// The n-body program of the Benchmarks Game: the orbits of the Jovian
// planets, objects with double fields read and written in a tight loop.
interface Body {
  x: double
  y: double
  z: double
  vx: double
  vy: double
  vz: double
  mass: double
}

const SOLAR_MASS = 4 * Math.PI * Math.PI
const DAYS_PER_YEAR = 365.24

function makeBodies(): Body[] {
  return [
    // the Sun
    { x: 0, y: 0, z: 0, vx: 0, vy: 0, vz: 0, mass: SOLAR_MASS },
    // Jupiter
    {
      x: 4.8414314424647209,
      y: -1.16032004402742839,
      z: -1.03622044471123109e-1,
      vx: 1.66007664274403694e-3 * DAYS_PER_YEAR,
      vy: 7.69901118419740425e-3 * DAYS_PER_YEAR,
      vz: -6.90460016972063023e-5 * DAYS_PER_YEAR,
      mass: 9.54791938424326609e-4 * SOLAR_MASS,
    },
    // Saturn
    {
      x: 8.34336671824457987,
      y: 4.12479856412430479,
      z: -4.03523417114321381e-1,
      vx: -2.76742510726862411e-3 * DAYS_PER_YEAR,
      vy: 4.99852801234917238e-3 * DAYS_PER_YEAR,
      vz: 2.30417297573763929e-5 * DAYS_PER_YEAR,
      mass: 2.85885980666130812e-4 * SOLAR_MASS,
    },
    // Uranus
    {
      x: 1.2894369562139131e1,
      y: -1.51111514016986312e1,
      z: -2.23307578892655734e-1,
      vx: 2.96460137564761618e-3 * DAYS_PER_YEAR,
      vy: 2.3784717395948095e-3 * DAYS_PER_YEAR,
      vz: -2.96589568540237556e-5 * DAYS_PER_YEAR,
      mass: 4.36624404335156298e-5 * SOLAR_MASS,
    },
    // Neptune
    {
      x: 1.53796971148509165e1,
      y: -2.59193146099879641e1,
      z: 1.79258772950371181e-1,
      vx: 2.68067772490389322e-3 * DAYS_PER_YEAR,
      vy: 1.62824170038242295e-3 * DAYS_PER_YEAR,
      vz: -9.5159225451971587e-5 * DAYS_PER_YEAR,
      mass: 5.15138902046611451e-5 * SOLAR_MASS,
    },
  ]
}

function offsetMomentum(bodies: Body[]) {
  let px = 0.0, py = 0.0, pz = 0.0
  for (const b of bodies) {
    px += b.vx * b.mass
    py += b.vy * b.mass
    pz += b.vz * b.mass
  }
  const sun = bodies[0]
  if (sun == undefined) return
  sun.vx = -px / SOLAR_MASS
  sun.vy = -py / SOLAR_MASS
  sun.vz = -pz / SOLAR_MASS
}

// Two bodies closer than 1e-9 would divide by almost 0, and the double would
// overflow (JavaScript gives Infinity); here they never come so close.
function advance(bodies: Body[], dt: double) {
  const n = bodies.length
  for (let i = 0; i < n; i++) {
    const bi = bodies[i]
    for (let j = i + 1; j < n; j++) {
      const bj = bodies[j]
      const dx = bi.x - bj.x
      const dy = bi.y - bj.y
      const dz = bi.z - bj.z
      const d2 = dx * dx + dy * dy + dz * dz
      const d3 = d2 * Math.sqrt(d2)
      if (d3 < 1e-9) continue
      const mag = dt / d3
      const bjm = bj.mass * mag
      bi.vx -= dx * bjm
      bi.vy -= dy * bjm
      bi.vz -= dz * bjm
      const bim = bi.mass * mag
      bj.vx += dx * bim
      bj.vy += dy * bim
      bj.vz += dz * bim
    }
  }
  for (const b of bodies) {
    b.x += dt * b.vx
    b.y += dt * b.vy
    b.z += dt * b.vz
  }
}

function energy(bodies: Body[]): double {
  let e = 0.0
  const n = bodies.length
  for (let i = 0; i < n; i++) {
    const bi = bodies[i]
    e += 0.5 * bi.mass * (bi.vx * bi.vx + bi.vy * bi.vy + bi.vz * bi.vz)
    for (let j = i + 1; j < n; j++) {
      const bj = bodies[j]
      const dx = bi.x - bj.x
      const dy = bi.y - bj.y
      const dz = bi.z - bj.z
      const d = Math.sqrt(dx * dx + dy * dy + dz * dz)
      if (d >= 1e-9) e -= (bi.mass * bj.mass) / d
    }
  }
  return e
}

const bodies = makeBodies()
offsetMomentum(bodies)
console.log(energy(bodies).toFixed(9))
for (let i = 0; i < 5000000; i++) advance(bodies, 0.01)
console.log(energy(bodies).toFixed(9))
