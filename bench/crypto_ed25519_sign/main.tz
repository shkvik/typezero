// Ed25519 signatures, 50000 times;
// the SHA-256 of the last signature is printed.
import { createPrivateKey, sign, createHash } from "node:crypto"

const pem =
  "-----BEGIN PRIVATE KEY-----\n" +
  "MC4CAQAwBQYDK2VwBCIEILv4fsSzEiPk7kwDzHM70NuGeJRFZkyyEOjHEB0ttb//\n" +
  "-----END PRIVATE KEY-----\n"

const keyMade = createPrivateKey(pem)
if (keyMade.isErr()) {
  console.error(keyMade.error.message)
  process.exit(1)
}
const key = keyMade.value
const data = Buffer.from("a message of some length to sign, as a token or a handshake would")
let signature = Buffer.alloc(0)
for (let i = 0; i < 50000; i++) {
  const made = sign(undefined, data, key)
  if (made.isErr()) {
    console.error(made.error.message)
    process.exit(1)
  }
  signature = made.value
}
const hashed = createHash("sha256")
if (hashed.isErr()) {
  console.error(hashed.error.message)
  process.exit(1)
}
console.log(hashed.value.update(signature).digest("hex"))
