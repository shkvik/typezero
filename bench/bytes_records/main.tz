// 4 million records of 16 bytes written and read back through a DataView:
// a little-endian uint32 id, a float64 value, and two big-endian uint16;
// then the same reads through Buffer's readUInt32LE and readDoubleLE. A double
// read from bytes may be any, so the sums take the values the records hold,
// from 0 to 1024: that is what keeps them finite.
const count = 4 * 1024 * 1024
const view = new DataView(new ArrayBuffer(count * 16))
let seed: Bit.Wrap32 = 1
for (let off = 0; off + 16 <= view.byteLength; off += 16) {
  seed = seed * 1103515245 + 12345
  const bits = seed.value
  view.setUint32(off, bits.toInt(), true)
  view.setFloat64(off + 4, (bits & 0xffff).toDouble() / 64, true)
  view.setUint16(off + 12, (bits & 0xffff).toInt())
  view.setUint16(off + 14, (bits >> 16).toInt())
}
let ids = 0
let values = 0.0
let small = 0
for (let round = 0; round < 5; round++) {
  for (let off = 0; off + 16 <= view.byteLength; off += 16) {
    ids += view.getUint32(off, true).toInt()
    const value = view.getFloat64(off + 4, true).unwrapOr(0)
    if (value >= 0 && value <= 1024) values += value
    small += (view.getUint16(off + 12) ^ view.getUint16(off + 14)).toInt()
  }
}
const buf = Buffer.from(view.buffer)
let check = 0
let total = 0.0
for (let off = 0; off + 16 <= buf.length; off += 16) {
  check += buf.readUInt32LE(off).toInt()
  const value = buf.readDoubleLE(off + 4).unwrapOr(0)
  if (value >= 0 && value <= 1024) total += value
}
console.log(ids, values, small, check, total)
