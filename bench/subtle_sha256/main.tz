// 2 GiB through crypto.subtle.digest("SHA-256"): 128 pieces of 16 MiB, all at once with
// Promise.all, and the digest of their digests.
const piece = new Uint8Array(16 << 20)
for (let i = 0; i < piece.length; i++) piece[i] = (i & 0xff).toUint8()
const pieces: Uint8Array[] = []
for (let i = 0; i < 128; i++) {
  const p = piece.slice()
  p.fill((i & 0xff).toUint8(), 0, 1)
  pieces.push(p)
}
const digests = Result.combine(await Promise.all(pieces.map(p => crypto.subtle.digest("SHA-256", p))))
if (digests.isErr()) {
  console.error(digests.error.message)
  process.exit(1)
}
const all = Buffer.concat(digests.value.map(d => new Uint8Array(d)))
const last = await crypto.subtle.digest("SHA-256", all)
console.log(last.isOk() ? Buffer.from(last.value).toString("hex") : last.error.message)
