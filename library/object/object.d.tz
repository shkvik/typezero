/**
 * What `Object` has. An object here is a value of an object type, of a class
 * or a dictionary `Record<string, T>`; a Map and a Set are not, as their
 * entries are no fields. The fields come in the order the object is printed
 * in.
 */
export interface ObjectConstructor {
  /** The names of the fields, or the keys of a dictionary. */
  readonly keys(value: Read<object>): string[];
  /** The values of the fields. */
  readonly values<T extends object>(value: Read<T>): T[keyof T][];
  /**
   * The fields as pairs of a name and a value.
   * @example Object.entries({ a: 1 }) // [["a", 1]]
   */
  readonly entries<T extends object>(value: Read<T>): [string, T[keyof T]][];
  /** A dictionary of the pairs of a key and a value. */
  readonly fromEntries<V>(
    entries: Read<Iterable<[string, V]> | Iterator<[string, V]>>,
  ): Record<string, V>;
  /**
   * A dictionary of the items by the key the function gives for each. The
   * key is a string; `Map.groupBy` groups by any key.
   */
  readonly groupBy<T>(
    items: Read<Iterable<T> | Iterator<T>>,
    key: Read<(item: T, index: int) => string>,
  ): Record<string, T[]>;
}

export declare const Object: ObjectConstructor;

/**
 * A deep copy of the value: the copy shares nothing with it.
 * @example const copy = structuredClone(line.start)
 */
export declare function structuredClone<T>(value: Read<T>): T;
