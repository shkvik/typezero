/** How a decimal is rounded; "half-up" is the usual one. */
export type RoundingMode =
  | "up"
  | "down"
  | "ceil"
  | "floor"
  | "half-up"
  | "half-down"
  | "half-even"
  | "half-ceil"
  | "half-floor";

/**
 * What a `decimal` has: an exact number with a fraction, of any length, for
 * money and for integers past 9.2e18. It counts with the usual operators,
 * and only with other decimals: an integer becomes one by `toDecimal()`, a
 * decimal becomes a double by `Number(x)`. `/` keeps 20 places after the
 * point. A divisor must be proven not to be zero.
 */
export interface decimal {
  /**
   * Divides, keeping the places after the point and rounding as told.
   * @example decimal(1).div(decimal(3), 2) // 0.33
   */
  readonly div(divisor: decimal, places?: int, mode?: RoundingMode): decimal;
  /**
   * Rounds to the places after the point, to an integer by default.
   * @example decimal("2.5").round(0, "half-even") // 2
   */
  readonly round(places?: int, mode?: RoundingMode): decimal;

  /** The number as text with that many places after the point. */
  readonly toFixed(places?: int, mode?: RoundingMode): string;
  /**
   * As `toFixed`, with the thousands set apart.
   * @example decimal("1234567.891").toFormat(2) // "1,234,567.89"
   */
  readonly toFormat(places?: int, mode?: RoundingMode): string;
  /** The number as text with a power of ten. */
  readonly toExponential(places?: int, mode?: RoundingMode): string;
  /** The number as text of that many significant digits. */
  readonly toPrecision(digits?: int, mode?: RoundingMode): string;
  /** The number as text in the base, 10 by default. */
  readonly toString(base?: int): string;

  /** The square root; the number must be proven not to be negative. */
  readonly sqrt(): decimal;
  readonly abs(): decimal;
  /** Whether the number has no fraction. */
  readonly isInteger(): boolean;
  /** How many places after the point the number has. */
  readonly decimalPlaces(): int;
  /** The number times that power of ten. */
  readonly shiftedBy(power: int): decimal;
  /**
   * The number as a fraction, its numerator and its denominator, the
   * denominator not above the limit when there is one.
   */
  readonly toFraction(maxDenominator?: decimal): decimal[];
}

/**
 * `decimal(value)` makes a decimal of a value; besides that `decimal` has
 * the functions that take several decimals.
 */
export interface DecimalConstructor {
  /**
   * A decimal of an integer or of a double; of a double it is the shortest
   * text that writes the number. A value of an enum of numbers is taken too.
   * @example decimal(0.1) // 0.1
   */
  (value: MathNumber | Bit.Wrap32 | Bit.Wrap64 | decimal): decimal;
  /**
   * Reads a decimal from a text; an error when the text is not a number. Of
   * a text written in the code it is the decimal itself, not a Result: the
   * text is checked when the program is built.
   * @example decimal("19.99") // 19.99
   */
  (value: string): Result<decimal, DecimalError>;

  readonly max(...values: decimal[]): decimal;
  readonly min(...values: decimal[]): decimal;
  readonly sum(...values: decimal[]): decimal;
}

export declare const decimal: DecimalConstructor;
