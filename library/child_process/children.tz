function spawnResult(
  pid: int,
  status: int,
  stdout: string,
  stderr: string,
): SpawnTextResult {
  const output: (string | undefined)[] = [undefined, stdout, stderr];

  return { pid, status, output, stdout, stderr };
}

function zeroArgument(args: Read<string[]>): int {
  for (let index = 0; index < args.length; index++) {
    const isZero = args[index]?.includes("\0") ?? false;

    if (isZero) {
      return index;
    }
  }

  return -1;
}

export function spawnText(
  file: Read<string>,
  args: Read<string[]>,
  encoding: int,
): Result<SpawnTextResult, SpawnTextError> {
  if (file.includes("\0")) {
    return err(zeroError(file, "file"));
  }
  if (file.length == 0) {
    return err(emptyError());
  }

  const zeroAt = zeroArgument(args);
  if (zeroAt >= 0) {
    return err(zeroError(file, `args[${zeroAt}]`));
  }

  const run = new ChildRun();

  childStarted(run, file, args);

  const stdout = run.output.textIn(encoding);
  const stderr = run.errors.textIn(encoding);

  if (run.failure() == noError()) {
    return ok(spawnResult(run.pid, run.status, stdout, stderr));
  }
  if (!run.isStarted) {
    return err(runError(file, args, run, undefined, undefined));
  }

  return err(runError(file, args, run, stdout, stderr));
}
