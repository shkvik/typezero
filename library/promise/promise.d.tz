/**
 * A value that comes later. A Promise is never rejected: an operation that
 * may fail gives a `Promise<Result<T, E>>`, so there is no `catch` and no
 * `finally`. It is read with `await`, or with `then`.
 */
export declare class Promise<T> {
  /**
   * A Promise that the function gives its value to by calling `resolve`. The
   * function gets only `resolve`: a Promise is never rejected.
   * @example new Promise<int>((resolve) => setTimeout(() => resolve(1), 10))
   */
  public constructor(executor: Read<(resolve: (value: T) => void) => void>);

  /**
   * Calls the function with the value when it comes; a Promise the function
   * gives is waited for too.
   * @example Promise.resolve(2).then((x) => x * 2) // a Promise of 4
   */
  public then<U>(next: Own<(value: T) => U | Promise<U>>): Promise<U>;

  /** A Promise that has the value already; a Promise is given as it is. */
  public static resolve(): Promise<void>;
  public static resolve<T>(value: Read<T | Promise<T>>): Promise<T>;
  /**
   * Waits for all of them and gives their values in the same order. Promises
   * of different types written in place give a tuple:
   * `Promise.all([a, b])` is a `Promise<[A, B]>`.
   */
  public static all<T>(promises: Read<Promise<T>[]>): Promise<T[]>;
  /** The value of the one that comes first. */
  public static race<T>(promises: Read<Promise<T>[]>): Promise<T>;
  /** A Promise together with the function that gives it its value. */
  public static withResolvers<T>(): {
    promise: Promise<T>;
    resolve: (value: T) => void;
  };
}

/** The same as `Promise<T>`. */
export type PromiseLike<T> = Promise<T>;
