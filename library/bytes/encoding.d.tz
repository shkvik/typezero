/** Turns text into bytes of UTF-8. It is made with `new TextEncoder()`. */
export declare class TextEncoder {
  public constructor();

  /** Always "utf-8". */
  public readonly encoding: string;

  /**
   * The text as bytes of UTF-8.
   * @example new TextEncoder().encode("Hi") // Uint8Array(2) [ 72, 105 ]
   */
  public encode(text?: string): Uint8Array;
  /**
   * Writes the text into the bytes given, as much of it as fits: `read` is
   * how many UTF-16 units of the text were taken, `written` how many bytes.
   */
  public encodeInto(
    text: string,
    target: Uint8Array,
  ): { read: int; written: int };
}

/** How a `TextDecoder` reads: by parts, when `stream` is true. */
export type TextDecodeOptions = { stream?: boolean };

/**
 * How a `TextDecoder` is made: `fatal` makes broken bytes an error instead
 * of the mark "�", `ignoreBOM` keeps the mark of the byte order in the
 * text.
 */
export type TextDecoderOptions = { fatal?: boolean; ignoreBOM?: boolean };

/**
 * Turns bytes into text. It is made with `new TextDecoder(label, options)`:
 * the label names the encoding, "utf-8" by default, and is a text written
 * in the code, so that the table of an old encoding such as "windows-1251"
 * gets into the program only when it is named. A label known only when the
 * program runs is read by `TextDecoder.parse`. With `fatal: true` the
 * decoder is a `FatalTextDecoder`.
 */
export declare class TextDecoder {
  /**
   * A decoder of the encoding the label names, "utf-8" by default. With
   * `fatal: true` what comes is a `FatalTextDecoder`.
   */
  public constructor(label?: string, options?: TextDecoderOptions);

  /** The name of the encoding. */
  public readonly encoding: string;
  public readonly fatal: boolean;
  public readonly ignoreBOM: boolean;

  /**
   * The bytes as text; broken bytes become "�".
   * @example new TextDecoder().decode(bytes)
   */
  public decode(bytes?: AnyBytes, options?: TextDecodeOptions): string;

  /**
   * Makes a decoder of a label known only when the program runs; an error
   * when the label names no encoding.
   */
  public static parse(
    label: string,
    options: { fatal: true; ignoreBOM?: boolean },
  ): Result<FatalTextDecoder, EncodingError>;
  public static parse(
    label: string,
    options?: TextDecoderOptions,
  ): Result<TextDecoder, EncodingError>;
}

/**
 * A `TextDecoder` made with `fatal: true`: broken bytes are an error, so
 * `decode` gives a Result.
 */
export declare class FatalTextDecoder {
  /** `new TextDecoder(label, { fatal: true })` makes one. */
  private constructor();

  /** The name of the encoding. */
  public readonly encoding: string;
  public readonly fatal: boolean;
  public readonly ignoreBOM: boolean;

  public decode(
    bytes?: AnyBytes,
    options?: TextDecodeOptions,
  ): Result<string, DecodeError>;
}
