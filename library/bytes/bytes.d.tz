/**
 * A piece of memory of a fixed length in bytes, made with
 * `new ArrayBuffer(length)`. It is read and written through a typed array or
 * a `DataView` over it. Its size does not change: there is no `resize` and
 * no `transfer` yet.
 */
export interface ArrayBuffer {
  /** The length in bytes. */
  readonly byteLength: int;
  /** The same as `byteLength`, as the size does not change. */
  readonly maxByteLength: int;
  /** Always false. */
  readonly resizable: boolean;
  /** Always false. */
  readonly detached: boolean;

  /** A new buffer with a copy of the bytes from `start` up to `end`. */
  slice(start?: int, end?: int): ArrayBuffer;
}

/** What `ArrayBuffer` has besides `new ArrayBuffer(length)`. */
export interface ArrayBufferConstructor {
  /** Whether the value is a typed array or a `DataView`. */
  isView(value: unknown): boolean;
}

export declare const ArrayBuffer: ArrayBufferConstructor;

/**
 * What every typed array has: numbers of one type `E` laid in memory one
 * after another, and `Self` is the typed array itself. Its length does not
 * change. An index counts from 0: what may be outside gives `undefined`
 * instead of failing, and a write needs a proof that the index is inside. A
 * number written must be of the type `E`: one that may not fit is an error
 * unless it is proven to fit or converted, as `x.toUint8()`.
 *
 * It is made with `new` of a length, of an array or an iterator of numbers,
 * of another typed array, or of an `ArrayBuffer` with an offset and a length
 * in items, and then it looks into the memory of that buffer.
 */
export interface TypedArray<E, Self> {
  /** How many items there are. */
  readonly length: int;
  /** The length in bytes. */
  readonly byteLength: int;
  /** Where in `buffer` the first item is. */
  readonly byteOffset: int;
  /** The memory the items are in. */
  readonly buffer: ArrayBuffer;
  /** How many bytes an item takes. */
  readonly BYTES_PER_ELEMENT: int;

  /** The item at the index; a negative index counts from the end. */
  at(index: int): E | undefined;
  /** Sets every item from `start` up to `end` to the value. */
  fill(value: E, start?: int, end?: int): Self;
  /**
   * Writes the items of an array, an iterator or another typed array from
   * `offset` on; they must be proven to fit, in count and in value.
   */
  set(items: Iterable<E> | Iterator<E>, offset?: int): void;
  /** Copies the items from `start` up to `end` to `target` inside itself. */
  copyWithin(target: int, start: int, end?: int): Self;
  /**
   * Sorts the array itself, by value when there is no function.
   * @example bytes.sort()
   */
  sort(compare?: (first: E, second: E) => int | double): Self;
  /** Reverses the array itself. */
  reverse(): Self;

  /** A new typed array with a copy of the items from `start` up to `end`. */
  slice(start?: int, end?: int): Self;
  /** A typed array that looks into the same memory from `start` to `end`. */
  subarray(start?: int, end?: int): Self;
  /** A reversed copy. */
  toReversed(): Self;
  /** A sorted copy. */
  toSorted(compare?: (first: E, second: E) => int | double): Self;
  /** A copy with the item at the index replaced. */
  with(index: int, value: E): Self;

  /** The index of the first such item, -1 when there is none. */
  indexOf(item: E | int | double, from?: int): int;
  /** The index of the last such item, -1 when there is none. */
  lastIndexOf(item: E | int | double, from?: int): int;
  includes(item: E | int | double, from?: int): boolean;

  /** The items as text with the separator, a comma by default. */
  join(separator?: string): string;
  toString(): string;

  keys(): Generator<int>;
  values(): Generator<E>;
  entries(): Generator<[int, E]>;

  forEach(action: (item: E, index: int, all: Self) => void): void;
  /** A new typed array of what the function gives for each item. */
  map(change: (item: E, index: int, all: Self) => E): Self;
  /** A new typed array of the items the function says yes to. */
  filter(keep: (item: E, index: int, all: Self) => boolean): Self;

  /**
   * Folds the items into one value from the left. Without a start value the
   * first item is the start, and an empty array gives `undefined`.
   */
  reduce(join: (result: E, item: E, index: int, all: Self) => E): E | undefined;
  reduce<U>(
    join: (result: U, item: E, index: int, all: Self) => U,
    start: U,
  ): U;
  /** As `reduce`, from the right. */
  reduceRight(
    join: (result: E, item: E, index: int, all: Self) => E,
  ): E | undefined;
  reduceRight<U>(
    join: (result: U, item: E, index: int, all: Self) => U,
    start: U,
  ): U;

  /** The first item the function says yes to. */
  find(test: (item: E, index: int, all: Self) => boolean): E | undefined;
  /** The last item the function says yes to. */
  findLast(test: (item: E, index: int, all: Self) => boolean): E | undefined;
  /** The index of the first such item, -1 when there is none. */
  findIndex(test: (item: E, index: int, all: Self) => boolean): int;
  /** The index of the last such item, -1 when there is none. */
  findLastIndex(test: (item: E, index: int, all: Self) => boolean): int;
  /** Whether the function says yes to at least one item. */
  some(test: (item: E, index: int, all: Self) => boolean): boolean;
  /** Whether the function says yes to every item. */
  every(test: (item: E, index: int, all: Self) => boolean): boolean;
}

/** What the name of a typed array has besides `new`. */
export interface TypedArrayConstructor<E, Self> {
  /** How many bytes an item takes. */
  readonly BYTES_PER_ELEMENT: int;

  /**
   * A new typed array of the items of an array, an iterator or another typed
   * array, each changed by the function when there is one.
   * @example Uint8Array.from(numbers, (x) => (x & 0xff).toUint8())
   */
  from(items: Iterable<E> | Iterator<E>): Self;
  from<T>(
    items: Iterable<T> | Iterator<T>,
    change: (item: T, index: int) => E,
  ): Self;
  /** A new typed array of the values given. */
  of(...items: E[]): Self;
}

/**
 * Bytes: numbers from 0 to 255. The type argument, `ArrayBuffer` or
 * `ArrayBufferLike`, is taken as TypeScript writes it and changes nothing.
 */
export interface Uint8Array<B = ArrayBuffer> extends TypedArray<
  uint8,
  Uint8Array
> {}

export declare const Uint8Array: TypedArrayConstructor<uint8, Uint8Array>;

/**
 * Bytes that a write clamps to 0…255 instead of asking for a proof: less
 * than 0 becomes 0, more than 255 becomes 255.
 */
export interface Uint8ClampedArray<B = ArrayBuffer> extends TypedArray<
  uint8,
  Uint8ClampedArray
> {}

export declare const Uint8ClampedArray: TypedArrayConstructor<
  uint8,
  Uint8ClampedArray
>;

/** Numbers from -128 to 127. */
export interface Int8Array<B = ArrayBuffer> extends TypedArray<
  int8,
  Int8Array
> {}

export declare const Int8Array: TypedArrayConstructor<int8, Int8Array>;

/** Numbers from 0 to 65 535, two bytes each. */
export interface Uint16Array<B = ArrayBuffer> extends TypedArray<
  uint16,
  Uint16Array
> {}

export declare const Uint16Array: TypedArrayConstructor<uint16, Uint16Array>;

/** Numbers from -32 768 to 32 767, two bytes each. */
export interface Int16Array<B = ArrayBuffer> extends TypedArray<
  int16,
  Int16Array
> {}

export declare const Int16Array: TypedArrayConstructor<int16, Int16Array>;

/** Numbers from 0 to 4 294 967 295, four bytes each. */
export interface Uint32Array<B = ArrayBuffer> extends TypedArray<
  uint32,
  Uint32Array
> {}

export declare const Uint32Array: TypedArrayConstructor<uint32, Uint32Array>;

/** Numbers from -2 147 483 648 to 2 147 483 647, four bytes each. */
export interface Int32Array<B = ArrayBuffer> extends TypedArray<
  int32,
  Int32Array
> {}

export declare const Int32Array: TypedArrayConstructor<int32, Int32Array>;

/** Numbers with a fraction, two bytes each. */
export interface Float16Array<B = ArrayBuffer> extends TypedArray<
  double,
  Float16Array
> {}

export declare const Float16Array: TypedArrayConstructor<double, Float16Array>;

/** Numbers with a fraction, four bytes each. */
export interface Float32Array<B = ArrayBuffer> extends TypedArray<
  double,
  Float32Array
> {}

export declare const Float32Array: TypedArrayConstructor<double, Float32Array>;

/** Numbers with a fraction, eight bytes each: every double as it is. */
export interface Float64Array<B = ArrayBuffer> extends TypedArray<
  double,
  Float64Array
> {}

export declare const Float64Array: TypedArrayConstructor<double, Float64Array>;

/** Any of the typed arrays. */
export type AnyTypedArray =
  | Uint8Array
  | Uint8ClampedArray
  | Int8Array
  | Uint16Array
  | Int16Array
  | Uint32Array
  | Int32Array
  | Float16Array
  | Float32Array
  | Float64Array;

/** Any of the typed arrays of integers. */
export type IntegerTypedArray =
  | Uint8Array
  | Uint8ClampedArray
  | Int8Array
  | Uint16Array
  | Int16Array
  | Uint32Array
  | Int32Array;

/** Anything that holds bytes: a typed array, a `DataView`, the memory. */
export type AnyBytes = AnyTypedArray | DataView | ArrayBuffer;

/**
 * Reads and writes numbers of any type at any place of an `ArrayBuffer`. It
 * is made with `new DataView(buffer)`, with an offset and a length in bytes
 * when given. A number of several bytes is big-endian unless `littleEndian`
 * is true. An offset must be proven to be inside, and a number written to
 * fit. Reading a number with a fraction gives a Result: the bytes may hold
 * `NaN` or an infinity, which a double here never is.
 */
export interface DataView {
  /** The memory it looks into. */
  readonly buffer: ArrayBuffer;
  /** Its length in bytes. */
  readonly byteLength: int;
  /** Where in `buffer` it starts. */
  readonly byteOffset: int;

  getInt8(offset: int): int;
  getUint8(offset: int): int;
  getInt16(offset: int, littleEndian?: boolean): int;
  getUint16(offset: int, littleEndian?: boolean): int;
  getInt32(offset: int, littleEndian?: boolean): int;
  getUint32(offset: int, littleEndian?: boolean): int;
  getFloat16(offset: int, littleEndian?: boolean): Result<double, NumberError>;
  getFloat32(offset: int, littleEndian?: boolean): Result<double, NumberError>;
  getFloat64(offset: int, littleEndian?: boolean): Result<double, NumberError>;

  setInt8(offset: int, value: int): void;
  setUint8(offset: int, value: int): void;
  setInt16(offset: int, value: int, littleEndian?: boolean): void;
  setUint16(offset: int, value: int, littleEndian?: boolean): void;
  setInt32(offset: int, value: int, littleEndian?: boolean): void;
  setUint32(offset: int, value: int, littleEndian?: boolean): void;
  setFloat16(offset: int, value: double, littleEndian?: boolean): void;
  setFloat32(offset: int, value: double, littleEndian?: boolean): void;
  setFloat64(offset: int, value: double, littleEndian?: boolean): void;
}

/** `DataView` has nothing besides `new DataView(buffer, offset, length)`. */
export interface DataViewConstructor {}

export declare const DataView: DataViewConstructor;
