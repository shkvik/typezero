    buffer: Read<ArrayBuffer>,
    byteOffset?: int,
    byteLength?: int,
  );

  /** The memory it looks into. */
  public readonly buffer: ArrayBuffer;
  /** Its length in bytes. */
  public readonly byteLength: int;
  /** Where in `buffer` it starts. */
  public readonly byteOffset: int;

  public readonly getInt8(offset: int): int;
  public readonly getUint8(offset: int): int;
  public readonly getInt16(offset: int, littleEndian?: boolean): int;
  public readonly getUint16(offset: int, littleEndian?: boolean): int;
  public readonly getInt32(offset: int, littleEndian?: boolean): int;
  public readonly getUint32(offset: int, littleEndian?: boolean): int;
  public readonly getFloat16(
    offset: int,
    littleEndian?: boolean,
  ): Result<double, NumberError>;
  public readonly getFloat32(
    offset: int,
    littleEndian?: boolean,
  ): Result<double, NumberError>;
  public readonly getFloat64(
    offset: int,
    littleEndian?: boolean,
  ): Result<double, NumberError>;

  public setInt8(offset: int, value: int): void;
  public setUint8(offset: int, value: int): void;
  public setInt16(offset: int, value: int, littleEndian?: boolean): void;
  public setUint16(offset: int, value: int, littleEndian?: boolean): void;
  public setInt32(offset: int, value: int, littleEndian?: boolean): void;
  public setUint32(offset: int, value: int, littleEndian?: boolean): void;
  public setFloat16(offset: int, value: double, littleEndian?: boolean): void;
  public setFloat32(offset: int, value: double, littleEndian?: boolean): void;
  public setFloat64(offset: int, value: double, littleEndian?: boolean): void;
}
