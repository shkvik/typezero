  public setInt8(offset: int, value: int): void;
  public setUint8(offset: int, value: int): void;
  public setInt16(offset: int, value: int, littleEndian?: boolean): void;
  public setUint16(offset: int, value: int, littleEndian?: boolean): void;
  public setInt32(offset: int, value: int, littleEndian?: boolean): void;
  public setUint32(offset: int, value: int, littleEndian?: boolean): void;
  public setFloat16(offset: int, value: double, littleEndian?: boolean): void;
  public setFloat32(offset: int, value: double, littleEndian?: boolean): void;
  public setFloat64(offset: int, value: double, littleEndian?: boolean): void;
}
