  public static from(items: Iterable<uint8> | Iterator<uint8>): Uint8Array;
  public static from<T>(
    items: Iterable<T> | Iterator<T>,
    change: (item: T, index: int) => uint8,
  ): Uint8Array;
  public static of(...items: uint8[]): Uint8Array;
}

