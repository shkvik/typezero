  /** Its length in bytes. */
  public readonly byteLength: int;
  /** Where in `buffer` it starts. */
  public readonly byteOffset: int;

  public getInt8(offset: int): int;
  public getUint8(offset: int): int;
  public getInt16(offset: int, littleEndian?: boolean): int;
  public getUint16(offset: int, littleEndian?: boolean): int;
  public getInt32(offset: int, littleEndian?: boolean): int;
  public getUint32(offset: int, littleEndian?: boolean): int;
