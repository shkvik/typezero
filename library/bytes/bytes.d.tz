/**
 * A piece of memory of a fixed length in bytes, made with
 * `new ArrayBuffer(length)`. It is read and written through a typed array or
 * a `DataView` over it. Its size does not change: there is no `resize` and
 * no `transfer` yet.
 */
export declare class ArrayBuffer {
  /** Memory of that many bytes, all zeros. */
  public constructor(length: int);

  /** The length in bytes. */
  public readonly byteLength: int;
  /** The same as `byteLength`, as the size does not change. */
  public readonly maxByteLength: int;
  /** Always false. */
  public readonly resizable: boolean;
  /** Always false. */
  public readonly detached: boolean;

  /** A new buffer with a copy of the bytes from `start` up to `end`. */
  public slice(start?: int, end?: int): ArrayBuffer;

  /** Whether the value is a typed array or a `DataView`. */
  public static isView(value: unknown): boolean;
}

/**
 * What every typed array has: numbers of one type `E` laid in memory one
 * after another, and `Self` is the typed array itself. Its length does not
 * change. An index counts from 0: what may be outside gives `undefined`
 * instead of failing, and a write needs a proof that the index is inside. A
 * number written must be of the type `E`: one that may not fit is an error
 * unless it is proven to fit or converted, as `x.toUint8()`.
 *
 * It is made with `new` of a length, of an array or an iterator of numbers,
 * of another typed array, or of an `ArrayBuffer` with an offset and a length
 * in items, and then it looks into the memory of that buffer.
 */
export declare abstract class TypedArray<E, Self> {
  /** How many items there are. */
  public readonly length: int;
  /** The length in bytes. */
  public readonly byteLength: int;
  /** Where in `buffer` the first item is. */
  public readonly byteOffset: int;
  /** The memory the items are in. */
  public readonly buffer: ArrayBuffer;
  /** How many bytes an item takes. */
  public readonly BYTES_PER_ELEMENT: int;

  /** The item at the index; a negative index counts from the end. */
  public at(index: int): E | undefined;
  /** Sets every item from `start` up to `end` to the value. */
  public fill(value: E, start?: int, end?: int): Self;
  /**
   * Writes the items of an array, an iterator or another typed array from
   * `offset` on; they must be proven to fit, in count and in value.
   */
  public set(items: Iterable<E> | Iterator<E>, offset?: int): void;
  /** Copies the items from `start` up to `end` to `target` inside itself. */
  public copyWithin(target: int, start: int, end?: int): Self;
  /**
   * Sorts the array itself, by value when there is no function.
   * @example bytes.sort()
   */
  public sort(compare?: (first: E, second: E) => int | double): Self;
  /** Reverses the array itself. */
  public reverse(): Self;

  /** A new typed array with a copy of the items from `start` up to `end`. */
  public slice(start?: int, end?: int): Self;
  /** A typed array that looks into the same memory from `start` to `end`. */
  public subarray(start?: int, end?: int): Self;
  /** A reversed copy. */
  public toReversed(): Self;
  /** A sorted copy. */
  public toSorted(compare?: (first: E, second: E) => int | double): Self;
  /** A copy with the item at the index replaced. */
  public with(index: int, value: E): Self;

  /** The index of the first such item, -1 when there is none. */
  public indexOf(item: E | int | double, from?: int): int;
  /** The index of the last such item, -1 when there is none. */
  public lastIndexOf(item: E | int | double, from?: int): int;
  public includes(item: E | int | double, from?: int): boolean;

  /** The items as text with the separator, a comma by default. */
  public join(separator?: string): string;
  public toString(): string;

  public keys(): Generator<int>;
  public values(): Generator<E>;
  public entries(): Generator<[int, E]>;

  public forEach(action: (item: E, index: int, all: Self) => void): void;
  /** A new typed array of what the function gives for each item. */
  public map(change: (item: E, index: int, all: Self) => E): Self;
  /** A new typed array of the items the function says yes to. */
  public filter(keep: (item: E, index: int, all: Self) => boolean): Self;

  /**
   * Folds the items into one value from the left. Without a start value the
   * first item is the start, and an empty array gives `undefined`.
   */
  public reduce(
    join: (result: E, item: E, index: int, all: Self) => E,
  ): E | undefined;
  public reduce<U>(
    join: (result: U, item: E, index: int, all: Self) => U,
    start: U,
  ): U;
  /** As `reduce`, from the right. */
  public reduceRight(
    join: (result: E, item: E, index: int, all: Self) => E,
  ): E | undefined;
  public reduceRight<U>(
    join: (result: U, item: E, index: int, all: Self) => U,
    start: U,
  ): U;

  /** The first item the function says yes to. */
  public find(test: (item: E, index: int, all: Self) => boolean): E | undefined;
  /** The last item the function says yes to. */
  public findLast(
    test: (item: E, index: int, all: Self) => boolean,
  ): E | undefined;
  /** The index of the first such item, -1 when there is none. */
  public findIndex(test: (item: E, index: int, all: Self) => boolean): int;
  /** The index of the last such item, -1 when there is none. */
  public findLastIndex(test: (item: E, index: int, all: Self) => boolean): int;
  /** Whether the function says yes to at least one item. */
  public some(test: (item: E, index: int, all: Self) => boolean): boolean;
  /** Whether the function says yes to every item. */
  public every(test: (item: E, index: int, all: Self) => boolean): boolean;
}

