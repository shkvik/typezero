import {
  ArrayBufferHead,
  ArrayHead,
  BytesHead,
  CStringHead,
  LayoutHead,
} from "tz:core";
import { objectMade, zeroFilled } from "tz:counts";
import { panic } from "tz:intrinsics";
import { textOfBytes } from "tz:text";
import {
  Raw,
  allocate,
  bitsRaw,
  cellsAt,
  copyCells,
  doubleBits,
  isAscii,
  peekAt,
  putUnit,
  release,
  sameCells,
  textCells,
  unitAt,
  viewAt,
} from "tz:unsafe";

const kEncodingNames: string[] = [
  "utf8",
  "utf-8",
  "utf16le",
  "utf-16le",
  "ucs2",
  "ucs-2",
  "latin1",
  "binary",
  "ascii",
  "base64",
  "base64url",
  "hex",
];

const kEncodingCodes: int[] = [0, 0, 1, 1, 1, 1, 2, 2, 3, 4, 5, 6];

function lowerCode(unit: int): int {
  if (unit >= 65 && unit <= 90) {
    return unit + 32;
  }

  return unit;
}

function isLowerEqual(text: Read<string>, name: Read<string>): boolean {
  if (text.length != name.length) {
    return false;
  }

  for (let index = 0; index < name.length; index++) {
    const unit = lowerCode(text.charCodeAt(index) ?? 0);

    if (unit != (name.charCodeAt(index) ?? 0)) {
      return false;
    }
  }

  return true;
}

export function encodingOf(name: Read<string>): int {
  for (let index = 0; index < kEncodingNames.length; index++) {
    if (isLowerEqual(name, kEncodingNames[index] ?? "")) {
      return kEncodingCodes[index] ?? 0;
    }
  }

  panic("internal error: an encoding Buffer does not know");
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "the cells of the text hold its length units",
})
function unitOf(
  narrow: Raw<uint8> | undefined,
  wide: Raw<uint16> | undefined,
  index: int,
): int {
  if (narrow != undefined) {
    return unitAt(narrow, index);
  }
  if (wide != undefined) {
    return unitAt(wide, index);
  }

  return 0;
}

@InPlace()
class TextUnits {
  public readonly narrow: Raw<uint8> | undefined;
  public readonly wide: Raw<uint16> | undefined;
  public readonly count: int;

  public constructor(
    narrow: Raw<uint8> | undefined,
    wide: Raw<uint16> | undefined,
    count: int,
  ) {
    this.narrow = narrow;
    this.wide = wide;
    this.count = count;
  }

  public readonly unitAt(index: int): int {
    return unitOf(this.narrow, this.wide, index);
  }

  public readonly isWide(): boolean {
    return this.narrow == undefined;
  }

  public readonly pointAt(index: int): int {
    const unit = this.unitAt(index);

    if (unit >= 55296 && unit <= 56319 && index + 1 < this.count) {
      const next = this.unitAt(index + 1);

      if (next >= 56320 && next <= 57343) {
        return 65536 + (unit - 55296) * 1024 + (next - 56320);
      }
    }
    if (unit >= 55296 && unit <= 57343) {
      return 65533;
    }

    return unit;
  }

  public readonly pointUnits(index: int): int {
    const unit = this.unitAt(index);

    if (unit >= 55296 && unit <= 56319 && index + 1 < this.count) {
      const next = this.unitAt(index + 1);

      if (next >= 56320 && next <= 57343) {
        return 2;
      }
    }

    return 1;
  }
}

function utf8Size(point: int): int {
  if (point < 128) {
    return 1;
  }
  if (point < 2048) {
    return 2;
  }
  if (point < 65536) {
    return 3;
  }

  return 4;
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "the cells hold count units of 16 bits",
})
function wideUtf8Length(wide: Raw<uint16>, count: int): int {
  let total = 0;
  let index = 0;

  while (index < count) {
    const unit = unitAt(wide, index);

    if (unit < 128) {
      total += 1;
    } else if (unit < 2048) {
      total += 2;
    } else if (unit >= 55296 && unit <= 56319 && index + 1 < count) {
      const next = unitAt(wide, index + 1);

      if (next >= 56320 && next <= 57343) {
        total += 4;
        index += 1;
      } else {
        total += 3;
      }
    } else {
      total += 3;
    }

    index += 1;
  }

  return total;
}

function utf8Length(units: Read<TextUnits>): int {
  const wide = units.wide;
  if (wide != undefined) {
    return wideUtf8Length(wide, units.count);
  }
  if (!units.isWide()) {
    let count = units.count;

    for (let index = 0; index < units.count; index++) {
      if (units.unitAt(index) >= 128) {
        count += 1;
      }
    }

    return count;
  }

  let count = 0;
  let index = 0;

  while (index < units.count) {
    count += utf8Size(units.pointAt(index));
    index += units.pointUnits(index);
  }

  return count;
}

function base64Length(units: Read<TextUnits>): int {
  let count = units.count;

  if (count > 0 && units.unitAt(count - 1) == 61) {
    count -= 1;
  }
  if (count > 1 && units.unitAt(count - 1) == 61) {
    count -= 1;
  }

  return (count * 3) >> 2;
}

function lengthIn(units: Read<TextUnits>, encoding: int): int {
  switch (encoding) {
    case 0:
      return utf8Length(units);
    case 1:
      return units.count * 2;
    case 4:
    case 5:
      return base64Length(units);
    case 6:
      return units.count >> 1;
    default:
      return units.count;
  }
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "the cells live as long as the borrowed text of this call",
})
export function byteLengthOf(text: Read<string>, encoding: int): int {
  const narrow = textCells<uint8>(text);
  const wide = textCells<uint16>(text);
  const units = new TextUnits(narrow, wide, text.length);

  return lengthIn(units, encoding);
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "the room has view.length bytes from the offset",
})
export function bufferText(
  buffer: Raw<uint8>,
  encoding: int,
  start: int,
  end: int,
  has: int,
): string {
  const head = viewAt<BytesHead>(buffer, 0);
  const length = head.length.toInt();
  let from = 0;
  let to = length;

  if ((has & 1) != 0) {
    from = Math.max(start, 0);
  }
  if ((has & 2) != 0) {
    to = Math.min(end, length);
  }
  if (from >= to) {
    return "";
  }

  return textOfBytes(cellsAt<uint8>(head.data, from), to - from, encoding);
}
