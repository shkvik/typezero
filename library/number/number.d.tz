/**
 * What every integer type has: `int`, `int8`, `int16`, `int32`, `uint8`,
 * `uint16`, `uint32` and `uint64`. A number changes its type only by these
 * methods; a narrower type needs a proof that the value fits it.
 */
export interface IntegerMethods {
  readonly toInt(): int;
  readonly toInt8(): int8;
  readonly toInt16(): int16;
  readonly toInt32(): int32;
  readonly toUint8(): uint8;
  readonly toUint16(): uint16;
  readonly toUint32(): uint32;
  readonly toUint64(): uint64;
  readonly toDouble(): double;
  /** The same number as an exact decimal. */
  readonly toDecimal(): decimal;
  /**
   * The number as text in the base, 10 by default.
   * @example (255).toString(16) // "ff"
   */
  readonly toString(radix?: int): string;
  /** The number as text with that many digits after the point. */
  readonly toFixed(digits?: int): string;
}

export interface int extends IntegerMethods {}
export interface int8 extends IntegerMethods {}
export interface int16 extends IntegerMethods {}
export interface int32 extends IntegerMethods {}
export interface uint8 extends IntegerMethods {}
export interface uint16 extends IntegerMethods {}
export interface uint32 extends IntegerMethods {}
export interface uint64 extends IntegerMethods {}

/**
 * What a `double` has. It becomes an integer only after rounding, so that the
 * fraction is never dropped silently: `Math.floor(x).toInt()`. It does not
 * become a decimal: a double is inexact already.
 */
export interface double {
  readonly toInt(): int;
  readonly toInt8(): int8;
  readonly toInt16(): int16;
  readonly toInt32(): int32;
  readonly toUint8(): uint8;
  readonly toUint16(): uint16;
  readonly toUint32(): uint32;
  readonly toUint64(): uint64;
  readonly toDouble(): double;
  /** The number as text in the base, 10 by default. */
  readonly toString(radix?: int): string;
  /**
   * The number as text with that many digits after the point.
   * @example (1.005).toFixed(2) // "1.00"
   */
  readonly toFixed(digits?: int): string;
}

/**
 * `Number(value)` makes a number of a value; besides that `Number` has the
 * limits of a double and the functions that read and test numbers. A value
 * that may be `undefined` is not taken: there is no NaN to give.
 */
export interface NumberConstructor {
  /** Zero. */
  (): double;
  /**
   * The number as a double; 1 of true and 0 of false. A value of an enum of
   * numbers is taken too.
   * @example Number(true) // 1
   */
  (value: MathNumber | Bit.Wrap32 | Bit.Wrap64 | boolean | decimal): double;
  /**
   * Reads a number from a text; an error when the text is not a number.
   * @example Number("2.5") // ok(2.5)
   */
  (value: string): Result<double, NumberError>;
  /** The milliseconds of the date since the start of 1970. */
  (value: Date): int;

  /** The largest integer a double holds exactly: 2 ** 53 - 1. */
  readonly MAX_SAFE_INTEGER: double;
  readonly MIN_SAFE_INTEGER: double;
  /** The distance from 1 to the next double. */
  readonly EPSILON: double;
  readonly MAX_VALUE: double;
  /** The smallest double above zero. */
  readonly MIN_VALUE: double;

  /** The same as the global `parseInt`. */
  readonly parseInt(text: string, radix?: int): Result<int, NumberError>;
  /** The same as the global `parseFloat`. */
  readonly parseFloat(text: string): Result<double, NumberError>;
  /** Whether the number has no fraction. */
  readonly isInteger(value: int | double): boolean;
  /** Whether the number is an integer a double holds exactly. */
  readonly isSafeInteger(value: int | double): boolean;
}

export declare const Number: NumberConstructor;

/**
 * Reads an integer in the base, 10 by default; an error when the text is not
 * a number.
 * @example parseInt("ff", 16) // ok(255)
 */
export declare function parseInt(
  text: string,
  radix?: int,
): Result<int, NumberError>;

/**
 * Reads a number with a fraction; an error when the text is not a number.
 * @example parseFloat("2.5") // ok(2.5)
 */
export declare function parseFloat(text: string): Result<double, NumberError>;

/** The same as `double`: so that code from TypeScript reads as it is. */
export type number = double;
