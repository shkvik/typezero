import { asClass } from "tz:intrinsics"
declare function libClassName(object: object): string
declare function signalNew(): object
declare function libSignalAbort(native: object, reason: unknown): void
declare function libSignalRun(native: object, order: double): void
declare function libOrder(): double

export class DOMException {
  readonly message: string
  readonly name: string
  readonly code: int
  constructor(message = "", name = "Error") {
    this.message = message
    this.name = name
    this.code = legacyCode(name)
  }
}

function legacyCode(name: string): int {
  const names = [
    "IndexSizeError", "", "HierarchyRequestError", "WrongDocumentError", "InvalidCharacterError",
    "", "NoModificationAllowedError", "NotFoundError", "NotSupportedError", "InUseAttributeError",
    "InvalidStateError", "SyntaxError", "InvalidModificationError", "NamespaceError",
    "InvalidAccessError", "", "TypeMismatchError", "SecurityError", "NetworkError", "AbortError",
    "URLMismatchError", "QuotaExceededError", "TimeoutError", "InvalidNodeTypeError",
    "DataCloneError",
  ]
  const at = names.indexOf(name)
  return name == "" || at < 0 ? 0 : at + 1
}

export interface EventInit {
  bubbles?: boolean
  cancelable?: boolean
  composed?: boolean
}

type EventState = {
  defaultPrevented: boolean
  isTrusted: boolean
  target?: EventTarget
  currentTarget?: EventTarget
  srcElement?: EventTarget
  eventPhase: int
  immediateStopped: boolean
}

export class Event {
  static readonly NONE = 0
  static readonly CAPTURING_PHASE = 1
  static readonly AT_TARGET = 2
  static readonly BUBBLING_PHASE = 3

  readonly type: string
  readonly cancelable: boolean
  readonly timeStamp: double
  readonly bubbles: boolean
  readonly composed: boolean
  returnValue = true
  cancelBubble = false
  private state: EventState

  constructor(type: string, options?: EventInit) {
    this.type = type
    this.bubbles = options?.bubbles ?? false
    this.cancelable = options?.cancelable ?? false
    this.composed = options?.composed ?? false
    this.timeStamp = performance.now()
    this.state = {
      defaultPrevented: false,
      isTrusted: false,
      eventPhase: Event.NONE,
      immediateStopped: false,
    }
  }

  public defaultPrevented(): boolean {
    return this.state.defaultPrevented
  }

  public isTrusted(): boolean {
    return this.state.isTrusted
  }

  public target(): EventTarget | undefined {
    return this.state.target
  }

  public currentTarget(): EventTarget | undefined {
    return this.state.currentTarget
  }

  public srcElement(): EventTarget | undefined {
    return this.state.srcElement
  }

  public eventPhase(): int {
    return this.state.eventPhase
  }

  public immediateStopped(): boolean {
    return this.state.immediateStopped
  }

  preventDefault() {
    if (!this.cancelable) return
    this.state.defaultPrevented = true
    this.returnValue = false
  }

  stopPropagation() {
    this.cancelBubble = true
  }

  stopImmediatePropagation() {
    this.cancelBubble = true
    this.state.immediateStopped = true
  }

  composedPath(): EventTarget[] {
    const target = this.state.currentTarget
    return this.state.eventPhase != Event.NONE && target != undefined ? [target] : []
  }

  dispatchOn(target: EventTarget, run: () => void): boolean {
    if (this.state.eventPhase != Event.NONE) return false
    this.state.target = target
    this.state.srcElement = target
    this.state.currentTarget = target
    this.state.eventPhase = Event.AT_TARGET
    run()
    this.state.currentTarget = undefined
    this.state.eventPhase = Event.NONE
    return true
  }

  protected markTrusted() {
    this.state.isTrusted = true
  }
}

class TrustedEvent extends Event {
  constructor(type: string) {
    super(type)
    this.markTrusted()
  }
}

interface CustomEventInit<T> {
  detail: T
  bubbles?: boolean
  cancelable?: boolean
  composed?: boolean
}

export class CustomEvent<T> extends Event {
  readonly detail: T
  constructor(type: string, options: CustomEventInit<T>) {
    super(type, {
      bubbles: options.bubbles,
      cancelable: options.cancelable,
      composed: options.composed,
    })
    this.detail = options.detail
  }
}

export interface EventListenerObject {
  handleEvent(event: Event): void
}

export interface AddEventListenerOptions {
  once?: boolean
  capture?: boolean
  passive?: boolean
  signal?: AbortSignal
}

class Listener {
  next?: Listener
  removed = false
  readonly order = libOrder()
  constructor(
    readonly callback: (event: Event) => void,
    readonly original: unknown,
    readonly once: boolean,
    readonly capture: boolean,
  ) {}
}

export class EventTarget {
  private events?: Map<string, Listener>

  private addFunctionListener<E extends Event>(
    type: string,
    listener: (event: E) => void,
    options?: AddEventListenerOptions,
  ) {
    const callback = (event: Event) => {
      const wanted = asClass<E>(event)
      if (wanted != undefined) listener(wanted)
    }
    this.add(type, callback, listener, options)
  }

  private addObjectListener(
    type: string,
    listener: EventListenerObject,
    options?: AddEventListenerOptions,
  ) {
    this.add(type, (event: Event) => listener.handleEvent(event), listener, options)
  }

  private add(
    type: string,
    callback: (event: Event) => void,
    original: unknown,
    options?: AddEventListenerOptions,
  ) {
    const signal = options?.signal
    if (signal != undefined && signal.aborted()) return
    const capture = options?.capture ?? false
    let events = this.events
    if (events == undefined) {
      events = new Map<string, Listener>()
      this.events = events
    }
    let root = events.get(type)
    if (root == undefined) {
      root = new Listener(noListener, undefined, false, false)
      events.set(type, root)
    }
    let last = root
    for (let at = root.next; at != undefined; at = at.next) {
      if (at.original == original && at.capture == capture) return
      last = at
    }
    last.next = new Listener(callback, original, options?.once ?? false, capture)
    if (signal != undefined) {
      const remove = (_event: Event) => this.removeListenerOf(type, original, capture)
      signal.addEventListener("abort", remove, { once: true })
    }
  }

  private removeListenerWith(type: string, listener: unknown, options?: { capture?: boolean }) {
    this.removeListenerOf(type, listener, options?.capture ?? false)
  }

  private removeListenerOf(type: string, original: unknown, capture: boolean) {
    const root = this.events?.get(type)
    if (root == undefined) return
    let previous = root
    for (let at = root.next; at != undefined; at = at.next) {
      if (at.original == original && at.capture == capture) {
        at.removed = true
        previous.next = at.next
        return
      }
      previous = at
    }
  }

  protected runtimeListeners(type: string, order: double) {
    void type
    void order
  }

  dispatchEvent(event: Event): boolean {
    const ran = event.dispatchOn(this, () => {
      const root = this.events?.get(event.type)
      let handler = root?.next
      while (handler != undefined) {
        const next: Listener | undefined = handler.next
        this.runtimeListeners(event.type, handler.order)
        if (handler.removed || event.immediateStopped()) {
          handler = next
          continue
        }
        if (handler.once) this.removeListenerOf(event.type, handler.original, handler.capture)
        handler.callback(event)
        handler = next
      }
      this.runtimeListeners(event.type, Number.MAX_VALUE)
    })
    return ran && !event.defaultPrevented()
  }

  private listenersOf(type: string): unknown[] {
    const out: unknown[] = []
    const root = this.events?.get(type)
    for (let at = root?.next; at != undefined; at = at.next) out.push(at.original)
    return out
  }
}

export class AbortSignal extends EventTarget {
  onabort?: (event: Event) => void
  private isAborted: boolean
  private abortReason: unknown
  private native: object = signalNew()
  private dependants?: AbortSignal[]
  private onabortListens = false

  private constructor() {
    super()
    this.isAborted = false
    this.abortReason = undefined
  }

  public aborted(): boolean {
    return this.isAborted
  }

  public reason(): unknown {
    return this.abortReason
  }

  static withAbort(): { signal: AbortSignal; abort: (reason: unknown) => void } {
    const signal = new AbortSignal()
    return { signal, abort: (reason: unknown) => signal.abort(reason) }
  }

  protected runtimeListeners(type: string, order: double) {
    if (type == "abort") libSignalRun(this.native, order)
  }

  private setOnabort(handler?: (event: Event) => void) {
    this.onabort = handler
    if (this.onabortListens) return
    this.onabortListens = true
    this.addEventListener("abort", runOnabort)
  }

  private abort(reason: unknown) {
    if (this.isAborted) return
    const followers: AbortSignal[] = []
    this.markAborted(reason, followers)
    this.runAbort()
    for (const follower of followers) follower.runAbort()
  }

  private markAborted(reason: unknown, followers: AbortSignal[]) {
    this.isAborted = true
    this.abortReason = reason
    libSignalAbort(this.native, reason)
    const dependants = this.dependants
    this.dependants = undefined
    if (dependants == undefined) return
    for (const signal of dependants)
      if (!signal.isAborted) {
        followers.push(signal)
        signal.markAborted(reason, followers)
      }
  }

  private runAbort() {
    this.dispatchEvent(new TrustedEvent("abort"))
  }

  static abort(reason?: unknown): AbortSignal {
    const signal = new AbortSignal()
    signal.markAborted(reason ?? new DOMException("This operation was aborted", "AbortError"), [])
    return signal
  }

  static timeout(delay: double): AbortSignal {
    const signal = new AbortSignal()
    setTimeout(() => {
      signal.abort(new DOMException("The operation was aborted due to timeout", "TimeoutError"))
    }, delay).unref()
    return signal
  }

  static any(signals: AbortSignal[]): AbortSignal {
    const result = new AbortSignal()
    for (const signal of signals)
      if (signal.isAborted) {
        result.markAborted(signal.abortReason, [])
        return result
      }
    for (const signal of signals) {
      const dependants = signal.dependants ?? []
      if (!dependants.includes(result)) dependants.push(result)
      signal.dependants = dependants
    }
    return result
  }
}

export class AbortController {
  readonly signal: AbortSignal
  private cancel: (reason: unknown) => void

  constructor() {
    const made = AbortSignal.withAbort()
    this.signal = made.signal
    this.cancel = made.abort
  }

  abort(reason?: unknown) {
    this.cancel(reason ?? new DOMException("This operation was aborted", "AbortError"))
  }
}

function runOnabort(event: Event) {
  const signal = event.currentTarget()
  if (!(signal instanceof AbortSignal)) return
  const handler = signal.onabort
  if (handler != undefined) handler(event)
}

function noListener(event: Event) {}
