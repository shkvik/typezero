import { AbortSignal, Event, EventTarget } from "tz:web"
import { asListener, defer } from "tz:intrinsics"

declare function libBare(map: Record<string, unknown>): Record<string, unknown>
declare function libClassName(object: object): string
declare function libInspect(value: unknown): string
declare function libPid(): int

class OnceWrapper {
  private wasFired = false
  constructor(readonly listener: unknown) {}
  fired() {
    return this.wasFired
  }
  markFired() {
    this.wasFired = true
  }
}

class AsyncListener {
  constructor(readonly listener: unknown) {}
}

class ThisListener {
  constructor(readonly listener: unknown) {}
}

class UnknownArgListener {
  constructor(readonly listener: unknown) {}
}

const kPlain = 0
const kAsync = 1
const kThis = 2
const kUnknownArg = 3

class ListenerList {
  constructor(public items: unknown[]) {}
  private emitting = 0
  warned = false
  begin() {
    this.emitting++
    return this.items
  }
  done(items: unknown[]) {
    if (items == this.items) this.emitting--
  }
  changing() {
    if (this.emitting > 0) {
      this.items = [...this.items]
      this.emitting = 0
    }
    return this.items
  }
}

function aborted(): AbortError {
  return { code: "ABORT_ERR", message: "The operation was aborted" }
}

export class EventEmitterBase {
  private events: Record<string, unknown> = libBare({})
  private eventsCount = 0
  private maxListeners?: double
  private shapeMode = false
  private capture = false

  setMaxListeners(n: double) {
    this.maxListeners = validNumber(n, 0)
    return this
  }

  getMaxListeners() {
    return this.maxListeners ?? EventEmitter.defaultMaxListeners
  }

  emit<A extends unknown[]>(type: string, ...args: A): boolean {
    const events = this.events
    const handler = events[type]
    if (handler == undefined) return false
    if (handler instanceof ListenerList) {
      const listeners = handler.begin()
      for (const listener of listeners) this.run(type, listener, ...args)
      handler.done(listeners)
    } else {
      this.run(type, handler, ...args)
    }
    return true
  }

  emitWithUnknown<A extends unknown[]>(type: string, boxed: unknown, ...args: A): boolean {
    const handler = this.events[type]
    if (handler == undefined) return false
    if (handler instanceof ListenerList) {
      const listeners = handler.begin()
      for (const listener of listeners) this.runWithUnknown(type, listener, boxed, ...args)
      handler.done(listeners)
    } else {
      this.runWithUnknown(type, handler, boxed, ...args)
    }
    return true
  }

  private runWithUnknown<A extends unknown[]>(type: string, listener: unknown, boxed: unknown,
                                       ...args: A) {
    if (listener instanceof UnknownArgListener) {
      asListener<(arg: unknown) => void>(listener.listener)(boxed)
      return
    }
    this.run(type, listener, ...args)
  }

  private run<A extends unknown[]>(type: string, listener: unknown, ...args: A) {
    let fn = listener
    if (fn instanceof OnceWrapper) {
      if (fn.fired()) return
      this.removeListener(type, fn)
      fn.markFired()
      fn = fn.listener
    }
    if (fn instanceof AsyncListener) {
      const promise = asListener<(...args: A) => Promise<void>>(fn.listener)(...args)
      void promise
      return
    }
    if (fn instanceof ThisListener) {
      asListener<(this: unknown, ...args: A) => void>(fn.listener).call(this, ...args)
      return
    }
    if (fn instanceof UnknownArgListener) {
      asListener<(arg: unknown) => void>(fn.listener)(firstArg(...args))
      return
    }
    asListener<(...args: A) => void>(fn)(...args)
  }

  private insertListener(type: string, listener: unknown, prepend: boolean) {
    let events = this.events
    if (events["newListener"] != undefined) {
      this.emit("newListener", type, original(listener))
      events = this.events
    }
    const existing = events[type]
    if (existing == undefined) {
      events[type] = listener
      ++this.eventsCount
      return this
    }
    let holder: ListenerList
    if (existing instanceof ListenerList) {
      holder = existing
      const list = existing.changing()
      if (prepend) list.unshift(listener)
      else list.push(listener)
    } else {
      holder = new ListenerList(prepend ? [listener, existing] : [existing, listener])
      events[type] = holder
    }
    const list = holder.items
    const m = this.getMaxListeners()
    if (m > 0 && list.length.toDouble() > m && !holder.warned) {
      holder.warned = true
      emitWarning(
        "MaxListenersExceededWarning",
        `Possible EventEmitter memory leak detected. ${list.length} ${type} listeners added to ` +
          `[${libClassName(this)}]. MaxListeners is ${m}. Use emitter.setMaxListeners() to ` +
          `increase limit`,
      )
    }
    return this
  }

  addListener(type: string, listener: unknown, kind: int = kPlain) {
    return this.insertListener(type, wrap(listener, kind), false)
  }

  on(type: string, listener: unknown, kind: int = kPlain) {
    return this.insertListener(type, wrap(listener, kind), false)
  }

  prependListener(type: string, listener: unknown, kind: int = kPlain) {
    return this.insertListener(type, wrap(listener, kind), true)
  }

  once(type: string, listener: unknown, kind: int = kPlain) {
    this.on(type, new OnceWrapper(wrap(listener, kind)))
    return this
  }

  prependOnceListener(type: string, listener: unknown, kind: int = kPlain) {
    this.prependListener(type, new OnceWrapper(wrap(listener, kind)))
    return this
  }

  removeListener(type: string, listener: unknown) {
    const events = this.events
    const kept = events[type]
    if (kept == undefined) return this
    if (!(kept instanceof ListenerList)) {
      const list = kept
      if (!same(list, listener)) return this
      this.eventsCount -= 1
      if (this.eventsCount == 0) this.events = libBare({})
      else delete events[type]
      if (events["removeListener"] != undefined)
        this.emit("removeListener", type, original(list))
      return this
    }
    const list = kept.changing()
    let position = -1
    for (let i = list.length - 1; i >= 0; i--) {
      if (same(list[i], listener)) {
        position = i
        break
      }
    }
    if (position < 0) return this
    if (position == 0) list.shift()
    else list.splice(position, 1)
    if (list.length == 1) events[type] = list[0]
    if (events["removeListener"] != undefined) this.emit("removeListener", type, listener)
    return this
  }

  off(type: string, listener: unknown) {
    return this.removeListener(type, listener)
  }

  removeAllListeners(type?: string) {
    const events = this.events
    if (events["removeListener"] == undefined) {
      if (type == undefined) {
        this.events = libBare({})
        this.eventsCount = 0
      } else if (events[type] != undefined) {
        if (--this.eventsCount == 0) this.events = libBare({})
        else delete events[type]
      }
      this.shapeMode = false
      return this
    }
    if (type == undefined) {
      for (const key of ownKeys(events)) {
        if (key == "removeListener") continue
        this.removeAllListeners(key)
      }
      this.removeAllListeners("removeListener")
      this.events = libBare({})
      this.eventsCount = 0
      this.shapeMode = false
      return this
    }
    const listeners = events[type]
    if (listeners instanceof ListenerList) {
      const items = listeners.items
      for (let i = items.length - 1; i >= 0; i--) this.removeListener(type, items[i])
    } else if (listeners != undefined) {
      this.removeListener(type, listeners)
    }
    return this
  }

  private listeners(type: string, raw: boolean): unknown[] {
    const evlistener = this.events[type]
    if (evlistener == undefined) return []
    if (!(evlistener instanceof ListenerList)) return [raw ? evlistener : original(evlistener)]
    return raw ? [...evlistener.items] : evlistener.items.map((l) => original(l))
  }

  private listenersOf<A extends unknown[]>(type: string, raw: boolean): ((...args: A) => void)[] {
    const out: ((...args: A) => void)[] = []
    for (const listener of this.listeners(type, raw)) out.push(this.callable<A>(type, listener))
    return out
  }

  private callable<A extends unknown[]>(type: string, listener: unknown): (...args: A) => void {
    if (listener instanceof OnceWrapper || listener instanceof AsyncListener ||
        listener instanceof ThisListener || listener instanceof UnknownArgListener)
      return (...args: A) => this.run(type, listener, ...args)
    return asListener<(...args: A) => void>(listener)
  }

  listenerCount(type: string, listener?: unknown): int {
    const evlistener = this.events[type]
    if (evlistener == undefined) return 0
    if (!(evlistener instanceof ListenerList)) {
      if (listener != undefined) return same(evlistener, listener) ? 1 : 0
      return 1
    }
    if (listener != undefined) {
      let matching = 0
      for (const l of evlistener.items) if (same(l, listener)) matching++
      return matching
    }
    return evlistener.items.length
  }

  eventNames(): string[] {
    return this.eventsCount > 0 ? ownKeys(this.events) : []
  }
}

export class EventEmitter<Events> extends EventEmitterBase {
  static defaultMaxListeners: double = 10
}

export function once<A extends unknown[], R extends unknown[]>(
  emitter: EventEmitterBase,
  name: string,
  options?: { signal?: AbortSignal },
  errors = false,
): Promise<A> {
  void options
  void errors
  return new Promise<A>((resolve) => {
    function resolver(...args: A) {
      resolve(args)
    }
    emitter.once(name, resolver)
  })
}

function onceResult<A extends unknown[], E>(
  emitter: EventEmitterBase,
  name: string,
  options?: { signal?: AbortSignal },
  errors = false,
): Promise<Result<A, E | AbortError>> {
  const signal = options?.signal
  if (signal != undefined && signal.aborted()) {
    const failed: Result<A, E | AbortError> = err(aborted())
    return Promise.resolve(failed)
  }
  return new Promise<Result<A, E | AbortError>>((resolve) => {
    function errorListener(error: E) {
      emitter.removeListener(name, resolver)
      if (signal != undefined) signal.removeEventListener("abort", abortListener)
      resolve(err(error))
    }
    function resolver(...args: A) {
      if (errors) emitter.removeListener("error", errorListener)
      if (signal != undefined) signal.removeEventListener("abort", abortListener)
      resolve(ok(args))
    }
    function abortListener(_event: Event) {
      emitter.removeListener(name, resolver)
      emitter.removeListener("error", errorListener)
      resolve(err(aborted()))
    }
    emitter.once(name, resolver)
    if (errors && name != "error") emitter.once("error", errorListener)
    if (signal != undefined)
      signal.addEventListener("abort", abortListener, { once: true })
  })
}

export function on<A extends unknown[], R extends unknown[]>(
  emitter: EventEmitterBase,
  name: string,
  options?: { signal?: AbortSignal; close?: string[] },
  errors = false,
) {
  void errors
  const queue = new EventQueue<A, AbortError>()
  const close = options?.close ?? []
  function eventHandler(...args: A) {
    queue.push(args)
  }
  function closeHandler() {
    queue.finish()
  }
  emitter.on(name, eventHandler)
  for (const closeName of close) emitter.on(closeName, closeHandler)
  return queue.items(() => {
    emitter.removeListener(name, eventHandler)
    for (const closeName of close) emitter.removeListener(closeName, closeHandler)
  })
}

function onResult<A extends unknown[], E>(
  emitter: EventEmitterBase,
  name: string,
  options?: { signal?: AbortSignal; close?: string[] },
  errors = false,
) {
  const signal = options?.signal
  const queue = new EventQueue<A, E | AbortError>()
  const close = options?.close ?? []
  function eventHandler(...args: A) {
    queue.push(args)
  }
  function errorHandler(error: E) {
    queue.fail(error)
  }
  function closeHandler() {
    queue.finish()
  }
  function abortListener(_event: Event) {
    queue.fail(aborted())
  }
  if (signal != undefined && signal.aborted()) queue.fail(aborted())
  emitter.on(name, eventHandler)
  if (errors && name != "error") emitter.on("error", errorHandler)
  for (const closeName of close) emitter.on(closeName, closeHandler)
  if (signal != undefined)
    signal.addEventListener("abort", abortListener, { once: true })
  return queue.results(() => {
    emitter.removeListener(name, eventHandler)
    emitter.removeListener("error", errorHandler)
    for (const closeName of close) emitter.removeListener(closeName, closeHandler)
    if (signal != undefined) signal.removeEventListener("abort", abortListener)
  })
}

class EventQueue<A extends unknown[], F> {
  private events: A[] = []
  private error?: F
  private finished = false
  private wake?: () => void

  push(args: A) {
    if (this.finished) return
    this.events.push(args)
    this.poke()
  }

  fail(error: F) {
    if (this.finished) return
    this.error = error
    this.finished = true
    this.poke()
  }

  finish() {
    this.finished = true
    this.poke()
  }

  private poke() {
    const wake = this.wake
    this.wake = undefined
    if (wake != undefined) wake()
  }

  private stopper(stop: () => void) {
    return defer(() => {
      this.finished = true
      this.wake = undefined
      stop()
    })
  }

  async *items(stop: () => void) {
    const stopper = this.stopper(stop)
    while (true) {
      const next = this.events.shift()
      if (next != undefined) {
        yield next
        continue
      }
      if (this.finished) return
      await new Promise<void>((resolve) => {
        this.wake = resolve
      })
    }
  }

  async *results(stop: () => void) {
    const stopper = this.stopper(stop)
    while (true) {
      const next = this.events.shift()
      if (next != undefined) {
        const item: Result<A, F> = ok(next)
        yield item
        continue
      }
      const error = this.error
      if (error != undefined) {
        const item: Result<A, F> = err(error)
        yield item
        return
      }
      if (this.finished) return
      await new Promise<void>((resolve) => {
        this.wake = resolve
      })
    }
  }
}

export function listenerCount(emitter: EventEmitterBase, name: string) {
  return emitter.listenerCount(name)
}

export function getMaxListeners(emitter: EventEmitterBase) {
  return emitter.getMaxListeners()
}

export function setMaxListeners(
  n: double = EventEmitter.defaultMaxListeners,
  ...targets: EventEmitterBase[]
) {
  const checked = validNumber(n, 0)
  if (targets.length == 0) EventEmitter.defaultMaxListeners = checked
  else for (const target of targets) target.setMaxListeners(checked)
}

function wrap(listener: unknown, kind: int): unknown {
  if (kind == kAsync) return new AsyncListener(listener)
  if (kind == kThis) return new ThisListener(listener)
  if (kind == kUnknownArg) return new UnknownArgListener(listener)
  return listener
}

function original(listener: unknown): unknown {
  if (listener instanceof OnceWrapper) return original(listener.listener)
  if (listener instanceof AsyncListener) return listener.listener
  if (listener instanceof ThisListener) return listener.listener
  if (listener instanceof UnknownArgListener) return listener.listener
  return listener
}

function same(kept: unknown, listener: unknown) {
  return kept == listener || original(kept) == listener
}

function firstArg(...args: unknown[]): unknown {
  return args.length > 0 ? args[0] : undefined
}

function ownKeys(events: Record<string, unknown>): string[] {
  const keys = Object.keys(events)
  const indices = keys.filter((k) => isArrayIndex(k))
  if (indices.length == 0) return keys
  indices.sort((a, b) => Number(a).unwrapOr(0) - Number(b).unwrapOr(0))
  return [...indices, ...keys.filter((k) => !isArrayIndex(k))]
}

function isArrayIndex(key: string) {
  return /^(0|[1-9][0-9]*)$/.test(key) && Number(key).unwrapOr(4294967295) < 4294967295
}

function validNumber(value: double, min: double): double {
  return value < min ? min : value
}

function emitWarning(name: string, message: string) {
  process.nextTick(() => console.error(`(node:${libPid()}) ${name}: ${message}`))
}

function onceTarget(
  target: EventTarget,
  name: string,
  options?: { signal?: AbortSignal },
): Promise<[Event]> {
  void options
  return new Promise<[Event]>((resolve) => {
    function resolver(event: Event) {
      resolve([event])
    }
    target.addEventListener(name, resolver, { once: true })
  })
}

function onceTargetResult(
  target: EventTarget,
  name: string,
  options?: { signal?: AbortSignal },
): Promise<Result<[Event], AbortError>> {
  const signal = options?.signal
  if (signal != undefined && signal.aborted()) {
    const failed: Result<[Event], AbortError> = err(aborted())
    return Promise.resolve(failed)
  }
  return new Promise<Result<[Event], AbortError>>((resolve) => {
    function resolver(event: Event) {
      if (signal != undefined) signal.removeEventListener("abort", abortListener)
      resolve(ok([event]))
    }
    function abortListener(_event: Event) {
      target.removeEventListener(name, resolver)
      resolve(err(aborted()))
    }
    target.addEventListener(name, resolver, { once: true })
    if (signal != undefined)
      signal.addEventListener("abort", abortListener, { once: true })
  })
}

export function getEventListeners(emitter: EventEmitterBase, name: string) {
  void emitter
  void name
}
