import { Event, EventTarget } from "tz:web"
import { asBoundListener, asListener, defer } from "tz:intrinsics"

declare function libBare(map: Record<string, unknown>): Record<string, unknown>
declare function listenerCode(listener: unknown): unknown
declare function listenerWeak(listener: unknown): object
declare function boundListener(code: unknown, weak: object): unknown
declare function weakTarget(weak: object): object | undefined
declare function weakIs(weak: object, listener: unknown): boolean
declare function sameCode(a: unknown, b: unknown): boolean
declare function weakAlive(weak: object): boolean

const kPlain = 0
const kAsync = 1
const kThis = 2
const kUnknownArg = 3
const kAdapt = 15
const kReceiver = 16
const kDedupe = 32

class Listener {
  fired: boolean
  constructor(
    readonly code: unknown,
    readonly weak: object | undefined,
    readonly kind: int,
    readonly once: boolean,
  ) {
    this.fired = false
  }

  alive(): boolean {
    const weak = this.weak
    return weak == undefined || weakAlive(weak)
  }

  matches(listener: unknown): boolean {
    const weak = this.weak
    if (weak == undefined) return this.code == listener
    return sameCode(this.code, listener) && weakIs(weak, listener)
  }

  repeats(listener: unknown, kind: int, once: boolean): boolean {
    if (this.once != once || (this.kind & kAdapt) != (kind & kAdapt)) return false
    const weak = this.weak
    if ((kind & kReceiver) == 0) return weak == undefined && sameCode(this.code, listener)
    return weak != undefined && sameCode(this.code, listener) && weakIs(weak, listener)
  }

  function(): unknown {
    const weak = this.weak
    if (weak == undefined) return this.code
    return boundListener(this.code, weak)
  }
}

class ListenerList {
  private emitting: int
  sweepAt: int
  constructor(public items: Listener[]) {
    this.emitting = 0
    this.sweepAt = 8
  }
  begin() {
    this.emitting++
    return this.items
  }
  done(items: Listener[]) {
    if (items == this.items) this.emitting--
  }
  changing() {
    if (this.emitting > 0) {
      this.items = [...this.items]
      this.emitting = 0
    }
    return this.items
  }
}

export class EventEmitterBase {
  private events: Record<string, unknown>
  private eventsCount: int
  private shapeMode: boolean
  private capture: boolean

  constructor() {
    this.events = libBare({})
    this.eventsCount = 0
    this.shapeMode = false
    this.capture = false
  }

  emit<A extends unknown[]>(type: string, ...args: A): boolean {
    const handler = this.events[type]
    if (!(handler instanceof ListenerList)) return false
    const listeners = handler.begin()
    let called = false
    let dead = false
    for (const listener of listeners) {
      if (this.run(type, listener, ...args)) called = true
      else dead = true
    }
    handler.done(listeners)
    if (dead) this.sweep(type)
    return called
  }

  emitWithUnknown<A extends unknown[]>(type: string, boxed: unknown, ...args: A): boolean {
    const handler = this.events[type]
    if (!(handler instanceof ListenerList)) return false
    const listeners = handler.begin()
    let called = false
    let dead = false
    for (const listener of listeners) {
      if (this.runWithUnknown(type, listener, boxed, ...args)) called = true
      else dead = true
    }
    handler.done(listeners)
    if (dead) this.sweep(type)
    return called
  }

  private runWithUnknown<A extends unknown[]>(type: string, listener: Listener, boxed: unknown,
                                       ...args: A): boolean {
    if ((listener.kind & kAdapt) == kUnknownArg && !listener.once) {
      const weak = listener.weak
      if (weak == undefined) {
        asListener<(arg: unknown) => void>(listener.code)(boxed)
        return true
      }
      const receiver = weakTarget(weak)
      if (receiver == undefined) return false
      asBoundListener<(arg: unknown) => void>(listener.code, receiver)(boxed)
      return true
    }
    return this.run(type, listener, ...args)
  }

  private run<A extends unknown[]>(type: string, listener: Listener, ...args: A): boolean {
    if (listener.once) {
      if (listener.fired) return true
      listener.fired = true
      this.removeRecord(type, listener)
    }
    const weak = listener.weak
    const adapt = listener.kind & kAdapt
    if (weak == undefined) {
      if (adapt == kPlain) asListener<(...args: A) => void>(listener.code)(...args)
      else this.call(listener.code, adapt, ...args)
      return true
    }
    const receiver = weakTarget(weak)
    if (receiver == undefined) return false
    if (adapt == kPlain) asBoundListener<(...args: A) => void>(listener.code, receiver)(...args)
    else this.callBound(listener.code, receiver, adapt, ...args)
    return true
  }

  private call<A extends unknown[]>(code: unknown, adapt: int, ...args: A) {
    if (adapt == kPlain) {
      asListener<(...args: A) => void>(code)(...args)
    } else if (adapt == kAsync) {
      const promise = asListener<(...args: A) => Promise<void>>(code)(...args)
      void promise
    } else if (adapt == kThis) {
      asListener<(this: unknown, ...args: A) => void>(code).call(this, ...args)
    } else {
      asListener<(arg: unknown) => void>(code)(firstArg(...args))
    }
  }

  private callBound<A extends unknown[]>(code: unknown, receiver: object, adapt: int, ...args: A) {
    if (adapt == kPlain) {
      asBoundListener<(...args: A) => void>(code, receiver)(...args)
    } else if (adapt == kAsync) {
      const promise = asBoundListener<(...args: A) => Promise<void>>(code, receiver)(...args)
      void promise
    } else if (adapt == kThis) {
      asBoundListener<(this: unknown, ...args: A) => void>(code, receiver).call(this, ...args)
    } else {
      asBoundListener<(arg: unknown) => void>(code, receiver)(firstArg(...args))
    }
  }

  private sweep(type: string) {
    const handler = this.events[type]
    if (!(handler instanceof ListenerList)) return
    const live = handler.changing().filter((listener) => listener.alive())
    handler.items = live
    handler.sweepAt = 2 * live.length + 8
    if (live.length == 0) this.dropType(type)
  }

  private dropType(type: string) {
    this.eventsCount -= 1
    if (this.eventsCount == 0) this.events = libBare({})
    else delete this.events[type]
  }

  private insertListener(type: string, listener: unknown, kind: int, once: boolean,
                         prepend: boolean) {
    const before = this.events[type]
    if ((kind & kDedupe) != 0 && before instanceof ListenerList) {
      for (const kept of before.items) {
        if (kept.repeats(listener, kind, once) && kept.alive()) return this
      }
    }
    let events = this.events
    if (events["newListener"] != undefined) {
      this.emit("newListener", { event: type, listener: listener })
      events = this.events
    }
    const existing = events[type]
    const record =
      (kind & kReceiver) != 0
        ? new Listener(listenerCode(listener), listenerWeak(listener), kind, once)
        : new Listener(listener, undefined, kind, once)
    if (!(existing instanceof ListenerList)) {
      events[type] = new ListenerList([record])
      ++this.eventsCount
      return this
    }
    const list = existing.changing()
    if (prepend) list.unshift(record)
    else list.push(record)
    if (list.length >= existing.sweepAt) this.sweep(type)
    return this
  }

  addListener(type: string, listener: unknown, kind: int = kPlain) {
    return this.insertListener(type, listener, kind, false, false)
  }

  on(type: string, listener: unknown, kind: int = kPlain) {
    return this.insertListener(type, listener, kind, false, false)
  }

  prependListener(type: string, listener: unknown, kind: int = kPlain) {
    return this.insertListener(type, listener, kind, false, true)
  }

  once(type: string, listener: unknown, kind: int = kPlain) {
    return this.insertListener(type, listener, kind, true, false)
  }

  prependOnceListener(type: string, listener: unknown, kind: int = kPlain) {
    return this.insertListener(type, listener, kind, true, true)
  }

  private removeRecord(type: string, record: Listener) {
    const kept = this.events[type]
    if (!(kept instanceof ListenerList)) return
    const list = kept.changing()
    const position = list.indexOf(record)
    if (position < 0) return
    list.splice(position, 1)
    if (list.length == 0) this.dropType(type)
    if (this.events["removeListener"] != undefined) {
      const fn = record.function()
      if (fn != undefined) this.emit("removeListener", { event: type, listener: fn })
    }
  }

  removeListener(type: string, listener: unknown) {
    const kept = this.events[type]
    if (!(kept instanceof ListenerList)) return this
    const items = kept.items
    for (let i = items.length - 1; i >= 0; i--) {
      const record = items[i]
      if (record != undefined && record.matches(listener)) {
        this.removeRecord(type, record)
        return this
      }
    }
    return this
  }

  off(type: string, listener: unknown) {
    return this.removeListener(type, listener)
  }

  removeAllListeners(type?: string) {
    const events = this.events
    if (events["removeListener"] == undefined) {
      if (type == undefined) {
        this.events = libBare({})
        this.eventsCount = 0
      } else if (events[type] != undefined) {
        this.dropType(type)
      }
      this.shapeMode = false
      return this
    }
    if (type == undefined) {
      for (const key of ownKeys(events)) {
        if (key == "removeListener") continue
        this.removeAllListeners(key)
      }
      this.removeAllListeners("removeListener")
      this.events = libBare({})
      this.eventsCount = 0
      this.shapeMode = false
      return this
    }
    const listeners = events[type]
    if (listeners instanceof ListenerList) {
      const items = [...listeners.items]
      for (let i = items.length - 1; i >= 0; i--) {
        const record = items[i]
        if (record != undefined) this.removeRecord(type, record)
      }
    }
    return this
  }

  private records(type: string): Listener[] {
    const handler = this.events[type]
    if (!(handler instanceof ListenerList)) return []
    return handler.items.filter((listener) => listener.alive())
  }

  private listenersOf<A extends unknown[]>(type: string, raw: boolean): ((...args: A) => void)[] {
    const out: ((...args: A) => void)[] = []
    for (const listener of this.records(type)) {
      const plain = (listener.kind & kAdapt) == kPlain
      if (plain && (!raw || !listener.once)) {
        const fn = listener.function()
        if (fn != undefined) out.push(asListener<(...args: A) => void>(fn))
        continue
      }
      out.push((...args: A) => {
        this.run(type, listener, ...args)
      })
    }
    return out
  }

  listenerCount(type: string, listener?: unknown): int {
    let matching = 0
    for (const kept of this.records(type)) {
      if (listener == undefined || kept.matches(listener)) matching++
    }
    return matching
  }

  eventNames(): string[] {
    if (this.eventsCount == 0) return []
    return ownKeys(this.events).filter((name) => this.records(name).length > 0)
  }
}

export class EventEmitter<Events> extends EventEmitterBase {}

export function once<A extends unknown[], R extends unknown[]>(
  emitter: EventEmitterBase,
  name: string,
  errors = false,
): Promise<A> {
  void errors
  return new Promise<A>((resolve) => {
    function resolver(...args: A) {
      resolve(args)
    }
    emitter.once(name, resolver)
  })
}

function onceResult<A extends unknown[], E>(
  emitter: EventEmitterBase,
  name: string,
  errors = false,
): Promise<Result<A, E>> {
  return new Promise<Result<A, E>>((resolve) => {
    function errorListener(error: E) {
      emitter.removeListener(name, resolver)
      resolve(err(error))
    }
    function resolver(...args: A) {
      if (errors) emitter.removeListener("error", errorListener)
      resolve(ok(args))
    }
    emitter.once(name, resolver)
    if (errors && name != "error") emitter.once("error", errorListener)
  })
}

export type EventTimeoutError = {
  kind: "EVENT_TIMEOUT_ERROR"
  code: "TIMEOUT_ERR"
  message: string
  event: string
  timeout: int
}

function eventTimeoutError(name: string, timeout: int): EventTimeoutError {
  return {
    kind: "EVENT_TIMEOUT_ERROR",
    code: "TIMEOUT_ERR",
    message: `no '${name}' within ${timeout} ms`,
    event: name,
    timeout: timeout,
  }
}

function onceWithin<A extends unknown[], E>(
  emitter: EventEmitterBase,
  name: string,
  options: { timeout: int },
  errors = false,
): Promise<Result<A, E | EventTimeoutError>> {
  const queue = new EventQueue<A, E | EventTimeoutError>()
  const timeout = options.timeout
  queue.within(timeout, () => eventTimeoutError(name, timeout))
  function eventHandler(...args: A) {
    queue.push(args)
  }
  function errorHandler(error: E) {
    queue.fail(error)
  }
  emitter.once(name, eventHandler)
  if (errors && name != "error") emitter.once("error", errorHandler)
  return queue.next(() => {
    emitter.removeListener(name, eventHandler)
    emitter.removeListener("error", errorHandler)
  })
}

function onWithin<A extends unknown[], E>(
  emitter: EventEmitterBase,
  name: string,
  options: { close?: string[]; timeout: int },
  errors = false,
) {
  const queue = new EventQueue<A, E | EventTimeoutError>()
  const timeout = options.timeout
  queue.within(timeout, () => eventTimeoutError(name, timeout))
  const close = options.close ?? []
  function eventHandler(...args: A) {
    queue.push(args)
  }
  function errorHandler(error: E) {
    queue.fail(error)
  }
  function closeHandler() {
    queue.finish()
  }
  emitter.on(name, eventHandler)
  if (errors && name != "error") emitter.on("error", errorHandler)
  for (const closeName of close) emitter.on(closeName, closeHandler)
  return queue.results(() => {
    emitter.removeListener(name, eventHandler)
    emitter.removeListener("error", errorHandler)
    for (const closeName of close) emitter.removeListener(closeName, closeHandler)
  })
}

export function on<A extends unknown[], R extends unknown[]>(
  emitter: EventEmitterBase,
  name: string,
  options?: { close?: string[] },
  errors = false,
) {
  void errors
  const queue = new EventQueue<A, never>()
  const close = options?.close ?? []
  function eventHandler(...args: A) {
    queue.push(args)
  }
  function closeHandler() {
    queue.finish()
  }
  emitter.on(name, eventHandler)
  for (const closeName of close) emitter.on(closeName, closeHandler)
  return queue.items(() => {
    emitter.removeListener(name, eventHandler)
    for (const closeName of close) emitter.removeListener(closeName, closeHandler)
  })
}

function onResult<A extends unknown[], E>(
  emitter: EventEmitterBase,
  name: string,
  options?: { close?: string[] },
  errors = false,
) {
  const queue = new EventQueue<A, E>()
  const close = options?.close ?? []
  function eventHandler(...args: A) {
    queue.push(args)
  }
  function errorHandler(error: E) {
    queue.fail(error)
  }
  function closeHandler() {
    queue.finish()
  }
  emitter.on(name, eventHandler)
  if (errors && name != "error") emitter.on("error", errorHandler)
  for (const closeName of close) emitter.on(closeName, closeHandler)
  return queue.results(() => {
    emitter.removeListener(name, eventHandler)
    emitter.removeListener("error", errorHandler)
    for (const closeName of close) emitter.removeListener(closeName, closeHandler)
  })
}

class EventQueue<A extends unknown[], F> {
  private events: A[]
  private error?: F
  private finished: boolean
  private wake?: () => void
  private limit: int
  private expired?: () => F

  constructor() {
    this.events = []
    this.finished = false
    this.limit = 0
  }

  within(limit: int, expired: () => F) {
    this.limit = limit
    this.expired = expired
  }

  push(args: A) {
    if (this.finished) return
    this.events.push(args)
    this.poke()
  }

  fail(error: F) {
    if (this.finished) return
    this.error = error
    this.finished = true
    this.poke()
  }

  finish() {
    this.finished = true
    this.poke()
  }

  private poke() {
    const wake = this.wake
    this.wake = undefined
    if (wake != undefined) wake()
  }

  private async idle() {
    const expired = this.expired
    if (expired == undefined) {
      await new Promise<void>((resolve) => {
        this.wake = resolve
      })
      return
    }
    const expire: () => F = expired
    const timer = setTimeout(() => this.fail(expire()), this.limit)
    await new Promise<void>((resolve) => {
      this.wake = resolve
    })
    clearTimeout(timer)
  }

  async next(stop: () => void): Promise<Result<A, F>> {
    const stopper = this.stopper(stop)
    while (true) {
      const next = this.events.shift()
      if (next != undefined) return ok(next)
      const error = this.error
      if (error != undefined) return err(error)
      await this.idle()
    }
  }

  private stopper(stop: () => void) {
    return defer(() => {
      this.finished = true
      this.wake = undefined
      stop()
    })
  }

  async *items(stop: () => void) {
    const stopper = this.stopper(stop)
    while (true) {
      const next = this.events.shift()
      if (next != undefined) {
        yield next
        continue
      }
      if (this.finished) return
      await this.idle()
    }
  }

  async *results(stop: () => void) {
    const stopper = this.stopper(stop)
    while (true) {
      const next = this.events.shift()
      if (next != undefined) {
        const item: Result<A, F> = ok(next)
        yield item
        continue
      }
      const error = this.error
      if (error != undefined) {
        const item: Result<A, F> = err(error)
        yield item
        return
      }
      if (this.finished) return
      await this.idle()
    }
  }
}

export function listenerCount(emitter: EventEmitterBase, name: string) {
  return emitter.listenerCount(name)
}

function firstArg(...args: unknown[]): unknown {
  return args.length > 0 ? args[0] : undefined
}

function ownKeys(events: Record<string, unknown>): string[] {
  const keys = Object.keys(events)
  const indices = keys.filter((k) => isArrayIndex(k))
  if (indices.length == 0) return keys
  indices.sort((a, b) => Number(a).unwrapOr(0) - Number(b).unwrapOr(0))
  return [...indices, ...keys.filter((k) => !isArrayIndex(k))]
}

function isArrayIndex(key: string) {
  return /^(0|[1-9][0-9]*)$/.test(key) && Number(key).unwrapOr(4294967295) < 4294967295
}

function onceTarget(target: EventTarget, name: string): Promise<[Event]> {
  return new Promise<[Event]>((resolve) => {
    function resolver(event: Event) {
      resolve([event])
    }
    target.addEventListener(name, resolver, { once: true })
  })
}

export function getEventListeners(emitter: EventEmitterBase, name: string) {
  void emitter
  void name
}
