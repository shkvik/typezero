/**
 * The functions of `Reflect`: for code that is written once and does not
 * know the classes of a program, such as a router, a container of services
 * or a reader of requests. The description of a class gets into a program
 * only for the classes these functions reach.
 */
export interface Reflect {
  /** The field or the method of an object by its name. */
  readonly get(target: Read<object>, name: string): unknown;
  /**
   * Calls a function with the object as `this` and the arguments of the
   * array; an error when the arguments do not fit its parameters.
   */
  readonly apply<R>(
    callee: Read<(...args: never[]) => R>,
    self: Read<unknown>,
    args: Read<unknown[]>,
  ): Result<R, ReflectError>;
  readonly apply(
    callee: Read<unknown>,
    self: Read<unknown>,
    args: Read<unknown[]>,
  ): Result<unknown, ReflectError>;
  /** Makes an object of a class known only when the program runs. */
  readonly construct<T>(
    cls: Read<Constructor<T>>,
    args: Read<unknown[]>,
  ): Result<T, ReflectError>;
  /**
   * Makes an object of a class without a constructor and gives its fields
   * the values by their names, each checked against the type of the field.
   */
  readonly fill<T>(
    cls: Read<Constructor<T>>,
    values: Read<Map<string, unknown>>,
  ): Result<T, ReflectFillError>;

  /**
   * Writes a record on a class, or on a member of it. A key is a decorator,
   * a class or a constant, and then its records have the type of what is
   * written; or a string, and then they are `unknown`.
   */
  defineMetadata(
    key: Read<unknown>,
    value: Own<unknown>,
    target: object,
    member?: string,
  ): void;
  /**
   * The record by the key, of the class or of those it extends. The keys
   * "design:type", "design:paramtypes" and "design:returntype" give the
   * types written in the code.
   */
  readonly getMetadata(
    key: Read<unknown>,
    target: Read<object>,
    member?: string,
  ): unknown;
  /** As `getMetadata`, of the class itself only. */
  readonly getOwnMetadata(
    key: Read<unknown>,
    target: Read<object>,
    member?: string,
  ): unknown;
  readonly hasMetadata(
    key: Read<unknown>,
    target: Read<object>,
    member?: string,
  ): boolean;
  readonly hasOwnMetadata(
    key: Read<unknown>,
    target: Read<object>,
    member?: string,
  ): boolean;
  /** Removes the record; whether it was there. */
  deleteMetadata(key: Read<unknown>, target: object, member?: string): boolean;
  /**
   * A decorator that writes the record. It is written only as a decorator,
   * before a class or a member.
   * @example @Reflect.metadata("table", "users")
   */
  readonly metadata(
    key: Read<unknown>,
    value: Own<unknown>,
  ): (cls: Constructor, member?: string) => void;
}

export declare const Reflect: Reflect;

/**
 * What a decorator of a method gets as its third argument: `A` is the types
 * of the parameters of the method and `R` the type of its result. They are
 * not written where the decorator is used: `@Log` over `add(a: int, b: int)`
 * gives `A = [int, int]` by itself.
 */
export interface MethodDescriptor<A extends unknown[], R> {
  /** The method itself; a decorator may put a wrapper in its place. */
  value: (this: unknown, ...args: A) => R;
}
