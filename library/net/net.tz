import { NativeError } from "tz:intrinsics";
import { Duplex, FaultCallback, HookCallback, StreamFault } from "node:stream";
import { URL } from "tz:url";

declare function netConnect(
  host: string,
  port: int,
  deadline: object | undefined,
): Promise<Result<object, NativeError>>;
declare function tlsConnect(
  conn: object,
  host: string,
  deadline: object | undefined,
): Promise<Result<void, NativeError>>;
declare function netClose(conn: object): void;
declare function tcpRead(
  conn: object,
  deadline: object | undefined,
): Promise<Result<Uint8Array | undefined, NativeError>>;
declare function httpWrite(conn: object, chunk: Uint8Array): Promise<Result<void, NativeError>>;
declare function netConnectFrom(
  host: string,
  port: int,
  localAddress: string,
  localPort: int,
  deadline: object | undefined,
): Promise<Result<object, NativeError>>;
declare function netConnectPath(path: string): Promise<Result<object, NativeError>>;
declare function netSocketOption(conn: object, option: int, value: int): boolean;
declare function netLocalHost(conn: object): string;
declare function netLocalPort(conn: object): int;
declare function tcpShutdown(conn: object): void;
declare function tcpReset(conn: object): void;
declare function netListenSocket(
  host: string,
  port: int,
  idle: int,
  backlog: int,
  flags: int,
): Result<object, NativeError>;
declare function netListenPath(path: string, idle: int, backlog: int): Result<object, NativeError>;
declare function netListenerPort(listener: object): int;
declare function netAccept(listener: object): Promise<object | undefined>;
declare function netCloseListener(listener: object): void;
declare function netAbortAll(listener: object): void;
declare function netDrained(listener: object): Promise<void>;
declare function netClientAddress(socket: object): string;
declare function netClientPort(socket: object): int;
declare function deadlineNew(): object;
declare function deadlinePass(deadline: object): void;
declare function deadlinePassed(deadline: object): boolean;

export type SocketTransport =
  | {
      secure: false;
    }
  | {
      secure: true;
      servername?: string;
    };

export type TcpSocketOptions = {
  host: string;
  port: int;
  timeout?: int;
  transport?: SocketTransport;
  allowHalfOpen?: boolean;
  localAddress?: string;
  localPort?: int;
  noDelay?: boolean;
  keepAlive?: boolean;
  keepAliveDelay?: int;
  keepAliveInterval?: int;
  keepAliveCount?: int;
  sendBufferSize?: int;
  receiveBufferSize?: int;
  ttl?: int;
  typeOfService?: int;
  userTimeout?: int;
  linger?: int;
};

export type PathSocketOptions = {
  path: string;
  timeout?: int;
  allowHalfOpen?: boolean;
};

export type SocketOptions = TcpSocketOptions | PathSocketOptions;

export type SocketTuning = {
  noDelay?: boolean;
  keepAlive?: boolean;
  keepAliveDelay?: int;
  keepAliveInterval?: int;
  keepAliveCount?: int;
  sendBufferSize?: int;
  receiveBufferSize?: int;
  ttl?: int;
  typeOfService?: int;
  userTimeout?: int;
  linger?: int;
};

function tune(conn: object, tuning: SocketTuning): void {
  const noDelay = tuning.noDelay ?? true;
  netSocketOption(conn, 1, noDelay ? 1 : 0);
  const keepAlive = tuning.keepAlive ?? false;
  netSocketOption(conn, 2, keepAlive ? 1 : 0);
  const delay = tuning.keepAliveDelay;
  if (keepAlive && delay != undefined) {
    netSocketOption(conn, 3, delay);
  }
  const interval = tuning.keepAliveInterval;
  if (keepAlive && interval != undefined) {
    netSocketOption(conn, 4, interval);
  }
  const count = tuning.keepAliveCount;
  if (keepAlive && count != undefined) {
    netSocketOption(conn, 5, count);
  }
  const sendBufferSize = tuning.sendBufferSize;
  if (sendBufferSize != undefined) {
    netSocketOption(conn, 6, sendBufferSize);
  }
  const receiveBufferSize = tuning.receiveBufferSize;
  if (receiveBufferSize != undefined) {
    netSocketOption(conn, 7, receiveBufferSize);
  }
  const ttl = tuning.ttl;
  if (ttl != undefined) {
    netSocketOption(conn, 8, ttl);
  }
  const typeOfService = tuning.typeOfService;
  if (typeOfService != undefined) {
    netSocketOption(conn, 9, typeOfService);
  }
  const userTimeout = tuning.userTimeout;
  if (userTimeout != undefined) {
    netSocketOption(conn, 10, userTimeout);
  }
  const linger = tuning.linger;
  if (linger != undefined) {
    netSocketOption(conn, 11, linger);
  }
}

export type ConnectError =
  | {
      kind: "CONNECT_ERROR_REQUEST";
      code: "ERR_INVALID_HOST" | "ERR_ALREADY_CONNECTED";
      message: string;
      host: string;
      port: int;
    }
  | {
      kind: "CONNECT_ERROR_NETWORK";
      code:
        | "ENOTFOUND"
        | "EAI_AGAIN"
        | "ECONNREFUSED"
        | "ETIMEDOUT"
        | "ENETUNREACH"
        | "EHOSTUNREACH"
        | "EADDRNOTAVAIL"
        | "ECONNRESET"
        | "EMFILE"
        | "ENOBUFS"
        | "ENOENT"
        | "EBUSY"
        | "EACCES"
        | "UNKNOWN";
      message: string;
      syscall: string;
      host: string;
      port: int;
    }
  | {
      kind: "CONNECT_ERROR_TLS";
      code: string;
      message: string;
      host: string;
    }
  | {
      kind: "CONNECT_ERROR_TIMEOUT";
      code: "TIMEOUT_ERR";
      message: string;
      timeout: int;
    };

type ConnectNetworkCode =
  | "ENOTFOUND"
  | "EAI_AGAIN"
  | "ECONNREFUSED"
  | "ETIMEDOUT"
  | "ENETUNREACH"
  | "EHOSTUNREACH"
  | "EADDRNOTAVAIL"
  | "ECONNRESET"
  | "EMFILE"
  | "ENOBUFS"
  | "ENOENT"
  | "EBUSY"
  | "EACCES"
  | "UNKNOWN";

function connectCode(code: string): ConnectNetworkCode {
  switch (code) {
    case "ENOTFOUND":
      return "ENOTFOUND";
    case "EAI_AGAIN":
      return "EAI_AGAIN";
    case "ECONNREFUSED":
      return "ECONNREFUSED";
    case "ETIMEDOUT":
      return "ETIMEDOUT";
    case "ENETUNREACH":
      return "ENETUNREACH";
    case "EHOSTUNREACH":
      return "EHOSTUNREACH";
    case "EADDRNOTAVAIL":
      return "EADDRNOTAVAIL";
    case "ECONNRESET":
      return "ECONNRESET";
    case "EMFILE":
      return "EMFILE";
    case "ENOBUFS":
      return "ENOBUFS";
    case "ENOENT":
      return "ENOENT";
    case "EBUSY":
      return "EBUSY";
    case "EACCES":
      return "EACCES";
    default:
      return "UNKNOWN";
  }
}

function connectMessage(code: ConnectNetworkCode, host: string, port: int, detail: string): string {
  switch (code) {
    case "ENOENT":
      return `could not connect to ${host}: no socket or pipe has this path`;
    case "EBUSY":
      return `could not connect to ${host}: every instance of the pipe is busy`;
    case "EACCES":
      return `could not connect to ${host}: permission denied`;
    case "ENOTFOUND":
      return `could not find the address of ${host}: no such name in DNS`;
    case "EAI_AGAIN":
      return `could not find the address of ${host}: DNS did not answer; check the network`;
    case "ECONNREFUSED":
      return `could not connect to ${host}:${port}: nothing listens on this port`;
    case "ETIMEDOUT":
      return `could not connect to ${host}:${port}: the host did not answer in time`;
    case "ENETUNREACH":
      return `could not connect to ${host}:${port}: the network is unreachable`;
    case "EHOSTUNREACH":
      return `could not connect to ${host}:${port}: the host is unreachable`;
    case "EADDRNOTAVAIL":
      return `could not connect to ${host}:${port}: the address is not available on this machine`;
    case "ECONNRESET":
      return `the connection to ${host}:${port} was reset while connecting`;
    case "EMFILE":
      return `could not connect to ${host}:${port}: too many files and sockets are open in this program`;
    case "ENOBUFS":
      return `could not connect to ${host}:${port}: the system has no buffer space left`;
    case "UNKNOWN":
      return `could not connect to ${host}:${port}: ${detail}`;
  }
}

function passed(deadline?: object): boolean {
  if (deadline == undefined) {
    return false;
  }

  return deadlinePassed(deadline);
}

function startDeadline(timeout?: int): object | undefined {
  if (timeout == undefined) {
    return undefined;
  }
  const deadline = deadlineNew();
  const timer = setTimeout(() => deadlinePass(deadline), timeout);
  timer.unref();

  return deadline;
}

export interface SocketErrorNetwork extends StreamError {
  kind: "SOCKET_ERROR_NETWORK";
  code: "ECONNRESET" | "EPIPE" | "ECONNABORTED" | "ETIMEDOUT" | "ERR_CLOSED" | "UNKNOWN";
  syscall: string;
  host: string;
  port: int;
}

export interface SocketErrorTls extends StreamError {
  kind: "SOCKET_ERROR_TLS";
  code: string;
  host: string;
}

export type SocketError = SocketErrorNetwork | SocketErrorTls;

type SocketNetworkCode = "ECONNRESET" | "EPIPE" | "ECONNABORTED" | "ETIMEDOUT" | "ERR_CLOSED" | "UNKNOWN";

function socketCode(code: string): SocketNetworkCode {
  switch (code) {
    case "ECONNRESET":
      return "ECONNRESET";
    case "EPIPE":
      return "EPIPE";
    case "ECONNABORTED":
      return "ECONNABORTED";
    case "ETIMEDOUT":
      return "ETIMEDOUT";
    case "ERR_CLOSED":
      return "ERR_CLOSED";
    default:
      return "UNKNOWN";
  }
}

function socketMessage(code: SocketNetworkCode, peer: string, detail: string): string {
  switch (code) {
    case "ECONNRESET":
      return `the connection to ${peer} was reset by the other side`;
    case "EPIPE":
      return `could not write to ${peer}: the other side closed the connection`;
    case "ECONNABORTED":
      return `the connection to ${peer} was aborted on this machine`;
    case "ETIMEDOUT":
      return `the connection to ${peer} timed out: the other side stopped answering`;
    case "ERR_CLOSED":
      return `the connection to ${peer} is closed`;
    case "UNKNOWN":
      return `the connection to ${peer} failed: ${detail}`;
  }
}

export class Socket extends Duplex<Buffer, Buffer, SocketError> {
  private conn?: object;
  private readonly host: string;
  private readonly port: int;
  private readonly path?: string;
  private readonly timeout?: int;
  private readonly halfOpen: boolean;
  private readonly localAddressWanted?: string;
  private readonly localPortWanted?: int;
  private readonly tuning: SocketTuning;
  private readonly transport: SocketTransport;
  private reading: boolean;
  private peerAddress: string;
  private peerPort: int;
  private bytesIn: double;
  private bytesOut: double;
  private secured: boolean;

  public constructor(options: SocketOptions) {
    const halfOpen = options.allowHalfOpen ?? false;
    super({ allowHalfOpen: halfOpen });
    this.conn = undefined;
    this.timeout = options.timeout;
    this.halfOpen = halfOpen;
    if ("path" in options) {
      this.host = options.path;
      this.port = 0;
      this.path = options.path;
      this.localAddressWanted = undefined;
      this.localPortWanted = undefined;
      this.tuning = {};
      this.transport = { secure: false };
    } else {
      this.host = options.host;
      this.port = options.port;
      this.path = undefined;
      this.localAddressWanted = options.localAddress;
      this.localPortWanted = options.localPort;
      this.tuning = {
        noDelay: options.noDelay,
        keepAlive: options.keepAlive,
        keepAliveDelay: options.keepAliveDelay,
        keepAliveInterval: options.keepAliveInterval,
        keepAliveCount: options.keepAliveCount,
        sendBufferSize: options.sendBufferSize,
        receiveBufferSize: options.receiveBufferSize,
        ttl: options.ttl,
        typeOfService: options.typeOfService,
        userTimeout: options.userTimeout,
        linger: options.linger,
      };
      this.transport = options.transport ?? { secure: false };
    }
    this.reading = false;
    this.peerAddress = this.host;
    this.peerPort = this.port;
    this.bytesIn = 0;
    this.bytesOut = 0;
    this.secured = false;
  }

  public static accepted(conn: object, path: string | undefined, tuning: SocketTuning,
                         halfOpen: boolean): Socket {
    const address = netClientAddress(conn);
    const port = netClientPort(conn);
    if (path != undefined) {
      const local = new Socket({ path: path, allowHalfOpen: halfOpen });
      local.conn = conn;

      return local;
    }
    tune(conn, tuning);
    const socket = new Socket({ host: address, port: port, allowHalfOpen: halfOpen });
    socket.conn = conn;
    socket.peerAddress = address;
    socket.peerPort = port;

    return socket;
  }

  private target(): string {
    if (this.path != undefined) {
      return this.path;
    }

    return `${this.host}:${this.port}`;
  }

  public async connect(): Promise<Result<void, ConnectError>> {
    if (this.conn != undefined) {
      return err({
        kind: "CONNECT_ERROR_REQUEST",
        code: "ERR_ALREADY_CONNECTED",
        message: `the socket to ${this.target()} is connected already`,
        host: this.host,
        port: this.port,
      });
    }
    if (this.host == "") {
      return err({
        kind: "CONNECT_ERROR_REQUEST",
        code: "ERR_INVALID_HOST",
        message: "the host to connect to is empty",
        host: this.host,
        port: this.port,
      });
    }
    const deadline = startDeadline(this.timeout);
    const path = this.path;
    const localAddress = this.localAddressWanted;
    const localPort = this.localPortWanted;
    let connecting = netConnect(this.host, this.port, deadline);
    if (path != undefined) {
      connecting = netConnectPath(path);
    } else if (localAddress != undefined || localPort != undefined) {
      connecting = netConnectFrom(this.host, this.port, localAddress ?? "", localPort ?? 0, deadline);
    }
    const connectedResult = await connecting;
    if (connectedResult.isErr()) {
      const e = connectedResult.error;
      if (passed(deadline)) {
        const timeout = this.timeout ?? 0;

        return err({
          kind: "CONNECT_ERROR_TIMEOUT",
          code: "TIMEOUT_ERR",
          message: `could not connect to ${this.target()} within ${timeout} ms`,
          timeout: timeout,
        });
      }
      const code = connectCode(e.code);
      const message = connectMessage(code, this.host, this.port, e.message);

      return err({
        kind: "CONNECT_ERROR_NETWORK",
        code: code,
        message: message,
        syscall: e.syscall,
        host: this.host,
        port: this.port,
      });
    }
    const conn = connectedResult.value;
    if (path == undefined) {
      tune(conn, this.tuning);
    }
    const transport = this.transport;
    if (transport.secure) {
      const servername = transport.servername ?? this.host;
      const securedResult = await tlsConnect(conn, servername, deadline);
      if (securedResult.isErr()) {
        netClose(conn);

        return err({
          kind: "CONNECT_ERROR_TLS",
          code: securedResult.error.code,
          message: `the TLS handshake with ${servername} failed: ${securedResult.error.message}`,
          host: servername,
        });
      }
      this.secured = true;
    }
    this.conn = conn;

    return ok(undefined);
  }

  public async startTls(servername?: string): Promise<Result<void, ConnectError>> {
    const conn = this.conn;
    const name = servername ?? this.host;
    if (conn == undefined) {
      return err({
        kind: "CONNECT_ERROR_REQUEST",
        code: "ERR_INVALID_HOST",
        message: `the socket to ${this.host}:${this.port} is not connected, so TLS cannot start`,
        host: this.host,
        port: this.port,
      });
    }
    const securedResult = await tlsConnect(conn, name, undefined);
    if (securedResult.isErr()) {
      return err({
        kind: "CONNECT_ERROR_TLS",
        code: securedResult.error.code,
        message: `the TLS handshake with ${name} failed: ${securedResult.error.message}`,
        host: name,
      });
    }
    this.secured = true;

    return ok(undefined);
  }

  public remoteAddress(): string {
    return this.peerAddress;
  }

  public remotePort(): int {
    return this.peerPort;
  }

  public localAddress(): string {
    const conn = this.conn;
    if (conn == undefined) {
      return "";
    }
    const address = netLocalHost(conn);

    return address;
  }

  public localPort(): int {
    const conn = this.conn;
    if (conn == undefined) {
      return 0;
    }
    const port = netLocalPort(conn);

    return port;
  }

  public bytesRead(): double {
    return this.bytesIn;
  }

  public bytesWritten(): double {
    return this.bytesOut;
  }

  public reset(): void {
    const conn = this.conn;
    if (conn != undefined) {
      tcpReset(conn);
    }
    this.destroy();
  }

  protected onRead(size: int): void {
    void size;
    const conn = this.conn;
    if (conn == undefined || this.reading) {
      return;
    }
    this.reading = true;
    void this.readChunk(conn);
  }

  private async readChunk(conn: object): Promise<void> {
    const chunkResult = await tcpRead(conn, undefined);
    this.reading = false;
    if (chunkResult.isErr()) {
      const failure = this.socketError(chunkResult.error);
      this.destroy(failure);
      return;
    }
    const chunk = chunkResult.value;
    if (chunk == undefined) {
      this.pushChunk(undefined);
      return;
    }
    this.bytesIn += chunk.length.toDouble();
    const bytes = Buffer.from(chunk);
    this.pushChunk(bytes);
  }

  protected onWrite(chunk: Buffer, encoding: string, callback: HookCallback<SocketError>): void {
    void encoding;
    const conn = this.conn;
    if (conn == undefined) {
      const peer = `${this.peerAddress}:${this.peerPort}`;

      callback({
        kind: "SOCKET_ERROR_NETWORK",
        code: "ERR_CLOSED",
        message: `could not write to ${peer}: the socket is not connected`,
        syscall: "write",
        host: this.peerAddress,
        port: this.peerPort,
      });
      return;
    }
    this.bytesOut += chunk.length.toDouble();
    void this.writeChunk(conn, chunk, callback);
  }

  private async writeChunk(conn: object, chunk: Buffer,
                           callback: HookCallback<SocketError>): Promise<void> {
    const wroteResult = await httpWrite(conn, chunk);
    if (wroteResult.isErr()) {
      const failure = this.socketError(wroteResult.error);
      callback(failure);
      return;
    }
    callback();
  }

  private socketError(e: NativeError): SocketError {
    const code = socketCode(e.code);
    if (this.secured && code == "UNKNOWN") {
      const tls: SocketErrorTls = {
        kind: "SOCKET_ERROR_TLS",
        code: e.code,
        message: `the TLS connection to ${this.peerAddress}:${this.peerPort} failed: ${e.message}`,
        host: this.peerAddress,
      };

      return tls;
    }
    const message = socketMessage(code, `${this.peerAddress}:${this.peerPort}`, e.message);
    const network: SocketErrorNetwork = {
      kind: "SOCKET_ERROR_NETWORK",
      code: code,
      message: message,
      syscall: e.syscall,
      host: this.peerAddress,
      port: this.peerPort,
    };

    return network;
  }

  protected onFinal(callback: HookCallback<SocketError>): void {
    const conn = this.conn;
    if (conn != undefined && this.halfOpen && this.path == undefined) {
      tcpShutdown(conn);
    } else if (conn != undefined) {
      netClose(conn);
    }
    callback();
  }

  protected destroyHook(error: StreamFault | undefined, callback: FaultCallback): void {
    const conn = this.conn;
    if (conn != undefined) {
      this.conn = undefined;
      netClose(conn);
    }
    callback(error);
  }
}

export type TcpServerOptions = {
  port?: int;
  hostname?: string;
  idleTimeout?: int;
  backlog?: int;
  ipv6Only?: boolean;
  reusePort?: boolean;
  allowHalfOpen?: boolean;
  noDelay?: boolean;
  keepAlive?: boolean;
  keepAliveDelay?: int;
  keepAliveInterval?: int;
  keepAliveCount?: int;
  sendBufferSize?: int;
  receiveBufferSize?: int;
  ttl?: int;
  typeOfService?: int;
  userTimeout?: int;
  linger?: int;
};

export type PathServerOptions = {
  path: string;
  idleTimeout?: int;
  backlog?: int;
  allowHalfOpen?: boolean;
};

export type ServerOptions = TcpServerOptions | PathServerOptions;

export type SocketHandler = (socket: Socket) => Promise<void>;

export type NetListenError = {
  kind: "NET_LISTEN_ERROR";
  code:
    | "EADDRINUSE"
    | "EACCES"
    | "EADDRNOTAVAIL"
    | "ENOTFOUND"
    | "ERR_INVALID_ARG_VALUE"
    | "EMFILE"
    | "ENOBUFS"
    | "EAFNOSUPPORT"
    | "ENOTSUP"
    | "UNKNOWN";
  message: string;
  syscall: string;
  address: string;
  port: int;
};

type ListenCode =
  | "EADDRINUSE"
  | "EACCES"
  | "EADDRNOTAVAIL"
  | "ENOTFOUND"
  | "ERR_INVALID_ARG_VALUE"
  | "EMFILE"
  | "ENOBUFS"
  | "EAFNOSUPPORT"
  | "ENOTSUP"
  | "UNKNOWN";

function listenCode(code: string): ListenCode {
  switch (code) {
    case "EADDRINUSE":
      return "EADDRINUSE";
    case "EACCES":
      return "EACCES";
    case "EADDRNOTAVAIL":
      return "EADDRNOTAVAIL";
    case "ENOTFOUND":
      return "ENOTFOUND";
    case "ERR_INVALID_ARG_VALUE":
      return "ERR_INVALID_ARG_VALUE";
    case "EMFILE":
      return "EMFILE";
    case "ENOBUFS":
      return "ENOBUFS";
    case "EAFNOSUPPORT":
      return "EAFNOSUPPORT";
    case "ENOTSUP":
      return "ENOTSUP";
    default:
      return "UNKNOWN";
  }
}

export type StopOptions = {
  timeout?: int;
};

export class Server {
  private readonly hostname: string;
  private readonly port: int;
  private readonly path?: string;
  private readonly idleTimeout: int;
  private readonly backlog: int;
  private readonly flags: int;
  private readonly settings: Settings;
  private readonly handler: SocketHandler;

  public constructor(options: ServerOptions, handler: SocketHandler) {
    this.idleTimeout = options.idleTimeout ?? 0;
    this.backlog = options.backlog ?? 511;
    const halfOpen = options.allowHalfOpen ?? false;
    if ("path" in options) {
      this.hostname = options.path;
      this.port = 0;
      this.path = options.path;
      this.flags = 0;
      this.settings = new Settings(options.path, {}, halfOpen);
    } else {
      this.hostname = options.hostname ?? "0.0.0.0";
      this.port = options.port ?? 0;
      this.path = undefined;
      const ipv6Only = options.ipv6Only ?? false;
      const reusePort = options.reusePort ?? false;
      this.flags = (ipv6Only ? 1 : 0) | (reusePort ? 2 : 0);
      const tuning: SocketTuning = {
        noDelay: options.noDelay,
        keepAlive: options.keepAlive,
        keepAliveDelay: options.keepAliveDelay,
        keepAliveInterval: options.keepAliveInterval,
        keepAliveCount: options.keepAliveCount,
        sendBufferSize: options.sendBufferSize,
        receiveBufferSize: options.receiveBufferSize,
        ttl: options.ttl,
        typeOfService: options.typeOfService,
        userTimeout: options.userTimeout,
        linger: options.linger,
      };
      this.settings = new Settings(undefined, tuning, halfOpen);
    }
    this.handler = handler;
  }

  public listen(): Result<Listening, NetListenError> {
    const path = this.path;
    const openedResult = path != undefined
      ? netListenPath(path, this.idleTimeout, this.backlog)
      : netListenSocket(this.hostname, this.port, this.idleTimeout, this.backlog, this.flags);
    if (openedResult.isErr()) {
      const e = openedResult.error;
      const code = listenCode(e.code);

      return err({
        kind: "NET_LISTEN_ERROR",
        code: code,
        message: e.message,
        syscall: e.syscall,
        address: this.hostname,
        port: this.port,
      });
    }
    const listening = new Listening(openedResult.value, this.hostname, this.settings, this.handler);

    return ok(listening);
  }
}

class Settings {
  public readonly path?: string;
  public readonly tuning: SocketTuning;
  public readonly halfOpen: boolean;

  public constructor(path: string | undefined, tuning: SocketTuning, halfOpen: boolean) {
    this.path = path;
    this.tuning = tuning;
    this.halfOpen = halfOpen;
  }
}

export class Listening {
  public readonly hostname: string;
  public readonly port: int;
  public readonly path?: string;

  private readonly native: object;
  private readonly accepting: Promise<void>;
  private stopping: boolean;

  public constructor(native: object, hostname: string, settings: Settings, handler: SocketHandler) {
    this.native = native;
    this.hostname = hostname;
    this.path = settings.path;
    this.port = settings.path == undefined ? netListenerPort(native) : 0;
    this.stopping = false;
    this.accepting = Listening.acceptAll(native, settings, handler);
  }

  public async stop(options?: StopOptions): Promise<void> {
    const native = this.native;
    if (!this.stopping) {
      this.stopping = true;
      netCloseListener(native);
    }
    const timeout = options?.timeout;
    if (timeout == undefined) {
      await this.accepting;
      return;
    }
    if (timeout <= 0) {
      netAbortAll(native);
      await this.accepting;
      return;
    }
    const timer = setTimeout(() => netAbortAll(native), timeout);
    await this.accepting;
    clearTimeout(timer);
  }

  private static async acceptAll(native: object, settings: Settings,
                                 handler: SocketHandler): Promise<void> {
    for (;;) {
      const conn = await netAccept(native);
      if (conn == undefined) {
        break;
      }
      void Listening.serve(conn, settings, handler);
    }
    await netDrained(native);
  }

  private static async serve(conn: object, settings: Settings, handler: SocketHandler): Promise<void> {
    const socket = Socket.accepted(conn, settings.path, settings.tuning, settings.halfOpen);
    await handler(socket);
  }
}

export function isIPv4(text: string): boolean {
  const parts = text.split(".");
  if (parts.length != 4) {
    return false;
  }
  for (const part of parts) {
    if (!/^(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])$/.test(part)) {
      return false;
    }
  }

  return true;
}

export function isIPv6(text: string): boolean {
  const parsedResult = URL.parse(`http://[${text}]/`);

  return parsedResult.isOk() && !text.includes("[") && text.includes(":");
}

export function isIP(text: string): int {
  if (isIPv4(text)) {
    return 4;
  }
  if (isIPv6(text)) {
    return 6;
  }

  return 0;
}
