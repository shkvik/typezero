declare function intlLocaleTag(tag: string): string
declare function intlLocalePart(tag: string, part: int): string

export class Locale {
  readonly baseName: string
  readonly language: string
  readonly script?: string
  readonly region?: string
  private tag: string

  constructor(tag: string) {
    const canonical = intlLocaleTag(tag)
    this.tag = canonical == "" ? tag : canonical
    this.baseName = intlLocalePart(this.tag, 0)
    this.language = intlLocalePart(this.tag, 1)
    const script = intlLocalePart(this.tag, 2)
    this.script = script == "" ? undefined : script
    const region = intlLocalePart(this.tag, 3)
    this.region = region == "" ? undefined : region
  }

  static parse(tag: string): Result<Locale, LocaleError> {
    if (tag == "")
      return err({ code: "bad_locale", message: "First argument to Intl.Locale constructor can't be empty or missing", tag })
    if (intlLocaleTag(tag) == "")
      return err({ code: "bad_locale", message: "Incorrect locale information provided", tag })
    return ok(new Locale(tag))
  }

  maximize(): Locale {
    const longer = intlLocalePart(this.tag, 4)
    return new Locale(longer == "" ? this.tag : longer)
  }

  toString(): string {
    return this.tag
  }
}
