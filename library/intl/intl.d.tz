  /** From 1 to 21. */
  maximumSignificantDigits?: int;
  /**
   * One of 1, 2, 5, 10, 20, 25, 50, 100, 200, 250, 500, 1000, 2000, 2500, 5000;
   * it needs the same minimumFractionDigits and maximumFractionDigits.
