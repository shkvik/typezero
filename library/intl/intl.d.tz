  roundingIncrement?: int;
  roundingMode?:
    | "ceil"
    | "floor"
    | "expand"
    | "trunc"
    | "halfCeil"
    | "halfFloor"
    | "halfExpand"
    | "halfTrunc"
    | "halfEven";
  roundingPriority?: "auto" | "morePrecision" | "lessPrecision";
