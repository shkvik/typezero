/**
 * The options of `Intl.DateTimeFormat`. A value known only when the program
 * runs is checked before.
 */
export type DateTimeFormatOptions = {
  /** How the language is looked for among those there are. */
  localeMatcher?: "lookup" | "best fit";
  calendar?: string;
  numberingSystem?: string;
  hourCycle?: "h11" | "h12" | "h23" | "h24";
  /**
   * The name of the zone, e.g. "Europe/Berlin"; that of the system by default.
   */
  timeZone?: string;
  weekday?: "narrow" | "short" | "long";
  era?: "narrow" | "short" | "long";
  year?: "2-digit" | "numeric";
  month?: "2-digit" | "numeric" | "narrow" | "short" | "long";
  day?: "2-digit" | "numeric";
  dayPeriod?: "narrow" | "short" | "long";
  hour?: "2-digit" | "numeric";
  minute?: "2-digit" | "numeric";
  second?: "2-digit" | "numeric";
  timeZoneName?:
    | "short"
    | "long"
    | "shortOffset"
    | "longOffset"
    | "shortGeneric"
    | "longGeneric";
  formatMatcher?: "basic" | "best fit";
  /**
   * A ready form of the date; it does not go with the options of single parts.
   */
  dateStyle?: "full" | "long" | "medium" | "short";
  /** A ready form of the time. */
  timeStyle?: "full" | "long" | "medium" | "short";
  hour12?: boolean;
  fractionalSecondDigits?: 1 | 2 | 3;
};

