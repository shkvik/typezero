import { Locale } from "tz:locale";

/**
 * A piece of formatted text: what it is ("day", "literal", "integer",
 * "currency"…) and the text itself.
 */
export type DateTimeFormatPart = { type: string; value: string };

/** The same as `Intl.DateTimeFormatPart`. */
export type NumberFormatPart = DateTimeFormatPart;

/** A piece of a relative time; a number says which unit it counts. */
export type RelativeTimeFormatPart = {
  type: string;
  value: string;
  unit?: string;
};

/**
 * A form of a word for a number: "zero", "one", "two", "few", "many" or
 * "other". The same as `string`.
 */
export type LDMLPluralRule = string;

/** A unit of time for `Intl.RelativeTimeFormat`. The same as `string`. */
export type RelativeTimeFormatUnit = string;

/** A tag of a language, e.g. "ru-RU". The same as `string`. */
export type UnicodeBCP47LocaleIdentifier = string;

/** A tag of a language. The same as `string`. */
export type BCP47LanguageTag = string;

/** How the languages asked for are matched with those there are. */
export type SupportedLocalesOptions = {
  localeMatcher?: "lookup" | "best fit";
};

/**
 * A piece of a text: the piece, where it starts, the whole text, and for words
 * whether it is a word and not what stands between words.
 */
export type SegmentData = {
  segment: string;
  index: int;
  input: string;
  isWordLike?: boolean;
};

/**
 * The pieces a `Segmenter` cut a text into. They are gone through with
 * `for...of`, each a `SegmentData`.
 */
export interface Segments {
  /** The piece the position of the text is in. */
  containing(index: int): SegmentData | undefined;
}

/**
 * The options of `Intl.NumberFormat`. A value known only when the program runs
 * is checked before.
 */
export type NumberFormatOptions = {
  /** How the language is looked for among those there are. */
  localeMatcher?: "lookup" | "best fit";
  /** The digits, e.g. "arab". */
  numberingSystem?: string;
  style?: "decimal" | "percent" | "currency" | "unit";
  /** The code of the currency, e.g. "USD"; needed with the style "currency". */
  currency?: string;
  currencyDisplay?: "code" | "symbol" | "narrowSymbol" | "name";
  currencySign?: "standard" | "accounting";
  /**
   * The unit, e.g. "kilometer" or "kilometer-per-hour"; needed with the style
   * "unit".
   */
  unit?: string;
  unitDisplay?: "short" | "narrow" | "long";
  /** Whether the thousands are set apart, and when. */
  useGrouping?: "min2" | "auto" | "always" | "true" | "false" | boolean;
  notation?: "standard" | "scientific" | "engineering" | "compact";
  compactDisplay?: "short" | "long";
  signDisplay?: "auto" | "never" | "always" | "exceptZero" | "negative";
  /** From 1 to 21. */
  minimumIntegerDigits?: int;
  /** From 0 to 100. */
  minimumFractionDigits?: int;
  /** From 0 to 100. */
  maximumFractionDigits?: int;
  /** From 1 to 21. */
  minimumSignificantDigits?: int;
  /** From 1 to 21. */
  maximumSignificantDigits?: int;
  /**
   * One of 1, 2, 5, 10, 20, 25, 50, 100, 200, 250, 500, 1000, 2000, 2500, 5000;
   * it needs the same minimumFractionDigits and maximumFractionDigits.
   */
  roundingIncrement?: int;
  roundingMode?:
    | "ceil"
    | "floor"
    | "expand"
    | "trunc"
    | "halfCeil"
    | "halfFloor"
    | "halfExpand"
    | "halfTrunc"
    | "halfEven";
  roundingPriority?: "auto" | "morePrecision" | "lessPrecision";
  trailingZeroDisplay?: "auto" | "stripIfInteger";
};

/**
 * What `resolvedOptions` of an `Intl.NumberFormat` gives: the options as they
 * were taken.
 */
export type ResolvedNumberFormatOptions = {
  locale: string;
  numberingSystem: string;
  style: string;
  currency?: string;
  currencyDisplay?: string;
  currencySign?: string;
  unit?: string;
  unitDisplay?: string;
  minimumIntegerDigits: int;
  minimumFractionDigits?: int;
  maximumFractionDigits?: int;
  minimumSignificantDigits?: int;
  maximumSignificantDigits?: int;
  useGrouping: string | boolean;
  notation: string;
  compactDisplay?: string;
  signDisplay: string;
  roundingIncrement: int;
  roundingMode: string;
  roundingPriority: string;
  trailingZeroDisplay: string;
};

/**
 * Writes numbers as a language does: digits, separators, currencies, units,
 * percents. It is made with `new Intl.NumberFormat(locale, options)`, or the
 * same without `new`: the language is a tag written in the code or an
 * `Intl.Locale`, that of the system by default.
 * @example new Intl.NumberFormat("de", { style: "percent" }).format(0.5)
 */
export declare class NumberFormat {
  public constructor(locale?: string | Locale, options?: NumberFormatOptions);

  /** The number as text. */
  public format(value: int | double | decimal): string;
  /** The text by parts: digits, separators, the sign of the currency. */
  public formatToParts(value: int | double | decimal): NumberFormatPart[];
  public resolvedOptions(): ResolvedNumberFormatOptions;

  /** Those of the languages asked for that there is data for. */
  public static supportedLocalesOf(
    locales: string | string[],
    options?: SupportedLocalesOptions,
  ): string[];
}

