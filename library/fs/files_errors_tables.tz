const kReadFileErrorCodes: string[] = [
  "ENOENT",
  "EISDIR",
  "ENOTDIR",
  "EACCES",
  "EPERM",
  "EBUSY",
  "EAGAIN",
  "EMFILE",
  "ENFILE",
  "ERR_INVALID_PATH",
  "ENAMETOOLONG",
  "ELOOP",
  "EINVAL",
  "EIO",
  "ENOMEM",
  "ETIMEDOUT",
  "EBADF",
  "UNKNOWN",
];

function readFileErrorOf(failure: Read<FsFailure>): ReadFileError {
  const isKnown = kReadFileErrorCodes.includes(failure.code);
  const verb = "read";
  const message = failureMessage(failure, verb, isKnown);
  const syscall = failure.syscall;
  const path = failure.path;

  const code = failure.code;

  switch (code) {
    case "ENOENT":
      return {
        kind: "READ_FILE_ERROR_NOT_FOUND",
        code,
        message,
        syscall,
        path,
      };
    case "EISDIR":
    case "ENOTDIR":
      return {
        kind: "READ_FILE_ERROR_WRONG_TYPE",
        code,
        message,
        syscall,
        path,
      };
    case "EACCES":
    case "EPERM":
      return {
        kind: "READ_FILE_ERROR_PERMISSION",
        code,
        message,
        syscall,
        path,
      };
    case "EBUSY":
    case "EAGAIN":
    case "EMFILE":
    case "ENFILE":
      return { kind: "READ_FILE_ERROR_BUSY", code, message, syscall, path };
    case "ERR_INVALID_PATH":
    case "ENAMETOOLONG":
    case "ELOOP":
    case "EINVAL":
      return { kind: "READ_FILE_ERROR_PATH", code, message, syscall, path };
    case "EIO":
    case "ENOMEM":
    case "ETIMEDOUT":
    case "EBADF":
      return { kind: "READ_FILE_ERROR_SYSTEM", code, message, syscall, path };
    default:
      return {
        kind: "READ_FILE_ERROR_SYSTEM",
        code: "UNKNOWN",
        message,
        syscall,
        path,
      };
  }
}

