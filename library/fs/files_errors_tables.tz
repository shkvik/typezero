const kCopyFileErrorCodes: string[] = [
  "ENOENT",
  "EEXIST",
  "EISDIR",
  "ENOTDIR",
  "EACCES",
  "EPERM",
  "EROFS",
  "EBUSY",
  "ETXTBSY",
  "EMFILE",
  "ENFILE",
  "ENOSPC",
  "EFBIG",
  "ERR_INVALID_PATH",
  "ENAMETOOLONG",
  "ELOOP",
  "EINVAL",
  "EIO",
  "ENOMEM",
  "ETIMEDOUT",
  "UNKNOWN",
];

function copyFileErrorOf(failure: Read<FsFailure>): CopyFileError {
  const isKnown = kCopyFileErrorCodes.includes(failure.code);
  const verb = "copy";
  const message = failureMessage(failure, verb, isKnown);
  const syscall = failure.syscall;
  const path = failure.path;
  const dest = failure.dest;

  const code = failure.code;

  switch (code) {
    case "ENOENT":
      return {
        kind: "COPY_FILE_ERROR_NOT_FOUND",
        code,
        message,
        syscall,
        path,
        dest,
      };
    case "EEXIST":
      return {
        kind: "COPY_FILE_ERROR_EXISTS",
        code,
        message,
        syscall,
        path,
        dest,
      };
    case "EISDIR":
    case "ENOTDIR":
      return {
        kind: "COPY_FILE_ERROR_WRONG_TYPE",
        code,
        message,
        syscall,
        path,
        dest,
      };
    case "EACCES":
    case "EPERM":
    case "EROFS":
      return {
        kind: "COPY_FILE_ERROR_PERMISSION",
        code,
        message,
        syscall,
        path,
        dest,
      };
    case "EBUSY":
    case "ETXTBSY":
    case "EMFILE":
    case "ENFILE":
      return {
        kind: "COPY_FILE_ERROR_BUSY",
        code,
        message,
        syscall,
        path,
        dest,
      };
    case "ENOSPC":
    case "EFBIG":
      return {
        kind: "COPY_FILE_ERROR_FULL",
        code,
        message,
        syscall,
        path,
        dest,
      };
    case "ERR_INVALID_PATH":
    case "ENAMETOOLONG":
    case "ELOOP":
    case "EINVAL":
      return {
        kind: "COPY_FILE_ERROR_PATH",
        code,
        message,
        syscall,
        path,
        dest,
      };
    case "EIO":
    case "ENOMEM":
    case "ETIMEDOUT":
      return {
        kind: "COPY_FILE_ERROR_SYSTEM",
        code,
        message,
        syscall,
        path,
        dest,
      };
    default:
      return {
        kind: "COPY_FILE_ERROR_SYSTEM",
        code: "UNKNOWN",
        message,
        syscall,
        path,
        dest,
      };
  }
}

