      return {
        kind: "MAKE_TEMPORARY_DIRECTORY_ERROR_PERMISSION",
        code,
        message,
        syscall,
        path,
      };
    case "ENOSPC":
    case "EMLINK":
      return {
        kind: "MAKE_TEMPORARY_DIRECTORY_ERROR_FULL",
        code,
