const kRemoveErrorCodes: string[] = [
  "ENOENT",
  "ENOTEMPTY",
  "EISDIR",
  "ENOTDIR",
  "EACCES",
  "EPERM",
  "EROFS",
  "EBUSY",
  "EMFILE",
  "ENFILE",
  "ERR_INVALID_PATH",
  "ENAMETOOLONG",
  "ELOOP",
  "EINVAL",
  "ECHARSET",
  "EIO",
  "ENOMEM",
  "ETIMEDOUT",
  "UNKNOWN",
];

function removeErrorOf(failure: Read<FsFailure>): RemoveError {
  const isKnown = kRemoveErrorCodes.includes(failure.code);
  const verb = "remove";
  const message = failureMessage(failure, verb, isKnown);
  const syscall = failure.syscall;
  const path = failure.path;

  const code = failure.code;

  switch (code) {
    case "ENOENT":
      return { kind: "REMOVE_ERROR_NOT_FOUND", code, message, syscall, path };
    case "ENOTEMPTY":
      return { kind: "REMOVE_ERROR_NOT_EMPTY", code, message, syscall, path };
    case "EISDIR":
    case "ENOTDIR":
      return { kind: "REMOVE_ERROR_WRONG_TYPE", code, message, syscall, path };
    case "EACCES":
    case "EPERM":
    case "EROFS":
      return { kind: "REMOVE_ERROR_PERMISSION", code, message, syscall, path };
    case "EBUSY":
    case "EMFILE":
    case "ENFILE":
      return { kind: "REMOVE_ERROR_BUSY", code, message, syscall, path };
    case "ERR_INVALID_PATH":
    case "ENAMETOOLONG":
    case "ELOOP":
    case "EINVAL":
    case "ECHARSET":
      return { kind: "REMOVE_ERROR_PATH", code, message, syscall, path };
    case "EIO":
    case "ENOMEM":
    case "ETIMEDOUT":
      return { kind: "REMOVE_ERROR_SYSTEM", code, message, syscall, path };
    default:
      return {
        kind: "REMOVE_ERROR_SYSTEM",
        code: "UNKNOWN",
        message,
        syscall,
        path,
      };
  }
}

