import { InterfaceOptions } from "node:readline";

/**
 * Reads the standard input line by line: `for await (const line of rl)`
 * gives the lines, each a string without its line break.
 */
export declare class Interface {
  /** There is no `new Interface()`: `createInterface` makes one. */
  private constructor();

  /**
   * Prints the query and waits for the line the user types; an error when
   * the interface is closed already.
   * @example const name = await rl.question("Name? ")
   */
  public question(query: string): Promise<Result<string, QuestionError>>;
  /** Stops reading; the lines read so far still come. */
  public close(): void;
  /** The lines as they come: what `for await` goes through. */
  public [Symbol.asyncIterator](): AsyncGenerator<string>;
}

/** Starts reading the standard input by lines. */
export declare function createInterface(options: InterfaceOptions): Interface;
