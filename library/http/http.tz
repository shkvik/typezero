import { Connection, Request, Response } from "tz:fetch";
import { URL } from "tz:url";
import { AbortSignal, Event } from "tz:web";
import { ahead, order } from "tz:intrinsics";

declare function netListen(
  host: string,
  port: int,
  maxBody: double,
  keepAlive: int,
  headersTimeout: int,
): Result<object, SystemError>;
declare function tlsListen(
  host: string,
  port: int,
  maxBody: double,
  keepAlive: int,
  headersTimeout: int,
  cert: string,
  key: string,
): Result<object, SystemError>;
declare function netListenerPort(listener: object): int;
declare function netListenerUrl(listener: object): string;
declare function netAccept(listener: object): Promise<object | undefined>;
declare function netCloseListener(listener: object): void;
declare function netDrained(listener: object): Promise<void>;
declare function netClientAddress(socket: object): string;
declare function netClientPort(socket: object): int;

export type Handler = (
  request: Request,
  client: Client,
) => Response | Promise<Response>;

export type Client = {
  address: string;
  port: int;
};

export type ServeOptions = {
  port?: int;
  hostname?: string;
  signal?: AbortSignal;
  maxBodySize?: double;
  keepAliveTimeout?: int;
  headersTimeout?: int;
  transport?: ServeTransport;
};

export type ServeTransport =
  | {
      secure: false;
    }
  | {
      secure: true;
      cert: string;
      key: string;
    };

export type ListenError = {
  kind: "SERVER";
  code: ListenErrorCode;
  message: string;
  errno: int;
  syscall: string;
  address: string;
  port: int;
};

export type ListenErrorCode =
  | "EADDRINUSE"
  | "EACCES"
  | "EADDRNOTAVAIL"
  | "ENOTFOUND"
  | "ERR_INVALID_ARG_VALUE"
  | "ERR_TLS_CERT"
  | "ERR_TLS_KEY"
  | "EMFILE"
  | "ENOBUFS"
  | "EAFNOSUPPORT"
  | "UNKNOWN";

function listenCode(code: string): ListenErrorCode {
  switch (code) {
    case "EADDRINUSE":
      return "EADDRINUSE";
    case "EACCES":
      return "EACCES";
    case "EADDRNOTAVAIL":
      return "EADDRNOTAVAIL";
    case "ENOTFOUND":
      return "ENOTFOUND";
    case "ERR_INVALID_ARG_VALUE":
      return "ERR_INVALID_ARG_VALUE";
    case "ERR_TLS_CERT":
      return "ERR_TLS_CERT";
    case "ERR_TLS_KEY":
      return "ERR_TLS_KEY";
    case "EMFILE":
      return "EMFILE";
    case "ENOBUFS":
      return "ENOBUFS";
    case "EAFNOSUPPORT":
      return "EAFNOSUPPORT";
    default:
      return "UNKNOWN";
  }
}

class Listener {
  public readonly native: object;

  public constructor(native: object) {
    this.native = native;
  }
}

export class Server {
  private readonly hostname: string;
  private readonly port: int;
  private readonly maxBody: double;
  private readonly keepAlive: int;
  private readonly headersTimeout: int;
  private readonly transport: ServeTransport;
  private readonly signal?: AbortSignal;
  private readonly handler: Handler;

  public constructor(options: ServeOptions, handler: Handler) {
    this.hostname = options.hostname ?? "0.0.0.0";
    this.port = options.port ?? 8000;
    this.maxBody = options.maxBodySize ?? 128 * 1024 * 1024;
    this.keepAlive = options.keepAliveTimeout ?? 5000;
    this.headersTimeout = options.headersTimeout ?? 60000;
    this.transport = options.transport ?? { secure: false };
    this.signal = options.signal;
    this.handler = handler;
  }

  public listen(): Result<Listening, ListenError> {
    const opened = this.open();

    if (opened.isErr()) {
      const code = listenCode(opened.error.code);

      return err({
        kind: "SERVER",
        code: code,
        message: opened.error.message,
        errno: opened.error.errno,
        syscall: opened.error.syscall,
        address: this.hostname,
        port: this.port,
      });
    }

    const listener = new Listener(opened.value);
    const listening = new Listening(
      listener,
      this.hostname,
      this.handler,
      this.signal,
    );

    return ok(listening);
  }

  private open(): Result<object, SystemError> {
    const transport = this.transport;
    if (transport.secure) {
      const secured = tlsListen(
        this.hostname,
        this.port,
        this.maxBody,
        this.keepAlive,
        this.headersTimeout,
        transport.cert,
        transport.key,
      );

      return secured;
    }
    const plain = netListen(
      this.hostname,
      this.port,
      this.maxBody,
      this.keepAlive,
      this.headersTimeout,
    );

    return plain;
  }
}

export class Listening {
  public readonly url: URL;
  public readonly hostname: string;
  public readonly port: int;

  private readonly listener: Listener;
  private readonly accepting: Promise<void>;
  private stopping: boolean;

  public constructor(
    listener: Listener,
    hostname: string,
    handler: Handler,
    signal?: AbortSignal,
  ) {
    this.listener = listener;
    this.stopping = false;
    const href = netListenerUrl(listener.native);
    this.url = new URL(href);
    this.hostname = hostname;
    this.port = netListenerPort(listener.native);
    this.accepting = Listening.acceptAll(listener, handler);
    this.stopOnSignal(signal);
  }

  public async stop(): Promise<void> {
    if (!this.stopping) {
      this.stopping = true;
      netCloseListener(this.listener.native);
    }
    await this.accepting;
  }

  private stopOnSignal(signal?: AbortSignal): void {
    if (signal == undefined) {
      return;
    }
    if (signal.aborted()) {
      void this.stop();
      return;
    }
    signal.addEventListener(
      "abort",
      (event: Event) => {
        void this.stop();
      },
      { once: true },
    );
  }

  private static async acceptAll(
    listener: Listener,
    handler: Handler,
  ): Promise<void> {
    for (;;) {
      const socket = await netAccept(listener.native);
      if (socket == undefined) {
        break;
      }
      void Listening.serve(socket, handler);
    }
    await netDrained(listener.native);
  }

  private static async serve(socket: object, handler: Handler): Promise<void> {
    const address = netClientAddress(socket);
    const port = netClientPort(socket);
    const client: Client = {
      address: address,
      port: port,
    };
    const conn = new Connection(socket);
    for (;;) {
      const next = conn.next();
      const got = await ahead(next);
      if (got.isErr() || got.value == 0) {
        break;
      }
      const request = Request.readFrom(conn);
      const handled = handler(request, client);
      const response = await ahead(handled);
      const headOnly = request.method == "HEAD";
      const written = response.writeTo(conn, headOnly);
      if (written.kind == "streaming") {
        await written.finished;
      }
      if (!conn.keepAlive()) {
        break;
      }
    }
    order();
    conn.close();
  }
}
