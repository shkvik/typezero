import { Connection, Request, Response } from "tz:fetch";
import { URL } from "tz:url";
import { AbortSignal, Event } from "tz:web";
import { ahead, order } from "tz:intrinsics";

declare function netListen(
  host: string,
  port: int,
  maxBody: double,
): Result<object, SystemError>;
declare function tlsListen(
  host: string,
  port: int,
  maxBody: double,
  cert: string,
  key: string,
): Result<object, SystemError>;
declare function netListenerPort(listener: object): int;
declare function netAccept(listener: object): Promise<object | undefined>;
declare function netCloseListener(listener: object): void;
declare function netSweep(listener: object, idle: double): int;

export interface ServeAddress {
  hostname: string;
  port: int;
}

export interface ServeTls {
  cert: string;
  key: string;
}

export interface ServeOptions {
  port?: int;
  hostname?: string;
  tls?: ServeTls;
  signal?: AbortSignal;
  onListen?: (address: ServeAddress) => void;
  maxBodySize?: double;
}

export type Handler = (request: Request) => Response | Promise<Response>;

const KEEP_ALIVE_MS = 5000;

export class Server {
  readonly port: int = 0;
  readonly hostname: string = "";
  readonly url?: URL;
  readonly finished: Promise<void>;
  private handler: Handler;
  private listener?: object;
  private listened = false;
  private base = "";
  private stopping = false;
  private open = 0;
  private resolveFinished: () => void;
  private sweep?: Timeout;

  constructor(handler: Handler) {
    this.handler = handler;
    const { promise, resolve } = Promise.withResolvers<void>();
    this.finished = promise;
    this.resolveFinished = resolve;
  }

  listen(options: ServeOptions): Result<URL, SystemError> {
    if (this.listened)
      return err({
        code: "ERR_SERVER_ALREADY_LISTEN",
        message:
          "Listen method has been called more than once without closing.",
        errno: 0,
        syscall: "listen",
      });
    const hostname = options.hostname ?? "0.0.0.0";
    const maxBody = options.maxBodySize ?? 128 * 1024 * 1024;
    const tls = options.tls;
    const opened =
      tls == undefined
        ? netListen(hostname, options.port ?? 8000, maxBody)
        : tlsListen(hostname, options.port ?? 8000, maxBody, tls.cert, tls.key);
    if (opened.isErr()) return err(opened.error);
    this.listened = true;
    const listener = opened.value;
    this.listener = listener;
    const scheme = tls == undefined ? "http" : "https";
    const port = netListenerPort(listener);
    this.port = port;
    this.hostname = hostname;
    const any = hostname == "0.0.0.0" || hostname == "::";
    const host = any ? "localhost" : hostname;
    const url = new URL(
      scheme +
        "://" +
        (host.includes(":") ? "[" + host + "]" : host) +
        ":" +
        String(port) +
        "/",
    );
    this.url = url;
    const shown = hostname.includes(":") ? "[" + hostname + "]" : hostname;
    this.base = scheme + "://" + shown + ":" + String(port);
    const sweep = setInterval(() => {
      netSweep(listener, KEEP_ALIVE_MS);
    }, 1000);
    sweep.unref();
    this.sweep = sweep;
    void this.accept(listener);
    const signal = options.signal;
    if (signal != undefined) {
      if (signal.aborted) void this.stop();
      else
        signal.addEventListener(
          "abort",
          (event: Event) => {
            void this.stop();
          },
          { once: true },
        );
    }
    options.onListen?.({ hostname, port });
    return ok(url);
  }

  async stop(): Promise<void> {
    const listener = this.listener;
    if (listener == undefined) return;
    if (!this.stopping) {
      this.stopping = true;
      const sweep = this.sweep;
      if (sweep != undefined) clearInterval(sweep);
      this.sweep = undefined;
      netCloseListener(listener);
      netSweep(listener, 0);
      if (this.open == 0) this.resolveFinished();
    }
    await this.finished;
  }

  private async accept(listener: object) {
    for (;;) {
      const socket = await netAccept(listener);
      if (socket == undefined) break;
      void this.serve(new Connection(socket));
    }
  }

  private async serve(conn: Connection) {
    this.open++;
    for (;;) {
      const got = await ahead(conn.next());
      if (got.isErr() || got.value == 0) break;
      const request = Request.readFrom(conn, this.base);
      const answer = this.handler(request);
      const response =
        answer instanceof Response ? answer : await ahead(answer);
      const streaming = response.writeTo(conn, request.method == "HEAD");
      if (streaming != undefined) await streaming;
      if (!conn.keepAlive()) break;
    }
    order();
    conn.close();
    this.open--;
    if (this.stopping && this.open == 0) this.resolveFinished();
  }
}
