import { Connection, Request, Response } from "tz:fetch";
import { URL } from "tz:url";
import { WebSocket, acceptKey } from "tz:websocket";
import { ahead, order } from "tz:intrinsics";

declare function netListen(
  host: string,
  port: int,
  maxBody: double,
  keepAlive: int,
  headersTimeout: int,
  requestTimeout: int,
): Result<object, SystemError>;
declare function tlsListen(
  host: string,
  port: int,
  maxBody: double,
  keepAlive: int,
  headersTimeout: int,
  requestTimeout: int,
  cert: string,
  key: string,
): Result<object, SystemError>;
declare function netListenerPort(listener: object): int;
declare function netListenerUrl(listener: object): string;
declare function netAccept(listener: object): Promise<object | undefined>;
declare function netCloseListener(listener: object): void;
declare function netAbortAll(listener: object): void;
declare function netDrained(listener: object): Promise<void>;
declare function netClientAddress(socket: object): string;
declare function netClientPort(socket: object): int;

export type Handler = (
  request: Request,
  client: Client,
) => Response | Promise<Response>;

export type Client = {
  address: string;
  port: int;
};

export type ServeOptions = {
  port?: int;
  hostname?: string;
  maxBodySize?: double;
  keepAliveTimeout?: int;
  headersTimeout?: int;
  requestTimeout?: int;
  transport?: ServeTransport;
};

export type ServeTransport =
  | {
      secure: false;
    }
  | {
      secure: true;
      cert: string;
      key: string;
    };

export type StopOptions = {
  timeout?: int;
};

export type UpgradeOptions = {
  protocol?: string;
  maxMessageSize?: int;
};

export type UpgradeError = {
  kind: "REQUEST";
  code: "ERR_NOT_WEBSOCKET" | "ERR_UNSUPPORTED_VERSION";
  message: string;
};

export class Upgraded {
  public readonly socket: WebSocket;
  public readonly response: Response;

  public constructor(socket: WebSocket, response: Response) {
    this.socket = socket;
    this.response = response;
  }
}

export function upgradeWebSocket(
  request: Request,
  options?: UpgradeOptions,
): Result<Upgraded, UpgradeError> {
  const upgrade = (request.headers.get("upgrade") ?? "").toLowerCase();
  const key = request.headers.get("sec-websocket-key") ?? "";
  if (upgrade != "websocket" || key == "") {
    return err({
      kind: "REQUEST",
      code: "ERR_NOT_WEBSOCKET",
      message: "the request does not ask for a WebSocket: no 'upgrade: websocket' or no key",
    });
  }
  const version = request.headers.get("sec-websocket-version") ?? "";
  if (version != "13") {
    return err({
      kind: "REQUEST",
      code: "ERR_UNSUPPORTED_VERSION",
      message: `the WebSocket version ${version} is not 13`,
    });
  }
  const protocol = options?.protocol ?? "";
  const socket = WebSocket.forServer(protocol, options?.maxMessageSize ?? 16 * 1024 * 1024);
  const accept = acceptKey(key);
  const headers: Record<string, string> = {
    upgrade: "websocket",
    connection: "Upgrade",
    "sec-websocket-accept": accept,
  };
  if (protocol != "") {
    headers["sec-websocket-protocol"] = protocol;
  }
  const response = Response.switchingProtocols(headers, (conn: Connection) => socket.attach(conn));
  const upgraded = new Upgraded(socket, response);

  return ok(upgraded);
}

export type ListenError = {
  kind: "SERVER";
  code: ListenErrorCode;
  message: string;
  errno: int;
  syscall: string;
  address: string;
  port: int;
};

export type ListenErrorCode =
  | "EADDRINUSE"
  | "EACCES"
  | "EADDRNOTAVAIL"
  | "ENOTFOUND"
  | "ERR_INVALID_ARG_VALUE"
  | "ERR_TLS_CERT"
  | "ERR_TLS_KEY"
  | "EMFILE"
  | "ENOBUFS"
  | "EAFNOSUPPORT"
  | "UNKNOWN";

function listenCode(code: string): ListenErrorCode {
  switch (code) {
    case "EADDRINUSE":
      return "EADDRINUSE";
    case "EACCES":
      return "EACCES";
    case "EADDRNOTAVAIL":
      return "EADDRNOTAVAIL";
    case "ENOTFOUND":
      return "ENOTFOUND";
    case "ERR_INVALID_ARG_VALUE":
      return "ERR_INVALID_ARG_VALUE";
    case "ERR_TLS_CERT":
      return "ERR_TLS_CERT";
    case "ERR_TLS_KEY":
      return "ERR_TLS_KEY";
    case "EMFILE":
      return "EMFILE";
    case "ENOBUFS":
      return "ENOBUFS";
    case "EAFNOSUPPORT":
      return "EAFNOSUPPORT";
    default:
      return "UNKNOWN";
  }
}

class Listener {
  public readonly native: object;

  public constructor(native: object) {
    this.native = native;
  }
}

export class Server {
  private readonly hostname: string;
  private readonly port: int;
  private readonly maxBody: double;
  private readonly keepAlive: int;
  private readonly headersTimeout: int;
  private readonly requestTimeout: int;
  private readonly transport: ServeTransport;
  private readonly handler: Handler;

  public constructor(options: ServeOptions, handler: Handler) {
    this.hostname = options.hostname ?? "0.0.0.0";
    this.port = options.port ?? 8000;
    this.maxBody = options.maxBodySize ?? 128 * 1024 * 1024;
    this.keepAlive = options.keepAliveTimeout ?? 5000;
    this.headersTimeout = options.headersTimeout ?? 60000;
    this.requestTimeout = options.requestTimeout ?? 300000;
    this.transport = options.transport ?? { secure: false };
    this.handler = handler;
  }

  public listen(): Result<Listening, ListenError> {
    const opened = this.open();

    if (opened.isErr()) {
      const code = listenCode(opened.error.code);

      return err({
        kind: "SERVER",
        code: code,
        message: opened.error.message,
        errno: opened.error.errno,
        syscall: opened.error.syscall,
        address: this.hostname,
        port: this.port,
      });
    }

    const listener = new Listener(opened.value);
    const listening = new Listening(listener, this.hostname, this.handler);

    return ok(listening);
  }

  private open(): Result<object, SystemError> {
    const transport = this.transport;
    if (transport.secure) {
      const secured = tlsListen(
        this.hostname,
        this.port,
        this.maxBody,
        this.keepAlive,
        this.headersTimeout,
        this.requestTimeout,
        transport.cert,
        transport.key,
      );

      return secured;
    }
    const plain = netListen(
      this.hostname,
      this.port,
      this.maxBody,
      this.keepAlive,
      this.headersTimeout,
      this.requestTimeout,
    );

    return plain;
  }
}

export class Listening {
  public readonly url: URL;
  public readonly hostname: string;
  public readonly port: int;

  private readonly listener: Listener;
  private readonly accepting: Promise<void>;
  private stopping: boolean;

  public constructor(listener: Listener, hostname: string, handler: Handler) {
    this.listener = listener;
    this.stopping = false;
    const href = netListenerUrl(listener.native);
    this.url = new URL(href);
    this.hostname = hostname;
    this.port = netListenerPort(listener.native);
    this.accepting = Listening.acceptAll(listener, handler);
  }

  public async stop(options?: StopOptions): Promise<void> {
    const native = this.listener.native;
    if (!this.stopping) {
      this.stopping = true;
      netCloseListener(native);
    }
    const timeout = options?.timeout;
    if (timeout == undefined) {
      await this.accepting;
      return;
    }
    if (timeout <= 0) {
      netAbortAll(native);
      await this.accepting;
      return;
    }
    const timer = setTimeout(() => netAbortAll(native), timeout);
    await this.accepting;
    clearTimeout(timer);
  }

  private static async acceptAll(
    listener: Listener,
    handler: Handler,
  ): Promise<void> {
    for (;;) {
      const socket = await netAccept(listener.native);
      if (socket == undefined) {
        break;
      }
      void Listening.serve(socket, handler);
    }
    await netDrained(listener.native);
  }

  private static async serve(socket: object, handler: Handler): Promise<void> {
    const address = netClientAddress(socket);
    const port = netClientPort(socket);
    const client: Client = {
      address: address,
      port: port,
    };
    const conn = new Connection(socket);
    for (;;) {
      const next = conn.next();
      const got = await ahead(next);
      if (got.isErr() || got.value == 0) {
        break;
      }
      const request = Request.readFrom(conn);
      const handled = handler(request, client);
      const response = await ahead(handled);
      const headOnly = request.method == "HEAD";
      const written = response.writeTo(conn, headOnly);
      if (written.kind == "streaming") {
        await written.finished;
      }
      const upgrade = response.upgrade;
      if (upgrade != undefined) {
        upgrade(conn);
        return;
      }
      if (!conn.keepAlive()) {
        break;
      }
    }
    order();
    conn.close();
  }
}
