import { URL, URLSearchParams, percentDecode } from "tz:url"
import { ahead, defer, NativeError } from "tz:intrinsics"

declare function netConnect(host: string, port: int,
                            deadline: object | undefined): Promise<Result<object, NativeError>>
declare function netClose(conn: object): void
declare function tlsConnect(conn: object, host: string,
                            deadline: object | undefined): Promise<Result<void, NativeError>>
declare function httpRequest(conn: object, method: string, target: string, headers: string[],
                             text: string, bytes: Uint8Array | undefined, flags: int): void
declare function httpResponse(conn: object,
                              deadline: object | undefined): Promise<Result<int, NativeError>>
declare function httpStatusText(conn: object): string
declare function httpHeaders(conn: object): string[]
declare function httpHasBody(conn: object): boolean
declare function httpRead(conn: object, deadline: object | undefined):
  Promise<Result<Uint8Array | undefined, NativeError>>
declare function httpReadAll(conn: object, deadline: object | undefined):
  Promise<Result<Uint8Array, NativeError>>
declare function httpReusable(conn: object): boolean
declare function httpAlive(conn: object): boolean
declare function httpOfferH2(conn: object): void
declare function httpIsH2(conn: object): boolean
declare function httpStartClient(conn: object): void
declare function httpOpenStream(conn: object): object | undefined
declare function httpStreamsLeft(conn: object): int
declare function http2End(conn: object, trailers: string[]): int
declare function http2Reset(conn: object, code: int): void
declare function http2ErrorCode(conn: object): int
declare function http2Field(conn: object, which: int): string
declare function http2Trailers(conn: object): string[]
declare function http2Headers(conn: object): string[]
declare function http2Flags(conn: object): int
declare function http2ConnectionState(conn: object): int
declare function http2Close(conn: object): void
declare function http2Read(conn: object): Promise<Result<Uint8Array | undefined, NativeError>>
declare function http2Write(conn: object, chunk: Uint8Array): Promise<Result<void, NativeError>>
declare function http2Response(conn: object): Promise<Result<int, NativeError>>
declare function http2Request(conn: object, method: string, target: string, headers: string[]): void
declare function http2Respond(conn: object, status: int, headers: string[]): int
declare function httpWrite(conn: object, chunk: Uint8Array): Promise<Result<void, NativeError>>
declare function httpEnd(conn: object): void
declare function httpNext(conn: object): Promise<Result<int, NativeError>>
declare function httpMethod(conn: object): string
declare function httpTarget(conn: object): string
declare function httpKeepAlive(conn: object): boolean
declare function httpEndAfter(conn: object): void
declare function httpBodyLimit(conn: object): double
declare function tcpRead(conn: object, deadline: object | undefined):
  Promise<Result<Uint8Array | undefined, NativeError>>
declare function httpRequestTimeout(conn: object): int
declare function httpRespond(conn: object, status: int, statusText: string, headers: string[],
                             text: string, bytes: Uint8Array | undefined, flags: int): void
declare function zlibNew(kind: int): object
declare function zlibPush(decoder: object, chunk: Uint8Array): Result<Uint8Array, NativeError>
declare function zlibEnd(decoder: object): Result<Uint8Array, NativeError>
declare function deadlineNew(): object
declare function deadlinePass(deadline: object): void
declare function deadlinePassed(deadline: object): boolean

const SEND_STREAM = 1
const SEND_NO_BODY = 4
const SEND_BYTES = 8

const DEFAULT_REQUEST_HEADERS: [string, string][] = [
  ["connection", "keep-alive"], ["accept", "*/*"], ["accept-language", "*"],
  ["sec-fetch-mode", "cors"], ["user-agent", "tz"], ["accept-encoding", "gzip, deflate, br"],
]

export class Connection {
  origin = ""
  status = 0
  absolute = false
  proxyAuth = ""
  protocol: ResponseProtocol = "http/1.1"
  private socket: object
  private head: string[] = []

  constructor(socket: object) {
    this.socket = socket
  }

  static async open(host: string, port: int, secure: boolean, deadline: object | undefined,
                    offerH2: boolean): Promise<Result<Connection, NativeError>> {
    const connected = await netConnect(host, port, deadline)
    if (connected.isErr()) return err(connected.error)
    const socket = connected.value
    if (secure) {
      if (offerH2) httpOfferH2(socket)
      const secured = await tlsConnect(socket, host, deadline)
      if (secured.isErr()) {
        netClose(socket)
        return err(secured.error)
      }
    }
    return ok(new Connection(socket))
  }

  close() {
    netClose(this.socket)
  }

  async secure(host: string, deadline?: object): Promise<Result<void, NativeError>> {
    return tlsConnect(this.socket, host, deadline)
  }

  readRaw(deadline?: object): Promise<Result<Uint8Array | undefined, NativeError>> {
    return tcpRead(this.socket, deadline)
  }

  setHead(headers: string[]) {
    this.head = headers
  }

  headerList(): string[] {
    return httpHeaders(this.socket)
  }

  request(method: string, url: URL, text: string, bytes: Uint8Array | undefined, flags: int) {
    const head = this.head
    const out: string[] = ["host", url.host()]
    for (let i = 0; i + 1 < head.length; i += 2) {
      const name = head[i] ?? ""
      if (name == "host") continue
      out.push(name)
      out.push(head[i + 1] ?? "")
    }
    for (const [name, value] of DEFAULT_REQUEST_HEADERS)
      if (!hasName(head, name)) {
        out.push(name)
        out.push(value)
      }
    if (this.proxyAuth != "") {
      out.push("proxy-authorization")
      out.push(`Basic ${this.proxyAuth}`)
    }
    const path = (url.pathname() == "" ? "/" : url.pathname()) + url.search()
    const target = this.absolute ? url.protocol() + "//" + url.host() + path : path
    httpRequest(this.socket, method, target, out, text, bytes, flags)
  }

  respond(status: int, statusText: string, text: string, bytes: Uint8Array | undefined,
          flags: int) {
    httpRespond(this.socket, status, statusText, this.head, text, bytes, flags)
  }

  requestStream(method: string, target: string, headers: string[]) {
    http2Request(this.socket, method, target, headers)
  }

  respondStream(status: int, headers: string[]): int {
    return http2Respond(this.socket, status, headers)
  }

  endStream(trailers: string[]): int {
    return http2End(this.socket, trailers)
  }

  readStream(): Promise<Result<Uint8Array | undefined, NativeError>> {
    return http2Read(this.socket)
  }

  writeStream(chunk: Uint8Array): Promise<Result<void, NativeError>> {
    return http2Write(this.socket, chunk)
  }

  responseStream(): Promise<Result<int, NativeError>> {
    return http2Response(this.socket)
  }

  headerCopy(): string[] {
    return http2Headers(this.socket)
  }

  streamFlags(): int {
    return http2Flags(this.socket)
  }

  reset(code: int) {
    http2Reset(this.socket, code)
  }

  errorCode(): int {
    return http2ErrorCode(this.socket)
  }

  field(which: int): string {
    return http2Field(this.socket, which)
  }

  trailerList(): string[] {
    return http2Trailers(this.socket)
  }

  connectionState(): int {
    return http2ConnectionState(this.socket)
  }

  closeHttp2() {
    http2Close(this.socket)
  }

  async response(deadline?: object): Promise<Result<void, NativeError>> {
    const status = await httpResponse(this.socket, deadline)
    if (status.isErr()) return err(status.error)
    this.status = status.value
    return ok(undefined)
  }

  statusText(): string {
    return httpStatusText(this.socket)
  }

  hasBody(): boolean {
    return httpHasBody(this.socket)
  }

  read(deadline?: object): Promise<Result<Uint8Array | undefined, NativeError>> {
    return httpRead(this.socket, deadline)
  }

  readAll(deadline?: object): Promise<Result<Uint8Array, NativeError>> {
    return httpReadAll(this.socket, deadline)
  }

  write(chunk: Uint8Array): Promise<Result<void, NativeError>> {
    return httpWrite(this.socket, chunk)
  }

  end() {
    httpEnd(this.socket)
  }

  endAfter() {
    httpEndAfter(this.socket)
  }

  reusable(): boolean {
    return httpReusable(this.socket)
  }

  alive(): boolean {
    return httpAlive(this.socket)
  }

  isH2(): boolean {
    return httpIsH2(this.socket)
  }

  startH2() {
    httpStartClient(this.socket)
    this.protocol = "h2"
  }

  openStream(): Connection | undefined {
    const stream = httpOpenStream(this.socket)
    if (stream == undefined) {
      return undefined
    }
    const conn = new Connection(stream)
    conn.protocol = "h2"

    return conn
  }

  streamsLeft(): int {
    return httpStreamsLeft(this.socket)
  }

  next(): Promise<Result<int, NativeError>> {
    return httpNext(this.socket)
  }

  method(): string {
    return httpMethod(this.socket)
  }

  target(): string {
    return httpTarget(this.socket)
  }

  keepAlive(): boolean {
    return httpKeepAlive(this.socket)
  }

  bodyLimit(): double {
    return httpBodyLimit(this.socket)
  }

  requestTimeout(): int {
    return httpRequestTimeout(this.socket)
  }
}

function hasName(list: string[], name: string): boolean {
  for (let i = 0; i < list.length; i += 2) if (list[i] == name) return true
  return false
}

function isTokenChar(c: int): boolean {
  if ((c >= 0x30 && c <= 0x39) || (c >= 0x41 && c <= 0x5a) || (c >= 0x61 && c <= 0x7a)) return true
  return c == 0x21 || c == 0x23 || c == 0x24 || c == 0x25 || c == 0x26 || c == 0x27 || c == 0x2a ||
         c == 0x2b || c == 0x2d || c == 0x2e || c == 0x5e || c == 0x5f || c == 0x60 || c == 0x7c ||
         c == 0x7e
}

function isToken(s: string): boolean {
  if (s == "") return false
  for (let i = 0; i < s.length; i++) if (!isTokenChar(s.charCodeAt(i))) return false
  return true
}

function isHttpSpace(c: int): boolean {
  return c == 0x20 || c == 0x09 || c == 0x0a || c == 0x0d
}

function normalizeValue(value: string): string {
  let start = 0
  let end = value.length
  while (start < end && isHttpSpace(value.charCodeAt(start))) start++
  while (end > start && isHttpSpace(value.charCodeAt(end - 1))) end--
  return value.slice(start, end)
}

function headerValue(value: string): string {
  const v = normalizeValue(value)
  let kept = ""
  let from = 0
  for (let i = 0; i < v.length; i++) {
    const c = v.charCodeAt(i)
    if (c != 0 && c != 0x0a && c != 0x0d) continue
    kept += v.slice(from, i)
    from = i + 1
  }
  return from == 0 ? v : kept + v.slice(from)
}

export type HeadersInit = Headers | [string, string][] | Record<string, string>

export class Headers {
  private list: string[] = []
  private shown?: string[]

  constructor(init?: HeadersInit) {
    if (init == undefined) return
    if (init instanceof Headers) {
      this.list = [...init.list]
      const shown = init.shown
      if (shown != undefined) this.shown = [...shown]
    } else if (Array.isArray(init)) {
      for (const pair of init) this.append(pair[0], pair[1])
    } else {
      for (const [name, value] of Object.entries(init)) this.append(name, value)
    }
  }

  static readFrom(conn: Connection): Headers {
    const h = new Headers()
    h.list = conn.headerList()
    return h
  }

  static fromList(conn: Connection, list: string[]): Headers {
    void conn
    const h = new Headers()
    h.list = list
    return h
  }

  listFor(conn: Connection): string[] {
    void conn
    return [...this.list]
  }

  writeTo(conn: Connection) {
    conn.setHead(this.list)
  }

  private push(name: string, lower: string, value: string) {
    let shown = this.shown
    if (shown == undefined && name != lower) {
      shown = []
      for (let i = 0; i < this.list.length; i += 2) shown.push(this.list[i] ?? "")
      this.shown = shown
    }
    shown?.push(name)
    this.list.push(lower)
    this.list.push(value)
  }

  private keep(keep: (i: int) => boolean) {
    const list: string[] = []
    const shown = this.shown
    const kept: string[] = []
    for (let i = 0; i + 1 < this.list.length; i += 2) {
      if (!keep(i)) continue
      list.push(this.list[i] ?? "")
      list.push(this.list[i + 1] ?? "")
      if (shown != undefined) kept.push(shown[i >> 1] ?? "")
    }
    this.list = list
    if (shown != undefined) this.shown = kept
  }

  append(name: string, value: string) {
    if (!isToken(name)) return
    this.push(name, name.toLowerCase(), headerValue(value))
  }

  delete(name: string) {
    if (!isToken(name)) return
    const lower = name.toLowerCase()
    if (this.list.includes(lower)) this.keep(i => this.list[i] != lower)
  }

  get(name: string): string | undefined {
    const list = this.list
    const lower = isLower(name) ? name : name.toLowerCase()
    let out: string | undefined = undefined
    for (let i = 0; i + 1 < list.length; i += 2)
      if (list[i] == lower) {
        const v = list[i + 1] ?? ""
        out = out == undefined ? v : out + ", " + v
      }
    return out
  }

  getSetCookie(): string[] {
    const out: string[] = []
    for (let i = 0; i + 1 < this.list.length; i += 2)
      if (this.list[i] == "set-cookie") out.push(this.list[i + 1] ?? "")
    return out
  }

  has(name: string): boolean {
    if (!isToken(name)) return false
    const list = this.list
    const lower = name.toLowerCase()
    for (let i = 0; i < list.length; i += 2) if (list[i] == lower) return true
    return false
  }

  set(name: string, value: string) {
    if (!isToken(name)) return
    const v = headerValue(value)
    const lower = name.toLowerCase()
    const list = this.list
    let at = -1
    for (let i = 0; i < list.length && at < 0; i += 2) if (list[i] == lower) at = i
    if (at < 0) {
      this.push(name, lower, v)
      return
    }
    const valueAt = at + 1
    if (valueAt >= 0 && valueAt < list.length) list[valueAt] = v
    this.keep(i => i <= at || this.list[i] != lower)
  }

  private sorted(): [string, string][] {
    const names: string[] = []
    for (let i = 0; i < this.list.length; i += 2) {
      const name = this.list[i] ?? ""
      if (!names.includes(name)) names.push(name)
    }
    names.sort()
    const out: [string, string][] = []
    for (const name of names) {
      if (name == "set-cookie") {
        for (const v of this.getSetCookie()) out.push([name, v])
        continue
      }
      out.push([name, this.get(name) ?? ""])
    }
    return out
  }

  forEach(callback: (value: string, key: string, parent: Headers) => void) {
    for (const [name, value] of this.sorted()) callback(value, name, this)
  }

  *entries(): IterableIterator<[string, string]> {
    for (const pair of this.sorted()) yield pair
  }

  *keys(): IterableIterator<string> {
    for (const pair of this.sorted()) yield pair[0]
  }

  *values(): IterableIterator<string> {
    for (const pair of this.sorted()) yield pair[1]
  }

  *[Symbol.iterator](): IterableIterator<[string, string]> {
    for (const pair of this.sorted()) yield pair
  }

  private printed(): [string, string][] {
    const out: [string, string][] = []
    const seen: string[] = []
    const shown = this.shown
    for (let i = 0; i < this.list.length; i += 2) {
      const name = this.list[i] ?? ""
      if (seen.includes(name)) continue
      seen.push(name)
      out.push([shown != undefined ? shown[i >> 1] ?? name : name, this.get(name) ?? ""])
    }
    return out
  }
}

function isLower(s: string): boolean {
  for (let i = 0; i < s.length; i++) {
    const c = s.charCodeAt(i)
    if (c >= 0x41 && c <= 0x5a) return false
  }
  return true
}

export type ReadableStreamReadResult<R> = { done: false; value: R } | { done: true; value?: R }

type ReadResult<R, E> = Result<ReadableStreamReadResult<R>, E | ReaderError | ControllerClosedError>

class StreamState<R, E extends StreamError> {
  queue: R[] = []
  state = "readable"
  error?: E
  misuse?: ControllerClosedError
  source?: UnderlyingSource<R, E>
  started = false
  pulling = false
  pullAgain = false
  closeRequested = false
  locked = false
  disturbed = false
  bytes = false
  highWaterMark: double = 1
  reads: ((result: ReadResult<R, E>) => void)[] = []

  lock(locked: boolean) {
    this.locked = locked
  }

  disturb() {
    this.disturbed = true
  }
}

export interface UnderlyingSource<R, E extends StreamError = StreamError> {
  start?: (controller: ReadableStreamDefaultController<R, E>) => Promise<void> | undefined
  pull?: (controller: ReadableStreamDefaultController<R, E>) => Promise<void> | undefined
  cancel?: (reason: string | undefined) => Promise<void> | undefined
  type?: string
}

export interface QueuingStrategy {
  highWaterMark?: double
}

function lockedError(): ReaderError {
  return {
    kind: "READER_ERROR",
    code: "ERR_STREAM_LOCKED",
    message: "the stream is locked: another reader holds it; read it with that reader",
  }
}

function releasedError(): ReaderError {
  return {
    kind: "READER_ERROR",
    code: "ERR_READER_RELEASED",
    message: "the reader has released the stream: get a new reader with getReader()",
  }
}

function closeStream<R, E extends StreamError>(s: StreamState<R, E>) {
  if (s.state != "readable") return
  s.state = "closed"
  s.source = undefined
  const reads = s.reads
  s.reads = []
  for (const r of reads) r(ok({ done: true }))
}

function errorStream<R, E extends StreamError>(s: StreamState<R, E>, e: E) {
  if (s.state != "readable") return
  s.state = "errored"
  s.error = e
  s.queue = []
  s.source = undefined
  const reads = s.reads
  s.reads = []
  for (const r of reads) r(err(e))
}

function misuseStream<R, E extends StreamError>(s: StreamState<R, E>, message: string) {
  if (s.state != "readable") {
    return
  }
  const problem: ControllerClosedError = {
    kind: "CONTROLLER_CLOSED_ERROR",
    code: "ERR_INVALID_STATE",
    message: message,
  }
  s.state = "errored"
  s.misuse = problem
  s.queue = []
  s.source = undefined
  const reads = s.reads
  s.reads = []
  for (const r of reads) {
    r(err(problem))
  }
}

function desiredSize<R, E extends StreamError>(s: StreamState<R, E>): double {
  return s.highWaterMark - s.queue.length.toDouble()
}

function pullIfNeeded<R, E extends StreamError>(s: StreamState<R, E>) {
  if (s.state != "readable" || s.closeRequested || !s.started) return
  const pull = s.source?.pull
  if (pull == undefined) return
  if (s.reads.length == 0 && desiredSize(s) <= 0) return
  if (s.pulling) {
    s.pullAgain = true
    return
  }
  s.pulling = true
  const pulled = pull(new ReadableStreamDefaultController<R, E>(s))
  if (pulled == undefined) {
    afterPull(s)
    return
  }
  void pulled.then(() => afterPull(s))
}

function afterPull<R, E extends StreamError>(s: StreamState<R, E>) {
  s.pulling = false
  if (s.pullAgain) {
    s.pullAgain = false
    pullIfNeeded(s)
  }
}

export class ReadableStreamDefaultController<R, E extends StreamError = StreamError> {
  private s: StreamState<R, E>

  constructor(state: StreamState<R, E>) {
    this.s = state
  }

  desiredSize(): double {
    return this.s.state == "readable" ? desiredSize(this.s) : 0
  }

  enqueue(chunk: R) {
    const s = this.s
    if (s.state != "readable") return
    if (s.closeRequested) {
      misuseStream(s, "enqueue() after close(): this stream has already been closed")
      return
    }
    const read = s.reads.shift()
    if (read != undefined) read(ok({ done: false, value: chunk }))
    else s.queue.push(chunk)
    pullIfNeeded(s)
  }

  close() {
    const s = this.s
    if (s.state != "readable") return
    if (s.closeRequested) {
      misuseStream(s, "close() was already called on this stream")
      return
    }
    s.closeRequested = true
    if (s.queue.length == 0) closeStream(s)
  }

  error(e: E) {
    errorStream(this.s, e)
  }
}

export class ReadableStreamDefaultReader<R, E extends StreamError = StreamError> {
  private s?: StreamState<R, E>
  private problem?: ReaderError

  constructor(source: ReadableStream<R, E> | StreamState<R, E>) {
    if (source instanceof ReadableStream) {
      const made = source.getReader()
      this.s = made.s
      this.problem = made.problem
      return
    }
    if (source.locked) {
      this.problem = lockedError()
      return
    }
    source.lock(true)
    this.s = source
  }

  async read(): Promise<ReadResult<R, E>> {
    const s = this.s
    if (s == undefined) return err(this.problem ?? releasedError())
    s.disturb()
    if (s.queue.length > 0) {
      const chunk = s.queue.shift()
      if (s.closeRequested && s.queue.length == 0) closeStream(s)
      else pullIfNeeded(s)
      if (chunk != undefined) return ok({ done: false, value: chunk })
    }
    if (s.state == "closed") return ok({ done: true })
    if (s.state == "errored") {
      const error = s.error
      if (error != undefined) return err(error)
      const misuse = s.misuse
      if (misuse != undefined) return err(misuse)
    }
    const read = Promise.withResolvers<ReadResult<R, E>>()
    s.reads.push(read.resolve)
    pullIfNeeded(s)
    return read.promise
  }

  releaseLock() {
    const s = this.s
    if (s == undefined) return
    s.lock(false)
    this.s = undefined
    const reads = s.reads
    s.reads = []
    for (const r of reads) r(err(releasedError()))
  }

  async cancel(reason?: string): Promise<void> {
    const s = this.s
    if (s != undefined) await cancelStream(s, reason)
  }
}

async function cancelStream<R, E extends StreamError>(s: StreamState<R, E>,
                                                      reason: string | undefined): Promise<void> {
  s.disturb()
  if (s.state != "readable") return
  const cancel = s.source?.cancel
  s.queue = []
  closeStream(s)
  if (cancel != undefined) {
    const done = cancel(reason)
    if (done != undefined) await done
  }
}

function startedState<R, E extends StreamError>(source: UnderlyingSource<R, E> | undefined,
                            strategy: QueuingStrategy | undefined): StreamState<R, E> {
  const s = new StreamState<R, E>()
  s.source = source
  s.highWaterMark = strategy?.highWaterMark ?? (source?.type == "bytes" ? 0 : 1)
  s.bytes = source?.type == "bytes"
  const start = source?.start
  let started: Promise<void> | undefined = undefined
  if (start != undefined) started = start(new ReadableStreamDefaultController<R, E>(s))
  if (started == undefined) {
    queueMicrotask(() => {
      s.started = true
      pullIfNeeded(s)
    })
  } else {
    void started.then(() => {
      s.started = true
      pullIfNeeded(s)
    })
  }
  return s
}

export class ReadableStream<R = Uint8Array, E extends StreamError = StreamError> {
  private s?: StreamState<R, E>

  constructor(source?: UnderlyingSource<R, E>, strategy?: QueuingStrategy) {
    if (source != undefined || strategy != undefined) this.s = startedState(source, strategy)
  }

  public locked(): boolean {
    const s = this.s

    return s != undefined && s.locked
  }

  public disturbed(): boolean {
    const s = this.s

    return s != undefined && s.disturbed
  }

  public failure(): E | undefined {
    const s = this.s
    if (s == undefined) {
      return undefined
    }

    return s.error
  }

  protected open(): StreamState<R, E> {
    const s = new StreamState<R, E>()
    s.started = true
    return s
  }

  private state(): StreamState<R, E> {
    const s = this.s
    if (s != undefined) return s
    const opened = this.open()
    this.s = opened
    return opened
  }

  getReader(): ReadableStreamDefaultReader<R, E> {
    return new ReadableStreamDefaultReader<R, E>(this.state())
  }

  async cancel(reason?: string): Promise<void> {
    const s = this.state()
    if (s.locked) return
    await cancelStream(s, reason)
  }

  async *values(): AsyncGenerator<Result<R, E | ReaderError | ControllerClosedError>, void, void> {
    const reader = this.getReader()
    let finished = false
    const release = defer(() => {
      if (finished) {
        reader.releaseLock()
        return
      }
      void reader.cancel().then(() => reader.releaseLock())
    })
    for (;;) {
      const r = await reader.read()
      if (r.isErr()) {
        finished = true
        const failed: Result<R, E | ReaderError | ControllerClosedError> = err(r.error)
        yield failed
        return
      }
      const step = r.value
      if (step.done) {
        finished = true
        return
      }
      const item: Result<R, E | ReaderError | ControllerClosedError> = ok(step.value)
      yield item
    }
  }

  async *[Symbol.asyncIterator](): AsyncGenerator<Result<R, E | ReaderError | ControllerClosedError>, void, void> {
    yield* this.values()
  }
}

function bodyStream<E extends StreamError>(source: ReadableStream<Uint8Array, E>):
    ReadableStream<Uint8Array, BodyError> {
  let reader: ReadableStreamDefaultReader<Uint8Array, E> | undefined = undefined
  const stream = new ReadableStream<Uint8Array, BodyError>({
    type: "bytes",
    pull: async c => {
      let current = reader
      if (current == undefined) {
        if (source.locked()) {
          c.error(bodyLocked())
          return
        }
        current = source.getReader()
        reader = current
      }
      const r = await current.read()
      if (r.isOk()) {
        const step = r.value
        if (step.done) c.close()
        else c.enqueue(step.value)
        return
      }
      const failure = r.error
      const message = `the stream of the body failed: ${failure.message}`
      c.error({ kind: "BODY_ERROR_STREAM", code: "ERR_STREAM_FAILED", message: message })
    },
    cancel: async reason => {
      const current = reader
      if (current != undefined) await current.cancel(reason)
      else await source.cancel(reason)
    },
  })

  return stream
}

const BODY_NONE = 0
const BODY_TEXT = 1
const BODY_BYTES = 2
const BODY_STREAM = 3
const BODY_WIRE = 4

const CODING_GZIP = 1
const CODING_DEFLATE = 2
const CODING_BR = 3

export type Written =
  | {
      kind: "done"
    }
  | {
      kind: "streaming"
      finished: Promise<void>
    }

export type BodyData = string | Uint8Array | ArrayBuffer | URLSearchParams | FormData

type Decode = (chunk: Uint8Array, last: boolean) => Result<Uint8Array, NativeError>

function passed(deadline?: object): boolean {
  if (deadline == undefined) {
    return false;
  }

  return deadlinePassed(deadline);
}

export class Peer {
  public readonly host: string;
  public readonly port: int;
  public readonly timeout: int;
  public readonly deadline?: object;

  public constructor(host: string, port: int, timeout: int, deadline?: object) {
    this.host = host;
    this.port = port;
    this.timeout = timeout;
    this.deadline = deadline;
  }

  public name(): string {
    return `${this.host}:${this.port}`;
  }

  public passed(): boolean {
    return passed(this.deadline);
  }
}

export type NetworkCode =
  | "ENOTFOUND"
  | "EAI_AGAIN"
  | "ECONNREFUSED"
  | "ETIMEDOUT"
  | "ENETUNREACH"
  | "EHOSTUNREACH"
  | "EADDRNOTAVAIL"
  | "ECONNRESET"
  | "ECONNABORTED"
  | "EPIPE"
  | "EMFILE"
  | "ENOBUFS"
  | "ERR_NOT_PROCESSED"
  | "ERR_STREAM_RESET"
  | "UNKNOWN";

function networkCode(code: string): NetworkCode {
  switch (code) {
    case "ENOTFOUND":
      return "ENOTFOUND";
    case "EAI_AGAIN":
      return "EAI_AGAIN";
    case "ECONNREFUSED":
      return "ECONNREFUSED";
    case "ETIMEDOUT":
      return "ETIMEDOUT";
    case "ENETUNREACH":
      return "ENETUNREACH";
    case "EHOSTUNREACH":
      return "EHOSTUNREACH";
    case "EADDRNOTAVAIL":
      return "EADDRNOTAVAIL";
    case "ECONNRESET":
      return "ECONNRESET";
    case "ECONNABORTED":
      return "ECONNABORTED";
    case "EPIPE":
      return "EPIPE";
    case "EMFILE":
      return "EMFILE";
    case "ENOBUFS":
      return "ENOBUFS";
    case "ERR_NOT_PROCESSED":
      return "ERR_NOT_PROCESSED";
    case "ERR_STREAM_RESET":
      return "ERR_STREAM_RESET";
    default:
      return "UNKNOWN";
  }
}

export function networkMessage(code: NetworkCode, peer: Peer, stage: string, detail: string): string {
  const name = peer.name();
  switch (code) {
    case "ENOTFOUND":
      return `could not find the address of ${peer.host}: no such name in DNS`;
    case "EAI_AGAIN":
      return `could not find the address of ${peer.host}: DNS did not answer; check the network`;
    case "ECONNREFUSED":
      return `could not connect to ${name}: nothing listens on this port`;
    case "ETIMEDOUT":
      return `could not connect to ${name}: the host did not answer in time`;
    case "ENETUNREACH":
      return `could not connect to ${name}: the network is unreachable`;
    case "EHOSTUNREACH":
      return `could not connect to ${name}: the host is unreachable`;
    case "EADDRNOTAVAIL":
      return `could not connect to ${name}: the address is not available on this machine`;
    case "ECONNRESET":
      return `the connection to ${name} was reset while ${stage}`;
    case "ECONNABORTED":
      return `the connection to ${name} was aborted on this machine while ${stage}`;
    case "EPIPE":
      return `the connection to ${name} broke while ${stage}`;
    case "EMFILE":
      return `could not connect to ${name}: too many files and sockets are open in this program`;
    case "ENOBUFS":
      return `could not connect to ${name}: the system has no buffer space left`;
    case "ERR_NOT_PROCESSED":
      return `${name} did not process the request (HTTP/2), so it can be sent again`;
    case "ERR_STREAM_RESET":
      return `${name} reset the HTTP/2 stream of the request while ${stage}`;
    case "UNKNOWN":
      return `the connection to ${name} failed while ${stage}: ${detail}`;
  }
}

export function tlsCode(code: string): TlsCode | undefined {
  switch (code) {
    case "UNABLE_TO_GET_ISSUER_CERT":
      return "UNABLE_TO_GET_ISSUER_CERT";
    case "UNABLE_TO_GET_CRL":
      return "UNABLE_TO_GET_CRL";
    case "UNABLE_TO_DECRYPT_CERT_SIGNATURE":
      return "UNABLE_TO_DECRYPT_CERT_SIGNATURE";
    case "UNABLE_TO_DECRYPT_CRL_SIGNATURE":
      return "UNABLE_TO_DECRYPT_CRL_SIGNATURE";
    case "UNABLE_TO_DECODE_ISSUER_PUBLIC_KEY":
      return "UNABLE_TO_DECODE_ISSUER_PUBLIC_KEY";
    case "CERT_SIGNATURE_FAILURE":
      return "CERT_SIGNATURE_FAILURE";
    case "CRL_SIGNATURE_FAILURE":
      return "CRL_SIGNATURE_FAILURE";
    case "CERT_NOT_YET_VALID":
      return "CERT_NOT_YET_VALID";
    case "CERT_HAS_EXPIRED":
      return "CERT_HAS_EXPIRED";
    case "CRL_NOT_YET_VALID":
      return "CRL_NOT_YET_VALID";
    case "CRL_HAS_EXPIRED":
      return "CRL_HAS_EXPIRED";
    case "ERROR_IN_CERT_NOT_BEFORE_FIELD":
      return "ERROR_IN_CERT_NOT_BEFORE_FIELD";
    case "ERROR_IN_CERT_NOT_AFTER_FIELD":
      return "ERROR_IN_CERT_NOT_AFTER_FIELD";
    case "ERROR_IN_CRL_LAST_UPDATE_FIELD":
      return "ERROR_IN_CRL_LAST_UPDATE_FIELD";
    case "ERROR_IN_CRL_NEXT_UPDATE_FIELD":
      return "ERROR_IN_CRL_NEXT_UPDATE_FIELD";
    case "OUT_OF_MEM":
      return "OUT_OF_MEM";
    case "DEPTH_ZERO_SELF_SIGNED_CERT":
      return "DEPTH_ZERO_SELF_SIGNED_CERT";
    case "SELF_SIGNED_CERT_IN_CHAIN":
      return "SELF_SIGNED_CERT_IN_CHAIN";
    case "UNABLE_TO_GET_ISSUER_CERT_LOCALLY":
      return "UNABLE_TO_GET_ISSUER_CERT_LOCALLY";
    case "UNABLE_TO_VERIFY_LEAF_SIGNATURE":
      return "UNABLE_TO_VERIFY_LEAF_SIGNATURE";
    case "CERT_CHAIN_TOO_LONG":
      return "CERT_CHAIN_TOO_LONG";
    case "CERT_REVOKED":
      return "CERT_REVOKED";
    case "INVALID_CA":
      return "INVALID_CA";
    case "PATH_LENGTH_EXCEEDED":
      return "PATH_LENGTH_EXCEEDED";
    case "INVALID_PURPOSE":
      return "INVALID_PURPOSE";
    case "CERT_UNTRUSTED":
      return "CERT_UNTRUSTED";
    case "CERT_REJECTED":
      return "CERT_REJECTED";
    case "HOSTNAME_MISMATCH":
      return "HOSTNAME_MISMATCH";
    case "UNSPECIFIED":
      return "UNSPECIFIED";
    case "ERR_TLS_CERT_ALTNAME_INVALID":
      return "ERR_TLS_CERT_ALTNAME_INVALID";
    case "ERR_NO_TLS":
      return "ERR_TLS_HANDSHAKE";
  }
  if (code.startsWith("ERR_SSL_") || code.startsWith("ERR_OSSL_")) {
    return "ERR_TLS_HANDSHAKE";
  }

  return undefined;
}

const SYSTEM_CA_HINT =
  "; if its root CA is installed on this machine, run with NODE_USE_SYSTEM_CA=1";

export function tlsMessage(code: TlsCode, host: string, detail: string): string {
  const hint = detail.includes("NODE_USE_SYSTEM_CA") ? SYSTEM_CA_HINT : "";
  switch (code) {
    case "CERT_HAS_EXPIRED":
      return `the certificate of ${host} has expired`;
    case "CERT_NOT_YET_VALID":
      return `the certificate of ${host} is not valid yet`;
    case "DEPTH_ZERO_SELF_SIGNED_CERT":
      return `the certificate of ${host} is self-signed, so it is not trusted${hint}`;
    case "SELF_SIGNED_CERT_IN_CHAIN":
      return `the certificates of ${host} lead to a root CA that is not trusted${hint}`;
    case "UNABLE_TO_VERIFY_LEAF_SIGNATURE":
      return `the certificate of ${host} is signed by an authority that is not known${hint}`;
    case "UNABLE_TO_GET_ISSUER_CERT_LOCALLY":
      return `the certificate of ${host} is signed by an authority that is not known${hint}`;
    case "ERR_TLS_CERT_ALTNAME_INVALID":
      return `the certificate is not for ${host}`;
    case "HOSTNAME_MISMATCH":
      return `the certificate is not for ${host}`;
    case "CERT_REVOKED":
      return `the certificate of ${host} is revoked`;
    case "ERR_TLS_HANDSHAKE":
      if (detail.includes("no application protocol")) {
        return `${host} speaks none of the offered versions of HTTP (TLS alert: no application ` +
               `protocol); with httpVersion: "1.1" only HTTP/1.1 is offered`;
      }

      return `the TLS handshake with ${host} failed: ${detail}`;
    default:
      return `the certificate of ${host} is not trusted: ${detail}`;
  }
}

function timeoutError(peer: Peer): FetchError {
  return {
    kind: "FETCH_ERROR_TIMEOUT",
    code: "TIMEOUT_ERR",
    message: `no full answer from ${peer.host} within ${peer.timeout} ms`,
    timeout: peer.timeout,
  };
}

function connectionError(e: NativeError, peer: Peer, stage: string): FetchError {
  if (peer.passed()) {
    return timeoutError(peer);
  }
  const tls = tlsCode(e.code);
  if (tls != undefined) {
    const message = tlsMessage(tls, peer.host, e.message);

    return { kind: "FETCH_ERROR_TLS", code: tls, message: message, host: peer.host };
  }
  if (e.code == "ERR_CLOSED") {
    return {
      kind: "FETCH_ERROR_RESPONSE",
      code: "ERR_CLOSED",
      message: `${peer.name()} closed the connection before the response`,
      host: peer.host,
      port: peer.port,
    };
  }
  if (e.code == "ERR_INVALID_RESPONSE") {
    return {
      kind: "FETCH_ERROR_RESPONSE",
      code: "ERR_INVALID_RESPONSE",
      message: `${peer.name()} did not answer in HTTP/1.1: ${e.message}`,
      host: peer.host,
      port: peer.port,
    };
  }
  if (e.code == "ERR_HEAD_TOO_LARGE") {
    return {
      kind: "FETCH_ERROR_RESPONSE",
      code: "ERR_HEAD_TOO_LARGE",
      message: `the head of the response from ${peer.name()} is larger than 16 KB`,
      host: peer.host,
      port: peer.port,
    };
  }
  const code = networkCode(e.code);
  const message = networkMessage(code, peer, stage, e.message);

  return {
    kind: "FETCH_ERROR_NETWORK",
    code: code,
    message: message,
    syscall: e.syscall,
    host: peer.host,
    port: peer.port,
  };
}

function requestError(
  code:
    | "ERR_INVALID_URL"
    | "ERR_CREDENTIALS_IN_URL"
    | "ERR_INVALID_METHOD"
    | "ERR_BODY_WITH_GET"
    | "ERR_DUPLEX_REQUIRED"
    | "ERR_REQUEST_USED"
    | "ERR_UNSUPPORTED_SCHEME"
    | "ERR_BLOCKED_PORT"
    | "ERR_BODY_FAILED",
  message: string,
  url: string,
): FetchError {
  return { kind: "FETCH_ERROR_REQUEST", code: code, message: message, url: url };
}

function redirectError(
  code:
    | "ERR_UNEXPECTED_REDIRECT"
    | "ERR_TOO_MANY_REDIRECTS"
    | "ERR_INVALID_LOCATION"
    | "ERR_REDIRECT_WITH_STREAM",
  message: string,
  location: string,
): FetchError {
  return { kind: "FETCH_ERROR_REDIRECT", code: code, message: message, location: location };
}

function bodyUsed(): BodyError {
  return {
    kind: "BODY_ERROR_USED",
    code: "ERR_BODY_USED",
    message: "the body is already read: text(), json(), bytes(), formData() and body() read it once",
  };
}

function bodyLocked(): BodyError {
  return {
    kind: "BODY_ERROR_USED",
    code: "ERR_BODY_LOCKED",
    message: "the body is locked: a reader of body() holds it",
  };
}

function formError(
  code: "ERR_NOT_A_FORM" | "ERR_NO_BOUNDARY" | "ERR_INVALID_MULTIPART",
  message: string,
  contentType: string | undefined,
): FormDataError {
  return { kind: "FORM_DATA_ERROR_CONTENT", code: code, message: message, contentType: contentType };
}

function jsonBody(text: Result<string, TextError>, contentType: string | undefined): Result<Json, JsonBodyError> {
  if (text.isErr()) {
    return text;
  }
  const parsed = JSON.parse(text.value);
  if (parsed.isErr()) {
    const message = `the body is not JSON: ${parsed.error.message}`;
    const start = text.value.slice(0, 200);

    return err({
      kind: "JSON_BODY_ERROR_CONTENT",
      code: "ERR_INVALID_JSON",
      message: message,
      contentType: contentType,
      start: start,
    });
  }

  return ok(parsed.value);
}

function bodyFailure(e: BodyError | ReaderError | ControllerClosedError): BodyError {
  if (e.kind == "READER_ERROR") {
    return bodyLocked();
  }
  if (e.kind == "CONTROLLER_CLOSED_ERROR") {
    const failure: BodyError = { kind: "BODY_ERROR_STREAM", code: "ERR_STREAM_FAILED", message: e.message };

    return failure;
  }

  return e;
}

class Wire {
  conn: Connection
  peer?: Peer
  decode?: Decode
  coding = ""
  finished = false
  failure?: BodyError

  constructor(conn: Connection, peer?: Peer) {
    this.conn = conn
    this.peer = peer
  }

  private decodeChunk(decode: Decode, chunk: Uint8Array, last: boolean): Result<Uint8Array, BodyError> {
    const data = decode(chunk, last)
    if (data.isErr()) {
      this.finished = true
      this.conn.close()
      const failure: BodyError = {
        kind: "BODY_ERROR_MALFORMED",
        code: "ERR_INVALID_COMPRESSION",
        message: `the body is not valid ${this.coding}: ${data.error.message}`,
      }
      this.failure = failure

      return err(failure)
    }
    return ok(data.value)
  }

  private failed(e: NativeError): BodyError {
    this.finished = true
    const failure = wireError(e, this.peer, this.conn)
    this.failure = failure

    return failure
  }

  private finish() {
    this.finished = true
    if (this.conn.origin != "") giveBack(this.conn)
  }

  async next(): Promise<Result<Uint8Array | undefined, BodyError>> {
    while (!this.finished) {
      const read = await this.conn.read(this.peer?.deadline)
      if (read.isErr()) return err(this.failed(read.error))
      const chunk = read.value
      const decode = this.decode
      if (chunk == undefined) {
        let rest: Uint8Array | undefined = undefined
        if (decode != undefined) {
          const last = this.decodeChunk(decode, new Uint8Array(0), true)
          if (last.isErr()) return last
          rest = last.value
        }
        this.finish()
        return ok(rest != undefined && rest.length > 0 ? rest : undefined)
      }
      let data = chunk
      if (decode != undefined) {
        const decoded = this.decodeChunk(decode, chunk, false)
        if (decoded.isErr()) return decoded
        data = decoded.value
      }
      if (data.length > 0) return ok(data)
    }
    return ok(undefined)
  }

  async all(): Promise<Result<Uint8Array, BodyError>> {
    const peer = this.peer
    const reading = this.conn.readAll(peer?.deadline)
    if (peer == undefined) {
      const served = await ahead(reading)
      return this.collected(served)
    }
    const bytes = await reading
    return this.collected(bytes)
  }

  private collected(bytes: Result<Uint8Array, NativeError>): Result<Uint8Array, BodyError> {
    if (bytes.isErr()) return err(this.failed(bytes.error))
    const decode = this.decode
    let data = bytes.value
    if (decode != undefined) {
      const decoded = this.decodeChunk(decode, bytes.value, true)
      if (decoded.isErr()) return decoded
      data = decoded.value
    }
    this.finish()
    return ok(data)
  }
}

function wireError(e: NativeError, peer: Peer | undefined, conn: Connection): BodyError {
  if (peer != undefined && peer.passed()) {
    return {
      kind: "BODY_ERROR_TIMEOUT",
      code: "TIMEOUT_ERR",
      message: `no full answer from ${peer.host} within ${peer.timeout} ms`,
      timeout: peer.timeout,
    };
  }
  const who = peer == undefined ? "the client" : peer.name();
  const of = peer == undefined ? "with the client" : `to ${peer.name()}`;
  switch (e.code) {
    case "TIMEOUT_ERR": {
      const timeout = conn.requestTimeout();

      return {
        kind: "BODY_ERROR_TIMEOUT",
        code: "TIMEOUT_ERR",
        message: `the request did not come in full within ${timeout} ms (requestTimeout)`,
        timeout: timeout,
      };
    }
    case "ERR_BODY_TOO_LARGE": {
      const limit = conn.bodyLimit();

      return {
        kind: "BODY_ERROR_TOO_LARGE",
        code: "ERR_BODY_TOO_LARGE",
        message: `the body is larger than ${limit} bytes (maxBodySize)`,
        limit: limit,
      };
    }
    case "ERR_INVALID_CHUNKED":
      return {
        kind: "BODY_ERROR_MALFORMED",
        code: "ERR_INVALID_CHUNKED",
        message: "the body is not valid chunked encoding",
      };
    case "ERR_CLOSED":
      return {
        kind: "BODY_ERROR_NETWORK",
        code: "ERR_CLOSED",
        message: `${who} closed the connection before the end of the body`,
      };
    case "ECONNRESET":
      return {
        kind: "BODY_ERROR_NETWORK",
        code: "ECONNRESET",
        message: `the connection ${of} was reset before the end of the body`,
      };
    case "ECONNABORTED":
      return {
        kind: "BODY_ERROR_NETWORK",
        code: "ECONNABORTED",
        message: `the connection ${of} was aborted on this machine before the end of the body`,
      };
    case "ETIMEDOUT":
      return {
        kind: "BODY_ERROR_NETWORK",
        code: "ETIMEDOUT",
        message: `the connection ${of} timed out before the end of the body`,
      };
  }
  const tls = tlsCode(e.code);
  if (tls != undefined) {
    return {
      kind: "BODY_ERROR_NETWORK",
      code: "ERR_TLS_FAILED",
      message: `the TLS connection ${of} failed before the end of the body: ${e.message}`,
    };
  }

  return {
    kind: "BODY_ERROR_NETWORK",
    code: "UNKNOWN",
    message: `the connection ${of} failed before the end of the body: ${e.message}`,
  };
}

function concat(parts: Uint8Array[]): Uint8Array {
  if (parts.length == 1) return parts[0] ?? new Uint8Array(0)
  let total = 0
  for (const p of parts) total += p.length
  const all = new Uint8Array(total)
  let at = 0
  for (const p of parts) {
    all.set(p, at)
    at += p.length
  }
  return all
}

function decoding(encoding: string | undefined): Decode | undefined {
  const found = decodersOf(encoding)
  if (found == undefined || found.length == 0) return undefined
  const decoders: object[] = found
  return (chunk, last) => {
    let data = chunk
    for (const d of decoders) {
      const out = zlibPush(d, data)
      if (out.isErr()) return out
      if (last) {
        const end = zlibEnd(d)
        if (end.isErr()) return end
        data = concat([out.value, end.value])
      } else {
        data = out.value
      }
    }
    return ok(data)
  }
}

function decodersOf(encoding: string | undefined): object[] | undefined {
  if (encoding == undefined) return []
  const out: object[] = []
  for (const part of encoding.toLowerCase().split(",").reverse()) {
    const coding = part.trim()
    if (coding == "" || coding == "identity") continue
    if (coding == "gzip" || coding == "x-gzip") out.push(zlibNew(CODING_GZIP))
    else if (coding == "deflate") out.push(zlibNew(CODING_DEFLATE))
    else if (coding == "br") out.push(zlibNew(CODING_BR))
    else return undefined
  }
  return out
}

class Body {
  kind = BODY_NONE
  text = ""
  bytes?: Uint8Array
  stream?: ReadableStream<Uint8Array, BodyError>
  wire?: Wire
  used = false
  type?: string
  opened?: StreamState<Uint8Array, BodyError>

  static of(init: BodyData | undefined): Body {
    const b = new Body()
    if (init == undefined) return b
    if (typeof init == "string") {
      b.kind = BODY_TEXT
      b.text = init
      b.type = "text/plain;charset=UTF-8"
    } else if (init instanceof Uint8Array) {
      b.kind = BODY_BYTES
      b.bytes = new Uint8Array(init)
    } else if (init instanceof ArrayBuffer) {
      b.kind = BODY_BYTES
      b.bytes = new Uint8Array(init.slice(0))
    } else if (init instanceof URLSearchParams) {
      b.kind = BODY_TEXT
      b.text = init.toString()
      b.type = "application/x-www-form-urlencoded;charset=UTF-8"
    } else {
      const boundary = "----formdata-tz-" + String(Math.floor(Math.random() * 1e12))
      b.kind = BODY_TEXT
      b.text = multipartText(init, boundary)
      b.type = "multipart/form-data; boundary=" + boundary
    }
    return b
  }

  static ofStream(stream: ReadableStream<Uint8Array, BodyError>): Body {
    const b = new Body()
    b.kind = BODY_STREAM
    b.stream = stream

    return b
  }

  static ofWire(wire: Wire): Body {
    const b = new Body()
    b.kind = BODY_WIRE
    b.wire = wire
    return b
  }

  moved(): Body {
    const b = new Body()
    b.kind = this.kind
    b.text = this.text
    b.bytes = this.bytes
    b.stream = this.stream
    b.wire = this.wire
    b.type = this.type
    this.used = true
    return b
  }

  private touched(): boolean {
    return this.stream != undefined || this.opened != undefined
  }

  private locked(): boolean {
    const stream = this.stream
    if (stream != undefined) return stream.locked()
    return this.opened?.locked ?? false
  }

  usedOrDisturbed(): boolean {
    if (this.used) return true
    const stream = this.stream
    if (stream != undefined) return stream.disturbed()
    return this.opened?.disturbed ?? false
  }

  isNull(): boolean {
    return this.kind == BODY_NONE
  }

  view(): ReadableStream<Uint8Array, BodyError> | undefined {
    if (this.kind == BODY_NONE) return undefined
    const stream = this.stream
    return stream != undefined ? stream : new BodyStream(this)
  }

  state(): StreamState<Uint8Array, BodyError> | undefined {
    const opened = this.opened
    if (opened != undefined) return opened
    if (this.kind == BODY_NONE) return undefined
    let made: StreamState<Uint8Array, BodyError>
    const maybeWire = this.wire
    if (this.used) {
      made = new StreamState<Uint8Array, BodyError>()
      made.started = true
      made.disturbed = true
      made.state = "closed"
    } else if (maybeWire != undefined) {
      const wire: Wire = maybeWire
      made = startedState<Uint8Array, BodyError>({
        type: "bytes",
        pull: async c => {
          const chunk = await wire.next()
          if (chunk.isErr()) {
            c.error(chunk.error)
          } else {
            const value = chunk.value
            if (value == undefined) c.close()
            else c.enqueue(value)
          }
        },
      }, undefined)
    } else {
      const bytes = this.kind == BODY_TEXT ? new TextEncoder().encode(this.text) : this.bytes
      made = startedState<Uint8Array, BodyError>({
        type: "bytes",
        start: c => {
          if (bytes != undefined && bytes.length > 0) c.enqueue(bytes)
          c.close()
        },
      }, undefined)
    }
    this.opened = made
    return made
  }

  async consume(): Promise<Result<Uint8Array, BodyError>> {
    if (this.usedOrDisturbed()) return err(bodyUsed())
    if (this.locked()) return err(bodyLocked())
    const touched = this.touched()
    this.used = true
    const stream = touched ? this.view() : undefined
    if (stream != undefined) {
      const parts: Uint8Array[] = []
      const reader = stream.getReader()
      for (;;) {
        const r = await reader.read()
        if (r.isErr()) {
          reader.releaseLock()
          return err(this.wire?.failure ?? bodyFailure(r.error))
        }
        const step = r.value
        if (step.done) break
        parts.push(step.value)
      }
      reader.releaseLock()
      return ok(concat(parts))
    }
    if (this.kind == BODY_TEXT) return ok(new TextEncoder().encode(this.text))
    const bytes = this.bytes
    if (bytes != undefined) return ok(bytes)
    const wire = this.wire
    if (wire != undefined) {
      const reading = wire.all()
      const read = await ahead(reading)
      return read
    }
    return ok(new Uint8Array(0))
  }

  async consumeText(): Promise<Result<string, BodyError>> {
    if (this.kind == BODY_TEXT && !this.touched()) {
      if (this.used) return err(bodyUsed())
      this.used = true
      return ok(this.text)
    }
    const fresh = !this.touched() && (this.kind == BODY_NONE || this.kind == BODY_WIRE)
    if (fresh) {
      const consuming = this.consume()
      const read = await ahead(consuming)
      if (read.isErr()) return read
      return ok(new TextDecoder().decode(read.value))
    }
    const bytes = await this.consume()
    if (bytes.isErr()) return bytes
    return ok(new TextDecoder().decode(bytes.value))
  }

  copy(): Body {
    const b = new Body()
    if (this.usedOrDisturbed()) {
      b.used = true
      return b
    }
    b.kind = this.kind
    b.text = this.text
    b.bytes = this.bytes
    b.type = this.type
    if (this.kind == BODY_STREAM || this.kind == BODY_WIRE) {
      const source = this.view()
      if (source != undefined) {
        const [left, right] = tee(source)
        this.stream = left
        b.kind = BODY_STREAM
        b.stream = right
        this.kind = BODY_STREAM
        this.wire = undefined
        this.opened = undefined
      }
    }
    return b
  }
}

class BodyStream extends ReadableStream<Uint8Array, BodyError> {
  private body: Body

  constructor(body: Body) {
    super()
    this.body = body
  }

  protected override open(): StreamState<Uint8Array, BodyError> {
    return this.body.state() ?? new StreamState<Uint8Array, BodyError>()
  }
}

class TeeState {
  buffers: Uint8Array[][] = [[], []]
  done = false
  failure?: BodyError
  reading?: Promise<void>
}

function tee(source: ReadableStream<Uint8Array, BodyError>):
    [ReadableStream<Uint8Array, BodyError>, ReadableStream<Uint8Array, BodyError>] {
  const reader = source.getReader()
  const state = new TeeState()
  const readMore = async () => {
    const r = await reader.read()
    state.reading = undefined
    if (r.isErr()) {
      state.failure = bodyFailure(r.error)
      state.done = true
      return
    }
    const step = r.value
    if (step.done) {
      state.done = true
      return
    }
    state.buffers[0]?.push(step.value)
    state.buffers[1]?.push(step.value)
  }
  const branch = (i: int) => new ReadableStream<Uint8Array, BodyError>({
    pull: async c => {
      for (;;) {
        const next = (state.buffers[i] ?? []).shift()
        if (next != undefined) {
          c.enqueue(next)
          return
        }
        if (state.done) {
          const failure = state.failure
          if (failure != undefined) c.error(failure)
          else c.close()
          return
        }
        let pending = state.reading
        if (pending == undefined) {
          pending = readMore()
          state.reading = pending
        }
        await pending
      }
    },
  })
  return [branch(0), branch(1)]
}

export class FormData {
  private list: [string, string][] = []

  append(name: string, value: string) {
    this.list.push([name, value])
  }

  delete(name: string) {
    this.list = this.list.filter(e => e[0] != name)
  }

  get(name: string): string | undefined {
    for (const [n, v] of this.list) if (n == name) return v
    return undefined
  }

  getAll(name: string): string[] {
    const out: string[] = []
    for (const [n, v] of this.list) if (n == name) out.push(v)
    return out
  }

  has(name: string): boolean {
    return this.list.some(e => e[0] == name)
  }

  set(name: string, value: string) {
    const at = this.list.findIndex(e => e[0] == name)
    if (at < 0) {
      this.list.push([name, value])
      return
    }
    this.list = this.list.filter((e, i) => e[0] != name || i == at)
    const kept = this.list.findIndex(e => e[0] == name)
    const entries = this.list
    if (kept >= 0 && kept < entries.length) entries[kept] = [name, value]
  }

  forEach(callback: (value: string, key: string, parent: FormData) => void) {
    for (const [name, value] of [...this.list]) callback(value, name, this)
  }

  *entries(): IterableIterator<[string, string]> {
    for (const e of [...this.list]) yield [e[0], e[1]]
  }

  *keys(): IterableIterator<string> {
    for (const e of [...this.list]) yield e[0]
  }

  *values(): IterableIterator<string> {
    for (const e of [...this.list]) yield e[1]
  }

  *[Symbol.iterator](): IterableIterator<[string, string]> {
    for (const e of [...this.list]) yield [e[0], e[1]]
  }

}

function multipartText(form: FormData, boundary: string): string {
  const escape = (s: string) =>
    s.replaceAll("\"", "%22").replaceAll("\n", "%0A").replaceAll("\r", "%0D")
  let out = ""
  for (const [name, value] of form)
    out += `--${boundary}\r\nContent-Disposition: form-data; name="${escape(name)}"\r\n\r\n` +
           `${value.replaceAll(/\r(?!\n)|(?<!\r)\n/g, "\r\n")}\r\n`
  return out + `--${boundary}--\r\n`
}

function parseFormData(type: string | undefined, bytes: Uint8Array): Result<FormData, FormDataError> {
  const form = new FormData()
  const given = type ?? ""
  const contentType = given.toLowerCase()
  if (contentType.startsWith("application/x-www-form-urlencoded")) {
    for (const [name, value] of new URLSearchParams(new TextDecoder().decode(bytes)))
      form.append(name, value)
    return ok(form)
  }
  if (contentType.startsWith("multipart/form-data")) {
    const m = /boundary=(?:"([^"]+)"|([^;\s]+))/i.exec(type ?? "")
    const boundary = m == undefined ? "" : m[1] ?? m[2] ?? ""
    if (boundary == "")
      return err(formError("ERR_NO_BOUNDARY",
                              "the body is not a form: multipart/form-data has no boundary", type))
    const text = new TextDecoder().decode(bytes)
    const parts = text.split("--" + boundary)
    for (const part of parts.slice(1)) {
      if (part.startsWith("--")) break
      const headEnd = part.indexOf("\r\n\r\n")
      if (headEnd < 0)
        return err(formError("ERR_INVALID_MULTIPART",
                                "the body is not a valid multipart form: a part has no end of its head",
                                type))
      const head = part.slice(0, headEnd)
      let body = part.slice(headEnd + 4)
      if (body.endsWith("\r\n")) body = body.slice(0, body.length - 2)
      const name = /name="([^"]*)"/i.exec(head)
      if (name == undefined)
        return err(formError("ERR_INVALID_MULTIPART",
                                "the body is not a valid multipart form: a part has no name", type))
      const field = (name[1] ?? "").replaceAll("%22", "\"").replaceAll("%0A", "\n")
        .replaceAll("%0D", "\r")
      form.append(field, body)
    }
    return ok(form)
  }
  const what = given == "" ? "it has no content-type" : `content-type is ${given}`
  return err(formError("ERR_NOT_A_FORM", `the body is not a form: ${what}`, type))
}

export type RequestRedirect = "follow" | "error" | "manual"

export interface RequestInit<E extends StreamError = StreamError> {
  method?: string
  headers?: HeadersInit
  body?: BodyData | ReadableStream<Uint8Array, E>
  redirect?: RequestRedirect
  timeout?: int
  duplex?: "half"
  proxy?: ProxyOption
  httpVersion?: HttpVersion
}

export interface RequestOptions {
  method?: string
  headers?: HeadersInit
  body?: BodyData
  redirect?: RequestRedirect
  timeout?: int
  duplex?: "half"
}

function methodProblem(method: string): string | undefined {
  if (!isToken(method)) return `'${method}' is not a valid HTTP method`
  const upper = method.toUpperCase()
  if (upper == "CONNECT" || upper == "TRACE" || upper == "TRACK")
    return `fetch does not send ${upper} requests`
  return undefined
}

function normalizeMethod(method: string): string {
  const upper = method.toUpperCase()
  if (upper == "DELETE" || upper == "GET" || upper == "HEAD" || upper == "OPTIONS" ||
      upper == "POST" || upper == "PUT" || upper == "PATCH")
    return upper == "PATCH" ? method : upper
  return method
}

export class Request {
  readonly method: string = "GET"
  readonly url: string
  readonly headers: Headers
  readonly redirect: RequestRedirect = "follow"
  readonly duplex?: "half"
  readonly timeout?: int
  private bodyStream?: ReadableStream<Uint8Array, BodyError>
  private data: Body

  constructor(input: string | URL | Request, init?: RequestOptions) {
    if (input instanceof Request) {
      this.method = input.method
      this.url = input.url
      this.headers = new Headers(input.headers)
      this.redirect = input.redirect
      this.duplex = input.duplex
      const given = init?.body
      this.data = given != undefined ? Body.of(given) : input.data
      if (given == undefined && input.data.kind != BODY_NONE && !input.data.usedOrDisturbed())
        this.data = input.data.moved()
    } else {
      if (typeof input == "string") {
        const parsed = URL.parse(input)
        this.url = parsed.isOk() ? parsed.value.href() : input
      } else {
        this.url = input.href()
      }
      this.headers = new Headers()
      this.data = Body.of(undefined)
    }
    let timeout = input instanceof Request ? input.timeout : undefined
    if (init != undefined) {
      const method = init.method
      if (method != undefined) this.method = normalizeMethod(method)
      if (init.headers != undefined) this.headers = new Headers(init.headers)
      if (init.redirect != undefined) this.redirect = init.redirect
      if (init.timeout != undefined) timeout = init.timeout
      if (init.duplex != undefined) this.duplex = init.duplex
      if (init.body != undefined) this.data = Body.of(init.body)
    }
    this.timeout = timeout
    const type = this.data.type
    if (type != undefined && !this.headers.has("content-type"))
      this.headers.append("content-type", type)
  }

  private constructor(conn: Connection) {
    this.method = conn.method()
    this.headers = Headers.readFrom(conn)
    this.url = conn.target()
    if (conn.hasBody()) {
      this.data = Body.ofWire(new Wire(conn))
      this.duplex = "half"
    } else {
      this.data = Body.of(undefined)
    }
  }

  static readFrom(conn: Connection): Request {
    return new Request(conn)
  }

  public static stream<E extends StreamError>(input: string | URL | Request,
                                              body: ReadableStream<Uint8Array, E>,
                                              init?: RequestOptions): Request {
    const request = new Request(input, init)
    const stream = bodyStream(body)
    request.data = Body.ofStream(stream)

    return request
  }

  async writeTo(conn: Connection, url: URL, peer: Peer): Promise<Result<void, FetchError>> {
    const body = this.data
    let text = ""
    let bytes: Uint8Array | undefined = undefined
    let flags = 0
    if (body.kind == BODY_TEXT) {
      text = body.text
    } else if (body.kind == BODY_BYTES) {
      bytes = body.bytes
      flags = SEND_BYTES
    } else if (body.kind == BODY_STREAM || body.kind == BODY_WIRE) {
      flags = SEND_STREAM
    } else if (this.method != "POST" && this.method != "PUT" && this.method != "PATCH") {
      flags = SEND_NO_BODY
    }
    this.headers.writeTo(conn)
    conn.request(this.method, url, text, bytes, flags)
    if (flags == SEND_STREAM) {
      body.used = true
      const stream = body.view()
      if (stream != undefined) {
        const problem = await sendBody(conn, stream, peer, url.href())
        if (problem != undefined) return err(problem)
      }
      conn.end()
    }
    return ok(undefined)
  }

  public body(): ReadableStream<Uint8Array, BodyError> | undefined {
    const made = this.bodyStream
    if (made != undefined) {
      return made
    }
    const view = this.data.view()
    this.bodyStream = view

    return view
  }

  bodyUsed(): boolean {
    return this.data.usedOrDisturbed()
  }

  clone(): Request {
    const init: RequestOptions = { method: this.method, headers: this.headers,
                                   redirect: this.redirect, timeout: this.timeout,
                                   duplex: this.duplex }
    const r = new Request(this.url, init)
    r.data = this.data.copy()
    this.bodyStream = undefined
    return r
  }

  async text(): Promise<Result<string, TextError>> {
    const consuming = this.data.consumeText()
    const text = await ahead(consuming)

    return text
  }

  async json(): Promise<Result<Json, JsonBodyError>> {
    const contentType = this.headers.get("content-type")
    const texting = this.text()
    const text = await ahead(texting)
    const parsed = jsonBody(text, contentType)

    return parsed
  }

  async bytes(): Promise<Result<Uint8Array, BytesError>> {
    const consuming = this.data.consume()
    const bytes = await ahead(consuming)

    return bytes
  }

  async arrayBuffer(): Promise<Result<ArrayBuffer, BytesError>> {
    const bytes = await this.data.consume()
    if (bytes.isErr()) return bytes
    return ok(bytes.value.slice().buffer)
  }

  async formData(): Promise<Result<FormData, FormDataError>> {
    const bytes = await this.data.consume()
    if (bytes.isErr()) return bytes
    return parseFormData(this.headers.get("content-type"), bytes.value)
  }
}

export interface ResponseInit {
  status?: HttpStatus
  statusText?: string
  headers?: HeadersInit
}

export function isHttpStatus(code: int) {
  return code >= 200 && code <= 599
}

function reasonPhrase(text: string): string {
  let kept = ""
  let from = 0
  for (let i = 0; i < text.length; i++) {
    const c = text.charCodeAt(i)
    if (c == 0x09 || (c >= 0x20 && c <= 0x7e) || (c >= 0x80 && c <= 0xff)) continue
    kept += text.slice(from, i)
    from = i + 1
  }
  return from == 0 ? text : kept + text.slice(from)
}

export type ResponseProtocol = "http/1.1" | "h2"

export type HttpVersion = "auto" | "1.1" | "2"

export class Response {
  readonly status: int = 200
  readonly statusText: string = ""
  readonly headers: Headers
  readonly ok: boolean = true
  readonly redirected: boolean = false
  readonly type: string = "default"
  readonly url: string = ""
  readonly protocol: ResponseProtocol = "http/1.1"
  upgrade?: (conn: Connection) => void
  private bodyStream?: ReadableStream<Uint8Array, BodyError>
  private data: Body

  constructor(body?: BodyData, init?: ResponseInit) {
    const status: int = init?.status ?? 200
    this.status = status
    this.ok = status >= 200 && status <= 299
    this.statusText = reasonPhrase(init?.statusText ?? "")
    this.headers = new Headers(init?.headers)
    this.data = Body.of(status == 204 || status == 205 || status == 304 ? undefined : body)
    const type = this.data.type
    if (type != undefined && !this.headers.has("content-type"))
      this.headers.append("content-type", type)
  }

  public static stream<E extends StreamError>(body: ReadableStream<Uint8Array, E> | undefined,
                                              init?: ResponseInit): Response {
    const status: int = init?.status ?? 200
    const statusText = reasonPhrase(init?.statusText ?? "")
    const headers = new Headers(init?.headers)
    const empty = status == 204 || status == 205 || status == 304
    let data = Body.of(undefined)
    if (body != undefined && !empty) {
      const stream = bodyStream(body)
      data = Body.ofStream(stream)
    }
    const response = new Response(status, statusText, headers, data, "", false, "default",
                                  "http/1.1")

    return response
  }

  private constructor(status: int, statusText: string, headers: Headers, data: Body,
                      url: string, redirected: boolean, type: string,
                      protocol: ResponseProtocol) {
    this.status = status
    this.ok = status >= 200 && status <= 299
    this.statusText = statusText
    this.headers = headers
    this.data = data
    this.url = url
    this.redirected = redirected
    this.type = type
    this.protocol = protocol
  }

  static readFrom(conn: Connection, url: string, redirected: boolean, peer: Peer): Response {
    const headers = Headers.readFrom(conn)
    let body: Body
    if (conn.hasBody()) {
      const wire = new Wire(conn, peer)
      const coding = headers.get("content-encoding")
      wire.decode = decoding(coding)
      wire.coding = coding ?? ""
      body = Body.ofWire(wire)
    } else {
      giveBack(conn)
      body = Body.of(undefined)
    }
    return new Response(conn.status, conn.statusText(), headers, body, url, redirected, "basic",
                        conn.protocol)
  }

  static switchingProtocols(headers: HeadersInit, upgrade: (conn: Connection) => void): Response {
    const response = new Response(101, "Switching Protocols", new Headers(headers), Body.of(undefined),
                                  "", false, "default", "http/1.1")
    response.upgrade = upgrade

    return response
  }

  static readFrom(data: DataUrl): Response {
    const headers = new Headers({ "content-type": data.type })
    return new Response(200, "", headers, Body.of(data.bytes), data.url, false, "default",
                        "http/1.1")
  }

  writeTo(conn: Connection, headOnly: boolean): Written {
    const body = this.data
    const kind = body.kind
    this.headers.writeTo(conn)
    if (kind == BODY_STREAM || kind == BODY_WIRE) {
      const finished = this.streamTo(conn, body, headOnly)
      const streaming: Written = {
        kind: "streaming",
        finished: finished,
      }

      return streaming
    }
    conn.respond(this.status, this.statusText, kind == BODY_TEXT ? body.text : "", body.bytes,
                 (headOnly ? SEND_NO_BODY : 0) | (kind == BODY_BYTES ? SEND_BYTES : 0))
    const done: Written = {
      kind: "done",
    }

    return done
  }

  private async streamTo(conn: Connection, body: Body, head: boolean) {
    conn.respond(this.status, this.statusText, "", undefined,
                 SEND_STREAM | (head ? SEND_NO_BODY : 0))
    const stream = body.view()
    if (stream != undefined && !head) {
      const reader = stream.getReader()
      for (;;) {
        const r = await reader.read()
        if (r.isErr()) {
          console.error(r.error)
          conn.endAfter()
          conn.close()
          return
        }
        const step = r.value
        if (step.done) break
        const wrote = await conn.write(step.value)
        if (wrote.isErr()) {
          await reader.cancel()
          conn.endAfter()
          return
        }
      }
    }
    conn.end()
  }

  static json<T>(data: T, init?: ResponseInit): Response {
    const r = new Response(JSON.stringify(data), init)
    r.headers.set("content-type", "application/json")
    return r
  }

  static redirect(url: URL, status: RedirectStatus = 302): Response {
    const r = new Response(undefined, { status })
    r.headers.set("location", url.href())
    return r
  }

  static error(): Response {
    const headers = new Headers()
    const data = Body.of(undefined)
    const response = new Response(0, "", headers, data, "", false, "error", "http/1.1")

    return response
  }

  public body(): ReadableStream<Uint8Array, BodyError> | undefined {
    const made = this.bodyStream
    if (made != undefined) {
      return made
    }
    const view = this.data.view()
    this.bodyStream = view

    return view
  }

  bodyUsed(): boolean {
    return this.data.usedOrDisturbed()
  }

  clone(): Response {
    const headers = new Headers(this.headers)
    const data = this.data.copy()
    this.bodyStream = undefined
    const copy = new Response(this.status, this.statusText, headers, data, this.url,
                              this.redirected, this.type, this.protocol)

    return copy
  }

  async text(): Promise<Result<string, TextError>> {
    const consuming = this.data.consumeText()
    const text = await ahead(consuming)

    return text
  }

  async json(): Promise<Result<Json, JsonBodyError>> {
    const contentType = this.headers.get("content-type")
    const texting = this.text()
    const text = await ahead(texting)
    const parsed = jsonBody(text, contentType)

    return parsed
  }

  async bytes(): Promise<Result<Uint8Array, BytesError>> {
    const consuming = this.data.consume()
    const bytes = await ahead(consuming)

    return bytes
  }

  async arrayBuffer(): Promise<Result<ArrayBuffer, BytesError>> {
    const bytes = await this.data.consume()
    if (bytes.isErr()) return bytes
    return ok(bytes.value.slice().buffer)
  }

  async formData(): Promise<Result<FormData, FormDataError>> {
    const bytes = await this.data.consume()
    if (bytes.isErr()) return bytes
    return parseFormData(this.headers.get("content-type"), bytes.value)
  }
}

class Idle {
  conn: Connection
  since: int
  constructor(conn: Connection, since: int) {
    this.conn = conn
    this.since = since
  }
}
const pool = new Map<string, Idle[]>()
const KEEP_ALIVE_MS = 4000

function takeIdle(origin: string): Connection | undefined {
  const list = pool.get(origin)
  if (list == undefined) return undefined
  const now = Date.now()
  for (;;) {
    const idle = list.pop()
    if (idle == undefined) return undefined
    if (now - idle.since < KEEP_ALIVE_MS && idle.conn.alive()) return idle.conn
    idle.conn.close()
  }
}

function giveBack(conn: Connection) {
  if (!conn.reusable()) {
    conn.close()
    return
  }
  let list = pool.get(conn.origin)
  if (list == undefined) {
    list = []
    pool.set(conn.origin, list)
  }
  list.push(new Idle(conn, Date.now()))
}

const BAD_PORTS = new Set<int>([
  1, 7, 9, 11, 13, 15, 17, 19, 20, 21, 22, 23, 25, 37, 42, 43, 53, 69, 77, 79, 87, 95, 101, 102,
  103, 104, 109, 110, 111, 113, 115, 117, 119, 123, 135, 137, 139, 143, 161, 179, 389, 427, 465,
  512, 513, 514, 515, 526, 530, 531, 532, 540, 548, 554, 556, 563, 587, 601, 636, 989, 990, 993,
  995, 1719, 1720, 1723, 2049, 3659, 4045, 4190, 5060, 5061, 6000, 6566, 6665, 6666, 6667, 6668,
  6669, 6679, 6697, 10080,
])

async function sendBody(conn: Connection, stream: ReadableStream<Uint8Array, BodyError>, peer: Peer,
                        url: string): Promise<FetchError | undefined> {
  const reader = stream.getReader()
  for (;;) {
    const r = await reader.read()
    if (r.isErr()) {
      reader.releaseLock()
      if (peer.passed()) {
        return timeoutError(peer)
      }

      return requestError("ERR_BODY_FAILED",
                          `the body of the request could not be read: ${r.error.message}`, url)
    }
    const step = r.value
    if (step.done) break
    const wrote = await conn.write(step.value)
    if (wrote.isErr()) {
      reader.releaseLock()
      return connectionError(wrote.error, peer, "sending the request")
    }
  }
  reader.releaseLock()
  return undefined
}

export function peerOf(url: URL, timeout?: int, deadline?: object): Peer {
  const hostname = url.hostname()
  const host = hostname.startsWith("[") ? hostname.slice(1, hostname.length - 1) : hostname
  const https = url.protocol() == "https:"
  const port = url.portNumber() ?? (https ? 443 : 80)
  const peer = new Peer(host, port, timeout ?? 0, deadline)

  return peer
}

export type ProxyOption =
  | {
      enabled: true;
      url: string;
      httpVersion?: "auto" | "1.1";
    }
  | {
      enabled: false;
    };

export class ProxyTarget {
  public readonly host: string;
  public readonly port: int;
  public readonly secure: boolean;
  public readonly auth: string;
  public readonly shown: string;

  public constructor(host: string, port: int, secure: boolean, auth: string, shown: string) {
    this.host = host;
    this.port = port;
    this.secure = secure;
    this.auth = auth;
    this.shown = shown;
  }

  public name(): string {
    return `${this.host}:${this.port}`;
  }
}

function proxyError(
  code: "ERR_INVALID_PROXY_URL" | "ERR_PROXY_AUTH_REQUIRED" | "ERR_PROXY_REFUSED",
  message: string,
  proxy: string,
  status: int,
): FetchError {
  return { kind: "FETCH_ERROR_PROXY", code: code, message: message, proxy: proxy, status: status };
}

function envValue(names: string[]): [string, string] | undefined {
  for (const name of names) {
    const value = process.env[name];
    if (value != undefined && value != "") {
      return [name, value];
    }
  }

  return undefined;
}

function hostMatches(host: string, port: int, entry: string): boolean {
  let pattern = entry.trim().toLowerCase();
  if (pattern == "") {
    return false;
  }
  if (pattern == "*") {
    return true;
  }
  const colon = pattern.lastIndexOf(":");
  if (colon > 0 && !pattern.includes("]") && pattern.indexOf(":") == colon) {
    const wanted = pattern.slice(colon + 1);
    if (wanted != String(port)) {
      return false;
    }
    pattern = pattern.slice(0, colon);
  }
  const slash = pattern.indexOf("/");
  if (slash > 0) {
    return inNetwork(host, pattern.slice(0, slash), pattern.slice(slash + 1));
  }
  if (pattern.startsWith(".")) {
    return host.endsWith(pattern) || host == pattern.slice(1);
  }

  return host == pattern || host.endsWith("." + pattern);
}

function ipv4Number(text: string): double | undefined {
  const parts = text.split(".");
  if (parts.length != 4) {
    return undefined;
  }
  let value = 0.0;
  for (const part of parts) {
    const parsed = parseInt(part);
    if (parsed.isErr() || parsed.value < 0 || parsed.value > 255) {
      return undefined;
    }
    value = value * 256 + parsed.value.toDouble();
  }

  return value;
}

function inNetwork(host: string, base: string, bits: string): boolean {
  const address = ipv4Number(host);
  const network = ipv4Number(base);
  const width = parseInt(bits);
  if (address == undefined || network == undefined || width.isErr()) {
    return false;
  }
  const size = Math.pow(2, 32 - Math.min(32, Math.max(0, width.value)).toDouble());

  return Math.floor(address / size) == Math.floor(network / size);
}

function bypassed(host: string, port: int): boolean {
  const lower = host.toLowerCase();
  if (lower == "localhost" || lower == "127.0.0.1" || lower == "::1") {
    return true;
  }
  const found = envValue(["NO_PROXY", "no_proxy"]);
  if (found == undefined) {
    return false;
  }

  return found[1].split(",").some((entry) => hostMatches(lower, port, entry));
}

function proxyOf(text: string, source: string): Result<ProxyTarget, FetchError> {
  const parsed = URL.parse(text);
  const hint = source == "proxy.url" ? "" : `; write it as http://${text}`;
  if (parsed.isErr()) {
    return err(proxyError("ERR_INVALID_PROXY_URL",
                          `${source} is not a URL: "${text}"${hint}`, text, 0));
  }
  const url = parsed.value;
  const protocol = url.protocol();
  if (protocol != "http:" && protocol != "https:") {
    return err(proxyError("ERR_INVALID_PROXY_URL",
                          `${source} is a ${protocol} proxy, and only http: and https: proxies work`,
                          text, 0));
  }
  const secure = protocol == "https:";
  const port = url.portNumber() ?? (secure ? 443 : 80);
  const hostname = url.hostname();
  const host = hostname.startsWith("[") ? hostname.slice(1, hostname.length - 1) : hostname;
  let auth = "";
  if (url.username() != "") {
    const user = decodeURIComponent(url.username()).unwrapOr(url.username());
    const password = decodeURIComponent(url.password()).unwrapOr(url.password());
    auth = Buffer.from(`${user}:${password}`).toString("base64");
  }
  const shown = `${protocol}//${url.host()}`;
  const proxy = new ProxyTarget(host, port, secure, auth, shown);

  return ok(proxy);
}

function proxyFor(url: URL, peer: Peer, option?: ProxyOption): Result<ProxyTarget | undefined, FetchError> {
  if (option != undefined) {
    if (!option.enabled) {
      return ok(undefined);
    }
    const explicitResult = proxyOf(option.url, "proxy.url");
    if (explicitResult.isErr()) {
      return err(explicitResult.error);
    }

    return ok(explicitResult.value);
  }
  const https = url.protocol() == "https:";
  const cgi = process.env.REQUEST_METHOD != undefined;
  const names = https ? ["HTTPS_PROXY", "https_proxy"] : cgi ? [] : ["HTTP_PROXY", "http_proxy"];
  const found = envValue(names);
  if (found == undefined || bypassed(peer.host, peer.port)) {
    return ok(undefined);
  }
  const envResult = proxyOf(found[1], found[0]);
  if (envResult.isErr()) {
    return err(envResult.error);
  }

  return ok(envResult.value);
}

function proxyStatusError(status: int, proxy: ProxyTarget, peer: Peer): FetchError {
  if (status == 407) {
    return proxyError("ERR_PROXY_AUTH_REQUIRED",
                      `the proxy ${proxy.name()} asks for a login (407): put user and password ` +
                      "into its URL, http://user:password@host:port", proxy.shown, status);
  }

  return proxyError("ERR_PROXY_REFUSED",
                    `the proxy ${proxy.name()} refused to connect to ${peer.name()} (${status})`,
                    proxy.shown, status);
}

function proxyConnectionError(e: NativeError, proxy: ProxyTarget, peer: Peer): FetchError {
  const proxyPeer = new Peer(proxy.host, proxy.port, peer.timeout, peer.deadline);
  const failure = connectionError(e, proxyPeer, "connecting");
  if (failure.kind == "FETCH_ERROR_NETWORK") {
    return {
      kind: "FETCH_ERROR_NETWORK",
      code: failure.code,
      message: `the proxy: ${failure.message}`,
      syscall: failure.syscall,
      host: failure.host,
      port: failure.port,
    };
  }

  return failure;
}

async function tunnel(conn: Connection, proxy: ProxyTarget, peer: Peer): Promise<FetchError | undefined> {
  const target = peer.host.includes(":") ? `[${peer.host}]:${peer.port}` : peer.name();
  let head = `CONNECT ${target} HTTP/1.1\r\nhost: ${target}\r\n`;
  if (proxy.auth != "") {
    head += `proxy-authorization: Basic ${proxy.auth}\r\n`;
  }
  head += "\r\n";
  const encoder = new TextEncoder();
  const wroteResult = await conn.write(encoder.encode(head));
  if (wroteResult.isErr()) {
    return proxyConnectionError(wroteResult.error, proxy, peer);
  }
  let answer = "";
  const decoder = new TextDecoder("latin1");
  while (!answer.includes("\r\n\r\n")) {
    const readResult = await conn.readRaw(peer.deadline);
    if (readResult.isErr()) {
      return proxyConnectionError(readResult.error, proxy, peer);
    }
    const chunk = readResult.value;
    if (chunk == undefined || answer.length > 16384) {
      return proxyStatusError(502, proxy, peer);
    }
    answer += decoder.decode(chunk);
  }
  const statusText = answer.split(" ")[1] ?? "";
  const status = parseInt(statusText).unwrapOr(502);
  if (status < 200 || status > 299) {
    return proxyStatusError(status, proxy, peer);
  }

  return undefined;
}

async function openThrough(proxy: ProxyTarget, https: boolean,
                           peer: Peer): Promise<Result<Connection, FetchError>> {
  const opened = await Connection.open(proxy.host, proxy.port, proxy.secure, peer.deadline, false)
  if (opened.isErr()) return err(proxyConnectionError(opened.error, proxy, peer))
  const conn = opened.value
  if (!https) {
    conn.absolute = true
    conn.proxyAuth = proxy.auth
    return ok(conn)
  }
  const problem = await tunnel(conn, proxy, peer)
  if (problem != undefined) {
    conn.close()
    return err(problem)
  }
  const secured = await conn.secure(peer.host, peer.deadline)
  if (secured.isErr()) {
    conn.close()
    return err(connectionError(secured.error, peer, "connecting"))
  }
  return ok(conn)
}

const h2pool = new Map<string, Connection[]>()

function takeH2(origin: string): Connection | undefined {
  const list = h2pool.get(origin)
  if (list == undefined) {
    return undefined
  }
  let found: Connection | undefined = undefined
  const kept: Connection[] = []
  for (const conn of list) {
    const left = conn.streamsLeft()
    if (left < 0) {
      conn.close()
      continue
    }
    kept.push(conn)
    if (found == undefined && left > 0) {
      found = conn
    }
  }
  h2pool.set(origin, kept)

  return found
}

function keepH2(origin: string, conn: Connection) {
  let list = h2pool.get(origin)
  if (list == undefined) {
    list = []
    h2pool.set(origin, list)
  }
  list.push(conn)
}

async function exchange(request: Request, url: URL, redirected: boolean, peer: Peer,
                        conn: Connection): Promise<Result<Response, FetchError>> {
  const wrote = await request.writeTo(conn, url, peer)
  if (wrote.isErr()) {
    conn.close()
    return wrote
  }
  const status = await conn.response(peer.deadline)
  if (status.isErr()) {
    conn.close()
    if (peer.passed()) {
      return err(timeoutError(peer))
    }

    return err(connectionError(status.error, peer, "waiting for the response"))
  }
  let shown = url.href()
  const hash = shown.indexOf("#")
  if (hash >= 0) shown = shown.slice(0, hash)
  const response = Response.readFrom(conn, shown, redirected, peer)

  return ok(response)
}

async function send(request: Request, url: URL, redirected: boolean, peer: Peer,
                    version: HttpVersion, proxy?: ProxyTarget): Promise<Result<Response, FetchError>> {
  const https = url.protocol() == "https:"
  const through = proxy == undefined ? "" : proxy.shown + "|"
  const origin = through + url.protocol() + peer.host + ":" + String(peer.port)
  const http2 = proxy == undefined && version != "1.1" && (https || version == "2")
  let fresh: Connection | undefined = undefined
  if (http2) {
    let parent = takeH2(origin)
    if (parent == undefined) {
      const opened = await Connection.open(peer.host, peer.port, https, peer.deadline, true)
      if (opened.isErr()) return err(connectionError(opened.error, peer, "connecting"))
      const conn = opened.value
      conn.origin = origin
      if (!https || conn.isH2()) {
        conn.startH2()
        keepH2(origin, conn)
        parent = conn
      } else if (version == "2") {
        conn.close()

        return err({
          kind: "FETCH_ERROR_RESPONSE",
          code: "ERR_NO_HTTP2",
          message: `${peer.name()} does not speak HTTP/2: drop httpVersion: "2" to take HTTP/1.1`,
          host: peer.host,
          port: peer.port,
        })
      } else {
        fresh = conn
      }
    }
    if (parent != undefined) {
      const stream = parent.openStream()
      if (stream == undefined) {
        return err({
          kind: "FETCH_ERROR_NETWORK",
          code: "ERR_NOT_PROCESSED",
          message: `${peer.name()} closed the HTTP/2 connection before the request, so it can be sent again`,
          syscall: "write",
          host: peer.host,
          port: peer.port,
        })
      }
      const sent = await exchange(request, url, redirected, peer, stream)

      return sent
    }
  }
  const idle = fresh ?? takeIdle(origin)
  let conn: Connection
  if (idle != undefined) {
    conn = idle
  } else if (proxy != undefined) {
    const opened = await openThrough(proxy, https, peer)
    if (opened.isErr()) return opened
    conn = opened.value
  } else {
    const opened = await Connection.open(peer.host, peer.port, https, peer.deadline, false)
    if (opened.isErr()) return err(connectionError(opened.error, peer, "connecting"))
    conn = opened.value
  }
  conn.origin = origin
  const wrote = await request.writeTo(conn, url, peer)
  if (wrote.isErr()) {
    conn.close()
    return wrote
  }
  const status = await conn.response(peer.deadline)
  if (status.isErr()) {
    conn.close()
    if (peer.passed()) {
      return err(timeoutError(peer))
    }

    return err(connectionError(status.error, peer, "waiting for the response"))
  }
  let shown = url.href()
  const hash = shown.indexOf("#")
  if (hash >= 0) shown = shown.slice(0, hash)
  if (proxy != undefined && !https && conn.status == 407) {
    conn.close()
    return err(proxyStatusError(conn.status, proxy, peer))
  }
  return ok(Response.readFrom(conn, shown, redirected, peer))
}

class DataUrl {
  constructor(readonly type: string, readonly bytes: Uint8Array, readonly url: string) {}
}

function dataResponse(url: URL): Result<Response, FetchError> {
  const text = url.href().slice(5)
  const comma = text.indexOf(",")
  if (comma < 0)
    return err(requestError("ERR_INVALID_URL", `${url.href()} is not a data: URL: it has no comma`,
                            url.href()))
  let type = text.slice(0, comma)
  const data = text.slice(comma + 1)
  const base64 = /;base64$/i.test(type)
  if (base64) type = type.slice(0, type.length - 7)
  const decoded = percentDecode(data)
  const bytes = base64 ? Buffer.from(new TextDecoder("latin1").decode(decoded), "base64") : decoded
  return ok(Response.readFrom(new DataUrl(type == "" ? "text/plain;charset=US-ASCII" : type,
                                          new Uint8Array(bytes), url.href())))
}

function requestProblem(request: Request, url: URL): FetchError | undefined {
  if (url.username() != "" || url.password() != "")
    return requestError("ERR_CREDENTIALS_IN_URL",
                        `the URL ${request.url} has a user name or a password; send them in ` +
                        "the authorization header instead", request.url)
  const method = methodProblem(request.method)
  if (method != undefined) return requestError("ERR_INVALID_METHOD", method, request.url)
  const body = request.body()
  if (body == undefined) return undefined
  if (request.method == "GET" || request.method == "HEAD")
    return requestError("ERR_BODY_WITH_GET",
                        `a ${request.method} request cannot have a body: use POST, or drop the body`,
                        request.url)
  if (!(body instanceof BodyStream) && request.duplex != "half")
    return requestError("ERR_DUPLEX_REQUIRED",
                        "a request whose body is a stream needs duplex: \"half\"", request.url)
  return undefined
}

export function startDeadline(timeout?: int): object | undefined {
  if (timeout == undefined) {
    return undefined
  }

  const deadline = deadlineNew()
  const timer = setTimeout(() => deadlinePass(deadline), timeout)
  timer.unref()

  return deadline
}

function plainInit<E extends StreamError>(init: RequestInit<E> | undefined,
                                          body: BodyData | undefined): RequestOptions | undefined {
  if (init == undefined) {
    return undefined
  }
  const plain: RequestOptions = {
    method: init.method,
    headers: init.headers,
    body: body,
    redirect: init.redirect,
    timeout: init.timeout,
    duplex: init.duplex,
  }

  return plain
}

export async function fetch<E extends StreamError = never>(input: string | URL | Request,
                                                          init?: RequestInit<E>):
    Promise<Result<Response, FetchError<E>>> {
  const body = init?.body
  if (input instanceof Request && body == undefined && input.bodyUsed()) {
    return err(requestError("ERR_REQUEST_USED",
                            "the body of this Request is already read, so it cannot be sent",
                            input.url))
  }
  if (!(body instanceof ReadableStream)) {
    const plain = plainInit(init, body)
    const request = new Request(input, plain)
    const sent = await fetchRequest(request, init?.proxy, init?.httpVersion ?? "auto")

    return sent
  }
  const rest = plainInit(init, undefined)
  const request = Request.stream(input, body, rest)
  const sent = await fetchRequest(request, init?.proxy, init?.httpVersion ?? "auto")
  if (sent.isOk()) {
    return sent
  }
  const failure = body.failure()
  if (failure != undefined) {
    const message = `the stream of the body of the request failed: ${failure.message}`

    return err({
      kind: "FETCH_ERROR_REQUEST",
      code: "ERR_STREAM_FAILED",
      message: message,
      url: request.url,
      details: failure,
    })
  }

  return sent
}

async function fetchRequest(request: Request, proxyOption: ProxyOption | undefined,
                            version: HttpVersion): Promise<Result<Response, FetchError>> {
  const first = URL.parse(request.url)
  if (first.isErr())
    return err(requestError("ERR_INVALID_URL", `fetch cannot parse "${request.url}" as a URL`,
                            request.url))
  const problem = requestProblem(request, first.value)
  if (problem != undefined) return err(problem)
  let url = first.value
  const timeout = request.timeout
  const deadline = startDeadline(timeout)
  let current = request
  let redirects = 0
  for (;;) {
    if (url.protocol() == "data:") return dataResponse(url)
    if (url.protocol() != "http:" && url.protocol() != "https:")
      return err(requestError("ERR_UNSUPPORTED_SCHEME",
                              `fetch cannot get ${url.href()}: only http:, https: and data: work`,
                              url.href()))
    const portNumber = url.portNumber()
    if (portNumber != undefined && BAD_PORTS.has(portNumber))
      return err(requestError("ERR_BLOCKED_PORT",
                              `fetch does not connect to port ${portNumber}: browsers and node ` +
                              "block it too", url.href()))
    const peer = peerOf(url, timeout, deadline)
    const proxied = proxyFor(url, peer, proxyOption)
    if (proxied.isErr()) return err(proxied.error)
    const sent = await send(current, url, redirects > 0, peer, version, proxied.value)
    if (sent.isErr()) return sent
    const response = sent.value
    const status = response.status
    const location = response.headers.get("location")
    const redirect = status == 301 || status == 302 || status == 303 || status == 307 ||
                     status == 308
    if (!redirect || location == undefined || request.redirect == "manual") return ok(response)
    if (request.redirect == "error")
      return err(redirectError("ERR_UNEXPECTED_REDIRECT",
                               `${url.href()} redirects to ${location}, and redirect is "error"`,
                               location))
    if (++redirects > 20)
      return err(redirectError("ERR_TOO_MANY_REDIRECTS",
                               `more than 20 redirects, the last one to ${location}`, location))
    const next = URL.parse(location, url)
    if (next.isErr())
      return err(redirectError("ERR_INVALID_LOCATION",
                               `${url.href()} redirects to "${location}", which is not a URL`,
                               location))
    const drained = await response.bytes()
    if (drained.isErr()) {
      if (peer.passed()) {
        return err(timeoutError(peer))
      }

      return err({
        kind: "FETCH_ERROR_RESPONSE",
        code: "ERR_CLOSED",
        message: `${peer.name()} closed the connection in the middle of a redirect`,
        host: peer.host,
        port: peer.port,
      })
    }
    const method = current.method
    if (((status == 301 || status == 302) && method == "POST") ||
        (status == 303 && method != "GET" && method != "HEAD")) {
      const headers = new Headers(current.headers)
      for (const name of ["content-encoding", "content-language", "content-location",
                          "content-type", "content-length"])
        headers.delete(name)
      current = new Request(next.value, { method: "GET", headers, redirect: request.redirect })
    } else if (current.bodyUsed()) {
      return err(redirectError("ERR_REDIRECT_WITH_STREAM",
                               `${url.href()} redirects to ${location}, but the body of the ` +
                               "request was a stream and is already sent", location))
    }
    if (next.value.origin() != url.origin()) {
      current.headers.delete("authorization")
      current.headers.delete("cookie")
      current.headers.delete("proxy-authorization")
    }
    url = next.value
  }
}
