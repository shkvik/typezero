/**
 * What can be gone through item by item with `for...of`, a spread and a
 * destructuring: an array, a string, a Map, a Set, an iterator, and an object
 * of a class that has the method `[Symbol.iterator]`. It is written only as
 * the type of a parameter of a function declared at the top level or of a
 * method: the function gets a copy for each kind of iterable it is called
 * with. Elsewhere the type itself is written, or `Iterator<T>`.
 */
export interface Iterable<T> {
  [Symbol.iterator](): Iterator<T>;
}

/**
 * A step of an iterator: an item while `done` is false, and what the
 * iterator ends with when it is true.
 */
export type IteratorResult<T, R = undefined> =
  { done: false; value: T } | { done: true; value: R };

/**
 * An iterator: it gives items one by one, each only when asked for. A
 * function with `function*` makes one: `T` is what it yields, `R` what it
 * returns at the end, `N` what `next(value)` sends into it as the value of
 * `yield`. The methods besides `next` are lazy: nothing is gone through until
 * the items are asked for, and a chain of them compiles into one loop. They
 * are there for an iterator that is sent nothing. There is no `throw`, since
 * an error is a value.
 */
export interface Generator<T, R = void, N = void> {
  /**
   * The next step: an item while `done` is false. It is a plain object, not
   * an `IteratorResult`: a check of `done` does not narrow `value`, so the
   * value is checked itself. A generator that returns nothing adds nothing
   * to the value: it is a `T | undefined`.
   */
  next(value?: N): { done: boolean; value: T | R | undefined };

  /**
   * An iterator of what the function gives for each item.
   * @example xs.values().map((x) => x * 2).toArray()
   */
  map<U>(change: (item: T, index: int) => U): Generator<U>;
  /** An iterator of the items the function says yes to. */
  filter(keep: (item: T, index: int) => boolean): Generator<T>;
  /** An iterator of the first `count` items; the count is not negative. */
  take(count: int): Generator<T>;
  /** An iterator without the first `count` items. */
  drop(count: int): Generator<T>;
  /** As `map`, and what the function gives is put in item by item. */
  flatMap<U>(change: (item: T, index: int) => U[] | Generator<U>): Generator<U>;

  /** Goes through the iterator and gives its items as an array. */
  toArray(): T[];
  forEach(action: (item: T, index: int) => void): void;
  /**
   * Folds the items into one value. Without a start value the first item is
   * the start, and an iterator of nothing gives `undefined`.
   */
  reduce(join: (result: T, item: T, index: int) => T): T | undefined;
  reduce<U>(join: (result: U, item: T, index: int) => U, start: U): U;
  /** Whether the function says yes to at least one item. */
  some(test: (item: T, index: int) => boolean): boolean;
  /** Whether the function says yes to every item. */
  every(test: (item: T, index: int) => boolean): boolean;
  /** The first item the function says yes to. */
  find(test: (item: T, index: int) => boolean): T | undefined;
}

/** The same as `Generator`. */
export type Iterator<T, R = void, N = void> = Generator<T, R, N>;

/** The same as `Generator`. */
export type IterableIterator<T, R = void, N = void> = Generator<T, R, N>;

/** What `Iterator` has. */
export interface IteratorConstructor {
  /**
   * An iterator of the items of an array, a string, a Map, a Set or an
   * object of a class with `[Symbol.iterator]`; an iterator is given as it
   * is.
   */
  from<T>(items: Iterable<T> | Iterator<T>): Iterator<T>;
}

export declare const Iterator: IteratorConstructor;

/**
 * An iterator whose items come later. A function with `async function*`
 * makes one, and it is gone through with `for await`: it has no methods of
 * its own.
 */
export interface AsyncGenerator<T, R = void, N = void> {}

/** The same as `AsyncGenerator`. */
export type AsyncIterator<T, R = void, N = void> = AsyncGenerator<T, R, N>;

/** The same as `AsyncGenerator`. */
export type AsyncIterable<T, R = void, N = void> = AsyncGenerator<T, R, N>;

/** The same as `AsyncGenerator`. */
export type AsyncIterableIterator<T, R = void, N = void> = AsyncGenerator<
  T,
  R,
  N
>;
