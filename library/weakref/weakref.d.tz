/**
 * A reference that does not keep its object: the object is freed when
 * nothing else holds it. It is made with `new WeakRef<T>(object)`.
 */
export declare class WeakRef<T> {
  /** A reference to an object; a number or a text is held itself. */
  public constructor(target: T);

  /** The object, or `undefined` when it is freed already. */
  public deref(): T | undefined;
}
