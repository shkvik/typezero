/**
 * What a `Map<K, V>` has: values by keys, in the order the keys were set. It
 * is made with `new Map<K, V>()`, of pairs or of another map when given.
 */
export interface Map<K, V> {
  /** How many keys there are. */
  readonly size: int;

  /** The value of the key. */
  get(key: K): V | undefined;
  /** Sets the value of the key and gives the map itself. */
  set(key: K, value: V): Map<K, V>;
  has(key: K): boolean;
  /** Removes the key; whether it was there. */
  delete(key: K): boolean;
  clear(): void;

  keys(): Generator<K>;
  values(): Generator<V>;
  entries(): Generator<[K, V]>;
  forEach(action: (value: V, key: K, all: Map<K, V>) => void): void;
}

/** What `Map` has besides `new Map<K, V>()`. */
export interface MapConstructor {
  /**
   * A map of the items by the key the function gives for each.
   * @example Map.groupBy([1, 2, 3], (x) => x % 2) // 1 => [1, 3], 0 => [2]
   */
  groupBy<T, K>(
    items: Iterable<T>,
    key: (item: T, index: int) => K,
  ): Map<K, T[]>;
}

export declare const Map: MapConstructor;

/**
 * What a `Set<T>` has: values without repeats, in the order they were added.
 * It is made with `new Set<T>()`, of the items of an array or of another set
 * when given. Where another set is taken, a map stands for the set of its
 * keys.
 */
export interface Set<T> {
  /** How many values there are. */
  readonly size: int;

  /** Adds the value and gives the set itself. */
  add(value: T): Set<T>;
  has(value: T): boolean;
  /** Removes the value; whether it was there. */
  delete(value: T): boolean;
  clear(): void;

  keys(): Generator<T>;
  values(): Generator<T>;
  entries(): Generator<[T, T]>;
  forEach(action: (value: T, same: T, all: Set<T>) => void): void;

  /** The values of both sets. */
  union(other: Set<T> | Map<T, unknown>): Set<T>;
  /** The values that are in both sets. */
  intersection(other: Set<T> | Map<T, unknown>): Set<T>;
  /** The values of this set that the other does not have. */
  difference(other: Set<T> | Map<T, unknown>): Set<T>;
  /** The values that are in one of the sets only. */
  symmetricDifference(other: Set<T> | Map<T, unknown>): Set<T>;
  isSubsetOf(other: Set<T> | Map<T, unknown>): boolean;
  isSupersetOf(other: Set<T> | Map<T, unknown>): boolean;
  /** Whether the sets have no value in common. */
  isDisjointFrom(other: Set<T> | Map<T, unknown>): boolean;
}
