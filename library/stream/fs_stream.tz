import {
  BufferedWrite,
  FaultCallback,
  HookCallback,
  Readable,
  StreamCallback,
  StreamFault,
  Writable,
  WriteChunk,
  faultOf,
  finished,
} from "node:stream"
import { ReadStreamError, WriteNewStreamError, WriteStreamError } from "node:fs"
import { chunkOf, defer, fsClose, fsOpen, fsRead, fsWrite, stdWrite, stdinChunk, stdinFailed } from "tz:intrinsics"

function failure(code: string, message: string): StreamFault {
  return { code, message }
}

function rangeProblem(value: double, name: string): string | undefined {
  if (Number.isInteger(value) && value >= 0 && value <= Number.MAX_SAFE_INTEGER) return undefined
  return `${name} must be a whole number from 0 to 9007199254740991, not ${value}`
}

export interface ReadStreamOptions {
  flags?: string
  encoding?: BufferEncoding
  fd?: int
  mode?: int
  autoClose?: boolean
  emitClose?: boolean
  start?: double
  end?: double
  highWaterMark?: double
}

export interface WriteStreamOptions {
  flags?: string
  encoding?: BufferEncoding
  fd?: int
  mode?: int
  autoClose?: boolean
  emitClose?: boolean
  start?: double
  flush?: boolean
  highWaterMark?: double
}

declare function libCloseFd(fd: int): boolean

class OpenFile {
  fd?: int
}

function closeOnDrop(file: OpenFile) {
  return defer(() => {
    const fd = file.fd
    if (fd == undefined) return
    file.fd = undefined
    if (!libCloseFd(fd))
      console.error(`closing file descriptor ${fd} on its last reference failed`)
  })
}

function closeFd<E extends StreamError>(fd: int | undefined, flush: boolean,
                                        err: StreamFault | undefined, cb: FaultCallback,
                                        fault: (error: E) => StreamFault) {
  if (fd == undefined) {
    cb(err)
    return
  }
  const open = fd
  const closeIt = (error: StreamFault | undefined) => {
    void fsClose<E>(open, false).then((closed) => {
      if (closed.isErr()) cb(fault(closed.error))
      else cb(error)
    })
  }
  if (flush)
    void fsClose<E>(open, true).then((synced) => {
      if (synced.isErr()) closeIt(err ?? fault(synced.error))
      else closeIt(err)
    })
  else closeIt(err)
}

export class ReadStream<T = Buffer> extends Readable<T, ReadStreamError> {
  private fileFd?: int
  readonly path: string
  readonly flags: string
  readonly mode: int
  readonly start?: double
  readonly end?: double
  private position?: double
  private readCount: int = 0
  private opening: boolean
  readonly autoClose: boolean
  private performingIO = false
  private ioDone?: (error: StreamFault | undefined) => void
  private invalid?: ReadStreamError
  private file = new OpenFile()
  private closer: object

  constructor(path: string, options?: ReadStreamOptions) {
    super({
      highWaterMark: options?.highWaterMark ?? 64 * 1024,
      encoding: options?.encoding,
      emitClose: options?.emitClose,
      autoDestroy: options?.autoClose ?? true,
    })
    this.fileFd = options?.fd
    this.path = path
    this.flags = options?.flags ?? "r"
    this.mode = options?.mode ?? 0o666
    this.autoClose = options?.autoClose ?? true
    if (this.autoClose) this.file.fd = this.fileFd
    this.closer = closeOnDrop(this.file)
    const start = options?.start
    this.start = start
    this.position = start
    const end = options?.end
    this.end = end
    let problem = start == undefined ? undefined : rangeProblem(start, "start")
    if (problem == undefined && end != undefined) problem = rangeProblem(end, "end")
    if (problem == undefined && start != undefined && end != undefined && start > end)
      problem = `start (${start}) is after end (${end})`
    if (problem != undefined)
      this.invalid = {
        kind: "READ_STREAM_ERROR_INVALID_RANGE",
        code: "ERR_OUT_OF_RANGE",
        message: `could not read ${path}: ${problem}`,
        path,
      }
    this.opening = this.fileFd == undefined
  }

  public fd(): int | undefined {
    return this.fileFd
  }

  public pos(): double | undefined {
    return this.position
  }

  public pending(): boolean {
    return this.opening
  }

  public bytesRead(): int {
    return this.readCount
  }

  protected onConstruct(callback: HookCallback<ReadStreamError>): void {
    const invalid = this.invalid
    if (invalid != undefined) {
      callback(invalid)
      return
    }
    if (this.fileFd != undefined) {
      callback()
      return
    }
    void fsOpen<ReadStreamError>(this.path, this.flags, this.mode).then((opened) => {
      if (opened.isErr()) {
        callback(opened.error)
        return
      }
      const fd = opened.value
      this.fileFd = fd
      if (this.autoClose) this.file.fd = fd
      this.opening = false
      callback()
      this.emit("open", fd)
      this.emit("ready")
    })
  }

  protected onRead(size: int): void {
    const pos = this.position
    const end = this.end
    const left =
      end == undefined ? size.toDouble()
      : pos != undefined ? end - pos + 1
      : end - this.readCount.toDouble() + 1
    const n = left < size.toDouble() ? Math.floor(left).toInt() : size
    const fd = this.fileFd
    if (n <= 0 || fd == undefined) {
      this.pushChunk(undefined)
      return
    }
    const buf = Buffer.allocUnsafeSlow(n)
    this.performingIO = true
    void fsRead<ReadStreamError>(fd, buf, 0, n, pos ?? -1).then((read) => {
      if (read.isErr()) this.afterRead(read.error, 0, buf)
      else this.afterRead(undefined, read.value, buf)
    })
  }

  private afterRead(er: ReadStreamError | undefined, bytesRead: int, buf: Buffer) {
    this.performingIO = false
    if (this.destroyed()) {
      const done = this.ioDone
      this.ioDone = undefined
      if (done != undefined) done(er == undefined ? undefined : this.faultFrom(er))
      return
    }
    if (er != undefined) {
      this.destroy(er)
    } else if (bytesRead > 0) {
      const pos = this.position
      if (pos != undefined) this.position = pos + bytesRead.toDouble()
      this.readCount += bytesRead
      let chunk = buf
      if (bytesRead != buf.length) {
        const dst = Buffer.allocUnsafeSlow(bytesRead)
        buf.copy(dst, 0, 0, bytesRead)
        chunk = dst
      }
      this.pushChunk(chunk)
    } else {
      this.pushChunk(undefined)
    }
  }

  protected destroyHook(error: StreamFault | undefined, callback: FaultCallback): void {
    const finish = (er: StreamFault | undefined) => {
      const fd = this.fileFd
      this.fileFd = undefined
      this.file.fd = undefined
      closeFd<ReadStreamError>(fd, false, er, callback, (e: ReadStreamError) => this.faultFrom(e))
    }
    if (this.performingIO) this.ioDone = (er: StreamFault | undefined) => finish(error ?? er)
    else finish(error)
  }

  close(callback?: StreamCallback) {
    if (callback != undefined) finished(this, callback)
    this.destroy()
  }
}

abstract class FileWriter<E extends StreamError> extends Writable<Buffer, E> {
  private fileFd?: int
  readonly path: string
  readonly flags: string
  readonly mode: int
  readonly start?: double
  private position?: double
  private writeCount: int = 0
  readonly flush: boolean
  private opening: boolean
  readonly autoClose: boolean
  private performingIO = false
  private ioDone?: (error: StreamFault | undefined) => void
  private problem?: string
  private file = new OpenFile()
  private closer: object

  constructor(path: string, options?: WriteStreamOptions) {
    super({
      highWaterMark: options?.highWaterMark,
      decodeStrings: true,
      emitClose: options?.emitClose,
      autoDestroy: options?.autoClose ?? true,
      defaultEncoding: options?.encoding,
    })
    this.fileFd = options?.fd
    this.path = path
    this.flags = options?.flags ?? "w"
    this.mode = options?.mode ?? 0o666
    this.autoClose = options?.autoClose ?? true
    if (this.autoClose) this.file.fd = this.fileFd
    this.closer = closeOnDrop(this.file)
    this.flush = options?.flush ?? false
    const start = options?.start
    this.start = start
    this.position = start
    this.problem = start == undefined ? undefined : rangeProblem(start, "start")
    this.opening = this.fileFd == undefined
  }

  public fd(): int | undefined {
    return this.fileFd
  }

  public pos(): double | undefined {
    return this.position
  }

  public pending(): boolean {
    return this.opening
  }

  public bytesWritten(): int {
    return this.writeCount
  }

  protected abstract rangeError(message: string): E

  protected onConstruct(callback: HookCallback<E>): void {
    const problem = this.problem
    if (problem != undefined) {
      const invalid = this.rangeError(`could not write ${this.path}: ${problem}`)
      callback(invalid)
      return
    }
    if (this.fileFd != undefined) {
      callback()
      return
    }
    void fsOpen<E>(this.path, this.flags, this.mode).then((opened) => {
      if (opened.isErr()) {
        callback(opened.error)
        return
      }
      const fd = opened.value
      this.fileFd = fd
      if (this.autoClose) this.file.fd = fd
      this.opening = false
      callback()
      this.emit("open", fd)
      this.emit("ready")
    })
  }

  private writeAll(data: Buffer, offset: int, size: int, pos: double | undefined, cb: FaultCallback,
            retries: int) {
    const fd = this.fileFd
    if (fd == undefined) {
      cb(failure("ERR_STREAM_DESTROYED", "Cannot call write after a stream was destroyed"))
      return
    }
    void fsWrite<E>(fd, data, offset, size, pos ?? -1).then((written) => {
      if (written.isErr()) {
        cb(this.faultFrom(written.error))
        return
      }
      const bytesWritten = written.value
      if (this.destroyed()) {
        cb(failure("ERR_STREAM_DESTROYED", "Cannot call write after a stream was destroyed"))
        return
      }
      this.writeCount += bytesWritten
      const tries = bytesWritten != 0 ? 0 : retries + 1
      const left = size - bytesWritten
      if (tries > 5) cb(failure("ERR_SYSTEM_ERROR", "write failed"))
      else if (left != 0)
        this.writeAll(data, offset + bytesWritten, left,
                       pos != undefined ? pos + bytesWritten.toDouble() : undefined, cb, tries)
      else cb()
    })
  }

  protected onWrite(chunk: Buffer, encoding: string, callback: HookCallback<E>): void {
    void chunk
    void encoding
    callback()
  }

  protected writeChunk(chunk: unknown, encoding: string, callback: FaultCallback): void {
    this.writeBuffer(chunkOf<Buffer>(chunk), callback)
  }

  protected writevChunks(chunks: BufferedWrite[], callback: FaultCallback): void {
    const all: Buffer[] = []
    for (const c of chunks) all.push(chunkOf<Buffer>(c.chunk))
    this.writeBuffer(Buffer.concat(all), callback)
  }

  private writeBuffer(chunk: Buffer, callback: FaultCallback): void {
    this.performingIO = true
    this.writeAll(chunk, 0, chunk.length, this.position, (er?: StreamFault) => {
      this.performingIO = false
      if (this.destroyed()) {
        callback(er)
        const done = this.ioDone
        this.ioDone = undefined
        if (done != undefined) done(er)
        return
      }
      callback(er)
    }, 0)
    const pos = this.position
    if (pos != undefined) this.position = pos + chunk.length.toDouble()
  }

  protected onWritev(chunks: WriteChunk<Buffer>[], callback: HookCallback<E>): void {
    void chunks
    callback()
  }

  protected destroyHook(error: StreamFault | undefined, callback: FaultCallback): void {
    const finish = (er: StreamFault | undefined) => {
      const fd = this.fileFd
      this.fileFd = undefined
      this.file.fd = undefined
      closeFd<E>(fd, this.flush, er, callback, (e: E) => this.faultFrom(e))
    }
    if (this.performingIO) this.ioDone = (er: StreamFault | undefined) => finish(error ?? er)
    else finish(error)
  }

  close(callback?: StreamCallback) {
    if (callback != undefined) {
      const done = callback
      if (this.closed()) {
        process.nextTick(() => done())
        return
      }
      this.on("close", () => done())
    }
    if (!this.autoClose) this.on("finish", () => this.destroy())
    void this.end()
  }
}

export class WriteStream extends FileWriter<WriteStreamError> {
  public constructor(path: string, options?: WriteStreamOptions) {
    super(path, options)
  }

  protected rangeError(message: string): WriteStreamError {
    const invalid: WriteStreamError = {
      kind: "WRITE_STREAM_ERROR_INVALID_RANGE",
      code: "ERR_OUT_OF_RANGE",
      message: message,
      path: this.path,
    }

    return invalid
  }
}

export class WriteNewStream extends FileWriter<WriteNewStreamError> {
  public constructor(path: string, options?: WriteStreamOptions) {
    super(path, options)
  }

  protected rangeError(message: string): WriteNewStreamError {
    const invalid: WriteNewStreamError = {
      kind: "WRITE_NEW_STREAM_ERROR_INVALID_RANGE",
      code: "ERR_OUT_OF_RANGE",
      message: message,
      path: this.path,
    }

    return invalid
  }
}

export function createReadStream() {}
export function createWriteStream() {}

export function streamReadFile<T>(path: string, options: ReadStreamOptions | undefined,
                                  encoding: BufferEncoding | undefined): ReadStream<T> {
  if (encoding == undefined) return new ReadStream<T>(path, options)
  return new ReadStream<T>(path, {
    flags: options?.flags,
    encoding,
    fd: options?.fd,
    mode: options?.mode,
    autoClose: options?.autoClose,
    emitClose: options?.emitClose,
    start: options?.start,
    end: options?.end,
    highWaterMark: options?.highWaterMark,
  })
}

function writeOptions(options: WriteStreamOptions | undefined,
                      encoding: BufferEncoding | undefined): WriteStreamOptions | undefined {
  if (encoding == undefined) {
    return options
  }
  const merged: WriteStreamOptions = {
    flags: options?.flags,
    encoding: encoding,
    fd: options?.fd,
    mode: options?.mode,
    autoClose: options?.autoClose,
    emitClose: options?.emitClose,
    start: options?.start,
    flush: options?.flush,
    highWaterMark: options?.highWaterMark,
  }

  return merged
}

export function streamWriteFile(path: string, options: WriteStreamOptions | undefined,
                                encoding: BufferEncoding | undefined): WriteStream {
  const merged = writeOptions(options, encoding)
  const stream = new WriteStream(path, merged)

  return stream
}

export function streamWriteNewFile(path: string, options: WriteStreamOptions | undefined,
                                   encoding: BufferEncoding | undefined): WriteNewStream {
  const merged = writeOptions(options, encoding)
  const stream = new WriteNewStream(path, merged)

  return stream
}

export interface StdinError extends StreamError {
  kind: "STDIN_ERROR"
  code: "EIO"
}

export interface StdoutError extends StreamError {
  kind: "STDOUT_ERROR"
  code: "EPIPE" | "EOF"
  fd: int
}

class StdinStream extends Readable<Buffer, StdinError> {
  readonly fd = 0
  private reading = false

  protected onRead(size: int): void {
    if (this.reading) return
    this.reading = true
    void stdinChunk(size).then((chunk: Buffer | undefined) => {
      this.reading = false
      if (chunk == undefined && stdinFailed()) {
        this.destroy({
          kind: "STDIN_ERROR",
          code: "EIO",
          message: "could not read stdin: the system failed to read it",
        })
        return
      }
      this.pushChunk(chunk)
    })
  }
}

class StdioStream extends Writable<Buffer, StdoutError> {
  constructor(readonly fd: int) {
    super({ emitClose: false, autoDestroy: false })
  }

  protected onWrite(chunk: Buffer, encoding: string, callback: HookCallback<StdoutError>): void {
    void encoding
    const gone = stdWrite(this.fd, chunk)
    if (gone == 0) {
      callback()
      return
    }
    const name = this.fd == 2 ? "stderr" : "stdout"

    callback({
      kind: "STDOUT_ERROR",
      code: process.platform == "win32" ? "EOF" : "EPIPE",
      message: `could not write to ${name}: the reader is gone`,
      fd: this.fd,
    })
  }
}

let stdinStream: StdinStream | undefined = undefined
let stdoutStream: StdioStream | undefined = undefined
let stderrStream: StdioStream | undefined = undefined

export function processStdin(): Readable<Buffer, StdinError> {
  const made = stdinStream
  if (made != undefined) return made
  const stream = new StdinStream({ highWaterMark: 64 * 1024 })
  stdinStream = stream
  return stream
}

export function processStdout(fd: int): Writable<Buffer, StdoutError> {
  const made = fd == 2 ? stderrStream : stdoutStream
  if (made != undefined) return made
  const stream = new StdioStream(fd)
  if (fd == 2) stderrStream = stream
  else stdoutStream = stream
  return stream
}
