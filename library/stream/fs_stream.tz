import { AbortSignal } from "tz:web"
import { Readable, Stream, StreamCallback, Writable, WriteChunk, streamFinished } from "node:stream"
import { defer, fsClose, fsOpen, fsRead, fsWrite, stdWrite, stdinChunk } from "tz:intrinsics"

function failure(code: string, message: string): StreamError {
  return { code, message }
}

function streamFailure(e: SystemError): StreamError {
  return { code: e.code, message: e.message, errno: e.errno, syscall: e.syscall, path: e.path }
}

function invalidInteger(value: double, name: string): StreamError | undefined {
  if (Number.isInteger(value) && value >= 0 && value <= Number.MAX_SAFE_INTEGER) return undefined
  return failure(
    "ERR_OUT_OF_RANGE",
    `The value of "${name}" is out of range. It must be >= 0 && <= 9007199254740991. ` +
      `Received ${value}`,
  )
}

export interface ReadStreamOptions {
  flags?: string
  encoding?: BufferEncoding
  fd?: int
  mode?: int
  autoClose?: boolean
  emitClose?: boolean
  start?: double
  end?: double
  highWaterMark?: double
  signal?: AbortSignal
}

export interface WriteStreamOptions {
  flags?: string
  encoding?: BufferEncoding
  fd?: int
  mode?: int
  autoClose?: boolean
  emitClose?: boolean
  start?: double
  flush?: boolean
  highWaterMark?: double
  signal?: AbortSignal
}

declare function libCloseFd(fd: int): boolean

class OpenFile {
  fd?: int
}

function closeOnDrop(file: OpenFile) {
  return defer(() => {
    const fd = file.fd
    if (fd == undefined) return
    file.fd = undefined
    if (!libCloseFd(fd))
      console.error(`closing file descriptor ${fd} on its last reference failed`)
  })
}

function closeFd(fd: int | undefined, flush: boolean, err: StreamError | undefined,
                 cb: StreamCallback) {
  if (fd == undefined) {
    cb(err)
    return
  }
  const open = fd
  const closeIt = (error: StreamError | undefined) => {
    void fsClose(open, false).then((closed) => {
      if (closed.isErr()) cb(streamFailure(closed.error))
      else cb(error)
    })
  }
  if (flush)
    void fsClose(open, true).then((synced) => {
      if (synced.isErr()) closeIt(err ?? streamFailure(synced.error))
      else closeIt(err)
    })
  else closeIt(err)
}

export class ReadStream<T = Buffer> extends Readable<T> {
  fd?: int
  path: string
  flags: string
  mode: int
  start?: double
  end?: double
  pos?: double
  bytesRead = 0
  pending: boolean
  autoClose: boolean
  _performingIO = false
  _ioDone?: (error: StreamError | undefined) => void
  _invalid?: StreamError
  _file = new OpenFile()
  _closer: object

  constructor(path: string, options?: ReadStreamOptions) {
    super({
      highWaterMark: options?.highWaterMark ?? 64 * 1024,
      encoding: options?.encoding,
      emitClose: options?.emitClose,
      autoDestroy: options?.autoClose ?? true,
      signal: options?.signal,
    })
    this.fd = options?.fd
    this.path = path
    this.flags = options?.flags ?? "r"
    this.mode = options?.mode ?? 0o666
    this.autoClose = options?.autoClose ?? true
    if (this.autoClose) this._file.fd = this.fd
    this._closer = closeOnDrop(this._file)
    const start = options?.start
    this.start = start
    this.pos = start
    if (start != undefined) this._invalid = invalidInteger(start, "start")
    const end = options?.end
    this.end = end
    if (end != undefined && this._invalid == undefined) {
      this._invalid = invalidInteger(end, "end")
      if (start != undefined && start > end && this._invalid == undefined)
        this._invalid = failure(
          "ERR_OUT_OF_RANGE",
          `The value of "start" is out of range. It must be <= "end" (here: ${end}). ` +
            `Received ${start}`,
        )
    }
    this.pending = this.fd == undefined
  }

  _construct(callback: StreamCallback): void {
    if (this._invalid != undefined) {
      callback(this._invalid)
      return
    }
    if (this.fd != undefined) {
      callback()
      return
    }
    void fsOpen(this.path, this.flags, this.mode).then((opened) => {
      if (opened.isErr()) {
        callback(streamFailure(opened.error))
        return
      }
      const fd = opened.value
      this.fd = fd
      if (this.autoClose) this._file.fd = fd
      this.pending = false
      callback()
      this.emit("open", fd)
      this.emit("ready")
    })
  }

  _read(size: int): void {
    const pos = this.pos
    const end = this.end
    const left =
      end == undefined ? size.toDouble()
      : pos != undefined ? end - pos + 1
      : end - this.bytesRead.toDouble() + 1
    const n = left < size.toDouble() ? Math.floor(left).toInt() : size
    const fd = this.fd
    if (n <= 0 || fd == undefined) {
      this._pushChunk(undefined)
      return
    }
    const buf = Buffer.allocUnsafeSlow(n)
    this._performingIO = true
    void fsRead(fd, buf, 0, n, pos ?? -1).then((read) => {
      if (read.isErr()) this.afterRead(streamFailure(read.error), 0, buf)
      else this.afterRead(undefined, read.value, buf)
    })
  }

  private afterRead(er: StreamError | undefined, bytesRead: int, buf: Buffer) {
    this._performingIO = false
    if (this.destroyed) {
      const done = this._ioDone
      this._ioDone = undefined
      if (done != undefined) done(er)
      return
    }
    if (er != undefined) {
      this.destroy(er)
    } else if (bytesRead > 0) {
      const pos = this.pos
      if (pos != undefined) this.pos = pos + bytesRead.toDouble()
      this.bytesRead += bytesRead
      let chunk = buf
      if (bytesRead != buf.length) {
        const dst = Buffer.allocUnsafeSlow(bytesRead)
        buf.copy(dst, 0, 0, bytesRead)
        chunk = dst
      }
      this._pushChunk(chunk)
    } else {
      this._pushChunk(undefined)
    }
  }

  _destroy(error: StreamError | undefined, callback: StreamCallback): void {
    const finish = (er: StreamError | undefined) => {
      const fd = this.fd
      this.fd = undefined
      this._file.fd = undefined
      closeFd(fd, false, er, callback)
    }
    if (this._performingIO) this._ioDone = (er: StreamError | undefined) => finish(error ?? er)
    else finish(error)
  }

  close(callback?: StreamCallback) {
    if (callback != undefined) streamFinished(this, undefined, callback)
    this.destroy()
  }
}

export class WriteStream extends Writable<Buffer> {
  fd?: int
  path: string
  flags: string
  mode: int
  start?: double
  pos?: double
  bytesWritten = 0
  flush: boolean
  pending: boolean
  autoClose: boolean
  _performingIO = false
  _ioDone?: (error: StreamError | undefined) => void
  _invalid?: StreamError
  _file = new OpenFile()
  _closer: object

  constructor(path: string, options?: WriteStreamOptions) {
    super({
      highWaterMark: options?.highWaterMark,
      decodeStrings: true,
      emitClose: options?.emitClose,
      autoDestroy: options?.autoClose ?? true,
      signal: options?.signal,
      defaultEncoding: options?.encoding,
    })
    this.fd = options?.fd
    this.path = path
    this.flags = options?.flags ?? "w"
    this.mode = options?.mode ?? 0o666
    this.autoClose = options?.autoClose ?? true
    if (this.autoClose) this._file.fd = this.fd
    this._closer = closeOnDrop(this._file)
    this.flush = options?.flush ?? false
    const start = options?.start
    this.start = start
    this.pos = start
    if (start != undefined) this._invalid = invalidInteger(start, "start")
    this.pending = this.fd == undefined
  }

  _construct(callback: StreamCallback): void {
    if (this._invalid != undefined) {
      callback(this._invalid)
      return
    }
    if (this.fd != undefined) {
      callback()
      return
    }
    void fsOpen(this.path, this.flags, this.mode).then((opened) => {
      if (opened.isErr()) {
        callback(streamFailure(opened.error))
        return
      }
      const fd = opened.value
      this.fd = fd
      if (this.autoClose) this._file.fd = fd
      this.pending = false
      callback()
      this.emit("open", fd)
      this.emit("ready")
    })
  }

  private writeAll(data: Buffer, offset: int, size: int, pos: double | undefined, cb: StreamCallback,
            retries: int) {
    const fd = this.fd
    if (fd == undefined) {
      cb(failure("ERR_STREAM_DESTROYED", "Cannot call write after a stream was destroyed"))
      return
    }
    void fsWrite(fd, data, offset, size, pos ?? -1).then((written) => {
      if (written.isErr()) {
        cb(streamFailure(written.error))
        return
      }
      const bytesWritten = written.value
      if (this.destroyed) {
        cb(failure("ERR_STREAM_DESTROYED", "Cannot call write after a stream was destroyed"))
        return
      }
      this.bytesWritten += bytesWritten
      const tries = bytesWritten != 0 ? 0 : retries + 1
      const left = size - bytesWritten
      if (tries > 5) cb(failure("ERR_SYSTEM_ERROR", "write failed"))
      else if (left != 0)
        this.writeAll(data, offset + bytesWritten, left,
                       pos != undefined ? pos + bytesWritten.toDouble() : undefined, cb, tries)
      else cb()
    })
  }

  _write(chunk: Buffer, encoding: string, callback: StreamCallback): void {
    void encoding
    this._performingIO = true
    this.writeAll(chunk, 0, chunk.length, this.pos, (er?: StreamError) => {
      this._performingIO = false
      if (this.destroyed) {
        callback(er)
        const done = this._ioDone
        this._ioDone = undefined
        if (done != undefined) done(er)
        return
      }
      callback(er)
    }, 0)
    const pos = this.pos
    if (pos != undefined) this.pos = pos + chunk.length.toDouble()
  }

  _writev(chunks: WriteChunk<Buffer>[], callback: StreamCallback): void {
    const all: Buffer[] = []
    for (const c of chunks) all.push(c.chunk)
    this._write(Buffer.concat(all), "buffer", callback)
  }

  _destroy(error: StreamError | undefined, callback: StreamCallback): void {
    const finish = (er: StreamError | undefined) => {
      const fd = this.fd
      this.fd = undefined
      this._file.fd = undefined
      closeFd(fd, this.flush, er, callback)
    }
    if (this._performingIO) this._ioDone = (er: StreamError | undefined) => finish(error ?? er)
    else finish(error)
  }

  close(callback?: StreamCallback) {
    if (callback != undefined) {
      const done = callback
      if (this.closed) {
        process.nextTick(() => done())
        return
      }
      this.on("close", () => done())
    }
    if (!this.autoClose) this.on("finish", () => this.destroy())
    this._endWith(false, undefined, undefined, undefined)
  }
}

export function createReadStream() {}
export function createWriteStream() {}

export function streamReadFile<T>(path: string, options: ReadStreamOptions | undefined,
                                  encoding: BufferEncoding | undefined): ReadStream<T> {
  if (encoding == undefined) return new ReadStream<T>(path, options)
  return new ReadStream<T>(path, {
    flags: options?.flags,
    encoding,
    fd: options?.fd,
    mode: options?.mode,
    autoClose: options?.autoClose,
    emitClose: options?.emitClose,
    start: options?.start,
    end: options?.end,
    highWaterMark: options?.highWaterMark,
    signal: options?.signal,
  })
}

export function streamWriteFile(path: string, options: WriteStreamOptions | undefined,
                                encoding: BufferEncoding | undefined): WriteStream {
  if (encoding == undefined) return new WriteStream(path, options)
  return new WriteStream(path, {
    flags: options?.flags,
    encoding,
    fd: options?.fd,
    mode: options?.mode,
    autoClose: options?.autoClose,
    emitClose: options?.emitClose,
    start: options?.start,
    flush: options?.flush,
    highWaterMark: options?.highWaterMark,
    signal: options?.signal,
  })
}

class StdinStream extends Readable<Buffer> {
  fd = 0
  private reading = false

  _read(size: int): void {
    if (this.reading) return
    this.reading = true
    void stdinChunk(size).then((chunk: Buffer | undefined) => {
      this.reading = false
      this._pushChunk(chunk)
    })
  }
}

class StdioStream extends Writable<Buffer> {
  constructor(readonly fd: int) {
    super({ emitClose: false, autoDestroy: false })
  }

  _write(chunk: Buffer, encoding: string, callback: StreamCallback): void {
    void encoding
    stdWrite(this.fd, chunk)
    callback()
  }
}

let stdinStream: StdinStream | undefined = undefined
let stdoutStream: StdioStream | undefined = undefined
let stderrStream: StdioStream | undefined = undefined

export function processStdin(): Readable<Buffer> {
  const made = stdinStream
  if (made != undefined) return made
  const stream = new StdinStream({ highWaterMark: 64 * 1024 })
  stdinStream = stream
  return stream
}

export function processStdout(fd: int): Writable<Buffer> {
  const made = fd == 2 ? stderrStream : stdoutStream
  if (made != undefined) return made
  const stream = new StdioStream(fd)
  if (fd == 2) stderrStream = stream
  else stdoutStream = stream
  stream._markStdio()
  return stream
}

export function isStdioStream(stream: Stream): boolean {
  return stream == stdoutStream || stream == stderrStream
}
