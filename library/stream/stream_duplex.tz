export type StreamEvents<T> = {
  close: []
  data: [chunk: T]
  end: []
  error: [err: StreamError]
  pause: []
  readable: []
  resume: []
  drain: []
  finish: []
  prefinish: []
  pipe: [src: Stream]
  unpipe: [src: Stream, info: { hasUnpiped: boolean }]
  open: [fd: int]
  ready: []
}

export class StreamEmitter<Events> extends Stream {}

let pendingSides: DuplexSides | undefined = undefined

const kStringChunks = 1

export interface ReadableOptions<T> {
  highWaterMark?: double
  encoding?: BufferEncoding
  objectMode?: boolean
  emitClose?: boolean
  autoDestroy?: boolean
  signal?: AbortSignal
  read?: (this: Readable<T>, size: int) => void
  destroy?: (this: Readable<T>, error: StreamError | undefined, callback: StreamCallback) => void
  construct?: (this: Readable<T>, callback: StreamCallback) => void
}

function chunkEncoding(kind: int, objectMode: boolean,
                       encoding: BufferEncoding | undefined): BufferEncoding | undefined {
  if (objectMode || kind != kStringChunks) return encoding
  return encoding ?? "utf8"
}

export class Readable<T = Buffer> extends StreamEmitter<StreamEvents<T>> {
  private readOption?: (this: Readable<T>, size: int) => void
  private destroyOption?:
    (this: Readable<T>, error: StreamError | undefined, callback: StreamCallback) => void
  private constructOption?: (this: Readable<T>, callback: StreamCallback) => void

  constructor(options?: ReadableOptions<T>) {
    super()
    this.readOption = options?.read
    this.destroyOption = options?.destroy
    this.constructOption = options?.construct
    if (pendingSides != undefined) return
    const setup = new StreamSetup()
    setup.readable = {
      highWaterMark: options?.highWaterMark,
      objectMode: options?.objectMode,
      encoding: chunkEncoding(chunkKind<T>(), options?.objectMode ?? false, options?.encoding),
      emitClose: options?.emitClose,
      autoDestroy: options?.autoDestroy,
    }
    setup.hasConstruct = options?.construct != undefined || overrides(this, "onConstruct")
    setup.signal = options?.signal
    this.setUp(setup)
  }

  protected onRead(size: int): void {
    const read = this.readOption
    if (read == undefined) super.onRead(size)
    else read.call(this, size)
  }

  protected onDestroy(error: StreamError | undefined, callback: StreamCallback): void {
    const destroy = this.destroyOption
    if (destroy == undefined) callback(error)
    else destroy.call(this, error, callback)
  }

  protected onConstruct(callback: StreamCallback): void {
    const construct = this.constructOption
    if (construct == undefined) callback()
    else construct.call(this, callback)
  }

  protected emitData(chunk: unknown): void {
    if (this.readableObjectMode) this.emitWithUnknown("data", chunk, chunkOf<T>(chunk))
    else if (typeof chunk == "string") this.emitWithUnknown("data", chunk, chunk)
    else this.emitWithUnknown("data", chunk, chunkOf<Buffer>(chunk))
  }

  protected pushChunk(chunk: unknown, encoding?: string): boolean {
    if (chunk != undefined && this.readableObjectMode && !isChunk<T>(chunk)) {
      this.destroy(invalidChunk(chunk))
      return false
    }
    return super.pushChunk(chunk, encoding)
  }

  read(size?: int): T | undefined {
    const chunk = this.readChunk(size)
    return chunk == undefined ? undefined : chunkOf<T>(chunk)
  }

  [Symbol.asyncIterator](): AsyncGenerator<Result<T, StreamError>> {
    return this.iterate<T>(true)
  }

  iterator(options?: { destroyOnReturn?: boolean }): AsyncGenerator<Result<T, StreamError>> {
    return this.iterate<T>(options?.destroyOnReturn ?? true)
  }
}

export interface WriteChunk<T> {
  chunk: T
  encoding: string
}

export interface WritableOptions<T> {
  highWaterMark?: double
  decodeStrings?: boolean
  defaultEncoding?: BufferEncoding
  objectMode?: boolean
  emitClose?: boolean
  autoDestroy?: boolean
  signal?: AbortSignal
  write?: (this: Writable<T>, chunk: T, encoding: string, callback: StreamCallback) => void
  writev?: (this: Writable<T>, chunks: WriteChunk<T>[], callback: StreamCallback) => void
  final?: (this: Writable<T>, callback: StreamCallback) => void
  destroy?: (this: Writable<T>, error: StreamError | undefined, callback: StreamCallback) => void
  construct?: (this: Writable<T>, callback: StreamCallback) => void
}

function typedChunks<T>(chunks: BufferedWrite[]): WriteChunk<T>[] {
  const out: WriteChunk<T>[] = []
  for (const c of chunks) out.push({ chunk: chunkOf<T>(c.chunk), encoding: c.encoding })
  return out
}

function decodesStrings(kind: int, objectMode: boolean) {
  return objectMode || kind != kStringChunks
}

export class Writable<T = Buffer> extends StreamEmitter<StreamEvents<T>> {
  private writeOption?:
    (this: Writable<T>, chunk: T, encoding: string, callback: StreamCallback) => void
  private writevOption?:
    (this: Writable<T>, chunks: WriteChunk<T>[], callback: StreamCallback) => void
  private finalOption?: (this: Writable<T>, callback: StreamCallback) => void
  private destroyOption?:
    (this: Writable<T>, error: StreamError | undefined, callback: StreamCallback) => void
  private constructOption?: (this: Writable<T>, callback: StreamCallback) => void

  constructor(options?: WritableOptions<T>) {
    super()
    this.writeOption = options?.write
    this.writevOption = options?.writev
    this.finalOption = options?.final
    this.destroyOption = options?.destroy
    this.constructOption = options?.construct
    const setup = new StreamSetup()
    setup.writable = {
      highWaterMark: options?.highWaterMark,
      objectMode: options?.objectMode,
      decodeStrings: decodesStrings(chunkKind<T>(), options?.objectMode ?? false),
      defaultEncoding: options?.defaultEncoding,
      emitClose: options?.emitClose,
      autoDestroy: options?.autoDestroy,
    }
    setup.hasWritev = options?.writev != undefined || overrides(this, "onWritev")
    setup.hasFinal = options?.final != undefined || overrides(this, "onFinal")
    setup.hasConstruct = options?.construct != undefined || overrides(this, "onConstruct")
    setup.signal = options?.signal
    this.setUp(setup)
  }

  protected writeChunk(chunk: unknown, encoding: string, callback: StreamCallback): void {
    this.onWrite(chunkOf<T>(chunk), encoding, callback)
  }

  protected writevChunks(chunks: BufferedWrite[], callback: StreamCallback): void {
    this.onWritev(typedChunks<T>(chunks), callback)
  }

  protected onWrite(chunk: T, encoding: string, callback: StreamCallback): void {
    const write = this.writeOption
    if (write != undefined) write.call(this, chunk, encoding, callback)
    else if (this.writevOption != undefined || overrides(this, "onWritev"))
      this.onWritev([{ chunk, encoding }], callback)
    else callback(methodNotImplemented("onWrite()"))
  }

  protected onWritev(chunks: WriteChunk<T>[], callback: StreamCallback): void {
    const writev = this.writevOption
    if (writev == undefined) callback(methodNotImplemented("onWritev()"))
    else writev.call(this, chunks, callback)
  }

  protected onFinal(callback: StreamCallback): void {
    const final = this.finalOption
    if (final == undefined) callback()
    else final.call(this, callback)
  }

  protected onDestroy(error: StreamError | undefined, callback: StreamCallback): void {
    const destroy = this.destroyOption
    if (destroy == undefined) callback(error)
    else destroy.call(this, error, callback)
  }

  protected onConstruct(callback: StreamCallback): void {
    const construct = this.constructOption
    if (construct == undefined) callback()
    else construct.call(this, callback)
  }
}

export interface DuplexOptions<W, R> {
  allowHalfOpen?: boolean
  readable?: boolean
  writable?: boolean
  highWaterMark?: double
  readableHighWaterMark?: double
  writableHighWaterMark?: double
  objectMode?: boolean
  readableObjectMode?: boolean
  writableObjectMode?: boolean
  encoding?: BufferEncoding
  decodeStrings?: boolean
  defaultEncoding?: BufferEncoding
  emitClose?: boolean
  autoDestroy?: boolean
  signal?: AbortSignal
  read?: (this: Duplex<W, R>, size: int) => void
  write?: (this: Duplex<W, R>, chunk: W, encoding: string, callback: StreamCallback) => void
  writev?: (this: Duplex<W, R>, chunks: WriteChunk<W>[], callback: StreamCallback) => void
  final?: (this: Duplex<W, R>, callback: StreamCallback) => void
  destroy?: (this: Duplex<W, R>, error: StreamError | undefined, callback: StreamCallback) => void
  construct?: (this: Duplex<W, R>, callback: StreamCallback) => void
}

class DuplexSides {
  allowHalfOpen?: boolean
  readable?: boolean
  writable?: boolean
  highWaterMark?: double
  readableHighWaterMark?: double
  writableHighWaterMark?: double
  objectMode?: boolean
  readableObjectMode?: boolean
  writableObjectMode?: boolean
  encoding?: BufferEncoding
  decodeStrings?: boolean
  defaultEncoding?: BufferEncoding
  emitClose?: boolean
  autoDestroy?: boolean
  signal?: AbortSignal
  hasWritev = false
  hasFinal = false
  hasConstruct = false
  transform = false
}

function duplexSetup<W, R>(sides: DuplexSides): StreamSetup {
  const readableObjectMode = sides.objectMode == true || sides.readableObjectMode == true
  const writableObjectMode = sides.objectMode == true || sides.writableObjectMode == true
  const setup = new StreamSetup()
  setup.duplex = true
  setup.readable = {
    highWaterMark: sides.highWaterMark,
    sideHighWaterMark: sides.readableHighWaterMark,
    objectMode: sides.objectMode,
    sideObjectMode: sides.readableObjectMode,
    encoding: chunkEncoding(chunkKind<R>(), readableObjectMode, sides.encoding),
    defaultEncoding: sides.defaultEncoding,
    emitClose: sides.emitClose,
    autoDestroy: sides.autoDestroy,
  }
  setup.writable = {
    highWaterMark: sides.highWaterMark,
    sideHighWaterMark: sides.writableHighWaterMark,
    objectMode: sides.objectMode,
    sideObjectMode: sides.writableObjectMode,
    decodeStrings: decodesStrings(chunkKind<W>(), writableObjectMode),
    defaultEncoding: sides.defaultEncoding,
    emitClose: sides.emitClose,
    autoDestroy: sides.autoDestroy,
  }
  setup.allowHalfOpen = sides.allowHalfOpen != false
  setup.readableOff = sides.readable == false
  setup.writableOff = sides.writable == false
  setup.signal = sides.signal

  return setup
}

export class Duplex<W = Buffer, R = W> extends Readable<R> {
  private duplexRead?: (this: Duplex<W, R>, size: int) => void
  private duplexWrite?:
    (this: Duplex<W, R>, chunk: W, encoding: string, callback: StreamCallback) => void
  private duplexWritev?:
    (this: Duplex<W, R>, chunks: WriteChunk<W>[], callback: StreamCallback) => void
  private duplexFinal?: (this: Duplex<W, R>, callback: StreamCallback) => void
  private duplexDestroy?:
    (this: Duplex<W, R>, error: StreamError | undefined, callback: StreamCallback) => void
  private duplexConstruct?: (this: Duplex<W, R>, callback: StreamCallback) => void

  constructor(options?: DuplexOptions<W, R>) {
    const given = pendingSides
    if (given == undefined) pendingSides = new DuplexSides()
    super()
    pendingSides = undefined
    this.duplexRead = options?.read
    this.duplexWrite = options?.write
    this.duplexWritev = options?.writev
    this.duplexFinal = options?.final
    this.duplexDestroy = options?.destroy
    this.duplexConstruct = options?.construct
    if (given != undefined) return
    const sides = new DuplexSides()
    sides.allowHalfOpen = options?.allowHalfOpen
    sides.readable = options?.readable
    sides.writable = options?.writable
    sides.highWaterMark = options?.highWaterMark
    sides.readableHighWaterMark = options?.readableHighWaterMark
    sides.writableHighWaterMark = options?.writableHighWaterMark
    sides.objectMode = options?.objectMode
    sides.readableObjectMode = options?.readableObjectMode
    sides.writableObjectMode = options?.writableObjectMode
    sides.encoding = options?.encoding
    sides.decodeStrings = options?.decodeStrings
    sides.defaultEncoding = options?.defaultEncoding
    sides.emitClose = options?.emitClose
    sides.autoDestroy = options?.autoDestroy
    sides.signal = options?.signal
    const setup = duplexSetup<W, R>(sides)
    setup.hasWritev = options?.writev != undefined || overrides(this, "onWritev")
    setup.hasFinal = options?.final != undefined || overrides(this, "onFinal")
    setup.hasConstruct = options?.construct != undefined || overrides(this, "onConstruct")
    this.setUp(setup)
  }

  protected onRead(size: int): void {
    const read = this.duplexRead
    if (read == undefined) super.onRead(size)
    else read.call(this, size)
  }

  protected writeChunk(chunk: unknown, encoding: string, callback: StreamCallback): void {
    this.onWrite(chunkOf<W>(chunk), encoding, callback)
  }

  protected writevChunks(chunks: BufferedWrite[], callback: StreamCallback): void {
    this.onWritev(typedChunks<W>(chunks), callback)
  }

  protected onWrite(chunk: W, encoding: string, callback: StreamCallback): void {
    const write = this.duplexWrite
    if (write != undefined) write.call(this, chunk, encoding, callback)
    else if (this.duplexWritev != undefined || overrides(this, "onWritev"))
      this.onWritev([{ chunk, encoding }], callback)
    else callback(methodNotImplemented("onWrite()"))
  }

  protected onWritev(chunks: WriteChunk<W>[], callback: StreamCallback): void {
    const writev = this.duplexWritev
    if (writev == undefined) callback(methodNotImplemented("onWritev()"))
    else writev.call(this, chunks, callback)
  }

  protected onFinal(callback: StreamCallback): void {
    const final = this.duplexFinal
    if (final == undefined) callback()
    else final.call(this, callback)
  }

  protected onDestroy(error: StreamError | undefined, callback: StreamCallback): void {
    const destroy = this.duplexDestroy
    if (destroy == undefined) callback(error)
    else destroy.call(this, error, callback)
  }

  protected onConstruct(callback: StreamCallback): void {
    const construct = this.duplexConstruct
    if (construct == undefined) callback()
    else construct.call(this, callback)
  }
}

export interface TransformOptions<W, R> {
  allowHalfOpen?: boolean
  readable?: boolean
  writable?: boolean
  highWaterMark?: double
  readableHighWaterMark?: double
  writableHighWaterMark?: double
  objectMode?: boolean
  readableObjectMode?: boolean
  writableObjectMode?: boolean
  encoding?: BufferEncoding
  decodeStrings?: boolean
  defaultEncoding?: BufferEncoding
  emitClose?: boolean
  autoDestroy?: boolean
  signal?: AbortSignal
  read?: (this: Transform<W, R>, size: int) => void
  write?: (this: Transform<W, R>, chunk: W, encoding: string, callback: StreamCallback) => void
  writev?: (this: Transform<W, R>, chunks: WriteChunk<W>[], callback: StreamCallback) => void
  final?: (this: Transform<W, R>, callback: StreamCallback) => void
  destroy?: (this: Transform<W, R>, error: StreamError | undefined, callback: StreamCallback) => void
  construct?: (this: Transform<W, R>, callback: StreamCallback) => void
  transform?: (this: Transform<W, R>, chunk: W, encoding: string,
               callback: TransformCallback) => void
  flush?: (this: Transform<W, R>, callback: TransformCallback) => void
}

function transformSides<W, R>(options: TransformOptions<W, R> | undefined): DuplexSides {
  const sides = new DuplexSides()
  const hwm = options?.highWaterMark ?? options?.readableHighWaterMark
  const zero = hwm == 0
  sides.allowHalfOpen = options?.allowHalfOpen
  sides.readable = options?.readable
  sides.writable = options?.writable
  sides.highWaterMark = zero ? undefined : options?.highWaterMark
  sides.readableHighWaterMark = zero ? 0 : options?.readableHighWaterMark
  sides.writableHighWaterMark = zero
    ? options?.writableHighWaterMark ?? 0
    : options?.writableHighWaterMark
  sides.objectMode = options?.objectMode
  sides.readableObjectMode = options?.readableObjectMode
  sides.writableObjectMode = options?.writableObjectMode
  sides.encoding = options?.encoding
  sides.decodeStrings = options?.decodeStrings
  sides.defaultEncoding = options?.defaultEncoding
  sides.emitClose = options?.emitClose
  sides.autoDestroy = options?.autoDestroy
  sides.signal = options?.signal
  sides.transform = true
  return sides
}

export class Transform<W = Buffer, R = W> extends Duplex<W, R> {
  private transformRead?: (this: Transform<W, R>, size: int) => void
  private transformWrite?:
    (this: Transform<W, R>, chunk: W, encoding: string, callback: StreamCallback) => void
  private transformWritev?:
    (this: Transform<W, R>, chunks: WriteChunk<W>[], callback: StreamCallback) => void
  private transformFinal?: (this: Transform<W, R>, callback: StreamCallback) => void
  private transformDestroy?:
    (this: Transform<W, R>, error: StreamError | undefined, callback: StreamCallback) => void
  private transformConstruct?: (this: Transform<W, R>, callback: StreamCallback) => void
  private transformOption?:
    (this: Transform<W, R>, chunk: W, encoding: string, callback: TransformCallback) => void
  private flushOption?: (this: Transform<W, R>, callback: TransformCallback) => void

  constructor(options?: TransformOptions<W, R>) {
    const sides = transformSides(options)
    pendingSides = sides
    super()
    this.transformRead = options?.read
    this.transformWrite = options?.write
    this.transformWritev = options?.writev
    this.transformFinal = options?.final
    this.transformDestroy = options?.destroy
    this.transformConstruct = options?.construct
    this.transformOption = options?.transform
    this.flushOption = options?.flush
    const setup = duplexSetup<W, R>(sides)
    setup.transform = true
    setup.hasWritev = options?.writev != undefined || overrides(this, "onWritev")
    setup.hasFinal = true
    setup.hasConstruct = options?.construct != undefined || overrides(this, "onConstruct")
    setup.hasFlush = options?.flush != undefined || overrides(this, "onFlush")
    setup.transformsWrites = options?.write == undefined && !overrides(this, "onWrite")
    setup.transformsFinal = options?.final == undefined && !overrides(this, "onFinal")
    this.setUp(setup)
  }

  protected onRead(size: int): void {
    const read = this.transformRead
    if (read == undefined) super.onRead(size)
    else read.call(this, size)
  }

  protected onWrite(chunk: W, encoding: string, callback: StreamCallback): void {
    const write = this.transformWrite
    if (write == undefined) callback(methodNotImplemented("onWrite()"))
    else write.call(this, chunk, encoding, callback)
  }

  protected onWritev(chunks: WriteChunk<W>[], callback: StreamCallback): void {
    const writev = this.transformWritev
    if (writev == undefined) callback(methodNotImplemented("onWritev()"))
    else writev.call(this, chunks, callback)
  }

  protected onFinal(callback: StreamCallback): void {
    const final = this.transformFinal
    if (final == undefined) callback()
    else final.call(this, callback)
  }

  protected onDestroy(error: StreamError | undefined, callback: StreamCallback): void {
    const destroy = this.transformDestroy
    if (destroy == undefined) callback(error)
    else destroy.call(this, error, callback)
  }

  protected onConstruct(callback: StreamCallback): void {
    const construct = this.transformConstruct
    if (construct == undefined) callback()
    else construct.call(this, callback)
  }

  protected transformChunk(chunk: unknown, encoding: string, callback: TransformCallback): void {
    this.onTransform(chunkOf<W>(chunk), encoding, callback)
  }

  protected onTransform(chunk: W, encoding: string, callback: TransformCallback): void {
    const transform = this.transformOption
    if (transform == undefined) callback(methodNotImplemented("onTransform()"))
    else transform.call(this, chunk, encoding, callback)
  }

  protected onFlush(callback: TransformCallback): void {
    const flush = this.flushOption
    if (flush == undefined) callback()
    else flush.call(this, callback)
  }
}

export class PassThrough<W = Buffer, R = W> extends Transform<W, R> {
  constructor(options?: TransformOptions<W, R>) {
    super(options)
  }

  protected onTransform(chunk: W, encoding: string, callback: TransformCallback): void {
    void encoding
    callback(undefined, chunk)
  }
}

export interface ReadableFromOptions {
  objectMode?: boolean
  highWaterMark?: double
  encoding?: BufferEncoding
  emitClose?: boolean
  autoDestroy?: boolean
  signal?: AbortSignal
}

function fromOptions<U>(options: ReadableFromOptions | undefined, hwm: double | undefined):
    ReadableOptions<U> {
  return {
    objectMode: options?.objectMode ?? true,
    highWaterMark: options?.highWaterMark ?? hwm,
    encoding: options?.encoding,
    emitClose: options?.emitClose,
    autoDestroy: options?.autoDestroy,
    signal: options?.signal,
  }
}

export function streamFromValue<U>(value: U, options?: ReadableFromOptions): Readable<U> {
  return new FromValue<U>(value, fromOptions<U>(options, undefined))
}

class FromValue<U> extends Readable<U> {
  private value?: U
  constructor(value: U, options: ReadableOptions<U>) {
    super(options)
    this.value = value
  }

  protected onRead(size: int): void {
    void size
    const value = this.value
    this.value = undefined
    if (value != undefined) this.pushChunk(value)
    this.pushChunk(undefined)
  }
}

export function streamFromIterator<U>(iterator: Iterator<U>, options?: ReadableFromOptions):
    Readable<U> {
  return new FromIterator<U>(iterator, fromOptions<U>(options, 1))
}

class FromIterator<U> extends Readable<U> {
  private source: Iterator<U>
  private reading = false
  constructor(iterator: Iterator<U>, options: ReadableOptions<U>) {
    super(options)
    this.source = iterator
  }

  protected onRead(size: int): void {
    void size
    if (!this.reading) {
      this.reading = true
      this.next()
    }
  }

  private next() {
    for (;;) {
      const result = this.source.next()
      if (result.done) {
        this.pushChunk(undefined)
        return
      }
      const value: unknown = result.value
      if (value == undefined) {
        this.reading = false
        this.destroy(nullValues())
        return
      }
      if (this.pushChunk(value)) continue
      this.reading = false
      return
    }
  }
}

export function streamFromAsyncIterator<U>(iterator: AsyncIterator<U>,
                                           options?: ReadableFromOptions): Readable<U> {
  return new FromAsyncIterator<U>(iterator, fromOptions<U>(options, 1))
}

class FromAsyncIterator<U> extends Readable<U> {
  private source: AsyncIterator<U>
  private started = false
  private wake?: () => void
  constructor(iterator: AsyncIterator<U>, options: ReadableOptions<U>) {
    super(options)
    this.source = iterator
  }

  protected onRead(size: int): void {
    void size
    if (!this.started) {
      this.started = true
      void this.pump()
      return
    }
    this.resumeNext()
  }

  private resumeNext() {
    const wake = this.wake
    this.wake = undefined
    if (wake != undefined) wake()
  }

  private async pump() {
    for await (const value of this.source) {
      const chunk: unknown = value
      if (chunk == undefined) {
        this.destroy(nullValues())
        return
      }
      if (!this.pushChunk(chunk))
        await new Promise<void>((resolve) => {
          this.wake = resolve
        })
      if (this.destroyed) return
    }
    this.pushChunk(undefined)
  }

  protected onDestroy(error: StreamError | undefined, callback: StreamCallback): void {
    this.resumeNext()
    process.nextTick(() => callback(error))
  }
}
