export type StreamEvents<T> = {
  close: []
  data: [chunk: T]
  end: []
  error: [err: StreamFault]
  pause: []
  readable: []
  resume: []
  drain: []
  finish: []
  prefinish: []
  pipe: [src: Stream]
  unpipe: [src: Stream, info: { hasUnpiped: boolean }]
  open: [fd: int]
  ready: []
}

export class StreamEmitter<Events> extends Stream {}

let pendingSides: DuplexSides | undefined = undefined

const kStringChunks = 1

export interface ReadableOptions {
  highWaterMark?: double
  encoding?: BufferEncoding
  objectMode?: boolean
  emitClose?: boolean
  autoDestroy?: boolean
}

function chunkEncoding(kind: int, objectMode: boolean,
                       encoding: BufferEncoding | undefined): BufferEncoding | undefined {
  if (objectMode || kind != kStringChunks) return encoding
  return encoding ?? "utf8"
}

function backFault(back: StreamError | undefined, given: StreamFault | undefined): StreamFault | undefined {
  if (back == undefined) return undefined
  if (given != undefined && back == given) return given
  return faultOf(back)
}

export abstract class Readable<T = Buffer, E extends StreamError = StreamError>
    extends StreamEmitter<StreamEvents<T>> {
  private failure?: E

  constructor(options?: ReadableOptions) {
    super()
    if (pendingSides != undefined) return
    const setup = new StreamSetup()
    setup.readable = {
      highWaterMark: options?.highWaterMark,
      objectMode: options?.objectMode,
      encoding: chunkEncoding(chunkKind<T>(), options?.objectMode ?? false, options?.encoding),
      emitClose: options?.emitClose,
      autoDestroy: options?.autoDestroy,
    }
    setup.hasConstruct = overrides(this, "onConstruct")
    this.setUp(setup)
  }

  protected abstract onRead(size: int): void

  protected onConstruct(callback: HookCallback<E>): void {
    callback()
  }

  protected onDestroy(error: StreamError | undefined, callback: StreamCallback): void {
    callback(error)
  }

  protected destroy(error: E): void {
    this.noteError(error)
    this.breakWith(error)
  }

  protected noteError(error: E): void {
    if (this.failure == undefined) this.failure = error
  }

  protected faultFrom(error: E): StreamFault {
    this.noteError(error)
    return faultOf(error)
  }

  protected readFault(fault: StreamFault): E | PrematureCloseError | PushAfterEndError {
    return readError<E>(this.failure, fault)
  }

  protected writeFaultOf(fault: StreamFault):
      E | PrematureCloseError | WriteAfterEndError | WriteAfterDestroyError | AlreadyEndedError |
      CallbackTwiceError {
    return writeError<E>(this.failure, fault)
  }

  protected requestChunks(size: int): void {
    this.onRead(size)
  }

  protected constructHook(callback: FaultCallback): void {
    this.onConstruct((error?: E) => callback(error == undefined ? undefined : this.faultFrom(error)))
  }

  protected destroyHook(error: StreamFault | undefined, callback: FaultCallback): void {
    this.onDestroy(error, (back?: StreamError) => callback(backFault(back, error)))
  }

  protected emitData(chunk: unknown): void {
    if (this.readableObjectMode()) this.emitWithUnknown("data", chunk, chunkOf<T>(chunk))
    else if (typeof chunk == "string") this.emitWithUnknown("data", chunk, chunk)
    else this.emitWithUnknown("data", chunk, chunkOf<Buffer>(chunk))
  }

  protected pushChunk(chunk: unknown, encoding?: string): boolean {
    if (chunk != undefined && this.readableObjectMode() && !isChunk<T>(chunk)) {
      this.breakWith(invalidChunk(chunk))
      return false
    }
    return super.pushChunk(chunk, encoding)
  }

  pushEnd(): void {
    this.pushChunk(undefined)
  }

  read(size?: int): T | undefined {
    const chunk = this.readChunk(size)
    return chunk == undefined ? undefined : chunkOf<T>(chunk)
  }

  errored(): E | PrematureCloseError | PushAfterEndError | undefined {
    const fault = this.fault()
    if (fault == undefined) return undefined
    return this.readFault(fault)
  }

  [Symbol.asyncIterator](): AsyncGenerator<Result<T, E | PrematureCloseError | PushAfterEndError>> {
    return this.iterate<T, E | PrematureCloseError | PushAfterEndError>(
      true, (fault: StreamFault) => this.readFault(fault))
  }

  iterator(options?: { destroyOnReturn?: boolean }):
      AsyncGenerator<Result<T, E | PrematureCloseError | PushAfterEndError>> {
    return this.iterate<T, E | PrematureCloseError | PushAfterEndError>(
      options?.destroyOnReturn ?? true, (fault: StreamFault) => this.readFault(fault))
  }
}

export interface WriteChunk<T> {
  chunk: T
  encoding: string
}

export interface WritableOptions {
  highWaterMark?: double
  decodeStrings?: boolean
  defaultEncoding?: BufferEncoding
  objectMode?: boolean
  emitClose?: boolean
  autoDestroy?: boolean
}

function typedChunks<T>(chunks: BufferedWrite[]): WriteChunk<T>[] {
  const out: WriteChunk<T>[] = []
  for (const c of chunks) out.push({ chunk: chunkOf<T>(c.chunk), encoding: c.encoding })
  return out
}

function decodesStrings(kind: int, objectMode: boolean) {
  return objectMode || kind != kStringChunks
}

export abstract class Writable<T = Buffer, E extends StreamError = StreamError>
    extends StreamEmitter<StreamEvents<T>> {
  private failure?: E

  constructor(options?: WritableOptions) {
    super()
    const setup = new StreamSetup()
    setup.writable = {
      highWaterMark: options?.highWaterMark,
      objectMode: options?.objectMode,
      decodeStrings: decodesStrings(chunkKind<T>(), options?.objectMode ?? false),
      defaultEncoding: options?.defaultEncoding,
      emitClose: options?.emitClose,
      autoDestroy: options?.autoDestroy,
    }
    setup.hasWritev = overrides(this, "onWritev")
    setup.hasFinal = overrides(this, "onFinal")
    setup.hasConstruct = overrides(this, "onConstruct")
    this.setUp(setup)
  }

  protected abstract onWrite(chunk: T, encoding: string, callback: HookCallback<E>): void

  protected onWritev(chunks: WriteChunk<T>[], callback: HookCallback<E>): void {
    void chunks
    callback()
  }

  protected onFinal(callback: HookCallback<E>): void {
    callback()
  }

  protected onConstruct(callback: HookCallback<E>): void {
    callback()
  }

  protected onDestroy(error: StreamError | undefined, callback: StreamCallback): void {
    callback(error)
  }

  protected destroy(error: E): void {
    this.noteError(error)
    this.breakWith(error)
  }

  protected noteError(error: E): void {
    if (this.failure == undefined) this.failure = error
  }

  protected faultFrom(error: E): StreamFault {
    this.noteError(error)
    return faultOf(error)
  }

  protected writeChunk(chunk: unknown, encoding: string, callback: FaultCallback): void {
    this.onWrite(chunkOf<T>(chunk), encoding,
                 (error?: E) => callback(error == undefined ? undefined : this.faultFrom(error)))
  }

  protected writevChunks(chunks: BufferedWrite[], callback: FaultCallback): void {
    this.onWritev(typedChunks<T>(chunks),
                  (error?: E) => callback(error == undefined ? undefined : this.faultFrom(error)))
  }

  protected finalHook(callback: FaultCallback): void {
    this.onFinal((error?: E) => callback(error == undefined ? undefined : this.faultFrom(error)))
  }

  protected constructHook(callback: FaultCallback): void {
    this.onConstruct((error?: E) => callback(error == undefined ? undefined : this.faultFrom(error)))
  }

  protected destroyHook(error: StreamFault | undefined, callback: FaultCallback): void {
    this.onDestroy(error, (back?: StreamError) => callback(backFault(back, error)))
  }

  errored():
      E | PrematureCloseError | WriteAfterEndError | WriteAfterDestroyError | AlreadyEndedError |
      CallbackTwiceError | undefined {
    const fault = this.fault()
    if (fault == undefined) return undefined
    return writeError<E>(this.failure, fault)
  }

  private writeTyped(
    chunk: unknown,
    encoding: string | undefined,
    cb: ((error?: E | PrematureCloseError | WriteAfterEndError | WriteAfterDestroyError |
          AlreadyEndedError | CallbackTwiceError) => void) | undefined,
  ): boolean {
    if (cb == undefined) return this.writeFault(chunk, encoding, undefined)
    const done = cb
    return this.writeFault(chunk, encoding, (fault?: StreamFault) =>
      done(fault == undefined ? undefined : writeError<E>(this.failure, fault)))
  }

  private endTyped(
    hasChunk: boolean,
    chunk: unknown,
    encoding: string | undefined,
  ): Promise<Result<void, E | PrematureCloseError | WriteAfterEndError | WriteAfterDestroyError |
                         AlreadyEndedError | CallbackTwiceError>> {
    return this.endFault(hasChunk, chunk, encoding).then((ended) => {
      if (ended.isErr()) return err(writeError<E>(this.failure, ended.error))
      return ok()
    })
  }
}

export interface DuplexOptions {
  allowHalfOpen?: boolean
  readable?: boolean
  writable?: boolean
  highWaterMark?: double
  readableHighWaterMark?: double
  writableHighWaterMark?: double
  objectMode?: boolean
  readableObjectMode?: boolean
  writableObjectMode?: boolean
  encoding?: BufferEncoding
  decodeStrings?: boolean
  defaultEncoding?: BufferEncoding
  emitClose?: boolean
  autoDestroy?: boolean
}

class DuplexSides {
  allowHalfOpen?: boolean
  readable?: boolean
  writable?: boolean
  highWaterMark?: double
  readableHighWaterMark?: double
  writableHighWaterMark?: double
  objectMode?: boolean
  readableObjectMode?: boolean
  writableObjectMode?: boolean
  encoding?: BufferEncoding
  decodeStrings?: boolean
  defaultEncoding?: BufferEncoding
  emitClose?: boolean
  autoDestroy?: boolean
  hasWritev = false
  hasFinal = false
  hasConstruct = false
  transform = false
}

function duplexSetup<W, R>(sides: DuplexSides): StreamSetup {
  const readableObjectMode = sides.objectMode == true || sides.readableObjectMode == true
  const writableObjectMode = sides.objectMode == true || sides.writableObjectMode == true
  const setup = new StreamSetup()
  setup.duplex = true
  setup.readable = {
    highWaterMark: sides.highWaterMark,
    sideHighWaterMark: sides.readableHighWaterMark,
    objectMode: sides.objectMode,
    sideObjectMode: sides.readableObjectMode,
    encoding: chunkEncoding(chunkKind<R>(), readableObjectMode, sides.encoding),
    defaultEncoding: sides.defaultEncoding,
    emitClose: sides.emitClose,
    autoDestroy: sides.autoDestroy,
  }
  setup.writable = {
    highWaterMark: sides.highWaterMark,
    sideHighWaterMark: sides.writableHighWaterMark,
    objectMode: sides.objectMode,
    sideObjectMode: sides.writableObjectMode,
    decodeStrings: decodesStrings(chunkKind<W>(), writableObjectMode),
    defaultEncoding: sides.defaultEncoding,
    emitClose: sides.emitClose,
    autoDestroy: sides.autoDestroy,
  }
  setup.allowHalfOpen = sides.allowHalfOpen != false
  setup.readableOff = sides.readable == false
  setup.writableOff = sides.writable == false

  return setup
}

function duplexSides(options: DuplexOptions | undefined): DuplexSides {
  const sides = new DuplexSides()
  sides.allowHalfOpen = options?.allowHalfOpen
  sides.readable = options?.readable
  sides.writable = options?.writable
  sides.highWaterMark = options?.highWaterMark
  sides.readableHighWaterMark = options?.readableHighWaterMark
  sides.writableHighWaterMark = options?.writableHighWaterMark
  sides.objectMode = options?.objectMode
  sides.readableObjectMode = options?.readableObjectMode
  sides.writableObjectMode = options?.writableObjectMode
  sides.encoding = options?.encoding
  sides.decodeStrings = options?.decodeStrings
  sides.defaultEncoding = options?.defaultEncoding
  sides.emitClose = options?.emitClose
  sides.autoDestroy = options?.autoDestroy
  return sides
}

export abstract class Duplex<W = Buffer, R = W, E extends StreamError = StreamError>
    extends Readable<R, E> {
  constructor(options?: DuplexOptions) {
    const given = pendingSides
    if (given == undefined) pendingSides = new DuplexSides()
    super()
    pendingSides = undefined
    if (given != undefined) return
    const setup = duplexSetup<W, R>(duplexSides(options))
    setup.hasWritev = overrides(this, "onWritev")
    setup.hasFinal = overrides(this, "onFinal")
    setup.hasConstruct = overrides(this, "onConstruct")
    this.setUp(setup)
  }

  protected abstract onWrite(chunk: W, encoding: string, callback: HookCallback<E>): void

  protected onWritev(chunks: WriteChunk<W>[], callback: HookCallback<E>): void {
    void chunks
    callback()
  }

  protected onFinal(callback: HookCallback<E>): void {
    callback()
  }

  protected writeChunk(chunk: unknown, encoding: string, callback: FaultCallback): void {
    this.onWrite(chunkOf<W>(chunk), encoding,
                 (error?: E) => callback(error == undefined ? undefined : this.faultFrom(error)))
  }

  protected writevChunks(chunks: BufferedWrite[], callback: FaultCallback): void {
    this.onWritev(typedChunks<W>(chunks),
                  (error?: E) => callback(error == undefined ? undefined : this.faultFrom(error)))
  }

  protected finalHook(callback: FaultCallback): void {
    this.onFinal((error?: E) => callback(error == undefined ? undefined : this.faultFrom(error)))
  }

  private writeTyped(
    chunk: unknown,
    encoding: string | undefined,
    cb: ((error?: E | PrematureCloseError | WriteAfterEndError | WriteAfterDestroyError |
          AlreadyEndedError | CallbackTwiceError) => void) | undefined,
  ): boolean {
    if (cb == undefined) return this.writeFault(chunk, encoding, undefined)
    const done = cb
    return this.writeFault(chunk, encoding, (fault?: StreamFault) =>
      done(fault == undefined ? undefined : this.writeFaultOf(fault)))
  }

  private endTyped(
    hasChunk: boolean,
    chunk: unknown,
    encoding: string | undefined,
  ): Promise<Result<void, E | PrematureCloseError | WriteAfterEndError | WriteAfterDestroyError |
                         AlreadyEndedError | CallbackTwiceError>> {
    return this.endFault(hasChunk, chunk, encoding).then((ended) => {
      if (ended.isErr()) return err(this.writeFaultOf(ended.error))
      return ok()
    })
  }
}

export interface TransformOptions {
  allowHalfOpen?: boolean
  readable?: boolean
  writable?: boolean
  highWaterMark?: double
  readableHighWaterMark?: double
  writableHighWaterMark?: double
  objectMode?: boolean
  readableObjectMode?: boolean
  writableObjectMode?: boolean
  encoding?: BufferEncoding
  decodeStrings?: boolean
  defaultEncoding?: BufferEncoding
  emitClose?: boolean
  autoDestroy?: boolean
}

function transformSides(options: TransformOptions | undefined): DuplexSides {
  const sides = duplexSides(options)
  const hwm = options?.highWaterMark ?? options?.readableHighWaterMark
  const zero = hwm == 0
  sides.highWaterMark = zero ? undefined : options?.highWaterMark
  sides.readableHighWaterMark = zero ? 0 : options?.readableHighWaterMark
  sides.writableHighWaterMark = zero
    ? options?.writableHighWaterMark ?? 0
    : options?.writableHighWaterMark
  sides.transform = true
  return sides
}

export abstract class Transform<W = Buffer, R = W, E extends StreamError = StreamError>
    extends Duplex<W, R, E> {
  constructor(options?: TransformOptions) {
    const sides = transformSides(options)
    pendingSides = sides
    super()
    const setup = duplexSetup<W, R>(sides)
    setup.transform = true
    setup.hasWritev = overrides(this, "onWritev")
    setup.hasFinal = true
    setup.hasConstruct = overrides(this, "onConstruct")
    setup.hasFlush = overrides(this, "onFlush")
    setup.transformsWrites = !overrides(this, "onWrite")
    setup.transformsFinal = !overrides(this, "onFinal")
    this.setUp(setup)
  }

  protected abstract onTransform(chunk: W, encoding: string,
                                 callback: TransformHookCallback<E>): void

  protected onFlush(callback: TransformHookCallback<E>): void {
    callback()
  }

  protected onRead(size: int): void {
    this.pullTransformed(size)
  }

  protected onWrite(chunk: W, encoding: string, callback: HookCallback<E>): void {
    void chunk
    void encoding
    callback()
  }

  protected transformChunk(chunk: unknown, encoding: string, callback: FaultTransformCallback): void {
    this.onTransform(chunkOf<W>(chunk), encoding, (error?: E, data?: unknown) =>
      callback(error == undefined ? undefined : this.faultFrom(error), data))
  }

  protected flushHook(callback: FaultTransformCallback): void {
    this.onFlush((error?: E, data?: unknown) =>
      callback(error == undefined ? undefined : this.faultFrom(error), data))
  }
}

export class PassThrough<W = Buffer, R = W> extends Transform<W, R> {
  constructor(options?: TransformOptions) {
    super(options)
  }

  protected onTransform(chunk: W, encoding: string,
                        callback: TransformHookCallback<StreamError>): void {
    void encoding
    callback(undefined, chunk)
  }
}

export interface ReadableFromOptions {
  objectMode?: boolean
  highWaterMark?: double
  encoding?: BufferEncoding
  emitClose?: boolean
  autoDestroy?: boolean
}

function fromOptions(options: ReadableFromOptions | undefined, hwm: double | undefined):
    ReadableOptions {
  return {
    objectMode: options?.objectMode ?? true,
    highWaterMark: options?.highWaterMark ?? hwm,
    encoding: options?.encoding,
    emitClose: options?.emitClose,
    autoDestroy: options?.autoDestroy,
  }
}

export function streamFromValue<U>(value: U, options?: ReadableFromOptions): Readable<U> {
  return new FromValue<U>(value, fromOptions(options, undefined))
}

class FromValue<U> extends Readable<U> {
  private value?: U
  constructor(value: U, options: ReadableOptions) {
    super(options)
    this.value = value
  }

  protected onRead(size: int): void {
    void size
    const value = this.value
    this.value = undefined
    if (value != undefined) this.pushChunk(value)
    this.pushChunk(undefined)
  }
}

export function streamFromIterator<U>(iterator: Iterator<U>, options?: ReadableFromOptions):
    Readable<U> {
  return new FromIterator<U>(iterator, fromOptions(options, 1))
}

class FromIterator<U> extends Readable<U> {
  private source: Iterator<U>
  private reading = false
  constructor(iterator: Iterator<U>, options: ReadableOptions) {
    super(options)
    this.source = iterator
  }

  protected onRead(size: int): void {
    void size
    if (!this.reading) {
      this.reading = true
      this.next()
    }
  }

  private next() {
    for (;;) {
      const result = this.source.next()
      if (result.done) {
        this.pushChunk(undefined)
        return
      }
      const value: unknown = result.value
      if (value == undefined) {
        this.reading = false
        this.breakWith(nullValues())
        return
      }
      if (this.pushChunk(value)) continue
      this.reading = false
      return
    }
  }
}

export function streamFromAsyncIterator<U>(iterator: AsyncIterator<U>,
                                           options?: ReadableFromOptions): Readable<U> {
  return new FromAsyncIterator<U>(iterator, fromOptions(options, 1))
}

class FromAsyncIterator<U> extends Readable<U> {
  private source: AsyncIterator<U>
  private started = false
  private wake?: () => void
  constructor(iterator: AsyncIterator<U>, options: ReadableOptions) {
    super(options)
    this.source = iterator
  }

  protected onRead(size: int): void {
    void size
    if (!this.started) {
      this.started = true
      void this.pump()
      return
    }
    this.resumeNext()
  }

  private resumeNext() {
    const wake = this.wake
    this.wake = undefined
    if (wake != undefined) wake()
  }

  private async pump() {
    for await (const value of this.source) {
      const chunk: unknown = value
      if (chunk == undefined) {
        this.breakWith(nullValues())
        return
      }
      if (!this.pushChunk(chunk))
        await new Promise<void>((resolve) => {
          this.wake = resolve
        })
      if (this.destroyed()) return
    }
    this.pushChunk(undefined)
  }

  protected onDestroy(error: StreamError | undefined, callback: StreamCallback): void {
    this.resumeNext()
    process.nextTick(() => callback(error))
  }
}
