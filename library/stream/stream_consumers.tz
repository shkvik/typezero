import { Readable } from "node:stream";
import { StringDecoder } from "node:string_decoder";
import { chunkOf } from "tz:intrinsics";

export async function text<T>(
  stream: Readable<T>,
): Promise<Result<string, StreamError>> {
  const dec = new StringDecoder("utf8");
  let str = "";
  for await (const item of stream) {
    if (item.isErr()) return err(item.error);
    const chunk: unknown = item.value;
    if (typeof chunk == "string") str += chunk;
    else str += dec.write(chunkOf<Buffer>(chunk));
  }
  str += dec.end();
  return ok(str);
}

export async function json<T>(
  stream: Readable<T>,
): Promise<Result<Json, StreamError | JsonError>> {
  const content = await text<T>(stream);
  if (content.isErr()) return err(content.error);
  const parsed = JSON.parse(content.value);
  if (parsed.isErr()) return err(parsed.error);
  return ok(parsed.value);
}

export async function buffer<T>(
  stream: Readable<T>,
): Promise<Result<Buffer, StreamError>> {
  const chunks: Buffer[] = [];
  for await (const item of stream) {
    if (item.isErr()) return err(item.error);
    const chunk: unknown = item.value;
    if (typeof chunk == "string") chunks.push(Buffer.from(chunk));
    else chunks.push(chunkOf<Buffer>(chunk));
  }
  return ok(Buffer.concat(chunks));
}

export async function arrayBuffer<T>(
  stream: Readable<T>,
): Promise<Result<ArrayBuffer, StreamError>> {
  const all = await buffer<T>(stream);
  if (all.isErr()) return err(all.error);
  const copy = new Uint8Array(all.value.length);
  copy.set(all.value);
  return ok(copy.buffer);
}
