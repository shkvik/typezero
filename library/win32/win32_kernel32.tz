@InPlace({ layout: Layout.C })
export class StartupInfo {
  public size: uint32;
  public reserved: Raw<uint8>;
  public desktop: Raw<uint8>;
  public title: Raw<uint8>;
  public x: uint32;
  public y: uint32;
  public width: uint32;
  public height: uint32;
  public columns: uint32;
  public rows: uint32;
  public fill: uint32;
  public flags: uint32;
  public showWindow: uint16;
  public reservedSize: uint16;
  public reservedBlock: Raw<uint8>;
  public input: Raw<uint8>;
  public output: Raw<uint8>;
  public errors: Raw<uint8>;
  public attributes: Raw<uint8>;
}

@InPlace({ layout: Layout.C })
export class ProcessInformation {
  public process: Raw<uint8>;
  public thread: Raw<uint8>;
  public processId: uint32;
  public threadId: uint32;
}

