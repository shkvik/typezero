import { wstring } from "tz:ffi";
import { Raw } from "tz:unsafe";

@InPlace({ layout: Layout.C })
export class FileAttributeData {
  public attributes: uint32;
  public createdLow: uint32;
  public createdHigh: uint32;
  public accessedLow: uint32;
  public accessedHigh: uint32;
  public writtenLow: uint32;
  public writtenHigh: uint32;
  public sizeHigh: uint32;
  public sizeLow: uint32;
}

export declare function GetFileAttributesExW(
  name: Read<wstring>,
  level: int32,
  data: FileAttributeData,
): int32;

export declare function GetCurrentDirectoryW(
  size: uint32,
  buffer: Raw<uint16>,
): uint32;

export declare function GetEnvironmentVariableW(
  name: Read<wstring>,
  buffer: Raw<uint16>,
  size: uint32,
): uint32;

export declare function GetLastError(): uint32;

export declare function SetLastError(code: uint32): void;

@InPlace({ layout: Layout.C })
export class LargeInteger {
  public value: int;
}

@InPlace({ layout: Layout.C })
export class FileTime {
