/** What `toJSON` of a Buffer gives. */
export type BufferJson = { type: string; data: int[] };

/**
 * Bytes as node has them: a `Uint8Array` with the methods of node, and what
 * the node API gives where it reads bytes. It is made by `Buffer.from` and
 * `Buffer.alloc`, never by `new`. The methods that give the array itself or
 * a new one of the same kind give a Buffer; `toReversed`, `toSorted` and
 * `with` give a `Uint8Array`. There is no `slice`: in node it shares the
 * memory, unlike `slice` of a `Uint8Array`; `subarray` shares it, and
 * `Buffer.from(b.subarray(start, end))` copies.
 *
 * An offset and a length must be proven to be inside the Buffer, and a
 * number written to fit its bytes. A method that reads or writes a number
 * of several bytes ends in `LE`, the lowest byte first, or `BE`, the
 * highest byte first. `UInt` and `Uint` in a name are the same.
 */
export declare class Buffer<B = ArrayBuffer> extends Uint8Array {
  /** There is no `new Buffer(…)`: `Buffer.from` or `Buffer.alloc` makes one. */
  private constructor();

  public fill(value: uint8, start?: int, end?: int): Buffer;
  /** Fills with a number, with the bytes of a text or with other bytes. */
  public fill(
    value: int | string | Uint8Array,
    start?: int,
    end?: int,
    encoding?: BufferEncoding,
  ): Buffer;
  /** The encoding in place of `start` or of `end`: to the end of the bytes. */
  public fill(value: string, encoding: BufferEncoding): Buffer;
  public fill(value: string, start: int, encoding: BufferEncoding): Buffer;
  public copyWithin(target: int, start: int, end?: int): Buffer;
  public sort(compare?: (first: uint8, second: uint8) => int | double): Buffer;
  public reverse(): Buffer;
  /** A Buffer that looks into the same memory from `start` to `end`. */
  public subarray(start?: int, end?: int): Read<Buffer>;
  /**
   * Cuts `count` bytes off the start, in place and without a copy.
   * @example buffered.advance(size)
   */
  public advance(count: int): void;
  public map(change: (item: uint8, index: int, all: Buffer) => uint8): Buffer;
  public filter(
    keep: (item: uint8, index: int, all: Buffer) => boolean,
  ): Buffer;

  /**
   * The bytes from `start` up to `end` as text in the encoding, "utf8" by
   * default.
   * @example Buffer.from("Hi").toString("hex") // "4869"
   */
  public toString(encoding?: BufferEncoding, start?: int, end?: int): string;
  /** The same as `toString`. */
  public toLocaleString(
    encoding?: BufferEncoding,
    start?: int,
    end?: int,
  ): string;
  /** An object of the bytes for JSON: `{ type: "Buffer", data: [...] }`. */
  public toJSON(): BufferJson;

  /** Whether the bytes are the same. */
  public equals(other: Uint8Array): boolean;
  /**
   * Compares the bytes, or the parts given of both: -1 when this one goes
   * earlier, 1 when later, 0 when they are the same.
   */
  public compare(
    target: Uint8Array,
    targetStart?: int,
    targetEnd?: int,
    sourceStart?: int,
    sourceEnd?: int,
  ): int;
  /** Copies the bytes into the target and gives how many were copied. */
  public copy(
    target: Uint8Array,
    targetStart?: int,
    sourceStart?: int,
    sourceEnd?: int,
  ): int;
  /**
   * Writes the text at the offset, at most `length` bytes of it, and gives
   * how many bytes were written.
   */
  public write(text: string, encoding?: BufferEncoding): int;
  public write(text: string, offset: int, encoding: BufferEncoding): int;
  public write(
    text: string,
    offset: int,
    length?: int,
    encoding?: BufferEncoding,
  ): int;

  /**
   * The offset of the first occurrence of a byte, of the bytes of a text or
   * of other bytes, -1 when there is none. An encoding goes only with a
   * text, and may stand in place of the offset.
   */
  public indexOf(
    value: int | string | Uint8Array,
    byteOffset?: int,
    encoding?: BufferEncoding,
  ): int;
  public indexOf(value: string, encoding: BufferEncoding): int;
  /** The offset of the last occurrence, -1 when there is none. */
  public lastIndexOf(
    value: int | string | Uint8Array,
    byteOffset?: int,
    encoding?: BufferEncoding,
  ): int;
  public lastIndexOf(value: string, encoding: BufferEncoding): int;
  public includes(
    value: int | string | Uint8Array,
    byteOffset?: int,
    encoding?: BufferEncoding,
  ): boolean;
  public includes(value: string, encoding: BufferEncoding): boolean;

  /** Swaps the bytes of every pair in place. */
  public swap16(): Buffer;
  /** Reverses the bytes of every four in place. */
  public swap32(): Buffer;
  /** Reverses the bytes of every eight in place. */
  public swap64(): Buffer;

  /** Reads a number of one byte at the offset, 0 by default. */
  public readInt8(offset?: int): int;
  public readUInt8(offset?: int): int;
  public readUint8(offset?: int): int;
  /** Reads a number of two bytes. */
  public readInt16LE(offset?: int): int;
  public readInt16BE(offset?: int): int;
  public readUInt16LE(offset?: int): int;
  public readUInt16BE(offset?: int): int;
  public readUint16LE(offset?: int): int;
  public readUint16BE(offset?: int): int;
  /** Reads a number of four bytes. */
  public readInt32LE(offset?: int): int;
  public readInt32BE(offset?: int): int;
  public readUInt32LE(offset?: int): int;
  public readUInt32BE(offset?: int): int;
  public readUint32LE(offset?: int): int;
  public readUint32BE(offset?: int): int;
  /** Reads a number of `byteLength` bytes, from 1 to 6. */
  public readIntLE(offset: int, byteLength: int): int;
  public readIntBE(offset: int, byteLength: int): int;
  public readUIntLE(offset: int, byteLength: int): int;
  public readUIntBE(offset: int, byteLength: int): int;
  public readUintLE(offset: int, byteLength: int): int;
  public readUintBE(offset: int, byteLength: int): int;
  /**
   * Reads a number with a fraction of four bytes; an error when the bytes
   * hold `NaN` or an infinity.
   */
  public readFloatLE(offset?: int): Result<double, NumberError>;
  public readFloatBE(offset?: int): Result<double, NumberError>;
  /** Reads a number with a fraction of eight bytes. */
  public readDoubleLE(offset?: int): Result<double, NumberError>;
  public readDoubleBE(offset?: int): Result<double, NumberError>;

  /**
   * Writes a number of one byte at the offset, 0 by default, and gives the
   * offset after it.
   */
  public writeInt8(value: int, offset?: int): int;
  public writeUInt8(value: int, offset?: int): int;
  public writeUint8(value: int, offset?: int): int;
  /** Writes a number of two bytes. */
  public writeInt16LE(value: int, offset?: int): int;
  public writeInt16BE(value: int, offset?: int): int;
  public writeUInt16LE(value: int, offset?: int): int;
  public writeUInt16BE(value: int, offset?: int): int;
  public writeUint16LE(value: int, offset?: int): int;
  public writeUint16BE(value: int, offset?: int): int;
  /** Writes a number of four bytes. */
  public writeInt32LE(value: int, offset?: int): int;
  public writeInt32BE(value: int, offset?: int): int;
  public writeUInt32LE(value: int, offset?: int): int;
  public writeUInt32BE(value: int, offset?: int): int;
  public writeUint32LE(value: int, offset?: int): int;
  public writeUint32BE(value: int, offset?: int): int;
  /** Writes a number of `byteLength` bytes, from 1 to 6. */
  public writeIntLE(value: int, offset: int, byteLength: int): int;
  public writeIntBE(value: int, offset: int, byteLength: int): int;
  public writeUIntLE(value: int, offset: int, byteLength: int): int;
  public writeUIntBE(value: int, offset: int, byteLength: int): int;
  public writeUintLE(value: int, offset: int, byteLength: int): int;
  public writeUintBE(value: int, offset: int, byteLength: int): int;
  /** Writes a number with a fraction of four bytes. */
  public writeFloatLE(value: double, offset?: int): int;
  public writeFloatBE(value: double, offset?: int): int;
  /** Writes a number with a fraction of eight bytes. */
  public writeDoubleLE(value: double, offset?: int): int;
  public writeDoubleBE(value: double, offset?: int): int;

  /** How many bytes an item takes: 1. */
  public static readonly BYTES_PER_ELEMENT: int;
  /** The size of the pool node takes small Buffers from: 8192. */
  public static readonly poolSize: int;

  /**
   * A Buffer of the bytes of a text in the encoding, "utf8" by default.
   * @example Buffer.from("SGk=", "base64") // <Buffer 48 69>
   */
  public static from(text: string, encoding?: BufferEncoding): Buffer;
  /** A Buffer with a copy of the bytes of an array or of other bytes. */
  public static from(items: uint8[] | Uint8Array): Buffer;
  /** A Buffer that looks into the memory of an `ArrayBuffer`. */
  public static from(
    buffer: ArrayBuffer,
    byteOffset?: int,
    length?: int,
  ): Buffer;
  /** A Buffer of the bytes given. */
  public static of(...items: uint8[]): Buffer;

  /**
   * A Buffer of `size` bytes, zeros or what `fill` says: a number, the
   * bytes of a text or other bytes.
   */
  public static alloc(
    size: int,
    fill?: int | string | Uint8Array,
    encoding?: BufferEncoding,
  ): Buffer;
  /**
   * A Buffer of `size` bytes that are not set to zeros: they are whatever
   * the memory held, so every byte is to be written before it is read.
   */
  public static allocUnsafe(size: int): Buffer;
  /** The same as `allocUnsafe`. */
  public static allocUnsafeSlow(size: int): Buffer;
  /**
   * One Buffer of all the bytes in a row, cut or padded with zeros to
   * `totalLength` when given.
   */
  public static concat(list: Uint8Array[], totalLength?: int): Buffer;

  /** How many bytes a text takes in the encoding, or bytes hold. */
  public static byteLength(
    value: string | AnyBytes,
    encoding?: BufferEncoding,
  ): int;
  /** Compares two rows of bytes: -1, 0 or 1; fits `sort`. */
  public static compare(first: Uint8Array, second: Uint8Array): int;
  public static isBuffer(value: unknown): boolean;
  /** Whether the text names an encoding Buffer knows. */
  public static isEncoding(encoding: string): boolean;
}
