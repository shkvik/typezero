async function subtleExportJwk(format: KeyFormat,
                               key: CryptoKey): Promise<Result<JsonWebKey, SubtleError>> {
  const result = await key.export(format)
  if (result.isErr()) return err(result.error)
  const value = result.value
  if (value instanceof ArrayBuffer) return ok({})
  return ok(value)
}

async function subtleExportBytes(format: KeyFormat,
                                 key: CryptoKey): Promise<Result<ArrayBuffer, SubtleError>> {
  return exportBytes(format, key)
}

