/** The functions of `JSON`. */
export interface JSON {
  /**
   * Reads a text of JSON. The value is a `Json`: a check shows what it holds
   * before it is used.
   * @example JSON.parse("[1, 2]") // ok([1, 2])
   */
  readonly parse(text: string): Result<Json, JsonError>;

  /**
   * Writes a value as a text of JSON. There is no replacer: build the value to
   * write first, and pass `null` in its place. `space` is the indent: a count
   * of spaces or the text of one step.
   * @example JSON.stringify({ a: 1 }, null, 2)
   */
  readonly stringify(
    value: Read<unknown>,
    replacer?: null,
    space?: int | string,
  ): string;
}

/** Reading and writing JSON. */
export declare const JSON: JSON;

/** What `Json` has; the type `Json` is any value of JSON. */
export interface JsonConstructor {
  /**
   * Whether a value of an unknown type is a value of JSON; after the check
   * it is a `Json`.
   */
  readonly isJson(value: Read<unknown>): boolean;
}

export declare const Json: JsonConstructor;
