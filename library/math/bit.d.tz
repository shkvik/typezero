/**
 * An unsigned number of 32 bits that counts modulo 2**32, for hashes,
 * checksums and random numbers, where a plain overflow would be an error.
 * A variable of this type starts with a literal or with
 * `Bit.Wrap32.from(x)`. Every operator with it gives a `Bit.Wrap32` again,
 * the other operand being any integer; the number leaves only through
 * `value`.
 * @example let hash: Bit.Wrap32 = 0x811c9dc5
 */
export interface Wrap32 {
  /** The same bits as a plain number. */
  readonly value: uint32;
  readonly toString(): string;
}

/** What `Bit.Wrap32` has. */
export interface Wrap32Constructor {
  /** The lowest 32 bits of an integer. */
  readonly from(
    value: int | int8 | int16 | int32 | uint8 | uint16 | uint32 | uint64,
  ): Wrap32;
}

export declare const Wrap32: Wrap32Constructor;

/** As `Bit.Wrap32`, of 64 bits: it counts modulo 2**64. */
export interface Wrap64 {
  /** The same bits as a plain number. */
  readonly value: uint64;
  readonly toString(): string;
}

/** What `Bit.Wrap64` has. */
export interface Wrap64Constructor {
  /** The lowest 64 bits of an integer. */
  readonly from(
    value: int | int8 | int16 | int32 | uint8 | uint16 | uint32 | uint64,
  ): Wrap64;
}

export declare const Wrap64: Wrap64Constructor;

/** A number of 32 bits: a function gives the type it was given. */
export type Bits32 = int32 | uint32 | Wrap32;

/** A number of 64 bits: a function gives the type it was given. */
export type Bits64 = int | uint64 | Wrap64;

/**
 * Turns the bits to the left by `count` places: those that leave at one
 * end come back at the other.
 * @example state = Bit.rotateLeft32(state ^ key, 16)
 */
export declare function rotateLeft32<N extends Bits32>(
  value: N,
  count: int,
): N;
export declare function rotateLeft64<N extends Bits64>(
  value: N,
  count: int,
): N;

/** Turns the bits to the right by `count` places. */
export declare function rotateRight32<N extends Bits32>(
  value: N,
  count: int,
): N;
export declare function rotateRight64<N extends Bits64>(
  value: N,
  count: int,
): N;

/** How many zero bits there are before the highest one bit. */
export declare function leadingZeros32(value: Read<Bits32>): int;
export declare function leadingZeros64(value: Read<Bits64>): int;

/** How many zero bits there are after the lowest one bit. */
export declare function trailingZeros32(value: Read<Bits32>): int;
export declare function trailingZeros64(value: Read<Bits64>): int;

/** How many one bits there are. */
export declare function onesCount32(value: Read<Bits32>): int;
export declare function onesCount64(value: Read<Bits64>): int;

/** The bytes in the opposite order. */
export declare function reverseBytes32<N extends Bits32>(value: N): N;
export declare function reverseBytes64<N extends Bits64>(value: N): N;

/**
 * Both halves of the product of 128 bits.
 * @example const { hi, lo } = Bit.mul64(a, b)
 */
export declare function mul64(
  first: Read<uint64 | Wrap64>,
  second: Read<uint64 | Wrap64>,
): { hi: uint64; lo: uint64 };

/** The sum with the carry in and the carry out, each 0 or 1. */
export declare function add64(
  first: Read<uint64 | Wrap64>,
  second: Read<uint64 | Wrap64>,
  carry: Read<uint64 | Wrap64>,
): { sum: uint64; carry: uint64 };

/** The difference with the borrow in and the borrow out, each 0 or 1. */
export declare function sub64(
  first: Read<uint64 | Wrap64>,
  second: Read<uint64 | Wrap64>,
  borrow: Read<uint64 | Wrap64>,
): { diff: uint64; borrow: uint64 };
