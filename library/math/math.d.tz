/**
 * The numbers `Math` works with: the integers and `double`. A `decimal` has
 * its own functions (`decimal.max`, the methods of a decimal).
 */
export type MathNumber =
  int | int8 | int16 | int32 | uint8 | uint16 | uint32 | uint64 | double;

/** A 32-bit integer, as `Math.clz32` and `Math.imul` take it. */
export type MathBits32 = int32 | uint32 | Bit.Wrap32;

/**
 * The functions and constants of `Math`. A function never changes the type of
 * a number by itself: what takes a `double` does not take an integer, and the
 * values of `min`, `max`, `clamp` and `pow` have one type, which the result
 * has too.
 */
export interface Math {
  readonly E: double;
  readonly LN10: double;
  readonly LN2: double;
  readonly LOG10E: double;
  readonly LOG2E: double;
  readonly PI: double;
  readonly SQRT1_2: double;
  readonly SQRT2: double;

  /** The largest whole number not above the value. */
  readonly floor(value: double): double;
  /** The smallest whole number not below the value. */
  readonly ceil(value: double): double;
  /** The nearest whole number; a half goes up. */
  readonly round(value: double): double;
  /** The value without its fraction. */
  readonly trunc(value: double): double;

  /** The value without its sign. */
  readonly abs<N extends MathNumber>(value: N): N;
  /** -1, 0 or 1 by the sign of the value. */
  readonly sign<N extends MathNumber>(value: N): N;
  /** The smallest of the values; there must be at least one. */
  readonly min<N extends MathNumber>(...values: N[]): N;
  /** The largest of the values; there must be at least one. */
  readonly max<N extends MathNumber>(...values: N[]): N;
  /** The value, or the bound it is beyond. */
  readonly clamp<N extends MathNumber>(value: N, low: N, high: N): N;
  /** `base ** exponent`. */
  readonly pow<N extends MathNumber>(base: N, exponent: N): N;

  readonly sqrt(value: double): double;
  readonly cbrt(value: double): double;
  readonly exp(value: double): double;
  readonly expm1(value: double): double;
  readonly log(value: double): double;
  readonly log1p(value: double): double;
  readonly log2(value: double): double;
  readonly log10(value: double): double;
  readonly sin(value: double): double;
  readonly cos(value: double): double;
  readonly tan(value: double): double;
  /** The value must be proven to be from -1 to 1. */
  readonly asin(value: double): double;
  /** The value must be proven to be from -1 to 1. */
  readonly acos(value: double): double;
  readonly atan(value: double): double;
  readonly atan2(y: double, x: double): double;
  readonly sinh(value: double): double;
  readonly cosh(value: double): double;
  readonly tanh(value: double): double;
  readonly asinh(value: double): double;
  readonly acosh(value: double): double;
  /** The value must be proven to be between -1 and 1. */
  readonly atanh(value: double): double;
  /** The square root of the sum of the squares. */
  readonly hypot(...values: double[]): double;
  /** The nearest 32-bit float. */
  readonly fround(value: double): double;

  /** How many zero bits a 32-bit integer starts with. */
  readonly clz32(value: Read<MathBits32>): int;
  /** The low 32 bits of the product. */
  readonly imul(left: Read<MathBits32>, right: Read<MathBits32>): int32;

  /** A number from 0 up to, but not including, 1. */
  readonly random(): double;
}

/**
 * The mathematical functions and constants.
 * @example Math.max(1, 2) // 2
 */
export declare const Math: Math;
