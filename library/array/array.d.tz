/**
 * What an array `T[]` has. An index counts from 0, and what may be outside
 * the array gives `undefined` instead of failing: the compiler asks for a
 * check unless it can prove the index. A function passed to a method may take
 * fewer parameters than the method gives it.
 */
export interface Array<T> {
  /** How many items there are; writing it cuts the array or does nothing. */
  length: int;

  /** Adds the items at the end and gives the new length. */
  push(...items: T[]): int;
  /** Adds the items at the start and gives the new length. */
  unshift(...items: T[]): int;
  /** Takes the last item out. */
  pop(): T | undefined;
  /** Takes the first item out. */
  shift(): T | undefined;
  /**
   * Takes `count` items out from `start` (all to the end without a count),
   * puts `items` in their place and gives the items taken out.
   */
  splice(start: int, count?: int, ...items: T[]): T[];
  /** Sets every item from `start` up to `end` to the value. */
  fill(value: T, start?: int, end?: int): T[];
  /**
   * Sorts the array itself. The function gives a negative number when the
   * first item goes earlier; only an array of strings is sorted without one.
   * @example xs.sort((a, b) => a - b)
   */
  sort(compare?: (first: T, second: T) => int | double): T[];
  /** Reverses the array itself. */
  reverse(): T[];

  /** The item at the index; a negative index counts from the end. */
  at(index: int): T | undefined;
  /** A new array of the items from `start` up to `end`. */
  slice(start?: int, end?: int): T[];
  /** A new array of this one followed by the items and the items of arrays. */
  concat(...items: (T | T[])[]): T[];

  /** The index of the first such item, -1 when there is none. */
  indexOf(item: T, from?: int): int;
  /** The index of the last such item, -1 when there is none. */
  lastIndexOf(item: T, from?: int): int;
  includes(item: T, from?: int): boolean;

  /** The items as text with the separator, a comma by default. */
  join(separator?: string): string;
  toString(): string;

  keys(): Generator<int>;
  values(): Generator<T>;
  entries(): Generator<[int, T]>;

  forEach(action: (item: T, index: int, all: T[]) => void): void;
  /**
   * A new array of what the function gives for each item.
   * @example [1, 2].map((x) => x * 2) // [2, 4]
   */
  map<U>(change: (item: T, index: int, all: T[]) => U): U[];
  /** As `map`, and an array the function gives is put in item by item. */
  flatMap<U>(change: (item: T, index: int, all: T[]) => U | U[]): U[];
  /** A new array of the items the function says yes to. */
  filter(keep: (item: T, index: int, all: T[]) => boolean): T[];

  /**
   * Folds the items into one value from the left. Without a start value the
   * first item is the start, and an empty array gives `undefined`.
   * @example [1, 2, 3].reduce((sum, x) => sum + x, 0) // 6
   */
  reduce(join: (result: T, item: T, index: int, all: T[]) => T): T | undefined;
  reduce<U>(join: (result: U, item: T, index: int, all: T[]) => U, start: U): U;
  /** As `reduce`, from the right. */
  reduceRight(
    join: (result: T, item: T, index: int, all: T[]) => T,
  ): T | undefined;
  reduceRight<U>(
    join: (result: U, item: T, index: int, all: T[]) => U,
    start: U,
  ): U;

  /** The first item the function says yes to. */
  find(test: (item: T, index: int, all: T[]) => boolean): T | undefined;
  /** The last item the function says yes to. */
  findLast(test: (item: T, index: int, all: T[]) => boolean): T | undefined;
  /** The index of the first such item, -1 when there is none. */
  findIndex(test: (item: T, index: int, all: T[]) => boolean): int;
  /** The index of the last such item, -1 when there is none. */
  findLastIndex(test: (item: T, index: int, all: T[]) => boolean): int;
  /** Whether the function says yes to at least one item. */
  some(test: (item: T, index: int, all: T[]) => boolean): boolean;
  /** Whether the function says yes to every item. */
  every(test: (item: T, index: int, all: T[]) => boolean): boolean;
}

/**
 * What `Array` has besides `new Array<T>(length)`, which makes an array of
 * that many items.
 */
export interface ArrayConstructor {
  isArray(value: unknown): boolean;
  /**
   * A new array of the items of an array, a string or an iterator, each
   * changed by the function when there is one.
   */
  from<T>(items: Iterable<T> | Iterator<T>): T[];
  from<T, U>(
    items: Iterable<T> | Iterator<T>,
    change: (item: T, index: int) => U,
  ): U[];
}

export declare const Array: ArrayConstructor;

/** The same as `T[]`. */
export type ReadonlyArray<T> = T[];
