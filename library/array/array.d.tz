/**
 * What an array `T[]` has. An index counts from 0, and what may be outside
 * the array gives `undefined` instead of failing: the compiler asks for a
 * check unless it can prove the index. A function passed to a method may take
 * fewer parameters than the method gives it.
 */
export interface Array<T> {
  /** How many items there are; writing it cuts the array or does nothing. */
  length: int;

  /** Adds the items at the end and gives the new length. */
  push(...items: Own<T>[]): int;
  /** Adds the items at the start and gives the new length. */
  unshift(...items: Own<T>[]): int;
  /** Takes the last item out. */
  pop(): T | undefined;
  /** Takes the first item out. */
  shift(): T | undefined;
  /**
   * Takes `count` items out from `start` (all to the end without a count),
   * puts `items` in their place and gives the items taken out.
   */
  splice(start: int, count?: int, ...items: Own<T>[]): T[];
  /** Sets every item from `start` up to `end` to the value. */
  fill(value: Read<T>, start?: int, end?: int): T[];
  /**
   * Sorts the array itself. The function gives a negative number when the
   * first item goes earlier; only an array of strings is sorted without one.
   * @example xs.sort((a, b) => a - b)
   */
  sort(compare?: Read<(first: T, second: T) => int | double>): T[];
  /** Reverses the array itself. */
  reverse(): T[];

  /** The item at the index; a negative index counts from the end. */
  readonly at(index: int): T | undefined;
  /** A new array of the items from `start` up to `end`. */
  readonly slice(start?: int, end?: int): T[];
  /**
   * A look at the items from start to end, for reading only.
   * @example const head = items.view(0, 3)
   */
  readonly view(start?: int, end?: int): readonly T[];
  /**
   * Takes every item out, in order, and leaves the array empty.
   * @example for (using file of files.drain()) {}
   */
  drain(): T[];
  /**
   * Keeps only the items the function says yes to, in place.
   * @example items.retain((item) => item.isLive)
   */
  retain(keep: Read<(item: T, index: int, all: T[]) => boolean>): void;
  /** A new array of this one followed by the items and the items of arrays. */
  readonly concat(...items: Read<T | T[]>[]): T[];

  /** The index of the first such item, -1 when there is none. */
  readonly indexOf(item: Read<T>, from?: int): int;
  /** The index of the last such item, -1 when there is none. */
  readonly lastIndexOf(item: Read<T>, from?: int): int;
  readonly includes(item: Read<T>, from?: int): boolean;

  /** The items as text with the separator, a comma by default. */
  readonly join(separator?: string): string;
  readonly toString(): string;

  readonly keys(): Generator<int>;
  readonly values(): Generator<T>;
  readonly entries(): Generator<[int, T]>;
  /** The items in order: what `for...of` goes through. */
  [Symbol.iterator](): Iterator<T>;

  readonly forEach(action: Read<(item: T, index: int, all: T[]) => void>): void;
  /**
   * A new array of what the function gives for each item.
   * @example [1, 2].map((x) => x * 2) // [2, 4]
   */
  readonly map<U>(change: Read<(item: T, index: int, all: T[]) => U>): U[];
  /** As `map`, and an array the function gives is put in item by item. */
  readonly flatMap<U>(
    change: Read<(item: T, index: int, all: T[]) => U | U[]>,
  ): U[];
  /** A new array of the items the function says yes to. */
  readonly filter(keep: Read<(item: T, index: int, all: T[]) => boolean>): T[];

  /**
   * Folds the items into one value from the left. Without a start value the
   * first item is the start, and an empty array gives `undefined`.
   * @example [1, 2, 3].reduce((sum, x) => sum + x, 0) // 6
   */
  readonly reduce(
    join: Read<(result: T, item: T, index: int, all: T[]) => T>,
  ): T | undefined;
  readonly reduce<U>(
    join: Read<(result: U, item: T, index: int, all: T[]) => U>,
    start: Read<U>,
  ): U;
  /** As `reduce`, from the right. */
  readonly reduceRight(
    join: Read<(result: T, item: T, index: int, all: T[]) => T>,
  ): T | undefined;
  readonly reduceRight<U>(
    join: Read<(result: U, item: T, index: int, all: T[]) => U>,
    start: Read<U>,
  ): U;

  /** The first item the function says yes to. */
  readonly find(
    test: Read<(item: T, index: int, all: T[]) => boolean>,
  ): T | undefined;
  /** The last item the function says yes to. */
  readonly findLast(
    test: Read<(item: T, index: int, all: T[]) => boolean>,
  ): T | undefined;
  /** The index of the first such item, -1 when there is none. */
  readonly findIndex(
    test: Read<(item: T, index: int, all: T[]) => boolean>,
  ): int;
  /** The index of the last such item, -1 when there is none. */
  readonly findLastIndex(
    test: Read<(item: T, index: int, all: T[]) => boolean>,
  ): int;
  /** Whether the function says yes to at least one item. */
  readonly some(
    test: Read<(item: T, index: int, all: T[]) => boolean>,
  ): boolean;
  /** Whether the function says yes to every item. */
  readonly every(
    test: Read<(item: T, index: int, all: T[]) => boolean>,
  ): boolean;
}

/**
 * `Array<T>(length)` makes an array, with `new` or without it; besides that
 * `Array` has the functions that test and build arrays.
 */
export interface ArrayConstructor {
  /**
   * An array of that many items, each the default value of its type: 0, "",
   * false, `undefined`; a type without one is refused. An empty array when
   * there is no length. The type of the items is written, and the length is
   * proven not to be negative.
   * @example Array<int>(3) // [0, 0, 0]
   */
  <T>(length?: int): T[];

  readonly isArray(value: Read<unknown>): boolean;
  /**
   * A new array of the items of an array, a string or an iterator, each
   * changed by the function when there is one.
   */
  readonly from<T>(items: Read<Iterable<T> | Iterator<T>>): T[];
  readonly from<T, U>(
    items: Read<Iterable<T> | Iterator<T>>,
    change: Read<(item: T, index: int) => U>,
  ): U[];
}

export declare const Array: ArrayConstructor;

/** The same as `T[]`. */
export type ReadonlyArray<T> = readonly T[];
