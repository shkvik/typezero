function isHighUnit(unit: int): boolean {
  return unit >= 55296 && unit <= 56319;
}

function isLowUnit(unit: int): boolean {
  return unit >= 56320 && unit <= 57343;
}

function pointUnitCount(point: int): int {
  if (point >= 65536) {
    return 2;
  }

  return 1;
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "every index stays below the length of the table",
})
function runDelta(runs: Read<int[]>, point: int): int {
  const cells = arrayCells(runs);
  let low = 0;
  let high = runs.length / 4;

  while (low < high) {
    const middle = (low + high) / 2;
    if (unitAt(cells, middle * 4) <= point) {
      low = middle + 1;
    } else {
      high = middle;
    }
  }
  if (low == 0) {
    return 0;
  }

  const base = (low - 1) * 4;
  const start = unitAt(cells, base);
  const end = unitAt(cells, base + 1);
  const stride = unitAt(cells, base + 2);
  if (point > end || (point - start) % stride != 0) {
    return 0;
  }

  return unitAt(cells, base + 3);
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "every index stays below the length of the table",
})
function specialAt(table: Read<int[]>, point: int): int {
  const cells = arrayCells(table);
  let low = 0;
  let high = table.length / 5;

  while (low < high) {
    const middle = (low + high) / 2;
    const found = unitAt(cells, middle * 5);
    if (found < point) {
      low = middle + 1;
    } else if (found > point) {
      high = middle;
    } else {
      return middle * 5;
    }
  }

  return -1;
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "every index stays below the length of the table",
})
function inRanges(table: Read<int[]>, point: int): boolean {
  const cells = arrayCells(table);
  let low = 0;
  let high = table.length / 2;

  while (low < high) {
    const middle = (low + high) / 2;
    if (unitAt(cells, middle * 2 + 1) < point) {
      low = middle + 1;
    } else if (unitAt(cells, middle * 2) > point) {
      high = middle;
    } else {
      return true;
    }
  }

  return false;
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "at < count, the next unit is read only when at + 1 < count",
})
function pointAtCell<C>(cells: Raw<C>, at: int, count: int): int {
  const unit = unitAt(cells, at);
  if (!isHighUnit(unit) || at + 1 >= count) {
    return unit;
  }

  const next = unitAt(cells, at + 1);
  if (!isLowUnit(next)) {
    return unit;
  }

  return 65536 + (unit - 55296) * 1024 + (next - 56320);
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "0 < at <= count, the unit before is read only when at >= 2",
})
function pointBefore<C>(cells: Raw<C>, at: int): int {
  const unit = unitAt(cells, at - 1);
  if (!isLowUnit(unit) || at < 2) {
    return unit;
  }

  const before = unitAt(cells, at - 2);
  if (!isHighUnit(before)) {
    return unit;
  }

  return 65536 + (before - 55296) * 1024 + (unit - 56320);
}

function asciiCased(unit: int, isUpper: boolean): int {
  if (isUpper && unit >= 97 && unit <= 122) {
    return unit - 32;
  }
  if (!isUpper && unit >= 65 && unit <= 90) {
    return unit + 32;
  }

  return unit;
}

function isCasedPoint(point: int): boolean {
  return inRanges(kCasedRanges, point);
}

function isIgnorablePoint(point: int): boolean {
  return inRanges(kIgnorableRanges, point);
}

function isFinalSigma<C>(cells: Raw<C>, at: int, count: int): boolean {
  let back = at;
  let isPreceded = false;

  while (back > 0) {
    const point = pointBefore(cells, back);

    back -= pointUnitCount(point);

    if (!isIgnorablePoint(point)) {
      isPreceded = isCasedPoint(point);
      back = 0;
    }
  }
  if (!isPreceded) {
    return false;
  }

  let ahead = at + 1;

  while (ahead < count) {
    const point = pointAtCell(cells, ahead, count);

    ahead += pointUnitCount(point);

    if (!isIgnorablePoint(point)) {
      return !isCasedPoint(point);
    }
  }

  return true;
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "into has room for 3 points",
})
function mappedPoints(point: int, isUpper: boolean, into: Raw<int>): int {
  if (point < 128) {
    putUnit(into, 0, asciiCased(point, isUpper));

    return 1;
  }
  if (isUpper) {
    return mappedFrom(kUpperSpecial, kUpperRuns, point, into);
  }

  return mappedFrom(kLowerSpecial, kLowerRuns, point, into);
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "into has room for 3 points; the table entry has 5 cells",
})
function mappedFrom(
  special: Read<int[]>,
  runs: Read<int[]>,
  point: int,
  into: Raw<int>,
): int {
  const found = specialAt(special, point);
  if (found >= 0) {
    const cells = arrayCells(special);
    const count = unitAt(cells, found + 1);

    for (let index = 0; index < count; index++) {
      putUnit(into, index, unitAt(cells, found + 2 + index));
    }

    return count;
  }

  putUnit(into, 0, point + runDelta(runs, point));

  return 1;
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "the room has the units counted by the pass that does not write",
})
function putPoint<T>(room: Raw<T>, used: int, point: int): int {
  if (point < 65536) {
    putUnit(room, used, point);

    return used + 1;
  }

  const rest = point - 65536;

  putUnit(room, used, 55296 + rest / 1024);
  putUnit(room, used + 1, 56320 + rest % 1024);

  return used + 2;
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "the room has the units counted by the pass that does not write",
})
function caseUnits<C, T>(
  cells: Raw<C>,
  count: int,
  isUpper: boolean,
  room: Raw<T>,
  isWriting: boolean,
): Piece {
  const mapped = frameCells<int>(3);
  let used = 0;
  let isChanged = false;
  let at = 0;

  while (at < count) {
    const point = pointAtCell(cells, at, count);
    let made = 1;

    if (!isUpper && point == 931) {
      let sigma = 963;

      if (isFinalSigma(cells, at, count)) {
        sigma = 962;
      }

      putUnit(mapped, 0, sigma);
    } else {
      made = mappedPoints(point, isUpper, mapped);
    }

    isChanged = isChanged || made != 1 || unitAt(mapped, 0) != point;

    for (let index = 0; index < made; index++) {
      const result = unitAt(mapped, index);

      if (isWriting) {
        used = putPoint(room, used, result);
      } else {
        used += pointUnitCount(result);
      }
    }

    at += pointUnitCount(point);
  }

  let changed = 0;

  if (isChanged) {
    changed = 1;
  }

  return new Piece(used, changed);
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "a unit maps to at most 3 units, the scratch has 3 per unit",
})
function casedThrough<C>(
  text: Read<string>,
  cells: Raw<C>,
  isUpper: boolean,
  scratch: Raw<uint16>,
): string {
  const made = caseUnits(cells, text.length, isUpper, scratch, true);
  if (made.count == 0) {
    return text;
  }

  const total = made.at;
  const room = textRoom<uint16>(total);

  copyCells(scratch, 0, room, 0, total);

  return textClosed(room, total, false);
}

function scratchUnits(): int {
  return 96;
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "the scratch has 3 units for every unit of the text",
})
function casedCells<C>(
  text: Read<string>,
  cells: Raw<C>,
  isUpper: boolean,
): string {
  const most = text.length * 3;
  if (most <= scratchUnits()) {
    const scratch = frameCells<uint16>(96);

    return casedThrough(text, cells, isUpper, scratch);
  }

  const scratch = allocate<uint16>(most);
  const made = casedThrough(text, cells, isUpper, scratch);

  release(scratch);

  return made;
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "at is inside the cells",
})
function isLetterAt(cells: Raw<uint8>, at: int, first: int): boolean {
  const unit = unitAt(cells, at);

  return unit >= first && unit <= first + 25;
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "the room has count cells and every one is written",
})
function casedAscii(
  text: Read<string>,
  cells: Raw<uint8>,
  isUpper: boolean,
): string {
  const count = text.length;
  let first = 65;

  if (isUpper) {
    first = 97;
  }

  let at = 0;

  while (at < count && !isLetterAt(cells, at, first)) {
    at += 1;
  }
  if (at == count) {
    return text;
  }

  const room = textRoom<uint8>(count);

  for (let index = 0; index < count; index++) {
    const unit = unitAt(cells, index);
    let made = unit;

    if (unit >= first && unit <= first + 25) {
      made = unit ^ 32;
    }

    putUnit(room, index, made);
  }

  return textClosed(room, count, true);
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "the cells live as long as this borrowed string",
})
function cased(text: Read<string>, isUpper: boolean): string {
  const narrow = textCells<uint8>(text);
  if (narrow != undefined && isAscii(text)) {
    return casedAscii(text, narrow, isUpper);
  }
  if (narrow != undefined) {
    return casedCells(text, narrow, isUpper);
  }

  const wide = textCells<uint16>(text);
  if (wide != undefined) {
    return casedCells(text, wide, isUpper);
  }

  return text;
}

export function toUpperCase(text: Read<string>): string {
  return cased(text, true);
}

export function toLowerCase(text: Read<string>): string {
  return cased(text, false);
}
