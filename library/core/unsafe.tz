export declare class Raw<T> {}

export declare function allocate<T>(count: int): Raw<T>;
export declare function reallocate<T>(raw: Raw<T>, count: int): Raw<T>;
export declare function release<T>(raw: Raw<T>): void;
export declare function putAt<T>(raw: Raw<T>, index: int, value: Own<T>): void;
export declare function takeAt<T>(raw: Raw<T>, index: int): T;
export declare function peekAt<T>(raw: Raw<T>, index: int): Read<T>;
export declare function destroyAt<T>(raw: Raw<T>, index: int): void;
export declare function shiftCells<T>(
  raw: Raw<T>,
  from: int,
  to: int,
  count: int,
): void;
export declare function forget<T>(value: Own<T>): void;
export declare function arrayCells<T>(items: Read<T[]>): Raw<T>;
export declare function hashOf<T>(key: Read<T>): int;
export declare function textCells<C>(text: Read<string>): Raw<C> | undefined;
export declare function unitAt<C>(raw: Raw<C>, index: int): int;
export declare function findUnit<C>(
  raw: Raw<C>,
  from: int,
  end: int,
  unit: int,
): int;
export declare function sameCells<T>(
  first: Raw<T>,
  firstAt: int,
  second: Raw<T>,
  secondAt: int,
  count: int,
): boolean;
export declare function copyCells<S, T>(
  from: Raw<S>,
  start: int,
  into: Raw<T>,
  at: int,
  count: int,
): void;
export declare function putUnit<C>(raw: Raw<C>, index: int, unit: int): void;
export declare function textRoom<C>(count: int): Raw<C>;
export declare function textClosed<C>(
  room: Raw<C>,
  count: int,
  isAscii: boolean,
): string;
export declare function isAscii(text: Read<string>): boolean;
export declare function frameCells<T>(count: int): Raw<T>;
