import {
  Raw,
  allocate,
  destroyAt,
  peekAt,
  putAt,
  reallocate,
  release,
  shiftCells,
  takeAt,
} from "tz:unsafe";

export class List<T> {
  private data: Raw<T>;
  private count: int;
  private capacity: int;

  @Unsafe({
    uses: [UnsafeUse.Memory],
    reason: "the list is empty: there are no cells, count and capacity are 0",
  })
  public constructor() {
    this.data = allocate<T>(0);
    this.count = 0;
    this.capacity = 0;
  }

  public readonly length(): int {
    return this.count;
  }

  @Unsafe({
    uses: [UnsafeUse.Memory],
    reason: "after grow the cell count exists and is empty",
  })
  public push(item: Own<T>): void {
    if (this.count == this.capacity) {
      this.grow();
    }

    putAt(this.data, this.count, item);
    this.count += 1;
  }

  @Unsafe({
    uses: [UnsafeUse.Memory],
    reason: "the cell count - 1 is full; after take it counts as empty",
  })
  public pop(): T | undefined {
    if (this.count == 0) {
      return undefined;
    }

    this.count -= 1;

    return takeAt(this.data, this.count);
  }

  @Unsafe({
    uses: [UnsafeUse.Memory],
    reason: "index is checked: the cell is full",
  })
  public readonly at(index: int): Read<T> | undefined {
    if (index < 0 || index >= this.count) {
      return undefined;
    }

    return peekAt(this.data, index);
  }

  @Unsafe({
    uses: [UnsafeUse.Memory],
    reason: "cells index … count - 1 move one up into room grow made; the cell index is then empty",
  })
  public insert(index: int, item: Own<T>): void {
    if (index < 0 || index > this.count) {
      return;
    }
    if (this.count == this.capacity) {
      this.grow();
    }

    shiftCells(this.data, index, index + 1, this.count - index);
    putAt(this.data, index, item);
    this.count += 1;
  }

  @Unsafe({
    uses: [UnsafeUse.Memory],
    reason: "the cell index is full; the cells after it move one down",
  })
  public remove(index: int): T | undefined {
    if (index < 0 || index >= this.count) {
      return undefined;
    }

    const item = takeAt(this.data, index);

    shiftCells(this.data, index + 1, index, this.count - index - 1);
    this.count -= 1;

    return item;
  }

  @Unsafe({
    uses: [UnsafeUse.Memory],
    reason: "cells 0 … count - 1 are full; each is freed once",
  })
  public clear(): void {
    for (let index = 0; index < this.count; index++) {
      destroyAt(this.data, index);
    }

    this.count = 0;
  }

  @Unsafe({
    uses: [UnsafeUse.Memory],
    reason: "after clear no cell is full, so the memory can go",
  })
  public free(): void {
    this.clear();
    release(this.data);
    this.data = allocate<T>(0);
    this.capacity = 0;
  }

  @Unsafe({
    uses: [UnsafeUse.Memory],
    reason: "the list dies: its full cells are freed once, then its memory",
  })
  public [Symbol.dispose](): void {
    this.clear();
    release(this.data);
  }

  @Unsafe({
    uses: [UnsafeUse.Memory],
    reason: "reallocate moves count full cells; the new place is bigger",
  })
  private grow(): void {
    let capacity: int = this.capacity * 2;
    if (capacity < 4) {
      capacity = 4;
    }

    this.data = reallocate(this.data, capacity);
    this.capacity = capacity;
  }
}
