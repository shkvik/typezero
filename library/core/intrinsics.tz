                                         data: ArrayBuffer): Promise<int>
export declare function subtlePbkdf2(hash: string, password: ArrayBuffer, salt: ArrayBuffer,
                                     iterations: double, bits: double): Promise<ArrayBuffer>
export declare function subtleHkdf(hash: string, key: ArrayBuffer, salt: ArrayBuffer,
                                   info: ArrayBuffer,
                                   bits: double): Promise<ArrayBuffer | undefined>
export declare function subtleAes(cipher: string, key: ArrayBuffer, encrypt: boolean,
                                  iv: ArrayBuffer, data: ArrayBuffer, tagLength: int, counter: int,
                                  additional: ArrayBuffer): Promise<ArrayBuffer | undefined>
export declare function subtleAesKw(key: ArrayBuffer, wrap: boolean,
                                    data: ArrayBuffer): Promise<ArrayBuffer | undefined>
export declare function subtleSign(key: object, kind: int, hash: string, saltLength: int,
                                   data: ArrayBuffer): Promise<ArrayBuffer | undefined>
export declare function subtleVerify(key: object, kind: int, hash: string, saltLength: int,
                                     signature: ArrayBuffer, data: ArrayBuffer): Promise<int>
