import {
  Raw,
  copyCells,
  findUnit,
  frameCells,
  isAscii,
  putUnit,
  sameCells,
  textCells,
  textClosed,
  textRoom,
  unitAt,
} from "tz:unsafe";

@InPlace()
export class Cells<C> {
  public readonly start: Raw<C>;
  public readonly count: int;

  public constructor(start: Raw<C>, count: int) {
    this.start = start;
    this.count = count;
  }
}

@InPlace()
class Piece {
  public readonly at: int;
  public readonly count: int;

  public constructor(at: int, count: int) {
    this.at = at;
    this.count = count;
  }
}

function isShort(count: int): boolean {
  return count <= 16;
}

function clamped(position: int, count: int): int {
  if (position < 0) {
    return 0;
  }
  if (position > count) {
    return count;
  }

  return position;
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "at + needle.count <= hay.count: both ranges are inside their cells",
})
function matches<H, N>(hay: Cells<H>, at: int, needle: Cells<N>): boolean {
  for (let index = 0; index < needle.count; index++) {
    if (unitAt(hay.start, at + index) != unitAt(needle.start, index)) {
      return false;
    }
  }

  return true;
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "from and end are inside the cells of hay",
})
function firstUnit<C>(hay: Cells<C>, from: int, end: int, unit: int): int {
  if (!isShort(end - from)) {
    return findUnit(hay.start, from, end, unit);
  }

  for (let at = from; at < end; at++) {
    if (unitAt(hay.start, at) == unit) {
      return at;
    }
  }

  return -1;
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "at + needle.count <= hay.count: both ranges are inside their cells",
})
function matchesSame<C>(hay: Cells<C>, at: int, needle: Cells<C>): boolean {
  if (isShort(needle.count)) {
    return matches(hay, at, needle);
  }

  return sameCells(hay.start, at, needle.start, 0, needle.count);
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "every start is at most hay.count - needle.count, so the range fits",
})
function foundSame<C>(hay: Cells<C>, needle: Cells<C>, from: int): int {
  const end = hay.count - needle.count + 1;
  if (needle.count == 0) {
    return from;
  }
  if (from >= end) {
    return -1;
  }

  const last = needle.count - 1;
  const head = unitAt(needle.start, 0);
  const tail = unitAt(needle.start, last);
  let at = firstUnit(hay, from, end, head);

  while (at >= 0) {
    const isEnding = unitAt(hay.start, at + last) == tail;
    if (isEnding && (last < 2 || matchesSame(hay, at, needle))) {
      return at;
    }

    at = firstUnit(hay, at + 1, end, head);
  }

  return -1;
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "every start is at most hay.count - needle.count, so the range fits",
})
function foundMixed<H, N>(hay: Cells<H>, needle: Cells<N>, from: int): int {
  const end = hay.count - needle.count + 1;
  if (needle.count == 0) {
    return from;
  }
  if (from >= end) {
    return -1;
  }

  const last = needle.count - 1;
  const head = unitAt(needle.start, 0);
  const tail = unitAt(needle.start, last);
  let at = firstUnit(hay, from, end, head);

  while (at >= 0) {
    const isEnding = unitAt(hay.start, at + last) == tail;
    if (isEnding && (last < 2 || matches(hay, at, needle))) {
      return at;
    }

    at = firstUnit(hay, at + 1, end, head);
  }

  return -1;
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "the cells of wanted live as long as this borrowed string",
})
function foundNarrow(hay: Cells<uint8>, wanted: Read<string>, from: int): int {
  const same = textCells<uint8>(wanted);
  if (same != undefined) {
    return foundSame(hay, new Cells<uint8>(same, wanted.length), from);
  }

  const other = textCells<uint16>(wanted);
  if (other != undefined) {
    return foundMixed(hay, new Cells<uint16>(other, wanted.length), from);
  }

  return -1;
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "the cells of wanted live as long as this borrowed string",
})
function foundWide(hay: Cells<uint16>, wanted: Read<string>, from: int): int {
  const other = textCells<uint8>(wanted);
  if (other != undefined) {
    return foundMixed(hay, new Cells<uint8>(other, wanted.length), from);
  }

  const same = textCells<uint16>(wanted);
  if (same != undefined) {
    return foundSame(hay, new Cells<uint16>(same, wanted.length), from);
  }

  return -1;
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "at + wanted.length <= hay.count is checked by the caller",
})
function hasNarrow(hay: Cells<uint8>, wanted: Read<string>, at: int): boolean {
  const same = textCells<uint8>(wanted);
  if (same != undefined) {
    return matchesSame(hay, at, new Cells<uint8>(same, wanted.length));
  }

  const other = textCells<uint16>(wanted);
  if (other != undefined) {
    return matches(hay, at, new Cells<uint16>(other, wanted.length));
  }

  return false;
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "at + wanted.length <= hay.count is checked by the caller",
})
function hasWide(hay: Cells<uint16>, wanted: Read<string>, at: int): boolean {
  const other = textCells<uint8>(wanted);
  if (other != undefined) {
    return matches(hay, at, new Cells<uint8>(other, wanted.length));
  }

  const same = textCells<uint16>(wanted);
  if (same != undefined) {
    return matchesSame(hay, at, new Cells<uint16>(same, wanted.length));
  }

  return false;
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "the cells live as long as the two borrowed strings",
})
function hasAt(text: Read<string>, wanted: Read<string>, at: int): boolean {
  if (at < 0 || at + wanted.length > text.length) {
    return false;
  }

  const narrow = textCells<uint8>(text);
  if (narrow != undefined) {
    return hasNarrow(new Cells<uint8>(narrow, text.length), wanted, at);
  }

  const wide = textCells<uint16>(text);
  if (wide != undefined) {
    return hasWide(new Cells<uint16>(wide, text.length), wanted, at);
  }

  return false;
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "the cells live as long as the two borrowed strings",
})
export function indexOf(
  text: Read<string>,
  wanted: Read<string>,
  position: int,
  hasPosition: boolean,
): int {
  let from = 0;

  if (hasPosition) {
    from = clamped(position, text.length);
  }

  const narrow = textCells<uint8>(text);
  if (narrow != undefined) {
    return foundNarrow(new Cells<uint8>(narrow, text.length), wanted, from);
  }

  const wide = textCells<uint16>(text);
  if (wide != undefined) {
    return foundWide(new Cells<uint16>(wide, text.length), wanted, from);
  }

  return -1;
}

export function includes(
  text: Read<string>,
  wanted: Read<string>,
  position: int,
  hasPosition: boolean,
): boolean {
  return indexOf(text, wanted, position, hasPosition) >= 0;
}

export function startsWith(
  text: Read<string>,
  wanted: Read<string>,
  position: int,
  hasPosition: boolean,
): boolean {
  let at = 0;

  if (hasPosition) {
    at = clamped(position, text.length);
  }

  return hasAt(text, wanted, at);
}

export function endsWith(
  text: Read<string>,
  wanted: Read<string>,
  position: int,
  hasPosition: boolean,
): boolean {
  let end = text.length;

  if (hasPosition) {
    end = clamped(position, text.length);
  }

  return hasAt(text, wanted, end - wanted.length);
}

function dollar(): int {
  return 36;
}

function isMark(unit: int): boolean {
  return unit == 36 || unit == 38 || unit == 96 || unit == 39;
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "index + 1 < fill.count: both cells are inside fill",
})
function markAt<R>(fill: Cells<R>, index: int): int {
  if (unitAt(fill.start, index) != dollar()) {
    return -1;
  }

  const next = unitAt(fill.start, index + 1);
  if (isMark(next)) {
    return next;
  }

  return -1;
}

function markSize(mark: int, found: Piece, count: int): int {
  if (mark == 36) {
    return 1;
  }
  if (mark == 38) {
    return found.count;
  }
  if (mark == 96) {
    return found.at;
  }

  return count - found.at - found.count;
}

function fillSize<R>(fill: Cells<R>, found: Piece, count: int): int {
  let size = fill.count;
  let index = 0;

  while (index + 1 < fill.count) {
    const mark = markAt(fill, index);
    if (mark < 0) {
      index += 1;

      continue;
    }

    size += markSize(mark, found, count) - 2;
    index += 2;
  }

  return size;
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "into has room for markSize cells from used; found is inside hay",
})
function marked<H, T>(
  hay: Cells<H>,
  into: Raw<T>,
  used: int,
  found: Piece,
  mark: int,
): void {
  const after = found.at + found.count;

  if (mark == 36) {
    putUnit(into, used, dollar());
  } else if (mark == 38) {
    copyCells(hay.start, found.at, into, used, found.count);
  } else if (mark == 96) {
    copyCells(hay.start, 0, into, used, found.at);
  } else {
    copyCells(hay.start, after, into, used, hay.count - after);
  }
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "into has room for fillSize cells from used; found is inside hay",
})
function marksFilled<H, R, T>(
  hay: Cells<H>,
  fill: Cells<R>,
  into: Raw<T>,
  used: int,
  found: Piece,
): int {
  let plain = 0;
  let index = 0;
  let room = used;

  while (index + 1 < fill.count) {
    const mark = markAt(fill, index);
    if (mark < 0) {
      index += 1;

      continue;
    }

    copyCells(fill.start, plain, into, room, index - plain);
    room += index - plain;
    marked(hay, into, room, found, mark);
    room += markSize(mark, found, hay.count);
    plain = index + 2;
    index += 2;
  }

  copyCells(fill.start, plain, into, room, fill.count - plain);

  return room + fill.count - plain;
}

function keptPlaces(): int {
  return 32;
}

function nextAt<H, N>(hay: Cells<H>, needle: Cells<N>, at: int): int {
  let step = needle.count;

  if (step == 0) {
    step = 1;
  }
  if (at + step > hay.count) {
    return -1;
  }

  return foundMixed(hay, needle, at + step);
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "the first pass counts every cell the second pass writes",
})
function replaced<H, N, R, T>(
  hay: Cells<H>,
  needle: Cells<N>,
  fill: Cells<R>,
  text: Read<string>,
  isPlain: boolean,
): string {
  const first = foundMixed(hay, needle, 0);
  if (first < 0) {
    return text;
  }

  const hasMarks = firstUnit(fill, 0, fill.count, dollar()) >= 0;
  const matched = needle.count;
  const places = frameCells<int>(32);
  let found = 0;
  let total = hay.count;
  let at = first;

  while (at >= 0) {
    if (found < keptPlaces()) {
      putUnit(places, found, at);
    }

    found += 1;
    total -= matched;

    if (hasMarks) {
      total += fillSize(fill, new Piece(at, matched), hay.count);
    } else {
      total += fill.count;
    }

    at = nextAt(hay, needle, at);
  }

  const into = textRoom<T>(total);
  let copied = 0;
  let used = 0;

  for (let index = 0; index < found; index++) {
    if (index < keptPlaces()) {
      at = unitAt(places, index);
    } else {
      at = nextAt(hay, needle, at);
    }

    copyCells(hay.start, copied, into, used, at - copied);
    used += at - copied;

    if (hasMarks) {
      used = marksFilled(hay, fill, into, used, new Piece(at, matched));
    } else {
      copyCells(fill.start, 0, into, used, fill.count);
      used += fill.count;
    }

    copied = at + matched;
  }

  copyCells(hay.start, copied, into, used, hay.count - copied);

  return textClosed(into, total, isPlain);
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "the cells of replacement live as long as this borrowed string",
})
function byFill<H, N>(
  hay: Cells<H>,
  needle: Cells<N>,
  text: Read<string>,
  replacement: Read<string>,
  isPlain: boolean,
): string {
  const narrow = textCells<uint8>(replacement);
  if (narrow != undefined) {
    const fill = new Cells<uint8>(narrow, replacement.length);

    return replaced<H, N, uint8, H>(hay, needle, fill, text, isPlain);
  }

  const wide = textCells<uint16>(replacement);
  if (wide != undefined) {
    const fill = new Cells<uint16>(wide, replacement.length);

    return replaced<H, N, uint16, uint16>(hay, needle, fill, text, isPlain);
  }

  return text;
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "the cells of pattern live as long as this borrowed string",
})
function byNeedle<H>(
  hay: Cells<H>,
  text: Read<string>,
  pattern: Read<string>,
  replacement: Read<string>,
  isPlain: boolean,
): string {
  const narrow = textCells<uint8>(pattern);
  if (narrow != undefined) {
    const needle = new Cells<uint8>(narrow, pattern.length);

    return byFill(hay, needle, text, replacement, isPlain);
  }

  const wide = textCells<uint16>(pattern);
  if (wide != undefined) {
    const needle = new Cells<uint16>(wide, pattern.length);

    return byFill(hay, needle, text, replacement, isPlain);
  }

  return text;
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "the cells live as long as the three borrowed strings",
})
export function replaceAll(
  text: Read<string>,
  pattern: Read<string>,
  replacement: Read<string>,
): string {
  const isPlain = isAscii(text) && isAscii(replacement);
  const narrow = textCells<uint8>(text);
  if (narrow != undefined) {
    const hay = new Cells<uint8>(narrow, text.length);

    return byNeedle(hay, text, pattern, replacement, isPlain);
  }

  const wide = textCells<uint16>(text);
  if (wide != undefined) {
    const hay = new Cells<uint16>(wide, text.length);

    return byNeedle(hay, text, pattern, replacement, isPlain);
  }

  return text;
}
