/**
 * A moment in time: the milliseconds since the start of 1970 in UTC. The
 * methods without `UTC` in the name read and set it in the time zone of the
 * system. A month counts from 0, a day of the week from Sunday as 0. A setter
 * gives the new milliseconds. Two dates are subtracted and compared directly:
 * `later - earlier` is the milliseconds between them.
 */
export declare class Date {
  /**
   * This moment; the moment of the milliseconds since the start of 1970; a
   * copy of a date; the date written in a text of the code (a text known
   * only when the program runs is read by `Date.parse`); or a date and time
   * in the local zone, where a month counts from 0.
   * @example new Date(2026, 10, 19)
   */
  public constructor();
  public constructor(milliseconds: int);
  public constructor(date: Read<Date>);
  public constructor(text: string);
  public constructor(
    year: int,
    month: int,
    day?: int,
    hours?: int,
    minutes?: int,
    seconds?: int,
    milliseconds?: int,
  );

  /** The milliseconds since the start of 1970 in UTC. */
  public readonly getTime(): int;
  /** The same as `getTime`. */
  public readonly valueOf(): int;

  public readonly getFullYear(): int;
  public readonly getMonth(): int;
  /** The day of the month, from 1. */
  public readonly getDate(): int;
  /** The day of the week, Sunday is 0. */
  public readonly getDay(): int;
  public readonly getHours(): int;
  public readonly getMinutes(): int;
  public readonly getSeconds(): int;
  public readonly getMilliseconds(): int;
  /** The minutes from the local time to UTC: -180 for UTC+3. */
  public readonly getTimezoneOffset(): int;

  public readonly getUTCFullYear(): int;
  public readonly getUTCMonth(): int;
  public readonly getUTCDate(): int;
  public readonly getUTCDay(): int;
  public readonly getUTCHours(): int;
  public readonly getUTCMinutes(): int;
  public readonly getUTCSeconds(): int;
  public readonly getUTCMilliseconds(): int;

  public setTime(time: int): int;
  public setMilliseconds(milliseconds: int): int;
  public setSeconds(seconds: int, milliseconds?: int): int;
  public setMinutes(minutes: int, seconds?: int, milliseconds?: int): int;
  public setHours(
    hours: int,
    minutes?: int,
    seconds?: int,
    milliseconds?: int,
  ): int;
  public setDate(day: int): int;
  public setMonth(month: int, day?: int): int;
  public setFullYear(year: int, month?: int, day?: int): int;

  public setUTCMilliseconds(milliseconds: int): int;
  public setUTCSeconds(seconds: int, milliseconds?: int): int;
  public setUTCMinutes(minutes: int, seconds?: int, milliseconds?: int): int;
  public setUTCHours(
    hours: int,
    minutes?: int,
    seconds?: int,
    milliseconds?: int,
  ): int;
  public setUTCDate(day: int): int;
  public setUTCMonth(month: int, day?: int): int;
  public setUTCFullYear(year: int, month?: int, day?: int): int;

  /** The date in UTC as `2026-11-19T10:00:00.000Z`. */
  public readonly toISOString(): string;
  /** The same as `toISOString`. */
  public readonly toJSON(): string;
  public readonly toUTCString(): string;
  public readonly toString(): string;
  public readonly toDateString(): string;
  public readonly toTimeString(): string;
  /** The date and time as the language writes them. */
  public readonly toLocaleString(
    locale?: Read<string | Intl.Locale>,
    options?: Read<object>,
  ): string;
  public readonly toLocaleDateString(
    locale?: Read<string | Intl.Locale>,
    options?: Read<object>,
  ): string;
  public readonly toLocaleTimeString(
    locale?: Read<string | Intl.Locale>,
    options?: Read<object>,
  ): string;

  /** The milliseconds of this moment. */
  public static now(): int;
  /** The milliseconds of the date and time given in UTC. */
  public static UTC(
    year: int,
    month?: int,
    day?: int,
    hours?: int,
    minutes?: int,
    seconds?: int,
    milliseconds?: int,
  ): int;
  /**
   * The milliseconds of the date written in a text.
   * @example Date.parse("2026-11-19T10:00:00Z")
   */
  public static parse(text: string): Result<int, DateError>;
}
