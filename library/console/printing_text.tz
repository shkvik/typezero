
function breakLength(): int {
  return 80;
}

function compactLevel(): int {
  return 3;
}

function depthLimit(): int {
  return 2;
}

function arrayLimit(): int {
  return 100;
}

function stringLimit(): int {
  return 10000;
}

function lineMinimum(): int {
  return 16;
}

