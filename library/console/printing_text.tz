  129351, 129535, 129648, 129791, 131072, 196605, 196608, 262141,
];

const kControlTexts: string[] = [
  "\\x00",
  "\\x01",
  "\\x02",
  "\\x03",
  "\\x04",
  "\\x05",
  "\\x06",
  "\\x07",
  "\\b",
  "\\t",
  "\\n",
  "\\x0B",
  "\\f",
  "\\r",
  "\\x0E",
  "\\x0F",
  "\\x10",
  "\\x11",
  "\\x12",
  "\\x13",
  "\\x14",
  "\\x15",
  "\\x16",
  "\\x17",
  "\\x18",
  "\\x19",
  "\\x1A",
  "\\x1B",
  "\\x1C",
  "\\x1D",
  "\\x1E",
  "\\x1F",
];

const kUpperDigits = "0123456789ABCDEF";
const kLowerDigits = "0123456789abcdef";

function isInRanges(ranges: Read<int[]>, point: int): boolean {
  let low = 0;
  let high = ranges.length / 2;

  while (low < high) {
    const middle = (low + high) / 2;
    const first = ranges[middle * 2] ?? 0;
    const last = ranges[middle * 2 + 1] ?? 0;

    if (point < first) {
      high = middle;
    } else if (point > last) {
      low = middle + 1;
    } else {
      return true;
    }
  }

  return false;
}

function isHighSurrogate(unit: int): boolean {
  return unit >= 55296 && unit <= 56319;
}

function isLowSurrogate(unit: int): boolean {
  return unit >= 56320 && unit <= 57343;
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "the cells of the text hold its length units",
})
function textWidth(text: Read<string>): int {
  const narrow = textCells<uint8>(text);
  const count = text.length;

  if (narrow != undefined) {
    let width = 0;

    for (let index = 0; index < count; index++) {
      const unit = unitAt(narrow, index);

      if (unit > 31 && (unit < 127 || unit > 159)) {
        width += 1;
      }
    }

    return width;
  }

  const wide = textCells<uint16>(text);
  if (wide == undefined) {
    return 0;
  }

  let width = 0;
  let index = 0;

  while (index < count) {
    let point = unitAt(wide, index);

    if (isHighSurrogate(point) && index + 1 < count) {
      const next = unitAt(wide, index + 1);

      if (isLowSurrogate(next)) {
        point = 65536 + (point - 55296) * 1024 + (next - 56320);
        index += 1;
      }
    }

    index += 1;

    if (!isInRanges(kZeroWidth, point)) {
      width += 1;

      if (isInRanges(kWide, point)) {
        width += 1;
      }
    }
  }

  return width;
}

function spaces(count: int): string {
  if (count <= 0) {
    return "";
  }

  return " ".repeat(count);
}

function plural(count: int): string {
  if (count > 1) {
    return "s";
  }

  return "";
}

function hasUnit(text: Read<string>, from: int, to: int, unit: int): boolean {
  const found = text.indexOf(String.fromCharCode(unit), from);

  return found >= 0 && found < to;
}

function hasDollarBrace(text: Read<string>, from: int, to: int): boolean {
  const found = text.indexOf("${", from);

  return found >= 0 && found + 1 < to;
}

function quoteFor(text: Read<string>, from: int, to: int): int {
  if (!hasUnit(text, from, to, 39)) {
    return 39;
  }
  if (!hasUnit(text, from, to, 34)) {
    return 34;
  }
  if (!hasUnit(text, from, to, 96) && !hasDollarBrace(text, from, to)) {
    return 96;
  }

  return 39;
}

function hexUnit(digits: Read<string>, unit: int, shift: int): int {
  return digits.charCodeAt((unit >> shift) & 15) ?? 0;
}

function unitEscaped(out: Mut<TextBuilder>, unit: int, quote: int): boolean {
  if (unit < 32) {
    out.add(kControlTexts[unit] ?? "");

    return true;
  }
  if (unit == 39 && quote == 39) {
    out.add("\\'");

    return true;
  }
  if (unit == 92) {
    out.add("\\\\");

    return true;
  }
  if (unit >= 127 && unit <= 159) {
    out.add("\\x");
    out.addUnit(hexUnit(kUpperDigits, unit, 4));
    out.addUnit(hexUnit(kUpperDigits, unit, 0));

    return true;
  }

  return false;
}

function loneEscaped(out: Mut<TextBuilder>, unit: int): void {
  out.add("\\u");
  out.addUnit(hexUnit(kLowerDigits, unit, 12));
  out.addUnit(hexUnit(kLowerDigits, unit, 8));
  out.addUnit(hexUnit(kLowerDigits, unit, 4));
  out.addUnit(hexUnit(kLowerDigits, unit, 0));
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "the cells of the text hold its length units",
})
function unitIn(
  narrow: Raw<uint8> | undefined,
  wide: Raw<uint16> | undefined,
  index: int,
): int {
  if (narrow != undefined) {
    return unitAt(narrow, index);
  }
  if (wide != undefined) {
    return unitAt(wide, index);
  }

  return 0;
}

@Unsafe({
  uses: [UnsafeUse.Memory],
  reason: "the cells of the text hold its length units",
})
function escapedRange(
  out: Mut<TextBuilder>,
  text: Read<string>,
  from: int,
  to: int,
): void {
  const quote = quoteFor(text, from, to);
  const narrow = textCells<uint8>(text);
  const wide = textCells<uint16>(text);
  let run = from;
  let index = from;

  out.addUnit(quote);

  while (index < to) {
    const unit = unitIn(narrow, wide, index);
    const isQuote = unit == 39 && quote == 39;
    const isSpecial = unit < 32 || isQuote || unit == 92;

    if (isSpecial || (unit >= 127 && unit <= 159)) {
      out.addPart(text, run, index);
      unitEscaped(out, unit, quote);
      run = index + 1;
    } else if (unit >= 55296 && unit <= 57343) {
      const isPair = isHighSurrogate(unit) && index + 1 < to;

      if (isPair && isLowSurrogate(unitIn(narrow, wide, index + 1))) {
        index += 1;
      } else {
        out.addPart(text, run, index);
        loneEscaped(out, unit);
        run = index + 1;
      }
    }

    index += 1;
  }

  out.addPart(text, run, to);
  out.addUnit(quote);
}

function escapedText(text: Read<string>): string {
  const out = new TextBuilder();

  escapedRange(out, text, 0, text.length);

  return out.taken();
}

function stringFormatted(
  context: Read<PrintContext>,
  out: Mut<TextBuilder>,
  text: Read<string>,
): void {
  let length = text.length;
  let remaining = 0;

  if (length > stringLimit()) {
    remaining = length - stringLimit();
    length = stringLimit();
  }

  const room = breakLength() - context.indentation - 4;

  if (length > lineMinimum() && length > room) {
    let start = 0;

    while (start < length) {
      let end = text.indexOf("\n", start) + 1;

      if (end <= 0 || end > length) {
        end = length;
      }
      if (start > 0) {
        out.add(" +\n");
        out.addSpaces(context.indentation + 2);
      }

      escapedRange(out, text, start, end);
      start = end;
    }
  } else {
    escapedRange(out, text, 0, length);
  }
  if (remaining > 0) {
    out.add(`... ${remaining} more character${plural(remaining)}`);
  }
}
