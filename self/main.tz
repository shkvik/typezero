import { LoadCommand } from "./cli/load/load-command/load-command.tz";
import { kLoadWord } from "./cli/load/load-command/const/load-command.const.tz";
import { NamesCommand } from "./cli/names/names-command/names-command.tz";
import { kNamesWord } from "./cli/names/names-command/const/names-command.const.tz";
import { ScopesCommand } from "./cli/scopes/scopes-command/scopes-command.tz";
import { kScopesWord } from "./cli/scopes/scopes-command/const/scopes-command.const.tz";
import { SyntaxCommand } from "./cli/syntax/syntax-command/syntax-command.tz";
import { TypesCommand } from "./cli/types/types-command/types-command.tz";
import { kTypesWord } from "./cli/types/types-command/const/types-command.const.tz";

switch (process.argv[2]) {
  case kLoadWord: {
    const command = new LoadCommand(process.argv);

    command.run();

    break;
  }
  case kNamesWord: {
    const command = new NamesCommand(process.argv);

    command.run();

    break;
  }
  case kScopesWord: {
    const command = new ScopesCommand(process.argv);

    command.run();

    break;
  }
  case kTypesWord: {
    const command = new TypesCommand(process.argv);

    command.run();

    break;
  }
  default: {
    const command = new SyntaxCommand(process.argv);

    command.run();

    break;
  }
}
