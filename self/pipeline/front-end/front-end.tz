import { SourceError } from "../../diagnostic/types/message.types.tz";
import { LoadResult } from "../../load/loader/types/loader.types.tz";
import { ModuleTypes } from "../../program/module-types/types/module-types.types.tz";
import { Module, Program } from "../../program/module/types/module.types.tz";
import { TypeStore } from "../../program/type/type-store/type-store.tz";
import { ExpressionTypes } from "../../semantic/code/expression-types/expression-types.tz";
import { DeclarationTypes } from "../../semantic/declaration/declaration-types/declaration-types.tz";
import { ModuleBinder } from "../../semantic/declaration/module-binder/module-binder.tz";
import { NameResolver } from "../../semantic/declaration/name-resolver/name-resolver.tz";
import { TypeSystem } from "../../semantic/types/type-system/type-system.tz";
import { kRecoverableCodes } from "./const/front-end.const.tz";
import { kEmptyList } from "../../program/ast/ast-tree/const/ast-tree.const.tz";
import { kCheckedLibraries } from "../../semantic/declaration/module-questions/const/module-questions.const.tz";
import { CheckedProgram, ModuleProblems } from "./types/front-end.types.tz";

export class FrontEnd {
  public readonly isCheckable(loaded: Read<LoadResult>): boolean {
    const isReadable =
      loaded.unreadable.length == 0 && loaded.packageErrors.length == 0;

    return isReadable && this.isRecoverable(loaded.program);
  }

  public readonly run(program: Own<Program>): CheckedProgram {
    const binder = new ModuleBinder();
    const names = binder.run(program);
    const resolver = new NameResolver(names);
    const resolved = resolver.run(program);
    const modules = resolved.map((scopes) => scopes.module);
    const checked = modules.filter((id) => this.isChecked(program, id));
    const store = new TypeStore();
    const types = new TypeSystem(store, program, resolved);
    const values = new ExpressionTypes(types);

    values.prepare();

    const steps: DeclarationTypes[] = [];

    for (const module of checked) {
      const declarations = this.declarationsOf(values.types.program, module);

      declarations.resolveAliases(values.types);
      steps.push(declarations);
    }

    const typed: ModuleTypes[] = [];

    for (const declarations of steps) {
      typed.push(declarations.run(values));
    }

    values.finish();

    return { modules, values, typed };
  }

  private readonly declarationsOf(
    program: Read<Program>,
    id: int,
  ): DeclarationTypes {
    const module = program.modules[id];
    if (module == undefined) {
      const empty = {
        itemsList: kEmptyList,
        importsList: kEmptyList,
        exportsList: kEmptyList,
      };

      return new DeclarationTypes(id, empty, true);
    }

    return new DeclarationTypes(id, module.file, module.source.isLibrary);
  }

  private readonly valueProblems(
    checked: Read<CheckedProgram>,
    module: int,
  ): SourceError[] {
    if (!this.isChecked(checked.values.types.program, module)) {
      return [];
    }

    return checked.values.problems(module);
  }

  private readonly isChecked(program: Read<Program>, id: int): boolean {
    const module = program.modules[id];
    if (module == undefined || !module.source.isLibrary) {
      return true;
    }

    return kCheckedLibraries.includes(module.name);
  }

  public readonly problems(checked: Read<CheckedProgram>): ModuleProblems[] {
    const found: ModuleProblems[] = [];

    for (const module of checked.modules) {
      const scopeErrors = checked.values.types.scopeErrors(module);
      const typeErrors = checked.values.types.problems(module);
      const valueErrors = this.valueProblems(checked, module);
      const errors: SourceError[] = scopeErrors.concat(typeErrors, valueErrors);

      errors.sort((first, second) => first.loc - second.loc);
      found.push({ module, errors });
    }

    return found;
  }

  private readonly isRecoverable(program: Read<Program>): boolean {
    const hasBroken = program.builtins.some(
      (builtin) => builtin.parsed.errors.length > 0,
    );
    if (hasBroken) {
      return false;
    }

    return program.order.every((id) =>
      this.isRecoverableModule(program.modules[id]),
    );
  }

  private readonly isRecoverableModule(
    module: Read<Module | undefined>,
  ): boolean {
    if (module == undefined) {
      return true;
    }

    const isOwnRecoverable = module.errors.every((error) =>
      kRecoverableCodes.includes(error.code),
    );
    const declared = module.declaration?.errors;
    const isDeclaredRecoverable =
      declared == undefined ||
      declared.every((error) => kRecoverableCodes.includes(error.code));

    return isOwnRecoverable && isDeclaredRecoverable;
  }
}
