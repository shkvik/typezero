import { Module } from "../../module/types/module.types.tz";
import { Type } from "../../type/types/type.types.tz";

export enum DeclarationForm {
  Value,
  TypeAlias,
  Enum,
}

export type TypedDeclaration = {
  readonly form: DeclarationForm;
  readonly name: string;
  readonly loc: int;
  readonly type: Type;
};

export type ModuleTypes = {
  readonly module: Module;
  readonly declarations: TypedDeclaration[];
};
