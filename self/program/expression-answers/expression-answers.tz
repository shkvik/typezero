import { Expr } from "../ast/types/ast.types.expressions.tz";
import { Type } from "../type/types/type.types.tz";

export class ExpressionAnswers {
  private visited: Cell<Set<Expr>>;
  private types: Cell<Map<Expr, Type>>;
  private tried: Cell<Map<Expr, Type>>;
  private folded: Cell<Map<Expr, decimal>>;

  public constructor() {
    this.visited = new Set<Expr>();
    this.types = new Map<Expr, Type>();
    this.tried = new Map<Expr, Type>();
    this.folded = new Map<Expr, decimal>();
  }

  public readonly visit(expr: Expr): void {
    this.visited.add(expr);
  }

  public readonly isVisited(expr: Expr): boolean {
    return this.visited.has(expr);
  }

  public readonly answer(expr: Expr, type: Type): void {
    this.types.set(expr, type);
  }

  public readonly tryAnswer(expr: Expr, type: Type): void {
    if (!this.tried.has(expr)) {
      this.tried.set(expr, type);
    }
  }

  public readonly typeOf(expr: Expr): Type | undefined {
    return this.types.get(expr) ?? this.tried.get(expr);
  }

  public readonly fold(expr: Expr, value: decimal): void {
    this.folded.set(expr, value);
  }

  public readonly foldedOf(expr: Expr): decimal | undefined {
    return this.folded.get(expr);
  }
}

export type InternedExpressionAnswers = Interned<ExpressionAnswers>;
