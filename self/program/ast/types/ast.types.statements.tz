import {
  ClassDecl,
  EnumDecl,
  HandleDecl,
  TypeAliasDecl,
} from "./ast.types.classes.tz";
import { FunctionDecl } from "./ast.types.functions.tz";
import { VarDeclarator } from "./ast.types.patterns.tz";
import { AstList } from "./ast.types.span.tz";

export enum StmtKind {
  Block,
  VarDecl,
  Function,
  Expr,
  If,
  While,
  DoWhile,
  For,
  ForOf,
  Switch,
  Labeled,
  Return,
  Break,
  Continue,
  Empty,
  Debugger,
  TypeAlias,
  Enum,
  Class,
  Handle,
}

export type BlockStmt = {
  readonly kind: StmtKind.Block;
  readonly id: int;
  readonly loc: int;
  readonly bodyList: AstList;
  readonly end?: int;
};

export type VarDeclStmt = {
  readonly kind: StmtKind.VarDecl;
  readonly id: int;
  readonly loc: int;
  readonly isConst: boolean;
  readonly isUsing: boolean;
  readonly declsList: AstList;
};

export type ExprStmt = {
  readonly kind: StmtKind.Expr;
  readonly id: int;
  readonly loc: int;
  readonly exprId: int;
};

export type IfStmt = {
  readonly kind: StmtKind.If;
  readonly id: int;
  readonly loc: int;
  readonly condId: int;
  readonly thenStmtId: int;
  readonly elseStmtId?: int;
};

export type WhileStmt = {
  readonly kind: StmtKind.While;
  readonly id: int;
  readonly loc: int;
  readonly condId: int;
  readonly bodyId: int;
};

export type DoWhileStmt = {
  readonly kind: StmtKind.DoWhile;
  readonly id: int;
  readonly loc: int;
  readonly bodyId: int;
  readonly condId: int;
};

export type ForStmt = {
  readonly kind: StmtKind.For;
  readonly id: int;
  readonly loc: int;
  readonly initId?: int;
  readonly condId?: int;
  readonly stepId?: int;
  readonly bodyId?: int;
};

export type ForOfStmt = {
  readonly kind: StmtKind.ForOf;
  readonly id: int;
  readonly loc: int;
  readonly isConst: boolean;
  readonly isUsing: boolean;
  readonly keys: boolean;
  readonly isAwait: boolean;
  readonly binding: VarDeclarator;
  readonly iterableId: int;
  readonly bodyId: int;
};

export type SwitchCase = {
  readonly loc: int;
  readonly testId?: int;
  readonly bodyList: AstList;
};

export type SwitchStmt = {
  readonly kind: StmtKind.Switch;
  readonly id: int;
  readonly loc: int;
  readonly discriminantId: int;
  readonly casesList: AstList;
};

export type LabeledStmt = {
  readonly kind: StmtKind.Labeled;
  readonly id: int;
  readonly loc: int;
  readonly label: string;
  readonly bodyId: int;
};

export type ReturnStmt = {
  readonly kind: StmtKind.Return;
  readonly id: int;
  readonly loc: int;
  readonly valueId?: int;
};

export type JumpStmt = {
  readonly kind: StmtKind.Break | StmtKind.Continue;
  readonly id: int;
  readonly loc: int;
  readonly label: string;
};

export type MarkerStmt = {
  readonly kind: StmtKind.Empty | StmtKind.Debugger;
  readonly id: int;
  readonly loc: int;
};

export type Stmt =
  | BlockStmt
  | VarDeclStmt
  | FunctionDecl
  | ExprStmt
  | IfStmt
  | WhileStmt
  | DoWhileStmt
  | ForStmt
  | ForOfStmt
  | SwitchStmt
  | LabeledStmt
  | ReturnStmt
  | JumpStmt
  | MarkerStmt
  | TypeAliasDecl
  | EnumDecl
  | ClassDecl
  | HandleDecl;
