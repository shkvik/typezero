import { AstList, Span } from "./ast.types.span.tz";

export enum TypeRefKind {
  Name,
  Array,
  Union,
  Generic,
  Function,
  Object,
  Tuple,
  Literal,
  Predicate,
  KeyOf,
  Indexed,
  TypeOf,
  Mapped,
  Conditional,
  Infer,
  Template,
  Intersection,
  Invalid,
}

export type PlainTypeForm = {
  readonly kind:
    | TypeRefKind.Name
    | TypeRefKind.Union
    | TypeRefKind.Generic
    | TypeRefKind.KeyOf
    | TypeRefKind.Indexed
    | TypeRefKind.Conditional
    | TypeRefKind.Infer
    | TypeRefKind.Intersection
    | TypeRefKind.Invalid;
};

export type ArrayTypeForm = {
  readonly kind: TypeRefKind.Array;
  readonly readonly: boolean;
};

export type FunctionTypeParam = {
  readonly name: string;
  readonly loc: int;
  readonly optional: boolean;
  readonly typeId: int;
};

export type FunctionTypeForm = {
  readonly kind: TypeRefKind.Function;
  readonly paramsList: AstList;
  readonly rest: boolean;
  readonly resultId?: int;
};

export type ObjectTypeField = {
  readonly name: string;
  readonly loc: int;
  readonly optional: boolean;
  readonly readonly: boolean;
  readonly method: boolean;
  readonly isReadonlyMethod?: boolean;
  readonly call: boolean;
  readonly typeParamsList: AstList;
  readonly typeId: int;
};

export type ObjectTypeForm = {
  readonly kind: TypeRefKind.Object;
  readonly fieldsList: AstList;
};

export type TupleElement = { readonly typeId: int; readonly spread: boolean };

export type TupleTypeForm = {
  readonly kind: TypeRefKind.Tuple;
  readonly elementsList: AstList;
  readonly readonly: boolean;
};

export type LiteralTypeForm = {
  readonly kind: TypeRefKind.Literal;
  readonly text: string;
  readonly number: double;
  readonly integer: boolean;
  readonly beyondDouble: boolean;
};

export type PredicateTypeForm = {
  readonly kind: TypeRefKind.Predicate;
  readonly asserts: boolean;
};

export type TypeOfTypeForm = {
  readonly kind: TypeRefKind.TypeOf;
  readonly namesList: AstList;
};

export enum ModifierChange {
  None,
  Add,
  Remove,
}

export type MappedTypeForm = {
  readonly kind: TypeRefKind.Mapped;
  readonly optionalChange: ModifierChange;
  readonly readonlyChange: ModifierChange;
};

export type TemplateTypeForm = {
  readonly kind: TypeRefKind.Template;
  readonly textsList: AstList;
};

export type TypeForm =
  | PlainTypeForm
  | ArrayTypeForm
  | FunctionTypeForm
  | ObjectTypeForm
  | TupleTypeForm
  | LiteralTypeForm
  | PredicateTypeForm
  | TypeOfTypeForm
  | MappedTypeForm
  | TemplateTypeForm;

export type TypeRef = {
  readonly id: int;
  readonly form: TypeForm;
  readonly name: string;
  readonly loc: int;
  readonly argsList: AstList;
  readonly source?: Span;
};

export type TypeParamDecl = {
  readonly name: string;
  readonly loc: int;
  readonly constraintId?: int;
  readonly defaultTypeId?: int;
};
