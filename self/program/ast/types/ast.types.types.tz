import { Span } from "./ast.types.span.tz";

export enum TypeRefKind {
  Name,
  Array,
  Union,
  Generic,
  Function,
  Object,
  Tuple,
  Literal,
  Predicate,
  KeyOf,
  Indexed,
  TypeOf,
  Mapped,
  Conditional,
  Infer,
  Template,
  Intersection,
  Invalid,
}

export type PlainTypeForm = {
  readonly kind:
    | TypeRefKind.Name
    | TypeRefKind.Array
    | TypeRefKind.Union
    | TypeRefKind.Generic
    | TypeRefKind.KeyOf
    | TypeRefKind.Indexed
    | TypeRefKind.Conditional
    | TypeRefKind.Infer
    | TypeRefKind.Intersection
    | TypeRefKind.Invalid;
};

export type FunctionTypeParam = {
  readonly name: string;
  readonly loc: int;
  readonly optional: boolean;
  readonly type: TypeRef;
};

export type FunctionTypeForm = {
  readonly kind: TypeRefKind.Function;
  readonly params: FunctionTypeParam[];
  readonly rest: boolean;
  readonly result?: TypeRef;
};

export type ObjectTypeField = {
  readonly name: string;
  readonly loc: int;
  readonly optional: boolean;
  readonly readonly: boolean;
  readonly method: boolean;
  readonly call: boolean;
  readonly typeParams: TypeParamDecl[];
  readonly type: TypeRef;
};

export type ObjectTypeForm = {
  readonly kind: TypeRefKind.Object;
  readonly fields: ObjectTypeField[];
};

export type TupleElement = {
  readonly type: TypeRef;
  readonly spread: boolean;
};

export type TupleTypeForm = {
  readonly kind: TypeRefKind.Tuple;
  readonly elements: TupleElement[];
  readonly: boolean;
};

export type LiteralTypeForm = {
  readonly kind: TypeRefKind.Literal;
  readonly text: string;
  readonly number: double;
  readonly integer: boolean;
  readonly beyondDouble: boolean;
};

export type PredicateTypeForm = {
  readonly kind: TypeRefKind.Predicate;
  readonly asserts: boolean;
};

export type TypeOfTypeForm = {
  readonly kind: TypeRefKind.TypeOf;
  readonly names: string[];
};

export enum ModifierChange {
  None,
  Add,
  Remove,
}

export type MappedTypeForm = {
  readonly kind: TypeRefKind.Mapped;
  optionalChange: ModifierChange;
  readonly readonlyChange: ModifierChange;
};

export type TemplateTypeForm = {
  readonly kind: TypeRefKind.Template;
  readonly texts: string[];
};

export type TypeForm =
  | PlainTypeForm
  | FunctionTypeForm
  | ObjectTypeForm
  | TupleTypeForm
  | LiteralTypeForm
  | PredicateTypeForm
  | TypeOfTypeForm
  | MappedTypeForm
  | TemplateTypeForm;

export type TypeRef = {
  form: TypeForm;
  name: string;
  loc: int;
  args: TypeRef[];
  source?: Span;
};

export type TypeParamDecl = {
  readonly name: string;
  readonly loc: int;
  readonly constraint?: TypeRef;
  readonly defaultType?: TypeRef;
};
