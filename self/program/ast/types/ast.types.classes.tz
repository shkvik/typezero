import { AstList, Span } from "./ast.types.span.tz";
import { StmtKind } from "./ast.types.statements.tz";

export enum Access {
  Public,
  Protected,
  Private,
}

export enum MethodKind {
  Instance,
  Static,
  Constructor,
  Abstract,
}

export enum FieldKind {
  Instance,
  ArrowMethod,
  Static,
  Parameter,
}

export enum FieldPresence {
  Required,
  Optional,
  Definite,
}

export type Decorator = { readonly loc: int; readonly exprId: int };

export type TypeAliasDecl = {
  readonly kind: StmtKind.TypeAlias;
  readonly id: int;
  readonly loc: int;
  readonly name: string;
  readonly typeParamsList: AstList;
  readonly typeId: int;
  readonly basesList: AstList;
};

export type HandleDecl = {
  readonly kind: StmtKind.Handle;
  readonly id: int;
  readonly loc: int;
  readonly name: string;
  readonly typeParamsList: AstList;
};

export type EnumMember = {
  readonly name: string;
  readonly loc: int;
  readonly initId?: int;
};

export type EnumDecl = {
  readonly kind: StmtKind.Enum;
  readonly id: int;
  readonly loc: int;
  readonly name: string;
  readonly membersList: AstList;
};

export type ClassMember = {
  readonly access: Access;
  readonly isOverride: boolean;
  readonly isReadonly: boolean;
  readonly decoratorsList: AstList;
  readonly method: MethodKind;
};

export type ClassField = {
  readonly name: string;
  readonly loc: int;
  readonly typeId?: int;
  readonly initId?: int;
  readonly form: FieldKind;
  readonly presence: FieldPresence;
  readonly readonly: boolean;
  readonly isOverride: boolean;
  readonly access: Access;
  readonly decoratorsList: AstList;
  readonly accessor: boolean;
};

export type ClassDecl = {
  readonly kind: StmtKind.Class;
  readonly id: int;
  readonly loc: int;
  readonly name?: string;
  readonly isAbstract: boolean;
  readonly isPartial: boolean;
  readonly isInPlace: boolean;
  readonly baseId?: int;
  readonly baseExprId?: int;
  readonly baseArgsList: AstList;
  readonly interfacesList: AstList;
  readonly fieldsList: AstList;
  readonly methodsList: AstList;
  readonly constructorsList: AstList;
  readonly expression: boolean;
  readonly decoratorsList: AstList;
  readonly typeParamsList: AstList;
  readonly source?: Span;
};
