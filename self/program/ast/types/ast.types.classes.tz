import { Span } from "./ast.types.span.tz";
import { TypeParamDecl, TypeRef } from "./ast.types.types.tz";
import { Expr } from "./ast.types.expressions.tz";
import { StmtKind } from "./ast.types.statements.tz";
import { FunctionDecl } from "./ast.types.functions.tz";

export enum Access {
  Public,
  Protected,
  Private,
}

export enum MethodKind {
  Instance,
  Static,
  Constructor,
  Abstract,
}

export enum FieldKind {
  Instance,
  ArrowMethod,
  Static,
  Parameter,
}

export enum FieldPresence {
  Required,
  Optional,
  Definite,
}

export type Decorator = {
  readonly loc: int;
  readonly expr: Expr;
};

export type TypeAliasDecl = {
  readonly kind: StmtKind.TypeAlias;
  readonly loc: int;
  readonly name: string;
  readonly typeParams: TypeParamDecl[];
  readonly type: TypeRef;
  readonly bases: TypeRef[];
};

export type HandleDecl = {
  readonly kind: StmtKind.Handle;
  readonly loc: int;
  readonly name: string;
};

export type EnumMember = {
  readonly name: string;
  readonly loc: int;
  readonly init?: Expr;
};

export type EnumDecl = {
  readonly kind: StmtKind.Enum;
  readonly loc: int;
  readonly name: string;
  readonly members: EnumMember[];
};

export type ClassMember = {
  readonly access: Access;
  readonly isOverride: boolean;
  readonly decorators: Decorator[];
  readonly method: MethodKind;
};

export type ClassField = {
  readonly name: string;
  readonly loc: int;
  readonly type?: TypeRef;
  readonly init?: Expr;
  readonly form: FieldKind;
  readonly presence: FieldPresence;
  readonly readonly: boolean;
  readonly isOverride: boolean;
  readonly access: Access;
  readonly decorators: Decorator[];
  readonly accessor: boolean;
};

export type ClassDecl = {
  readonly kind: StmtKind.Class;
  readonly loc: int;
  name?: string;
  isAbstract: boolean;
  isPartial: boolean;
  readonly base?: TypeRef;
  readonly baseExpr?: Expr;
  readonly interfaces: TypeRef[];
  readonly fields: ClassField[];
  readonly methods: FunctionDecl[];
  readonly constructors: FunctionDecl[];
  readonly expression: boolean;
  decorators: Decorator[];
  readonly typeParams: TypeParamDecl[];
  source?: Span;
};
