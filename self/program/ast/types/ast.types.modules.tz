import { AstList } from "./ast.types.span.tz";

export enum ExportForm {
  Local,
  Re,
  All,
}

export type ModuleName = {
  readonly name: string;
  readonly loc: int;
  readonly as: string;
  readonly asLoc: int;
};

export type ModulePath = { readonly path: string; readonly loc: int };

export type WholeImport = {
  readonly name: string;
  readonly loc: int;
  readonly isDefault: boolean;
};

export type ImportDecl = {
  readonly loc: int;
  readonly namesList: AstList;
  readonly from: ModulePath;
  readonly whole?: WholeImport;
  readonly isPartList: boolean;
};

export type ExportDecl = {
  readonly loc: int;
  readonly form: ExportForm;
  readonly namesList: AstList;
  readonly from?: ModulePath;
};

export type SourceFile = {
  readonly itemsList: AstList;
  readonly importsList: AstList;
  readonly exportsList: AstList;
};
