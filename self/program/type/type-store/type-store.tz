import "./partial/type-store.partial.lists.tz";
import "./partial/type-store.partial.unions.tz";
import {
  ArrayType,
  Change,
  DictKind,
  FunctionShape,
  IteratorShape,
  LiteralKind,
  ObjectField,
  OperationKind,
  OperationShape,
  ParamWriter,
  PlainKind,
  TupleShape,
  Type,
  TypeId,
  TypeKind,
} from "../types/type.types.tz";
import { kIntegerBits, kPlainKinds } from "./const/type-store.const.tz";

export class TypeStore {
  private all: Type[];
  private plains: Map<TypeKind, Type>;
  private byKey: Map<string, Type>;
  private labels: Map<int, string>;
  private parents: Map<int, readonly Type[]>;
  private bases: Set<int>;
  private constraints: Map<int, Type>;
  private writers: Map<string, readonly ParamWriter[]>;
  private defined: Map<int, Type>;
  private partTable: Map<int, Type[]>;
  private itemTable: Map<int, Type[]>;
  private argTable: Map<int, Type[]>;
  private fieldTable: Map<int, ObjectField[]>;
  private textTable: Map<int, string[]>;
  private functionTable: Map<int, FunctionShape>;
  private iteratorTable: Map<int, IteratorShape>;
  private operationTable: Map<int, OperationShape>;
  private readonly errorPlain: Type;

  public constructor() {
    this.errorPlain = { id: 1, kind: TypeKind.Error };
    this.all = [this.errorPlain, this.errorPlain];
    this.plains = new Map<TypeKind, Type>();
    this.byKey = new Map<string, Type>();
    this.labels = new Map<int, string>();
    this.parents = new Map<int, readonly Type[]>();
    this.bases = new Set<int>();
    this.constraints = new Map<int, Type>();
    this.writers = new Map<string, readonly ParamWriter[]>();
    this.defined = new Map<int, Type>();
    this.partTable = new Map<int, Type[]>();
    this.itemTable = new Map<int, Type[]>();
    this.argTable = new Map<int, Type[]>();
    this.fieldTable = new Map<int, ObjectField[]>();
    this.textTable = new Map<int, string[]>();
    this.functionTable = new Map<int, FunctionShape>();
    this.iteratorTable = new Map<int, IteratorShape>();
    this.operationTable = new Map<int, OperationShape>();
    this.plains.set(TypeKind.Error, this.errorPlain);

    for (const kind of kPlainKinds) {
      this.madePlain(kind);
    }

    for (const bits of kIntegerBits) {
      this.madeInteger(bits, false);
      this.madeInteger(bits, true);
    }
  }

  public readonly typeOf(id: TypeId): Type {
    const type = this.all[id];
    if (type == undefined) {
      return this.errorPlain;
    }

    return type;
  }

  public definedOf(type: Type): Type {
    const known = this.defined.get(type.id);
    if (known != undefined) {
      return known;
    }

    const parts = this.partsBesideUndefined(type);
    if (parts.length == 0) {
      return type;
    }

    const defined = this.unionOf(parts);
    if (type.kind == TypeKind.Union && !type.recursive) {
      this.defined.set(type.id, defined);
    }

    return defined;
  }

  private readonly partsBesideUndefined(type: Type): Type[] {
    if (type.kind != TypeKind.Union) {
      return [type];
    }

    const parts = this.partsOf(type);

    return parts.filter((part) => part.kind != TypeKind.Undefined);
  }

  public inherit(instance: Type, parents: Own<Type[]>): void {
    this.parents.set(instance.id, parents);
  }

  public markBase(base: Type): void {
    this.bases.add(base.id);
  }

  public readonly isBase(type: Type): boolean {
    return this.bases.has(type.id);
  }

  public readonly hasParents(instance: Type): boolean {
    return this.parents.has(instance.id);
  }

  public readonly parentsOf(instance: Type): Type[] {
    const known = this.parents.get(instance.id);
    if (known == undefined) {
      return [];
    }

    return known.slice();
  }

  public constrain(parameter: Type, constraint: Type): void {
    this.constraints.set(parameter.id, constraint);
  }

  public readonly constraintOf(parameter: Type): Type | undefined {
    return this.constraints.get(parameter.id);
  }

  public label(type: Type, text: string): void {
    if (!this.labels.has(type.id)) {
      this.labels.set(type.id, text);
    }
  }

  public readonly labelOf(type: Type): string | undefined {
    return this.labels.get(type.id);
  }

  public readonly plain(kind: PlainKind): Type {
    const known = this.plains.get(kind);
    if (known != undefined) {
      return known;
    }

    return this.errorPlain;
  }

  public readonly integer(bits: int, unsigned: boolean): Type {
    const known = this.byKey.get(`int ${bits} ${unsigned}`);
    if (known != undefined) {
      return known;
    }

    return this.errorPlain;
  }

  private madePlain(kind: PlainKind): Type {
    const known = this.plains.get(kind);
    if (known != undefined) {
      return known;
    }

    const made: Type = { id: this.nextId(), kind };

    this.plains.set(kind, made);

    return this.recorded(made);
  }

  private madeInteger(bits: int, unsigned: boolean): Type {
    const key = `int ${bits} ${unsigned}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const made: Type = {
      id: this.nextId(),
      kind: TypeKind.Int,
      bits,
      unsigned,
      wraps: false,
    };

    return this.keep(key, made);
  }

  public wrapping(bits: int): Type {
    const key = `wrap ${bits}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const made: Type = {
      id: this.nextId(),
      kind: TypeKind.Int,
      bits,
      unsigned: true,
      wraps: true,
    };

    return this.keep(key, made);
  }

  public literal(literal: LiteralKind, text: string): Type {
    const word = this.literalWord(literal);
    const key = `literal ${word} ${text}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const made: Type = {
      id: this.nextId(),
      kind: TypeKind.Literal,
      literal,
      text,
    };

    return this.keep(key, made);
  }

  public sameArrayOf(array: ArrayType, item: Type): Type {
    if (array.lent == true) {
      return this.lentArrayOf(item);
    }
    if (array.readonly == true) {
      return this.readonlyArrayOf(item);
    }

    return this.arrayOf(item);
  }

  public lentArrayOf(item: Type): Type {
    const key = `lent array ${item.id}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const made: Type = {
      id: this.nextId(),
      kind: TypeKind.Array,
      itemId: item.id,
      lent: true,
    };

    return this.keep(key, made);
  }

  public readonly isLentArray(type: Type): boolean {
    return type.kind == TypeKind.Array && type.lent == true;
  }

  public readonlyArrayOf(item: Type): Type {
    const key = `readonly array ${item.id}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const made: Type = {
      id: this.nextId(),
      kind: TypeKind.Array,
      itemId: item.id,
      readonly: true,
    };

    return this.keep(key, made);
  }

  public arrayOf(item: Type): Type {
    const key = `array ${item.id}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const made: Type = {
      id: this.nextId(),
      kind: TypeKind.Array,
      itemId: item.id,
    };

    return this.keep(key, made);
  }

  public tupleOf(shape: Read<TupleShape>): Type {
    const ids = this.idsText(shape.items);
    const lent = shape.lent == true;
    const head = `tuple ${shape.readonly} ${shape.required} ${shape.rest}`;
    const key = `${head} ${lent} ${ids}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const id = this.nextId();
    const made: Type = {
      id,
      kind: TypeKind.Tuple,
      readonly: shape.readonly,
      required: shape.required,
      rest: shape.rest,
      lent,
    };

    this.itemTable.set(id, shape.items.slice());

    return this.keep(key, made);
  }

  public lentTuple(items: Own<Type[]>): Type {
    const required = items.length;

    return this.tupleOf({
      items,
      readonly: false,
      required,
      rest: -1,
      lent: true,
    });
  }

  public readonly isLentTuple(type: Type): boolean {
    return type.kind == TypeKind.Tuple && type.lent == true;
  }

  public plainTuple(items: Own<Type[]>): Type {
    const required = items.length;

    return this.tupleOf({
      items,
      readonly: false,
      required,
      rest: -1,
    });
  }

  public objectOf(fields: Own<ObjectField[]>): Type {
    const sorted = fields.slice();

    sorted.sort((first, second) => this.compareNames(first, second));

    const parts = sorted.map((field) => this.fieldKey(field));
    const key = `object ${parts.join(" ")}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const id = this.nextId();
    const made: Type = { id, kind: TypeKind.Object };

    this.fieldTable.set(id, fields);

    return this.keep(key, made);
  }

  public functionOf(shape: Own<FunctionShape>): Type {
    const params = shape.params.map(
      (param) => `${param.type.id}:${param.optional}`,
    );
    const self = shape.self?.id ?? 0;
    const head = `function ${shape.rest} ${self} ${shape.result.id}`;
    const key = `${head} ${params.join(" ")}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const id = this.nextId();
    const made: Type = { id, kind: TypeKind.Function };

    this.functionTable.set(id, shape);

    return this.keep(key, made);
  }

  public reserveObject(): Type {
    const id = this.nextId();
    const made: Type = { id, kind: TypeKind.Object };

    this.fieldTable.set(id, []);

    return this.recorded(made);
  }

  public fillObject(reserved: Type, fields: Read<ObjectField[]>): void {
    const known = this.fieldTable.get(reserved.id);
    if (reserved.kind == TypeKind.Object && known != undefined) {
      known.push(...fields);
    }
  }

  public reserveUnion(): Type {
    const id = this.nextId();
    const made: Type = { id, kind: TypeKind.Union, recursive: true };

    this.partTable.set(id, []);

    return this.recorded(made);
  }

  public fillUnion(reserved: Type, parts: Read<Type[]>): void {
    const known = this.partTable.get(reserved.id);
    if (reserved.kind == TypeKind.Union && known != undefined) {
      known.push(...parts);
    }
  }

  public instanceOf(
    module: int,
    loc: int,
    name: string,
    args: Own<Type[]>,
  ): Type {
    const ids = this.idsText(args);
    const key = `instance ${module} ${loc} ${ids}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const id = this.nextId();
    const made: Type = { id, kind: TypeKind.Instance, module, loc, name };

    this.argTable.set(id, args);

    return this.keep(key, made);
  }

  public typeParameter(module: int, loc: int, name: string): Type {
    const key = `parameter ${module} ${loc}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const id = this.nextId();
    const made: Type = { id, kind: TypeKind.TypeParameter, module, loc, name };

    return this.keep(key, made);
  }

  public resultOf(value: Type, error: Type): Type {
    const key = `result ${value.id} ${error.id}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const made: Type = {
      id: this.nextId(),
      kind: TypeKind.Result,
      valueId: value.id,
      errorId: error.id,
    };

    return this.keep(key, made);
  }

  public promiseOf(value: Type): Type {
    const key = `promise ${value.id}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const made: Type = {
      id: this.nextId(),
      kind: TypeKind.Promise,
      valueId: value.id,
    };

    return this.keep(key, made);
  }

  public classOf(instance: Type, exact: boolean): Type {
    const key = `class ${exact} ${instance.id}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const made: Type = {
      id: this.nextId(),
      kind: TypeKind.Class,
      instanceId: instance.id,
      exact,
    };

    return this.keep(key, made);
  }

  public iteratorOf(shape: IteratorShape): Type {
    const ids = this.idsText([shape.yielded, shape.returned, shape.sent]);
    const key = `iterator ${shape.async} ${ids}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const id = this.nextId();
    const made: Type = { id, kind: TypeKind.Iterator, isAsync: shape.async };

    this.iteratorTable.set(id, shape);

    return this.keep(key, made);
  }

  public dictOf(dict: DictKind, key: Type, value: Type): Type {
    const word = this.dictWord(dict);
    const text = `dict ${word} ${key.id} ${value.id}`;
    const known = this.byKey.get(text);
    if (known != undefined) {
      return known;
    }

    const made: Type = {
      id: this.nextId(),
      kind: TypeKind.Dict,
      dict,
      keyId: key.id,
      valueId: value.id,
    };

    return this.keep(text, made);
  }

  public templateOf(texts: Own<string[]>, parts: Own<Type[]>): Type {
    const sized = texts.map((text) => `${text.length}:${text}`);
    const ids = this.idsText(parts);
    const key = `template ${ids} ${sized.join("")}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const id = this.nextId();
    const made: Type = { id, kind: TypeKind.Template };

    this.textTable.set(id, texts);
    this.partTable.set(id, parts);

    return this.keep(key, made);
  }

  public operationOf(shape: Own<OperationShape>): Type {
    const op = this.operationWord(shape.op);
    const optional = this.changeWord(shape.optional);
    const readonly = this.changeWord(shape.readonly);
    const word = `${shape.word.length}:${shape.word}`;
    const ids = this.idsText(shape.operands);
    const key = `operation ${op} ${optional} ${readonly} ${word} ${ids}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const id = this.nextId();
    const made: Type = { id, kind: TypeKind.Operation };

    this.operationTable.set(id, shape);

    return this.keep(key, made);
  }

  private readonly operationWord(op: OperationKind): string {
    switch (op) {
      case OperationKind.KeyOf:
        return "keyof";
      case OperationKind.Indexed:
        return "indexed";
      case OperationKind.Mapped:
        return "mapped";
      case OperationKind.Conditional:
        return "conditional";
      case OperationKind.Intersection:
        return "intersection";
      case OperationKind.TextChange:
        return "text";
      default:
        return "alias";
    }
  }

  private readonly changeWord(change: Change): string {
    switch (change) {
      case Change.Add:
        return "add";
      case Change.Remove:
        return "remove";
      default:
        return "none";
    }
  }

  private readonly compareNames(first: ObjectField, second: ObjectField): int {
    if (first.name < second.name) {
      return -1;
    }
    if (first.name > second.name) {
      return 1;
    }

    return 0;
  }

  private readonly fieldKey(field: ObjectField): string {
    const name = `${field.name.length}:${field.name}`;
    const method = field.method ?? false;
    const reads = field.isReadonlyMethod ?? false;
    const kinds = `${method}:${reads}`;
    const flags = `${field.optional}:${field.readonly}:${kinds}`;

    return `${name}:${field.type.id}:${flags}`;
  }

  private readonly idsText(types: Read<Type[]>): string {
    const ids = types.map((type) => `${type.id}`);

    return ids.join(" ");
  }

  private readonly literalWord(literal: LiteralKind): string {
    switch (literal) {
      case LiteralKind.String:
        return "string";
      case LiteralKind.Int:
        return "int";
      case LiteralKind.Double:
        return "double";
      default:
        return "boolean";
    }
  }

  private readonly dictWord(dict: DictKind): string {
    switch (dict) {
      case DictKind.Record:
        return "record";
      case DictKind.Map:
        return "map";
      default:
        return "set";
    }
  }

  private keep(key: string, made: Type): Type {
    this.byKey.set(key, made);

    return this.recorded(made);
  }

  private recorded(made: Type): Type {
    this.all.push(made);

    return made;
  }

  private readonly nextId(): int {
    return this.all.length;
  }

  public setWriters(module: int, loc: int, writers: Own<ParamWriter[]>): void {
    this.writers.set(`${module} ${loc}`, writers);
  }

  public readonly writersOf(module: int, loc: int): ParamWriter[] | undefined {
    return this.writers.get(`${module} ${loc}`)?.slice();
  }
}
