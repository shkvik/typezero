import {
  ArrayType,
  Change,
  DictKind,
  FunctionShape,
  IteratorShape,
  LiteralKind,
  ObjectField,
  OperationKind,
  OperationShape,
  ParamWriter,
  PlainKind,
  TupleShape,
  Type,
  TypeKind,
} from "../types/type.types.tz";
import { kParentDepthLimit } from "./const/type-store.const.tz";

export class TypeStore {
  private plains: Cell<Map<TypeKind, Type>>;
  private byKey: Cell<Map<string, Type>>;
  private labels: Cell<Map<Type, string>>;
  private parents: Cell<Map<Type, readonly Type[]>>;
  private bases: Cell<Set<Type>>;
  private constraints: Cell<Map<Type, Type>>;
  private writers: Cell<Map<string, readonly ParamWriter[]>>;
  private interned: Cell<Set<int>>;
  private count: Cell<int>;

  public constructor() {
    this.plains = new Map<TypeKind, Type>();
    this.byKey = new Map<string, Type>();
    this.labels = new Map<Type, string>();
    this.parents = new Map<Type, readonly Type[]>();
    this.bases = new Set<Type>();
    this.constraints = new Map<Type, Type>();
    this.writers = new Map<string, readonly ParamWriter[]>();
    this.interned = new Set<int>();
    this.count = 0;
  }

  public readonly markInterned(type: Type): void {
    if (this.interned.has(type.id)) {
      return;
    }

    this.interned.add(type.id);

    if (type.kind == TypeKind.Union) {
      for (const part of type.parts) {
        this.markInterned(part);
      }
    }
  }

  public readonly isInterned(type: Type): boolean {
    return this.interned.has(type.id);
  }

  public readonly inherit(instance: Type, parents: Own<Type[]>): void {
    this.parents.set(instance, parents);
  }

  public readonly markBase(base: Type): void {
    this.bases.add(base);
  }

  public readonly isBase(type: Type): boolean {
    return this.bases.has(type);
  }

  public readonly hasParents(instance: Type): boolean {
    return this.parents.has(instance);
  }

  public readonly parentsOf(instance: Type): Type[] {
    return this.parents.get(instance) ?? [];
  }

  public readonly constrain(parameter: Type, constraint: Type): void {
    this.constraints.set(parameter, constraint);
  }

  public readonly constraintOf(parameter: Type): Type | undefined {
    return this.constraints.get(parameter);
  }

  public readonly label(type: Type, text: string): void {
    if (!this.labels.has(type)) {
      this.labels.set(type, text);
    }
  }

  public readonly labelOf(type: Type): string | undefined {
    return this.labels.get(type);
  }

  public readonly plain(kind: PlainKind): Type {
    const known = this.plains.get(kind);
    if (known != undefined) {
      return known;
    }

    const id = this.nextId();
    const made: Type = { id, kind };

    this.plains.set(kind, made);

    return made;
  }

  public readonly integer(bits: int, unsigned: boolean): Type {
    const key = `int ${bits} ${unsigned}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const id = this.nextId();
    const made: Type = {
      id,
      kind: TypeKind.Int,
      bits,
      unsigned,
      wraps: false,
    };

    return this.keep(key, made);
  }

  public readonly wrapping(bits: int): Type {
    const key = `wrap ${bits}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const id = this.nextId();
    const made: Type = {
      id,
      kind: TypeKind.Int,
      bits,
      unsigned: true,
      wraps: true,
    };

    return this.keep(key, made);
  }

  public readonly literal(literal: LiteralKind, text: string): Type {
    const word = this.literalWord(literal);
    const key = `literal ${word} ${text}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const id = this.nextId();
    const made: Type = { id, kind: TypeKind.Literal, literal, text };

    return this.keep(key, made);
  }

  public readonly sameArrayOf(array: ArrayType, item: Type): Type {
    if (array.readonly == true) {
      return this.readonlyArrayOf(item);
    }

    return this.arrayOf(item);
  }

  public readonly readonlyArrayOf(item: Type): Type {
    const key = `readonly array ${item.id}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const id = this.nextId();
    const made: Type = { id, kind: TypeKind.Array, item, readonly: true };

    return this.keep(key, made);
  }

  public readonly arrayOf(item: Type): Type {
    const key = `array ${item.id}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const id = this.nextId();
    const made: Type = { id, kind: TypeKind.Array, item };

    return this.keep(key, made);
  }

  public readonly tupleOf(shape: TupleShape): Type {
    const ids = this.idsText(shape.items);
    const head = `tuple ${shape.readonly} ${shape.required} ${shape.rest}`;
    const key = `${head} ${ids}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const id = this.nextId();
    const made: Type = {
      id,
      kind: TypeKind.Tuple,
      items: shape.items,
      readonly: shape.readonly,
      required: shape.required,
      rest: shape.rest,
    };

    return this.keep(key, made);
  }

  public readonly plainTuple(items: Own<Type[]>): Type {
    const required = items.length;

    return this.tupleOf({
      items,
      readonly: false,
      required,
      rest: -1,
    });
  }

  public readonly objectOf(fields: Own<ObjectField[]>): Type {
    const sorted = fields.slice();

    sorted.sort((first, second) => this.compareNames(first, second));

    const parts = sorted.map((field) => this.fieldKey(field));
    const key = `object ${parts.join(" ")}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const id = this.nextId();
    const made: Type = { id, kind: TypeKind.Object, fields };

    return this.keep(key, made);
  }

  public readonly functionOf(shape: Own<FunctionShape>): Type {
    const params = shape.params.map(
      (param) => `${param.type.id}:${param.optional}`,
    );
    const self = shape.self?.id ?? 0;
    const head = `function ${shape.rest} ${self} ${shape.result.id}`;
    const key = `${head} ${params.join(" ")}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const id = this.nextId();
    const made: Type = { id, kind: TypeKind.Function, shape };

    return this.keep(key, made);
  }

  public readonly unionOf(parts: Read<Type[]>): Type {
    const flat = this.flatParts(parts);
    const unknown = flat.find((part) => part.kind == TypeKind.Unknown);
    if (unknown != undefined) {
      return unknown;
    }

    const kept = this.orderedParts(flat);
    const only = kept[0];
    if (only == undefined) {
      return this.plain(TypeKind.Never);
    }
    if (kept.length == 1) {
      return only;
    }

    const sorted = kept.slice();

    sorted.sort((first, second) => first.id - second.id);

    const ids = this.idsText(sorted);
    const key = `union ${ids}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const id = this.nextId();
    const made: Type = {
      id,
      kind: TypeKind.Union,
      parts: kept,
      recursive: false,
    };

    return this.keep(key, made);
  }

  public readonly reserveObject(): Type {
    const id = this.nextId();

    return { id, kind: TypeKind.Object, fields: [] };
  }

  public readonly fillObject(reserved: Type, fields: Read<ObjectField[]>): void {
    if (reserved.kind != TypeKind.Object) {
      return;
    }

    reserved.fields = reserved.fields.concat(fields.slice());
  }

  public readonly reserveUnion(): Type {
    const id = this.nextId();

    return { id, kind: TypeKind.Union, parts: [], recursive: true };
  }

  public readonly fillUnion(reserved: Type, parts: Read<Type[]>): void {
    if (reserved.kind != TypeKind.Union) {
      return;
    }

    reserved.parts = reserved.parts.concat(parts.slice());
  }

  public readonly instanceOf(module: int, loc: int, name: string, args: Own<Type[]>): Type {
    const ids = this.idsText(args);
    const key = `instance ${module} ${loc} ${ids}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const id = this.nextId();
    const made: Type = { id, kind: TypeKind.Instance, module, loc, name, args };

    return this.keep(key, made);
  }

  public readonly typeParameter(module: int, loc: int, name: string): Type {
    const key = `parameter ${module} ${loc}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const id = this.nextId();
    const made: Type = { id, kind: TypeKind.TypeParameter, module, loc, name };

    return this.keep(key, made);
  }

  public readonly resultOf(value: Type, error: Type): Type {
    const key = `result ${value.id} ${error.id}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const id = this.nextId();
    const made: Type = { id, kind: TypeKind.Result, value, error };

    return this.keep(key, made);
  }

  public readonly promiseOf(value: Type): Type {
    const key = `promise ${value.id}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const id = this.nextId();
    const made: Type = { id, kind: TypeKind.Promise, value };

    return this.keep(key, made);
  }

  public readonly classOf(instance: Type, exact: boolean): Type {
    const key = `class ${exact} ${instance.id}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const id = this.nextId();
    const made: Type = { id, kind: TypeKind.Class, instance, exact };

    return this.keep(key, made);
  }

  public readonly iteratorOf(shape: IteratorShape): Type {
    const ids = this.idsText([shape.yielded, shape.returned, shape.sent]);
    const key = `iterator ${shape.async} ${ids}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const id = this.nextId();
    const made: Type = { id, kind: TypeKind.Iterator, shape };

    return this.keep(key, made);
  }

  public readonly dictOf(dict: DictKind, key: Type, value: Type): Type {
    const word = this.dictWord(dict);
    const text = `dict ${word} ${key.id} ${value.id}`;
    const known = this.byKey.get(text);
    if (known != undefined) {
      return known;
    }

    const id = this.nextId();
    const made: Type = { id, kind: TypeKind.Dict, dict, key, value };

    return this.keep(text, made);
  }

  public readonly templateOf(texts: Own<string[]>, parts: Own<Type[]>): Type {
    const sized = texts.map((text) => `${text.length}:${text}`);
    const ids = this.idsText(parts);
    const key = `template ${ids} ${sized.join("")}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const id = this.nextId();
    const made: Type = { id, kind: TypeKind.Template, texts, parts };

    return this.keep(key, made);
  }

  public readonly operationOf(shape: OperationShape): Type {
    const op = this.operationWord(shape.op);
    const optional = this.changeWord(shape.optional);
    const readonly = this.changeWord(shape.readonly);
    const word = `${shape.word.length}:${shape.word}`;
    const ids = this.idsText(shape.operands);
    const key = `operation ${op} ${optional} ${readonly} ${word} ${ids}`;
    const known = this.byKey.get(key);
    if (known != undefined) {
      return known;
    }

    const id = this.nextId();
    const made: Type = { id, kind: TypeKind.Operation, shape };

    return this.keep(key, made);
  }

  private readonly operationWord(op: OperationKind): string {
    switch (op) {
      case OperationKind.KeyOf:
        return "keyof";
      case OperationKind.Indexed:
        return "indexed";
      case OperationKind.Mapped:
        return "mapped";
      case OperationKind.Conditional:
        return "conditional";
      case OperationKind.Intersection:
        return "intersection";
      case OperationKind.TextChange:
        return "text";
      default:
        return "alias";
    }
  }

  private readonly changeWord(change: Change): string {
    switch (change) {
      case Change.Add:
        return "add";
      case Change.Remove:
        return "remove";
      default:
        return "none";
    }
  }

  private readonly flatParts(parts: Read<Type[]>): Type[] {
    const flat: Type[] = [];

    for (const part of parts) {
      if (part.kind == TypeKind.Union && !part.recursive) {
        this.addParts(flat, part.parts);
      } else {
        this.addParts(flat, [part]);
      }
    }

    return flat;
  }

  private readonly addParts(flat: Type[], parts: Read<Type[]>): void {
    for (const part of parts) {
      if (!flat.includes(part)) {
        flat.push(part);
      }
    }
  }

  private readonly orderedParts(flat: Read<Type[]>): Type[] {
    const ordered: Type[] = [];
    const absent: Type[] = [];

    for (const part of flat) {
      if (part.kind == TypeKind.Undefined) {
        absent.push(part);

        continue;
      }
      const isKept =
        part.kind != TypeKind.Never &&
        !this.isUninhabited(part) &&
        !this.isAbsorbed(part, flat);
      if (isKept) {
        ordered.push(part);
      }
    }

    for (const part of absent) {
      ordered.push(part);
    }

    return ordered;
  }

  private readonly isAbsorbed(part: Type, flat: Read<Type[]>): boolean {
    let current = this.parentsOf(part);

    for (let depth = 0; depth < kParentDepthLimit; depth++) {
      if (current.length == 0) {
        return false;
      }
      if (current.some((parent) => flat.includes(parent))) {
        return true;
      }

      current = current.flatMap((parent) => this.parentsOf(parent));
    }

    return false;
  }

  private readonly isUninhabited(part: Type): boolean {
    if (part.kind != TypeKind.Object) {
      return false;
    }

    return part.fields.some(
      (field) => !field.optional && field.type.kind == TypeKind.Never,
    );
  }

  private readonly compareNames(first: ObjectField, second: ObjectField): int {
    if (first.name < second.name) {
      return -1;
    }
    if (first.name > second.name) {
      return 1;
    }

    return 0;
  }

  private readonly fieldKey(field: ObjectField): string {
    const name = `${field.name.length}:${field.name}`;
    const kinds = `${field.method ?? false}:${field.cell ?? false}`;
    const flags = `${field.optional}:${field.readonly}:${kinds}`;

    return `${name}:${field.type.id}:${flags}`;
  }

  private readonly idsText(types: Read<Type[]>): string {
    const ids = types.map((type) => `${type.id}`);

    return ids.join(" ");
  }

  private readonly literalWord(literal: LiteralKind): string {
    switch (literal) {
      case LiteralKind.String:
        return "string";
      case LiteralKind.Int:
        return "int";
      case LiteralKind.Double:
        return "double";
      default:
        return "boolean";
    }
  }

  private readonly dictWord(dict: DictKind): string {
    switch (dict) {
      case DictKind.Record:
        return "record";
      case DictKind.Map:
        return "map";
      default:
        return "set";
    }
  }

  private readonly keep(key: string, made: Type): Type {
    this.byKey.set(key, made);

    return made;
  }

  private readonly nextId(): int {
    this.count += 1;

    return this.count;
  }

  public readonly setWriters(module: int, loc: int, writers: Own<ParamWriter[]>): void {
    this.writers.set(`${module} ${loc}`, writers);
  }

  public readonly writersOf(module: int, loc: int): ParamWriter[] | undefined {
    return this.writers.get(`${module} ${loc}`);
  }
}

export type InternedTypeStore = Interned<TypeStore>;
