import { TypeStore } from "../type-store/type-store.tz";
import {
  ArrayType,
  Change,
  ClassType,
  DictKind,
  DictType,
  FunctionShape,
  InstanceType,
  IntType,
  IteratorShape,
  LiteralKind,
  LiteralType,
  ObjectField,
  ObjectType,
  OperationKind,
  OperationShape,
  PromiseType,
  ResultType,
  TemplateType,
  TupleType,
  Type,
  TypeKind,
} from "../types/type.types.tz";

export class TypeText {
  private readonly store: TypeStore;

  public constructor(store: TypeStore) {
    this.store = store;
  }

  public readonly of(type: Type): string {
    const label = this.store.labelOf(type);
    if (label != undefined) {
      return label;
    }

    return this.structure(type);
  }

  public readonly structure(type: Type): string {
    switch (type.kind) {
      case TypeKind.Void:
        return "void";
      case TypeKind.Undefined:
        return "undefined";
      case TypeKind.Never:
        return "never";
      case TypeKind.Unknown:
        return "unknown";
      case TypeKind.Boolean:
        return "boolean";
      case TypeKind.Double:
        return "double";
      case TypeKind.Decimal:
        return "decimal";
      case TypeKind.String:
        return "string";
      case TypeKind.Json:
        return "Json";
      case TypeKind.AnyObject:
        return "object";
      case TypeKind.Int:
        return this.intText(type);
      case TypeKind.Literal:
        return this.literalText(type);
      case TypeKind.Array:
        return this.arrayText(type);
      case TypeKind.Tuple:
        return this.tupleText(type);
      case TypeKind.Object:
        return this.objectText(type);
      case TypeKind.Function:
        return this.functionText(type.shape);
      case TypeKind.Union:
        return this.listText(type.parts, " | ");
      case TypeKind.Result:
        return this.resultText(type);
      case TypeKind.Promise:
        return this.promiseText(type);
      case TypeKind.Iterator:
        return this.iteratorText(type.shape);
      case TypeKind.Dict:
        return this.dictText(type);
      case TypeKind.Instance:
        return this.instanceText(type);
      case TypeKind.TypeParameter:
        return type.name;
      case TypeKind.Template:
        return this.templateText(type);
      case TypeKind.Operation:
        return this.operationText(type.shape);
      case TypeKind.Class:
        return this.classText(type);
      default:
        return "?";
    }
  }

  private readonly classText(type: ClassType): string {
    const instance = this.of(type.instance);
    if (type.exact) {
      return `typeof ${instance}`;
    }
    if (type.instance.kind == TypeKind.AnyObject) {
      return "Constructor";
    }

    return `Constructor<${instance}>`;
  }

  private readonly templateText(type: TemplateType): string {
    let text = type.texts[0] ?? "";

    for (let index = 0; index < type.parts.length; index++) {
      const part = this.holeText(type.parts[index]);
      const after = type.texts[index + 1] ?? "";

      text = `${text}\${${part}}${after}`;
    }

    return `\`${text}\``;
  }

  private readonly holeText(part: Type | undefined): string {
    if (part == undefined) {
      return "";
    }
    if (part.kind == TypeKind.Double) {
      return "number";
    }

    return this.of(part);
  }

  private readonly operationText(shape: OperationShape): string {
    const texts = shape.operands.map((operand) => this.of(operand));
    const first = texts[0] ?? "";
    const second = texts[1] ?? "";

    switch (shape.op) {
      case OperationKind.KeyOf:
        return `keyof ${first}`;
      case OperationKind.Indexed:
        return `${first}[${second}]`;
      case OperationKind.Mapped:
        return this.mappedText(shape, texts);
      case OperationKind.Conditional: {
        const yes = texts[2] ?? "";
        const no = texts[3] ?? "";

        return `${first} extends ${second} ? ${yes} : ${no}`;
      }
      case OperationKind.Intersection:
        return texts.join(" & ");
      case OperationKind.TextChange:
        return `${shape.word}<${first}>`;
      default:
        return shape.word;
    }
  }

  private readonly mappedText(shape: OperationShape, texts: Read<string[]>): string {
    const keys = texts[0] ?? "";
    const value = texts[1] ?? "";
    const renamed = this.renameText(texts[2]);
    const readonly = this.changeText(shape.readonly, "readonly ");
    const optional = this.changeText(shape.optional, "?");
    const head = `${readonly}[${shape.word} in ${keys}${renamed}]`;

    return `{ ${head}${optional}: ${value} }`;
  }

  private readonly renameText(renamed: string | undefined): string {
    if (renamed == undefined) {
      return "";
    }

    return ` as ${renamed}`;
  }

  private readonly changeText(change: Change, mark: string): string {
    switch (change) {
      case Change.Add:
        return mark;
      case Change.Remove:
        return `-${mark}`;
      default:
        return "";
    }
  }

  private readonly instanceText(type: InstanceType): string {
    if (type.args.length == 0) {
      return type.name;
    }

    const args = type.args.map((arg) => this.of(arg));

    return `${type.name}<${args.join(", ")}>`;
  }

  private readonly intText(type: IntType): string {
    if (type.wraps) {
      return `Bit.Wrap${type.bits}`;
    }
    if (type.bits == 64 && !type.unsigned) {
      return "int";
    }
    if (type.unsigned) {
      return `uint${type.bits}`;
    }

    return `int${type.bits}`;
  }

  private readonly literalText(type: LiteralType): string {
    if (type.literal == LiteralKind.String) {
      return `"${type.text}"`;
    }

    return type.text;
  }

  private readonly arrayText(type: ArrayType): string {
    const plain = this.plainArrayText(type);
    if (type.readonly == true) {
      return `readonly ${plain}`;
    }

    return plain;
  }

  private readonly plainArrayText(type: ArrayType): string {
    const item = type.item;
    const text = this.of(item);

    if (item.kind == TypeKind.Union || item.kind == TypeKind.Function) {
      return `(${text})[]`;
    }

    return `${text}[]`;
  }

  private readonly resultText(type: ResultType): string {
    const value = this.of(type.value);
    const error = this.of(type.error);

    return `Result<${value}, ${error}>`;
  }

  private readonly promiseText(type: PromiseType): string {
    const value = this.of(type.value);

    return `Promise<${value}>`;
  }

  private readonly listText(types: Read<Type[]>, separator: string): string {
    const texts = types.map((type) => this.partText(type));

    return texts.join(separator);
  }

  private readonly partText(part: Type): string {
    const text = this.of(part);

    if (part.kind == TypeKind.Function) {
      return `(${text})`;
    }

    return text;
  }

  private readonly tupleText(type: TupleType): string {
    const texts: string[] = [];

    for (let index = 0; index < type.items.length; index++) {
      const text = this.itemText(type, index);

      texts.push(text);
    }

    const list = `[${texts.join(", ")}]`;

    if (type.readonly) {
      return `readonly ${list}`;
    }

    return list;
  }

  private readonly itemText(type: TupleType, index: int): string {
    const item = type.items[index];
    if (item == undefined) {
      return "";
    }

    const text = this.of(item);

    if (index == type.rest) {
      return `...${text}`;
    }
    if (index >= type.required) {
      return `${text}?`;
    }

    return text;
  }

  private readonly objectText(type: ObjectType): string {
    if (type.fields.length == 0) {
      return "{}";
    }

    const texts = type.fields.map((field) => this.fieldText(field));

    return `{ ${texts.join("; ")} }`;
  }

  private readonly fieldText(field: ObjectField): string {
    if (field.method ?? false) {
      return `${field.name}()`;
    }

    const type = this.of(field.type);
    const name = this.fieldName(field);

    if (field.readonly) {
      return `readonly ${name}: ${type}`;
    }

    return `${name}: ${type}`;
  }

  private readonly fieldName(field: ObjectField): string {
    if (field.optional) {
      return `${field.name}?`;
    }

    return field.name;
  }

  private readonly functionText(shape: Read<FunctionShape>): string {
    const texts: string[] = [];
    const self = shape.self;
    if (self != undefined) {
      const text = this.of(self);

      texts.push(`this: ${text}`);
    }

    for (let index = 0; index < shape.params.length; index++) {
      const text = this.paramText(shape, index);

      texts.push(text);
    }

    const result = this.of(shape.result);

    return `(${texts.join(", ")}) => ${result}`;
  }

  private readonly paramText(shape: Read<FunctionShape>, index: int): string {
    const param = shape.params[index];
    if (param == undefined) {
      return "";
    }

    const text = this.of(param.type);

    if (shape.rest && index == shape.params.length - 1) {
      return `...${text}`;
    }
    if (param.optional) {
      return `${text}?`;
    }

    return text;
  }

  private readonly iteratorText(shape: IteratorShape): string {
    const name = this.iteratorName(shape.async);
    const yielded = this.of(shape.yielded);
    const plain =
      shape.returned.kind == TypeKind.Void && shape.sent.kind == TypeKind.Void;
    if (plain) {
      return `${name}<${yielded}>`;
    }

    const returned = this.of(shape.returned);
    if (shape.sent.kind == TypeKind.Void) {
      return `${name}<${yielded}, ${returned}>`;
    }

    const sent = this.of(shape.sent);

    return `${name}<${yielded}, ${returned}, ${sent}>`;
  }

  private readonly iteratorName(async: boolean): string {
    if (async) {
      return "AsyncGenerator";
    }

    return "Generator";
  }

  private readonly dictText(type: DictType): string {
    const key = this.of(type.key);
    const value = this.of(type.value);

    switch (type.dict) {
      case DictKind.Record:
        return `Record<${key}, ${value}>`;
      case DictKind.Map:
        return `Map<${key}, ${value}>`;
      default:
        return `Set<${key}>`;
    }
  }
}
