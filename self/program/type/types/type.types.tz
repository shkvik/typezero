export enum TypeKind {
  Error,
  Void,
  Undefined,
  Never,
  Unknown,
  Boolean,
  Double,
  Decimal,
  String,
  Json,
  AnyObject,
  Int,
  Literal,
  Array,
  Tuple,
  Object,
  Function,
  Union,
  Result,
  Promise,
  Iterator,
  Dict,
  Instance,
  TypeParameter,
  Template,
  Operation,
  Class,
}

export enum OperationKind {
  KeyOf,
  Indexed,
  Mapped,
  Conditional,
  Intersection,
  TextChange,
  Alias,
}

export enum Change {
  None,
  Add,
  Remove,
}

export enum DictKind {
  Record,
  Map,
  Set,
}

export enum LiteralKind {
  String,
  Int,
  Double,
  Boolean,
}

export type PlainKind =
  | TypeKind.Error
  | TypeKind.Void
  | TypeKind.Undefined
  | TypeKind.Never
  | TypeKind.Unknown
  | TypeKind.Boolean
  | TypeKind.Double
  | TypeKind.Decimal
  | TypeKind.String
  | TypeKind.Json
  | TypeKind.AnyObject;

export type PlainType = {
  readonly id: int;
  readonly kind: PlainKind;
};

export type IntType = {
  readonly id: int;
  readonly kind: TypeKind.Int;
  readonly bits: int;
  readonly unsigned: boolean;
  readonly wraps: boolean;
};

export type LiteralType = {
  readonly id: int;
  readonly kind: TypeKind.Literal;
  readonly literal: LiteralKind;
  readonly text: string;
};

export type ArrayType = {
  readonly id: int;
  readonly kind: TypeKind.Array;
  readonly item: Type;
  readonly readonly?: boolean;
};

export type TupleShape = {
  readonly items: readonly Type[];
  readonly readonly: boolean;
  readonly required: int;
  readonly rest: int;
};

export type TupleType = {
  readonly id: int;
  readonly kind: TypeKind.Tuple;
  readonly items: readonly Type[];
  readonly readonly: boolean;
  readonly required: int;
  readonly rest: int;
};

export type ObjectField = {
  readonly name: string;
  readonly type: Type;
  readonly optional: boolean;
  readonly readonly: boolean;
  readonly method?: boolean;
  readonly cell?: boolean;
};

export type ObjectType = {
  readonly id: int;
  readonly kind: TypeKind.Object;
  fields: Cell<readonly ObjectField[]>;
};

export type FunctionParameter = {
  readonly type: Type;
  readonly optional: boolean;
};

export type FunctionShape = {
  readonly params: readonly FunctionParameter[];
  readonly rest: boolean;
  readonly self?: Type;
  readonly result: Type;
};

export type FunctionType = {
  readonly id: int;
  readonly kind: TypeKind.Function;
  readonly shape: FunctionShape;
};

export type UnionType = {
  readonly id: int;
  readonly kind: TypeKind.Union;
  parts: Cell<readonly Type[]>;
  readonly recursive: boolean;
};

export type ResultType = {
  readonly id: int;
  readonly kind: TypeKind.Result;
  readonly value: Type;
  readonly error: Type;
};

export type PromiseType = {
  readonly id: int;
  readonly kind: TypeKind.Promise;
  readonly value: Type;
};

export type IteratorShape = {
  readonly yielded: Type;
  readonly returned: Type;
  readonly sent: Type;
  readonly async: boolean;
};

export type IteratorType = {
  readonly id: int;
  readonly kind: TypeKind.Iterator;
  readonly shape: IteratorShape;
};

export type DictType = {
  readonly id: int;
  readonly kind: TypeKind.Dict;
  readonly dict: DictKind;
  readonly key: Type;
  readonly value: Type;
};

export type InstanceType = {
  readonly id: int;
  readonly kind: TypeKind.Instance;
  readonly module: int;
  readonly loc: int;
  readonly name: string;
  readonly args: readonly Type[];
};

export type TypeParameterType = {
  readonly id: int;
  readonly kind: TypeKind.TypeParameter;
  readonly module: int;
  readonly loc: int;
  readonly name: string;
};

export type TemplateType = {
  readonly id: int;
  readonly kind: TypeKind.Template;
  readonly texts: readonly string[];
  readonly parts: readonly Type[];
};

export type OperationShape = {
  readonly op: OperationKind;
  readonly operands: readonly Type[];
  readonly word: string;
  readonly optional: Change;
  readonly readonly: Change;
};

export type OperationType = {
  readonly id: int;
  readonly kind: TypeKind.Operation;
  readonly shape: OperationShape;
};

export type ClassType = {
  readonly id: int;
  readonly kind: TypeKind.Class;
  readonly instance: Type;
  readonly exact: boolean;
};

export type Type =
  | PlainType
  | IntType
  | LiteralType
  | ArrayType
  | TupleType
  | ObjectType
  | FunctionType
  | UnionType
  | ResultType
  | PromiseType
  | IteratorType
  | DictType
  | InstanceType
  | TypeParameterType
  | TemplateType
  | OperationType
  | ClassType;

export type InternedType = Interned<Type>;

export type InternedTypeList = Interned<readonly Type[]>;

export type InternedFields = Interned<readonly ObjectField[]>;

export type InternedWriters = Interned<readonly ParamWriter[]>;

export type InternedParams = Interned<readonly FunctionParameter[]>;
export type ParamWriter = {
  readonly name: string;
  readonly writer: string;
};
