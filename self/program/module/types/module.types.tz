import { SourceError } from "../../../diagnostic/types/message.types.tz";
import { ClassDecl } from "../../ast/types/ast.types.classes.tz";
import {
  DeclarationFile,
  DeclaredClass,
} from "../../ast/types/ast.types.declarations.tz";
import {
  ImportDecl,
  ModulePath,
  SourceFile,
} from "../../ast/types/ast.types.modules.tz";

export type SourcePiece = { readonly path: string; readonly start: int };

export type SourceText = {
  readonly path: string;
  readonly text: Buffer;
  readonly isLibrary: boolean;
  readonly pieces?: SourcePiece[];
};

export type ParsedFile = {
  readonly source: SourceText;
  readonly file: SourceFile;
  readonly errors: SourceError[];
};

export type ParsedDeclaration = {
  readonly source: SourceText;
  readonly file: DeclarationFile;
  readonly errors: SourceError[];
};

export enum LinkKind {
  Module,
  Builtin,
  Package,
  Json,
  Missing,
}

export type ModuleLink =
  | {
      readonly kind: LinkKind.Module;
      readonly from: ModulePath;
      readonly target: int;
    }
  | {
      readonly kind:
        LinkKind.Builtin | LinkKind.Package | LinkKind.Json | LinkKind.Missing;
      readonly from: ModulePath;
    };

export type Module = {
  readonly id: int;
  readonly name: string;
  readonly source: SourceText;
  readonly file: SourceFile;
  readonly errors: SourceError[];
  readonly declaration?: ParsedDeclaration;
  readonly links: ModuleLink[];
  readonly implicit: ImportDecl[];
  readonly parts: ClassDecl[];
  readonly isDeclarationOnly: boolean;
  readonly declared: DeclaredClass[];
};

export enum BuiltinText {
  Prelude,
  Iterate,
  FileSystemErrors,
  CryptoErrors,
  ChildProcessErrors,
}

export type BuiltinFile = {
  readonly text: BuiltinText;
  readonly parsed: ParsedFile;
};

export type Program = {
  readonly modules: Module[];
  readonly order: Module[];
  readonly globals: Module[];
  readonly builtins: BuiltinFile[];
};
