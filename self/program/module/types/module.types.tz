import { SourceError } from "../../../diagnostic/types/message.types.tz";
import { AstTree } from "../../ast/ast-tree/ast-tree.tz";
import { DeclarationFile } from "../../ast/types/ast.types.declarations.tz";
import {
  ModulePath,
  SourceFile,
} from "../../ast/types/ast.types.modules.tz";
import { AstList } from "../../ast/types/ast.types.span.tz";

export type SourcePiece = { readonly path: string; readonly start: int };

export type SourceText = {
  readonly path: string;
  readonly text: Buffer;
  readonly isLibrary: boolean;
  readonly pieces?: readonly SourcePiece[];
};

export type ParsedFile = {
  readonly source: SourceText;
  readonly file: SourceFile;
  readonly errors: readonly SourceError[];
};

export type ParsedDeclaration = {
  readonly source: SourceText;
  readonly file: DeclarationFile;
  readonly errors: readonly SourceError[];
};

export enum LinkKind {
  Module,
  Package,
  Json,
  Missing,
}

export type ModuleLink =
  | {
      readonly kind: LinkKind.Module;
      readonly from: ModulePath;
      readonly target: int;
    }
  | {
      readonly kind: LinkKind.Package | LinkKind.Json | LinkKind.Missing;
      readonly from: ModulePath;
    };

export type Module = {
  readonly id: int;
  readonly name: string;
  readonly source: SourceText;
  readonly file: SourceFile;
  readonly errors: readonly SourceError[];
  readonly declaration?: ParsedDeclaration;
  readonly links: readonly ModuleLink[];
  readonly implicitList: AstList;
  readonly partsList: AstList;
  readonly isDeclarationOnly: boolean;
  readonly declaredList: AstList;
};

export enum BuiltinText {
  Iterate,
}

export type BuiltinFile = {
  readonly text: BuiltinText;
  readonly parsed: ParsedFile;
};

export type Program = {
  readonly modules: readonly Module[];
  readonly order: readonly int[];
  readonly globals: readonly int[];
  readonly ambient: readonly int[];
  readonly builtins: readonly BuiltinFile[];
  readonly tree: AstTree;
};
