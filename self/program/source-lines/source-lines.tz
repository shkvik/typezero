import { CodePointRange, SourcePlace } from "./types/source-lines.types.tz";
import {
  kCarriageReturn,
  kCombiningRanges,
  kContinuationBits,
  kContinuationFirst,
  kContinuationLast,
  kContinuationShift,
  kFourByteBits,
  kFourByteLead,
  kLineFeed,
  kSpace,
  kTab,
  kThreeByteBits,
  kThreeByteLead,
  kTwoByteBits,
  kTwoByteLead,
  kWideRanges,
} from "./const/source-lines.const.tz";

export class SourceLines {
  private readonly source: Buffer;
  private readonly starts: int[];

  public constructor(source: Read<Buffer>) {
    this.source = Buffer.from(source);
    this.starts = [0];

    for (let offset = 0; offset < this.source.length; offset++) {
      if (this.byteAt(offset) == kLineFeed) {
        this.starts.push(offset + 1);
      }
    }
  }

  public readonly placeOf(offset: int): SourcePlace {
    const index = this.lineIndexAt(offset);
    const start = this.startOf(index);
    const before = this.charactersBetween(start, offset);

    return { line: index + 1, column: before + 1 };
  }

  public readonly textEndBefore(offset: int): int {
    if (offset < this.source.length) {
      return offset;
    }

    let end = this.source.length;

    while (end > 0 && this.isBlank(end - 1)) {
      end -= 1;
    }

    return end;
  }

  public readonly lineTextAt(offset: int): string {
    const index = this.lineIndexAt(offset);
    const start = this.startOf(index);
    const end = this.endOf(index);

    return this.source.toString("utf8", start, end);
  }

  public readonly indentTo(offset: int): string {
    const index = this.lineIndexAt(offset);
    const start = this.startOf(index);
    let indent = "";

    for (let at = start; at < offset; at++) {
      indent += this.indentAt(at);
    }

    return indent;
  }

  private readonly lineIndexAt(offset: int): int {
    let left = 0;
    let right = this.starts.length;

    while (left < right) {
      const middle = (left + right) / 2;
      const start = this.startOf(middle);

      if (start <= offset) {
        left = middle + 1;
      } else {
        right = middle;
      }
    }

    return left - 1;
  }

  private readonly startOf(index: int): int {
    return this.starts[index] ?? this.source.length;
  }

  private readonly endOf(index: int): int {
    const next = this.starts[index + 1];
    if (next == undefined) {
      return this.source.length;
    }

    const lineFeed = next - 1;
    if (this.byteAt(lineFeed - 1) == kCarriageReturn) {
      return lineFeed - 1;
    }

    return lineFeed;
  }

  private readonly charactersBetween(start: int, end: int): int {
    let count = 0;

    for (let at = start; at < end; at++) {
      const byte = this.byteAt(at);

      if (!this.isContinuation(byte)) {
        count += 1;
      }
    }

    return count;
  }

  private readonly indentAt(offset: int): string {
    const byte = this.byteAt(offset);
    if (byte == kTab) {
      return "\t";
    }
    if (this.isContinuation(byte)) {
      return "";
    }

    const point = this.codePointAt(offset);
    if (this.within(kCombiningRanges, point)) {
      return "";
    }
    if (this.within(kWideRanges, point)) {
      return "  ";
    }

    return " ";
  }

  private readonly codePointAt(offset: int): int {
    const lead = this.byteAt(offset);
    if (lead < kTwoByteLead) {
      return lead;
    }
    if (lead < kThreeByteLead) {
      return this.joined(lead & kTwoByteBits, offset, 1);
    }
    if (lead < kFourByteLead) {
      return this.joined(lead & kThreeByteBits, offset, 2);
    }

    return this.joined(lead & kFourByteBits, offset, 3);
  }

  private readonly joined(leadBits: int, offset: int, tails: int): int {
    let point = leadBits;

    for (let tail = 1; tail <= tails; tail++) {
      const byte = this.byteAt(offset + tail);
      const bits = byte & kContinuationBits;

      point = (point << kContinuationShift) | bits;
    }

    return point;
  }

  private readonly within(ranges: Read<CodePointRange[]>, point: int): boolean {
    for (const range of ranges) {
      if (point >= range.first && point <= range.last) {
        return true;
      }
    }

    return false;
  }

  private readonly isBlank(offset: int): boolean {
    const byte = this.byteAt(offset);

    switch (byte) {
      case kSpace:
      case kTab:
      case kLineFeed:
      case kCarriageReturn:
        return true;
      default:
        return false;
    }
  }

  private readonly isContinuation(byte: int): boolean {
    return byte >= kContinuationFirst && byte <= kContinuationLast;
  }

  private readonly byteAt(offset: int): int {
    const value = this.source[offset] ?? 0;

    return value.toInt();
  }
}
