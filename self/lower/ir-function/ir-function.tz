import { cstring } from "tz:string";
import {
  LLVMAddIncoming,
  LLVMAppendBasicBlockInContext,
  LLVMBlock,
  LLVMBuildAlloca,
  LLVMBuildBinOp,
  LLVMBuildBr,
  LLVMBuildCall2,
  LLVMBuildCast,
  LLVMBuildCondBr,
  LLVMBuildExtractValue,
  LLVMBuildFCmp,
  LLVMBuildFNeg,
  LLVMBuildICmp,
  LLVMBuildInBoundsGEP2,
  LLVMBuildInsertValue,
  LLVMBuildLoad2,
  LLVMBuildPhi,
  LLVMBuildRet,
  LLVMBuildRetVoid,
  LLVMBuildSelect,
  LLVMBuildStore,
  LLVMBuildStructGEP2,
  LLVMBuildUnreachable,
  LLVMBuilder,
  LLVMContext,
  LLVMCreateBuilderInContext,
  LLVMGetBasicBlockTerminator,
  LLVMGetInsertBlock,
  LLVMGetParam,
  LLVMPositionBuilderAtEnd,
  LLVMType,
  LLVMValue,
} from "../llvm-api/llvm-api.tz";
import { IrModule } from "../ir-module/ir-module.tz";
import { IrTypes } from "../ir-types/ir-types.tz";
import {
  kDeadLabel,
  kEntryLabel,
  kProgramEntry,
  kStartLabel,
} from "./const/ir-function.const.tz";
import {
  IrCallee,
  IrIntPredicate,
  IrOpcode,
  IrRealPredicate,
} from "./types/ir-function.types.tz";

export class IrFunction {
  public readonly callee: IrCallee;
  private readonly context: LLVMContext;
  private readonly parser: IrTypes;
  private readonly builder: LLVMBuilder;
  private readonly entryBuilder: LLVMBuilder;
  private readonly entry: LLVMBlock;
  private readonly start: LLVMBlock;

  public constructor(
    module: IrModule,
    name: string,
    result: string,
    params: Read<string[]>,
  ) {
    const callee = module.declare(name, result, params);
    const fn = callee.fn;

    if (name != kProgramEntry) {
      module.keptInside(fn);
    }

    const context = module.context;
    const entryName = module.cname(kEntryLabel);
    const startName = module.cname(kStartLabel);
    const entry = LLVMAppendBasicBlockInContext(context, fn, entryName);
    const start = LLVMAppendBasicBlockInContext(context, fn, startName);
    const builder = LLVMCreateBuilderInContext(context);
    const entryBuilder = LLVMCreateBuilderInContext(context);

    LLVMPositionBuilderAtEnd(entryBuilder, entry);
    LLVMPositionBuilderAtEnd(builder, start);

    this.callee = callee;
    this.context = context;
    this.parser = new IrTypes(context);
    this.builder = builder;
    this.entryBuilder = entryBuilder;
    this.entry = entry;
    this.start = start;
  }

  public readonly param(index: int): LLVMValue {
    return LLVMGetParam(this.callee.fn, index.toUint32());
  }

  public readonly slot(type: string, name: string): LLVMValue {
    const cname = this.cname(name);

    return LLVMBuildAlloca(this.entryBuilder, this.typeOf(type), cname);
  }

  public readonly entryStore(value: LLVMValue, pointer: LLVMValue): void {
    LLVMBuildStore(this.entryBuilder, value, pointer);
  }

  public readonly block(prefix: string): LLVMBlock {
    const name = this.cname(prefix);

    const fn = this.callee.fn;

    return LLVMAppendBasicBlockInContext(this.context, fn, name);
  }

  public readonly open(block: LLVMBlock): void {
    if (!this.isClosed()) {
      LLVMBuildBr(this.builder, block);
    }

    LLVMPositionBuilderAtEnd(this.builder, block);
  }

  public readonly currentBlock(): LLVMBlock {
    return LLVMGetInsertBlock(this.builder);
  }

  public readonly isClosed(): boolean {
    const current = LLVMGetInsertBlock(this.builder);

    return LLVMGetBasicBlockTerminator(current) != undefined;
  }

  private readonly typeOf(key: string): LLVMType {
    return this.parser.parsed(key);
  }

  private readonly cname(text: string): cstring {
    const made = text.toCString();
    if (made == undefined) {
      return "";
    }

    return made;
  }

  public readonly binary(
    opcode: IrOpcode,
    left: LLVMValue,
    right: LLVMValue,
  ): LLVMValue {
    this.alive();

    const code: int = opcode;

    return LLVMBuildBinOp(this.builder, code.toInt32(), left, right, "");
  }

  public readonly negated(value: LLVMValue): LLVMValue {
    this.alive();

    return LLVMBuildFNeg(this.builder, value, "");
  }

  public readonly integerCompare(
    predicate: IrIntPredicate,
    left: LLVMValue,
    right: LLVMValue,
  ): LLVMValue {
    this.alive();

    const code: int = predicate;

    return LLVMBuildICmp(this.builder, code.toInt32(), left, right, "");
  }

  public readonly realCompare(
    predicate: IrRealPredicate,
    left: LLVMValue,
    right: LLVMValue,
  ): LLVMValue {
    this.alive();

    const code: int = predicate;

    return LLVMBuildFCmp(this.builder, code.toInt32(), left, right, "");
  }

  public readonly cast(
    opcode: IrOpcode,
    value: LLVMValue,
    type: string,
  ): LLVMValue {
    const code: int = opcode;

    this.alive();

    return LLVMBuildCast(
      this.builder,
      code.toInt32(),
      value,
      this.typeOf(type),
      "",
    );
  }

  public readonly load(type: string, pointer: LLVMValue): LLVMValue {
    this.alive();

    return LLVMBuildLoad2(this.builder, this.typeOf(type), pointer, "");
  }

  public readonly store(value: LLVMValue, pointer: LLVMValue): void {
    this.alive();
    LLVMBuildStore(this.builder, value, pointer);
  }

  public readonly element(
    type: string,
    pointer: LLVMValue,
    index: LLVMValue,
  ): LLVMValue {
    this.alive();

    const element = this.typeOf(type);

    return LLVMBuildInBoundsGEP2(
      this.builder,
      element,
      pointer,
      [index],
      1,
      "",
    );
  }

  public readonly field(
    type: string,
    pointer: LLVMValue,
    index: int,
  ): LLVMValue {
    this.alive();

    const struct = this.typeOf(type);

    const at = index.toUint32();

    return LLVMBuildStructGEP2(this.builder, struct, pointer, at, "");
  }

  public readonly call(callee: IrCallee, args: Read<LLVMValue[]>): LLVMValue {
    this.alive();

    return LLVMBuildCall2(
      this.builder,
      callee.type,
      callee.fn,
      args,
      args.length.toUint32(),
      "",
    );
  }

  public readonly indirectCall(
    type: LLVMType,
    fn: LLVMValue,
    args: Read<LLVMValue[]>,
  ): LLVMValue {
    this.alive();

    const count = args.length.toUint32();

    return LLVMBuildCall2(this.builder, type, fn, args, count, "");
  }

  public readonly phi(
    type: string,
    values: Read<LLVMValue[]>,
    blocks: Read<LLVMBlock[]>,
  ): LLVMValue {
    this.alive();

    const made = LLVMBuildPhi(this.builder, this.typeOf(type), "");

    LLVMAddIncoming(made, values, blocks, values.length.toUint32());

    return made;
  }

  public readonly select(
    condition: LLVMValue,
    then: LLVMValue,
    otherwise: LLVMValue,
  ): LLVMValue {
    this.alive();

    return LLVMBuildSelect(this.builder, condition, then, otherwise, "");
  }

  public readonly extract(aggregate: LLVMValue, index: int): LLVMValue {
    this.alive();

    const at = index.toUint32();

    return LLVMBuildExtractValue(this.builder, aggregate, at, "");
  }

  public readonly insert(
    aggregate: LLVMValue,
    value: LLVMValue,
    index: int,
  ): LLVMValue {
    this.alive();

    const at = index.toUint32();

    return LLVMBuildInsertValue(this.builder, aggregate, value, at, "");
  }

  public readonly branch(block: LLVMBlock): void {
    this.alive();
    LLVMBuildBr(this.builder, block);
  }

  public readonly conditionalBranch(
    condition: LLVMValue,
    then: LLVMBlock,
    otherwise: LLVMBlock,
  ): void {
    this.alive();
    LLVMBuildCondBr(this.builder, condition, then, otherwise);
  }

  public readonly returned(value: LLVMValue): void {
    this.alive();
    LLVMBuildRet(this.builder, value);
  }

  public readonly returnedVoid(): void {
    this.alive();
    LLVMBuildRetVoid(this.builder);
  }

  public readonly unreachable(): void {
    this.alive();
    LLVMBuildUnreachable(this.builder);
  }

  public readonly finishVoid(): void {
    if (!this.isClosed()) {
      LLVMBuildRetVoid(this.builder);
    }

    this.sealed();
  }

  public readonly finishValue(value: LLVMValue): void {
    if (!this.isClosed()) {
      LLVMBuildRet(this.builder, value);
    }

    this.sealed();
  }

  public readonly finishUnreachable(): void {
    if (!this.isClosed()) {
      LLVMBuildUnreachable(this.builder);
    }

    this.sealed();
  }

  private readonly sealed(): void {
    LLVMBuildBr(this.entryBuilder, this.start);
  }

  private readonly alive(): void {
    if (this.isClosed()) {
      const dead = this.block(kDeadLabel);

      LLVMPositionBuilderAtEnd(this.builder, dead);
    }
  }
}

