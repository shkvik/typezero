import { IrTypes } from "../ir-types/ir-types.tz";
import { cstring } from "tz:string";
import {
  LLVMAddFunction,
  LLVMAddGlobal,
  LLVMArrayType2,
  LLVMConstArray2,
  LLVMConstIntOfString,
  LLVMConstIntToPtr,
  LLVMConstNull,
  LLVMSizeOf,
  LLVMConstReal,
  LLVMConstRealOfString,
  LLVMConstStringInContext2,
  LLVMConstStructInContext,
  LLVMContext,
  LLVMContextCreate,
  LLVMCreateTargetDataLayout,
  LLVMCreateTargetMachine,
  LLVMDoubleTypeInContext,
  LLVMFunctionType,
  LLVMGetDefaultTargetTriple,
  LLVMGetTargetFromName,
  LLVMGetUndef,
  LLVMInitializeX86AsmPrinter,
  LLVMInitializeX86Target,
  LLVMInitializeX86TargetInfo,
  LLVMInitializeX86TargetMC,
  LLVMIntTypeInContext,
  LLVMIsConstant,
  LLVMModule,
  LLVMModuleCreateWithNameInContext,
  LLVMPointerTypeInContext,
  LLVMPrintModuleToFile,
  LLVMSetAlignment,
  LLVMSetGlobalConstant,
  LLVMSetInitializer,
  LLVMSetLinkage,
  LLVMSetModuleDataLayout,
  LLVMSetTarget,
  LLVMSetUnnamedAddress,
  LLVMStructTypeInContext,
  LLVMTargetMachineEmitToFile,
  LLVMType,
  LLVMValue,
  LLVMVerifyModule,
  LLVMVoidTypeInContext,
} from "../llvm-api/llvm-api.tz";
import { IrCallee } from "../ir-function/types/ir-function.types.tz";
import {
  kCodeGenLevelNone,
  kGenericCpu,
  kGlobalUnnamed,
  kInternalLinkage,
  kObjectFileKind,
  kPrintMessageAction,
  kPrivateLinkage,
  kTargetName,
} from "./const/ir-module.const.tz";

export class IrModule {
  public readonly context: LLVMContext;
  private readonly module: LLVMModule;
  private readonly parser: IrTypes;
  private types: Map<string, LLVMType>;
  private callees: Map<string, IrCallee>;
  private externals: Map<string, LLVMValue>;
  private next: int;

  public constructor(name: string) {
    const context = LLVMContextCreate();
    const cname = name.toCString() ?? "main";

    this.context = context;
    this.module = LLVMModuleCreateWithNameInContext(cname, context);
    this.parser = new IrTypes(context);
    this.types = new Map<string, LLVMType>();
    this.callees = new Map<string, IrCallee>();
    this.externals = new Map<string, LLVMValue>();
    this.next = 0;
  }

  public type(key: string): LLVMType {
    const known = this.types.get(key);
    if (known != undefined) {
      return known;
    }

    const made = this.parser.parsed(key.trim());

    this.types.set(key, made);

    return made;
  }

  public readonly callee(name: string): IrCallee | undefined {
    return this.callees.get(name);
  }

  public signature(result: string, params: Read<string[]>): LLVMType {
    const elements = params.map((param) => this.type(param));
    const returned = this.type(result);

    const count = elements.length.toUint32();

    return LLVMFunctionType(returned, elements, count, 0);
  }

  public declare(
    name: string,
    result: string,
    params: Read<string[]>,
  ): IrCallee {
    const known = this.callees.get(name);
    if (known != undefined) {
      return known;
    }

    const type = this.signature(result, params);
    const fn = LLVMAddFunction(this.module, this.cname(name), type);
    const callee: IrCallee = { fn, type };

    this.callees.set(name, callee);

    return callee;
  }

  public integer(key: string, text: string): LLVMValue {
    return LLVMConstIntOfString(this.type(key), this.cname(text), 10);
  }

  public hexInteger(key: string, hex: string): LLVMValue {
    return LLVMConstIntOfString(this.type(key), this.cname(hex), 16);
  }

  public real(value: double): LLVMValue {
    return LLVMConstReal(this.type("double"), value);
  }

  public realOf(digits: string): LLVMValue {
    return LLVMConstRealOfString(this.type("double"), this.cname(digits));
  }

  public zero(key: string): LLVMValue {
    return LLVMConstNull(this.type(key));
  }

  public sizeOf(key: string): LLVMValue {
    return LLVMSizeOf(this.type(key));
  }

  public undefinedOf(key: string): LLVMValue {
    return LLVMGetUndef(this.type(key));
  }

  public readonly constStruct(values: Read<LLVMValue[]>): LLVMValue {
    const count = values.length.toUint32();

    return LLVMConstStructInContext(this.context, values, count, 0);
  }

  public constArray(element: string, values: Read<LLVMValue[]>): LLVMValue {
    const count = values.length.toUint64();

    return LLVMConstArray2(this.type(element), values, count);
  }

  public readonly bytes(data: Read<Buffer>, isTerminated: boolean): LLVMValue {
    let unterminated: int32 = 1;

    if (isTerminated) {
      unterminated = 0;
    }

    return LLVMConstStringInContext2(
      this.context,
      data,
      data.length.toUint64(),
      unterminated,
    );
  }

  public pointerFromBits(hex: string): LLVMValue {
    const bits = this.hexInteger("i64", hex);

    return LLVMConstIntToPtr(bits, this.type("ptr"));
  }

  public readonly isConstant(value: LLVMValue): boolean {
    return LLVMIsConstant(value) != 0;
  }

  public global(
    name: string,
    key: string,
    init: LLVMValue,
    isConstant: boolean,
  ): LLVMValue {
    const global = LLVMAddGlobal(this.module, this.type(key), this.cname(name));

    LLVMSetInitializer(global, init);

    if (isConstant) {
      LLVMSetGlobalConstant(global, 1);
      LLVMSetLinkage(global, kPrivateLinkage);
      LLVMSetUnnamedAddress(global, kGlobalUnnamed);
    } else {
      LLVMSetLinkage(global, kInternalLinkage);
    }

    LLVMSetAlignment(global, 8);

    return global;
  }

  public external(name: string, key: string): LLVMValue {
    const known = this.externals.get(name);
    if (known != undefined) {
      return known;
    }

    const global = LLVMAddGlobal(this.module, this.type(key), this.cname(name));

    this.externals.set(name, global);

    return global;
  }

  public uniqueName(prefix: string): string {
    const name = `${prefix}${this.next}`;

    this.next += 1;

    return name;
  }

  public readonly cname(text: string): cstring {
    const made = text.toCString();
    if (made == undefined) {
      return "";
    }

    return made;
  }

  public readonly isValid(): boolean {
    return LLVMVerifyModule(this.module, kPrintMessageAction, undefined) == 0;
  }

  public readonly printed(path: string): boolean {
    return LLVMPrintModuleToFile(this.module, this.cname(path), undefined) == 0;
  }

  public readonly emitted(path: string): boolean {
    LLVMInitializeX86TargetInfo();
    LLVMInitializeX86Target();
    LLVMInitializeX86TargetMC();
    LLVMInitializeX86AsmPrinter();

    const target = LLVMGetTargetFromName(this.cname(kTargetName));
    if (target == undefined) {
      return false;
    }

    const triple = LLVMGetDefaultTargetTriple();
    const machine = LLVMCreateTargetMachine(
      target,
      triple,
      this.cname(kGenericCpu),
      "",
      kCodeGenLevelNone,
      0,
      0,
    );
    const data = LLVMCreateTargetDataLayout(machine);
    const file = this.cname(path);

    LLVMSetTarget(this.module, triple);
    LLVMSetModuleDataLayout(this.module, data);

    const failed = LLVMTargetMachineEmitToFile(
      machine,
      this.module,
      file,
      kObjectFileKind,
      undefined,
    );

    return failed == 0;
  }
}

