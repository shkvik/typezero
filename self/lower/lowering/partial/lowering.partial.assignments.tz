import {
  AssignExpr,
  BinaryOp,
  Expr,
  ExprKind,
  UpdateExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { IrOpcode } from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import { Lowering } from "../lowering.tz";
import {
  kArraySetLength,
  kBooleanType,
  kDoubleType,
  kIntType,
  kLengthName,
  kPointerType,
  kVoidType,
} from "../const/lowering.const.tz";
import { Frame, IrValue, Place } from "../types/lowering.types.tz";

partial class Lowering {
  private assigned(frame: Frame, expr: AssignExpr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const target = tree.exprOf(expr.targetId);
    if (target.kind == ExprKind.Index) {
      return this.elementAssigned(frame, expr, target);
    }
    if (target.kind == ExprKind.Member) {
      const targetObject = tree.exprOf(target.objectId);
      if (this.isProcessName(frame, targetObject)) {
        return this.processAssigned(frame, expr, target);
      }
      if (target.name == kLengthName && expr.op == undefined) {
        const objectExpr = tree.exprOf(target.objectId);
        const object = this.typeOf(objectExpr);
        if (object != undefined && object.kind == TypeKind.Array) {
          return this.lengthAssigned(
            frame,
            expr,
            tree.exprOf(target.objectId),
            object,
          );
        }
      }
    }

    const targetExpr = tree.exprOf(expr.targetId);
    const place = this.targetPlace(frame, targetExpr);
    if (place == undefined) {
      return undefined;
    }

    const value = this.assignedValue(frame, expr, place);
    if (value == undefined) {
      return undefined;
    }

    const isLent =
      place.flag != undefined &&
      value.owned != true &&
      value.ownedFlag == undefined;
    if (isLent) {
      this.lentStored(frame, place, value);
    } else {
      this.stored(frame, place, value);
    }

    return { type: value.type, value: value.value, tz: value.tz };
  }

  private lentStored(frame: Read<Frame>, place: Place, value: IrValue): void {
    const flag = place.flag;
    if (flag == undefined || !this.isManaged(place.tz)) {
      return this.stored(frame, place, value);
    }

    const before = frame.made.load(place.type, place.pointer);
    const old: IrValue = {
      type: place.type,
      value: before,
      tz: place.tz,
      owned: true,
    };

    this.flaggedDrop(frame, flag, old);
    frame.made.store(value.value, place.pointer);
    frame.made.store(this.ir.zero(kBooleanType), flag);
  }

  private lengthAssigned(
    frame: Frame,
    expr: AssignExpr,
    owner: Expr,
    type: Type,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    if (type.kind != TypeKind.Array) {
      return undefined;
    }

    const isPlain =
      !this.isManaged(this.values.types.store.itemOf(type)) ||
      this.isString(this.values.types.store.itemOf(type));
    if (!isPlain) {
      this.notLowered(frame.module, expr.loc, "a length set on this array");

      return undefined;
    }

    const array = this.value(frame, owner);
    const int = this.values.types.store.integer(64, false);
    const valueExpr = tree.exprOf(expr.valueId);
    const given = this.wantedValue(frame, valueExpr, int);
    if (array == undefined || given == undefined) {
      return undefined;
    }

    const length = this.converted(
      frame,
      given,
      int,
      tree.exprOf(expr.valueId).loc,
    );
    if (length == undefined) {
      return undefined;
    }

    const setting = this.ir.declare(kArraySetLength, kVoidType, [
      kPointerType,
      kIntType,
    ]);

    frame.made.call(setting, [array.value, length.value]);
    this.dropping(frame, array);

    return length;
  }

  private assignedValue(
    frame: Frame,
    expr: AssignExpr,
    place: Place,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const op = expr.op;
    if (op == undefined) {
      const valueExpr = tree.exprOf(expr.valueId);
      const given = this.value(frame, valueExpr);
      if (given == undefined) {
        return undefined;
      }

      return this.converted(
        frame,
        given,
        place.tz,
        tree.exprOf(expr.valueId).loc,
      );
    }
    if (op == BinaryOp.Add && this.isString(place.tz)) {
      const current = this.loaded(frame, place);

      const exprValue = tree.exprOf(expr.valueId);

      return this.concatenated(frame, [current], [exprValue]);
    }

    if (this.isDecimal(place.tz)) {
      const current = this.loaded(frame, place);

      return this.decimalCompound(
        frame,
        op,
        current,
        tree.exprOf(expr.valueId),
      );
    }

    const isNumber = this.isInteger(place.tz) || this.isDouble(place.tz);
    if (!isNumber) {
      this.notLowered(frame.module, expr.loc, "this assignment");

      return undefined;
    }

    const current = this.loaded(frame, place);
    const right = this.operand(frame, tree.exprOf(expr.valueId), place.tz);
    if (right == undefined) {
      return undefined;
    }

    return this.arithmetic(frame, op, current, right, expr.loc);
  }

  private targetPlace(frame: Frame, target: Expr): Place | undefined {
    const tree = this.values.types.program.tree;

    if (target.kind == ExprKind.Name) {
      return this.namePlace(frame, target);
    }
    if (target.kind != ExprKind.Member) {
      this.notLowered(frame.module, target.loc, "an assignment to this target");

      return undefined;
    }

    const fixed = this.values.staticFieldOf(target, frame.module);
    if (fixed != undefined) {
      return this.staticPlace(frame, target, fixed);
    }

    const object = tree.exprOf(target.objectId);
    const holder = this.value(frame, object);
    if (holder == undefined) {
      return undefined;
    }

    const place = this.fieldAt(
      frame,
      holder.value,
      holder.tz,
      target.name,
      target.loc,
    );

    this.dropping(frame, holder);

    return place;
  }

  private readonly loaded(frame: Read<Frame>, place: Place): IrValue {
    const value = frame.made.load(place.type, place.pointer);

    return { type: place.type, value, tz: place.tz };
  }

  private updated(frame: Frame, expr: UpdateExpr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const target = tree.exprOf(expr.targetId);
    if (target.kind != ExprKind.Name && target.kind != ExprKind.Member) {
      this.notLowered(frame.module, expr.loc, "an update of this target");

      return undefined;
    }

    const place = this.targetPlace(frame, target);
    if (place == undefined) {
      return undefined;
    }

    const isNumber = this.isInteger(place.tz) || this.isDouble(place.tz);
    if (!isNumber) {
      this.notLowered(frame.module, expr.loc, "this update");

      return undefined;
    }

    const before = this.loaded(frame, place);
    const after = this.stepped(frame, before, expr.increment);

    frame.made.store(after.value, place.pointer);

    if (expr.prefix) {
      return after;
    }

    return before;
  }

  private stepped(frame: Read<Frame>, value: IrValue, isUp: boolean): IrValue {
    const isDouble = value.type == kDoubleType;
    const one = this.oneOf(value.type, isDouble);
    let opcode: IrOpcode = this.opcodeFor(
      isDouble,
      IrOpcode.FSub,
      IrOpcode.Sub,
    );

    if (isUp) {
      opcode = this.opcodeFor(isDouble, IrOpcode.FAdd, IrOpcode.Add);
    }

    const made = frame.made.binary(opcode, value.value, one);

    return { type: value.type, value: made, tz: value.tz };
  }

  private oneOf(type: string, isDouble: boolean): LLVMValue {
    if (isDouble) {
      return this.ir.real(1);
    }

    return this.ir.integer(type, "1");
  }
}
