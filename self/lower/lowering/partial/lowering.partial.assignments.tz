import {
  AssignExpr,
  BinaryOp,
  Expr,
  ExprKind,
  UpdateExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { IrOpcode } from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import { Lowering } from "../lowering.tz";
import {
  kArraySetLength,
  kDoubleType,
  kIntType,
  kLengthName,
  kPointerType,
  kVoidType,
} from "../const/lowering.const.tz";
import { Frame, IrValue, Place } from "../types/lowering.types.tz";

partial class Lowering {
  private assigned(frame: Frame, expr: AssignExpr): IrValue | undefined {
    const target = expr.target;
    if (target.kind == ExprKind.Index) {
      return this.elementAssigned(frame, expr, target);
    }
    if (target.kind == ExprKind.Member) {
      if (this.isProcessName(frame, target.object)) {
        return this.processAssigned(frame, expr, target);
      }
      if (target.name == kLengthName && expr.op == undefined) {
        const object = this.typeOf(target.object);
        if (object != undefined && object.kind == TypeKind.Array) {
          return this.lengthAssigned(frame, expr, target.object, object);
        }
      }
    }

    const place = this.targetPlace(frame, expr.target);
    if (place == undefined) {
      return undefined;
    }

    const value = this.assignedValue(frame, expr, place);
    if (value == undefined) {
      return undefined;
    }

    this.stored(frame, place, value);

    return { type: value.type, value: value.value, tz: value.tz };
  }

  private lengthAssigned(
    frame: Frame,
    expr: AssignExpr,
    owner: Expr,
    type: Type,
  ): IrValue | undefined {
    if (type.kind != TypeKind.Array) {
      return undefined;
    }

    const isPlain = !this.isManaged(type.item) || this.isString(type.item);
    if (!isPlain) {
      this.notLowered(frame.module, expr.loc, "a length set on this array");

      return undefined;
    }

    const array = this.value(frame, owner);
    const int = this.store.integer(64, false);
    const given = this.wantedValue(frame, expr.value, int);
    if (array == undefined || given == undefined) {
      return undefined;
    }

    const length = this.converted(frame, given, int, expr.value.loc);
    if (length == undefined) {
      return undefined;
    }

    const setting = this.ir.declare(kArraySetLength, kVoidType, [
      kPointerType,
      kIntType,
    ]);

    frame.made.call(setting, [array.value, length.value]);
    this.dropping(frame, array);

    return length;
  }

  private assignedValue(
    frame: Frame,
    expr: AssignExpr,
    place: Place,
  ): IrValue | undefined {
    const op = expr.op;
    if (op == undefined) {
      const given = this.value(frame, expr.value);
      if (given == undefined) {
        return undefined;
      }

      return this.converted(frame, given, place.tz, expr.value.loc);
    }
    if (op == BinaryOp.Add && this.isString(place.tz)) {
      const current = this.loaded(frame, place);

      return this.concatenated(frame, [current], [expr.value]);
    }

    if (this.isDecimal(place.tz)) {
      const current = this.loaded(frame, place);

      return this.decimalCompound(frame, op, current, expr.value);
    }

    const isNumber = this.isInteger(place.tz) || this.isDouble(place.tz);
    if (!isNumber) {
      this.notLowered(frame.module, expr.loc, "this assignment");

      return undefined;
    }

    const current = this.loaded(frame, place);
    const right = this.operand(frame, expr.value, place.tz);
    if (right == undefined) {
      return undefined;
    }

    return this.arithmetic(frame, op, current, right, expr.loc);
  }

  private targetPlace(frame: Frame, target: Expr): Place | undefined {
    if (target.kind == ExprKind.Name) {
      return this.namePlace(frame, target);
    }
    if (target.kind != ExprKind.Member) {
      this.notLowered(frame.module, target.loc, "an assignment to this target");

      return undefined;
    }

    const holder = this.value(frame, target.object);
    if (holder == undefined) {
      return undefined;
    }

    const place = this.fieldAt(
      frame,
      holder.value,
      holder.tz,
      target.name,
      target.loc,
    );

    this.dropping(frame, holder);

    return place;
  }

  private readonly loaded(frame: Read<Frame>, place: Place): IrValue {
    const value = frame.made.load(place.type, place.pointer);

    return { type: place.type, value, tz: place.tz };
  }

  private updated(frame: Frame, expr: UpdateExpr): IrValue | undefined {
    const target = expr.target;
    if (target.kind != ExprKind.Name && target.kind != ExprKind.Member) {
      this.notLowered(frame.module, expr.loc, "an update of this target");

      return undefined;
    }

    const place = this.targetPlace(frame, target);
    if (place == undefined) {
      return undefined;
    }

    const isNumber = this.isInteger(place.tz) || this.isDouble(place.tz);
    if (!isNumber) {
      this.notLowered(frame.module, expr.loc, "this update");

      return undefined;
    }

    const before = this.loaded(frame, place);
    const after = this.stepped(frame, before, expr.increment);

    frame.made.store(after.value, place.pointer);

    if (expr.prefix) {
      return after;
    }

    return before;
  }

  private readonly stepped(frame: Read<Frame>, value: IrValue, isUp: boolean): IrValue {
    const isDouble = value.type == kDoubleType;
    const one = this.oneOf(value.type, isDouble);
    let opcode: IrOpcode = this.opcodeFor(
      isDouble,
      IrOpcode.FSub,
      IrOpcode.Sub,
    );

    if (isUp) {
      opcode = this.opcodeFor(isDouble, IrOpcode.FAdd, IrOpcode.Add);
    }

    const made = frame.made.binary(opcode, value.value, one);

    return { type: value.type, value: made, tz: value.tz };
  }

  private readonly oneOf(type: string, isDouble: boolean): LLVMValue {
    if (isDouble) {
      return this.ir.real(1);
    }

    return this.ir.integer(type, "1");
  }
}
