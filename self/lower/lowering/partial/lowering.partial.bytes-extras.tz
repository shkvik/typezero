import {
  CallExpr,
  MemberExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import {
  IrIntPredicate,
  IrOpcode,
} from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kBufferConcat,
  kBufferFromText,
  kBooleanType,
  kBuffersModule,
  kBytesLayouts,
  kByteType,
  kFlagType,
  kIntType,
  kPointerType,
  kStringType,
} from "../const/lowering.const.tz";
import {
  BytesCall,
  Frame,
  IrValue,
  RuntimeTarget,
} from "../types/lowering.types.tz";

partial class Lowering {
  private bufferByteLength(
    frame: Frame,
    call: CallExpr,
    given: IrValue,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const tz = this.values.types.store.integer(64, false);
    if (this.isBytesType(given.tz)) {
      const length = this.bytesLength(frame, given.value);

      this.dropping(frame, given);

      return { type: kIntType, value: length, tz };
    }

    const encoding = this.encodingOf(
      frame,
      tree.exprAt(tree.argumentsOf(call.argsList)[1]?.exprId),
    );
    const code = frame.made.cast(IrOpcode.SExt, encoding, kIntType);
    const coded: IrValue = { type: kIntType, value: code, tz };
    const name = "byteLengthOf";
    const target: RuntimeTarget = { module: kBuffersModule, name };
    const args = [given, coded];
    const length = this.runtimeFunctionCall(frame, target, [], args, call.loc);

    this.dropping(frame, given);

    return length;
  }

  private bytesMade(
    frame: Read<Frame>,
    cName: string,
    tzName: string,
    call: Read<BytesCall>,
  ): LLVMValue {
    const name = this.runtimeHelperName(kBuffersModule, tzName, cName);
    if (name == cName) {
      const callee = this.ir.declare(name, kPointerType, call.params);

      return frame.made.call(callee, call.args);
    }

    const layouts = this.ir.external(kBytesLayouts, kPointerType);
    const params = call.params.concat([kPointerType]);
    const args = call.args.concat([layouts]);
    const callee = this.ir.declare(name, kPointerType, params);

    return frame.made.call(callee, args);
  }

  private bufferOfTextMade(
    frame: Read<Frame>,
    given: IrValue,
    encoding: LLVMValue,
  ): LLVMValue {
    const name = this.runtimeHelperName(
      kBuffersModule,
      "bufferOfText",
      kBufferFromText,
    );
    if (name == kBufferFromText) {
      const params = [kPointerType, kIntType, kFlagType];
      const callee = this.ir.declare(name, kPointerType, params);
      const args = this.textParts(frame, given).concat([encoding]);

      return frame.made.call(callee, args);
    }

    const layouts = this.ir.external(kBytesLayouts, kPointerType);
    const params = [kStringType, kFlagType, kPointerType];
    const callee = this.ir.declare(name, kPointerType, params);

    return frame.made.call(callee, [given.value, encoding, layouts]);
  }

  private bufferConcat(
    frame: Frame,
    call: CallExpr,
    list: IrValue,
    result: Type,
  ): IrValue | undefined {
    const total = this.integerArgument(frame, call, 1);
    if (total == undefined) {
      return undefined;
    }

    const params = [kPointerType, kIntType, kFlagType];
    const hasTotal = this.ir.integer(kFlagType, `${total.given}`);
    const value = this.bytesMade(frame, kBufferConcat, "buffersJoined", {
      params,
      args: [list.value, total.value, hasTotal],
    });

    this.dropping(frame, list);

    return { type: kPointerType, value, tz: result, owned: true };
  }

  private bytesSearched(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const object = tree.exprOf(member.objectId);
    const bytes = this.value(frame, object);
    const needle = tree.argumentsOf(call.argsList)[0];
    if (bytes == undefined || needle == undefined) {
      return undefined;
    }

    const expr = tree.exprOf(needle.exprId);
    const given = this.value(frame, expr);
    const from = this.integerArgument(frame, call, 1);
    if (given == undefined || from == undefined || !this.isString(given.tz)) {
      this.notLowered(frame.module, call.loc, "this search in bytes");

      return undefined;
    }

    const encoding = this.encodingOf(
      frame,
      tree.exprAt(tree.argumentsOf(call.argsList)[2]?.exprId),
    );
    const int = this.values.types.store.integer(64, false);
    const boolean = this.values.types.store.plain(TypeKind.Boolean);
    const hasFrom = this.ir.integer(kBooleanType, `${from.given}`);
    const mode = this.ir.integer(kIntType, `${this.searchMode(member.name)}`);
    const code = frame.made.cast(IrOpcode.SExt, encoding, kIntType);
    const args: IrValue[] = [
      { type: kPointerType, value: bytes.value, tz: int },
      given,
      { type: kIntType, value: from.value, tz: int },
      { type: kBooleanType, value: hasFrom, tz: boolean },
      { type: kIntType, value: code, tz: int },
      { type: kIntType, value: mode, tz: int },
    ];
    const name = "bufferTextFound";
    const target: RuntimeTarget = { module: kBuffersModule, name };
    const found = this.runtimeFunctionCall(frame, target, [], args, call.loc);

    this.dropping(frame, given);
    this.dropping(frame, bytes);

    if (found == undefined) {
      return undefined;
    }
    if (member.name == "includes") {
      const zero = this.ir.zero(kIntType);
      const value = frame.made.integerCompare(
        IrIntPredicate.NotEqual,
        found.value,
        zero,
      );

      return { type: kBooleanType, value, tz: boolean };
    }

    return found;
  }

  private doubleWritten(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const object = tree.exprOf(member.objectId);
    const bytes = this.value(frame, object);
    const first = tree.argumentsOf(call.argsList)[0];
    const offset = this.integerArgument(frame, call, 1);
    if (bytes == undefined || first == undefined || offset == undefined) {
      return undefined;
    }

    const expr = tree.exprOf(first.exprId);
    const given = this.value(frame, expr);
    const double = this.values.types.store.plain(TypeKind.Double);
    const number = this.convertedOrNone(frame, given, double, call.loc);
    if (number == undefined) {
      return undefined;
    }

    const raw = frame.made.cast(IrOpcode.BitCast, number.value, kIntType);
    const data = this.bytesData(frame, bytes.value);
    const isBig = member.name == "writeDoubleBE";

    for (let index = 0; index < 8; index++) {
      const shift = this.byteShift(index, isBig);
      const moved = frame.made.binary(IrOpcode.LShr, raw, shift);
      const byte = frame.made.cast(IrOpcode.Trunc, moved, kByteType);
      const step = this.ir.integer(kIntType, `${index}`);
      const at = frame.made.binary(IrOpcode.Add, offset.value, step);

      frame.made.store(byte, frame.made.element(kByteType, data, at));
    }

    const size = this.ir.integer(kIntType, "8");
    const value = frame.made.binary(IrOpcode.Add, offset.value, size);
    const tz = this.values.types.store.integer(64, false);

    this.dropping(frame, bytes);

    return { type: kIntType, value, tz };
  }

  private byteShift(index: int, isBig: boolean): LLVMValue {
    let place = index;

    if (isBig) {
      place = 7 - index;
    }

    return this.ir.integer(kIntType, `${place * 8}`);
  }
}
