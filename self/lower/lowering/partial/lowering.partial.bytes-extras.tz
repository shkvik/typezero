import {
  CallExpr,
  MemberExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import {
  IrIntPredicate,
  IrOpcode,
} from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kBufferByteLength,
  kBufferConcat,
  kBufferIndexOfText,
  kBooleanType,
  kByteType,
  kFlagType,
  kIntType,
  kPointerType,
} from "../const/lowering.const.tz";
import { Frame, IrValue } from "../types/lowering.types.tz";

partial class Lowering {
  private bufferByteLength(
    frame: Frame,
    call: CallExpr,
    given: IrValue,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const tz = this.values.types.store.integer(64, false);
    if (this.isBytesType(given.tz)) {
      const length = this.bytesLength(frame, given.value);

      this.dropping(frame, given);

      return { type: kIntType, value: length, tz };
    }

    const encoding = this.encodingOf(
      frame,
      tree.exprAt(tree.argumentsOf(call.argsList)[1]?.exprId),
    );
    const params = [kPointerType, kIntType, kFlagType];
    const callee = this.ir.declare(kBufferByteLength, kFlagType, params);
    const args = this.textParts(frame, given).concat([encoding]);
    const length = frame.made.call(callee, args);
    const value = frame.made.cast(IrOpcode.SExt, length, kIntType);

    this.dropping(frame, given);

    return { type: kIntType, value, tz };
  }

  private bufferConcat(
    frame: Frame,
    call: CallExpr,
    list: IrValue,
    result: Type,
  ): IrValue | undefined {
    const total = this.integerArgument(frame, call, 1);
    if (total == undefined) {
      return undefined;
    }

    const params = [kPointerType, kIntType, kFlagType];
    const callee = this.ir.declare(kBufferConcat, kPointerType, params);
    const hasTotal = this.ir.integer(kFlagType, `${total.given}`);
    const value = frame.made.call(callee, [list.value, total.value, hasTotal]);

    this.dropping(frame, list);

    return { type: kPointerType, value, tz: result, owned: true };
  }

  private bytesSearched(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const object = tree.exprOf(member.objectId);
    const bytes = this.value(frame, object);
    const needle = tree.argumentsOf(call.argsList)[0];
    if (bytes == undefined || needle == undefined) {
      return undefined;
    }

    const expr = tree.exprOf(needle.exprId);
    const given = this.value(frame, expr);
    const from = this.integerArgument(frame, call, 1);
    if (given == undefined || from == undefined || !this.isString(given.tz)) {
      this.notLowered(frame.module, call.loc, "this search in bytes");

      return undefined;
    }

    const encoding = this.encodingOf(
      frame,
      tree.exprAt(tree.argumentsOf(call.argsList)[2]?.exprId),
    );
    const params = [
      kPointerType,
      kPointerType,
      kIntType,
      kIntType,
      kFlagType,
      kFlagType,
      kFlagType,
    ];
    const callee = this.ir.declare(kBufferIndexOfText, kFlagType, params);
    const hasFrom = this.ir.integer(kFlagType, `${from.given}`);
    const mode = this.ir.integer(kFlagType, `${this.searchMode(member.name)}`);
    const args = [bytes.value]
      .concat(this.textParts(frame, given))
      .concat([from.value, hasFrom, encoding, mode]);
    const found = frame.made.call(callee, args);

    this.dropping(frame, given);
    this.dropping(frame, bytes);

    if (member.name == "includes") {
      const zero = this.ir.zero(kFlagType);
      const value = frame.made.integerCompare(
        IrIntPredicate.NotEqual,
        found,
        zero,
      );
      const tz = this.values.types.store.plain(TypeKind.Boolean);

      return { type: kBooleanType, value, tz };
    }

    const value = frame.made.cast(IrOpcode.SExt, found, kIntType);
    const tz = this.values.types.store.integer(64, false);

    return { type: kIntType, value, tz };
  }

  private doubleWritten(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const object = tree.exprOf(member.objectId);
    const bytes = this.value(frame, object);
    const first = tree.argumentsOf(call.argsList)[0];
    const offset = this.integerArgument(frame, call, 1);
    if (bytes == undefined || first == undefined || offset == undefined) {
      return undefined;
    }

    const expr = tree.exprOf(first.exprId);
    const given = this.value(frame, expr);
    const double = this.values.types.store.plain(TypeKind.Double);
    const number = this.convertedOrNone(frame, given, double, call.loc);
    if (number == undefined) {
      return undefined;
    }

    const raw = frame.made.cast(IrOpcode.BitCast, number.value, kIntType);
    const data = this.bytesData(frame, bytes.value);
    const isBig = member.name == "writeDoubleBE";

    for (let index = 0; index < 8; index++) {
      const shift = this.byteShift(index, isBig);
      const moved = frame.made.binary(IrOpcode.LShr, raw, shift);
      const byte = frame.made.cast(IrOpcode.Trunc, moved, kByteType);
      const step = this.ir.integer(kIntType, `${index}`);
      const at = frame.made.binary(IrOpcode.Add, offset.value, step);

      frame.made.store(byte, frame.made.element(kByteType, data, at));
    }

    const size = this.ir.integer(kIntType, "8");
    const value = frame.made.binary(IrOpcode.Add, offset.value, size);
    const tz = this.values.types.store.integer(64, false);

    this.dropping(frame, bytes);

    return { type: kIntType, value, tz };
  }

  private byteShift(index: int, isBig: boolean): LLVMValue {
    let place = index;

    if (isBig) {
      place = 7 - index;
    }

    return this.ir.integer(kIntType, `${place * 8}`);
  }
}
