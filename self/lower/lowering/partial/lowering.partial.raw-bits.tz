import {
  CallExpr,
  ExprKind,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { IrOpcode } from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import { TypeKind } from "../../../program/type/types/type.types.tz";
import {
  kByteCell,
  kDecimalType,
  kMemoryHelpers,
  kMemoryModule,
  kThreadName,
  kThreadOfC,
  kThreadRecord,
  kFlagType,
  kIntType,
  kPointerType,
  kStringType,
  kTextModule,
  kVoidType,
} from "../const/lowering.const.tz";
import { Frame, IrValue, RuntimeTarget } from "../types/lowering.types.tz";

partial class Lowering {
  private rawOfBits(frame: Frame, call: CallExpr): IrValue | undefined {
    const bits = this.rawArgument(frame, call, 0);
    if (bits == undefined) {
      return undefined;
    }

    const value = frame.made.cast(IrOpcode.IntToPtr, bits, kPointerType);

    return this.rawMade(call, value);
  }

  private bitsOfRaw(frame: Frame, call: CallExpr): IrValue | undefined {
    const raw = this.rawArgument(frame, call, 0);
    if (raw == undefined) {
      return undefined;
    }

    const bits = frame.made.cast(IrOpcode.PtrToInt, raw, kIntType);
    const tz = this.values.types.store.integer(64, true);

    return { type: kIntType, value: bits, tz };
  }

  private comparedCall(frame: Frame, call: CallExpr): IrValue | undefined {
    const compare = this.rawArgument(frame, call, 0);
    const context = this.rawArgument(frame, call, 1);
    const first = this.rawArgument(frame, call, 2);
    const second = this.rawArgument(frame, call, 3);
    if (compare == undefined || context == undefined) {
      return undefined;
    }
    if (first == undefined || second == undefined) {
      return undefined;
    }

    const params = [kPointerType, kPointerType, kPointerType];
    const signature = this.ir.signature(kFlagType, params);
    const args = [context, first, second];
    const result = frame.made.indirectCall(signature, compare, args);
    const value = frame.made.cast(IrOpcode.SExt, result, kIntType);
    const tz = this.values.types.store.integer(64, false);

    return { type: kIntType, value, tz };
  }

  private invokedCall(frame: Frame, call: CallExpr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const entry = this.rawArgument(frame, call, 0);
    if (entry == undefined) {
      return undefined;
    }

    const tz = this.values.types.store.integer(64, true);
    const params: string[] = [];
    const given: LLVMValue[] = [];

    for (const argument of tree.argumentsOf(call.argsList).slice(1)) {
      const expr = tree.exprOf(argument.exprId);
      const found = this.wantedValue(frame, expr, tz);
      if (found == undefined) {
        return undefined;
      }

      const value = this.converted(frame, found, tz, expr.loc);
      if (value == undefined) {
        return undefined;
      }

      params.push(kIntType);
      given.push(value.value);
    }

    const signature = this.ir.signature(kIntType, params);
    const value = frame.made.indirectCall(signature, entry, given);

    return { type: kIntType, value, tz };
  }

  private entryOfFunction(frame: Frame, call: CallExpr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const argument = tree.argumentsOf(call.argsList)[0];
    if (argument == undefined) {
      return undefined;
    }

    const named = tree.exprOf(argument.exprId);
    const module = frame.module;
    if (named.kind != ExprKind.Name) {
      this.notLowered(module, call.loc, "entryOf of this expression");

      return undefined;
    }

    const fn = this.functionNamed(module, named.name);
    if (fn == undefined) {
      this.notLowered(module, call.loc, "entryOf of this name");

      return undefined;
    }

    const declared = this.values.functionOf(module, fn.loc);
    if (declared.kind != TypeKind.Function) {
      this.notLowered(module, call.loc, "entryOf of this name");

      return undefined;
    }

    const shape = this.values.types.store.functionShapeOf(declared);
    const name = this.instanceName(module, fn, []);
    const result = this.irType(shape.result);
    const types = this.shapeTypes(shape);
    if (result == undefined || types == undefined) {
      this.notLowered(module, call.loc, "entryOf of this function");

      return undefined;
    }

    const params = this.values.types.parameterTypes(
      module,
      tree.typeParamsOf(fn.typeParamsList),
    );

    this.instanceWanted({ module, fn, name, params, args: [] });

    const callee = this.ir.declare(name, result, types);

    return this.rawMade(call, callee.fn);
  }

  private bufferOfRaw(frame: Frame, call: CallExpr): IrValue | undefined {
    const raw = this.rawArgument(frame, call, 0);
    const type = this.typeOf(call);
    if (raw == undefined || type == undefined) {
      return undefined;
    }

    return { type: kPointerType, value: raw, tz: type, owned: true };
  }

  private droppedCall(frame: Frame, call: CallExpr): IrValue | undefined {
    const drop = this.rawArgument(frame, call, 0);
    const object = this.rawArgument(frame, call, 1);
    if (drop == undefined || object == undefined) {
      return undefined;
    }

    const signature = this.ir.signature(kVoidType, [kPointerType]);

    frame.made.indirectCall(signature, drop, [object]);

    return this.nothing();
  }

  private threadStateOf(call: CallExpr): IrValue | undefined {
    return this.rawMade(call, this.threadRecord());
  }

  private threadRecord(): LLVMValue {
    const known = this.threadGlobal;
    if (known != undefined) {
      return known;
    }

    if (this.moduleIdNamed(kMemoryModule) == undefined) {
      return this.ir.external(kThreadOfC, "{ ptr }");
    }

    const zero = this.ir.zero(kThreadRecord);
    const global = this.ir.global(kThreadName, kThreadRecord, zero, false);

    this.threadGlobal = global;

    return global;
  }

  private memoryHelper(name: string): string {
    const helper = kMemoryHelpers.get(name) ?? name;

    return this.runtimeHelperName(kMemoryModule, helper, name);
  }

  private cellsAtMade(frame: Frame, call: CallExpr): IrValue | undefined {
    const raw = this.rawArgument(frame, call, 0);
    const offset = this.intArgument(frame, call, 1);
    if (raw == undefined || offset == undefined) {
      return undefined;
    }

    const value = frame.made.element(kByteCell, raw, offset);

    return this.rawMade(call, value);
  }

  private textTreeMade(frame: Frame, call: CallExpr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const args = tree.argumentsOf(call.argsList);
    const first = args[0];
    const second = args[1];
    if (first == undefined || second == undefined) {
      return undefined;
    }

    const left = this.value(frame, tree.exprOf(first.exprId));
    const right = this.value(frame, tree.exprOf(second.exprId));
    if (left == undefined || right == undefined) {
      return undefined;
    }
    if (left.type != kStringType || right.type != kStringType) {
      return undefined;
    }

    const name = "treeMade";
    const target: RuntimeTarget = { module: kTextModule, name };
    const pieces = [left, right];
    const made = this.runtimeFunctionCall(frame, target, [], pieces, call.loc);

    this.dropping(frame, left);
    this.dropping(frame, right);

    return made;
  }

  private decimalPiece(
    frame: Frame,
    call: CallExpr,
    isMeta: boolean,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const argument = tree.argumentsOf(call.argsList)[0];
    if (argument == undefined) {
      return undefined;
    }

    const given = this.value(frame, tree.exprOf(argument.exprId));
    if (given == undefined || given.type != kDecimalType) {
      return undefined;
    }

    let index = 0;
    let tz = this.values.types.store.integer(64, false);

    if (isMeta) {
      index = 1;
      tz = this.values.types.store.integer(64, true);
    }

    const value = frame.made.extract(given.value, index);

    this.dropping(frame, given);

    return { type: kIntType, value, tz };
  }

  private decimalJoined(frame: Frame, call: CallExpr): IrValue | undefined {
    const coef = this.intArgument(frame, call, 0);
    const meta = this.rawArgument(frame, call, 1);
    if (coef == undefined || meta == undefined) {
      return undefined;
    }

    const empty = this.ir.zero(kDecimalType);
    const half = frame.made.insert(empty, coef, 0);
    const value = frame.made.insert(half, meta, 1);
    const tz = this.values.types.store.plain(TypeKind.Decimal);

    return { type: kDecimalType, value, tz, owned: true };
  }
}
