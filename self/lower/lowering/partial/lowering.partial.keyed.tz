import { IndexExpr } from "../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import { IrFunction } from "../../ir-function/ir-function.tz";
import { IrCallee } from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kIntType,
  kPointerType,
  kStringType,
  kTextModule,
} from "../const/lowering.const.tz";
import {
  ClassLayout,
  Frame,
  IrValue,
  RuntimeTarget,
} from "../types/lowering.types.tz";

partial class Lowering {
  private keyedIndexed(
    frame: Frame,
    expr: IndexExpr,
    object: Type,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const indexExpr = tree.exprOf(expr.indexId);
    const keyType = this.typeIn(frame, indexExpr);
    const layout = this.layoutOf(object);
    const names = this.textLiterals(this.widenedKey(keyType));
    const first = this.layoutFieldAt(layout, 0);
    if (layout == undefined || first == undefined || names.length == 0) {
      this.notLowered(frame.module, expr.loc, "an index on type object");

      return undefined;
    }

    const isSameKind = this.fieldsOf(layout).every(
      (field) => field.ir == first.ir,
    );
    if (!isSameKind) {
      this.notLowered(frame.module, expr.loc, "an index on these fields");

      return undefined;
    }

    const objectExpr = tree.exprOf(expr.objectId);
    const holder = this.value(frame, objectExpr);
    const exprIndex = tree.exprOf(expr.indexId);
    const key = this.value(frame, exprIndex);
    if (holder == undefined || key == undefined) {
      return undefined;
    }

    const finder = this.keyedFinder(frame.module, layout, names);
    const text = frame.made.extract(key.value, 0);
    const meta = frame.made.extract(key.value, 1);
    const address = this.recordAddress(frame, holder);
    const pointer = frame.made.call(finder, [address, text, meta]);
    const loaded: IrValue = {
      type: first.ir,
      value: frame.made.load(first.ir, pointer),
      tz: first.type,
    };

    this.dropping(frame, key);

    if (holder.owned != true || !this.isManaged(holder.tz)) {
      return loaded;
    }
    if (this.isSingleOwner(loaded) && this.isSingleOwner(holder)) {
      frame.made.store(this.ir.zero(first.ir), pointer);
      this.dropping(frame, holder);

      const type = first.ir;

      return { type, value: loaded.value, tz: first.type, owned: true };
    }

    const kept = this.owning(frame, loaded);

    this.dropping(frame, holder);

    return kept;
  }

  private readonly widenedKey(type: Type | undefined): Type {
    if (type == undefined) {
      return this.values.types.store.plain(TypeKind.Never);
    }

    return type;
  }

  private keyedFinder(
    module: int,
    layout: Read<ClassLayout>,
    names: Read<string[]>,
  ): IrCallee {
    const key = `${layout.struct} ${names.join(" ")}`;
    const known = this.keyedFinders.get(key);
    if (known != undefined) {
      return known;
    }

    const name = this.ir.uniqueName("tz.keyed.");
    const params = [kPointerType, kPointerType, kIntType];
    const made = new IrFunction(this.ir, name, kPointerType, params);
    const object = made.param(0);
    const text = made.param(1);
    const meta = made.param(2);
    const inner: Frame = {
      made,
      id: this.frameId(),
      module,
      loops: [],
      scopes: [],
    };
    const string = this.values.types.store.plain(TypeKind.String);
    const half = made.insert(this.ir.zero(kStringType), text, 0);
    const joined = made.insert(half, meta, 1);
    const given: IrValue = { type: kStringType, value: joined, tz: string };
    const target: RuntimeTarget = { module: kTextModule, name: "equals" };
    let fallback: LLVMValue = made.field(layout.struct, object, 0);

    for (const one of names) {
      const field = this.layoutField(layout, one);
      if (field == undefined) {
        continue;
      }

      const literal = this.stringValue(one);
      const args = [given, literal];
      const same = this.runtimeFunctionCall(inner, target, [], args, 0);
      if (same == undefined) {
        continue;
      }

      const found = made.block("keyed.found");
      const next = made.block("keyed.next");

      made.conditionalBranch(same.value, found, next);
      made.open(found);
      made.returned(made.field(layout.struct, object, field.index));
      made.open(next);
      fallback = made.field(layout.struct, object, 0);
    }

    made.finishValue(fallback);
    this.keyedFinders.set(key, made.callee);

    return made.callee;
  }
}
