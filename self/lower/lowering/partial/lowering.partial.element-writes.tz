import {
  AssignExpr,
  IndexExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { Type } from "../../../program/type/types/type.types.tz";
import { IrIntPredicate } from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import { kByteType } from "../const/lowering.const.tz";
import { Frame, IrValue, Place } from "../types/lowering.types.tz";

partial class Lowering {
  private elementAssigned(
    frame: Frame,
    expr: AssignExpr,
    target: IndexExpr,
  ): IrValue | undefined {
    const object = this.typeIn(frame, target.object);
    const isBytes = object != undefined && this.isBytesType(object);
    if (object == undefined || (expr.op != undefined && isBytes)) {
      this.notLowered(frame.module, expr.loc, "an assignment to this element");

      return undefined;
    }
    if (isBytes) {
      return this.byteAssigned(frame, expr, target);
    }

    const item = this.itemOf(object);
    const element = this.typeOrUndefined(item);
    if (item == undefined || element == undefined) {
      this.notLowered(frame.module, expr.loc, "an assignment to this element");

      return undefined;
    }
    if (expr.op != undefined) {
      return this.elementUpdated(frame, expr, target, item, element);
    }

    const array = this.value(frame, target.object);
    const index = this.value(frame, target.index);
    const given = this.wantedValue(frame, expr.value, item);
    if (array == undefined || index == undefined || given == undefined) {
      return undefined;
    }

    const value = this.converted(frame, given, item, expr.value.loc);
    if (value == undefined) {
      return undefined;
    }

    const owned = this.owning(frame, value);
    const position = this.toLong(frame, index).value;

    this.elementPlaced(frame, array.value, position, owned, item);
    this.dropping(frame, array);

    return { type: owned.type, value: owned.value, tz: owned.tz };
  }

  private elementUpdated(
    frame: Frame,
    expr: AssignExpr,
    target: IndexExpr,
    item: Type,
    element: string,
  ): IrValue | undefined {
    const isPlain =
      this.isInteger(item) || this.isDouble(item) || this.isString(item);
    if (!isPlain) {
      this.notLowered(frame.module, expr.loc, "an update of this element");

      return undefined;
    }

    const array = this.value(frame, target.object);
    const index = this.value(frame, target.index);
    if (array == undefined || index == undefined) {
      return undefined;
    }

    const position = this.toLong(frame, index).value;
    const data = this.arrayData(frame, array.value);
    const pointer = frame.made.element(element, data, position);
    const place: Place = { pointer, type: element, tz: item, owner: frame.id };
    const updated = this.assignedValue(frame, expr, place);
    if (updated == undefined) {
      return undefined;
    }

    this.stored(frame, place, updated);
    this.dropping(frame, array);

    return { type: updated.type, value: updated.value, tz: updated.tz };
  }

  private elementPlaced(
    frame: Read<Frame>,
    array: LLVMValue,
    position: LLVMValue,
    value: IrValue,
    item: Type,
  ): void {
    const element = value.type;
    const length = this.arrayLength(frame, array);
    const isInside = frame.made.integerCompare(
      IrIntPredicate.UnsignedLess,
      position,
      length,
    );
    const replace = frame.made.block("element.replace");
    const append = frame.made.block("element.append");
    const end = frame.made.block("element.end");

    frame.made.conditionalBranch(isInside, replace, append);
    frame.made.open(replace);

    const data = this.arrayData(frame, array);
    const pointer = frame.made.element(element, data, position);
    const place: Place = { pointer, type: element, tz: item, owner: frame.id };

    this.stored(frame, place, value);
    frame.made.branch(end);
    frame.made.open(append);
    this.pushed(frame, array, value, item);
    frame.made.branch(end);
    frame.made.open(end);
  }

  private byteAssigned(
    frame: Frame,
    expr: AssignExpr,
    target: IndexExpr,
  ): IrValue | undefined {
    const bytes = this.value(frame, target.object);
    const index = this.value(frame, target.index);
    const given = this.value(frame, expr.value);
    if (bytes == undefined || index == undefined || given == undefined) {
      return undefined;
    }

    const byte = this.store.integer(8, true);
    const value = this.converted(frame, given, byte, expr.value.loc);
    if (value == undefined) {
      return undefined;
    }

    const position = this.toLong(frame, index).value;
    const length = this.bytesLength(frame, bytes.value);
    const isInside = frame.made.integerCompare(
      IrIntPredicate.UnsignedLess,
      position,
      length,
    );
    const write = frame.made.block("byte.write");
    const end = frame.made.block("byte.end");

    frame.made.conditionalBranch(isInside, write, end);
    frame.made.open(write);

    const data = this.bytesData(frame, bytes.value);
    const address = frame.made.element(kByteType, data, position);

    frame.made.store(value.value, address);
    frame.made.branch(end);
    frame.made.open(end);
    this.dropping(frame, bytes);

    return value;
  }
}
