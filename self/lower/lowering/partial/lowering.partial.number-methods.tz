import {
  CallExpr,
  MemberExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import {
  IrIntPredicate,
  IrOpcode,
} from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kBooleanType,
  kMathsModule,
  kIntType,
  kIntegerNames,
  kTextModule,
} from "../const/lowering.const.tz";
import { Frame, IrValue, RuntimeTarget } from "../types/lowering.types.tz";

partial class Lowering {
  private numberMethod(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const result = this.typeOf(call);
    const object = tree.exprOf(member.objectId);
    const given = this.value(frame, object);
    if (given == undefined) {
      return undefined;
    }

    const name = member.name;
    if (name == "toString" && tree.argumentsOf(call.argsList).length == 0) {
      return this.numberText(frame, given);
    }
    if (name == "toString" || name == "toFixed") {
      return this.numberShown(frame, call, name, given);
    }
    if (name == "toDecimal") {
      return this.decimalFrom(frame, given);
    }
    if (name == "toDouble") {
      const double = this.values.types.store.plain(TypeKind.Double);

      return this.converted(frame, given, double, call.loc);
    }

    const isConversion = kIntegerNames.includes(name);
    if (!isConversion || result == undefined || !this.isInteger(result)) {
      const called = this.calledName(call);

      this.notLowered(frame.module, call.loc, `a call of method ${called}`);

      return undefined;
    }

    return this.integerFitted(frame, given, this.widened(result));
  }

  private numberShown(
    frame: Frame,
    call: CallExpr,
    name: string,
    given: IrValue,
  ): IrValue | undefined {
    const double = this.values.types.store.plain(TypeKind.Double);
    const value = this.converted(frame, given, double, call.loc);
    const count = this.integerArgument(frame, call, 0);
    if (value == undefined || count == undefined) {
      return undefined;
    }

    let runtime = "toRadix";

    if (name == "toFixed") {
      runtime = name;
    }

    const target: RuntimeTarget = { module: kTextModule, name: runtime };
    const int = this.values.types.store.integer(64, false);
    const digits: IrValue = { type: kIntType, value: count.value, tz: int };

    return this.runtimeFunctionCall(
      frame,
      target,
      [],
      [value, digits],
      call.loc,
    );
  }

  private numberText(frame: Read<Frame>, given: IrValue): IrValue | undefined {
    if (this.isDouble(given.tz)) {
      const target: RuntimeTarget = { module: kTextModule, name: "fromDouble" };
      const loc = this.statementLoc;

      return this.runtimeFunctionCall(frame, target, [], [given], loc);
    }

    const isWideUnsigned =
      this.isUnsigned(given.tz) && this.bitsOf(given.tz) == 64;
    if (isWideUnsigned) {
      const name = "fromUnsigned";
      const target: RuntimeTarget = { module: kTextModule, name };
      const loc = this.statementLoc;

      return this.runtimeFunctionCall(frame, target, [], [given], loc);
    }

    const long = this.toLong(frame, given);
    const target: RuntimeTarget = { module: kTextModule, name: "fromSigned" };

    const loc = this.statementLoc;

    return this.runtimeFunctionCall(frame, target, [], [long], loc);
  }

  private integerFitted(
    frame: Read<Frame>,
    given: IrValue,
    target: Type,
  ): IrValue | undefined {
    const type = this.irType(target);
    if (type == undefined || target.kind != TypeKind.Int) {
      return undefined;
    }
    if (this.isDouble(given.tz)) {
      const opcode = this.fromDouble(target);
      const value = frame.made.cast(opcode, given.value, type);

      return { type, value, tz: target };
    }
    if (!this.isInteger(given.tz)) {
      return undefined;
    }

    const isUnsigned = this.isUnsigned(given.tz);
    const long = this.toLong(frame, given);
    const fits = this.fitTest(frame, long.value, isUnsigned, target);
    const good = frame.made.block("int.fits");
    const bad = frame.made.block("int.does.not.fit");

    frame.made.conditionalBranch(fits, good, bad);
    frame.made.open(bad);

    const boolean = this.values.types.store.plain(TypeKind.Boolean);
    const int = this.values.types.store.integer(64, false);
    const bit = `${this.flagIf(isUnsigned, 1)}`;
    const flagBit = this.ir.integer(kBooleanType, bit);
    const flag: IrValue = { type: kBooleanType, value: flagBit, tz: boolean };
    const shown: IrValue = { type: kIntType, value: long.value, tz: int };
    const unfit: RuntimeTarget = { module: kMathsModule, name: "integerUnfit" };

    const name = this.stringValue(this.integerName(target));

    this.runtimeFunctionCall(frame, unfit, [], [shown, flag, name], 0);
    frame.made.unreachable();
    frame.made.open(good);

    const from = this.bitsOf(given.tz);
    const resized = this.resizing(from, target.bits, given.tz);
    const value = this.sizedCast(frame, given, resized, type);

    return { type, value, tz: target };
  }

  private readonly sizedCast(
    frame: Read<Frame>,
    given: IrValue,
    opcode: IrOpcode,
    type: string,
  ): LLVMValue {
    if (given.type == type) {
      return given.value;
    }

    return frame.made.cast(opcode, given.value, type);
  }

  private readonly fromDouble(target: Type): IrOpcode {
    if (this.isUnsigned(target)) {
      return IrOpcode.FPToUI;
    }

    return IrOpcode.FPToSI;
  }

  private fitTest(
    frame: Read<Frame>,
    long: LLVMValue,
    isUnsigned: boolean,
    target: Type,
  ): LLVMValue {
    const highest = this.integerHighest(target);
    const top = this.ir.integer(kIntType, highest);
    if (isUnsigned) {
      const predicate = IrIntPredicate.UnsignedLessOrEqual;

      return frame.made.integerCompare(predicate, long, top);
    }

    const lowest = this.ir.integer(kIntType, this.integerLowest(target));
    const isAbove = frame.made.integerCompare(
      IrIntPredicate.SignedGreaterOrEqual,
      long,
      lowest,
    );
    if (this.isUnsigned(target) && this.bitsOf(target) == 64) {
      return isAbove;
    }

    const isBelow = frame.made.integerCompare(
      IrIntPredicate.SignedLessOrEqual,
      long,
      top,
    );

    return frame.made.binary(IrOpcode.And, isAbove, isBelow);
  }

  private readonly integerHighest(target: Type): string {
    const bits = this.bitsOf(target);
    if (this.isUnsigned(target) && bits == 64) {
      return "-1";
    }
    if (this.isUnsigned(target)) {
      return `${2 ** bits - 1}`;
    }
    if (bits == 64) {
      return "9223372036854775807";
    }

    return `${2 ** (bits - 1) - 1}`;
  }

  private readonly integerLowest(target: Type): string {
    const bits = this.bitsOf(target);
    if (this.isUnsigned(target)) {
      return "0";
    }
    if (bits == 64) {
      return "-9223372036854775808";
    }

    return `${-(2 ** (bits - 1))}`;
  }

  private readonly integerName(target: Type): string {
    const bits = this.bitsOf(target);
    if (this.isUnsigned(target)) {
      return `uint${bits}`;
    }
    if (bits == 64) {
      return "int";
    }

    return `int${bits}`;
  }
}
