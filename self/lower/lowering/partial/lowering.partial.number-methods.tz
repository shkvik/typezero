import {
  CallExpr,
  MemberExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import {
  IrIntPredicate,
  IrOpcode,
} from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kDoubleType,
  kFlagType,
  kIntType,
  kIntegerNames,
  kNumberFixed,
  kNumberRadix,
  kPanicIntegerFit,
  kPointerType,
  kTextFromDouble,
  kTextFromSigned,
  kTextFromUnsigned,
  kVoidType,
} from "../const/lowering.const.tz";
import { Frame, IrValue } from "../types/lowering.types.tz";

partial class Lowering {
  private numberMethod(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
  ): IrValue | undefined {
    const result = this.typeOf(call);
    const given = this.value(frame, member.object);
    if (given == undefined) {
      return undefined;
    }

    const name = member.name;
    if (name == "toString" && call.args.length == 0) {
      return this.numberText(frame, given);
    }
    if (name == "toString" || name == "toFixed") {
      return this.numberShown(frame, call, name, given);
    }
    if (name == "toDecimal") {
      return this.decimalFrom(frame, given);
    }
    if (name == "toDouble") {
      const double = this.store.plain(TypeKind.Double);

      return this.converted(frame, given, double, call.loc);
    }

    const isConversion = kIntegerNames.includes(name);
    if (!isConversion || result == undefined || !this.isInteger(result)) {
      const called = this.calledName(call);

      this.notLowered(frame.module, call.loc, `a call of method ${called}`);

      return undefined;
    }

    return this.integerFitted(frame, given, this.widened(result));
  }

  private numberShown(
    frame: Frame,
    call: CallExpr,
    name: string,
    given: IrValue,
  ): IrValue | undefined {
    const double = this.store.plain(TypeKind.Double);
    const value = this.converted(frame, given, double, call.loc);
    const count = this.integerArgument(frame, call, 0);
    if (value == undefined || count == undefined) {
      return undefined;
    }

    const runtime = this.pick(name == "toFixed", kNumberFixed, kNumberRadix);
    const params = [kDoubleType, kIntType];

    return this.textOut(frame, runtime, params, [value.value, count.value]);
  }

  private numberText(frame: Frame, given: IrValue): IrValue | undefined {
    if (this.isDouble(given.tz)) {
      const params = [kDoubleType];

      return this.textOut(frame, kTextFromDouble, params, [given.value]);
    }

    const isWideUnsigned =
      this.isUnsigned(given.tz) && this.bitsOf(given.tz) == 64;
    if (isWideUnsigned) {
      const args = [given.value];

      return this.textOut(frame, kTextFromUnsigned, [kIntType], args);
    }

    const long = this.toLong(frame, given);

    return this.textOut(frame, kTextFromSigned, [kIntType], [long.value]);
  }

  private integerFitted(
    frame: Frame,
    given: IrValue,
    target: Type,
  ): IrValue | undefined {
    const made = frame.made;
    const type = this.irType(target);
    if (type == undefined || target.kind != TypeKind.Int) {
      return undefined;
    }
    if (this.isDouble(given.tz)) {
      const opcode = this.fromDouble(target);
      const value = made.cast(opcode, given.value, type);

      return { type, value, tz: target };
    }
    if (!this.isInteger(given.tz)) {
      return undefined;
    }

    const isUnsigned = this.isUnsigned(given.tz);
    const long = this.toLong(frame, given);
    const fits = this.fitTest(frame, long.value, isUnsigned, target);
    const good = made.block("int.fits");
    const bad = made.block("int.does.not.fit");

    made.conditionalBranch(fits, good, bad);
    made.open(bad);

    const panic = this.ir.declare(kPanicIntegerFit, kVoidType, [
      kIntType,
      kFlagType,
      kPointerType,
    ]);
    const flag = this.ir.integer(kFlagType, `${this.flagIf(isUnsigned, 1)}`);

    const name = this.cText(this.integerName(target));

    made.call(panic, [long.value, flag, name]);
    made.unreachable();
    made.open(good);

    const from = this.bitsOf(given.tz);
    const resized = this.resizing(from, target.bits, given.tz);
    const value = this.sizedCast(frame, given, resized, type);

    return { type, value, tz: target };
  }

  private sizedCast(
    frame: Frame,
    given: IrValue,
    opcode: IrOpcode,
    type: string,
  ): LLVMValue {
    if (given.type == type) {
      return given.value;
    }

    return frame.made.cast(opcode, given.value, type);
  }

  private fromDouble(target: Type): IrOpcode {
    if (this.isUnsigned(target)) {
      return IrOpcode.FPToUI;
    }

    return IrOpcode.FPToSI;
  }

  private fitTest(
    frame: Frame,
    long: LLVMValue,
    isUnsigned: boolean,
    target: Type,
  ): LLVMValue {
    const made = frame.made;
    const highest = this.integerHighest(target);
    const top = this.ir.integer(kIntType, highest);
    if (isUnsigned) {
      const predicate = IrIntPredicate.UnsignedLessOrEqual;

      return made.integerCompare(predicate, long, top);
    }

    const lowest = this.ir.integer(kIntType, this.integerLowest(target));
    const isAbove = made.integerCompare(
      IrIntPredicate.SignedGreaterOrEqual,
      long,
      lowest,
    );
    if (this.isUnsigned(target) && this.bitsOf(target) == 64) {
      return isAbove;
    }

    const isBelow = made.integerCompare(
      IrIntPredicate.SignedLessOrEqual,
      long,
      top,
    );

    return made.binary(IrOpcode.And, isAbove, isBelow);
  }

  private integerHighest(target: Type): string {
    const bits = this.bitsOf(target);
    if (this.isUnsigned(target) && bits == 64) {
      return "-1";
    }
    if (this.isUnsigned(target)) {
      return `${2 ** bits - 1}`;
    }
    if (bits == 64) {
      return "9223372036854775807";
    }

    return `${2 ** (bits - 1) - 1}`;
  }

  private integerLowest(target: Type): string {
    const bits = this.bitsOf(target);
    if (this.isUnsigned(target)) {
      return "0";
    }
    if (bits == 64) {
      return "-9223372036854775808";
    }

    return `${-(2 ** (bits - 1))}`;
  }

  private integerName(target: Type): string {
    const bits = this.bitsOf(target);
    if (this.isUnsigned(target)) {
      return `uint${bits}`;
    }
    if (bits == 64) {
      return "int";
    }

    return `int${bits}`;
  }
}
