import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import { IrOpcode } from "../../ir-function/types/ir-function.types.tz";
import { Lowering } from "../lowering.tz";
import { kDoubleType } from "../const/lowering.const.tz";
import { Frame, IrValue } from "../types/lowering.types.tz";

partial class Lowering {
  private converted(
    frame: Frame,
    value: IrValue,
    target: Type,
    loc: int,
  ): IrValue | undefined {
    const type = this.irType(target);
    if (type == undefined) {
      const kind = this.kindName(target);

      this.notLowered(frame.module, loc, `a value of type ${kind}`);

      return undefined;
    }
    if (value.tz.kind == TypeKind.Undefined) {
      return { type, value: this.ir.zero(type), tz: target };
    }

    const inner = this.optionalInner(target);
    const sourceInner = this.optionalInner(value.tz);
    if (inner != undefined && sourceInner == undefined) {
      const placed = this.converted(frame, value, inner, loc);
      if (placed == undefined) {
        return undefined;
      }

      return this.somewhere(frame, placed, target);
    }
    if (sourceInner != undefined && inner == undefined) {
      const inside = this.insideValue(frame, value, sourceInner);

      return this.converted(frame, inside, target, loc);
    }
    const isResults =
      value.tz.kind == TypeKind.Result && target.kind == TypeKind.Result;
    if (isResults && value.tz.id != target.id) {
      return this.resultConverted(frame, value, target);
    }
    if (this.isReshaped(value.tz, target)) {
      return this.reshaped(frame, value, target, loc);
    }
    if (type == value.type) {
      const kept = this.keptLent(value.tz, target);
      const retyped = this.retyped(value, type, kept);

      return this.uniqueOwned(frame, value, retyped);
    }
    if (this.isInteger(value.tz) && this.isInteger(target)) {
      return this.integerConverted(frame, value, target, type);
    }
    if (this.isDecimal(target)) {
      const decimal = this.decimalFrom(frame, value);
      if (decimal != undefined) {
        return decimal;
      }
    }
    if (this.isDecimal(value.tz) && this.isDouble(target)) {
      return this.decimalToDouble(frame, value);
    }
    if (this.isDouble(value.tz) && this.isInteger(target)) {
      return this.saturated(frame, value, target, type);
    }
    if (this.isInteger(value.tz) && this.isDouble(target)) {
      const opcode = this.integerToDouble(value.tz);
      const made = frame.made.cast(opcode, value.value, kDoubleType);

      return { type, value: made, tz: target };
    }

    this.notLowered(frame.module, loc, "this conversion");

    return undefined;
  }

  private keptLent(source: Type, target: Type): Type {
    if (!this.isLookingArray(source) || target.kind != TypeKind.Array) {
      return target;
    }

    return this.values.types.store.lentArrayOf(
      this.values.types.store.itemOf(target),
    );
  }

  private readonly integerConverted(
    frame: Read<Frame>,
    value: IrValue,
    target: Type,
    type: string,
  ): IrValue {
    const from = this.bitsOf(value.tz);
    const to = this.bitsOf(target);
    const opcode = this.resizing(from, to, value.tz);
    const made = frame.made.cast(opcode, value.value, type);

    return { type, value: made, tz: target };
  }

  private readonly resizing(from: int, to: int, source: Type): IrOpcode {
    if (to < from) {
      return IrOpcode.Trunc;
    }
    if (this.isUnsigned(source)) {
      return IrOpcode.ZExt;
    }

    return IrOpcode.SExt;
  }

  private readonly integerToDouble(source: Type): IrOpcode {
    if (this.isUnsigned(source)) {
      return IrOpcode.UIToFP;
    }

    return IrOpcode.SIToFP;
  }

  private readonly isConstant(value: IrValue): boolean {
    return this.ir.isConstant(value.value);
  }

  private doubleValue(value: double): IrValue {
    const tz = this.values.types.store.plain(TypeKind.Double);

    return { type: kDoubleType, value: this.ir.real(value), tz };
  }

  private integerValue(type: string, text: string, tz: Type): IrValue {
    return { type, value: this.ir.integer(type, text), tz };
  }

  private saturated(
    frame: Read<Frame>,
    value: IrValue,
    target: Type,
    type: string,
  ): IrValue {
    const sign = this.pick(this.isUnsigned(target), "u", "s");
    const name = `llvm.fpto${sign}i.sat.${type}.f64`;
    const callee = this.ir.declare(name, type, [kDoubleType]);
    const made = frame.made.call(callee, [value.value]);

    return { type, value: made, tz: target };
  }
}
