import { replace } from "tz:mem";
import { Expr } from "../../../program/ast/types/ast.types.expressions.tz";
import {
  BodySource,
  FunctionDecl,
  Param,
  ParamKind,
} from "../../../program/ast/types/ast.types.functions.tz";
import {
  FunctionParameter,
  FunctionShape,
  Type,
  TypeKind,
} from "../../../program/type/types/type.types.tz";
import { IrFunction } from "../../ir-function/ir-function.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kBooleanType,
  kGivenModes,
  kPointerType,
  kVoidType,
} from "../const/lowering.const.tz";
import { Frame, IrValue, Place } from "../types/lowering.types.tz";

partial class Lowering {
  private functionDeclared(frame: Read<Frame>, fn: FunctionDecl): void {
    const tree = this.values.types.program.tree;

    if (
      fn.bodySource == BodySource.Foreign ||
      tree.typeParamsOf(fn.typeParamsList).length > 0
    ) {
      return;
    }

    const name = this.functionName(frame.module, fn.loc);

    this.functionLowered(frame.module, fn, name);
  }

  private functionLowered(module: int, fn: FunctionDecl, name: string): void {
    const tree = this.values.types.program.tree;

    const body = tree.blockAt(fn.bodyId);
    const shape = this.shapeOf(module, fn.loc);
    if (body == undefined || shape == undefined) {
      return this.notLowered(module, fn.loc, "this function");
    }

    const isPlain =
      !fn.isAsync &&
      !fn.isGenerator &&
      !shape.rest &&
      tree
        .paramsOf(fn.paramsList)
        .every((param) => this.isPlainParameter(param));
    if (!isPlain) {
      return this.notLowered(module, fn.loc, "this kind of function");
    }

    const result = this.irType(shape.result);
    const params = this.parameterTypes(module, fn, shape);
    if (result == undefined || params == undefined) {
      const kind = this.shapeProblem(shape);

      return this.notLowered(module, fn.loc, `a function of type ${kind}`);
    }

    const made = new IrFunction(this.ir, name, result, params);
    const inner: Frame = {
      made,
      id: this.frameId(),
      module,
      result: shape.result,
      loops: [],
      scopes: [],
      place: fn.name,
      isLending: this.isLending(fn),
    };

    this.openScope(inner);
    this.parametersStored(inner, fn, shape, params);
    const bodyItem = tree.stmtsOf(body.bodyList);

    this.statements(inner, bodyItem);
    this.closeScope(inner);
    this.finished(made, result, shape.result);
  }

  private finished(made: IrFunction, result: string, tz?: Type): void {
    if (result == kVoidType) {
      return made.finishVoid();
    }

    const ending = this.fallenOff(made, tz);
    if (ending != undefined) {
      return made.finishValue(ending);
    }

    made.finishUnreachable();
  }

  private fallenOff(
    made: IrFunction,
    tz: Type | undefined,
  ): LLVMValue | undefined {
    if (
      tz == undefined ||
      made.isClosed() ||
      this.optionalInner(tz) == undefined
    ) {
      return undefined;
    }

    return this.undefinedValue(tz)?.value;
  }

  private shapeOf(module: int, loc: int): FunctionShape | undefined {
    const type = this.values.functionOf(module, loc);
    if (type.kind != TypeKind.Function) {
      return undefined;
    }
    if (this.binding.size == 0) {
      return this.values.types.store.functionShapeOf(type);
    }

    const binding = replace(this.binding, new Map<int, Type>());
    const shape = this.shapeWith(
      this.values.types.store.functionShapeOf(type),
      binding,
    );

    this.binding = binding;

    return shape;
  }

  private parameterTypes(
    module: int,
    fn: FunctionDecl,
    shape: Read<FunctionShape>,
  ): string[] | undefined {
    const tree = this.values.types.program.tree;

    const types: string[] = [];

    for (let index = 0; index < tree.paramsOf(fn.paramsList).length; index++) {
      const param = shape.params[index];
      if (param == undefined) {
        return undefined;
      }

      const passed = this.passedType(param);
      const type = this.irType(passed);
      if (type == undefined || type == kVoidType) {
        return undefined;
      }
      if (this.isMovedRecord(passed)) {
        types.push(kPointerType);

        continue;
      }

      types.push(type);
    }

    return types;
  }

  private readonly isPlainParameter(param: Param): boolean {
    const kind = param.form.kind;
    const isTaken =
      kind == ParamKind.Required ||
      kind == ParamKind.Optional ||
      kind == ParamKind.Defaulted;

    return isTaken && param.pattern == undefined;
  }

  private passedType(param: FunctionParameter): Type {
    if (!param.optional || this.optionalInner(param.type) != undefined) {
      return param.type;
    }

    const empty = this.values.types.store.plain(TypeKind.Undefined);

    return this.values.types.store.unionOf([param.type, empty]);
  }

  private parametersStored(
    frame: Frame,
    fn: FunctionDecl,
    shape: Read<FunctionShape>,
    types: Read<string[]>,
  ): void {
    const tree = this.values.types.program.tree;

    for (let index = 0; index < tree.paramsOf(fn.paramsList).length; index++) {
      const param = tree.paramsOf(fn.paramsList)[index];
      const passed = shape.params[index];
      const type = types[index];
      if (param == undefined || passed == undefined || type == undefined) {
        continue;
      }

      const tz = this.passedType(passed);
      const position = index + this.selfOffset(frame);
      const isBorrowed =
        frame.isClosure != true &&
        this.isBorrowedParam(param) &&
        this.isManaged(tz);
      const given: IrValue = {
        type,
        value: frame.made.param(position),
        tz,
        owned: !isBorrowed,
      };
      const form = param.form;
      const isOptional = this.optionalInner(tz) != undefined;
      if (form.kind == ParamKind.Defaulted && isOptional) {
        this.defaultedStored(
          frame,
          param,
          tree.exprOf(form.defaultValueId),
          given,
        );

        continue;
      }

      const pointer = frame.made.slot(type, param.name);
      const key = this.placeKey(frame.module, param.loc);
      const flag = this.dropFlag(frame, isBorrowed);
      const plain: Place = { pointer, type, tz, owner: frame.id, flag };
      const isView = type == kPointerType && this.isMovedRecord(tz);
      let place = plain;

      if (isView) {
        place = this.viewPlace(frame, pointer, tz, flag) ?? plain;
      }

      frame.made.store(given.value, pointer);
      this.places.set(key, place);
      this.keepPlace(frame, place);
    }
  }

  private readonly isBorrowedParam(param: Param): boolean {
    const tree = this.values.types.program.tree;

    const kind = param.form.kind;
    const isPlain =
      (kind == ParamKind.Required || kind == ParamKind.Optional) &&
      param.pattern == undefined &&
      param.property == undefined;
    const ref = tree.typeRefAt(param.typeId);
    const isGiven =
      ref != undefined &&
      tree.typeRefsOf(ref.argsList).length == 1 &&
      kGivenModes.includes(ref.name);

    return isPlain && !isGiven;
  }

  private dropFlag(
    frame: Read<Frame>,
    isBorrowed: boolean,
  ): LLVMValue | undefined {
    if (!isBorrowed) {
      return undefined;
    }

    const flag = frame.made.slot(kBooleanType, "param.owned");

    frame.made.entryStore(this.ir.zero(kBooleanType), flag);

    return flag;
  }

  private droppedAll(frame: Read<Frame>, kept: Read<IrValue[]>): void {
    for (const value of kept) {
      this.dropping(frame, value);
    }
  }

  private defaultedStored(
    frame: Frame,
    param: Param,
    fallback: Expr,
    given: IrValue,
  ): void {
    const inner = this.optionalInner(given.tz);
    const type = this.typeOrUndefined(inner);
    if (inner == undefined || type == undefined) {
      return this.notLowered(frame.module, param.loc, "this default value");
    }

    const pointer = frame.made.slot(type, param.name);
    const key = this.placeKey(frame.module, param.loc);
    const place: Place = { pointer, type, tz: inner, owner: frame.id };
    const has = this.hasValue(frame, given);
    const passed = frame.made.block("default.passed");
    const missing = frame.made.block("default.missing");
    const end = frame.made.block("default.end");

    frame.made.entryStore(this.ir.zero(type), pointer);
    this.places.set(key, place);
    this.keepPlace(frame, place);
    frame.made.conditionalBranch(has, passed, missing);
    frame.made.open(passed);

    const inside = this.insideValue(frame, given, inner);

    frame.made.store(inside.value, pointer);
    frame.made.branch(end);
    frame.made.open(missing);

    const value = this.value(frame, fallback);
    const converted = this.convertedOrNone(frame, value, inner, fallback.loc);

    if (converted != undefined) {
      this.stored(frame, place, converted);
    }

    frame.made.branch(end);
    frame.made.open(end);
  }

  private convertedOrNone(
    frame: Frame,
    value: IrValue | undefined,
    target: Type,
    loc: int,
  ): IrValue | undefined {
    if (value == undefined) {
      return undefined;
    }

    return this.converted(frame, value, target, loc);
  }

  private readonly selfOffset(frame: Read<Frame>): int {
    if (frame.self != undefined || frame.isClosure == true) {
      return 1;
    }

    return 0;
  }

  private readonly functionName(module: int, loc: int): string {
    const name = `tz.f${module}.${loc}`;
    if (!this.isInsideInstance(module, loc)) {
      return name;
    }

    return `${name}.${this.instanceSuffix}`;
  }
}
