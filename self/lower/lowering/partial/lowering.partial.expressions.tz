import {
  ConditionalExpr,
  Expr,
  ExprKind,
  IntLitExpr,
  NameExpr,
  UnaryExpr,
  UnaryOp,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { SymbolKind } from "../../../program/scopes/types/scopes.types.tz";
import {
  LiteralKind,
  Type,
  TypeKind,
} from "../../../program/type/types/type.types.tz";
import {
  IrIntPredicate,
  IrOpcode,
  IrRealPredicate,
} from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kBooleanType,
  kDoubleType,
  kHexPrefix,
  kIntType,
  kLengthMask,
  kNineCode,
  kNoOwner,
  kThisName,
  kTrue,
  kZeroCode,
} from "../const/lowering.const.tz";
import { Frame, IrValue, Place } from "../types/lowering.types.tz";

partial class Lowering {
  private value(frame: Frame, expr: Expr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const ready = this.readyValue(expr);
    if (ready != undefined) {
      return ready;
    }

    const isChained = this.chainedObject(frame, expr);
    if (!isChained) {
      return undefined;
    }

    const constant = this.constantOf(frame, expr);
    if (constant != undefined) {
      return constant;
    }

    switch (expr.kind) {
      case ExprKind.Undefined: {
        const tz = this.values.types.store.plain(TypeKind.Undefined);

        return { type: kBooleanType, value: this.ir.zero(kBooleanType), tz };
      }
      case ExprKind.IntLit:
        return this.intLiteral(frame, expr);
      case ExprKind.FloatLit:
        return this.doubleValue(expr.value);
      case ExprKind.BoolLit:
        return this.booleanValue(expr.value);
      case ExprKind.StringLit:
        return this.stringValue(expr.value);
      case ExprKind.Name:
        return this.nameValue(frame, expr);
      case ExprKind.Binary:
        return this.binary(frame, expr);
      case ExprKind.Unary:
        return this.unary(frame, expr);
      case ExprKind.Assign:
        return this.assigned(frame, expr);
      case ExprKind.Update:
        return this.updated(frame, expr);
      case ExprKind.Call:
        return this.callValue(frame, expr);
      case ExprKind.Conditional:
        return this.conditional(frame, expr);
      case ExprKind.Sequence:
        const exprs = tree.exprsOf(expr.exprsList);

        return this.sequence(frame, exprs);
      case ExprKind.Cast:
        const operand = tree.exprOf(expr.operandId);

        return this.cast(frame, expr, operand);
      case ExprKind.Template:
        return this.templateValue(frame, expr);
      case ExprKind.ArrayLit:
        return this.madeLiteral(frame, expr);
      case ExprKind.ObjectLit:
        return this.objectLiteral(frame, expr);
      case ExprKind.New:
        return this.madeObject(frame, expr);
      case ExprKind.Index:
        return this.indexValue(frame, expr);
      case ExprKind.Member:
        return this.memberValue(frame, expr);
      case ExprKind.OptionalChain:
        return this.chainValue(frame, expr);
      case ExprKind.Function:
        return this.closureMade(frame, expr);
      default:
        this.notLowered(frame.module, expr.loc, `an expression #${expr.kind}`);

        return undefined;
    }
  }

  private constantOf(frame: Read<Frame>, expr: Expr): IrValue | undefined {
    if (expr.kind == ExprKind.IntLit) {
      return this.intLiteral(frame, expr);
    }

    const text = this.enumText(frame, expr);
    if (text != undefined) {
      return this.stringValue(text);
    }

    const number = this.enumNumber(frame, expr);
    if (number != undefined) {
      const int = this.values.types.store.integer(64, false);

      return this.integerValue(kIntType, `${number}`, int);
    }

    const type = this.typeOf(expr);
    if (type == undefined) {
      return undefined;
    }

    const folded = this.values.answers.foldedOf(expr);
    if (folded != undefined && this.isInteger(type)) {
      const tz = this.widened(type);
      const ir = this.irType(tz) ?? kIntType;

      return this.integerValue(ir, `${folded}`, tz);
    }
    if (type.kind != TypeKind.Literal) {
      return undefined;
    }

    switch (type.literal) {
      case LiteralKind.Int: {
        const tz = this.widened(type);

        return this.integerValue(kIntType, type.text, tz);
      }
      case LiteralKind.Boolean:
        return this.booleanValue(type.text == kTrue);
      default:
        return undefined;
    }
  }

  private enumText(frame: Read<Frame>, expr: Expr): string | undefined {
    if (expr.kind != ExprKind.Member) {
      return undefined;
    }

    return this.values.enumText(expr, frame.module);
  }

  private enumNumber(frame: Read<Frame>, expr: Expr): decimal | undefined {
    if (expr.kind != ExprKind.Member) {
      return undefined;
    }

    return this.values.enumNumber(expr, frame.module);
  }

  private booleanValue(value: boolean): IrValue {
    const tz = this.values.types.store.plain(TypeKind.Boolean);
    let text: string = "0";

    if (value) {
      text = "1";
    }

    return this.integerValue(kBooleanType, text, tz);
  }

  private nameValue(frame: Frame, expr: NameExpr): IrValue | undefined {
    const self = frame.self;
    if (expr.name == kThisName && self != undefined) {
      return this.selfValue(frame, self);
    }
    if (this.moves.has(expr.id) && frame.inline == undefined) {
      const moved = this.movedLocal(frame, expr);
      if (moved != undefined) {
        return moved;
      }
    }

    const target = this.values.valueTargetOf(expr, frame.module);
    if (target != undefined && target.kind == SymbolKind.Function) {
      return this.functionValue(frame, expr);
    }

    const place = this.namePlace(frame, expr);
    if (place == undefined) {
      return undefined;
    }

    const loaded = this.namedLoad(frame, expr, place);
    const seen = this.typeOf(expr);
    if (seen == undefined || seen.kind == TypeKind.Error) {
      return loaded;
    }

    const seenType = this.irType(seen);
    if (seenType == undefined) {
      return loaded;
    }
    if (seenType == place.type) {
      return this.retyped(loaded, loaded.type, seen);
    }

    return this.converted(frame, loaded, seen, expr.loc);
  }

  private namedLoad(frame: Read<Frame>, expr: NameExpr, place: Place): IrValue {
    const loaded = this.loaded(frame, place);
    const target = this.values.valueTargetOf(expr, frame.module);
    if (target == undefined) {
      return loaded;
    }

    const key = this.placeKey(target.module, target.loc);
    if (!this.immortalGlobals.has(key)) {
      return loaded;
    }

    return this.staticValue(loaded);
  }

  private namePlace(frame: Read<Frame>, expr: NameExpr): Place | undefined {
    const target = this.values.valueTargetOf(expr, frame.module);
    const isValue =
      target != undefined &&
      (target.kind == SymbolKind.Variable ||
        target.kind == SymbolKind.Parameter);
    if (target == undefined || !isValue) {
      this.notLowered(frame.module, expr.loc, "this name");

      return undefined;
    }

    const key = this.placeKey(target.module, target.loc);
    const place = this.places.get(key);
    if (place == undefined) {
      this.notLowered(frame.module, expr.loc, "this variable");

      return undefined;
    }
    if (place.owner != kNoOwner && place.owner != frame.id) {
      this.notLowered(frame.module, expr.loc, "a captured variable");

      return undefined;
    }

    return place;
  }

  private unary(frame: Frame, expr: UnaryExpr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    switch (expr.op) {
      case UnaryOp.Plus:
      case UnaryOp.NonNull:
        const operand = tree.exprOf(expr.operandId);

        return this.value(frame, operand);
      case UnaryOp.Not:
        const operandExpr = tree.exprOf(expr.operandId);

        return this.negated(frame, operandExpr);
      case UnaryOp.Neg:
        return this.minus(frame, expr);
      case UnaryOp.BitNot:
        return this.inverted(frame, expr);
      default:
        this.notLowered(frame.module, expr.loc, "this operator");

        return undefined;
    }
  }

  private negated(frame: Frame, operand: Expr): IrValue | undefined {
    const test = this.truth(frame, operand);
    if (test == undefined) {
      return undefined;
    }

    const tz = this.values.types.store.plain(TypeKind.Boolean);
    const yes = this.ir.integer(kBooleanType, "1");
    const value = frame.made.binary(IrOpcode.Xor, test, yes);

    return { type: kBooleanType, value, tz };
  }

  private minus(frame: Frame, expr: UnaryExpr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const literal = this.negativeLiteral(frame, expr);
    if (literal != undefined) {
      return literal;
    }

    const operandExpr = tree.exprOf(expr.operandId);
    const operand = this.value(frame, operandExpr);
    if (operand == undefined) {
      return undefined;
    }

    const answered = this.typeOf(expr);
    const isWidened =
      answered != undefined &&
      this.isDouble(answered) &&
      this.isInteger(operand.tz);
    if (isWidened && answered != undefined) {
      const wide = this.converted(frame, operand, answered, expr.loc);
      if (wide != undefined) {
        const value = frame.made.negated(wide.value);

        return { type: wide.type, value, tz: wide.tz };
      }
    }

    const given = this.proven(frame, operand);
    if (this.isDecimal(given.tz)) {
      return this.decimalNegated(frame, given);
    }
    if (this.isDouble(given.tz)) {
      const value = frame.made.negated(given.value);

      return { type: given.type, value, tz: given.tz };
    }
    if (this.isInteger(given.tz)) {
      const zero = this.ir.zero(given.type);
      const value = frame.made.binary(IrOpcode.Sub, zero, given.value);

      return { type: given.type, value, tz: given.tz };
    }

    this.notLowered(frame.module, expr.loc, "this operator");

    return undefined;
  }

  private inverted(frame: Frame, expr: UnaryExpr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const operand = tree.exprOf(expr.operandId);
    const given = this.value(frame, operand);
    if (given == undefined || !this.isInteger(given.tz)) {
      this.notLowered(frame.module, expr.loc, "this operator");

      return undefined;
    }

    const ones = this.ir.integer(given.type, "-1");
    const value = frame.made.binary(IrOpcode.Xor, given.value, ones);

    return { type: given.type, value, tz: given.tz };
  }

  private conditional(
    frame: Frame,
    expr: ConditionalExpr,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const result = this.typeOf(expr);
    const type = this.typeOrUndefined(result);
    const condExpr = tree.exprOf(expr.condId);
    const test = this.truth(frame, condExpr);
    if (result == undefined || type == undefined || test == undefined) {
      this.notLowered(frame.module, expr.loc, "this condition");

      return undefined;
    }

    const then = frame.made.block("cond.then");
    const otherwise = frame.made.block("cond.else");
    const end = frame.made.block("cond.end");

    frame.made.conditionalBranch(test, then, otherwise);
    frame.made.open(then);

    const thenExpr = tree.exprOf(expr.thenExprId);
    const first = this.branchValue(frame, thenExpr, result);
    const firstBlock = frame.made.currentBlock();

    this.jumpTo(frame, end);
    frame.made.open(otherwise);

    const second = this.branchValue(
      frame,
      tree.exprOf(expr.elseExprId),
      result,
    );
    const secondBlock = frame.made.currentBlock();

    this.jumpTo(frame, end);
    frame.made.open(end);

    if (first == undefined || second == undefined) {
      return undefined;
    }

    const value = frame.made.phi(
      type,
      [first.value, second.value],
      [firstBlock, secondBlock],
    );

    return { type, value, tz: result, owned: true };
  }

  private branchValue(
    frame: Frame,
    expr: Expr,
    result: Type,
  ): IrValue | undefined {
    const given = this.wantedValue(frame, expr, result);
    if (given == undefined) {
      return undefined;
    }

    const value = this.converted(frame, given, result, expr.loc);
    if (value == undefined) {
      return undefined;
    }

    return this.owning(frame, value);
  }

  private typeOrUndefined(type: Type | undefined): string | undefined {
    if (type == undefined) {
      return undefined;
    }

    return this.irType(type);
  }

  private sequence(frame: Frame, exprs: Read<Expr[]>): IrValue | undefined {
    let last: IrValue | undefined = undefined;

    for (const expr of exprs) {
      if (last != undefined) {
        this.dropping(frame, last);
      }

      last = this.value(frame, expr);
    }

    return last;
  }

  private cast(frame: Frame, expr: Expr, operand: Expr): IrValue | undefined {
    const target = this.typeOf(expr);
    const given = this.value(frame, operand);
    if (target == undefined || given == undefined) {
      return undefined;
    }

    return this.converted(frame, given, target, expr.loc);
  }

  private truth(frame: Frame, expr: Expr): LLVMValue | undefined {
    const value = this.value(frame, expr);
    if (value == undefined) {
      return undefined;
    }

    const inner = this.optionalInner(value.tz);
    const isMarked =
      inner != undefined &&
      (this.isReferenceLike(inner) || this.isInPlace(inner));
    if (isMarked) {
      const has = this.hasValue(frame, value);

      this.dropping(frame, value);

      return has;
    }
    if (inner != undefined) {
      const inside = this.insideValue(frame, value, inner);
      const borrowed: IrValue = {
        type: inside.type,
        value: inside.value,
        tz: inside.tz,
      };
      const test = this.truthOf(frame, borrowed, expr);

      this.dropping(frame, value);

      return test;
    }

    return this.truthOf(frame, value, expr);
  }

  private truthOf(
    frame: Read<Frame>,
    value: IrValue,
    expr: Expr,
  ): LLVMValue | undefined {
    if (this.isBoolean(value.tz)) {
      return value.value;
    }
    if (this.isInteger(value.tz)) {
      const zero = this.ir.zero(value.type);

      return frame.made.integerCompare(
        IrIntPredicate.NotEqual,
        value.value,
        zero,
      );
    }
    if (this.isDouble(value.tz)) {
      const zero = this.ir.zero(kDoubleType);

      return frame.made.realCompare(
        IrRealPredicate.OrderedNotEqual,
        value.value,
        zero,
      );
    }
    if (this.isReferenceLike(value.tz) || this.isInPlace(value.tz)) {
      this.dropping(frame, value);

      return this.ir.integer(kBooleanType, "1");
    }
    if (this.isString(value.tz)) {
      const meta = frame.made.extract(value.value, 1);
      const mask = this.ir.hexInteger(kIntType, kLengthMask);
      const length = frame.made.binary(IrOpcode.And, meta, mask);
      const zero = this.ir.zero(kIntType);
      const test = frame.made.integerCompare(
        IrIntPredicate.NotEqual,
        length,
        zero,
      );

      this.dropping(frame, value);

      return test;
    }

    this.notLowered(frame.module, expr.loc, "a test of this type");

    return undefined;
  }

  private intLiteral(frame: Read<Frame>, expr: IntLitExpr): IrValue {
    const answered = this.typeOf(expr);
    let tz = this.values.types.store.integer(64, false);

    if (answered != undefined && this.isInteger(answered)) {
      tz = this.widened(answered);
    }

    const type = this.irType(tz) ?? kIntType;
    const written = this.writtenDigits(frame, expr);
    if (written == undefined) {
      return this.integerValue(type, `${expr.value}`, tz);
    }

    const isWide =
      answered != undefined &&
      this.isDouble(answered) &&
      !written.startsWith(kHexPrefix);
    if (isWide) {
      const wide = this.values.types.store.plain(TypeKind.Double);

      return { type: kDoubleType, value: this.ir.realOf(written), tz: wide };
    }
    if (written.startsWith(kHexPrefix)) {
      const digits = written.slice(kHexPrefix.length);

      return { type, value: this.ir.hexInteger(type, digits), tz };
    }

    return this.integerValue(type, written, tz);
  }

  private negativeLiteral(
    frame: Read<Frame>,
    expr: UnaryExpr,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const operand = tree.exprOf(expr.operandId);
    const answered = this.typeOf(expr);
    if (operand.kind != ExprKind.IntLit || answered == undefined) {
      return undefined;
    }
    if (!this.isDouble(answered)) {
      return undefined;
    }

    const written = this.writtenDigits(frame, operand);
    if (written == undefined || written.startsWith(kHexPrefix)) {
      return undefined;
    }

    const wide = this.values.types.store.plain(TypeKind.Double);

    return {
      type: kDoubleType,
      value: this.ir.realOf(`-${written}`),
      tz: wide,
    };
  }

  private readonly writtenDigits(
    frame: Read<Frame>,
    expr: IntLitExpr,
  ): string | undefined {
    const span = expr.text;
    const module = this.values.types.program.modules[frame.module];
    if (span == undefined || module == undefined) {
      return undefined;
    }

    const bytes = module.source.text.subarray(span.start, span.end);
    const written = bytes.toString().replaceAll("_", "").toLowerCase();
    if (written.startsWith(kHexPrefix)) {
      return written;
    }

    if (!this.isDigitText(written)) {
      return undefined;
    }

    return written;
  }

  private readonly isDigitText(text: string): boolean {
    if (text.length == 0) {
      return false;
    }

    for (let index = 0; index < text.length; index++) {
      const code = text.charCodeAt(index);
      if (code < kZeroCode || code > kNineCode) {
        return false;
      }
    }

    return true;
  }
}
