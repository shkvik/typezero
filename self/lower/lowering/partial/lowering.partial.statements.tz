import {
  BinaryExpr,
  BinaryOp,
  Expr,
  ExprKind,
  NameExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { VarDeclarator } from "../../../program/ast/types/ast.types.patterns.tz";
import {
  IfStmt,
  JumpStmt,
  LabeledStmt,
  ReturnStmt,
  Stmt,
  StmtKind,
  VarDeclStmt,
} from "../../../program/ast/types/ast.types.statements.tz";
import { Module } from "../../../program/module/types/module.types.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import { LLVMBlock, LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import { kBooleanType, kDebugger, kNoOwner } from "../const/lowering.const.tz";
import { Frame, IrValue, LoopTarget, Place } from "../types/lowering.types.tz";

partial class Lowering {
  private statement(frame: Frame, statement: Stmt): void {
    const tree = this.values.types.program.tree;

    this.statementLoc = statement.loc;

    switch (statement.kind) {
      case StmtKind.Expr:
        const expr = tree.exprOf(statement.exprId);

        return this.discarded(frame, expr);
      case StmtKind.VarDecl:
        return this.variables(frame, statement);
      case StmtKind.Block:
        const body = tree.stmtsOf(statement.bodyList);

        return this.block(frame, body);
      case StmtKind.If:
        return this.ifStatement(frame, statement);
      case StmtKind.While:
        return this.whileLoop(frame, statement);
      case StmtKind.DoWhile:
        return this.doWhileLoop(frame, statement);
      case StmtKind.For:
        return this.forLoop(frame, statement);
      case StmtKind.ForOf:
        return this.forOfLoop(frame, statement);
      case StmtKind.Labeled:
        return this.labeled(frame, statement);
      case StmtKind.Switch:
        return this.switchStatement(frame, statement);
      case StmtKind.Return:
        return this.returned(frame, statement);
      case StmtKind.Break:
      case StmtKind.Continue:
        return this.jump(frame, statement);
      case StmtKind.Function:
        return this.functionDeclared(frame, statement);
      case StmtKind.Class:
        return this.classDeclared(frame, statement);
      case StmtKind.Debugger:
        return this.runtimeCall(frame.made, kDebugger, []);
      case StmtKind.Empty:
      case StmtKind.Enum:
      case StmtKind.TypeAlias:
      case StmtKind.Handle:
        return;
      default:
        return this.notLowered(frame.module, statement.loc, "this statement");
    }
  }

  private block(frame: Frame, body: Read<Stmt[]>): void {
    this.openScope(frame);
    this.statements(frame, body);
    this.closeScope(frame);
  }

  private statements(frame: Frame, body: Read<Stmt[]>): void {
    for (const statement of body) {
      this.statement(frame, statement);
    }
  }

  private discarded(frame: Frame, expr: Expr): void {
    const value = this.value(frame, expr);
    if (value != undefined) {
      this.dropping(frame, value);
    }
  }

  private moduleGlobals(module: int): void {
    const tree = this.values.types.program.tree;
    const items = this.values.types.program.modules[module]?.file.itemsList;

    for (const statement of tree.stmtsOf(items)) {
      if (statement.kind != StmtKind.VarDecl) {
        continue;
      }

      for (const decl of tree.declaratorsOf(statement.declsList)) {
        this.moduleGlobal(module, decl, statement.isConst);
      }
    }
  }

  private moduleGlobal(
    module: int,
    decl: VarDeclarator,
    isConst: boolean,
  ): void {
    const tz = this.values.variableOf(module, decl.loc);
    const type = this.typeOfVariable(module, decl, tz);
    if (tz == undefined || type == undefined) {
      return;
    }

    const name = `tz.g${module}.${decl.loc}`;
    const zero = this.ir.zero(type);
    const pointer = this.ir.global(name, type, zero, false);
    const key = this.placeKey(module, decl.loc);
    const place: Place = { pointer, type, tz, owner: kNoOwner };

    this.places.set(key, place);

    if (this.isManaged(tz)) {
      this.managedGlobals.push(place);
    }
    if (isConst && this.isImmortalKind(tz)) {
      this.immortalGlobals.add(key);
    }
  }

  private variableTypeIn(frame: Frame, decl: VarDeclarator): Type | undefined {
    const tree = this.values.types.program.tree;

    const variable = this.values.variableOf(frame.module, decl.loc);
    const tz = this.boundOrNone(variable);
    const init = tree.exprAt(decl.initId);
    if (init != undefined && init.kind == ExprKind.Binary) {
      if (init.op == BinaryOp.Nullish) {
        return this.nullishResult(frame, init) ?? tz;
      }
    }
    if (tz != undefined && init != undefined && tz.kind == TypeKind.Array) {
      return this.lentHolding(frame, init, tz);
    }
    if (tz == undefined || tz.kind != TypeKind.Error || init == undefined) {
      return tz;
    }

    return this.typeIn(frame, init) ?? tz;
  }

  private lentHolding(frame: Frame, init: Expr, declared: Type): Type {
    const given = this.typeIn(frame, init);
    if (given == undefined || !this.isLookingArray(given)) {
      return declared;
    }

    return this.values.types.store.lentArrayOf(
      this.values.types.store.itemOf(declared),
    );
  }

  private typeOfVariable(
    module: int,
    decl: VarDeclarator,
    tz: Type | undefined,
  ): string | undefined {
    if (tz == undefined) {
      this.notLowered(module, decl.loc, "a variable without a type");

      return undefined;
    }

    const type = this.irType(tz);
    if (type == undefined) {
      const kind = this.kindName(tz);

      this.notLowered(module, decl.loc, `a variable of type ${kind}`);
    }

    return type;
  }

  private variables(frame: Frame, statement: VarDeclStmt): void {
    const tree = this.values.types.program.tree;

    for (const decl of tree.declaratorsOf(statement.declsList)) {
      if (!statement.isConst) {
        this.letKeys.add(this.placeKey(frame.module, decl.loc));
      }

      this.variable(frame, decl);
    }
  }

  private variable(frame: Frame, decl: VarDeclarator): void {
    const tree = this.values.types.program.tree;

    const key = this.placeKey(frame.module, decl.loc);
    const known = this.places.get(key);
    const place = this.globalOrNone(known) ?? this.localPlace(frame, decl);
    if (place == undefined) {
      return;
    }

    const init = tree.exprAt(decl.initId);
    if (init == undefined) {
      return frame.made.store(this.ir.zero(place.type), place.pointer);
    }
    if (
      place.flag != undefined &&
      init.kind == ExprKind.Binary &&
      init.op == BinaryOp.Nullish
    ) {
      return this.nullishInitialized(frame, place, init);
    }

    const given = this.wantedValue(frame, init, place.tz);
    if (given == undefined) {
      return;
    }

    const value = this.converted(frame, given, place.tz, init.loc);
    if (value == undefined) {
      return;
    }

    this.initialized(frame, place, value);
    this.immortalGlobal(frame, place, key);
  }

  private nullishInitialized(
    frame: Frame,
    place: Place,
    init: BinaryExpr,
  ): void {
    const given = this.nullishValue(frame, init, true);
    if (given == undefined) {
      return;
    }

    const value = this.converted(frame, given, place.tz, init.loc);
    if (value != undefined) {
      this.flaggedInitialized(frame, place, value, given.ownedFlag);
    }
  }

  private flaggedInitialized(
    frame: Read<Frame>,
    place: Place,
    value: IrValue,
    ownedFlag: LLVMValue | undefined,
  ): void {
    const flag = place.flag;
    if (flag == undefined || ownedFlag == undefined) {
      return this.initialized(frame, place, value);
    }

    frame.made.store(value.value, place.pointer);
    frame.made.store(ownedFlag, flag);
  }

  private initialized(frame: Read<Frame>, place: Place, value: IrValue): void {
    const flag = place.flag;
    if (flag == undefined) {
      return this.stored(frame, place, value);
    }
    if (value.owned == true) {
      frame.made.store(this.ir.zero(kBooleanType), flag);

      return this.stored(frame, place, value);
    }

    frame.made.store(value.value, place.pointer);
    frame.made.store(this.ir.zero(kBooleanType), flag);
  }

  private readonly globalOrNone(place: Place | undefined): Place | undefined {
    if (place == undefined || place.owner != kNoOwner) {
      return undefined;
    }

    return place;
  }

  private boundPlace(
    frame: Frame,
    decl: VarDeclarator,
    item: Type,
    isUnknown: boolean,
  ): Place | undefined {
    if (!isUnknown) {
      return this.localPlace(frame, decl);
    }

    const type = this.typeOfVariable(frame.module, decl, item);
    if (type == undefined) {
      return undefined;
    }

    const pointer = frame.made.slot(type, decl.name);
    const place: Place = { pointer, type, tz: item, owner: frame.id };
    const key = this.placeKey(frame.module, decl.loc);

    frame.made.entryStore(this.ir.zero(type), pointer);
    this.places.set(key, place);
    this.keepPlace(frame, place);

    return place;
  }

  private localPlace(frame: Frame, decl: VarDeclarator): Place | undefined {
    const tz = this.variableTypeIn(frame, decl);
    const type = this.typeOfVariable(frame.module, decl, tz);
    if (tz == undefined || type == undefined) {
      return undefined;
    }

    const pointer = frame.made.slot(type, decl.name);
    const key = this.placeKey(frame.module, decl.loc);
    const isBorrow = this.borrows.has(key) && this.isManaged(tz);
    const flag = this.dropFlag(frame, isBorrow);
    const place: Place = { pointer, type, tz, owner: frame.id, flag };

    frame.made.entryStore(this.ir.zero(type), pointer);
    this.places.set(key, place);
    this.keepPlace(frame, place);

    return place;
  }

  private ifStatement(frame: Frame, statement: IfStmt): void {
    const tree = this.values.types.program.tree;

    const cond = tree.exprOf(statement.condId);
    const test = this.truth(frame, cond);
    if (test == undefined) {
      return;
    }

    const then = frame.made.block("if.then");
    const otherwise = frame.made.block("if.else");
    const end = frame.made.block("if.end");
    const elseStmt = tree.stmtAt(statement.elseStmtId);
    let missed: LLVMBlock = end;

    if (elseStmt != undefined) {
      missed = otherwise;
    }

    frame.made.conditionalBranch(test, then, missed);
    frame.made.open(then);
    const thenStmt = tree.stmtOf(statement.thenStmtId);

    this.statement(frame, thenStmt);
    this.jumpTo(frame, end);

    frame.made.open(otherwise);

    if (elseStmt != undefined) {
      this.statement(frame, elseStmt);
    }

    this.jumpTo(frame, end);
    frame.made.open(end);
  }

  private readonly jumpTo(frame: Read<Frame>, block: LLVMBlock): void {
    if (!frame.made.isClosed()) {
      frame.made.branch(block);
    }
  }

  private labeled(frame: Frame, statement: LabeledStmt): void {
    const tree = this.values.types.program.tree;

    const body = tree.stmtOf(statement.bodyId);
    const isLoop =
      body.kind == StmtKind.While ||
      body.kind == StmtKind.DoWhile ||
      body.kind == StmtKind.For ||
      body.kind == StmtKind.ForOf;
    if (isLoop) {
      this.pendingLabel = statement.label;

      return this.statement(frame, body);
    }

    const end = frame.made.block("label.end");
    const target: LoopTarget = {
      breakBlock: end,
      label: statement.label,
      depth: frame.scopes.length,
    };

    frame.loops.push(target);
    this.statement(frame, body);
    frame.loops.pop();
    frame.made.open(end);
  }

  private jump(frame: Read<Frame>, statement: JumpStmt): void {
    const isBreak = statement.kind == StmtKind.Break;
    const target = this.jumpTarget(frame, statement.label, isBreak);
    if (target == undefined) {
      return this.notLowered(frame.module, statement.loc, "this jump");
    }

    this.cleanupsTo(frame, target.depth);

    const goal = target.continueBlock;
    if (isBreak || goal == undefined) {
      return frame.made.branch(target.breakBlock);
    }

    frame.made.branch(goal);
  }

  private readonly jumpTarget(
    frame: Read<Frame>,
    label: string,
    isBreak: boolean,
  ): LoopTarget | undefined {
    for (let index = frame.loops.length - 1; index >= 0; index--) {
      const target = frame.loops[index];
      if (target == undefined) {
        continue;
      }
      if (label != "" && target.label == label) {
        return target;
      }
      if (label == "" && (isBreak || target.continueBlock != undefined)) {
        return target;
      }
    }

    return undefined;
  }

  private returned(frame: Frame, statement: ReturnStmt): void {
    const tree = this.values.types.program.tree;

    const inline = frame.inline;
    if (inline != undefined) {
      return this.inlineReturned(frame, statement, inline);
    }

    const given = tree.exprAt(statement.valueId);
    const result = frame.result;
    if (given == undefined || result == undefined) {
      this.cleanupsTo(frame, 0);

      return frame.made.returnedVoid();
    }
    if (result.kind == TypeKind.Void) {
      this.discarded(frame, given);
      this.cleanupsTo(frame, 0);

      return frame.made.returnedVoid();
    }

    const moved = this.movedLocal(frame, given);
    const value = moved ?? this.wantedValue(frame, given, result);
    if (value == undefined) {
      return;
    }

    const returned = this.converted(frame, value, result, given.loc);
    if (returned == undefined) {
      return;
    }
    if (frame.isLending == true) {
      return this.lentReturned(frame, returned);
    }

    const owned = this.owning(frame, returned);

    this.cleanupsTo(frame, 0);
    frame.made.returned(owned.value);
  }

  private ownLocalPlace(
    frame: Read<Frame>,
    given: NameExpr,
  ): Place | undefined {
    const target = this.values.valueTargetOf(given, frame.module);
    if (target == undefined) {
      return undefined;
    }

    const key = this.placeKey(target.module, target.loc);
    const place = this.places.get(key);
    if (
      place == undefined ||
      place.owner != frame.id ||
      place.isCaptured == true
    ) {
      return undefined;
    }
    if (place.flag != undefined || !this.isManaged(place.tz)) {
      return undefined;
    }

    return place;
  }

  private lentReturned(frame: Read<Frame>, returned: IrValue): void {
    this.cleanupsTo(frame, 0);
    this.dropping(frame, returned);
    frame.made.returned(returned.value);
  }

  private movedLocal(frame: Read<Frame>, given: Expr): IrValue | undefined {
    if (given.kind != ExprKind.Name) {
      return undefined;
    }

    const place = this.ownLocalPlace(frame, given);
    if (place == undefined) {
      return undefined;
    }

    const value = frame.made.load(place.type, place.pointer);

    frame.made.store(this.ir.zero(place.type), place.pointer);

    return { type: place.type, value, tz: place.tz, owned: true };
  }
}
