import {
  CallExpr,
  NameExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import { IrOpcode } from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kCharType,
  kIntType,
  kMemoryAllocate,
  kMemoryFree,
  kMemoryMove,
  kMemoryResize,
  kHashMask,
  kHashMultiplier,
  kMapModule,
  kTextHashName,
  kPointerType,
  kVoidType,
} from "../const/lowering.const.tz";
import { Frame, IrValue, RuntimeTarget } from "../types/lowering.types.tz";

partial class Lowering {
  private unsafeCall(
    frame: Frame,
    call: CallExpr,
    callee: NameExpr,
  ): IrValue | undefined {
    if (callee.name == "isAscii") {
      return this.textIsAscii(frame, call);
    }
    if (callee.name == "textObject" || callee.name == "textMeta") {
      return this.textPiece(frame, call, callee.name == "textMeta");
    }
    if (callee.name == "textOf") {
      return this.textJoined(frame, call);
    }
    if (callee.name == "doubleBits") {
      return this.bitsOfDouble(frame, call);
    }
    if (callee.name == "bitsDouble") {
      return this.doubleOfBits(frame, call);
    }
    if (callee.name == "productShifted") {
      return this.shiftedProduct(frame, call);
    }
    if (callee.name == "rawBits") {
      return this.bitsOfRaw(frame, call);
    }
    if (callee.name == "invoked") {
      return this.invokedCall(frame, call);
    }
    if (callee.name == "entryOf") {
      return this.entryOfFunction(frame, call);
    }
    if (callee.name == "bufferOf" || callee.name == "jsonOf") {
      return this.bufferOfRaw(frame, call);
    }
    if (callee.name == "wrappedProduct") {
      return this.productWrapped(frame, call);
    }
    if (callee.name == "compared") {
      return this.comparedCall(frame, call);
    }
    if (callee.name == "threadState") {
      return this.threadStateOf(call);
    }
    if (callee.name == "dropped") {
      return this.droppedCall(frame, call);
    }
    if (callee.name == "bitsRaw") {
      return this.rawOfBits(frame, call);
    }
    if (callee.name == "textTree") {
      return this.textTreeMade(frame, call);
    }
    if (callee.name == "decimalCoef" || callee.name == "decimalMeta") {
      return this.decimalPiece(frame, call, callee.name == "decimalMeta");
    }
    if (callee.name == "decimalOf") {
      return this.decimalJoined(frame, call);
    }

    const written = this.values.typeArgumentsOf(frame.module, callee.loc);
    const first = written?.[0];
    const other = written?.[1];
    const item = this.boundOrNone(first);
    const cell = this.typeOrNone(item);
    const second = this.boundOrNone(other);
    const targetCell = this.typeOrNone(second) ?? cell;
    if (item == undefined || cell == undefined || targetCell == undefined) {
      this.notLowered(frame.module, call.loc, "a call of this unsafe function");

      return undefined;
    }

    switch (callee.name) {
      case "allocate":
        return this.rawAllocated(frame, call, cell);
      case "reallocate":
        return this.rawReallocated(frame, call, cell);
      case "release":
        return this.rawReleased(frame, call);
      case "putAt":
        return this.cellPut(frame, call, cell, item);
      case "takeAt":
        return this.cellRead(frame, call, cell, item, true);
      case "peekAt":
        return this.cellRead(frame, call, cell, item, false);
      case "destroyAt":
        return this.cellDestroyed(frame, call, cell, item);
      case "shiftCells":
        return this.cellsShifted(frame, call, cell);
      case "forget":
        return this.forgotten(frame, call);
      case "arrayCells":
        return this.arrayCellsOf(frame, call);
      case "hashOf":
        return this.keyHash(frame, call, item);
      case "textCells":
        return this.textCellsOf(frame, call, cell);
      case "unitAt":
        return this.unitRead(frame, call, cell);
      case "findUnit":
        return this.unitFound(frame, call, cell);
      case "sameCells":
        return this.cellsCompared(frame, call, cell);
      case "copyCells":
        return this.cellsCopied(frame, call, cell, targetCell);
      case "putUnit":
        return this.unitWritten(frame, call, cell);
      case "frameCells":
        return this.frameCellsOf(frame, call, cell);
      case "cellsAt":
        return this.cellsAtMade(frame, call);
      case "viewAt":
        return this.viewRead(frame, call, item, cell);
      case "textRoom":
        return this.textRoomOf(frame, call, cell);
      case "textClosed":
        return this.textMade(frame, call, cell);
      default:
        this.notLowered(
          frame.module,
          call.loc,
          "a call of this unsafe function",
        );

        return undefined;
    }
  }

  private typeOrNone(type: Type | undefined): string | undefined {
    if (type == undefined) {
      return undefined;
    }

    return this.irType(type);
  }

  private rawAllocated(
    frame: Frame,
    call: CallExpr,
    cell: string,
  ): IrValue | undefined {
    const count = this.intArgument(frame, call, 0);
    if (count == undefined) {
      return undefined;
    }

    const bytes = this.cellBytes(frame, cell, count);
    const name = this.memoryHelper(kMemoryAllocate);
    const allocating = this.ir.declare(name, kPointerType, [kIntType]);
    const value = frame.made.call(allocating, [bytes]);

    return this.rawMade(call, value);
  }

  private rawReallocated(
    frame: Frame,
    call: CallExpr,
    cell: string,
  ): IrValue | undefined {
    const raw = this.rawArgument(frame, call, 0);
    const count = this.intArgument(frame, call, 1);
    if (raw == undefined || count == undefined) {
      return undefined;
    }

    const bytes = this.cellBytes(frame, cell, count);
    const params = [kPointerType, kIntType];
    const name = this.memoryHelper(kMemoryResize);
    const resizing = this.ir.declare(name, kPointerType, params);
    const value = frame.made.call(resizing, [raw, bytes]);

    return this.rawMade(call, value);
  }

  private rawReleased(frame: Frame, call: CallExpr): IrValue | undefined {
    const raw = this.rawArgument(frame, call, 0);
    if (raw == undefined) {
      return undefined;
    }

    const name = this.memoryHelper(kMemoryFree);
    const freeing = this.ir.declare(name, kVoidType, [kPointerType]);

    frame.made.call(freeing, [raw]);

    return this.nothing();
  }

  private cellPut(
    frame: Frame,
    call: CallExpr,
    cell: string,
    item: Type,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const raw = this.rawArgument(frame, call, 0);
    const index = this.intArgument(frame, call, 1);
    const argument = tree.argumentsOf(call.argsList)[2];
    if (raw == undefined || index == undefined || argument == undefined) {
      return undefined;
    }

    const expr = tree.exprOf(argument.exprId);
    const given = this.wantedValue(frame, expr, item);
    if (given == undefined) {
      return undefined;
    }

    const value = this.converted(
      frame,
      given,
      item,
      tree.exprOf(argument.exprId).loc,
    );
    if (value == undefined) {
      return undefined;
    }

    const owned = this.owning(frame, value);
    const address = frame.made.element(cell, raw, index);

    frame.made.store(owned.value, address);

    return this.nothing();
  }

  private cellRead(
    frame: Frame,
    call: CallExpr,
    cell: string,
    item: Type,
    isTaken: boolean,
  ): IrValue | undefined {
    const raw = this.rawArgument(frame, call, 0);
    const index = this.intArgument(frame, call, 1);
    if (raw == undefined || index == undefined) {
      return undefined;
    }

    const address = frame.made.element(cell, raw, index);
    const value = frame.made.load(cell, address);

    return { type: cell, value, tz: item, owned: isTaken };
  }

  private cellDestroyed(
    frame: Frame,
    call: CallExpr,
    cell: string,
    item: Type,
  ): IrValue | undefined {
    const read = this.cellRead(frame, call, cell, item, true);
    if (read == undefined) {
      return undefined;
    }

    this.dropping(frame, read);

    return this.nothing();
  }

  private cellsShifted(
    frame: Frame,
    call: CallExpr,
    cell: string,
  ): IrValue | undefined {
    const raw = this.rawArgument(frame, call, 0);
    const from = this.intArgument(frame, call, 1);
    const to = this.intArgument(frame, call, 2);
    const count = this.intArgument(frame, call, 3);
    if (raw == undefined || from == undefined) {
      return undefined;
    }
    if (to == undefined || count == undefined) {
      return undefined;
    }

    const source = frame.made.element(cell, raw, from);
    const target = frame.made.element(cell, raw, to);
    const bytes = this.cellBytes(frame, cell, count);
    const params = [kPointerType, kPointerType, kIntType];
    const moving = this.ir.declare(kMemoryMove, kPointerType, params);

    frame.made.call(moving, [target, source, bytes]);

    return this.nothing();
  }

  private forgotten(frame: Frame, call: CallExpr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const argument = tree.argumentsOf(call.argsList)[0];
    if (argument == undefined) {
      return undefined;
    }

    const expr = tree.exprOf(argument.exprId);
    const given = this.value(frame, expr);
    if (given == undefined) {
      return undefined;
    }

    return this.nothing();
  }

  private arrayCellsOf(frame: Frame, call: CallExpr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const argument = tree.argumentsOf(call.argsList)[0];
    if (argument == undefined) {
      return undefined;
    }

    const expr = tree.exprOf(argument.exprId);
    const array = this.value(frame, expr);
    if (array == undefined) {
      return undefined;
    }

    const data = this.arrayData(frame, array.value);

    return this.rawMade(call, data);
  }

  private keyHash(
    frame: Frame,
    call: CallExpr,
    item: Type,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const argument = tree.argumentsOf(call.argsList)[0];
    if (argument == undefined) {
      return undefined;
    }

    const expr = tree.exprOf(argument.exprId);
    const given = this.value(frame, expr);
    if (given == undefined) {
      return undefined;
    }
    if (this.isString(item)) {
      const target: RuntimeTarget = { module: kMapModule, name: kTextHashName };
      const hashed = this.runtimeFunctionCall(
        frame,
        target,
        [],
        [given],
        call.loc,
      );

      this.dropping(frame, given);

      return hashed;
    }

    const bits = this.keyBits(frame, given, item);
    if (bits == undefined) {
      this.notLowered(frame.module, call.loc, "a hash of this key");

      return undefined;
    }

    const tz = this.values.types.store.integer(64, false);
    const mixed = this.mixedBits(frame, bits);

    this.dropping(frame, given);

    return { type: kIntType, value: mixed, tz };
  }

  private readonly keyBits(
    frame: Read<Frame>,
    given: IrValue,
    item: Type,
  ): LLVMValue | undefined {
    if (this.isInteger(item)) {
      return this.wideInteger(frame, given, item);
    }
    if (this.isBoolean(item)) {
      return frame.made.cast(IrOpcode.ZExt, given.value, kIntType);
    }
    if (given.type == kPointerType) {
      return frame.made.cast(IrOpcode.PtrToInt, given.value, kIntType);
    }

    return undefined;
  }

  private readonly wideInteger(
    frame: Read<Frame>,
    given: IrValue,
    item: Type,
  ): LLVMValue {
    if (given.type == kIntType) {
      return given.value;
    }

    if (this.isUnsigned(item)) {
      return frame.made.cast(IrOpcode.ZExt, given.value, kIntType);
    }

    return frame.made.cast(IrOpcode.SExt, given.value, kIntType);
  }

  private mixedBits(frame: Read<Frame>, bits: LLVMValue): LLVMValue {
    const golden = this.ir.hexInteger(kIntType, kHashMultiplier);
    const shift = this.ir.integer(kIntType, "32");
    const spread = frame.made.binary(IrOpcode.Mul, bits, golden);
    const high = frame.made.binary(IrOpcode.LShr, spread, shift);
    const mixed = frame.made.binary(IrOpcode.Xor, spread, high);
    const keep = this.ir.hexInteger(kIntType, kHashMask);

    return frame.made.binary(IrOpcode.And, mixed, keep);
  }

  private cellBytes(
    frame: Read<Frame>,
    cell: string,
    count: LLVMValue,
  ): LLVMValue {
    const size = this.ir.sizeOf(cell);

    return frame.made.binary(IrOpcode.Mul, count, size);
  }

  private rawArgument(
    frame: Frame,
    call: CallExpr,
    position: int,
  ): LLVMValue | undefined {
    const tree = this.values.types.program.tree;

    const argument = tree.argumentsOf(call.argsList)[position];
    if (argument == undefined) {
      return undefined;
    }

    return this.value(frame, tree.exprOf(argument.exprId))?.value;
  }

  private intArgument(
    frame: Frame,
    call: CallExpr,
    position: int,
  ): LLVMValue | undefined {
    const tree = this.values.types.program.tree;

    const argument = tree.argumentsOf(call.argsList)[position];
    if (argument == undefined) {
      return undefined;
    }

    const int = this.values.types.store.integer(64, false);
    const expr = tree.exprOf(argument.exprId);
    const given = this.wantedValue(frame, expr, int);
    if (given == undefined) {
      return undefined;
    }

    return this.converted(frame, given, int, tree.exprOf(argument.exprId).loc)
      ?.value;
  }

  private rawMade(call: CallExpr, value: LLVMValue): IrValue {
    const type =
      this.typeOf(call) ?? this.values.types.store.plain(TypeKind.Error);

    return { type: kPointerType, value, tz: type, owned: true };
  }

  private nothing(): IrValue {
    const tz = this.values.types.store.plain(TypeKind.Void);

    return { type: kVoidType, value: this.ir.zero(kCharType), tz };
  }
}
