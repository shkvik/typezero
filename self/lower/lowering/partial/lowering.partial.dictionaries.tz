import {
  CallExpr,
  MemberExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import {
  DictKind,
  Type,
  TypeKind,
} from "../../../program/type/types/type.types.tz";
import {
  IrIntPredicate,
  IrOpcode,
} from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kBooleanType,
  kByteType,
  kDictLayoutFlag,
  kFlagType,
  kIntType,
  kMapAdd,
  kMapAddText,
  kMapCountField,
  kMapDelete,
  kMapDeleteText,
  kMapDrop,
  kMapFind,
  kMapFindText,
  kMapLayout,
  kMapNew,
  kMapStruct,
  kPointerType,
  kVoidType,
} from "../const/lowering.const.tz";
import { DictLayout, Frame, IrValue } from "../types/lowering.types.tz";

partial class Lowering {
  private dictLayout(type: Type): DictLayout | undefined {
    const known = this.dictLayouts.get(type.id);
    if (known != undefined) {
      return known;
    }
    if (type.kind != TypeKind.Dict) {
      return undefined;
    }

    const isSet = type.dict == DictKind.Set;
    const key = this.descriptor(this.values.types.store.keyOf(type));
    const value = this.dictValueDescriptor(type, isSet);
    const keyIr = this.irType(this.values.types.store.keyOf(type));
    const valueIr = this.irType(this.values.types.store.valueOf(type));
    if (key == undefined || value == undefined) {
      return undefined;
    }
    if (keyIr == undefined || valueIr == undefined) {
      return undefined;
    }

    const keyOffset = this.aligned(
      8,
      this.alignOf(this.values.types.store.keyOf(type)),
    );
    const keyEnd = keyOffset + this.sizeOf(this.values.types.store.keyOf(type));
    const valueOffset = this.dictValueOffset(type, isSet, keyEnd);
    const size = this.dictEntrySize(type, isSet, keyEnd, valueOffset);
    const descriptor = this.dictDescriptor(
      type,
      key,
      value,
      size,
      keyOffset,
      valueOffset,
    );
    const layout: DictLayout = {
      descriptor,
      keyOffset,
      valueOffset,
      key: keyIr,
      value: valueIr,
    };

    this.dictLayouts.set(type.id, layout);

    return layout;
  }

  private dictValueDescriptor(
    type: Type,
    isSet: boolean,
  ): LLVMValue | undefined {
    if (isSet || type.kind != TypeKind.Dict) {
      return this.ir.zero(kPointerType);
    }

    return this.descriptor(this.values.types.store.valueOf(type));
  }

  private dictValueOffset(type: Type, isSet: boolean, keyEnd: int): int {
    if (isSet || type.kind != TypeKind.Dict) {
      return 0;
    }

    return this.aligned(
      keyEnd,
      this.alignOf(this.values.types.store.valueOf(type)),
    );
  }

  private dictEntrySize(
    type: Type,
    isSet: boolean,
    keyEnd: int,
    valueOffset: int,
  ): int {
    if (type.kind != TypeKind.Dict) {
      return keyEnd;
    }

    const keyAlign = this.alignOf(this.values.types.store.keyOf(type));
    if (isSet) {
      return this.aligned(keyEnd, Math.max(4, keyAlign));
    }

    const end =
      valueOffset + this.sizeOf(this.values.types.store.valueOf(type));
    const valueAlign = this.alignOf(this.values.types.store.valueOf(type));
    const align = Math.max(4, Math.max(keyAlign, valueAlign));

    return this.aligned(end, align);
  }

  private dictDescriptor(
    type: Type,
    key: LLVMValue,
    value: LLVMValue,
    size: int,
    keyOffset: int,
    valueOffset: int,
  ): LLVMValue {
    const none = this.ir.zero(kPointerType);
    const dropName = this.dictsHelper(kMapDrop);
    const drop = this.ir.declare(dropName, kVoidType, [kPointerType]);
    const head = this.ir.constStruct([
      drop.fn,
      none,
      this.ir.integer(kFlagType, "0"),
      this.ir.integer(kFlagType, `${kDictLayoutFlag}`),
      none,
      this.ir.integer(kFlagType, "0"),
      this.ir.integer(kFlagType, `${this.nextClassId()}`),
    ]);
    const kind = this.dictKindNumber(type);
    const descriptor = this.ir.constStruct([
      head,
      key,
      value,
      this.ir.integer(kFlagType, `${kind}`),
      this.ir.integer(kFlagType, `${size}`),
      this.ir.integer(kFlagType, `${keyOffset}`),
      this.ir.integer(kFlagType, `${valueOffset}`),
    ]);
    const name = this.ir.uniqueName("tz.layout.dict.");

    return this.ir.global(name, kMapLayout, descriptor, true);
  }

  private readonly dictKindNumber(type: Type): int {
    if (type.kind != TypeKind.Dict) {
      return 0;
    }

    switch (type.dict) {
      case DictKind.Record:
        return 0;
      case DictKind.Map:
        return 1;
      default:
        return 2;
    }
  }

  private newDict(
    frame: Read<Frame>,
    type: Type,
    loc: int,
  ): IrValue | undefined {
    if (this.isTzMap(type)) {
      return this.mapMade(frame, type, loc);
    }

    const layout = this.dictLayout(type);
    if (layout == undefined) {
      this.notLowered(frame.module, loc, "a dictionary of these types");

      return undefined;
    }

    const creatingName = this.dictsHelper(kMapNew);

    const creating = this.ir.declare(creatingName, kPointerType, [kPointerType]);
    const map = frame.made.call(creating, [layout.descriptor]);

    return { type: kPointerType, value: map, tz: type, owned: true };
  }

  private dictCall(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
    object: Type,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    if (this.isTzSet(object) && member.name == "add") {
      return this.setAdded(
        frame,
        object,
        tree.exprOf(member.objectId),
        tree.argumentsOf(call.argsList),
        call.loc,
      );
    }
    if (this.isTzMap(object)) {
      const name = member.name;

      return this.mapMethod(
        frame,
        object,
        name,
        tree.exprOf(member.objectId),
        tree.argumentsOf(call.argsList),
        call.loc,
      );
    }

    const layout = this.dictLayout(object);
    if (layout == undefined || object.kind != TypeKind.Dict) {
      this.notLowered(frame.module, call.loc, "a dictionary of these types");

      return undefined;
    }

    switch (member.name) {
      case "get":
        return this.dictGet(frame, call, member, object);
      case "has":
        return this.dictHas(frame, call, member, object);
      case "set":
      case "add":
        return this.dictPut(frame, call, member, object);
      case "delete":
        return this.dictDelete(frame, call, member, object);
      default: {
        const name = this.calledName(call);

        this.notLowered(frame.module, call.loc, `a call of method ${name}`);

        return undefined;
      }
    }
  }

  private dictKey(
    frame: Frame,
    call: CallExpr,
    object: Type,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const argument = tree.argumentsOf(call.argsList)[0];
    if (argument == undefined || object.kind != TypeKind.Dict) {
      this.notLowered(frame.module, call.loc, "these arguments");

      return undefined;
    }

    const expr = tree.exprOf(argument.exprId);
    const given = this.value(frame, expr);
    if (given == undefined) {
      return undefined;
    }

    return this.converted(
      frame,
      given,
      this.values.types.store.keyOf(object),
      tree.exprOf(argument.exprId).loc,
    );
  }

  private dictFind(
    frame: Read<Frame>,
    map: LLVMValue,
    key: IrValue,
  ): LLVMValue {
    if (this.isString(key.tz)) {
      const text = frame.made.extract(key.value, 0);
      const meta = frame.made.extract(key.value, 1);
      const findingName = this.dictsHelper(kMapFindText);
      const finding = this.ir.declare(findingName, kPointerType, [
        kPointerType,
        kPointerType,
        kIntType,
      ]);

      return frame.made.call(finding, [map, text, meta]);
    }

    const slot = this.keySlot(frame, key);
    const findingName = this.dictsHelper(kMapFind);
    const finding = this.ir.declare(findingName, kPointerType, [
      kPointerType,
      kPointerType,
    ]);

    return frame.made.call(finding, [map, slot]);
  }

  private dictAdd(frame: Read<Frame>, map: LLVMValue, key: IrValue): LLVMValue {
    const added = frame.made.slot(kFlagType, "map.added");

    return this.dictAddFlagged(frame, map, key, added);
  }

  private dictAddFlagged(
    frame: Read<Frame>,
    map: LLVMValue,
    key: IrValue,
    added: LLVMValue,
  ): LLVMValue {
    if (this.isString(key.tz)) {
      const text = frame.made.extract(key.value, 0);
      const meta = frame.made.extract(key.value, 1);
      const addingName = this.dictsHelper(kMapAddText);
      const adding = this.ir.declare(addingName, kPointerType, [
        kPointerType,
        kPointerType,
        kIntType,
        kPointerType,
      ]);

      return frame.made.call(adding, [map, text, meta, added]);
    }

    const slot = this.keySlot(frame, key);
    const addingName = this.dictsHelper(kMapAdd);
    const adding = this.ir.declare(addingName, kPointerType, [
      kPointerType,
      kPointerType,
      kPointerType,
    ]);

    return frame.made.call(adding, [map, slot, added]);
  }

  private readonly keySlot(frame: Read<Frame>, key: IrValue): LLVMValue {
    const slot = frame.made.slot(key.type, "map.key");

    frame.made.store(key.value, slot);

    return slot;
  }

  private entryField(
    frame: Read<Frame>,
    entry: LLVMValue,
    offset: int,
  ): LLVMValue {
    const at = this.ir.integer(kIntType, `${offset}`);

    return frame.made.element(kByteType, entry, at);
  }

  private dictGet(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
    object: Type,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const layout = this.dictLayout(object);
    const result = this.typeOf(call);
    const resultIr = this.typeOrUndefined(result);
    const objectExpr = tree.exprOf(member.objectId);
    const map = this.value(frame, objectExpr);
    const key = this.dictKey(frame, call, object);
    if (layout == undefined || object.kind != TypeKind.Dict) {
      return undefined;
    }
    if (result == undefined || resultIr == undefined) {
      this.notLowered(frame.module, call.loc, "a value of this dictionary");

      return undefined;
    }
    if (map == undefined || key == undefined) {
      return undefined;
    }

    const entry = this.dictFind(frame, map.value, key);
    const none = this.ir.zero(kPointerType);
    const isFound = frame.made.integerCompare(
      IrIntPredicate.NotEqual,
      entry,
      none,
    );
    const before = frame.made.currentBlock();
    const read = frame.made.block("map.read");
    const end = frame.made.block("map.got");

    frame.made.conditionalBranch(isFound, read, end);
    frame.made.open(read);

    const address = this.entryField(frame, entry, layout.valueOffset);
    const loaded: IrValue = {
      type: layout.value,
      value: frame.made.load(layout.value, address),
      tz: this.values.types.store.valueOf(object),
    };
    const isLooked = map.owned != true;
    const kept = this.gotValue(frame, loaded, isLooked);
    const placed = this.converted(frame, kept, result, call.loc);
    const readEnd = frame.made.currentBlock();

    frame.made.branch(end);
    frame.made.open(end);

    if (placed == undefined) {
      return undefined;
    }

    const missing = this.ir.zero(resultIr);
    const value = frame.made.phi(
      resultIr,
      [missing, placed.value],
      [before, readEnd],
    );

    this.dropping(frame, key);
    this.dropping(frame, map);

    const got: IrValue = {
      type: resultIr,
      value,
      tz: result,
      owned: !isLooked,
    };
    if (isLooked && map.isStatic == true) {
      return this.staticValue(got);
    }

    return got;
  }

  private gotValue(
    frame: Read<Frame>,
    loaded: IrValue,
    isLooked: boolean,
  ): IrValue {
    if (isLooked) {
      return loaded;
    }

    return this.owning(frame, loaded);
  }

  private dictHas(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
    object: Type,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const objectExpr = tree.exprOf(member.objectId);
    const map = this.value(frame, objectExpr);
    const key = this.dictKey(frame, call, object);
    if (map == undefined || key == undefined) {
      return undefined;
    }

    const entry = this.dictFind(frame, map.value, key);
    const none = this.ir.zero(kPointerType);
    const value = frame.made.integerCompare(
      IrIntPredicate.NotEqual,
      entry,
      none,
    );
    const tz = this.values.types.store.plain(TypeKind.Boolean);

    this.dropping(frame, key);
    this.dropping(frame, map);

    return { type: kBooleanType, value, tz };
  }

  private dictPut(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
    object: Type,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const layout = this.dictLayout(object);
    const objectExpr = tree.exprOf(member.objectId);
    const map = this.value(frame, objectExpr);
    const key = this.dictKey(frame, call, object);
    if (layout == undefined || object.kind != TypeKind.Dict) {
      return undefined;
    }
    if (map == undefined || key == undefined) {
      return undefined;
    }

    const isSet = object.dict == DictKind.Set;
    const stored = this.dictStoredValue(frame, call, object, isSet);
    if (stored == undefined && !isSet) {
      return undefined;
    }

    const entry = this.dictAdd(frame, map.value, key);

    if (stored != undefined) {
      this.entryStored(frame, entry, layout.valueOffset, stored);
    }

    this.dropping(frame, key);

    return map;
  }

  private dictStoredValue(
    frame: Frame,
    call: CallExpr,
    object: Type,
    isSet: boolean,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const argument = tree.argumentsOf(call.argsList)[1];
    if (isSet || argument == undefined || object.kind != TypeKind.Dict) {
      return undefined;
    }

    const expr = tree.exprOf(argument.exprId);
    const given = this.value(frame, expr);
    if (given == undefined) {
      return undefined;
    }

    const loc = tree.exprOf(argument.exprId).loc;
    const value = this.converted(
      frame,
      given,
      this.values.types.store.valueOf(object),
      loc,
    );
    if (value == undefined) {
      return undefined;
    }

    return this.owning(frame, value);
  }

  private entryStored(
    frame: Read<Frame>,
    entry: LLVMValue,
    offset: int,
    value: IrValue,
  ): void {
    const address = this.entryField(frame, entry, offset);
    const before = frame.made.load(value.type, address);
    const old: IrValue = {
      type: value.type,
      value: before,
      tz: value.tz,
      owned: true,
    };

    frame.made.store(value.value, address);
    this.dropping(frame, old);
  }

  private dictDelete(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
    object: Type,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const objectExpr = tree.exprOf(member.objectId);
    const map = this.value(frame, objectExpr);
    const key = this.dictKey(frame, call, object);
    if (map == undefined || key == undefined) {
      return undefined;
    }

    const removed = this.dictRemoved(frame, map.value, key);
    const zero = this.ir.zero(kFlagType);
    const value = frame.made.integerCompare(
      IrIntPredicate.NotEqual,
      removed,
      zero,
    );
    const tz = this.values.types.store.plain(TypeKind.Boolean);

    this.dropping(frame, key);
    this.dropping(frame, map);

    return { type: kBooleanType, value, tz };
  }

  private dictRemoved(
    frame: Read<Frame>,
    map: LLVMValue,
    key: IrValue,
  ): LLVMValue {
    if (this.isString(key.tz)) {
      const text = frame.made.extract(key.value, 0);
      const meta = frame.made.extract(key.value, 1);
      const removingName = this.dictsHelper(kMapDeleteText);
      const removing = this.ir.declare(removingName, kFlagType, [
        kPointerType,
        kPointerType,
        kIntType,
      ]);

      return frame.made.call(removing, [map, text, meta]);
    }

    const slot = this.keySlot(frame, key);
    const removingName = this.dictsHelper(kMapDelete);
    const removing = this.ir.declare(removingName, kFlagType, [
      kPointerType,
      kPointerType,
    ]);

    return frame.made.call(removing, [map, slot]);
  }

  private dictSize(frame: Frame, expr: MemberExpr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    if (expr.name != "size") {
      this.notLowered(frame.module, expr.loc, "this member of a dictionary");

      return undefined;
    }

    const objectExpr = tree.exprOf(expr.objectId);
    const object = this.typeOf(objectExpr);
    if (object != undefined && this.isTzMap(object)) {
      return this.mapMethod(
        frame,
        object,
        "size",
        tree.exprOf(expr.objectId),
        [],
        expr.loc,
      );
    }

    const exprObject = tree.exprOf(expr.objectId);
    const map = this.value(frame, exprObject);
    if (map == undefined) {
      return undefined;
    }

    const field = frame.made.field(kMapStruct, map.value, kMapCountField);
    const count = frame.made.load(kFlagType, field);
    const value = frame.made.cast(IrOpcode.ZExt, count, kIntType);
    const tz = this.values.types.store.integer(64, false);

    this.dropping(frame, map);

    return { type: kIntType, value, tz };
  }
}
