import {
  BinaryExpr,
  BinaryOp,
  Expr,
  ExprKind,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import {
  IrIntPredicate,
  IrOpcode,
} from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kBooleanType,
  kPointerType,
  kThisName,
  kZero,
} from "../const/lowering.const.tz";
import { Frame, IrValue } from "../types/lowering.types.tz";

partial class Lowering {
  private optionalInner(type: Type): Type | undefined {
    if (type.kind != TypeKind.Union) {
      return undefined;
    }

    const defined = this.values.types.store
      .partsOf(type)
      .filter((part) => part.kind != TypeKind.Undefined);
    const inner = defined[0];
    if (
      defined.length == this.values.types.store.partsOf(type).length ||
      inner == undefined
    ) {
      return undefined;
    }
    if (defined.length == 1) {
      return inner;
    }

    return this.values.types.store.unionOf(defined);
  }

  private isReferenceLike(type: Type): boolean {
    return (
      this.isArray(type) || this.isCounted(type) || this.isHandleType(type)
    );
  }

  private optionalType(inner: Type): string | undefined {
    const type = this.irType(inner);
    if (type == undefined) {
      return undefined;
    }
    if (this.isReferenceLike(inner)) {
      return type;
    }

    return `{ ${type}, ${kBooleanType} }`;
  }

  private somewhere(frame: Read<Frame>, value: IrValue, target: Type): IrValue {
    const type = this.irType(target) ?? kPointerType;
    if (type == value.type) {
      return this.retyped(value, type, target);
    }

    const empty = this.ir.undefinedOf(type);
    const first = frame.made.insert(empty, value.value, 0);
    const yes = this.ir.integer(kBooleanType, "1");
    const placed = frame.made.insert(first, yes, 1);

    return { type, value: placed, tz: target, owned: value.owned };
  }

  private insideValue(
    frame: Read<Frame>,
    value: IrValue,
    inner: Type,
  ): IrValue {
    const type = this.irType(inner) ?? kPointerType;
    if (type == value.type) {
      return this.retyped(value, type, inner);
    }

    const made = frame.made.extract(value.value, 0);

    const { owned, isStatic } = value;

    return { type, value: made, tz: inner, owned, isStatic };
  }

  private proven(frame: Read<Frame>, value: IrValue): IrValue {
    const inner = this.optionalInner(value.tz);
    if (inner == undefined) {
      return value;
    }

    return this.insideValue(frame, value, inner);
  }

  private hasValue(frame: Read<Frame>, value: IrValue): LLVMValue {
    const inner = this.optionalInner(value.tz);
    if (inner == undefined && value.type == kPointerType) {
      const none = this.ir.zero(kPointerType);

      return frame.made.integerCompare(
        IrIntPredicate.NotEqual,
        value.value,
        none,
      );
    }
    if (inner == undefined) {
      return this.ir.integer(kBooleanType, "1");
    }
    if (this.isReferenceLike(inner)) {
      const none = this.ir.zero(kPointerType);

      return frame.made.integerCompare(
        IrIntPredicate.NotEqual,
        value.value,
        none,
      );
    }

    return frame.made.extract(value.value, 1);
  }

  private undefinedValue(target: Type): IrValue | undefined {
    const type = this.irType(target);
    if (type == undefined) {
      return undefined;
    }

    return { type, value: this.ir.zero(type), tz: target };
  }

  private undefinedTest(frame: Frame, expr: BinaryExpr): IrValue | undefined {
    const other = this.definedSide(expr);
    const value = this.rawValue(frame, other);
    if (value == undefined) {
      return undefined;
    }

    const has = this.hasValue(frame, value);
    const tz = this.values.types.store.plain(TypeKind.Boolean);

    this.dropping(frame, value);

    if (expr.op == BinaryOp.Ne) {
      return { type: kBooleanType, value: has, tz };
    }

    const yes = this.ir.integer(kBooleanType, "1");
    const missing = frame.made.binary(IrOpcode.Xor, has, yes);

    return { type: kBooleanType, value: missing, tz };
  }

  private rawValue(frame: Frame, expr: Expr): IrValue | undefined {
    const isThis = expr.kind == ExprKind.Name && expr.name == kThisName;
    if (expr.kind != ExprKind.Name || isThis) {
      return this.value(frame, expr);
    }

    const place = this.namePlace(frame, expr);
    if (place == undefined) {
      return undefined;
    }

    return this.loaded(frame, place);
  }

  private readonly definedSide(expr: BinaryExpr): Expr {
    const tree = this.values.types.program.tree;

    const lhs = tree.exprOf(expr.lhsId);
    if (lhs.kind == ExprKind.Undefined) {
      return tree.exprOf(expr.rhsId);
    }

    return tree.exprOf(expr.lhsId);
  }

  private nullish(frame: Frame, expr: BinaryExpr): IrValue | undefined {
    return this.nullishValue(frame, expr, false);
  }

  private nullishValue(
    frame: Frame,
    expr: BinaryExpr,
    isFlagWanted: boolean,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const result = this.nullishResult(frame, expr);
    const type = this.typeOrUndefined(result);
    const lhs = tree.exprOf(expr.lhsId);
    const left = this.value(frame, lhs);
    if (result == undefined || type == undefined || left == undefined) {
      this.notLowered(frame.module, expr.loc, "this operator");

      return undefined;
    }

    const inner = this.optionalInner(left.tz);
    if (inner == undefined) {
      return this.converted(frame, left, result, expr.loc);
    }

    const isFlagged =
      isFlagWanted && left.owned != true && this.isManaged(result);
    if (isFlagged) {
      return this.flaggedNullish(frame, expr, left, inner, result);
    }

    const has = this.hasValue(frame, left);
    const given = frame.made.block("nullish.given");
    const other = frame.made.block("nullish.other");
    const end = frame.made.block("nullish.end");

    frame.made.conditionalBranch(has, given, other);
    frame.made.open(given);

    const inside = this.insideValue(frame, left, inner);
    const first = this.nullishFirst(frame, inside, result, expr.loc);
    const firstBlock = frame.made.currentBlock();

    this.jumpTo(frame, end);
    frame.made.open(other);

    const rhs = tree.exprOf(expr.rhsId);
    const second = this.branchValue(frame, rhs, result);
    const secondBlock = frame.made.currentBlock();

    this.jumpTo(frame, end);
    frame.made.open(end);

    if (first == undefined || second == undefined) {
      return undefined;
    }

    const value = frame.made.phi(
      type,
      [first.value, second.value],
      [firstBlock, secondBlock],
    );

    return { type, value, tz: result, owned: true };
  }

  private nullishFirst(
    frame: Frame,
    inside: IrValue,
    result: Type,
    loc: int,
  ): IrValue | undefined {
    if (inside.owned != true) {
      return this.branchOwned(frame, inside, result, loc);
    }

    const converted = this.converted(frame, inside, result, loc);
    if (converted == undefined) {
      return undefined;
    }

    return this.owning(frame, converted);
  }

  private nullishResult(frame: Frame, expr: BinaryExpr): Type | undefined {
    const tree = this.values.types.program.tree;

    const result = this.typeIn(frame, expr);
    const lhs = tree.exprOf(expr.lhsId);
    const left = this.typeIn(frame, lhs);
    if (result == undefined || left == undefined) {
      return result;
    }

    const defined = this.definedOf(left);
    if (
      this.isCString(defined) &&
      tree.exprOf(expr.rhsId).kind == ExprKind.StringLit
    ) {
      return defined;
    }

    return result;
  }

  private flaggedNullish(
    frame: Frame,
    expr: BinaryExpr,
    left: IrValue,
    inner: Type,
    result: Type,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const type = this.irType(result) ?? kPointerType;
    const has = this.hasValue(frame, left);
    const given = frame.made.block("nullish.given");
    const other = frame.made.block("nullish.other");
    const end = frame.made.block("nullish.end");

    frame.made.conditionalBranch(has, given, other);
    frame.made.open(given);

    const inside = this.insideValue(frame, left, inner);
    const first = this.converted(frame, inside, result, expr.loc);
    const firstBlock = frame.made.currentBlock();

    this.jumpTo(frame, end);
    frame.made.open(other);

    const rhs = tree.exprOf(expr.rhsId);
    const wanted = this.wantedValue(frame, rhs, result);
    const second = this.convertedOrNone(
      frame,
      wanted,
      result,
      tree.exprOf(expr.rhsId).loc,
    );
    const secondBlock = frame.made.currentBlock();

    this.jumpTo(frame, end);
    frame.made.open(end);

    if (first == undefined || second == undefined) {
      return undefined;
    }

    const value = frame.made.phi(
      type,
      [first.value, second.value],
      [firstBlock, secondBlock],
    );
    const firstFlag = this.ownedBit(first);
    const secondFlag = this.ownedBit(second);
    const ownedFlag = frame.made.phi(
      kBooleanType,
      [firstFlag, secondFlag],
      [firstBlock, secondBlock],
    );

    return { type, value, tz: result, owned: false, ownedFlag };
  }

  private ownedBit(value: Read<IrValue>): LLVMValue {
    if (value.owned == true || value.isStatic == true) {
      return this.ir.integer(kBooleanType, "1");
    }

    return this.ir.integer(kBooleanType, "0");
  }

  private argumentValue(
    frame: Frame,
    expr: Expr,
    wanted: Type,
    isLent: boolean,
  ): IrValue | undefined {
    if (isLent && expr.kind == ExprKind.Binary && expr.op == BinaryOp.Nullish) {
      return this.nullishValue(frame, expr, true);
    }

    return this.wantedValue(frame, expr, wanted);
  }

  private readonly withOwnedFlag(
    value: IrValue,
    ownedFlag: LLVMValue | undefined,
  ): IrValue {
    if (ownedFlag == undefined) {
      return value;
    }

    return {
      type: value.type,
      value: value.value,
      tz: value.tz,
      owned: false,
      ownedFlag,
    };
  }

  private loopSourceValue(frame: Frame, expr: Expr): IrValue | undefined {
    if (expr.kind == ExprKind.Binary && expr.op == BinaryOp.Nullish) {
      return this.nullishValue(frame, expr, true);
    }

    return this.loopSource(frame, expr);
  }

  private branchOwned(
    frame: Frame,
    value: IrValue,
    result: Type,
    loc: int,
  ): IrValue | undefined {
    const converted = this.converted(frame, value, result, loc);
    if (converted == undefined) {
      return undefined;
    }

    const borrowed: IrValue = {
      type: converted.type,
      value: converted.value,
      tz: converted.tz,
    };

    return this.owning(frame, borrowed);
  }
}
