import {
  BinaryExpr,
  BinaryOp,
  Expr,
  ExprKind,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import {
  IrIntPredicate,
  IrOpcode,
} from "../../ir-function/types/ir-function.types.tz";
import { Lowering } from "../lowering.tz";
import {
  kBooleanType,
  kDivisionByZero,
  kDoubleType,
  kIntType,
  kPanic,
  kPointerType,
  kPowDouble,
  kPowInt,
} from "../const/lowering.const.tz";
import { Frame, IrValue } from "../types/lowering.types.tz";

partial class Lowering {
  private binary(frame: Frame, expr: BinaryExpr): IrValue | undefined {
    switch (expr.op) {
      case BinaryOp.LogAnd:
      case BinaryOp.LogOr:
        return this.logical(frame, expr);
      case BinaryOp.Eq:
      case BinaryOp.Ne:
        if (this.isUndefinedTest(expr)) {
          return this.undefinedTest(frame, expr);
        }

        return this.comparison(frame, expr);
      case BinaryOp.Lt:
      case BinaryOp.Le:
      case BinaryOp.Gt:
      case BinaryOp.Ge:
        return this.comparison(frame, expr);
      case BinaryOp.Nullish:
        return this.nullish(frame, expr);
      case BinaryOp.In:
      case BinaryOp.InstanceOf:
        this.notLowered(frame.module, expr.loc, "this operator");

        return undefined;
      default:
        return this.arithmeticExpr(frame, expr);
    }
  }

  private joinedTypeIn(frame: Frame, expr: BinaryExpr): Type | undefined {
    const tree = this.values.types.program.tree;

    const lhs = tree.exprOf(expr.lhsId);
    const left = this.definedIn(frame, lhs);
    const rhs = tree.exprOf(expr.rhsId);
    const right = this.definedIn(frame, rhs);
    if (left == undefined || right == undefined) {
      return undefined;
    }

    const isText = this.isString(left) || this.isString(right);
    if (expr.op == BinaryOp.Add && isText) {
      return this.values.types.store.plain(TypeKind.String);
    }
    if (this.isDecimal(left) || this.isDecimal(right)) {
      return this.values.types.store.plain(TypeKind.Decimal);
    }
    if (this.isDouble(left) || this.isDouble(right)) {
      return this.values.types.store.plain(TypeKind.Double);
    }
    if (this.isInteger(left) && this.isInteger(right)) {
      return this.widened(left);
    }

    return undefined;
  }

  private definedIn(frame: Frame, expr: Expr): Type | undefined {
    const type = this.typeIn(frame, expr);
    if (type == undefined) {
      return undefined;
    }

    return this.definedOf(type);
  }

  private readonly isUndefinedTest(expr: BinaryExpr): boolean {
    const tree = this.values.types.program.tree;

    return (
      tree.exprOf(expr.lhsId).kind == ExprKind.Undefined ||
      tree.exprOf(expr.rhsId).kind == ExprKind.Undefined
    );
  }

  private arithmeticExpr(frame: Frame, expr: BinaryExpr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const type = this.typeOf(expr) ?? this.joinedTypeIn(frame, expr);
    if (type == undefined) {
      this.notLowered(frame.module, expr.loc, "this operator");

      return undefined;
    }
    if (expr.op == BinaryOp.Add && this.isString(type)) {
      return this.concatenated(frame, [], [expr]);
    }
    if (this.isDecimal(type)) {
      return this.decimalArithmetic(frame, expr);
    }

    const isNumber = this.isInteger(type) || this.isDouble(type);
    if (!isNumber) {
      const kind = this.kindName(type);

      this.notLowered(frame.module, expr.loc, `an operator of type ${kind}`);

      return undefined;
    }

    const lhs = tree.exprOf(expr.lhsId);
    const left = this.operand(frame, lhs, type);
    const rhs = tree.exprOf(expr.rhsId);
    const right = this.operand(frame, rhs, type);
    if (left == undefined || right == undefined) {
      return undefined;
    }

    return this.arithmetic(frame, expr.op, left, right, expr.loc);
  }

  private operand(frame: Frame, expr: Expr, type: Type): IrValue | undefined {
    const given = this.value(frame, expr);
    if (given == undefined) {
      return undefined;
    }

    return this.converted(frame, given, this.widened(type), expr.loc);
  }

  private arithmetic(
    frame: Read<Frame>,
    op: BinaryOp,
    left: IrValue,
    right: IrValue,
    loc: int,
  ): IrValue | undefined {
    const isDouble = left.type == kDoubleType;
    const simple = this.simpleOpcode(op, isDouble);
    if (simple != undefined) {
      return this.operated(frame, simple, left, right);
    }

    switch (op) {
      case BinaryOp.Div:
        return this.integerDivision(frame, left, right, false);
      case BinaryOp.Rem:
        return this.integerDivision(frame, left, right, true);
      case BinaryOp.Pow:
        return this.power(frame, left, right);
      case BinaryOp.Shl:
      case BinaryOp.Shr:
      case BinaryOp.UShr:
        return this.shifted(frame, op, left, right, loc);
      default:
        this.notLowered(frame.module, loc, "this operator");

        return undefined;
    }
  }

  private readonly simpleOpcode(
    op: BinaryOp,
    isDouble: boolean,
  ): IrOpcode | undefined {
    switch (op) {
      case BinaryOp.Add:
        return this.opcodeFor(isDouble, IrOpcode.FAdd, IrOpcode.Add);
      case BinaryOp.Sub:
        return this.opcodeFor(isDouble, IrOpcode.FSub, IrOpcode.Sub);
      case BinaryOp.Mul:
        return this.opcodeFor(isDouble, IrOpcode.FMul, IrOpcode.Mul);
      case BinaryOp.BitAnd:
        return IrOpcode.And;
      case BinaryOp.BitOr:
        return IrOpcode.Or;
      case BinaryOp.BitXor:
        return IrOpcode.Xor;
      default:
        return this.doubleOpcode(op, isDouble);
    }
  }

  private readonly doubleOpcode(
    op: BinaryOp,
    isDouble: boolean,
  ): IrOpcode | undefined {
    if (!isDouble) {
      return undefined;
    }
    if (op == BinaryOp.Div) {
      return IrOpcode.FDiv;
    }
    if (op == BinaryOp.Rem) {
      return IrOpcode.FRem;
    }

    return undefined;
  }

  private readonly opcodeFor(
    isFirst: boolean,
    first: IrOpcode,
    second: IrOpcode,
  ): IrOpcode {
    if (isFirst) {
      return first;
    }

    return second;
  }

  private readonly pick(
    isFirst: boolean,
    first: string,
    second: string,
  ): string {
    if (isFirst) {
      return first;
    }

    return second;
  }

  private readonly operated(
    frame: Read<Frame>,
    opcode: IrOpcode,
    left: IrValue,
    right: IrValue,
  ): IrValue {
    const value = frame.made.binary(opcode, left.value, right.value);

    return { type: left.type, value, tz: left.tz };
  }

  private integerDivision(
    frame: Read<Frame>,
    left: IrValue,
    right: IrValue,
    isRemainder: boolean,
  ): IrValue {
    const type = left.type;
    const zero = this.ir.zero(type);
    const isZero = frame.made.integerCompare(
      IrIntPredicate.Equal,
      right.value,
      zero,
    );
    const fails = frame.made.block("div.zero");
    const goes = frame.made.block("div.ok");

    frame.made.conditionalBranch(isZero, fails, goes);
    frame.made.open(fails);
    this.panic(frame, kDivisionByZero);
    frame.made.open(goes);

    if (this.isUnsigned(left.tz)) {
      const opcode = this.opcodeFor(isRemainder, IrOpcode.URem, IrOpcode.UDiv);

      return this.operated(frame, opcode, left, right);
    }

    const minusOne = this.ir.integer(type, "-1");
    const one = this.ir.integer(type, "1");
    const isMinusOne = frame.made.integerCompare(
      IrIntPredicate.Equal,
      right.value,
      minusOne,
    );
    const divisor = frame.made.select(isMinusOne, one, right.value);
    if (isRemainder) {
      const value = frame.made.binary(IrOpcode.SRem, left.value, divisor);

      return { type, value, tz: left.tz };
    }

    const quotient = frame.made.binary(IrOpcode.SDiv, left.value, divisor);
    const negative = frame.made.binary(IrOpcode.Sub, zero, left.value);
    const value = frame.made.select(isMinusOne, negative, quotient);

    return { type, value, tz: left.tz };
  }

  private power(frame: Read<Frame>, left: IrValue, right: IrValue): IrValue {
    if (left.type == kDoubleType) {
      const value = this.runtimeValue(frame, kPowDouble, kDoubleType, [
        left,
        right,
      ]);

      return { type: kDoubleType, value, tz: left.tz };
    }

    const wideLeft = this.toLong(frame, left);
    const wideRight = this.toLong(frame, right);
    const long = this.runtimeValue(frame, kPowInt, kIntType, [
      wideLeft,
      wideRight,
    ]);
    if (left.type == kIntType) {
      return { type: kIntType, value: long, tz: left.tz };
    }

    const value = frame.made.cast(IrOpcode.Trunc, long, left.type);

    return { type: left.type, value, tz: left.tz };
  }

  private readonly toLong(frame: Read<Frame>, value: IrValue): IrValue {
    const tz = this.values.types.store.integer(64, false);
    if (value.type == kIntType) {
      return { type: kIntType, value: value.value, tz };
    }

    const opcode = this.resizing(this.bitsOf(value.tz), 64, value.tz);
    const made = frame.made.cast(opcode, value.value, kIntType);

    return { type: kIntType, value: made, tz };
  }

  private shifted(
    frame: Read<Frame>,
    op: BinaryOp,
    left: IrValue,
    right: IrValue,
    loc: int,
  ): IrValue | undefined {
    const plain = this.widened(left.tz);
    if (plain.kind == TypeKind.Int && plain.wraps) {
      this.notLowered(frame.module, loc, "a shift of a wrapping number");

      return undefined;
    }

    const bits = this.bitsOf(left.tz);
    const mask = this.ir.integer(left.type, `${bits - 1}`);
    const count = frame.made.binary(IrOpcode.And, right.value, mask);
    let opcode: IrOpcode = IrOpcode.LShr;

    if (op == BinaryOp.Shl) {
      opcode = IrOpcode.Shl;
    } else if (op == BinaryOp.Shr && !this.isUnsigned(left.tz)) {
      opcode = IrOpcode.AShr;
    }

    const value = frame.made.binary(opcode, left.value, count);

    return { type: left.type, value, tz: left.tz };
  }

  private logical(frame: Frame, expr: BinaryExpr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const result = this.typeOf(expr);
    if (result != undefined && !this.isBoolean(result)) {
      const kind = this.kindName(result);

      this.notLowered(frame.module, expr.loc, `a logical of type ${kind}`);

      return undefined;
    }

    const lhs = tree.exprOf(expr.lhsId);
    const left = this.truth(frame, lhs);
    if (left == undefined) {
      return undefined;
    }

    const isAnd = expr.op == BinaryOp.LogAnd;
    const start = frame.made.currentBlock();
    const rest = frame.made.block("logic.rhs");
    const end = frame.made.block("logic.end");

    if (isAnd) {
      frame.made.conditionalBranch(left, rest, end);
    } else {
      frame.made.conditionalBranch(left, end, rest);
    }

    frame.made.open(rest);

    const rhsExpr = tree.exprOf(expr.rhsId);
    const right = this.truth(frame, rhsExpr);
    const restEnd = frame.made.currentBlock();

    this.jumpTo(frame, end);
    frame.made.open(end);

    if (right == undefined) {
      return undefined;
    }

    const early = this.pick(isAnd, "0", "1");
    const first = this.ir.integer(kBooleanType, early);
    const value = frame.made.phi(
      kBooleanType,
      [first, right],
      [start, restEnd],
    );
    const tz = this.values.types.store.plain(TypeKind.Boolean);

    return { type: kBooleanType, value, tz };
  }

  private panic(frame: Read<Frame>, message: string): void {
    const text = this.byteText(message);
    const tz = this.values.types.store.integer(64, false);
    const length = this.ir.integer(kIntType, `${text.length}`);
    const pointer: IrValue = { type: kPointerType, value: text.pointer, tz };
    const size: IrValue = { type: kIntType, value: length, tz };

    this.runtimeCall(frame.made, kPanic, [pointer, size]);
    frame.made.unreachable();
  }
}
