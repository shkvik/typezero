import {
  LiteralKind,
  Type,
  TypeKind,
} from "../../../program/type/types/type.types.tz";
import { Lowering } from "../lowering.tz";
import {
  kBooleanType,
  kDecimalType,
  kDoubleType,
  kEmptyType,
  kPointerType,
  kStringType,
  kTypeKindNames,
  kVoidType,
} from "../const/lowering.const.tz";

partial class Lowering {
  private readonly widened(type: Type): Type {
    if (this.isNumberUnion(type)) {
      return this.values.types.store.integer(64, false);
    }
    if (this.isTextUnion(type)) {
      return this.values.types.store.plain(TypeKind.String);
    }
    if (type.kind != TypeKind.Literal) {
      return type;
    }

    switch (type.literal) {
      case LiteralKind.Int:
        return this.values.types.store.integer(64, false);
      case LiteralKind.Double:
        return this.values.types.store.plain(TypeKind.Double);
      case LiteralKind.Boolean:
        return this.values.types.store.plain(TypeKind.Boolean);
      default:
        return this.values.types.store.plain(TypeKind.String);
    }
  }

  private readonly isNumberUnion(type: Type): boolean {
    if (type.kind != TypeKind.Union) {
      return false;
    }

    return this.values.types.store.partsOf(type).every(
      (part) =>
        part.kind == TypeKind.Literal && part.literal == LiteralKind.Int,
    );
  }

  private readonly isTextUnion(type: Type): boolean {
    if (type.kind != TypeKind.Union) {
      return false;
    }

    return this.values.types.store.partsOf(type).every(
      (part) =>
        part.kind == TypeKind.Literal && part.literal == LiteralKind.String,
    );
  }

  private irType(type: Type): string | undefined {
    const plain = this.widened(type);

    switch (plain.kind) {
      case TypeKind.Int:
        return `i${plain.bits}`;
      case TypeKind.Double:
        return kDoubleType;
      case TypeKind.Boolean:
        return kBooleanType;
      case TypeKind.String:
        return kStringType;
      case TypeKind.Decimal:
        return kDecimalType;
      case TypeKind.Array:
      case TypeKind.Instance:
      case TypeKind.Object:
      case TypeKind.Tuple:
      case TypeKind.Dict:
      case TypeKind.Function:
        return kPointerType;
      case TypeKind.Void:
        return kVoidType;
      case TypeKind.Never:
        return kEmptyType;
      case TypeKind.Result:
        return this.resultLayout(plain)?.struct;
      case TypeKind.Undefined:
        return kBooleanType;
      case TypeKind.Union:
        return this.unionType(plain);
      default:
        return undefined;
    }
  }

  private unionType(type: Type): string | undefined {
    if (this.isObjectLike(type)) {
      return kPointerType;
    }

    const inner = this.optionalInner(type);
    if (inner == undefined) {
      return undefined;
    }

    return this.optionalType(inner);
  }

  private readonly isInteger(type: Type): boolean {
    return this.widened(type).kind == TypeKind.Int;
  }

  private readonly isUnsigned(type: Type): boolean {
    const plain = this.widened(type);

    return plain.kind == TypeKind.Int && plain.unsigned;
  }

  private readonly bitsOf(type: Type): int {
    const plain = this.widened(type);
    if (plain.kind != TypeKind.Int) {
      return 0;
    }

    return plain.bits;
  }

  private readonly isDouble(type: Type): boolean {
    return this.widened(type).kind == TypeKind.Double;
  }

  private readonly isBoolean(type: Type): boolean {
    return this.widened(type).kind == TypeKind.Boolean;
  }

  private readonly isString(type: Type): boolean {
    return this.widened(type).kind == TypeKind.String;
  }

  private readonly isArray(type: Type): boolean {
    return type.kind == TypeKind.Array;
  }

  private readonly isInstance(type: Type): boolean {
    return type.kind == TypeKind.Instance;
  }

  private isCounted(type: Type): boolean {
    return (
      this.isObjectLike(type) ||
      type.kind == TypeKind.Dict ||
      type.kind == TypeKind.Function
    );
  }

  private isObjectLike(type: Type): boolean {
    switch (type.kind) {
      case TypeKind.Instance:
        return !this.isHandleType(type);
      case TypeKind.Object:
      case TypeKind.Tuple:
        return true;
      case TypeKind.Union:
        return this.values.types.store
          .partsOf(type)
          .every((part) => this.isObjectLike(part));
      default:
        return false;
    }
  }

  private sizeOf(type: Type): int {
    const plain = this.widened(type);
    const inner = this.optionalInner(plain);
    if (inner != undefined && !this.isReferenceLike(inner)) {
      const align = this.alignOf(inner);
      const size = this.sizeOf(inner);

      return this.aligned(size + 1, align);
    }

    switch (plain.kind) {
      case TypeKind.Int:
        return plain.bits >> 3;
      case TypeKind.Boolean:
      case TypeKind.Undefined:
        return 1;
      case TypeKind.String:
      case TypeKind.Decimal:
        return 16;
      default:
        return 8;
    }
  }

  private alignOf(type: Type): int {
    const plain = this.widened(type);
    const inner = this.optionalInner(plain);
    if (inner != undefined && !this.isReferenceLike(inner)) {
      return this.alignOf(inner);
    }

    switch (plain.kind) {
      case TypeKind.Int:
        return plain.bits >> 3;
      case TypeKind.Boolean:
      case TypeKind.Undefined:
        return 1;
      default:
        return 8;
    }
  }

  private readonly kindName(type: Type | undefined): string {
    if (type == undefined) {
      return "unknown";
    }

    const position: int = type.kind;

    return kTypeKindNames[position] ?? "?";
  }
}
