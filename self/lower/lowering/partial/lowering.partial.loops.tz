import {
  DoWhileStmt,
  ForStmt,
  WhileStmt,
} from "../../../program/ast/types/ast.types.statements.tz";
import { LLVMBlock } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import { Frame, LoopTarget } from "../types/lowering.types.tz";

partial class Lowering {
  private whileLoop(frame: Frame, statement: WhileStmt): void {
    const cond = frame.made.block("while.cond");
    const body = frame.made.block("while.body");
    const end = frame.made.block("while.end");
    const target = this.loopTarget(frame, end, cond);

    frame.made.open(cond);

    const test = this.truth(frame, statement.cond);
    if (test == undefined) {
      return;
    }

    frame.made.conditionalBranch(test, body, end);
    frame.made.open(body);
    frame.loops.push(target);
    this.statement(frame, statement.body);
    frame.loops.pop();
    this.jumpTo(frame, cond);
    frame.made.open(end);
  }

  private doWhileLoop(frame: Frame, statement: DoWhileStmt): void {
    const body = frame.made.block("do.body");
    const cond = frame.made.block("do.cond");
    const end = frame.made.block("do.end");
    const target = this.loopTarget(frame, end, cond);

    frame.made.open(body);
    frame.loops.push(target);
    this.statement(frame, statement.body);
    frame.loops.pop();
    frame.made.open(cond);

    const test = this.truth(frame, statement.cond);
    if (test == undefined) {
      return;
    }

    frame.made.conditionalBranch(test, body, end);
    frame.made.open(end);
  }

  private forLoop(frame: Frame, statement: ForStmt): void {
    const cond = frame.made.block("for.cond");
    const body = frame.made.block("for.body");
    const step = frame.made.block("for.step");
    const end = frame.made.block("for.end");
    const init = statement.init;

    this.openScope(frame);

    const target = this.loopTarget(frame, end, step);

    if (init != undefined) {
      this.statement(frame, init);
    }

    frame.made.open(cond);
    this.forTest(frame, statement, body, end);
    frame.made.open(body);
    frame.loops.push(target);

    if (statement.body != undefined) {
      this.statement(frame, statement.body);
    }

    frame.loops.pop();
    frame.made.open(step);

    if (statement.step != undefined) {
      this.value(frame, statement.step);
    }

    this.jumpTo(frame, cond);
    frame.made.open(end);
    this.closeScope(frame);
  }

  private forTest(
    frame: Frame,
    statement: ForStmt,
    body: LLVMBlock,
    end: LLVMBlock,
  ): void {
    const cond = statement.cond;
    if (cond == undefined) {
      return frame.made.branch(body);
    }

    const test = this.truth(frame, cond);
    if (test == undefined) {
      return;
    }

    frame.made.conditionalBranch(test, body, end);
  }

  private loopTarget(
    frame: Read<Frame>,
    breakBlock: LLVMBlock,
    continueBlock: LLVMBlock,
  ): LoopTarget {
    const label = this.pendingLabel;
    const depth = frame.scopes.length;

    this.pendingLabel = "";

    return { breakBlock, continueBlock, label, depth };
  }
}
