import {
  CallArgument,
  CallExpr,
  Expr,
  ExprKind,
  NameExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { TypeKind } from "../../../program/type/types/type.types.tz";
import { Lowering } from "../lowering.tz";
import {
  kChildrenModule,
  kEncodingNames,
  kIntType,
  kPointerType,
} from "../const/lowering.const.tz";
import {
  Frame,
  IrValue,
  RuntimeTarget,
} from "../types/lowering.types.tz";

partial class Lowering {
  private childCall(
    frame: Frame,
    call: CallExpr,
    callee: NameExpr,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const type = this.typeOf(call);
    const command = tree.argumentsOf(call.argsList)[0];
    if (callee.name != "spawnSync" || command == undefined) {
      this.notLowered(frame.module, call.loc, "a call of this function");

      return undefined;
    }
    if (type == undefined || type.kind != TypeKind.Result) {
      this.notLowered(frame.module, call.loc, "a call of this function");

      return undefined;
    }

    const second = tree.argumentsOf(call.argsList)[1];
    const hasList =
      second != undefined &&
      this.isListArgument(frame, tree.exprOf(second.exprId));
    const listExpr = this.listOf(second, hasList);
    const options = this.optionsOf(call, hasList);
    const encoding = this.spawnEncoding(frame, options);
    if (encoding == undefined) {
      this.notLowered(frame.module, call.loc, "these options of spawnSync");

      return undefined;
    }

    const exprExpr = tree.exprOf(command.exprId);
    const file = this.value(frame, exprExpr);
    const list = this.spawnList(frame, listExpr);
    if (encoding > 0) {
      return this.spawnTextCall(frame, call, file, list, encoding);
    }

    return this.spawnBytesCall(frame, call, file, list);
  }

  private spawnBytesCall(
    frame: Frame,
    call: CallExpr,
    file: IrValue | undefined,
    list: IrValue | undefined,
  ): IrValue | undefined {
    if (file == undefined || list == undefined) {
      return undefined;
    }

    const int = this.values.types.store.integer(64, false);
    const layouts = this.bytesLayouts();
    const raw: IrValue = { type: kPointerType, value: layouts, tz: int };
    const name = "spawnBytes";
    const target: RuntimeTarget = { module: kChildrenModule, name };
    const given = [file, list, raw];
    const found = this.runtimeFunctionCall(frame, target, [], given, call.loc);

    this.dropping(frame, file);
    this.dropping(frame, list);

    return found;
  }

  private spawnTextCall(
    frame: Frame,
    call: CallExpr,
    file: IrValue | undefined,
    list: IrValue | undefined,
    encoding: int,
  ): IrValue | undefined {
    if (file == undefined || list == undefined) {
      return undefined;
    }

    const int = this.values.types.store.integer(64, false);
    const value = this.ir.integer(kIntType, `${encoding - 1}`);
    const code: IrValue = { type: kIntType, value, tz: int };
    const name = "spawnText";
    const target: RuntimeTarget = { module: kChildrenModule, name };
    const given = [file, list, code];
    const found = this.runtimeFunctionCall(frame, target, [], given, call.loc);

    this.dropping(frame, file);
    this.dropping(frame, list);

    return found;
  }

  private isListArgument(frame: Frame, expr: Expr): boolean {
    const type = this.typeIn(frame, expr);
    if (type == undefined) {
      return expr.kind == ExprKind.ArrayLit;
    }

    return this.definedOf(type).kind == TypeKind.Array;
  }

  private readonly listOf(
    argument: CallArgument | undefined,
    hasList: boolean,
  ): Expr | undefined {
    const tree = this.values.types.program.tree;

    if (argument == undefined || !hasList) {
      return undefined;
    }

    return tree.exprOf(argument.exprId);
  }

  private readonly optionsOf(
    call: CallExpr,
    hasList: boolean,
  ): Expr | undefined {
    const tree = this.values.types.program.tree;

    let position = 1;

    if (hasList) {
      position = 2;
    }

    return tree.exprAt(tree.argumentsOf(call.argsList)[position]?.exprId);
  }

  private spawnEncoding(
    frame: Read<Frame>,
    options: Expr | undefined,
  ): int | undefined {
    const tree = this.values.types.program.tree;

    if (options == undefined) {
      return 0;
    }
    if (options.kind != ExprKind.ObjectLit) {
      return undefined;
    }

    let encoding = 0;

    for (const property of tree.propertiesOf(options.propsList)) {
      if (property.name != "encoding") {
        return undefined;
      }

      const value = tree.exprOf(property.valueId);
      const text = this.constantText(frame, value);
      const known = kEncodingNames.indexOf(text ?? "");
      if (known < 0) {
        return undefined;
      }

      encoding = known + 1;
    }

    return encoding;
  }

  private spawnList(frame: Frame, expr: Expr | undefined): IrValue | undefined {
    if (expr != undefined) {
      return this.value(frame, expr);
    }

    const string = this.values.types.store.plain(TypeKind.String);
    const descriptor = this.descriptor(string);
    if (descriptor == undefined) {
      return undefined;
    }

    const value = this.emptyArray(frame, descriptor);
    const tz = this.values.types.store.arrayOf(string);

    return { type: kPointerType, value, tz, owned: true };
  }
}
