import {
  AssignExpr,
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { TypeKind } from "../../../program/type/types/type.types.tz";
import { Lowering } from "../lowering.tz";
import {
  kFlagType,
  kArrayCopy,
  kIntType,
  kPointerType,
  kProcessArgv,
  kProcessExecPath,
  kProcessName,
  kProcessPlatform,
  kProcessSetExitCode,
  kVoidType,
} from "../const/lowering.const.tz";
import { Frame, IrValue } from "../types/lowering.types.tz";

partial class Lowering {
  private readonly isProcessName(frame: Read<Frame>, expr: Expr): boolean {
    if (expr.kind != ExprKind.Name || expr.name != kProcessName) {
      return false;
    }

    const target = this.values.valueTargetOf(expr, frame.module);
    const opened = this.values.types.program.modules[target?.module ?? -1];
    if (opened == undefined) {
      return false;
    }

    return opened.source.isLibrary;
  }

  private processMember(
    frame: Read<Frame>,
    expr: MemberExpr,
  ): IrValue | undefined {
    switch (expr.name) {
      case "argv":
        return this.processArgv(frame);
      case "execPath":
        return this.textOut(frame, kProcessExecPath, [], []);
      case "platform":
        return this.textOut(frame, kProcessPlatform, [], []);
      default:
        this.notLowered(frame.module, expr.loc, "this member of process");

        return undefined;
    }
  }

  private processArgv(frame: Read<Frame>): IrValue | undefined {
    const string = this.values.types.store.plain(TypeKind.String);
    const descriptor = this.descriptor(string);
    if (descriptor == undefined) {
      return undefined;
    }

    const callee = this.ir.declare(kProcessArgv, kPointerType, [kPointerType]);
    const cached = frame.made.call(callee, [descriptor]);
    const tz = this.values.types.store.arrayOf(string);
    const copying = this.ir.declare(kArrayCopy, kPointerType, [kPointerType]);
    const value = frame.made.call(copying, [cached]);
    const shared: IrValue = {
      type: kPointerType,
      value: cached,
      tz,
      owned: true,
    };

    this.countCall(frame, false, shared);

    return { type: kPointerType, value, tz, owned: true };
  }

  private processAssigned(
    frame: Frame,
    expr: AssignExpr,
    target: MemberExpr,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    if (target.name != "exitCode" || expr.op != undefined) {
      this.notLowered(frame.module, expr.loc, "an assignment to process");

      return undefined;
    }

    const valueExpr = tree.exprOf(expr.valueId);
    const given = this.value(frame, valueExpr);
    if (given == undefined) {
      return undefined;
    }

    const int = this.values.types.store.integer(64, false);
    const code = this.converted(
      frame,
      given,
      int,
      tree.exprOf(expr.valueId).loc,
    );
    if (code == undefined) {
      return undefined;
    }

    const params = [kIntType, kFlagType];
    const callee = this.ir.declare(kProcessSetExitCode, kVoidType, params);
    const has = this.ir.integer(kFlagType, "1");

    frame.made.call(callee, [code.value, has]);

    return code;
  }
}
