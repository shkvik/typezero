import {
  AssignExpr,
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { Lowering } from "../lowering.tz";
import {
  kFlagType,
  kIntType,
  kPlatformName,
  kProcessModule,
  kProcessName,
  kProcessSetExitCode,
  kVoidType,
} from "../const/lowering.const.tz";
import { Frame, IrValue, RuntimeTarget } from "../types/lowering.types.tz";

partial class Lowering {
  private readonly isProcessName(frame: Read<Frame>, expr: Expr): boolean {
    if (expr.kind != ExprKind.Name || expr.name != kProcessName) {
      return false;
    }

    const target = this.values.valueTargetOf(expr, frame.module);
    const opened = this.values.types.program.modules[target?.module ?? -1];
    if (opened == undefined) {
      return false;
    }

    return opened.source.isLibrary;
  }

  private processMember(
    frame: Read<Frame>,
    expr: MemberExpr,
  ): IrValue | undefined {
    switch (expr.name) {
      case "argv":
        return this.processArgv(frame);
      case "execPath":
        return this.processCall(frame, "execPath", expr.loc);
      case "platform":
        return this.stringValue(kPlatformName);
      default:
        this.notLowered(frame.module, expr.loc, "this member of process");

        return undefined;
    }
  }

  private processArgv(frame: Read<Frame>): IrValue | undefined {
    return this.processCall(frame, "argumentsOf", this.statementLoc);
  }

  private processCall(
    frame: Read<Frame>,
    name: string,
    loc: int,
  ): IrValue | undefined {
    const target: RuntimeTarget = { module: kProcessModule, name };

    return this.runtimeFunctionCall(frame, target, [], [], loc);
  }

  private processAssigned(
    frame: Frame,
    expr: AssignExpr,
    target: MemberExpr,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    if (target.name != "exitCode" || expr.op != undefined) {
      this.notLowered(frame.module, expr.loc, "an assignment to process");

      return undefined;
    }

    const valueExpr = tree.exprOf(expr.valueId);
    const given = this.value(frame, valueExpr);
    if (given == undefined) {
      return undefined;
    }

    const int = this.values.types.store.integer(64, false);
    const code = this.converted(
      frame,
      given,
      int,
      tree.exprOf(expr.valueId).loc,
    );
    if (code == undefined) {
      return undefined;
    }

    const params = [kIntType, kFlagType];
    const callee = this.ir.declare(kProcessSetExitCode, kVoidType, params);
    const has = this.ir.integer(kFlagType, "1");

    frame.made.call(callee, [code.value, has]);

    return code;
  }
}
