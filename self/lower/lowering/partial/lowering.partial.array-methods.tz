import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import { IrFunction } from "../../ir-function/ir-function.tz";
import {
  IrIntPredicate,
  IrOpcode,
  IrRealPredicate,
} from "../../ir-function/types/ir-function.types.tz";
import { LLVMBlock, LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kAppendName,
  kAppendTakenName,
  kArrayAppend,
  kArrayIndexOf,
  kArrayJoin,
  kArrayLengthField,
  kArrayModule,
  kArrayNew,
  kArrayReverse,
  kArraySetLength,
  kArraySlice,
  kArraySort,
  kArraySortWith,
  kArraySplice,
  kBooleanType,
  kCharType,
  kDoubleType,
  kFindName,
  kFlagType,
  kIntType,
  kPointerType,
  kReverseName,
  kSliceName,
  kStringType,
  kVoidType,
} from "../const/lowering.const.tz";
import {
  CallbackStep,
  EachLoop,
  Frame,
  GivenNumber,
  GivenText,
  IrValue,
  Place,
} from "../types/lowering.types.tz";

partial class Lowering {
  private arrayAt(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
    object: Type,
  ): IrValue | undefined {
    const argument = call.args[0];
    if (object.kind != TypeKind.Array || argument == undefined) {
      this.notLowered(frame.module, call.loc, "a call of method array.at");

      return undefined;
    }

    const item = object.item;
    const empty = this.store.plain(TypeKind.Undefined);
    const result = this.store.unionOf([item, empty]);
    const array = this.value(frame, member.object);
    const int = this.store.integer(64, false);
    const given = this.wantedValue(frame, argument.expr, int);
    if (array == undefined || given == undefined) {
      return undefined;
    }

    const index = this.toLong(frame, given).value;
    const length = this.arrayLength(frame, array.value);
    const zero = this.ir.zero(kIntType);
    const isFromEnd = frame.made.integerCompare(IrIntPredicate.SignedLess, index, zero);
    const fromEnd = frame.made.binary(IrOpcode.Add, index, length);
    const position = frame.made.select(isFromEnd, fromEnd, index);
    const read = this.checkedRead(frame, array, position, item, result);

    this.dropping(frame, array);

    return read;
  }

  private arrayMethod(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
    object: Type,
  ): IrValue | undefined {
    if (object.kind != TypeKind.Array) {
      return undefined;
    }

    switch (member.name) {
      case "push":
        return this.arrayCall(frame, call, member, object);
      case "at":
        return this.arrayAt(frame, call, member, object);
      case "some":
      case "every":
      case "find":
      case "findIndex":
      case "filter":
      case "map":
      case "flatMap":
      case "forEach":
        return this.callbackMethod(frame, call, member, object);
      case "includes":
      case "indexOf":
      case "lastIndexOf":
        return this.searched(frame, call, member, object);
      case "join":
        return this.arrayJoined(frame, call, member);
      case "slice":
      case "view":
        return this.arraySliced(frame, call, member, object);
      case "drain":
        return this.drainedArray(frame, member, object);
      case "retain":
        return this.retainedArray(frame, call, member, object);
      case "pop":
        return this.popped(frame, call, member, object);
      case "concat":
        return this.concatArrays(frame, call, member, object);
      case "sort":
        return this.sortedArray(frame, call, member, object);
      case "reverse":
        return this.reversedArray(frame, call, member, object);
      case "splice":
        return this.splicedArray(frame, call, member, object);
      case "unshift":
        return this.unshiftedArray(frame, call, member, object);
      default: {
        const name = this.calledName(call);

        this.notLowered(frame.module, call.loc, `a call of method ${name}`);

        return undefined;
      }
    }
  }

  private eachStart(
    frame: Read<Frame>,
    array: LLVMValue,
    item: Type,
  ): EachLoop | undefined {
    const element = this.irType(item);
    if (element == undefined) {
      return undefined;
    }

    const counter = frame.made.slot(kIntType, "each.index");
    const cond = frame.made.block("each.cond");
    const body = frame.made.block("each.body");
    const step = frame.made.block("each.step");
    const done = frame.made.block("each.done");
    const tz = this.store.integer(64, false);

    frame.made.store(this.ir.zero(kIntType), counter);
    frame.made.open(cond);

    const index = frame.made.load(kIntType, counter);
    const length = this.arrayLength(frame, array);
    const isInside = frame.made.integerCompare(
      IrIntPredicate.UnsignedLess,
      index,
      length,
    );

    frame.made.conditionalBranch(isInside, body, done);
    frame.made.open(body);

    const data = this.arrayData(frame, array);
    const address = frame.made.element(element, data, index);
    const value: IrValue = {
      type: element,
      value: frame.made.load(element, address),
      tz: item,
    };
    const position: IrValue = { type: kIntType, value: index, tz };

    return { item: value, index: position, counter, cond, step, done };
  }

  private readonly eachEnd(frame: Read<Frame>, loop: EachLoop): void {
    frame.made.open(loop.step);

    const one = this.ir.integer(kIntType, "1");
    const next = frame.made.binary(IrOpcode.Add, loop.index.value, one);

    frame.made.store(next, loop.counter);
    frame.made.branch(loop.cond);
    frame.made.open(loop.done);
  }

  private readonly methodResult(
    call: CallExpr,
    name: string,
    object: Type,
  ): Type | undefined {
    if (name == "filter") {
      return object;
    }

    const answered = this.typeOf(call);
    if (answered != undefined && answered.kind != TypeKind.Error) {
      return answered;
    }

    switch (name) {
      case "some":
      case "every":
        return this.store.plain(TypeKind.Boolean);
      case "findIndex":
        return this.store.integer(64, false);
      case "forEach":
        return this.store.plain(TypeKind.Void);
      case "filter":
        return object;
      case "find": {
        const item = this.itemOf(object);
        if (item == undefined) {
          return undefined;
        }

        const empty = this.store.plain(TypeKind.Undefined);

        return this.store.unionOf([item, empty]);
      }
      default:
        return answered;
    }
  }

  private callbackMethod(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
    object: Type,
  ): IrValue | undefined {
    const callback = call.args[0];
    const result = this.methodResult(call, member.name, object);
    const resultIr = this.typeOrUndefined(result);
    if (object.kind != TypeKind.Array || callback == undefined) {
      this.notLowered(frame.module, call.loc, "these arguments");

      return undefined;
    }
    if (result == undefined || resultIr == undefined) {
      this.notLowered(frame.module, call.loc, "a result of this type");

      return undefined;
    }
    if (!this.isInlineable(callback.expr)) {
      this.notLowered(frame.module, call.loc, "a callback that is not inline");

      return undefined;
    }

    const array = this.value(frame, member.object);
    if (array == undefined) {
      return undefined;
    }

    const borrowed: IrValue = {
      type: array.type,
      value: array.value,
      tz: array.tz,
    };
    const slotType = this.slotTypeOf(resultIr);
    const slot = frame.made.slot(slotType, "method.result");
    const place: Place = {
      pointer: slot,
      type: slotType,
      tz: result,
      owner: frame.id,
    };

    frame.made.entryStore(this.ir.zero(slotType), slot);

    const isStarted = this.methodStart(frame, member.name, place, result);
    if (!isStarted) {
      return undefined;
    }

    const loop = this.eachStart(frame, array.value, object.item);
    if (loop == undefined) {
      return undefined;
    }

    const isLent = member.name == kFindName && array.owned != true;
    const isStepped = this.callbackStep(
      frame,
      member.name,
      callback.expr,
      place,
      {
        item: loop.item,
        index: loop.index,
        array: borrowed,
        done: loop.done,
        isLent,
      },
    );
    if (!isStepped) {
      return undefined;
    }

    this.eachEnd(frame, loop);

    const value = frame.made.load(slotType, slot);

    frame.made.store(this.ir.zero(slotType), slot);
    this.dropping(frame, array);

    return { type: resultIr, value, tz: result, owned: !isLent };
  }

  private readonly slotTypeOf(type: string): string {
    if (type == kVoidType) {
      return kBooleanType;
    }

    return type;
  }

  private methodStart(
    frame: Read<Frame>,
    name: string,
    place: Place,
    result: Type,
  ): boolean {
    switch (name) {
      case "every":
        frame.made.store(this.ir.integer(kBooleanType, "1"), place.pointer);

        return true;
      case "findIndex":
        frame.made.store(this.ir.integer(kIntType, "-1"), place.pointer);

        return true;
      case "filter":
      case "map":
      case "flatMap": {
        const item = this.itemOf(result);
        const descriptor = this.descriptor(item ?? result);
        if (item == undefined || descriptor == undefined) {
          return false;
        }

        const array = this.emptyArray(frame, descriptor);

        frame.made.store(array, place.pointer);

        return true;
      }
      default:
        return true;
    }
  }

  private callbackStep(
    frame: Frame,
    name: string,
    callback: Expr,
    place: Place,
    step: CallbackStep,
  ): boolean {
    const args = [step.item, step.index, step.array];
    const wanted = this.flatWanted(name, place);
    const returned = this.inlineCall(frame, callback, args, wanted);
    if (returned == undefined) {
      return false;
    }

    switch (name) {
      case "forEach":
        this.dropping(frame, returned);

        return true;
      case "map":
        return this.mappedPush(frame, place, returned, callback);
      case "flatMap":
        return this.flatPushed(frame, place, returned, callback);
      default:
        return this.testedStep(frame, name, callback, place, step, returned);
    }
  }

  private readonly flatWanted(name: string, place: Place): Type | undefined {
    if (name != "flatMap") {
      return undefined;
    }

    return place.tz;
  }

  private mappedPush(
    frame: Frame,
    place: Place,
    returned: IrValue,
    callback: Expr,
  ): boolean {
    const item = this.itemOf(place.tz);
    if (item == undefined) {
      return false;
    }

    const value = this.converted(frame, returned, item, callback.loc);
    if (value == undefined) {
      return false;
    }

    const array = frame.made.load(kPointerType, place.pointer);

    this.pushed(frame, array, value, item);

    return true;
  }

  private testedStep(
    frame: Frame,
    name: string,
    callback: Expr,
    place: Place,
    step: CallbackStep,
    returned: IrValue,
  ): boolean {
    const test = this.truthOf(frame, returned, callback);
    if (test == undefined) {
      return false;
    }

    const hit = frame.made.block("method.hit");
    const miss = frame.made.block("method.miss");

    if (name == "every") {
      frame.made.conditionalBranch(test, miss, hit);
    } else {
      frame.made.conditionalBranch(test, hit, miss);
    }

    frame.made.open(hit);

    const isStored = this.hitStored(frame, name, place, step);
    if (!isStored) {
      return false;
    }

    frame.made.open(miss);

    return true;
  }

  private hitStored(
    frame: Frame,
    name: string,
    place: Place,
    step: CallbackStep,
  ): boolean {
    switch (name) {
      case "some":
        frame.made.store(this.ir.integer(kBooleanType, "1"), place.pointer);
        frame.made.branch(step.done);

        return true;
      case "every":
        frame.made.store(this.ir.integer(kBooleanType, "0"), place.pointer);
        frame.made.branch(step.done);

        return true;
      case "findIndex":
        frame.made.store(step.index.value, place.pointer);
        frame.made.branch(step.done);

        return true;
      case "find": {
        const kept = this.foundItem(frame, step);
        const value = this.converted(frame, kept, place.tz, 0);
        if (value == undefined) {
          return false;
        }

        frame.made.store(value.value, place.pointer);
        frame.made.branch(step.done);

        return true;
      }
      case "filter": {
        const array = frame.made.load(kPointerType, place.pointer);
        const item = this.itemOf(place.tz);
        if (item == undefined) {
          return false;
        }

        this.pushed(frame, array, step.item, item);

        return true;
      }
      default:
        return false;
    }
  }

  private foundItem(frame: Read<Frame>, step: Read<CallbackStep>): IrValue {
    if (step.isLent == true) {
      return step.item;
    }

    return this.owning(frame, step.item);
  }

  private readonly emptyArray(frame: Read<Frame>, descriptor: LLVMValue): LLVMValue {
    const tz = this.store.integer(64, false);
    const zero = this.ir.zero(kIntType);
    const args: IrValue[] = [
      { type: kPointerType, value: descriptor, tz },
      { type: kIntType, value: zero, tz },
      { type: kIntType, value: zero, tz },
    ];

    return this.runtimeValue(frame, kArrayNew, kPointerType, args);
  }

  private searched(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
    object: Type,
  ): IrValue | undefined {
    const argument = call.args[0];
    if (object.kind != TypeKind.Array || argument == undefined) {
      this.notLowered(frame.module, call.loc, "these arguments");

      return undefined;
    }
    if (call.args.length > 1) {
      this.notLowered(frame.module, call.loc, "a search from a position");

      return undefined;
    }

    const array = this.value(frame, member.object);
    const given = this.value(frame, argument.expr);
    if (array == undefined || given == undefined) {
      return undefined;
    }

    const loc = argument.expr.loc;
    const wanted = this.converted(frame, given, object.item, loc);
    if (wanted == undefined) {
      return undefined;
    }

    if (this.isPlainElement(object.item)) {
      const items = [object.item];
      const given = [array, wanted];
      const target = { module: kArrayModule, name: member.name };
      const found = this.runtimeFunctionCall(frame, target, items, given, loc);

      this.dropping(frame, wanted);
      this.dropping(frame, array);

      return found;
    }

    const slot = frame.made.slot(wanted.type, "search.value");
    const mode = this.searchMode(member.name);

    frame.made.store(wanted.value, slot);

    const searching = this.ir.declare(kArrayIndexOf, kFlagType, [
      kPointerType,
      kPointerType,
      kIntType,
      kFlagType,
      kFlagType,
    ]);
    const found = frame.made.call(searching, [
      array.value,
      slot,
      this.ir.zero(kIntType),
      this.ir.zero(kFlagType),
      this.ir.integer(kFlagType, `${mode}`),
    ]);

    this.dropping(frame, wanted);
    this.dropping(frame, array);

    if (mode == 2) {
      const zero = this.ir.zero(kFlagType);
      const value = frame.made.integerCompare(IrIntPredicate.NotEqual, found, zero);
      const tz = this.store.plain(TypeKind.Boolean);

      return { type: kBooleanType, value, tz };
    }

    const value = frame.made.cast(IrOpcode.SExt, found, kIntType);
    const tz = this.store.integer(64, false);

    return { type: kIntType, value, tz };
  }

  private isPlainElement(item: Type): boolean {
    if (this.optionalInner(item) != undefined) {
      return false;
    }

    const isInstance =
      item.kind == TypeKind.Instance && !this.isHandleType(item);

    return (
      this.isInteger(item) ||
      this.isBoolean(item) ||
      this.isString(item) ||
      isInstance
    );
  }

  private readonly searchMode(name: string): int {
    switch (name) {
      case "lastIndexOf":
        return 1;
      case "includes":
        return 2;
      default:
        return 0;
    }
  }

  private arrayJoined(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
  ): IrValue | undefined {
    const array = this.value(frame, member.object);
    const argument = call.args[0];
    if (array == undefined) {
      return undefined;
    }

    const separator = this.optionalText(frame, argument?.expr);
    if (separator == undefined) {
      return undefined;
    }

    const out = frame.made.slot(kStringType, "join.out");
    const joining = this.ir.declare(kArrayJoin, kVoidType, [
      kPointerType,
      kPointerType,
      kPointerType,
      kIntType,
      kFlagType,
    ]);
    const text = frame.made.extract(separator.value, 0);
    const meta = frame.made.extract(separator.value, 1);
    const hasSeparator = this.ir.integer(kFlagType, `${separator.given}`);

    frame.made.call(joining, [out, array.value, text, meta, hasSeparator]);

    const value = frame.made.load(kStringType, out);
    const tz = this.store.plain(TypeKind.String);

    this.dropping(frame, separator.text);
    this.dropping(frame, array);

    return { type: kStringType, value, tz, owned: true };
  }

  private optionalText(
    frame: Frame,
    expr: Expr | undefined,
  ): GivenText | undefined {
    if (expr == undefined) {
      const empty = this.stringValue("");

      return { value: empty.value, text: empty, given: 0 };
    }

    const given = this.value(frame, expr);
    if (given == undefined) {
      return undefined;
    }

    const text = this.converted(
      frame,
      given,
      this.store.plain(TypeKind.String),
      expr.loc,
    );
    if (text == undefined) {
      return undefined;
    }

    return { value: text.value, text, given: 1 };
  }

  private arraySliced(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
    object: Type,
  ): IrValue | undefined {
    const array = this.value(frame, member.object);
    const start = this.integerArgument(frame, call, 0);
    const end = this.integerArgument(frame, call, 1);
    if (array == undefined || start == undefined || end == undefined) {
      return undefined;
    }

    if (object.kind == TypeKind.Array && this.isPlainElement(object.item)) {
      const target = { module: kArrayModule, name: kSliceName };
      const int = this.store.integer(64, false);
      const boolean = this.store.plain(TypeKind.Boolean);
      const isEnded = this.ir.integer(kBooleanType, `${end.given}`);
      const given: IrValue[] = [
        array,
        { type: kIntType, value: start.value, tz: int },
        { type: kIntType, value: end.value, tz: int },
        { type: kBooleanType, value: isEnded, tz: boolean },
      ];
      const items = [object.item];
      const sliced = this.runtimeFunctionCall(frame, target, items, given, call.loc);

      this.dropping(frame, array);

      return sliced;
    }

    const hasEnd = this.ir.integer(kFlagType, `${end.given}`);
    const slicing = this.ir.declare(kArraySlice, kPointerType, [
      kPointerType,
      kIntType,
      kIntType,
      kFlagType,
    ]);
    const value = frame.made.call(slicing, [
      array.value,
      start.value,
      end.value,
      hasEnd,
    ]);

    this.dropping(frame, array);

    return { type: kPointerType, value, tz: object, owned: true };
  }

  private drainedArray(
    frame: Frame,
    member: MemberExpr,
    object: Type,
  ): IrValue | undefined {
    const array = this.value(frame, member.object);
    if (array == undefined) {
      return undefined;
    }

    const slots = frame.made.slot(kPointerType, "drain.slots");
    const splicing = this.ir.declare(kArraySplice, kPointerType, [
      kPointerType,
      kIntType,
      kIntType,
      kFlagType,
      kIntType,
      kPointerType,
    ]);
    const zero = this.ir.integer(kIntType, "0");
    const none = this.ir.integer(kFlagType, "0");
    const removed = frame.made.call(splicing, [
      array.value,
      zero,
      zero,
      none,
      zero,
      slots,
    ]);

    this.dropping(frame, array);

    return { type: kPointerType, value: removed, tz: object, owned: true };
  }

  private retainedArray(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
    object: Type,
  ): IrValue | undefined {
    const asFilter: MemberExpr = {
      kind: ExprKind.Member,
      loc: member.loc,
      object: member.object,
      name: "filter",
      known: member.known,
      optional: member.optional,
      typeArgs: member.typeArgs,
    };
    const kept = this.callbackMethod(frame, call, asFilter, object);
    const array = this.value(frame, member.object);
    if (kept == undefined || array == undefined) {
      return undefined;
    }

    const cutting = this.ir.declare(kArraySetLength, kVoidType, [
      kPointerType,
      kIntType,
    ]);
    const appending = this.ir.declare(kArrayAppend, kVoidType, [
      kPointerType,
      kPointerType,
    ]);

    frame.made.call(cutting, [array.value, this.ir.integer(kIntType, "0")]);
    frame.made.call(appending, [array.value, kept.value]);
    this.dropping(frame, kept);
    this.dropping(frame, array);

    const tz = this.store.plain(TypeKind.Void);

    return { type: kVoidType, value: this.ir.zero(kCharType), tz };
  }

  private integerArgument(
    frame: Frame,
    call: CallExpr,
    position: int,
  ): GivenNumber | undefined {
    const argument = call.args[position];
    if (argument == undefined) {
      return { value: this.ir.zero(kIntType), given: 0 };
    }

    const given = this.value(frame, argument.expr);
    if (given == undefined) {
      return undefined;
    }

    const int = this.store.integer(64, false);
    const value = this.converted(frame, given, int, argument.expr.loc);
    if (value == undefined) {
      return undefined;
    }

    return { value: value.value, given: 1 };
  }

  private popped(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
    object: Type,
  ): IrValue | undefined {
    const result = this.typeOf(call);
    const resultIr = this.typeOrUndefined(result);
    if (result == undefined || resultIr == undefined) {
      const kind = this.kindName(result);

      this.notLowered(frame.module, call.loc, `a result of type ${kind}`);

      return undefined;
    }
    if (object.kind != TypeKind.Array) {
      return undefined;
    }

    const element = this.irType(object.item);
    if (element == undefined) {
      return undefined;
    }

    const array = this.value(frame, member.object);
    if (array == undefined) {
      return undefined;
    }

    const lengthField = this.arrayField(frame, array.value, kArrayLengthField);
    const length = frame.made.load(kFlagType, lengthField);
    const zero = this.ir.zero(kFlagType);
    const isEmpty = frame.made.integerCompare(IrIntPredicate.Equal, length, zero);
    const before = frame.made.currentBlock();
    const take = frame.made.block("pop.take");
    const end = frame.made.block("pop.end");

    frame.made.conditionalBranch(isEmpty, end, take);
    frame.made.open(take);

    const one = this.ir.integer(kFlagType, "1");
    const last = frame.made.binary(IrOpcode.Sub, length, one);
    const data = this.arrayData(frame, array.value);
    const at = frame.made.cast(IrOpcode.ZExt, last, kIntType);
    const address = frame.made.element(element, data, at);
    const item: IrValue = {
      type: element,
      value: frame.made.load(element, address),
      tz: object.item,
      owned: true,
    };

    frame.made.store(last, lengthField);

    const placed = this.converted(frame, item, result, call.loc);
    const takeEnd = frame.made.currentBlock();

    frame.made.branch(end);
    frame.made.open(end);

    if (placed == undefined) {
      return undefined;
    }

    const missing = this.ir.zero(resultIr);
    const value = frame.made.phi(
      resultIr,
      [missing, placed.value],
      [before, takeEnd],
    );

    this.dropping(frame, array);

    return { type: resultIr, value, tz: result, owned: true };
  }

  private joinedArrays(
    frame: Frame,
    call: CallExpr,
    array: IrValue,
    object: Type,
  ): IrValue | undefined {
    if (object.kind != TypeKind.Array) {
      return undefined;
    }

    const items = [object.item];
    const int = this.store.integer(64, false);
    const boolean = this.store.plain(TypeKind.Boolean);
    const zero: IrValue = { type: kIntType, value: this.ir.zero(kIntType), tz: int };
    const whole: IrValue = {
      type: kBooleanType,
      value: this.ir.zero(kBooleanType),
      tz: boolean,
    };
    const slicing = { module: kArrayModule, name: kSliceName };
    const given = [array, zero, zero, whole];
    const copy = this.runtimeFunctionCall(frame, slicing, items, given, call.loc);

    this.dropping(frame, array);

    if (copy == undefined) {
      return undefined;
    }

    const isCopy = this.traits.isCopy(object.item, this.values);
    const name = this.pick(isCopy, kAppendName, kAppendTakenName);
    const appending = { module: kArrayModule, name };

    for (const argument of call.args) {
      const passed = this.wantedValue(frame, argument.expr, object);
      if (passed == undefined) {
        return undefined;
      }

      const other = this.converted(frame, passed, object, argument.expr.loc);
      if (other == undefined || argument.spread) {
        this.notLowered(frame.module, argument.expr.loc, "this argument");

        return undefined;
      }

      this.runtimeFunctionCall(frame, appending, items, [copy, other], call.loc);
      this.dropping(frame, other);
    }

    return copy;
  }

  private concatArrays(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
    object: Type,
  ): IrValue | undefined {
    const array = this.value(frame, member.object);
    if (array == undefined) {
      return undefined;
    }
    if (object.kind == TypeKind.Array && this.isPlainElement(object.item)) {
      return this.joinedArrays(frame, call, array, object);
    }

    const copying = this.ir.declare(kArraySlice, kPointerType, [
      kPointerType,
      kIntType,
      kIntType,
      kFlagType,
    ]);
    const zero = this.ir.zero(kIntType);
    const none = this.ir.zero(kFlagType);
    const copy = frame.made.call(copying, [array.value, zero, zero, none]);
    const appending = this.ir.declare(kArrayAppend, kVoidType, [
      kPointerType,
      kPointerType,
    ]);

    this.dropping(frame, array);

    for (const argument of call.args) {
      const given = this.wantedValue(frame, argument.expr, object);
      if (given == undefined) {
        return undefined;
      }

      const other = this.converted(frame, given, object, argument.expr.loc);
      if (other == undefined || argument.spread) {
        this.notLowered(frame.module, argument.expr.loc, "this argument");

        return undefined;
      }

      frame.made.call(appending, [copy, other.value]);
      this.dropping(frame, other);
    }

    return { type: kPointerType, value: copy, tz: object, owned: true };
  }

  private sortedArray(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
    object: Type,
  ): IrValue | undefined {
    const callback = call.args[0];
    if (object.kind != TypeKind.Array) {
      return undefined;
    }

    const array = this.value(frame, member.object);
    if (array == undefined) {
      return undefined;
    }

    if (callback == undefined) {
      const sorting = this.ir.declare(kArraySort, kVoidType, [kPointerType]);

      frame.made.call(sorting, [array.value]);

      return array;
    }

    const compare = this.comparator(frame, callback.expr, object.item);
    if (compare == undefined) {
      return undefined;
    }

    const params = [kPointerType, kPointerType, kPointerType];
    const sorting = this.ir.declare(kArraySortWith, kVoidType, params);
    const context = this.comparatorContext(frame);

    frame.made.call(sorting, [array.value, compare, context]);

    return array;
  }

  private readonly comparatorContext(frame: Read<Frame>): LLVMValue {
    const self = frame.self;
    if (self == undefined) {
      return this.ir.zero(kPointerType);
    }

    return frame.made.load(kPointerType, self.pointer);
  }

  private comparator(
    frame: Read<Frame>,
    callback: Expr,
    item: Type,
  ): LLVMValue | undefined {
    const element = this.irType(item);
    if (element == undefined || !this.isInlineable(callback)) {
      this.notLowered(frame.module, callback.loc, "this comparison");

      return undefined;
    }

    const name = this.ir.uniqueName("tz.compare.");
    const params = [kPointerType, kPointerType, kPointerType];
    const made = new IrFunction(this.ir, name, kFlagType, params);
    const self = this.comparatorSelf(made, frame.self);
    const inner: Frame = {
      made,
      id: this.frameId(),
      module: frame.module,
      loops: [],
      scopes: [],
      self,
      place: "",
    };
    const first: IrValue = {
      type: element,
      value: made.load(element, made.param(1)),
      tz: item,
    };
    const second: IrValue = {
      type: element,
      value: made.load(element, made.param(2)),
      tz: item,
    };

    this.openScope(inner);

    const returned = this.inlineCall(inner, callback, [first, second]);
    if (returned == undefined) {
      return undefined;
    }

    const sign = this.signOf(inner, returned);

    this.dropping(inner, returned);
    this.closeScope(inner);
    made.finishValue(sign);

    return made.callee.fn;
  }

  private readonly comparatorSelf(
    made: IrFunction,
    outer: Place | undefined,
  ): Place | undefined {
    if (outer == undefined) {
      return undefined;
    }

    const pointer = made.slot(kPointerType, "this");

    made.store(made.param(0), pointer);

    return { pointer, type: kPointerType, tz: outer.tz, owner: -1 };
  }

  private readonly signOf(frame: Read<Frame>, value: IrValue): LLVMValue {
    const one = this.ir.integer(kFlagType, "1");
    const minus = this.ir.integer(kFlagType, "-1");
    const zero = this.ir.zero(kFlagType);
    if (this.isDouble(value.tz)) {
      const none = this.ir.zero(kDoubleType);
      const above = frame.made.realCompare(
        IrRealPredicate.OrderedGreater,
        value.value,
        none,
      );
      const below = frame.made.realCompare(
        IrRealPredicate.OrderedLess,
        value.value,
        none,
      );
      const low = frame.made.select(below, minus, zero);

      return frame.made.select(above, one, low);
    }

    const long = this.toLong(frame, value).value;
    const none = this.ir.zero(kIntType);
    const above = frame.made.integerCompare(IrIntPredicate.SignedGreater, long, none);
    const below = frame.made.integerCompare(IrIntPredicate.SignedLess, long, none);
    const low = frame.made.select(below, minus, zero);

    return frame.made.select(above, one, low);
  }

  private reversedArray(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
    object: Type,
  ): IrValue | undefined {
    const array = this.value(frame, member.object);
    if (array == undefined) {
      return undefined;
    }
    if (object.kind == TypeKind.Array && this.isPlainElement(object.item)) {
      const items = [object.item];
      const target = { module: kArrayModule, name: kReverseName };
      const reversed = this.runtimeFunctionCall(
        frame,
        target,
        items,
        [array],
        call.loc,
      );
      if (reversed == undefined) {
        return undefined;
      }

      return array;
    }

    const params = [kPointerType];
    const reversing = this.ir.declare(kArrayReverse, kVoidType, params);

    frame.made.call(reversing, [array.value]);

    return array;
  }
}
