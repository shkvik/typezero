import {
  CallExpr,
  Expr,
  MemberExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import {
  IrIntPredicate,
  IrOpcode,
} from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kArrayModule,
  kBooleanType,
  kFlagType,
  kIntType,
  kPointerType,
  kJoinComma,
  kValuesModule,
  kTextModule,
} from "../const/lowering.const.tz";
import {
  EachLoop,
  Frame,
  GivenText,
  IrValue,
  RuntimeTarget,
} from "../types/lowering.types.tz";

partial class Lowering {
  private arrayAt(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
    object: Type,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const argument = tree.argumentsOf(call.argsList)[0];
    if (object.kind != TypeKind.Array || argument == undefined) {
      this.notLowered(frame.module, call.loc, "a call of method array.at");

      return undefined;
    }

    const item = this.values.types.store.itemOf(object);
    const empty = this.values.types.store.plain(TypeKind.Undefined);
    const result = this.values.types.store.unionOf([item, empty]);
    const objectExpr = tree.exprOf(member.objectId);
    const array = this.value(frame, objectExpr);
    const int = this.values.types.store.integer(64, false);
    const expr = tree.exprOf(argument.exprId);
    const given = this.wantedValue(frame, expr, int);
    if (array == undefined || given == undefined) {
      return undefined;
    }

    const index = this.toLong(frame, given).value;
    const length = this.arrayLength(frame, array.value);
    const zero = this.ir.zero(kIntType);
    const isFromEnd = frame.made.integerCompare(
      IrIntPredicate.SignedLess,
      index,
      zero,
    );
    const fromEnd = frame.made.binary(IrOpcode.Add, index, length);
    const position = frame.made.select(isFromEnd, fromEnd, index);
    const read = this.checkedRead(frame, array, position, item, result);

    this.dropping(frame, array);

    return read;
  }

  private arrayMethod(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
    object: Type,
  ): IrValue | undefined {
    if (object.kind != TypeKind.Array) {
      return undefined;
    }

    switch (member.name) {
      case "push":
        return this.arrayCall(frame, call, member, object);
      case "at":
        return this.arrayAt(frame, call, member, object);
      case "some":
      case "every":
      case "find":
      case "findIndex":
      case "filter":
      case "map":
      case "flatMap":
      case "forEach":
        return this.callbackMethod(frame, call, member, object);
      case "includes":
      case "indexOf":
      case "lastIndexOf":
        return this.searched(frame, call, member, object);
      case "join":
        return this.arrayJoined(frame, call, member);
      case "slice":
      case "view":
        return this.arraySliced(frame, call, member, object);
      case "drain":
        return this.drainedArray(frame, member, object);
      case "retain":
        return this.retainedArray(frame, call, member, object);
      case "pop":
        return this.popped(frame, call, member, object);
      case "concat":
        return this.concatArrays(frame, call, member, object);
      case "sort":
        return this.sortedArray(frame, call, member, object);
      case "reverse":
        return this.reversedArray(frame, call, member, object);
      case "splice":
        return this.splicedArray(frame, call, member, object);
      case "unshift":
        return this.unshiftedArray(frame, call, member, object);
      default: {
        const name = this.calledName(call);

        this.notLowered(frame.module, call.loc, `a call of method ${name}`);

        return undefined;
      }
    }
  }

  private eachStart(
    frame: Read<Frame>,
    array: LLVMValue,
    item: Type,
  ): EachLoop | undefined {
    const element = this.irType(item);
    if (element == undefined) {
      return undefined;
    }

    const counter = frame.made.slot(kIntType, "each.index");
    const cond = frame.made.block("each.cond");
    const body = frame.made.block("each.body");
    const step = frame.made.block("each.step");
    const done = frame.made.block("each.done");
    const tz = this.values.types.store.integer(64, false);

    frame.made.store(this.ir.zero(kIntType), counter);
    frame.made.open(cond);

    const index = frame.made.load(kIntType, counter);
    const length = this.arrayLength(frame, array);
    const isInside = frame.made.integerCompare(
      IrIntPredicate.UnsignedLess,
      index,
      length,
    );

    frame.made.conditionalBranch(isInside, body, done);
    frame.made.open(body);

    const data = this.arrayData(frame, array);
    const address = frame.made.element(element, data, index);
    const value: IrValue = {
      type: element,
      value: frame.made.load(element, address),
      tz: item,
    };
    const position: IrValue = { type: kIntType, value: index, tz };

    return { item: value, index: position, counter, cond, step, done };
  }

  private eachEnd(frame: Read<Frame>, loop: EachLoop): void {
    frame.made.open(loop.step);

    const one = this.ir.integer(kIntType, "1");
    const next = frame.made.binary(IrOpcode.Add, loop.index.value, one);

    frame.made.store(next, loop.counter);
    frame.made.branch(loop.cond);
    frame.made.open(loop.done);
  }

  private emptyArray(frame: Read<Frame>, descriptor: LLVMValue): LLVMValue {
    const tz = this.values.types.store.integer(64, false);
    const zero = this.ir.zero(kIntType);
    const args: IrValue[] = [
      { type: kPointerType, value: descriptor, tz },
      { type: kIntType, value: zero, tz },
      { type: kIntType, value: zero, tz },
    ];

    return this.runtimeValue(frame, this.arrayMaking(), kPointerType, args);
  }

  private searched(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
    object: Type,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const argument = tree.argumentsOf(call.argsList)[0];
    if (object.kind != TypeKind.Array || argument == undefined) {
      this.notLowered(frame.module, call.loc, "these arguments");

      return undefined;
    }
    const args = tree.argumentsOf(call.argsList);
    if (args.length > 1) {
      this.notLowered(frame.module, call.loc, "a search from a position");

      return undefined;
    }

    const objectExpr = tree.exprOf(member.objectId);
    const array = this.value(frame, objectExpr);
    const expr = tree.exprOf(argument.exprId);
    const given = this.value(frame, expr);
    if (array == undefined || given == undefined) {
      return undefined;
    }

    const loc = tree.exprOf(argument.exprId).loc;
    const wanted = this.converted(
      frame,
      given,
      this.values.types.store.itemOf(object),
      loc,
    );
    if (wanted == undefined) {
      return undefined;
    }

    if (this.isPlainElement(this.values.types.store.itemOf(object))) {
      const items = [this.values.types.store.itemOf(object)];
      const given = [array, wanted];
      const target: RuntimeTarget = { module: kArrayModule, name: member.name };
      const found = this.runtimeFunctionCall(frame, target, items, given, loc);

      this.dropping(frame, wanted);
      this.dropping(frame, array);

      return found;
    }

    const slot = frame.made.slot(wanted.type, "search.value");
    const mode = this.searchMode(member.name);
    const int = this.values.types.store.integer(64, false);
    const modeValue = this.ir.integer(kIntType, `${mode}`);
    const searchParts: IrValue[] = [
      { type: kPointerType, value: array.value, tz: int },
      { type: kPointerType, value: slot, tz: int },
      { type: kIntType, value: modeValue, tz: int },
    ];
    const name = "indexOfValue";
    const target: RuntimeTarget = { module: kValuesModule, name };

    frame.made.store(wanted.value, slot);

    const found = this.runtimeFunctionCall(frame, target, [], searchParts, loc);

    this.dropping(frame, wanted);
    this.dropping(frame, array);

    if (found == undefined) {
      return undefined;
    }
    if (mode == 2) {
      const zero = this.ir.zero(kIntType);
      const value = frame.made.integerCompare(
        IrIntPredicate.NotEqual,
        found.value,
        zero,
      );
      const tz = this.values.types.store.plain(TypeKind.Boolean);

      return { type: kBooleanType, value, tz };
    }

    return { type: kIntType, value: found.value, tz: int };
  }

  private isPlainElement(item: Type): boolean {
    if (this.optionalInner(item) != undefined) {
      return false;
    }

    const isInstance =
      item.kind == TypeKind.Instance && !this.isHandleType(item);

    return (
      this.isInteger(item) ||
      this.isBoolean(item) ||
      this.isString(item) ||
      isInstance
    );
  }

  private readonly searchMode(name: string): int {
    switch (name) {
      case "lastIndexOf":
        return 1;
      case "includes":
        return 2;
      default:
        return 0;
    }
  }

  private arrayJoined(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const object = tree.exprOf(member.objectId);
    const array = this.value(frame, object);
    const argument = tree.argumentsOf(call.argsList)[0];
    if (array == undefined) {
      return undefined;
    }

    const separator = this.optionalText(frame, tree.exprAt(argument?.exprId));
    if (separator == undefined) {
      return undefined;
    }
    if (this.isTextArray(array.tz)) {
      return this.textsJoined(frame, call, array, separator);
    }

    return this.valuesJoined(frame, call, array, separator);
  }

  private valuesJoined(
    frame: Frame,
    call: CallExpr,
    array: IrValue,
    separator: Read<GivenText>,
  ): IrValue | undefined {
    let cut = separator.text;

    if (separator.given == 0) {
      cut = this.stringValue(kJoinComma);
    }

    const tz = this.values.types.store.integer(64, false);
    const raw: IrValue = { type: kPointerType, value: array.value, tz };
    const name = "joinedValues";
    const target: RuntimeTarget = { module: kValuesModule, name };
    const args = [raw, cut];
    const joined = this.runtimeFunctionCall(frame, target, [], args, call.loc);

    this.dropping(frame, separator.text);
    this.dropping(frame, array);

    return joined;
  }

  private optionalText(
    frame: Frame,
    expr: Expr | undefined,
  ): GivenText | undefined {
    if (expr == undefined) {
      const empty = this.stringValue("");

      return { value: empty.value, text: empty, given: 0 };
    }

    const given = this.value(frame, expr);
    if (given == undefined) {
      return undefined;
    }

    const text = this.converted(
      frame,
      given,
      this.values.types.store.plain(TypeKind.String),
      expr.loc,
    );
    if (text == undefined) {
      return undefined;
    }

    return { value: text.value, text, given: 1 };
  }

  private isTextArray(type: Type): boolean {
    const item = this.itemOf(type) ?? type;

    return type.kind == TypeKind.Array && this.isString(item);
  }

  private textsJoined(
    frame: Frame,
    call: CallExpr,
    array: IrValue,
    separator: Read<GivenText>,
  ): IrValue | undefined {
    let cut = separator.text;

    if (separator.given == 0) {
      cut = this.stringValue(kJoinComma);
    }

    const target: RuntimeTarget = { module: kTextModule, name: "join" };
    const args = [array, cut];
    const joined = this.runtimeFunctionCall(frame, target, [], args, call.loc);

    this.dropping(frame, separator.text);
    this.dropping(frame, array);

    return joined;
  }
}
