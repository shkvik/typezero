import {
  BinaryExpr,
  BinaryOp,
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import {
  IrIntPredicate,
  IrOpcode,
} from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kBooleanType,
  kDivisionPlaces,
  kRoundingModes,
  kDecimalRoundHalfUp,
  kDecimalType,
  kDecimalsModule,
  kDoubleType,
  kFlagType,
  kIntType,
  kPointerType,
  kVoidType,
} from "../const/lowering.const.tz";
import {
  Frame,
  GivenNumber,
  IrValue,
  RuntimeTarget,
} from "../types/lowering.types.tz";

partial class Lowering {
  private readonly isDecimal(type: Type): boolean {
    return this.widened(type).kind == TypeKind.Decimal;
  }

  private readonly decimalParts(
    frame: Read<Frame>,
    value: IrValue,
  ): LLVMValue[] {
    return [
      frame.made.extract(value.value, 0),
      frame.made.extract(value.value, 1),
    ];
  }

  private decimalOut(
    frame: Read<Frame>,
    name: string,
    args: Own<LLVMValue[]>,
  ): IrValue {
    const out = frame.made.slot(kDecimalType, "decimal.out");
    const params = [kPointerType].concat(args.map(() => kIntType));
    const callee = this.ir.declare(name, kVoidType, params);

    frame.made.call(callee, [out].concat(args));

    const value = frame.made.load(kDecimalType, out);
    const tz = this.values.types.store.plain(TypeKind.Decimal);

    return { type: kDecimalType, value, tz, owned: true };
  }

  private decimalFrom(frame: Read<Frame>, value: IrValue): IrValue | undefined {
    const tz = this.values.types.store.plain(TypeKind.Decimal);
    if (this.isDecimal(value.tz)) {
      return value;
    }
    if (this.isDouble(value.tz)) {
      return this.decimalsCalled(frame, "fromDouble", [value]);
    }
    if (!this.isInteger(value.tz)) {
      return undefined;
    }

    const isWideUnsigned =
      this.isUnsigned(value.tz) && this.bitsOf(value.tz) == 64;
    if (isWideUnsigned) {
      return this.decimalsCalled(frame, "fromUnsigned", [value]);
    }

    const long = this.toLong(frame, value);
    const empty = this.ir.undefinedOf(kDecimalType);
    const first = frame.made.insert(empty, long.value, 0);
    const zero = this.ir.zero(kIntType);
    const placed = frame.made.insert(first, zero, 1);

    return { type: kDecimalType, value: placed, tz };
  }

  private decimalArithmetic(
    frame: Frame,
    expr: BinaryExpr,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const lhs = tree.exprOf(expr.lhsId);
    const left = this.decimalOperand(frame, lhs);
    if (expr.op == BinaryOp.Pow) {
      const int = this.values.types.store.integer(64, false);
      const rhs = tree.exprOf(expr.rhsId);
      const given = this.value(frame, rhs);
      const power = this.convertedOrNone(
        frame,
        given,
        int,
        tree.exprOf(expr.rhsId).loc,
      );
      if (left == undefined || power == undefined) {
        return undefined;
      }

      const result = this.decimalsCalled(frame, "power", [left, power]);

      this.dropping(frame, left);

      return result;
    }

    const rhsExpr = tree.exprOf(expr.rhsId);
    const right = this.decimalOperand(frame, rhsExpr);
    const name = this.decimalRuntimeName(expr.op);
    if (left == undefined || right == undefined || name == undefined) {
      this.notLowered(frame.module, expr.loc, "this decimal operator");

      return undefined;
    }

    const found = this.decimalBinary(frame, name, left, right);

    this.dropping(frame, left);
    this.dropping(frame, right);

    return found;
  }

  private decimalBinary(
    frame: Read<Frame>,
    name: string,
    left: IrValue,
    right: IrValue,
  ): IrValue | undefined {
    if (name != "divide") {
      return this.decimalsCalled(frame, name, [left, right]);
    }

    const places = this.intValue(kDivisionPlaces);
    const mode = this.intValue(kDecimalRoundHalfUp);

    return this.decimalsCalled(frame, name, [left, right, places, mode]);
  }

  private intValue(value: int): IrValue {
    const made = this.ir.integer(kIntType, `${value}`);
    const tz = this.values.types.store.integer(64, false);

    return { type: kIntType, value: made, tz };
  }

  private intOfFlag(frame: Read<Frame>, flag: LLVMValue): IrValue {
    const value = frame.made.cast(IrOpcode.SExt, flag, kIntType);
    const tz = this.values.types.store.integer(64, false);

    return { type: kIntType, value, tz };
  }

  private decimalCompound(
    frame: Frame,
    op: BinaryOp,
    current: IrValue,
    expr: Expr,
  ): IrValue | undefined {
    const right = this.decimalOperand(frame, expr);
    const name = this.decimalRuntimeName(op);
    if (right == undefined || name == undefined) {
      this.notLowered(frame.module, expr.loc, "this decimal operator");

      return undefined;
    }

    const found = this.decimalBinary(frame, name, current, right);

    this.dropping(frame, right);

    return found;
  }

  private readonly decimalRuntimeName(op: BinaryOp): string | undefined {
    switch (op) {
      case BinaryOp.Add:
        return "add";
      case BinaryOp.Sub:
        return "subtract";
      case BinaryOp.Mul:
        return "multiply";
      case BinaryOp.Div:
        return "divide";
      case BinaryOp.Rem:
        return "remainder";
      default:
        return undefined;
    }
  }

  private decimalsCalled(
    frame: Read<Frame>,
    name: string,
    given: Read<IrValue[]>,
  ): IrValue | undefined {
    const target: RuntimeTarget = { module: kDecimalsModule, name };
    const loc = this.statementLoc;

    return this.runtimeFunctionCall(frame, target, [], given, loc);
  }

  private decimalOperand(frame: Frame, expr: Expr): IrValue | undefined {
    const given = this.value(frame, expr);
    if (given == undefined) {
      return undefined;
    }

    const inside = this.proven(frame, given);
    const converted = this.decimalFrom(frame, inside);
    if (converted == undefined) {
      this.notLowered(frame.module, expr.loc, "this decimal operand");
    }

    return converted;
  }

  private decimalsCompared(
    frame: Read<Frame>,
    op: BinaryOp,
    left: IrValue,
    right: IrValue,
  ): LLVMValue | undefined {
    const first = this.decimalFrom(frame, left);
    const second = this.decimalFrom(frame, right);
    if (first == undefined || second == undefined) {
      return undefined;
    }

    const isEquality = op == BinaryOp.Eq || op == BinaryOp.Ne;
    if (isEquality) {
      const same = this.decimalsCalled(frame, "equals", [first, second]);
      if (same == undefined) {
        return undefined;
      }
      if (op == BinaryOp.Eq) {
        return same.value;
      }

      const no = this.ir.zero(kBooleanType);

      return frame.made.integerCompare(IrIntPredicate.Equal, same.value, no);
    }

    const order = this.decimalsCalled(frame, "compare", [first, second]);
    if (order == undefined) {
      return undefined;
    }

    const predicate = this.integerPredicate(op, false);
    const zero = this.ir.zero(kIntType);

    return frame.made.integerCompare(predicate, order.value, zero);
  }

  private decimalToDouble(frame: Read<Frame>, value: IrValue): IrValue {
    const double = this.decimalsCalled(frame, "toDouble", [value]);

    this.dropping(frame, value);

    return double ?? this.doubleValue(0.0);
  }


  private decimalNegated(frame: Read<Frame>, value: IrValue): IrValue {
    const result = this.decimalsCalled(frame, "negate", [value]);

    this.dropping(frame, value);

    return result ?? value;
  }

  private decimalText(frame: Read<Frame>, value: IrValue): IrValue {
    const text = this.decimalsCalled(frame, "toText", [value]);

    this.dropping(frame, value);

    return text ?? this.stringValue("");
  }

  private decimalMethod(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const objectExpr = tree.exprOf(member.objectId);
    const object = this.value(frame, objectExpr);
    if (object == undefined) {
      return undefined;
    }

    const parts = this.decimalParts(frame, object);
    const params = [kIntType, kIntType];

    switch (member.name) {
      case "toString":
        return this.decimalText(frame, object);
      case "abs": {
        const result = this.decimalsCalled(frame, "absolute", [object]);

        this.dropping(frame, object);

        return result;
      }
      case "isInteger": {
        const result = this.decimalsCalled(frame, "isWhole", [object]);

        this.dropping(frame, object);

        return result;
      }
      case "decimalPlaces": {
        const result = this.decimalsCalled(frame, "placesOf", [object]);

        this.dropping(frame, object);

        return result;
      }
      case "toNumber":
      case "toDouble":
        return this.decimalToDouble(frame, object);
      case "div":
        return this.decimalDivided(frame, call, object);
      case "round":
        return this.decimalRounded(frame, call, object);
      case "toFixed":
      case "toFormat":
      case "toExponential":
      case "toPrecision":
        return this.decimalShown(frame, call, member.name, object);
      default: {
        const name = this.calledName(call);

        this.dropping(frame, object);
        this.notLowered(frame.module, call.loc, `a call of method ${name}`);

        return undefined;
      }
    }
  }

  private decimalDivided(
    frame: Frame,
    call: CallExpr,
    object: IrValue,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const divisor = tree.argumentsOf(call.argsList)[0];
    if (divisor == undefined) {
      this.notLowered(frame.module, call.loc, "a division of this form");

      return undefined;
    }

    const expr = tree.exprOf(divisor.exprId);
    const given = this.value(frame, expr);
    const right = this.decimalFromOrNone(frame, given);
    const places = this.placesArgument(frame, call, 1, kDivisionPlaces);
    const mode = this.roundingMode(frame, call, 2);
    if (right == undefined || places == undefined || mode == undefined) {
      return undefined;
    }

    const int = this.values.types.store.integer(64, false);
    const count: IrValue = { type: kIntType, value: places.value, tz: int };
    const args = [object, right, count, this.intOfFlag(frame, mode)];
    const result = this.decimalsCalled(frame, "divide", args);

    this.dropping(frame, object);
    this.dropping(frame, right);

    return result;
  }

  private decimalOf(frame: Frame, call: CallExpr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const argument = tree.argumentsOf(call.argsList)[0];
    if (argument == undefined || tree.argumentsOf(call.argsList).length != 1) {
      this.notLowered(frame.module, call.loc, "these arguments");

      return undefined;
    }

    const expr = tree.exprOf(argument.exprId);
    const given = this.value(frame, expr);
    if (given != undefined && this.isString(given.tz)) {
      return this.decimalParsed(frame, call, given);
    }

    return this.decimalFromOrNone(frame, given);
  }

  private decimalParsed(
    frame: Frame,
    call: CallExpr,
    text: IrValue,
  ): IrValue | undefined {
    const type = this.typeOf(call);
    const isChecked = type != undefined && type.kind == TypeKind.Result;
    let name = "fromText";

    if (isChecked) {
      name = "fromTextChecked";
    }

    const parsed = this.decimalsCalled(frame, name, [text]);

    this.dropping(frame, text);

    return parsed;
  }

  private decimalFromOrNone(
    frame: Read<Frame>,
    value: IrValue | undefined,
  ): IrValue | undefined {
    if (value == undefined) {
      return undefined;
    }

    return this.decimalFrom(frame, value);
  }

  private placesArgument(
    frame: Frame,
    call: CallExpr,
    position: int,
    absent: int,
  ): GivenNumber | undefined {
    const tree = this.values.types.program.tree;

    const argument = tree.argumentsOf(call.argsList)[position];
    if (argument == undefined) {
      const value = this.ir.integer(kIntType, `${absent}`);

      return { value, given: 0 };
    }

    return this.integerArgument(frame, call, position);
  }

  private roundingMode(
    frame: Frame,
    call: CallExpr,
    position: int,
  ): LLVMValue | undefined {
    const tree = this.values.types.program.tree;

    const argument = tree.argumentsOf(call.argsList)[position];
    if (argument == undefined) {
      return this.ir.integer(kFlagType, `${kDecimalRoundHalfUp}`);
    }

    const expr = tree.exprOf(argument.exprId);
    if (expr.kind == ExprKind.StringLit) {
      const known = kRoundingModes.indexOf(expr.value);
      if (known >= 0) {
        return this.ir.integer(kFlagType, `${known}`);
      }
    }

    const given = this.value(frame, expr);
    if (given == undefined) {
      return undefined;
    }

    const named = this.decimalsCalled(frame, "modeNamed", [given]);

    this.dropping(frame, given);

    if (named == undefined) {
      return undefined;
    }

    return frame.made.cast(IrOpcode.Trunc, named.value, kFlagType);
  }

  private decimalRounded(
    frame: Frame,
    call: CallExpr,
    object: IrValue,
  ): IrValue | undefined {
    const places = this.placesArgument(frame, call, 0, 0);
    const mode = this.roundingMode(frame, call, 1);
    if (places == undefined || mode == undefined) {
      return undefined;
    }

    const int = this.values.types.store.integer(64, false);
    const count: IrValue = { type: kIntType, value: places.value, tz: int };
    const given = [object, count, this.intOfFlag(frame, mode)];
    const result = this.decimalsCalled(frame, "rounded", given);

    this.dropping(frame, object);

    return result;
  }

  private decimalShown(
    frame: Frame,
    call: CallExpr,
    name: string,
    object: IrValue,
  ): IrValue | undefined {
    const count = this.placesArgument(frame, call, 0, 0);
    const mode = this.roundingMode(frame, call, 1);
    if (count == undefined || mode == undefined) {
      return undefined;
    }

    const int = this.values.types.store.integer(64, false);
    const places: IrValue = { type: kIntType, value: count.value, tz: int };
    const isGiven = this.booleanValue(count.given != 0);
    const args = [object, places, isGiven, this.intOfFlag(frame, mode)];
    const text = this.decimalsCalled(frame, name, args);

    this.dropping(frame, object);

    return text;
  }
}
