import {
  BinaryExpr,
  BinaryOp,
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import {
  IrIntPredicate,
  IrOpcode,
} from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kBooleanType,
  kDecimalAbs,
  kDecimalAdd,
  kDecimalCompare,
  kDecimalDivide,
  kDecimalEqual,
  kDecimalFromDouble,
  kDecimalFromText,
  kDecimalRound,
  kDecimalRoundingMode,
  kDecimalShowers,
  kDivisionPlaces,
  kRoundingModes,
  kDecimalFromUnsigned,
  kDecimalIsInteger,
  kDecimalMultiply,
  kDecimalNegate,
  kDecimalPlaces,
  kDecimalPower,
  kDecimalRemainder,
  kDecimalRoundHalfUp,
  kDecimalSubtract,
  kDecimalToDouble,
  kDecimalToText,
  kDecimalType,
  kDoubleType,
  kFlagType,
  kIntType,
  kPointerType,
  kVoidType,
} from "../const/lowering.const.tz";
import { Frame, GivenNumber, IrValue } from "../types/lowering.types.tz";

partial class Lowering {
  private readonly isDecimal(type: Type): boolean {
    return this.widened(type).kind == TypeKind.Decimal;
  }

  private readonly decimalParts(
    frame: Read<Frame>,
    value: IrValue,
  ): LLVMValue[] {
    return [
      frame.made.extract(value.value, 0),
      frame.made.extract(value.value, 1),
    ];
  }

  private decimalOut(
    frame: Read<Frame>,
    name: string,
    args: Own<LLVMValue[]>,
  ): IrValue {
    const out = frame.made.slot(kDecimalType, "decimal.out");
    const params = [kPointerType].concat(args.map(() => kIntType));
    const callee = this.ir.declare(name, kVoidType, params);

    frame.made.call(callee, [out].concat(args));

    const value = frame.made.load(kDecimalType, out);
    const tz = this.values.types.store.plain(TypeKind.Decimal);

    return { type: kDecimalType, value, tz, owned: true };
  }

  private decimalFrom(frame: Read<Frame>, value: IrValue): IrValue | undefined {
    const tz = this.values.types.store.plain(TypeKind.Decimal);
    if (this.isDecimal(value.tz)) {
      return value;
    }
    if (this.isDouble(value.tz)) {
      const out = frame.made.slot(kDecimalType, "decimal.out");
      const callee = this.ir.declare(kDecimalFromDouble, kVoidType, [
        kPointerType,
        kDoubleType,
      ]);

      frame.made.call(callee, [out, value.value]);

      const loaded = frame.made.load(kDecimalType, out);

      return { type: kDecimalType, value: loaded, tz, owned: true };
    }
    if (!this.isInteger(value.tz)) {
      return undefined;
    }

    const isWideUnsigned =
      this.isUnsigned(value.tz) && this.bitsOf(value.tz) == 64;
    if (isWideUnsigned) {
      return this.decimalOut(frame, kDecimalFromUnsigned, [value.value]);
    }

    const long = this.toLong(frame, value);
    const empty = this.ir.undefinedOf(kDecimalType);
    const first = frame.made.insert(empty, long.value, 0);
    const zero = this.ir.zero(kIntType);
    const placed = frame.made.insert(first, zero, 1);

    return { type: kDecimalType, value: placed, tz };
  }

  private decimalArithmetic(
    frame: Frame,
    expr: BinaryExpr,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const lhs = tree.exprOf(expr.lhsId);
    const left = this.decimalOperand(frame, lhs);
    if (expr.op == BinaryOp.Pow) {
      const int = this.values.types.store.integer(64, false);
      const rhs = tree.exprOf(expr.rhsId);
      const given = this.value(frame, rhs);
      const power = this.convertedOrNone(
        frame,
        given,
        int,
        tree.exprOf(expr.rhsId).loc,
      );
      if (left == undefined || power == undefined) {
        return undefined;
      }

      const parts = this.decimalParts(frame, left);
      const result = this.decimalOut(
        frame,
        kDecimalPower,
        parts.concat([power.value]),
      );

      this.dropping(frame, left);

      return result;
    }

    const rhsExpr = tree.exprOf(expr.rhsId);
    const right = this.decimalOperand(frame, rhsExpr);
    const name = this.decimalOperator(expr.op);
    if (left == undefined || right == undefined || name == undefined) {
      this.notLowered(frame.module, expr.loc, "this decimal operator");

      return undefined;
    }

    const args = this.decimalParts(frame, left).concat(
      this.decimalParts(frame, right),
    );
    if (expr.op == BinaryOp.Div) {
      args.push(this.ir.integer(kIntType, "20"));
    }

    const result = this.decimalCall(frame, name, args, expr.op);

    this.dropping(frame, left);
    this.dropping(frame, right);

    return result;
  }

  private decimalCall(
    frame: Read<Frame>,
    name: string,
    args: Own<LLVMValue[]>,
    op: BinaryOp,
  ): IrValue {
    if (op != BinaryOp.Div) {
      return this.decimalOut(frame, name, args);
    }

    const out = frame.made.slot(kDecimalType, "decimal.out");
    const params = [
      kPointerType,
      kIntType,
      kIntType,
      kIntType,
      kIntType,
      kIntType,
      kFlagType,
    ];
    const callee = this.ir.declare(name, kVoidType, params);
    const mode = this.ir.integer(kFlagType, `${kDecimalRoundHalfUp}`);

    frame.made.call(callee, [out].concat(args).concat([mode]));

    const value = frame.made.load(kDecimalType, out);
    const tz = this.values.types.store.plain(TypeKind.Decimal);

    return { type: kDecimalType, value, tz, owned: true };
  }

  private decimalCompound(
    frame: Frame,
    op: BinaryOp,
    current: IrValue,
    expr: Expr,
  ): IrValue | undefined {
    const right = this.decimalOperand(frame, expr);
    const name = this.decimalOperator(op);
    if (right == undefined || name == undefined) {
      this.notLowered(frame.module, expr.loc, "this decimal operator");

      return undefined;
    }

    const args = this.decimalParts(frame, current).concat(
      this.decimalParts(frame, right),
    );
    if (op == BinaryOp.Div) {
      args.push(this.ir.integer(kIntType, "20"));
    }

    const result = this.decimalCall(frame, name, args, op);

    this.dropping(frame, right);

    return result;
  }

  private readonly decimalOperator(op: BinaryOp): string | undefined {
    switch (op) {
      case BinaryOp.Add:
        return kDecimalAdd;
      case BinaryOp.Sub:
        return kDecimalSubtract;
      case BinaryOp.Mul:
        return kDecimalMultiply;
      case BinaryOp.Div:
        return kDecimalDivide;
      case BinaryOp.Rem:
        return kDecimalRemainder;
      default:
        return undefined;
    }
  }

  private decimalOperand(frame: Frame, expr: Expr): IrValue | undefined {
    const given = this.value(frame, expr);
    if (given == undefined) {
      return undefined;
    }

    const inside = this.proven(frame, given);
    const converted = this.decimalFrom(frame, inside);
    if (converted == undefined) {
      this.notLowered(frame.module, expr.loc, "this decimal operand");
    }

    return converted;
  }

  private decimalsCompared(
    frame: Read<Frame>,
    op: BinaryOp,
    left: IrValue,
    right: IrValue,
  ): LLVMValue | undefined {
    const first = this.decimalFrom(frame, left);
    const second = this.decimalFrom(frame, right);
    if (first == undefined || second == undefined) {
      return undefined;
    }

    const args = this.decimalParts(frame, first).concat(
      this.decimalParts(frame, second),
    );
    const params = [kIntType, kIntType, kIntType, kIntType];
    const zero = this.ir.zero(kFlagType);
    const isEquality = op == BinaryOp.Eq || op == BinaryOp.Ne;
    if (isEquality) {
      const callee = this.ir.declare(kDecimalEqual, kFlagType, params);
      const same = frame.made.call(callee, args);
      const predicate = this.equalFlagPredicate(op);

      return frame.made.integerCompare(predicate, same, zero);
    }

    const callee = this.ir.declare(kDecimalCompare, kFlagType, params);
    const order = frame.made.call(callee, args);
    const predicate = this.integerPredicate(op, false);

    return frame.made.integerCompare(predicate, order, zero);
  }

  private decimalToDouble(frame: Read<Frame>, value: IrValue): IrValue {
    const parts = this.decimalParts(frame, value);
    const params = [kIntType, kIntType];
    const callee = this.ir.declare(kDecimalToDouble, kDoubleType, params);
    const double = frame.made.call(callee, parts);
    const tz = this.values.types.store.plain(TypeKind.Double);

    this.dropping(frame, value);

    return { type: kDoubleType, value: double, tz };
  }

  private decimalNegated(frame: Read<Frame>, value: IrValue): IrValue {
    const parts = this.decimalParts(frame, value);
    const result = this.decimalOut(frame, kDecimalNegate, parts);

    this.dropping(frame, value);

    return result;
  }

  private decimalText(frame: Read<Frame>, value: IrValue): IrValue {
    const parts = this.decimalParts(frame, value);
    const params = [kIntType, kIntType];
    const text = this.textOut(frame, kDecimalToText, params, parts);

    this.dropping(frame, value);

    return text;
  }

  private decimalMethod(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const objectExpr = tree.exprOf(member.objectId);
    const object = this.value(frame, objectExpr);
    if (object == undefined) {
      return undefined;
    }

    const parts = this.decimalParts(frame, object);
    const params = [kIntType, kIntType];

    switch (member.name) {
      case "toString":
        return this.decimalText(frame, object);
      case "abs": {
        const result = this.decimalOut(frame, kDecimalAbs, parts);

        this.dropping(frame, object);

        return result;
      }
      case "isInteger": {
        const callee = this.ir.declare(kDecimalIsInteger, kFlagType, params);
        const zero = this.ir.zero(kFlagType);
        const flag = frame.made.call(callee, parts);
        const value = frame.made.integerCompare(
          IrIntPredicate.NotEqual,
          flag,
          zero,
        );
        const tz = this.values.types.store.plain(TypeKind.Boolean);

        this.dropping(frame, object);

        return { type: kBooleanType, value, tz };
      }
      case "decimalPlaces": {
        const callee = this.ir.declare(kDecimalPlaces, kFlagType, params);
        const places = frame.made.call(callee, parts);
        const value = frame.made.cast(IrOpcode.SExt, places, kIntType);
        const tz = this.values.types.store.integer(64, false);

        this.dropping(frame, object);

        return { type: kIntType, value, tz };
      }
      case "toNumber":
      case "toDouble": {
        const callee = this.ir.declare(kDecimalToDouble, kDoubleType, params);
        const value = frame.made.call(callee, parts);
        const tz = this.values.types.store.plain(TypeKind.Double);

        this.dropping(frame, object);

        return { type: kDoubleType, value, tz };
      }
      case "div":
        return this.decimalDivided(frame, call, object);
      case "round":
        return this.decimalRounded(frame, call, object);
      case "toFixed":
      case "toFormat":
      case "toExponential":
      case "toPrecision":
        return this.decimalShown(frame, call, member.name, object);
      default: {
        const name = this.calledName(call);

        this.dropping(frame, object);
        this.notLowered(frame.module, call.loc, `a call of method ${name}`);

        return undefined;
      }
    }
  }

  private decimalDivided(
    frame: Frame,
    call: CallExpr,
    object: IrValue,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const divisor = tree.argumentsOf(call.argsList)[0];
    if (divisor == undefined) {
      this.notLowered(frame.module, call.loc, "a division of this form");

      return undefined;
    }

    const expr = tree.exprOf(divisor.exprId);
    const given = this.value(frame, expr);
    const right = this.decimalFromOrNone(frame, given);
    const places = this.placesArgument(frame, call, 1, kDivisionPlaces);
    const mode = this.roundingMode(frame, call, 2);
    if (right == undefined || places == undefined || mode == undefined) {
      return undefined;
    }

    const args = this.decimalParts(frame, object).concat(
      this.decimalParts(frame, right),
    );
    const out = frame.made.slot(kDecimalType, "decimal.out");
    const params = [
      kPointerType,
      kIntType,
      kIntType,
      kIntType,
      kIntType,
      kIntType,
      kFlagType,
    ];
    const callee = this.ir.declare(kDecimalDivide, kVoidType, params);

    frame.made.call(callee, [out].concat(args).concat([places.value, mode]));

    const value = frame.made.load(kDecimalType, out);
    const tz = this.values.types.store.plain(TypeKind.Decimal);
    const result: IrValue = { type: kDecimalType, value, tz, owned: true };

    this.dropping(frame, object);
    this.dropping(frame, right);

    return result;
  }

  private decimalOf(frame: Frame, call: CallExpr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const argument = tree.argumentsOf(call.argsList)[0];
    if (argument == undefined || tree.argumentsOf(call.argsList).length != 1) {
      this.notLowered(frame.module, call.loc, "these arguments");

      return undefined;
    }

    const expr = tree.exprOf(argument.exprId);
    const given = this.value(frame, expr);
    if (given != undefined && this.isString(given.tz)) {
      return this.decimalParsed(frame, call, given);
    }

    return this.decimalFromOrNone(frame, given);
  }

  private decimalParsed(
    frame: Frame,
    call: CallExpr,
    text: IrValue,
  ): IrValue | undefined {
    const type = this.typeOf(call);
    const isChecked = type != undefined && type.kind == TypeKind.Result;
    let maker: LLVMValue = this.ir.zero(kPointerType);

    if (type != undefined && type.kind == TypeKind.Result) {
      const failure = this.failureMaker(this.values.types.store.errorOf(type), [
        "text",
      ]);
      if (failure == undefined) {
        this.notLowered(frame.module, call.loc, "a failure of this type");

        return undefined;
      }

      maker = failure;
    }

    const out = frame.made.slot(kDecimalType, "decimal.out");
    const params = [kPointerType, kPointerType, kIntType, kPointerType];
    const callee = this.ir.declare(kDecimalFromText, kVoidType, params);
    const args = [out].concat(this.textParts(frame, text)).concat([maker]);

    frame.made.call(callee, args);

    const value = frame.made.load(kDecimalType, out);
    const tz = this.values.types.store.plain(TypeKind.Decimal);
    const parsed: IrValue = { type: kDecimalType, value, tz, owned: true };

    this.dropping(frame, text);

    if (type == undefined || !isChecked) {
      return parsed;
    }

    return this.caughtResult(frame, parsed, type, call.loc);
  }

  private decimalFromOrNone(
    frame: Read<Frame>,
    value: IrValue | undefined,
  ): IrValue | undefined {
    if (value == undefined) {
      return undefined;
    }

    return this.decimalFrom(frame, value);
  }

  private placesArgument(
    frame: Frame,
    call: CallExpr,
    position: int,
    absent: int,
  ): GivenNumber | undefined {
    const tree = this.values.types.program.tree;

    const argument = tree.argumentsOf(call.argsList)[position];
    if (argument == undefined) {
      const value = this.ir.integer(kIntType, `${absent}`);

      return { value, given: 0 };
    }

    return this.integerArgument(frame, call, position);
  }

  private roundingMode(
    frame: Frame,
    call: CallExpr,
    position: int,
  ): LLVMValue | undefined {
    const tree = this.values.types.program.tree;

    const argument = tree.argumentsOf(call.argsList)[position];
    if (argument == undefined) {
      return this.ir.integer(kFlagType, `${kDecimalRoundHalfUp}`);
    }

    const expr = tree.exprOf(argument.exprId);
    if (expr.kind == ExprKind.StringLit) {
      const known = kRoundingModes.indexOf(expr.value);
      if (known >= 0) {
        return this.ir.integer(kFlagType, `${known}`);
      }
    }

    const given = this.value(frame, expr);
    if (given == undefined) {
      return undefined;
    }

    const params = [kPointerType, kIntType];
    const callee = this.ir.declare(kDecimalRoundingMode, kFlagType, params);
    const mode = frame.made.call(callee, this.textParts(frame, given));

    this.dropping(frame, given);

    return mode;
  }

  private decimalRounded(
    frame: Frame,
    call: CallExpr,
    object: IrValue,
  ): IrValue | undefined {
    const places = this.placesArgument(frame, call, 0, 0);
    const mode = this.roundingMode(frame, call, 1);
    if (places == undefined || mode == undefined) {
      return undefined;
    }

    const out = frame.made.slot(kDecimalType, "decimal.out");
    const params = [kPointerType, kIntType, kIntType, kIntType, kFlagType];
    const callee = this.ir.declare(kDecimalRound, kVoidType, params);
    const parts = this.decimalParts(frame, object);

    frame.made.call(callee, [out].concat(parts).concat([places.value, mode]));

    const value = frame.made.load(kDecimalType, out);
    const tz = this.values.types.store.plain(TypeKind.Decimal);

    this.dropping(frame, object);

    return { type: kDecimalType, value, tz, owned: true };
  }

  private decimalShown(
    frame: Frame,
    call: CallExpr,
    name: string,
    object: IrValue,
  ): IrValue | undefined {
    const count = this.placesArgument(frame, call, 0, 0);
    const mode = this.roundingMode(frame, call, 1);
    const runtime = kDecimalShowers.get(name);
    if (count == undefined || mode == undefined || runtime == undefined) {
      return undefined;
    }

    const given = this.ir.integer(kFlagType, `${count.given}`);
    const parts = this.decimalParts(frame, object);
    const args = parts.concat([count.value, given, mode]);
    const params = [kIntType, kIntType, kIntType, kFlagType, kFlagType];
    const text = this.textOut(frame, runtime, params, args);

    this.dropping(frame, object);

    return text;
  }
}
