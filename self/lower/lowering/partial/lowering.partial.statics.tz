import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import {
  IrIntPredicate,
  IrOpcode,
  IrRealPredicate,
} from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kCharCodesText,
  kCodePointsText,
  kDateNow,
  kDoubleType,
  kIntType,
  kMathAbsolute,
  kMathCeil,
  kMathFloor,
  kMathRound,
  kMathTrunc,
  kPerformanceNow,
  kPointerType,
  kStaticHolders,
} from "../const/lowering.const.tz";
import { Frame, IrValue } from "../types/lowering.types.tz";

partial class Lowering {
  private readonly isStaticHolder(frame: Read<Frame>, expr: Expr): boolean {
    if (expr.kind != ExprKind.Name || !kStaticHolders.includes(expr.name)) {
      return false;
    }

    const target = this.values.valueTargetOf(expr, frame.module);
    if (target == undefined) {
      return true;
    }

    const opened = this.values.types.program.modules[target.module];

    return opened != undefined && opened.source.isLibrary;
  }

  private staticCall(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const holder = tree.exprOf(member.objectId);
    const holderName = this.nameOf(holder);
    const key = `${holderName}.${member.name}`;

    switch (key) {
      case "Math.min":
      case "Math.max":
        return this.mathPicked(frame, call, member.name == "min");
      case "Math.abs":
        return this.mathAbsolute(frame, call);
      case "Math.trunc":
      case "Math.floor":
      case "Math.ceil":
      case "Math.round":
        return this.mathRounded(frame, call, member.name);
      case "String.fromCharCode":
        return this.charCodesText(frame, call);
      case "String.fromCodePoint":
        return this.codePointsText(frame, call);
      case "performance.now": {
        const callee = this.ir.declare(kPerformanceNow, kDoubleType, []);
        const value = frame.made.call(callee, []);
        const tz = this.values.types.store.plain(TypeKind.Double);

        return { type: kDoubleType, value, tz };
      }
      case "Date.now": {
        const callee = this.ir.declare(kDateNow, kIntType, []);
        const value = frame.made.call(callee, []);
        const tz = this.values.types.store.integer(64, false);

        return { type: kIntType, value, tz };
      }
      default:
        this.notLowered(frame.module, call.loc, `a call of ${key}`);

        return undefined;
    }
  }

  private readonly nameOf(expr: Expr): string {
    if (expr.kind != ExprKind.Name) {
      return "";
    }

    return expr.name;
  }

  private mathArguments(
    frame: Frame,
    call: CallExpr,
    type: Type,
  ): LLVMValue[] | undefined {
    const tree = this.values.types.program.tree;

    const values: LLVMValue[] = [];

    for (const argument of tree.argumentsOf(call.argsList)) {
      const expr = tree.exprOf(argument.exprId);
      const given = this.value(frame, expr);
      if (given == undefined || argument.spread) {
        this.notLowered(frame.module, call.loc, "these arguments");

        return undefined;
      }

      const inside = this.proven(frame, given);
      const value = this.converted(
        frame,
        inside,
        type,
        tree.exprOf(argument.exprId).loc,
      );
      if (value == undefined) {
        return undefined;
      }

      values.push(value.value);
    }

    return values;
  }

  private mathPicked(
    frame: Frame,
    call: CallExpr,
    isMin: boolean,
  ): IrValue | undefined {
    const result = this.typeOf(call);
    const type = this.typeOrUndefined(result);
    if (result == undefined || type == undefined) {
      return undefined;
    }

    const values = this.mathArguments(frame, call, result);
    const first = values?.[0];
    if (values == undefined || first == undefined) {
      return undefined;
    }

    let picked: LLVMValue = first;

    for (const value of values.slice(1)) {
      const isLess = this.lessTest(frame, value, picked, result);
      if (isMin) {
        picked = frame.made.select(isLess, value, picked);
      } else {
        picked = frame.made.select(isLess, picked, value);
      }
    }

    return { type, value: picked, tz: result };
  }

  private readonly lessTest(
    frame: Read<Frame>,
    left: LLVMValue,
    right: LLVMValue,
    type: Type,
  ): LLVMValue {
    if (this.isDouble(type)) {
      return frame.made.realCompare(IrRealPredicate.OrderedLess, left, right);
    }
    if (this.isUnsigned(type)) {
      return frame.made.integerCompare(
        IrIntPredicate.UnsignedLess,
        left,
        right,
      );
    }

    return frame.made.integerCompare(IrIntPredicate.SignedLess, left, right);
  }

  private mathAbsolute(frame: Frame, call: CallExpr): IrValue | undefined {
    const result = this.typeOf(call);
    const type = this.typeOrUndefined(result);
    if (result == undefined || type == undefined) {
      return undefined;
    }

    const values = this.mathArguments(frame, call, result);
    const value = values?.[0];
    if (value == undefined) {
      return undefined;
    }

    if (this.isDouble(result)) {
      const params = [kDoubleType];
      const callee = this.ir.declare(kMathAbsolute, kDoubleType, params);

      return { type, value: frame.made.call(callee, [value]), tz: result };
    }
    if (this.isUnsigned(result)) {
      return { type, value, tz: result };
    }

    const zero = this.ir.zero(type);
    const isNegative = frame.made.integerCompare(
      IrIntPredicate.SignedLess,
      value,
      zero,
    );
    const negative = frame.made.binary(IrOpcode.Sub, zero, value);
    const picked = frame.made.select(isNegative, negative, value);

    return { type, value: picked, tz: result };
  }

  private mathRounded(
    frame: Frame,
    call: CallExpr,
    name: string,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const result = this.typeOf(call);
    const argument = tree.argumentsOf(call.argsList)[0];
    const type = this.typeOrUndefined(result);
    if (result == undefined || type == undefined || argument == undefined) {
      return undefined;
    }

    const expr = tree.exprOf(argument.exprId);
    const given = this.value(frame, expr);
    if (given == undefined) {
      return undefined;
    }

    const inside = this.proven(frame, given);
    if (!this.isDouble(inside.tz)) {
      return this.converted(frame, inside, result, call.loc);
    }

    const runtime = this.roundingRuntime(name);
    const callee = this.ir.declare(runtime, kDoubleType, [kDoubleType]);
    const rounded = frame.made.call(callee, [inside.value]);
    const double = this.values.types.store.plain(TypeKind.Double);
    if (this.isDouble(result)) {
      return { type, value: rounded, tz: result };
    }

    const value: IrValue = { type: kDoubleType, value: rounded, tz: double };

    return this.integerFitted(frame, value, this.widened(result));
  }

  private readonly roundingRuntime(name: string): string {
    switch (name) {
      case "floor":
        return kMathFloor;
      case "ceil":
        return kMathCeil;
      case "round":
        return kMathRound;
      default:
        return kMathTrunc;
    }
  }

  private charCodesText(frame: Frame, call: CallExpr): IrValue | undefined {
    const int32 = this.values.types.store.integer(32, false);
    const values = this.mathArguments(frame, call, int32);
    if (values == undefined) {
      return undefined;
    }

    const count = values.length;
    const array = `[${count} x i32]`;
    const slot = frame.made.slot(array, "char.codes");

    for (let index = 0; index < count; index++) {
      const value = values[index];
      if (value != undefined) {
        frame.made.store(value, frame.made.field(array, slot, index));
      }
    }

    const size = this.ir.integer(kIntType, `${count}`);
    const params = [kPointerType, kIntType];

    return this.textOut(frame, kCharCodesText, params, [slot, size]);
  }

  private codePointsText(frame: Frame, call: CallExpr): IrValue | undefined {
    const double = this.values.types.store.plain(TypeKind.Double);
    const values = this.mathArguments(frame, call, double);
    if (values == undefined) {
      return undefined;
    }

    const count = values.length;
    const array = `[${count} x ${kDoubleType}]`;
    const slot = frame.made.slot(array, "code.points");

    for (let index = 0; index < count; index++) {
      const value = values[index];
      if (value != undefined) {
        frame.made.store(value, frame.made.field(array, slot, index));
      }
    }

    const size = this.ir.integer(kIntType, `${count}`);
    const params = [kPointerType, kIntType];

    return this.textOut(frame, kCodePointsText, params, [slot, size]);
  }
}
