import {
  CallExpr,
  Expr,
  ExprKind,
  NameExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import { IrFunction } from "../../ir-function/ir-function.tz";
import { IrOpcode } from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kFilesModule,
  kIntType,
  kPointerType,
  kStatsOrder,
} from "../const/lowering.const.tz";
import {
  ClassLayout,
  Frame,
  IrValue,
  RuntimeTarget,
} from "../types/lowering.types.tz";

partial class Lowering {
  private filesCall(
    frame: Frame,
    call: CallExpr,
    callee: NameExpr,
  ): IrValue | undefined {
    switch (callee.name) {
      case "existsSync":
        return this.fileExists(frame, call);
      case "readFileSync":
        return this.fileRead(frame, call);
      case "realpathSync":
        return this.pathRuntimeCall(frame, call, "realPath");
      case "mkdtempSync":
        return this.pathRuntimeCall(frame, call, "makeTemporary");
      case "statSync":
        return this.fileStatus(frame, call);
      case "readdirSync":
        return this.directoryRead(frame, call);
      case "rmSync":
        return this.fileRemoved(frame, call);
      case "copyFileSync":
        return this.fileCopied(frame, call);
      default:
        this.notLowered(frame.module, call.loc, "a call of this function");

        return undefined;
    }
  }

  private pathArgument(frame: Frame, call: CallExpr): IrValue | undefined {
    return this.pathArgumentAt(frame, call, 0);
  }

  private pathArgumentAt(
    frame: Frame,
    call: CallExpr,
    index: int,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const first = tree.argumentsOf(call.argsList)[index];
    if (first == undefined) {
      return undefined;
    }

    const string = this.values.types.store.plain(TypeKind.String);
    const expr = tree.exprOf(first.exprId);
    const given = this.value(frame, expr);

    return this.convertedOrNone(
      frame,
      given,
      string,
      tree.exprOf(first.exprId).loc,
    );
  }

  private fileExists(frame: Frame, call: CallExpr): IrValue | undefined {
    return this.pathRuntimeCall(frame, call, "exists");
  }

  private pathRuntimeCall(
    frame: Frame,
    call: CallExpr,
    name: string,
  ): IrValue | undefined {
    const path = this.pathArgument(frame, call);
    if (path == undefined) {
      return undefined;
    }

    const target: RuntimeTarget = { module: kFilesModule, name };
    const found = this.runtimeFunctionCall(frame, target, [], [path], call.loc);

    this.dropping(frame, path);

    return found;
  }

  private fileRead(frame: Frame, call: CallExpr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const type = this.typeOf(call);
    if (type == undefined || type.kind != TypeKind.Result) {
      this.notLowered(frame.module, call.loc, "a result of this type");

      return undefined;
    }
    if (this.isBytesType(this.values.types.store.valueOf(type))) {
      return this.fileBytesRead(frame, call);
    }

    const path = this.pathArgument(frame, call);
    if (path == undefined) {
      return undefined;
    }

    const encoding = this.encodingOf(
      frame,
      tree.exprAt(tree.argumentsOf(call.argsList)[1]?.exprId),
    );
    const wide = frame.made.cast(IrOpcode.SExt, encoding, kIntType);
    const int = this.values.types.store.integer(64, false);
    const code: IrValue = { type: kIntType, value: wide, tz: int };
    const target: RuntimeTarget = { module: kFilesModule, name: "readText" };
    const given = [path, code];
    const found = this.runtimeFunctionCall(frame, target, [], given, call.loc);

    this.dropping(frame, path);

    return found;
  }

  private fileBytesRead(frame: Frame, call: CallExpr): IrValue | undefined {
    const path = this.pathArgument(frame, call);
    if (path == undefined) {
      return undefined;
    }

    const int = this.values.types.store.integer(64, false);
    const layouts = this.bytesLayouts();
    const raw: IrValue = { type: kPointerType, value: layouts, tz: int };
    const target: RuntimeTarget = { module: kFilesModule, name: "readBytes" };
    const given = [path, raw];
    const found = this.runtimeFunctionCall(frame, target, [], given, call.loc);

    this.dropping(frame, path);

    return found;
  }

  private fileStatus(frame: Frame, call: CallExpr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const answered = this.typeOf(call);
    const path = this.pathArgument(frame, call);
    if (answered == undefined || answered.kind != TypeKind.Result) {
      this.notLowered(frame.module, call.loc, "a result of this type");

      return undefined;
    }
    if (path == undefined) {
      return undefined;
    }

    const value = this.values.types.store.valueOf(answered);
    const stats = this.definedOf(value);
    const statsMaker = this.orderMaker(stats, kStatsOrder);
    if (statsMaker == undefined || tree.argumentsOf(call.argsList).length > 1) {
      this.notLowered(frame.module, call.loc, "this call of statSync");

      return undefined;
    }

    const int = this.values.types.store.integer(64, false);
    const maker: IrValue = { type: kPointerType, value: statsMaker, tz: int };
    const target: RuntimeTarget = { module: kFilesModule, name: "status" };
    const given = [path, maker];
    const found = this.runtimeFunctionCall(frame, target, [], given, call.loc);

    this.dropping(frame, path);

    const type = this.irType(answered);
    const isSame = found != undefined && type == found.type;
    if (found == undefined || type == undefined || !isSame) {
      this.notLowered(frame.module, call.loc, "this call of statSync");

      return undefined;
    }

    return { type, value: found.value, tz: answered, owned: true };
  }

  private directoryRead(frame: Frame, call: CallExpr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    if (tree.argumentsOf(call.argsList).length > 1) {
      this.notLowered(frame.module, call.loc, "this call of readdirSync");

      return undefined;
    }

    return this.pathRuntimeCall(frame, call, "readNames");
  }

  private descriptorOrNone(type: Type | undefined): LLVMValue | undefined {
    if (type == undefined) {
      return undefined;
    }

    return this.descriptor(type);
  }

  private fileRemoved(frame: Frame, call: CallExpr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const path = this.pathArgument(frame, call);
    if (path == undefined) {
      return undefined;
    }

    const options = tree.exprAt(tree.argumentsOf(call.argsList)[1]?.exprId);
    const isRecursive = this.optionFlag(options, "recursive");
    const isForced = this.optionFlag(options, "force");
    let name = "remove";

    if (isForced) {
      name = "forceRemove";
    }

    const target: RuntimeTarget = { module: kFilesModule, name };
    const args = [path, this.booleanValue(isRecursive)];
    const found = this.runtimeFunctionCall(frame, target, [], args, call.loc);

    this.dropping(frame, path);

    return found;
  }

  private fileCopied(frame: Frame, call: CallExpr): IrValue | undefined {
    const from = this.pathArgumentAt(frame, call, 0);
    const to = this.pathArgumentAt(frame, call, 1);
    if (from == undefined || to == undefined) {
      return undefined;
    }

    const target: RuntimeTarget = { module: kFilesModule, name: "copyFile" };
    const args = [from, to];
    const found = this.runtimeFunctionCall(frame, target, [], args, call.loc);

    this.dropping(frame, from);
    this.dropping(frame, to);

    return found;
  }

  private readonly optionFlag(
    options: Expr | undefined,
    name: string,
  ): boolean {
    const tree = this.values.types.program.tree;

    if (options == undefined || options.kind != ExprKind.ObjectLit) {
      return false;
    }

    const property = tree
      .propertiesOf(options.propsList)
      .find((one) => one.name == name);
    const value = tree.exprAt(property?.valueId);

    if (value == undefined || value.kind != ExprKind.BoolLit) {
      return false;
    }

    return value.value;
  }

  private orderMaker(type: Type, order: Read<string[]>): LLVMValue | undefined {
    const key = `${type.id} ${order.join(" ")}`;
    const known = this.orderMakers.get(key);
    if (known != undefined) {
      return known;
    }

    const layout = this.layoutOf(type);
    if (layout == undefined) {
      return undefined;
    }

    const elements: string[] = [];

    for (const name of order) {
      const field = this.layoutField(layout, name);
      if (field == undefined) {
        return undefined;
      }

      elements.push(this.partIr(field.type, field.ir));
    }

    const struct = `{ ${elements.join(", ")} }`;
    const name = this.ir.uniqueName("tz.make.");
    const made = new IrFunction(this.ir, name, kPointerType, [kPointerType]);
    const frame: Frame = {
      made,
      id: this.frameId(),
      module: 0,
      loops: [],
      scopes: [],
    };
    const parts = made.param(0);
    const object = this.allocated(frame, layout);

    for (let index = 0; index < order.length; index++) {
      const field = this.layoutField(layout, order[index]);
      if (field == undefined) {
        continue;
      }

      const address = made.field(struct, parts, index);
      const value = this.partValue(frame, address, field.type, field.ir);

      made.store(value, made.field(layout.struct, object, field.index));
    }

    this.fixedFields(frame, object, layout, order);
    made.finishValue(object);
    this.orderMakers.set(key, made.callee.fn);

    return made.callee.fn;
  }

  private readonly partIr(type: Type, ir: string): string {
    if (this.textLiterals(type).length > 0) {
      return kPointerType;
    }

    return ir;
  }

  private partValue(
    frame: Read<Frame>,
    address: LLVMValue,
    type: Type,
    ir: string,
  ): LLVMValue {
    if (this.textLiterals(type).length > 0) {
      const text = frame.made.load(kPointerType, address);

      return this.codeChosen(frame, text, type);
    }

    return frame.made.load(ir, address);
  }

  private fixedFields(
    frame: Read<Frame>,
    object: LLVMValue,
    layout: Read<ClassLayout>,
    order: Read<string[]>,
  ): void {
    for (const field of this.fieldsOf(layout)) {
      const literals = this.textLiterals(field.type);
      const only = literals[0];
      if (order.includes(field.name) || literals.length != 1) {
        continue;
      }
      if (only != undefined) {
        const address = frame.made.field(layout.struct, object, field.index);

        frame.made.store(this.stringValue(only).value, address);
      }
    }
  }
}
