import {
  CallExpr,
  Expr,
  ExprKind,
  NameExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import { IrFunction } from "../../ir-function/ir-function.tz";
import {
  IrIntPredicate,
  IrOpcode,
} from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kFlagType,
  kFsCompose,
  kFsErrorOrders,
  kFsReadFileBytes,
  kFsStat,
  kFilesModule,
  kFsVerbs,
  kIntType,
  kPointerType,
  kReadFlag,
  kStatsOrder,
  kTextCompareC,
  kVoidType,
} from "../const/lowering.const.tz";
import {
  ClassLayout,
  FileCallParts,
  Frame,
  IrValue,
  RuntimeTarget,
} from "../types/lowering.types.tz";

partial class Lowering {
  private filesCall(
    frame: Frame,
    call: CallExpr,
    callee: NameExpr,
  ): IrValue | undefined {
    switch (callee.name) {
      case "existsSync":
        return this.fileExists(frame, call);
      case "readFileSync":
        return this.fileRead(frame, call);
      case "realpathSync":
        return this.pathRuntimeCall(frame, call, "realPath");
      case "mkdtempSync":
        return this.pathRuntimeCall(frame, call, "makeTemporary");
      case "statSync":
        return this.fileStatus(frame, call);
      case "readdirSync":
        return this.directoryRead(frame, call);
      case "rmSync":
        return this.fileRemoved(frame, call);
      case "copyFileSync":
        return this.fileCopied(frame, call);
      default:
        this.notLowered(frame.module, call.loc, "a call of this function");

        return undefined;
    }
  }

  private pathArgument(frame: Frame, call: CallExpr): IrValue | undefined {
    return this.pathArgumentAt(frame, call, 0);
  }

  private pathArgumentAt(
    frame: Frame,
    call: CallExpr,
    index: int,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const first = tree.argumentsOf(call.argsList)[index];
    if (first == undefined) {
      return undefined;
    }

    const string = this.values.types.store.plain(TypeKind.String);
    const expr = tree.exprOf(first.exprId);
    const given = this.value(frame, expr);

    return this.convertedOrNone(
      frame,
      given,
      string,
      tree.exprOf(first.exprId).loc,
    );
  }

  private fileExists(frame: Frame, call: CallExpr): IrValue | undefined {
    return this.pathRuntimeCall(frame, call, "exists");
  }

  private pathRuntimeCall(
    frame: Frame,
    call: CallExpr,
    name: string,
  ): IrValue | undefined {
    const path = this.pathArgument(frame, call);
    if (path == undefined) {
      return undefined;
    }

    const target: RuntimeTarget = { module: kFilesModule, name };
    const found = this.runtimeFunctionCall(frame, target, [], [path], call.loc);

    this.dropping(frame, path);

    return found;
  }

  private fileResultParts(
    frame: Read<Frame>,
    call: CallExpr,
  ): FileCallParts | undefined {
    const type = this.typeOf(call);
    if (type == undefined || type.kind != TypeKind.Result) {
      this.notLowered(frame.module, call.loc, "a result of this type");

      return undefined;
    }

    const maker = this.fsErrorMaker(this.values.types.store.errorOf(type));
    if (maker == undefined) {
      this.notLowered(frame.module, call.loc, "an error of this type");

      return undefined;
    }

    return { type, value: this.values.types.store.valueOf(type), maker };
  }

  private fileRead(frame: Frame, call: CallExpr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const type = this.typeOf(call);
    if (type == undefined || type.kind != TypeKind.Result) {
      this.notLowered(frame.module, call.loc, "a result of this type");

      return undefined;
    }
    if (this.isBytesType(this.values.types.store.valueOf(type))) {
      return this.fileBytesRead(frame, call);
    }

    const path = this.pathArgument(frame, call);
    if (path == undefined) {
      return undefined;
    }

    const encoding = this.encodingOf(
      frame,
      tree.exprAt(tree.argumentsOf(call.argsList)[1]?.exprId),
    );
    const wide = frame.made.cast(IrOpcode.SExt, encoding, kIntType);
    const int = this.values.types.store.integer(64, false);
    const code: IrValue = { type: kIntType, value: wide, tz: int };
    const target: RuntimeTarget = { module: kFilesModule, name: "readText" };
    const given = [path, code];
    const found = this.runtimeFunctionCall(frame, target, [], given, call.loc);

    this.dropping(frame, path);

    return found;
  }

  private fileBytesRead(frame: Frame, call: CallExpr): IrValue | undefined {
    const parts = this.fileResultParts(frame, call);
    const path = this.pathArgument(frame, call);
    if (parts == undefined || path == undefined) {
      return undefined;
    }

    const flag = this.stringValue(kReadFlag);
    const args = this.textParts(frame, path).concat(
      this.textParts(frame, flag),
    );
    const params = [kPointerType, kIntType, kPointerType, kIntType];
    const all = params.concat([kPointerType]);
    const callee = this.ir.declare(kFsReadFileBytes, kPointerType, all);
    const read = frame.made.call(callee, args.concat([parts.maker]));
    const value: IrValue = {
      type: kPointerType,
      value: read,
      tz: parts.value,
      owned: true,
    };

    this.dropping(frame, path);

    return this.caughtResult(frame, value, parts.type, call.loc);
  }

  private fileStatus(frame: Frame, call: CallExpr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const parts = this.fileResultParts(frame, call);
    const path = this.pathArgument(frame, call);
    if (parts == undefined || path == undefined) {
      return undefined;
    }

    const stats = this.definedOf(parts.value);
    const statsMaker = this.orderMaker(stats, kStatsOrder);
    if (statsMaker == undefined || tree.argumentsOf(call.argsList).length > 1) {
      this.notLowered(frame.module, call.loc, "this call of statSync");

      return undefined;
    }

    const params = [
      kPointerType,
      kIntType,
      kFlagType,
      kFlagType,
      kPointerType,
      kPointerType,
    ];
    const callee = this.ir.declare(kFsStat, kPointerType, params);
    const yes = this.ir.integer(kFlagType, "1");
    const args = this.textParts(frame, path).concat([
      yes,
      yes,
      statsMaker,
      parts.maker,
    ]);
    const found = frame.made.call(callee, args);
    const value: IrValue = {
      type: kPointerType,
      value: found,
      tz: stats,
      owned: true,
    };

    this.dropping(frame, path);

    return this.caughtResult(frame, value, parts.type, call.loc);
  }

  private directoryRead(frame: Frame, call: CallExpr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    if (tree.argumentsOf(call.argsList).length > 1) {
      this.notLowered(frame.module, call.loc, "this call of readdirSync");

      return undefined;
    }

    return this.pathRuntimeCall(frame, call, "readNames");
  }

  private descriptorOrNone(type: Type | undefined): LLVMValue | undefined {
    if (type == undefined) {
      return undefined;
    }

    return this.descriptor(type);
  }

  private fileRemoved(frame: Frame, call: CallExpr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const path = this.pathArgument(frame, call);
    if (path == undefined) {
      return undefined;
    }

    const options = tree.exprAt(tree.argumentsOf(call.argsList)[1]?.exprId);
    const isRecursive = this.optionFlag(options, "recursive");
    const isForced = this.optionFlag(options, "force");
    let name = "remove";

    if (isForced) {
      name = "forceRemove";
    }

    const target: RuntimeTarget = { module: kFilesModule, name };
    const args = [path, this.booleanValue(isRecursive)];
    const found = this.runtimeFunctionCall(frame, target, [], args, call.loc);

    this.dropping(frame, path);

    return found;
  }

  private fileCopied(frame: Frame, call: CallExpr): IrValue | undefined {
    const from = this.pathArgumentAt(frame, call, 0);
    const to = this.pathArgumentAt(frame, call, 1);
    if (from == undefined || to == undefined) {
      return undefined;
    }

    const target: RuntimeTarget = { module: kFilesModule, name: "copyFile" };
    const args = [from, to];
    const found = this.runtimeFunctionCall(frame, target, [], args, call.loc);

    this.dropping(frame, from);
    this.dropping(frame, to);

    return found;
  }

  private readonly optionFlag(
    options: Expr | undefined,
    name: string,
  ): boolean {
    const tree = this.values.types.program.tree;

    if (options == undefined || options.kind != ExprKind.ObjectLit) {
      return false;
    }

    const property = tree
      .propertiesOf(options.propsList)
      .find((one) => one.name == name);
    const value = tree.exprAt(property?.valueId);

    if (value == undefined || value.kind != ExprKind.BoolLit) {
      return false;
    }

    return value.value;
  }

  private fsErrorMaker(error: Type): LLVMValue | undefined {
    const known = this.makers.get(error.id);
    if (known != undefined) {
      return known;
    }

    const variants = this.objectParts(error);
    const makers: LLVMValue[] = [];

    for (const variant of variants) {
      const order = this.errorOrder(variant);
      const maker = this.orderMakerOrNone(variant, order);
      if (maker == undefined) {
        return undefined;
      }

      makers.push(maker);
    }

    const label = this.values.types.store.labelOf(error) ?? "";
    const verb = kFsVerbs.get(label) ?? "";
    const name = this.ir.uniqueName("tz.make.fs.");
    const made = new IrFunction(this.ir, name, kPointerType, [kPointerType]);
    const parts = made.param(0);
    const code = made.load(kPointerType, parts);
    const chosen = this.variantChosen(made, code, variants);
    const compose = this.ir.declare(kFsCompose, kVoidType, [
      kPointerType,
      kPointerType,
      kFlagType,
    ]);
    const none = this.ir.integer(kFlagType, "-1");
    const isKnown = made.integerCompare(IrIntPredicate.NotEqual, chosen, none);
    const knownFlag = made.cast(IrOpcode.ZExt, isKnown, kFlagType);
    const unknown = this.unknownVariant(variants);
    const fallback = this.ir.integer(kFlagType, `${unknown}`);
    const index = made.select(isKnown, chosen, fallback);

    made.call(compose, [parts, this.cText(verb), knownFlag]);

    const result = this.ir.zero(kPointerType);

    for (let position = 0; position < makers.length; position++) {
      const maker = makers[position];
      if (maker == undefined) {
        continue;
      }

      const wanted = this.ir.integer(kFlagType, `${position}`);
      const isThis = made.integerCompare(IrIntPredicate.Equal, index, wanted);
      const signature = this.ir.signature(kPointerType, [kPointerType]);
      const thisBlock = made.block("variant.make");
      const nextBlock = made.block("variant.next");

      made.conditionalBranch(isThis, thisBlock, nextBlock);
      made.open(thisBlock);
      made.returned(made.indirectCall(signature, maker, [parts]));
      made.open(nextBlock);
    }

    made.finishValue(result);
    this.makers.set(error.id, made.callee.fn);

    return made.callee.fn;
  }

  private variantChosen(
    made: IrFunction,
    code: LLVMValue,
    variants: Read<Type[]>,
  ): LLVMValue {
    const compare = this.ir.declare(kTextCompareC, kFlagType, [
      kPointerType,
      kPointerType,
    ]);
    const zero = this.ir.zero(kFlagType);
    let index: LLVMValue = this.ir.integer(kFlagType, "-1");

    for (let position = 0; position < variants.length; position++) {
      const codes = this.variantCodes(variants[position]);

      for (const literal of codes) {
        const order = made.call(compare, [code, this.cText(literal)]);
        const isSame = made.integerCompare(IrIntPredicate.Equal, order, zero);
        const value = this.ir.integer(kFlagType, `${position}`);

        index = made.select(isSame, value, index);
      }
    }

    return index;
  }

  private readonly variantCodes(variant: Type | undefined): string[] {
    if (variant == undefined || variant.kind != TypeKind.Object) {
      return [];
    }

    const field = this.values.types.store
      .fieldsOf(variant)
      .find((one) => one.name == "code");
    if (field == undefined) {
      return [];
    }

    return this.textLiterals(field.type);
  }

  private readonly unknownVariant(variants: Read<Type[]>): int {
    for (let position = 0; position < variants.length; position++) {
      if (this.variantCodes(variants[position]).includes("UNKNOWN")) {
        return position;
      }
    }

    return 0;
  }

  private readonly errorOrder(variant: Type): string[] {
    if (variant.kind != TypeKind.Object) {
      return [];
    }

    const fields = this.values.types.store.fieldsOf(variant).slice();

    for (const order of kFsErrorOrders) {
      const isPresent = order.every((name) =>
        fields.some((field) => field.name == name),
      );
      const isCovered = fields.every(
        (field) =>
          order.includes(field.name) ||
          this.textLiterals(field.type).length == 1,
      );
      if (isPresent && isCovered) {
        return order.slice();
      }
    }

    return [];
  }

  private orderMakerOrNone(
    type: Type,
    order: Read<string[]>,
  ): LLVMValue | undefined {
    if (order.length == 0) {
      return undefined;
    }

    return this.orderMaker(type, order);
  }

  private orderMaker(type: Type, order: Read<string[]>): LLVMValue | undefined {
    const key = `${type.id} ${order.join(" ")}`;
    const known = this.orderMakers.get(key);
    if (known != undefined) {
      return known;
    }

    const layout = this.layoutOf(type);
    if (layout == undefined) {
      return undefined;
    }

    const elements: string[] = [];

    for (const name of order) {
      const field = this.layoutField(layout, name);
      if (field == undefined) {
        return undefined;
      }

      elements.push(this.partIr(field.type, field.ir));
    }

    const struct = `{ ${elements.join(", ")} }`;
    const name = this.ir.uniqueName("tz.make.");
    const made = new IrFunction(this.ir, name, kPointerType, [kPointerType]);
    const frame: Frame = {
      made,
      id: this.frameId(),
      module: 0,
      loops: [],
      scopes: [],
    };
    const parts = made.param(0);
    const object = this.allocated(frame, layout);

    for (let index = 0; index < order.length; index++) {
      const field = this.layoutField(layout, order[index]);
      if (field == undefined) {
        continue;
      }

      const address = made.field(struct, parts, index);
      const value = this.partValue(frame, address, field.type, field.ir);

      made.store(value, made.field(layout.struct, object, field.index));
    }

    this.fixedFields(frame, object, layout, order);
    made.finishValue(object);
    this.orderMakers.set(key, made.callee.fn);

    return made.callee.fn;
  }

  private readonly partIr(type: Type, ir: string): string {
    if (this.textLiterals(type).length > 0) {
      return kPointerType;
    }

    return ir;
  }

  private partValue(
    frame: Read<Frame>,
    address: LLVMValue,
    type: Type,
    ir: string,
  ): LLVMValue {
    if (this.textLiterals(type).length > 0) {
      const text = frame.made.load(kPointerType, address);

      return this.codeChosen(frame, text, type);
    }

    return frame.made.load(ir, address);
  }

  private fixedFields(
    frame: Read<Frame>,
    object: LLVMValue,
    layout: Read<ClassLayout>,
    order: Read<string[]>,
  ): void {
    for (const field of this.fieldsOf(layout)) {
      const literals = this.textLiterals(field.type);
      const only = literals[0];
      if (order.includes(field.name) || literals.length != 1) {
        continue;
      }
      if (only != undefined) {
        const address = frame.made.field(layout.struct, object, field.index);

        frame.made.store(this.stringValue(only).value, address);
      }
    }
  }
}
