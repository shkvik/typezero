import {
  CallArgument,
  CallExpr,
  Expr,
  MemberExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import { IrOpcode } from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kArrayAppend,
  kArrayLengthField,
  kArraySplice,
  kArrayUnshift,
  kFlagType,
  kIntType,
  kPointerType,
  kVoidType,
} from "../const/lowering.const.tz";
import { Frame, IrValue, Place } from "../types/lowering.types.tz";

partial class Lowering {
  private insertedItems(
    frame: Frame,
    args: Read<CallArgument[]>,
    item: Type,
  ): IrValue[] | undefined {
    const items: IrValue[] = [];

    for (const argument of args) {
      if (argument.spread) {
        this.notLowered(frame.module, argument.expr.loc, "a spread argument");

        return undefined;
      }

      const given = this.wantedValue(frame, argument.expr, item);
      if (given == undefined) {
        return undefined;
      }

      const loc = argument.expr.loc;
      const value = this.converted(frame, given, item, loc);
      if (value == undefined) {
        return undefined;
      }

      items.push(this.owning(frame, value));
    }

    return items;
  }

  private readonly itemsPlaced(
    frame: Read<Frame>,
    slots: LLVMValue,
    items: Read<IrValue[]>,
    element: string,
  ): void {
    for (let index = 0; index < items.length; index++) {
      const item = items[index];
      if (item == undefined) {
        continue;
      }

      const position = this.ir.integer(kIntType, `${index}`);
      const address = frame.made.element(element, slots, position);

      frame.made.store(item.value, address);
    }
  }

  private splicedArray(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
    object: Type,
  ): IrValue | undefined {
    if (object.kind != TypeKind.Array) {
      return undefined;
    }

    const element = this.irType(object.item);
    const array = this.value(frame, member.object);
    const start = this.integerArgument(frame, call, 0);
    const count = this.integerArgument(frame, call, 1);
    if (element == undefined || array == undefined) {
      return undefined;
    }
    if (start == undefined || count == undefined) {
      return undefined;
    }

    const items = this.insertedItems(frame, call.args.slice(2), object.item);
    if (items == undefined) {
      return undefined;
    }

    const slots = frame.made.slot(kPointerType, "splice.slots");
    const params = [
      kPointerType,
      kIntType,
      kIntType,
      kFlagType,
      kIntType,
      kPointerType,
    ];
    const splicing = this.ir.declare(kArraySplice, kPointerType, params);
    const hasCount = this.ir.integer(kFlagType, `${count.given}`);
    const inserted = this.ir.integer(kIntType, `${items.length}`);
    const removed = frame.made.call(splicing, [
      array.value,
      start.value,
      count.value,
      hasCount,
      inserted,
      slots,
    ]);
    const data = frame.made.load(kPointerType, slots);

    this.itemsPlaced(frame, data, items, element);
    this.dropping(frame, array);

    return { type: kPointerType, value: removed, tz: object, owned: true };
  }

  private unshiftedArray(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
    object: Type,
  ): IrValue | undefined {
    if (object.kind != TypeKind.Array) {
      return undefined;
    }

    const element = this.irType(object.item);
    const array = this.value(frame, member.object);
    if (element == undefined || array == undefined) {
      return undefined;
    }

    const items = this.insertedItems(frame, call.args, object.item);
    if (items == undefined) {
      return undefined;
    }

    const params = [kPointerType, kIntType];
    const opening = this.ir.declare(kArrayUnshift, kPointerType, params);
    const count = this.ir.integer(kIntType, `${items.length}`);
    const data = frame.made.call(opening, [array.value, count]);

    this.itemsPlaced(frame, data, items, element);

    const lengthField = this.arrayField(frame, array.value, kArrayLengthField);
    const length = frame.made.load(kFlagType, lengthField);
    const value = frame.made.cast(IrOpcode.ZExt, length, kIntType);
    const tz = this.store.integer(64, false);

    this.dropping(frame, array);

    return { type: kIntType, value, tz };
  }

  private flatPushed(
    frame: Frame,
    place: Place,
    returned: IrValue,
    callback: Expr,
  ): boolean {
    const part = this.converted(frame, returned, place.tz, callback.loc);
    if (part == undefined) {
      return false;
    }

    const array = frame.made.load(kPointerType, place.pointer);
    const params = [kPointerType, kPointerType];
    const appending = this.ir.declare(kArrayAppend, kVoidType, params);

    frame.made.call(appending, [array, part.value]);
    this.dropping(frame, part);

    return true;
  }
}
