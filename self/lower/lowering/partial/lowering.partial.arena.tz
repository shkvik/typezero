import {
  ArrayLitExpr,
  Expr,
  ExprKind,
  MemberExpr,
  NewExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import { IrFunction } from "../../ir-function/ir-function.tz";
import {
  IrCallee,
  IrIntPredicate,
  IrOpcode,
} from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kArrayForget,
  kFreshArrayMethods,
  kImmortalCount,
  kImmortalFloor,
  kImmortalName,
  kIntType,
  kNoOwner,
  kObjectForget,
  kPointerType,
  kRuntimeModule,
  kThisName,
  kVoidType,
} from "../const/lowering.const.tz";
import { Frame, IrValue, LayoutField, Place } from "../types/lowering.types.tz";

partial class Lowering {
  private isImmortalKind(type: Type): boolean {
    const inner = this.optionalInner(type) ?? type;
    if (this.isString(inner) || !this.isManaged(inner)) {
      return false;
    }
    if (this.isInPlace(inner)) {
      return false;
    }
    if (this.isArray(inner)) {
      return true;
    }

    return (
      this.isObjectLike(inner) &&
      inner.kind != TypeKind.Union &&
      this.layoutOf(inner) != undefined
    );
  }

  private staticValue(value: Read<IrValue>): IrValue {
    const isStatic = this.isImmortalKind(value.tz);
    if (!isStatic) {
      return {
        type: value.type,
        value: value.value,
        tz: value.tz,
        owned: value.owned,
      };
    }

    return {
      type: value.type,
      value: value.value,
      tz: value.tz,
      isStatic: true,
    };
  }

  private retyped(value: Read<IrValue>, type: string, tz: Type): IrValue {
    const isStatic = value.isStatic == true;

    return {
      type,
      value: value.value,
      tz,
      owned: value.owned,
      ownedFlag: value.ownedFlag,
      isStatic,
    };
  }

  private madeLiteral(frame: Frame, expr: ArrayLitExpr): IrValue | undefined {
    return this.arrayLiteral(frame, expr);
  }

  private madeObject(frame: Frame, expr: NewExpr): IrValue | undefined {
    return this.newValue(frame, expr);
  }

  private isStaticUnionField(
    object: Read<IrValue>,
    result: Type,
    expr: MemberExpr,
  ): boolean {
    const type = object.tz;
    if (type.kind != TypeKind.Union || !this.isStaticSource(object)) {
      return false;
    }
    return this.isImmortalKind(result);
  }

  private keptOrStatic(
    frame: Read<Frame>,
    value: IrValue,
    isStatic: boolean,
  ): IrValue {
    if (isStatic) {
      return value;
    }

    return this.owning(frame, value);
  }

  private isTakenItem(
    source: Read<IrValue>,
    iterable: Expr,
    element: string,
    item: Type,
  ): boolean {
    const isFresh = source.owned == true && this.isFreshArray(iterable);

    return isFresh && element == kPointerType && this.isManaged(item);
  }

  private isFreshArray(expr: Expr): boolean {
    const tree = this.values.types.program.tree;

    if (expr.kind == ExprKind.ArrayLit) {
      return true;
    }
    if (expr.kind != ExprKind.Call) {
      return false;
    }

    const callee = tree.exprOf(expr.calleeId);
    if (callee.kind != ExprKind.Member) {
      return false;
    }

    const object = tree.exprOf(callee.objectId);
    const receiver = this.typeOf(object);
    const isArray = receiver != undefined && receiver.kind == TypeKind.Array;

    return isArray && kFreshArrayMethods.includes(callee.name);
  }

  private staticOrSame(value: IrValue, isStatic: boolean): IrValue {
    if (!isStatic) {
      return value;
    }

    return this.staticValue(value);
  }

  private readonly isStaticSource(object: Read<IrValue>): boolean {
    return object.isStatic == true;
  }

  private isStaticField(object: Read<IrValue>, expr: MemberExpr): boolean {
    const tree = this.values.types.program.tree;

    const holder = tree.exprOf(expr.objectId);
    const isThis = holder.kind == ExprKind.Name && holder.name == kThisName;

    return this.isStaticSource(object) && !isThis;
  }

  private deepImmortalCallee(type: Type): IrCallee | undefined {
    const given = this.optionalInner(type) ?? type;
    const inner = this.immortalShape(given);
    if (!this.isImmortalKind(inner)) {
      return this.unionImmortalCallee(inner);
    }

    const name = `${kImmortalName}.${inner.id}`;
    const known = this.ir.callee(name);
    if (known != undefined) {
      return known;
    }

    const made = new IrFunction(this.ir, name, kVoidType, [kPointerType]);
    const frame: Frame = {
      made,
      id: this.frameId(),
      module: 0,
      loops: [],
      scopes: [],
    };
    const object = made.param(0);
    const check = made.block("check");
    const work = made.block("work");
    const done = made.block("done");
    const none = this.ir.zero(kPointerType);
    const isObject = made.integerCompare(IrIntPredicate.NotEqual, object, none);

    made.conditionalBranch(isObject, check, done);
    made.open(check);

    const count = made.load(kIntType, object);
    const floor = this.ir.integer(kIntType, kImmortalFloor);
    const isImmortal = made.integerCompare(
      IrIntPredicate.SignedLess,
      floor,
      count,
    );

    made.conditionalBranch(isImmortal, done, work);
    made.open(work);
    made.store(this.ir.integer(kIntType, kImmortalCount), object);
    made.call(this.forgetCallee(inner), []);
    this.immortalChildren(frame, object, inner);
    made.branch(done);
    made.open(done);
    made.finishVoid();

    return made.callee;
  }

  private immortalShape(type: Type): Type {
    if (!this.isTzMap(type)) {
      return type;
    }

    return this.mapInstance(type) ?? type;
  }

  private forgetCallee(type: Type): IrCallee {
    let name = kObjectForget;

    if (this.isArray(type)) {
      name = kArrayForget;
    }

    const callee = this.runtimeHelperName(kRuntimeModule, name, name);

    return this.ir.declare(callee, kVoidType, []);
  }

  private isImmortalGlobal(place: Read<Place>, key: string): boolean {
    const isGlobal = place.owner == kNoOwner && !this.letKeys.has(key);
    const isChanged = this.changedGlobals.has(key);
    const isKept = isGlobal && !isChanged && this.isImmortalKind(place.tz);

    return isKept && this.immortalGlobals.has(key);
  }

  private immortalGlobal(frame: Read<Frame>, place: Place, key: string): void {
    if (!this.isImmortalGlobal(place, key)) {
      return;
    }

    const kept = this.loaded(frame, place);

    this.immortalized(frame, kept);
    this.immortalGlobals.add(key);
  }

  private immortalChildren(frame: Frame, object: LLVMValue, type: Type): void {
    if (this.isArray(type) && type.kind == TypeKind.Array) {
      return this.immortalItems(
        frame,
        object,
        this.values.types.store.itemOf(type),
      );
    }

    const layout = this.layoutOf(type);
    if (layout == undefined) {
      return;
    }

    for (const field of this.fieldsOf(layout)) {
      this.immortalField(frame, object, type, layout.struct, field);
    }
  }

  private immortalField(
    frame: Frame,
    object: LLVMValue,
    owner: Type,
    struct: string,
    field: Read<LayoutField>,
  ): void {
    const isPointer = field.ir == kPointerType;
    if (!isPointer) {
      return this.immortalRecord(frame, object, struct, field);
    }

    const callee = this.deepImmortalCallee(field.type);
    if (callee == undefined) {
      return;
    }

    const address = frame.made.field(struct, object, field.index);
    const value = frame.made.load(kPointerType, address);

    frame.made.call(callee, [value]);
  }

  private immortalRecord(
    frame: Frame,
    object: LLVMValue,
    struct: string,
    field: Read<LayoutField>,
  ): void {
    const record = this.optionalInner(field.type) ?? field.type;
    if (!this.isInPlace(record)) {
      return;
    }

    const layout = this.layoutOf(record);
    if (layout == undefined) {
      return;
    }

    const address = frame.made.field(struct, object, field.index);

    for (const inner of this.fieldsOf(layout)) {
      this.immortalField(frame, address, record, layout.struct, inner);
    }
  }

  private immortalItems(frame: Frame, array: LLVMValue, item: Type): void {
    const isPointer = this.irType(item) == kPointerType;
    if (!isPointer) {
      return;
    }

    const callee = this.deepImmortalCallee(item);
    if (callee == undefined) {
      return;
    }

    const made = frame.made;
    const data = this.arrayData(frame, array);
    const length = this.arrayLength(frame, array);
    const counter = made.slot(kIntType, "immortal.index");
    const cond = made.block("immortal.cond");
    const body = made.block("immortal.body");
    const end = made.block("immortal.end");

    made.store(this.ir.zero(kIntType), counter);
    made.branch(cond);
    made.open(cond);

    const index = made.load(kIntType, counter);
    const isInside = made.integerCompare(
      IrIntPredicate.SignedLess,
      index,
      length,
    );

    made.conditionalBranch(isInside, body, end);
    made.open(body);

    const address = made.element(kPointerType, data, index);
    const element = made.load(kPointerType, address);
    const one = this.ir.integer(kIntType, "1");
    const next = made.binary(IrOpcode.Add, index, one);

    made.call(callee, [element]);
    made.store(next, counter);
    made.branch(cond);
    made.open(end);
  }

  private immortalized(frame: Read<Frame>, value: IrValue): void {
    const inner = this.optionalInner(value.tz);
    if (inner != undefined) {
      const inside = this.insideValue(frame, value, inner);

      return this.immortalized(frame, inside);
    }
    if (value.type != kPointerType) {
      return;
    }

    const deep = this.deepImmortalCallee(value.tz);
    if (deep != undefined) {
      frame.made.call(deep, [value.value]);

      return;
    }

    const helper = this.immortalHelper();

    frame.made.call(helper, [value.value]);
  }

  private immortalHelper(): IrCallee {
    const known = this.ir.callee(kImmortalName);
    if (known != undefined) {
      return known;
    }

    const made = new IrFunction(this.ir, kImmortalName, kVoidType, [
      kPointerType,
    ]);
    const object = made.param(0);
    const kept = made.block("kept");
    const done = made.block("done");
    const none = this.ir.zero(kPointerType);
    const isObject = made.integerCompare(IrIntPredicate.NotEqual, object, none);

    made.conditionalBranch(isObject, kept, done);
    made.open(kept);
    made.store(this.ir.integer(kIntType, kImmortalCount), object);
    made.open(done);
    made.finishVoid();

    return made.callee;
  }
}
