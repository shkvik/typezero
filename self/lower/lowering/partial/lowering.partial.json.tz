import { CallExpr } from "../../../program/ast/types/ast.types.expressions.tz";
import { TypeKind } from "../../../program/type/types/type.types.tz";
import { IrOpcode } from "../../ir-function/types/ir-function.types.tz";
import { Lowering } from "../lowering.tz";
import {
  kDoubleType,
  kIntType,
  kPointerType,
  kValuesModule,
} from "../const/lowering.const.tz";
import { Frame, IrValue, RuntimeTarget } from "../types/lowering.types.tz";

partial class Lowering {
  private jsonStringified(frame: Frame, call: CallExpr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const first = tree.argumentsOf(call.argsList)[0];
    if (first == undefined) {
      this.notLowered(frame.module, call.loc, "this call of JSON.stringify");

      return undefined;
    }

    const value = this.value(frame, tree.exprOf(first.exprId));
    if (value == undefined) {
      return undefined;
    }

    const descriptor = this.descriptor(value.tz);
    if (descriptor == undefined) {
      this.notLowered(frame.module, call.loc, "JSON of a value of this type");

      return undefined;
    }

    const spill = frame.made.slot(value.type, "json.value");
    const int = this.values.types.store.integer(64, false);
    const space = this.jsonSpace(frame, call);
    if (space == undefined) {
      return undefined;
    }

    frame.made.store(value.value, spill);

    const zero = this.ir.zero(kIntType);
    const kind = space[0] ?? { type: kIntType, value: zero, tz: int };
    const double = this.values.types.store.plain(TypeKind.Double);
    const empty = this.ir.zero(kDoubleType);
    const number = space[1] ?? { type: kDoubleType, value: empty, tz: double };
    const gap = space[2] ?? this.stringValue("");
    const given: IrValue[] = [
      { type: kPointerType, value: descriptor, tz: int },
      { type: kPointerType, value: spill, tz: int },
      kind,
      number,
      gap,
    ];
    const name = "jsonText";
    const target: RuntimeTarget = { module: kValuesModule, name };
    const text = this.runtimeFunctionCall(frame, target, [], given, call.loc);

    this.dropping(frame, value);
    this.dropping(frame, gap);

    return text;
  }

  private jsonSpace(frame: Frame, call: CallExpr): IrValue[] | undefined {
    const tree = this.values.types.program.tree;

    const int = this.values.types.store.integer(64, false);
    const double = this.values.types.store.plain(TypeKind.Double);
    const argument = tree.argumentsOf(call.argsList)[2];
    const zero = this.ir.zero(kDoubleType);
    const none: IrValue[] = [
      { type: kIntType, value: this.ir.zero(kIntType), tz: int },
      { type: kDoubleType, value: zero, tz: double },
      this.stringValue(""),
    ];
    if (argument == undefined) {
      return none;
    }

    const given = this.value(frame, tree.exprOf(argument.exprId));
    if (given == undefined) {
      return undefined;
    }
    if (this.isString(given.tz)) {
      return [
        { type: kIntType, value: this.ir.integer(kIntType, "2"), tz: int },
        { type: kDoubleType, value: zero, tz: double },
        given,
      ];
    }

    let number = given.value;

    if (this.isInteger(given.tz)) {
      const long = this.toLong(frame, given);

      number = frame.made.cast(IrOpcode.SIToFP, long.value, kDoubleType);
    } else if (!this.isDouble(given.tz)) {
      this.notLowered(frame.module, call.loc, "this space of JSON.stringify");

      return undefined;
    }

    return [
      { type: kIntType, value: this.ir.integer(kIntType, "1"), tz: int },
      { type: kDoubleType, value: number, tz: double },
      this.stringValue(""),
    ];
  }
}
