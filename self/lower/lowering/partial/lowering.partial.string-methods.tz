import {
  CallExpr,
  MemberExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { TypeKind } from "../../../program/type/types/type.types.tz";
import {
  IrIntPredicate,
  IrOpcode,
} from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kBooleanType,
  kFlagType,
  kIntType,
  kPointerType,
  kStringType,
  kCStringFromText,
  kTextCharCode,
  kTextCodePoint,
  kTextEndsWith,
  kTextIncludes,
  kTextIndexOf,
  kTextLastIndexOf,
  kTextLower,
  kTextModule,
  kTextPad,
  kTextRepeat,
  kTextReplace,
  kTextSlice,
  kTextSplit,
  kTextStartsWith,
  kTextSubstring,
  kTextTrim,
  kTextUpper,
  kVoidType,
} from "../const/lowering.const.tz";
import {
  Frame,
  IrValue,
  RuntimeTarget,
  TextArguments,
} from "../types/lowering.types.tz";

partial class Lowering {
  private stringMethod(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const object = tree.exprOf(member.objectId);
    const receiver = this.value(frame, object);
    const given = this.textArguments(frame, call);
    if (receiver == undefined || given == undefined) {
      return undefined;
    }

    const result = this.stringMethodValue(frame, call, member, receiver, given);

    this.dropping(frame, receiver);

    for (const text of given.texts) {
      this.dropping(frame, text);
    }

    return result;
  }

  private textArguments(
    frame: Frame,
    call: CallExpr,
  ): TextArguments | undefined {
    const tree = this.values.types.program.tree;

    const texts: IrValue[] = [];
    const numbers: LLVMValue[] = [];
    const int = this.values.types.store.integer(64, false);

    for (const argument of tree.argumentsOf(call.argsList)) {
      const expr = tree.exprOf(argument.exprId);
      const given = this.value(frame, expr);
      if (given == undefined || argument.spread) {
        return undefined;
      }
      if (this.isString(given.tz)) {
        texts.push(given);

        continue;
      }

      const number = this.converted(
        frame,
        given,
        int,
        tree.exprOf(argument.exprId).loc,
      );
      if (number == undefined) {
        return undefined;
      }

      numbers.push(number.value);
    }

    return { texts, numbers };
  }

  private stringMethodValue(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
    receiver: IrValue,
    given: Read<TextArguments>,
  ): IrValue | undefined {
    const name = member.name;

    switch (name) {
      case "toString":
        return this.owning(frame, receiver);
      case "toCString":
        return this.cstringOf(frame, call, receiver);
      case "slice":
      case "substring":
        return this.textSlice(frame, name, receiver, given);
      case "lastIndexOf":
        return this.textSearch(frame, name, receiver, given);
      case "indexOf":
      case "includes":
      case "startsWith":
      case "endsWith":
        return this.textFound(frame, call, name, receiver, given);
      case "toLowerCase":
      case "toUpperCase":
        return this.textCase(frame, name, receiver);
      case "trim":
      case "trimStart":
      case "trimEnd":
        return this.textTrim(frame, name, receiver);
      case "charCodeAt":
      case "codePointAt":
        return this.textCode(frame, call, name, receiver, given);
      case "charAt":
        return this.textCharAt(frame, receiver, given);
      case "at":
        return this.textAt(frame, call, receiver, given);
      case "split":
        return this.textSplit(frame, receiver, given);
      case "replace":
      case "replaceAll":
        return this.textReplace(frame, call, name, receiver, given);
      case "repeat":
        return this.textRepeat(frame, receiver, given);
      case "padStart":
      case "padEnd":
        return this.textPad(frame, name, receiver, given);
      default: {
        const called = this.calledName(call);

        this.notLowered(frame.module, call.loc, `a call of method ${called}`);

        return undefined;
      }
    }
  }

  private cstringOf(
    frame: Read<Frame>,
    call: CallExpr,
    receiver: IrValue,
  ): IrValue | undefined {
    const result = this.typeOf(call);
    if (result == undefined) {
      return undefined;
    }

    const params = [kPointerType, kIntType];
    const callee = this.ir.declare(kCStringFromText, kPointerType, params);
    const value = frame.made.call(callee, this.textParts(frame, receiver));

    return { type: kPointerType, value, tz: result, owned: true };
  }

  private readonly textParts(frame: Read<Frame>, text: IrValue): LLVMValue[] {
    return [
      frame.made.extract(text.value, 0),
      frame.made.extract(text.value, 1),
    ];
  }

  private numberAt(given: Read<TextArguments>, index: int): LLVMValue {
    return given.numbers[index] ?? this.ir.zero(kIntType);
  }

  private flagAt(given: Read<TextArguments>, index: int): LLVMValue {
    const isGiven = index < given.numbers.length;

    return this.ir.integer(kFlagType, `${this.flagIf(isGiven, 1)}`);
  }

  private textOut(
    frame: Read<Frame>,
    name: string,
    params: Own<string[]>,
    args: Own<LLVMValue[]>,
  ): IrValue {
    const out = frame.made.slot(kStringType, "text.out");
    const all = [kPointerType].concat(params);
    const callee = this.ir.declare(name, kVoidType, all);

    frame.made.call(callee, [out].concat(args));

    const value = frame.made.load(kStringType, out);
    const tz = this.values.types.store.plain(TypeKind.String);

    return { type: kStringType, value, tz, owned: true };
  }

  private textSlice(
    frame: Read<Frame>,
    name: string,
    receiver: IrValue,
    given: Read<TextArguments>,
  ): IrValue {
    const isSlice = name == "slice";
    const runtime = this.pick(isSlice, kTextSlice, kTextSubstring);
    const args = this.textParts(frame, receiver).concat([
      this.numberAt(given, 0),
      this.numberAt(given, 1),
      this.flagAt(given, 1),
    ]);
    const params = [kPointerType, kIntType, kIntType, kIntType, kFlagType];

    return this.textOut(frame, runtime, params, args);
  }

  private textSearch(
    frame: Read<Frame>,
    name: string,
    receiver: IrValue,
    given: Read<TextArguments>,
  ): IrValue | undefined {
    const search = given.texts[0];
    if (search == undefined) {
      return undefined;
    }

    const runtime = this.searchRuntime(name);
    const params = [
      kPointerType,
      kIntType,
      kPointerType,
      kIntType,
      kIntType,
      kFlagType,
    ];
    const callee = this.ir.declare(runtime, kFlagType, params);
    const args = this.textParts(frame, receiver)
      .concat(this.textParts(frame, search))
      .concat([this.numberAt(given, 0), this.flagAt(given, 0)]);
    const found = frame.made.call(callee, args);
    if (name == "indexOf" || name == "lastIndexOf") {
      const value = frame.made.cast(IrOpcode.SExt, found, kIntType);
      const tz = this.values.types.store.integer(64, false);

      return { type: kIntType, value, tz };
    }

    const zero = this.ir.zero(kFlagType);
    const value = frame.made.integerCompare(
      IrIntPredicate.NotEqual,
      found,
      zero,
    );
    const tz = this.values.types.store.plain(TypeKind.Boolean);

    return { type: kBooleanType, value, tz };
  }

  private textFound(
    frame: Read<Frame>,
    call: CallExpr,
    name: string,
    receiver: IrValue,
    given: Read<TextArguments>,
  ): IrValue | undefined {
    const search = given.texts[0];
    if (search == undefined) {
      return undefined;
    }

    const zero = this.ir.zero(kFlagType);
    const flag = this.flagAt(given, 0);
    const number = this.numberAt(given, 0);
    const has = frame.made.integerCompare(IrIntPredicate.NotEqual, flag, zero);
    const position: IrValue = {
      type: kIntType,
      value: number,
      tz: this.values.types.store.integer(64, false),
    };
    const hasPosition: IrValue = {
      type: kBooleanType,
      value: has,
      tz: this.values.types.store.plain(TypeKind.Boolean),
    };
    const target: RuntimeTarget = { module: kTextModule, name };
    const args = [receiver, search, position, hasPosition];

    return this.runtimeFunctionCall(frame, target, [], args, call.loc);
  }

  private readonly searchRuntime(name: string): string {
    switch (name) {
      case "indexOf":
        return kTextIndexOf;
      case "lastIndexOf":
        return kTextLastIndexOf;
      case "includes":
        return kTextIncludes;
      case "startsWith":
        return kTextStartsWith;
      default:
        return kTextEndsWith;
    }
  }

  private textCase(
    frame: Read<Frame>,
    name: string,
    receiver: IrValue,
  ): IrValue {
    const isUpper = name == "toUpperCase";
    const runtime = this.pick(isUpper, kTextUpper, kTextLower);
    const args = this.textParts(frame, receiver);

    return this.textOut(frame, runtime, [kPointerType, kIntType], args);
  }

  private textTrim(
    frame: Read<Frame>,
    name: string,
    receiver: IrValue,
  ): IrValue {
    const ends = this.trimEnds(name);
    const args = this.textParts(frame, receiver).concat([
      this.ir.integer(kFlagType, `${ends}`),
    ]);
    const params = [kPointerType, kIntType, kFlagType];

    return this.textOut(frame, kTextTrim, params, args);
  }

  private readonly trimEnds(name: string): int {
    switch (name) {
      case "trimStart":
        return 1;
      case "trimEnd":
        return 2;
      default:
        return 3;
    }
  }

  private textCode(
    frame: Read<Frame>,
    call: CallExpr,
    name: string,
    receiver: IrValue,
    given: Read<TextArguments>,
  ): IrValue | undefined {
    const result = this.typeOf(call);
    const resultIr = this.typeOrUndefined(result);
    if (result == undefined || resultIr == undefined) {
      this.notLowered(frame.module, call.loc, "a result of this type");

      return undefined;
    }

    const position = this.numberAt(given, 0);
    const int = this.values.types.store.integer(64, false);
    const isCode = name == "charCodeAt";
    const runtime = this.pick(isCode, kTextCharCode, kTextCodePoint);
    const callee = this.ir.declare(runtime, kFlagType, [
      kPointerType,
      kIntType,
      kIntType,
    ]);
    if (this.optionalInner(result) == undefined) {
      const args = this.textParts(frame, receiver).concat([position]);
      const code = frame.made.cast(
        IrOpcode.SExt,
        frame.made.call(callee, args),
        kIntType,
      );

      return { type: kIntType, value: code, tz: int };
    }

    const length = this.textLength(frame, receiver);
    const isInside = frame.made.integerCompare(
      IrIntPredicate.UnsignedLess,
      position,
      length,
    );
    const before = frame.made.currentBlock();
    const read = frame.made.block("code.read");
    const end = frame.made.block("code.end");

    frame.made.conditionalBranch(isInside, read, end);
    frame.made.open(read);

    const args = this.textParts(frame, receiver).concat([position]);
    const code = frame.made.cast(
      IrOpcode.SExt,
      frame.made.call(callee, args),
      kIntType,
    );
    const found: IrValue = { type: kIntType, value: code, tz: int };
    const placed = this.somewhere(frame, found, result);
    const readEnd = frame.made.currentBlock();

    frame.made.branch(end);
    frame.made.open(end);

    const missing = this.ir.zero(resultIr);
    const value = frame.made.phi(
      resultIr,
      [missing, placed.value],
      [before, readEnd],
    );

    return { type: resultIr, value, tz: result };
  }

  private textSplit(
    frame: Read<Frame>,
    receiver: IrValue,
    given: Read<TextArguments>,
  ): IrValue | undefined {
    const string = this.values.types.store.plain(TypeKind.String);
    const descriptor = this.descriptor(string);
    if (descriptor == undefined) {
      return undefined;
    }

    const separator = given.texts[0];
    const hasSeparator = this.flagIf(separator != undefined, 1);
    const parts = this.separatorParts(frame, separator);
    const params = [
      kPointerType,
      kPointerType,
      kIntType,
      kPointerType,
      kIntType,
      kFlagType,
      kIntType,
      kFlagType,
    ];
    const callee = this.ir.declare(kTextSplit, kPointerType, params);
    const args = [descriptor]
      .concat(this.textParts(frame, receiver))
      .concat(parts)
      .concat([
        this.ir.integer(kFlagType, `${hasSeparator}`),
        this.numberAt(given, 0),
        this.flagAt(given, 0),
      ]);
    const value = frame.made.call(callee, args);
    const tz = this.values.types.store.arrayOf(string);

    return { type: kPointerType, value, tz, owned: true };
  }

  private separatorParts(
    frame: Read<Frame>,
    separator: IrValue | undefined,
  ): LLVMValue[] {
    if (separator == undefined) {
      return [this.ir.zero(kPointerType), this.ir.zero(kIntType)];
    }

    return this.textParts(frame, separator);
  }

  private textReplace(
    frame: Read<Frame>,
    call: CallExpr,
    name: string,
    receiver: IrValue,
    given: Read<TextArguments>,
  ): IrValue | undefined {
    const pattern = given.texts[0];
    const replacement = given.texts[1];
    if (pattern == undefined || replacement == undefined) {
      this.notLowered(frame.module, call.loc, "a replacement of this kind");

      return undefined;
    }

    const isAll = this.flagIf(name == "replaceAll", 1);
    const args = this.textParts(frame, receiver)
      .concat(this.textParts(frame, pattern))
      .concat(this.textParts(frame, replacement))
      .concat([this.ir.integer(kFlagType, `${isAll}`)]);
    const params = [
      kPointerType,
      kIntType,
      kPointerType,
      kIntType,
      kPointerType,
      kIntType,
      kFlagType,
    ];

    return this.textOut(frame, kTextReplace, params, args);
  }

  private textRepeat(
    frame: Read<Frame>,
    receiver: IrValue,
    given: Read<TextArguments>,
  ): IrValue {
    const args = this.textParts(frame, receiver).concat([
      this.numberAt(given, 0),
    ]);
    const params = [kPointerType, kIntType, kIntType];

    return this.textOut(frame, kTextRepeat, params, args);
  }

  private textPad(
    frame: Read<Frame>,
    name: string,
    receiver: IrValue,
    given: Read<TextArguments>,
  ): IrValue {
    const fill = given.texts[0];
    const hasFill = this.flagIf(fill != undefined, 1);
    const atStart = this.flagIf(name == "padStart", 1);
    const args = this.textParts(frame, receiver)
      .concat([this.numberAt(given, 0)])
      .concat(this.separatorParts(frame, fill))
      .concat([
        this.ir.integer(kFlagType, `${hasFill}`),
        this.ir.integer(kFlagType, `${atStart}`),
      ]);
    const params = [
      kPointerType,
      kIntType,
      kIntType,
      kPointerType,
      kIntType,
      kFlagType,
      kFlagType,
    ];

    return this.textOut(frame, kTextPad, params, args);
  }
}
