import {
  CallExpr,
  MemberExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { TypeKind } from "../../../program/type/types/type.types.tz";
import {
  IrIntPredicate,
  IrOpcode,
} from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kBooleanType,
  kFlagType,
  kIntType,
  kPadFill,
  kPointerType,
  kStringType,
  kBuffersModule,
  kCStringFromText,
  kCStringMade,
  kTextModule,
  kVoidType,
} from "../const/lowering.const.tz";
import {
  Frame,
  IrValue,
  RuntimeTarget,
  TextArguments,
} from "../types/lowering.types.tz";

partial class Lowering {
  private stringMethod(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const object = tree.exprOf(member.objectId);
    const receiver = this.value(frame, object);
    const given = this.textArguments(frame, call);
    if (receiver == undefined || given == undefined) {
      return undefined;
    }

    const result = this.stringMethodValue(frame, call, member, receiver, given);

    this.dropping(frame, receiver);

    for (const text of given.texts) {
      this.dropping(frame, text);
    }

    return result;
  }

  private textArguments(
    frame: Frame,
    call: CallExpr,
  ): TextArguments | undefined {
    const tree = this.values.types.program.tree;

    const texts: IrValue[] = [];
    const numbers: LLVMValue[] = [];
    const int = this.values.types.store.integer(64, false);

    for (const argument of tree.argumentsOf(call.argsList)) {
      const expr = tree.exprOf(argument.exprId);
      const given = this.value(frame, expr);
      if (given == undefined || argument.spread) {
        return undefined;
      }
      if (this.isString(given.tz)) {
        texts.push(given);

        continue;
      }

      const number = this.converted(
        frame,
        given,
        int,
        tree.exprOf(argument.exprId).loc,
      );
      if (number == undefined) {
        return undefined;
      }

      numbers.push(number.value);
    }

    return { texts, numbers };
  }

  private stringMethodValue(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
    receiver: IrValue,
    given: Read<TextArguments>,
  ): IrValue | undefined {
    const name = member.name;

    switch (name) {
      case "toString":
        return this.owning(frame, receiver);
      case "toCString":
        return this.cstringOf(frame, call, receiver);
      case "slice":
      case "substring":
        return this.textSlice(frame, call, name, receiver, given);
      case "lastIndexOf":
      case "indexOf":
      case "includes":
      case "startsWith":
      case "endsWith":
        return this.textFound(frame, call, name, receiver, given);
      case "toLowerCase":
      case "toUpperCase":
        return this.textCase(frame, call, name, receiver);
      case "trim":
      case "trimStart":
      case "trimEnd":
        return this.textTrim(frame, call, name, receiver);
      case "charCodeAt":
      case "codePointAt":
        return this.textCode(frame, call, name, receiver, given);
      case "charAt":
        return this.textCharAt(frame, call, receiver, given);
      case "at":
        return this.textAt(frame, call, receiver, given);
      case "split":
        return this.textSplit(frame, call, receiver, given);
      case "replace":
      case "replaceAll":
        return this.textReplace(frame, call, name, receiver, given);
      case "repeat":
        return this.textRepeat(frame, call, receiver, given);
      case "padStart":
      case "padEnd":
        return this.textPad(frame, call, name, receiver, given);
      default: {
        const called = this.calledName(call);

        this.notLowered(frame.module, call.loc, `a call of method ${called}`);

        return undefined;
      }
    }
  }

  private cstringOf(
    frame: Read<Frame>,
    call: CallExpr,
    receiver: IrValue,
  ): IrValue | undefined {
    const result = this.typeOf(call);
    if (result == undefined) {
      return undefined;
    }

    const name = this.runtimeHelperName(
      kBuffersModule,
      kCStringMade,
      kCStringFromText,
    );
    const value = this.cstringMadeOf(frame, name, receiver);

    return { type: kPointerType, value, tz: result, owned: true };
  }

  private cstringMadeOf(
    frame: Read<Frame>,
    name: string,
    receiver: IrValue,
  ): LLVMValue {
    if (name == kCStringFromText) {
      const params = [kPointerType, kIntType];
      const callee = this.ir.declare(name, kPointerType, params);

      return frame.made.call(callee, this.textParts(frame, receiver));
    }

    const layout = this.cstringLayout();
    const params = [kStringType, kPointerType];
    const callee = this.ir.declare(name, kPointerType, params);

    return frame.made.call(callee, [receiver.value, layout]);
  }

  private readonly textParts(frame: Read<Frame>, text: IrValue): LLVMValue[] {
    return [
      frame.made.extract(text.value, 0),
      frame.made.extract(text.value, 1),
    ];
  }

  private numberAt(given: Read<TextArguments>, index: int): LLVMValue {
    return given.numbers[index] ?? this.ir.zero(kIntType);
  }

  private flagAt(given: Read<TextArguments>, index: int): LLVMValue {
    const isGiven = index < given.numbers.length;

    return this.ir.integer(kFlagType, `${this.flagIf(isGiven, 1)}`);
  }

  private textOut(
    frame: Read<Frame>,
    name: string,
    params: Own<string[]>,
    args: Own<LLVMValue[]>,
  ): IrValue {
    const out = frame.made.slot(kStringType, "text.out");
    const all = [kPointerType].concat(params);
    const callee = this.ir.declare(name, kVoidType, all);

    frame.made.call(callee, [out].concat(args));

    const value = frame.made.load(kStringType, out);
    const tz = this.values.types.store.plain(TypeKind.String);

    return { type: kStringType, value, tz, owned: true };
  }

  private textSlice(
    frame: Read<Frame>,
    call: CallExpr,
    name: string,
    receiver: IrValue,
    given: Read<TextArguments>,
  ): IrValue | undefined {
    const zero = this.ir.zero(kFlagType);
    const flag = this.flagAt(given, 1);
    const has = frame.made.integerCompare(IrIntPredicate.NotEqual, flag, zero);
    const first = this.numberAt(given, 0);
    const second = this.numberAt(given, 1);
    const int = this.values.types.store.integer(64, false);
    const truth = this.values.types.store.plain(TypeKind.Boolean);
    const start: IrValue = { type: kIntType, value: first, tz: int };
    const end: IrValue = { type: kIntType, value: second, tz: int };
    const hasEnd: IrValue = { type: kBooleanType, value: has, tz: truth };
    const target: RuntimeTarget = { module: kTextModule, name };
    const args = [receiver, start, end, hasEnd];

    return this.runtimeFunctionCall(frame, target, [], args, call.loc);
  }

  private textFound(
    frame: Read<Frame>,
    call: CallExpr,
    name: string,
    receiver: IrValue,
    given: Read<TextArguments>,
  ): IrValue | undefined {
    const search = given.texts[0];
    if (search == undefined) {
      return undefined;
    }

    const zero = this.ir.zero(kFlagType);
    const flag = this.flagAt(given, 0);
    const number = this.numberAt(given, 0);
    const has = frame.made.integerCompare(IrIntPredicate.NotEqual, flag, zero);
    const position: IrValue = {
      type: kIntType,
      value: number,
      tz: this.values.types.store.integer(64, false),
    };
    const hasPosition: IrValue = {
      type: kBooleanType,
      value: has,
      tz: this.values.types.store.plain(TypeKind.Boolean),
    };
    const target: RuntimeTarget = { module: kTextModule, name };
    const args = [receiver, search, position, hasPosition];

    return this.runtimeFunctionCall(frame, target, [], args, call.loc);
  }

  private textCase(
    frame: Read<Frame>,
    call: CallExpr,
    name: string,
    receiver: IrValue,
  ): IrValue | undefined {
    const target: RuntimeTarget = { module: kTextModule, name };

    return this.runtimeFunctionCall(frame, target, [], [receiver], call.loc);
  }

  private textTrim(
    frame: Read<Frame>,
    call: CallExpr,
    name: string,
    receiver: IrValue,
  ): IrValue | undefined {
    const target: RuntimeTarget = { module: kTextModule, name };

    return this.runtimeFunctionCall(frame, target, [], [receiver], call.loc);
  }

  private textCode(
    frame: Read<Frame>,
    call: CallExpr,
    name: string,
    receiver: IrValue,
    given: Read<TextArguments>,
  ): IrValue | undefined {
    const result = this.typeOf(call);
    const resultIr = this.typeOrUndefined(result);
    if (result == undefined || resultIr == undefined) {
      this.notLowered(frame.module, call.loc, "a result of this type");

      return undefined;
    }

    const position = this.numberAt(given, 0);
    const int = this.values.types.store.integer(64, false);
    const at: IrValue = { type: kIntType, value: position, tz: int };
    const target: RuntimeTarget = { module: kTextModule, name };
    if (this.optionalInner(result) == undefined) {
      return this.runtimeFunctionCall(
        frame,
        target,
        [],
        [receiver, at],
        call.loc,
      );
    }

    const length = this.textLength(frame, receiver);
    const isInside = frame.made.integerCompare(
      IrIntPredicate.UnsignedLess,
      position,
      length,
    );
    const before = frame.made.currentBlock();
    const read = frame.made.block("code.read");
    const end = frame.made.block("code.end");

    frame.made.conditionalBranch(isInside, read, end);
    frame.made.open(read);

    const found = this.runtimeFunctionCall(
      frame,
      target,
      [],
      [receiver, at],
      call.loc,
    );
    if (found == undefined) {
      return undefined;
    }

    const placed = this.somewhere(frame, found, result);
    const readEnd = frame.made.currentBlock();

    frame.made.branch(end);
    frame.made.open(end);

    const missing = this.ir.zero(resultIr);
    const value = frame.made.phi(
      resultIr,
      [missing, placed.value],
      [before, readEnd],
    );

    return { type: resultIr, value, tz: result };
  }

  private textSplit(
    frame: Read<Frame>,
    call: CallExpr,
    receiver: IrValue,
    given: Read<TextArguments>,
  ): IrValue | undefined {
    const separator = given.texts[0];
    const hasSeparator = separator != undefined;
    const zero = this.ir.zero(kFlagType);
    const flag = this.flagAt(given, 0);
    const has = frame.made.integerCompare(IrIntPredicate.NotEqual, flag, zero);
    const limit = this.numberAt(given, 0);
    const isGiven = this.flagIf(hasSeparator, 1);
    const marked = this.ir.integer(kBooleanType, `${isGiven}`);
    const int = this.values.types.store.integer(64, false);
    const truth = this.values.types.store.plain(TypeKind.Boolean);
    const cut = separator ?? this.stringValue("");
    const isCut: IrValue = { type: kBooleanType, value: marked, tz: truth };
    const most: IrValue = { type: kIntType, value: limit, tz: int };
    const isMost: IrValue = { type: kBooleanType, value: has, tz: truth };
    const target: RuntimeTarget = { module: kTextModule, name: "split" };
    const args = [receiver, cut, isCut, most, isMost];

    return this.runtimeFunctionCall(frame, target, [], args, call.loc);
  }

  private separatorParts(
    frame: Read<Frame>,
    separator: IrValue | undefined,
  ): LLVMValue[] {
    if (separator == undefined) {
      return [this.ir.zero(kPointerType), this.ir.zero(kIntType)];
    }

    return this.textParts(frame, separator);
  }

  private textReplace(
    frame: Read<Frame>,
    call: CallExpr,
    name: string,
    receiver: IrValue,
    given: Read<TextArguments>,
  ): IrValue | undefined {
    const pattern = given.texts[0];
    const replacement = given.texts[1];
    const isAll = name == "replaceAll";
    if (pattern == undefined || replacement == undefined || !isAll) {
      this.notLowered(frame.module, call.loc, "a replacement of this kind");

      return undefined;
    }

    const target: RuntimeTarget = { module: kTextModule, name };
    const args = [receiver, pattern, replacement];

    return this.runtimeFunctionCall(frame, target, [], args, call.loc);
  }

  private textRepeat(
    frame: Read<Frame>,
    call: CallExpr,
    receiver: IrValue,
    given: Read<TextArguments>,
  ): IrValue | undefined {
    const count: IrValue = {
      type: kIntType,
      value: this.numberAt(given, 0),
      tz: this.values.types.store.integer(64, false),
    };
    const target: RuntimeTarget = { module: kTextModule, name: "repeat" };

    return this.runtimeFunctionCall(
      frame,
      target,
      [],
      [receiver, count],
      call.loc,
    );
  }

  private textPad(
    frame: Read<Frame>,
    call: CallExpr,
    name: string,
    receiver: IrValue,
    given: Read<TextArguments>,
  ): IrValue | undefined {
    const length: IrValue = {
      type: kIntType,
      value: this.numberAt(given, 0),
      tz: this.values.types.store.integer(64, false),
    };
    const fill = given.texts[0] ?? this.stringValue(kPadFill);
    const target: RuntimeTarget = { module: kTextModule, name };
    const args = [receiver, length, fill];

    return this.runtimeFunctionCall(frame, target, [], args, call.loc);
  }
}
