import {
  BinaryOp,
  Expr,
  ExprKind,
  MemberExpr,
  TemplateExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import { IrOpcode } from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kFalse,
  kIntType,
  kLengthMask,
  kNumberPartDouble,
  kNumberPartInt,
  kPointerType,
  kStringType,
  kTrue,
  kUndefinedText,
  kTextModule,
} from "../const/lowering.const.tz";
import { Frame, IrValue, RuntimeTarget } from "../types/lowering.types.tz";

partial class Lowering {
  private concatenated(
    frame: Frame,
    given: Read<IrValue[]>,
    exprs: Read<Expr[]>,
  ): IrValue | undefined {
    const leaves: Expr[] = [];

    for (const expr of exprs) {
      this.concatLeaves(expr, leaves);
    }

    const parts = given.slice();

    for (const leaf of leaves) {
      const part = this.concatPart(frame, leaf);
      if (part == undefined) {
        return undefined;
      }

      parts.push(part);
    }

    return this.joined(frame, parts);
  }

  private concatLeaves(expr: Expr, leaves: Expr[]): void {
    const tree = this.values.types.program.tree;

    const type = this.typeOf(expr);
    const isText = type == undefined || this.isString(type);
    if (expr.kind != ExprKind.Binary || expr.op != BinaryOp.Add || !isText) {
      leaves.push(expr);

      return;
    }

    const lhs = tree.exprOf(expr.lhsId);

    this.concatLeaves(lhs, leaves);
    const rhs = tree.exprOf(expr.rhsId);

    this.concatLeaves(rhs, leaves);
  }

  private concatPart(frame: Frame, expr: Expr): IrValue | undefined {
    const given = this.value(frame, expr);
    if (given == undefined) {
      return undefined;
    }

    const inner = this.optionalInner(given.tz);
    if (inner == undefined) {
      return this.textPart(frame, given, expr.loc);
    }

    return this.optionalTextPart(frame, given, inner, expr.loc);
  }

  private optionalTextPart(
    frame: Frame,
    given: IrValue,
    inner: Type,
    loc: int,
  ): IrValue | undefined {
    const has = this.hasValue(frame, given);
    const present = frame.made.block("text.present");
    const absent = frame.made.block("text.absent");
    const end = frame.made.block("text.end");

    frame.made.conditionalBranch(has, present, absent);
    frame.made.open(present);

    const inside = this.insideValue(frame, given, inner);
    const part = this.textPart(frame, inside, loc);
    if (part == undefined) {
      return undefined;
    }

    const presentEnd = frame.made.currentBlock();

    frame.made.branch(end);
    frame.made.open(absent);

    const none = this.stringValue(kUndefinedText);

    frame.made.branch(end);
    frame.made.open(end);

    const value = frame.made.phi(
      kStringType,
      [part.value, none.value],
      [presentEnd, absent],
    );

    return { type: kStringType, value, tz: part.tz, owned: part.owned };
  }

  private textPart(
    frame: Frame,
    value: IrValue,
    loc: int,
  ): IrValue | undefined {
    if (this.isString(value.tz)) {
      return value;
    }
    if (this.isBoolean(value.tz)) {
      const yes = this.stringValue(kTrue);
      const no = this.stringValue(kFalse);
      const made = frame.made.select(value.value, yes.value, no.value);

      return { type: kStringType, value: made, tz: yes.tz };
    }

    if (this.isDecimal(value.tz)) {
      return this.decimalText(frame, value);
    }

    const isWideUnsigned =
      this.isUnsigned(value.tz) && this.bitsOf(value.tz) == 64;
    if (isWideUnsigned) {
      const name = "fromUnsigned";
      const target: RuntimeTarget = { module: kTextModule, name };

      return this.runtimeFunctionCall(frame, target, [], [value], loc);
    }
    if (this.isInteger(value.tz)) {
      const long = this.toLong(frame, value);

      return this.numberPart(frame, long.value, kNumberPartInt);
    }
    if (this.isDouble(value.tz)) {
      const bits = frame.made.cast(IrOpcode.BitCast, value.value, kIntType);

      return this.numberPart(frame, bits, kNumberPartDouble);
    }

    this.notLowered(frame.module, loc, "this value in a text");

    return undefined;
  }

  private numberPart(
    frame: Read<Frame>,
    bits: LLVMValue,
    meta: string,
  ): IrValue {
    const tz = this.values.types.store.plain(TypeKind.Unknown);
    const pointer = frame.made.cast(IrOpcode.IntToPtr, bits, kPointerType);
    const empty = this.ir.undefinedOf(kStringType);
    const first = frame.made.insert(empty, pointer, 0);
    const mark = this.ir.hexInteger(kIntType, meta);
    const value = frame.made.insert(first, mark, 1);

    return { type: kStringType, value, tz };
  }

  private joined(frame: Read<Frame>, parts: Read<IrValue[]>): IrValue {
    const count = parts.length;
    if (count == 0) {
      return this.stringValue("");
    }

    const first = parts[0];
    const second = parts[1];
    if (count == 2 && first != undefined && second != undefined) {
      if (this.isString(first.tz) && this.isString(second.tz)) {
        return this.pairJoined(frame, first, second);
      }
    }

    const array = `[${count} x ${kStringType}]`;
    const slot = frame.made.slot(array, "concat.parts");

    for (let index = 0; index < count; index++) {
      const part = parts[index];
      if (part == undefined) {
        continue;
      }

      const at = frame.made.field(array, slot, index);

      frame.made.store(part.value, at);
    }

    const unknown = this.values.types.store.plain(TypeKind.Unknown);
    const int = this.values.types.store.integer(64, false);
    const size = this.ir.integer(kIntType, `${count}`);
    const cells: IrValue = { type: kPointerType, value: slot, tz: unknown };
    const total: IrValue = { type: kIntType, value: size, tz: int };
    const target: RuntimeTarget = { module: kTextModule, name: "concatParts" };
    const loc = this.statementLoc;
    const args = [cells, total];
    const found = this.runtimeFunctionCall(frame, target, [], args, loc);

    for (const part of parts) {
      this.dropping(frame, part);
    }

    return found ?? this.stringValue("");
  }

  private pairJoined(
    frame: Read<Frame>,
    first: IrValue,
    second: IrValue,
  ): IrValue {
    const target: RuntimeTarget = { module: kTextModule, name: "concatPair" };
    const loc = this.statementLoc;
    const args = [first, second];
    const found = this.runtimeFunctionCall(frame, target, [], args, loc);

    this.dropping(frame, first);
    this.dropping(frame, second);

    return found ?? this.stringValue("");
  }

  private templateValue(frame: Frame, expr: TemplateExpr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const parts: IrValue[] = [];
    const only = tree.exprsOf(expr.exprsList)[0];
    const isAlone =
      tree.exprsOf(expr.exprsList).length == 1 &&
      tree.textsOf(expr.quasisList).every((quasi) => quasi.length == 0);
    if (only != undefined && isAlone) {
      return this.aloneValue(frame, only);
    }

    for (let index = 0; index < tree.textsOf(expr.quasisList).length; index++) {
      const quasi = tree.textsOf(expr.quasisList)[index] ?? "";
      const inner = tree.exprsOf(expr.exprsList)[index];

      if (quasi.length > 0) {
        parts.push(this.stringValue(quasi));
      }
      if (inner == undefined) {
        continue;
      }

      const part = this.concatPart(frame, inner);
      if (part == undefined) {
        return undefined;
      }

      parts.push(part);
    }

    const first = parts[0];
    if (parts.length == 1 && first != undefined && this.isString(first.tz)) {
      return first;
    }

    return this.joined(frame, parts);
  }

  private aloneValue(frame: Frame, expr: Expr): IrValue | undefined {
    const part = this.concatPart(frame, expr);
    if (part == undefined || this.isString(part.tz)) {
      return part;
    }

    return this.joined(frame, [part]);
  }

  private isOptionalObject(type: Type): boolean {
    const defined = this.optionalInner(type);

    return defined != undefined && this.isObjectLike(defined);
  }

  private memberValue(frame: Frame, expr: MemberExpr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const fixed = this.values.staticFieldOf(expr, frame.module);
    if (fixed != undefined) {
      return this.staticFieldValue(frame, expr, fixed);
    }

    const exprObject = tree.exprOf(expr.objectId);
    if (this.isProcessName(frame, exprObject)) {
      return this.processMember(frame, expr);
    }

    const objectExpr = tree.exprOf(expr.objectId);
    const object = this.typeIn(frame, objectExpr);
    if (this.isJsonish(object)) {
      return this.jsonMember(frame, expr);
    }

    const isArray = object != undefined && this.isArray(object);
    if (isArray && expr.name == "length") {
      return this.arrayMember(frame, expr);
    }
    if (object != undefined && this.isBytesType(object)) {
      return this.bytesMember(frame, expr);
    }
    if (object != undefined && this.isObjectLike(object)) {
      return this.fieldValue(frame, expr);
    }
    if (object != undefined && this.isOptionalObject(object)) {
      return this.fieldValue(frame, expr);
    }
    if (object != undefined && object.kind == TypeKind.Dict) {
      return this.dictSize(frame, expr);
    }
    if (object != undefined && object.kind == TypeKind.Result) {
      return this.resultMember(frame, expr);
    }
    if (object != undefined && object.kind == TypeKind.Int) {
      return this.wrappedValue(frame, expr, object);
    }

    const isLength =
      expr.name == "length" && object != undefined && this.isString(object);
    if (!isLength) {
      const kind = this.kindName(object);

      this.notLowered(frame.module, expr.loc, `a member of type ${kind}`);

      return undefined;
    }

    const text = this.value(frame, tree.exprOf(expr.objectId));
    if (text == undefined) {
      return undefined;
    }

    const meta = frame.made.extract(text.value, 1);
    const mask = this.ir.hexInteger(kIntType, kLengthMask);
    const length = frame.made.binary(IrOpcode.And, meta, mask);
    const tz = this.values.types.store.integer(64, false);

    this.dropping(frame, text);

    return { type: kIntType, value: length, tz };
  }
}
