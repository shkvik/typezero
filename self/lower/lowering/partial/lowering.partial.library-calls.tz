import {
  AssignExpr,
  CallExpr,
  Expr,
  ExprKind,
  NameExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import { IrIntPredicate } from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kBooleanType,
  kChildModule,
  kFlagType,
  kIntType,
  kPathBasename,
  kPathDirname,
  kPathExtname,
  kPathIsAbsolute,
  kFsModule,
  kMemModule,
  kUnsafeModule,
  kInspectModule,
  kVoidType,
  kCharType,
  kReplaceName,
  kSwapName,
  kTakeName,
  kDropName,
  kStructuredCloneName,
  kStringName,
  kBooleanName,
  kArrayCopy,
  kNumberName,
  kOsModule,
  kOsText,
  kOsTexts,
  kParseIntName,
  kPathJoin,
  kPathModule,
  kPathNormalize,
  kPathRelative,
  kPathResolve,
  kPathStyle,
  kPointerType,
} from "../const/lowering.const.tz";
import { Frame, IrValue } from "../types/lowering.types.tz";

partial class Lowering {
  private memCall(
    frame: Frame,
    call: CallExpr,
    callee: NameExpr,
  ): IrValue | undefined {
    const first = call.args[0];
    const second = call.args[1];
    if (first != undefined && callee.name == kTakeName) {
      return this.memTaken(frame, first.expr);
    }
    if (first != undefined && callee.name == kDropName) {
      return this.memDropped(frame, first.expr);
    }
    if (first == undefined || second == undefined) {
      this.notLowered(frame.module, call.loc, "this call");

      return undefined;
    }
    if (callee.name == kReplaceName) {
      return this.memReplaced(frame, call.loc, first.expr, second.expr);
    }
    if (callee.name == kSwapName) {
      return this.memSwapped(frame, call.loc, first.expr, second.expr);
    }

    this.notLowered(frame.module, call.loc, "a call of this function");

    return undefined;
  }

  private memReplaced(
    frame: Frame,
    loc: int,
    place: Expr,
    value: Expr,
  ): IrValue | undefined {
    const current = this.value(frame, place);
    if (current == undefined) {
      return undefined;
    }

    const handed = this.handedOver(frame, place, current, value);
    if (handed != undefined) {
      return handed;
    }

    const old = this.owning(frame, current);
    const assignment: AssignExpr = {
      kind: ExprKind.Assign,
      loc,
      target: place,
      value,
    };

    this.assigned(frame, assignment);

    return old;
  }

  private handedOver(
    frame: Frame,
    place: Expr,
    current: IrValue,
    value: Expr,
  ): IrValue | undefined {
    const isPlace = place.kind == ExprKind.Name || place.kind == ExprKind.Member;
    if (!isPlace || current.owned == true || !this.isManaged(current.tz)) {
      return undefined;
    }

    const target = this.targetPlace(frame, place);
    if (target == undefined || target.flag != undefined) {
      return undefined;
    }

    const given = this.value(frame, value);
    if (given == undefined) {
      return undefined;
    }

    const converted = this.converted(frame, given, target.tz, value.loc);
    if (converted == undefined) {
      return undefined;
    }

    const owned = this.owning(frame, converted);

    frame.made.store(owned.value, target.pointer);

    return {
      type: current.type,
      value: current.value,
      tz: current.tz,
      owned: true,
    };
  }

  private stringCalled(frame: Frame, call: CallExpr): IrValue | undefined {
    const argument = call.args[0];
    if (argument == undefined) {
      return this.stringValue("");
    }

    return this.aloneValue(frame, argument.expr);
  }

  private booleanCalled(frame: Frame, call: CallExpr): IrValue | undefined {
    const argument = call.args[0];
    if (argument == undefined) {
      return this.booleanValue(false);
    }

    const test = this.truth(frame, argument.expr);
    if (test == undefined) {
      return undefined;
    }

    const tz = this.store.plain(TypeKind.Boolean);

    return { type: kBooleanType, value: test, tz };
  }

  private clonedValue(frame: Frame, call: CallExpr): IrValue | undefined {
    const argument = call.args[0];
    if (argument == undefined) {
      return undefined;
    }

    const type = this.typeOf(argument.expr);
    const given = this.value(frame, argument.expr);
    if (type == undefined || given == undefined) {
      return undefined;
    }
    if (!this.isManaged(type) || this.isString(type) || this.traits.isCopy(type, this.values)) {
      return this.owning(frame, given);
    }

    const isFlat =
      type.kind == TypeKind.Array &&
      (!this.isManaged(type.item) || this.isString(type.item));
    if (!isFlat) {
      this.notLowered(frame.module, call.loc, "a deep copy of this type");

      return undefined;
    }

    const copying = this.ir.declare(kArrayCopy, kPointerType, [kPointerType]);
    const value = frame.made.call(copying, [given.value]);

    this.dropping(frame, given);

    return { type: kPointerType, value, tz: type, owned: true };
  }

  private memDropped(frame: Frame, value: Expr): IrValue | undefined {
    const place = value.kind == ExprKind.Name ? this.targetPlace(frame, value) : undefined;
    const empty = place == undefined ? undefined : this.undefinedValue(place.tz);

    if (place != undefined && empty != undefined) {
      this.stored(frame, place, empty);
    } else {
      const given = this.value(frame, value);
      if (given == undefined) {
        return undefined;
      }

      this.dropping(frame, given);
    }

    const tz = this.store.plain(TypeKind.Void);

    return { type: kVoidType, value: this.ir.zero(kCharType), tz };
  }

  private memTaken(frame: Frame, place: Expr): IrValue | undefined {
    const type = this.typeOf(place);
    const current = this.value(frame, place);
    if (type == undefined || current == undefined) {
      return undefined;
    }

    const empty = this.emptyValueOf(frame, type, place.loc);
    const target = this.targetPlace(frame, place);
    if (empty == undefined || target == undefined) {
      return undefined;
    }

    const isHanded =
      current.owned != true &&
      target.flag == undefined &&
      this.isManaged(current.tz);
    if (isHanded) {
      const owned = this.owning(frame, empty);

      frame.made.store(owned.value, target.pointer);

      return {
        type: current.type,
        value: current.value,
        tz: current.tz,
        owned: true,
      };
    }

    const old = this.owning(frame, current);

    this.stored(frame, target, empty);

    return old;
  }

  private emptyValueOf(frame: Read<Frame>, type: Type, loc: int): IrValue | undefined {
    if (this.isString(type)) {
      return this.stringValue("");
    }
    if (type.kind == TypeKind.Array) {
      const descriptor = this.descriptor(type.item);
      if (descriptor != undefined) {
        const value = this.emptyArray(frame, descriptor);

        return { type: kPointerType, value, tz: type, owned: true };
      }
    }

    const isPlain =
      type.kind == TypeKind.Int ||
      type.kind == TypeKind.Double ||
      type.kind == TypeKind.Boolean ||
      this.optionalInner(type) != undefined;
    if (isPlain) {
      return this.undefinedValue(type);
    }

    this.notLowered(frame.module, loc, "take of a value without an empty one");

    return undefined;
  }

  private memSwapped(
    frame: Frame,
    loc: int,
    first: Expr,
    second: Expr,
  ): IrValue | undefined {
    const current = this.value(frame, first);
    if (current == undefined) {
      return undefined;
    }

    const old = this.owning(frame, current);
    const toFirst: AssignExpr = {
      kind: ExprKind.Assign,
      loc,
      target: first,
      value: second,
    };

    this.assigned(frame, toFirst);

    const place = this.targetPlace(frame, second);
    if (place == undefined) {
      return undefined;
    }

    this.stored(frame, place, old);

    const tz = this.store.plain(TypeKind.Void);

    return { type: kVoidType, value: this.ir.zero(kCharType), tz };
  }

  private libraryCall(
    frame: Frame,
    call: CallExpr,
    callee: NameExpr,
    module: int,
  ): IrValue | undefined {
    if (callee.name == kNumberName) {
      return this.numberOf(frame, call);
    }
    if (callee.name == kParseIntName) {
      return this.parsedInteger(frame, call);
    }
    if (callee.name == kStructuredCloneName) {
      return this.clonedValue(frame, call);
    }
    if (callee.name == kStringName) {
      return this.stringCalled(frame, call);
    }
    if (callee.name == kBooleanName) {
      return this.booleanCalled(frame, call);
    }

    const opened = this.program.modules[module];
    if (opened != undefined && opened.name == kMemModule) {
      return this.memCall(frame, call, callee);
    }
    if (opened != undefined && opened.name == kUnsafeModule) {
      return this.unsafeCall(frame, call, callee);
    }
    if (opened != undefined && opened.name == kInspectModule) {
      return this.inspectCall(frame, call, callee);
    }
    if (opened != undefined && opened.name == kFsModule) {
      return this.filesCall(frame, call, callee);
    }
    if (opened != undefined && opened.name == kChildModule) {
      return this.childCall(frame, call, callee);
    }
    if (opened != undefined && opened.name == kOsModule) {
      return this.osCall(frame, call, callee);
    }
    if (opened == undefined || opened.name != kPathModule) {
      this.notLowered(frame.module, call.loc, "a call of this function");

      return undefined;
    }

    switch (callee.name) {
      case "join":
      case "resolve":
        return this.pathJoined(frame, call, callee.name);
      case "dirname":
      case "extname":
      case "normalize":
        return this.pathPart(frame, call, callee.name);
      case "basename":
        return this.pathBase(frame, call);
      case "relative":
        return this.pathRelative(frame, call);
      case "isAbsolute":
        return this.pathAbsolute(frame, call);
      default:
        this.notLowered(frame.module, call.loc, "a call of this function");

        return undefined;
    }
  }

  private osCall(
    frame: Read<Frame>,
    call: CallExpr,
    callee: NameExpr,
  ): IrValue | undefined {
    const which = kOsTexts.indexOf(callee.name);
    if (which < 0 || call.args.length > 0) {
      this.notLowered(frame.module, call.loc, "a call of this function");

      return undefined;
    }

    const kind = this.ir.integer(kIntType, `${which}`);

    return this.textOut(frame, kOsText, [kIntType], [kind]);
  }

  private pathTexts(frame: Frame, call: CallExpr): IrValue[] | undefined {
    const texts: IrValue[] = [];
    const string = this.store.plain(TypeKind.String);

    for (const argument of call.args) {
      const given = this.value(frame, argument.expr);
      if (given == undefined || argument.spread) {
        this.notLowered(frame.module, call.loc, "these arguments");

        return undefined;
      }

      const text = this.converted(frame, given, string, argument.expr.loc);
      if (text == undefined) {
        return undefined;
      }

      texts.push(text);
    }

    return texts;
  }

  private readonly pathStyle(): LLVMValue {
    return this.ir.integer(kIntType, `${kPathStyle}`);
  }

  private textsDropped(frame: Read<Frame>, texts: Read<IrValue[]>): void {
    for (const text of texts) {
      this.dropping(frame, text);
    }
  }

  private pathJoined(
    frame: Frame,
    call: CallExpr,
    name: string,
  ): IrValue | undefined {
    const texts = this.pathTexts(frame, call);
    const string = this.store.plain(TypeKind.String);
    const descriptor = this.descriptor(string);
    if (texts == undefined || descriptor == undefined) {
      return undefined;
    }

    const array = this.newArray(frame, descriptor, texts.length);
    const data = this.arrayData(frame, array);

    for (let index = 0; index < texts.length; index++) {
      const text = texts[index];
      if (text == undefined) {
        continue;
      }

      const owned = this.owning(frame, text);
      const position = this.ir.integer(kIntType, `${index}`);
      const at = frame.made.element(text.type, data, position);

      frame.made.store(owned.value, at);
    }

    const runtime = this.pick(name == "join", kPathJoin, kPathResolve);
    const params = [kPointerType, kIntType];
    const result = this.textOut(frame, runtime, params, [
      array,
      this.pathStyle(),
    ]);
    const list: IrValue = {
      type: kPointerType,
      value: array,
      tz: this.store.arrayOf(string),
      owned: true,
    };

    this.dropping(frame, list);

    return result;
  }

  private pathPart(
    frame: Frame,
    call: CallExpr,
    name: string,
  ): IrValue | undefined {
    const texts = this.pathTexts(frame, call);
    const text = texts?.[0];
    if (texts == undefined || text == undefined) {
      return undefined;
    }

    const runtime = this.pathPartRuntime(name);
    const args = this.textParts(frame, text).concat([this.pathStyle()]);
    const params = [kPointerType, kIntType, kIntType];
    const result = this.textOut(frame, runtime, params, args);

    this.textsDropped(frame, texts);

    return result;
  }

  private readonly pathPartRuntime(name: string): string {
    switch (name) {
      case "dirname":
        return kPathDirname;
      case "extname":
        return kPathExtname;
      default:
        return kPathNormalize;
    }
  }

  private pathBase(frame: Frame, call: CallExpr): IrValue | undefined {
    const texts = this.pathTexts(frame, call);
    const text = texts?.[0];
    if (texts == undefined || text == undefined) {
      return undefined;
    }

    const suffix = texts[1];
    const hasSuffix = this.flagIf(suffix != undefined, 1);
    const args = this.textParts(frame, text)
      .concat(this.separatorParts(frame, suffix))
      .concat([
        this.ir.integer(kFlagType, `${hasSuffix}`),
        this.pathStyle(),
      ]);
    const params = [
      kPointerType,
      kIntType,
      kPointerType,
      kIntType,
      kFlagType,
      kIntType,
    ];
    const result = this.textOut(frame, kPathBasename, params, args);

    this.textsDropped(frame, texts);

    return result;
  }

  private pathRelative(frame: Frame, call: CallExpr): IrValue | undefined {
    const texts = this.pathTexts(frame, call);
    const from = texts?.[0];
    const to = texts?.[1];
    if (texts == undefined || from == undefined || to == undefined) {
      return undefined;
    }

    const args = this.textParts(frame, from)
      .concat(this.textParts(frame, to))
      .concat([this.pathStyle()]);
    const params = [kPointerType, kIntType, kPointerType, kIntType, kIntType];
    const result = this.textOut(frame, kPathRelative, params, args);

    this.textsDropped(frame, texts);

    return result;
  }

  private pathAbsolute(frame: Frame, call: CallExpr): IrValue | undefined {
    const texts = this.pathTexts(frame, call);
    const text = texts?.[0];
    if (texts == undefined || text == undefined) {
      return undefined;
    }

    const params = [kPointerType, kIntType, kIntType];
    const callee = this.ir.declare(kPathIsAbsolute, kFlagType, params);
    const args = this.textParts(frame, text).concat([this.pathStyle()]);
    const flag = frame.made.call(callee, args);
    const zero = this.ir.zero(kFlagType);
    const value = frame.made.integerCompare(IrIntPredicate.NotEqual, flag, zero);
    const tz = this.store.plain(TypeKind.Boolean);

    this.textsDropped(frame, texts);

    return { type: kBooleanType, value, tz };
  }
}
