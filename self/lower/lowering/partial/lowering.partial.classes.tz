import { ClassDecl } from "../../../program/ast/types/ast.types.classes.tz";
import { DeclaredMemberKind } from "../../../program/ast/types/ast.types.declarations.tz";
import {
  CallExpr,
  Expr,
  MemberExpr,
  NewExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../program/ast/types/ast.types.functions.tz";
import { InstanceField } from "../../../program/expression-answers/types/expression-answers.types.tz";
import {
  FunctionShape,
  ObjectField,
  Type,
  TypeKind,
} from "../../../program/type/types/type.types.tz";
import { IrFunction } from "../../ir-function/ir-function.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kFlagType,
  kIntType,
  kLayoutHead,
  kObjectAllocate,
  kObjectFree,
  kObjectHeader,
  kTupleFlag,
  kPointerType,
  kVoidType,
} from "../const/lowering.const.tz";
import {
  ClassLayout,
  Frame,
  IrValue,
  LayoutField,
  LayoutShape,
  Place,
} from "../types/lowering.types.tz";

partial class Lowering {
  private classDeclared(frame: Read<Frame>, decl: ClassDecl): void {
    if (!this.isPlainClass(decl)) {
      return this.notLowered(frame.module, decl.loc, "this class");
    }

    for (const fn of decl.constructors) {
      this.methodLowered(frame.module, decl, fn);
    }

    for (const fn of decl.methods) {
      if (fn.body != undefined) {
        this.methodLowered(frame.module, decl, fn);
      }
    }
  }

  private readonly isPlainClass(decl: ClassDecl): boolean {
    return (
      decl.typeParams.length == 0 &&
      decl.base == undefined &&
      decl.baseExpr == undefined &&
      decl.decorators.length == 0 &&
      !decl.isPartial
    );
  }

  private readonly methodName(module: int, decl: ClassDecl, fn: FunctionDecl): string {
    const home = this.methodHome(module, decl, fn);

    return `tz.k${module}.${decl.loc}.${fn.name}.${home}.${fn.loc}`;
  }

  private readonly methodHome(module: int, decl: ClassDecl, fn: FunctionDecl): int {
    for (const opened of this.program.modules) {
      const part = opened.parts.find(
        (one) => one.name == decl.name && one.methods.includes(fn),
      );
      if (part != undefined) {
        return opened.id;
      }
    }

    return module;
  }

  private readonly methodTitle(decl: ClassDecl, fn: FunctionDecl): string {
    const name = decl.name ?? "";
    if (decl.constructors.includes(fn)) {
      return `new ${name}`;
    }

    return `${name}.${fn.name}`;
  }

  private readonly methodShape(
    module: int,
    decl: ClassDecl,
    fn: FunctionDecl,
  ): FunctionShape | undefined {
    const home = this.methodHome(module, decl, fn);

    return this.shapeOf(home, fn.loc);
  }

  private methodLowered(
    classModule: int,
    decl: ClassDecl,
    fn: FunctionDecl,
  ): void {
    const body = fn.body;
    const module = this.methodHome(classModule, decl, fn);
    const shape = this.shapeOf(module, fn.loc);
    const self = this.resolver.classInstance(classModule, decl, []);
    if (body == undefined || shape == undefined) {
      return this.notLowered(module, fn.loc, "this method");
    }

    const isPlain =
      fn.typeParams.length == 0 &&
      !fn.isAsync &&
      !fn.isGenerator &&
      !shape.rest &&
      fn.params.every((param) => this.isPlainParameter(param));
    if (!isPlain) {
      return this.notLowered(module, fn.loc, "this kind of method");
    }

    const result = this.irType(shape.result);
    const params = this.parameterTypes(module, fn, shape);
    if (result == undefined || params == undefined) {
      const kind = this.shapeProblem(shape);

      return this.notLowered(module, fn.loc, `a method of type ${kind}`);
    }

    const name = this.methodName(classModule, decl, fn);
    const all = [kPointerType].concat(params.slice());
    const made = new IrFunction(this.ir, name, result, all);
    const selfPlace: Place = {
      pointer: made.slot(kPointerType, "this"),
      type: kPointerType,
      tz: self,
      owner: -1,
    };
    const inner: Frame = {
      made,
      id: this.frameId(),
      module,
      result: shape.result,
      loops: [],
      scopes: [],
      self: selfPlace,
      place: this.methodTitle(decl, fn),
    };

    made.store(made.param(0), selfPlace.pointer);
    this.openScope(inner);
    this.parametersStored(inner, fn, shape, params);
    this.statements(inner, body.body);
    this.closeScope(inner);
    this.finished(made, result);
  }

  private layoutOf(type: Type): ClassLayout | undefined {
    const known = this.layouts.get(type.id);
    if (known != undefined) {
      return known;
    }

    const shape = this.layoutShape(type);
    if (shape == undefined) {
      return undefined;
    }

    const fields = shape.fields;
    const placed = this.placedFields(fields);
    if (placed == undefined) {
      return undefined;
    }

    const types = [kIntType, kPointerType].concat(
      placed.map((field) => field.ir),
    );
    const struct = `{ ${types.join(", ")} }`;
    const size = this.structSize(placed);
    const name = shape.name;
    const classId = this.nextClassId();
    const drop = this.dropFunction(this.layoutTitle(name), struct, placed);
    const descriptor = this.layoutDescriptor(shape, drop, placed, classId);
    const layout: ClassLayout = {
      struct,
      size,
      fields: placed,
      descriptor,
      classId,
      shape,
      drop,
    };

    this.layouts.set(type.id, layout);

    return layout;
  }

  private readonly layoutShape(type: Type): LayoutShape | undefined {
    if (type.kind == TypeKind.Object) {
      const fields = type.fields.map((field) => this.objectField(field));

      return { name: "", fields, flags: 0 };
    }
    if (type.kind == TypeKind.Tuple) {
      const fields = type.items.map((item, index) => ({
        name: `${index}`,
        loc: 0,
        type: item,
      }));

      return { name: "", fields, flags: kTupleFlag };
    }

    const declared = this.libraryShape(type);
    if (declared != undefined) {
      return declared;
    }

    const decl = this.values.classDeclOf(type);
    const fields = this.values.instanceFields(type);
    if (decl == undefined || fields == undefined || !this.isPlainClass(decl)) {
      return undefined;
    }

    return { name: decl.name ?? "", fields, flags: 0 };
  }

  private readonly libraryShape(type: Type): LayoutShape | undefined {
    if (type.kind != TypeKind.Instance) {
      return undefined;
    }

    const opened = this.program.modules[type.module];
    const loc = type.loc;
    const decl = opened?.declared.find((one) => one.loc == loc);
    if (opened == undefined || decl == undefined || !opened.source.isLibrary) {
      return undefined;
    }

    const context = this.resolver.classContext(
      type,
      decl.typeParams,
      type.module,
    );
    const fields: InstanceField[] = [];

    for (const member of decl.members) {
      const written = member.type;
      const isField = member.form.kind == DeclaredMemberKind.Field;
      if (!isField || member.isStatic || written == undefined) {
        continue;
      }

      const resolved = this.resolver.resolve(written, context);

      fields.push({ name: member.name, loc: member.loc, type: resolved });
    }

    return { name: decl.name ?? "", fields, flags: 0 };
  }

  private layoutProblem(type: Type): string {
    const shape = this.layoutShape(type);
    if (shape == undefined) {
      return `a ${this.kindName(type)} of this form`;
    }

    const failed = shape.fields.find(
      (field) => this.irType(field.type) == undefined,
    );
    if (failed == undefined) {
      return "a missing field";
    }

    return `type ${this.kindName(failed.type)}`;
  }

  private readonly objectField(field: ObjectField): InstanceField {
    const type = field.type;
    const empty = this.store.plain(TypeKind.Undefined);
    const isBare = this.optionalInner(type) == undefined;
    if (field.optional && isBare) {
      const optional = this.store.unionOf([type, empty]);

      return { name: field.name, loc: 0, type: optional };
    }

    return { name: field.name, loc: 0, type };
  }

  private placedFields(fields: Read<InstanceField[]>): LayoutField[] | undefined {
    const order = fields.slice();

    order.sort((first, second) => this.fieldOrder(first, second));

    const placed: LayoutField[] = [];
    let offset: int = 16;

    for (let index = 0; index < order.length; index++) {
      const field = order[index];
      if (field == undefined) {
        return undefined;
      }

      const ir = this.irType(field.type);
      if (ir == undefined || ir == kVoidType) {
        return undefined;
      }

      const align = this.alignOf(field.type);

      offset = this.aligned(offset, align);
      placed.push({
        name: field.name,
        index: index + 2,
        offset,
        type: field.type,
        ir,
      });
      offset += this.sizeOf(field.type);
    }

    return placed;
  }

  private fieldOrder(first: InstanceField, second: InstanceField): int {
    const isFirstTag = first.type.kind == TypeKind.Literal;
    const isSecondTag = second.type.kind == TypeKind.Literal;
    if (isFirstTag != isSecondTag) {
      return this.choose(isFirstTag, -1, 1);
    }

    const isFirstCode = first.type.kind == TypeKind.Function;
    const isSecondCode = second.type.kind == TypeKind.Function;
    if (isFirstCode != isSecondCode) {
      return this.choose(isSecondCode, -1, 1);
    }

    const firstAlign = this.alignOf(first.type);
    const secondAlign = this.alignOf(second.type);
    if (firstAlign != secondAlign) {
      return secondAlign - firstAlign;
    }
    if (first.name < second.name) {
      return -1;
    }
    if (first.name > second.name) {
      return 1;
    }

    return 0;
  }

  private structSize(fields: Read<LayoutField[]>): int {
    let end: int = 16;

    for (const field of fields) {
      end = field.offset + this.sizeOf(field.type);
    }

    return this.aligned(end, 8);
  }

  private readonly aligned(offset: int, align: int): int {
    const rest = offset % align;
    if (rest == 0) {
      return offset;
    }

    return offset + align - rest;
  }

  private dropFunction(
    name: string,
    struct: string,
    fields: Read<LayoutField[]>,
  ): LLVMValue {
    const dropName = this.ir.uniqueName(`tz.drop.${name}.`);
    const made = new IrFunction(this.ir, dropName, kVoidType, [kPointerType]);
    const object = made.param(0);
    const frame: Frame = {
      made,
      id: this.frameId(),
      module: 0,
      loops: [],
      scopes: [],
    };
    const held: IrValue[] = [];

    for (const field of fields) {
      if (!this.isManaged(field.type)) {
        continue;
      }

      const address = made.field(struct, object, field.index);
      const value = made.load(field.ir, address);

      held.push({ type: field.ir, value, tz: field.type, owned: true });
    }

    const freeing = this.ir.declare(kObjectFree, kVoidType, [kPointerType]);

    made.call(freeing, [object]);

    for (const value of held) {
      this.dropping(frame, value);
    }

    made.finishVoid();

    return made.callee.fn;
  }

  private layoutDescriptor(
    shape: Read<LayoutShape>,
    drop: LLVMValue,
    placed: Read<LayoutField[]>,
    classId: int,
  ): LLVMValue {
    const entries: LLVMValue[] = [];
    const name = shape.name;
    const title = this.layoutTitle(name);

    for (const field of shape.fields) {
      const spot = placed.find((one) => one.name == field.name);
      const type = this.descriptor(field.type) ?? this.ir.zero(kPointerType);
      const offset = spot?.offset ?? 0;

      entries.push(
        this.ir.constStruct([
          this.cText(field.name),
          this.ir.integer(kFlagType, `${field.name.length}`),
          this.ir.integer(kFlagType, `${offset}`),
          type,
        ]),
      );
    }

    const entry = "{ ptr, i32, i32, ptr }";
    const count = entries.length;
    const tableName = this.ir.uniqueName(`tz.fields.${title}.`);
    const tableType = `[${count} x ${entry}]`;
    const values = this.ir.constArray(entry, entries);
    const table = this.ir.global(tableName, tableType, values, true);
    const head = this.ir.constStruct([
      drop,
      table,
      this.ir.integer(kFlagType, `${count}`),
      this.ir.integer(kFlagType, `${shape.flags}`),
      this.nameText(name),
      this.ir.integer(kFlagType, `${name.length}`),
      this.ir.integer(kFlagType, `${classId}`),
    ]);
    const slots = this.ir.constArray(kPointerType, []);
    const descriptor = this.ir.constStruct([
      head,
      this.ir.zero(kPointerType),
      slots,
    ]);
    const globalName = this.ir.uniqueName(`tz.layout.${title}.`);
    const globalType = `{ ${kLayoutHead}, ptr, [0 x ptr] }`;

    return this.ir.global(globalName, globalType, descriptor, true);
  }

  private readonly layoutTitle(name: string): string {
    if (name.length == 0) {
      return "object";
    }

    return name;
  }

  private nameText(name: string): LLVMValue {
    if (name.length == 0) {
      return this.ir.zero(kPointerType);
    }

    return this.cText(name);
  }

  private cText(text: string): LLVMValue {
    const known = this.cTexts.get(text);
    if (known != undefined) {
      return known;
    }

    const bytes = Buffer.from(text, "utf8");
    const name = this.ir.uniqueName(".name.");
    const data = this.ir.bytes(bytes, true);
    const array = `[${bytes.length + 1} x i8]`;
    const global = this.ir.global(name, array, data, true);

    this.cTexts.set(text, global);

    return global;
  }

  private resultType(shape: Read<FunctionShape | undefined>): string | undefined {
    if (shape == undefined) {
      return undefined;
    }

    return this.irType(shape.result);
  }

  private shapeTypesOf(shape: Read<FunctionShape | undefined>): string[] | undefined {
    if (shape == undefined) {
      return undefined;
    }

    return this.shapeTypes(shape);
  }

  private shapeProblemOf(shape: Read<FunctionShape | undefined>): string {
    if (shape == undefined) {
      return "unknown";
    }

    return this.shapeProblem(shape);
  }

  private nextClassId(): int {
    const id = this.classIds;

    this.classIds += 1;

    return id;
  }

  private newValue(frame: Frame, expr: NewExpr): IrValue | undefined {
    const type = this.typeOf(expr);
    if (type != undefined && type.kind == TypeKind.Dict) {
      return this.newDictFrom(frame, expr, type);
    }
    if (type == undefined || type.kind != TypeKind.Instance) {
      this.notLowered(frame.module, expr.loc, "this new");

      return undefined;
    }

    const decl = this.values.classDeclOf(type);
    const layout = this.layoutOf(type);
    if (decl == undefined || layout == undefined) {
      this.notLowered(frame.module, expr.loc, "this new");

      return undefined;
    }

    const object = this.allocated(frame, layout);

    const value: IrValue = {
      type: kPointerType,
      value: object,
      tz: type,
      owned: true,
    };
    const ctor = decl.constructors[0];
    if (ctor == undefined) {
      return value;
    }

    const shape = this.methodShape(type.module, decl, ctor);
    const params = this.shapeTypesOf(shape);
    if (shape == undefined || params == undefined) {
      this.notLowered(frame.module, expr.loc, "this new");

      return undefined;
    }

    const args = this.callArguments(frame, expr.args, shape, expr.loc);
    if (args == undefined) {
      return undefined;
    }

    const name = this.methodName(type.module, decl, ctor);
    const all = [kPointerType].concat(params);
    const callee = this.ir.declare(name, kVoidType, all);

    frame.made.call(callee, [object].concat(args));

    return value;
  }

  private orderedDescriptor(layout: Read<ClassLayout>, names: Read<string[]>): LLVMValue {
    const fields = layout.shape.fields;
    const isSame = names.every((name, index) => fields[index]?.name == name);
    if (isSame) {
      return layout.descriptor;
    }

    const key = `${layout.classId} ${names.join(" ")}`;
    const known = this.orderedDescriptors.get(key);
    if (known != undefined) {
      return known;
    }

    const ordered: InstanceField[] = [];

    for (const name of names) {
      const field = fields.find((one) => one.name == name);
      if (field != undefined) {
        ordered.push(field);
      }
    }

    const rest = fields.filter((field) => !names.includes(field.name));
    const shape: LayoutShape = {
      name: layout.shape.name,
      fields: ordered.concat(rest),
      flags: layout.shape.flags,
    };
    const descriptor = this.layoutDescriptor(
      shape,
      layout.drop,
      layout.fields,
      layout.classId,
    );

    this.orderedDescriptors.set(key, descriptor);

    return descriptor;
  }

  private readonly allocated(frame: Read<Frame>, layout: Read<ClassLayout>): LLVMValue {
    const tz = this.store.integer(64, false);
    const size = this.ir.integer(kIntType, `${layout.size}`);
    const sizeValue: IrValue = { type: kIntType, value: size, tz };
    const object = this.runtimeValue(frame, kObjectAllocate, kPointerType, [
      sizeValue,
    ]);
    const count = frame.made.field(kObjectHeader, object, 0);
    const kind = frame.made.field(kObjectHeader, object, 1);

    frame.made.store(this.ir.integer(kIntType, "1"), count);
    frame.made.store(layout.descriptor, kind);
    this.zeroFields(frame, object, layout);

    return object;
  }

  private readonly zeroFields(
    frame: Read<Frame>,
    object: LLVMValue,
    layout: Read<ClassLayout>,
  ): void {
    for (const field of layout.fields) {
      const address = frame.made.field(layout.struct, object, field.index);

      frame.made.store(this.ir.zero(field.ir), address);
    }
  }

  private fieldPlace(
    frame: Frame,
    object: Place,
    name: string,
    loc: int,
  ): Place | undefined {
    const pointer = frame.made.load(kPointerType, object.pointer);

    return this.fieldAt(frame, pointer, object.tz, name, loc);
  }

  private fieldAt(
    frame: Frame,
    object: LLVMValue,
    type: Type,
    name: string,
    loc: int,
  ): Place | undefined {
    if (type.kind == TypeKind.Union) {
      const parts = type.parts.filter(
        (part) => part.kind != TypeKind.Undefined,
      );
      const single = parts[0];
      if (parts.length == 1 && single != undefined) {
        return this.fieldAt(frame, object, single, name, loc);
      }

      return this.unionFieldAt(frame, object, parts, name, loc);
    }

    const layout = this.layoutOf(type);
    const field = layout?.fields.find((one) => one.name == name);
    if (layout == undefined || field == undefined) {
      const problem = this.layoutProblem(type);

      this.notLowered(frame.module, loc, `a field of ${problem}`);

      return undefined;
    }

    const pointer = frame.made.field(layout.struct, object, field.index);

    return { pointer, type: field.ir, tz: field.type, owner: -1 };
  }

  private fieldValue(frame: Frame, expr: MemberExpr): IrValue | undefined {
    const object = this.value(frame, expr.object);
    if (object == undefined) {
      return undefined;
    }
    if (this.isMixedField(object.tz, expr.name)) {
      return this.mixedFieldValue(frame, object, expr);
    }

    const place = this.fieldAt(
      frame,
      object.value,
      object.tz,
      expr.name,
      expr.loc,
    );
    if (place == undefined) {
      return undefined;
    }

    const loaded = this.seenAs(frame, this.loaded(frame, place), expr);
    if (object.owned != true) {
      return loaded;
    }

    const kept = this.owning(frame, loaded);

    this.dropping(frame, object);

    return kept;
  }

  private seenAs(frame: Frame, loaded: IrValue, expr: Expr): IrValue {
    const seen = this.typeOf(expr);
    if (seen == undefined || seen.kind == TypeKind.Error) {
      return loaded;
    }
    if (this.irType(seen) == undefined) {
      return loaded;
    }

    const isNarrowed =
      this.optionalInner(loaded.tz) != undefined &&
      this.optionalInner(seen) == undefined;
    if (!isNarrowed) {
      return loaded;
    }

    return this.converted(frame, loaded, seen, expr.loc) ?? loaded;
  }

  private methodCall(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
    object: Type,
  ): IrValue | undefined {
    const decl = this.values.classDeclOf(object);
    const fn = decl?.methods.find((one) => one.name == member.name);
    if (
      decl == undefined ||
      fn == undefined ||
      object.kind != TypeKind.Instance
    ) {
      const name = this.calledName(call);

      this.notLowered(frame.module, call.loc, `a call of method ${name}`);

      return undefined;
    }

    const shape = this.methodShape(object.module, decl, fn);
    const result = this.resultType(shape);
    const params = this.shapeTypesOf(shape);
    if (shape == undefined || result == undefined || params == undefined) {
      const kind = this.shapeProblemOf(shape);

      this.notLowered(frame.module, call.loc, `a method call of type ${kind}`);

      return undefined;
    }

    const self = this.value(frame, member.object);
    if (self == undefined) {
      return undefined;
    }

    const args = this.callArguments(frame, call.args, shape, call.loc);
    if (args == undefined) {
      return undefined;
    }

    const name = this.methodName(object.module, decl, fn);
    const all = [kPointerType].concat(params);
    const callee = this.ir.declare(name, result, all);
    const made = frame.made.call(callee, [self.value].concat(args));

    this.dropping(frame, self);

    return { type: result, value: made, tz: shape.result, owned: true };
  }
}
