import { ClassDecl } from "../../../program/ast/types/ast.types.classes.tz";
import {
  CallExpr,
  MemberExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import {
  FunctionDecl,
} from "../../../program/ast/types/ast.types.functions.tz";
import {
  FunctionShape,
  Type,
  TypeKind,
} from "../../../program/type/types/type.types.tz";
import { IrFunction } from "../../ir-function/ir-function.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kPointerType,
  kRuntimeModules,
} from "../const/lowering.const.tz";
import {
  Frame,
  IrValue,
  MethodCallSite,
  MethodTarget,
  Place,
} from "../types/lowering.types.tz";

partial class Lowering {
  private classDeclared(frame: Read<Frame>, decl: ClassDecl): void {
    const tree = this.values.types.program.tree;

    if (!this.isPlainClass(decl)) {
      return this.notLowered(frame.module, decl.loc, "this class");
    }
    const typeParams = tree.typeParamsOf(decl.typeParamsList);
    if (typeParams.length > 0) {
      return;
    }

    const self = this.values.types.classInstance(frame.module, decl, []);

    for (const fn of tree.functionsOf(decl.constructorsList)) {
      const name = this.methodName(frame.module, decl, fn);

      this.methodLowered(frame.module, decl, fn, name, self);
    }

    for (const fn of tree.functionsOf(decl.methodsList)) {
      if (
        tree.blockAt(fn.bodyId) != undefined &&
        tree.typeParamsOf(fn.typeParamsList).length == 0
      ) {
        const name = this.methodName(frame.module, decl, fn);

        this.methodLowered(frame.module, decl, fn, name, self);
      }
    }
  }

  private readonly isPlainClass(decl: ClassDecl): boolean {
    const tree = this.values.types.program.tree;

    const isSimpleBase =
      tree.typeRefAt(decl.baseId) == undefined ||
      tree.typeParamsOf(decl.typeParamsList).length == 0;

    return (
      isSimpleBase &&
      tree.exprAt(decl.baseExprId) == undefined &&
      tree.decoratorsOf(decl.decoratorsList).length == 0 &&
      !decl.isPartial
    );
  }

  private methodTarget(
    object: Type,
    decl: ClassDecl,
    fn: FunctionDecl,
    call?: MethodCallSite,
  ): MethodTarget | undefined {
    const tree = this.values.types.program.tree;

    if (object.kind != TypeKind.Instance) {
      return undefined;
    }

    const shape = this.methodShape(object.module, decl, fn);
    const name = this.methodName(object.module, decl, fn);
    if (shape == undefined) {
      return undefined;
    }
    if (
      tree.typeParamsOf(decl.typeParamsList).length == 0 &&
      tree.typeParamsOf(fn.typeParamsList).length == 0
    ) {
      this.runtimeMethodWanted(object, decl, fn, name);

      return { name, shape };
    }

    const home = this.methodHome(object.module, decl, fn);
    const classParams = this.values.types.parameterTypes(
      object.module,
      tree.typeParamsOf(decl.typeParamsList),
    );
    const ownParams = this.values.types.parameterTypes(
      home,
      tree.typeParamsOf(fn.typeParamsList),
    );
    const ownArgs = this.methodTypeArguments(fn, call);
    if (ownArgs == undefined) {
      return undefined;
    }

    const params = classParams.concat(ownParams);
    const args = this.values.types.store.argsOf(object).concat(ownArgs);
    const binding = this.bindingOf(params, args);
    const bound = this.shapeWith(shape, binding);
    const ids = args.map((type) => `${type.id}`);
    const instance = `${name}.i${ids.join("_")}`;

    this.instanceWanted({
      module: home,
      fn,
      name: instance,
      params,
      args,
      owner: decl,
      self: object,
    });

    return { name: instance, shape: bound };
  }

  private runtimeMethodWanted(
    object: Type,
    decl: ClassDecl,
    fn: FunctionDecl,
    name: string,
  ): void {
    if (object.kind != TypeKind.Instance) {
      return;
    }

    const opened = this.values.types.program.modules[object.module];
    if (opened == undefined || !kRuntimeModules.includes(opened.name)) {
      return;
    }

    this.instanceWanted({
      module: object.module,
      fn,
      name,
      params: [],
      args: [],
      owner: decl,
      self: object,
    });
  }

  private methodTypeArguments(
    fn: FunctionDecl,
    call: MethodCallSite | undefined,
  ): Type[] | undefined {
    const tree = this.values.types.program.tree;

    const typeParams = tree.typeParamsOf(fn.typeParamsList);
    if (typeParams.length == 0) {
      return [];
    }
    if (call == undefined) {
      return undefined;
    }

    const written = this.values.typeArgumentsOf(call.module, call.loc);
    if (written == undefined) {
      return undefined;
    }

    return written.map((type) => this.bound(type));
  }

  private virtualCall(
    frame: Read<Frame>,
    object: Type,
    fn: FunctionDecl,
    self: IrValue,
    args: Read<LLVMValue[]>,
    target: Read<MethodTarget>,
  ): LLVMValue | undefined {
    const tree = this.values.types.program.tree;

    if (
      !this.isInHierarchy(object) ||
      tree.typeParamsOf(fn.typeParamsList).length > 0
    ) {
      return undefined;
    }

    return this.dispatchedCall(
      frame,
      object,
      fn.name,
      self,
      args.slice(),
      target,
    );
  }

  private readonly methodName(
    module: int,
    decl: ClassDecl,
    fn: FunctionDecl,
  ): string {
    const home = this.methodHome(module, decl, fn);

    return `tz.k${module}.${decl.loc}.${fn.name}.${home}.${fn.loc}`;
  }

  private readonly methodHome(
    module: int,
    decl: ClassDecl,
    fn: FunctionDecl,
  ): int {
    const tree = this.values.types.program.tree;

    for (const opened of this.values.types.program.modules) {
      const part = tree
        .classesOf(opened.partsList)
        .find(
          (one) =>
            one.name == decl.name && tree.holdsStmt(one.methodsList, fn.id),
        );
      if (part != undefined) {
        return opened.id;
      }
    }

    return module;
  }

  private readonly methodTitle(decl: ClassDecl, fn: FunctionDecl): string {
    const tree = this.values.types.program.tree;

    const name = decl.name ?? "";
    if (tree.holdsStmt(decl.constructorsList, fn.id)) {
      return `new ${name}`;
    }

    return `${name}.${fn.name}`;
  }

  private methodShape(
    module: int,
    decl: ClassDecl,
    fn: FunctionDecl,
  ): FunctionShape | undefined {
    const home = this.methodHome(module, decl, fn);

    return this.shapeOf(home, fn.loc);
  }

  private methodLowered(
    classModule: int,
    decl: ClassDecl,
    fn: FunctionDecl,
    name: string,
    self: Type,
  ): void {
    const tree = this.values.types.program.tree;

    const body = tree.blockAt(fn.bodyId);
    const module = this.methodHome(classModule, decl, fn);
    const shape = this.shapeOf(module, fn.loc);
    if (body == undefined || shape == undefined) {
      return this.notLowered(module, fn.loc, "this method");
    }

    const isPlain =
      !fn.isAsync &&
      !fn.isGenerator &&
      !shape.rest &&
      tree
        .paramsOf(fn.paramsList)
        .every((param) => this.isPlainParameter(param));
    if (!isPlain) {
      return this.notLowered(module, fn.loc, "this kind of method");
    }

    const result = this.irType(shape.result);
    const params = this.parameterTypes(module, fn, shape);
    if (result == undefined || params == undefined) {
      const kind = this.shapeProblem(shape);

      return this.notLowered(module, fn.loc, `a method of type ${kind}`);
    }

    const all = [kPointerType].concat(params.slice());
    const made = new IrFunction(this.ir, name, result, all);
    const selfPlace: Place = {
      pointer: made.slot(kPointerType, "this"),
      type: kPointerType,
      tz: self,
      owner: -1,
    };
    const inner: Frame = {
      made,
      id: this.frameId(),
      module,
      result: shape.result,
      loops: [],
      scopes: [],
      self: selfPlace,
      place: this.methodTitle(decl, fn),
      isLending: this.isLending(fn),
    };

    made.store(made.param(0), selfPlace.pointer);
    this.openScope(inner);
    this.parametersStored(inner, fn, shape, params);
    const bodyItem = tree.stmtsOf(body.bodyList);

    this.statements(inner, bodyItem);
    this.closeScope(inner);
    this.finished(made, result, shape.result);
  }

  private resultType(
    shape: Read<FunctionShape | undefined>,
  ): string | undefined {
    if (shape == undefined) {
      return undefined;
    }

    return this.irType(shape.result);
  }

  private shapeTypesOf(
    shape: Read<FunctionShape | undefined>,
  ): string[] | undefined {
    if (shape == undefined) {
      return undefined;
    }

    return this.shapeTypes(shape);
  }

  private shapeProblemOf(shape: Read<FunctionShape | undefined>): string {
    if (shape == undefined) {
      return "unknown";
    }

    return this.shapeProblem(shape);
  }

  private nextClassId(): int {
    const id = this.classIds;

    this.classIds += 1;

    return id;
  }

  private methodCall(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
    object: Type,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const found = this.ownedMethod(object, member.name);
    const decl = found?.decl;
    const fn = found?.fn;
    if (
      found == undefined ||
      decl == undefined ||
      fn == undefined ||
      object.kind != TypeKind.Instance
    ) {
      const name = this.calledName(call);

      this.notLowered(frame.module, call.loc, `a call of method ${name}`);

      return undefined;
    }

    const site: MethodCallSite = { module: frame.module, loc: member.loc };
    const target = this.methodTarget(found.owner, decl, fn, site);
    const shape = target?.shape;
    const result = this.resultType(shape);
    const params = this.shapeTypesOf(shape);
    if (
      target == undefined ||
      shape == undefined ||
      result == undefined ||
      params == undefined
    ) {
      const kind = this.shapeProblemOf(shape);

      this.notLowered(frame.module, call.loc, `a method call of type ${kind}`);

      return undefined;
    }

    const objectExpr = tree.exprOf(member.objectId);
    const self = this.value(frame, objectExpr);
    if (self == undefined) {
      return undefined;
    }

    const kept: IrValue[] = [];
    const args = this.callArguments(
      frame,
      tree.argumentsOf(call.argsList),
      shape,
      call.loc,
      fn,
      kept,
    );
    if (args == undefined) {
      return undefined;
    }

    const all = [kPointerType].concat(params);
    const callee = this.ir.declare(target.name, result, all);
    const dispatched = this.virtualCall(frame, object, fn, self, args, target);
    const receiver = this.recordAddress(frame, self);
    const made = dispatched ?? frame.made.call(callee, [receiver].concat(args));
    const answer: IrValue = { type: result, value: made, tz: shape.result };
    const temporaries = kept.concat([self]);
    const given = this.receiverResult(frame, answer, fn, temporaries, self);

    this.droppedAll(frame, kept);
    this.dropping(frame, self);

    return given;
  }
}
