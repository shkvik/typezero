import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import { IrFunction } from "../../ir-function/ir-function.tz";
import {
  IrCallee,
  IrIntPredicate,
  IrOpcode,
} from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kArrayFree,
  kArrayFreed,
  kArrayAppend,
  kArrayAppendTaken,
  kArrayCopy,
  kArrayLengthField,
  kArrayRelease,
  kArrayRetain,
  kArraySetLength,
  kArraySlice,
  kArraySliceLent,
  kArraySplice,
  kArrayUnshift,
  kBooleanType,
  kCountsModule,
  kDecimalFree,
  kDecimalFreed,
  kDecimalsModule,
  kDecimalRelease,
  kDecimalRetain,
  kDecimalType,
  kFlagType,
  kInstanceRelease,
  kIntType,
  kObjectHeader,
  kPointerType,
  kStringFree,
  kStringRelease,
  kStringRetain,
  kStringType,
  kTextFreed,
  kTextModule,
  kVoidType,
} from "../const/lowering.const.tz";
import { CountForm, Frame, IrValue, Place } from "../types/lowering.types.tz";

partial class Lowering {
  private isManaged(type: Type): boolean {
    const inner = this.optionalInner(type);
    if (inner != undefined) {
      return this.isManaged(inner);
    }

    return (
      this.isString(type) ||
      this.isArray(type) ||
      this.isCounted(type) ||
      this.isDecimal(type) ||
      this.isManagedResult(type)
    );
  }

  private isManagedResult(type: Type): boolean {
    if (type.kind != TypeKind.Result) {
      return false;
    }

    const isValueManaged =
      !this.isEmptyHalf(this.values.types.store.valueOf(type)) &&
      this.isManaged(this.values.types.store.valueOf(type));
    const isErrorManaged =
      !this.isEmptyHalf(this.values.types.store.errorOf(type)) &&
      this.isManaged(this.values.types.store.errorOf(type));

    return isValueManaged || isErrorManaged;
  }

  private owning(frame: Read<Frame>, value: IrValue): IrValue {
    if (value.isStatic == true) {
      return {
        type: value.type,
        value: value.value,
        tz: value.tz,
        owned: true,
        isStatic: true,
      };
    }

    const ownedFlag = value.ownedFlag;
    if (ownedFlag != undefined) {
      return this.flagOwning(frame, ownedFlag, value);
    }

    const isFree =
      value.owned == true ||
      !this.isManaged(value.tz) ||
      this.isConstant(value);
    if (!isFree) {
      this.auditCount(frame, value.tz);
      this.countCall(frame, true, value);
    }

    return { type: value.type, value: value.value, tz: value.tz, owned: true };
  }

  private auditCount(frame: Read<Frame>, type: Type): void {
    const inner = this.optionalInner(type) ?? type;
    if (!this.isAuditing || this.isString(inner) || this.isDecimal(inner)) {
      return;
    }
    if (this.values.isCopy(inner)) {
      return;
    }

    const module = this.values.types.program.modules[frame.module];
    if (module == undefined) {
      return;
    }

    const lines = this.linesOf(frame.module, module.source.text);
    const line = lines?.placeOf(this.statementLoc).line ?? 0;
    const kind = this.kindName(inner);

    this.audited.push(`${module.source.path}:${line}: ${kind}`);
  }

  private dropping(frame: Read<Frame>, value: IrValue): void {
    if (value.isStatic == true) {
      return;
    }

    const ownedFlag = value.ownedFlag;
    if (ownedFlag != undefined) {
      return this.flagDropped(frame, ownedFlag, value);
    }

    const isOwned =
      value.owned == true &&
      this.isManaged(value.tz) &&
      !this.isConstant(value);
    if (isOwned && this.isCheckedDrop(value)) {
      this.ownDropChecked(frame, value);
    }
    if (isOwned) {
      this.countCall(frame, false, value);
    }
  }

  private countCall(
    frame: Read<Frame>,
    isRetain: boolean,
    value: IrValue,
  ): void {
    const inner = this.optionalInner(value.tz);
    if (inner != undefined) {
      const inside = this.insideValue(frame, value, inner);

      return this.countCall(frame, isRetain, inside);
    }
    if (this.isRecordValue(value)) {
      return this.recordCount(frame, isRetain, value);
    }

    if (this.isSingleOwner(value)) {
      return this.ownCount(frame, isRetain, value);
    }

    const helper = this.countHelperOf(value.tz, isRetain);

    frame.made.call(helper, [value.value]);
  }

  private countHelperOf(type: Type, isRetain: boolean): IrCallee {
    const result = this.resultCounter(type, isRetain);
    if (result != undefined) {
      return result;
    }
    if (this.isString(type)) {
      const name = this.pick(isRetain, kStringRetain, kStringRelease);

      return this.countHelper(name, isRetain, CountForm.Text);
    }
    if (this.isDecimal(type)) {
      const name = this.pick(isRetain, kDecimalRetain, kDecimalRelease);

      return this.countHelper(name, isRetain, CountForm.Decimal);
    }
    if (this.isCounted(type) && !isRetain) {
      return this.instanceReleaseHelper();
    }
    if (
      !isRetain &&
      type.kind == TypeKind.Array &&
      this.isManaged(this.values.types.store.itemOf(type))
    ) {
      return this.arrayReleaseHelper(type);
    }

    const name = this.pick(isRetain, kArrayRetain, kArrayRelease);

    return this.countHelper(name, isRetain, CountForm.Pointer);
  }

  private readonly openScope(frame: Frame): void {
    frame.scopes.push([]);
  }

  private closeScope(frame: Frame): void {
    const scope = frame.scopes.pop();
    if (scope == undefined || frame.made.isClosed()) {
      return;
    }

    this.scopeCleanup(frame, scope);
  }

  private cleanupsTo(frame: Read<Frame>, depth: int): void {
    for (let index = frame.scopes.length - 1; index >= depth; index--) {
      const scope = frame.scopes[index];
      if (scope != undefined) {
        this.scopeCleanup(frame, scope);
      }
    }
  }

  private scopeCleanup(frame: Read<Frame>, scope: Read<Place[]>): void {
    for (let index = scope.length - 1; index >= 0; index--) {
      const place = scope[index];
      if (place != undefined) {
        this.placeReleased(frame, place);
      }
    }
  }

  private placeReleased(frame: Read<Frame>, place: Place): void {
    if (place.view != undefined) {
      return this.viewReleased(frame, place);
    }

    const loaded = frame.made.load(place.type, place.pointer);
    const value: IrValue = {
      type: place.type,
      value: loaded,
      tz: place.tz,
      owned: true,
    };
    const flag = place.flag;

    frame.made.store(this.ir.zero(place.type), place.pointer);

    if (flag == undefined) {
      return this.dropping(frame, value);
    }

    this.flaggedDrop(frame, flag, value);
  }

  private viewReleased(frame: Read<Frame>, place: Place): void {
    const seen = this.loaded(frame, place);
    const value: IrValue = {
      type: seen.type,
      value: seen.value,
      tz: seen.tz,
      owned: true,
    };
    const flag = place.flag;

    frame.made.store(this.ir.zero(place.type), place.pointer);

    if (flag == undefined) {
      return this.dropping(frame, value);
    }

    this.flaggedDrop(frame, flag, value);
  }

  private flagDropped(
    frame: Read<Frame>,
    ownedFlag: LLVMValue,
    value: IrValue,
  ): void {
    const release = frame.made.block("owned.drop");
    const after = frame.made.block("owned.after");
    const owned: IrValue = {
      type: value.type,
      value: value.value,
      tz: value.tz,
      owned: true,
    };

    frame.made.conditionalBranch(ownedFlag, release, after);
    frame.made.open(release);
    this.dropping(frame, owned);
    frame.made.open(after);
  }

  private flagOwning(
    frame: Read<Frame>,
    ownedFlag: LLVMValue,
    value: IrValue,
  ): IrValue {
    const retain = frame.made.block("borrowed.count");
    const after = frame.made.block("borrowed.after");
    const borrowed: IrValue = {
      type: value.type,
      value: value.value,
      tz: value.tz,
    };

    frame.made.conditionalBranch(ownedFlag, after, retain);
    frame.made.open(retain);
    this.owning(frame, borrowed);
    frame.made.open(after);

    return { type: value.type, value: value.value, tz: value.tz, owned: true };
  }

  private flaggedDrop(
    frame: Read<Frame>,
    flag: LLVMValue,
    value: IrValue,
  ): void {
    const isOwned = frame.made.load(kBooleanType, flag);
    const release = frame.made.block("flag.drop");
    const after = frame.made.block("flag.after");

    frame.made.conditionalBranch(isOwned, release, after);
    frame.made.open(release);
    this.dropping(frame, value);
    frame.made.open(after);
  }

  private keepPlace(frame: Frame, place: Place): void {
    const scope = frame.scopes[frame.scopes.length - 1];
    if (scope != undefined && this.isManaged(place.tz)) {
      scope.push(place);
    }
  }

  private stored(frame: Read<Frame>, place: Place, value: IrValue): void {
    if (place.view != undefined) {
      const form = "a new value for a borrow of an in-place value";

      return this.notLowered(frame.module, this.statementLoc, form);
    }

    const owned = this.owning(frame, value);
    if (!this.isManaged(place.tz)) {
      return frame.made.store(owned.value, place.pointer);
    }

    const before = frame.made.load(place.type, place.pointer);
    const old: IrValue = {
      type: place.type,
      value: before,
      tz: place.tz,
      owned: true,
    };
    const flag = place.flag;

    frame.made.store(owned.value, place.pointer);

    if (flag == undefined) {
      return this.dropping(frame, old);
    }

    this.flaggedDrop(frame, flag, old);
    frame.made.store(this.ir.integer(kBooleanType, "1"), flag);
  }

  private countHelper(
    name: string,
    isRetain: boolean,
    form: CountForm,
  ): IrCallee {
    const known = this.ir.callee(name);
    if (known != undefined) {
      return known;
    }

    const param = this.countParam(form);
    const made = new IrFunction(this.ir, name, kVoidType, [param]);
    const argument = made.param(0);
    const counted = made.block("counted");
    const done = made.block("done");
    const isCounted = this.isCountedTest(made, argument, form);

    made.conditionalBranch(isCounted, counted, done);
    made.open(counted);

    const object = this.countedObject(made, argument, form);
    const count = made.load(kIntType, object);

    if (isRetain) {
      const one = this.ir.integer(kIntType, "1");
      const more = made.binary(IrOpcode.Add, count, one);

      made.store(more, object);
    } else {
      const free = this.freeName(form);

      this.lastReference(made, object, count, free);
    }

    made.open(done);
    made.finishVoid();

    return made.callee;
  }

  private readonly countParam(form: CountForm): string {
    switch (form) {
      case CountForm.Text:
        return kStringType;
      case CountForm.Decimal:
        return kDecimalType;
      default:
        return kPointerType;
    }
  }

  private runtimeHelperName(
    module: string,
    freeing: string,
    fallback: string,
  ): string {
    const tree = this.values.types.program.tree;

    const homeId = this.moduleIdNamed(module);
    const fn = this.functionNamed(homeId, freeing);
    if (homeId == undefined || fn == undefined) {
      return fallback;
    }

    const name = this.instanceName(homeId, fn, []);
    const params = this.values.types.parameterTypes(
      homeId,
      tree.typeParamsOf(fn.typeParamsList),
    );

    this.instanceWanted({ module: homeId, fn, name, params, args: [] });

    return name;
  }

  private countsHelper(name: string): string {
    const helper = this.countsHelperOf(name);
    if (helper == undefined) {
      return name;
    }

    return this.runtimeHelperName(kCountsModule, helper, name);
  }

  private readonly countsHelperOf(name: string): string | undefined {
    switch (name) {
      case kArraySlice:
        return "arraySliced";
      case kArraySliceLent:
        return "arrayLentSliced";
      case kArrayCopy:
        return "arrayCopied";
      case kArrayAppend:
        return "arrayAppended";
      case kArrayAppendTaken:
        return "arrayTakenAppended";
      case kArraySetLength:
        return "arrayLengthSet";
      case kArrayUnshift:
        return "arrayUnshifted";
      case kArraySplice:
        return "arraySpliced";
      default:
        return undefined;
    }
  }

  private freeName(form: CountForm): string {
    switch (form) {
      case CountForm.Text:
        return this.runtimeHelperName(kTextModule, kTextFreed, kStringFree);
      case CountForm.Decimal:
        return this.runtimeHelperName(kDecimalsModule, kDecimalFreed, kDecimalFree);
      default:
        return this.runtimeHelperName(kCountsModule, kArrayFreed, kArrayFree);
    }
  }

  private readonly countedObject(
    made: IrFunction,
    argument: LLVMValue,
    form: CountForm,
  ): LLVMValue {
    switch (form) {
      case CountForm.Text:
        return made.extract(argument, 0);
      case CountForm.Decimal: {
        const bits = made.extract(argument, 0);

        return made.cast(IrOpcode.IntToPtr, bits, kPointerType);
      }
      default:
        return argument;
    }
  }

  private isCountedTest(
    made: IrFunction,
    argument: LLVMValue,
    form: CountForm,
  ): LLVMValue {
    if (form != CountForm.Pointer) {
      const meta = made.extract(argument, 1);
      const zero = this.ir.zero(kIntType);

      return made.integerCompare(IrIntPredicate.SignedLess, meta, zero);
    }

    const none = this.ir.zero(kPointerType);

    return made.integerCompare(IrIntPredicate.NotEqual, argument, none);
  }

  private lastReference(
    made: IrFunction,
    object: LLVMValue,
    count: LLVMValue,
    free: string,
  ): void {
    const freed = made.block("free");
    const after = made.block("after");
    const one = this.ir.integer(kIntType, "1");
    const left = made.binary(IrOpcode.Sub, count, one);
    const zero = this.ir.zero(kIntType);
    const isLast = made.integerCompare(IrIntPredicate.Equal, left, zero);
    const freeing = this.ir.declare(free, kVoidType, [kPointerType]);

    made.store(left, object);
    made.conditionalBranch(isLast, freed, after);
    made.open(freed);
    made.call(freeing, [object]);
    made.open(after);
  }

  private arrayReleaseHelper(type: Type): IrCallee {
    const name = `${kArrayRelease}.${type.id}`;
    const known = this.ir.callee(name);
    if (known != undefined) {
      return known;
    }

    const made = new IrFunction(this.ir, name, kVoidType, [kPointerType]);
    const frame: Frame = {
      made,
      id: this.frameId(),
      module: 0,
      loops: [],
      scopes: [],
      place: name,
    };
    const array = made.param(0);
    const counted = made.block("counted");
    const freed = made.block("free");
    const done = made.block("done");
    const none = this.ir.zero(kPointerType);
    const isArray = made.integerCompare(IrIntPredicate.NotEqual, array, none);

    made.conditionalBranch(isArray, counted, done);
    made.open(counted);

    const count = made.load(kIntType, array);
    const one = this.ir.integer(kIntType, "1");
    const left = made.binary(IrOpcode.Sub, count, one);
    const zero = this.ir.zero(kIntType);
    const isLast = made.integerCompare(IrIntPredicate.Equal, left, zero);

    made.store(left, array);
    made.conditionalBranch(isLast, freed, done);
    made.open(freed);
    this.cellsReleased(frame, array, type);
    made.open(done);
    made.finishVoid();

    return made.callee;
  }

  private cellsReleased(
    frame: Read<Frame>,
    array: LLVMValue,
    type: Type,
  ): void {
    const isLent = this.isLookingArray(type);
    const isHeld = this.isManagedItems(type);
    if (type.kind == TypeKind.Array && !isLent && isHeld) {
      const loop = this.eachStart(
        frame,
        array,
        this.values.types.store.itemOf(type),
      );
      if (loop != undefined) {
        const item = loop.item;

        this.dropping(frame, {
          type: item.type,
          value: item.value,
          tz: item.tz,
          owned: true,
        });
        this.eachEnd(frame, loop);
      }
    }

    const length = this.arrayField(frame, array, kArrayLengthField);
    const name = this.runtimeHelperName(kCountsModule, kArrayFreed, kArrayFree);
    const freeing = this.ir.declare(name, kVoidType, [kPointerType]);

    frame.made.store(this.ir.zero(kFlagType), length);
    frame.made.call(freeing, [array]);
  }

  private instanceReleaseHelper(): IrCallee {
    const known = this.ir.callee(kInstanceRelease);
    if (known != undefined) {
      return known;
    }

    const made = new IrFunction(this.ir, kInstanceRelease, kVoidType, [
      kPointerType,
    ]);
    const object = made.param(0);
    const counted = made.block("counted");
    const dropped = made.block("drop");
    const done = made.block("done");
    const none = this.ir.zero(kPointerType);
    const isCounted = made.integerCompare(
      IrIntPredicate.NotEqual,
      object,
      none,
    );

    made.conditionalBranch(isCounted, counted, done);
    made.open(counted);

    const count = made.load(kIntType, object);
    const one = this.ir.integer(kIntType, "1");
    const left = made.binary(IrOpcode.Sub, count, one);
    const zero = this.ir.zero(kIntType);
    const isLast = made.integerCompare(IrIntPredicate.Equal, left, zero);

    made.store(left, object);
    made.conditionalBranch(isLast, dropped, done);
    made.open(dropped);

    const kind = made.field(kObjectHeader, object, 1);
    const layout = made.load(kPointerType, kind);
    const dropper = made.load(kPointerType, layout);
    const dropType = this.ir.signature(kVoidType, [kPointerType]);

    made.indirectCall(dropType, dropper, [object]);
    made.open(done);
    made.finishVoid();

    return made.callee;
  }
}
