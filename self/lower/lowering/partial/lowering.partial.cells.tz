import {
  CallExpr,
  Expr,
  ExprKind,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { TypeKind } from "../../../program/type/types/type.types.tz";
import {
  IrIntPredicate,
  IrOpcode,
} from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kAllBits,
  kBooleanType,
  kByteCell,
  kByteType,
  kFlagType,
  kIntType,
  kLengthMask,
  kMemoryCompare,
  kMemoryFind,
  kTextModule,
  kWideFound,
  kMemoryMove,
  kPointerType,
  kStringType,
  kTextAsciiBit,
  kTextBufferHead,
  kTextClosedMade,
  kTextHighBits,
  kTextFormBits,
  kTextOffsetShift,
  kTextRoomMade,
  kTextShortAscii,
  kTextShortCount,
  kTextShortBits,
  kTextTreeBits,
  kTextWideBit,
  kVoidType,
  kWideCell,
} from "../const/lowering.const.tz";
import {
  CellPair,
  Frame,
  IrValue,
  RuntimeTarget,
} from "../types/lowering.types.tz";

partial class Lowering {
  private textCellsOf(
    frame: Frame,
    call: CallExpr,
    cell: string,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const argument = tree.argumentsOf(call.argsList)[0];
    if (argument == undefined) {
      return undefined;
    }

    const address = this.textAddress(frame, tree.exprOf(argument.exprId));
    if (address == undefined) {
      const form = "the cells of a string that is not a variable";

      this.notLowered(frame.module, call.loc, form);

      return undefined;
    }

    const isWide = cell == kWideCell;
    const made = frame.made;
    const metaAddress = made.field(kStringType, address, 1);
    const meta = made.load(kIntType, metaAddress);
    const treeBits = this.ir.hexInteger(kIntType, kTextTreeBits);
    const kind = made.binary(IrOpcode.And, meta, treeBits);
    const isTree = made.integerCompare(IrIntPredicate.Equal, kind, treeBits);
    const slow = made.block("cells.tree");
    const fast = made.block("cells.flat");
    const end = made.block("cells.end");

    made.conditionalBranch(isTree, slow, fast);
    made.open(slow);

    const text = made.load(kStringType, address);
    const string = this.values.types.store.plain(TypeKind.String);
    const boolean = this.values.types.store.plain(TypeKind.Boolean);
    const wide = this.ir.integer(kBooleanType, this.pick(isWide, "1", "0"));
    const given: IrValue[] = [
      { type: kStringType, value: text, tz: string },
      { type: kBooleanType, value: wide, tz: boolean },
    ];
    const target: RuntimeTarget = { module: kTextModule, name: "treeCells" };
    const cells = this.runtimeFunctionCall(frame, target, [], given, call.loc);
    const found = cells?.value ?? this.ir.zero(kPointerType);
    const after = made.currentBlock();

    made.branch(end);
    made.open(fast);

    const flat = this.flatCells(frame, address, meta, isWide);

    made.branch(end);
    made.open(end);

    const value = made.phi(kPointerType, [found, flat], [after, fast]);

    return this.rawMade(call, value);
  }

  private flatCells(
    frame: Read<Frame>,
    address: LLVMValue,
    meta: LLVMValue,
    isWide: boolean,
  ): LLVMValue {
    const made = frame.made;
    const none = this.ir.zero(kPointerType);
    const zero = this.ir.zero(kIntType);
    const formBits = this.ir.hexInteger(kIntType, kTextFormBits);
    const shortBits = this.ir.hexInteger(kIntType, kTextShortBits);
    const wideBit = this.ir.hexInteger(kIntType, kTextWideBit);
    const form = made.binary(IrOpcode.And, meta, formBits);
    const isShort = made.integerCompare(IrIntPredicate.Equal, form, shortBits);
    const wide = made.binary(IrOpcode.And, meta, wideBit);
    let widthTest = IrIntPredicate.Equal;

    if (isWide) {
      widthTest = IrIntPredicate.NotEqual;
    }

    const isFitting = made.integerCompare(widthTest, wide, zero);
    const shifted = made.binary(
      IrOpcode.LShr,
      meta,
      this.ir.integer(kIntType, kTextOffsetShift),
    );
    const mask = this.ir.hexInteger(kIntType, kLengthMask);
    const offset = made.binary(IrOpcode.And, shifted, mask);
    const step = this.pick(isWide, "1", "0");
    const scaled = made.binary(
      IrOpcode.Shl,
      offset,
      this.ir.integer(kIntType, step),
    );
    const head = this.ir.integer(kIntType, kTextBufferHead);
    const skip = made.binary(IrOpcode.Add, scaled, head);
    const buffer = made.load(kPointerType, address);
    const body = made.element(kByteType, buffer, skip);
    const hasBuffer = made.integerCompare(
      IrIntPredicate.NotEqual,
      buffer,
      none,
    );
    const held = made.select(hasBuffer, body, address);
    const cells = made.select(isShort, address, held);

    return made.select(isFitting, cells, none);
  }

  private textAddress(frame: Read<Frame>, expr: Expr): LLVMValue | undefined {
    if (expr.kind != ExprKind.Name || !this.isLocalName(frame, expr)) {
      return undefined;
    }

    const target = this.values.valueTargetOf(expr, frame.module);
    if (target == undefined) {
      return undefined;
    }

    const key = this.placeKey(target.module, target.loc);
    const place = this.places.get(key);
    if (place == undefined || place.type != kStringType) {
      return undefined;
    }

    return place.pointer;
  }

  private unitRead(
    frame: Frame,
    call: CallExpr,
    cell: string,
  ): IrValue | undefined {
    const raw = this.rawArgument(frame, call, 0);
    const index = this.intArgument(frame, call, 1);
    if (raw == undefined || index == undefined) {
      return undefined;
    }

    const address = frame.made.element(cell, raw, index);
    const unit = frame.made.load(cell, address);
    const tz = this.values.types.store.integer(64, false);
    if (cell == kIntType) {
      return { type: kIntType, value: unit, tz };
    }

    const value = frame.made.cast(IrOpcode.ZExt, unit, kIntType);

    return { type: kIntType, value, tz };
  }

  private unitFound(
    frame: Frame,
    call: CallExpr,
    cell: string,
  ): IrValue | undefined {
    const raw = this.rawArgument(frame, call, 0);
    const from = this.intArgument(frame, call, 1);
    const end = this.intArgument(frame, call, 2);
    const unit = this.intArgument(frame, call, 3);
    const isByte = cell == kByteCell;
    if (!isByte && cell != kWideCell) {
      this.notLowered(frame.module, call.loc, "a search in cells of this size");

      return undefined;
    }
    if (raw == undefined || from == undefined) {
      return undefined;
    }
    if (end == undefined || unit == undefined) {
      return undefined;
    }

    const tz = this.values.types.store.integer(64, false);

    if (!isByte) {
      const target: RuntimeTarget = { module: kTextModule, name: kWideFound };
      const given: IrValue[] = [
        { type: kPointerType, value: raw, tz },
        { type: kIntType, value: from, tz },
        { type: kIntType, value: end, tz },
        { type: kIntType, value: unit, tz },
      ];

      return this.runtimeFunctionCall(frame, target, [], given, call.loc);
    }

    const value = this.byteFound(frame, raw, from, end, unit);

    return { type: kIntType, value, tz };
  }

  private byteFound(
    frame: Read<Frame>,
    raw: LLVMValue,
    from: LLVMValue,
    end: LLVMValue,
    unit: LLVMValue,
  ): LLVMValue {
    const made = frame.made;
    const count = made.binary(IrOpcode.Sub, end, from);
    const zero = this.ir.zero(kIntType);
    const limit = this.ir.integer(kIntType, "255");
    const isEmpty = made.integerCompare(
      IrIntPredicate.SignedLessOrEqual,
      count,
      zero,
    );
    const isWide = made.integerCompare(
      IrIntPredicate.UnsignedGreater,
      unit,
      limit,
    );
    const isMissed = made.binary(IrOpcode.Or, isEmpty, isWide);
    const search = made.block("find.search");
    const missed = made.block("find.missed");
    const done = made.block("find.done");

    made.conditionalBranch(isMissed, missed, search);
    made.open(search);

    const start = made.element(kByteCell, raw, from);
    const byte = made.cast(IrOpcode.Trunc, unit, kFlagType);
    const params = [kPointerType, kFlagType, kIntType];
    const finding = this.ir.declare(kMemoryFind, kPointerType, params);
    const found = made.call(finding, [start, byte, count]);
    const foundBits = made.cast(IrOpcode.PtrToInt, found, kIntType);
    const rawBits = made.cast(IrOpcode.PtrToInt, raw, kIntType);
    const offset = made.binary(IrOpcode.Sub, foundBits, rawBits);
    const isNone = made.integerCompare(IrIntPredicate.Equal, foundBits, zero);
    const none = this.ir.integer(kIntType, "-1");
    const index = made.select(isNone, none, offset);

    made.branch(done);
    made.open(missed);
    made.branch(done);
    made.open(done);

    return made.phi(kIntType, [index, none], [search, missed]);
  }

  private cellsCompared(
    frame: Frame,
    call: CallExpr,
    cell: string,
  ): IrValue | undefined {
    const first = this.cellAddress(frame, call, cell, 0);
    const second = this.cellAddress(frame, call, cell, 2);
    const count = this.intArgument(frame, call, 4);
    if (first == undefined || second == undefined || count == undefined) {
      return undefined;
    }

    const bytes = this.cellBytes(frame, cell, count);
    const params = [kPointerType, kPointerType, kIntType];
    const comparing = this.ir.declare(kMemoryCompare, kFlagType, params);
    const order = frame.made.call(comparing, [first, second, bytes]);
    const zero = this.ir.zero(kFlagType);
    const value = frame.made.integerCompare(IrIntPredicate.Equal, order, zero);
    const tz = this.values.types.store.plain(TypeKind.Boolean);

    return { type: kBooleanType, value, tz };
  }

  private cellsCopied(
    frame: Frame,
    call: CallExpr,
    cell: string,
    targetCell: string,
  ): IrValue | undefined {
    const source = this.cellAddress(frame, call, cell, 0);
    const target = this.cellAddress(frame, call, targetCell, 2);
    const count = this.intArgument(frame, call, 4);
    if (source == undefined || target == undefined || count == undefined) {
      return undefined;
    }
    if (cell != targetCell) {
      const isWidening = cell == kByteCell && targetCell == kWideCell;
      const isNarrowing = cell == kWideCell && targetCell == kByteCell;
      if (!isWidening && !isNarrowing) {
        this.notLowered(frame.module, call.loc, "a copy between these cells");

        return undefined;
      }

      const cells: CellPair = { from: cell, into: targetCell };

      return this.cellsSpread(frame, source, target, count, cells);
    }

    const bytes = this.cellBytes(frame, cell, count);
    const params = [kPointerType, kPointerType, kIntType];
    const moving = this.ir.declare(kMemoryMove, kPointerType, params);

    frame.made.call(moving, [target, source, bytes]);

    return this.nothing();
  }

  private cellsSpread(
    frame: Read<Frame>,
    source: LLVMValue,
    target: LLVMValue,
    count: LLVMValue,
    cells: CellPair,
  ): IrValue {
    const made = frame.made;
    const at = made.slot(kIntType, "spread.at");
    const test = made.block("spread.test");
    const body = made.block("spread.body");
    const end = made.block("spread.end");
    let fitting = IrOpcode.ZExt;

    if (cells.from == kWideCell) {
      fitting = IrOpcode.Trunc;
    }

    made.store(this.ir.zero(kIntType), at);
    made.branch(test);
    made.open(test);

    const index = made.load(kIntType, at);
    const isInside = made.integerCompare(
      IrIntPredicate.SignedLess,
      index,
      count,
    );

    made.conditionalBranch(isInside, body, end);
    made.open(body);

    const read = made.element(cells.from, source, index);
    const unit = made.load(cells.from, read);
    const fitted = made.cast(fitting, unit, cells.into);
    const written = made.element(cells.into, target, index);
    const one = this.ir.integer(kIntType, "1");
    const next = made.binary(IrOpcode.Add, index, one);

    made.store(fitted, written);
    made.store(next, at);
    made.branch(test);
    made.open(end);

    return this.nothing();
  }

  private unitWritten(
    frame: Frame,
    call: CallExpr,
    cell: string,
  ): IrValue | undefined {
    const raw = this.rawArgument(frame, call, 0);
    const index = this.intArgument(frame, call, 1);
    const unit = this.intArgument(frame, call, 2);
    if (raw == undefined || index == undefined || unit == undefined) {
      return undefined;
    }

    const address = frame.made.element(cell, raw, index);
    if (cell == kIntType) {
      frame.made.store(unit, address);

      return this.nothing();
    }

    const fitted = frame.made.cast(IrOpcode.Trunc, unit, cell);

    frame.made.store(fitted, address);

    return this.nothing();
  }

  private textMade(
    frame: Frame,
    call: CallExpr,
    cell: string,
  ): IrValue | undefined {
    const raw = this.rawArgument(frame, call, 0);
    const count = this.intArgument(frame, call, 1);
    const isByte = cell == kByteCell;
    if (!isByte && cell != kWideCell) {
      this.notLowered(frame.module, call.loc, "a string of cells of this size");

      return undefined;
    }
    if (raw == undefined || count == undefined) {
      return undefined;
    }

    const tree = this.values.types.program.tree;

    const hint = tree.argumentsOf(call.argsList)[2];
    if (hint == undefined) {
      return undefined;
    }

    const known = this.value(frame, tree.exprOf(hint.exprId));
    if (known == undefined || known.type != kBooleanType) {
      return undefined;
    }

    const int = this.values.types.store.integer(64, false);
    const boolean = this.values.types.store.plain(TypeKind.Boolean);
    const isWide = this.ir.integer(kBooleanType, this.pick(isByte, "0", "1"));
    const closing: IrValue[] = [
      { type: kPointerType, value: raw, tz: int },
      { type: kIntType, value: count, tz: int },
      { type: kBooleanType, value: isWide, tz: boolean },
      known,
    ];
    const target: RuntimeTarget = { module: kTextModule, name: kTextClosedMade };
    if (!isByte) {
      return this.runtimeFunctionCall(frame, target, [], closing, call.loc);
    }

    const made = frame.made;
    const out = made.slot(kStringType, "text.out");
    const limit = this.ir.integer(kIntType, kTextShortCount);
    const isLong = made.integerCompare(
      IrIntPredicate.SignedGreater,
      count,
      limit,
    );
    const long = made.block("close.long");
    const short = made.block("close.short");
    const end = made.block("close.end");

    made.conditionalBranch(isLong, long, short);
    made.open(long);

    const closed = this.runtimeFunctionCall(frame, target, [], closing, call.loc);

    if (closed != undefined) {
      made.store(closed.value, out);
    }

    made.branch(end);
    made.open(short);
    made.store(this.shortText(frame, raw, count), out);
    made.branch(end);
    made.open(end);

    const value = made.load(kStringType, out);
    const tz = this.values.types.store.plain(TypeKind.String);

    return { type: kStringType, value, tz, owned: true };
  }

  private shortText(
    frame: Read<Frame>,
    room: LLVMValue,
    count: LLVMValue,
  ): LLVMValue {
    const made = frame.made;
    const zero = this.ir.zero(kIntType);
    const eight = this.ir.integer(kIntType, kTextShortCount);
    const isEmpty = made.integerCompare(IrIntPredicate.Equal, count, zero);
    const spare = made.binary(IrOpcode.Sub, eight, count);
    const shift = made.binary(IrOpcode.Mul, spare, eight);
    const safe = made.select(isEmpty, zero, shift);
    const ones = this.ir.hexInteger(kIntType, kAllBits);
    const mask = made.binary(IrOpcode.LShr, ones, safe);
    const read = made.load(kIntType, room);
    const kept = made.binary(IrOpcode.And, read, mask);
    const bits = made.select(isEmpty, zero, kept);
    const highBits = this.ir.hexInteger(kIntType, kTextHighBits);
    const high = made.binary(IrOpcode.And, bits, highBits);
    const isPlain = made.integerCompare(IrIntPredicate.Equal, high, zero);
    const plain = this.ir.hexInteger(kIntType, kTextShortAscii);
    const other = this.ir.hexInteger(kIntType, kTextShortBits);
    const form = made.select(isPlain, plain, other);
    const none = this.ir.hexInteger(kIntType, kTextAsciiBit);
    const flags = made.select(isEmpty, none, form);
    const meta = made.binary(IrOpcode.Or, count, flags);
    const object = made.cast(IrOpcode.IntToPtr, bits, kPointerType);
    const half = made.insert(this.ir.zero(kStringType), object, 0);

    return made.insert(half, meta, 1);
  }

  private frameCellsOf(
    frame: Frame,
    call: CallExpr,
    cell: string,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const argument = tree.argumentsOf(call.argsList)[0];
    if (argument == undefined) {
      return undefined;
    }

    const expr = tree.exprOf(argument.exprId);
    if (expr.kind != ExprKind.IntLit) {
      const form = "cells in the frame without a number literal";

      this.notLowered(frame.module, call.loc, form);

      return undefined;
    }

    const room = frame.made.slot(`[${expr.value} x ${cell}]`, "frame.cells");

    return this.rawMade(call, room);
  }

  private textIsAscii(frame: Frame, call: CallExpr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const argument = tree.argumentsOf(call.argsList)[0];
    if (argument == undefined) {
      return undefined;
    }

    const text = this.value(frame, tree.exprOf(argument.exprId));
    if (text == undefined || text.type != kStringType) {
      return undefined;
    }

    const meta = frame.made.extract(text.value, 1);
    const bit = this.ir.hexInteger(kIntType, kTextAsciiBit);
    const kept = frame.made.binary(IrOpcode.And, meta, bit);
    const zero = this.ir.zero(kIntType);
    const value = frame.made.integerCompare(
      IrIntPredicate.NotEqual,
      kept,
      zero,
    );
    const tz = this.values.types.store.plain(TypeKind.Boolean);

    this.dropping(frame, text);

    return { type: kBooleanType, value, tz };
  }

  private textRoomOf(
    frame: Frame,
    call: CallExpr,
    cell: string,
  ): IrValue | undefined {
    const count = this.intArgument(frame, call, 0);
    const isByte = cell == kByteCell;
    if (!isByte && cell != kWideCell) {
      this.notLowered(frame.module, call.loc, "a string of cells of this size");

      return undefined;
    }
    if (count == undefined) {
      return undefined;
    }

    const made = frame.made;
    const short = made.slot(kStringType, "text.room");
    const limit = this.ir.integer(kIntType, kTextShortCount);
    const isLong = made.integerCompare(
      IrIntPredicate.SignedGreater,
      count,
      limit,
    );
    const before = made.currentBlock();
    const long = made.block("room.long");
    const end = made.block("room.end");

    made.conditionalBranch(isLong, long, end);
    made.open(long);

    const int = this.values.types.store.integer(64, false);
    const boolean = this.values.types.store.plain(TypeKind.Boolean);
    const isWide = this.ir.integer(kBooleanType, this.pick(isByte, "0", "1"));
    const making: IrValue[] = [
      { type: kIntType, value: count, tz: int },
      { type: kBooleanType, value: isWide, tz: boolean },
    ];
    const target: RuntimeTarget = { module: kTextModule, name: kTextRoomMade };
    const room = this.runtimeFunctionCall(frame, target, [], making, call.loc);
    const held = room?.value ?? this.ir.zero(kPointerType);
    const after = made.currentBlock();

    made.branch(end);
    made.open(end);

    const value = made.phi(kPointerType, [short, held], [before, after]);

    return this.rawMade(call, value);
  }

  private cellAddress(
    frame: Frame,
    call: CallExpr,
    cell: string,
    position: int,
  ): LLVMValue | undefined {
    const raw = this.rawArgument(frame, call, position);
    const index = this.intArgument(frame, call, position + 1);
    if (raw == undefined || index == undefined) {
      return undefined;
    }

    return frame.made.element(cell, raw, index);
  }

  private textPiece(
    frame: Frame,
    call: CallExpr,
    isMeta: boolean,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const argument = tree.argumentsOf(call.argsList)[0];
    if (argument == undefined) {
      return undefined;
    }

    const text = this.value(frame, tree.exprOf(argument.exprId));
    if (text == undefined || text.type != kStringType) {
      return undefined;
    }

    const tz =
      this.typeOf(call) ?? this.values.types.store.integer(64, true);
    if (isMeta) {
      const meta = frame.made.extract(text.value, 1);

      this.dropping(frame, text);

      return { type: kIntType, value: meta, tz };
    }

    const object = frame.made.extract(text.value, 0);

    this.dropping(frame, text);

    return { type: kPointerType, value: object, tz };
  }

  private textJoined(frame: Frame, call: CallExpr): IrValue | undefined {
    const object = this.rawArgument(frame, call, 0);
    const tree = this.values.types.program.tree;

    const argument = tree.argumentsOf(call.argsList)[1];
    if (object == undefined || argument == undefined) {
      return undefined;
    }

    const given = this.value(frame, tree.exprOf(argument.exprId));
    if (given == undefined || given.type != kIntType) {
      return undefined;
    }

    const half = frame.made.insert(this.ir.zero(kStringType), object, 0);
    const value = frame.made.insert(half, given.value, 1);
    const tz = this.values.types.store.plain(TypeKind.String);

    return { type: kStringType, value, tz, owned: true };
  }
}
