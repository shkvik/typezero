import {
  ArrayLitExpr,
  CallArgument,
  CallExpr,
  Expr,
  ExprKind,
  IndexExpr,
  MemberExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { ForOfStmt } from "../../../program/ast/types/ast.types.statements.tz";
import {
  DictKind,
  Type,
  TypeKind,
} from "../../../program/type/types/type.types.tz";
import {
  IrIntPredicate,
  IrOpcode,
} from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kArrayAppend,
  kArrayCapacityField,
  kArrayDataField,
  kArrayGrow,
  kArrayLayout,
  kArrayLengthField,
  kArrayNew,
  kDescriptorLayout,
  kFlagType,
  kHandleKind,
  kHandleLayout,
  kIntType,
  kPointerType,
  kVoidType,
} from "../const/lowering.const.tz";
import {
  DescriptorShape,
  Frame,
  IrValue,
  Place,
} from "../types/lowering.types.tz";

partial class Lowering {
  private arrayLiteral(frame: Frame, expr: ArrayLitExpr): IrValue | undefined {
    return this.arrayLiteralOf(frame, expr, this.typeOf(expr));
  }

  private wantedValue(
    frame: Frame,
    expr: Expr,
    wanted: Type,
  ): IrValue | undefined {
    const known = this.typeOf(expr);
    if (known == undefined && expr.kind == ExprKind.ArrayLit) {
      return this.arrayLiteralOf(frame, expr, wanted);
    }
    if (known == undefined && expr.kind == ExprKind.ObjectLit) {
      return this.objectLiteral(frame, expr, wanted);
    }

    const literal = this.wantedText(expr, wanted);
    if (literal != undefined) {
      return literal;
    }

    return this.value(frame, expr);
  }

  private arrayLiteralOf(
    frame: Frame,
    expr: ArrayLitExpr,
    type: Type | undefined,
  ): IrValue | undefined {
    const isPlain = expr.elements.every(
      (element) => !element.spread && !element.hole,
    );
    if (type != undefined && type.kind == TypeKind.Tuple && isPlain) {
      return this.tupleLiteral(frame, expr, type);
    }

    const hasHoles = expr.elements.some((element) => element.hole);
    if (type != undefined && type.kind == TypeKind.Array && !hasHoles) {
      if (!isPlain) {
        return this.spreadArray(frame, expr, type);
      }
    }
    if (type == undefined || type.kind != TypeKind.Array || !isPlain) {
      const kind = this.kindName(type);

      this.notLowered(frame.module, expr.loc, `an array literal of ${kind}`);

      return undefined;
    }

    const item = type.item;
    const element = this.irType(item);
    const descriptor = this.descriptor(item);
    if (element == undefined || descriptor == undefined) {
      this.notLowered(frame.module, expr.loc, "an array of this type");

      return undefined;
    }

    const count = expr.elements.length;
    const array = this.newArray(frame, descriptor, count);
    const data = this.arrayData(frame, array);

    for (let index = 0; index < count; index++) {
      const entry = expr.elements[index];
      if (entry == undefined) {
        continue;
      }

      const given = this.value(frame, entry.expr);
      if (given == undefined) {
        return undefined;
      }

      const value = this.converted(frame, given, item, entry.expr.loc);
      if (value == undefined) {
        return undefined;
      }

      const owned = this.owning(frame, value);
      const position = this.ir.integer(kIntType, `${index}`);
      const at = frame.made.element(element, data, position);

      frame.made.store(owned.value, at);
    }

    return { type: kPointerType, value: array, tz: type, owned: true };
  }

  private spreadArray(
    frame: Frame,
    expr: ArrayLitExpr,
    type: Type,
  ): IrValue | undefined {
    const item = this.itemOf(type);
    if (item == undefined) {
      return undefined;
    }

    const descriptor = this.descriptor(item);
    if (descriptor == undefined) {
      this.notLowered(frame.module, expr.loc, "an array of this type");

      return undefined;
    }

    const array = this.emptyArray(frame, descriptor);

    for (const element of expr.elements) {
      const argument: CallArgument = {
        expr: element.expr,
        spread: element.spread,
      };
      const isAdded = this.itemAdded(frame, array, argument, type);
      if (!isAdded) {
        return undefined;
      }
    }

    return { type: kPointerType, value: array, tz: type, owned: true };
  }

  private readonly newArray(frame: Read<Frame>, descriptor: LLVMValue, count: int): LLVMValue {
    const tz = this.store.integer(64, false);
    const size = this.ir.integer(kIntType, `${count}`);
    const args: IrValue[] = [
      { type: kPointerType, value: descriptor, tz },
      { type: kIntType, value: size, tz },
      { type: kIntType, value: size, tz },
    ];

    return this.runtimeValue(frame, kArrayNew, kPointerType, args);
  }

  private readonly arrayField(frame: Read<Frame>, array: LLVMValue, field: int): LLVMValue {
    return frame.made.field(kArrayLayout, array, field);
  }

  private readonly arrayData(frame: Read<Frame>, array: LLVMValue): LLVMValue {
    const field = this.arrayField(frame, array, kArrayDataField);

    return frame.made.load(kPointerType, field);
  }

  private readonly arrayLength(frame: Read<Frame>, array: LLVMValue): LLVMValue {
    const field = this.arrayField(frame, array, kArrayLengthField);
    const short = frame.made.load(kFlagType, field);

    return frame.made.cast(IrOpcode.ZExt, short, kIntType);
  }

  private descriptor(type: Type): LLVMValue | undefined {
    if (type.kind == TypeKind.Result) {
      return this.resultDescriptor(type);
    }

    const plain = this.widened(type);
    const known = this.descriptors.get(plain.id);
    if (known != undefined) {
      return known;
    }

    if (this.isHandleType(plain)) {
      return this.handleDescriptor(plain);
    }

    const shape = this.descriptorShape(plain);
    if (shape == undefined) {
      return undefined;
    }

    const name = this.ir.uniqueName("tz.type.");
    const inner = shape.inner ?? this.ir.zero(kPointerType);
    const value = this.ir.constStruct([
      this.ir.integer(kFlagType, `${shape.kind}`),
      this.ir.integer(kFlagType, `${shape.size}`),
      inner,
    ]);
    const global = this.ir.global(name, kDescriptorLayout, value, true);

    this.descriptors.set(plain.id, global);

    return global;
  }

  private handleDescriptor(type: Type): LLVMValue {
    let label = "";

    if (type.kind == TypeKind.Instance) {
      label = type.name;
    }

    const name = this.ir.uniqueName("tz.type.");
    const base = this.ir.constStruct([
      this.ir.integer(kFlagType, `${kHandleKind}`),
      this.ir.integer(kFlagType, "8"),
      this.ir.zero(kPointerType),
    ]);
    const length = Buffer.from(label, "utf8").length;
    const value = this.ir.constStruct([
      base,
      this.cText(label),
      this.ir.integer(kFlagType, `${length}`),
    ]);
    const global = this.ir.global(name, kHandleLayout, value, true);

    this.descriptors.set(type.id, global);

    return global;
  }

  private descriptorShape(type: Type): DescriptorShape | undefined {
    switch (type.kind) {
      case TypeKind.Int:
        return {
          kind: this.integerKind(type.bits, type.unsigned),
          size: type.bits >> 3,
        };
      case TypeKind.Double:
        return { kind: 3, size: 8 };
      case TypeKind.Boolean:
        return { kind: 4, size: 1 };
      case TypeKind.String:
        return { kind: 5, size: 16 };
      case TypeKind.Decimal:
        return { kind: 11, size: 16 };
      case TypeKind.Array: {
        const inner = this.descriptor(type.item);
        if (inner == undefined) {
          return undefined;
        }

        return { kind: 6, size: 8, inner };
      }
      case TypeKind.Undefined:
        return { kind: 8, size: 1 };
      case TypeKind.Instance:
      case TypeKind.Object:
      case TypeKind.Tuple:
      case TypeKind.Dict:
        return { kind: 10, size: 8 };
      case TypeKind.Union:
        return this.unionShape(type);
      default:
        return undefined;
    }
  }

  private unionShape(type: Type): DescriptorShape | undefined {
    if (this.isObjectLike(type)) {
      return { kind: 10, size: 8 };
    }

    return this.optionalShape(type);
  }

  private optionalShape(type: Type): DescriptorShape | undefined {
    const inner = this.optionalInner(type);
    if (inner == undefined) {
      return undefined;
    }

    const described = this.descriptor(inner);
    if (described == undefined) {
      return undefined;
    }

    const size = this.optionalSize(this.widened(inner));

    return { kind: 7, size, inner: described };
  }

  private optionalSize(inner: Type): int {
    if (this.isReferenceLike(inner)) {
      return 8;
    }

    switch (inner.kind) {
      case TypeKind.Int:
        return inner.bits >> 2;
      case TypeKind.Boolean:
        return 2;
      case TypeKind.String:
      case TypeKind.Decimal:
        return 24;
      case TypeKind.Instance:
        return 8;
      default:
        return 16;
    }
  }

  private readonly integerKind(bits: int, isUnsigned: boolean): int {
    switch (bits) {
      case 8:
        return this.choose(isUnsigned, 20, 18);
      case 16:
        return this.choose(isUnsigned, 21, 19);
      case 32:
        return this.choose(isUnsigned, 22, 1);
      default:
        return this.choose(isUnsigned, 23, 2);
    }
  }

  private readonly choose(isFirst: boolean, first: int, second: int): int {
    if (isFirst) {
      return first;
    }

    return second;
  }

  private indexValue(frame: Frame, expr: IndexExpr): IrValue | undefined {
    const object = this.typeIn(frame, expr.object);
    const result = this.typeOf(expr);
    if (object == undefined || result == undefined) {
      this.notLowered(frame.module, expr.loc, "this index");

      return undefined;
    }
    if (this.isString(object)) {
      return this.textIndexed(frame, expr, result);
    }
    if (this.isBytesType(object)) {
      return this.bytesIndexed(frame, expr, result);
    }
    if (object.kind == TypeKind.Tuple) {
      return this.tupleIndexed(frame, expr);
    }
    if (object.kind == TypeKind.Object) {
      return this.keyedIndexed(frame, expr, object);
    }

    const item = this.itemOf(object);
    if (item == undefined || this.irType(item) == undefined) {
      const kind = this.kindName(object);

      this.notLowered(frame.module, expr.loc, `an index on type ${kind}`);

      return undefined;
    }

    const array = this.value(frame, expr.object);
    const index = this.value(frame, expr.index);
    if (array == undefined || index == undefined) {
      return undefined;
    }

    const at = this.toLong(frame, index);
    if (this.optionalInner(result) == undefined) {
      const loaded = this.elementRead(frame, array, at.value, item);

      this.dropping(frame, array);

      return loaded;
    }

    const checked = this.checkedRead(frame, array, at.value, item, result);

    this.dropping(frame, array);

    return checked;
  }

  private readonly itemOf(object: Type): Type | undefined {
    if (object.kind != TypeKind.Array) {
      return undefined;
    }

    return object.item;
  }

  private elementRead(
    frame: Read<Frame>,
    array: IrValue,
    at: LLVMValue,
    item: Type,
  ): IrValue {
    const element = this.irType(item) ?? kPointerType;
    const data = this.arrayData(frame, array.value);
    const address = frame.made.element(element, data, at);
    const value = frame.made.load(element, address);
    const loaded: IrValue = { type: element, value, tz: item };
    if (array.owned != true) {
      return loaded;
    }

    return this.owning(frame, loaded);
  }

  private checkedRead(
    frame: Read<Frame>,
    array: IrValue,
    at: LLVMValue,
    item: Type,
    result: Type,
  ): IrValue {
    const type = this.irType(result) ?? kPointerType;
    const length = this.arrayLength(frame, array.value);
    const isInside = frame.made.integerCompare(
      IrIntPredicate.UnsignedLess,
      at,
      length,
    );
    const before = frame.made.currentBlock();
    const read = frame.made.block("read");
    const end = frame.made.block("read.end");

    frame.made.conditionalBranch(isInside, read, end);
    frame.made.open(read);

    const loaded = this.elementRead(frame, array, at, item);
    const placed = this.somewhere(frame, loaded, result);
    const readEnd = frame.made.currentBlock();

    frame.made.open(end);

    const missing = this.ir.zero(type);
    const value = frame.made.phi(type, [missing, placed.value], [before, readEnd]);

    return { type, value, tz: result, owned: loaded.owned };
  }

  private arrayMember(frame: Frame, expr: MemberExpr): IrValue | undefined {
    const array = this.value(frame, expr.object);
    if (array == undefined) {
      return undefined;
    }

    const length = this.arrayLength(frame, array.value);
    const tz = this.store.integer(64, false);

    this.dropping(frame, array);

    return { type: kIntType, value: length, tz };
  }

  private arrayCall(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
    object: Type,
  ): IrValue | undefined {
    if (object.kind != TypeKind.Array) {
      const name = this.calledName(call);

      this.notLowered(frame.module, call.loc, `a call of method ${name}`);

      return undefined;
    }

    const array = this.value(frame, member.object);
    if (array == undefined) {
      return undefined;
    }

    for (const argument of call.args) {
      const isAdded = this.itemAdded(frame, array.value, argument, object);
      if (!isAdded) {
        return undefined;
      }
    }

    const length = this.arrayLength(frame, array.value);
    const tz = this.store.integer(64, false);

    this.dropping(frame, array);

    return { type: kIntType, value: length, tz };
  }

  private itemAdded(
    frame: Frame,
    array: LLVMValue,
    argument: CallArgument,
    object: Type,
  ): boolean {
    if (object.kind != TypeKind.Array) {
      return false;
    }

    const loc = argument.expr.loc;
    if (argument.spread) {
      const given = this.wantedValue(frame, argument.expr, object);
      const other = this.convertedOrNone(frame, given, object, loc);
      if (other == undefined) {
        return false;
      }

      const params = [kPointerType, kPointerType];
      const appending = this.ir.declare(kArrayAppend, kVoidType, params);

      frame.made.call(appending, [array, other.value]);
      this.dropping(frame, other);

      return true;
    }

    const given = this.wantedValue(frame, argument.expr, object.item);
    const item = this.convertedOrNone(frame, given, object.item, loc);
    if (item == undefined) {
      return false;
    }

    this.pushed(frame, array, item, object.item);

    return true;
  }

  private pushed(
    frame: Read<Frame>,
    array: LLVMValue,
    value: IrValue,
    item: Type,
  ): LLVMValue {
    const element = this.irType(item) ?? kPointerType;
    const owned = this.owning(frame, value);
    const lengthField = this.arrayField(frame, array, kArrayLengthField);
    const capacityField = this.arrayField(frame, array, kArrayCapacityField);
    const length = frame.made.load(kFlagType, lengthField);
    const capacity = frame.made.load(kFlagType, capacityField);
    const one = this.ir.integer(kFlagType, "1");
    const next = frame.made.binary(IrOpcode.Add, length, one);
    const isFull = frame.made.integerCompare(
      IrIntPredicate.UnsignedGreater,
      next,
      capacity,
    );
    const grow = frame.made.block("push.grow");
    const place = frame.made.block("push.store");

    frame.made.conditionalBranch(isFull, grow, place);
    frame.made.open(grow);

    const wanted = frame.made.cast(IrOpcode.ZExt, next, kIntType);
    const growing = this.ir.declare(kArrayGrow, kVoidType, [
      kPointerType,
      kIntType,
    ]);

    frame.made.call(growing, [array, wanted]);
    frame.made.open(place);

    const data = this.arrayData(frame, array);
    const at = frame.made.cast(IrOpcode.ZExt, length, kIntType);
    const address = frame.made.element(element, data, at);

    frame.made.store(owned.value, address);
    frame.made.store(next, lengthField);

    return frame.made.cast(IrOpcode.ZExt, next, kIntType);
  }

  private forOfLoop(frame: Frame, statement: ForOfStmt): void {
    const iterated = this.typeIn(frame, statement.iterable);
    if (iterated != undefined && this.isString(iterated)) {
      return this.textLoop(frame, statement);
    }

    const itemType = this.loopItemType(frame, statement.iterable);
    const binding = statement.binding;
    const isPlain = !statement.isAwait && !statement.keys;
    if (itemType == undefined || !isPlain) {
      return this.notLowered(frame.module, statement.loc, "this loop");
    }

    const iterable = this.store.arrayOf(itemType);

    const cond = frame.made.block("for.of.cond");
    const body = frame.made.block("for.of.body");
    const end = frame.made.block("for.of.end");

    this.openScope(frame);

    const target = this.loopTarget(frame, end, cond);
    const source = this.loopSource(frame, statement.iterable);
    const element = this.irType(itemType);
    if (source == undefined || element == undefined) {
      return;
    }

    const holder: Place = {
      pointer: frame.made.slot(kPointerType, "for.iterable"),
      type: kPointerType,
      tz: iterable,
      owner: frame.id,
    };
    const counter = frame.made.slot(kIntType, "for.index");
    const none = this.ir.zero(kPointerType);

    frame.made.entryStore(none, holder.pointer);
    this.keepPlace(frame, holder);
    this.stored(frame, holder, source);
    frame.made.store(this.ir.zero(kIntType), counter);
    frame.made.open(cond);

    const array = frame.made.load(kPointerType, holder.pointer);
    const index = frame.made.load(kIntType, counter);
    const length = this.arrayLength(frame, array);
    const isInside = frame.made.integerCompare(
      IrIntPredicate.UnsignedLess,
      index,
      length,
    );

    frame.made.conditionalBranch(isInside, body, end);
    frame.made.open(body);
    this.openScope(frame);

    const data = this.arrayData(frame, array);
    const address = frame.made.element(element, data, index);
    const item = frame.made.load(element, address);
    const one = this.ir.integer(kIntType, "1");
    const next = frame.made.binary(IrOpcode.Add, index, one);

    frame.made.store(next, counter);
    this.loopItem(frame, statement, {
      type: element,
      value: item,
      tz: itemType,
    });
    frame.loops.push(target);
    this.statement(frame, statement.body);
    frame.loops.pop();
    this.closeScope(frame);
    this.jumpTo(frame, cond);
    frame.made.open(end);
    this.closeScope(frame);
  }

  private loopItemType(frame: Frame, expr: Expr): Type | undefined {
    const type = this.typeIn(frame, expr);
    const listed = this.listedDict(expr);
    if (listed != undefined) {
      const object = this.typeOf(listed.object);
      if (object == undefined) {
        return undefined;
      }

      return this.dictItemType(object, listed.name == "keys");
    }
    if (type == undefined) {
      return undefined;
    }
    if (type.kind == TypeKind.Array) {
      return type.item;
    }
    if (type.kind == TypeKind.Dict && type.dict == DictKind.Set) {
      return type.key;
    }
    if (type.kind == TypeKind.Dict && type.dict == DictKind.Map) {
      return this.store.plainTuple([type.key, type.value]);
    }

    return undefined;
  }

  private loopSource(frame: Frame, expr: Expr): IrValue | undefined {
    const type = this.typeIn(frame, expr);
    if (type != undefined && type.kind == TypeKind.Dict) {
      if (type.dict == DictKind.Map) {
        return this.dictEntries(frame, expr, type);
      }

      return this.dictItems(frame, expr, true);
    }

    return this.sourceItems(frame, expr);
  }

  private loopItem(frame: Frame, statement: ForOfStmt, item: IrValue): void {
    const binding = statement.binding;
    const variable = this.values.variableOf(frame.module, binding.loc);
    const declared = this.boundOrNone(variable);
    const isUnknown = declared == undefined || declared.kind == TypeKind.Error;
    const place = this.boundPlace(frame, binding, item.tz, isUnknown);
    if (place == undefined) {
      return;
    }

    const value = this.converted(frame, item, place.tz, binding.loc);
    if (value != undefined) {
      this.stored(frame, place, value);
    }
  }
}
