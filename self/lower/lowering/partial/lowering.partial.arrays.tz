import {
  ArrayLitExpr,
  CallArgument,
  CallExpr,
  Expr,
  ExprKind,
  IndexExpr,
  MemberExpr,
  NewExpr,
  NewKind,
} from "../../../program/ast/types/ast.types.expressions.tz";
import {
  TypeContext,
  TypePlace,
} from "../../../semantic/types/type-resolver/types/type-resolver.types.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import {
  IrIntPredicate,
  IrOpcode,
} from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kCountsModule,
  kArrayAppend,
  kArrayCapacityField,
  kArrayClassName,
  kArrayDataField,
  kArrayGrow,
  kArrayGrown,
  kArrayLayout,
  kArrayLengthField,
  kArrayMade,
  kArrayNew,
  kFlagType,
  kIntType,
  kPointerType,
  kVoidType,
} from "../const/lowering.const.tz";
import { Frame, IrValue } from "../types/lowering.types.tz";

partial class Lowering {
  private arrayLiteral(frame: Frame, expr: ArrayLitExpr): IrValue | undefined {
    return this.arrayLiteralOf(frame, expr, this.typeOf(expr));
  }

  private wantedValue(
    frame: Frame,
    expr: Expr,
    wanted: Type,
  ): IrValue | undefined {
    const known = this.typeOf(expr);
    if (known == undefined && expr.kind == ExprKind.ArrayLit) {
      return this.arrayLiteralOf(frame, expr, wanted);
    }
    if (known == undefined && expr.kind == ExprKind.ObjectLit) {
      return this.objectLiteral(frame, expr, wanted);
    }

    const literal = this.wantedText(expr, wanted);
    if (literal != undefined) {
      return literal;
    }

    const isUntypedArray =
      expr.kind == ExprKind.New &&
      wanted.kind == TypeKind.Array &&
      this.madeArrayType(known) == undefined;
    if (isUntypedArray && expr.kind == ExprKind.New) {
      return this.arrayOfLength(frame, expr, wanted);
    }

    return this.value(frame, expr);
  }

  private arrayLiteralOf(
    frame: Frame,
    expr: ArrayLitExpr,
    type: Type | undefined,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const isPlain = tree.elementsOf(expr.elementsList).every(
      (element) => !element.spread && !element.hole,
    );
    if (type != undefined && type.kind == TypeKind.Tuple && isPlain) {
      return this.tupleLiteral(frame, expr, type);
    }

    const hasHoles = tree
      .elementsOf(expr.elementsList)
      .some((element) => element.hole);
    if (type != undefined && type.kind == TypeKind.Array && !hasHoles) {
      if (!isPlain) {
        return this.spreadArray(frame, expr, type);
      }
    }
    if (type == undefined || type.kind != TypeKind.Array || !isPlain) {
      const kind = this.kindName(type);

      this.notLowered(frame.module, expr.loc, `an array literal of ${kind}`);

      return undefined;
    }

    const item = this.values.types.store.itemOf(type);
    const element = this.irType(item);
    const descriptor = this.descriptor(item);
    if (element == undefined || descriptor == undefined) {
      this.notLowered(frame.module, expr.loc, "an array of this type");

      return undefined;
    }

    const count = tree.elementsOf(expr.elementsList).length;
    const array = this.newArray(frame, descriptor, count);
    const data = this.arrayData(frame, array);

    for (let index = 0; index < count; index++) {
      const entry = tree.elementsOf(expr.elementsList)[index];
      if (entry == undefined) {
        continue;
      }

      const exprExpr = tree.exprOf(entry.exprId);
      const given = this.value(frame, exprExpr);
      if (given == undefined) {
        return undefined;
      }

      const value = this.converted(
        frame,
        given,
        item,
        tree.exprOf(entry.exprId).loc,
      );
      if (value == undefined) {
        return undefined;
      }

      const owned = this.owning(frame, value);
      const position = this.ir.integer(kIntType, `${index}`);
      const at = frame.made.element(element, data, position);

      frame.made.store(owned.value, at);
    }

    return { type: kPointerType, value: array, tz: type, owned: true };
  }

  private spreadArray(
    frame: Frame,
    expr: ArrayLitExpr,
    type: Type,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const item = this.itemOf(type);
    if (item == undefined) {
      return undefined;
    }

    const descriptor = this.descriptor(item);
    if (descriptor == undefined) {
      this.notLowered(frame.module, expr.loc, "an array of this type");

      return undefined;
    }

    const array = this.emptyArray(frame, descriptor);

    for (const element of tree.elementsOf(expr.elementsList)) {
      const argument: CallArgument = {
        exprId: element.exprId,
        spread: element.spread,
        hole: false,
      };
      const isAdded = this.itemAdded(frame, array, argument, type);
      if (!isAdded) {
        return undefined;
      }
    }

    return { type: kPointerType, value: array, tz: type, owned: true };
  }

  private arrayOfLength(
    frame: Frame,
    expr: NewExpr,
    type: Type,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const argument = tree.argumentsOf(expr.argsList)[0];
    const item = this.descriptorOfArray(type);
    if (
      argument == undefined ||
      item == undefined ||
      tree.argumentsOf(expr.argsList).length != 1
    ) {
      this.notLowered(frame.module, expr.loc, "this new");

      return undefined;
    }

    const int = this.values.types.store.integer(64, false);
    const exprExpr = tree.exprOf(argument.exprId);
    const given = this.wantedValue(frame, exprExpr, int);
    if (given == undefined) {
      return undefined;
    }

    const count = this.converted(
      frame,
      given,
      int,
      tree.exprOf(argument.exprId).loc,
    );
    if (count == undefined) {
      return undefined;
    }

    const tz = this.values.types.store.integer(64, false);
    const args: IrValue[] = [
      { type: kPointerType, value: item, tz },
      count,
      count,
    ];
    const making = this.arrayMaking();
    const value = this.runtimeValue(frame, making, kPointerType, args);

    return { type: kPointerType, value, tz: type, owned: true };
  }

  private madeArrayType(type: Type | undefined): Type | undefined {
    if (type == undefined) {
      return undefined;
    }
    if (type.kind == TypeKind.Array) {
      return type;
    }

    if (type.kind != TypeKind.Instance || type.name != kArrayClassName) {
      return undefined;
    }

    const item = this.values.types.store.argsOf(type)[0];
    if (item == undefined || this.values.types.store.argsOf(type).length != 1) {
      return undefined;
    }

    return this.values.types.store.arrayOf(item);
  }

  private writtenArrayType(
    frame: Read<Frame>,
    expr: NewExpr,
  ): Type | undefined {
    const tree = this.values.types.program.tree;

    const form = expr.form;
    const written = tree.typeRefsOf(expr.typeArgsList)[0];
    const isArray =
      form.kind == NewKind.Named &&
      form.name == kArrayClassName &&
      form.member == undefined;
    if (
      !isArray ||
      written == undefined ||
      tree.typeRefsOf(expr.typeArgsList).length != 1
    ) {
      return undefined;
    }

    const context: TypeContext = {
      module: frame.module,
      bindings: new Map<int, Type>(this.binding),
      place: TypePlace.Plain,
    };
    const item = this.values.types.resolve(written, context);
    if (item.kind == TypeKind.Error) {
      return undefined;
    }

    return this.values.types.store.arrayOf(item);
  }

  private descriptorOfArray(type: Type): LLVMValue | undefined {
    if (type.kind != TypeKind.Array) {
      return undefined;
    }

    return this.descriptor(this.values.types.store.itemOf(type));
  }

  private newArray(
    frame: Read<Frame>,
    descriptor: LLVMValue,
    count: int,
  ): LLVMValue {
    const tz = this.values.types.store.integer(64, false);
    const size = this.ir.integer(kIntType, `${count}`);
    const args: IrValue[] = [
      { type: kPointerType, value: descriptor, tz },
      { type: kIntType, value: size, tz },
      { type: kIntType, value: size, tz },
    ];

    return this.runtimeValue(frame, this.arrayMaking(), kPointerType, args);
  }

  private arrayMaking(): string {
    return this.runtimeHelperName(kCountsModule, kArrayMade, kArrayNew);
  }

  private readonly arrayField(
    frame: Read<Frame>,
    array: LLVMValue,
    field: int,
  ): LLVMValue {
    return frame.made.field(kArrayLayout, array, field);
  }

  private readonly arrayData(frame: Read<Frame>, array: LLVMValue): LLVMValue {
    const field = this.arrayField(frame, array, kArrayDataField);

    return frame.made.load(kPointerType, field);
  }

  private readonly arrayLength(
    frame: Read<Frame>,
    array: LLVMValue,
  ): LLVMValue {
    const field = this.arrayField(frame, array, kArrayLengthField);
    const short = frame.made.load(kFlagType, field);

    return frame.made.cast(IrOpcode.ZExt, short, kIntType);
  }

  private readonly choose(isFirst: boolean, first: int, second: int): int {
    if (isFirst) {
      return first;
    }

    return second;
  }

  private indexValue(frame: Frame, expr: IndexExpr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const objectExpr = tree.exprOf(expr.objectId);
    const object = this.typeIn(frame, objectExpr);
    const result = this.typeOf(expr);
    if (object == undefined || result == undefined) {
      this.notLowered(frame.module, expr.loc, "this index");

      return undefined;
    }
    if (this.isString(object)) {
      return this.textIndexed(frame, expr, result);
    }
    if (this.isBytesType(object)) {
      return this.bytesIndexed(frame, expr, result);
    }
    if (object.kind == TypeKind.Tuple) {
      return this.tupleIndexed(frame, expr);
    }
    if (object.kind == TypeKind.Object) {
      return this.keyedIndexed(frame, expr, object);
    }

    const item = this.itemOf(object);
    if (item == undefined || this.irType(item) == undefined) {
      const kind = this.kindName(object);

      this.notLowered(frame.module, expr.loc, `an index on type ${kind}`);

      return undefined;
    }

    const exprObject = tree.exprOf(expr.objectId);
    const array = this.value(frame, exprObject);
    const indexExpr = tree.exprOf(expr.indexId);
    const index = this.value(frame, indexExpr);
    if (array == undefined || index == undefined) {
      return undefined;
    }

    const at = this.toLong(frame, index);
    if (this.optionalInner(result) == undefined) {
      const loaded = this.elementRead(frame, array, at.value, item);

      this.dropping(frame, array);

      return loaded;
    }

    const checked = this.checkedRead(frame, array, at.value, item, result);

    this.dropping(frame, array);

    return checked;
  }

  private readonly itemOf(object: Type): Type | undefined {
    if (object.kind != TypeKind.Array) {
      return undefined;
    }

    return this.values.types.store.itemOf(object);
  }

  private elementRead(
    frame: Read<Frame>,
    array: IrValue,
    at: LLVMValue,
    item: Type,
  ): IrValue {
    const element = this.irType(item) ?? kPointerType;
    const data = this.arrayData(frame, array.value);
    const address = frame.made.element(element, data, at);
    const value = frame.made.load(element, address);
    const loaded: IrValue = { type: element, value, tz: item };
    if (array.owned != true && array.isStatic == true) {
      return this.staticValue(loaded);
    }
    if (array.owned != true) {
      return loaded;
    }
    if (this.isSingleOwner(loaded) && this.isSingleOwner(array)) {
      frame.made.store(this.ir.zero(element), address);

      return { type: element, value, tz: item, owned: true };
    }

    return this.owning(frame, loaded);
  }

  private checkedRead(
    frame: Read<Frame>,
    array: IrValue,
    at: LLVMValue,
    item: Type,
    result: Type,
  ): IrValue {
    const type = this.irType(result) ?? kPointerType;
    const length = this.arrayLength(frame, array.value);
    const isInside = frame.made.integerCompare(
      IrIntPredicate.UnsignedLess,
      at,
      length,
    );
    const before = frame.made.currentBlock();
    const read = frame.made.block("read");
    const end = frame.made.block("read.end");

    frame.made.conditionalBranch(isInside, read, end);
    frame.made.open(read);

    const loaded = this.elementRead(frame, array, at, item);
    const placed = this.somewhere(frame, loaded, result);
    const readEnd = frame.made.currentBlock();

    frame.made.open(end);

    const missing = this.ir.zero(type);
    const value = frame.made.phi(
      type,
      [missing, placed.value],
      [before, readEnd],
    );

    return { type, value, tz: result, owned: loaded.owned };
  }

  private arrayMember(frame: Frame, expr: MemberExpr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const object = tree.exprOf(expr.objectId);
    const array = this.value(frame, object);
    if (array == undefined) {
      return undefined;
    }

    const length = this.arrayLength(frame, array.value);
    const tz = this.values.types.store.integer(64, false);

    this.dropping(frame, array);

    return { type: kIntType, value: length, tz };
  }

  private arrayCall(
    frame: Frame,
    call: CallExpr,
    member: MemberExpr,
    object: Type,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    if (object.kind != TypeKind.Array) {
      const name = this.calledName(call);

      this.notLowered(frame.module, call.loc, `a call of method ${name}`);

      return undefined;
    }

    const objectExpr = tree.exprOf(member.objectId);
    const array = this.value(frame, objectExpr);
    if (array == undefined) {
      return undefined;
    }

    for (const argument of tree.argumentsOf(call.argsList)) {
      const isAdded = this.itemAdded(frame, array.value, argument, object);
      if (!isAdded) {
        return undefined;
      }
    }

    const length = this.arrayLength(frame, array.value);
    const tz = this.values.types.store.integer(64, false);

    this.dropping(frame, array);

    return { type: kIntType, value: length, tz };
  }

  private itemAdded(
    frame: Frame,
    array: LLVMValue,
    argument: CallArgument,
    object: Type,
  ): boolean {
    const tree = this.values.types.program.tree;

    if (object.kind != TypeKind.Array) {
      return false;
    }

    const loc = tree.exprOf(argument.exprId).loc;
    if (argument.spread) {
      const given = this.wantedValue(
        frame,
        tree.exprOf(argument.exprId),
        object,
      );
      const other = this.convertedOrNone(frame, given, object, loc);
      if (other == undefined) {
        return false;
      }

      const params = [kPointerType, kPointerType];
      const appendingName = this.countsHelper(kArrayAppend);
      const appending = this.ir.declare(appendingName, kVoidType, params);

      frame.made.call(appending, [array, other.value]);
      this.dropping(frame, other);

      return true;
    }

    const given = this.wantedValue(
      frame,
      tree.exprOf(argument.exprId),
      this.values.types.store.itemOf(object),
    );
    const item = this.convertedOrNone(
      frame,
      given,
      this.values.types.store.itemOf(object),
      loc,
    );
    if (item == undefined) {
      return false;
    }
    if (this.isLookingArray(object)) {
      const looked: IrValue = {
        type: item.type,
        value: item.value,
        tz: item.tz,
        owned: true,
      };

      this.pushed(frame, array, looked, this.values.types.store.itemOf(object));

      return true;
    }

    this.pushed(frame, array, item, this.values.types.store.itemOf(object));

    return true;
  }

  private pushed(
    frame: Read<Frame>,
    array: LLVMValue,
    value: IrValue,
    item: Type,
  ): LLVMValue {
    const element = this.irType(item) ?? kPointerType;
    const owned = this.owning(frame, value);
    const lengthField = this.arrayField(frame, array, kArrayLengthField);
    const capacityField = this.arrayField(frame, array, kArrayCapacityField);
    const length = frame.made.load(kFlagType, lengthField);
    const capacity = frame.made.load(kFlagType, capacityField);
    const one = this.ir.integer(kFlagType, "1");
    const next = frame.made.binary(IrOpcode.Add, length, one);
    const isFull = frame.made.integerCompare(
      IrIntPredicate.UnsignedGreater,
      next,
      capacity,
    );
    const grow = frame.made.block("push.grow");
    const place = frame.made.block("push.store");

    frame.made.conditionalBranch(isFull, grow, place);
    frame.made.open(grow);

    const wanted = frame.made.cast(IrOpcode.ZExt, next, kIntType);
    const growName = this.runtimeHelperName(
      kCountsModule,
      kArrayGrown,
      kArrayGrow,
    );
    const growing = this.ir.declare(growName, kVoidType, [
      kPointerType,
      kIntType,
    ]);

    frame.made.call(growing, [array, wanted]);
    frame.made.open(place);

    const data = this.arrayData(frame, array);
    const at = frame.made.cast(IrOpcode.ZExt, length, kIntType);
    const address = frame.made.element(element, data, at);

    frame.made.store(owned.value, address);
    frame.made.store(next, lengthField);

    return frame.made.cast(IrOpcode.ZExt, next, kIntType);
  }
}
