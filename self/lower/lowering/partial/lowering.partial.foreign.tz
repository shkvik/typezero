import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../program/ast/types/ast.types.functions.tz";
import { StmtKind } from "../../../program/ast/types/ast.types.statements.tz";
import {
  FunctionShape,
  Type,
  TypeKind,
} from "../../../program/type/types/type.types.tz";
import { IrIntPredicate } from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kBooleanType,
  kBuffersModule,
  kByteType,
  kCountsModule,
  kBytesDataField,
  kBytesNames,
  kBytesStruct,
  kCStringCopied,
  kCStringCopy,
  kCStringFromText,
  kCStringLayoutFlag,
  kCStringName,
  kCStringTextOffset,
  kFfiModule,
  kWideCells,
  kWideName,
  kDoubleType,
  kForeignNullText,
  kForeverCount,
  kFlagType,
  kIntType,
  kLayoutHead,
  kObjectFree,
  kObjectFreed,
  kPointerType,
  kVoidType,
} from "../const/lowering.const.tz";
import { Frame, IrValue } from "../types/lowering.types.tz";

partial class Lowering {
  private isHandleType(type: Type): boolean {
    const tree = this.values.types.program.tree;

    if (type.kind != TypeKind.Instance) {
      return false;
    }

    const known = this.handles.get(type.id);
    if (known != undefined) {
      return known;
    }

    const opened = this.values.types.program.modules[type.module];
    const loc = type.loc;
    const isHandle =
      opened != undefined &&
      tree
        .stmtsOf(opened.file.itemsList)
        .some((item) => item.kind == StmtKind.Handle && item.loc == loc);

    this.handles.set(type.id, isHandle);

    return isHandle;
  }

  private readonly isCString(type: Type): boolean {
    const opened = this.values.types.program.modules[this.typeModule(type)];

    return (
      type.kind == TypeKind.Instance &&
      type.name == kCStringName &&
      opened != undefined &&
      opened.source.isLibrary
    );
  }

  private readonly typeModule(type: Type): int {
    if (type.kind != TypeKind.Instance) {
      return -1;
    }

    return type.module;
  }

  private readonly isBytesType(type: Type): boolean {
    if (type.kind != TypeKind.Instance) {
      return false;
    }

    const opened = this.values.types.program.modules[type.module];

    return (
      opened != undefined &&
      opened.source.isLibrary &&
      kBytesNames.includes(type.name)
    );
  }

  private readonly bytesData(frame: Read<Frame>, bytes: LLVMValue): LLVMValue {
    const field = frame.made.field(kBytesStruct, bytes, kBytesDataField);

    return frame.made.load(kPointerType, field);
  }

  private readonly declaredFunction(
    module: int,
    loc: int,
  ): FunctionDecl | undefined {
    const tree = this.values.types.program.tree;

    const opened = this.values.types.program.modules[module];
    if (opened == undefined) {
      return undefined;
    }

    for (const item of tree.stmtsOf(opened.file.itemsList)) {
      if (item.kind == StmtKind.Function && item.loc == loc) {
        return item;
      }
    }

    return undefined;
  }

  private cstringLiteral(text: string, tz: Type): IrValue {
    const known = this.cstrings.get(text);
    if (known != undefined) {
      return { type: kPointerType, value: known, tz };
    }

    const bytes = Buffer.from(text, "utf8");
    const layout = this.cstringLayout();
    const data = this.ir.bytes(bytes, true);
    const array = `[${bytes.length + 1} x i8]`;
    const value = this.ir.constStruct([
      this.ir.hexInteger(kIntType, kForeverCount),
      layout,
      this.ir.integer(kIntType, `${bytes.length}`),
      data,
    ]);
    const name = this.ir.uniqueName("tz.cstring.");
    const struct = `{ i64, ptr, i64, ${array} }`;
    const global = this.ir.global(name, struct, value, false);

    this.cstrings.set(text, global);

    return { type: kPointerType, value: global, tz };
  }

  private definedOf(type: Type): Type {
    const inner = this.optionalInner(type);
    if (inner == undefined) {
      return type;
    }

    return inner;
  }

  private wantedText(expr: Expr, wanted: Type): IrValue | undefined {
    const inner = this.definedOf(wanted);
    if (expr.kind != ExprKind.StringLit || !this.isCString(inner)) {
      return undefined;
    }

    return this.cstringLiteral(expr.value, inner);
  }

  private foreignCall(
    frame: Frame,
    call: CallExpr,
    fn: FunctionDecl,
    shape: Read<FunctionShape>,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const given: IrValue[] = [];
    const args: LLVMValue[] = [];
    const params: string[] = [];

    for (let index = 0; index < shape.params.length; index++) {
      const param = shape.params[index];
      const argument = tree.argumentsOf(call.argsList)[index];
      if (param == undefined) {
        return undefined;
      }

      const wanted = this.passedType(param);
      const expr = tree.exprAt(argument?.exprId);
      if (expr != undefined && this.isInPlace(wanted)) {
        const address = this.recordForeign(frame, expr, wanted, given);
        if (address == undefined) {
          return undefined;
        }

        args.push(address);
        params.push(kPointerType);

        continue;
      }

      const value = this.foreignArgument(frame, expr, wanted, call.loc);
      if (value == undefined) {
        return undefined;
      }

      given.push(value);
      args.push(this.foreignValue(frame, value));
      params.push(this.foreignType(wanted));
    }

    const result = shape.result;
    const returned = this.foreignType(result);
    const callee = this.ir.declare(fn.name, returned, params);
    const value = frame.made.call(callee, args);

    for (const one of given) {
      this.dropping(frame, one);
    }

    return this.foreignResult(frame, fn, result, value);
  }

  private foreignArgument(
    frame: Frame,
    expr: Expr | undefined,
    wanted: Type,
    loc: int,
  ): IrValue | undefined {
    if (expr == undefined) {
      const type = this.irType(wanted);
      if (type == undefined) {
        return undefined;
      }

      return { type, value: this.ir.zero(type), tz: wanted };
    }

    const literal = this.wantedText(expr, wanted);
    if (literal != undefined) {
      return literal;
    }

    const given = this.wantedValue(frame, expr, wanted);
    if (given == undefined) {
      return undefined;
    }

    const value = this.converted(frame, given, wanted, loc);
    if (value == undefined) {
      return undefined;
    }

    return value;
  }

  private foreignValue(frame: Read<Frame>, value: IrValue): LLVMValue {
    const type = this.definedOf(value.tz);
    if (this.isWideText(type)) {
      return this.wideCells(frame, value.value, type);
    }
    if (this.isCString(type)) {
      const none = this.ir.zero(kPointerType);
      const isAbsent = frame.made.integerCompare(
        IrIntPredicate.Equal,
        value.value,
        none,
      );
      const offset = this.ir.integer(kIntType, `${kCStringTextOffset}`);
      const text = frame.made.element(kByteType, value.value, offset);

      return frame.made.select(isAbsent, none, text);
    }
    if (type.kind == TypeKind.Array) {
      return this.arrayData(frame, value.value);
    }
    if (this.isBytesType(type)) {
      return this.bytesData(frame, value.value);
    }

    return value.value;
  }

  private readonly foreignType(type: Type): string {
    const plain = this.widened(type);

    switch (plain.kind) {
      case TypeKind.Void:
        return kVoidType;
      case TypeKind.Boolean:
        return kBooleanType;
      case TypeKind.Int:
        return `i${plain.bits}`;
      case TypeKind.Double:
        return kDoubleType;
      default:
        return kPointerType;
    }
  }

  private foreignResult(
    frame: Read<Frame>,
    fn: FunctionDecl,
    result: Type,
    value: LLVMValue,
  ): IrValue | undefined {
    const type = this.irType(result);
    if (type == undefined) {
      return undefined;
    }

    const isOptional = this.optionalInner(result) != undefined;
    const target = this.definedOf(result);
    if (this.isCString(target)) {
      const copied = this.cstringCopied(frame, value, isOptional, fn);

      return { type, value: copied, tz: result, owned: true };
    }
    if (this.isHandleType(target) && !isOptional) {
      this.notNullChecked(frame, value, fn);
    }

    return { type, value, tz: result, owned: true };
  }

  private cstringCopied(
    frame: Read<Frame>,
    value: LLVMValue,
    isOptional: boolean,
    fn: FunctionDecl,
  ): LLVMValue {
    if (!isOptional) {
      this.notNullChecked(frame, value, fn);

      return this.cstringCopyMade(frame, value);
    }

    const none = this.ir.zero(kPointerType);
    const isAbsent = frame.made.integerCompare(
      IrIntPredicate.Equal,
      value,
      none,
    );
    const before = frame.made.currentBlock();
    const copy = frame.made.block("foreign.copy");
    const end = frame.made.block("foreign.copied");

    frame.made.conditionalBranch(isAbsent, end, copy);
    frame.made.open(copy);

    const copied = this.cstringCopyMade(frame, value);
    const copyEnd = frame.made.currentBlock();

    frame.made.branch(end);
    frame.made.open(end);

    return frame.made.phi(kPointerType, [none, copied], [before, copyEnd]);
  }

  private cstringLayout(): LLVMValue {
    const known = this.cstringLayoutGlobal;
    if (known != undefined) {
      return known;
    }

    const freeName = this.runtimeHelperName(
      kCountsModule,
      kObjectFreed,
      kObjectFree,
    );
    const freeing = this.ir.declare(freeName, kVoidType, [kPointerType]);
    const none = this.ir.zero(kPointerType);
    const head = this.ir.constStruct([
      freeing.fn,
      none,
      this.ir.integer(kFlagType, "0"),
      this.ir.integer(kFlagType, `${kCStringLayoutFlag}`),
      this.cText(kCStringName),
      this.ir.integer(kFlagType, `${kCStringName.length}`),
      this.ir.integer(kFlagType, "0"),
    ]);
    const name = this.ir.uniqueName("tz.layout.cstring.");
    const global = this.ir.global(name, kLayoutHead, head, true);

    this.cstringLayoutGlobal = global;

    return global;
  }

  private cstringCopyMade(frame: Read<Frame>, value: LLVMValue): LLVMValue {
    const name = this.runtimeHelperName(
      kBuffersModule,
      kCStringCopied,
      kCStringCopy,
    );
    if (name == kCStringCopy) {
      const copying = this.ir.declare(name, kPointerType, [kPointerType]);

      return frame.made.call(copying, [value]);
    }

    const layout = this.cstringLayout();
    const params = [kPointerType, kPointerType];
    const copying = this.ir.declare(name, kPointerType, params);

    return frame.made.call(copying, [value, layout]);
  }

  private notNullChecked(
    frame: Read<Frame>,
    value: LLVMValue,
    fn: FunctionDecl,
  ): void {
    const none = this.ir.zero(kPointerType);
    const isNull = frame.made.integerCompare(IrIntPredicate.Equal, value, none);
    const bad = frame.made.block("foreign.null");
    const good = frame.made.block("foreign.value");

    frame.made.conditionalBranch(isNull, bad, good);
    frame.made.open(bad);

    const message = `${fn.name}${kForeignNullText}`;

    this.panic(frame, message);
    frame.made.unreachable();
    frame.made.open(good);
  }

  private recordForeign(
    frame: Frame,
    expr: Expr,
    wanted: Type,
    given: IrValue[],
  ): LLVMValue | undefined {
    const address = this.recordPlace(frame, expr);
    if (address != undefined) {
      return address;
    }

    const value = this.foreignArgument(frame, expr, wanted, expr.loc);
    if (value == undefined) {
      return undefined;
    }

    const slot = frame.made.slot(value.type, "record.foreign");

    frame.made.store(value.value, slot);
    given.push(value);

    return slot;
  }

  private readonly isWideText(type: Type): boolean {
    if (type.kind != TypeKind.Instance || type.name != kWideName) {
      return false;
    }

    const opened = this.values.types.program.modules[type.module];

    return opened != undefined && opened.name == kFfiModule;
  }

  private wideCells(
    frame: Read<Frame>,
    object: LLVMValue,
    type: Type,
  ): LLVMValue {
    const layout = this.layoutOf(type);
    if (layout == undefined) {
      return this.ir.zero(kPointerType);
    }

    const field = this.fieldsOf(layout).find((one) => one.name == kWideCells);
    if (field == undefined) {
      return this.ir.zero(kPointerType);
    }

    const address = frame.made.field(layout.struct, object, field.index);

    return frame.made.load(kPointerType, address);
  }
}
