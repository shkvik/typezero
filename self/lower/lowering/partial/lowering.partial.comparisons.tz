import {
  BinaryExpr,
  BinaryOp,
  ExprKind,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { TypeKind } from "../../../program/type/types/type.types.tz";
import {
  IrIntPredicate,
  IrOpcode,
  IrRealPredicate,
} from "../../ir-function/types/ir-function.types.tz";
import { LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import {
  kBooleanType,
  kFlagType,
  kIntType,
  kPointerType,
  kTextModule,
  kWideType,
} from "../const/lowering.const.tz";
import { Frame, IrValue, RuntimeTarget } from "../types/lowering.types.tz";

partial class Lowering {
  private comparison(frame: Frame, expr: BinaryExpr): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const lhs = tree.exprOf(expr.lhsId);
    const left = this.value(frame, lhs);
    const rhs = tree.exprOf(expr.rhsId);
    const right = this.value(frame, rhs);
    if (left == undefined || right == undefined) {
      return undefined;
    }

    const tz = this.values.types.store.plain(TypeKind.Boolean);
    const value = this.compared(frame, expr, left, right);
    if (value == undefined) {
      return undefined;
    }

    this.dropping(frame, left);
    this.dropping(frame, right);

    return { type: kBooleanType, value, tz };
  }

  private compared(
    frame: Frame,
    expr: BinaryExpr,
    left: IrValue,
    right: IrValue,
  ): LLVMValue | undefined {
    if (right.tz.kind == TypeKind.Undefined) {
      return this.emptyCompared(frame, expr.op, left);
    }
    if (left.tz.kind == TypeKind.Undefined) {
      return this.emptyCompared(frame, expr.op, right);
    }
    if (this.isJsonish(left.tz) || this.isJsonish(right.tz)) {
      return this.jsonCompared(frame, expr, left, right);
    }
    if (this.isDecimal(left.tz) || this.isDecimal(right.tz)) {
      return this.decimalsCompared(frame, expr.op, left, right);
    }

    const isNumber =
      (this.isInteger(left.tz) || this.isDouble(left.tz)) &&
      (this.isInteger(right.tz) || this.isDouble(right.tz));
    if (isNumber) {
      return this.numbersCompared(frame, expr, left, right);
    }

    const isEquality = expr.op == BinaryOp.Eq || expr.op == BinaryOp.Ne;
    if (isEquality && this.isBoolean(left.tz) && this.isBoolean(right.tz)) {
      const predicate = this.integerPredicate(expr.op, false);

      return frame.made.integerCompare(predicate, left.value, right.value);
    }
    if (this.isString(left.tz) && this.isString(right.tz)) {
      return this.stringsCompared(frame, expr.op, left, right);
    }

    if (isEquality && this.hasEquals(left, right)) {
      return this.recordsEqual(frame, expr, left, right);
    }

    const isReference = left.type == kPointerType && right.type == kPointerType;
    if (isEquality && isReference) {
      const predicate = this.integerPredicate(expr.op, false);

      return frame.made.integerCompare(predicate, left.value, right.value);
    }

    const leftInner = this.optionalInner(left.tz);
    const rightInner = this.optionalInner(right.tz);
    const isOptional = leftInner != undefined || rightInner != undefined;
    if (isEquality && isOptional) {
      return this.optionalsCompared(frame, expr, left, right);
    }

    const first = this.kindName(left.tz);
    const second = this.kindName(right.tz);
    const form = `a comparison of ${first} and ${second}`;

    this.notLowered(frame.module, expr.loc, form);

    return undefined;
  }

  private emptyCompared(
    frame: Read<Frame>,
    op: BinaryOp,
    value: IrValue,
  ): LLVMValue {
    const yes = this.ir.integer(kBooleanType, "1");
    let has: LLVMValue = yes;

    if (this.optionalInner(value.tz) != undefined) {
      has = this.hasValue(frame, value);
    }
    if (op == BinaryOp.Ne) {
      return has;
    }

    return frame.made.binary(IrOpcode.Xor, has, yes);
  }

  private optionalsCompared(
    frame: Frame,
    expr: BinaryExpr,
    left: IrValue,
    right: IrValue,
  ): LLVMValue | undefined {
    const tree = this.values.types.program.tree;

    const leftHas = this.hasValue(frame, left);
    const rightHas = this.hasValue(frame, right);
    const first = this.presentPart(frame, left);
    const second = this.presentPart(frame, right);
    const same: BinaryExpr = {
      kind: ExprKind.Binary,
      id: expr.id,
      loc: expr.loc,
      op: BinaryOp.Eq,
      lhsId: expr.lhsId,
      rhsId: expr.rhsId,
    };
    const isInnerEqual = this.compared(frame, same, first, second);
    if (isInnerEqual == undefined) {
      return undefined;
    }

    const isBothSet = frame.made.binary(IrOpcode.And, leftHas, rightHas);
    const isNoneSet = frame.made.binary(IrOpcode.Or, leftHas, rightHas);
    const yes = this.ir.integer(kBooleanType, "1");
    const isBothEmpty = frame.made.binary(IrOpcode.Xor, isNoneSet, yes);
    const isMatch = frame.made.binary(IrOpcode.And, isBothSet, isInnerEqual);
    const isEqual = frame.made.binary(IrOpcode.Or, isMatch, isBothEmpty);
    if (expr.op == BinaryOp.Eq) {
      return isEqual;
    }

    return frame.made.binary(IrOpcode.Xor, isEqual, yes);
  }

  private presentPart(frame: Read<Frame>, value: IrValue): IrValue {
    const inner = this.optionalInner(value.tz);
    if (inner == undefined) {
      return value;
    }

    const inside = this.insideValue(frame, value, inner);

    return { type: inside.type, value: inside.value, tz: inside.tz };
  }

  private numbersCompared(
    frame: Frame,
    expr: BinaryExpr,
    left: IrValue,
    right: IrValue,
  ): LLVMValue | undefined {
    const tree = this.values.types.program.tree;

    if (this.isDouble(left.tz) || this.isDouble(right.tz)) {
      const double = this.values.types.store.plain(TypeKind.Double);
      const first = this.converted(
        frame,
        left,
        double,
        tree.exprOf(expr.lhsId).loc,
      );
      const second = this.converted(
        frame,
        right,
        double,
        tree.exprOf(expr.rhsId).loc,
      );
      if (first == undefined || second == undefined) {
        return undefined;
      }

      const predicate = this.doublePredicate(expr.op);

      return frame.made.realCompare(predicate, first.value, second.value);
    }
    if (left.type == right.type && this.sameSign(left, right)) {
      const isUnsigned = this.isUnsigned(left.tz);
      const predicate = this.integerPredicate(expr.op, isUnsigned);

      return frame.made.integerCompare(predicate, left.value, right.value);
    }

    const first = this.wide(frame, left);
    const second = this.wide(frame, right);
    const predicate = this.integerPredicate(expr.op, false);

    return frame.made.integerCompare(predicate, first, second);
  }

  private readonly sameSign(left: IrValue, right: IrValue): boolean {
    return this.isUnsigned(left.tz) == this.isUnsigned(right.tz);
  }

  private readonly wide(frame: Read<Frame>, value: IrValue): LLVMValue {
    const opcode = this.resizing(this.bitsOf(value.tz), 65, value.tz);

    return frame.made.cast(opcode, value.value, kWideType);
  }

  private stringsCompared(
    frame: Read<Frame>,
    op: BinaryOp,
    left: IrValue,
    right: IrValue,
  ): LLVMValue {
    const isEquality = op == BinaryOp.Eq || op == BinaryOp.Ne;
    const loc = this.statementLoc;
    if (isEquality) {
      const target: RuntimeTarget = { module: kTextModule, name: "equals" };
      const args = [left, right];
      const found = this.runtimeFunctionCall(frame, target, [], args, loc);
      const truth = this.ir.integer(kBooleanType, "1");
      const equal = found?.value ?? truth;
      if (op == BinaryOp.Eq) {
        return equal;
      }

      return frame.made.binary(IrOpcode.Xor, equal, truth);
    }

    const target: RuntimeTarget = { module: kTextModule, name: "compare" };
    const args = [left, right];
    const found = this.runtimeFunctionCall(frame, target, [], args, loc);
    const zero = this.ir.zero(kIntType);
    const order = found?.value ?? zero;
    const predicate = this.integerPredicate(op, false);

    return frame.made.integerCompare(predicate, order, zero);
  }

  private readonly equalFlagPredicate(op: BinaryOp): IrIntPredicate {
    if (op == BinaryOp.Eq) {
      return IrIntPredicate.NotEqual;
    }

    return IrIntPredicate.Equal;
  }

  private readonly doublePredicate(op: BinaryOp): IrRealPredicate {
    switch (op) {
      case BinaryOp.Lt:
        return IrRealPredicate.OrderedLess;
      case BinaryOp.Le:
        return IrRealPredicate.OrderedLessOrEqual;
      case BinaryOp.Gt:
        return IrRealPredicate.OrderedGreater;
      case BinaryOp.Ge:
        return IrRealPredicate.OrderedGreaterOrEqual;
      case BinaryOp.Eq:
        return IrRealPredicate.OrderedEqual;
      default:
        return IrRealPredicate.UnorderedNotEqual;
    }
  }

  private readonly integerPredicate(
    op: BinaryOp,
    isUnsigned: boolean,
  ): IrIntPredicate {
    switch (op) {
      case BinaryOp.Lt:
        return this.predicateFor(
          isUnsigned,
          IrIntPredicate.UnsignedLess,
          IrIntPredicate.SignedLess,
        );
      case BinaryOp.Le:
        return this.predicateFor(
          isUnsigned,
          IrIntPredicate.UnsignedLessOrEqual,
          IrIntPredicate.SignedLessOrEqual,
        );
      case BinaryOp.Gt:
        return this.predicateFor(
          isUnsigned,
          IrIntPredicate.UnsignedGreater,
          IrIntPredicate.SignedGreater,
        );
      case BinaryOp.Ge:
        return this.predicateFor(
          isUnsigned,
          IrIntPredicate.UnsignedGreaterOrEqual,
          IrIntPredicate.SignedGreaterOrEqual,
        );
      case BinaryOp.Eq:
        return IrIntPredicate.Equal;
      default:
        return IrIntPredicate.NotEqual;
    }
  }

  private readonly predicateFor(
    isFirst: boolean,
    first: IrIntPredicate,
    second: IrIntPredicate,
  ): IrIntPredicate {
    if (isFirst) {
      return first;
    }

    return second;
  }
}
