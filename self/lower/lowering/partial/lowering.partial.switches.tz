import {
  BinaryExpr,
  BinaryOp,
  Expr,
  ExprKind,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { SwitchStmt } from "../../../program/ast/types/ast.types.statements.tz";
import { LLVMBlock, LLVMValue } from "../../llvm-api/llvm-api.tz";
import { Lowering } from "../lowering.tz";
import { kSubjectName } from "../const/lowering.const.tz";
import { Frame, LoopTarget, Place } from "../types/lowering.types.tz";
import {
  SyntheticNode,
} from "../../../program/ast/ast-tree/types/ast-tree.types.synthetic.tz";

partial class Lowering {
  private switchStatement(frame: Frame, statement: SwitchStmt): void {
    const tree = this.values.types.program.tree;

    const end = frame.made.block("switch.end");
    const bodies = tree
      .casesOf(statement.casesList)
      .map(() => frame.made.block("switch.case"));

    this.openScope(frame);

    const subject = this.switchSubject(
      frame,
      tree.exprOf(statement.discriminantId),
    );
    if (subject == undefined) {
      return;
    }

    let missed: LLVMBlock = end;

    for (
      let index = 0;
      index < tree.casesOf(statement.casesList).length;
      index++
    ) {
      const test = tree.exprAt(
        tree.casesOf(statement.casesList)[index]?.testId,
      );
      const body = bodies[index];
      if (body == undefined) {
        continue;
      }
      if (test == undefined) {
        missed = body;

        continue;
      }

      const isMatch = this.caseTest(frame, statement, subject, test);
      if (isMatch == undefined) {
        return;
      }

      const next = frame.made.block("switch.next");

      frame.made.conditionalBranch(isMatch, body, next);
      frame.made.open(next);
    }

    frame.made.branch(missed);
    this.caseBodies(frame, statement, bodies, end);
    frame.made.open(end);
    this.closeScope(frame);
  }

  private switchSubject(frame: Frame, expr: Expr): Place | undefined {
    const given = this.value(frame, expr);
    if (given == undefined) {
      return undefined;
    }

    const pointer = frame.made.slot(given.type, kSubjectName);
    const place: Place = {
      pointer,
      type: given.type,
      tz: given.tz,
      owner: frame.id,
    };

    frame.made.entryStore(this.ir.zero(given.type), pointer);
    this.keepPlace(frame, place);
    this.stored(frame, place, given);

    return place;
  }

  private caseTest(
    frame: Frame,
    statement: SwitchStmt,
    subject: Place,
    test: Expr,
  ): LLVMValue | undefined {
    const tree = this.values.types.program.tree;

    const left = this.loaded(frame, subject);
    const right = this.value(frame, test);
    if (right == undefined) {
      return undefined;
    }

    const id = tree.syntheticId(SyntheticNode.CaseTest, test.id);
    const expr: BinaryExpr = {
      kind: ExprKind.Binary,
      id,
      loc: test.loc,
      op: BinaryOp.Eq,
      lhsId: statement.discriminantId,
      rhsId: test.id,
    };
    const isMatch = this.compared(frame, expr, left, right);

    this.dropping(frame, right);

    return isMatch;
  }

  private caseBodies(
    frame: Frame,
    statement: SwitchStmt,
    bodies: Read<LLVMBlock[]>,
    end: LLVMBlock,
  ): void {
    const tree = this.values.types.program.tree;

    const target: LoopTarget = {
      breakBlock: end,
      label: "",
      depth: frame.scopes.length,
    };

    frame.loops.push(target);

    for (
      let index = 0;
      index < tree.casesOf(statement.casesList).length;
      index++
    ) {
      const body = bodies[index];
      const item = tree.casesOf(statement.casesList)[index];
      if (body == undefined || item == undefined) {
        continue;
      }

      frame.made.open(body);
      const bodyItem = tree.stmtsOf(item.bodyList);

      this.statements(frame, bodyItem);
    }

    frame.loops.pop();
  }
}
