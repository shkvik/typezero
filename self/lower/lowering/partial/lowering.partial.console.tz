import {
  CallExpr,
  Expr,
  ExprKind,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { TypeKind } from "../../../program/type/types/type.types.tz";
import { IrOpcode } from "../../ir-function/types/ir-function.types.tz";
import { Lowering } from "../lowering.tz";
import {
  kCharType,
  kConsoleName,
  kErrorBegin,
  kErrorEnd,
  kNewlineCode,
  kPrintBoolean,
  kPrintChar,
  kPrintDouble,
  kPrintInt,
  kPrintString,
  kPointerType,
  kPrintUnsigned,
  kPrintValue,
  kSpaceCode,
  kStderrPrints,
  kStdoutPrints,
  kUndefinedText,
  kVoidType,
} from "../const/lowering.const.tz";
import { Frame, IrValue } from "../types/lowering.types.tz";

partial class Lowering {
  private printStream(frame: Frame, call: CallExpr): boolean | undefined {
    const callee = call.callee;
    if (callee.kind != ExprKind.Member) {
      return undefined;
    }

    const object = callee.object;
    if (object.kind != ExprKind.Name || object.name != kConsoleName) {
      return undefined;
    }

    const target = this.values.valueTargetOf(object, frame.module);
    const opened = this.program.modules[target?.module ?? -1];
    if (opened == undefined || !opened.source.isLibrary) {
      return undefined;
    }
    if (kStderrPrints.includes(callee.name)) {
      return true;
    }
    if (kStdoutPrints.includes(callee.name)) {
      return false;
    }

    return undefined;
  }

  private printed(
    frame: Frame,
    call: CallExpr,
    isError: boolean,
  ): IrValue | undefined {
    const values: IrValue[] = [];

    for (const arg of call.args) {
      if (arg.spread) {
        this.notLowered(frame.module, arg.expr.loc, "a spread argument");

        return undefined;
      }

      const value = this.printedValue(frame, arg.expr);
      if (value == undefined) {
        return undefined;
      }

      values.push(value);
    }

    if (isError) {
      this.runtimeCall(frame.made, kErrorBegin, []);
    }

    for (let index = 0; index < values.length; index++) {
      const value = values[index];
      if (value == undefined) {
        continue;
      }
      if (index > 0) {
        this.printCode(frame, kSpaceCode);
      }

      this.printOne(frame, value);
    }

    this.printCode(frame, kNewlineCode);

    for (const value of values) {
      this.dropping(frame, value);
    }

    if (isError) {
      this.runtimeCall(frame.made, kErrorEnd, []);
    }

    const tz = this.store.plain(TypeKind.Void);

    return { type: kVoidType, value: this.ir.zero(kCharType), tz };
  }

  private printedValue(frame: Frame, expr: Expr): IrValue | undefined {
    if (expr.kind == ExprKind.Undefined) {
      return this.stringValue(kUndefinedText);
    }

    return this.value(frame, expr);
  }

  private printOne(frame: Frame, value: IrValue): void {
    const made = frame.made;
    const tz = this.store.integer(64, false);
    if (this.isString(value.tz)) {
      const parts = this.stringParts(frame, value);

      return this.runtimeCall(made, kPrintString, parts);
    }
    if (this.isDouble(value.tz)) {
      return this.runtimeCall(made, kPrintDouble, [value]);
    }
    const isWhole =
      this.isArray(value.tz) ||
      this.isInstance(value.tz) ||
      this.optionalInner(value.tz) != undefined;
    if (isWhole) {
      return this.printedWhole(frame, value);
    }
    if (this.isBoolean(value.tz)) {
      const widened = made.cast(IrOpcode.ZExt, value.value, kCharType);
      const flag: IrValue = { type: kCharType, value: widened, tz };

      return this.runtimeCall(made, kPrintBoolean, [flag]);
    }

    const isLong = this.bitsOf(value.tz) == 64;
    if (isLong && this.isUnsigned(value.tz)) {
      return this.runtimeCall(made, kPrintUnsigned, [value]);
    }

    const long = this.toLong(frame, value);

    this.runtimeCall(made, kPrintInt, [long]);
  }

  private printedWhole(frame: Frame, value: IrValue): void {
    const made = frame.made;
    const descriptor = this.descriptor(value.tz);
    if (descriptor == undefined) {
      return;
    }

    const spill = made.slot(value.type, "print.value");
    const tz = this.store.integer(64, false);
    const args: IrValue[] = [
      { type: kPointerType, value: descriptor, tz },
      { type: kPointerType, value: spill, tz },
    ];

    made.store(value.value, spill);
    this.runtimeCall(made, kPrintValue, args);
  }

  private printCode(frame: Frame, code: int): void {
    const tz = this.store.integer(32, false);
    const made = this.ir.integer(kCharType, `${code}`);
    const value: IrValue = { type: kCharType, value: made, tz };

    this.runtimeCall(frame.made, kPrintChar, [value]);
  }
}
