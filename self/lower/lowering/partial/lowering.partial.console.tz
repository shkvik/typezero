import {
  CallExpr,
  NameExpr,
  Expr,
  ExprKind,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { TypeKind } from "../../../program/type/types/type.types.tz";
import { IrOpcode } from "../../ir-function/types/ir-function.types.tz";
import { Lowering } from "../lowering.tz";
import {
  kBooleanType,
  kCharType,
  kConsoleName,
  kErrorBegin,
  kErrorEnd,
  kMapModule,
  kMapPrintName,
  kNewlineCode,
  kPointerType,
  kPrintBoolean,
  kPrintChar,
  kPrintDouble,
  kPrintInt,
  kPrintNestedName,
  kPrintString,
  kPrintUnsigned,
  kPrintValue,
  kQuoteCode,
  kSpaceCode,
  kStderrPrints,
  kStdoutPrints,
  kUndefinedText,
  kVoidType,
} from "../const/lowering.const.tz";
import { Frame, IrValue, RuntimeTarget } from "../types/lowering.types.tz";

partial class Lowering {
  private readonly printStream(
    frame: Read<Frame>,
    call: CallExpr,
  ): boolean | undefined {
    const tree = this.values.types.program.tree;

    const callee = tree.exprOf(call.calleeId);
    if (callee.kind != ExprKind.Member) {
      return undefined;
    }

    const object = tree.exprOf(callee.objectId);
    if (object.kind != ExprKind.Name || object.name != kConsoleName) {
      return undefined;
    }

    const target = this.values.valueTargetOf(object, frame.module);
    const opened = this.values.types.program.modules[target?.module ?? -1];
    if (opened == undefined || !opened.source.isLibrary) {
      return undefined;
    }
    if (kStderrPrints.includes(callee.name)) {
      return true;
    }
    if (kStdoutPrints.includes(callee.name)) {
      return false;
    }

    return undefined;
  }

  private printed(
    frame: Frame,
    call: CallExpr,
    isError: boolean,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const values: IrValue[] = [];

    for (const arg of tree.argumentsOf(call.argsList)) {
      if (arg.spread) {
        this.notLowered(
          frame.module,
          tree.exprOf(arg.exprId).loc,
          "a spread argument",
        );

        return undefined;
      }

      const expr = tree.exprOf(arg.exprId);
      const value = this.printedValue(frame, expr);
      if (value == undefined) {
        return undefined;
      }

      values.push(value);
    }

    if (isError) {
      this.runtimeCall(frame.made, kErrorBegin, []);
    }

    for (let index = 0; index < values.length; index++) {
      const value = values[index];
      if (value == undefined) {
        continue;
      }
      if (index > 0) {
        this.printCode(frame, kSpaceCode);
      }

      this.printOne(frame, value);
    }

    this.printCode(frame, kNewlineCode);

    for (const value of values) {
      this.dropping(frame, value);
    }

    if (isError) {
      this.runtimeCall(frame.made, kErrorEnd, []);
    }

    const tz = this.values.types.store.plain(TypeKind.Void);

    return { type: kVoidType, value: this.ir.zero(kCharType), tz };
  }

  private printedValue(frame: Frame, expr: Expr): IrValue | undefined {
    if (expr.kind == ExprKind.Undefined) {
      return this.stringValue(kUndefinedText);
    }

    return this.value(frame, expr);
  }

  private printOne(frame: Read<Frame>, value: IrValue): void {
    const tz = this.values.types.store.integer(64, false);
    if (this.isTzMap(value.tz)) {
      return this.mapPrinted(frame, value);
    }
    if (this.isString(value.tz)) {
      const parts = this.stringParts(frame, value);

      return this.runtimeCall(frame.made, kPrintString, parts);
    }
    if (this.isDouble(value.tz)) {
      return this.runtimeCall(frame.made, kPrintDouble, [value]);
    }
    const isWhole =
      this.isReferenceLike(value.tz) ||
      this.isInPlace(value.tz) ||
      this.isDecimal(value.tz) ||
      value.tz.kind == TypeKind.Result ||
      this.optionalInner(value.tz) != undefined;
    if (isWhole) {
      return this.printedWhole(frame, value);
    }
    if (this.isBoolean(value.tz)) {
      const widened = frame.made.cast(IrOpcode.ZExt, value.value, kCharType);
      const flag: IrValue = { type: kCharType, value: widened, tz };

      return this.runtimeCall(frame.made, kPrintBoolean, [flag]);
    }

    const isLong = this.bitsOf(value.tz) == 64;
    if (isLong && this.isUnsigned(value.tz)) {
      return this.runtimeCall(frame.made, kPrintUnsigned, [value]);
    }

    const long = this.toLong(frame, value);

    this.runtimeCall(frame.made, kPrintInt, [long]);
  }

  private mapPrinted(frame: Read<Frame>, value: IrValue): void {
    const type = value.tz;
    if (type.kind != TypeKind.Dict) {
      return;
    }

    const isSet = this.isTzSet(type);
    const target: RuntimeTarget = { module: kMapModule, name: kMapPrintName };
    const items = [
      this.values.types.store.keyOf(type),
      this.mapValueType(type),
    ];
    const boolean = this.values.types.store.plain(TypeKind.Boolean);
    const flag = this.ir.integer(kBooleanType, `${this.choose(isSet, 1, 0)}`);
    const kind: IrValue = { type: kBooleanType, value: flag, tz: boolean };

    this.runtimeFunctionCall(frame, target, items, [value, kind], 0);
  }

  private inspectCall(
    frame: Frame,
    call: CallExpr,
    callee: NameExpr,
  ): IrValue | undefined {
    const tree = this.values.types.program.tree;

    const argument = tree.argumentsOf(call.argsList)[0];
    if (argument == undefined) {
      return undefined;
    }

    const expr = tree.exprOf(argument.exprId);
    const value = this.value(frame, expr);
    if (value == undefined) {
      return undefined;
    }

    const isQuoted = callee.name == kPrintNestedName && this.isString(value.tz);
    if (isQuoted) {
      this.printCode(frame, kQuoteCode);
    }

    this.printOne(frame, value);

    if (isQuoted) {
      this.printCode(frame, kQuoteCode);
    }

    this.dropping(frame, value);

    return this.nothing();
  }

  private printedWhole(frame: Read<Frame>, value: IrValue): void {
    const descriptor = this.descriptor(value.tz);
    if (descriptor == undefined) {
      return;
    }

    const spill = frame.made.slot(value.type, "print.value");
    const tz = this.values.types.store.integer(64, false);
    const args: IrValue[] = [
      { type: kPointerType, value: descriptor, tz },
      { type: kPointerType, value: spill, tz },
    ];

    frame.made.store(value.value, spill);
    this.runtimeCall(frame.made, kPrintValue, args);
  }

  private printCode(frame: Read<Frame>, code: int): void {
    const tz = this.values.types.store.integer(32, false);
    const made = this.ir.integer(kCharType, `${code}`);
    const value: IrValue = { type: kCharType, value: made, tz };

    this.runtimeCall(frame.made, kPrintChar, [value]);
  }
}
