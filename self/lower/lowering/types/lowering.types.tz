import { ClassDecl } from "../../../program/ast/types/ast.types.classes.tz";
import { FunctionDecl } from "../../../program/ast/types/ast.types.functions.tz";
import { InstanceField } from "../../../program/expression-answers/types/expression-answers.types.tz";
import {
  FunctionShape,
  Type,
} from "../../../program/type/types/type.types.tz";
import { IrFunction } from "../../ir-function/ir-function.tz";
import { LLVMBlock, LLVMValue } from "../../llvm-api/llvm-api.tz";

export enum CountForm {
  Text,
  Decimal,
  Pointer,
}

export type IrValue = {
  readonly type: string;
  readonly value: LLVMValue;
  readonly tz: Type;
  readonly owned?: boolean;
};

export type Place = {
  readonly pointer: LLVMValue;
  readonly type: string;
  readonly tz: Type;
  readonly owner: int;
  readonly flag?: LLVMValue;
};

export type LoopTarget = {
  readonly breakBlock: LLVMBlock;
  readonly continueBlock?: LLVMBlock;
  readonly label: string;
  readonly depth: int;
};

export type Frame = {
  readonly made: IrFunction;
  readonly id: int;
  readonly module: int;
  readonly result?: Type;
  readonly loops: LoopTarget[];
  scopes: Place[][];
  readonly self?: Place;
  readonly inline?: InlineTarget;
  readonly place?: string;
};

export type CallbackStep = {
  readonly item: IrValue;
  readonly index: IrValue;
  readonly array: IrValue;
  readonly done: LLVMBlock;
};

export type GivenText = {
  readonly value: LLVMValue;
  readonly text: IrValue;
  readonly given: int;
};

export type ResultLayout = {
  readonly struct: string;
  readonly value: int;
  readonly error: int;
  readonly ok: int;
  readonly site: int;
};

export type ResultShape = {
  readonly value: LLVMValue;
  readonly error: LLVMValue;
  readonly size: int;
  readonly valueOffset: int;
  readonly errorOffset: int;
  readonly okOffset: int;
  readonly siteOffset: int;
};

export type FileCallParts = {
  readonly type: Type;
  readonly value: Type;
  readonly maker: LLVMValue;
};

export type EachLoop = {
  readonly item: IrValue;
  readonly index: IrValue;
  readonly counter: LLVMValue;
  readonly cond: LLVMBlock;
  readonly step: LLVMBlock;
  readonly done: LLVMBlock;
};

export type TextArguments = {
  readonly texts: IrValue[];
  readonly numbers: LLVMValue[];
};

export type GivenNumber = {
  readonly value: LLVMValue;
  readonly given: int;
};

export type InlineTarget = {
  readonly result?: Place;
  readonly end: LLVMBlock;
  readonly depth: int;
};

export type PendingInstance = {
  readonly module: int;
  readonly fn: FunctionDecl;
  readonly name: string;
  readonly params: readonly Type[];
  readonly args: readonly Type[];
  readonly owner?: ClassDecl;
  readonly self?: Type;
};

export type MethodTarget = {
  readonly name: string;
  readonly shape: FunctionShape;
};

export type Unlowered = {
  readonly module: int;
  readonly loc: int;
  readonly form: string;
};

export type LoweredProgram = {
  readonly unlowered: Unlowered[];
};

export type TextConstant = {
  readonly pointer: LLVMValue;
  readonly length: int;
};

export type DescriptorShape = {
  readonly kind: int;
  readonly size: int;
  readonly inner?: LLVMValue;
};

export type LayoutField = {
  readonly name: string;
  readonly index: int;
  readonly offset: int;
  readonly type: Type;
  readonly ir: string;
};

export type ClassLayout = {
  readonly struct: string;
  readonly size: int;
  readonly fields: readonly LayoutField[];
  readonly descriptor: LLVMValue;
  readonly classId: int;
  readonly shape: LayoutShape;
  readonly drop: LLVMValue;
};

export type DictLayout = {
  readonly descriptor: LLVMValue;
  readonly keyOffset: int;
  readonly valueOffset: int;
  readonly key: string;
  readonly value: string;
};

export type LayoutShape = {
  readonly name: string;
  readonly fields: readonly InstanceField[];
  readonly flags: int;
};

export type InternedLayouts = Interned<ClassLayout | LayoutShape>;
