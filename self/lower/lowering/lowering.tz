import { SourceLines } from "../../program/source-lines/source-lines.tz";
import {
  kFirstClassId,
  kMainFrame,
  kFlagType,
  kMainName,
  kRuntimeFinished,
  kRuntimeMainDone,
  kRuntimeModule,
  kRuntimeModules,
  kRuntimeStarted,
  kVoidType,
} from "./const/lowering.const.tz";
import {
  ClassLayout,
  LayoutField,
  LayoutShape,
  DictLayout,
  Frame,
  IrValue,
  LoweredProgram,
  PendingClosure,
  PendingInstance,
  Place,
  Unlowered,
} from "./types/lowering.types.tz";

export class Lowering {
  private readonly values: ExpressionTypes;
  public readonly ir: IrModule;
  private unlowered: Unlowered[];
  private readonly places: Map<string, Place>;
  private managedGlobals: Place[];
  private readonly strings: Map<string, LLVMValue>;
  private readonly descriptors: Map<int, LLVMValue>;
  private readonly layouts: Map<int, ClassLayout>;
  private readonly layoutFields: Map<int, LayoutField[]>;
  private readonly layoutShapes: Map<int, LayoutShape>;
  private readonly layoutSlots: Map<int, LLVMValue[]>;
  private readonly dictLayouts: Map<int, DictLayout>;
  private readonly cTexts: Map<string, LLVMValue>;
  private readonly knownTypes: Map<int, Type>;
  private readonly evaluated: Map<int, IrValue>;
  private readonly chainExits: LLVMBlock[];
  private readonly sites: Map<string, LLVMValue>;
  private readonly lines: Map<int, SourceLines>;
  private readonly handles: Map<int, boolean>;
  private readonly cstrings: Map<string, LLVMValue>;
  private cstringLayoutGlobal: LLVMValue | undefined;
  private bytesLayoutsGlobal: LLVMValue | undefined;
  private jsonLayoutGlobal: LLVMValue | undefined;
  private readonly makers: Map<int, LLVMValue>;
  private readonly orderedDescriptors: Map<string, LLVMValue>;
  private readonly orderMakers: Map<string, LLVMValue>;
  private readonly keyedFinders: Map<string, IrCallee>;
  private classIds: int;
  private pendingLabel: string;
  private nextFrame: int;
  private binding: Map<int, Type>;
  private readonly wantedInstances: Set<string>;
  private readonly pendingInstances: PendingInstance[];
  private instanceModule: int;
  private instanceStart: int;
  private instanceEnd: int;
  private instanceSuffix: string;
  private readonly moves: Set<int>;
  private readonly lentClosures: Set<int>;
  private readonly borrows: Set<string>;
  private isAuditing: boolean;
  private isCheckingCounts: boolean;
  private readonly audited: string[];
  private statementLoc: int;
  private readonly pendingClosures: PendingClosure[];
  private readonly letKeys: Set<string>;
  private changedGlobals: Set<string>;
  private readonly immortalGlobals: Set<string>;
  private readonly functionObjects: Map<string, LLVMValue>;
  private readonly initFunctions: Map<int, IrCallee>;
  private readonly noInits: Set<int>;
  private readonly inPlaceTypes: Map<int, boolean>;
  private readonly unionParts: Set<int>;
  private readonly recordBoxes: Map<int, ClassLayout>;
  private readonly staticTables: Set<string>;
  private areUnionsScanned: boolean;

  public constructor(
    values: Own<ExpressionTypes>,
    moves: Own<Set<int>>,
    borrows: Own<Set<string>>,
    closures: Own<Set<int>>,
  ) {
    const name = values.types.program.modules[0]?.name ?? "";

    this.values = values;
    this.ir = new IrModule(name);
    this.unlowered = [];
    this.places = new Map<string, Place>();
    this.managedGlobals = [];
    this.strings = new Map<string, LLVMValue>();
    this.descriptors = new Map<int, LLVMValue>();
    this.layouts = new Map<int, ClassLayout>();
    this.layoutFields = new Map<int, LayoutField[]>();
    this.layoutShapes = new Map<int, LayoutShape>();
    this.layoutSlots = new Map<int, LLVMValue[]>();
    this.dictLayouts = new Map<int, DictLayout>();
    this.cTexts = new Map<string, LLVMValue>();
    this.knownTypes = new Map<int, Type>();
    this.evaluated = new Map<int, IrValue>();
    this.chainExits = [];
    this.sites = new Map<string, LLVMValue>();
    this.lines = new Map<int, SourceLines>();
    this.handles = new Map<int, boolean>();
    this.cstrings = new Map<string, LLVMValue>();
    this.cstringLayoutGlobal = undefined;
    this.bytesLayoutsGlobal = undefined;
    this.jsonLayoutGlobal = undefined;
    this.makers = new Map<int, LLVMValue>();
    this.orderedDescriptors = new Map<string, LLVMValue>();
    this.orderMakers = new Map<string, LLVMValue>();
    this.keyedFinders = new Map<string, IrCallee>();
    this.classIds = kFirstClassId;
    this.pendingLabel = "";
    this.nextFrame = kMainFrame + 1;
    this.binding = new Map<int, Type>();
    this.wantedInstances = new Set<string>();
    this.pendingInstances = [];
    this.instanceModule = -1;
    this.instanceStart = 0;
    this.instanceEnd = 0;
    this.instanceSuffix = "";
    this.moves = moves;
    this.borrows = borrows;
    this.lentClosures = closures;
    this.isAuditing = false;
    this.isCheckingCounts = false;
    this.audited = [];
    this.statementLoc = 0;
    this.pendingClosures = [];
    this.letKeys = new Set<string>();
    this.changedGlobals = new Set<string>();
    this.immortalGlobals = new Set<string>();
    this.functionObjects = new Map<string, LLVMValue>();
    this.initFunctions = new Map<int, IrCallee>();
    this.noInits = new Set<int>();
    this.inPlaceTypes = new Map<int, boolean>();
    this.unionParts = new Set<int>();
    this.recordBoxes = new Map<int, ClassLayout>();
    this.staticTables = new Set<string>();
    this.areUnionsScanned = false;
  }

  public audit(): void {
    this.isAuditing = true;
  }

  public keepChangedConstants(keys: Own<Set<string>>): void {
    this.changedGlobals = keys;
  }

  public checkCounts(): void {
    this.isCheckingCounts = true;
  }

  public readonly lateWork(): string[] {
    return this.values.lateWorkList();
  }

  public readonly sourceProgram(): Read<Program> {
    return this.values.types.program;
  }

  public auditedCounts(): string[] {
    return replace(this.audited, []);
  }

  public run(): LoweredProgram {
    const tree = this.values.types.program.tree;

    const main = new IrFunction(this.ir, kMainName, kFlagType, []);
    const modules = this.values.types.program.order.filter((module) =>
      this.isProgramModule(module),
    );
    const runtime = this.values.types.program.order.filter((module) =>
      this.isRuntimeModule(module),
    );

    for (const module of runtime) {
      this.moduleGlobals(module);
    }
    for (const module of modules) {
      this.moduleGlobals(module);
    }
    for (const module of runtime) {
      this.runtimeGlobalsMade(main, module);

      if (this.values.types.program.modules[module]?.name == kRuntimeModule) {
        this.ownRuntimeCall(main, kRuntimeStarted);
      }
    }

    for (const module of modules) {
      const frame: Frame = {
        made: main,
        id: kMainFrame,
        module: module,
        loops: [],
        scopes: [],
      };

      const items = this.values.types.program.modules[module]?.file.itemsList;

      for (const statement of tree.stmtsOf(items)) {
        this.statement(frame, statement);
      }
    }

    this.instancesLowered();

    while (this.closuresLowered()) {
      this.instancesLowered();
    }

    this.ownRuntimeCall(main, kRuntimeMainDone);
    this.globalsReleased(main);
    this.ownRuntimeCall(main, kRuntimeFinished);
    this.instancesLowered();

    while (this.closuresLowered()) {
      this.instancesLowered();
    }

    main.finishValue(this.ir.integer(kFlagType, "0"));

    return { unlowered: replace(this.unlowered, []) };
  }

  private ownRuntimeCall(made: IrFunction, name: string): void {
    const callee = this.runtimeHelperName(kRuntimeModule, name, name);

    made.call(this.ir.declare(callee, kVoidType, []), []);
  }

  private globalsReleased(main: Own<IrFunction>): void {
    const frame: Frame = {
      made: main,
      id: kMainFrame,
      module: 0,
      loops: [],
      scopes: [replace(this.managedGlobals, [])],
    };

    this.cleanupsTo(frame, 0);
  }

  private runtimeGlobalsMade(main: IrFunction, module: int): void {
    const tree = this.values.types.program.tree;

    const frame: Frame = {
      made: main,
      id: kMainFrame,
      module,
      loops: [],
      scopes: [],
    };
    const items = this.values.types.program.modules[module]?.file.itemsList;

    for (const statement of tree.stmtsOf(items)) {
      if (statement.kind == StmtKind.VarDecl) {
        this.statement(frame, statement);
      }
      if (statement.kind == StmtKind.Class) {
        this.staticsInitialized(frame, statement);
      }
    }
  }

  private readonly isRuntimeModule(id: int): boolean {
    const module = this.values.types.program.modules[id];
    if (module == undefined || !module.source.isLibrary) {
      return false;
    }

    return kRuntimeModules.includes(module.name);
  }

  private readonly isProgramModule(id: int): boolean {
    const module = this.values.types.program.modules[id];
    if (module == undefined) {
      return false;
    }

    return !module.source.isLibrary && !module.isDeclarationOnly;
  }

  private readonly placeKey(module: int, loc: int): string {
    return `${module} ${loc}`;
  }

  private frameId(): int {
    const id = this.nextFrame;

    this.nextFrame += 1;

    return id;
  }

  private notLowered(module: int, loc: int, form: string): void {
    this.unlowered.push({ module, loc, form });
  }
}
