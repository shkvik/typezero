import { ExpressionAnswers } from "../../program/expression-answers/expression-answers.tz";
import { Module, Program } from "../../program/module/types/module.types.tz";
import { TypeStore } from "../../program/type/type-store/type-store.tz";
import { ExpressionTypes } from "../../semantic/code/expression-types/expression-types.tz";
import { TypeResolver } from "../../semantic/types/type-resolver/type-resolver.tz";
import { CheckedProgram } from "../../pipeline/front-end/types/front-end.types.tz";
import { IrFunction } from "../ir-function/ir-function.tz";
import { IrCallee } from "../ir-function/types/ir-function.types.tz";
import { IrModule } from "../ir-module/ir-module.tz";
import { LLVMBlock, LLVMValue } from "../llvm-api/llvm-api.tz";
import { Expr } from "../../program/ast/types/ast.types.expressions.tz";
import { Type } from "../../program/type/types/type.types.tz";
import { SourceLines } from "../../program/source-lines/source-lines.tz";
import {
  kFirstClassId,
  kMainFrame,
  kFlagType,
  kMainName,
  kRuntimeInit,
  kRuntimeMainDone,
  kRuntimeShutdown,
} from "./const/lowering.const.tz";
import {
  ClassLayout,
  DictLayout,
  Frame,
  IrValue,
  LoweredProgram,
  PendingInstance,
  Place,
  Unlowered,
} from "./types/lowering.types.tz";

export class Lowering {
  private readonly program: Program;
  private readonly store: TypeStore;
  private readonly values: ExpressionTypes;
  private readonly resolver: TypeResolver;
  private readonly answers: ExpressionAnswers;
  public readonly ir: IrModule;
  private unlowered: Unlowered[];
  private readonly places: Map<string, Place>;
  private managedGlobals: Place[];
  private readonly strings: Map<string, LLVMValue>;
  private readonly descriptors: Map<int, LLVMValue>;
  private readonly layouts: Map<int, ClassLayout>;
  private readonly dictLayouts: Map<int, DictLayout>;
  private readonly cTexts: Map<string, LLVMValue>;
  private readonly knownTypes: Map<Expr, Type>;
  private readonly evaluated: Map<Expr, IrValue>;
  private readonly chainExits: LLVMBlock[];
  private readonly sites: Map<string, LLVMValue>;
  private readonly lines: Map<int, SourceLines>;
  private readonly handles: Map<int, boolean>;
  private readonly cstrings: Map<string, LLVMValue>;
  private readonly makers: Map<int, LLVMValue>;
  private readonly orderedDescriptors: Map<string, LLVMValue>;
  private readonly orderMakers: Map<string, LLVMValue>;
  private readonly keyedFinders: Map<string, IrCallee>;
  private classIds: int;
  private pendingLabel: string;
  private nextFrame: int;
  private binding: Map<int, Type>;
  private readonly wantedInstances: Set<string>;
  private readonly pendingInstances: PendingInstance[];
  private instanceModule: int;
  private instanceStart: int;
  private instanceEnd: int;
  private instanceSuffix: string;

  public constructor(
    store: TypeStore,
    program: Own<Program>,
    checked: Read<CheckedProgram>,
  ) {
    const name = program.modules[0]?.name ?? "";

    this.program = program;
    this.store = store;
    this.values = checked.values;
    this.resolver = checked.types;
    this.answers = checked.values.answers;
    this.ir = new IrModule(name);
    this.unlowered = [];
    this.places = new Map<string, Place>();
    this.managedGlobals = [];
    this.strings = new Map<string, LLVMValue>();
    this.descriptors = new Map<int, LLVMValue>();
    this.layouts = new Map<int, ClassLayout>();
    this.dictLayouts = new Map<int, DictLayout>();
    this.cTexts = new Map<string, LLVMValue>();
    this.knownTypes = new Map<Expr, Type>();
    this.evaluated = new Map<Expr, IrValue>();
    this.chainExits = [];
    this.sites = new Map<string, LLVMValue>();
    this.lines = new Map<int, SourceLines>();
    this.handles = new Map<int, boolean>();
    this.cstrings = new Map<string, LLVMValue>();
    this.makers = new Map<int, LLVMValue>();
    this.orderedDescriptors = new Map<string, LLVMValue>();
    this.orderMakers = new Map<string, LLVMValue>();
    this.keyedFinders = new Map<string, IrCallee>();
    this.classIds = kFirstClassId;
    this.pendingLabel = "";
    this.nextFrame = kMainFrame + 1;
    this.binding = new Map<int, Type>();
    this.wantedInstances = new Set<string>();
    this.pendingInstances = [];
    this.instanceModule = -1;
    this.instanceStart = 0;
    this.instanceEnd = 0;
    this.instanceSuffix = "";
  }

  public run(): LoweredProgram {
    const main = new IrFunction(this.ir, kMainName, kFlagType, []);
    const modules = this.program.order.filter((module) =>
      this.isProgramModule(module),
    );

    this.runtimeCall(main, kRuntimeInit, []);

    for (const module of modules) {
      this.moduleGlobals(module);
    }

    for (const module of modules) {
      const frame: Frame = {
        made: main,
        id: kMainFrame,
        module: module.id,
        loops: [],
        scopes: [],
      };

      for (const statement of module.file.items) {
        this.statement(frame, statement);
      }
    }

    this.instancesLowered();
    this.runtimeCall(main, kRuntimeMainDone, []);
    this.globalsReleased(main);
    this.runtimeCall(main, kRuntimeShutdown, []);
    main.finishValue(this.ir.integer(kFlagType, "0"));

    return { unlowered: replace(this.unlowered, []) };
  }

  private globalsReleased(main: Own<IrFunction>): void {
    const frame: Frame = {
      made: main,
      id: kMainFrame,
      module: 0,
      loops: [],
      scopes: [replace(this.managedGlobals, [])],
    };

    this.cleanupsTo(frame, 0);
  }

  private readonly isProgramModule(module: Module): boolean {
    return !module.source.isLibrary && !module.isDeclarationOnly;
  }

  private readonly placeKey(module: int, loc: int): string {
    return `${module} ${loc}`;
  }

  private frameId(): int {
    const id = this.nextFrame;

    this.nextFrame += 1;

    return id;
  }

  private notLowered(module: int, loc: int, form: string): void {
    this.unlowered.push({ module, loc, form });
  }
}
