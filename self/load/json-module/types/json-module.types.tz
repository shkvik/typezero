export enum JsonNodeKind {
  Null,
  Bool,
  Number,
  String,
  Array,
  Object,
}

export type JsonNode = {
  readonly kind: JsonNodeKind;
  readonly raw: string;
  readonly items: readonly JsonNode[];
  readonly keys: readonly string[];
};

export type JsonFields = {
  readonly keys: string[];
  readonly items: JsonNode[];
};

export enum JsonShapeKind {
  Unknown,
  Json,
  Bool,
  Int,
  Double,
  String,
  Array,
  Object,
}

export type JsonShape = {
  readonly kind: JsonShapeKind;
  readonly items: readonly JsonShape[];
  readonly keys: readonly string[];
  readonly optional: readonly boolean[];
};

export type InternedJson = Interned<JsonNode | JsonShape>;
