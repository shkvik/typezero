import {
  kBooleanTypeName,
  kByteOrderMark,
  kDoubleTypeName,
  kExportStart,
  kFalseWord,
  kFractionMarks,
  kFractionTail,
  kIntTypeName,
  kJsonTypeName,
  kLargestInteger,
  kNullWord,
  kNumberCharacters,
  kSpaceCharacters,
  kStringTypeName,
  kTrueWord,
  kValueStart,
} from "./const/json-module.const.tz";
import {
  JsonFields,
  JsonNode,
  JsonNodeKind,
  JsonShape,
  JsonShapeKind,
} from "./types/json-module.types.tz";

export class JsonModule {
  private readonly text: string;
  private position: int;
  private isBroken: boolean;

  public constructor(text: string) {
    this.text = text;
    this.position = 0;
    this.isBroken = false;
  }

  public moduleText(): string | undefined {
    if (this.text.startsWith(kByteOrderMark)) {
      this.position = kByteOrderMark.length;
    }

    this.skipSpace();

    const root = this.value();

    this.skipSpace();

    const isWhole = this.position >= this.text.length;
    if (this.isBroken || !isWhole) {
      return undefined;
    }

    const shape = this.shapeOf(root);
    const type = this.typeText(shape);
    const value = this.valueText(root, shape);

    return `${kExportStart}${type}${kValueStart}${value}\n`;
  }

  private current(): string {
    return this.text.slice(this.position, this.position + 1);
  }

  private skipSpace(): void {
    while (this.position < this.text.length) {
      const character = this.current();
      if (!kSpaceCharacters.includes(character)) {
        return;
      }

      this.position += 1;
    }
  }

  private accept(character: string): boolean {
    if (this.current() != character) {
      return false;
    }

    this.position += 1;

    return true;
  }

  private value(): JsonNode {
    switch (this.current()) {
      case "{":
        return this.objectNode();
      case "[":
        return this.arrayNode();
      case '"':
        return this.stringNode();
      case "t":
        return this.wordNode(kTrueWord, JsonNodeKind.Bool);
      case "f":
        return this.wordNode(kFalseWord, JsonNodeKind.Bool);
      case "n":
        return this.wordNode(kNullWord, JsonNodeKind.Null);
      default:
        return this.numberNode();
    }
  }

  private node(kind: JsonNodeKind, raw: string): JsonNode {
    return { kind, raw, items: [], keys: [] };
  }

  private objectNode(): JsonNode {
    const node = this.node(JsonNodeKind.Object, "");

    this.position += 1;
    this.skipSpace();

    if (this.accept("}")) {
      return node;
    }

    while (!this.isBroken) {
      this.skipSpace();

      if (this.current() != '"') {
        this.isBroken = true;

        return node;
      }

      const key = this.stringNode().raw;

      this.skipSpace();

      if (!this.accept(":")) {
        this.isBroken = true;

        return node;
      }

      this.skipSpace();

      const item = this.value();

      node.keys.push(key);
      node.items.push(item);
      this.skipSpace();

      if (this.accept("}")) {
        return node;
      }
      if (!this.accept(",")) {
        this.isBroken = true;
      }
    }

    return node;
  }

  private arrayNode(): JsonNode {
    const node = this.node(JsonNodeKind.Array, "");

    this.position += 1;
    this.skipSpace();

    if (this.accept("]")) {
      return node;
    }

    while (!this.isBroken) {
      this.skipSpace();

      const item = this.value();

      node.items.push(item);
      this.skipSpace();

      if (this.accept("]")) {
        return node;
      }
      if (!this.accept(",")) {
        this.isBroken = true;
      }
    }

    return node;
  }

  private stringNode(): JsonNode {
    const start = this.position;

    this.position += 1;

    while (this.position < this.text.length) {
      const character = this.current();
      if (character == "\\") {
        this.position += 2;
        continue;
      }

      this.position += 1;

      if (character == '"') {
        const raw = this.text.slice(start, this.position);

        return this.node(JsonNodeKind.String, raw);
      }
    }

    this.isBroken = true;

    return this.node(JsonNodeKind.String, "");
  }

  private wordNode(word: string, kind: JsonNodeKind): JsonNode {
    if (!this.text.startsWith(word, this.position)) {
      this.isBroken = true;

      return this.node(kind, word);
    }

    this.position += word.length;

    return this.node(kind, word);
  }

  private numberNode(): JsonNode {
    const start = this.position;

    while (this.position < this.text.length) {
      if (!kNumberCharacters.includes(this.current())) {
        break;
      }

      this.position += 1;
    }

    if (this.position == start) {
      this.isBroken = true;
    }

    const raw = this.text.slice(start, this.position);

    return this.node(JsonNodeKind.Number, raw);
  }

  private shape(kind: JsonShapeKind): JsonShape {
    return { kind, items: [], keys: [], optional: [] };
  }

  private shapeOf(node: JsonNode): JsonShape {
    switch (node.kind) {
      case JsonNodeKind.Null:
        return this.shape(JsonShapeKind.Json);
      case JsonNodeKind.Bool:
        return this.shape(JsonShapeKind.Bool);
      case JsonNodeKind.Number:
        return this.numberShape(node.raw);
      case JsonNodeKind.String:
        return this.shape(JsonShapeKind.String);
      case JsonNodeKind.Array:
        return this.arrayShape(node);
      default:
        return this.objectShape(node);
    }
  }

  private numberShape(raw: string): JsonShape {
    if (this.isIntegral(raw)) {
      return this.shape(JsonShapeKind.Int);
    }

    return this.shape(JsonShapeKind.Double);
  }

  private hasFraction(raw: string): boolean {
    for (const mark of kFractionMarks) {
      if (raw.includes(mark)) {
        return true;
      }
    }

    return false;
  }

  private isIntegral(raw: string): boolean {
    if (this.hasFraction(raw)) {
      return false;
    }

    const digits = raw.replaceAll("-", "");
    if (digits.length != kLargestInteger.length) {
      return digits.length < kLargestInteger.length;
    }

    return digits <= kLargestInteger;
  }

  private arrayShape(node: JsonNode): JsonShape {
    let element = this.shape(JsonShapeKind.Unknown);

    for (const item of node.items) {
      element = this.join(element, this.shapeOf(item));
    }

    return {
      kind: JsonShapeKind.Array,
      items: [element],
      keys: [],
      optional: [],
    };
  }

  private objectShape(node: JsonNode): JsonShape {
    const fields = this.fieldsOf(node);
    const items = fields.items.map((item) => this.shapeOf(item));
    const optional = fields.keys.map(() => false);

    return { kind: JsonShapeKind.Object, items, keys: fields.keys, optional };
  }

  private fieldsOf(node: JsonNode): JsonFields {
    const keys: string[] = [];
    const items: JsonNode[] = [];

    for (let index = 0; index < node.keys.length; index++) {
      const key = node.keys[index];
      const item = node.items[index];
      if (key == undefined || item == undefined) {
        continue;
      }

      const known = keys.indexOf(key);
      if (known >= 0) {
        items.splice(known, 1, item);
        continue;
      }

      keys.push(key);
      items.push(item);
    }

    return { keys, items };
  }

  private join(first: JsonShape, second: JsonShape): JsonShape {
    if (first.kind == JsonShapeKind.Unknown) {
      return second;
    }
    if (second.kind == JsonShapeKind.Unknown) {
      return first;
    }
    if (this.isNumberPair(first, second)) {
      return this.shape(JsonShapeKind.Double);
    }
    if (first.kind != second.kind || first.kind == JsonShapeKind.Json) {
      return this.shape(JsonShapeKind.Json);
    }
    if (first.kind == JsonShapeKind.Array) {
      return this.joinedArray(first, second);
    }
    if (first.kind != JsonShapeKind.Object) {
      return first;
    }

    return this.joinedObject(first, second);
  }

  private isNumberPair(first: JsonShape, second: JsonShape): boolean {
    const isFirstNumber =
      first.kind == JsonShapeKind.Int || first.kind == JsonShapeKind.Double;
    const isSecondNumber =
      second.kind == JsonShapeKind.Int || second.kind == JsonShapeKind.Double;

    return isFirstNumber && isSecondNumber && first.kind != second.kind;
  }

  private joinedArray(first: JsonShape, second: JsonShape): JsonShape {
    const unknown = this.shape(JsonShapeKind.Unknown);
    const firstItem = first.items[0] ?? unknown;
    const secondItem = second.items[0] ?? unknown;
    const element = this.join(firstItem, secondItem);

    return {
      kind: JsonShapeKind.Array,
      items: [element],
      keys: [],
      optional: [],
    };
  }

  private joinedObject(first: JsonShape, second: JsonShape): JsonShape {
    const merged: JsonShape = this.shape(JsonShapeKind.Object);

    for (let index = 0; index < first.keys.length; index++) {
      const key = first.keys[index];
      const item = first.items[index];
      if (key == undefined || item == undefined) {
        continue;
      }

      const there = second.keys.indexOf(key);
      const theirs = second.items[there];

      merged.keys.push(key);
      if (theirs == undefined) {
        merged.items.push(item);
        merged.optional.push(true);
        continue;
      }

      const isOptional =
        first.optional[index] == true || second.optional[there] == true;

      merged.items.push(this.join(item, theirs));
      merged.optional.push(isOptional);
    }

    for (let index = 0; index < second.keys.length; index++) {
      const key = second.keys[index];
      const item = second.items[index];
      if (key != undefined && item != undefined && !first.keys.includes(key)) {
        merged.keys.push(key);
        merged.items.push(item);
        merged.optional.push(true);
      }
    }

    return merged;
  }

  private typeText(shape: JsonShape): string {
    switch (shape.kind) {
      case JsonShapeKind.Bool:
        return kBooleanTypeName;
      case JsonShapeKind.Int:
        return kIntTypeName;
      case JsonShapeKind.Double:
        return kDoubleTypeName;
      case JsonShapeKind.String:
        return kStringTypeName;
      case JsonShapeKind.Array:
        return this.arrayTypeText(shape);
      case JsonShapeKind.Object:
        return this.objectTypeText(shape);
      default:
        return kJsonTypeName;
    }
  }

  private arrayTypeText(shape: JsonShape): string {
    const element = shape.items[0] ?? this.shape(JsonShapeKind.Unknown);

    return `${this.typeText(element)}[]`;
  }

  private objectTypeText(shape: JsonShape): string {
    const parts: string[] = [];

    for (let index = 0; index < shape.keys.length; index++) {
      const key = shape.keys[index];
      const item = shape.items[index];
      if (key == undefined || item == undefined) {
        continue;
      }

      const mark = this.optionalMark(shape.optional[index] == true);

      parts.push(`${key}${mark} ${this.typeText(item)}`);
    }

    return this.braced(parts, "; ");
  }

  private optionalMark(isOptional: boolean): string {
    if (isOptional) {
      return "?:";
    }

    return ":";
  }

  private braced(parts: string[], separator: string): string {
    if (parts.length == 0) {
      return "{}";
    }

    return `{ ${parts.join(separator)} }`;
  }

  private valueText(node: JsonNode, shape: JsonShape): string {
    switch (shape.kind) {
      case JsonShapeKind.Double:
        return this.doubleText(node.raw);
      case JsonShapeKind.Array:
        return this.arrayValueText(node, shape.items[0]);
      case JsonShapeKind.Object:
        return this.objectValueText(node, shape);
      default:
        return this.jsonText(node);
    }
  }

  private doubleText(raw: string): string {
    if (this.hasFraction(raw)) {
      return raw;
    }

    return `${raw}${kFractionTail}`;
  }

  private arrayValueText(
    node: JsonNode,
    element: JsonShape | undefined,
  ): string {
    const parts = node.items.map((item) => {
      if (element == undefined) {
        return this.jsonText(item);
      }

      return this.valueText(item, element);
    });

    return `[${parts.join(", ")}]`;
  }

  private objectValueText(node: JsonNode, shape: JsonShape): string {
    const fields = this.fieldsOf(node);
    const parts: string[] = [];

    for (let index = 0; index < fields.keys.length; index++) {
      const key = fields.keys[index];
      const item = fields.items[index];
      const place = shape.keys.indexOf(key ?? "");
      const itemShape = shape.items[place];
      if (key == undefined || item == undefined || itemShape == undefined) {
        continue;
      }

      parts.push(`${key}: ${this.valueText(item, itemShape)}`);
    }

    return this.braced(parts, ", ");
  }

  private jsonText(node: JsonNode): string {
    switch (node.kind) {
      case JsonNodeKind.Number:
        return this.jsonNumberText(node.raw);
      case JsonNodeKind.Array:
        return this.arrayValueText(node, undefined);
      case JsonNodeKind.Object:
        return this.jsonObjectText(node);
      default:
        return node.raw;
    }
  }

  private jsonNumberText(raw: string): string {
    if (this.isIntegral(raw)) {
      return raw;
    }

    return this.doubleText(raw);
  }

  private jsonObjectText(node: JsonNode): string {
    const fields = this.fieldsOf(node);
    const parts: string[] = [];

    for (let index = 0; index < fields.keys.length; index++) {
      const key = fields.keys[index];
      const item = fields.items[index];
      if (key != undefined && item != undefined) {
        parts.push(`${key}: ${this.jsonText(item)}`);
      }
    }

    return this.braced(parts, ", ");
  }
}
