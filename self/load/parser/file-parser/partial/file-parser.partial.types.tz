import { FileParser } from "../file-parser.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { Details } from "../../../../diagnostic/types/message.types.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import {
  KnownName,
  Token,
  TokenKind,
} from "../../../token/types/token.types.tz";
import { kTokenTable } from "../../../token/const/token.const.tz";
import {
  FunctionTypeForm,
  MappedTypeForm,
  ModifierChange,
  ObjectTypeForm,
  TemplateTypeForm,
  TupleTypeForm,
  TypeKind,
  TypeRef,
} from "../../../../program/ast/types/ast.types.types.tz";
import { ExprKind } from "../../../../program/ast/types/ast.types.expressions.tz";
import { TypePlace } from "../types/file-parser.types.context.tz";
import {
  ObjectTypeMember,
  Signature,
} from "../types/file-parser.types.types.tz";
import {
  kExactDoubleLimit,
  kSymbolAsyncIteratorName,
  kSymbolDisposeName,
  kSymbolIteratorName,
} from "../const/file-parser.const.types.tz";

partial class FileParser {
  private type(place: TypePlace = TypePlace.Plain): TypeRef {
    const head = this.cursor.peek();
    const start = head.start;
    const outer = this.context;

    this.context = { ...outer, typePlace: place };
    const check = this.unionType();
    this.context = outer;

    const extendsClause = place == TypePlace.ExtendsClause;
    if (extendsClause || !this.cursor.is(TokenKind.Extends)) {
      return check;
    }

    const ref = this.typeRef(check.loc);
    ref.form = { kind: TypeKind.Conditional };
    this.cursor.next();
    ref.args.push(check);

    const extendsType = this.type(TypePlace.ExtendsClause);
    ref.args.push(extendsType);
    if (
      !this.cursor.expect(TokenKind.Question, Code.ExpectedAfterExtendsClause)
    ) {
      return this.typeRef(start);
    }

    const whenTrue = this.type();
    ref.args.push(whenTrue);
    if (!this.cursor.expect(TokenKind.Colon, Code.ExpectedBetweenBranches)) {
      return this.typeRef(start);
    }

    const whenFalse = this.type();
    ref.args.push(whenFalse);
    ref.source = this.cursor.spanFrom(start);

    return ref;
  }

  private unionType(): TypeRef {
    const head = this.cursor.peek();
    const loc = head.start;

    this.cursor.accept(TokenKind.Pipe);
    const first = this.intersectionType();
    if (!this.cursor.is(TokenKind.Pipe)) {
      return first;
    }

    const ref = this.typeRef(loc);
    ref.form = { kind: TypeKind.Union };
    ref.args.push(first);

    while (this.cursor.accept(TokenKind.Pipe)) {
      const next = this.intersectionType();
      ref.args.push(next);
    }

    return ref;
  }

  private intersectionType(): TypeRef {
    const head = this.cursor.peek();
    const loc = head.start;

    this.cursor.accept(TokenKind.Amp);
    const first = this.prefixedType();
    if (!this.cursor.is(TokenKind.Amp)) {
      return first;
    }

    const ref = this.typeRef(loc);
    ref.form = { kind: TypeKind.Intersection };
    ref.args.push(first);

    while (this.cursor.accept(TokenKind.Amp)) {
      const next = this.prefixedType();
      ref.args.push(next);
    }

    return ref;
  }

  private subjectAhead(): boolean {
    const next = this.cursor.lookahead();
    const subject =
      kTokenTable.isName(next.kind) || next.kind == TokenKind.This;

    return subject && !next.newline;
  }

  private isAhead(): boolean {
    const next = this.cursor.lookahead();

    return next.kind == TokenKind.Is && !next.newline;
  }

  private returnType(): TypeRef {
    const asserts = this.cursor.is(TokenKind.Asserts) && this.subjectAhead();
    const predicate = this.cursor.atNameOrThis() && this.isAhead();
    if (!asserts && !predicate) {
      return this.type();
    }

    const token = this.cursor.peek();
    const ref = this.typeRef(token.start);
    ref.form = { kind: TypeKind.Predicate, asserts };

    if (asserts) {
      this.cursor.next();
    }

    const subject = this.cursor.next();
    ref.name = subject.text;

    const following = this.cursor.peek();
    if (following.kind == TokenKind.Is && !following.newline) {
      this.cursor.next();
      const type = this.type();
      ref.args.push(type);
    }

    return ref;
  }

  private prefixedType(): TypeRef {
    if (this.keyofAhead()) {
      return this.keyofType();
    }
    if (this.readonlyAhead()) {
      return this.readonlyType();
    }

    return this.suffixedType();
  }

  private keyofAhead(): boolean {
    const next = this.cursor.lookahead();
    const operand =
      kTokenTable.isName(next.kind) ||
      next.kind == TokenKind.LParen ||
      next.kind == TokenKind.LBrace ||
      next.kind == TokenKind.Typeof;

    return this.cursor.is(TokenKind.Keyof) && operand;
  }

  private readonlyAhead(): boolean {
    const next = this.cursor.lookahead();
    const operand =
      kTokenTable.isName(next.kind) ||
      next.kind == TokenKind.LParen ||
      next.kind == TokenKind.LBracket;

    return this.cursor.is(TokenKind.Readonly) && operand;
  }

  private keyofType(): TypeRef {
    const keyword = this.cursor.next();
    const ref = this.typeRef(keyword.start);
    const operand = this.prefixedType();

    ref.form = { kind: TypeKind.KeyOf };
    ref.args.push(operand);

    return ref;
  }

  private suffixedType(): TypeRef {
    let ref = this.primaryType();

    while (this.indexAhead()) {
      this.cursor.next();

      if (this.cursor.accept(TokenKind.RBracket)) {
        ref = this.arrayOf(ref);
      } else {
        ref = this.indexedType(ref);
      }
    }

    return ref;
  }

  private arrayOf(element: TypeRef): TypeRef {
    const ref = this.typeRef(element.loc);

    ref.form = { kind: TypeKind.Array };
    ref.args.push(element);

    return ref;
  }

  private indexedType(object: TypeRef): TypeRef {
    const ref = this.typeRef(object.loc);
    const index = this.type();

    ref.form = { kind: TypeKind.Indexed };
    ref.args.push(object);
    ref.args.push(index);
    this.cursor.expect(TokenKind.RBracket, Code.ExpectedIndexedAccessClose);

    return ref;
  }

  private indexAhead(): boolean {
    const token = this.cursor.peek();

    return token.kind == TokenKind.LBracket && !token.newline;
  }

  private readonlyType(): TypeRef {
    const keyword = this.cursor.next();
    const ref = this.prefixedType();
    const form = ref.form;

    if (form.kind == TypeKind.Tuple) {
      form.readonly = ref.args.map((arg) => true);
    } else if (form.kind != TypeKind.Array) {
      this.cursor.report(keyword.start, Code.ReadonlyOnlyArrays);
    }

    return ref;
  }

  private primaryType(): TypeRef {
    const token = this.cursor.peek();
    const next = this.cursor.lookahead();

    switch (token.kind) {
      case TokenKind.LBrace:
        return this.objectType();
      case TokenKind.LBracket:
        return this.tupleType();
      case TokenKind.Less:
        return this.genericFunctionType();

      case TokenKind.LParen:
        if (this.functionTypeAhead()) {
          return this.functionType();
        }
        return this.parenthesizedType();

      case TokenKind.TemplateString:
      case TokenKind.TemplateHead:
        return this.templateType();

      case TokenKind.String:
        return this.stringLiteralType();
      case TokenKind.True:
      case TokenKind.False:
        return this.booleanLiteralType();

      case TokenKind.Int:
      case TokenKind.Float:
        return this.numberType();
      case TokenKind.Minus:
        if (next.kind == TokenKind.Int || next.kind == TokenKind.Float) {
          return this.numberType();
        }
        return this.missingType();

      case TokenKind.Typeof:
        return this.typeOfType();

      case TokenKind.Infer:
        if (kTokenTable.isName(next.kind)) {
          return this.inferType();
        }
        return this.namedType();

      case TokenKind.This:
      case TokenKind.Void:
        return this.namedType();
      default:
        if (this.cursor.atName()) {
          return this.namedType();
        }
        return this.missingType();
    }
  }

  private parenthesizedType(): TypeRef {
    this.cursor.next();
    const inner = this.type();
    this.cursor.expect(TokenKind.RParen, Code.ExpectedParenthesizedTypeClose);

    return inner;
  }

  private namedType(): TypeRef {
    const first = this.cursor.next();
    const ref = this.typeRef(first.start);
    ref.name = first.text;

    while (this.qualifiedPartAhead()) {
      this.cursor.next();
      const part = this.cursor.next();
      ref.name = this.keepName(`${ref.name}.${part.text}`);
    }
    if (this.cursor.is(TokenKind.Less)) {
      ref.form = { kind: TypeKind.Generic };
      ref.args = this.typeArguments();
    }

    return ref;
  }

  private missingType(): TypeRef {
    const token = this.cursor.peek();
    this.cursor.error(token.start, Code.ExpectedType, { found: token.kind });

    return this.typeRef(token.start);
  }

  private stringLiteralType(): TypeRef {
    const token = this.cursor.next();
    const decoded = this.literals.string(token);
    const ref = this.typeRef(token.start);

    ref.form = {
      kind: TypeKind.Literal,
      text: decoded.text,
      number: 0.0,
      integer: false,
    };
    ref.name = "string";

    return ref;
  }

  private booleanLiteralType(): TypeRef {
    const token = this.cursor.next();
    const truth = token.kind == TokenKind.True ? 1.0 : 0.0;
    const ref = this.typeRef(token.start);

    ref.form = {
      kind: TypeKind.Literal,
      text: "",
      number: truth,
      integer: false,
    };
    ref.name = "boolean";

    return ref;
  }

  private genericFunctionType(): TypeRef {
    const less = this.cursor.peek();

    this.typeParams();
    if (this.cursor.is(TokenKind.LParen)) {
      this.functionType();
    }

    this.cursor.report(less.start, Code.GenericFunctionType);

    return this.typeRef(less.start);
  }

  private inferType(): TypeRef {
    const keyword = this.cursor.peek();
    const ref = this.typeRef(keyword.start);
    ref.form = { kind: TypeKind.Infer };

    this.cursor.next();
    const variable = this.cursor.next();
    ref.name = variable.text;

    if (!this.cursor.is(TokenKind.Extends)) {
      return ref;
    }

    const start = this.cursor.mark();
    this.cursor.next();
    const constraint = this.type(TypePlace.ExtendsClause);

    const extendsClause = this.context.typePlace == TypePlace.ExtendsClause;
    if (extendsClause || !this.cursor.is(TokenKind.Question)) {
      ref.args.push(constraint);
    } else {
      this.cursor.reset(start);
    }

    return ref;
  }

  private templateType(): TypeRef {
    const token = this.cursor.peek();
    const ref = this.typeRef(token.start);
    const first = this.literals.templatePart(token);

    this.cursor.next();

    if (token.kind == TokenKind.TemplateString) {
      ref.form = {
        kind: TypeKind.Literal,
        text: first.text,
        number: 0.0,
        integer: false,
      };
      ref.name = "string";

      return ref;
    }

    const parts: TemplateTypeForm = {
      kind: TypeKind.Template,
      texts: [first.text],
    };
    ref.form = parts;

    let piece = token;
    while (
      piece.kind == TokenKind.TemplateHead ||
      piece.kind == TokenKind.TemplateMiddle
    ) {
      const part = this.type();
      ref.args.push(part);

      const middle = this.cursor.peek();
      if (
        middle.kind != TokenKind.TemplateMiddle &&
        middle.kind != TokenKind.TemplateTail
      ) {
        this.cursor.error(middle.start, Code.ExpectedTemplateTypeClose);

        return this.typeRef(token.start);
      }

      const text = this.literals.templatePart(middle);
      parts.texts.push(text.text);
      piece = this.cursor.next();
    }

    return ref;
  }

  private numberType(): TypeRef {
    const first = this.cursor.peek();
    const ref = this.typeRef(first.start);
    const negative = this.cursor.accept(TokenKind.Minus);

    const lit = this.cursor.is(TokenKind.Int)
      ? this.intLiteral()
      : this.floatLiteral();

    let number = 0.0;
    let integer = false;

    if (lit.kind == ExprKind.IntLit) {
      number = this.integerAsDouble(lit.value);
      integer = true;
    } else if (lit.kind == ExprKind.FloatLit) {
      number = lit.value;
    }
    if (negative) {
      number = -number;
    }

    ref.form = { kind: TypeKind.Literal, text: "", number, integer };
    ref.name = "number";

    return ref;
  }

  private typeOfType(): TypeRef {
    const keyword = this.cursor.peek();
    const ref = this.typeRef(keyword.start);
    const names: string[] = [];
    ref.form = { kind: TypeKind.TypeOf, names };

    this.cursor.next();

    if (!this.cursor.atNameOrThis()) {
      const token = this.cursor.peek();
      this.cursor.error(token.start, Code.ExpectedTypeofName, {
        found: token.kind,
      });

      return ref;
    }

    const first = this.cursor.next();
    names.push(first.text);

    while (this.qualifiedPartAhead()) {
      this.cursor.next();
      const part = this.cursor.next();
      names.push(part.text);
    }

    return ref;
  }

  private typeArguments(): TypeRef[] {
    this.cursor.next();
    const args: TypeRef[] = [this.type()];

    while (this.cursor.accept(TokenKind.Comma)) {
      const arg = this.type();
      args.push(arg);
    }
    if (!this.cursor.accept(TokenKind.Greater)) {
      const token = this.cursor.peek();
      this.cursor.error(token.start, Code.ExpectedTypeArgumentsClose, {
        found: token.kind,
      });
    }

    return args;
  }

  private tryTypeArguments(callOnly: boolean): TypeRef[] | undefined {
    const start = this.cursor.mark();

    this.cursor.startDiscarding();
    this.cursor.stopRecovering();

    const parsed = this.typeArguments();
    const fits =
      !this.cursor.isRecovering() && this.followsTypeArguments(callOnly);

    this.cursor.stopDiscarding();

    if (!fits) {
      this.cursor.reset(start);

      return undefined;
    }

    this.cursor.restoreRecovering(start);

    return parsed;
  }

  private followsTypeArguments(callOnly: boolean): boolean {
    const token = this.cursor.peek();

    switch (token.kind) {
      case TokenKind.LParen:
        return true;
      case TokenKind.RParen:
      case TokenKind.RBracket:
      case TokenKind.RBrace:
      case TokenKind.Comma:
      case TokenKind.Semi:
      case TokenKind.Colon:
      case TokenKind.End:
        return !callOnly;
      default:
        return token.newline && !callOnly;
    }
  }

  private qualifiedPartAhead(): boolean {
    const next = this.cursor.lookahead();

    return this.cursor.is(TokenKind.Dot) && kTokenTable.isName(next.kind);
  }

  private mappedTypeAhead(): boolean {
    const next = this.cursor.lookahead();
    const after = this.cursor.tokenAt(2);

    return (
      this.cursor.is(TokenKind.LBracket) &&
      kTokenTable.isName(next.kind) &&
      after.kind == TokenKind.In
    );
  }

  private mappedType(object: TypeRef, readonlyChange: ModifierChange): TypeRef {
    const ref = this.typeRef(object.loc);
    const mapped: MappedTypeForm = {
      kind: TypeKind.Mapped,
      optionalChange: ModifierChange.None,
      readonlyChange,
    };

    ref.form = mapped;
    this.cursor.accept(TokenKind.LBracket);
    const variable = this.cursor.next();

    ref.name = variable.text;
    this.cursor.accept(TokenKind.In);
    const keys = this.type();

    ref.args.push(keys);
    const rename = this.cursor.accept(TokenKind.As) ? this.type() : undefined;

    if (!this.cursor.expect(TokenKind.RBracket, Code.ExpectedAfterMappedKeys)) {
      this.cursor.skipToClosingBrace();
      return ref;
    }
    mapped.optionalChange = this.acceptModifier(TokenKind.Question);
    if (!this.cursor.expect(TokenKind.Colon, Code.ExpectedBeforeMappedValues)) {
      this.cursor.skipToClosingBrace();
      return ref;
    }

    const values = this.type();
    ref.args.push(values);

    if (rename != undefined) {
      ref.args.push(rename);
    }
    if (!this.cursor.accept(TokenKind.Semi)) {
      this.cursor.accept(TokenKind.Comma);
    }
    if (!this.cursor.is(TokenKind.RBrace) || object.args.length > 0) {
      const token = this.cursor.peek();
      this.skipObjectType(token.start, Code.MappedTypeNextToFields);

      return ref;
    }

    this.cursor.next();

    return ref;
  }

  private acceptModifier(modifier: TokenKind): ModifierChange {
    const sign = this.acceptSignBefore(modifier);
    const present = this.cursor.accept(modifier);

    if (sign != ModifierChange.None) {
      return sign;
    }
    if (present) {
      return ModifierChange.Add;
    }

    return ModifierChange.None;
  }

  private acceptSignBefore(modifier: TokenKind): ModifierChange {
    const next = this.cursor.lookahead();
    if (next.kind != modifier) {
      return ModifierChange.None;
    }

    if (this.cursor.accept(TokenKind.Minus)) {
      return ModifierChange.Remove;
    }
    if (this.cursor.accept(TokenKind.Plus)) {
      return ModifierChange.Add;
    }

    return ModifierChange.None;
  }

  private fieldName(): string | undefined {
    if (this.cursor.symbolKeyAhead()) {
      return this.symbolName();
    }
    const token = this.cursor.peek();
    const name = this.fieldNameOf(token);

    if (name == undefined) {
      const code = this.fieldNameProblem(token.kind);
      this.cursor.error(token.start, code, { found: token.kind });

      return undefined;
    }

    this.fieldNames.add(name);
    this.cursor.next();

    return name;
  }

  private fieldNameOf(token: Token): string | undefined {
    if (token.kind == TokenKind.String) {
      const decoded = this.literals.string(token);

      return this.keepName(decoded.text);
    }
    if (
      token.kind == TokenKind.Identifier ||
      kTokenTable.isKeyword(token.kind)
    ) {
      return token.text;
    }

    return undefined;
  }

  private fieldNameProblem(kind: TokenKind): Code {
    switch (kind) {
      case TokenKind.LBracket:
        return Code.FieldNameInBrackets;
      case TokenKind.Int:
      case TokenKind.Float:
        return Code.NumberFieldName;
      default:
        return Code.ExpectedFieldName;
    }
  }

  private symbolName(): string | undefined {
    const bracket = this.cursor.peek();
    const loc = bracket.start;

    this.cursor.skip(2);
    if (!this.cursor.expect(TokenKind.Dot, Code.ExpectedAfterSymbol)) {
      return undefined;
    }

    const member = this.cursor.next();
    if (!this.cursor.expect(TokenKind.RBracket, Code.ExpectedSymbolNameClose)) {
      return undefined;
    }

    const name = this.symbolMemberName(member.known);
    if (name == undefined) {
      this.cursor.report(loc, Code.SymbolMemberName, { word: member.text });

      return kSymbolIteratorName;
    }

    return name;
  }

  private symbolMemberName(known: KnownName): string | undefined {
    switch (known) {
      case KnownName.AsyncIterator:
        return kSymbolAsyncIteratorName;
      case KnownName.Dispose:
        return kSymbolDisposeName;
      case KnownName.Iterator:
        return kSymbolIteratorName;
      default:
        return undefined;
    }
  }

  private objectType(): TypeRef {
    const brace = this.cursor.next();
    const ref = this.typeRef(brace.start);
    const object: ObjectTypeForm = {
      kind: TypeKind.Object,
      names: [],
      locs: [],
      optional: [],
      readonly: [],
      methods: [],
    };
    ref.form = object;

    while (this.cursor.insideList(TokenKind.RBrace)) {
      const first = this.cursor.peek();

      let readonlyChange = this.acceptSignBefore(TokenKind.Readonly);
      const readonly = this.acceptReadonlyWord();
      if (readonly && readonlyChange == ModifierChange.None) {
        readonlyChange = ModifierChange.Add;
      }

      const head = this.cursor.peek();
      const loc = readonly ? head.start : first.start;

      if (this.mappedTypeAhead()) {
        return this.mappedType(ref, readonlyChange);
      }
      if (this.cursor.is(TokenKind.LBracket) && !this.cursor.symbolKeyAhead()) {
        return this.indexSignature(ref, loc);
      }
      if (
        this.cursor.is(TokenKind.LParen) ||
        this.cursor.is(TokenKind.Less) ||
        this.cursor.is(TokenKind.New)
      ) {
        this.skipObjectType(loc, Code.CallSignatures);

        return ref;
      }

      const member = this.objectTypeMember(loc, readonly);
      if (member == undefined) {
        return ref;
      }

      this.addObjectTypeMember(ref, object, member);

      const separatorCode = member.method
        ? Code.ExpectedSemicolonAfterMethod
        : Code.ExpectedSemicolonAfterField;
      if (!this.endObjectTypeMember(separatorCode)) {
        return ref;
      }
    }

    this.cursor.expect(TokenKind.RBrace, Code.ExpectedObjectTypeClose);

    return ref;
  }

  private acceptReadonlyWord(): boolean {
    const next = this.cursor.lookahead();
    const fieldName =
      next.kind == TokenKind.Colon ||
      next.kind == TokenKind.Question ||
      next.kind == TokenKind.LParen;

    if (!this.cursor.is(TokenKind.Readonly) || fieldName) {
      return false;
    }
    this.cursor.next();

    return true;
  }

  private skipObjectType(
    loc: int,
    code: Code,
    details: Details = kNoDetails,
  ): void {
    this.cursor.error(loc, code, details);
    this.cursor.skipToClosingBrace();
  }

  private addObjectTypeMember(
    ref: TypeRef,
    object: ObjectTypeForm,
    member: ObjectTypeMember,
  ): void {
    ref.args.push(member.type);
    object.names.push(member.name);
    object.locs.push(member.loc);
    object.optional.push(member.optional);
    object.readonly.push(member.readonly);
    object.methods.push(member.method);
  }

  private objectTypeMember(
    loc: int,
    readonly: boolean,
  ): ObjectTypeMember | undefined {
    const name = this.fieldName();
    if (name == undefined) {
      this.cursor.skipToClosingBrace();

      return undefined;
    }

    const optional = this.cursor.accept(TokenKind.Question);
    const token = this.cursor.peek();

    switch (token.kind) {
      case TokenKind.LParen:
        return this.objectTypeMethod(name, loc, optional);
      case TokenKind.Colon:
        return this.objectTypeField(name, loc, optional, readonly);
      case TokenKind.Less:
        this.skipObjectType(token.start, Code.GenericTypeMethods);
        return undefined;
      default:
        this.skipObjectType(token.start, Code.FieldNeedsType, { word: name });
        return undefined;
    }
  }

  private objectTypeField(
    name: string,
    loc: int,
    optional: boolean,
    readonly: boolean,
  ): ObjectTypeMember {
    this.cursor.next();
    const type = this.type();

    return { name, loc, optional, readonly, method: false, type };
  }

  private objectTypeMethod(
    name: string,
    loc: int,
    optional: boolean,
  ): ObjectTypeMember | undefined {
    const parsed = this.signatureParams();
    if (!parsed.complete || this.cursor.isRecovering()) {
      this.cursor.skipToClosingBrace();

      return undefined;
    }
    if (!this.cursor.accept(TokenKind.Colon)) {
      const token = this.cursor.peek();
      this.skipObjectType(token.start, Code.MethodNeedsReturnType, {
        word: name,
      });

      return undefined;
    }

    const signature = parsed.type;
    const result = this.type();
    signature.args.push(result);

    return {
      name,
      loc,
      optional,
      readonly: true,
      method: true,
      type: signature,
    };
  }

  private endObjectTypeMember(code: Code): boolean {
    if (
      this.cursor.accept(TokenKind.Semi) ||
      this.cursor.accept(TokenKind.Comma)
    ) {
      return true;
    }

    const token = this.cursor.peek();
    if (token.kind != TokenKind.RBrace && !token.newline) {
      this.skipObjectType(token.start, code, { found: token.kind });

      return false;
    }

    return true;
  }

  private indexSignature(ref: TypeRef, loc: int): TypeRef {
    this.cursor.next();
    const next = this.cursor.lookahead();

    if (!this.cursor.atName() || next.kind != TokenKind.Colon) {
      this.skipObjectType(loc, Code.ExpectedIndexSignatureOrMapped);

      return ref;
    }

    this.cursor.skip(2);
    const key = this.type();

    if (
      !this.cursor.expect(TokenKind.RBracket, Code.ExpectedAfterIndexKeys) ||
      !this.cursor.expect(TokenKind.Colon, Code.ExpectedBeforeIndexValues)
    ) {
      this.cursor.skipToClosingBrace();

      return ref;
    }

    const value = this.type();

    if (!this.cursor.accept(TokenKind.Semi)) {
      this.cursor.accept(TokenKind.Comma);
    }
    if (ref.args.length > 0 || !this.cursor.is(TokenKind.RBrace)) {
      this.skipObjectType(loc, Code.IndexSignatureNextToFields);

      return ref;
    }

    this.cursor.next();
    const record = this.typeRef(ref.loc);

    record.form = { kind: TypeKind.Generic };
    record.name = "Record";
    record.args.push(key);
    record.args.push(value);

    return record;
  }

  private tupleType(): TypeRef {
    const bracket = this.cursor.peek();
    const ref = this.typeRef(bracket.start);

    const tuple: TupleTypeForm = {
      kind: TypeKind.Tuple,
      readonly: [],
      spread: [],
    };

    ref.form = tuple;
    this.cursor.next();

    while (this.cursor.insideList(TokenKind.RBracket)) {
      const spread = this.cursor.accept(TokenKind.Ellipsis);
      const next = this.cursor.lookahead();

      if (this.cursor.atName() && next.kind == TokenKind.Colon) {
        this.cursor.skip(2);
      }
      const element = this.type();

      ref.args.push(element);
      tuple.readonly.push(false);
      tuple.spread.push(spread);

      if (this.cursor.is(TokenKind.Question)) {
        const token = this.cursor.peek();
        this.cursor.report(token.start, Code.OptionalTupleElements);
        this.cursor.next();
      }
      if (!this.cursor.accept(TokenKind.Comma)) {
        break;
      }
    }

    this.cursor.expect(TokenKind.RBracket, Code.ExpectedTupleClose);

    return ref;
  }

  private functionTypeAhead(): boolean {
    const start = this.cursor.mark();

    this.cursor.startDiscarding();
    this.cursor.stopRecovering();
    this.cursor.next();

    const fits = this.scansAsFunctionType();

    this.cursor.stopDiscarding();
    this.cursor.reset(start);

    return fits;
  }

  private scansAsFunctionType(): boolean {
    while (!this.cursor.is(TokenKind.RParen)) {
      this.cursor.accept(TokenKind.Ellipsis);
      if (!this.cursor.atNameOrThis()) {
        return false;
      }

      this.cursor.next();
      this.cursor.accept(TokenKind.Question);

      if (this.cursor.accept(TokenKind.Colon)) {
        this.type();
        if (this.cursor.isRecovering()) {
          return false;
        }
      }
      if (!this.cursor.accept(TokenKind.Comma)) {
        break;
      }
    }

    return (
      this.cursor.accept(TokenKind.RParen) && this.cursor.is(TokenKind.Arrow)
    );
  }

  private functionType(): TypeRef {
    const parsed = this.signatureParams();
    const ref = parsed.type;
    if (!parsed.complete) {
      return ref;
    }

    this.cursor.expect(
      TokenKind.Arrow,
      Code.ExpectedAfterFunctionTypeParameters,
    );
    const result = this.returnType();
    ref.args.push(result);

    return ref;
  }

  private signatureParams(): Signature {
    const paren = this.cursor.next();
    const ref = this.typeRef(paren.start);
    const signature: FunctionTypeForm = {
      kind: TypeKind.Function,
      names: [],
      optional: [],
      rest: false,
    };
    ref.form = signature;

    while (this.cursor.insideList(TokenKind.RParen)) {
      const rest = this.cursor.accept(TokenKind.Ellipsis);
      const name = this.cursor.peek();
      const named =
        this.cursor.accept(TokenKind.This) ||
        this.cursor.expectName(Code.ExpectedFunctionTypeParameter);
      if (!named) {
        return { type: ref, complete: false };
      }

      const optional = this.cursor.accept(TokenKind.Question);
      const type = this.signatureParamType(name);

      if (signature.rest) {
        this.cursor.report(name.start, Code.RestParameterNotLast);
      }
      if (rest) {
        signature.rest = true;
      }

      ref.args.push(type);
      signature.names.push(name.text);
      signature.optional.push(optional);

      if (!this.cursor.accept(TokenKind.Comma)) {
        break;
      }
    }

    this.cursor.expect(
      TokenKind.RParen,
      Code.ExpectedFunctionTypeParametersClose,
    );

    return { type: ref, complete: true };
  }

  private signatureParamType(name: Token): TypeRef {
    if (this.cursor.accept(TokenKind.Colon)) {
      return this.type();
    }

    this.cursor.report(name.start, Code.FunctionTypeParameterNeedsType, {
      word: name.text,
    });

    return this.typeRef(name.start);
  }

  private integerAsDouble(whole: uint64): double {
    if (whole <= kExactDoubleLimit) {
      return whole.toDouble();
    }
    const text = `${whole}`;
    const parsed = Number(text);

    return parsed.unwrapOr(0.0);
  }

  private typeRef(loc?: int): TypeRef {
    return {
      form: { kind: TypeKind.Name },
      name: "",
      loc,
      args: [],
    };
  }
}
