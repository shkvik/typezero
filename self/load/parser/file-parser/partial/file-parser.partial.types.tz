import { FileParser } from "../file-parser.tz";
import { Code } from "../../../../diagnostic/code.tz";
import {
  KnownName,
  TokenKind,
  isKeyword,
  isName,
} from "../../../../token.tz";
import {
  ExprKind,
  FunctionTypeForm,
  MappedTypeForm,
  ModifierChange,
  ObjectTypeForm,
  TemplateTypeForm,
  TupleTypeForm,
  TypeKind,
  TypeRef,
  typeRef,
} from "../../../../ast.tz";
import { TypePlace } from "../types/file-parser.types.context.tz";

const kExactDoubleLimit: uint64 = 9007199254740992;

function integerAsDouble(whole: uint64): double {
  if (whole <= kExactDoubleLimit) {
    return whole.toDouble();
  }
  const text = `${whole}`;
  const parsed = Number(text);

  return parsed.unwrapOr(0.0);
}

partial class FileParser {
  private type(place: TypePlace = TypePlace.Plain): TypeRef {
    const head = this.cursor.peek();
    const start = head.start;
    const outer = this.context;
    this.context = { ...outer, typePlace: place };
    const check = this.unionType();
    this.context = outer;
    const extendsClause = place == TypePlace.ExtendsClause;
    if (extendsClause || !this.cursor.is(TokenKind.Extends)) {
      return check;
    }
    const ref = typeRef(check.loc);
    ref.form = { kind: TypeKind.Conditional };
    this.cursor.next();
    ref.args.push(check);
    const extendsType = this.type(TypePlace.ExtendsClause);
    ref.args.push(extendsType);
    if (
      !this.cursor.expect(TokenKind.Question, Code.ExpectedAfterExtendsClause)
    ) {
      return typeRef(start);
    }
    const whenTrue = this.type();
    ref.args.push(whenTrue);
    if (!this.cursor.expect(TokenKind.Colon, Code.ExpectedBetweenBranches)) {
      return typeRef(start);
    }
    const whenFalse = this.type();
    ref.args.push(whenFalse);
    ref.source = this.cursor.spanFrom(start);

    return ref;
  }

  private unionType(): TypeRef {
    const head = this.cursor.peek();
    const loc = head.start;
    this.cursor.accept(TokenKind.Pipe);
    const first = this.intersectionType();
    if (!this.cursor.is(TokenKind.Pipe)) {
      return first;
    }
    const ref = typeRef(loc);
    ref.form = { kind: TypeKind.Union };
    ref.args.push(first);
    while (this.cursor.accept(TokenKind.Pipe)) {
      const next = this.intersectionType();
      ref.args.push(next);
    }

    return ref;
  }

  private intersectionType(): TypeRef {
    const head = this.cursor.peek();
    const loc = head.start;
    this.cursor.accept(TokenKind.Amp);
    const first = this.arrayType();
    if (!this.cursor.is(TokenKind.Amp)) {
      return first;
    }
    const ref = typeRef(loc);
    ref.form = { kind: TypeKind.Intersection };
    ref.args.push(first);
    while (this.cursor.accept(TokenKind.Amp)) {
      const next = this.arrayType();
      ref.args.push(next);
    }

    return ref;
  }

  private subjectAhead(): boolean {
    const next = this.cursor.lookahead();
    const subject = isName(next.kind) || next.kind == TokenKind.This;

    return subject && !next.newline;
  }

  private isAhead(): boolean {
    const next = this.cursor.lookahead();

    return next.kind == TokenKind.Is && !next.newline;
  }

  private returnType(): TypeRef {
    const asserts = this.cursor.is(TokenKind.Asserts) && this.subjectAhead();
    const predicate = this.cursor.atNameOrThis() && this.isAhead();
    if (!asserts && !predicate) {
      return this.type();
    }
    const token = this.cursor.peek();
    const ref = typeRef(token.start);
    ref.form = { kind: TypeKind.Predicate, asserts };
    if (asserts) {
      this.cursor.next();
    }
    const subject = this.cursor.next();
    ref.name = subject.text;
    const following = this.cursor.peek();
    if (following.kind == TokenKind.Is && !following.newline) {
      this.cursor.next();
      const type = this.type();
      ref.args.push(type);
    }

    return ref;
  }

  private arrayType(): TypeRef {
    const next = this.cursor.lookahead();
    const keyOf =
      this.cursor.is(TokenKind.Keyof) &&
      (isName(next.kind) ||
        next.kind == TokenKind.LParen ||
        next.kind == TokenKind.LBrace ||
        next.kind == TokenKind.Typeof);

    if (keyOf) {
      const token = this.cursor.peek();
      const ref = typeRef(token.start);
      ref.form = { kind: TypeKind.KeyOf };
      this.cursor.next();
      const inner = this.arrayType();
      ref.args.push(inner);
      return ref;
    }

    const readonly =
      this.cursor.is(TokenKind.Readonly) &&
      (isName(next.kind) ||
        next.kind == TokenKind.LParen ||
        next.kind == TokenKind.LBracket);

    if (readonly) {
      return this.readonlyType();
    }
    let ref = this.primaryType();

    while (this.indexAhead()) {
      const array = typeRef(ref.loc);
      this.cursor.next();
      if (this.cursor.accept(TokenKind.RBracket)) {
        array.form = { kind: TypeKind.Array };
        array.args.push(ref);
        ref = array;
        continue;
      }
      array.form = { kind: TypeKind.Indexed };
      array.args.push(ref);
      const index = this.type();
      array.args.push(index);
      this.cursor.expect(TokenKind.RBracket, Code.ExpectedIndexedAccessClose);
      ref = array;
    }

    return ref;
  }

  private indexAhead(): boolean {
    const token = this.cursor.peek();

    return token.kind == TokenKind.LBracket && !token.newline;
  }

  private readonlyType(): TypeRef {
    const keyword = this.cursor.peek();
    const loc = keyword.start;
    this.cursor.next();
    const ref = this.arrayType();
    const form = ref.form;
    if (form.kind == TypeKind.Tuple) {
      form.readonly = ref.args.map((arg) => true);
    } else if (form.kind != TypeKind.Array) {
      this.cursor.report(loc, Code.ReadonlyOnlyArrays);
    }

    return ref;
  }

  private primaryType(): TypeRef {
    const token = this.cursor.peek();
    const ref = typeRef(token.start);
    switch (token.kind) {
      case TokenKind.LBrace:
        return this.objectType();
      case TokenKind.LBracket:
        return this.tupleType();
      case TokenKind.Less:
        return this.genericFunctionType();
      case TokenKind.TemplateString:
      case TokenKind.TemplateHead:
        return this.templateType(ref);
      case TokenKind.String: {
        const decoded = this.literals.string(token);
        ref.form = {
          kind: TypeKind.Literal,
          text: decoded.text,
          number: 0.0,
          integer: false,
        };
        ref.name = "string";
        this.cursor.next();
        return ref;
      }
      case TokenKind.True:
      case TokenKind.False: {
        const truth = token.kind == TokenKind.True ? 1.0 : 0.0;
        ref.form = {
          kind: TypeKind.Literal,
          text: "",
          number: truth,
          integer: false,
        };
        ref.name = "boolean";
        this.cursor.next();
        return ref;
      }
      case TokenKind.Typeof:
        return this.typeOfType(ref);
      default:
        return this.otherPrimaryType(ref);
    }
  }

  private otherPrimaryType(ref: TypeRef): TypeRef {
    const next = this.cursor.lookahead();
    if (this.cursor.is(TokenKind.LParen) && this.functionTypeAhead()) {
      return this.functionType();
    }
    if (this.cursor.is(TokenKind.Infer) && isName(next.kind)) {
      return this.inferType(ref);
    }
    const negative =
      this.cursor.is(TokenKind.Minus) &&
      (next.kind == TokenKind.Int || next.kind == TokenKind.Float);
    if (
      negative ||
      this.cursor.is(TokenKind.Int) ||
      this.cursor.is(TokenKind.Float)
    ) {
      return this.numberType(ref, negative);
    }
    if (this.cursor.accept(TokenKind.LParen)) {
      const inner = this.type();
      this.cursor.expect(TokenKind.RParen, Code.ExpectedParenthesizedTypeClose);
      return inner;
    }
    if (!this.cursor.atNameOrThis() && !this.cursor.is(TokenKind.Void)) {
      const token = this.cursor.peek();
      this.cursor.error(token.start, Code.ExpectedType, { found: token.kind });
      return ref;
    }
    const first = this.cursor.next();
    ref.name = first.text;
    while (this.qualifiedPartAhead()) {
      this.cursor.next();
      const part = this.cursor.next();
      ref.name = this.keepName(`${ref.name}.${part.text}`);
    }
    if (this.cursor.is(TokenKind.Less)) {
      ref.form = { kind: TypeKind.Generic };
      ref.args = this.typeArguments();
    }

    return ref;
  }

  private genericFunctionType(): TypeRef {
    const less = this.cursor.peek();
    this.typeParams();
    if (this.cursor.is(TokenKind.LParen)) {
      this.functionType();
    }
    this.cursor.report(less.start, Code.GenericFunctionType);

    return typeRef(less.start);
  }

  private inferType(ref: TypeRef): TypeRef {
    ref.form = { kind: TypeKind.Infer };
    this.cursor.next();
    const variable = this.cursor.next();
    ref.name = variable.text;
    if (!this.cursor.is(TokenKind.Extends)) {
      return ref;
    }
    const start = this.cursor.mark();
    this.cursor.next();
    const constraint = this.type(TypePlace.ExtendsClause);
    const extendsClause = this.context.typePlace == TypePlace.ExtendsClause;
    if (extendsClause || !this.cursor.is(TokenKind.Question)) {
      ref.args.push(constraint);
    } else {
      this.cursor.reset(start);
    }

    return ref;
  }

  private templateType(ref: TypeRef): TypeRef {
    const token = this.cursor.peek();
    const first = this.literals.templatePart(token);
    this.cursor.next();
    if (token.kind == TokenKind.TemplateString) {
      ref.form = {
        kind: TypeKind.Literal,
        text: first.text,
        number: 0.0,
        integer: false,
      };
      ref.name = "string";
      return ref;
    }
    const parts: TemplateTypeForm = {
      kind: TypeKind.Template,
      texts: [first.text],
    };
    ref.form = parts;
    let piece = token;
    while (
      piece.kind == TokenKind.TemplateHead ||
      piece.kind == TokenKind.TemplateMiddle
    ) {
      const part = this.type();
      ref.args.push(part);
      const middle = this.cursor.peek();
      if (
        middle.kind != TokenKind.TemplateMiddle &&
        middle.kind != TokenKind.TemplateTail
      ) {
        this.cursor.error(middle.start, Code.ExpectedTemplateTypeClose);
        return typeRef(token.start);
      }
      const text = this.literals.templatePart(middle);
      parts.texts.push(text.text);
      piece = this.cursor.next();
    }

    return ref;
  }

  private numberType(ref: TypeRef, negative: boolean): TypeRef {
    if (negative) {
      this.cursor.next();
    }
    const lit = this.cursor.is(TokenKind.Int)
      ? this.intLiteral()
      : this.floatLiteral();
    let number = 0.0;
    let integer = false;
    if (lit.kind == ExprKind.IntLit) {
      number = integerAsDouble(lit.value);
      integer = true;
    } else if (lit.kind == ExprKind.FloatLit) {
      number = lit.value;
    }
    if (negative) {
      number = -number;
    }
    ref.form = { kind: TypeKind.Literal, text: "", number, integer };
    ref.name = "number";

    return ref;
  }

  private typeOfType(ref: TypeRef): TypeRef {
    const names: string[] = [];
    ref.form = { kind: TypeKind.TypeOf, names };
    this.cursor.next();
    if (!this.cursor.atNameOrThis()) {
      const token = this.cursor.peek();
      this.cursor.error(
        token.start,
        Code.ExpectedTypeofName,
        { found: token.kind },
      );
      return ref;
    }
    const first = this.cursor.next();
    names.push(first.text);
    while (this.qualifiedPartAhead()) {
      this.cursor.next();
      const part = this.cursor.next();
      names.push(part.text);
    }

    return ref;
  }

  private typeArguments(): TypeRef[] {
    this.cursor.next();
    const args: TypeRef[] = [this.type()];
    while (this.cursor.accept(TokenKind.Comma)) {
      const arg = this.type();
      args.push(arg);
    }
    if (!this.cursor.accept(TokenKind.Greater)) {
      const token = this.cursor.peek();
      this.cursor.error(
        token.start,
        Code.ExpectedTypeArgumentsClose,
        { found: token.kind },
      );
    }

    return args;
  }

  private tryTypeArguments(callOnly: boolean): TypeRef[] | undefined {
    const start = this.cursor.mark();
    this.cursor.startDiscarding();
    this.cursor.stopRecovering();
    const parsed = this.typeArguments();
    const fits =
      !this.cursor.isRecovering() && this.followsTypeArguments(callOnly);
    this.cursor.stopDiscarding();
    if (!fits) {
      this.cursor.reset(start);
      return undefined;
    }
    this.cursor.restoreRecovering(start);

    return parsed;
  }

  private followsTypeArguments(callOnly: boolean): boolean {
    const token = this.cursor.peek();
    switch (token.kind) {
      case TokenKind.LParen:
        return true;
      case TokenKind.RParen:
      case TokenKind.RBracket:
      case TokenKind.RBrace:
      case TokenKind.Comma:
      case TokenKind.Semi:
      case TokenKind.Colon:
      case TokenKind.End:
        return !callOnly;
      default:
        return token.newline && !callOnly;
    }
  }

  private qualifiedPartAhead(): boolean {
    const next = this.cursor.lookahead();

    return this.cursor.is(TokenKind.Dot) && isName(next.kind);
  }

  private mappedTypeAhead(): boolean {
    const next = this.cursor.lookahead();
    const after = this.cursor.tokenAt(2);

    return (
      this.cursor.is(TokenKind.LBracket) &&
      isName(next.kind) &&
      after.kind == TokenKind.In
    );
  }

  private mappedType(
    object: TypeRef,
    readonlyChange: ModifierChange,
  ): TypeRef {
    const ref = typeRef(object.loc);
    const mapped: MappedTypeForm = {
      kind: TypeKind.Mapped,
      optionalChange: ModifierChange.None,
      readonlyChange,
    };
    
    ref.form = mapped;
    this.cursor.accept(TokenKind.LBracket);
    const variable = this.cursor.next();

    ref.name = variable.text;
    this.cursor.accept(TokenKind.In);
    const keys = this.type();
    
    ref.args.push(keys);
    const rename = this.cursor.accept(TokenKind.As) ? this.type() : undefined;
    
    if (
      !this.cursor.expect(TokenKind.RBracket, Code.ExpectedAfterMappedKeys)
    ) {
      this.cursor.skipToClosingBrace();
      return ref;
    }
    mapped.optionalChange = this.acceptModifier(TokenKind.Question);
    if (
      !this.cursor.expect(TokenKind.Colon, Code.ExpectedBeforeMappedValues)
    ) {
      this.cursor.skipToClosingBrace();
      return ref;
    }

    const values = this.type();
    ref.args.push(values);
    
    if (rename != undefined) {
      ref.args.push(rename);
    }
    if (!this.cursor.accept(TokenKind.Semi)) {
      this.cursor.accept(TokenKind.Comma);
    }
    if (!this.cursor.is(TokenKind.RBrace) || object.args.length > 0) {
      const token = this.cursor.peek();
      this.cursor.error(token.start, Code.MappedTypeNextToFields);
    
      this.cursor.skipToClosingBrace();
      return ref;
    }
    
    this.cursor.next();

    return ref;
  }

  private acceptModifier(modifier: TokenKind): ModifierChange {
    const next = this.cursor.lookahead();
    const signed =
      (this.cursor.is(TokenKind.Minus) || this.cursor.is(TokenKind.Plus)) &&
      next.kind == modifier;
    if (signed) {
      const sign = this.cursor.next();
      this.cursor.next();
      return sign.kind == TokenKind.Minus
        ? ModifierChange.Remove
        : ModifierChange.Add;
    }
    if (this.cursor.accept(modifier)) {
      return ModifierChange.Add;
    }

    return ModifierChange.None;
  }

  private fieldName(): string | undefined {
    if (this.cursor.symbolKeyAhead()) {
      return this.symbolName();
    }
    const token = this.cursor.peek();
    if (token.kind == TokenKind.Identifier || isKeyword(token.kind)) {
      this.fieldNames.add(token.text);
      this.cursor.next();
      return token.text;
    }
    if (token.kind == TokenKind.String) {
      const decoded = this.literals.string(token);
      const name = this.keepName(decoded.text);
      this.fieldNames.add(name);
      this.cursor.next();
      return name;
    }
    if (token.kind == TokenKind.LBracket) {
      this.cursor.error(token.start, Code.FieldNameInBrackets);
    } else if (token.kind == TokenKind.Int || token.kind == TokenKind.Float) {
      this.cursor.error(token.start, Code.NumberFieldName);
    } else {
      this.cursor.error(
        token.start,
        Code.ExpectedFieldName,
        { found: token.kind },
      );
    }

    return undefined;
  }

  private symbolName(): string | undefined {
    const bracket = this.cursor.peek();
    const loc = bracket.start;
    this.cursor.skip(2);
    if (!this.cursor.expect(TokenKind.Dot, Code.ExpectedAfterSymbol)) {
      return undefined;
    }
    const member = this.cursor.next();
    if (!this.cursor.expect(TokenKind.RBracket, Code.ExpectedSymbolNameClose)) {
      return undefined;
    }
    switch (member.known) {
      case KnownName.AsyncIterator:
        return "[Symbol.asyncIterator]";
      case KnownName.Dispose:
        return "[Symbol.dispose]";
      case KnownName.Iterator:
        return "[Symbol.iterator]";
      default:
        this.cursor.report(loc, Code.SymbolMemberName, { word: member.text });
        return "[Symbol.iterator]";
    }
  }

  private objectType(): TypeRef {
    const brace = this.cursor.peek();
    const ref = typeRef(brace.start);
    const object: ObjectTypeForm = {
      kind: TypeKind.Object,
      names: [],
      locs: [],
      optional: [],
      readonly: [],
      methods: [],
    };
    ref.form = object;
    this.cursor.next();
    while (
      !this.cursor.is(TokenKind.RBrace) &&
      !this.cursor.is(TokenKind.End)
    ) {
      const first = this.cursor.peek();
      let loc = first.start;
      let readonly = false;
      let readonlyChange = ModifierChange.None;
      const next = this.cursor.lookahead();
      if (
        (this.cursor.is(TokenKind.Minus) || this.cursor.is(TokenKind.Plus)) &&
        next.kind == TokenKind.Readonly
      ) {
        const sign = this.cursor.next();
        readonlyChange =
          sign.kind == TokenKind.Minus
            ? ModifierChange.Remove
            : ModifierChange.Add;
      }
      const after = this.cursor.lookahead();
      if (
        this.cursor.is(TokenKind.Readonly) &&
        after.kind != TokenKind.Colon &&
        after.kind != TokenKind.Question &&
        after.kind != TokenKind.LParen
      ) {
        readonly = true;
        if (readonlyChange == ModifierChange.None) {
          readonlyChange = ModifierChange.Add;
        }
        this.cursor.next();
        const member = this.cursor.peek();
        loc = member.start;
      }
      if (this.mappedTypeAhead()) {
        return this.mappedType(ref, readonlyChange);
      }
      if (this.cursor.is(TokenKind.LBracket) && !this.cursor.symbolKeyAhead()) {
        return this.indexSignature(ref, loc);
      }
      if (
        this.cursor.is(TokenKind.LParen) ||
        this.cursor.is(TokenKind.Less) ||
        this.cursor.is(TokenKind.New)
      ) {
        this.cursor.error(loc, Code.CallSignatures);
        this.cursor.skipToClosingBrace();
        return ref;
      }
      if (!this.objectTypeMember(ref, object, loc, readonly)) {
        return ref;
      }
    }
    this.cursor.expect(TokenKind.RBrace, Code.ExpectedObjectTypeClose);

    return ref;
  }

  private objectTypeMember(
    ref: TypeRef,
    object: ObjectTypeForm,
    loc: int,
    readonly: boolean,
  ): boolean {
    const name = this.fieldName();
    if (name == undefined) {
      this.cursor.skipToClosingBrace();
      return false;
    }
    const optional = this.cursor.accept(TokenKind.Question);
    if (this.cursor.is(TokenKind.Less)) {
      const token = this.cursor.peek();
      this.cursor.error(token.start, Code.GenericTypeMethods);
      this.cursor.skipToClosingBrace();
      return false;
    }
    if (this.cursor.is(TokenKind.LParen)) {
      return this.objectTypeMethod(ref, object, loc, name, optional);
    }
    if (!this.cursor.is(TokenKind.Colon)) {
      const token = this.cursor.peek();
      this.cursor.error(token.start, Code.FieldNeedsType, { word: name });
      this.cursor.skipToClosingBrace();
      return false;
    }
    this.cursor.next();
    const type = this.type();
    ref.args.push(type);
    object.names.push(name);
    object.locs.push(loc);
    object.optional.push(optional);
    object.readonly.push(readonly);
    object.methods.push(false);

    return this.endObjectTypeMember(Code.ExpectedSemicolonAfterField);
  }

  private objectTypeMethod(
    ref: TypeRef,
    object: ObjectTypeForm,
    loc: int,
    name: string,
    optional: boolean,
  ): boolean {
    const fn = typeRef();
    if (!this.signatureParams(fn) || this.cursor.isRecovering()) {
      this.cursor.skipToClosingBrace();
      return false;
    }
    if (!this.cursor.accept(TokenKind.Colon)) {
      const token = this.cursor.peek();
      this.cursor.error(
        token.start,
        Code.MethodNeedsReturnType,
        { word: name },
      );
      this.cursor.skipToClosingBrace();
      return false;
    }
    const result = this.type();
    fn.args.push(result);
    ref.args.push(fn);
    object.names.push(name);
    object.locs.push(loc);
    object.optional.push(optional);
    object.readonly.push(true);
    object.methods.push(true);

    return this.endObjectTypeMember(Code.ExpectedSemicolonAfterMethod);
  }

  private endObjectTypeMember(code: Code): boolean {
    if (
      this.cursor.accept(TokenKind.Semi) ||
      this.cursor.accept(TokenKind.Comma)
    ) {
      return true;
    }
    const token = this.cursor.peek();
    if (token.kind != TokenKind.RBrace && !token.newline) {
      this.cursor.error(token.start, code, { found: token.kind });
      this.cursor.skipToClosingBrace();
      return false;
    }

    return true;
  }

  private indexSignature(ref: TypeRef, loc: int): TypeRef {
    this.cursor.next();
    const next = this.cursor.lookahead();
    if (!this.cursor.atName() || next.kind != TokenKind.Colon) {
      this.cursor.error(loc, Code.ExpectedIndexSignatureOrMapped);
      this.cursor.skipToClosingBrace();
      return ref;
    }
    this.cursor.skip(2);
    const key = this.type();
    if (
      !this.cursor.expect(TokenKind.RBracket, Code.ExpectedAfterIndexKeys) ||
      !this.cursor.expect(TokenKind.Colon, Code.ExpectedBeforeIndexValues)
    ) {
      this.cursor.skipToClosingBrace();
      return ref;
    }
    const value = this.type();
    if (!this.cursor.accept(TokenKind.Semi)) {
      this.cursor.accept(TokenKind.Comma);
    }
    if (ref.args.length > 0 || !this.cursor.is(TokenKind.RBrace)) {
      this.cursor.error(loc, Code.IndexSignatureNextToFields);
      this.cursor.skipToClosingBrace();
      return ref;
    }
    this.cursor.next();
    const record = typeRef(ref.loc);
    record.form = { kind: TypeKind.Generic };
    record.name = "Record";
    record.args.push(key);
    record.args.push(value);

    return record;
  }

  private tupleType(): TypeRef {
    const bracket = this.cursor.peek();
    const ref = typeRef(bracket.start);
    const tuple: TupleTypeForm = {
      kind: TypeKind.Tuple,
      readonly: [],
      spread: [],
    };
    ref.form = tuple;
    this.cursor.next();
    while (this.cursor.insideList(TokenKind.RBracket)) {
      const spread = this.cursor.accept(TokenKind.Ellipsis);
      const next = this.cursor.lookahead();
      if (this.cursor.atName() && next.kind == TokenKind.Colon) {
        this.cursor.skip(2);
      }
      const element = this.type();
      ref.args.push(element);
      tuple.readonly.push(false);
      tuple.spread.push(spread);
      if (this.cursor.is(TokenKind.Question)) {
        const token = this.cursor.peek();
        this.cursor.report(token.start, Code.OptionalTupleElements);
        this.cursor.next();
      }
      if (!this.cursor.accept(TokenKind.Comma)) {
        break;
      }
    }
    this.cursor.expect(TokenKind.RBracket, Code.ExpectedTupleClose);

    return ref;
  }

  private functionTypeAhead(): boolean {
    const start = this.cursor.mark();
    this.cursor.startDiscarding();
    this.cursor.stopRecovering();
    this.cursor.next();
    const fits = this.scansAsFunctionType();
    this.cursor.stopDiscarding();
    this.cursor.reset(start);

    return fits;
  }

  private scansAsFunctionType(): boolean {
    while (!this.cursor.is(TokenKind.RParen)) {
      this.cursor.accept(TokenKind.Ellipsis);
      if (!this.cursor.atNameOrThis()) {
        return false;
      }
      this.cursor.next();
      this.cursor.accept(TokenKind.Question);
      if (this.cursor.accept(TokenKind.Colon)) {
        this.type();
        if (this.cursor.isRecovering()) {
          return false;
        }
      }
      if (!this.cursor.accept(TokenKind.Comma)) {
        break;
      }
    }

    return (
      this.cursor.accept(TokenKind.RParen) && this.cursor.is(TokenKind.Arrow)
    );
  }

  private functionType(): TypeRef {
    const ref = typeRef();
    if (!this.signatureParams(ref)) {
      return ref;
    }
    this.cursor.expect(
      TokenKind.Arrow,
      Code.ExpectedAfterFunctionTypeParameters,
    );
    const result = this.returnType();
    ref.args.push(result);

    return ref;
  }

  private signatureParams(ref: TypeRef): boolean {
    const signature: FunctionTypeForm = {
      kind: TypeKind.Function,
      names: [],
      optional: [],
      rest: false,
    };
    ref.form = signature;
    const paren = this.cursor.peek();
    ref.loc = paren.start;
    this.cursor.next();
    while (this.cursor.insideList(TokenKind.RParen)) {
      const rest = this.cursor.accept(TokenKind.Ellipsis);
      const token = this.cursor.peek();
      const named =
        this.cursor.accept(TokenKind.This) ||
        this.cursor.expectName(Code.ExpectedFunctionTypeParameter);
      if (!named) {
        return false;
      }
      const optional = this.cursor.accept(TokenKind.Question);
      let param = typeRef(token.start);
      if (this.cursor.accept(TokenKind.Colon)) {
        param = this.type();
      } else {
        this.cursor.report(
          token.start,
          Code.FunctionTypeParameterNeedsType,
          { word: token.text },
        );
      }
      if (signature.rest) {
        this.cursor.report(token.start, Code.RestParameterNotLast);
      }
      ref.args.push(param);
      signature.optional.push(optional);
      signature.names.push(token.text);
      signature.rest = signature.rest || rest;
      if (!this.cursor.accept(TokenKind.Comma)) {
        break;
      }
    }
    this.cursor.expect(
      TokenKind.RParen,
      Code.ExpectedFunctionTypeParametersClose,
    );

    return true;
  }
}
