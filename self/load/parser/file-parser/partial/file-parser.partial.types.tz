import { FileParser } from "../file-parser.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { TokenKind } from "../../../token/types/token.types.tz";
import { kTokenTable } from "../../../token/const/token.const.tz";
import {
  TemplateTypeForm,
  TupleTypeForm,
  TypeKind,
  TypeRef,
} from "../../../../program/ast/types/ast.types.types.tz";
import { ExprKind } from "../../../../program/ast/types/ast.types.expressions.tz";
import { TypePlace } from "../types/file-parser.types.context.tz";
import { kExactDoubleLimit } from "../const/file-parser.const.types.tz";

partial class FileParser {
  private type(place: TypePlace = TypePlace.Plain): TypeRef {
    const head = this.cursor.peek();
    const start = head.start;
    const outer = this.context;

    this.context = { ...outer, typePlace: place };
    const check = this.unionType();
    this.context = outer;

    const extendsClause = place == TypePlace.ExtendsClause;
    if (extendsClause || !this.cursor.is(TokenKind.Extends)) {
      return check;
    }

    const ref = this.typeRef(check.loc);
    ref.form = { kind: TypeKind.Conditional };
    this.cursor.next();
    ref.args.push(check);

    const extendsType = this.type(TypePlace.ExtendsClause);
    ref.args.push(extendsType);
    if (
      !this.cursor.expect(TokenKind.Question, Code.ExpectedAfterExtendsClause)
    ) {
      return this.typeRef(start);
    }

    const whenTrue = this.type();
    ref.args.push(whenTrue);
    if (!this.cursor.expect(TokenKind.Colon, Code.ExpectedBetweenBranches)) {
      return this.typeRef(start);
    }

    const whenFalse = this.type();
    ref.args.push(whenFalse);
    ref.source = this.cursor.spanFrom(start);

    return ref;
  }

  private unionType(): TypeRef {
    const head = this.cursor.peek();
    const loc = head.start;

    this.cursor.accept(TokenKind.Pipe);
    const first = this.intersectionType();
    if (!this.cursor.is(TokenKind.Pipe)) {
      return first;
    }

    const ref = this.typeRef(loc);
    ref.form = { kind: TypeKind.Union };
    ref.args.push(first);

    while (this.cursor.accept(TokenKind.Pipe)) {
      const next = this.intersectionType();
      ref.args.push(next);
    }

    return ref;
  }

  private intersectionType(): TypeRef {
    const head = this.cursor.peek();
    const loc = head.start;

    this.cursor.accept(TokenKind.Amp);
    const first = this.prefixedType();
    if (!this.cursor.is(TokenKind.Amp)) {
      return first;
    }

    const ref = this.typeRef(loc);
    ref.form = { kind: TypeKind.Intersection };
    ref.args.push(first);

    while (this.cursor.accept(TokenKind.Amp)) {
      const next = this.prefixedType();
      ref.args.push(next);
    }

    return ref;
  }

  private prefixedType(): TypeRef {
    if (this.keyofAhead()) {
      return this.keyofType();
    }
    if (this.readonlyAhead()) {
      return this.readonlyType();
    }

    return this.suffixedType();
  }

  private keyofAhead(): boolean {
    const next = this.cursor.lookahead();
    const operand =
      kTokenTable.isName(next.kind) ||
      next.kind == TokenKind.LParen ||
      next.kind == TokenKind.LBrace ||
      next.kind == TokenKind.Typeof;

    return this.cursor.is(TokenKind.Keyof) && operand;
  }

  private readonlyAhead(): boolean {
    const next = this.cursor.lookahead();
    const operand =
      kTokenTable.isName(next.kind) ||
      next.kind == TokenKind.LParen ||
      next.kind == TokenKind.LBracket;

    return this.cursor.is(TokenKind.Readonly) && operand;
  }

  private keyofType(): TypeRef {
    const keyword = this.cursor.next();
    const ref = this.typeRef(keyword.start);
    const operand = this.prefixedType();

    ref.form = { kind: TypeKind.KeyOf };
    ref.args.push(operand);

    return ref;
  }

  private suffixedType(): TypeRef {
    let ref = this.primaryType();

    while (this.indexAhead()) {
      this.cursor.next();

      if (this.cursor.accept(TokenKind.RBracket)) {
        ref = this.arrayOf(ref);
      } else {
        ref = this.indexedType(ref);
      }
    }

    return ref;
  }

  private arrayOf(element: TypeRef): TypeRef {
    const ref = this.typeRef(element.loc);

    ref.form = { kind: TypeKind.Array };
    ref.args.push(element);

    return ref;
  }

  private indexedType(object: TypeRef): TypeRef {
    const ref = this.typeRef(object.loc);
    const index = this.type();

    ref.form = { kind: TypeKind.Indexed };
    ref.args.push(object);
    ref.args.push(index);
    this.cursor.expect(TokenKind.RBracket, Code.ExpectedIndexedAccessClose);

    return ref;
  }

  private indexAhead(): boolean {
    const token = this.cursor.peek();

    return token.kind == TokenKind.LBracket && !token.newline;
  }

  private readonlyType(): TypeRef {
    const keyword = this.cursor.next();
    const ref = this.prefixedType();
    const form = ref.form;

    if (form.kind == TypeKind.Tuple) {
      form.readonly = ref.args.map((arg) => true);
    } else if (form.kind != TypeKind.Array) {
      this.cursor.report(keyword.start, Code.ReadonlyOnlyArrays);
    }

    return ref;
  }

  private primaryType(): TypeRef {
    const token = this.cursor.peek();
    const next = this.cursor.lookahead();

    switch (token.kind) {
      case TokenKind.LBrace:
        return this.objectType();
      case TokenKind.LBracket:
        return this.tupleType();
      case TokenKind.Less:
        return this.genericFunctionType();

      case TokenKind.LParen:
        if (this.functionTypeAhead()) {
          return this.functionType();
        }
        return this.parenthesizedType();

      case TokenKind.TemplateString:
      case TokenKind.TemplateHead:
        return this.templateType();

      case TokenKind.String:
        return this.stringLiteralType();
      case TokenKind.True:
      case TokenKind.False:
        return this.booleanLiteralType();

      case TokenKind.Int:
      case TokenKind.Float:
        return this.numberType();
      case TokenKind.Minus:
        if (next.kind == TokenKind.Int || next.kind == TokenKind.Float) {
          return this.numberType();
        }
        return this.missingType();

      case TokenKind.Typeof:
        return this.typeOfType();

      case TokenKind.Infer:
        if (kTokenTable.isName(next.kind)) {
          return this.inferType();
        }
        return this.namedType();

      case TokenKind.This:
      case TokenKind.Void:
        return this.namedType();
      default:
        if (this.cursor.atName()) {
          return this.namedType();
        }
        return this.missingType();
    }
  }

  private parenthesizedType(): TypeRef {
    this.cursor.next();
    const inner = this.type();
    this.cursor.expect(TokenKind.RParen, Code.ExpectedParenthesizedTypeClose);

    return inner;
  }

  private namedType(): TypeRef {
    const first = this.cursor.next();
    const ref = this.typeRef(first.start);
    ref.name = first.text;

    while (this.qualifiedPartAhead()) {
      this.cursor.next();
      const part = this.cursor.next();
      ref.name = this.keepName(`${ref.name}.${part.text}`);
    }
    if (this.cursor.is(TokenKind.Less)) {
      ref.form = { kind: TypeKind.Generic };
      ref.args = this.typeArguments();
    }

    return ref;
  }

  private missingType(): TypeRef {
    const token = this.cursor.peek();
    this.cursor.error(token.start, Code.ExpectedType, { found: token.kind });

    return this.typeRef(token.start);
  }

  private stringLiteralType(): TypeRef {
    const token = this.cursor.next();
    const decoded = this.literals.string(token);
    const ref = this.typeRef(token.start);

    ref.form = {
      kind: TypeKind.Literal,
      text: decoded.text,
      number: 0.0,
      integer: false,
    };
    ref.name = "string";

    return ref;
  }

  private booleanLiteralType(): TypeRef {
    const token = this.cursor.next();
    const truth = token.kind == TokenKind.True ? 1.0 : 0.0;
    const ref = this.typeRef(token.start);

    ref.form = {
      kind: TypeKind.Literal,
      text: "",
      number: truth,
      integer: false,
    };
    ref.name = "boolean";

    return ref;
  }

  private inferType(): TypeRef {
    const keyword = this.cursor.peek();
    const ref = this.typeRef(keyword.start);
    ref.form = { kind: TypeKind.Infer };

    this.cursor.next();
    const variable = this.cursor.next();
    ref.name = variable.text;

    if (!this.cursor.is(TokenKind.Extends)) {
      return ref;
    }

    const start = this.cursor.mark();
    this.cursor.next();
    const constraint = this.type(TypePlace.ExtendsClause);

    const extendsClause = this.context.typePlace == TypePlace.ExtendsClause;
    if (extendsClause || !this.cursor.is(TokenKind.Question)) {
      ref.args.push(constraint);
    } else {
      this.cursor.reset(start);
    }

    return ref;
  }

  private templateType(): TypeRef {
    const token = this.cursor.peek();
    const ref = this.typeRef(token.start);
    const first = this.literals.templatePart(token);

    this.cursor.next();

    if (token.kind == TokenKind.TemplateString) {
      ref.form = {
        kind: TypeKind.Literal,
        text: first.text,
        number: 0.0,
        integer: false,
      };
      ref.name = "string";

      return ref;
    }

    const parts: TemplateTypeForm = {
      kind: TypeKind.Template,
      texts: [first.text],
    };
    ref.form = parts;

    let piece = token;
    while (
      piece.kind == TokenKind.TemplateHead ||
      piece.kind == TokenKind.TemplateMiddle
    ) {
      const part = this.type();
      ref.args.push(part);

      const middle = this.cursor.peek();
      if (
        middle.kind != TokenKind.TemplateMiddle &&
        middle.kind != TokenKind.TemplateTail
      ) {
        this.cursor.error(middle.start, Code.ExpectedTemplateTypeClose);

        return this.typeRef(token.start);
      }

      const text = this.literals.templatePart(middle);
      parts.texts.push(text.text);
      piece = this.cursor.next();
    }

    return ref;
  }

  private numberType(): TypeRef {
    const first = this.cursor.peek();
    const ref = this.typeRef(first.start);
    const negative = this.cursor.accept(TokenKind.Minus);

    const lit = this.cursor.is(TokenKind.Int)
      ? this.intLiteral()
      : this.floatLiteral();

    let number = 0.0;
    let integer = false;

    if (lit.kind == ExprKind.IntLit) {
      number = this.integerAsDouble(lit.value);
      integer = true;
    } else if (lit.kind == ExprKind.FloatLit) {
      number = lit.value;
    }
    if (negative) {
      number = -number;
    }

    ref.form = { kind: TypeKind.Literal, text: "", number, integer };
    ref.name = "number";

    return ref;
  }

  private typeOfType(): TypeRef {
    const keyword = this.cursor.peek();
    const ref = this.typeRef(keyword.start);
    const names: string[] = [];
    ref.form = { kind: TypeKind.TypeOf, names };

    this.cursor.next();

    if (!this.cursor.atNameOrThis()) {
      const token = this.cursor.peek();
      this.cursor.error(token.start, Code.ExpectedTypeofName, {
        found: token.kind,
      });

      return ref;
    }

    const first = this.cursor.next();
    names.push(first.text);

    while (this.qualifiedPartAhead()) {
      this.cursor.next();
      const part = this.cursor.next();
      names.push(part.text);
    }

    return ref;
  }

  private typeArguments(): TypeRef[] {
    this.cursor.next();
    const args: TypeRef[] = [this.type()];

    while (this.cursor.accept(TokenKind.Comma)) {
      const arg = this.type();
      args.push(arg);
    }
    if (!this.cursor.accept(TokenKind.Greater)) {
      const token = this.cursor.peek();
      this.cursor.error(token.start, Code.ExpectedTypeArgumentsClose, {
        found: token.kind,
      });
    }

    return args;
  }

  private tryTypeArguments(callOnly: boolean): TypeRef[] | undefined {
    const start = this.cursor.mark();

    this.cursor.startDiscarding();
    this.cursor.stopRecovering();

    const parsed = this.typeArguments();
    const fits =
      !this.cursor.isRecovering() && this.followsTypeArguments(callOnly);

    this.cursor.stopDiscarding();

    if (!fits) {
      this.cursor.reset(start);

      return undefined;
    }

    this.cursor.restoreRecovering(start);

    return parsed;
  }

  private followsTypeArguments(callOnly: boolean): boolean {
    const token = this.cursor.peek();

    switch (token.kind) {
      case TokenKind.LParen:
        return true;
      case TokenKind.RParen:
      case TokenKind.RBracket:
      case TokenKind.RBrace:
      case TokenKind.Comma:
      case TokenKind.Semi:
      case TokenKind.Colon:
      case TokenKind.End:
        return !callOnly;
      default:
        return token.newline && !callOnly;
    }
  }

  private qualifiedPartAhead(): boolean {
    const next = this.cursor.lookahead();

    return this.cursor.is(TokenKind.Dot) && kTokenTable.isName(next.kind);
  }

  private tupleType(): TypeRef {
    const bracket = this.cursor.peek();
    const ref = this.typeRef(bracket.start);

    const tuple: TupleTypeForm = {
      kind: TypeKind.Tuple,
      readonly: [],
      spread: [],
    };

    ref.form = tuple;
    this.cursor.next();

    while (this.cursor.insideList(TokenKind.RBracket)) {
      const spread = this.cursor.accept(TokenKind.Ellipsis);
      const next = this.cursor.lookahead();

      if (this.cursor.atName() && next.kind == TokenKind.Colon) {
        this.cursor.skip(2);
      }
      const element = this.type();

      ref.args.push(element);
      tuple.readonly.push(false);
      tuple.spread.push(spread);

      if (this.cursor.is(TokenKind.Question)) {
        const token = this.cursor.peek();
        this.cursor.report(token.start, Code.OptionalTupleElements);
        this.cursor.next();
      }
      if (!this.cursor.accept(TokenKind.Comma)) {
        break;
      }
    }

    this.cursor.expect(TokenKind.RBracket, Code.ExpectedTupleClose);

    return ref;
  }

  private integerAsDouble(whole: uint64): double {
    if (whole <= kExactDoubleLimit) {
      return whole.toDouble();
    }
    const text = `${whole}`;
    const parsed = Number(text);

    return parsed.unwrapOr(0.0);
  }

  private typeRef(loc?: int): TypeRef {
    return {
      form: { kind: TypeKind.Name },
      name: "",
      loc,
      args: [],
    };
  }
}
