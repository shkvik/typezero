import { FileParser } from "../file-parser.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { Token, TokenKind } from "../../../token/types/token.types.tz";
import { kTokenTable } from "../../../token/const/token.const.tz";
import {
  Expr,
  ExprKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import {
  ExpressionPlace,
  FunctionKind,
} from "../types/file-parser.types.context.tz";
import { Precedence } from "../types/file-parser.types.operators.tz";

partial class FileParser {
  private sequence(): Expr {
    const first = this.expression();

    if (!this.cursor.is(TokenKind.Comma)) {
      return first;
    }

    const exprs: Expr[] = [first];

    while (this.cursor.accept(TokenKind.Comma)) {
      const next = this.expression();

      exprs.push(next);
    }

    return { kind: ExprKind.Sequence, loc: first.loc, exprs };
  }

  private expression(): Expr {
    const head = this.cursor.peek();
    const start = head.start;

    if (this.cursor.is(TokenKind.Yield)) {
      return this.yieldExpression();
    }

    const target = this.conditional();
    const op = this.operator();
    if (!this.isAssignment(op.kind)) {
      return target;
    }

    this.rejectOptionalTarget(target, start);
    const operatorToken = this.cursor.peek();
    const loc = operatorToken.start;

    this.cursor.skip(op.width);
    const value = this.expression();
    const assignment = this.assignmentOp(op.kind);
    const source = this.cursor.spanFrom(start);

    this.rejectPatternValue(target, start, assignment != undefined);

    return {
      kind: ExprKind.Assign,
      loc,
      op: assignment,
      target,
      value,
      source,
    };
  }

  private rejectPatternValue(
    target: Expr,
    start: int,
    compound: boolean,
  ): void {
    const pattern =
      target.kind == ExprKind.ArrayLit || target.kind == ExprKind.ObjectLit;
    if (!pattern) {
      return;
    }

    const first = this.cursor.onlyOpenParens(this.statementStart, start);
    if (compound || !first || !this.endsPatternStatement()) {
      this.cursor.report(start, Code.PatternAssignmentNotStatement);
    }
  }

  private endsPatternStatement(): boolean {
    let closed = 0;

    while (this.cursor.tokenAt(closed).kind == TokenKind.RParen) {
      closed += 1;
    }

    const next = this.cursor.tokenAt(closed);
    if (next.kind == TokenKind.Comma) {
      const afterComma = this.cursor.tokenAt(closed + 1);

      return this.closesStatement(afterComma.kind);
    }

    return closed == 0 || !this.usesValue(next);
  }

  private usesValue(token: Token): boolean {
    if (token.newline) {
      return false;
    }

    switch (token.kind) {
      case TokenKind.Dot:
      case TokenKind.QuestionDot:
      case TokenKind.LBracket:
      case TokenKind.LParen:
      case TokenKind.Question:
      case TokenKind.Bang:
      case TokenKind.PlusPlus:
      case TokenKind.MinusMinus:
      case TokenKind.TemplateString:
      case TokenKind.TemplateHead:
      case TokenKind.As:
        return true;
      default:
        return (
          this.binaryPrecedence(token.kind) != Precedence.None ||
          this.isAssignment(token.kind)
        );
    }
  }

  private closesStatement(kind: TokenKind): boolean {
    switch (kind) {
      case TokenKind.Semi:
      case TokenKind.RBrace:
      case TokenKind.End:
        return true;
      default:
        return false;
    }
  }

  private yieldExpression(): Expr {
    const keyword = this.cursor.next();
    const loc = keyword.start;
    const star = this.cursor.peek();
    const delegate = !star.newline && this.cursor.accept(TokenKind.Star);
    const value = this.yieldValue(delegate);

    if (this.context.functionKind != FunctionKind.Generator) {
      this.cursor.report(loc, Code.YieldOutsideGenerator);

      return value ?? { kind: ExprKind.Undefined, loc };
    }

    return { kind: ExprKind.Yield, loc, value, delegate };
  }

  private yieldValue(delegate: boolean): Expr | undefined {
    if (delegate) {
      return this.expression();
    }

    const token = this.cursor.peek();
    if (token.newline || this.endsYield(token.kind)) {
      return undefined;
    }
    if (!this.startsYieldOperand(token.kind)) {
      return undefined;
    }

    return this.expression();
  }

  private startsYieldOperand(kind: TokenKind): boolean {
    return (
      this.binaryPrecedence(kind) == Precedence.None ||
      kind == TokenKind.Plus ||
      kind == TokenKind.Minus ||
      kind == TokenKind.Less
    );
  }

  private conditional(): Expr {
    const cond = this.binary(Precedence.None);

    if (!this.cursor.is(TokenKind.Question)) {
      return cond;
    }

    const question = this.cursor.next();
    const loc = question.start;
    const thenExpr = this.thenBranch();

    this.cursor.expect(TokenKind.Colon, Code.ExpectedInConditional);
    const elseExpr = this.expression();

    return { kind: ExprKind.Conditional, loc, cond, thenExpr, elseExpr };
  }

  private thenBranch(): Expr {
    const outer = this.context;

    this.context = {
      ...outer,
      expressionPlace: ExpressionPlace.ConditionalThen,
    };
    const branch = this.expression();

    this.context = outer;

    return branch;
  }

  private primary(): Expr {
    const outer = this.context;
    const place = outer.expressionPlace;

    this.context = { ...outer, expressionPlace: ExpressionPlace.Plain };
    const expr = this.primaryInside(place);

    this.context = outer;

    return expr;
  }

  private primaryInside(place: ExpressionPlace): Expr {
    const token = this.cursor.peek();

    switch (token.kind) {
      case TokenKind.At:
        return this.decoratedPrimary();
      case TokenKind.Int:
        return this.intLiteral();
      case TokenKind.Float:
        return this.floatLiteral();
      case TokenKind.String:
        return this.stringLiteral();
      case TokenKind.TemplateString:
      case TokenKind.TemplateHead:
        return this.template(false);
      case TokenKind.Regex:
        return this.regexLiteral();
      case TokenKind.True:
      case TokenKind.False:
        return this.booleanLiteral();
      case TokenKind.Import:
        return this.importPrimary(token);
      case TokenKind.Class:
        return this.classPrimary(token);
      case TokenKind.Async:
        return this.tryAsyncFunction() ?? this.identifierPrimary(token);
      case TokenKind.This:
      case TokenKind.Super:
      case TokenKind.Identifier:
        return this.identifierPrimary(token);
      case TokenKind.Function:
        return this.functionExpression();
      case TokenKind.LParen:
        return this.parenthesized(place);
      case TokenKind.LBracket:
        return this.arrayLiteral();
      case TokenKind.LBrace:
        return this.objectLiteral();
      case TokenKind.New:
        return this.newExpression();
      case TokenKind.Less:
        return this.genericArrow(token.start);
      default:
        if (kTokenTable.isName(token.kind)) {
          return this.identifierPrimary(token);
        }
        return this.missingExpression();
    }
  }

  private decoratedPrimary(): Expr {
    const first = this.cursor.peek();
    const decorators = this.decorators();

    this.rejectDecorators(decorators);
    if (this.cursor.isRecovering()) {
      return this.invalid(first.start);
    }

    return this.primaryInside(ExpressionPlace.Plain);
  }

  private functionExpression(): Expr {
    const keyword = this.cursor.peek();
    const declaration = this.functionDecl(true, false);

    return { kind: ExprKind.Function, loc: keyword.start, fn: declaration };
  }

  private missingExpression(): Expr {
    const token = this.cursor.peek();

    this.cursor.error(token.start, Code.ExpectedExpression, {
      found: token.kind,
    });

    return this.invalid(token.start);
  }

  private parenthesized(place: ExpressionPlace): Expr {
    const isArrow =
      this.parametersAhead() ||
      (this.arrowAhead() && this.arrowFitsPlace(place));
    if (isArrow) {
      return this.arrow([], false);
    }

    this.cursor.next();
    const inner = this.sequence();

    this.cursor.expect(TokenKind.RParen, Code.ExpectedParenthesizedClose);

    return inner;
  }

  private genericArrow(loc: int): Expr {
    const start = this.cursor.mark();
    const less = this.cursor.peek();
    const text = less.start;

    this.cursor.startDiscarding();
    this.cursor.stopRecovering();
    const typeParams = this.typeParams();
    const isArrow =
      !this.cursor.isRecovering() &&
      this.cursor.is(TokenKind.LParen) &&
      this.arrowAhead();

    this.cursor.stopDiscarding();
    if (isArrow) {
      this.cursor.restoreRecovering(start);

      return this.arrow(typeParams, false, text);
    }

    this.cursor.reset(start);

    return this.brokenGenericArrow(loc);
  }

  private brokenGenericArrow(loc: int): Expr {
    const next = this.cursor.lookahead();
    if (!kTokenTable.isName(next.kind)) {
      this.cursor.error(loc, Code.ExpectedExpression, {
        found: TokenKind.Less,
      });

      return this.invalid(loc);
    }

    const typeParams = this.typeParams();

    if (this.cursor.is(TokenKind.LParen)) {
      return this.arrow(typeParams, false, loc);
    }

    const token = this.cursor.peek();

    this.cursor.error(token.start, Code.ExpectedExpression, {
      found: token.kind,
    });

    return this.invalid(loc);
  }

  private importPrimary(token: Token): Expr {
    const next = this.cursor.lookahead();
    if (next.kind == TokenKind.Dot) {
      this.cursor.report(token.start, Code.ImportMetaNotSupported);
    } else {
      this.cursor.report(token.start, Code.DynamicImportNotSupported);
    }

    this.cursor.next();

    return this.invalid(token.start);
  }

  private classPrimary(token: Token): Expr {
    const decl = this.classDecl(true);

    return { kind: ExprKind.Class, loc: token.start, decl };
  }

  private identifierPrimary(token: Token): Expr {
    const loc = token.start;
    const name = token.text;
    const next = this.cursor.lookahead();
    if (next.kind == TokenKind.Arrow && !next.newline) {
      return this.arrow([], false);
    }

    const generator = this.context.functionKind == FunctionKind.Generator;
    if (token.kind == TokenKind.Yield && generator) {
      this.cursor.report(loc, Code.YieldNeedsParentheses);

      return this.yieldExpression();
    }

    this.cursor.next();
    if (token.kind == TokenKind.Undefined) {
      return { kind: ExprKind.Undefined, loc };
    }

    return { kind: ExprKind.Name, loc, name, known: token.known, typeArgs: [] };
  }

  private endsYield(kind: TokenKind): boolean {
    switch (kind) {
      case TokenKind.RParen:
      case TokenKind.RBracket:
      case TokenKind.RBrace:
      case TokenKind.Comma:
      case TokenKind.Semi:
      case TokenKind.Colon:
      case TokenKind.Question:
      case TokenKind.End:
      case TokenKind.TemplateMiddle:
      case TokenKind.TemplateTail:
        return true;
      default:
        return false;
    }
  }

  private invalid(loc: int): Expr {
    return { kind: ExprKind.IntLit, loc, value: 0 };
  }
}
