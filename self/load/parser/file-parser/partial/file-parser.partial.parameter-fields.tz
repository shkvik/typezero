import { FileParser } from "../file-parser.tz";
import { KnownName } from "../../../token/types/token.types.tz";
import {
  ExprKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import {
  StmtKind,
} from "../../../../program/ast/types/ast.types.statements.tz";
import {
  ParamProperty,
} from "../../../../program/ast/types/ast.types.functions.tz";
import {
  FieldKind,
  FieldPresence,
} from "../../../../program/ast/types/ast.types.classes.tz";
import { ClassDeclDraft } from "../types/file-parser.types.classes.tz";
import { kThisName } from "../const/file-parser.const.classes.tz";
import {
  ClassDecl,
  ClassField,
} from "../../../../program/syntax/types/syntax.types.classes.tz";
import {
  Expr,
} from "../../../../program/syntax/types/syntax.types.expressions.tz";
import {
  FunctionDecl,
  Param,
} from "../../../../program/syntax/types/syntax.types.functions.tz";
import {
  BlockStmt,
  Stmt,
} from "../../../../program/syntax/types/syntax.types.statements.tz";

partial class FileParser {
  private readonly hasParameterField(
    declaration: ClassDecl,
    name: string,
  ): boolean {
    for (const field of declaration.fields) {
      if (field.form == FieldKind.Parameter && field.name == name) {
        return true;
      }
    }

    return false;
  }

  private readonly superCallEnd(body: BlockStmt): int {
    for (let i = 0; i < body.body.length; i++) {
      const stmt = body.body[i];
      if (stmt == undefined || stmt.kind != StmtKind.Expr) {
        continue;
      }

      const call = stmt.expr;
      if (call.kind != ExprKind.Call) {
        continue;
      }

      const callee = call.callee;
      if (callee.kind == ExprKind.Name && callee.known == KnownName.Super) {
        return i + 1;
      }
    }

    return 0;
  }

  private withParameterFields(
    declaration: ClassDeclDraft,
    constructorDecl: Own<FunctionDecl>,
  ): FunctionDecl {
    const sets: Stmt[] = [];
    let properties = this.parameterFieldCount(declaration);

    for (const param of constructorDecl.params) {
      const property = param.property;
      if (property == undefined) {
        continue;
      }

      this.fieldNames.add(param.name);
      if (!this.hasParameterField(declaration, param.name)) {
        const field = this.parameterField(param, property);

        declaration.fields.splice(properties, 0, field);
        properties += 1;
      }

      const set = this.parameterSet(param);

      sets.push(set);
    }

    if (constructorDecl.body == undefined || sets.length == 0) {
      return constructorDecl;
    }

    const body = constructorDecl.body;
    const at = this.fieldSetsStart(declaration, body);
    const before = body.body.slice(0, at).map((one) => this.copyStmt(one));
    const after = body.body.slice(at).map((one) => this.copyStmt(one));
    const statements = before.concat(sets).concat(after);
    const filled: BlockStmt = {
      kind: StmtKind.Block,
      loc: body.loc,
      body: statements,
      end: body.end,
    };

    const source = constructorDecl.bodySource;

    return this.withBody(constructorDecl, filled, source);
  }

  private readonly parameterFieldCount(declaration: ClassDecl): int {
    let count = 0;

    for (const field of declaration.fields) {
      if (field.form == FieldKind.Parameter) {
        count += 1;
      }
    }

    return count;
  }

  private readonly parameterField(
    param: Read<Param>,
    property: ParamProperty,
  ): ClassField {
    return {
      name: param.name,
      loc: param.loc,
      type: this.copyTypeRefAt(param.type),
      form: FieldKind.Parameter,
      presence: FieldPresence.Required,
      readonly: property.readonly,
      isOverride: false,
      access: property.access,
      decorators: [],
      accessor: false,
    };
  }

  private readonly parameterSet(param: Param): Stmt {
    const self: Expr = {
      kind: ExprKind.Name,
      loc: param.loc,
      name: kThisName,
      known: KnownName.None,
      typeArgs: [],
    };
    const target: Expr = {
      kind: ExprKind.Member,
      loc: param.loc,
      object: self,
      name: param.name,
      known: KnownName.None,
      optional: false,
      typeArgs: [],
    };
    const value: Expr = {
      kind: ExprKind.Name,
      loc: param.loc,
      name: param.name,
      known: KnownName.None,
      typeArgs: [],
    };
    const set: Expr = {
      kind: ExprKind.Assign,
      loc: param.loc,
      target,
      value,
    };

    return { kind: StmtKind.Expr, loc: param.loc, expr: set };
  }

  private readonly fieldSetsStart(
    declaration: Read<ClassDeclDraft>,
    body: BlockStmt,
  ): int {
    if (declaration.base == undefined) {
      return 0;
    }

    return this.superCallEnd(body);
  }
}
