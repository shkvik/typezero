import { FileParser } from "../file-parser.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { TokenKind } from "../../../token/types/token.types.tz";
import { kTokenTable } from "../../../token/const/token.const.tz";
import {
  ArrayElement,
  Expr,
  ExprKind,
  Property,
  PropertyKind,
  TemplateExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionPlace } from "../../../../program/ast/types/ast.types.functions.tz";

partial class FileParser {
  private template(raw: boolean): TemplateExpr {
    const opening = this.cursor.peek();
    const loc = opening.start;
    const head = this.templateText(raw);
    const quasis: string[] = [head];
    const exprs: Expr[] = [];
    let piece = this.cursor.next();
    while (
      piece.kind == TokenKind.TemplateHead ||
      piece.kind == TokenKind.TemplateMiddle
    ) {
      const part = this.sequence();
      exprs.push(part);
      if (
        !this.cursor.is(TokenKind.TemplateMiddle) &&
        !this.cursor.is(TokenKind.TemplateTail)
      ) {
        const token = this.cursor.peek();
        this.cursor.error(token.start, Code.ExpectedSubstitutionClose);
        quasis.push("");
        return { kind: ExprKind.Template, loc, quasis, exprs };
      }
      const text = this.templateText(raw);
      quasis.push(text);
      piece = this.cursor.next();
    }

    return { kind: ExprKind.Template, loc, quasis, exprs };
  }

  private templateText(raw: boolean): string {
    const token = this.cursor.peek();
    if (raw) {
      return this.literals.templateRaw(token);
    }
    const decoded = this.literals.templatePart(token);

    return decoded.text;
  }

  private arrayLiteral(): Expr {
    const bracket = this.cursor.next();
    const loc = bracket.start;
    const elements: ArrayElement[] = [];
    while (this.cursor.insideList(TokenKind.RBracket)) {
      if (this.cursor.is(TokenKind.Comma)) {
        const hole = this.cursor.peek();
        elements.push({
          expr: { kind: ExprKind.Undefined, loc: hole.start },
          spread: false,
          hole: true,
        });
      } else {
        const spread = this.cursor.accept(TokenKind.Ellipsis);
        const value = this.expression();
        elements.push({ expr: value, spread, hole: false });
      }
      if (!this.cursor.accept(TokenKind.Comma)) {
        break;
      }
    }
    this.cursor.expect(TokenKind.RBracket, Code.ExpectedArrayClose);

    return { kind: ExprKind.ArrayLit, loc, elements };
  }

  private objectLiteral(): Expr {
    const brace = this.cursor.next();
    const loc = brace.start;
    const props: Property[] = [];
    while (this.cursor.insideList(TokenKind.RBrace)) {
      if (this.cursor.is(TokenKind.At)) {
        const decorators = this.decorators();
        this.rejectDecorators(decorators);
        if (this.cursor.isRecovering()) {
          return { kind: ExprKind.ObjectLit, loc, props };
        }
      }
      const prop = this.property();
      if (prop == undefined) {
        return { kind: ExprKind.ObjectLit, loc, props };
      }
      props.push(prop);
      if (!this.cursor.accept(TokenKind.Comma)) {
        break;
      }
    }
    this.cursor.expect(TokenKind.RBrace, Code.ExpectedObjectClose);

    return { kind: ExprKind.ObjectLit, loc, props };
  }

  private property(): Property | undefined {
    const head = this.cursor.peek();
    const loc = head.start;
    if (this.cursor.accept(TokenKind.Ellipsis)) {
      const value = this.expression();
      return {
        name: "",
        loc,
        value,
        form: { kind: PropertyKind.Spread, omit: [], omitKeys: [] },
      };
    }
    if (
      !this.cursor.symbolKeyAhead() &&
      this.cursor.accept(TokenKind.LBracket)
    ) {
      return this.computedProperty(loc);
    }

    return this.namedProperty(loc);
  }

  private computedProperty(loc: int): Property | undefined {
    const key = this.expression();
    this.cursor.expect(TokenKind.RBracket, Code.ExpectedKeyClose);
    if (key.kind == ExprKind.Name) {
      const constants = this.stringConstants.get(key.name) ?? [];
      for (const text of constants) {
        this.fieldNames.add(text);
      }
    } else if (key.kind == ExprKind.StringLit) {
      this.fieldNames.add(key.value);
    }
    if (this.cursor.is(TokenKind.LParen) || this.cursor.is(TokenKind.Less)) {
      this.cursor.error(loc, Code.MethodKeyInBrackets);
      this.cursor.skipToClosingBrace();
      return undefined;
    }
    if (!this.cursor.expect(TokenKind.Colon, Code.ExpectedAfterKey)) {
      this.cursor.skipToClosingBrace();
      return undefined;
    }
    const value = this.expression();

    return { name: "", loc, value, form: { kind: PropertyKind.Computed, key } };
  }

  private accessorAhead(): boolean {
    const next = this.cursor.lookahead();

    return (
      (this.cursor.is(TokenKind.Get) || this.cursor.is(TokenKind.Set)) &&
      (next.kind == TokenKind.Identifier ||
        kTokenTable.isKeyword(next.kind) ||
        next.kind == TokenKind.String)
    );
  }

  private asyncMethodAhead(): boolean {
    const next = this.cursor.lookahead();

    return (
      this.cursor.is(TokenKind.Async) &&
      next.kind != TokenKind.Colon &&
      next.kind != TokenKind.Comma &&
      next.kind != TokenKind.RBrace &&
      next.kind != TokenKind.LParen &&
      !next.newline
    );
  }

  private namedProperty(loc: int): Property | undefined {
    if (this.accessorAhead()) {
      this.cursor.error(loc, Code.AccessorsNotSupported);
      this.cursor.skipToClosingBrace();
      return undefined;
    }
    const isAsync = this.asyncMethodAhead();
    if (isAsync) {
      this.cursor.next();
    }
    const head = this.cursor.peek();
    const start = head.start;
    const generator = this.cursor.accept(TokenKind.Star);
    const token = this.cursor.peek();
    const identifier = kTokenTable.isName(token.kind);
    const name = this.fieldName();
    if (name == undefined) {
      this.cursor.skipToClosingBrace();
      return undefined;
    }
    if (this.cursor.is(TokenKind.LParen) || this.cursor.is(TokenKind.Less)) {
      return this.methodProperty(loc, name, start, generator, isAsync);
    }
    if (generator || isAsync) {
      const current = this.cursor.peek();
      this.cursor.error(current.start, Code.ExpectedParenAfterMethodName);
      this.cursor.skipToClosingBrace();
      return undefined;
    }
    if (this.cursor.accept(TokenKind.Colon)) {
      const value = this.expression();
      return { name, loc, value, form: { kind: PropertyKind.Value } };
    }
    if (
      identifier &&
      (this.cursor.is(TokenKind.Comma) || this.cursor.is(TokenKind.RBrace))
    ) {
      const value: Expr =
        token.kind == TokenKind.Undefined
          ? { kind: ExprKind.Undefined, loc }
          : {
              kind: ExprKind.Name,
              loc,
              name,
              known: token.known,
              typeArgs: [],
            };
      return { name, loc, value, form: { kind: PropertyKind.Value } };
    }
    if (identifier && this.cursor.is(TokenKind.Assign)) {
      const assign = this.cursor.next();
      const assignLoc = assign.start;
      const fallback = this.expression();
      const value: Expr = {
        kind: ExprKind.Assign,
        loc: assignLoc,
        target: {
          kind: ExprKind.Name,
          loc,
          name,
          known: token.known,
          typeArgs: [],
        },
        value: fallback,
      };
      return { name, loc, value, form: { kind: PropertyKind.Defaulted } };
    }
    const current = this.cursor.peek();
    this.cursor.error(
      current.start,
      Code.ExpectedColonAfterFieldName,
      { found: current.kind },
    );
    this.cursor.skipToClosingBrace();

    return undefined;
  }

  private methodProperty(
    loc: int,
    name: string,
    start: int,
    generator: boolean,
    isAsync: boolean,
  ): Property | undefined {
    const fn = this.method(
      loc,
      name,
      start,
      generator,
      isAsync,
      FunctionPlace.Expression,
      undefined,
    );
    if (this.cursor.isRecovering() || fn.body == undefined) {
      if (fn.body == undefined) {
        const token = this.cursor.peek();
        this.cursor.error(token.start, Code.ExpectedMethodBody);
      }
      this.cursor.skipToClosingBrace();
      return undefined;
    }
    const value: Expr = { kind: ExprKind.Function, loc, fn };

    return { name, loc, value, form: { kind: PropertyKind.Method } };
  }

  private intLiteral(): Expr {
    const token = this.cursor.next();
    const number = this.literals.integer(token);
    if (!number.valid) {
      this.cursor.report(token.start, Code.InvalidIntegerLiteral);
      return this.invalid(token.start);
    }
    const text = { start: token.start, end: token.end };
    if (number.isInt) {
      return {
        kind: ExprKind.IntLit,
        loc: token.start,
        value: number.intValue,
        text,
      };
    }

    return {
      kind: ExprKind.FloatLit,
      loc: token.start,
      value: number.doubleValue,
      text,
    };
  }

  private floatLiteral(): Expr {
    const token = this.cursor.next();
    const number = this.literals.float(token);
    if (!number.valid) {
      this.cursor.report(token.start, Code.InvalidNumberLiteral);
    }
    const text = { start: token.start, end: token.end };

    return {
      kind: ExprKind.FloatLit,
      loc: token.start,
      value: number.doubleValue,
      text,
    };
  }
}
