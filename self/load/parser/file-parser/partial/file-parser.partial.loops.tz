import { FileParser } from "../file-parser.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { TokenKind } from "../../../token/types/token.types.tz";
import {
  BindingForm,
  BindingKind,
  NameOrigin,
  VarDeclarator,
} from "../../../../program/ast/types/ast.types.patterns.tz";
import {
  Stmt,
  StmtKind,
  VarDeclStmt,
} from "../../../../program/ast/types/ast.types.statements.tz";
import { ExpressionPlace } from "../types/file-parser.types.context.tz";
import { ForTarget, ForTargetKind } from "../types/file-parser.types.loops.tz";
import { Pattern } from "../types/file-parser.types.patterns.tz";

partial class FileParser {
  private whileStatement(): Stmt {
    const keyword = this.cursor.next();
    const loc = keyword.start;
    const cond = this.condition(Code.ExpectedAfterWhile);
    const body = this.statement(false);

    return { kind: StmtKind.While, loc, cond, body };
  }

  private doWhileStatement(): Stmt {
    const keyword = this.cursor.next();
    const loc = keyword.start;
    const body = this.statement(false);

    this.cursor.expect(TokenKind.While, Code.ExpectedAfterDoBody);
    const cond = this.condition(Code.ExpectedAfterWhile);

    this.cursor.accept(TokenKind.Semi);

    return { kind: StmtKind.DoWhile, loc, body, cond };
  }

  private forStatement(): Stmt {
    const outer = this.context;

    this.context = { ...outer, expressionPlace: ExpressionPlace.ForHead };
    const loop = this.forInside();

    this.context = outer;

    return loop;
  }

  private forInside(): Stmt {
    const keyword = this.cursor.next();
    const loc = keyword.start;
    const awaitLoc = this.forAwaitLoc();

    this.cursor.expect(TokenKind.LParen, Code.ExpectedAfterFor);
    const head = this.cursor.peek();

    switch (head.kind) {
      case TokenKind.Let:
      case TokenKind.Const:
      case TokenKind.Var:
        return this.forDeclared(loc, awaitLoc);
      case TokenKind.Semi:
        return this.classicFor(loc, awaitLoc, undefined);
      default: {
        const expr = this.sequence();
        const init: Stmt = { kind: StmtKind.Expr, loc: head.start, expr };

        return this.classicFor(loc, awaitLoc, init);
      }
    }
  }

  private forAwaitLoc(): int | undefined {
    if (!this.cursor.is(TokenKind.Await)) {
      return undefined;
    }

    const word = this.cursor.next();

    return word.start;
  }

  private forDeclared(loc: int, awaitLoc: int | undefined): Stmt {
    const head = this.cursor.next();
    if (head.kind == TokenKind.Var) {
      this.cursor.error(head.start, Code.VarNotSupported);
    }

    const isConst = head.kind == TokenKind.Const;
    const target = this.forTarget();
    if (target == undefined) {
      return { kind: StmtKind.For, loc };
    }
    if (this.cursor.is(TokenKind.Of) || this.cursor.is(TokenKind.In)) {
      return this.forOf(loc, awaitLoc, isConst, target);
    }

    const decls = this.forDeclarators(target, isConst);
    if (decls == undefined) {
      return { kind: StmtKind.For, loc };
    }

    const init: Stmt = {
      kind: StmtKind.VarDecl,
      loc: head.start,
      isConst,
      isUsing: false,
      decls,
    };

    return this.classicFor(loc, awaitLoc, init);
  }

  private forDeclarators(
    target: ForTarget,
    isConst: boolean,
  ): VarDeclarator[] | undefined {
    const decls: VarDeclarator[] = [];

    if (target.kind == ForTargetKind.Pattern) {
      if (!this.cursor.expect(TokenKind.Assign, Code.ExpectedAfterForPattern)) {
        return undefined;
      }

      const value = this.expression();

      this.declarePattern(decls, target.pattern, value, undefined);
    } else {
      const value = this.cursor.accept(TokenKind.Assign)
        ? this.expression()
        : undefined;

      decls.push({
        ...target.binding,
        origin: NameOrigin.Written,
        init: value,
        form: { kind: BindingKind.Plain },
      });
    }
    if (this.cursor.accept(TokenKind.Comma)) {
      this.declarators(decls, isConst);
    }

    return decls;
  }

  private forTarget(): ForTarget | undefined {
    if (
      this.cursor.is(TokenKind.LBracket) ||
      this.cursor.is(TokenKind.LBrace)
    ) {
      const pattern = this.bindingPattern();

      return { kind: ForTargetKind.Pattern, pattern };
    }

    const binding = this.binding();
    if (binding == undefined) {
      return undefined;
    }

    return { kind: ForTargetKind.Name, binding };
  }

  private classicFor(
    loc: int,
    awaitLoc: int | undefined,
    init: Stmt | undefined,
  ): Stmt {
    if (this.cursor.is(TokenKind.In) || this.cursor.is(TokenKind.Of)) {
      const token = this.cursor.peek();

      this.cursor.error(token.start, Code.ForNeedsNewVariable);

      return { kind: StmtKind.For, loc, init };
    }

    this.context = { ...this.context, expressionPlace: ExpressionPlace.Plain };
    if (awaitLoc != undefined) {
      this.cursor.report(awaitLoc, Code.ForAwaitNeedsIterable);
    }

    this.cursor.expect(TokenKind.Semi, Code.ExpectedAfterLoopInitializer);
    const cond = this.cursor.is(TokenKind.Semi) ? undefined : this.sequence();

    this.cursor.expect(TokenKind.Semi, Code.ExpectedAfterLoopCondition);
    const step = this.cursor.is(TokenKind.RParen) ? undefined : this.sequence();

    this.cursor.expect(TokenKind.RParen, Code.ExpectedLoopHeaderClose);
    const body = this.statement(false);

    return { kind: StmtKind.For, loc, init, cond, step, body };
  }

  private forOf(
    loc: int,
    awaitLoc: int | undefined,
    isConst: boolean,
    target: ForTarget,
  ): Stmt {
    const word = this.cursor.next();
    const keys = word.kind == TokenKind.In;
    const isAwait = awaitLoc != undefined;

    if (keys && target.kind == ForTargetKind.Pattern) {
      this.cursor.report(target.pattern.loc, Code.ForInKeyPattern);
    }
    if (keys && awaitLoc != undefined) {
      this.cursor.report(awaitLoc, Code.ForAwaitIn);
    }

    this.context = { ...this.context, expressionPlace: ExpressionPlace.Plain };
    const iterable = this.expression();

    this.cursor.expect(TokenKind.RParen, Code.ExpectedLoopHeaderClose);
    const statement = this.statement(false);
    const binding = this.forOfBinding(target, keys);
    const body = this.forOfBody(target, keys, isConst, binding.name, statement);

    return {
      kind: StmtKind.ForOf,
      loc,
      isConst,
      keys,
      isAwait,
      binding,
      iterable,
      body,
    };
  }

  private forOfBinding(target: ForTarget, keys: boolean): VarDeclarator {
    if (target.kind == ForTargetKind.Name) {
      return {
        ...target.binding,
        origin: NameOrigin.Written,
        form: { kind: BindingKind.Plain },
      };
    }

    const pattern = target.pattern;
    const name = this.hiddenName();
    const form = this.forOfForm(pattern, keys);

    return {
      name,
      origin: NameOrigin.Generated,
      loc: pattern.loc,
      form,
    };
  }

  private forOfForm(pattern: Pattern, keys: boolean): BindingForm {
    if (keys) {
      return { kind: BindingKind.Plain };
    }
    if (pattern.object) {
      return { kind: BindingKind.Object };
    }

    return { kind: BindingKind.Array, length: 0, rest: false };
  }

  private forOfBody(
    target: ForTarget,
    keys: boolean,
    isConst: boolean,
    name: string,
    statement: Stmt,
  ): Stmt {
    if (target.kind == ForTargetKind.Name) {
      return statement;
    }
    if (keys) {
      return statement;
    }

    const pattern = target.pattern;
    const decls: VarDeclarator[] = [];

    this.declareElements(decls, pattern, name);
    const elements: VarDeclStmt = {
      kind: StmtKind.VarDecl,
      loc: pattern.loc,
      isConst,
      isUsing: false,
      decls,
    };

    return {
      kind: StmtKind.Block,
      loc: statement.loc,
      body: [elements, statement],
    };
  }
}
