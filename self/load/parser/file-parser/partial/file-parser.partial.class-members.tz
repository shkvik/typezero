import { FileParser } from "../file-parser.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { TokenKind } from "../../../token/types/token.types.tz";
import { kTokenTable } from "../../../token/const/token.const.tz";
import {
  StmtKind,
} from "../../../../program/ast/types/ast.types.statements.tz";
import {
  FunctionPlace,
} from "../../../../program/ast/types/ast.types.functions.tz";
import {
  Access,
  MethodKind,
} from "../../../../program/ast/types/ast.types.classes.tz";
import {
  ClassDeclDraft,
  MemberName,
  Modifiers,
} from "../types/file-parser.types.classes.tz";
import {
  ClassMember,
  Decorator,
} from "../../../../program/syntax/types/syntax.types.classes.tz";
import {
  FunctionDecl,
} from "../../../../program/syntax/types/syntax.types.functions.tz";
import {
  BlockStmt,
} from "../../../../program/syntax/types/syntax.types.statements.tz";

partial class FileParser {
  private readonly memberAccessorAhead(): boolean {
    const next = this.cursor.lookahead();

    return (
      (this.cursor.is(TokenKind.Get) || this.cursor.is(TokenKind.Set)) &&
      !next.newline &&
      (next.kind == TokenKind.Identifier ||
        kTokenTable.isKeyword(next.kind) ||
        next.kind == TokenKind.String)
    );
  }

  private classMember(declaration: ClassDeclDraft): void {
    if (this.cursor.accept(TokenKind.Semi)) {
      return;
    }

    const decorators = this.decorators();

    if (this.cursor.isRecovering()) {
      return;
    }

    const head = this.cursor.peek();
    const loc = head.start;
    const modifiers = this.modifiers();
    if (modifiers.staticBlock) {
      return;
    }
    if (this.memberAccessorAhead()) {
      return this.memberAccessor(loc);
    }
    if (this.cursor.is(TokenKind.LBracket) && !this.cursor.symbolKeyAhead()) {
      this.cursor.report(loc, Code.MemberNameInBrackets);
      this.cursor.skipBracketed();

      return this.skipClassMember();
    }

    const member = this.memberName(modifiers);
    if (member == undefined) {
      return;
    }
    if (this.cursor.is(TokenKind.LParen) || this.cursor.is(TokenKind.Less)) {
      return this.classMethod(declaration, modifiers, decorators, loc, member);
    }
    if (member.generator || modifiers.isAsync) {
      const token = this.cursor.peek();
      const code = this.methodParenCode(member.generator);

      return this.cursor.error(token.start, code);
    }

    this.classField(declaration, modifiers, decorators, loc, member);
  }

  private memberAccessor(loc: int): void {
    const keyword = this.cursor.next();
    const name = this.cursor.peek();

    this.reportAccessor(loc, keyword.kind, name.text);
    this.skipClassMember();
  }

  private reportAccessor(loc: int, keyword: TokenKind, name: string): void {
    if (keyword == TokenKind.Get) {
      return this.cursor.report(loc, Code.GettersNotSupported, { word: name });
    }

    const setter = this.setterName(name);

    this.cursor.report(loc, Code.SettersNotSupported, { word: setter });
  }

  private readonly setterName(name: string): string {
    const first = name.slice(0, 1);
    const rest = name.slice(1);
    const capital = first.toUpperCase();

    return `set${capital}${rest}`;
  }

  private readonly methodParenCode(generator: boolean): Code {
    if (generator) {
      return Code.ExpectedParenAfterGeneratorName;
    }

    return Code.ExpectedParenAfterAsyncName;
  }

  private memberName(modifiers: Modifiers): MemberName | undefined {
    const head = this.cursor.peek();
    const start = head.start;
    const generator = this.cursor.accept(TokenKind.Star);
    const token = this.cursor.peek();
    const name = this.fieldName();
    if (name == undefined) {
      return undefined;
    }
    if (token.hash) {
      this.cursor.report(token.start, Code.NoPrivateName, { word: name });
      modifiers.access = Access.Private;
    }

    return {
      loc: token.start,
      start,
      name,
      generator,
      constructorName: token.kind == TokenKind.Constructor,
    };
  }

  private classMethod(
    declaration: ClassDeclDraft,
    modifiers: Read<Modifiers>,
    decorators: Own<Decorator[]>,
    loc: int,
    member: MemberName,
  ): void {
    const constructor = member.constructorName && !modifiers.isStatic;
    const abstractMethod = modifiers.isAbstract && !constructor;

    if (modifiers.accessor) {
      this.cursor.report(loc, Code.AccessorBeforeMethod);
    }

    const first = decorators[0];
    if (first != undefined && constructor) {
      this.cursor.report(first.loc, Code.DecoratedConstructor);
    }

    const role: ClassMember = {
      access: modifiers.access,
      isOverride: modifiers.isOverride && !constructor,
      isReadonly: modifiers.readonly && !constructor && !modifiers.isStatic,
      decorators: this.methodDecorators(decorators, constructor),
      method: this.methodKind(modifiers, constructor),
    };

    this.reportMethodModifiers(modifiers, member.generator, constructor, loc);
    const method = this.method(
      member.loc,
      member.name,
      member.start,
      member.generator && !constructor,
      modifiers.isAsync && !constructor,
      FunctionPlace.Declared,
      role,
    );

    if (this.cursor.isRecovering()) {
      return;
    }
    if (abstractMethod) {
      return this.addAbstractMethod(declaration, method, member);
    }

    if (method.body == undefined) {
      return this.reportMissingBody(method, member);
    }
    if (!this.isConstructor(method)) {
      declaration.methods.push(method);

      return;
    }

    this.addConstructor(declaration, method);
  }

  private readonly methodKind(
    modifiers: Read<Modifiers>,
    constructor: boolean,
  ): MethodKind {
    if (constructor) {
      return MethodKind.Constructor;
    }
    if (modifiers.isStatic) {
      return MethodKind.Static;
    }
    if (modifiers.isAbstract) {
      return MethodKind.Abstract;
    }

    return MethodKind.Instance;
  }

  private reportMissingBody(method: FunctionDecl, member: MemberName): void {
    if (this.isConstructor(method)) {
      return this.cursor.report(member.loc, Code.ConstructorWithoutBody);
    }

    this.cursor.report(member.loc, Code.MethodWithoutBody, {
      word: member.name,
    });
  }

  private addAbstractMethod(
    declaration: ClassDeclDraft,
    method: Own<FunctionDecl>,
    member: MemberName,
  ): void {
    if (method.body != undefined) {
      this.cursor.report(member.loc, Code.AbstractMethodBody, {
        word: member.name,
        other: declaration.name,
      });
    }

    const body: BlockStmt = { kind: StmtKind.Block, loc: member.loc, body: [] };
    const source = method.bodySource;
    const bodied = this.withBody(method, body, source);

    declaration.methods.push(bodied);
  }

  private addConstructor(
    declaration: ClassDeclDraft,
    method: Own<FunctionDecl>,
  ): void {
    const returnType = method.returnType;
    if (returnType != undefined) {
      this.cursor.report(returnType.loc, Code.ConstructorReturnType);
    }

    const filled = this.withParameterFields(declaration, method);

    declaration.constructors.push(filled);
  }

  private readonly constructorModifier(modifiers: Read<Modifiers>): TokenKind {
    if (modifiers.isOverride) {
      return TokenKind.Override;
    }

    return TokenKind.Abstract;
  }

  private reportMethodModifiers(
    modifiers: Read<Modifiers>,
    generator: boolean,
    constructor: boolean,
    loc: int,
  ): void {
    if (generator && constructor) {
      this.cursor.report(loc, Code.GeneratorConstructor);
    }
    if (modifiers.isAsync && constructor) {
      this.cursor.report(loc, Code.AsyncConstructor);
    }
    if (modifiers.readonly && constructor) {
      this.cursor.report(loc, Code.ReadonlyNotMethod, {
        word: "a constructor",
      });
    }
    if (modifiers.readonly && modifiers.isStatic) {
      this.cursor.report(loc, Code.ReadonlyNotMethod, {
        word: "a static method",
      });
    }
    if ((modifiers.isOverride || modifiers.isAbstract) && constructor) {
      const found = this.constructorModifier(modifiers);

      this.cursor.report(loc, Code.ConstructorModifier, { found });
    }
    if (modifiers.isAbstract && modifiers.isStatic) {
      this.cursor.report(loc, Code.AbstractStaticMethod);
    }
  }
}
