import { FileParser } from "../file-parser.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { Details } from "../../../../diagnostic/types/message.types.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import {
  KnownName,
  Token,
  TokenKind,
} from "../../../token/types/token.types.tz";
import { kTokenTable } from "../../../token/const/token.const.tz";
import {
  MappedTypeForm,
  ModifierChange,
  ObjectTypeField,
  ObjectTypeForm,
  TypeRefKind,
  TypeParamDecl,
  TypeRef,
} from "../../../../program/ast/types/ast.types.types.tz";
import {
  kRecordTypeName,
  kSymbolAsyncIteratorName,
  kSymbolDisposeName,
  kSymbolIteratorName,
} from "../const/file-parser.const.object-types.tz";

partial class FileParser {
  private mappedTypeAhead(): boolean {
    const next = this.cursor.lookahead();
    const after = this.cursor.tokenAt(2);

    return (
      this.cursor.is(TokenKind.LBracket) &&
      kTokenTable.isName(next.kind) &&
      after.kind == TokenKind.In
    );
  }

  private mappedType(
    loc: int,
    afterFields: boolean,
    readonlyChange: ModifierChange,
  ): TypeRef {
    const ref = this.typeRef(loc);
    const mapped: MappedTypeForm = {
      kind: TypeRefKind.Mapped,
      optionalChange: ModifierChange.None,
      readonlyChange,
    };

    ref.form = mapped;
    this.cursor.accept(TokenKind.LBracket);
    const variable = this.cursor.next();

    ref.name = variable.text;
    this.cursor.accept(TokenKind.In);
    const keys = this.type();

    ref.args.push(keys);
    const rename = this.mappedRename();

    if (!this.cursor.expect(TokenKind.RBracket, Code.ExpectedAfterMappedKeys)) {
      this.cursor.skipToClosingBrace();
      return ref;
    }
    mapped.optionalChange = this.acceptModifier(TokenKind.Question);
    if (!this.cursor.expect(TokenKind.Colon, Code.ExpectedBeforeMappedValues)) {
      this.cursor.skipToClosingBrace();
      return ref;
    }

    const values = this.type();
    ref.args.push(values);

    if (rename != undefined) {
      ref.args.push(rename);
    }
    if (!this.cursor.accept(TokenKind.Semi)) {
      this.cursor.accept(TokenKind.Comma);
    }
    if (!this.cursor.is(TokenKind.RBrace) || afterFields) {
      const token = this.cursor.peek();
      this.skipBraced(token.start, Code.MappedTypeNextToFields);

      return ref;
    }

    this.cursor.next();

    return ref;
  }

  private acceptModifier(modifier: TokenKind): ModifierChange {
    const sign = this.acceptSignBefore(modifier);
    const present = this.cursor.accept(modifier);

    if (sign != ModifierChange.None) {
      return sign;
    }
    if (present) {
      return ModifierChange.Add;
    }

    return ModifierChange.None;
  }

  private acceptSignBefore(modifier: TokenKind): ModifierChange {
    const next = this.cursor.lookahead();
    if (next.kind != modifier) {
      return ModifierChange.None;
    }

    if (this.cursor.accept(TokenKind.Minus)) {
      return ModifierChange.Remove;
    }
    if (this.cursor.accept(TokenKind.Plus)) {
      return ModifierChange.Add;
    }

    return ModifierChange.None;
  }

  private fieldName(): string | undefined {
    if (this.cursor.symbolKeyAhead()) {
      return this.symbolName();
    }
    const token = this.cursor.peek();
    const name = this.fieldNameOf(token);

    if (name == undefined) {
      const code = this.fieldNameProblem(token.kind);
      this.cursor.error(token.start, code, { found: token.kind });

      return undefined;
    }

    this.fieldNames.add(name);
    this.cursor.next();

    return name;
  }

  private fieldNameOf(token: Token): string | undefined {
    if (token.kind == TokenKind.String) {
      const text = this.stringText(token);

      return this.keepName(text);
    }
    if (
      token.kind == TokenKind.Identifier ||
      kTokenTable.isKeyword(token.kind)
    ) {
      return token.text;
    }

    return undefined;
  }

  private fieldNameProblem(kind: TokenKind): Code {
    switch (kind) {
      case TokenKind.LBracket:
        return Code.FieldNameInBrackets;
      case TokenKind.Int:
      case TokenKind.Float:
        return Code.NumberFieldName;
      default:
        return Code.ExpectedFieldName;
    }
  }

  private brokenSymbolName(): string | undefined {
    this.cursor.skipToClosingBracket();

    return undefined;
  }

  private symbolName(): string | undefined {
    const bracket = this.cursor.peek();
    const loc = bracket.start;

    this.cursor.skip(2);
    if (!this.cursor.expect(TokenKind.Dot, Code.ExpectedAfterSymbol)) {
      return this.brokenSymbolName();
    }
    if (!this.isPropertyName()) {
      const token = this.cursor.peek();

      this.cursor.error(token.start, Code.ExpectedNameAfterDot);

      return this.brokenSymbolName();
    }

    const member = this.cursor.next();
    if (!this.cursor.expect(TokenKind.RBracket, Code.ExpectedSymbolNameClose)) {
      return this.brokenSymbolName();
    }

    const name = this.symbolMemberName(member.known);
    if (name == undefined) {
      this.cursor.report(loc, Code.SymbolMemberName, { word: member.text });

      return kSymbolIteratorName;
    }

    return name;
  }

  private symbolMemberName(known: KnownName): string | undefined {
    switch (known) {
      case KnownName.AsyncIterator:
        return kSymbolAsyncIteratorName;
      case KnownName.Dispose:
        return kSymbolDisposeName;
      case KnownName.Iterator:
        return kSymbolIteratorName;
      default:
        return undefined;
    }
  }

  private objectType(): TypeRef {
    const brace = this.cursor.next();
    const ref = this.typeRef(brace.start);
    const fields: ObjectTypeField[] = [];
    const object: ObjectTypeForm = { kind: TypeRefKind.Object, fields };

    ref.form = object;

    while (this.cursor.insideList(TokenKind.RBrace)) {
      const first = this.cursor.peek();

      let readonlyChange = this.acceptSignBefore(TokenKind.Readonly);
      const readonly = this.acceptReadonlyWord();
      if (readonly && readonlyChange == ModifierChange.None) {
        readonlyChange = ModifierChange.Add;
      }

      const loc = this.memberLoc(first, readonly);

      const afterFields = fields.length > 0;

      if (this.mappedTypeAhead()) {
        return this.mappedType(ref.loc, afterFields, readonlyChange);
      }
      if (this.cursor.is(TokenKind.LBracket) && !this.cursor.symbolKeyAhead()) {
        return this.indexSignature(ref, loc, afterFields);
      }
      if (this.cursor.is(TokenKind.New) || this.refusedCallAhead()) {
        this.skipBraced(loc, Code.CallSignatures);

        return ref;
      }

      const member = this.objectTypeMember(loc, readonly);
      if (member == undefined) {
        return ref;
      }

      fields.push(member);

      const separatorCode = this.separatorCode(member);
      if (!this.endObjectTypeMember(separatorCode)) {
        return ref;
      }
    }

    this.cursor.expect(TokenKind.RBrace, Code.ExpectedObjectTypeClose);

    return ref;
  }

  private callSignatureAhead(): boolean {
    return this.cursor.is(TokenKind.LParen) || this.cursor.is(TokenKind.Less);
  }

  private refusedCallAhead(): boolean {
    return this.callSignatureAhead() && !this.library;
  }

  private callSignature(loc: int): ObjectTypeField | undefined {
    const typeParams = this.optionalTypeParams();
    const optional = false;
    const call = true;

    return this.objectTypeMethod("", loc, optional, call, typeParams);
  }

  private acceptReadonlyWord(): boolean {
    const next = this.cursor.lookahead();
    const fieldName =
      next.kind == TokenKind.Colon ||
      next.kind == TokenKind.Question ||
      next.kind == TokenKind.LParen;

    if (!this.cursor.is(TokenKind.Readonly) || fieldName) {
      return false;
    }
    this.cursor.next();

    return true;
  }

  private skipBraced(
    loc: int,
    code: Code,
    details: Details = kNoDetails,
  ): void {
    this.cursor.error(loc, code, details);
    this.cursor.skipToClosingBrace();
  }

  private closeBraced(code: Code): void {
    if (!this.cursor.expect(TokenKind.RBrace, code)) {
      this.cursor.skipToListClose();
    }
  }

  private objectTypeMember(
    loc: int,
    readonly: boolean,
  ): ObjectTypeField | undefined {
    if (this.callSignatureAhead()) {
      return this.callSignature(loc);
    }

    const name = this.fieldName();
    if (name == undefined) {
      this.cursor.skipToClosingBrace();

      return undefined;
    }

    const optional = this.cursor.accept(TokenKind.Question);
    const token = this.cursor.peek();

    switch (token.kind) {
      case TokenKind.LParen:
        return this.plainTypeMethod(name, loc, optional);
      case TokenKind.Colon:
        return this.objectTypeField(name, loc, optional, readonly);
      case TokenKind.Less:
        return this.genericTypeMethod(name, loc, optional);
      default:
        this.skipBraced(token.start, Code.FieldNeedsType, { word: name });
        return undefined;
    }
  }

  private objectTypeField(
    name: string,
    loc: int,
    optional: boolean,
    readonly: boolean,
  ): ObjectTypeField {
    this.cursor.next();
    const type = this.type();

    return {
      name,
      loc,
      optional,
      readonly,
      method: false,
      call: false,
      typeParams: [],
      type,
    };
  }

  private plainTypeMethod(
    name: string,
    loc: int,
    optional: boolean,
  ): ObjectTypeField | undefined {
    const typeParams: TypeParamDecl[] = [];
    const call = false;

    return this.objectTypeMethod(name, loc, optional, call, typeParams);
  }

  private genericTypeMethod(
    name: string,
    loc: int,
    optional: boolean,
  ): ObjectTypeField | undefined {
    if (!this.library) {
      const token = this.cursor.peek();

      this.skipBraced(token.start, Code.GenericTypeMethods);

      return undefined;
    }

    const typeParams = this.typeParams();
    const call = false;

    return this.objectTypeMethod(name, loc, optional, call, typeParams);
  }

  private objectTypeMethod(
    name: string,
    loc: int,
    optional: boolean,
    call: boolean,
    typeParams: TypeParamDecl[],
  ): ObjectTypeField | undefined {
    const parsed = this.signatureParams();
    if (!parsed.complete || this.cursor.isRecovering()) {
      this.cursor.skipToClosingBrace();

      return undefined;
    }
    if (!this.cursor.accept(TokenKind.Colon)) {
      const token = this.cursor.peek();
      this.skipBraced(token.start, Code.MethodNeedsReturnType, {
        word: name,
      });

      return undefined;
    }

    const result = this.type();
    const type = this.functionTypeOf(parsed, result);

    return {
      name,
      loc,
      optional,
      readonly: true,
      method: true,
      call,
      typeParams,
      type,
    };
  }

  private endObjectTypeMember(code: Code): boolean {
    if (
      this.cursor.accept(TokenKind.Semi) ||
      this.cursor.accept(TokenKind.Comma)
    ) {
      return true;
    }

    const token = this.cursor.peek();
    if (token.kind != TokenKind.RBrace && !token.newline) {
      this.skipBraced(token.start, code, { found: token.kind });

      return false;
    }

    return true;
  }

  private wrongIndexToken(): Token {
    if (this.cursor.atName()) {
      return this.cursor.lookahead();
    }

    return this.cursor.peek();
  }

  private indexSignature(
    ref: TypeRef,
    loc: int,
    afterFields: boolean,
  ): TypeRef {
    this.cursor.next();
    const next = this.cursor.lookahead();

    if (!this.cursor.atName() || next.kind != TokenKind.Colon) {
      const wrong = this.wrongIndexToken();

      this.skipBraced(wrong.start, Code.ExpectedIndexSignatureOrMapped);

      return ref;
    }

    this.cursor.skip(2);
    const key = this.type();

    if (
      !this.cursor.expect(TokenKind.RBracket, Code.ExpectedAfterIndexKeys) ||
      !this.cursor.expect(TokenKind.Colon, Code.ExpectedBeforeIndexValues)
    ) {
      this.cursor.skipToClosingBrace();

      return ref;
    }

    const value = this.type();

    if (!this.cursor.accept(TokenKind.Semi)) {
      this.cursor.accept(TokenKind.Comma);
    }
    if (afterFields || !this.cursor.is(TokenKind.RBrace)) {
      this.skipBraced(loc, Code.IndexSignatureNextToFields);

      return ref;
    }

    this.cursor.next();
    const record = this.typeRef(ref.loc);

    record.form = { kind: TypeRefKind.Generic };
    record.name = kRecordTypeName;
    record.args.push(key);
    record.args.push(value);

    return record;
  }

  private mappedRename(): TypeRef | undefined {
    if (!this.cursor.accept(TokenKind.As)) {
      return undefined;
    }

    return this.type();
  }

  private memberLoc(first: Token, readonly: boolean): int {
    if (!readonly) {
      return first.start;
    }

    const head = this.cursor.peek();

    return head.start;
  }

  private separatorCode(member: ObjectTypeField): Code {
    if (member.method) {
      return Code.ExpectedSemicolonAfterMethod;
    }

    return Code.ExpectedSemicolonAfterField;
  }
}
