import { FileParser } from "../file-parser.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { TokenKind } from "../../../token/types/token.types.tz";
import {
  ExprKind,
  PropertyKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import {
  BindingForm,
  BindingKind,
  NameOrigin,
} from "../../../../program/ast/types/ast.types.patterns.tz";
import {
  Pattern,
  PatternElement,
} from "../types/file-parser.types.patterns.tz";
import {
  kArrayPatternExample,
  kComputedKeyExample,
  kObjectPatternExample,
} from "../const/file-parser.const.patterns.tz";
import {
  ArrayElement,
  ArrayLitExpr,
  Expr,
  IndexExpr,
  ObjectLitExpr,
  Property,
} from "../../../../program/syntax/types/syntax.types.expressions.tz";
import {
  VarDeclarator,
} from "../../../../program/syntax/types/syntax.types.patterns.tz";
import {
  TypeRef,
} from "../../../../program/syntax/types/syntax.types.types.tz";

partial class FileParser {
  private bindingPattern(): Pattern {
    if (this.cursor.is(TokenKind.LBrace)) {
      return this.objectPattern();
    }

    const bracket = this.cursor.next();
    const pattern: Pattern = {
      loc: bracket.start,
      object: false,
      elements: [],
    };

    while (this.cursor.insideList(TokenKind.RBracket)) {
      const element = this.arrayPatternElement();
      if (element == undefined) {
        return pattern;
      }

      const isRest = element.rest;
      const elementLoc = element.loc;

      pattern.elements.push(element);
      if (!this.cursor.accept(TokenKind.Comma)) {
        break;
      }
      if (isRest) {
        this.cursor.report(elementLoc, Code.RestElementNotLast);
      }
    }

    this.cursor.expect(TokenKind.RBracket, Code.ExpectedPatternClose);

    return pattern;
  }

  private arrayPatternElement(): PatternElement | undefined {
    const first = this.cursor.peek();
    const element = this.emptyElement(first.start);

    if (this.cursor.is(TokenKind.Comma)) {
      element.hole = true;

      return element;
    }

    element.rest = this.cursor.accept(TokenKind.Ellipsis);
    if (!this.bindingTarget(element)) {
      return undefined;
    }

    const assign = this.cursor.peek();

    if (!this.cursor.accept(TokenKind.Assign)) {
      return element;
    }
    if (element.rest) {
      this.cursor.report(assign.start, Code.RestElementDefault);
    }

    element.defaultValue = this.expression();

    return element;
  }

  private bindingTarget(element: PatternElement): boolean {
    if (
      this.cursor.is(TokenKind.LBracket) ||
      this.cursor.is(TokenKind.LBrace)
    ) {
      element.nested = this.bindingPattern();

      return true;
    }
    if (!this.cursor.atName()) {
      const token = this.cursor.peek();

      this.cursor.error(token.start, Code.ExpectedPatternVariable, {
        found: token.kind,
      });

      return false;
    }

    const word = this.cursor.next();

    element.name = word.text;

    return true;
  }

  private objectPattern(): Pattern {
    const brace = this.cursor.next();
    const pattern: Pattern = {
      loc: brace.start,
      object: true,
      elements: [],
    };

    while (this.cursor.insideList(TokenKind.RBrace)) {
      const element = this.objectPatternElement();
      if (element == undefined) {
        return pattern;
      }

      const isRest = element.rest;
      const elementLoc = element.loc;

      pattern.elements.push(element);
      if (!this.cursor.accept(TokenKind.Comma)) {
        break;
      }
      if (isRest) {
        this.cursor.report(elementLoc, Code.RestElementNotLast);
      }
    }

    this.cursor.expect(TokenKind.RBrace, Code.ExpectedPatternClose);

    return pattern;
  }

  private objectPatternElement(): PatternElement | undefined {
    if (this.cursor.is(TokenKind.Ellipsis)) {
      return this.objectPatternRest();
    }

    return this.objectPatternEntry();
  }

  private objectPatternRest(): PatternElement | undefined {
    const ellipsis = this.cursor.next();
    const element = this.emptyElement(ellipsis.start);

    element.rest = true;

    if (!this.cursor.atName()) {
      const token = this.cursor.peek();

      this.cursor.error(token.start, Code.ExpectedVariableAfterRest);

      return undefined;
    }

    const word = this.cursor.next();

    element.name = word.text;

    return element;
  }

  private readonly patternExample(pattern: Read<Pattern>): string {
    if (pattern.object) {
      return kObjectPatternExample;
    }

    return kArrayPatternExample;
  }

  private readonly keyExample(element: Read<PatternElement>): string {
    if (element.keyExpr != undefined) {
      return kComputedKeyExample;
    }

    return element.key;
  }

  private objectPatternEntry(): PatternElement | undefined {
    const first = this.cursor.peek();
    const element = this.emptyElement(first.start);
    const identifier = this.cursor.atName();

    if (this.cursor.accept(TokenKind.LBracket)) {
      element.keyExpr = this.expression();
      this.cursor.expect(TokenKind.RBracket, Code.ExpectedKeyClose);
    } else {
      const key = this.fieldName();
      if (key == undefined) {
        this.cursor.skipToClosingBrace();

        return undefined;
      }

      element.key = key;
    }
    if (!this.entryVariable(element, identifier)) {
      return undefined;
    }
    if (this.cursor.accept(TokenKind.Assign)) {
      element.defaultValue = this.expression();
    }

    return element;
  }

  private entryVariable(element: PatternElement, identifier: boolean): boolean {
    if (this.cursor.accept(TokenKind.Colon)) {
      return this.bindingTarget(element);
    }
    if (identifier && element.keyExpr == undefined) {
      element.name = element.key;

      return true;
    }

    const token = this.cursor.peek();
    const word = this.keyExample(element);

    this.cursor.error(token.start, Code.PatternKeyNeedsVariable, { word });

    return false;
  }

  private patternFromLiteral(
    expr: Read<ArrayLitExpr | ObjectLitExpr>,
  ): Pattern {
    if (expr.kind == ExprKind.ObjectLit) {
      return this.objectPatternFrom(expr);
    }

    return this.arrayPatternFrom(expr);
  }

  private objectPatternFrom(expr: Read<ObjectLitExpr>): Pattern {
    const pattern: Pattern = { loc: expr.loc, object: true, elements: [] };

    for (let i = 0; i < expr.props.length; i++) {
      const property = expr.props[i];
      if (property == undefined) {
        continue;
      }

      const isLast = i + 1 == expr.props.length;
      const element = this.elementFromProperty(property, isLast);

      pattern.elements.push(element);
    }

    return pattern;
  }

  private elementFromProperty(
    property: Read<Property>,
    isLast: boolean,
  ): PatternElement {
    const element = this.emptyElement(property.loc);
    const form = property.form;

    element.rest = form.kind == PropertyKind.Spread;
    element.key = property.name;
    if (form.kind == PropertyKind.Computed) {
      element.keyExpr = this.copyExpr(form.key);
    }
    if (element.rest && !isLast) {
      this.cursor.report(element.loc, Code.RestElementNotLast);
    }

    const value = this.copyExpr(property.value);

    this.fillElement(element, value, false);

    return element;
  }

  private arrayPatternFrom(expr: Read<ArrayLitExpr>): Pattern {
    const pattern: Pattern = { loc: expr.loc, object: false, elements: [] };

    for (let i = 0; i < expr.elements.length; i++) {
      const item = expr.elements[i];
      if (item == undefined) {
        continue;
      }

      const isLast = i + 1 == expr.elements.length;
      const element = this.elementFromItem(item, isLast);

      pattern.elements.push(element);
    }

    return pattern;
  }

  private elementFromItem(
    item: Read<ArrayElement>,
    isLast: boolean,
  ): PatternElement {
    const element = this.emptyElement(item.expr.loc);

    element.hole = item.hole;
    element.rest = item.spread;
    if (element.rest && !isLast) {
      this.cursor.report(element.loc, Code.RestElementNotLast);
    }

    const value = this.copyExpr(item.expr);

    this.fillElement(element, value, element.hole);

    return element;
  }

  private fillElement(
    element: PatternElement,
    value: Own<Expr>,
    hole: boolean,
  ): void {
    if (
      value.kind == ExprKind.Assign &&
      value.op == undefined &&
      !element.rest
    ) {
      element.defaultValue = value.value;

      return this.fillTarget(element, value.target, hole);
    }

    this.fillTarget(element, value, hole);
  }

  private fillTarget(
    element: PatternElement,
    target: Own<Expr>,
    hole: boolean,
  ): void {
    if (target.kind == ExprKind.ArrayLit || target.kind == ExprKind.ObjectLit) {
      element.nested = this.patternFromLiteral(target);

      return;
    }
    if (!hole) {
      element.target = target;
    }
  }

  private hiddenDeclarator(
    loc: int,
    init: Own<Expr>,
    typeAnn: Own<TypeRef | undefined>,
    form: BindingForm,
  ): VarDeclarator {
    const name = this.hiddenName();

    return { name, origin: NameOrigin.Generated, loc, typeAnn, init, form };
  }

  private declarePattern(
    decls: VarDeclarator[],
    pattern: Read<Pattern>,
    value: Own<Expr>,
    typeAnn: Own<TypeRef | undefined>,
  ): void {
    const form = this.formOf(pattern);
    const hidden = this.hiddenDeclarator(pattern.loc, value, typeAnn, form);
    const name = hidden.name;

    decls.push(hidden);
    this.declareElements(decls, pattern, name);
  }

  private declareElements(
    decls: VarDeclarator[],
    pattern: Read<Pattern>,
    base: string,
  ): void {
    const keyReads: IndexExpr[] = [];

    for (let i = 0; i < pattern.elements.length; i++) {
      const element = pattern.elements[i];
      if (element == undefined || element.hole) {
        continue;
      }

      const value = this.elementOf(base, pattern, i, keyReads);
      const nested = element.nested;
      if (nested != undefined) {
        this.declarePattern(decls, nested, value, undefined);

        continue;
      }

      decls.push({
        name: element.name,
        origin: NameOrigin.Written,
        loc: element.loc,
        init: value,
        form: { kind: BindingKind.Plain },
      });
    }
  }
}
