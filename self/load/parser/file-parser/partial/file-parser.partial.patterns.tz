import { FileParser } from "../file-parser.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { KnownName, TokenKind } from "../../../token/types/token.types.tz";
import { TypeRef } from "../../../../program/ast/types/ast.types.types.tz";
import {
  ArrayElement,
  ArrayLitExpr,
  BinaryOp,
  Expr,
  ExprKind,
  IndexExpr,
  ObjectLitExpr,
  Property,
  PropertyKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import {
  BindingForm,
  BindingKind,
  NameOrigin,
  VarDeclarator,
} from "../../../../program/ast/types/ast.types.patterns.tz";
import {
  Stmt,
  StmtKind,
} from "../../../../program/ast/types/ast.types.statements.tz";
import {
  Pattern,
  PatternElement,
} from "../types/file-parser.types.patterns.tz";
import {
  kArrayPatternExample,
  kComputedKeyExample,
  kObjectPatternExample,
  kSliceMethodName,
} from "../const/file-parser.const.patterns.tz";

partial class FileParser {
  private bindingPattern(): Pattern {
    if (this.cursor.is(TokenKind.LBrace)) {
      return this.objectPattern();
    }

    const bracket = this.cursor.next();
    const pattern: Pattern = {
      loc: bracket.start,
      object: false,
      elements: [],
    };

    while (this.cursor.insideList(TokenKind.RBracket)) {
      const element = this.arrayPatternElement();
      if (element == undefined) {
        return pattern;
      }

      pattern.elements.push(element);
      if (!this.cursor.accept(TokenKind.Comma)) {
        break;
      }
      if (element.rest) {
        this.cursor.report(element.loc, Code.RestElementNotLast);
      }
    }

    this.cursor.expect(TokenKind.RBracket, Code.ExpectedPatternClose);

    return pattern;
  }

  private arrayPatternElement(): PatternElement | undefined {
    const first = this.cursor.peek();
    const element = this.emptyElement(first.start);

    if (this.cursor.is(TokenKind.Comma)) {
      element.hole = true;

      return element;
    }

    element.rest = this.cursor.accept(TokenKind.Ellipsis);
    if (!this.bindingTarget(element)) {
      return undefined;
    }

    const assign = this.cursor.peek();

    if (!this.cursor.accept(TokenKind.Assign)) {
      return element;
    }
    if (element.rest) {
      this.cursor.report(assign.start, Code.RestElementDefault);
    }

    element.defaultValue = this.expression();

    return element;
  }

  private bindingTarget(element: PatternElement): boolean {
    if (
      this.cursor.is(TokenKind.LBracket) ||
      this.cursor.is(TokenKind.LBrace)
    ) {
      element.nested = this.bindingPattern();

      return true;
    }
    if (!this.cursor.atName()) {
      const token = this.cursor.peek();

      this.cursor.error(token.start, Code.ExpectedPatternVariable, {
        found: token.kind,
      });

      return false;
    }

    const word = this.cursor.next();

    element.name = word.text;

    return true;
  }

  private objectPattern(): Pattern {
    const brace = this.cursor.next();
    const pattern: Pattern = {
      loc: brace.start,
      object: true,
      elements: [],
    };

    while (this.cursor.insideList(TokenKind.RBrace)) {
      const element = this.objectPatternElement();
      if (element == undefined) {
        return pattern;
      }

      pattern.elements.push(element);
      if (!this.cursor.accept(TokenKind.Comma)) {
        break;
      }
      if (element.rest) {
        this.cursor.report(element.loc, Code.RestElementNotLast);
      }
    }

    this.cursor.expect(TokenKind.RBrace, Code.ExpectedPatternClose);

    return pattern;
  }

  private objectPatternElement(): PatternElement | undefined {
    if (this.cursor.is(TokenKind.Ellipsis)) {
      return this.objectPatternRest();
    }

    return this.objectPatternEntry();
  }

  private objectPatternRest(): PatternElement | undefined {
    const ellipsis = this.cursor.next();
    const element = this.emptyElement(ellipsis.start);

    element.rest = true;

    if (!this.cursor.atName()) {
      const token = this.cursor.peek();

      this.cursor.error(token.start, Code.ExpectedVariableAfterRest);

      return undefined;
    }

    const word = this.cursor.next();

    element.name = word.text;

    return element;
  }

  private patternExample(pattern: Pattern): string {
    if (pattern.object) {
      return kObjectPatternExample;
    }

    return kArrayPatternExample;
  }

  private keyExample(element: PatternElement): string {
    if (element.keyExpr != undefined) {
      return kComputedKeyExample;
    }

    return element.key;
  }

  private objectPatternEntry(): PatternElement | undefined {
    const first = this.cursor.peek();
    const element = this.emptyElement(first.start);
    const identifier = this.cursor.atName();

    if (this.cursor.accept(TokenKind.LBracket)) {
      element.keyExpr = this.expression();
      this.cursor.expect(TokenKind.RBracket, Code.ExpectedKeyClose);
    } else {
      const key = this.fieldName();
      if (key == undefined) {
        this.cursor.skipToClosingBrace();

        return undefined;
      }

      element.key = key;
    }
    if (!this.entryVariable(element, identifier)) {
      return undefined;
    }
    if (this.cursor.accept(TokenKind.Assign)) {
      element.defaultValue = this.expression();
    }

    return element;
  }

  private entryVariable(element: PatternElement, identifier: boolean): boolean {
    if (this.cursor.accept(TokenKind.Colon)) {
      return this.bindingTarget(element);
    }
    if (identifier && element.keyExpr == undefined) {
      element.name = element.key;

      return true;
    }

    const token = this.cursor.peek();
    const word = this.keyExample(element);

    this.cursor.error(token.start, Code.PatternKeyNeedsVariable, { word });

    return false;
  }

  private patternFromLiteral(expr: ArrayLitExpr | ObjectLitExpr): Pattern {
    if (expr.kind == ExprKind.ObjectLit) {
      return this.objectPatternFrom(expr);
    }

    return this.arrayPatternFrom(expr);
  }

  private objectPatternFrom(expr: ObjectLitExpr): Pattern {
    const pattern: Pattern = { loc: expr.loc, object: true, elements: [] };

    for (let i = 0; i < expr.props.length; i++) {
      const property = expr.props[i];
      if (property == undefined) {
        continue;
      }

      const isLast = i + 1 == expr.props.length;
      const element = this.elementFromProperty(property, isLast);

      pattern.elements.push(element);
    }

    return pattern;
  }

  private elementFromProperty(
    property: Property,
    isLast: boolean,
  ): PatternElement {
    const element = this.emptyElement(property.loc);
    const form = property.form;

    element.rest = form.kind == PropertyKind.Spread;
    element.key = property.name;
    if (form.kind == PropertyKind.Computed) {
      element.keyExpr = form.key;
    }
    if (element.rest && !isLast) {
      this.cursor.report(element.loc, Code.RestElementNotLast);
    }

    this.fillElement(element, property.value, false);

    return element;
  }

  private arrayPatternFrom(expr: ArrayLitExpr): Pattern {
    const pattern: Pattern = { loc: expr.loc, object: false, elements: [] };

    for (let i = 0; i < expr.elements.length; i++) {
      const item = expr.elements[i];
      if (item == undefined) {
        continue;
      }

      const isLast = i + 1 == expr.elements.length;
      const element = this.elementFromItem(item, isLast);

      pattern.elements.push(element);
    }

    return pattern;
  }

  private elementFromItem(item: ArrayElement, isLast: boolean): PatternElement {
    const element = this.emptyElement(item.expr.loc);

    element.hole = item.hole;
    element.rest = item.spread;
    if (element.rest && !isLast) {
      this.cursor.report(element.loc, Code.RestElementNotLast);
    }

    this.fillElement(element, item.expr, element.hole);

    return element;
  }

  private fillElement(
    element: PatternElement,
    value: Expr,
    hole: boolean,
  ): void {
    if (
      value.kind == ExprKind.Assign &&
      value.op == undefined &&
      !element.rest
    ) {
      element.defaultValue = value.value;

      return this.fillTarget(element, value.target, hole);
    }

    this.fillTarget(element, value, hole);
  }

  private fillTarget(
    element: PatternElement,
    target: Expr,
    hole: boolean,
  ): void {
    if (target.kind == ExprKind.ArrayLit || target.kind == ExprKind.ObjectLit) {
      element.nested = this.patternFromLiteral(target);

      return;
    }
    if (!hole) {
      element.target = target;
    }
  }

  private hiddenDeclarator(
    loc: int,
    init: Expr,
    typeAnn: TypeRef | undefined,
    form: BindingForm,
  ): VarDeclarator {
    const name = this.hiddenName();

    return { name, origin: NameOrigin.Generated, loc, typeAnn, init, form };
  }

  private declarePattern(
    decls: VarDeclarator[],
    pattern: Pattern,
    value: Expr,
    typeAnn: TypeRef | undefined,
  ): void {
    const form = this.formOf(pattern);
    const hidden = this.hiddenDeclarator(pattern.loc, value, typeAnn, form);

    decls.push(hidden);
    this.declareElements(decls, pattern, hidden.name);
  }

  private declareElements(
    decls: VarDeclarator[],
    pattern: Pattern,
    base: string,
  ): void {
    const keyReads: IndexExpr[] = [];

    for (let i = 0; i < pattern.elements.length; i++) {
      const element = pattern.elements[i];
      if (element == undefined || element.hole) {
        continue;
      }

      const value = this.elementOf(base, pattern, i, keyReads);
      const nested = element.nested;
      if (nested != undefined) {
        this.declarePattern(decls, nested, value, undefined);

        continue;
      }

      decls.push({
        name: element.name,
        origin: NameOrigin.Written,
        loc: element.loc,
        init: value,
        form: { kind: BindingKind.Plain },
      });
    }
  }

  private assignPattern(loc: int, pattern: Pattern, value: Expr): Stmt {
    const decls: VarDeclarator[] = [];
    const body: Stmt[] = [
      { kind: StmtKind.VarDecl, loc, isConst: true, isUsing: false, decls },
    ];
    const direct = this.isDirect(pattern, value);
    const values: string[] = [];

    if (direct && value.kind == ExprKind.ArrayLit) {
      for (const item of value.elements) {
        const hidden = this.hiddenDeclarator(
          item.expr.loc,
          item.expr,
          undefined,
          { kind: BindingKind.Plain },
        );

        decls.push(hidden);
        values.push(hidden.name);
      }
    } else {
      const form = this.formOf(pattern);
      const hidden = this.hiddenDeclarator(pattern.loc, value, undefined, form);

      decls.push(hidden);
    }

    const base = decls[0]?.name ?? "";
    const keyReads: IndexExpr[] = [];

    for (let i = 0; i < pattern.elements.length; i++) {
      const element = pattern.elements[i];
      if (element == undefined || element.hole) {
        continue;
      }

      const name = values[i];
      const part = this.assignedPart(element, name, base, pattern, i, keyReads);
      const nested = element.nested;
      if (nested != undefined) {
        const assignment = this.assignPattern(element.loc, nested, part);

        body.push(assignment);

        continue;
      }

      const target = element.target ?? part;
      const assign: Expr = {
        kind: ExprKind.Assign,
        loc: element.loc,
        target,
        value: part,
      };

      body.push({ kind: StmtKind.Expr, loc: element.loc, expr: assign });
    }

    return { kind: StmtKind.Block, loc, body };
  }

  private directElement(element: PatternElement, name: string): Expr {
    const read: Expr = {
      kind: ExprKind.Name,
      loc: element.loc,
      name,
      known: KnownName.None,
      typeArgs: [],
    };
    const fallback = element.defaultValue;
    if (fallback == undefined) {
      return read;
    }

    return {
      kind: ExprKind.Binary,
      loc: element.loc,
      op: BinaryOp.Nullish,
      lhs: read,
      rhs: fallback,
    };
  }

  private elementOf(
    base: string,
    pattern: Pattern,
    i: int,
    keyReads: IndexExpr[],
  ): Expr {
    const element = pattern.elements[i];
    const loc = element?.loc ?? pattern.loc;
    const source: Expr = {
      kind: ExprKind.Name,
      loc,
      name: base,
      known: KnownName.None,
      typeArgs: [],
    };

    if (element == undefined) {
      return source;
    }
    if (pattern.object) {
      return this.objectElementOf(pattern, element, source, keyReads);
    }

    return this.arrayElementOf(element, source, i);
  }

  private arrayElementOf(element: PatternElement, source: Expr, i: int): Expr {
    const position: Expr = {
      kind: ExprKind.IntLit,
      loc: element.loc,
      value: i.toUint64(),
    };

    if (element.rest) {
      return this.sliceFrom(element.loc, source, position);
    }

    const read: Expr = {
      kind: ExprKind.Index,
      loc: element.loc,
      object: source,
      index: position,
      optional: false,
    };

    return this.withDefault(element, read);
  }

  private sliceFrom(loc: int, source: Expr, position: Expr): Expr {
    const slice: Expr = {
      kind: ExprKind.Member,
      loc,
      object: source,
      name: kSliceMethodName,
      known: KnownName.None,
      optional: false,
      typeArgs: [],
    };

    return {
      kind: ExprKind.Call,
      loc,
      callee: slice,
      args: [{ expr: position, spread: false }],
      optional: false,
      tagged: false,
    };
  }

  private objectElementOf(
    pattern: Pattern,
    element: PatternElement,
    source: Expr,
    keyReads: IndexExpr[],
  ): Expr {
    if (element.rest) {
      return this.restOf(pattern, element, source, keyReads);
    }

    const keyExpr = element.keyExpr;
    if (keyExpr != undefined) {
      const keyed: IndexExpr = {
        kind: ExprKind.Index,
        loc: element.loc,
        object: source,
        index: keyExpr,
        optional: false,
      };

      keyReads.push(keyed);

      return this.withDefault(element, keyed);
    }

    const read: Expr = {
      kind: ExprKind.Member,
      loc: element.loc,
      object: source,
      name: element.key,
      known: KnownName.None,
      optional: false,
      typeArgs: [],
    };

    return this.withDefault(element, read);
  }

  private withDefault(element: PatternElement, read: Expr): Expr {
    const fallback = element.defaultValue;
    if (fallback == undefined) {
      return read;
    }

    return {
      kind: ExprKind.Binary,
      loc: element.loc,
      op: BinaryOp.Nullish,
      lhs: read,
      rhs: fallback,
    };
  }

  private restOf(
    pattern: Pattern,
    element: PatternElement,
    source: Expr,
    keyReads: IndexExpr[],
  ): Expr {
    const omit: string[] = [];

    for (const other of pattern.elements) {
      if (!other.rest && other.keyExpr == undefined) {
        omit.push(other.key);
      }
    }

    return {
      kind: ExprKind.ObjectLit,
      loc: element.loc,
      props: [
        {
          name: "",
          loc: element.loc,
          value: source,
          form: { kind: PropertyKind.Spread, omit, omitKeys: keyReads.slice() },
        },
      ],
    };
  }

  private emptyElement(loc: int): PatternElement {
    return { loc, hole: false, rest: false, name: "", key: "" };
  }

  private formOf(pattern: Pattern): BindingForm {
    if (pattern.object) {
      return { kind: BindingKind.Object };
    }

    const last = pattern.elements[pattern.elements.length - 1];
    const rest = last != undefined && last.rest;

    return { kind: BindingKind.Array, length: pattern.elements.length, rest };
  }

  private isDirect(pattern: Pattern, value: Expr): boolean {
    if (pattern.object || value.kind != ExprKind.ArrayLit) {
      return false;
    }
    if (value.elements.length < pattern.elements.length) {
      return false;
    }

    for (const item of value.elements) {
      if (item.spread || item.hole) {
        return false;
      }
    }

    for (const item of pattern.elements) {
      if (item.rest) {
        return false;
      }
    }

    return true;
  }

  private assignedPart(
    element: PatternElement,
    name: string | undefined,
    base: string,
    pattern: Pattern,
    i: int,
    keyReads: IndexExpr[],
  ): Expr {
    if (name != undefined) {
      return this.directElement(element, name);
    }

    return this.elementOf(base, pattern, i, keyReads);
  }
}
