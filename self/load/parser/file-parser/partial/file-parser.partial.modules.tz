import { FileParser } from "../file-parser.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { TokenKind } from "../../../token/types/token.types.tz";
import { kTokenTable } from "../../../token/const/token.const.tz";
import {
  Expr,
  ExprKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { NameOrigin } from "../../../../program/ast/types/ast.types.patterns.tz";
import {
  Stmt,
  StmtKind,
} from "../../../../program/ast/types/ast.types.statements.tz";
import { Decorator } from "../../../../program/ast/types/ast.types.classes.tz";
import {
  ExportForm,
  ImportDecl,
  ModuleName,
  ModulePath,
  WholeImport,
} from "../../../../program/ast/types/ast.types.modules.tz";
import {
  ImportClause,
  ImportForm,
  NameListCodes,
} from "../types/file-parser.types.modules.tz";
import {
  kExportNames,
  kImportNames,
  kJsonAttributeValue,
  kJsonExtension,
  kJsonImportName,
  kNodeModulePrefix,
  kTypeAttributeKey,
  kTzModulePrefix,
} from "../const/file-parser.const.modules.tz";

partial class FileParser {
  private importDecl(topLevel: boolean): Stmt {
    const keyword = this.cursor.next();
    const loc = keyword.start;

    if (!topLevel) {
      this.cursor.report(loc, Code.ImportNotTopLevel);
    }
    if (this.cursor.is(TokenKind.String)) {
      return this.partList(loc, topLevel);
    }

    const next = this.cursor.lookahead();
    const typeWord =
      this.cursor.is(TokenKind.Type) &&
      next.kind != TokenKind.Comma &&
      next.kind != TokenKind.From;
    if (typeWord) {
      const token = this.cursor.peek();

      this.cursor.report(token.start, Code.ImportTypeNotNeeded);
      this.cursor.next();
    }

    const head = this.cursor.peek();
    const formLoc = head.start;
    let clause: ImportClause = { kind: ImportForm.Named };

    if (this.cursor.accept(TokenKind.Star)) {
      let name: string | undefined = undefined;

      if (this.cursor.expect(TokenKind.As, Code.ExpectedAfterImportStar)) {
        const alias = this.cursor.peek();
        if (kTokenTable.isName(alias.kind)) {
          name = alias.text;
        }

        this.cursor.expectName(Code.ExpectedAfterImportStarAs);
      }

      clause = { kind: ImportForm.Namespace, name };
    } else if (this.cursor.atName()) {
      const alias = this.cursor.next();

      clause = { kind: ImportForm.Default, name: alias.text };
      if (this.cursor.is(TokenKind.Assign)) {
        this.cursor.error(formLoc, Code.ImportEqualsNotSupported, {
          word: alias.text,
        });

        return this.marker(StmtKind.Empty, loc);
      }
      if (
        this.cursor.accept(TokenKind.Comma) &&
        !this.cursor.is(TokenKind.LBrace)
      ) {
        const token = this.cursor.peek();

        this.cursor.error(token.start, Code.ExpectedBraceAfterComma, {
          found: token.kind,
        });
      }
    }

    const names: ModuleName[] = [];

    if (this.cursor.is(TokenKind.LBrace)) {
      this.moduleNames(names, kImportNames);
    } else if (clause.kind == ImportForm.Named) {
      const token = this.cursor.peek();

      this.cursor.error(token.start, Code.ExpectedImportNames, {
        found: token.kind,
      });
    }
    if (this.cursor.isRecovering()) {
      return this.marker(StmtKind.Empty, loc);
    }

    const from = this.fromPath(true);
    if (from == undefined) {
      return this.marker(StmtKind.Empty, loc);
    }

    return this.finishImport(loc, clause, formLoc, names, from);
  }

  private partList(loc: int, topLevel: boolean): Stmt {
    const from = this.fromPath(false);

    this.cursor.expectSemicolon();
    if (topLevel && from != undefined) {
      this.imports.push({ loc, names: [], from, isPartList: true });
    }

    return this.marker(StmtKind.Empty, loc);
  }

  private finishImport(
    loc: int,
    clause: ImportClause,
    formLoc: int,
    names: ModuleName[],
    from: ModulePath,
  ): Stmt {
    const json = from.path.endsWith(kJsonExtension);
    let jsonType = false;
    const token = this.cursor.peek();
    const attributes =
      token.kind == TokenKind.With || token.kind == TokenKind.Assert;
    if (attributes && !token.newline) {
      jsonType = this.importAttributes(json);
    }

    this.cursor.expectSemicolon();
    if (json) {
      if (clause.kind != ImportForm.Default) {
        this.cursor.report(formLoc, Code.JsonImportWhole);

        return this.marker(StmtKind.Empty, loc);
      }
      if (!jsonType) {
        this.cursor.report(from.loc, Code.JsonImportAttribute);
      }

      names.push({
        name: kJsonImportName,
        loc: formLoc,
        as: clause.name,
        asLoc: formLoc,
      });
      this.addImport(loc, names, from);

      return this.marker(StmtKind.Empty, loc);
    }

    const whole = this.clauseName(clause);
    if (whole != undefined && this.isBuiltinModule(from.path)) {
      const wholeImport: WholeImport = {
        name: whole,
        loc: formLoc,
        isDefault: clause.kind == ImportForm.Default,
      };

      this.addImport(loc, names, from, wholeImport);

      return this.marker(StmtKind.Empty, loc);
    }
    if (clause.kind == ImportForm.Namespace) {
      this.cursor.report(formLoc, Code.NamespaceImportNotSupported);
    } else if (clause.kind == ImportForm.Default) {
      this.cursor.report(formLoc, Code.DefaultImportNotSupported);
    } else if (names.length == 0) {
      this.cursor.report(loc, Code.ImportWithoutNames);
    }
    if (names.length > 0) {
      this.addImport(loc, names, from);
    }

    return this.marker(StmtKind.Empty, loc);
  }

  private addImport(
    loc: int,
    names: ModuleName[],
    from: ModulePath,
    whole?: WholeImport,
  ): void {
    const decl: ImportDecl = { loc, names, from, whole, isPartList: false };

    this.imports.push(decl);
  }

  private partialClassAhead(): boolean {
    const next = this.cursor.lookahead();

    return next.kind == TokenKind.Class && !next.newline;
  }

  private exportedDeclarationAhead(): boolean {
    const token = this.cursor.peek();
    const next = this.cursor.lookahead();

    switch (token.kind) {
      case TokenKind.Function:
      case TokenKind.Const:
      case TokenKind.Let:
      case TokenKind.Var:
      case TokenKind.Enum:
        return true;
      case TokenKind.Class:
      case TokenKind.Type:
      case TokenKind.Interface:
        return kTokenTable.isName(next.kind) && !next.newline;
      case TokenKind.Abstract:
        return next.kind == TokenKind.Class && !next.newline;
      case TokenKind.Declare:
        return (
          next.kind == TokenKind.Function ||
          (!this.library && next.kind == TokenKind.Class)
        );
      default:
        return this.asyncFunctionAhead();
    }
  }

  private exportDecl(topLevel: boolean): Stmt {
    const keyword = this.cursor.next();
    const loc = keyword.start;

    if (!topLevel) {
      this.cursor.report(loc, Code.ExportNotTopLevel);
    }
    if (this.cursor.is(TokenKind.At)) {
      return this.exportDecorated(topLevel);
    }
    if (this.cursor.is(TokenKind.Partial) && this.partialClassAhead()) {
      this.cursor.report(loc, Code.PartNotExported);

      return this.statement(topLevel);
    }
    if (this.exportedDeclarationAhead()) {
      const stmt = this.statement(topLevel);

      if (topLevel) {
        this.exportDeclared(stmt);
      }

      return stmt;
    }
    if (this.cursor.is(TokenKind.Default)) {
      return this.exportDefault(loc, topLevel);
    }
    if (this.cursor.accept(TokenKind.Assign)) {
      this.cursor.report(loc, Code.ExportEqualsNotSupported);
      this.expression();
      this.cursor.expectSemicolon();

      return this.marker(StmtKind.Empty, loc);
    }
    if (this.cursor.is(TokenKind.Star)) {
      return this.exportAll(loc);
    }

    const next = this.cursor.lookahead();
    if (this.cursor.is(TokenKind.Type) && next.kind == TokenKind.LBrace) {
      const token = this.cursor.peek();

      this.cursor.report(token.start, Code.ExportTypeNotNeeded);
      this.cursor.next();
    }
    if (!this.cursor.is(TokenKind.LBrace)) {
      const token = this.cursor.peek();

      this.cursor.error(token.start, Code.ExpectedExportDeclaration, {
        found: token.kind,
      });

      return this.marker(StmtKind.Empty, loc);
    }

    return this.exportNames(loc);
  }

  private exportDecorated(topLevel: boolean): Stmt {
    const decorators: Decorator[] = this.decorators();
    const stmt = this.statement(topLevel);
    if (stmt.kind == StmtKind.Class) {
      if (topLevel) {
        this.exportDeclared(stmt);
      }

      stmt.decorators = decorators.concat(stmt.decorators);
    } else {
      this.rejectDecorators(decorators);
    }

    return stmt;
  }

  private exportNames(loc: int): Stmt {
    const names: ModuleName[] = [];

    this.moduleNames(names, kExportNames);
    const reExport =
      !this.cursor.isRecovering() && this.cursor.is(TokenKind.From);
    let from: ModulePath | undefined = undefined;

    if (reExport) {
      from = this.fromPath(true);
      if (from == undefined) {
        return this.marker(StmtKind.Empty, loc);
      }
    }

    this.cursor.expectSemicolon();
    if (!this.cursor.isRecovering()) {
      const form = reExport ? ExportForm.Re : ExportForm.Local;

      this.exports.push({ loc, form, names, from });
    }

    return this.marker(StmtKind.Empty, loc);
  }

  private exportDefault(loc: int, topLevel: boolean): Stmt {
    this.cursor.report(loc, Code.ExportDefaultNotSupported);
    this.cursor.next();
    const next = this.cursor.lookahead();
    if (this.cursor.is(TokenKind.Function) && kTokenTable.isName(next.kind)) {
      return this.statement(topLevel);
    }

    const head = this.cursor.peek();
    const exprLoc = head.start;
    const expr = this.exprOrFunction(exprLoc);

    this.cursor.expectSemicolon();

    return { kind: StmtKind.Expr, loc: exprLoc, expr };
  }

  private exprOrFunction(loc: int): Expr {
    if (!this.cursor.is(TokenKind.Function)) {
      return this.expression();
    }

    const declaration = this.functionDecl(true, false);

    return { kind: ExprKind.Function, loc, fn: declaration };
  }

  private exportAll(loc: int): Stmt {
    this.cursor.next();
    if (this.cursor.is(TokenKind.As)) {
      const asKeyword = this.cursor.next();
      const asLoc = asKeyword.start;

      this.cursor.expectName(Code.ExpectedAfterExportStarAs);
      if (!this.cursor.isRecovering() && this.fromPath(true) != undefined) {
        this.cursor.report(asLoc, Code.ExportStarAsNotSupported);
        this.cursor.expectSemicolon();
      }

      return this.marker(StmtKind.Empty, loc);
    }

    const from = this.fromPath(true);
    if (from != undefined) {
      this.cursor.expectSemicolon();
      this.exports.push({
        loc,
        form: ExportForm.All,
        names: [],
        from,
      });
    }

    return this.marker(StmtKind.Empty, loc);
  }

  private moduleNames(names: ModuleName[], codes: NameListCodes): void {
    this.cursor.next();

    while (this.cursor.insideList(TokenKind.RBrace)) {
      const next = this.cursor.lookahead();
      if (this.cursor.is(TokenKind.Type) && kTokenTable.isName(next.kind)) {
        const token = this.cursor.peek();

        this.cursor.report(token.start, codes.typeNotNeeded);
        this.cursor.next();
      }

      const name = this.moduleName(codes);
      if (name == undefined) {
        return;
      }

      names.push(name);
      if (!this.cursor.accept(TokenKind.Comma)) {
        break;
      }
    }

    this.cursor.expect(TokenKind.RBrace, codes.close);
  }

  private moduleName(codes: NameListCodes): ModuleName | undefined {
    const token = this.cursor.peek();
    if (token.kind == TokenKind.Default) {
      this.cursor.error(token.start, Code.NoExportDefault);

      return undefined;
    }

    const reserved =
      !kTokenTable.isName(token.kind) && kTokenTable.isKeyword(token.kind);
    const next = this.cursor.lookahead();
    const renamed = reserved && next.kind == TokenKind.As;
    if (reserved && !renamed) {
      this.cursor.error(token.start, codes.keywordName, { word: token.text });

      return undefined;
    }
    if (!kTokenTable.isName(token.kind) && !renamed) {
      this.cursor.error(token.start, codes.expectedName, { found: token.kind });

      return undefined;
    }

    this.cursor.next();
    if (!this.cursor.accept(TokenKind.As)) {
      return {
        name: token.text,
        loc: token.start,
        as: token.text,
        asLoc: token.start,
      };
    }

    const alias = this.cursor.peek();
    if (alias.kind == TokenKind.Default) {
      this.cursor.error(alias.start, Code.NoExportDefault);

      return undefined;
    }
    if (!kTokenTable.isName(alias.kind)) {
      this.cursor.error(alias.start, Code.ExpectedNameAfterAs, {
        found: alias.kind,
      });

      return undefined;
    }

    this.cursor.next();

    return {
      name: token.text,
      loc: token.start,
      as: alias.text,
      asLoc: alias.start,
    };
  }

  private importAttributes(json: boolean): boolean {
    const keyword = this.cursor.peek();
    const at = keyword.start;
    const old = keyword.kind == TokenKind.Assert;

    this.cursor.next();
    if (!this.cursor.expect(TokenKind.LBrace, Code.ExpectedAfterWith)) {
      return false;
    }

    let typeJson = false;
    let other = false;

    while (this.cursor.insideList(TokenKind.RBrace)) {
      const key = this.attributeKey();
      if (
        key == undefined ||
        !this.cursor.expect(TokenKind.Colon, Code.ExpectedAfterAttributeName)
      ) {
        this.cursor.skipToClosingBrace();

        return false;
      }

      const value = this.fromPath(false);
      if (value == undefined) {
        this.cursor.skipToClosingBrace();

        return false;
      }
      if (key == kTypeAttributeKey && value.path == kJsonAttributeValue) {
        typeJson = true;
      } else {
        other = true;
      }
      if (!this.cursor.accept(TokenKind.Comma)) {
        break;
      }
    }

    this.cursor.expect(TokenKind.RBrace, Code.ExpectedAttributesClose);
    if (!json) {
      this.cursor.report(at, Code.AttributesOnlyForJson);

      return false;
    }
    if (old) {
      this.cursor.report(at, Code.AssertAttributes);
    } else if (other) {
      this.cursor.report(at, Code.JsonOneAttribute);
    }

    return typeJson || old || other;
  }

  private attributeKey(): string | undefined {
    const token = this.cursor.peek();
    if (kTokenTable.isName(token.kind) || kTokenTable.isKeyword(token.kind)) {
      this.cursor.next();

      return token.text;
    }

    const quoted = this.fromPath(false);

    return quoted == undefined ? undefined : quoted.path;
  }

  private fromPath(from: boolean): ModulePath | undefined {
    if (from && !this.cursor.is(TokenKind.From)) {
      const token = this.cursor.peek();

      this.cursor.error(token.start, Code.ExpectedFrom, { found: token.kind });

      return undefined;
    }
    if (from) {
      this.cursor.next();
    }

    const token = this.cursor.peek();
    if (token.kind != TokenKind.String) {
      this.cursor.error(token.start, Code.ExpectedPathString, {
        found: token.kind,
      });

      return undefined;
    }

    const decoded = this.literals.string(token);

    this.cursor.next();

    return { path: decoded.text, loc: token.start };
  }

  private exportDeclared(stmt: Stmt): void {
    const names: ModuleName[] = [];

    if (
      stmt.kind == StmtKind.Function ||
      stmt.kind == StmtKind.TypeAlias ||
      stmt.kind == StmtKind.Enum
    ) {
      names.push({
        name: stmt.name,
        loc: stmt.loc,
        as: stmt.name,
        asLoc: stmt.loc,
      });
    } else if (stmt.kind == StmtKind.Class) {
      const name = stmt.name ?? "";

      names.push({ name, loc: stmt.loc, as: name, asLoc: stmt.loc });
    } else if (stmt.kind == StmtKind.VarDecl) {
      for (const declarator of stmt.decls) {
        if (declarator.origin == NameOrigin.Written) {
          names.push({
            name: declarator.name,
            loc: declarator.loc,
            as: declarator.name,
            asLoc: declarator.loc,
          });
        }
      }
    }
    if (names.length == 0) {
      return;
    }

    this.exports.push({
      loc: stmt.loc,
      form: ExportForm.Local,
      names,
    });
  }

  private clauseName(clause: ImportClause): string | undefined {
    if (clause.kind == ImportForm.Named) {
      return undefined;
    }

    return clause.name;
  }

  private isBareModule(path: string): boolean {
    switch (path) {
      case "assert":
      case "assert/strict":
      case "async_hooks":
      case "buffer":
      case "child_process":
      case "cluster":
      case "console":
      case "constants":
      case "crypto":
      case "dgram":
      case "diagnostics_channel":
      case "dns":
      case "dns/promises":
      case "domain":
      case "events":
      case "fs":
      case "fs/promises":
      case "http":
      case "http2":
      case "https":
      case "inspector":
      case "inspector/promises":
      case "module":
      case "net":
      case "os":
      case "path":
      case "path/posix":
      case "path/win32":
      case "perf_hooks":
      case "process":
      case "punycode":
      case "querystring":
      case "readline":
      case "readline/promises":
      case "repl":
      case "stream":
      case "stream/consumers":
      case "stream/promises":
      case "stream/web":
      case "string_decoder":
      case "sys":
      case "timers":
      case "timers/promises":
      case "tls":
      case "trace_events":
      case "tty":
      case "url":
      case "util":
      case "util/types":
      case "v8":
      case "vm":
      case "wasi":
      case "worker_threads":
      case "zlib":
        return true;
      default:
        return false;
    }
  }

  private isBuiltinModule(path: string): boolean {
    return (
      path.startsWith(kNodeModulePrefix) ||
      path.startsWith(kTzModulePrefix) ||
      this.isBareModule(path)
    );
  }
}
