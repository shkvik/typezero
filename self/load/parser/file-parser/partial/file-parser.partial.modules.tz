import { FileParser } from "../file-parser.tz";
import { Token, TokenKind, isKeyword, isName } from "../../../../token.tz";
import {
  Decorator,
  ExportForm,
  Expr,
  ExprKind,
  ImportDecl,
  ModuleName,
  ModulePath,
  NameOrigin,
  Stmt,
  StmtKind,
  WholeImport,
  marker,
} from "../../../../ast.tz";

enum ImportForm {
  Named,
  Namespace,
  Default,
}

type ImportClause =
  | { readonly kind: ImportForm.Named }
  | { readonly kind: ImportForm.Default; readonly name: string }
  | { readonly kind: ImportForm.Namespace; readonly name?: string };

function clauseName(clause: ImportClause): string | undefined {
  if (clause.kind == ImportForm.Named) {
    return undefined;
  }

  return clause.name;
}

function isBareModule(path: string): boolean {
  switch (path) {
    case "assert":
    case "assert/strict":
    case "async_hooks":
    case "buffer":
    case "child_process":
    case "cluster":
    case "console":
    case "constants":
    case "crypto":
    case "dgram":
    case "diagnostics_channel":
    case "dns":
    case "dns/promises":
    case "domain":
    case "events":
    case "fs":
    case "fs/promises":
    case "http":
    case "http2":
    case "https":
    case "inspector":
    case "inspector/promises":
    case "module":
    case "net":
    case "os":
    case "path":
    case "path/posix":
    case "path/win32":
    case "perf_hooks":
    case "process":
    case "punycode":
    case "querystring":
    case "readline":
    case "readline/promises":
    case "repl":
    case "stream":
    case "stream/consumers":
    case "stream/promises":
    case "stream/web":
    case "string_decoder":
    case "sys":
    case "timers":
    case "timers/promises":
    case "tls":
    case "trace_events":
    case "tty":
    case "url":
    case "util":
    case "util/types":
    case "v8":
    case "vm":
    case "wasi":
    case "worker_threads":
    case "zlib":
      return true;
    default:
      return false;
  }
}

function isBuiltinModule(path: string): boolean {
  return (
    path.startsWith("node:") || path.startsWith("tz:") || isBareModule(path)
  );
}

partial class FileParser {
  private importDecl(topLevel: boolean): Stmt {
    const keyword = this.cursor.next();
    const loc = keyword.start;
    if (!topLevel) {
      this.cursor.report(
        loc,
        "'import' is allowed only at the top level of a file",
      );
    }
    if (this.cursor.is(TokenKind.String)) {
      return this.partList(loc, topLevel);
    }
    const next = this.cursor.lookahead();
    const typeWord =
      this.cursor.is(TokenKind.Type) &&
      next.kind != TokenKind.Comma &&
      next.kind != TokenKind.From;
    if (typeWord) {
      const token = this.cursor.peek();
      this.cursor.report(token.start, "'import type' is not needed");
      this.cursor.next();
    }
    const head = this.cursor.peek();
    const formLoc = head.start;
    let clause: ImportClause = { kind: ImportForm.Named };
    if (this.cursor.accept(TokenKind.Star)) {
      let name: string | undefined = undefined;
      if (this.cursor.expect(TokenKind.As, "after 'import *'")) {
        const alias = this.cursor.peek();
        if (isName(alias.kind)) {
          name = alias.text;
        }
        this.cursor.expectName("after 'import * as'");
      }
      clause = { kind: ImportForm.Namespace, name };
    } else if (this.cursor.atName()) {
      const alias = this.cursor.next();
      clause = { kind: ImportForm.Default, name: alias.text };
      if (this.cursor.is(TokenKind.Assign)) {
        this.cursor.error(
          formLoc,
          `'import ${alias.text} = ...' is not supported`,
        );
        return marker(StmtKind.Empty, loc);
      }
      if (
        this.cursor.accept(TokenKind.Comma) &&
        !this.cursor.is(TokenKind.LBrace)
      ) {
        const token = this.cursor.peek();
        this.cursor.error(
          token.start,
          `expected '{' after ',', found ${token.kind}`,
        );
      }
    }
    const names: ModuleName[] = [];
    if (this.cursor.is(TokenKind.LBrace)) {
      this.moduleNames(names, keyword);
    } else if (clause.kind == ImportForm.Named) {
      const token = this.cursor.peek();
      this.cursor.error(
        token.start,
        `expected '{' and the names to import, found ${token.kind}`,
      );
    }
    if (this.cursor.isRecovering()) {
      return marker(StmtKind.Empty, loc);
    }
    const from = this.fromPath(true);
    if (from == undefined) {
      return marker(StmtKind.Empty, loc);
    }

    return this.finishImport(loc, clause, formLoc, names, from);
  }

  private partList(loc: int, topLevel: boolean): Stmt {
    const from = this.fromPath(false);
    this.cursor.expectSemicolon();
    if (topLevel && from != undefined) {
      this.imports.push({ loc, names: [], from, isPartList: true });
    }

    return marker(StmtKind.Empty, loc);
  }

  private finishImport(
    loc: int,
    clause: ImportClause,
    formLoc: int,
    names: ModuleName[],
    from: ModulePath,
  ): Stmt {
    const json = from.path.endsWith(".json");
    let jsonType = false;
    const token = this.cursor.peek();
    const attributes =
      token.kind == TokenKind.With || token.kind == TokenKind.Assert;
    if (attributes && !token.newline) {
      jsonType = this.importAttributes(json);
    }
    this.cursor.expectSemicolon();
    if (json) {
      if (clause.kind != ImportForm.Default) {
        this.cursor.report(
          formLoc,
          "a JSON file is one value: import it whole",
        );
        return marker(StmtKind.Empty, loc);
      }
      if (!jsonType) {
        this.cursor.report(
          from.loc,
          "a JSON file is imported with 'with { type: \"json\" }'",
        );
      }
      names.push({
        name: "json",
        loc: formLoc,
        as: clause.name,
        asLoc: formLoc,
      });
      this.addImport(loc, names, from);
      return marker(StmtKind.Empty, loc);
    }
    const whole = clauseName(clause);
    if (whole != undefined && isBuiltinModule(from.path)) {
      const wholeImport: WholeImport = {
        name: whole,
        loc: formLoc,
        isDefault: clause.kind == ImportForm.Default,
      };
      this.addImport(loc, names, from, wholeImport);
      return marker(StmtKind.Empty, loc);
    }
    if (clause.kind == ImportForm.Namespace) {
      this.cursor.report(formLoc, "'import * as' is not supported");
    } else if (clause.kind == ImportForm.Default) {
      this.cursor.report(formLoc, "default imports are not supported");
    } else if (names.length == 0) {
      this.cursor.report(loc, "an import must name what it takes");
    }
    if (names.length > 0) {
      this.addImport(loc, names, from);
    }

    return marker(StmtKind.Empty, loc);
  }

  private addImport(
    loc: int,
    names: ModuleName[],
    from: ModulePath,
    whole?: WholeImport,
  ): void {
    const decl: ImportDecl = { loc, names, from, whole, isPartList: false };
    this.imports.push(decl);
  }

  private partialClassAhead(): boolean {
    const next = this.cursor.lookahead();

    return next.kind == TokenKind.Class && !next.newline;
  }

  private exportedDeclarationAhead(): boolean {
    const token = this.cursor.peek();
    const next = this.cursor.lookahead();
    switch (token.kind) {
      case TokenKind.Function:
      case TokenKind.Const:
      case TokenKind.Let:
      case TokenKind.Var:
      case TokenKind.Enum:
        return true;
      case TokenKind.Class:
      case TokenKind.Type:
      case TokenKind.Interface:
        return isName(next.kind) && !next.newline;
      case TokenKind.Abstract:
        return next.kind == TokenKind.Class && !next.newline;
      case TokenKind.Declare:
        return (
          next.kind == TokenKind.Function ||
          (!this.library && next.kind == TokenKind.Class)
        );
      default:
        return this.asyncFunctionAhead();
    }
  }

  private exportDecl(topLevel: boolean): Stmt {
    const keyword = this.cursor.next();
    const loc = keyword.start;
    if (!topLevel) {
      this.cursor.report(loc, "'export' is allowed only at the top level");
    }
    if (this.cursor.is(TokenKind.At)) {
      return this.exportDecorated(topLevel);
    }
    if (this.cursor.is(TokenKind.Partial) && this.partialClassAhead()) {
      this.cursor.report(loc, "a part of a class is not exported");
      return this.statement(topLevel);
    }
    if (this.exportedDeclarationAhead()) {
      const stmt = this.statement(topLevel);
      if (topLevel) {
        this.exportDeclared(stmt);
      }
      return stmt;
    }
    if (this.cursor.is(TokenKind.Default)) {
      return this.exportDefault(loc, topLevel);
    }
    if (this.cursor.accept(TokenKind.Assign)) {
      this.cursor.report(loc, "'export =' is not supported");
      this.expression();
      this.cursor.expectSemicolon();
      return marker(StmtKind.Empty, loc);
    }
    if (this.cursor.is(TokenKind.Star)) {
      return this.exportAll(loc);
    }
    const next = this.cursor.lookahead();
    if (this.cursor.is(TokenKind.Type) && next.kind == TokenKind.LBrace) {
      const token = this.cursor.peek();
      this.cursor.report(token.start, "'export type' is not needed");
      this.cursor.next();
    }
    if (!this.cursor.is(TokenKind.LBrace)) {
      const token = this.cursor.peek();
      this.cursor.error(
        token.start,
        `expected a declaration or '{' after 'export', found ${token.kind}`,
      );
      return marker(StmtKind.Empty, loc);
    }

    return this.exportNames(keyword);
  }

  private exportDecorated(topLevel: boolean): Stmt {
    const decorators: Decorator[] = this.decorators();
    const stmt = this.statement(topLevel);
    if (stmt.kind == StmtKind.Class) {
      if (topLevel) {
        this.exportDeclared(stmt);
      }
      stmt.decorators = decorators.concat(stmt.decorators);
    } else {
      this.rejectDecorators(decorators);
    }

    return stmt;
  }

  private exportNames(keyword: Token): Stmt {
    const loc = keyword.start;
    const names: ModuleName[] = [];
    this.moduleNames(names, keyword);
    const reExport =
      !this.cursor.isRecovering() && this.cursor.is(TokenKind.From);
    let from: ModulePath | undefined = undefined;
    if (reExport) {
      from = this.fromPath(true);
      if (from == undefined) {
        return marker(StmtKind.Empty, loc);
      }
    }
    this.cursor.expectSemicolon();
    if (!this.cursor.isRecovering()) {
      const form = reExport ? ExportForm.Re : ExportForm.Local;
      this.exports.push({ loc, form, names, from });
    }

    return marker(StmtKind.Empty, loc);
  }

  private exportDefault(loc: int, topLevel: boolean): Stmt {
    this.cursor.report(loc, "'export default' is not supported");
    this.cursor.next();
    const next = this.cursor.lookahead();
    if (this.cursor.is(TokenKind.Function) && isName(next.kind)) {
      return this.statement(topLevel);
    }
    const head = this.cursor.peek();
    const exprLoc = head.start;
    const expr = this.exprOrFunction(exprLoc);
    this.cursor.expectSemicolon();

    return { kind: StmtKind.Expr, loc: exprLoc, expr };
  }

  private exprOrFunction(loc: int): Expr {
    if (!this.cursor.is(TokenKind.Function)) {
      return this.expression();
    }
    const fn = this.functionDecl(true, false);

    return { kind: ExprKind.Function, loc, fn };
  }

  private exportAll(loc: int): Stmt {
    this.cursor.next();
    if (this.cursor.is(TokenKind.As)) {
      const asKeyword = this.cursor.next();
      const asLoc = asKeyword.start;
      this.cursor.expectName("after 'export * as'");
      if (!this.cursor.isRecovering() && this.fromPath(true) != undefined) {
        this.cursor.report(asLoc, "'export * as' is not supported");
        this.cursor.expectSemicolon();
      }
      return marker(StmtKind.Empty, loc);
    }
    const from = this.fromPath(true);
    if (from != undefined) {
      this.cursor.expectSemicolon();
      this.exports.push({
        loc,
        form: ExportForm.All,
        names: [],
        from,
      });
    }

    return marker(StmtKind.Empty, loc);
  }

  private moduleNames(names: ModuleName[], keyword: Token): void {
    this.cursor.next();
    while (this.cursor.insideList(TokenKind.RBrace)) {
      const next = this.cursor.lookahead();
      if (this.cursor.is(TokenKind.Type) && isName(next.kind)) {
        const token = this.cursor.peek();
        this.cursor.report(
          token.start,
          `'type' is not needed in an ${keyword.text}`,
        );
        this.cursor.next();
      }
      const name = this.moduleName(keyword);
      if (name == undefined) {
        return;
      }
      names.push(name);
      if (!this.cursor.accept(TokenKind.Comma)) {
        break;
      }
    }
    this.cursor.expect(
      TokenKind.RBrace,
      `to close the names to ${keyword.text}`,
    );
  }

  private moduleName(keyword: Token): ModuleName | undefined {
    const token = this.cursor.peek();
    if (token.kind == TokenKind.Default) {
      this.cursor.error(token.start, "there is no 'export default'");
      return undefined;
    }
    const reserved = !isName(token.kind) && isKeyword(token.kind);
    const next = this.cursor.lookahead();
    const renamed = reserved && next.kind == TokenKind.As;
    if (reserved && !renamed) {
      this.cursor.error(
        token.start,
        `'${token.text}' is a keyword in tz: ${keyword.text} it under another name, e.g. '{ ${token.text} as ${token.text}Name }'`,
      );
      return undefined;
    }
    if (!isName(token.kind) && !renamed) {
      this.cursor.error(
        token.start,
        `expected a name to ${keyword.text}, found ${token.kind}`,
      );
      return undefined;
    }
    this.cursor.next();
    if (!this.cursor.accept(TokenKind.As)) {
      return {
        name: token.text,
        loc: token.start,
        as: token.text,
        asLoc: token.start,
      };
    }
    const alias = this.cursor.peek();
    if (alias.kind == TokenKind.Default) {
      this.cursor.error(alias.start, "there is no 'export default'");
      return undefined;
    }
    if (!isName(alias.kind)) {
      this.cursor.error(
        alias.start,
        `expected a name after 'as', found ${alias.kind}`,
      );
      return undefined;
    }
    this.cursor.next();

    return {
      name: token.text,
      loc: token.start,
      as: alias.text,
      asLoc: alias.start,
    };
  }

  private importAttributes(json: boolean): boolean {
    const keyword = this.cursor.peek();
    const at = keyword.start;
    const old = keyword.kind == TokenKind.Assert;
    this.cursor.next();
    if (!this.cursor.expect(TokenKind.LBrace, "after 'with'")) {
      return false;
    }
    let typeJson = false;
    let other = false;
    while (this.cursor.insideList(TokenKind.RBrace)) {
      const key = this.attributeKey();
      if (
        key == undefined ||
        !this.cursor.expect(
          TokenKind.Colon,
          "after the name of an import attribute",
        )
      ) {
        this.cursor.skipToClosingBrace();
        return false;
      }
      const value = this.fromPath(false);
      if (value == undefined) {
        this.cursor.skipToClosingBrace();
        return false;
      }
      if (key == "type" && value.path == "json") {
        typeJson = true;
      } else {
        other = true;
      }
      if (!this.cursor.accept(TokenKind.Comma)) {
        break;
      }
    }
    this.cursor.expect(TokenKind.RBrace, "after the import attributes");
    if (!json) {
      this.cursor.report(at, "import attributes are only for JSON files");
      return false;
    }
    if (old) {
      this.cursor.report(at, "'assert' is the old form of import attributes");
    } else if (other) {
      this.cursor.report(at, "a JSON file takes one import attribute");
    }

    return typeJson || old || other;
  }

  private attributeKey(): string | undefined {
    const token = this.cursor.peek();
    if (isName(token.kind) || isKeyword(token.kind)) {
      this.cursor.next();
      return token.text;
    }
    const quoted = this.fromPath(false);

    return quoted == undefined ? undefined : quoted.path;
  }

  private fromPath(from: boolean): ModulePath | undefined {
    if (from && !this.cursor.is(TokenKind.From)) {
      const token = this.cursor.peek();
      this.cursor.error(
        token.start,
        `expected 'from' and the path of the file, found ${token.kind}`,
      );
      return undefined;
    }
    if (from) {
      this.cursor.next();
    }
    const token = this.cursor.peek();
    if (token.kind != TokenKind.String) {
      this.cursor.error(
        token.start,
        `expected the path of the file as a string, found ${token.kind}`,
      );
      return undefined;
    }
    const decoded = this.literals.string(token);
    this.cursor.next();

    return { path: decoded.text, loc: token.start };
  }

  private exportDeclared(stmt: Stmt): void {
    const names: ModuleName[] = [];
    if (
      stmt.kind == StmtKind.Function ||
      stmt.kind == StmtKind.TypeAlias ||
      stmt.kind == StmtKind.Enum
    ) {
      names.push({
        name: stmt.name,
        loc: stmt.loc,
        as: stmt.name,
        asLoc: stmt.loc,
      });
    } else if (stmt.kind == StmtKind.Class) {
      const name = stmt.name ?? "";
      names.push({ name, loc: stmt.loc, as: name, asLoc: stmt.loc });
    } else if (stmt.kind == StmtKind.VarDecl) {
      for (const d of stmt.decls) {
        if (d.origin == NameOrigin.Written) {
          names.push({ name: d.name, loc: d.loc, as: d.name, asLoc: d.loc });
        }
      }
    }
    if (names.length == 0) {
      return;
    }
    this.exports.push({
      loc: stmt.loc,
      form: ExportForm.Local,
      names,
    });
  }
}
