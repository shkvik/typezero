import { FileParser } from "../file-parser.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { TokenKind } from "../../../token/types/token.types.tz";
import { kTokenTable } from "../../../token/const/token.const.tz";
import {
  TypeParamDecl,
  TypeRef,
} from "../../../../program/ast/types/ast.types.types.tz";
import { Expr } from "../../../../program/ast/types/ast.types.expressions.tz";
import { VarDeclarator } from "../../../../program/ast/types/ast.types.patterns.tz";
import {
  BlockStmt,
  Stmt,
  StmtKind,
} from "../../../../program/ast/types/ast.types.statements.tz";
import {
  BodySource,
  FunctionDecl,
  FunctionPlace,
  Param,
  ParamForm,
  ParamKind,
  ParamProperty,
} from "../../../../program/ast/types/ast.types.functions.tz";
import {
  Access,
  ClassMember,
  MethodKind,
} from "../../../../program/ast/types/ast.types.classes.tz";
import { FunctionKind } from "../types/file-parser.types.context.tz";
import {
  FunctionName,
  ParamName,
  ParamPattern,
} from "../types/file-parser.types.functions.tz";

partial class FileParser {
  private functionDeclaration(isAsync: boolean): Stmt {
    let declaration = this.functionDecl(false, isAsync);
    if (declaration.body != undefined) {
      return declaration;
    }

    const name = declaration.name;
    const loc = declaration.loc;

    while (declaration.body == undefined) {
      const next = this.cursor.lookahead();
      if (this.cursor.is(TokenKind.Export) && next.kind == TokenKind.Function) {
        this.cursor.next();
      }

      const nextName = this.cursor.lookahead();
      if (!this.cursor.is(TokenKind.Function) || nextName.text != name) {
        this.cursor.report(loc, Code.FunctionWithoutBody, { word: name });

        return this.marker(StmtKind.Empty, loc);
      }

      declaration = this.functionDecl(false, isAsync);
    }

    this.cursor.report(loc, Code.OverloadSignatures);

    return declaration;
  }

  private declaredFunction(): Stmt {
    const declaration = this.functionDecl(false, false);
    if (declaration.body != undefined) {
      this.cursor.report(declaration.loc, Code.DeclaredFunctionBody);

      return declaration;
    }

    declaration.bodySource = this.declaredBodySource();
    declaration.body = { kind: StmtKind.Block, loc: declaration.loc, body: [] };

    return declaration;
  }

  private functionDecl(expression: boolean, isAsync: boolean): FunctionDecl {
    const keyword = this.cursor.next();
    const generator = this.cursor.accept(TokenKind.Star);
    const named = this.functionName(keyword.start, expression);
    const typeParams = this.optionalTypeParams();
    const outer = this.context;
    const functionKind = this.functionKindOf(generator);

    this.context = { ...outer, functionKind };
    const patterns: ParamPattern[] = [];
    const params = this.params(false, false, patterns);
    const returnType = this.returnTypeAnnotation();
    const body = this.functionBody(expression, patterns);
    const ownName = this.ownNameOf(expression, named.name);
    const place = this.functionPlace(expression);

    this.context = outer;

    return {
      kind: StmtKind.Function,
      loc: named.loc,
      name: named.name,
      typeParams,
      params,
      returnType,
      body,
      source: this.cursor.spanFrom(keyword.start),
      isArrow: false,
      concise: false,
      ownName,
      place,
      bodySource: BodySource.Written,
      isGenerator: generator,
      isAsync,
    };
  }

  private functionName(keywordLoc: int, expression: boolean): FunctionName {
    const token = this.cursor.peek();
    const named = kTokenTable.isName(token.kind);
    const reserved = !named && kTokenTable.isKeyword(token.kind) && !expression;
    if (reserved) {
      this.cursor.report(token.start, Code.KeywordAsFunctionName, {
        word: token.text,
      });
    }
    if (named || reserved) {
      this.cursor.next();

      return { name: token.text, loc: token.start };
    }
    if (expression) {
      return { name: "", loc: keywordLoc };
    }

    this.cursor.error(token.start, Code.ExpectedFunctionName);

    return { name: "", loc: token.start };
  }

  private functionBody(
    expression: boolean,
    patterns: ParamPattern[],
  ): BlockStmt | undefined {
    if (!this.cursor.is(TokenKind.LBrace)) {
      return this.missingBody(expression);
    }

    const body = this.block();

    this.addPrologue(body, patterns);

    return body;
  }

  private missingBody(expression: boolean): BlockStmt | undefined {
    const token = this.cursor.peek();
    const declaredOnly =
      !expression &&
      (this.cursor.accept(TokenKind.Semi) ||
        token.newline ||
        token.kind == TokenKind.RBrace ||
        token.kind == TokenKind.End);
    if (declaredOnly) {
      return undefined;
    }

    this.cursor.error(token.start, Code.ExpectedFunctionBody);

    return {
      kind: StmtKind.Block,
      loc: token.start,
      body: [],
    };
  }

  private params(
    arrow: boolean,
    constructor: boolean,
    patterns: ParamPattern[],
  ): Param[] {
    const opened = this.openParams(arrow);
    const params: Param[] = [];

    while (this.cursor.insideList(TokenKind.RParen)) {
      const param = this.param(constructor, patterns);
      if (param == undefined) {
        return this.brokenParams(params, opened);
      }

      params.push(param);
      if (!this.cursor.accept(TokenKind.Comma)) {
        break;
      }

      const rest = param.form.kind == ParamKind.Rest;
      if (rest && !this.cursor.is(TokenKind.RParen)) {
        this.cursor.report(param.loc, Code.RestParameterNotLast);
      }
    }

    this.cursor.expect(TokenKind.RParen, Code.ExpectedParametersClose);

    return params;
  }

  private brokenParams(params: Param[], opened: boolean): Param[] {
    if (opened) {
      this.cursor.skipToClosingParen();
    }

    return params;
  }

  private param(
    constructor: boolean,
    patterns: ParamPattern[],
  ): Param | undefined {
    const decorators = this.decorators();

    if (this.cursor.isRecovering()) {
      return undefined;
    }

    const property = this.paramModifiers(constructor);
    const rest = this.cursor.accept(TokenKind.Ellipsis);
    const token = this.cursor.peek();
    const loc = token.start;
    const named = this.paramName(rest, patterns);
    if (named == undefined) {
      return undefined;
    }

    const optional = this.cursor.accept(TokenKind.Question);
    const type = this.typeAnnotation();
    const defaultValue = this.paramDefault(optional);
    if (rest && (optional || defaultValue != undefined)) {
      this.cursor.report(loc, Code.RestParameterOptional);
    }

    const form = this.paramForm(rest, optional, defaultValue);

    return {
      name: named.name,
      loc,
      type,
      form,
      property,
      pattern: named.pattern,
      decorators,
    };
  }

  private paramName(
    rest: boolean,
    patterns: ParamPattern[],
  ): ParamName | undefined {
    const token = this.cursor.peek();
    const named = this.cursor.atNameOrThis();
    const reserved = !named && kTokenTable.isKeyword(token.kind);
    if (reserved) {
      this.cursor.report(token.start, Code.KeywordAsParameterName, {
        word: token.text,
      });
    }
    if (named || reserved) {
      this.cursor.next();

      return { name: token.text };
    }

    const patternStarts =
      this.cursor.is(TokenKind.LBrace) || this.cursor.is(TokenKind.LBracket);
    if (patternStarts && !rest) {
      const bound = this.bindingPattern();
      const name = this.hiddenName();
      const pattern = this.cursor.spanFrom(token.start);

      patterns.push({ name, pattern: bound });

      return { name, pattern };
    }

    if (rest) {
      this.cursor.error(token.start, Code.ExpectedParameterAfterRest);
    } else {
      this.cursor.error(token.start, Code.ExpectedParameterName);
    }

    return undefined;
  }

  private paramDefault(optional: boolean): Expr | undefined {
    const assign = this.cursor.peek();
    if (assign.kind != TokenKind.Assign) {
      return undefined;
    }
    if (optional) {
      this.cursor.report(assign.start, Code.DefaultMakesOptional);
    }

    this.cursor.next();

    return this.expression();
  }

  private paramForm(
    rest: boolean,
    optional: boolean,
    defaultValue: Expr | undefined,
  ): ParamForm {
    if (rest) {
      return { kind: ParamKind.Rest };
    }
    if (defaultValue != undefined) {
      return { kind: ParamKind.Defaulted, defaultValue };
    }

    if (optional) {
      return { kind: ParamKind.Optional };
    }

    return { kind: ParamKind.Required };
  }

  private paramModifierAhead(): boolean {
    const token = this.cursor.peek();
    const next = this.cursor.lookahead();
    const named =
      kTokenTable.isName(next.kind) || kTokenTable.isKeyword(next.kind);

    return this.isParamModifier(token.kind) && named;
  }

  private paramModifiers(constructor: boolean): ParamProperty | undefined {
    let property: ParamProperty | undefined = undefined;
    const seen: TokenKind[] = [];

    while (this.paramModifierAhead()) {
      const word = this.cursor.next();

      this.rememberModifier(seen, word);
      if (!constructor) {
        this.cursor.report(word.start, Code.ParameterModifierMakesField, {
          word: word.text,
        });
      }

      const found = property ?? { readonly: false, access: Access.Public };

      property = found;
      if (word.kind == TokenKind.Readonly) {
        found.readonly = true;
      }

      const access = this.accessOf(word.kind);
      if (access != undefined) {
        found.access = access;
      }
    }

    return property;
  }

  private addPrologue(
    body: BlockStmt | undefined,
    patterns: ParamPattern[],
  ): void {
    if (patterns.length == 0 || body == undefined) {
      return;
    }

    const decls: VarDeclarator[] = [];

    for (const entry of patterns) {
      this.declareElements(decls, entry.pattern, entry.name);
    }

    const prologue: Stmt[] = [
      {
        kind: StmtKind.VarDecl,
        loc: body.loc,
        isConst: false,
        isUsing: false,
        decls,
      },
    ];

    body.body = prologue.concat(body.body);
  }

  private asyncFunctionAhead(): boolean {
    const next = this.cursor.lookahead();

    return (
      this.cursor.is(TokenKind.Async) &&
      next.kind == TokenKind.Function &&
      !next.newline
    );
  }

  private typeParams(): TypeParamDecl[] {
    const params: TypeParamDecl[] = [];

    this.cursor.next();

    while (this.cursor.insideList(TokenKind.Greater)) {
      const param = this.typeParam();
      if (param == undefined) {
        return params;
      }

      params.push(param);
      if (!this.cursor.accept(TokenKind.Comma)) {
        break;
      }
    }

    this.cursor.expect(TokenKind.Greater, Code.ExpectedTypeParametersClose);

    return params;
  }

  private typeParam(): TypeParamDecl | undefined {
    const next = this.cursor.lookahead();
    const modifier =
      this.cursor.is(TokenKind.Const) ||
      this.cursor.is(TokenKind.In) ||
      this.cursor.is(TokenKind.Out);
    if (modifier && kTokenTable.isName(next.kind)) {
      const word = this.cursor.next();

      this.cursor.report(word.start, Code.TypeParameterModifier, {
        word: word.text,
      });
    }

    const token = this.cursor.peek();
    if (!kTokenTable.isName(token.kind)) {
      this.cursor.error(token.start, Code.ExpectedTypeParameterName, {
        found: token.kind,
      });

      return undefined;
    }

    this.cursor.next();
    const constraint = this.typeConstraint();
    const defaultType = this.typeDefault();

    return {
      name: token.text,
      loc: token.start,
      constraint,
      defaultType,
    };
  }

  private method(
    loc: int,
    name: string,
    start: int,
    generator: boolean,
    isAsync: boolean,
    place: FunctionPlace,
    role: ClassMember | undefined,
  ): FunctionDecl {
    const outer = this.context;
    const functionKind = this.functionKindOf(generator);

    this.context = { ...outer, functionKind };
    const typeParams = this.optionalTypeParams();
    const patterns: ParamPattern[] = [];
    const constructor =
      role != undefined && role.method == MethodKind.Constructor;
    const params = this.params(false, constructor, patterns);
    const returnType = this.returnTypeAnnotation();
    const body = this.methodBody(patterns);
    const source = this.cursor.spanFrom(start);

    this.context = outer;

    return {
      kind: StmtKind.Function,
      loc,
      name,
      typeParams,
      params,
      returnType,
      body,
      source,
      isArrow: false,
      concise: false,
      ownName: "",
      place,
      bodySource: BodySource.Written,
      isGenerator: generator,
      isAsync,
      role,
    };
  }

  private methodBody(patterns: ParamPattern[]): BlockStmt | undefined {
    if (this.cursor.is(TokenKind.LBrace)) {
      const body = this.block();

      this.addPrologue(body, patterns);

      return body;
    }
    if (this.cursor.accept(TokenKind.Semi)) {
      return undefined;
    }

    const token = this.cursor.peek();
    const ended =
      token.newline ||
      token.kind == TokenKind.RBrace ||
      token.kind == TokenKind.End;
    if (!ended) {
      this.cursor.error(token.start, Code.ExpectedMethodBody);
    }

    return undefined;
  }

  private isParamModifier(kind: TokenKind): boolean {
    switch (kind) {
      case TokenKind.Public:
      case TokenKind.Private:
      case TokenKind.Protected:
      case TokenKind.Readonly:
      case TokenKind.Override:
        return true;
      default:
        return false;
    }
  }

  private optionalTypeParams(): TypeParamDecl[] {
    if (!this.cursor.is(TokenKind.Less)) {
      return [];
    }

    return this.typeParams();
  }

  private typeConstraint(): TypeRef | undefined {
    if (!this.cursor.accept(TokenKind.Extends)) {
      return undefined;
    }

    return this.type();
  }

  private typeDefault(): TypeRef | undefined {
    if (!this.cursor.accept(TokenKind.Assign)) {
      return undefined;
    }

    return this.type();
  }

  private functionKindOf(generator: boolean): FunctionKind {
    if (generator) {
      return FunctionKind.Generator;
    }

    return FunctionKind.Plain;
  }

  private functionPlace(expression: boolean): FunctionPlace {
    if (expression) {
      return FunctionPlace.Expression;
    }

    return FunctionPlace.Declared;
  }

  private ownNameOf(expression: boolean, name: string): string {
    if (expression) {
      return name;
    }

    return "";
  }

  private declaredBodySource(): BodySource {
    if (this.library) {
      return BodySource.External;
    }

    return BodySource.Foreign;
  }

  private openParams(arrow: boolean): boolean {
    if (arrow) {
      this.cursor.next();

      return true;
    }

    return this.cursor.expect(TokenKind.LParen, Code.ExpectedAfterFunctionName);
  }
}
