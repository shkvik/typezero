import { FileParser } from "../file-parser.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { Token, TokenKind } from "../../../token/types/token.types.tz";
import { kTokenTable } from "../../../token/const/token.const.tz";
import {
  BinaryOp,
  Expr,
  ExprKind,
  UnaryOp,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { ExpressionPlace } from "../types/file-parser.types.context.tz";
import {
  BinaryOperator,
  Operator,
  Precedence,
} from "../types/file-parser.types.operators.tz";

partial class FileParser {
  private operator(): Operator {
    const token = this.cursor.peek();
    if (token.kind != TokenKind.Greater) {
      return { kind: token.kind, width: 1 };
    }
    if (this.glued(1, TokenKind.Greater)) {
      if (this.glued(2, TokenKind.Greater)) {
        if (this.glued(3, TokenKind.Assign)) {
          return { kind: TokenKind.UShrAssign, width: 4 };
        }

        return { kind: TokenKind.UShr, width: 3 };
      }
      if (this.glued(2, TokenKind.Assign)) {
        return { kind: TokenKind.ShrAssign, width: 3 };
      }

      return { kind: TokenKind.Shr, width: 2 };
    }
    if (this.glued(1, TokenKind.Assign)) {
      return { kind: TokenKind.GreaterEq, width: 2 };
    }

    return { kind: TokenKind.Greater, width: 1 };
  }

  private glued(offset: int, kind: TokenKind): boolean {
    const token = this.cursor.tokenAt(offset);
    const before = this.cursor.tokenAt(offset - 1);

    return token.kind == kind && token.start == before.end;
  }

  private binary(above: Precedence): Expr {
    const head = this.cursor.peek();
    const start = head.start;
    const prefix = this.unaryOpFor(head.kind);
    let left = this.unary();

    if (prefix != undefined && this.cursor.is(TokenKind.StarStar)) {
      const token = this.cursor.peek();
      const operator = this.written(head.start, head.end);
      const example = this.unaryExample(head.kind, operator);

      this.cursor.report(token.start, Code.UnaryBeforePower, {
        word: operator,
        other: example,
      });
    }

    let lookahead = this.binaryOperator();
    let previous = head;

    while (lookahead.precedence > above) {
      const operator = this.cursor.peek();

      this.checkNullishMix(previous, operator);
      left = this.applyOperator(left, lookahead, start);
      previous = operator;
      lookahead = this.binaryOperator();
    }

    return left;
  }

  private checkNullishMix(previous: Token, next: Token): void {
    const nullishFirst =
      previous.kind == TokenKind.QuestionQuestion && this.isLogical(next.kind);
    const nullishSecond =
      next.kind == TokenKind.QuestionQuestion && this.isLogical(previous.kind);
    if (!nullishFirst && !nullishSecond) {
      return;
    }

    const first = this.written(previous.start, previous.end);
    const second = this.written(next.start, next.end);
    const word = `(a ${first} b) ${second} c`;
    const other = `a ${first} (b ${second} c)`;

    this.cursor.report(next.start, Code.NullishMixedWithLogical, {
      word,
      other,
    });
  }

  private isLogical(kind: TokenKind): boolean {
    return kind == TokenKind.PipePipe || kind == TokenKind.AmpAmp;
  }

  private binaryOperator(): BinaryOperator {
    const token = this.cursor.peek();

    switch (token.kind) {
      case TokenKind.As:
      case TokenKind.Instanceof:
        return {
          kind: token.kind,
          width: 1,
          precedence: Precedence.Relational,
        };
      case TokenKind.Satisfies: {
        const precedence = this.relationalUnless(token.newline);

        return { kind: token.kind, width: 1, precedence };
      }
      case TokenKind.In: {
        const place = this.context.expressionPlace;
        const forHead = place == ExpressionPlace.ForHead;
        const precedence = this.relationalUnless(forHead);

        return { kind: token.kind, width: 1, precedence };
      }
      default: {
        const op = this.operator();
        const precedence = this.binaryPrecedence(op.kind);

        return { kind: op.kind, width: op.width, precedence };
      }
    }
  }

  private applyOperator(left: Expr, op: BinaryOperator, start: int): Expr {
    const token = this.cursor.peek();
    const loc = token.start;

    this.cursor.skip(op.width);

    switch (op.kind) {
      case TokenKind.As:
        return this.castTo(left, loc);
      case TokenKind.Satisfies:
        return this.satisfiesCheck(left, loc);
      case TokenKind.Instanceof:
        return this.instanceOfCheck(left, loc, start);
      default:
        return this.binaryOperation(left, op, loc, start);
    }
  }

  private castTo(operand: Expr, loc: int): Expr {
    const target = this.type();

    return { kind: ExprKind.Cast, loc, operand, target };
  }

  private satisfiesCheck(operand: Expr, loc: int): Expr {
    const first = this.cursor.peek();

    this.type();
    const type = this.cursor.spanFrom(first.start);
    const word = this.written(type.start, type.end);

    this.cursor.report(loc, Code.SatisfiesNotSupported, { word });

    return operand;
  }

  private instanceOfCheck(left: Expr, loc: int, start: int): Expr {
    const right = this.binary(Precedence.Relational);
    const source = this.cursor.spanFrom(start);

    return {
      kind: ExprKind.Binary,
      loc,
      op: BinaryOp.InstanceOf,
      lhs: left,
      rhs: right,
      source,
    };
  }

  private binaryOperation(
    left: Expr,
    op: BinaryOperator,
    loc: int,
    start: int,
  ): Expr {
    if (op.kind == TokenKind.EqEqEq) {
      this.cursor.report(loc, Code.StrictEqualsNotSupported);
    }
    if (op.kind == TokenKind.BangEqEq) {
      this.cursor.report(loc, Code.StrictNotEqualsNotSupported);
    }

    const floor = this.rightFloor(op);
    const right = this.binary(floor);
    const operation = this.binaryOpFor(op.kind);
    const source = this.cursor.spanFrom(start);

    return {
      kind: ExprKind.Binary,
      loc,
      op: operation,
      lhs: left,
      rhs: right,
      source,
    };
  }

  private unary(): Expr {
    const token = this.cursor.peek();

    switch (token.kind) {
      case TokenKind.Await:
        return this.awaitExpression();
      case TokenKind.PlusPlus:
      case TokenKind.MinusMinus:
        return this.prefixUpdate();
      default:
        return this.prefixOperation();
    }
  }

  private awaitExpression(): Expr {
    const keyword = this.cursor.next();
    const value = this.unary();

    return { kind: ExprKind.Await, loc: keyword.start, value };
  }

  private prefixUpdate(): Expr {
    const sign = this.cursor.next();
    const first = this.cursor.peek();
    const target = this.unary();

    this.rejectOptionalTarget(target, first.start);

    return {
      kind: ExprKind.Update,
      loc: sign.start,
      increment: sign.kind == TokenKind.PlusPlus,
      prefix: true,
      target,
    };
  }

  private prefixOperation(): Expr {
    const token = this.cursor.peek();
    const op = this.unaryOpFor(token.kind);
    if (op == undefined) {
      return this.postfix();
    }

    this.cursor.next();
    const operand = this.unary();

    return { kind: ExprKind.Unary, loc: token.start, op, operand };
  }

  private postfix(): Expr {
    const first = this.cursor.peek();
    const target = this.callOrMember();
    const token = this.cursor.peek();
    const update =
      (token.kind == TokenKind.PlusPlus ||
        token.kind == TokenKind.MinusMinus) &&
      !token.newline;
    if (!update) {
      return target;
    }

    this.rejectOptionalTarget(target, first.start);
    this.cursor.next();

    return {
      kind: ExprKind.Update,
      loc: token.start,
      increment: token.kind == TokenKind.PlusPlus,
      prefix: false,
      target,
    };
  }

  private rejectOptionalTarget(target: Expr, start: int): void {
    if (target.kind != ExprKind.OptionalChain) {
      return;
    }

    const span = this.cursor.spanFrom(start);
    const word = this.written(span.start, span.end);

    this.cursor.report(start, Code.OptionalChainChanged, { word });
  }

  private binaryPrecedence(kind: TokenKind): Precedence {
    switch (kind) {
      case TokenKind.PipePipe:
      case TokenKind.QuestionQuestion:
        return Precedence.Or;
      case TokenKind.AmpAmp:
        return Precedence.And;
      case TokenKind.Pipe:
        return Precedence.BitOr;
      case TokenKind.Caret:
        return Precedence.BitXor;
      case TokenKind.Amp:
        return Precedence.BitAnd;
      case TokenKind.EqEq:
      case TokenKind.EqEqEq:
      case TokenKind.BangEq:
      case TokenKind.BangEqEq:
        return Precedence.Equality;
      case TokenKind.Less:
      case TokenKind.LessEq:
      case TokenKind.Greater:
      case TokenKind.GreaterEq:
      case TokenKind.In:
        return Precedence.Relational;
      case TokenKind.Shl:
      case TokenKind.Shr:
      case TokenKind.UShr:
        return Precedence.Shift;
      case TokenKind.Plus:
      case TokenKind.Minus:
        return Precedence.Additive;
      case TokenKind.Star:
      case TokenKind.Slash:
      case TokenKind.Percent:
        return Precedence.Multiplicative;
      case TokenKind.StarStar:
        return Precedence.Power;
      default:
        return Precedence.None;
    }
  }

  private binaryOpFor(kind: TokenKind): BinaryOp {
    switch (kind) {
      case TokenKind.PipePipe:
        return BinaryOp.LogOr;
      case TokenKind.QuestionQuestion:
        return BinaryOp.Nullish;
      case TokenKind.AmpAmp:
        return BinaryOp.LogAnd;
      case TokenKind.Pipe:
        return BinaryOp.BitOr;
      case TokenKind.Caret:
        return BinaryOp.BitXor;
      case TokenKind.Amp:
        return BinaryOp.BitAnd;
      case TokenKind.EqEq:
      case TokenKind.EqEqEq:
        return BinaryOp.Eq;
      case TokenKind.BangEq:
      case TokenKind.BangEqEq:
        return BinaryOp.Ne;
      case TokenKind.Less:
        return BinaryOp.Lt;
      case TokenKind.LessEq:
        return BinaryOp.Le;
      case TokenKind.Greater:
        return BinaryOp.Gt;
      case TokenKind.GreaterEq:
        return BinaryOp.Ge;
      case TokenKind.In:
        return BinaryOp.In;
      case TokenKind.Shl:
        return BinaryOp.Shl;
      case TokenKind.Shr:
        return BinaryOp.Shr;
      case TokenKind.UShr:
        return BinaryOp.UShr;
      case TokenKind.Plus:
        return BinaryOp.Add;
      case TokenKind.Minus:
        return BinaryOp.Sub;
      case TokenKind.Star:
        return BinaryOp.Mul;
      case TokenKind.StarStar:
        return BinaryOp.Pow;
      case TokenKind.Slash:
        return BinaryOp.Div;
      default:
        return BinaryOp.Rem;
    }
  }

  private assignmentOp(kind: TokenKind): BinaryOp | undefined {
    switch (kind) {
      case TokenKind.PlusAssign:
        return BinaryOp.Add;
      case TokenKind.MinusAssign:
        return BinaryOp.Sub;
      case TokenKind.StarAssign:
        return BinaryOp.Mul;
      case TokenKind.StarStarAssign:
        return BinaryOp.Pow;
      case TokenKind.SlashAssign:
        return BinaryOp.Div;
      case TokenKind.PercentAssign:
        return BinaryOp.Rem;
      case TokenKind.AmpAssign:
        return BinaryOp.BitAnd;
      case TokenKind.PipeAssign:
        return BinaryOp.BitOr;
      case TokenKind.CaretAssign:
        return BinaryOp.BitXor;
      case TokenKind.ShlAssign:
        return BinaryOp.Shl;
      case TokenKind.ShrAssign:
        return BinaryOp.Shr;
      case TokenKind.UShrAssign:
        return BinaryOp.UShr;
      case TokenKind.QuestionQuestionAssign:
        return BinaryOp.Nullish;
      case TokenKind.AmpAmpAssign:
        return BinaryOp.LogAnd;
      case TokenKind.PipePipeAssign:
        return BinaryOp.LogOr;
      default:
        return undefined;
    }
  }

  private isAssignment(kind: TokenKind): boolean {
    if (kind == TokenKind.Assign) {
      return true;
    }

    const compound = this.assignmentOp(kind);

    return compound != undefined;
  }

  private unaryExample(kind: TokenKind, operator: string): string {
    if (kTokenTable.isKeyword(kind)) {
      return `${operator} x`;
    }

    return `${operator}x`;
  }

  private unaryOpFor(kind: TokenKind): UnaryOp | undefined {
    switch (kind) {
      case TokenKind.Minus:
        return UnaryOp.Neg;
      case TokenKind.Plus:
        return UnaryOp.Plus;
      case TokenKind.Bang:
        return UnaryOp.Not;
      case TokenKind.Tilde:
        return UnaryOp.BitNot;
      case TokenKind.Typeof:
        return UnaryOp.TypeOf;
      case TokenKind.Void:
        return UnaryOp.Void;
      case TokenKind.Delete:
        return UnaryOp.Delete;
      default:
        return undefined;
    }
  }

  private relationalUnless(blocked: boolean): Precedence {
    if (blocked) {
      return Precedence.None;
    }

    return Precedence.Relational;
  }

  private rightFloor(op: BinaryOperator): Precedence {
    switch (op.kind) {
      case TokenKind.StarStar:
        return Precedence.Multiplicative;
      case TokenKind.QuestionQuestion:
        return Precedence.And;
      default:
        return op.precedence;
    }
  }
}
