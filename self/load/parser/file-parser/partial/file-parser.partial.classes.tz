import { FileParser } from "../file-parser.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { Token, TokenKind } from "../../../token/types/token.types.tz";
import { kTokenTable } from "../../../token/const/token.const.tz";
import { TypeRefKind } from "../../../../program/ast/types/ast.types.types.tz";
import {
  ExprKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import {
  StmtKind,
} from "../../../../program/ast/types/ast.types.statements.tz";
import {
  BodySource,
} from "../../../../program/ast/types/ast.types.functions.tz";
import {
  FieldKind,
  FieldPresence,
  MethodKind,
} from "../../../../program/ast/types/ast.types.classes.tz";
import {
  ClassBase,
  ClassDeclDraft,
  MemberName,
  Modifiers,
} from "../types/file-parser.types.classes.tz";
import {
  kInPlaceDecorator,
  kUnsafeDecorator,
} from "../const/file-parser.const.classes.tz";
import {
  ClassDecl,
  Decorator,
} from "../../../../program/syntax/types/syntax.types.classes.tz";
import {
  Expr,
} from "../../../../program/syntax/types/syntax.types.expressions.tz";
import {
  FunctionDecl,
} from "../../../../program/syntax/types/syntax.types.functions.tz";
import {
  BlockStmt,
} from "../../../../program/syntax/types/syntax.types.statements.tz";
import {
  TypeRef,
} from "../../../../program/syntax/types/syntax.types.types.tz";

partial class FileParser {
  private classDeclaration(): ClassDeclDraft {
    this.unsafeMark = undefined;

    if (!this.classNameAhead()) {
      const next = this.cursor.lookahead();

      this.cursor.report(next.start, Code.ClassNeedsName);
    }

    return this.classDecl(false);
  }

  private readonly finishedClass(draft: Own<ClassDeclDraft>): ClassDecl {
    return {
      kind: StmtKind.Class,
      loc: draft.loc,
      name: draft.name,
      isAbstract: draft.isAbstract,
      isPartial: draft.isPartial,
      isInPlace: draft.isInPlace,
      base: draft.base,
      baseExpr: draft.baseExpr,
      baseArgs: draft.baseArgs,
      interfaces: draft.interfaces,
      fields: draft.fields,
      methods: draft.methods,
      constructors: draft.constructors,
      expression: draft.expression,
      decorators: draft.decorators,
      typeParams: draft.typeParams,
      source: draft.source,
    };
  }

  private readonly namedClassDecl(
    decl: Own<ClassDecl>,
    name: string,
  ): ClassDecl {
    return {
      kind: StmtKind.Class,
      loc: decl.loc,
      name,
      isAbstract: decl.isAbstract,
      isPartial: decl.isPartial,
      isInPlace: decl.isInPlace,
      base: decl.base,
      baseExpr: decl.baseExpr,
      baseArgs: decl.baseArgs,
      interfaces: decl.interfaces,
      fields: decl.fields,
      methods: decl.methods,
      constructors: decl.constructors,
      expression: decl.expression,
      decorators: decl.decorators,
      typeParams: decl.typeParams,
      source: decl.source,
    };
  }

  private readonly decoratedClass(
    decl: Own<ClassDecl>,
    decorators: Own<Decorator[]>,
  ): ClassDecl {
    const all = decorators.concat(decl.decorators);
    const kept: Decorator[] = [];
    let isMarked = decl.isInPlace;
    let next = all.pop();

    while (next != undefined) {
      if (this.isInPlaceMark(next.expr)) {
        isMarked = true;
      } else {
        kept.push(next);
      }

      next = all.pop();
    }

    kept.reverse();

    return {
      kind: StmtKind.Class,
      loc: decl.loc,
      name: decl.name,
      isAbstract: decl.isAbstract,
      isPartial: decl.isPartial,
      isInPlace: isMarked,
      base: decl.base,
      baseExpr: decl.baseExpr,
      baseArgs: decl.baseArgs,
      interfaces: decl.interfaces,
      fields: decl.fields,
      methods: decl.methods,
      constructors: decl.constructors,
      expression: decl.expression,
      decorators: kept,
      typeParams: decl.typeParams,
      source: decl.source,
    };
  }

  private readonly withBody(
    fn: Own<FunctionDecl>,
    body: Own<BlockStmt>,
    bodySource: BodySource,
  ): FunctionDecl {
    return {
      kind: StmtKind.Function,
      unsafe: fn.unsafe,
      loc: fn.loc,
      name: fn.name,
      typeParams: fn.typeParams,
      params: fn.params,
      returnType: fn.returnType,
      body,
      source: fn.source,
      isArrow: fn.isArrow,
      concise: fn.concise,
      ownName: fn.ownName,
      place: fn.place,
      bodySource,
      isGenerator: fn.isGenerator,
      isAsync: fn.isAsync,
      role: fn.role,
    };
  }

  private readonly classNameAhead(): boolean {
    const next = this.cursor.lookahead();

    return kTokenTable.isName(next.kind);
  }

  private classDecl(expression: boolean): ClassDeclDraft {
    const keyword = this.cursor.next();
    const word = this.classNameWord();
    const named = word ?? keyword;
    const typeParams = this.optionalTypeParams();
    const extended = this.classBase(expression);
    const interfaces = this.implementedTypes();
    const declaration: ClassDeclDraft = {
      kind: StmtKind.Class,
      loc: named.start,
      name: word?.text,
      isAbstract: false,
      isPartial: false,
      isInPlace: false,
      base: extended.base,
      baseExpr: extended.baseExpr,
      baseArgs: extended.baseArgs,
      interfaces,
      fields: [],
      methods: [],
      constructors: [],
      expression,
      decorators: [],
      typeParams,
    };

    if (!this.cursor.expect(TokenKind.LBrace, Code.ExpectedClassMembersStart)) {
      return declaration;
    }

    while (this.cursor.insideList(TokenKind.RBrace)) {
      this.classMember(declaration);
      if (this.cursor.isRecovering()) {
        this.skipClassMember();
        this.cursor.stopRecovering();
      }
    }

    this.cursor.expect(TokenKind.RBrace, Code.ExpectedClassClose);
    declaration.source = this.cursor.spanFrom(keyword.start);

    return declaration;
  }

  private classBase(expression: boolean): ClassBase {
    if (!this.cursor.accept(TokenKind.Extends)) {
      return { baseArgs: [] };
    }

    if (this.valueBaseAhead()) {
      const baseExpr = this.callOrMember();
      const baseArgs = this.baseTypeArguments();

      return { baseExpr, baseArgs };
    }

    const word = this.cursor.peek();
    const base = this.primaryType();
    if (!expression || base.form.kind != TypeRefKind.Name) {
      return { base, baseArgs: [] };
    }

    const baseExpr: Expr = {
      kind: ExprKind.Name,
      loc: word.start,
      name: word.text,
      known: word.known,
      typeArgs: [],
    };

    return { base, baseExpr, baseArgs: [] };
  }

  private baseTypeArguments(): TypeRef[] {
    if (!this.cursor.is(TokenKind.Less)) {
      return [];
    }

    return this.typeArguments();
  }

  private valueBaseAhead(): boolean {
    if (!this.cursor.atName()) {
      return true;
    }

    const next = this.cursor.lookahead();

    switch (next.kind) {
      case TokenKind.LParen:
      case TokenKind.Dot:
      case TokenKind.LBracket:
        return true;
      case TokenKind.Less:
        return this.genericCallAhead();
      default:
        return false;
    }
  }

  private genericCallAhead(): boolean {
    const start = this.cursor.mark();

    this.cursor.next();
    const typeArguments = this.tryTypeArguments(true);

    this.cursor.reset(start);

    return typeArguments != undefined;
  }

  private implementedTypes(): TypeRef[] {
    const interfaces: TypeRef[] = [];

    if (!this.cursor.accept(TokenKind.Implements)) {
      return interfaces;
    }

    do {
      const implemented = this.primaryType();

      interfaces.push(implemented);
    } while (this.cursor.accept(TokenKind.Comma));

    return interfaces;
  }

  private skipClassMember(): void {
    if (this.cursor.statementEnded()) {
      return;
    }

    while (
      !this.cursor.is(TokenKind.End) &&
      !this.cursor.is(TokenKind.RBrace)
    ) {
      if (this.cursor.accept(TokenKind.Semi)) {
        return;
      }
      if (this.cursor.accept(TokenKind.LBrace)) {
        this.cursor.skipToClosingBrace();
      } else {
        this.cursor.next();
      }

      const token = this.cursor.peek();
      if (token.newline) {
        return;
      }
    }
  }

  private decorators(): Decorator[] {
    const decorators: Decorator[] = [];

    while (this.cursor.is(TokenKind.At)) {
      const at = this.cursor.next();
      const loc = at.start;
      const expr = this.decoratorExpr();
      if (expr != undefined && this.isUnsafeDecorator(expr)) {
        this.unsafeMark = { loc, options: this.unsafeOptions(expr) };
      } else if (expr != undefined) {
        decorators.push({ loc, expr });
      }
      if (this.cursor.isRecovering()) {
        break;
      }
    }

    return decorators;
  }

  private decoratorExpr(): Expr | undefined {
    if (this.cursor.accept(TokenKind.LParen)) {
      const inner = this.sequence();

      this.cursor.expect(TokenKind.RParen, Code.ExpectedDecoratorClose);

      return inner;
    }
    if (!this.cursor.atName()) {
      const token = this.cursor.peek();

      this.cursor.error(token.start, Code.ExpectedDecoratorName, {
        found: token.kind,
      });

      return undefined;
    }

    const head = this.cursor.next();
    let expr: Expr = {
      kind: ExprKind.Name,
      loc: head.start,
      name: head.text,
      known: head.known,
      typeArgs: [],
    };

    while (this.cursor.is(TokenKind.Dot)) {
      if (!this.dotAhead()) {
        this.brokenDot();

        return expr;
      }

      expr = this.dotLink(expr);
    }

    if (this.cursor.is(TokenKind.LParen)) {
      return this.callLink(expr, false);
    }

    return expr;
  }

  private readonly isInPlaceMark(expr: Read<Expr>): boolean {
    if (expr.kind != ExprKind.Call || expr.args.length > 0) {
      return false;
    }

    const callee = expr.callee;

    return callee.kind == ExprKind.Name && callee.name == kInPlaceDecorator;
  }

  private readonly isUnsafeDecorator(expr: Expr): boolean {
    if (expr.kind != ExprKind.Call) {
      return false;
    }

    const callee = expr.callee;

    return callee.kind == ExprKind.Name && callee.name == kUnsafeDecorator;
  }

  private readonly unsafeOptions(expr: Read<Expr>): Expr | undefined {
    if (expr.kind != ExprKind.Call) {
      return undefined;
    }

    const first = expr.args[0];
    if (first == undefined) {
      return undefined;
    }

    return this.copyExpr(first.expr);
  }

  private rejectDecorators(decorators: Read<Decorator[]>): void {
    const first = decorators[0];
    if (first != undefined) {
      this.cursor.report(first.loc, Code.DecoratorTarget);
    }
  }

  private classField(
    declaration: ClassDeclDraft,
    modifiers: Read<Modifiers>,
    decorators: Own<Decorator[]>,
    loc: int,
    member: MemberName,
  ): void {
    if (modifiers.isAbstract) {
      this.cursor.report(loc, Code.AbstractFields);
    }

    const presence = this.fieldPresence();
    const type = this.typeAnnotation();
    const init = this.initializer();
    const after = this.cursor.peek();
    const ended =
      this.cursor.accept(TokenKind.Semi) ||
      this.cursor.accept(TokenKind.Comma) ||
      after.kind == TokenKind.RBrace ||
      after.newline;
    if (!ended) {
      return this.cursor.error(after.start, Code.ExpectedSemicolonAfterField, {
        found: after.kind,
      });
    }

    declaration.fields.push({
      name: member.name,
      loc: member.loc,
      type,
      init,
      form: this.fieldKind(modifiers),
      presence,
      readonly: modifiers.readonly,
      isOverride: modifiers.isOverride,
      access: modifiers.access,
      decorators,
      accessor: modifiers.accessor,
    });
  }

  private fieldPresence(): FieldPresence {
    const suffix = this.cursor.peek();

    if (this.cursor.accept(TokenKind.Question)) {
      return FieldPresence.Optional;
    }
    if (suffix.kind == TokenKind.Bang && !suffix.newline) {
      this.cursor.next();

      return FieldPresence.Definite;
    }

    return FieldPresence.Required;
  }

  private readonly isConstructor(declaration: FunctionDecl): boolean {
    const role = declaration.role;

    return role != undefined && role.method == MethodKind.Constructor;
  }

  private classNameWord(): Token | undefined {
    if (!this.cursor.atName()) {
      return undefined;
    }

    return this.cursor.next();
  }

  private readonly methodDecorators(
    decorators: Own<Decorator[]>,
    constructor: boolean,
  ): Decorator[] {
    if (constructor) {
      return [];
    }

    return decorators;
  }

  private readonly fieldKind(modifiers: Read<Modifiers>): FieldKind {
    if (modifiers.isStatic) {
      return FieldKind.Static;
    }

    return FieldKind.Instance;
  }
}
