import { FileParser } from "../file-parser.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { Details } from "../../../../diagnostic/types/message.types.tz";
import {
  KnownName,
  Token,
  TokenKind,
} from "../../../token/types/token.types.tz";
import { kTokenTable } from "../../../token/const/token.const.tz";
import {
  TypeKind,
  TypeRef,
} from "../../../../program/ast/types/ast.types.types.tz";
import {
  Expr,
  ExprKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import {
  BlockStmt,
  Stmt,
  StmtKind,
} from "../../../../program/ast/types/ast.types.statements.tz";
import {
  FunctionDecl,
  FunctionPlace,
} from "../../../../program/ast/types/ast.types.functions.tz";
import {
  Access,
  ClassDecl,
  ClassField,
  ClassMember,
  Decorator,
  FieldKind,
  FieldPresence,
  MethodKind,
} from "../../../../program/ast/types/ast.types.classes.tz";
import {
  ClassBase,
  MemberName,
  Modifiers,
} from "../types/file-parser.types.classes.tz";
import { Arguments } from "../types/file-parser.types.calls.tz";
import { kThisName } from "../const/file-parser.const.classes.tz";

partial class FileParser {
  private classDecl(expression: boolean): ClassDecl {
    const keyword = this.cursor.next();
    const word = this.cursor.atName() ? this.cursor.next() : undefined;
    const typeParams = this.cursor.is(TokenKind.Less) ? this.typeParams() : [];
    const extended = this.classBase(expression);
    const interfaces = this.implementedTypes();
    const declaration: ClassDecl = {
      kind: StmtKind.Class,
      loc: word == undefined ? keyword.start : word.start,
      name: word?.text,
      isAbstract: false,
      isPartial: false,
      base: extended.base,
      baseExpr: extended.baseExpr,
      interfaces,
      fields: [],
      methods: [],
      constructors: [],
      expression,
      decorators: [],
      typeParams,
    };

    if (!this.cursor.expect(TokenKind.LBrace, Code.ExpectedClassMembersStart)) {
      return declaration;
    }

    while (this.cursor.insideList(TokenKind.RBrace)) {
      this.classMember(declaration);
      if (this.cursor.isRecovering()) {
        this.skipClassMember();
        this.cursor.stopRecovering();
      }
    }

    this.cursor.expect(TokenKind.RBrace, Code.ExpectedClassClose);
    declaration.source = this.cursor.spanFrom(keyword.start);

    return declaration;
  }

  private classBase(expression: boolean): ClassBase {
    if (!this.cursor.accept(TokenKind.Extends)) {
      return {};
    }

    const next = this.cursor.lookahead();
    const value =
      !this.cursor.atName() ||
      next.kind == TokenKind.LParen ||
      next.kind == TokenKind.Dot ||
      next.kind == TokenKind.LBracket;
    if (value) {
      const baseExpr = this.callOrMember();

      return { baseExpr };
    }

    const word = this.cursor.peek();
    const base = this.primaryType();
    if (!expression || base.form.kind != TypeKind.Name) {
      return { base };
    }

    const baseExpr: Expr = {
      kind: ExprKind.Name,
      loc: word.start,
      name: word.text,
      known: word.known,
      typeArgs: [],
    };

    return { base, baseExpr };
  }

  private implementedTypes(): TypeRef[] {
    const interfaces: TypeRef[] = [];
    if (!this.cursor.accept(TokenKind.Implements)) {
      return interfaces;
    }

    do {
      const implemented = this.primaryType();

      interfaces.push(implemented);
    } while (this.cursor.accept(TokenKind.Comma));

    return interfaces;
  }

  private memberModifierAhead(): boolean {
    const token = this.cursor.peek();
    if (!this.isMemberModifier(token.kind)) {
      return false;
    }

    const next = this.cursor.lookahead();
    if (next.newline && next.kind != TokenKind.LBrace) {
      return false;
    }

    return !this.endsModifiers(next.kind);
  }

  private skipClassMember(): void {
    while (
      !this.cursor.is(TokenKind.End) &&
      !this.cursor.is(TokenKind.RBrace)
    ) {
      if (this.cursor.accept(TokenKind.Semi)) {
        return;
      }
      if (this.cursor.accept(TokenKind.LBrace)) {
        this.cursor.skipToClosingBrace();
      } else {
        this.cursor.next();
      }

      const token = this.cursor.peek();
      if (token.newline) {
        return;
      }
    }
  }

  private decorators(): Decorator[] {
    const decorators: Decorator[] = [];

    while (this.cursor.is(TokenKind.At)) {
      const at = this.cursor.next();
      const loc = at.start;
      const expr = this.decoratorExpr();
      if (expr != undefined) {
        decorators.push({ loc, expr });
      }
      if (this.cursor.isRecovering()) {
        break;
      }
    }

    return decorators;
  }

  private decoratorExpr(): Expr | undefined {
    if (this.cursor.accept(TokenKind.LParen)) {
      const inner = this.sequence();

      this.cursor.expect(TokenKind.RParen, Code.ExpectedDecoratorClose);

      return inner;
    }
    if (!this.cursor.atName()) {
      const token = this.cursor.peek();

      this.cursor.error(
        token.start,
        Code.ExpectedDecoratorName,
        { found: token.kind },
      );

      return undefined;
    }

    const head = this.cursor.next();
    let expr: Expr = {
      kind: ExprKind.Name,
      loc: head.start,
      name: head.text,
      known: head.known,
      typeArgs: [],
    };

    while (this.cursor.accept(TokenKind.Dot)) {
      const token = this.cursor.peek();
      const property =
        token.kind == TokenKind.Identifier || kTokenTable.isKeyword(token.kind);
      if (!property) {
        this.cursor.error(token.start, Code.ExpectedPropertyAfterDot);

        return expr;
      }

      const name = this.cursor.next();

      expr = {
        kind: ExprKind.Member,
        loc: name.start,
        object: expr,
        name: name.text,
        known: name.known,
        optional: false,
        typeArgs: [],
      };
    }

    if (!this.cursor.accept(TokenKind.LParen)) {
      return expr;
    }

    const list: Arguments = this.arguments();

    return {
      kind: ExprKind.Call,
      loc: expr.loc,
      callee: expr,
      args: list.args,
      spread: list.spread,
      optional: false,
      tagged: false,
    };
  }

  private rejectDecorators(decorators: Decorator[]): void {
    const first = decorators[0];
    if (first != undefined) {
      this.cursor.report(first.loc, Code.DecoratorTarget);
    }
  }

  private modifiers(): Modifiers {
    const modifiers: Modifiers = {
      isStatic: false,
      readonly: false,
      isAbstract: false,
      isOverride: false,
      isAsync: false,
      accessor: false,
      access: Access.Public,
      staticBlock: false,
    };

    const seen: TokenKind[] = [];

    while (this.memberModifierAhead()) {
      const word = this.cursor.next();

      this.rememberModifier(seen, word);
      const access = this.accessOf(word.kind);
      if (access != undefined) {
        modifiers.access = access;

        continue;
      }

      switch (word.kind) {
        case TokenKind.Static:
          modifiers.isStatic = true;
          if (this.cursor.is(TokenKind.LBrace)) {
            this.cursor.report(word.start, Code.StaticBlocks);
            this.cursor.next();
            this.cursor.skipToClosingBrace();
            modifiers.staticBlock = true;

            return modifiers;
          }
          break;
        case TokenKind.Readonly:
          modifiers.readonly = true;
          break;
        case TokenKind.Override:
          modifiers.isOverride = true;
          break;
        case TokenKind.Abstract:
          modifiers.isAbstract = true;
          break;
        case TokenKind.Declare:
          this.cursor.report(word.start, Code.DeclareMemberNotSupported);
          break;
        case TokenKind.Accessor:
          modifiers.accessor = true;
          break;
        default:
          modifiers.isAsync = true;
          break;
      }
    }

    return modifiers;
  }

  private memberAccessorAhead(): boolean {
    const next = this.cursor.lookahead();

    return (
      (this.cursor.is(TokenKind.Get) || this.cursor.is(TokenKind.Set)) &&
      !next.newline &&
      (next.kind == TokenKind.Identifier ||
        kTokenTable.isKeyword(next.kind) ||
        next.kind == TokenKind.String)
    );
  }

  private classMember(declaration: ClassDecl): void {
    if (this.cursor.accept(TokenKind.Semi)) {
      return;
    }

    const decorators = this.decorators();

    if (this.cursor.isRecovering()) {
      return;
    }

    const head = this.cursor.peek();
    const loc = head.start;
    const modifiers = this.modifiers();
    if (modifiers.staticBlock) {
      return;
    }
    if (this.memberAccessorAhead()) {
      this.cursor.next();
      this.cursor.report(loc, Code.AccessorsNotSupported);

      return this.skipClassMember();
    }
    if (this.cursor.is(TokenKind.LBracket) && !this.cursor.symbolKeyAhead()) {
      this.cursor.report(loc, Code.MemberNameInBrackets);

      return this.skipClassMember();
    }

    const member = this.memberName(modifiers);
    if (member == undefined) {
      return;
    }
    if (this.cursor.is(TokenKind.LParen) || this.cursor.is(TokenKind.Less)) {
      return this.classMethod(declaration, modifiers, decorators, loc, member);
    }
    if (member.generator || modifiers.isAsync) {
      const token = this.cursor.peek();

      return this.cursor.error(token.start, Code.ExpectedParenAfterMethodName);
    }

    this.classField(declaration, modifiers, decorators, loc, member);
  }

  private memberName(modifiers: Modifiers): MemberName | undefined {
    const head = this.cursor.peek();
    const start = head.start;
    const generator = this.cursor.accept(TokenKind.Star);
    const token = this.cursor.peek();
    const name = this.fieldName();
    if (name == undefined) {
      return undefined;
    }
    if (token.hash) {
      this.cursor.report(token.start, Code.NoPrivateName, { word: name });
      modifiers.access = Access.Private;
    }

    return {
      loc: token.start,
      start,
      name,
      generator,
      constructorName: token.kind == TokenKind.Constructor,
    };
  }

  private classMethod(
    declaration: ClassDecl,
    modifiers: Modifiers,
    decorators: Decorator[],
    loc: int,
    member: MemberName,
  ): void {
    const constructor = member.constructorName && !modifiers.isStatic;
    const abstractMethod = modifiers.isAbstract && !constructor;

    if (modifiers.accessor) {
      this.cursor.report(loc, Code.AccessorBeforeMethod);
    }

    const first = decorators[0];
    if (first != undefined && constructor) {
      this.cursor.report(first.loc, Code.DecoratedConstructor);
    }

    const role: ClassMember = {
      access: modifiers.access,
      isOverride: modifiers.isOverride && !constructor,
      decorators: constructor ? [] : decorators,
      method: this.methodKind(modifiers, constructor),
    };

    this.reportMethodModifiers(modifiers, member.generator, constructor, loc);
    const method = this.method(
      member.loc,
      member.name,
      member.start,
      member.generator && !constructor,
      modifiers.isAsync && !constructor,
      FunctionPlace.Declared,
      role,
    );
    if (this.cursor.isRecovering()) {
      return;
    }
    if (abstractMethod) {
      return this.addAbstractMethod(declaration, method, member);
    }

    const body = method.body;
    if (body == undefined) {
      return this.cursor.report(member.loc, Code.MethodWithoutBody);
    }
    if (!this.isConstructor(method)) {
      declaration.methods.push(method);

      return;
    }

    this.addConstructor(declaration, method, body, member.loc);
  }

  private methodKind(modifiers: Modifiers, constructor: boolean): MethodKind {
    if (constructor) {
      return MethodKind.Constructor;
    }
    if (modifiers.isStatic) {
      return MethodKind.Static;
    }
    if (modifiers.isAbstract) {
      return MethodKind.Abstract;
    }

    return MethodKind.Instance;
  }

  private addAbstractMethod(
    declaration: ClassDecl,
    method: FunctionDecl,
    member: MemberName,
  ): void {
    if (method.body != undefined) {
      this.cursor.report(member.loc, Code.AbstractMethodBody, {
        word: member.name,
      });
    }

    method.body = { kind: StmtKind.Block, loc: member.loc, body: [] };
    declaration.methods.push(method);
  }

  private addConstructor(
    declaration: ClassDecl,
    method: FunctionDecl,
    body: BlockStmt,
    memberLoc: int,
  ): void {
    const returnType = method.returnType;
    if (returnType != undefined) {
      const loc = returnType.loc ?? memberLoc;

      this.cursor.report(loc, Code.ConstructorReturnType);
    }

    this.addParameterFields(declaration, method, body);
    declaration.constructors.push(method);
  }

  private reportMethodModifiers(
    modifiers: Modifiers,
    generator: boolean,
    constructor: boolean,
    loc: int,
  ): void {
    if (generator && constructor) {
      this.cursor.report(loc, Code.GeneratorConstructor);
    }
    if (modifiers.isAsync && constructor) {
      this.cursor.report(loc, Code.AsyncConstructor);
    }
    if (modifiers.readonly) {
      this.cursor.report(loc, Code.ReadonlyMethod);
    }
    if ((modifiers.isOverride || modifiers.isAbstract) && constructor) {
      this.cursor.report(loc, Code.OverrideConstructor);
    }
    if (modifiers.isAbstract && modifiers.isStatic) {
      this.cursor.report(loc, Code.AbstractStaticMethod);
    }
  }

  private hasParameterField(declaration: ClassDecl, name: string): boolean {
    for (const field of declaration.fields) {
      if (field.form == FieldKind.Parameter && field.name == name) {
        return true;
      }
    }

    return false;
  }

  private superCallEnd(body: BlockStmt): int {
    for (let i = 0; i < body.body.length; i++) {
      const stmt = body.body[i];
      if (stmt == undefined || stmt.kind != StmtKind.Expr) {
        continue;
      }

      const call = stmt.expr;
      if (call.kind != ExprKind.Call) {
        continue;
      }

      const callee = call.callee;
      if (callee.kind == ExprKind.Name && callee.known == KnownName.Super) {
        return i + 1;
      }
    }

    return 0;
  }

  private addParameterFields(
    declaration: ClassDecl,
    constructorDecl: FunctionDecl,
    body: BlockStmt,
  ): void {
    const sets: Stmt[] = [];
    let properties = 0;

    for (const field of declaration.fields) {
      if (field.form == FieldKind.Parameter) {
        properties += 1;
      }
    }

    for (const param of constructorDecl.params) {
      const property = param.property;
      if (property == undefined) {
        continue;
      }

      this.fieldNames.add(param.name);
      if (!this.hasParameterField(declaration, param.name)) {
        const field: ClassField = {
          name: param.name,
          loc: param.loc,
          type: param.type,
          form: FieldKind.Parameter,
          presence: FieldPresence.Required,
          readonly: property.readonly,
          isOverride: false,
          access: property.access,
          decorators: [],
          accessor: false,
        };

        declaration.fields.splice(properties, 0, field);
        properties += 1;
      }

      const self: Expr = {
        kind: ExprKind.Name,
        loc: param.loc,
        name: kThisName,
        known: KnownName.None,
        typeArgs: [],
      };
      const target: Expr = {
        kind: ExprKind.Member,
        loc: param.loc,
        object: self,
        name: param.name,
        known: KnownName.None,
        optional: false,
        typeArgs: [],
      };
      const value: Expr = {
        kind: ExprKind.Name,
        loc: param.loc,
        name: param.name,
        known: KnownName.None,
        typeArgs: [],
      };
      const set: Expr = {
        kind: ExprKind.Assign,
        loc: param.loc,
        target,
        value,
      };

      sets.push({ kind: StmtKind.Expr, loc: param.loc, expr: set });
    }

    const at = declaration.base != undefined ? this.superCallEnd(body) : 0;
    const before = body.body.slice(0, at);
    const after = body.body.slice(at);

    body.body = before.concat(sets).concat(after);
  }

  private classField(
    declaration: ClassDecl,
    modifiers: Modifiers,
    decorators: Decorator[],
    loc: int,
    member: MemberName,
  ): void {
    if (modifiers.isAbstract) {
      this.cursor.report(loc, Code.AbstractFields);
    }

    let presence = FieldPresence.Required;
    const suffix = this.cursor.peek();

    if (this.cursor.accept(TokenKind.Question)) {
      presence = FieldPresence.Optional;
    } else if (suffix.kind == TokenKind.Bang && !suffix.newline) {
      this.cursor.next();
      presence = FieldPresence.Definite;
    }

    const type = this.cursor.accept(TokenKind.Colon) ? this.type() : undefined;
    const init = this.cursor.accept(TokenKind.Assign)
      ? this.expression()
      : undefined;
    const after = this.cursor.peek();
    const ended =
      this.cursor.accept(TokenKind.Semi) ||
      this.cursor.accept(TokenKind.Comma) ||
      after.kind == TokenKind.RBrace ||
      after.newline;
    if (!ended) {
      return this.cursor.error(
        after.start,
        Code.ExpectedSemicolonAfterField,
        { found: after.kind },
      );
    }

    declaration.fields.push({
      name: member.name,
      loc: member.loc,
      type,
      init,
      form: modifiers.isStatic ? FieldKind.Static : FieldKind.Instance,
      presence,
      readonly: modifiers.readonly,
      isOverride: modifiers.isOverride,
      access: modifiers.access,
      decorators,
      accessor: modifiers.accessor,
    });
  }

  private rememberModifier(seen: TokenKind[], word: Token): void {
    const details: Details = { word: word.text };
    const repeated = seen.includes(word.kind);
    const secondAccess =
      this.accessOf(word.kind) != undefined && this.accessGiven(seen);

    if (repeated) {
      this.cursor.report(word.start, Code.ModifierRepeated, details);
    } else if (secondAccess) {
      this.cursor.report(word.start, Code.AccessAlreadyGiven, details);
    }

    seen.push(word.kind);
  }

  private accessGiven(seen: TokenKind[]): boolean {
    for (const kind of seen) {
      if (this.accessOf(kind) != undefined) {
        return true;
      }
    }

    return false;
  }

  private accessOf(kind: TokenKind): Access | undefined {
    switch (kind) {
      case TokenKind.Public:
        return Access.Public;
      case TokenKind.Private:
        return Access.Private;
      case TokenKind.Protected:
        return Access.Protected;
      default:
        return undefined;
    }
  }

  private isMemberModifier(kind: TokenKind): boolean {
    switch (kind) {
      case TokenKind.Public:
      case TokenKind.Private:
      case TokenKind.Protected:
      case TokenKind.Readonly:
      case TokenKind.Static:
      case TokenKind.Override:
      case TokenKind.Abstract:
      case TokenKind.Declare:
      case TokenKind.Accessor:
      case TokenKind.Async:
        return true;
      default:
        return false;
    }
  }

  private endsModifiers(kind: TokenKind): boolean {
    switch (kind) {
      case TokenKind.LParen:
      case TokenKind.Colon:
      case TokenKind.Assign:
      case TokenKind.Semi:
      case TokenKind.Question:
      case TokenKind.Bang:
      case TokenKind.Less:
      case TokenKind.RBrace:
      case TokenKind.End:
        return true;
      default:
        return false;
    }
  }

  private isConstructor(declaration: FunctionDecl): boolean {
    const role = declaration.role;

    return role != undefined && role.method == MethodKind.Constructor;
  }
}
