import { FileParser } from "../file-parser.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { Details } from "../../../../diagnostic/types/message.types.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import { Token, TokenKind, isKeyword, isName } from "../../../../token.tz";
import {
  BindingForm,
  BindingKind,
  BlockStmt,
  Expr,
  ExprKind,
  NameOrigin,
  Stmt,
  StmtKind,
  SwitchCase,
  VarDeclStmt,
  VarDeclarator,
  marker,
} from "../../../../ast.tz";
import { ExpressionPlace } from "../types/file-parser.types.context.tz";
import { Pattern } from "../types/file-parser.types.patterns.tz";
import {
  Binding,
  ForTarget,
  ForTargetKind,
} from "../types/file-parser.types.statements.tz";

partial class FileParser {
  private statement(topLevel: boolean): Stmt {
    const token = this.cursor.peek();
    const loc = token.start;
    const next = this.cursor.lookahead();
    if (isName(token.kind) && next.kind == TokenKind.Colon) {
      this.cursor.skip(2);
      const body = this.statement(false);
      return { kind: StmtKind.Labeled, loc, label: token.text, body };
    }
    switch (token.kind) {
      case TokenKind.At:
        return this.decoratedStatement(topLevel);
      case TokenKind.LBrace:
        return this.block();
      case TokenKind.Function:
        return this.functionDeclaration(false);
      case TokenKind.Var:
      case TokenKind.Let:
      case TokenKind.Const:
        return this.variableStatement(token);
      case TokenKind.If:
        return this.ifStatement();
      case TokenKind.While:
        return this.whileStatement();
      case TokenKind.Do:
        return this.doWhileStatement();
      case TokenKind.For:
        return this.forStatement();
      case TokenKind.Switch:
        return this.switchStatement();
      case TokenKind.Enum:
        return this.enumDecl();
      case TokenKind.Return:
        return this.returnStatement();
      case TokenKind.Break:
      case TokenKind.Continue:
        return this.jumpStatement(token);
      case TokenKind.Debugger:
        this.cursor.next();
        this.cursor.expectSemicolon();
        return marker(StmtKind.Debugger, loc);
      case TokenKind.Semi:
        this.cursor.next();
        return marker(StmtKind.Empty, loc);
      case TokenKind.Import:
        return this.importStatement(loc, topLevel);
      case TokenKind.Export:
        return this.exportDecl(topLevel);
      case TokenKind.Class:
        return this.classStatement(loc);
      case TokenKind.Namespace:
      case TokenKind.Module:
        return this.groupingStatement(token);
      case TokenKind.Declare:
        return this.declareStatement(loc);
      case TokenKind.Type:
        return this.typeStatement(loc);
      case TokenKind.Interface:
        return this.interfaceStatement(loc);
      case TokenKind.Abstract:
        return this.abstractStatement(loc);
      case TokenKind.Async:
        return this.asyncStatement(loc);
      case TokenKind.Using:
        return this.usingStatement(loc);
      case TokenKind.Throw:
        return this.throwStatement();
      case TokenKind.Try:
        return this.tryStatement(loc);
      case TokenKind.Catch:
      case TokenKind.Finally:
        return this.handlerStatement(token);
      case TokenKind.Partial:
        return this.partialStatement(loc, topLevel);
      default:
        return this.expressionStatement(loc);
    }
  }

  private decoratedStatement(topLevel: boolean): Stmt {
    const decorators = this.decorators();
    const stmt = this.statement(topLevel);
    if (stmt.kind == StmtKind.Class) {
      stmt.decorators = decorators.concat(stmt.decorators);
    } else {
      this.rejectDecorators(decorators);
    }

    return stmt;
  }

  private variableStatement(token: Token): Stmt {
    if (token.kind == TokenKind.Var) {
      this.cursor.report(token.start, Code.VarNotSupported);
    }
    const next = this.cursor.lookahead();
    if (token.kind == TokenKind.Const && next.kind == TokenKind.Enum) {
      this.cursor.next();
      return this.enumDecl();
    }
    const decl = this.varDecl();
    this.cursor.expectSemicolon();

    return decl;
  }

  private importStatement(loc: int, topLevel: boolean): Stmt {
    const next = this.cursor.lookahead();
    if (next.kind == TokenKind.LParen || next.kind == TokenKind.Dot) {
      return this.expressionStatement(loc);
    }

    return this.importDecl(topLevel);
  }

  private nameOnLine(): boolean {
    const next = this.cursor.lookahead();

    return isName(next.kind) && !next.newline;
  }

  private groupingAhead(): boolean {
    const next = this.cursor.lookahead();
    const named =
      isName(next.kind) ||
      isKeyword(next.kind) ||
      next.kind == TokenKind.String;

    return named && !next.newline;
  }

  private classStatement(loc: int): Stmt {
    if (this.nameOnLine()) {
      return this.classDecl(false);
    }

    return this.expressionStatement(loc);
  }

  private groupingStatement(token: Token): Stmt {
    if (this.groupingAhead()) {
      return this.skipDeclaration(token.start, Code.GroupingNotSupported, {
        word: token.text,
      });
    }

    return this.expressionStatement(token.start);
  }

  private declareStatement(loc: int): Stmt {
    if (this.groupingAhead()) {
      return this.declare(loc);
    }

    return this.expressionStatement(loc);
  }

  private typeStatement(loc: int): Stmt {
    if (this.nameOnLine()) {
      return this.typeAlias();
    }

    return this.expressionStatement(loc);
  }

  private interfaceStatement(loc: int): Stmt {
    if (this.nameOnLine()) {
      return this.interfaceDecl();
    }

    return this.expressionStatement(loc);
  }

  private abstractStatement(loc: int): Stmt {
    const next = this.cursor.lookahead();
    if (next.kind != TokenKind.Class || next.newline) {
      return this.expressionStatement(loc);
    }
    this.cursor.next();
    const cls = this.classDecl(false);
    cls.isAbstract = true;

    return cls;
  }

  private asyncStatement(loc: int): Stmt {
    if (!this.asyncFunctionAhead()) {
      return this.expressionStatement(loc);
    }
    this.cursor.next();

    return this.functionDeclaration(true);
  }

  private usingStatement(loc: int): Stmt {
    if (this.nameOnLine()) {
      return this.usingDecl();
    }

    return this.expressionStatement(loc);
  }

  private tryStatement(loc: int): Stmt {
    const next = this.cursor.lookahead();
    if (next.kind == TokenKind.LBrace) {
      return this.strayTry();
    }

    return this.expressionStatement(loc);
  }

  private handlerStatement(token: Token): Stmt {
    const next = this.cursor.lookahead();
    if (next.kind == TokenKind.LBrace || next.kind == TokenKind.LParen) {
      return this.strayHandler(token);
    }

    return this.expressionStatement(token.start);
  }

  private partialStatement(loc: int, topLevel: boolean): Stmt {
    const next = this.cursor.lookahead();
    if (next.kind == TokenKind.Class && !next.newline) {
      return this.partialClass(loc, topLevel);
    }

    return this.expressionStatement(loc);
  }

  private partialClass(loc: int, topLevel: boolean): Stmt {
    if (!topLevel) {
      this.cursor.report(loc, Code.PartialClassNotTopLevel);
    }
    this.cursor.next();
    const cls = this.classDecl(false);
    cls.isPartial = true;

    return cls;
  }

  private strayHandler(keyword: Token): Stmt {
    const loc = keyword.start;
    const code =
      keyword.kind == TokenKind.Catch ? Code.NoCatch : Code.NoFinally;
    this.cursor.report(loc, code);
    this.cursor.next();
    if (this.cursor.accept(TokenKind.LParen)) {
      this.cursor.skipTo(TokenKind.RParen);
      this.cursor.accept(TokenKind.RParen);
    }
    this.block();

    return marker(StmtKind.Empty, loc);
  }

  private declare(loc: int): Stmt {
    const next = this.cursor.lookahead();
    if (next.kind == TokenKind.Function) {
      this.cursor.next();
      return this.declaredFunction();
    }
    if (!this.library && next.kind == TokenKind.Class) {
      this.cursor.next();
      return this.handleClass();
    }
    if (
      next.kind == TokenKind.Module ||
      next.kind == TokenKind.Namespace ||
      next.kind == TokenKind.Global
    ) {
      return this.skipDeclaration(loc, Code.DeclareWordNotSupported, {
        word: next.text,
      });
    }

    return this.skipDeclaration(loc, Code.DeclareNotSupported);
  }

  private expressionStatement(loc: int): Stmt {
    const expr = this.sequence();
    if (expr.kind == ExprKind.Assign && expr.op == undefined) {
      const target = expr.target;
      if (
        target.kind == ExprKind.ArrayLit ||
        target.kind == ExprKind.ObjectLit
      ) {
        const pattern = this.patternFromLiteral(target);
        const stmt = this.assignPattern(loc, pattern, expr.value);
        this.cursor.expectSemicolon();
        return stmt;
      }
    }
    this.cursor.expectSemicolon();

    return { kind: StmtKind.Expr, loc, expr };
  }

  private skipDeclaration(
    loc: int,
    code: Code,
    details: Details = kNoDetails,
  ): Stmt {
    this.cursor.report(loc, code, details);
    this.cursor.next();
    while (
      !this.cursor.is(TokenKind.End) &&
      !this.cursor.is(TokenKind.RBrace)
    ) {
      if (this.cursor.accept(TokenKind.LBrace)) {
        this.cursor.skipToClosingBrace();
        break;
      }
      if (this.cursor.accept(TokenKind.Semi)) {
        break;
      }
      this.cursor.next();
      const current = this.cursor.peek();
      if (current.newline) {
        break;
      }
    }

    return marker(StmtKind.Empty, loc);
  }

  private jumpStatement(token: Token): Stmt {
    this.cursor.next();
    let label = "";
    const target = this.cursor.peek();
    if (isName(target.kind) && !target.newline) {
      this.cursor.next();
      label = target.text;
    }
    this.cursor.expectSemicolon();
    const kind =
      token.kind == TokenKind.Break ? StmtKind.Break : StmtKind.Continue;

    return { kind, loc: token.start, label };
  }

  private switchStatement(): Stmt {
    const keyword = this.cursor.next();
    const loc = keyword.start;
    this.cursor.expect(TokenKind.LParen, Code.ExpectedAfterSwitch);
    const discriminant = this.sequence();
    this.cursor.expect(TokenKind.RParen, Code.ExpectedAfterSwitchValue);
    this.cursor.expect(TokenKind.LBrace, Code.ExpectedSwitchCasesStart);
    const cases: SwitchCase[] = [];
    let hasDefault = false;
    while (
      this.cursor.is(TokenKind.Case) ||
      this.cursor.is(TokenKind.Default)
    ) {
      const clause = this.cursor.peek();
      const caseLoc = clause.start;
      let test: Expr | undefined = undefined;
      if (this.cursor.accept(TokenKind.Case)) {
        test = this.expression();
      } else {
        if (hasDefault) {
          this.cursor.report(caseLoc, Code.OneDefaultInSwitch);
        }
        hasDefault = true;
        this.cursor.next();
      }
      const afterLabel =
        test != undefined
          ? Code.ExpectedAfterCaseValue
          : Code.ExpectedAfterDefault;
      this.cursor.expect(TokenKind.Colon, afterLabel);
      const body = this.caseBody();
      cases.push({ loc: caseLoc, test, body });
    }
    if (!this.cursor.is(TokenKind.RBrace) && !this.cursor.is(TokenKind.End)) {
      const token = this.cursor.peek();
      this.cursor.error(token.start, Code.ExpectedCaseOrDefault);
    }
    this.cursor.expect(TokenKind.RBrace, Code.ExpectedSwitchClose);

    return { kind: StmtKind.Switch, loc, discriminant, cases };
  }

  private statementWithRecovery(topLevel: boolean): Stmt {
    const first = this.cursor.peek();
    const statement = this.statement(topLevel);
    if (this.cursor.isRecovering()) {
      this.cursor.recoverStatement(first.start);
    }

    return statement;
  }

  private caseBody(): Stmt[] {
    const body: Stmt[] = [];
    while (
      !this.cursor.is(TokenKind.Case) &&
      !this.cursor.is(TokenKind.Default) &&
      !this.cursor.is(TokenKind.RBrace) &&
      !this.cursor.is(TokenKind.End)
    ) {
      const statement = this.statementWithRecovery(false);
      body.push(statement);
    }

    return body;
  }

  private block(): BlockStmt {
    const brace = this.cursor.peek();
    const loc = brace.start;
    this.cursor.expect(TokenKind.LBrace, Code.ExpectedBlockStart);
    const body: Stmt[] = [];
    while (
      !this.cursor.is(TokenKind.RBrace) &&
      !this.cursor.is(TokenKind.End)
    ) {
      const statement = this.statementWithRecovery(false);
      body.push(statement);
    }
    const closing = this.cursor.peek();
    const end = closing.start;
    this.cursor.expect(TokenKind.RBrace, Code.ExpectedBlockClose);

    return { kind: StmtKind.Block, loc, body, end };
  }

  private condition(code: Code): Expr {
    this.cursor.expect(TokenKind.LParen, code);
    const cond = this.sequence();
    this.cursor.expect(TokenKind.RParen, Code.ExpectedAfterCondition);

    return cond;
  }

  private ifStatement(): Stmt {
    const keyword = this.cursor.next();
    const loc = keyword.start;
    const cond = this.condition(Code.ExpectedAfterIf);
    const thenStmt = this.statement(false);
    const elseStmt = this.cursor.accept(TokenKind.Else)
      ? this.statement(false)
      : undefined;

    return { kind: StmtKind.If, loc, cond, thenStmt, elseStmt };
  }

  private whileStatement(): Stmt {
    const keyword = this.cursor.next();
    const loc = keyword.start;
    const cond = this.condition(Code.ExpectedAfterWhile);
    const body = this.statement(false);

    return { kind: StmtKind.While, loc, cond, body };
  }

  private doWhileStatement(): Stmt {
    const keyword = this.cursor.next();
    const loc = keyword.start;
    const body = this.statement(false);
    this.cursor.expect(TokenKind.While, Code.ExpectedAfterDoBody);
    const cond = this.condition(Code.ExpectedAfterWhile);
    this.cursor.accept(TokenKind.Semi);

    return { kind: StmtKind.DoWhile, loc, body, cond };
  }

  private forStatement(): Stmt {
    const outer = this.context;
    this.context = { ...outer, expressionPlace: ExpressionPlace.ForHead };
    const loop = this.forInside();
    this.context = outer;

    return loop;
  }

  private forInside(): Stmt {
    const keyword = this.cursor.next();
    const loc = keyword.start;
    let awaitLoc: int | undefined = undefined;
    if (this.cursor.is(TokenKind.Await)) {
      const awaitKeyword = this.cursor.next();
      awaitLoc = awaitKeyword.start;
    }
    this.cursor.expect(TokenKind.LParen, Code.ExpectedAfterFor);
    let init: Stmt | undefined = undefined;
    if (
      this.cursor.is(TokenKind.Let) ||
      this.cursor.is(TokenKind.Const) ||
      this.cursor.is(TokenKind.Var)
    ) {
      const head = this.cursor.next();
      if (head.kind == TokenKind.Var) {
        this.cursor.error(head.start, Code.VarNotSupported);
      }
      const isConst = head.kind == TokenKind.Const;
      const target = this.forTarget();
      if (target == undefined) {
        return { kind: StmtKind.For, loc };
      }
      const forIn = this.cursor.is(TokenKind.In);
      if (this.cursor.is(TokenKind.Of) || forIn) {
        return this.forOf(loc, awaitLoc, isConst, forIn, target);
      }
      const decls: VarDeclarator[] = [];
      if (target.kind == ForTargetKind.Pattern) {
        if (
          !this.cursor.expect(TokenKind.Assign, Code.ExpectedAfterForPattern)
        ) {
          return { kind: StmtKind.For, loc };
        }
        const value = this.expression();
        this.declarePattern(decls, target.pattern, value, undefined);
      } else {
        const value = this.cursor.accept(TokenKind.Assign)
          ? this.expression()
          : undefined;
        decls.push({
          ...target.binding,
          origin: NameOrigin.Written,
          init: value,
          form: { kind: BindingKind.Plain },
        });
      }
      if (this.cursor.accept(TokenKind.Comma)) {
        this.declarators(decls, isConst);
      }
      init = {
        kind: StmtKind.VarDecl,
        loc: head.start,
        isConst,
        isUsing: false,
        decls,
      };
    } else if (!this.cursor.is(TokenKind.Semi)) {
      const head = this.cursor.peek();
      const initLoc = head.start;
      const expr = this.sequence();
      init = { kind: StmtKind.Expr, loc: initLoc, expr };
    }
    if (this.cursor.is(TokenKind.In) || this.cursor.is(TokenKind.Of)) {
      const token = this.cursor.peek();
      this.cursor.error(token.start, Code.ForNeedsNewVariable);
      return { kind: StmtKind.For, loc, init };
    }
    this.context = { ...this.context, expressionPlace: ExpressionPlace.Plain };
    if (awaitLoc != undefined) {
      this.cursor.report(awaitLoc, Code.ForAwaitNeedsIterable);
    }

    return this.forRest(loc, init);
  }

  private forTarget(): ForTarget | undefined {
    if (
      this.cursor.is(TokenKind.LBracket) ||
      this.cursor.is(TokenKind.LBrace)
    ) {
      const pattern = this.bindingPattern();
      return { kind: ForTargetKind.Pattern, pattern };
    }
    const binding = this.binding();
    if (binding == undefined) {
      return undefined;
    }

    return { kind: ForTargetKind.Name, binding };
  }

  private forRest(loc: int, init: Stmt | undefined): Stmt {
    this.cursor.expect(TokenKind.Semi, Code.ExpectedAfterLoopInitializer);
    const cond = this.cursor.is(TokenKind.Semi) ? undefined : this.sequence();
    this.cursor.expect(TokenKind.Semi, Code.ExpectedAfterLoopCondition);
    const step = this.cursor.is(TokenKind.RParen) ? undefined : this.sequence();
    this.cursor.expect(TokenKind.RParen, Code.ExpectedLoopHeaderClose);
    const body = this.statement(false);

    return { kind: StmtKind.For, loc, init, cond, step, body };
  }

  private forOf(
    loc: int,
    awaitLoc: int | undefined,
    isConst: boolean,
    keys: boolean,
    target: ForTarget,
  ): Stmt {
    if (keys && target.kind == ForTargetKind.Pattern) {
      this.cursor.report(target.pattern.loc, Code.ForInKeyPattern);
    }
    this.cursor.next();
    this.context = { ...this.context, expressionPlace: ExpressionPlace.Plain };
    const isAwait = awaitLoc != undefined;
    if (keys && awaitLoc != undefined) {
      this.cursor.report(awaitLoc, Code.ForAwaitIn);
    }
    const iterable = this.expression();
    this.cursor.expect(TokenKind.RParen, Code.ExpectedLoopHeaderClose);
    const body = this.statement(false);
    if (target.kind == ForTargetKind.Name) {
      const binding: VarDeclarator = {
        ...target.binding,
        origin: NameOrigin.Written,
        form: { kind: BindingKind.Plain },
      };
      return {
        kind: StmtKind.ForOf,
        loc,
        isConst,
        keys,
        isAwait,
        binding,
        iterable,
        body,
      };
    }
    const pattern = target.pattern;
    const name = this.hiddenName();
    if (keys) {
      const binding: VarDeclarator = {
        name,
        origin: NameOrigin.Generated,
        loc: pattern.loc,
        form: { kind: BindingKind.Plain },
      };
      return {
        kind: StmtKind.ForOf,
        loc,
        isConst,
        keys,
        isAwait,
        binding,
        iterable,
        body,
      };
    }
    const form: BindingForm = pattern.object
      ? { kind: BindingKind.Object }
      : { kind: BindingKind.Array, length: 0, rest: false };
    const binding: VarDeclarator = {
      name,
      origin: NameOrigin.Generated,
      loc: pattern.loc,
      form,
    };
    const decls: VarDeclarator[] = [];
    this.declareElements(decls, pattern, name);
    const elements: VarDeclStmt = {
      kind: StmtKind.VarDecl,
      loc: pattern.loc,
      isConst,
      isUsing: false,
      decls,
    };
    const wrapper: Stmt = {
      kind: StmtKind.Block,
      loc: body.loc,
      body: [elements, body],
    };

    return {
      kind: StmtKind.ForOf,
      loc,
      isConst,
      keys,
      isAwait,
      binding,
      iterable,
      body: wrapper,
    };
  }

  private returnStatement(): Stmt {
    const keyword = this.cursor.next();
    const loc = keyword.start;
    const token = this.cursor.peek();
    const hasValue =
      token.kind != TokenKind.Semi &&
      token.kind != TokenKind.RBrace &&
      token.kind != TokenKind.End &&
      !token.newline;
    const value = hasValue ? this.sequence() : undefined;
    this.cursor.expectSemicolon();

    return { kind: StmtKind.Return, loc, value };
  }

  private throwStatement(): Stmt {
    const keyword = this.cursor.next();
    const loc = keyword.start;
    this.cursor.report(loc, Code.NoThrow);
    const token = this.cursor.peek();
    const hasValue =
      !token.newline &&
      token.kind != TokenKind.Semi &&
      token.kind != TokenKind.RBrace &&
      token.kind != TokenKind.End;
    if (hasValue) {
      this.sequence();
      this.cursor.expectSemicolon();
    }

    return marker(StmtKind.Empty, loc);
  }

  private strayTry(): Stmt {
    const token = this.cursor.peek();
    this.cursor.report(token.start, Code.NoTry);
    this.cursor.next();
    const block = this.block();
    if (this.cursor.is(TokenKind.Catch)) {
      this.cursor.next();
      if (this.cursor.accept(TokenKind.LParen)) {
        this.cursor.skipTo(TokenKind.RParen);
        this.cursor.expect(TokenKind.RParen, Code.ExpectedAfterCatchVariable);
      }
      this.block();
    }
    if (this.cursor.is(TokenKind.Finally)) {
      this.cursor.next();
      this.block();
    }

    return block;
  }

  private varDecl(): VarDeclStmt {
    const head = this.cursor.next();
    const isConst = head.kind == TokenKind.Const;
    const decls: VarDeclarator[] = [];
    this.declarators(decls, isConst);

    return {
      kind: StmtKind.VarDecl,
      loc: head.start,
      isConst,
      isUsing: false,
      decls,
    };
  }

  private usingDecl(): VarDeclStmt {
    const keyword = this.cursor.next();
    const loc = keyword.start;
    const decls: VarDeclarator[] = [];
    this.declarators(decls, true);
    this.cursor.expectSemicolon();

    return { kind: StmtKind.VarDecl, loc, isConst: true, isUsing: true, decls };
  }

  private declarators(decls: VarDeclarator[], isConst: boolean): void {
    do {
      const pattern =
        this.cursor.is(TokenKind.LBracket) || this.cursor.is(TokenKind.LBrace);
      const declared = pattern
        ? this.patternDeclarator(decls)
        : this.plainDeclarator(decls, isConst);
      if (!declared) {
        return;
      }
    } while (this.cursor.accept(TokenKind.Comma));
  }

  private patternDeclarator(decls: VarDeclarator[]): boolean {
    const pattern = this.bindingPattern();
    const typeAnn = this.cursor.accept(TokenKind.Colon)
      ? this.type()
      : undefined;
    if (!this.cursor.is(TokenKind.Assign)) {
      this.cursor.error(pattern.loc, Code.DestructuringNeedsValue);
      return false;
    }
    this.cursor.next();
    const value = this.expression();
    this.declarePattern(decls, pattern, value, typeAnn);

    return true;
  }

  private plainDeclarator(decls: VarDeclarator[], isConst: boolean): boolean {
    const binding = this.binding();
    if (binding == undefined) {
      return false;
    }
    const init = this.cursor.accept(TokenKind.Assign)
      ? this.expression()
      : undefined;
    decls.push({
      ...binding,
      origin: NameOrigin.Written,
      init,
      form: { kind: BindingKind.Plain },
    });
    if (init == undefined) {
      return true;
    }
    if (init.kind == ExprKind.Class && init.decl.name == undefined) {
      init.decl.name = binding.name;
    }
    if (isConst) {
      this.recordConstant(binding.name, init);
    }

    return true;
  }

  private recordConstant(name: string, init: Expr): void {
    let values: string[] = [];
    if (init.kind == ExprKind.StringLit) {
      values.push(init.value);
    } else if (init.kind == ExprKind.Template && init.exprs.length == 0) {
      values.push(init.quasis[0] ?? "");
    } else if (init.kind == ExprKind.Name) {
      const known = this.stringConstants.get(init.name);
      values = known != undefined ? known.slice() : [];
    }
    const all = this.stringConstants.get(name);
    if (all == undefined) {
      this.stringConstants.set(name, values);
      return;
    }
    for (const value of values) {
      all.push(value);
    }
  }

  private binding(): Binding | undefined {
    const token = this.cursor.peek();
    const reserved = !isName(token.kind) && isKeyword(token.kind);
    if (reserved) {
      this.cursor.report(token.start, Code.KeywordAsVariableName, {
        word: token.text,
      });
    } else if (!isName(token.kind)) {
      this.cursor.error(token.start, Code.ExpectedVariableName);
      return undefined;
    }
    this.cursor.next();
    const typeAnn = this.cursor.accept(TokenKind.Colon)
      ? this.type()
      : undefined;

    return { name: token.text, loc: token.start, typeAnn };
  }
}
