import { FileParser } from "../file-parser.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { Details } from "../../../../diagnostic/types/message.types.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import { Token, TokenKind } from "../../../token/types/token.types.tz";
import { kTokenTable } from "../../../token/const/token.const.tz";
import {
  Expr,
  ExprKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import {
  BlockStmt,
  Stmt,
  StmtKind,
  SwitchCase,
} from "../../../../program/ast/types/ast.types.statements.tz";

partial class FileParser {
  private statement(topLevel: boolean): Stmt {
    const token = this.cursor.peek();
    const loc = token.start;
    const next = this.cursor.lookahead();
    if (kTokenTable.isName(token.kind) && next.kind == TokenKind.Colon) {
      return this.labeledStatement();
    }

    switch (token.kind) {
      case TokenKind.At:
        return this.decoratedStatement(topLevel);
      case TokenKind.LBrace:
        return this.block();
      case TokenKind.Function:
        return this.functionDeclaration(false);
      case TokenKind.Var:
      case TokenKind.Let:
      case TokenKind.Const:
        return this.variableStatement(token);
      case TokenKind.If:
        return this.ifStatement();
      case TokenKind.While:
        return this.whileStatement();
      case TokenKind.Do:
        return this.doWhileStatement();
      case TokenKind.For:
        return this.forStatement();
      case TokenKind.Switch:
        return this.switchStatement();
      case TokenKind.Enum:
        return this.enumDecl();
      case TokenKind.Return:
        return this.returnStatement();
      case TokenKind.Break:
      case TokenKind.Continue:
        return this.jumpStatement();
      case TokenKind.Debugger:
        return this.debuggerStatement();
      case TokenKind.Semi:
        return this.emptyStatement();
      case TokenKind.Import:
        return this.importStatement(loc, topLevel);
      case TokenKind.Export:
        return this.exportDecl(topLevel);
      case TokenKind.Class:
        return this.classStatement(loc);
      case TokenKind.Namespace:
      case TokenKind.Module:
        return this.groupingStatement(token);
      case TokenKind.Declare:
        return this.declareStatement(loc);
      case TokenKind.Type:
        return this.typeStatement(loc);
      case TokenKind.Interface:
        return this.interfaceStatement(loc);
      case TokenKind.Abstract:
        return this.abstractStatement(loc);
      case TokenKind.Async:
        return this.asyncStatement(loc);
      case TokenKind.Using:
        return this.usingStatement(loc);
      case TokenKind.Throw:
        return this.throwStatement();
      case TokenKind.Try:
        return this.tryStatement(loc);
      case TokenKind.Catch:
      case TokenKind.Finally:
        return this.handlerStatement(token);
      case TokenKind.Partial:
        return this.partialStatement(loc, topLevel);
      default:
        return this.expressionStatement(loc);
    }
  }

  private labeledStatement(): Stmt {
    const label = this.cursor.next();

    this.cursor.next();
    const body = this.statement(false);

    return {
      kind: StmtKind.Labeled,
      loc: label.start,
      label: label.text,
      body,
    };
  }

  private debuggerStatement(): Stmt {
    const keyword = this.cursor.next();

    this.cursor.expectSemicolon();

    return this.marker(StmtKind.Debugger, keyword.start);
  }

  private emptyStatement(): Stmt {
    const semicolon = this.cursor.next();

    return this.marker(StmtKind.Empty, semicolon.start);
  }

  private decoratedStatement(topLevel: boolean): Stmt {
    const decorators = this.decorators();
    const stmt = this.statement(topLevel);
    if (stmt.kind == StmtKind.Class) {
      stmt.decorators = decorators.concat(stmt.decorators);
    } else {
      this.rejectDecorators(decorators);
    }

    return stmt;
  }

  private variableStatement(token: Token): Stmt {
    if (token.kind == TokenKind.Var) {
      this.cursor.report(token.start, Code.VarNotSupported);
    }

    const next = this.cursor.lookahead();
    if (token.kind == TokenKind.Const && next.kind == TokenKind.Enum) {
      this.cursor.next();

      return this.enumDecl();
    }

    const decl = this.varDecl();

    this.cursor.expectSemicolon();

    return decl;
  }

  private importStatement(loc: int, topLevel: boolean): Stmt {
    const next = this.cursor.lookahead();
    if (next.kind == TokenKind.LParen || next.kind == TokenKind.Dot) {
      return this.expressionStatement(loc);
    }

    return this.importDecl(topLevel);
  }

  private nameOnLine(): boolean {
    const next = this.cursor.lookahead();

    return kTokenTable.isName(next.kind) && !next.newline;
  }

  private groupingAhead(): boolean {
    const next = this.cursor.lookahead();
    const named =
      kTokenTable.isName(next.kind) ||
      kTokenTable.isKeyword(next.kind) ||
      next.kind == TokenKind.String;

    return named && !next.newline;
  }

  private classStatement(loc: int): Stmt {
    if (this.nameOnLine()) {
      return this.classDecl(false);
    }

    return this.expressionStatement(loc);
  }

  private groupingStatement(token: Token): Stmt {
    if (this.groupingAhead()) {
      return this.skipDeclaration(token.start, Code.GroupingNotSupported, {
        word: token.text,
      });
    }

    return this.expressionStatement(token.start);
  }

  private declareStatement(loc: int): Stmt {
    if (this.groupingAhead()) {
      return this.declare(loc);
    }

    return this.expressionStatement(loc);
  }

  private typeStatement(loc: int): Stmt {
    if (this.nameOnLine()) {
      return this.typeAlias();
    }

    return this.expressionStatement(loc);
  }

  private interfaceStatement(loc: int): Stmt {
    if (this.nameOnLine()) {
      return this.interfaceDecl();
    }

    return this.expressionStatement(loc);
  }

  private abstractStatement(loc: int): Stmt {
    const next = this.cursor.lookahead();
    if (next.kind != TokenKind.Class || next.newline) {
      return this.expressionStatement(loc);
    }

    this.cursor.next();
    const declaration = this.classDecl(false);

    declaration.isAbstract = true;

    return declaration;
  }

  private asyncStatement(loc: int): Stmt {
    if (!this.asyncFunctionAhead()) {
      return this.expressionStatement(loc);
    }

    this.cursor.next();

    return this.functionDeclaration(true);
  }

  private usingStatement(loc: int): Stmt {
    if (this.nameOnLine()) {
      return this.usingDecl();
    }

    return this.expressionStatement(loc);
  }

  private tryStatement(loc: int): Stmt {
    const next = this.cursor.lookahead();
    if (next.kind == TokenKind.LBrace) {
      return this.strayTry();
    }

    return this.expressionStatement(loc);
  }

  private handlerStatement(token: Token): Stmt {
    const next = this.cursor.lookahead();
    if (next.kind == TokenKind.LBrace || next.kind == TokenKind.LParen) {
      return this.strayHandler(token);
    }

    return this.expressionStatement(token.start);
  }

  private partialStatement(loc: int, topLevel: boolean): Stmt {
    const next = this.cursor.lookahead();
    if (next.kind == TokenKind.Class && !next.newline) {
      return this.partialClass(loc, topLevel);
    }

    return this.expressionStatement(loc);
  }

  private partialClass(loc: int, topLevel: boolean): Stmt {
    if (!topLevel) {
      this.cursor.report(loc, Code.PartialClassNotTopLevel);
    }

    this.cursor.next();
    const declaration = this.classDecl(false);

    declaration.isPartial = true;

    return declaration;
  }

  private strayHandler(keyword: Token): Stmt {
    const loc = keyword.start;

    if (keyword.kind == TokenKind.Catch) {
      this.cursor.report(loc, Code.NoCatch);
    } else {
      this.cursor.report(loc, Code.NoFinally);
    }

    this.cursor.next();
    if (this.cursor.accept(TokenKind.LParen)) {
      this.cursor.skipTo(TokenKind.RParen);
      this.cursor.accept(TokenKind.RParen);
    }

    this.block();

    return this.marker(StmtKind.Empty, loc);
  }

  private declare(loc: int): Stmt {
    const next = this.cursor.lookahead();

    switch (next.kind) {
      case TokenKind.Function:
        this.cursor.next();
        return this.declaredFunction();
      case TokenKind.Class:
        if (this.library) {
          return this.skipDeclaration(loc, Code.DeclareNotSupported);
        }
        this.cursor.next();
        return this.handleClass();
      case TokenKind.Module:
      case TokenKind.Namespace:
      case TokenKind.Global:
        return this.skipDeclaration(loc, Code.DeclareWordNotSupported, {
          word: next.text,
        });
      default:
        return this.skipDeclaration(loc, Code.DeclareNotSupported);
    }
  }

  private expressionStatement(loc: int): Stmt {
    const expr = this.sequence();
    const assignment = this.destructuringAssignment(loc, expr);

    this.cursor.expectSemicolon();
    if (assignment != undefined) {
      return assignment;
    }

    return { kind: StmtKind.Expr, loc, expr };
  }

  private destructuringAssignment(loc: int, expr: Expr): Stmt | undefined {
    if (expr.kind != ExprKind.Assign) {
      return undefined;
    }
    if (expr.op != undefined) {
      return undefined;
    }

    const target = expr.target;
    if (target.kind == ExprKind.ArrayLit || target.kind == ExprKind.ObjectLit) {
      const pattern = this.patternFromLiteral(target);

      return this.assignPattern(loc, pattern, expr.value);
    }

    return undefined;
  }

  private skipDeclaration(
    loc: int,
    code: Code,
    details: Details = kNoDetails,
  ): Stmt {
    this.cursor.report(loc, code, details);
    this.cursor.next();

    while (
      !this.cursor.is(TokenKind.End) &&
      !this.cursor.is(TokenKind.RBrace)
    ) {
      if (this.cursor.accept(TokenKind.LBrace)) {
        this.cursor.skipToClosingBrace();

        break;
      }
      if (this.cursor.accept(TokenKind.Semi)) {
        break;
      }

      this.cursor.next();
      const current = this.cursor.peek();
      if (current.newline) {
        break;
      }
    }

    return this.marker(StmtKind.Empty, loc);
  }

  private jumpStatement(): Stmt {
    const keyword = this.cursor.next();
    const label = this.jumpLabel();

    this.cursor.expectSemicolon();
    if (keyword.kind == TokenKind.Break) {
      return { kind: StmtKind.Break, loc: keyword.start, label };
    }

    return { kind: StmtKind.Continue, loc: keyword.start, label };
  }

  private jumpLabel(): string {
    const target = this.cursor.peek();
    if (!kTokenTable.isName(target.kind) || target.newline) {
      return "";
    }

    this.cursor.next();

    return target.text;
  }

  private switchStatement(): Stmt {
    const keyword = this.cursor.next();
    const loc = keyword.start;

    this.cursor.expect(TokenKind.LParen, Code.ExpectedAfterSwitch);
    const discriminant = this.sequence();

    this.cursor.expect(TokenKind.RParen, Code.ExpectedAfterSwitchValue);
    this.cursor.expect(TokenKind.LBrace, Code.ExpectedSwitchCasesStart);
    const cases: SwitchCase[] = [];
    let hasDefault = false;

    while (
      this.cursor.is(TokenKind.Case) ||
      this.cursor.is(TokenKind.Default)
    ) {
      const label = this.cursor.peek();
      const isDefault = label.kind == TokenKind.Default;
      if (isDefault && hasDefault) {
        this.cursor.report(label.start, Code.OneDefaultInSwitch);
      }
      if (isDefault) {
        hasDefault = true;
      }

      const clause = this.switchCase();

      cases.push(clause);
    }

    this.closeSwitch();

    return { kind: StmtKind.Switch, loc, discriminant, cases };
  }

  private closeSwitch(): void {
    if (this.cursor.insideList(TokenKind.RBrace)) {
      const token = this.cursor.peek();

      return this.skipBraced(token.start, Code.ExpectedCaseOrDefault, {
        found: token.kind,
      });
    }

    this.cursor.expect(TokenKind.RBrace, Code.ExpectedSwitchClose);
  }

  private switchCase(): SwitchCase {
    const label = this.cursor.next();
    const loc = label.start;

    if (label.kind == TokenKind.Default) {
      this.cursor.expect(TokenKind.Colon, Code.ExpectedAfterDefault);
      const body = this.caseBody();

      return { loc, test: undefined, body };
    }

    const test = this.expression();

    this.cursor.expect(TokenKind.Colon, Code.ExpectedAfterCaseValue);
    const body = this.caseBody();

    return { loc, test, body };
  }

  private statementWithRecovery(topLevel: boolean): Stmt {
    const start = this.cursor.mark();
    const statement = this.statement(topLevel);

    if (this.cursor.isRecovering()) {
      this.cursor.recoverStatement(start);
    }

    return statement;
  }

  private caseBody(): Stmt[] {
    const body: Stmt[] = [];

    while (
      !this.cursor.is(TokenKind.Case) &&
      !this.cursor.is(TokenKind.Default) &&
      !this.cursor.is(TokenKind.RBrace) &&
      !this.cursor.is(TokenKind.End)
    ) {
      const statement = this.statementWithRecovery(false);

      body.push(statement);
    }

    return body;
  }

  private block(): BlockStmt {
    const brace = this.cursor.peek();
    const loc = brace.start;

    this.cursor.expect(TokenKind.LBrace, Code.ExpectedBlockStart);
    const body: Stmt[] = [];

    while (
      !this.cursor.is(TokenKind.RBrace) &&
      !this.cursor.is(TokenKind.End)
    ) {
      const statement = this.statementWithRecovery(false);

      body.push(statement);
    }

    const closing = this.cursor.peek();
    const end = closing.start;

    this.cursor.expect(TokenKind.RBrace, Code.ExpectedBlockClose);

    return { kind: StmtKind.Block, loc, body, end };
  }

  private condition(code: Code): Expr {
    this.cursor.expect(TokenKind.LParen, code);
    const cond = this.sequence();

    this.cursor.expect(TokenKind.RParen, Code.ExpectedAfterCondition);

    return cond;
  }

  private ifStatement(): Stmt {
    const keyword = this.cursor.next();
    const loc = keyword.start;
    const cond = this.condition(Code.ExpectedAfterIf);
    const thenStmt = this.statement(false);
    const elseStmt = this.elseBranch();

    return { kind: StmtKind.If, loc, cond, thenStmt, elseStmt };
  }

  private returnStatement(): Stmt {
    const keyword = this.cursor.next();
    const loc = keyword.start;
    const value = this.returnValue();

    this.cursor.expectSemicolon();

    return { kind: StmtKind.Return, loc, value };
  }

  private valueAhead(): boolean {
    const token = this.cursor.peek();
    const ends =
      token.kind == TokenKind.Semi ||
      token.kind == TokenKind.RBrace ||
      token.kind == TokenKind.End;

    return !ends && !token.newline;
  }

  private throwStatement(): Stmt {
    const keyword = this.cursor.next();
    const loc = keyword.start;

    this.cursor.report(loc, Code.NoThrow);
    if (this.valueAhead()) {
      this.sequence();
      this.cursor.expectSemicolon();
    }

    return this.marker(StmtKind.Empty, loc);
  }

  private strayTry(): Stmt {
    const token = this.cursor.peek();

    this.cursor.report(token.start, Code.NoTry);
    this.cursor.next();
    const block = this.block();

    if (this.cursor.is(TokenKind.Catch)) {
      this.cursor.next();
      if (this.cursor.accept(TokenKind.LParen)) {
        this.cursor.skipTo(TokenKind.RParen);
        this.cursor.expect(TokenKind.RParen, Code.ExpectedAfterCatchVariable);
      }

      this.block();
    }
    if (this.cursor.is(TokenKind.Finally)) {
      this.cursor.next();
      this.block();
    }

    return block;
  }

  private marker(kind: StmtKind.Empty | StmtKind.Debugger, loc: int): Stmt {
    return { kind, loc };
  }

  private elseBranch(): Stmt | undefined {
    if (!this.cursor.accept(TokenKind.Else)) {
      return undefined;
    }

    return this.statement(false);
  }

  private returnValue(): Expr | undefined {
    if (!this.valueAhead()) {
      return undefined;
    }

    return this.sequence();
  }
}
