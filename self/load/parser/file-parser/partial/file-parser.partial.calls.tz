import { FileParser } from "../file-parser.tz";
import { Code } from "../../../../diagnostic/code.tz";
import {
  KnownName,
  Token,
  TokenKind,
} from "../../../token/types/token.types.tz";
import { kTokenTable } from "../../../token/const/token.const.tz";
import {
  ArrayElement,
  CallArgument,
  Expr,
  ExprKind,
  MemberExpr,
  NameExpr,
  NewForm,
  NewKind,
  UnaryOp,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { ExpressionPlace } from "../types/file-parser.types.context.tz";

partial class FileParser {
  private arguments(): CallArgument[] {
    const outer = this.context;

    this.context = { ...outer, expressionPlace: ExpressionPlace.Plain };
    const args: CallArgument[] = [];

    while (this.cursor.insideList(TokenKind.RParen)) {
      const spread = this.cursor.accept(TokenKind.Ellipsis);
      const expr = this.expression();

      args.push({ expr, spread });
      if (!this.cursor.accept(TokenKind.Comma)) {
        break;
      }
    }

    this.cursor.expect(TokenKind.RParen, Code.ExpectedArgumentsClose);
    this.context = outer;

    return args;
  }

  private indexInside(): Expr {
    const outer = this.context;

    this.context = { ...outer, expressionPlace: ExpressionPlace.Plain };
    const index = this.sequence();

    this.cursor.expect(TokenKind.RBracket, Code.ExpectedIndexClose);
    this.context = outer;

    return index;
  }

  private readonly isPropertyName(): boolean {
    const token = this.cursor.peek();

    return (
      token.kind == TokenKind.Identifier || kTokenTable.isKeyword(token.kind)
    );
  }

  private callOrMember(): Expr {
    let expr = this.primary();
    let optionalChain = false;

    while (true) {
      const attached = this.withTypeArguments(expr, optionalChain);
      if (attached != undefined) {
        expr = attached;

        continue;
      }

      const optionalLink = this.cursor.accept(TokenKind.QuestionDot);
      if (optionalLink) {
        optionalChain = true;
      }

      const link = this.chainLink(expr, optionalLink, optionalChain);
      if (link == undefined) {
        break;
      }

      expr = link;
    }

    if (!optionalChain) {
      return expr;
    }

    return { kind: ExprKind.OptionalChain, loc: expr.loc, chain: expr };
  }

  private optionalLink(expr: Expr): Expr | undefined {
    if (this.isPropertyName()) {
      return this.memberLink(expr, true);
    }

    const token = this.cursor.peek();

    switch (token.kind) {
      case TokenKind.LParen:
        return this.callLink(expr, true);
      case TokenKind.LBracket:
        return this.indexLink(expr, true);
      default:
        this.cursor.error(token.start, Code.ExpectedPropertyAfterOptionalDot);
        return undefined;
    }
  }

  private plainLink(expr: Expr, optionalChain: boolean): Expr | undefined {
    const token = this.cursor.peek();

    switch (token.kind) {
      case TokenKind.LParen:
        return this.callLink(expr, false);
      case TokenKind.Dot:
        return this.dotLink(expr);
      case TokenKind.LBracket:
        return this.indexLink(expr, false);
      case TokenKind.TemplateString:
      case TokenKind.TemplateHead:
        return this.taggedTemplate(expr, optionalChain);
      case TokenKind.Bang:
        return this.nonNullLink(expr);
      default:
        return undefined;
    }
  }

  private dotLink(object: Expr): Expr | undefined {
    this.cursor.next();
    if (!this.isPropertyName()) {
      const token = this.cursor.peek();

      this.cursor.error(token.start, Code.ExpectedPropertyAfterDot);

      return undefined;
    }

    return this.memberLink(object, false);
  }

  private nonNullLink(operand: Expr): Expr | undefined {
    const bang = this.cursor.peek();
    if (bang.newline) {
      return undefined;
    }

    this.cursor.next();

    return {
      kind: ExprKind.Unary,
      loc: bang.start,
      op: UnaryOp.NonNull,
      operand,
    };
  }

  private memberLink(object: Expr, optional: boolean): Expr {
    const name = this.cursor.next();

    return {
      kind: ExprKind.Member,
      loc: name.start,
      object,
      name: name.text,
      known: name.known,
      optional,
      typeArgs: [],
    };
  }

  private callLink(callee: Expr, optional: boolean): Expr {
    this.cursor.next();
    const args = this.arguments();

    return {
      kind: ExprKind.Call,
      loc: callee.loc,
      callee,
      args,
      optional,
      tagged: false,
    };
  }

  private indexLink(object: Expr, optional: boolean): Expr {
    const bracket = this.cursor.next();
    const index = this.indexInside();

    return {
      kind: ExprKind.Index,
      loc: bracket.start,
      object,
      index,
      optional,
    };
  }

  private withTypeArguments(expr: Expr, optionalChain: boolean): Expr | undefined {
    if (!this.cursor.is(TokenKind.Less)) {
      return undefined;
    }
    if (expr.kind == ExprKind.Name && !optionalChain) {
      return this.nameWithTypeArguments(expr);
    }
    if (expr.kind == ExprKind.Member) {
      return this.memberWithTypeArguments(expr);
    }

    return undefined;
  }

  private nameWithTypeArguments(expr: NameExpr): Expr | undefined {
    if (expr.typeArgs.length > 0) {
      return undefined;
    }

    const typeArgs = this.tryTypeArguments(false);
    if (typeArgs == undefined) {
      return undefined;
    }

    return {
      kind: ExprKind.Name,
      loc: expr.loc,
      name: expr.name,
      known: expr.known,
      typeArgs,
    };
  }

  private memberWithTypeArguments(expr: MemberExpr): Expr | undefined {
    if (expr.typeArgs.length > 0) {
      return undefined;
    }

    const typeArgs = this.tryTypeArguments(true);
    if (typeArgs == undefined) {
      return undefined;
    }

    return {
      kind: ExprKind.Member,
      loc: expr.loc,
      object: expr.object,
      name: expr.name,
      known: expr.known,
      optional: expr.optional,
      typeArgs,
    };
  }

  private taggedTemplate(tag: Expr, optional: boolean): Expr {
    if (optional) {
      const token = this.cursor.peek();

      this.cursor.report(token.start, Code.TaggedTemplateInOptionalChain);
    }

    const raw = this.isStringRaw(tag);
    const outer = this.context;

    this.context = { ...outer, expressionPlace: ExpressionPlace.Plain };
    const template = this.template(raw);

    this.context = outer;
    const elements: ArrayElement[] = [];

    for (const text of template.quasis) {
      const value: Expr = {
        kind: ExprKind.StringLit,
        loc: template.loc,
        value: text,
      };

      elements.push({ expr: value, spread: false, hole: false });
    }

    const texts: Expr = {
      kind: ExprKind.ArrayLit,
      loc: template.loc,
      elements,
    };
    const args: CallArgument[] = [{ expr: texts, spread: false }];

    for (const part of template.exprs) {
      args.push({ expr: part, spread: false });
    }

    return {
      kind: ExprKind.Call,
      loc: tag.loc,
      callee: tag,
      args,
      optional: false,
      tagged: true,
    };
  }

  private readonly isStringRaw(tag: Expr): boolean {
    if (tag.kind != ExprKind.Member) {
      return false;
    }
    if (tag.known != KnownName.Raw) {
      return false;
    }

    const object = tag.object;

    return object.kind == ExprKind.Name && object.known == KnownName.String;
  }

  private newArguments(): CallArgument[] {
    if (!this.cursor.accept(TokenKind.LParen)) {
      this.rejectOptionalAfterNew();

      return [];
    }

    return this.arguments();
  }

  private rejectOptionalAfterNew(): void {
    const token = this.cursor.peek();
    if (token.kind == TokenKind.QuestionDot) {
      this.cursor.report(token.start, Code.OptionalChainAfterNew);
    }
  }

  private newExpression(): Expr {
    const keyword = this.cursor.next();
    const loc = keyword.start;

    if (this.cursor.is(TokenKind.LParen)) {
      return this.newOfExpression();
    }
    if (!this.cursor.atName() && !this.cursor.is(TokenKind.This)) {
      const token = this.cursor.peek();

      this.cursor.error(token.start, Code.ExpectedClassAfterNew);

      return this.invalid(loc);
    }

    const name = this.cursor.next();
    const member = this.newMember();
    const form = this.newForm(name, member);
    const typeArgs = this.optionalTypeArguments();
    const args = this.newArguments();

    return {
      kind: ExprKind.New,
      loc: name.start,
      form,
      typeArgs,
      args,
    };
  }

  private newMember(): Token | undefined {
    if (!this.cursor.accept(TokenKind.Dot)) {
      return undefined;
    }
    if (this.isPropertyName()) {
      return this.cursor.next();
    }

    const token = this.cursor.peek();

    this.cursor.error(token.start, Code.ExpectedNameAfterDot);

    return undefined;
  }

  private newForm(name: Token, member: Token | undefined): NewForm {
    const isPath = name.kind == TokenKind.This || this.newPathAhead();
    if (isPath) {
      const callee = this.newCallee(name, member);

      return { kind: NewKind.Callee, callee };
    }

    return { kind: NewKind.Named, name: name.text, member: member?.text };
  }

  private newOfExpression(): Expr {
    const paren = this.cursor.next();
    const at = paren.start;
    const outer = this.context;

    this.context = { ...outer, expressionPlace: ExpressionPlace.Plain };
    const inner = this.sequence();

    this.cursor.expect(TokenKind.RParen, Code.ExpectedNewClassClose);
    const callee = this.newPath(inner);
    const args = this.newArguments();

    this.context = outer;

    return {
      kind: ExprKind.New,
      loc: at,
      form: { kind: NewKind.Callee, callee },
      typeArgs: [],
      args,
    };
  }

  private newCallee(name: Token, member: Token | undefined): Expr {
    let path: Expr = {
      kind: ExprKind.Name,
      loc: name.start,
      name: name.text,
      known: name.known,
      typeArgs: [],
    };

    if (member != undefined) {
      path = {
        kind: ExprKind.Member,
        loc: member.start,
        object: path,
        name: member.text,
        known: member.known,
        optional: false,
        typeArgs: [],
      };
    }

    return this.newPath(path);
  }

  private newPath(from: Expr): Expr {
    let path = from;

    while (this.newPathAhead()) {
      const link = this.pathLink(path);
      if (link == undefined) {
        return path;
      }

      path = link;
    }

    return path;
  }

  private chainLink(
    expr: Expr,
    optionalLink: boolean,
    optionalChain: boolean,
  ): Expr | undefined {
    if (optionalLink) {
      return this.optionalLink(expr);
    }

    return this.plainLink(expr, optionalChain);
  }

  private readonly newPathAhead(): boolean {
    const token = this.cursor.peek();

    switch (token.kind) {
      case TokenKind.Dot:
      case TokenKind.LBracket:
        return true;
      case TokenKind.Bang:
        return !token.newline;
      default:
        return false;
    }
  }

  private pathLink(path: Expr): Expr | undefined {
    if (this.cursor.is(TokenKind.LBracket)) {
      return this.indexLink(path, false);
    }
    if (this.cursor.is(TokenKind.Bang)) {
      return this.nonNullLink(path);
    }

    return this.dotLink(path);
  }
}
