import { replace } from "tz:mem";
import "./partial/file-parser.partial.types.tz";
import "./partial/file-parser.partial.literal-types.tz";
import "./partial/file-parser.partial.copies-expressions.tz";
import "./partial/file-parser.partial.copies-statements.tz";
import "./partial/file-parser.partial.copies-declarations.tz";
import "./partial/file-parser.partial.copies-types.tz";
import { Code } from "../../../diagnostic/code.tz";
import "./partial/file-parser.partial.expressions.tz";
import "./partial/file-parser.partial.patterns.tz";
import "./partial/file-parser.partial.pattern-assignments.tz";
import "./partial/file-parser.partial.statements.tz";
import "./partial/file-parser.partial.switches.tz";
import "./partial/file-parser.partial.functions.tz";
import "./partial/file-parser.partial.classes.tz";
import "./partial/file-parser.partial.parameter-fields.tz";
import "./partial/file-parser.partial.class-members.tz";
import "./partial/file-parser.partial.modules.tz";
import "./partial/file-parser.partial.operators.tz";
import "./partial/file-parser.partial.calls.tz";
import "./partial/file-parser.partial.literals.tz";
import "./partial/file-parser.partial.object-types.tz";
import "./partial/file-parser.partial.function-types.tz";
import "./partial/file-parser.partial.loops.tz";
import "./partial/file-parser.partial.variables.tz";
import "./partial/file-parser.partial.declarations.tz";
import "./partial/file-parser.partial.arrows.tz";
import "./partial/file-parser.partial.modifiers.tz";
import "./partial/file-parser.partial.exports.tz";
import "./partial/file-parser.partial.declaration-file.tz";
import { Token, TokenKind } from "../../token/types/token.types.tz";
import { Cursor } from "../cursor/cursor.tz";
import { kNoStatement } from "./const/file-parser.const.statements.tz";
import { LiteralReader } from "../literal/literal.tz";
import {
  ExpressionPlace,
  FunctionKind,
  ParseContext,
  TypePlace,
} from "./types/file-parser.types.context.tz";
import {
  DeclarationDraft,
  DeclarationResult,
  ParseResult,
} from "./types/file-parser.types.result.tz";
import {
  DeclarationFile,
} from "../../../program/syntax/types/syntax.types.declarations.tz";
import {
  UnsafeMark,
} from "../../../program/syntax/types/syntax.types.functions.tz";
import {
  ExportDecl,
  ImportDecl,
  SourceFile,
} from "../../../program/syntax/types/syntax.types.modules.tz";
import { Stmt } from "../../../program/syntax/types/syntax.types.statements.tz";

export class FileParser {
  private readonly cursor: Cursor;
  private readonly literals: LiteralReader;
  private readonly library: boolean;
  private readonly bracesMissing: boolean;
  private fieldNames: Set<string>;
  private stringConstants: Map<string, string[]>;
  private imports: ImportDecl[];
  private exports: ExportDecl[];
  private context: ParseContext;
  private names: int;
  private statementStart: int;
  private unsafeMark?: UnsafeMark;

  public takeTokens(): Token[] {
    return this.cursor.takeTokens();
  }

  public constructor(
    source: Read<Buffer>,
    tokens: Own<Token[]>,
    library: boolean,
  ) {
    this.cursor = new Cursor(tokens);
    this.literals = new LiteralReader(source);
    this.library = library;
    this.bracesMissing = this.cursor.bracesMissing();
    this.fieldNames = new Set<string>();
    this.stringConstants = new Map<string, string[]>();
    this.imports = [];
    this.exports = [];
    this.context = {
      functionKind: FunctionKind.Plain,
      expressionPlace: ExpressionPlace.Plain,
      typePlace: TypePlace.Plain,
    };
    this.names = 0;
    this.statementStart = kNoStatement;
    this.unsafeMark = undefined;
  }

  private takenUnsafe(): UnsafeMark | undefined {
    return replace(this.unsafeMark, undefined);
  }

  public run(): ParseResult {
    const items: Stmt[] = [];

    while (!this.cursor.is(TokenKind.End)) {
      if (this.cursor.is(TokenKind.RBrace)) {
        this.strayBrace();

        continue;
      }

      const statement = this.statementWithRecovery(true);

      items.push(statement);
    }

    const file: SourceFile = {
      items,
      imports: replace(this.imports, []),
      exports: replace(this.exports, []),
      fieldNames: replace(this.fieldNames, new Set<string>()),
      stringConstants: replace(
        this.stringConstants,
        new Map<string, string[]>(),
      ),
    };

    return { file, errors: this.cursor.takeErrors() };
  }

  public runDeclaration(): DeclarationResult {
    const draft: DeclarationDraft = { items: [], classes: [] };

    while (!this.cursor.is(TokenKind.End)) {
      if (this.cursor.is(TokenKind.RBrace)) {
        this.strayBrace();

        continue;
      }

      this.declarationItem(draft);
    }

    const file: DeclarationFile = {
      items: draft.items,
      classes: draft.classes,
      imports: replace(this.imports, []),
      exports: replace(this.exports, []),
    };

    return { file, errors: this.cursor.takeErrors() };
  }

  private strayBrace(): void {
    const brace = this.cursor.next();

    this.cursor.error(brace.start, Code.UnexpectedClosingBrace);
    this.cursor.stopRecovering();
  }

  private readonly written(start: int, end: int): string {
    return this.literals.written(start, end);
  }

  private hiddenName(): string {
    const name = `%${this.names}`;

    this.names += 1;

    return name;
  }

  private keepName(name: string): string {
    this.names += 1;

    return name;
  }
}
