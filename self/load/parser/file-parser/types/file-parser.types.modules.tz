import { Code } from "../../../../diagnostic/code.tz";

export enum ImportForm {
  Named,
  Namespace,
  Default,
}

export type ImportClause =
  | { readonly kind: ImportForm.Named }
  | { readonly kind: ImportForm.Default; readonly name: string }
  | { readonly kind: ImportForm.Namespace; readonly name?: string };

export type NameListCodes = {
  readonly typeNotNeeded: Code;
  readonly keywordName: Code;
  readonly expectedName: Code;
  readonly close: Code;
};
