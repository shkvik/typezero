import {
  Access,
  ClassField,
  Decorator,
} from "../../../../program/ast/types/ast.types.classes.tz";
import { FunctionDecl } from "../../../../program/ast/types/ast.types.functions.tz";
import { Span } from "../../../../program/ast/types/ast.types.span.tz";
import { StmtKind } from "../../../../program/ast/types/ast.types.statements.tz";
import {
  TypeParamDecl,
  TypeRef,
} from "../../../../program/ast/types/ast.types.types.tz";
import { Expr } from "../../../../program/ast/types/ast.types.expressions.tz";

export type Modifiers = {
  isStatic: boolean;
  readonly: boolean;
  isAbstract: boolean;
  isOverride: boolean;
  isAsync: boolean;
  accessor: boolean;
  access: Access;
  accessWritten: boolean;
  staticBlock: boolean;
};

export type MemberName = {
  readonly loc: int;
  readonly start: int;
  readonly name: string;
  readonly generator: boolean;
  readonly constructorName: boolean;
};

export type ClassBase = {
  readonly base?: TypeRef;
  readonly baseExpr?: Expr;
  readonly baseArgs: TypeRef[];
};

export type ClassDeclDraft = {
  readonly kind: StmtKind.Class;
  readonly loc: int;
  name?: string;
  isAbstract: boolean;
  isPartial: boolean;
  readonly base?: TypeRef;
  readonly baseExpr?: Expr;
  readonly baseArgs: TypeRef[];
  readonly interfaces: TypeRef[];
  readonly fields: ClassField[];
  readonly methods: FunctionDecl[];
  readonly constructors: FunctionDecl[];
  readonly expression: boolean;
  decorators: Decorator[];
  readonly typeParams: TypeParamDecl[];
  source?: Span;
};
