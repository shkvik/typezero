import { Access } from "../../../../ast.tz";

export type Modifiers = {
  isStatic: boolean;
  readonly: boolean;
  isAbstract: boolean;
  isOverride: boolean;
  isAsync: boolean;
  accessor: boolean;
  access: Access;
  staticBlock: boolean;
};

export type MemberName = {
  readonly loc: int;
  readonly start: int;
  readonly name: string;
  readonly generator: boolean;
  readonly constructorName: boolean;
};
