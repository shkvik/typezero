import { Access } from "../../../../program/ast/types/ast.types.classes.tz";
import { TypeRef } from "../../../../program/ast/types/ast.types.types.tz";
import { Expr } from "../../../../program/ast/types/ast.types.expressions.tz";

export type Modifiers = {
  isStatic: boolean;
  readonly: boolean;
  isAbstract: boolean;
  isOverride: boolean;
  isAsync: boolean;
  accessor: boolean;
  access: Access;
  accessWritten: boolean;
  staticBlock: boolean;
};

export type MemberName = {
  readonly loc: int;
  readonly start: int;
  readonly name: string;
  readonly generator: boolean;
  readonly constructorName: boolean;
};

export type ClassBase = {
  readonly base?: TypeRef;
  readonly baseExpr?: Expr;
};
