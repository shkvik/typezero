import { Pattern } from "./file-parser.types.patterns.tz";
import { Binding } from "./file-parser.types.variables.tz";

export enum ForTargetKind {
  Name,
  Pattern,
}

export type ForDeclaration = {
  readonly loc: int;
  readonly isConst: boolean;
  readonly isUsing: boolean;
};

export type ForTarget =
  | { readonly kind: ForTargetKind.Name; readonly binding: Binding }
  | { readonly kind: ForTargetKind.Pattern; readonly pattern: Pattern };
