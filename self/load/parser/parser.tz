import { Code } from "../../diagnostic/code.tz";
import { SourceError } from "../../diagnostic/types/message.types.tz";
import { Lexer } from "../lexer/lexer.tz";
import { Token } from "../token/types/token.types.tz";
import { FileParser } from "./file-parser/file-parser.tz";
import { OpenBlocks } from "./open-blocks/open-blocks.tz";
import { LexResult, LexedFile } from "../lexer/types/lexer.types.tz";
import { SourceText } from "../../program/module/types/module.types.tz";
import {
  ParsedDeclaration,
  ParsedFile,
} from "../../program/syntax/types/syntax.types.files.tz";

export class Parser {
  public readonly run(sources: Read<SourceText[]>): ParsedFile[] {
    const parsed: ParsedFile[] = [];

    for (const source of sources) {
      const copy = this.copiedSource(source);
      const file = this.parseFile(copy);

      parsed.push(file);
    }

    return parsed;
  }

  public readonly runDeclarations(
    sources: Read<SourceText[]>,
  ): ParsedDeclaration[] {
    const parsed: ParsedDeclaration[] = [];

    for (const source of sources) {
      const copy = this.copiedSource(source);
      const file = this.parseDeclaration(copy);

      parsed.push(file);
    }

    return parsed;
  }

  private readonly copiedSource(source: Read<SourceText>): SourceText {
    const text = Buffer.from(source.text);
    const pieces = source.pieces?.slice();

    return {
      path: source.path,
      text,
      isLibrary: source.isLibrary,
      pieces,
    };
  }

  public readonly parseFile(source: Own<SourceText>): ParsedFile {
    const lexer = new Lexer(source.text);
    const lexed = lexer.run();
    const parsed = this.parseLexed(source, lexed);

    return parsed.parsed;
  }

  public readonly parseLexed(
    source: Own<SourceText>,
    lexed: Own<LexResult>,
  ): LexedFile {
    const lexical = lexed.errors;
    const fileParser = new FileParser(
      source.text,
      lexed.tokens,
      source.isLibrary,
    );
    const result = fileParser.run();
    const tokens = fileParser.takeTokens();
    const merged = this.mergeByPlace(lexical, tokens, result.errors);
    const blocks = new OpenBlocks(source.text, tokens);
    const errors = blocks.explain(merged);
    const parsed: ParsedFile = { source, file: result.file, errors };

    return { parsed, tokens: blocks.takeTokens() };
  }

  public readonly parseDeclaration(source: Own<SourceText>): ParsedDeclaration {
    const lexer = new Lexer(source.text);
    const lexed = lexer.run();
    const lexical = lexed.errors;
    const fileParser = new FileParser(
      source.text,
      lexed.tokens,
      source.isLibrary,
    );
    const result = fileParser.runDeclaration();
    const tokens = fileParser.takeTokens();
    const merged = this.mergeByPlace(lexical, tokens, result.errors);
    const blocks = new OpenBlocks(source.text, tokens);
    const errors = blocks.explain(merged);

    return { source, file: result.file, errors };
  }

  private readonly mergeByPlace(
    lexical: Read<SourceError[]>,
    tokens: Read<Token[]>,
    syntactic: Own<SourceError[]>,
  ): SourceError[] {
    if (lexical.length == 0) {
      return syntactic;
    }

    const merged: SourceError[] = [];
    let taken = 0;
    let explained = -1;

    for (const error of syntactic) {
      while (taken < lexical.length) {
        const earlier = lexical[taken];
        if (earlier == undefined || earlier.loc > error.loc) {
          break;
        }

        merged.push(earlier);
        explained = this.explainedPlace(earlier, tokens);
        taken += 1;
      }

      if (error.loc != explained) {
        merged.push(error);
      }
    }

    const rest = lexical.slice(taken);

    return merged.concat(rest);
  }

  private readonly explainedPlace(
    error: SourceError,
    tokens: Read<Token[]>,
  ): int {
    if (error.code != Code.UnexpectedCharacter) {
      return error.loc;
    }

    const next = tokens.find((token) => token.start > error.loc);
    if (next == undefined) {
      return error.loc;
    }

    return next.start;
  }
}
