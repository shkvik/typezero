import { SourceError } from "../../diagnostic/types/message.types.tz";
import { Lexer } from "../lexer/lexer.tz";
import { FileParser } from "./file-parser/file-parser.tz";
import { ParsedFile, SourceText } from "./types/parser.types.tz";

export class Parser {
  private readonly sources: SourceText[];

  public constructor(sources: SourceText[]) {
    this.sources = sources;
  }

  public run(): ParsedFile[] {
    const parsed: ParsedFile[] = [];

    for (const source of this.sources) {
      const file = this.parseFile(source);

      parsed.push(file);
    }

    return parsed;
  }

  private parseFile(source: SourceText): ParsedFile {
    const lexer = new Lexer(source.text);
    const lexed = lexer.run();
    const fileParser = new FileParser(
      source.text,
      lexed.tokens,
      source.isLibrary,
    );
    const result = fileParser.run();
    const errors = this.mergeByPlace(lexed.errors, result.errors);

    return { source, file: result.file, errors };
  }

  private mergeByPlace(
    lexical: SourceError[],
    syntactic: SourceError[],
  ): SourceError[] {
    if (lexical.length == 0) {
      return syntactic;
    }

    const merged: SourceError[] = [];
    let taken = 0;
    let explained = -1;

    for (const error of syntactic) {
      while (taken < lexical.length) {
        const earlier = lexical[taken];
        if (earlier == undefined || earlier.loc > error.loc) {
          break;
        }

        merged.push(earlier);
        explained = earlier.loc;
        taken += 1;
      }

      if (error.loc != explained) {
        merged.push(error);
      }
    }

    const rest = lexical.slice(taken);

    return merged.concat(rest);
  }
}
