import { Code } from "../../diagnostic/code.tz";
import { SourceError } from "../../diagnostic/types/message.types.tz";
import { Lexer } from "../lexer/lexer.tz";
import { Token } from "../token/types/token.types.tz";
import { FileParser } from "./file-parser/file-parser.tz";
import { OpenBlocks } from "./open-blocks/open-blocks.tz";
import { LexResult } from "../lexer/types/lexer.types.tz";
import {
  ParsedDeclaration,
  ParsedFile,
  SourceText,
} from "../../program/module/types/module.types.tz";

export class Parser {
  private readonly sources: SourceText[];

  public constructor(sources: Own<SourceText[]>) {
    this.sources = sources;
  }

  public readonly run(): ParsedFile[] {
    const parsed: ParsedFile[] = [];

    for (const source of this.sources) {
      const file = this.parseFile(source);

      parsed.push(file);
    }

    return parsed;
  }

  public readonly runDeclarations(): ParsedDeclaration[] {
    const parsed: ParsedDeclaration[] = [];

    for (const source of this.sources) {
      const file = this.parseDeclaration(source);

      parsed.push(file);
    }

    return parsed;
  }

  public readonly parseFile(source: SourceText): ParsedFile {
    const lexer = new Lexer(source.text);
    const lexed = lexer.run();

    return this.parseLexed(source, lexed);
  }

  public readonly parseLexed(source: Own<SourceText>, lexed: Read<LexResult>): ParsedFile {
    const fileParser = new FileParser(
      source.text,
      lexed.tokens,
      source.isLibrary,
    );
    const result = fileParser.run();
    const errors = this.explained(source, lexed, result.errors);

    return { source, file: result.file, errors };
  }

  public readonly parseDeclaration(source: Own<SourceText>): ParsedDeclaration {
    const lexer = new Lexer(source.text);
    const lexed = lexer.run();
    const fileParser = new FileParser(
      source.text,
      lexed.tokens,
      source.isLibrary,
    );
    const result = fileParser.runDeclaration();
    const errors = this.explained(source, lexed, result.errors);

    return { source, file: result.file, errors };
  }

  private readonly explained(
    source: SourceText,
    lexed: Read<LexResult>,
    syntactic: Own<SourceError[]>,
  ): SourceError[] {
    const merged = this.mergeByPlace(lexed, syntactic);
    const blocks = new OpenBlocks(source.text, lexed.tokens);

    return blocks.explain(merged);
  }

  private readonly mergeByPlace(
    lexed: Read<LexResult>,
    syntactic: Own<SourceError[]>,
  ): SourceError[] {
    const lexical = lexed.errors;
    if (lexical.length == 0) {
      return syntactic;
    }

    const merged: SourceError[] = [];
    let taken = 0;
    let explained = -1;

    for (const error of syntactic) {
      while (taken < lexical.length) {
        const earlier = lexical[taken];
        if (earlier == undefined || earlier.loc > error.loc) {
          break;
        }

        merged.push(earlier);
        explained = this.explainedPlace(earlier, lexed.tokens);
        taken += 1;
      }

      if (error.loc != explained) {
        merged.push(error);
      }
    }

    const rest = lexical.slice(taken);

    return merged.concat(rest);
  }

  private readonly explainedPlace(error: SourceError, tokens: readonly Token[]): int {
    if (error.code != Code.UnexpectedCharacter) {
      return error.loc;
    }

    const next = tokens.find((token) => token.start > error.loc);
    if (next == undefined) {
      return error.loc;
    }

    return next.start;
  }
}
