import { Token } from "../../token.tz";

const kNewline = 10;
const kReturn = 13;
const kQuote = 34;
const kApostrophe = 39;
const kZero = 48;
const kNine = 57;
const kUpperA = 65;
const kUpperF = 70;
const kBackslash = 92;
const kBacktick = 96;
const kLowerA = 97;
const kLowerB = 98;
const kLowerF = 102;
const kLowerN = 110;
const kLowerO = 111;
const kLowerR = 114;
const kLowerT = 116;
const kLowerU = 117;
const kLowerV = 118;
const kLowerX = 120;
const kUpperB = 66;
const kUpperO = 79;
const kUpperX = 88;
const kDollar = 36;
const kLeftBrace = 123;
const kRightBrace = 125;
const kSlash = 47;
const kUnderscore = 95;

export type DecodedText = { readonly text: string; readonly ok: boolean };

export type RegexText = { readonly pattern: string; readonly flags: string };

export type NumberText = {
  readonly isInt: boolean;
  readonly intValue: uint64;
  readonly doubleValue: double;
  readonly valid: boolean;
};

type Escape = { readonly text: string; readonly next: int };

export class LiteralReader {
  private readonly source: Buffer;

  public constructor(source: Buffer) {
    this.source = source;
  }

  public string(token: Token): DecodedText {
    const quote = this.byteAt(token.start);
    const closing = this.byteAt(token.end - 1);
    const closed = token.end > token.start + 1 && closing == quote;
    const last = closed ? token.end - 1 : token.end;

    return this.decodeText(token.start + 1, last, false);
  }

  public templatePart(token: Token): DecodedText {
    const last = this.templateEnd(token);

    return this.decodeText(token.start + 1, last, true);
  }

  public templateRaw(token: Token): string {
    const last = this.templateEnd(token);
    const parts: string[] = [];
    let segment = token.start + 1;
    let i = token.start + 1;
    while (i < last) {
      const c = this.byteAt(i);
      if (c != kReturn) {
        i += 1;
        continue;
      }
      const piece = this.source.toString("utf8", segment, i);
      parts.push(piece);
      parts.push("\n");
      const next = this.byteAt(i + 1);
      const crlf = i + 1 < last && next == kNewline;
      i += crlf ? 2 : 1;
      segment = i;
    }
    const tail = this.source.toString("utf8", segment, last);
    parts.push(tail);

    return parts.join("");
  }

  public regex(token: Token): RegexText {
    const from = token.start + 1;
    let slash = token.end;
    for (let i = token.end - 1; i >= from; i--) {
      const c = this.byteAt(i);
      if (c == kSlash) {
        slash = i;
        break;
      }
    }
    const pattern = this.source.toString("utf8", from, slash);
    const flagsStart = slash + 1 < token.end ? slash + 1 : token.end;
    const flags = this.source.toString("utf8", flagsStart, token.end);

    return { pattern, flags };
  }

  public integer(token: Token): NumberText {
    const digits = this.digitsOf(token);
    const radix = this.radixOf(digits);
    const from = radix == 10 ? 0 : 2;
    const base = radix.toUint64();
    let value: uint64 = 0;
    let fits = from < digits.length;
    for (let i = from; i < digits.length && fits; i++) {
      const digit = this.digitValue(digits[i] ?? 0, radix);
      if (digit >= radix) {
        fits = false;
        break;
      }
      if (digit < 0 || digit > 15) {
        fits = false;
        break;
      }
      const step = digit.toUint64();
      const product = Bit.mul64(value, base);
      if (product.hi != 0) {
        fits = false;
        break;
      }
      let sum = Bit.Wrap64.from(product.lo);
      sum = sum + step;
      if (sum.value < product.lo) {
        fits = false;
        break;
      }
      value = sum.value;
    }
    if (fits) {
      return { isInt: true, intValue: value, doubleValue: 0.0, valid: true };
    }
    for (let i = from; i < digits.length; i++) {
      const digit = this.digitValue(digits[i] ?? 0, radix);
      if (digit >= radix) {
        return { isInt: true, intValue: 0, doubleValue: 0.0, valid: false };
      }
    }
    const decimal = this.textOfDigits(digits, 0);
    const prefixed = this.textOfDigits(digits, 1);
    const text = radix == 10 ? decimal : `0${prefixed}`;
    const parsed = Number(text);
    const rounded = parsed.unwrapOr(0.0);

    return { isInt: false, intValue: 0, doubleValue: rounded, valid: true };
  }

  public float(token: Token): NumberText {
    const digits = this.digitsOf(token);
    const text = this.textOfDigits(digits, 0);
    const parsed = Number(text);
    if (parsed.isErr()) {
      return { isInt: false, intValue: 0, doubleValue: 0.0, valid: false };
    }

    return {
      isInt: false,
      intValue: 0,
      doubleValue: parsed.value,
      valid: true,
    };
  }

  private byteAt(i: int): int {
    const value = this.source[i] ?? 0;

    return value.toInt();
  }

  private hexValue(c: int): int {
    if (c >= kZero && c <= kNine) {
      return c - kZero;
    }
    if (c >= kLowerA && c <= kLowerF) {
      return c - kLowerA + 10;
    }
    if (c >= kUpperA && c <= kUpperF) {
      return c - kUpperA + 10;
    }

    return -1;
  }

  private hexEscape(at: int, end: int, count: int): Escape | undefined {
    let value = 0;
    for (let n = 0; n < count; n++) {
      if (at + n >= end) {
        return undefined;
      }
      const c = this.byteAt(at + n);
      const digit = this.hexValue(c);
      if (digit < 0) {
        return undefined;
      }
      value = value * 16 + digit;
    }
    const text = String.fromCharCode(value);

    return { text, next: at + count };
  }

  private unicodeEscape(at: int, end: int): Escape | undefined {
    const open = this.byteAt(at);
    if (at >= end || open != kLeftBrace) {
      return this.hexEscape(at, end, 4);
    }
    let i = at + 1;
    let cp = 0;
    let digits = 0;
    while (i < end) {
      const c = this.byteAt(i);
      const digit = this.hexValue(c);
      if (digit < 0) {
        break;
      }
      cp = cp * 16 + digit;
      i += 1;
      digits += 1;
      if (digits > 6) {
        return undefined;
      }
    }
    const close = this.byteAt(i);
    if (digits == 0 || i >= end || close != kRightBrace) {
      return undefined;
    }
    if (cp < 0 || cp > 0x10ffff) {
      return undefined;
    }
    const text = String.fromCodePoint(cp);

    return { text, next: i + 1 };
  }

  private simpleEscape(c: int): string | undefined {
    if (c == kLowerN) {
      return "\n";
    }
    if (c == kLowerT) {
      return "\t";
    }
    if (c == kLowerR) {
      return "\r";
    }
    if (c == kLowerB) {
      return "\b";
    }
    if (c == kLowerF) {
      return "\f";
    }
    if (c == kLowerV) {
      return "\v";
    }
    if (c == kZero) {
      return "\0";
    }

    return undefined;
  }

  private needsDecoding(start: int, end: int, isTemplate: boolean): boolean {
    for (let i = start; i < end; i++) {
      const c = this.byteAt(i);
      if (c == kBackslash || (isTemplate && c == kReturn)) {
        return true;
      }
    }

    return false;
  }

  private decodeText(start: int, end: int, isTemplate: boolean): DecodedText {
    const encoded = this.needsDecoding(start, end, isTemplate);
    if (!encoded) {
      const plain = this.source.toString("utf8", start, end);
      return { text: plain, ok: true };
    }
    const parts: string[] = [];
    let segment = start;
    let i = start;
    while (i < end) {
      const c = this.byteAt(i);
      if (isTemplate && c == kReturn) {
        const beforeReturn = this.source.toString("utf8", segment, i);

        parts.push(beforeReturn);
        parts.push("\n");

        const next = this.byteAt(i + 1);
        const crlf = i + 1 < end && next == kNewline;

        i += crlf ? 2 : 1;
        segment = i;
        continue;
      }

      if (c != kBackslash) {
        i += 1;
        continue;
      }

      const beforeEscape = this.source.toString("utf8", segment, i);
      parts.push(beforeEscape);
      i += 1;

      if (i >= end) {
        segment = i;
        break;
      }

      const e = this.byteAt(i);
      const simple = this.simpleEscape(e);

      i += 1;

      if (simple != undefined) {
        parts.push(simple);
        segment = i;
        continue;
      }
      if (e == kReturn) {
        const after = this.byteAt(i);
        if (i < end && after == kNewline) {
          i += 1;
        }
        segment = i;
        continue;
      }
      if (e == kNewline) {
        segment = i;
        continue;
      }
      if (e == kLowerX || e == kLowerU) {
        const escape = this.numericEscape(e, i, end);
        if (escape == undefined) {
          const partial = parts.join("");
          return { text: partial, ok: false };
        }
        parts.push(escape.text);
        i = escape.next;
        segment = i;
        continue;
      }
      segment = i - 1;
    }
    const tail = this.source.toString("utf8", segment, end);
    parts.push(tail);
    const text = parts.join("");

    return { text, ok: true };
  }

  private numericEscape(kind: int, at: int, end: int): Escape | undefined {
    if (kind == kLowerX) {
      return this.hexEscape(at, end, 2);
    }

    return this.unicodeEscape(at, end);
  }

  private templateEnd(token: Token): int {
    const length = token.end - token.start;
    const beforeLast = this.byteAt(token.end - 2);
    const last = this.byteAt(token.end - 1);
    const interpolation =
      length >= 3 && beforeLast == kDollar && last == kLeftBrace;
    if (interpolation) {
      return token.end - 2;
    }
    if (length >= 2 && last == kBacktick) {
      return token.end - 1;
    }

    return token.end;
  }

  private digitsOf(token: Token): int[] {
    const digits: int[] = [];
    for (let i = token.start; i < token.end; i++) {
      const c = this.byteAt(i);
      if (c != kUnderscore) {
        digits.push(c);
      }
    }

    return digits;
  }

  private radixOf(digits: int[]): int {
    if (digits.length <= 2 || digits[0] != kZero) {
      return 10;
    }
    const marker = digits[1] ?? 0;
    if (marker == kLowerX || marker == kUpperX) {
      return 16;
    }
    if (marker == kLowerB || marker == kUpperB) {
      return 2;
    }
    if (marker == kLowerO || marker == kUpperO) {
      return 8;
    }

    return 10;
  }

  private digitValue(c: int, radix: int): int {
    if (c >= kZero && c <= kNine) {
      return c - kZero;
    }
    const lower = c | 0x20;
    if (lower >= kLowerA && lower <= 122) {
      return lower - kLowerA + 10;
    }

    return radix;
  }

  private textOfDigits(digits: int[], from: int): string {
    const chars: string[] = [];
    for (let i = from; i < digits.length; i++) {
      const c = digits[i] ?? 0;
      const character = String.fromCharCode(c);
      chars.push(character);
    }

    return chars.join("");
  }
}
