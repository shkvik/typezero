import { Token } from "../../token.tz";

const kNewline = 10;
const kReturn = 13;
const kQuote = 34;
const kApostrophe = 39;
const kZero = 48;
const kNine = 57;
const kUpperA = 65;
const kUpperF = 70;
const kBackslash = 92;
const kBacktick = 96;
const kLowerA = 97;
const kLowerB = 98;
const kLowerF = 102;
const kLowerN = 110;
const kLowerO = 111;
const kLowerR = 114;
const kLowerT = 116;
const kLowerU = 117;
const kLowerV = 118;
const kLowerX = 120;
const kUpperB = 66;
const kUpperO = 79;
const kUpperX = 88;
const kDollar = 36;
const kLeftBrace = 123;
const kRightBrace = 125;
const kSlash = 47;
const kUnderscore = 95;
const kHigh = 128;

export type DecodedText = { readonly text: string; readonly ok: boolean };

export type RegexText = { readonly pattern: string; readonly flags: string };

export type NumberText = {
  readonly isInt: boolean;
  readonly intValue: uint64;
  readonly doubleValue: double;
  readonly valid: boolean;
};

type Escape = { readonly text: string; readonly next: int };

enum TextKind {
  Quoted,
  Template,
  RawTemplate,
}

export class LiteralReader {
  private readonly source: Buffer;

  public constructor(source: Buffer) {
    this.source = source;
  }

  public string(token: Token): DecodedText {
    const quote = this.byteAt(token.start);
    const closing = this.byteAt(token.end - 1);
    const closed = token.end > token.start + 1 && closing == quote;
    const last = closed ? token.end - 1 : token.end;

    return this.decodeText(token.start + 1, last, TextKind.Quoted);
  }

  public templatePart(token: Token): DecodedText {
    const last = this.templateEnd(token);

    return this.decodeText(token.start + 1, last, TextKind.Template);
  }

  public templateRaw(token: Token): string {
    const last = this.templateEnd(token);
    const decoded = this.decodeText(
      token.start + 1,
      last,
      TextKind.RawTemplate,
    );

    return decoded.text;
  }

  public regex(token: Token): RegexText {
    const from = token.start + 1;
    let slash = token.end;
    for (let i = token.end - 1; i >= from; i--) {
      const c = this.byteAt(i);
      if (c == kSlash) {
        slash = i;
        break;
      }
    }
    const pattern = this.source.toString("utf8", from, slash);
    const flagsStart = slash + 1 < token.end ? slash + 1 : token.end;
    const flags = this.source.toString("utf8", flagsStart, token.end);

    return { pattern, flags };
  }

  public integer(token: Token): NumberText {
    const digits = this.digitsOf(token);
    const radix = this.radixOf(digits);
    const from = radix == 10 ? 0 : 2;
    const base = radix.toUint64();
    let value: uint64 = 0;
    for (let i = from; i < digits.length; i++) {
      const c = digits[i] ?? 0;
      const digit = this.digitValue(c, radix);
      if (digit >= radix) {
        return { isInt: true, intValue: 0, doubleValue: 0.0, valid: false };
      }
      const next = this.appendDigit(value, base, digit);
      if (next == undefined) {
        return this.largeInteger(digits, radix, i);
      }
      value = next;
    }

    return { isInt: true, intValue: value, doubleValue: 0.0, valid: true };
  }

  public float(token: Token): NumberText {
    const digits = this.digitsOf(token);
    const text = this.textOfDigits(digits, 0);
    const parsed = Number(text);
    if (parsed.isErr()) {
      return { isInt: false, intValue: 0, doubleValue: 0.0, valid: false };
    }

    return {
      isInt: false,
      intValue: 0,
      doubleValue: parsed.value,
      valid: true,
    };
  }

  private byteAt(i: int): int {
    const value = this.source[i] ?? 0;

    return value.toInt();
  }

  private hexValue(c: int): int {
    if (c >= kZero && c <= kNine) {
      return c - kZero;
    }
    if (c >= kLowerA && c <= kLowerF) {
      return c - kLowerA + 10;
    }
    if (c >= kUpperA && c <= kUpperF) {
      return c - kUpperA + 10;
    }

    return -1;
  }

  private hexEscape(at: int, end: int, count: int): Escape | undefined {
    let value = 0;
    for (let n = 0; n < count; n++) {
      if (at + n >= end) {
        return undefined;
      }
      const c = this.byteAt(at + n);
      const digit = this.hexValue(c);
      if (digit < 0) {
        return undefined;
      }
      value = value * 16 + digit;
    }
    const text = String.fromCharCode(value);

    return { text, next: at + count };
  }

  private unicodeEscape(at: int, end: int): Escape | undefined {
    const open = this.byteAt(at);
    if (at >= end || open != kLeftBrace) {
      return this.hexEscape(at, end, 4);
    }
    let i = at + 1;
    let cp = 0;
    let digits = 0;
    while (i < end) {
      const c = this.byteAt(i);
      const digit = this.hexValue(c);
      if (digit < 0) {
        break;
      }
      cp = cp * 16 + digit;
      i += 1;
      digits += 1;
      if (digits > 6) {
        return undefined;
      }
    }
    const close = this.byteAt(i);
    if (digits == 0 || i >= end || close != kRightBrace) {
      return undefined;
    }
    if (cp < 0 || cp > 0x10ffff) {
      return undefined;
    }
    const text = String.fromCodePoint(cp);

    return { text, next: i + 1 };
  }

  private simpleEscape(c: int): string | undefined {
    if (c == kLowerN) {
      return "\n";
    }
    if (c == kLowerT) {
      return "\t";
    }
    if (c == kLowerR) {
      return "\r";
    }
    if (c == kLowerB) {
      return "\b";
    }
    if (c == kLowerF) {
      return "\f";
    }
    if (c == kLowerV) {
      return "\v";
    }
    if (c == kZero) {
      return "\0";
    }

    return undefined;
  }

  private decodeText(start: int, end: int, kind: TextKind): DecodedText {
    let i = this.plainEnd(start, end, kind);
    const first = this.source.toString("utf8", start, i);
    if (i == end) {
      return { text: first, ok: true };
    }
    const parts: string[] = [first];
    while (i < end) {
      const decoded = this.decodeAt(i, end);
      if (decoded == undefined) {
        const partial = parts.join("");
        return { text: partial, ok: false };
      }
      parts.push(decoded.text);
      const runStart = decoded.next;
      i = this.plainEnd(runStart, end, kind);
      const run = this.source.toString("utf8", runStart, i);
      parts.push(run);
    }
    const text = parts.join("");

    return { text, ok: true };
  }

  private plainEnd(from: int, end: int, kind: TextKind): int {
    let i = from;
    while (i < end && !this.needsDecodingAt(i, kind)) {
      i += 1;
    }

    return i;
  }

  private needsDecodingAt(i: int, kind: TextKind): boolean {
    const c = this.byteAt(i);
    if (kind == TextKind.Quoted) {
      return c == kBackslash;
    }
    if (kind == TextKind.RawTemplate) {
      return c == kReturn;
    }

    return c == kBackslash || c == kReturn;
  }

  private decodeAt(at: int, end: int): Escape | undefined {
    const c = this.byteAt(at);
    if (c == kReturn) {
      const next = this.skipLineFeed(at + 1, end);
      return { text: "\n", next };
    }
    const escaped = at + 1;
    if (escaped >= end) {
      return { text: "", next: end };
    }
    const letter = this.byteAt(escaped);
    const after = escaped + 1;
    const simple = this.simpleEscape(letter);
    if (simple != undefined) {
      return { text: simple, next: after };
    }
    if (letter == kReturn) {
      const next = this.skipLineFeed(after, end);
      return { text: "", next };
    }
    if (letter == kNewline) {
      return { text: "", next: after };
    }
    if (letter == kLowerX) {
      return this.hexEscape(after, end, 2);
    }
    if (letter == kLowerU) {
      return this.unicodeEscape(after, end);
    }
    if (letter < kHigh) {
      const text = String.fromCharCode(letter);
      return { text, next: after };
    }

    return { text: "", next: escaped };
  }

  private skipLineFeed(at: int, end: int): int {
    const c = this.byteAt(at);
    if (at < end && c == kNewline) {
      return at + 1;
    }

    return at;
  }

  private templateEnd(token: Token): int {
    const length = token.end - token.start;
    const beforeLast = this.byteAt(token.end - 2);
    const last = this.byteAt(token.end - 1);
    const interpolation =
      length >= 3 && beforeLast == kDollar && last == kLeftBrace;
    if (interpolation) {
      return token.end - 2;
    }
    if (length >= 2 && last == kBacktick) {
      return token.end - 1;
    }

    return token.end;
  }

  private allDigitsValid(digits: int[], from: int, radix: int): boolean {
    for (let i = from; i < digits.length; i++) {
      const c = digits[i] ?? 0;
      const digit = this.digitValue(c, radix);
      if (digit >= radix) {
        return false;
      }
    }

    return true;
  }

  private appendDigit(
    value: uint64,
    base: uint64,
    digit: int,
  ): uint64 | undefined {
    const product = Bit.mul64(value, base);
    if (product.hi != 0) {
      return undefined;
    }
    const step = digit.toUint64();
    let sum = Bit.Wrap64.from(product.lo);
    sum = sum + step;
    if (sum.value < product.lo) {
      return undefined;
    }

    return sum.value;
  }

  private largeInteger(digits: int[], radix: int, from: int): NumberText {
    if (!this.allDigitsValid(digits, from, radix)) {
      return { isInt: true, intValue: 0, doubleValue: 0.0, valid: false };
    }
    const decimal = this.textOfDigits(digits, 0);
    const prefixed = this.textOfDigits(digits, 1);
    const text = radix == 10 ? decimal : `0${prefixed}`;
    const parsed = Number(text);
    const rounded = parsed.unwrapOr(0.0);

    return { isInt: false, intValue: 0, doubleValue: rounded, valid: true };
  }

  private digitsOf(token: Token): int[] {
    const digits: int[] = [];
    for (let i = token.start; i < token.end; i++) {
      const c = this.byteAt(i);
      if (c != kUnderscore) {
        digits.push(c);
      }
    }

    return digits;
  }

  private radixOf(digits: int[]): int {
    if (digits.length <= 2 || digits[0] != kZero) {
      return 10;
    }
    const marker = digits[1] ?? 0;
    if (marker == kLowerX || marker == kUpperX) {
      return 16;
    }
    if (marker == kLowerB || marker == kUpperB) {
      return 2;
    }
    if (marker == kLowerO || marker == kUpperO) {
      return 8;
    }

    return 10;
  }

  private digitValue(c: int, radix: int): int {
    if (c >= kZero && c <= kNine) {
      return c - kZero;
    }
    const lower = c | 0x20;
    if (lower >= kLowerA && lower <= 122) {
      return lower - kLowerA + 10;
    }

    return radix;
  }

  private textOfDigits(digits: int[], from: int): string {
    const chars: string[] = [];
    for (let i = from; i < digits.length; i++) {
      const c = digits[i] ?? 0;
      const character = String.fromCharCode(c);
      chars.push(character);
    }

    return chars.join("");
  }
}
