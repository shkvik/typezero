import { Code } from "../../../../diagnostic/code.tz";

export type InvalidEscape = { readonly loc: int; readonly code: Code };

export type DecodedText = {
  readonly text: string;
  readonly invalid?: InvalidEscape;
};

export type RegexText = { readonly pattern: string; readonly flags: string };

export type NumberText = {
  readonly isInt: boolean;
  readonly intValue: uint64;
  readonly doubleValue: double;
  readonly beyondDouble: boolean;
  readonly valid: boolean;
};

export type Escape = { readonly text: string; readonly next: int };

export enum TextKind {
  Quoted,
  Template,
  RawTemplate,
}
