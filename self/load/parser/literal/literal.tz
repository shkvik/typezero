import { Code } from "../../../diagnostic/code.tz";
import { Token } from "../../token/types/token.types.tz";
import {
  DecodedText,
  Escape,
  InvalidEscape,
  NumberText,
  RegexText,
  TextKind,
} from "./types/literal.types.tz";
import {
  kBackslash,
  kBacktick,
  kDollar,
  kHigh,
  kLeftBrace,
  kLowerA,
  kLowerB,
  kLowerF,
  kLowerN,
  kLowerO,
  kLowerR,
  kLowerT,
  kLowerU,
  kLowerV,
  kLowerX,
  kLowerZ,
  kMaxCodePoint,
  kMaxCodePointDigits,
  kNewline,
  kNine,
  kRadixPrefixLength,
  kReturn,
  kRightBrace,
  kSlash,
  kUnderscore,
  kUpperA,
  kUpperB,
  kUpperF,
  kUpperO,
  kUpperX,
  kUpperZ,
  kZero,
} from "./const/literal.const.tz";

export class LiteralReader {
  private readonly source: Buffer;

  public constructor(source: Buffer) {
    this.source = source;
  }

  public string(token: Token): DecodedText {
    const quote = this.byteAt(token.start);
    const closing = this.byteAt(token.end - 1);
    const closed = token.end > token.start + 1 && closing == quote;
    let last = token.end;

    if (closed) {
      last -= 1;
    }

    return this.decodeText(token.start + 1, last, TextKind.Quoted);
  }

  public templatePart(token: Token): DecodedText {
    const last = this.templateEnd(token);

    return this.decodeText(token.start + 1, last, TextKind.Template);
  }

  public templateRaw(token: Token): string {
    const last = this.templateEnd(token);
    const decoded = this.decodeText(
      token.start + 1,
      last,
      TextKind.RawTemplate,
    );

    return decoded.text;
  }

  public regex(token: Token): RegexText {
    const from = token.start + 1;
    let slash = token.end;

    for (let i = token.end - 1; i >= from; i--) {
      const code = this.byteAt(i);
      if (code == kSlash) {
        slash = i;

        break;
      }
    }

    const pattern = this.source.toString("utf8", from, slash);
    let flagsStart = token.end;

    if (slash + 1 < token.end) {
      flagsStart = slash + 1;
    }

    const flags = this.source.toString("utf8", flagsStart, token.end);

    return { pattern, flags };
  }

  public integer(token: Token): NumberText {
    const digits = this.digitsOf(token);
    const radix = this.radixOf(digits);
    let prefixLength = kRadixPrefixLength;

    if (radix == 10) {
      prefixLength = 0;
    }

    const base = radix.toUint64();
    let value: uint64 = 0;

    for (let i = prefixLength; i < digits.length; i++) {
      const code = digits[i] ?? 0;
      const digit = this.digitValue(code);
      if (digit == undefined || digit >= radix) {
        return this.invalidInteger();
      }

      const next = this.appendDigit(value, base, digit);
      if (next == undefined) {
        return this.largeInteger(digits, radix, i);
      }

      value = next;
    }

    return {
      isInt: true,
      intValue: value,
      doubleValue: 0.0,
      beyondDouble: false,
      valid: true,
    };
  }

  public float(token: Token): NumberText {
    const digits = this.digitsOf(token);
    const text = this.textOfDigits(digits);

    return this.doubleOf(text);
  }

  private byteAt(i: int): int {
    const value = this.source[i] ?? 0;

    return value.toInt();
  }

  private hexValue(code: int): int | undefined {
    if (code >= kZero && code <= kNine) {
      return code - kZero;
    }
    if (code >= kLowerA && code <= kLowerF) {
      return code - kLowerA + 10;
    }
    if (code >= kUpperA && code <= kUpperF) {
      return code - kUpperA + 10;
    }

    return undefined;
  }

  private hexEscape(at: int, end: int, count: int): Escape | undefined {
    let value = 0;

    for (let index = 0; index < count; index++) {
      if (at + index >= end) {
        return undefined;
      }

      const code = this.byteAt(at + index);
      const digit = this.hexValue(code);
      if (digit == undefined) {
        return undefined;
      }

      value = value * 16 + digit;
    }

    const text = String.fromCharCode(value);

    return { text, next: at + count };
  }

  private unicodeEscape(at: int, end: int): Escape | undefined {
    const open = this.byteAt(at);
    if (at >= end || open != kLeftBrace) {
      return this.hexEscape(at, end, 4);
    }

    let i = at + 1;
    let codePoint = 0;
    let digits = 0;

    while (i < end) {
      const code = this.byteAt(i);
      const digit = this.hexValue(code);
      if (digit == undefined) {
        break;
      }

      codePoint = codePoint * 16 + digit;
      i += 1;
      digits += 1;
      if (digits > kMaxCodePointDigits) {
        return undefined;
      }
    }

    const close = this.byteAt(i);
    if (digits == 0 || i >= end || close != kRightBrace) {
      return undefined;
    }
    if (codePoint < 0 || codePoint > kMaxCodePoint) {
      return undefined;
    }

    const text = String.fromCodePoint(codePoint);

    return { text, next: i + 1 };
  }

  private simpleEscape(code: int): string | undefined {
    switch (code) {
      case kLowerN:
        return "\n";
      case kLowerT:
        return "\t";
      case kLowerR:
        return "\r";
      case kLowerB:
        return "\b";
      case kLowerF:
        return "\f";
      case kLowerV:
        return "\v";
      case kZero:
        return "\0";
      default:
        return undefined;
    }
  }

  private decodeText(start: int, end: int, kind: TextKind): DecodedText {
    let i = this.plainEnd(start, end, kind);
    const first = this.source.toString("utf8", start, i);

    if (i == end) {
      return { text: first };
    }

    const parts: string[] = [first];

    while (i < end) {
      const decoded = this.decodeAt(i, end);
      if (decoded == undefined) {
        const partial = parts.join("");
        const invalid = this.invalidEscape(i);

        return { text: partial, invalid };
      }

      parts.push(decoded.text);
      const runStart = decoded.next;

      i = this.plainEnd(runStart, end, kind);
      const run = this.source.toString("utf8", runStart, i);

      parts.push(run);
    }

    const text = parts.join("");

    return { text };
  }

  private invalidEscape(at: int): InvalidEscape {
    const letter = this.byteAt(at + 1);
    if (letter == kLowerX) {
      return { loc: at, code: Code.InvalidHexEscape };
    }

    return { loc: at, code: Code.InvalidUnicodeEscape };
  }

  private plainEnd(from: int, end: int, kind: TextKind): int {
    let i = from;

    while (i < end && !this.needsDecodingAt(i, kind)) {
      i += 1;
    }

    return i;
  }

  private needsDecodingAt(i: int, kind: TextKind): boolean {
    const code = this.byteAt(i);

    if (kind == TextKind.Quoted) {
      return code == kBackslash;
    }
    if (kind == TextKind.RawTemplate) {
      return code == kReturn;
    }

    return code == kBackslash || code == kReturn;
  }

  private decodeAt(at: int, end: int): Escape | undefined {
    const code = this.byteAt(at);
    if (code == kReturn) {
      const next = this.skipLineFeed(at + 1, end);

      return { text: "\n", next };
    }

    const escaped = at + 1;
    if (escaped >= end) {
      return { text: "", next: end };
    }

    const letter = this.byteAt(escaped);
    const after = escaped + 1;

    switch (letter) {
      case kLowerX:
        return this.hexEscape(after, end, 2);
      case kLowerU:
        return this.unicodeEscape(after, end);
      case kReturn: {
        const next = this.skipLineFeed(after, end);

        return { text: "", next };
      }
      case kNewline:
        return { text: "", next: after };
      default:
        return this.plainEscape(letter, escaped);
    }
  }

  private plainEscape(letter: int, escaped: int): Escape {
    const after = escaped + 1;
    const simple = this.simpleEscape(letter);
    if (simple != undefined) {
      return { text: simple, next: after };
    }
    if (letter < kHigh) {
      const text = String.fromCharCode(letter);

      return { text, next: after };
    }

    return { text: "", next: escaped };
  }

  private skipLineFeed(at: int, end: int): int {
    const code = this.byteAt(at);
    if (at < end && code == kNewline) {
      return at + 1;
    }

    return at;
  }

  private templateEnd(token: Token): int {
    const length = token.end - token.start;
    const beforeLast = this.byteAt(token.end - 2);
    const last = this.byteAt(token.end - 1);
    const interpolation =
      length >= 3 && beforeLast == kDollar && last == kLeftBrace;
    if (interpolation) {
      return token.end - 2;
    }
    if (length >= 2 && last == kBacktick) {
      return token.end - 1;
    }

    return token.end;
  }

  private allDigitsValid(digits: int[], from: int, radix: int): boolean {
    for (let i = from; i < digits.length; i++) {
      const code = digits[i] ?? 0;
      const digit = this.digitValue(code);
      if (digit == undefined || digit >= radix) {
        return false;
      }
    }

    return true;
  }

  private appendDigit(
    value: uint64,
    base: uint64,
    digit: int,
  ): uint64 | undefined {
    const product = Bit.mul64(value, base);
    if (product.hi != 0) {
      return undefined;
    }

    const step = digit.toUint64();
    let sum = Bit.Wrap64.from(product.lo);

    sum = sum + step;
    if (sum.value < product.lo) {
      return undefined;
    }

    return sum.value;
  }

  private largeInteger(digits: int[], radix: int, from: int): NumberText {
    if (!this.allDigitsValid(digits, from, radix)) {
      return this.invalidInteger();
    }

    const text = this.textOfDigits(digits);

    return this.doubleOf(text);
  }

  private invalidInteger(): NumberText {
    return {
      isInt: true,
      intValue: 0,
      doubleValue: 0.0,
      beyondDouble: false,
      valid: false,
    };
  }

  private doubleOf(text: string): NumberText {
    const parsed = Number(text);
    const beyondDouble = parsed.isErr();
    const doubleValue = parsed.unwrapOr(0.0);

    return {
      isInt: false,
      intValue: 0,
      doubleValue,
      beyondDouble,
      valid: true,
    };
  }

  private digitsOf(token: Token): int[] {
    const digits: int[] = [];

    for (let i = token.start; i < token.end; i++) {
      const code = this.byteAt(i);
      if (code != kUnderscore) {
        digits.push(code);
      }
    }

    return digits;
  }

  private radixOf(digits: int[]): int {
    if (digits.length <= kRadixPrefixLength || digits[0] != kZero) {
      return 10;
    }

    const marker = digits[1] ?? 0;
    if (marker == kLowerX || marker == kUpperX) {
      return 16;
    }
    if (marker == kLowerB || marker == kUpperB) {
      return 2;
    }
    if (marker == kLowerO || marker == kUpperO) {
      return 8;
    }

    return 10;
  }

  private digitValue(code: int): int | undefined {
    if (code >= kZero && code <= kNine) {
      return code - kZero;
    }
    if (code >= kLowerA && code <= kLowerZ) {
      return code - kLowerA + 10;
    }
    if (code >= kUpperA && code <= kUpperZ) {
      return code - kUpperA + 10;
    }

    return undefined;
  }

  private textOfDigits(digits: int[]): string {
    const chars: string[] = [];

    for (const code of digits) {
      const character = String.fromCharCode(code);

      chars.push(character);
    }

    return chars.join("");
  }
}
