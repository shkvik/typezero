import { Code } from "../../../diagnostic/code.tz";
import {
  Details,
  SourceError,
} from "../../../diagnostic/types/message.types.tz";
import { SourceLines } from "../../../program/source-lines/source-lines.tz";
import { Token, TokenKind } from "../../token/types/token.types.tz";
import { LeftBlock } from "./types/open-blocks.types.tz";

export class OpenBlocks {
  private readonly tokens: readonly Token[];
  private readonly lines: SourceLines;
  private readonly closedBefore: int[];

  public constructor(source: Own<Buffer>, tokens: readonly Token[]) {
    this.tokens = tokens;
    this.lines = new SourceLines(source);
    this.closedBefore = [];
  }

  public explain(errors: Own<SourceError[]>): SourceError[] {
    if (errors.length == 0) {
      return errors;
    }

    const placed = this.withBlocksBeforeElse(errors);
    const named = placed.map((error) => this.withOpeningLine(error));
    const unterminated = named.find((error) => this.takesBraces(error));
    if (unterminated != undefined) {
      return this.upToUnterminated(unterminated, named);
    }

    const left = this.leftBlock();
    if (left != undefined && !this.reportedInside(left, named)) {
      return this.upToLeftBlock(left, named);
    }

    return named;
  }

  private readonly upToUnterminated(
    unterminated: SourceError,
    errors: Read<SourceError[]>,
  ): SourceError[] {
    const loc = unterminated.loc;
    const earlier = errors.filter((error) => error.loc < loc);
    const substitution = errors.find((error) => this.closesSubstitution(error));
    const template = unterminated.code == Code.UnterminatedTemplate;
    if (!template || substitution == undefined) {
      return earlier.concat([unterminated]);
    }
    if (substitution.loc < loc) {
      return earlier;
    }

    const moved: SourceError = {
      code: substitution.code,
      loc,
      details: substitution.details,
    };

    return earlier.concat([moved]);
  }

  private readonly closesSubstitution(error: SourceError): boolean {
    return error.code == Code.ExpectedSubstitutionClose;
  }

  private readonly takesBraces(error: SourceError): boolean {
    switch (error.code) {
      case Code.UnterminatedComment:
      case Code.UnterminatedTemplate:
        return true;
      default:
        return false;
    }
  }

  private readonly reportedInside(left: LeftBlock, errors: Read<SourceError[]>): boolean {
    const from = this.startOf(left.block);
    const to = this.startOf(left.at);

    return errors.some((error) => error.loc >= from && error.loc < to);
  }

  private readonly upToLeftBlock(left: LeftBlock, errors: Read<SourceError[]>): SourceError[] {
    const loc = this.startOf(left.at);
    const line = this.lineOf(left.block);
    const earlier = errors.filter((error) => error.loc < loc);
    const notClosed: SourceError = {
      code: Code.BlockNotClosed,
      loc,
      details: { word: `${line}` },
    };

    return earlier.concat([notClosed]);
  }

  private withBlocksBeforeElse(errors: Read<SourceError[]>): SourceError[] {
    const placed: SourceError[] = [];

    for (const error of errors) {
      const explained = this.withBlockBeforeElse(error);

      placed.push(explained);
    }

    return placed;
  }

  private withBlockBeforeElse(error: SourceError): SourceError {
    if (error.code != Code.BlockNotClosedBeforeElse) {
      return error;
    }

    const loc = error.loc;
    const word = this.tokens.findIndex((token) => token.start == loc);
    const line = this.openingLine(loc, TokenKind.LBrace);

    this.closedBefore.push(word);

    return { code: error.code, loc, details: { word: `${line}` } };
  }

  private readonly withOpeningLine(error: SourceError): SourceError {
    const opener = this.openerOf(error.details.expected);
    if (opener == undefined) {
      return error;
    }

    const line = this.openingLine(error.loc, opener);
    const details: Details = { ...error.details, word: `${line}` };

    return { code: error.code, loc: error.loc, details };
  }

  private readonly openerOf(closer: TokenKind | undefined): TokenKind | undefined {
    switch (closer) {
      case TokenKind.RBrace:
        return TokenKind.LBrace;
      case TokenKind.RParen:
        return TokenKind.LParen;
      case TokenKind.RBracket:
        return TokenKind.LBracket;
      default:
        return undefined;
    }
  }

  private readonly openingLine(loc: int, opener: TokenKind): int {
    const opening = this.openingBefore(loc, opener);
    if (opening == undefined) {
      const place = this.lines.placeOf(loc);

      return place.line;
    }

    return this.lineOf(opening);
  }

  private readonly openingBefore(loc: int, opener: TokenKind): int | undefined {
    if (opener == TokenKind.LBrace) {
      return this.blockBefore(loc);
    }

    return this.groupBefore(loc, opener);
  }

  private readonly blockBefore(loc: int): int | undefined {
    const tokens = this.tokens;
    const open: int[] = [];

    for (let index = 0; index < tokens.length; index++) {
      const token = tokens[index];
      if (token.start >= loc) {
        break;
      }

      this.follow(open, index, token.kind);
    }

    return open[open.length - 1];
  }

  private readonly groupBefore(loc: int, opener: TokenKind): int | undefined {
    const tokens = this.tokens;
    const open: int[] = [];

    for (let index = 0; index < tokens.length; index++) {
      const token = tokens[index];
      if (token.start >= loc) {
        break;
      }

      this.followGroups(open, index, token.kind);
    }

    const depth = this.depthOf(open, opener);

    return open[depth];
  }

  private readonly followGroups(open: int[], index: int, kind: TokenKind): void {
    switch (kind) {
      case TokenKind.LBrace:
      case TokenKind.LParen:
      case TokenKind.LBracket:
        open.push(index);
        break;
      case TokenKind.RBrace:
      case TokenKind.RParen:
      case TokenKind.RBracket:
        this.closeGroup(open, kind);
        break;
      default:
        break;
    }
  }

  private readonly closeGroup(open: int[], closer: TokenKind): void {
    const opener = this.openerOf(closer);
    if (opener == undefined) {
      return;
    }

    const depth = this.depthOf(open, opener);
    if (depth < 0) {
      return;
    }

    while (open.length > depth) {
      open.pop();
    }
  }

  private readonly depthOf(open: Read<int[]>, opener: TokenKind): int {
    for (let depth = open.length - 1; depth >= 0; depth--) {
      const index = open[depth];
      if (index != undefined && this.kindOf(index) == opener) {
        return depth;
      }
    }

    return -1;
  }

  private readonly leftBlock(): LeftBlock | undefined {
    const tokens = this.tokens;
    const open: int[] = [];
    const left: LeftBlock[] = [];

    for (let index = 0; index < tokens.length; index++) {
      const token = tokens[index];
      if (token.newline && this.leavesBlock(open, index, token.kind)) {
        const block = open[open.length - 1] ?? 0;

        left.push({ block, at: index });
      }

      this.follow(open, index, token.kind);
    }

    if (open.length == 0) {
      return undefined;
    }

    return left[0];
  }

  private readonly follow(open: int[], index: int, kind: TokenKind): void {
    if (this.closedBefore.includes(index)) {
      open.pop();
    }

    switch (kind) {
      case TokenKind.LBrace:
        open.push(index);
        break;
      case TokenKind.RBrace:
        open.pop();
        break;
      default:
        break;
    }
  }

  private readonly leavesBlock(open: Read<int[]>, index: int, kind: TokenKind): boolean {
    switch (kind) {
      case TokenKind.End:
        return false;
      case TokenKind.RBrace: {
        const parent = open[open.length - 2];

        return this.columnOf(index) < this.contentColumn(parent);
      }
      default: {
        const block = open[open.length - 1];

        return this.columnOf(index) < this.contentColumn(block);
      }
    }
  }

  private readonly contentColumn(block: int | undefined): int {
    if (block == undefined) {
      return 0;
    }

    const first = block + 1;
    if (!this.startsLine(first)) {
      return 0;
    }

    return this.columnOf(first);
  }

  private readonly startsLine(index: int): boolean {
    const token = this.tokens[index];

    return token != undefined && token.newline;
  }

  private readonly kindOf(index: int): TokenKind {
    const token = this.tokens[index];
    if (token == undefined) {
      return TokenKind.End;
    }

    return token.kind;
  }

  private readonly startOf(index: int): int {
    const token = this.tokens[index];
    if (token == undefined) {
      return 0;
    }

    return token.start;
  }

  private readonly columnOf(index: int): int {
    const start = this.startOf(index);
    const place = this.lines.placeOf(start);

    return place.column;
  }

  private readonly lineOf(index: int): int {
    const start = this.startOf(index);
    const place = this.lines.placeOf(start);

    return place.line;
  }
}
