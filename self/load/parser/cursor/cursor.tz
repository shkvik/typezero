import { replace } from "tz:mem";
import { KnownName, Token, TokenKind } from "../../token/types/token.types.tz";
import { kTokenTable } from "../../token/const/token.const.tz";
import { Span } from "../../../program/ast/types/ast.types.span.tz";
import { Code } from "../../../diagnostic/code.tz";
import {
  Details,
  SourceError,
} from "../../../diagnostic/types/message.types.tz";
import { kNoDetails } from "../../../diagnostic/const/message.const.tz";
import { Mark } from "./types/cursor.types.tz";
import { kEnd, kNotResumed } from "./const/cursor.const.tz";

export class Cursor {
  private readonly tokens: readonly Token[];
  private at: int;
  private recovering: boolean;
  private discarding: int;
  private resumedAt: int;
  public errors: SourceError[];

  public constructor(tokens: readonly Token[]) {
    this.tokens = tokens;
    this.at = 0;
    this.recovering = false;
    this.discarding = 0;
    this.resumedAt = kNotResumed;
    this.errors = [];
  }

  public readonly peek(): Token {
    return this.tokens[this.at] ?? this.last();
  }

  public readonly lookahead(): Token {
    return this.tokens[this.at + 1] ?? this.last();
  }

  public readonly tokenAt(offset: int): Token {
    return this.tokens[this.at + offset] ?? this.last();
  }

  public next(): Token {
    const token = this.peek();

    this.at += 1;

    return token;
  }

  public skip(count: int): void {
    for (let i = 0; i < count; i++) {
      this.next();
    }
  }

  public readonly is(kind: TokenKind): boolean {
    const token = this.peek();

    return token.kind == kind;
  }

  public readonly atName(): boolean {
    const token = this.peek();

    return kTokenTable.isName(token.kind);
  }

  public accept(kind: TokenKind): boolean {
    if (!this.is(kind)) {
      return false;
    }

    this.next();

    return true;
  }

  public expect(kind: TokenKind, code: Code): boolean {
    if (this.accept(kind)) {
      return true;
    }

    const token = this.peek();

    this.error(token.start, code, { expected: kind, found: token.kind });

    return false;
  }

  public readonly insideList(close: TokenKind): boolean {
    return !this.is(close) && !this.is(TokenKind.End);
  }

  public readonly atNameOrThis(): boolean {
    return this.atName() || this.is(TokenKind.This);
  }

  public expectName(code: Code): boolean {
    if (!this.atName()) {
      return this.expect(TokenKind.Identifier, code);
    }

    this.next();

    return true;
  }

  public expectSemicolon(): void {
    if (this.accept(TokenKind.Semi)) {
      return;
    }

    const token = this.peek();
    if (
      token.kind == TokenKind.RBrace ||
      token.kind == TokenKind.End ||
      token.newline
    ) {
      return;
    }

    const details: Details = { expected: TokenKind.Semi, found: token.kind };

    if (this.startsAction()) {
      this.resumeAfterStatement(token.start, details);

      return;
    }
    if (this.resumedOnLine()) {
      this.recovering = true;

      return;
    }

    this.error(token.start, Code.ExpectedSemicolon, details);
  }

  public readonly spanFrom(start: int): Span {
    const end = this.previousEnd();

    if (end > start) {
      return { start, end };
    }

    return { start, end: start };
  }

  public error(loc: int, code: Code, details: Details = kNoDetails): void {
    if (this.recovering) {
      return;
    }

    this.recovering = true;
    if (!this.reportedAt(loc) && !this.followsReport()) {
      this.record(loc, code, details);
    }
  }

  public reportLexical(loc: int, code: Code): void {
    if (!this.reportedAt(loc)) {
      this.record(loc, code, kNoDetails);
    }
  }

  public takeErrors(): SourceError[] {
    return replace(this.errors, []);
  }

  public report(loc: int, code: Code, details: Details = kNoDetails): void {
    if (!this.recovering) {
      this.record(loc, code, details);
    }
  }

  public readonly isRecovering(): boolean {
    return this.recovering;
  }

  public stopRecovering(): void {
    this.recovering = false;
  }

  public restoreRecovering(mark: Mark): void {
    this.recovering = mark.recovering;
  }

  public startDiscarding(): void {
    this.discarding += 1;
  }

  public stopDiscarding(): void {
    this.discarding -= 1;
  }

  public readonly mark(): Mark {
    return { at: this.at, recovering: this.recovering };
  }

  public reset(mark: Mark): void {
    this.at = mark.at;
    this.recovering = mark.recovering;
  }

  public readonly onlyOpenParens(from: int, to: int): boolean {
    if (from < 0) {
      return false;
    }

    const tokens = this.tokens;

    for (let index = this.at - 1; index >= 0; index--) {
      const token = tokens[index];
      if (token == undefined || token.start < from) {
        break;
      }
      if (token.start < to && token.kind != TokenKind.LParen) {
        return false;
      }
    }

    return true;
  }

  public readonly symbolKeyAhead(): boolean {
    const next = this.lookahead();

    return this.is(TokenKind.LBracket) && next.known == KnownName.Symbol;
  }

  public synchronize(): void {
    this.recovering = false;

    while (!this.is(TokenKind.End) && !this.is(TokenKind.RBrace)) {
      if (this.accept(TokenKind.Semi)) {
        return;
      }

      const token = this.peek();
      if (token.newline && this.startsStatement()) {
        return;
      }

      const block = this.skipTokenOrBlock();
      if (block && this.lineEnded()) {
        return;
      }
    }
  }

  public readonly statementEnded(): boolean {
    const last = this.tokens[this.at - 1];
    const next = this.peek();
    const closed =
      last?.kind == TokenKind.Semi || last?.kind == TokenKind.RBrace;

    return closed && next.newline;
  }

  public recoverStatement(start: Mark): void {
    if (this.at == start.at) {
      this.next();
    }

    let unclosed = this.unclosedBraces(start.at);
    const ended = this.statementEnded() || this.endedBySemicolon(start.at);
    if (unclosed == 0 && ended) {
      this.recovering = false;

      return;
    }

    this.synchronize();

    while (unclosed > 0 && this.accept(TokenKind.RBrace)) {
      unclosed -= 1;
      if (unclosed == 0 && this.lineEnded()) {
        return;
      }

      this.synchronize();
    }
  }

  public skipToClosingParen(): void {
    let depth = 0;

    while (!this.is(TokenKind.End) && !this.is(TokenKind.RBrace)) {
      const token = this.next();

      switch (token.kind) {
        case TokenKind.LParen:
          depth += 1;
          break;
        case TokenKind.RParen:
          if (depth == 0) {
            return;
          }
          depth -= 1;
          break;
        case TokenKind.LBrace:
          this.skipToClosingBrace();
          break;
      }
    }
  }

  public readonly bracesMissing(): boolean {
    let unclosed = 0;

    for (const token of this.tokens) {
      switch (token.kind) {
        case TokenKind.LBrace:
          unclosed += 1;
          break;
        case TokenKind.RBrace:
          unclosed -= 1;
          break;
      }
    }

    return unclosed > 0;
  }

  public skipBracketed(): void {
    this.next();
    this.skipToClosingBracket();
  }

  public skipToClosingBracket(): void {
    let depth = 0;

    while (!this.is(TokenKind.End) && !this.is(TokenKind.RBrace)) {
      const token = this.next();
      const after = this.peek();

      switch (token.kind) {
        case TokenKind.LBracket:
          depth += 1;
          break;
        case TokenKind.RBracket:
          depth -= 1;
          break;
      }

      if (depth < 0 || after.newline) {
        return;
      }
    }
  }

  public skipTo(kind: TokenKind): void {
    while (!this.is(kind) && !this.is(TokenKind.End)) {
      this.next();
    }
  }

  public skipToListClose(): void {
    let depth = 0;

    while (!this.is(TokenKind.End)) {
      const ahead = this.peek();
      if (depth == 0 && ahead.newline && this.startsStatement()) {
        return;
      }

      const token = this.next();

      switch (token.kind) {
        case TokenKind.LBrace:
          depth += 1;
          break;
        case TokenKind.RBrace:
          depth -= 1;
          break;
      }

      if (depth < 0) {
        return;
      }
    }
  }

  public skipToClosingBrace(): void {
    let depth = 0;

    while (!this.is(TokenKind.End)) {
      const token = this.next();

      switch (token.kind) {
        case TokenKind.LBrace:
          depth += 1;
          break;
        case TokenKind.RBrace:
          if (depth == 0) {
            return;
          }
          depth -= 1;
          break;
      }
    }
  }

  private skipTokenOrBlock(): boolean {
    if (this.accept(TokenKind.LBrace)) {
      this.skipToClosingBrace();

      return true;
    }

    this.next();

    return false;
  }

  private readonly lineEnded(): boolean {
    const next = this.peek();

    switch (next.kind) {
      case TokenKind.Else:
      case TokenKind.Catch:
      case TokenKind.Finally:
        return false;
      default:
        return next.newline;
    }
  }

  private readonly endedBySemicolon(from: int): boolean {
    const last = this.tokens[this.at - 1];

    return last?.kind == TokenKind.Semi && this.unclosedGroups(from) == 0;
  }

  private readonly unclosedGroups(from: int): int {
    let unclosed = 0;

    for (let index = from; index < this.at; index++) {
      const token = this.tokens[index];

      switch (token?.kind) {
        case TokenKind.LParen:
        case TokenKind.LBracket:
          unclosed += 1;
          break;
        case TokenKind.RParen:
        case TokenKind.RBracket:
          if (unclosed > 0) {
            unclosed -= 1;
          }
          break;
      }
    }

    return unclosed;
  }

  private readonly unclosedBraces(from: int): int {
    let unclosed = 0;

    for (let index = from; index < this.at; index++) {
      const token = this.tokens[index];

      switch (token?.kind) {
        case TokenKind.LBrace:
          unclosed += 1;
          break;
        case TokenKind.RBrace:
          if (unclosed > 0) {
            unclosed -= 1;
          }
          break;
      }
    }

    return unclosed;
  }

  private readonly reportedAt(loc: int): boolean {
    const last = this.errors[this.errors.length - 1];

    return last != undefined && last.loc == loc;
  }

  private readonly followsReport(): boolean {
    const last = this.errors[this.errors.length - 1];
    const previous = this.tokens[this.at - 1];
    if (last == undefined || previous == undefined) {
      return false;
    }

    return last.loc >= previous.start;
  }

  private readonly previousEnd(): int {
    const previous = this.tokens[this.at - 1];

    if (previous == undefined) {
      return 0;
    }

    return previous.end;
  }

  private readonly startsStatement(): boolean {
    const token = this.peek();

    switch (token.kind) {
      case TokenKind.Let:
      case TokenKind.Const:
      case TokenKind.Var:
      case TokenKind.Function:
      case TokenKind.If:
      case TokenKind.While:
      case TokenKind.Do:
      case TokenKind.For:
      case TokenKind.Switch:
      case TokenKind.Case:
      case TokenKind.Default:
      case TokenKind.Enum:
      case TokenKind.Return:
      case TokenKind.Break:
      case TokenKind.Continue:
      case TokenKind.Debugger:
      case TokenKind.Import:
      case TokenKind.Export:
      case TokenKind.Throw:
      case TokenKind.Try:
        return true;
      case TokenKind.Class:
      case TokenKind.Type:
      case TokenKind.Interface:
      case TokenKind.Namespace:
      case TokenKind.Module:
      case TokenKind.Declare:
        return this.namesAhead();
      default:
        return false;
    }
  }

  private resumeAfterStatement(loc: int, details: Details): void {
    if (this.recovering || this.followsReport()) {
      return;
    }

    this.record(loc, Code.ExpectedSemicolon, details);
    this.resumedAt = loc;
  }

  private readonly resumedOnLine(): boolean {
    const last = this.errors[this.errors.length - 1];
    if (last == undefined || last.loc != this.resumedAt) {
      return false;
    }

    for (let index = this.at; index >= 0; index--) {
      const token = this.tokens[index];
      if (token == undefined || token.start <= last.loc) {
        return true;
      }
      if (token.newline) {
        return false;
      }
    }

    return true;
  }

  private readonly startsAction(): boolean {
    const next = this.lookahead();
    if (!this.atName() || next.newline) {
      return false;
    }

    switch (next.kind) {
      case TokenKind.Assign:
      case TokenKind.LParen:
      case TokenKind.Dot:
      case TokenKind.PlusPlus:
      case TokenKind.MinusMinus:
        return true;
      default:
        return false;
    }
  }

  private readonly namesAhead(): boolean {
    const next = this.lookahead();

    return kTokenTable.isName(next.kind) && !next.newline;
  }

  private readonly last(): Token {
    return this.tokens[this.tokens.length - 1] ?? kEnd;
  }

  private record(loc: int, code: Code, details: Details): void {
    if (this.discarding == 0) {
      this.errors.push({ code, loc, details });
    }
  }
}
