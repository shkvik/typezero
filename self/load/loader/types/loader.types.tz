import { SourceError } from "../../../diagnostic/types/message.types.tz";
import { ModulePath } from "../../../program/ast/types/ast.types.modules.tz";
import {
  ModuleLink,
  Program,
} from "../../../program/module/types/module.types.tz";
import {
  DeclaredClass,
} from "../../../program/syntax/types/syntax.types.declarations.tz";
import {
  ParsedDeclaration,
  ParsedFile,
} from "../../../program/syntax/types/syntax.types.files.tz";
import {
  ImportDecl,
} from "../../../program/syntax/types/syntax.types.modules.tz";

export enum ModuleState {
  New,
  Loading,
  Loaded,
}

export type OpenModule = {
  readonly id: int;
  readonly name: string;
  readonly file: string;
  readonly parsed: ParsedFile;
  readonly declaration?: ParsedDeclaration;
  readonly links: ModuleLink[];
  readonly implicit: readonly ImportDecl[];
  readonly partItems: int[];
  readonly isDeclarationOnly: boolean;
  readonly declared: readonly DeclaredClass[];
  readonly problems: SourceError[];
  state: ModuleState;
};

export type Request = {
  readonly owner: int;
  readonly from: ModulePath;
  readonly names: readonly string[];
  readonly isImplicit: boolean;
};

export type Overlay = {
  readonly path: string;
  readonly textFile: string;
};

export type LoadResult = {
  readonly program: Program;
  readonly unreadable: string[];
  readonly packageErrors: string[];
};
