import { SourceError } from "../../../diagnostic/types/message.types.tz";
import { ClassDecl } from "../../../program/ast/types/ast.types.classes.tz";
import { DeclaredClass } from "../../../program/ast/types/ast.types.declarations.tz";
import {
  ImportDecl,
  ModulePath,
} from "../../../program/ast/types/ast.types.modules.tz";
import {
  ModuleLink,
  ParsedDeclaration,
  ParsedFile,
  Program,
} from "../../../program/module/types/module.types.tz";

export enum ModuleState {
  New,
  Loading,
  Loaded,
}

export type OpenModule = {
  readonly id: int;
  readonly name: string;
  readonly file: string;
  readonly parsed: ParsedFile;
  readonly declaration?: ParsedDeclaration;
  readonly links: ModuleLink[];
  readonly implicit: ImportDecl[];
  readonly parts: ClassDecl[];
  readonly isDeclarationOnly: boolean;
  readonly declared: DeclaredClass[];
  readonly problems: SourceError[];
  state: ModuleState;
};

export type Request = {
  readonly from: ModulePath;
  readonly isImplicit: boolean;
};

export type LoadResult = {
  readonly program: Program;
  readonly unreadable: string[];
};
