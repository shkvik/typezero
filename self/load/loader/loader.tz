import { replace } from "tz:mem";
import "./partial/loader.partial.files.tz";
import "./partial/loader.partial.library.tz";
import { basename, dirname } from "node:path";
import { SourceError } from "../../diagnostic/types/message.types.tz";
import {
  ModuleName,
  ModulePath,
} from "../../program/ast/types/ast.types.modules.tz";
import {
  Stmt,
  StmtKind,
} from "../../program/ast/types/ast.types.statements.tz";
import {
  LinkKind,
  Module,
  ModuleLink,
} from "../../program/module/types/module.types.tz";
import { LibraryMentions } from "../library-mentions/library-mentions.tz";
import { ManifestReader } from "../manifest-reader/manifest-reader.tz";
import { ModuleResolver } from "../module-resolver/module-resolver.tz";
import { ResolutionKind } from "../module-resolver/types/module-resolver.types.tz";
import { PackageGraph } from "../package-graph/package-graph.tz";
import { Parser } from "../parser/parser.tz";
import { PartialClasses } from "../partial-classes/partial-classes.tz";
import {
  LoadResult,
  ModuleState,
  OpenModule,
  Overlay,
  Request,
} from "./types/loader.types.tz";

export class Loader {
  private readonly entryPath: string;
  private readonly entryDirectory: string;
  private readonly libraryDirectory: string;
  private readonly parser: Parser;
  private readonly resolver: ModuleResolver;
  private readonly mentions: LibraryMentions;
  private readonly opened: OpenModule[];
  private readonly byFile: Map<string, int>;
  private readonly libraries: Map<string, int>;
  private readonly order: OpenModule[];
  private unreadable: string[];
  private packageErrors: string[];
  private readonly packageOf: Map<int, int>;
  private readonly overlays: Map<string, string>;
  private readonly isBuilt: boolean;

  public constructor(
    entryPath: string,
    libraryDirectory: string,
    overlays: Read<Overlay[]>,
    isBuilt: boolean,
  ) {
    const entryDirectory = dirname(entryPath);
    const reader = new ManifestReader();
    const packages = new PackageGraph(reader);

    packages.build(entryDirectory);

    this.entryPath = entryPath;
    this.entryDirectory = entryDirectory;
    this.libraryDirectory = libraryDirectory;
    this.parser = new Parser([]);
    this.packageErrors = packages.errors();
    this.resolver = new ModuleResolver(packages);
    this.packageOf = new Map<int, int>();
    this.mentions = new LibraryMentions();
    this.opened = [];
    this.byFile = new Map<string, int>();
    this.libraries = new Map<string, int>();
    this.order = [];
    this.unreadable = [];
    this.overlays = new Map<string, string>();
    this.isBuilt = isBuilt;

    for (const overlay of overlays) {
      const key = this.keyOf(overlay.path);

      this.overlays.set(key, overlay.textFile);
    }
  }

  public run(): LoadResult {
    const key = this.keyOf(this.entryPath);
    const name = basename(this.entryPath);
    const entry = this.open(this.entryPath, key, name, this.entryPath);
    if (entry != undefined) {
      this.visit(entry);
    }

    const reached = this.opened.length;
    const globalIds = this.loadGlobals();

    if (this.isBuilt) {
      this.loadRuntime();
    }
    const parts = new PartialClasses(this.order.slice());

    parts.join();

    const order = this.order.map((module) => this.finished(module));
    const modules = order.slice();

    modules.sort((first, second) => first.id - second.id);

    const globals = order.filter((module) => globalIds.includes(module.id));
    const ambient = order.filter(
      (module) => module.id >= reached || globalIds.includes(module.id),
    );
    const builtins = this.builtins();

    return {
      program: { modules, order, globals, ambient, builtins },
      unreadable: replace(this.unreadable, []),
      packageErrors: replace(this.packageErrors, []),
    };
  }

  private visit(module: Own<OpenModule>): void {
    module.state = ModuleState.Loading;

    const requests = this.requests(module);

    for (let index = 0; index < requests.length; index++) {
      const request = requests[index];
      const target = this.linkedTarget(request);
      if (target == undefined) {
        continue;
      }
      if (target.state == ModuleState.New) {
        this.visit(target);
      }

      const asked = this.askedRequests(target, request.names);

      for (const one of asked) {
        requests.push(one);
      }
    }

    module.state = ModuleState.Loaded;
    this.order.push(module);
  }

  private linkedTarget(request: Request): OpenModule | undefined {
    const link = this.linked(request);

    request.owner.links.push(link);
    if (link.kind != LinkKind.Module) {
      return undefined;
    }

    return this.opened[link.target];
  }

  private readonly requests(module: Own<OpenModule>): Request[] {
    const file = module.parsed.file;
    const requests: Request[] = [];

    for (const decl of file.imports) {
      const names = this.askedNames(decl.names);

      requests.push({
        owner: module,
        from: decl.from,
        names,
        isImplicit: false,
      });
    }

    for (const decl of file.exports) {
      const from = decl.from;
      if (from != undefined && !module.isDeclarationOnly) {
        const names = this.askedNames(decl.names);

        requests.push({ owner: module, from, names, isImplicit: false });
      }
    }

    for (const decl of module.implicit) {
      const names = this.askedNames(decl.names);

      requests.push({
        owner: module,
        from: decl.from,
        names,
        isImplicit: true,
      });
    }

    requests.sort((first, second) => first.from.loc - second.from.loc);

    return requests;
  }

  private readonly askedRequests(module: Own<OpenModule>, names: Read<string[]>): Request[] {
    const requests: Request[] = [];

    if (!module.isDeclarationOnly) {
      return requests;
    }

    for (const decl of module.parsed.file.exports) {
      const from = decl.from;
      if (from == undefined || this.isLinked(module, from)) {
        continue;
      }

      const asked = decl.names.filter((name) => names.includes(name.as));
      if (asked.length > 0) {
        const theirs = this.askedNames(asked);

        requests.push({
          owner: module,
          from,
          names: theirs,
          isImplicit: false,
        });
      }
    }

    return requests;
  }

  private readonly askedNames(names: Read<ModuleName[]>): string[] {
    return names.map((name) => name.name);
  }

  private readonly isLinked(module: Read<OpenModule>, from: ModulePath): boolean {
    return module.links.some((link) => link.from.loc == from.loc);
  }

  private linked(request: Read<Request>): ModuleLink {
    const module = request.owner;
    const from = request.from;

    if (request.isImplicit) {
      return this.linkedImplicit(from);
    }

    const directory = dirname(module.file);
    const fromLibrary = module.parsed.source.isLibrary;
    const home = this.packageOf.get(module.id) ?? 0;
    const resolution = this.resolver.resolve(
      directory,
      from.path,
      fromLibrary,
      home,
    );
    if (resolution.kind == ResolutionKind.File) {
      return this.linkedFile(from, resolution.file, resolution.package);
    }
    if (resolution.kind == ResolutionKind.Library) {
      return this.linkedNamed(from, resolution.name);
    }
    if (resolution.kind == ResolutionKind.Problem) {
      module.problems.push({
        code: resolution.code,
        loc: from.loc,
        details: resolution.details,
      });

      return { kind: LinkKind.Missing, from };
    }

    return { kind: LinkKind.Package, from };
  }

  private readonly finished(module: Read<OpenModule>): Module {
    const parsed = module.parsed;
    const file = parsed.file;
    module.problems.sort((first, second) => first.loc - second.loc);

    const errors = this.mergedByPlace(parsed.errors, module.problems.slice());
    const items = this.withoutParts(file.items);

    return {
      id: module.id,
      name: module.name,
      source: parsed.source,
      file: {
        items,
        imports: file.imports,
        exports: file.exports,
        fieldNames: file.fieldNames,
        stringConstants: file.stringConstants,
      },
      errors,
      declaration: module.declaration,
      links: module.links.slice(),
      implicit: module.implicit,
      parts: module.parts.slice(),
      isDeclarationOnly: module.isDeclarationOnly,
      declared: module.declared,
    };
  }

  private readonly withoutParts(items: Read<Stmt[]>): Stmt[] {
    const kept: Stmt[] = [];

    for (const item of items) {
      if (item.kind != StmtKind.Class || !item.isPartial) {
        kept.push(item);
      }
    }

    return kept;
  }

  private readonly mergedByPlace(
    syntactic: Own<SourceError[]>,
    problems: Read<SourceError[]>,
  ): SourceError[] {
    if (problems.length == 0) {
      return syntactic;
    }

    const merged: SourceError[] = [];
    let taken = 0;

    for (const error of syntactic) {
      while (taken < problems.length) {
        const earlier = problems[taken];
        if (earlier == undefined || earlier.loc > error.loc) {
          break;
        }

        merged.push(earlier);
        taken += 1;
      }

      merged.push(error);
    }

    const rest = problems.slice(taken);

    return merged.concat(rest);
  }
}
