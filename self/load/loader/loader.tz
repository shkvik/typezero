import { replace } from "tz:mem";
import "./partial/loader.partial.files.tz";
import "./partial/loader.partial.library.tz";
import { basename, dirname } from "node:path";
import { SourceError } from "../../diagnostic/types/message.types.tz";
import {
  ModuleName,
  ModulePath,
} from "../../program/ast/types/ast.types.modules.tz";
import { StmtKind } from "../../program/ast/types/ast.types.statements.tz";
import {
  LinkKind,
  Module,
  ModuleLink,
  ParsedDeclaration,
} from "../../program/module/types/module.types.tz";
import { AstFlattener } from "../ast-flattener/ast-flattener.tz";
import { PartJoin } from "../partial-classes/types/partial-classes.types.tz";
import { LibraryMentions } from "../library-mentions/library-mentions.tz";
import { ManifestReader } from "../manifest-reader/manifest-reader.tz";
import { ModuleResolver } from "../module-resolver/module-resolver.tz";
import { ResolutionKind } from "../module-resolver/types/module-resolver.types.tz";
import { PackageGraph } from "../package-graph/package-graph.tz";
import { Parser } from "../parser/parser.tz";
import { PartialClasses } from "../partial-classes/partial-classes.tz";
import {
  LoadResult,
  ModuleState,
  OpenModule,
  Overlay,
  Request,
} from "./types/loader.types.tz";
import {
  ParsedDeclaration as SyntaxParsedDeclaration,
} from "../../program/syntax/types/syntax.types.files.tz";
import { Stmt } from "../../program/syntax/types/syntax.types.statements.tz";

export class Loader {
  private readonly entryPath: string;
  private readonly entryDirectory: string;
  private readonly libraryDirectory: string;
  private readonly parser: Parser;
  private readonly flattener: AstFlattener;
  private readonly resolver: ModuleResolver;
  private readonly mentions: LibraryMentions;
  private opened: OpenModule[];
  private readonly byFile: Map<string, int>;
  private readonly libraries: Map<string, int>;
  private readonly order: int[];
  private unreadable: string[];
  private packageErrors: string[];
  private readonly packageOf: Map<int, int>;
  private readonly overlays: Map<string, string>;
  private readonly isBuilt: boolean;

  public constructor(
    entryPath: string,
    libraryDirectory: string,
    overlays: Read<Overlay[]>,
    isBuilt: boolean,
  ) {
    const entryDirectory = dirname(entryPath);
    const reader = new ManifestReader();
    const packages = new PackageGraph(reader);

    packages.build(entryDirectory);

    this.entryPath = entryPath;
    this.entryDirectory = entryDirectory;
    this.libraryDirectory = libraryDirectory;
    this.parser = new Parser();
    this.flattener = new AstFlattener();
    this.packageErrors = packages.errors();
    this.resolver = new ModuleResolver(packages.takePackages());
    this.packageOf = new Map<int, int>();
    this.mentions = new LibraryMentions();
    this.opened = [];
    this.byFile = new Map<string, int>();
    this.libraries = new Map<string, int>();
    this.order = [];
    this.unreadable = [];
    this.overlays = new Map<string, string>();
    this.isBuilt = isBuilt;

    for (const overlay of overlays) {
      const key = this.keyOf(overlay.path);

      this.overlays.set(key, overlay.textFile);
    }
  }

  public run(): LoadResult {
    const key = this.keyOf(this.entryPath);
    const name = basename(this.entryPath);
    const entry = this.open(this.entryPath, key, name, this.entryPath);
    if (entry != undefined) {
      this.visit(entry);
    }

    const reached = this.opened.length;
    const globalIds = this.loadGlobals();

    if (this.isBuilt) {
      this.loadRuntime();
    }

    const opened = replace(this.opened, []);
    const parts = new PartialClasses(opened, this.order.slice());

    parts.join();
    this.opened = parts.takeModules();

    const joins = parts.takeJoins();
    const visited = new Set<int>(this.order);
    const modules: Module[] = [];
    const items = new Map<int, int[]>();

    for (const module of this.opened.drain()) {
      if (visited.has(module.id)) {
        const ids = this.flattener.itemIds(module.parsed.file.items);
        const finished = this.finished(module, ids);

        items.set(finished.id, ids);
        modules.push(finished);
      }
    }

    this.joinParts(joins, items);

    const order = this.orderedModules(modules);
    const globals = order.filter((id) => globalIds.includes(id));
    const ambient = order.filter(
      (id) => id >= reached || globalIds.includes(id),
    );
    const builtins = this.builtins();
    const tree = this.flattener.takeTree();

    return {
      program: { modules, order, globals, ambient, builtins, tree },
      unreadable: replace(this.unreadable, []),
      packageErrors: replace(this.packageErrors, []),
    };
  }

  private visit(id: int): void {
    this.setState(id, ModuleState.Loading);

    const requests = this.requests(id);

    for (let index = 0; index < requests.length; index++) {
      const request = requests[index];
      const target = this.linkedTarget(request);
      if (target == undefined) {
        continue;
      }
      if (this.stateOf(target) == ModuleState.New) {
        this.visit(target);
      }

      const asked = this.askedRequests(target, request.names);

      for (const one of asked.drain()) {
        requests.push(one);
      }
    }

    this.setState(id, ModuleState.Loaded);
    this.order.push(id);
  }

  private setState(id: int, state: ModuleState): void {
    const module = this.opened[id];
    if (module != undefined) {
      module.state = state;
    }
  }

  private readonly stateOf(id: int): ModuleState | undefined {
    return this.opened[id]?.state;
  }

  private readonly orderedModules(modules: Read<Module[]>): int[] {
    const known = new Set<int>();

    for (const module of modules) {
      known.add(module.id);
    }

    return this.order.filter((id) => known.has(id));
  }

  private linkedTarget(request: Read<Request>): int | undefined {
    const link = this.linked(request);
    const target = this.linkTarget(link);

    this.opened[request.owner]?.links.push(link);

    return target;
  }

  private readonly linkTarget(link: Read<ModuleLink>): int | undefined {
    if (link.kind != LinkKind.Module) {
      return undefined;
    }

    return link.target;
  }

  private readonly requests(id: int): Request[] {
    const requests: Request[] = [];
    const module = this.opened[id];
    if (module == undefined) {
      return requests;
    }

    const file = module.parsed.file;

    for (const decl of file.imports) {
      const names = this.askedNames(decl.names);

      requests.push({
        owner: id,
        from: decl.from,
        names,
        isImplicit: false,
      });
    }

    for (const decl of file.exports) {
      const from = decl.from;
      if (from != undefined && !module.isDeclarationOnly) {
        const names = this.askedNames(decl.names);

        requests.push({ owner: id, from, names, isImplicit: false });
      }
    }

    for (const decl of module.implicit) {
      const names = this.askedNames(decl.names);

      requests.push({
        owner: id,
        from: decl.from,
        names,
        isImplicit: true,
      });
    }

    requests.sort((first, second) => first.from.loc - second.from.loc);

    return requests;
  }

  private readonly askedRequests(id: int, names: Read<string[]>): Request[] {
    const requests: Request[] = [];
    const module = this.opened[id];
    if (module == undefined || !module.isDeclarationOnly) {
      return requests;
    }

    for (const decl of module.parsed.file.exports) {
      const from = decl.from;
      if (from == undefined || this.isLinked(module, from)) {
        continue;
      }

      const asked = decl.names.filter((name) => names.includes(name.as));
      if (asked.length > 0) {
        const theirs = this.askedNames(asked);

        requests.push({
          owner: id,
          from,
          names: theirs,
          isImplicit: false,
        });
      }
    }

    return requests;
  }

  private readonly askedNames(names: Read<ModuleName[]>): string[] {
    return names.map((name) => name.name);
  }

  private readonly isLinked(
    module: Read<OpenModule>,
    from: ModulePath,
  ): boolean {
    return module.links.some((link) => link.from.loc == from.loc);
  }

  private linked(request: Read<Request>): ModuleLink {
    const id = request.owner;
    const from = request.from;

    if (request.isImplicit) {
      return this.linkedImplicit(from);
    }

    const file = this.opened[id]?.file ?? "";
    const directory = dirname(file);
    const fromLibrary = this.opened[id]?.parsed.source.isLibrary == true;
    const home = this.packageOf.get(id) ?? 0;
    const resolution = this.resolver.resolve(
      directory,
      from.path,
      fromLibrary,
      home,
    );
    if (resolution.kind == ResolutionKind.File) {
      return this.linkedFile(from, resolution.file, resolution.package);
    }
    if (resolution.kind == ResolutionKind.Library) {
      return this.linkedNamed(from, resolution.name);
    }
    if (resolution.kind == ResolutionKind.Problem) {
      this.opened[id]?.problems.push({
        code: resolution.code,
        loc: from.loc,
        details: resolution.details,
      });

      return { kind: LinkKind.Missing, from };
    }

    return { kind: LinkKind.Package, from };
  }

  private finished(module: Own<OpenModule>, ids: Read<int[]>): Module {
    module.problems.sort((first, second) => first.loc - second.loc);

    const kept = this.withoutParts(module.parsed.file.items, ids);
    const partIds = this.partIds(module.partItems, ids);
    const itemsList = this.flattener.stmtIdList(kept);
    const partsList = this.flattener.stmtIdList(partIds);
    const importsList = this.flattener.importsOf(module.parsed.file.imports);
    const exportsList = this.flattener.exportsOf(module.parsed.file.exports);
    const implicitList = this.flattener.importsOf(module.implicit);
    const declaredList = this.flattener.declaredClassesOf(module.declared);
    const declaration = this.flatDeclaration(module.declaration);
    const errors = this.mergedByPlace(module.parsed.errors, module.problems);

    return {
      id: module.id,
      name: module.name,
      source: module.parsed.source,
      file: { itemsList, importsList, exportsList },
      errors,
      declaration,
      links: module.links,
      implicitList,
      partsList,
      isDeclarationOnly: module.isDeclarationOnly,
      declaredList,
    };
  }

  private flatDeclaration(
    declaration: Own<SyntaxParsedDeclaration | undefined>,
  ): ParsedDeclaration | undefined {
    if (declaration == undefined) {
      return undefined;
    }

    const file = this.flattener.declarationOf(declaration.file);

    return {
      source: declaration.source,
      file,
      errors: declaration.errors,
    };
  }

  private readonly withoutParts(items: Read<Stmt[]>, ids: Read<int[]>): int[] {
    const kept: int[] = [];

    for (let index = 0; index < items.length; index++) {
      const item = items[index];
      const id = ids[index];
      if (item == undefined || id == undefined) {
        continue;
      }
      if (item.kind != StmtKind.Class || !item.isPartial) {
        kept.push(id);
      }
    }

    return kept;
  }

  private readonly partIds(partItems: Read<int[]>, ids: Read<int[]>): int[] {
    const found: int[] = [];

    for (const item of partItems) {
      const id = ids[item];
      if (id != undefined) {
        found.push(id);
      }
    }

    return found;
  }

  private joinParts(
    joins: Read<PartJoin[]>,
    items: Read<Map<int, int[]>>,
  ): void {
    const methods = new Map<int, int[]>();

    for (const join of joins) {
      const classId = items.get(join.target.module)?.[join.target.item];
      const partId = items.get(join.part.module)?.[join.part.item];
      if (classId == undefined || partId == undefined) {
        continue;
      }

      const partMethods = this.flattener.methodIds(partId);
      const methodId = partMethods[join.method];
      if (methodId == undefined) {
        continue;
      }
      if (!methods.has(classId)) {
        const own = this.flattener.methodIds(classId);

        methods.set(classId, own);
      }

      methods.get(classId)?.push(methodId);
    }

    for (const classId of methods.keys()) {
      const ids = methods.get(classId) ?? [];

      this.flattener.setMethods(classId, ids);
    }
  }

  private readonly mergedByPlace(
    syntactic: Own<SourceError[]>,
    problems: Read<SourceError[]>,
  ): SourceError[] {
    if (problems.length == 0) {
      return syntactic;
    }

    const merged: SourceError[] = [];
    let taken = 0;

    for (const error of syntactic) {
      while (taken < problems.length) {
        const earlier = problems[taken];
        if (earlier == undefined || earlier.loc > error.loc) {
          break;
        }

        merged.push(earlier);
        taken += 1;
      }

      merged.push(error);
    }

    const rest = problems.slice(taken);

    return merged.concat(rest);
  }
}
