import { join } from "node:path";
import { Loader } from "../loader.tz";
import { ModulePath } from "../../../program/ast/types/ast.types.modules.tz";
import { kLibrary } from "../../../program/library/library-modules/const/library-modules.const.tz";
import { kBuiltinSources } from "../../../program/library/library-modules/const/library-modules.const.tables.tz";
import { LibraryModule } from "../../../program/library/library-modules/types/library-modules.types.tz";
import { kDeclarationExtension } from "../../../program/module/const/module.const.tz";
import {
  BuiltinFile,
  LinkKind,
  ModuleLink,
  ParsedFile as FlatParsedFile,
  SourcePiece,
  SourceText,
} from "../../../program/module/types/module.types.tz";
import { Token } from "../../token/types/token.types.tz";
import { ModuleState, OpenModule } from "../types/loader.types.tz";
import { kLineBreak, kMapLibrary } from "../const/loader.const.tz";
import {
  ParsedFile,
} from "../../../program/syntax/types/syntax.types.files.tz";
import {
  ImportDecl,
  SourceFile,
} from "../../../program/syntax/types/syntax.types.modules.tz";

partial class Loader {
  private linkedImplicit(from: ModulePath): ModuleLink {
    return this.linkedNamed(from, from.path);
  }

  private linkedNamed(from: ModulePath, name: string): ModuleLink {
    const library = kLibrary.named(name);
    if (library == undefined) {
      return { kind: LinkKind.Missing, from };
    }

    return this.linkedLibrary(from, library);
  }

  private linkedLibrary(
    from: ModulePath,
    library: Read<LibraryModule>,
  ): ModuleLink {
    const target = this.libraryId(library);
    if (target == undefined) {
      return { kind: LinkKind.Missing, from };
    }

    return { kind: LinkKind.Module, from, target };
  }

  private libraryId(library: Read<LibraryModule>): int | undefined {
    const known = this.libraries.get(library.name);
    if (known != undefined) {
      return known;
    }

    const module = this.openLibrary(library);
    if (module == undefined) {
      return undefined;
    }

    this.libraries.set(library.name, module);

    return module;
  }

  private loadGlobals(): int[] {
    const ids: int[] = [];

    for (const library of kLibrary.globalModules()) {
      const id = this.libraryId(library);
      if (id == undefined) {
        continue;
      }

      ids.push(id);

      if (this.stateOf(id) == ModuleState.New) {
        this.visit(id);
      }
    }

    return ids;
  }

  private loadRuntime(): void {
    for (const library of kLibrary.runtimeModules()) {
      this.runtimeVisited(library);
    }

    const map = kLibrary.named(kMapLibrary);
    if (map != undefined) {
      this.runtimeVisited(map);
    }
  }

  private runtimeVisited(library: Read<LibraryModule>): void {
    const id = this.libraryId(library);
    if (id != undefined && this.stateOf(id) == ModuleState.New) {
      this.visit(id);
    }
  }

  private openLibrary(library: Read<LibraryModule>): int | undefined {
    const file = join(this.libraryDirectory, library.file);
    if (file.endsWith(kDeclarationExtension)) {
      return this.openDeclared(library, file);
    }

    const source = this.librarySource(library, file);
    if (source == undefined) {
      return undefined;
    }

    return this.openSource(source, file, library.name);
  }

  private openDeclared(
    library: Read<LibraryModule>,
    file: string,
  ): int | undefined {
    const path = this.slashed(file);
    const text = this.read(file, path);
    if (text == undefined) {
      return undefined;
    }

    const source: SourceText = { path, text, isLibrary: true };
    const declaration = this.parser.parseDeclaration(source);
    const parsed: ParsedFile = {
      source: declaration.source,
      file: {
        items: declaration.file.items,
        imports: declaration.file.imports,
        exports: declaration.file.exports,
        fieldNames: new Set<string>(),
        stringConstants: new Map<string, string[]>(),
      },
      errors: declaration.errors,
    };
    const id = this.opened.length;
    const module: OpenModule = {
      id,
      name: library.name,
      file,
      parsed,
      links: [],
      implicit: [],
      partItems: [],
      isDeclarationOnly: true,
      declared: declaration.file.classes,
      problems: [],
      state: ModuleState.New,
    };

    this.opened.push(module);

    return id;
  }

  private librarySource(
    library: Read<LibraryModule>,
    file: string,
  ): SourceText | undefined {
    const path = this.slashed(file);
    const main = this.read(file, path);
    if (main == undefined) {
      return undefined;
    }
    if (library.parts.length == 0) {
      return { path, text: main, isLibrary: true };
    }

    let length = main.length;
    const texts: Buffer[] = [main];
    const pieces: SourcePiece[] = [{ path, start: 0 }];

    for (const part of library.parts) {
      const partFile = join(this.libraryDirectory, part);
      const partPath = this.slashed(partFile);
      const text = this.read(partFile, partPath);
      if (text == undefined) {
        return undefined;
      }

      const separator = Buffer.from(kLineBreak);
      const start = length + separator.length;
      const size = text.length;

      texts.push(separator);
      texts.push(text);
      pieces.push({ path: partPath, start });
      length = start + size;
    }

    const text = Buffer.concat(texts);

    return { path, text, isLibrary: true, pieces };
  }

  private readonly implicitImports(
    isLibrary: boolean,
    file: Read<SourceFile>,
    tokens: Read<Token[]>,
  ): ImportDecl[] {
    if (isLibrary) {
      return [];
    }

    return this.mentions.imports(tokens, file);
  }

  private flatParsed(parsed: Own<ParsedFile>): FlatParsedFile {
    const ids = this.flattener.itemIds(parsed.file.items);
    const itemsList = this.flattener.stmtIdList(ids);
    const importsList = this.flattener.importsOf(parsed.file.imports);
    const exportsList = this.flattener.exportsOf(parsed.file.exports);

    return {
      source: parsed.source,
      file: { itemsList, importsList, exportsList },
      errors: parsed.errors,
    };
  }

  private builtins(): BuiltinFile[] {
    const files: BuiltinFile[] = [];

    for (const builtin of kBuiltinSources) {
      const file = join(this.libraryDirectory, builtin.file);
      const path = this.slashed(file);
      const text = this.read(file, path);
      if (text != undefined) {
        const source: SourceText = { path, text, isLibrary: true };
        const parsed = this.parser.parseFile(source);
        const flat = this.flatParsed(parsed);

        files.push({ text: builtin.text, parsed: flat });
      }
    }

    return files;
  }
}
