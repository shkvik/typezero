import { existsSync, readFileSync, realpathSync } from "node:fs";
import { join, relative, resolve } from "node:path";
import { Loader } from "../loader.tz";
import { ModulePath } from "../../../program/ast/types/ast.types.modules.tz";
import {
  kDeclarationExtension,
  kJsonExtension,
  kPathSeparator,
  kSourceExtension,
  kWindowsSeparator,
} from "../../../program/module/const/module.const.tz";
import {
  LinkKind,
  ModuleLink,
  ParsedDeclaration,
  SourceText,
} from "../../../program/module/types/module.types.tz";
import { JsonModule } from "../../json-module/json-module.tz";
import { Lexer } from "../../lexer/lexer.tz";
import { ModuleState, OpenModule } from "../types/loader.types.tz";
import {
  kNewlineByte,
  kReferenceWord,
  kSpaceByte,
  kTabByte,
  kTripleSlash,
  kWindowsPlatform,
} from "../const/loader.const.tz";
import { Code } from "../../../diagnostic/code.tz";
import { kNoDetails } from "../../../diagnostic/const/message.const.tz";

partial class Loader {
  private linkedFile(from: ModulePath, file: string, owner: int): ModuleLink {
    if (file.endsWith(kJsonExtension)) {
      return this.linkedJson(from, file);
    }

    const key = this.keyOf(file);
    const known = this.byFile.get(key);
    if (known != undefined) {
      return { kind: LinkKind.Module, from, target: known };
    }

    const name = this.nameOf(file);
    const path = this.shownPath(name);
    const module = this.open(file, key, name, path);
    if (module == undefined) {
      return { kind: LinkKind.Missing, from };
    }

    this.packageOf.set(module.id, owner);

    return { kind: LinkKind.Module, from, target: module.id };
  }

  private linkedJson(from: ModulePath, file: string): ModuleLink {
    const key = this.keyOf(file);
    const known = this.byFile.get(key);
    if (known != undefined) {
      return { kind: LinkKind.Module, from, target: known };
    }

    const name = this.nameOf(file);
    const path = this.shownPath(name);
    const bytes = this.read(file, path);
    if (bytes == undefined) {
      return { kind: LinkKind.Missing, from };
    }

    const json = new JsonModule(bytes.toString("utf8"));
    const moduleText = json.moduleText();
    if (moduleText == undefined) {
      return { kind: LinkKind.Json, from };
    }

    const text = Buffer.from(moduleText, "utf8");
    const source: SourceText = { path, text, isLibrary: false };
    const module = this.openSource(source, file, name);

    this.byFile.set(key, module.id);

    return { kind: LinkKind.Module, from, target: module.id };
  }

  private open(
    file: string,
    key: string,
    name: string,
    path: string,
  ): OpenModule | undefined {
    const text = this.read(file, path);
    if (text == undefined) {
      return undefined;
    }

    const source: SourceText = { path, text, isLibrary: false };
    const module = this.openSource(source, file, name);

    this.byFile.set(key, module.id);

    return module;
  }

  private openSource(
    source: SourceText,
    file: string,
    name: string,
  ): OpenModule {
    const lexer = new Lexer(source.text);
    const lexed = lexer.run();
    const parsed = this.parser.parseLexed(source, lexed);
    const implicit = this.implicitImports(source, parsed.file, lexed.tokens);
    const declaration = this.declarationOf(file, source);
    const module: OpenModule = {
      id: this.opened.length,
      name,
      file,
      parsed,
      declaration,
      links: [],
      implicit,
      parts: [],
      isDeclarationOnly: false,
      declared: [],
      problems: [],
      state: ModuleState.New,
    };

    this.opened.push(module);
    this.rejectReferences(module, source.text);

    return module;
  }

  private readonly rejectReferences(module: OpenModule, text: Read<Buffer>): void {
    let from = 0;

    while (from < text.length) {
      const at = text.indexOf(kTripleSlash, from);
      if (at < 0) {
        return;
      }
      if (this.isReferenceAt(text, at)) {
        module.problems.push({
          code: Code.ReferenceDirective,
          loc: at,
          details: kNoDetails,
        });
      }

      from = at + kTripleSlash.length;
    }
  }

  private readonly isReferenceAt(text: Read<Buffer>, at: int): boolean {
    let before = at - 1;

    while (before >= 0 && this.isBlankByte(this.byteAt(text, before))) {
      before -= 1;
    }

    const isLineStart = before < 0 || this.byteAt(text, before) == kNewlineByte;
    let after = at + kTripleSlash.length;

    while (after < text.length && this.isBlankByte(this.byteAt(text, after))) {
      after += 1;
    }

    const end = after + kReferenceWord.length;
    const word = text.subarray(after, end).toString("utf8");

    return isLineStart && word == kReferenceWord;
  }

  private readonly byteAt(text: Read<Buffer>, at: int): int {
    const byte = text[at];
    if (byte == undefined) {
      return 0;
    }

    return byte.toInt();
  }

  private readonly isBlankByte(byte: int): boolean {
    return byte == kSpaceByte || byte == kTabByte;
  }

  private read(file: string, path: string): Buffer | undefined {
    const source = this.textFileOf(file);
    const text = readFileSync(source);
    if (text.isErr()) {
      this.unreadable.push(path);

      return undefined;
    }

    return text.value;
  }

  private readonly textFileOf(file: string): string {
    if (this.overlays.size == 0) {
      return file;
    }

    const key = this.keyOf(file);

    return this.overlays.get(key) ?? file;
  }

  private declarationOf(
    file: string,
    module: SourceText,
  ): ParsedDeclaration | undefined {
    const declarationFile = this.declarationPath(file);
    if (!existsSync(declarationFile)) {
      return undefined;
    }

    const path = this.declarationPath(module.path);
    const text = this.read(declarationFile, path);
    if (text == undefined) {
      return undefined;
    }

    const source: SourceText = { path, text, isLibrary: module.isLibrary };

    return this.parser.parseDeclaration(source);
  }

  private readonly declarationPath(path: string): string {
    const stem = path.slice(0, path.length - kSourceExtension.length);

    return `${stem}${kDeclarationExtension}`;
  }

  private readonly keyOf(file: string): string {
    const absolute = resolve(file);
    const real = realpathSync(absolute);
    const path = real.unwrapOr(absolute);

    if (process.platform == kWindowsPlatform) {
      return path.toLowerCase();
    }

    return path;
  }

  private readonly nameOf(file: string): string {
    const from = resolve(this.entryDirectory);
    const to = resolve(file);
    const name = relative(from, to);

    return this.slashed(name);
  }

  private readonly shownPath(name: string): string {
    const path = join(this.entryDirectory, name);

    return this.slashed(path);
  }

  private readonly slashed(path: string): string {
    return path.replaceAll(kWindowsSeparator, kPathSeparator);
  }
}
