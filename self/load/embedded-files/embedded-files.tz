import { readFileSync, statSync } from "node:fs";
import { dirname, join } from "node:path";

export class EmbeddedFiles {
  public sizeOf(modulePath: string, relative: string): int | undefined {
    const folder = dirname(modulePath);
    const path = join(folder, relative);
    const stat = statSync(path);
    if (stat.isErr()) {
      return undefined;
    }

    return stat.value.size;
  }

  public textOf(modulePath: string, relative: string): string | undefined {
    const folder = dirname(modulePath);
    const path = join(folder, relative);
    const read = readFileSync(path, "utf8");
    if (read.isErr()) {
      return undefined;
    }

    return read.value;
  }
}
