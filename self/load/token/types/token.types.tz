export enum KnownName {
  None,
  AsyncIterator,
  Dispose,
  Iterator,
  Raw,
  String,
  Super,
  Symbol,
  Equals,
  Hash,
  Clone,
}

export type Token = {
  readonly kind: TokenKind;
  readonly known: KnownName;
  readonly start: int;
  readonly end: int;
  readonly text: string;
  readonly newline: boolean;
  readonly hash: boolean;
};
