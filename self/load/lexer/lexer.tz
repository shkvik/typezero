import { KnownName, Token, TokenKind } from "../token/types/token.types.tz";
import { kTokenTable } from "../token/const/token.const.tz";
import { Code } from "../../diagnostic/code.tz";
import { Details, SourceError } from "../../diagnostic/types/message.types.tz";
import { kNoDetails } from "../../diagnostic/const/message.const.tz";
import { LexResult } from "./types/lexer.types.tz";
import {
  kAmp,
  kApostrophe,
  kAt,
  kBackslash,
  kBacktick,
  kBang,
  kCaret,
  kColon,
  kComma,
  kDollar,
  kDot,
  kEquals,
  kFormFeed,
  kGreater,
  kHash,
  kHigh,
  kLeftBrace,
  kLeftBracket,
  kLeftParen,
  kLess,
  kLowerA,
  kLowerB,
  kLowerE,
  kLowerN,
  kLowerO,
  kLowerX,
  kLowerZ,
  kMinus,
  kNewline,
  kNine,
  kPercent,
  kPipe,
  kPlus,
  kQuestion,
  kQuote,
  kRadixPrefixLength,
  kReturn,
  kRightBrace,
  kRightBracket,
  kRightParen,
  kSemi,
  kSlash,
  kSpace,
  kStar,
  kTab,
  kTilde,
  kUnderscore,
  kUpperA,
  kUpperB,
  kUpperE,
  kUpperO,
  kUpperX,
  kUpperZ,
  kVerticalTab,
  kZero,
} from "./const/lexer.const.tz";

export class Lexer {
  private readonly source: Buffer;
  private readonly end: int;
  private readonly tokens: Token[];
  private readonly errors: SourceError[];
  private readonly braces: int[];
  private position: int;
  private start: int;
  private newline: boolean;

  public constructor(source: Buffer) {
    this.source = source;
    this.end = source.length;
    this.tokens = [];
    this.errors = [];
    this.braces = [];
    this.position = 0;
    this.start = 0;
    this.newline = false;
  }

  public run(): LexResult {
    this.skipPreamble();
    this.newline = this.skipTrivia();

    while (!this.atEnd()) {
      this.token();
      this.newline = this.skipTrivia();
    }

    this.start = this.position;
    this.push(TokenKind.End);

    return { tokens: this.tokens, errors: this.errors };
  }

  private token(): void {
    this.start = this.position;
    const code = this.at(0);

    this.position += 1;

    switch (code) {
      case kLeftParen:
        return this.push(TokenKind.LParen);
      case kRightParen:
        return this.push(TokenKind.RParen);
      case kLeftBracket:
        return this.push(TokenKind.LBracket);
      case kRightBracket:
        return this.push(TokenKind.RBracket);
      case kComma:
        return this.push(TokenKind.Comma);
      case kSemi:
        return this.push(TokenKind.Semi);
      case kColon:
        return this.push(TokenKind.Colon);
      case kTilde:
        return this.push(TokenKind.Tilde);
      case kAt:
        return this.push(TokenKind.At);
      case kGreater:
        return this.push(TokenKind.Greater);
      case kLeftBrace:
        return this.leftBrace();
      case kRightBrace:
        return this.rightBrace();
      case kBacktick:
        return this.template(false);
      case kQuote:
      case kApostrophe:
        return this.string(code);
      case kPercent:
        return this.pushOperator(TokenKind.Percent, TokenKind.PercentAssign);
      case kCaret:
        return this.pushOperator(TokenKind.Caret, TokenKind.CaretAssign);
      case kPlus:
        if (this.match(kPlus)) {
          return this.push(TokenKind.PlusPlus);
        }
        return this.pushOperator(TokenKind.Plus, TokenKind.PlusAssign);
      case kMinus:
        if (this.match(kMinus)) {
          return this.push(TokenKind.MinusMinus);
        }
        return this.pushOperator(TokenKind.Minus, TokenKind.MinusAssign);
      case kStar:
        if (this.match(kStar)) {
          return this.pushOperator(
            TokenKind.StarStar,
            TokenKind.StarStarAssign,
          );
        }
        return this.pushOperator(TokenKind.Star, TokenKind.StarAssign);
      case kAmp:
        if (this.match(kAmp)) {
          return this.pushOperator(TokenKind.AmpAmp, TokenKind.AmpAmpAssign);
        }
        return this.pushOperator(TokenKind.Amp, TokenKind.AmpAssign);
      case kPipe:
        if (this.match(kPipe)) {
          return this.pushOperator(
            TokenKind.PipePipe,
            TokenKind.PipePipeAssign,
          );
        }
        return this.pushOperator(TokenKind.Pipe, TokenKind.PipeAssign);
      case kLess:
        if (this.match(kLess)) {
          return this.pushOperator(TokenKind.Shl, TokenKind.ShlAssign);
        }
        return this.pushOperator(TokenKind.Less, TokenKind.LessEq);
      case kEquals:
        if (this.match(kEquals)) {
          return this.pushOperator(TokenKind.EqEq, TokenKind.EqEqEq);
        }
        if (this.match(kGreater)) {
          return this.push(TokenKind.Arrow);
        }
        return this.push(TokenKind.Assign);
      case kBang:
        if (this.match(kEquals)) {
          return this.pushOperator(TokenKind.BangEq, TokenKind.BangEqEq);
        }
        return this.push(TokenKind.Bang);
      case kQuestion:
        if (this.match(kQuestion)) {
          return this.pushOperator(
            TokenKind.QuestionQuestion,
            TokenKind.QuestionQuestionAssign,
          );
        }
        if (this.at(0) == kDot && !this.digitAt(1)) {
          this.position += 1;

          return this.push(TokenKind.QuestionDot);
        }
        return this.push(TokenKind.Question);
      case kDot:
        if (this.digitAt(0)) {
          return this.number();
        }
        if (this.at(0) == kDot && this.at(1) == kDot) {
          this.position += 2;

          return this.push(TokenKind.Ellipsis);
        }
        return this.push(TokenKind.Dot);
      case kSlash:
        if (this.regexAllowed()) {
          return this.regex();
        }
        return this.pushOperator(TokenKind.Slash, TokenKind.SlashAssign);
      case kHash:
        if (this.identStartAt(0)) {
          return this.identifier(true);
        }
        return this.unexpected(code);
      default:
        if (this.isDigit(code)) {
          return this.number();
        }
        if (this.isIdentStart(code)) {
          return this.identifier(false);
        }
        return this.unexpected(code);
    }
  }

  private unexpected(code: int): void {
    const word = String.fromCharCode(code);

    this.error(this.start, Code.UnexpectedCharacter, { word });
  }

  private error(loc: int, code: Code, details: Details = kNoDetails): void {
    this.errors.push({ code, loc, details });
  }

  private push(kind: TokenKind): void {
    this.tokens.push({
      kind,
      known: KnownName.None,
      start: this.start,
      end: this.position,
      text: "",
      newline: this.newline,
      hash: false,
    });
  }

  private skipPreamble(): void {
    if (this.at(0) == 0xef && this.at(1) == 0xbb && this.at(2) == 0xbf) {
      this.position = 3;
    }
    if (this.at(0) == kHash && this.at(1) == kBang) {
      this.skipRestOfLine();
    }
  }

  private atEnd(): boolean {
    return this.position >= this.end;
  }

  private at(offset: int): int {
    const value = this.source[this.position + offset] ?? 0;

    return value.toInt();
  }

  private isDigit(code: int): boolean {
    return code >= kZero && code <= kNine;
  }

  private isAlpha(code: int): boolean {
    return (
      (code >= kLowerA && code <= kLowerZ) ||
      (code >= kUpperA && code <= kUpperZ)
    );
  }

  private isIdentStart(code: int): boolean {
    return (
      this.isAlpha(code) ||
      code == kUnderscore ||
      code == kDollar ||
      code >= kHigh
    );
  }

  private isIdentChar(code: int): boolean {
    return this.isIdentStart(code) || this.isDigit(code);
  }

  private digitAt(offset: int): boolean {
    const code = this.at(offset);

    return this.isDigit(code);
  }

  private alphaAt(offset: int): boolean {
    const code = this.at(offset);

    return this.isAlpha(code);
  }

  private identStartAt(offset: int): boolean {
    const code = this.at(offset);

    return this.isIdentStart(code);
  }

  private identCharAt(offset: int): boolean {
    const code = this.at(offset);

    return this.isIdentChar(code);
  }

  private isLineBreak(): boolean {
    const code = this.at(0);
    if (code == kNewline || code == kReturn) {
      return true;
    }

    return (
      code == 0xe2 &&
      this.at(1) == 0x80 &&
      (this.at(2) == 0xa8 || this.at(2) == 0xa9)
    );
  }

  private pushOperator(plain: TokenKind, withAssign: TokenKind): void {
    if (this.match(kEquals)) {
      return this.push(withAssign);
    }

    this.push(plain);
  }

  private match(code: int): boolean {
    if (this.at(0) != code) {
      return false;
    }

    this.position += 1;

    return true;
  }

  private skipTrivia(): boolean {
    let newline = false;

    while (!this.atEnd()) {
      const code = this.at(0);

      switch (code) {
        case kNewline:
          newline = true;
          this.position += 1;
          break;
        case kSpace:
        case kTab:
        case kReturn:
        case kFormFeed:
        case kVerticalTab:
          this.position += 1;
          break;
        case kSlash:
          if (!this.commentAhead()) {
            return newline;
          }
          newline = this.skipComment() || newline;
          break;
        default:
          return newline;
      }
    }

    return newline;
  }

  private commentAhead(): boolean {
    const next = this.at(1);

    return next == kSlash || next == kStar;
  }

  private skipComment(): boolean {
    if (this.at(1) == kSlash) {
      this.skipRestOfLine();

      return false;
    }

    return this.skipBlockComment();
  }

  private skipRestOfLine(): void {
    while (!this.atEnd() && this.at(0) != kNewline) {
      this.position += 1;
    }
  }

  private skipBlockComment(): boolean {
    const start = this.position;
    let newline = false;

    this.position += 2;

    while (
      !this.atEnd() &&
      !(this.at(0) == kStar && this.at(1) == kSlash)
    ) {
      if (this.at(0) == kNewline) {
        newline = true;
      }

      this.position += 1;
    }

    if (this.atEnd()) {
      this.error(start, Code.UnterminatedComment);

      return newline;
    }

    this.position += 2;

    return newline;
  }

  private regexAllowed(): boolean {
    const count = this.tokens.length;
    const last = this.tokens[count - 1];
    if (last == undefined) {
      return true;
    }

    const before = this.tokens[count - 2];
    const afterDot =
      before?.kind == TokenKind.Dot || before?.kind == TokenKind.QuestionDot;
    const isProperty = afterDot && kTokenTable.isKeyword(last.kind);

    return !isProperty && this.regexMayFollow(last.kind);
  }

  private leftBrace(): void {
    const braces = this.braces;
    const last = braces.length - 1;
    if (last >= 0) {
      braces[last] = (braces[last] ?? 0) + 1;
    }

    this.push(TokenKind.LBrace);
  }

  private rightBrace(): void {
    const braces = this.braces;
    const last = braces.length - 1;
    if (last < 0) {
      return this.push(TokenKind.RBrace);
    }

    const depth = braces[last] ?? 0;
    if (depth == 0) {
      braces.pop();

      return this.template(true);
    }

    braces[last] = depth - 1;
    this.push(TokenKind.RBrace);
  }

  private regex(): void {
    while (!this.atEnd() && !this.isLineBreak()) {
      const code = this.at(0);

      this.position += 1;

      switch (code) {
        case kBackslash:
          this.skipEscaped();
          break;
        case kLeftBracket:
          this.skipRegexClass();
          break;
        case kSlash:
          this.skipIdentChars();
          return this.push(TokenKind.Regex);
      }
    }

    this.error(this.start, Code.UnterminatedRegex);
    this.push(TokenKind.Regex);
  }

  private skipEscaped(): void {
    if (!this.atEnd() && !this.isLineBreak()) {
      this.position += 1;
    }
  }

  private skipRegexClass(): void {
    while (!this.atEnd() && !this.isLineBreak()) {
      const code = this.at(0);

      this.position += 1;
      if (code == kRightBracket) {
        return;
      }
      if (code == kBackslash) {
        this.skipEscaped();
      }
    }
  }

  private number(): void {
    const byte = this.source[this.start] ?? 0;
    const first = byte.toInt();
    const second = this.at(0);
    if (first == kZero && this.isRadixLetter(second)) {
      return this.radixNumber();
    }

    const leadingDot = first == kDot;

    this.skipDigits();
    const fraction = leadingDot || this.acceptFraction();
    const exponent = this.acceptExponent();
    if (fraction || exponent) {
      return this.finishNumber(TokenKind.Float);
    }

    this.finishNumber(TokenKind.Int);
  }

  private isRadixLetter(code: int): boolean {
    return (
      code == kLowerX ||
      code == kUpperX ||
      code == kLowerB ||
      code == kUpperB ||
      code == kLowerO ||
      code == kUpperO
    );
  }

  private acceptFraction(): boolean {
    if (this.at(0) != kDot) {
      return false;
    }

    const next = this.at(1);
    const exponentLetter = next == kLowerE || next == kUpperE;
    const member = this.isIdentStart(next) && !exponentLetter;
    if (member) {
      this.reportNameAfterPoint();

      return false;
    }

    this.position += 1;
    this.skipDigits();

    return true;
  }

  private reportNameAfterPoint(): void {
    let offset = 1;

    while (this.identCharAt(offset)) {
      offset += 1;
    }

    const nameStart = this.position + 1;
    const nameEnd = this.position + offset;
    const word = this.source.toString("utf8", this.start, this.position);
    const other = this.source.toString("utf8", nameStart, nameEnd);

    this.error(nameStart, Code.NameAfterNumberPoint, { word, other });
  }

  private acceptExponent(): boolean {
    const letter = this.at(0);
    if (letter != kLowerE && letter != kUpperE) {
      return false;
    }

    const sign = this.at(1);
    const signed = sign == kPlus || sign == kMinus;
    if (signed && !this.digitAt(2)) {
      return false;
    }
    if (!signed && !this.digitAt(1)) {
      return false;
    }

    this.position += 2;
    this.skipDigits();

    return true;
  }

  private radixNumber(): void {
    this.position += 1;

    while (
      this.alphaAt(0) ||
      this.digitAt(0) ||
      this.at(0) == kUnderscore
    ) {
      this.position += 1;
    }

    const suffix = this.at(-1) == kLowerN;
    const length = this.position - this.start;
    const digits = length - kRadixPrefixLength - 1;
    if (suffix && digits > 0) {
      this.position -= 1;
    }

    this.finishNumber(TokenKind.Int);
  }

  private skipDigits(): void {
    while (this.digitAt(0) || this.at(0) == kUnderscore) {
      this.position += 1;
    }
  }

  private finishNumber(kind: TokenKind): void {
    if (this.at(0) == kLowerN && !this.identCharAt(1)) {
      const word = this.source.toString("utf8", this.start, this.position);

      this.error(this.start, Code.BigIntLiteral, { word });
      this.push(kind);
      this.position += 1;

      return;
    }
    if (this.identStartAt(0)) {
      this.error(this.position, Code.NameAfterNumber);
      this.push(kind);
      this.skipIdentChars();

      return;
    }

    this.push(kind);
  }

  private skipIdentChars(): void {
    while (this.identCharAt(0)) {
      this.position += 1;
    }
  }

  private string(quote: int): void {
    while (
      !this.atEnd() &&
      this.at(0) != kNewline &&
      this.at(0) != kReturn
    ) {
      const code = this.at(0);

      this.position += 1;
      if (code == quote) {
        return this.push(TokenKind.String);
      }
      if (code == kBackslash && !this.atEnd()) {
        this.position += 1;
      }
    }

    this.error(this.start, Code.UnterminatedString);
    this.push(TokenKind.String);
  }

  private template(continuation: boolean): void {
    let closed: TokenKind = TokenKind.TemplateString;
    let opened: TokenKind = TokenKind.TemplateHead;

    if (continuation) {
      closed = TokenKind.TemplateTail;
      opened = TokenKind.TemplateMiddle;
    }

    while (!this.atEnd()) {
      const code = this.at(0);

      this.position += 1;
      if (code == kBacktick) {
        return this.push(closed);
      }
      if (code == kDollar && this.at(0) == kLeftBrace) {
        this.position += 1;
        this.braces.push(0);

        return this.push(opened);
      }
      if (code == kBackslash && !this.atEnd()) {
        this.position += 1;
      }
    }

    this.error(this.start, Code.UnterminatedTemplate);
    this.push(closed);
  }

  private identifier(hash: boolean): void {
    let start = this.start;

    if (hash) {
      start += 1;
    }

    this.skipIdentChars();

    const text = this.source.toString("utf8", start, this.position);
    let kind: TokenKind = TokenKind.Identifier;
    let known: KnownName = KnownName.None;

    if (!hash) {
      kind = kTokenTable.keywordKind(text);
      known = kTokenTable.knownName(text);
    }

    this.tokens.push({
      kind,
      known,
      start,
      end: this.position,
      text,
      newline: this.newline,
      hash,
    });
  }

  private regexMayFollow(kind: TokenKind): boolean {
    switch (kind) {
      case TokenKind.Await:
      case TokenKind.Yield:
        return true;
      case TokenKind.Identifier:
      case TokenKind.This:
      case TokenKind.Super:
      case TokenKind.Int:
      case TokenKind.Float:
      case TokenKind.String:
      case TokenKind.TemplateString:
      case TokenKind.TemplateTail:
      case TokenKind.Regex:
      case TokenKind.True:
      case TokenKind.False:
      case TokenKind.RParen:
      case TokenKind.RBracket:
      case TokenKind.RBrace:
      case TokenKind.PlusPlus:
      case TokenKind.MinusMinus:
        return false;
      default:
        return !kTokenTable.isContextual(kind);
    }
  }
}
