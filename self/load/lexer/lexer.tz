import "./partial/lexer.partial.literals.tz";
import { replace } from "tz:mem";
import { KnownName, Token, TokenKind } from "../token/types/token.types.tz";
import { kTokenTable } from "../token/const/token.const.tz";
import { Code } from "../../diagnostic/code.tz";
import { Details, SourceError } from "../../diagnostic/types/message.types.tz";
import { kNoDetails } from "../../diagnostic/const/message.const.tz";
import { LexResult } from "./types/lexer.types.tz";
import {
  kAmp,
  kApostrophe,
  kAt,
  kBacktick,
  kBang,
  kCaret,
  kColon,
  kComma,
  kDollar,
  kDot,
  kEquals,
  kFormFeed,
  kGreater,
  kHash,
  kHigh,
  kLeftBrace,
  kLeftBracket,
  kLeftParen,
  kLess,
  kLowerA,
  kLowerZ,
  kMinus,
  kNewline,
  kNoToken,
  kNine,
  kPercent,
  kPipe,
  kPlus,
  kQuestion,
  kQuote,
  kReturn,
  kRightBrace,
  kRightBracket,
  kRightParen,
  kSemi,
  kSlash,
  kSpace,
  kStar,
  kTab,
  kTilde,
  kUnderscore,
  kUpperA,
  kUpperZ,
  kVerticalTab,
  kZero,
} from "./const/lexer.const.tz";

export class Lexer {
  private readonly source: Buffer;
  private readonly end: int;
  private tokens: Token[];
  private errors: SourceError[];
  private readonly braces: int[];
  private readonly headers: boolean[];
  private headerEnd: int;
  private position: int;
  private start: int;
  private newline: boolean;

  public constructor(source: Read<Buffer>) {
    this.source = Buffer.from(source);
    this.end = this.source.length;
    this.tokens = [];
    this.errors = [];
    this.braces = [];
    this.headers = [];
    this.headerEnd = kNoToken;
    this.position = 0;
    this.start = 0;
    this.newline = false;
  }

  public run(): LexResult {
    this.skipPreamble();
    this.newline = this.skipTrivia();

    while (!this.atEnd()) {
      this.token();
      this.newline = this.skipTrivia();
    }

    this.start = this.position;
    this.push(TokenKind.End);

    return {
      tokens: replace(this.tokens, []),
      errors: replace(this.errors, []),
    };
  }

  private token(): void {
    this.start = this.position;
    const code = this.at(0);

    this.position += 1;

    switch (code) {
      case kLeftParen:
        return this.leftParen();
      case kRightParen:
        return this.rightParen();
      case kLeftBracket:
        return this.push(TokenKind.LBracket);
      case kRightBracket:
        return this.push(TokenKind.RBracket);
      case kComma:
        return this.push(TokenKind.Comma);
      case kSemi:
        return this.push(TokenKind.Semi);
      case kColon:
        return this.push(TokenKind.Colon);
      case kTilde:
        return this.push(TokenKind.Tilde);
      case kAt:
        return this.push(TokenKind.At);
      case kGreater:
        return this.push(TokenKind.Greater);
      case kLeftBrace:
        return this.leftBrace();
      case kRightBrace:
        return this.rightBrace();
      case kBacktick:
        return this.template(false);
      case kQuote:
      case kApostrophe:
        return this.string(code);
      case kPercent:
        return this.pushOperator(TokenKind.Percent, TokenKind.PercentAssign);
      case kCaret:
        return this.pushOperator(TokenKind.Caret, TokenKind.CaretAssign);
      case kPlus:
        if (this.match(kPlus)) {
          return this.push(TokenKind.PlusPlus);
        }
        return this.pushOperator(TokenKind.Plus, TokenKind.PlusAssign);
      case kMinus:
        if (this.match(kMinus)) {
          return this.push(TokenKind.MinusMinus);
        }
        return this.pushOperator(TokenKind.Minus, TokenKind.MinusAssign);
      case kStar:
        if (this.match(kStar)) {
          return this.pushOperator(
            TokenKind.StarStar,
            TokenKind.StarStarAssign,
          );
        }
        return this.pushOperator(TokenKind.Star, TokenKind.StarAssign);
      case kAmp:
        if (this.match(kAmp)) {
          return this.pushOperator(TokenKind.AmpAmp, TokenKind.AmpAmpAssign);
        }
        return this.pushOperator(TokenKind.Amp, TokenKind.AmpAssign);
      case kPipe:
        if (this.match(kPipe)) {
          return this.pushOperator(
            TokenKind.PipePipe,
            TokenKind.PipePipeAssign,
          );
        }
        return this.pushOperator(TokenKind.Pipe, TokenKind.PipeAssign);
      case kLess:
        if (this.match(kLess)) {
          return this.pushOperator(TokenKind.Shl, TokenKind.ShlAssign);
        }
        return this.pushOperator(TokenKind.Less, TokenKind.LessEq);
      case kEquals:
        if (this.match(kEquals)) {
          return this.pushOperator(TokenKind.EqEq, TokenKind.EqEqEq);
        }
        if (this.match(kGreater)) {
          return this.push(TokenKind.Arrow);
        }
        return this.push(TokenKind.Assign);
      case kBang:
        if (this.match(kEquals)) {
          return this.pushOperator(TokenKind.BangEq, TokenKind.BangEqEq);
        }
        return this.push(TokenKind.Bang);
      case kQuestion:
        if (this.match(kQuestion)) {
          return this.pushOperator(
            TokenKind.QuestionQuestion,
            TokenKind.QuestionQuestionAssign,
          );
        }
        if (this.at(0) == kDot && !this.digitAt(1)) {
          this.position += 1;

          return this.push(TokenKind.QuestionDot);
        }
        return this.push(TokenKind.Question);
      case kDot:
        if (this.digitAt(0)) {
          return this.number();
        }
        if (this.at(0) == kDot && this.at(1) == kDot) {
          this.position += 2;

          return this.push(TokenKind.Ellipsis);
        }
        return this.push(TokenKind.Dot);
      case kSlash:
        if (this.regexAllowed()) {
          return this.regex();
        }
        return this.pushOperator(TokenKind.Slash, TokenKind.SlashAssign);
      case kHash:
        if (this.identStartAt(0)) {
          return this.identifier(true);
        }
        return this.unexpected(code);
      default:
        if (this.isDigit(code)) {
          return this.number();
        }
        if (this.isIdentStart(code)) {
          return this.identifier(false);
        }
        return this.unexpected(code);
    }
  }

  private unexpected(code: int): void {
    const word = String.fromCharCode(code);

    this.error(this.start, Code.UnexpectedCharacter, { word });
  }

  private error(loc: int, code: Code, details: Details = kNoDetails): void {
    this.errors.push({ code, loc, details });
  }

  private push(kind: TokenKind): void {
    this.tokens.push({
      kind,
      known: KnownName.None,
      start: this.start,
      end: this.position,
      text: "",
      newline: this.newline,
      hash: false,
    });
  }

  private skipPreamble(): void {
    if (this.at(0) == 0xef && this.at(1) == 0xbb && this.at(2) == 0xbf) {
      this.position = 3;
    }
    if (this.at(0) == kHash && this.at(1) == kBang) {
      this.skipRestOfLine();
    }
  }

  private readonly atEnd(): boolean {
    return this.position >= this.end;
  }

  private readonly at(offset: int): int {
    const value = this.source[this.position + offset] ?? 0;

    return value.toInt();
  }

  private readonly isDigit(code: int): boolean {
    return code >= kZero && code <= kNine;
  }

  private readonly isAlpha(code: int): boolean {
    return (
      (code >= kLowerA && code <= kLowerZ) ||
      (code >= kUpperA && code <= kUpperZ)
    );
  }

  private readonly isIdentStart(code: int): boolean {
    return (
      this.isAlpha(code) ||
      code == kUnderscore ||
      code == kDollar ||
      code >= kHigh
    );
  }

  private readonly isIdentChar(code: int): boolean {
    return this.isIdentStart(code) || this.isDigit(code);
  }

  private readonly digitAt(offset: int): boolean {
    const code = this.at(offset);

    return this.isDigit(code);
  }

  private readonly alphaAt(offset: int): boolean {
    const code = this.at(offset);

    return this.isAlpha(code);
  }

  private readonly identStartAt(offset: int): boolean {
    const code = this.at(offset);

    return this.isIdentStart(code);
  }

  private readonly identCharAt(offset: int): boolean {
    const code = this.at(offset);

    return this.isIdentChar(code);
  }

  private readonly isLineBreak(): boolean {
    const code = this.at(0);
    if (code == kNewline || code == kReturn) {
      return true;
    }

    return (
      code == 0xe2 &&
      this.at(1) == 0x80 &&
      (this.at(2) == 0xa8 || this.at(2) == 0xa9)
    );
  }

  private pushOperator(plain: TokenKind, withAssign: TokenKind): void {
    if (this.match(kEquals)) {
      return this.push(withAssign);
    }

    this.push(plain);
  }

  private match(code: int): boolean {
    if (this.at(0) != code) {
      return false;
    }

    this.position += 1;

    return true;
  }

  private skipTrivia(): boolean {
    let newline = false;

    while (!this.atEnd()) {
      const code = this.at(0);

      switch (code) {
        case kNewline:
          newline = true;
          this.position += 1;
          break;
        case kSpace:
        case kTab:
        case kReturn:
        case kFormFeed:
        case kVerticalTab:
          this.position += 1;
          break;
        case kSlash:
          if (!this.commentAhead()) {
            return newline;
          }
          newline = this.skipComment() || newline;
          break;
        default:
          return newline;
      }
    }

    return newline;
  }

  private readonly commentAhead(): boolean {
    const next = this.at(1);

    return next == kSlash || next == kStar;
  }

  private skipComment(): boolean {
    if (this.at(1) == kSlash) {
      this.skipRestOfLine();

      return false;
    }

    return this.skipBlockComment();
  }

  private skipRestOfLine(): void {
    while (!this.atEnd() && this.at(0) != kNewline) {
      this.position += 1;
    }
  }

  private skipBlockComment(): boolean {
    const start = this.position;
    let newline = false;

    this.position += 2;

    while (!this.atEnd() && !(this.at(0) == kStar && this.at(1) == kSlash)) {
      if (this.at(0) == kNewline) {
        newline = true;
      }

      this.position += 1;
    }

    if (this.atEnd()) {
      this.error(start, Code.UnterminatedComment);

      return newline;
    }

    this.position += 2;

    return newline;
  }

  private readonly regexAllowed(): boolean {
    let operand = this.tokens.length - 1;

    while (this.isBangAt(operand)) {
      operand -= 1;
    }

    return operand == this.headerEnd || !this.endsOperand(operand);
  }

  private leftParen(): void {
    const last = this.tokens.length - 1;
    const opens = this.isHeaderWordAt(last);

    this.headers.push(opens);
    this.push(TokenKind.LParen);
  }

  private rightParen(): void {
    const closes = this.headers.pop() ?? false;
    if (closes) {
      this.headerEnd = this.tokens.length;
    }

    this.push(TokenKind.RParen);
  }

  private readonly isHeaderWordAt(index: int): boolean {
    const token = this.tokens[index];
    const before = this.tokens[index - 1];
    if (token == undefined || this.isAfterDot(before)) {
      return false;
    }

    switch (token.kind) {
      case TokenKind.If:
      case TokenKind.While:
      case TokenKind.For:
        return true;
      case TokenKind.Await:
        return before?.kind == TokenKind.For;
      default:
        return false;
    }
  }

  private readonly isAfterDot(before: Token | undefined): boolean {
    return (
      before?.kind == TokenKind.Dot || before?.kind == TokenKind.QuestionDot
    );
  }

  private readonly isBangAt(index: int): boolean {
    const token = this.tokens[index];
    if (token == undefined) {
      return false;
    }

    return token.kind == TokenKind.Bang && !token.newline;
  }

  private readonly endsOperand(index: int): boolean {
    const token = this.tokens[index];
    if (token == undefined) {
      return false;
    }

    const before = this.tokens[index - 1];
    const isProperty =
      this.isAfterDot(before) && kTokenTable.isKeyword(token.kind);
    if (isProperty) {
      return true;
    }
    if (this.isLoopOf(token, before)) {
      return false;
    }

    return !this.regexMayFollow(token.kind);
  }

  private readonly isLoopOf(token: Token, before: Token | undefined): boolean {
    if (token.kind != TokenKind.Of || token.newline || before == undefined) {
      return false;
    }

    switch (before.kind) {
      case TokenKind.RBracket:
      case TokenKind.RBrace:
        return true;
      default:
        return kTokenTable.isName(before.kind);
    }
  }

  private leftBrace(): void {
    const braces = this.braces;
    const last = braces.length - 1;
    if (last >= 0) {
      braces[last] = (braces[last] ?? 0) + 1;
    }

    this.push(TokenKind.LBrace);
  }

  private rightBrace(): void {
    const last = this.braces.length - 1;
    if (last < 0) {
      return this.push(TokenKind.RBrace);
    }

    const depth = this.braces[last] ?? 0;
    if (depth == 0) {
      this.braces.pop();

      return this.template(true);
    }

    this.braces[last] = depth - 1;
    this.push(TokenKind.RBrace);
  }

  private readonly regexMayFollow(kind: TokenKind): boolean {
    switch (kind) {
      case TokenKind.Await:
      case TokenKind.Yield:
        return true;
      case TokenKind.Identifier:
      case TokenKind.This:
      case TokenKind.Super:
      case TokenKind.Int:
      case TokenKind.Float:
      case TokenKind.String:
      case TokenKind.TemplateString:
      case TokenKind.TemplateTail:
      case TokenKind.Regex:
      case TokenKind.True:
      case TokenKind.False:
      case TokenKind.RParen:
      case TokenKind.RBracket:
      case TokenKind.PlusPlus:
      case TokenKind.MinusMinus:
        return false;
      default:
        return !kTokenTable.isContextual(kind);
    }
  }
}
