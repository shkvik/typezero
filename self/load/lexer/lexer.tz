import { KnownName, Token, TokenKind } from "../token/types/token.types.tz";
import { kTokenTable } from "../token/const/token.const.tz";

const kTab = 9;
const kNewline = 10;
const kVerticalTab = 11;
const kFormFeed = 12;
const kReturn = 13;
const kSpace = 32;
const kBang = 33;
const kQuote = 34;
const kHash = 35;
const kDollar = 36;
const kPercent = 37;
const kAmp = 38;
const kApostrophe = 39;
const kLeftParen = 40;
const kRightParen = 41;
const kStar = 42;
const kPlus = 43;
const kComma = 44;
const kMinus = 45;
const kDot = 46;
const kSlash = 47;
const kZero = 48;
const kNine = 57;
const kColon = 58;
const kSemi = 59;
const kLess = 60;
const kEquals = 61;
const kGreater = 62;
const kQuestion = 63;
const kAt = 64;
const kUpperA = 65;
const kUpperB = 66;
const kUpperE = 69;
const kUpperO = 79;
const kUpperX = 88;
const kUpperZ = 90;
const kLeftBracket = 91;
const kBackslash = 92;
const kRightBracket = 93;
const kCaret = 94;
const kUnderscore = 95;
const kBacktick = 96;
const kLowerA = 97;
const kLowerB = 98;
const kLowerE = 101;
const kLowerN = 110;
const kLowerO = 111;
const kLowerX = 120;
const kLowerZ = 122;
const kLeftBrace = 123;
const kPipe = 124;
const kRightBrace = 125;
const kTilde = 126;
const kHigh = 128;
const kRadixPrefixLength = 2;

export function tokenize(source: Buffer): Token[] {
  const lexer = new Lexer(source);

  return lexer.run();
}

function regexMayFollow(kind: TokenKind): boolean {
  if (kTokenTable.isContextual(kind)) {
    return false;
  }
  switch (kind) {
    case TokenKind.Identifier:
    case TokenKind.This:
    case TokenKind.Super:
    case TokenKind.Int:
    case TokenKind.Float:
    case TokenKind.String:
    case TokenKind.TemplateString:
    case TokenKind.TemplateTail:
    case TokenKind.Regex:
    case TokenKind.True:
    case TokenKind.False:
    case TokenKind.RParen:
    case TokenKind.RBracket:
    case TokenKind.RBrace:
    case TokenKind.PlusPlus:
    case TokenKind.MinusMinus:
      return false;
    default:
      return true;
  }
}

class Lexer {
  private readonly source: Buffer;
  private readonly end: int;
  private readonly tokens: Token[];
  private readonly braces: int[];
  private cur: int;
  private start: int;
  private newline: boolean;

  public constructor(source: Buffer) {
    this.source = source;
    this.end = source.length;
    this.tokens = [];
    this.braces = [];
    this.cur = 0;
    this.start = 0;
    this.newline = false;
  }

  public run(): Token[] {
    this.skipPreamble();
    this.newline = this.skipTrivia();
    while (!this.atEnd()) {
      this.token();
      this.newline = this.skipTrivia();
    }
    this.start = this.cur;
    this.push(TokenKind.End);

    return this.tokens;
  }

  private token(): void {
    this.start = this.cur;
    const c = this.at(0);
    this.cur += 1;
    switch (c) {
      case kLeftParen:
        return this.push(TokenKind.LParen);
      case kRightParen:
        return this.push(TokenKind.RParen);
      case kLeftBracket:
        return this.push(TokenKind.LBracket);
      case kRightBracket:
        return this.push(TokenKind.RBracket);
      case kComma:
        return this.push(TokenKind.Comma);
      case kSemi:
        return this.push(TokenKind.Semi);
      case kColon:
        return this.push(TokenKind.Colon);
      case kTilde:
        return this.push(TokenKind.Tilde);
      case kAt:
        return this.push(TokenKind.At);
      case kGreater:
        return this.push(TokenKind.Greater);
      case kLeftBrace:
        return this.leftBrace();
      case kRightBrace:
        return this.rightBrace();
      case kBacktick:
        return this.template(false);
      case kQuote:
      case kApostrophe:
        return this.string(c);
      case kPercent:
        return this.pushOperator(TokenKind.Percent, TokenKind.PercentAssign);
      case kCaret:
        return this.pushOperator(TokenKind.Caret, TokenKind.CaretAssign);
      case kPlus:
        if (this.match(kPlus)) {
          return this.push(TokenKind.PlusPlus);
        }
        return this.pushOperator(TokenKind.Plus, TokenKind.PlusAssign);
      case kMinus:
        if (this.match(kMinus)) {
          return this.push(TokenKind.MinusMinus);
        }
        return this.pushOperator(TokenKind.Minus, TokenKind.MinusAssign);
      case kStar:
        if (this.match(kStar)) {
          return this.pushOperator(
            TokenKind.StarStar,
            TokenKind.StarStarAssign,
          );
        }
        return this.pushOperator(TokenKind.Star, TokenKind.StarAssign);
      case kAmp:
        if (this.match(kAmp)) {
          return this.pushOperator(TokenKind.AmpAmp, TokenKind.AmpAmpAssign);
        }
        return this.pushOperator(TokenKind.Amp, TokenKind.AmpAssign);
      case kPipe:
        if (this.match(kPipe)) {
          return this.pushOperator(
            TokenKind.PipePipe,
            TokenKind.PipePipeAssign,
          );
        }
        return this.pushOperator(TokenKind.Pipe, TokenKind.PipeAssign);
      case kLess:
        if (this.match(kLess)) {
          return this.pushOperator(TokenKind.Shl, TokenKind.ShlAssign);
        }
        return this.pushOperator(TokenKind.Less, TokenKind.LessEq);
      case kEquals:
        if (this.match(kEquals)) {
          return this.pushOperator(TokenKind.EqEq, TokenKind.EqEqEq);
        }
        if (this.match(kGreater)) {
          return this.push(TokenKind.Arrow);
        }
        return this.push(TokenKind.Assign);
      case kBang:
        if (this.match(kEquals)) {
          return this.pushOperator(TokenKind.BangEq, TokenKind.BangEqEq);
        }
        return this.push(TokenKind.Bang);
      case kQuestion:
        if (this.match(kQuestion)) {
          return this.pushOperator(
            TokenKind.QuestionQuestion,
            TokenKind.QuestionQuestionAssign,
          );
        }
        if (this.at(0) == kDot && !this.digitAt(1)) {
          this.cur += 1;
          return this.push(TokenKind.QuestionDot);
        }
        return this.push(TokenKind.Question);
      case kDot:
        if (this.digitAt(0)) {
          return this.number();
        }
        if (this.at(0) == kDot && this.at(1) == kDot) {
          this.cur += 2;
          return this.push(TokenKind.Ellipsis);
        }
        return this.push(TokenKind.Dot);
      case kSlash:
        if (this.regexAllowed()) {
          return this.regex();
        }
        return this.pushOperator(TokenKind.Slash, TokenKind.SlashAssign);
      case kHash:
        if (this.identStartAt(0)) {
          this.identifier(true);
        }
        return;
      default:
        if (this.isDigit(c)) {
          return this.number();
        }
        if (this.isIdentStart(c)) {
          return this.identifier(false);
        }
    }
  }

  private push(kind: TokenKind): void {
    this.tokens.push({
      kind,
      known: KnownName.None,
      start: this.start,
      end: this.cur,
      text: "",
      newline: this.newline,
      hash: false,
    });
  }

  private skipPreamble(): void {
    if (this.at(0) == 0xef && this.at(1) == 0xbb && this.at(2) == 0xbf) {
      this.cur = 3;
    }
    if (this.at(0) == kHash && this.at(1) == kBang) {
      this.skipRestOfLine();
    }
  }

  private atEnd(): boolean {
    return this.cur >= this.end;
  }

  private at(offset: int): int {
    const value = this.source[this.cur + offset] ?? 0;

    return value.toInt();
  }

  private isDigit(c: int): boolean {
    return c >= kZero && c <= kNine;
  }

  private isAlpha(c: int): boolean {
    return (c >= kLowerA && c <= kLowerZ) || (c >= kUpperA && c <= kUpperZ);
  }

  private isIdentStart(c: int): boolean {
    return this.isAlpha(c) || c == kUnderscore || c == kDollar || c >= kHigh;
  }

  private isIdentChar(c: int): boolean {
    return this.isIdentStart(c) || this.isDigit(c);
  }

  private digitAt(offset: int): boolean {
    const c = this.at(offset);

    return this.isDigit(c);
  }

  private alphaAt(offset: int): boolean {
    const c = this.at(offset);

    return this.isAlpha(c);
  }

  private identStartAt(offset: int): boolean {
    const c = this.at(offset);

    return this.isIdentStart(c);
  }

  private identCharAt(offset: int): boolean {
    const c = this.at(offset);

    return this.isIdentChar(c);
  }

  private isLineBreak(): boolean {
    const c = this.at(0);
    if (c == kNewline || c == kReturn) {
      return true;
    }

    return (
      c == 0xe2 &&
      this.at(1) == 0x80 &&
      (this.at(2) == 0xa8 || this.at(2) == 0xa9)
    );
  }

  private pushOperator(plain: TokenKind, withAssign: TokenKind): void {
    const assign = this.match(kEquals);
    const kind = assign ? withAssign : plain;
    this.push(kind);
  }

  private match(c: int): boolean {
    if (this.at(0) != c) {
      return false;
    }
    this.cur += 1;

    return true;
  }

  private skipTrivia(): boolean {
    let newline = false;
    while (!this.atEnd()) {
      const c = this.at(0);
      if (c == kNewline) {
        newline = true;
        this.cur += 1;
      } else if (
        c == kSpace ||
        c == kTab ||
        c == kReturn ||
        c == kFormFeed ||
        c == kVerticalTab
      ) {
        this.cur += 1;
      } else if (c == kSlash && this.at(1) == kSlash) {
        this.skipRestOfLine();
      } else if (c == kSlash && this.at(1) == kStar) {
        newline = this.skipBlockComment() || newline;
      } else {
        return newline;
      }
    }

    return newline;
  }

  private skipRestOfLine(): void {
    while (!this.atEnd() && this.at(0) != kNewline) {
      this.cur += 1;
    }
  }

  private skipBlockComment(): boolean {
    let newline = false;
    this.cur += 2;
    while (
      !this.atEnd() &&
      !(this.at(0) == kStar && this.at(1) == kSlash)
    ) {
      if (this.at(0) == kNewline) {
        newline = true;
      }
      this.cur += 1;
    }
    if (!this.atEnd()) {
      this.cur += 2;
    }

    return newline;
  }

  private regexAllowed(): boolean {
    const last = this.tokens[this.tokens.length - 1];

    return last == undefined || regexMayFollow(last.kind);
  }

  private leftBrace(): void {
    const braces = this.braces;
    const last = braces.length - 1;
    if (last >= 0) {
      braces[last] = (braces[last] ?? 0) + 1;
    }
    this.push(TokenKind.LBrace);
  }

  private rightBrace(): void {
    const braces = this.braces;
    const last = braces.length - 1;
    if (last < 0) {
      return this.push(TokenKind.RBrace);
    }
    const depth = braces[last] ?? 0;
    if (depth == 0) {
      braces.pop();
      return this.template(true);
    }
    braces[last] = depth - 1;
    this.push(TokenKind.RBrace);
  }

  private regex(): void {
    let inClass = false;
    while (!this.atEnd() && !this.isLineBreak()) {
      const c = this.at(0);
      this.cur += 1;
      if (c == kBackslash) {
        if (!this.atEnd() && !this.isLineBreak()) {
          this.cur += 1;
        }
      } else if (c == kLeftBracket) {
        inClass = true;
      } else if (c == kRightBracket) {
        inClass = false;
      } else if (c == kSlash && !inClass) {
        while (this.identCharAt(0)) {
          this.cur += 1;
        }
        return this.push(TokenKind.Regex);
      }
    }
    this.push(TokenKind.Regex);
  }

  private number(): void {
    const byte = this.source[this.start] ?? 0;
    const first = byte.toInt();
    const second = this.at(0);
    if (first == kZero && this.isRadixLetter(second)) {
      return this.radixNumber();
    }
    const leadingDot = first == kDot;
    this.skipDigits();
    const fraction = leadingDot || this.acceptFraction();
    const exponent = this.acceptExponent();
    const kind = fraction || exponent ? TokenKind.Float : TokenKind.Int;
    this.finishNumber(kind);
  }

  private isRadixLetter(c: int): boolean {
    return (
      c == kLowerX ||
      c == kUpperX ||
      c == kLowerB ||
      c == kUpperB ||
      c == kLowerO ||
      c == kUpperO
    );
  }

  private acceptFraction(): boolean {
    if (this.at(0) != kDot) {
      return false;
    }
    const next = this.at(1);
    const exponentLetter = next == kLowerE || next == kUpperE;
    const member = this.isIdentStart(next) && !exponentLetter;
    if (member) {
      return false;
    }
    this.cur += 1;
    this.skipDigits();

    return true;
  }

  private acceptExponent(): boolean {
    const letter = this.at(0);
    if (letter != kLowerE && letter != kUpperE) {
      return false;
    }
    const sign = this.at(1);
    const signed = sign == kPlus || sign == kMinus;
    const digits = signed ? this.digitAt(2) : this.digitAt(1);
    if (!digits) {
      return false;
    }
    this.cur += 2;
    this.skipDigits();

    return true;
  }

  private radixNumber(): void {
    this.cur += 1;
    while (
      this.alphaAt(0) ||
      this.digitAt(0) ||
      this.at(0) == kUnderscore
    ) {
      this.cur += 1;
    }
    const suffix = this.at(-1) == kLowerN;
    const length = this.cur - this.start;
    const digits = length - kRadixPrefixLength - 1;
    if (suffix && digits > 0) {
      this.cur -= 1;
    }
    this.finishNumber(TokenKind.Int);
  }

  private skipDigits(): void {
    while (this.digitAt(0) || this.at(0) == kUnderscore) {
      this.cur += 1;
    }
  }

  private finishNumber(kind: TokenKind): void {
    if (this.at(0) == kLowerN && !this.identCharAt(1)) {
      this.push(kind);
      this.cur += 1;
      return;
    }
    if (this.identStartAt(0)) {
      while (this.identCharAt(0)) {
        this.cur += 1;
      }
    }
    this.push(kind);
  }

  private string(quote: int): void {
    while (
      !this.atEnd() &&
      this.at(0) != kNewline &&
      this.at(0) != kReturn
    ) {
      const c = this.at(0);
      this.cur += 1;
      if (c == quote) {
        break;
      }
      if (c == kBackslash && !this.atEnd()) {
        this.cur += 1;
      }
    }
    this.push(TokenKind.String);
  }

  private template(continuation: boolean): void {
    const closed = continuation
      ? TokenKind.TemplateTail
      : TokenKind.TemplateString;
    const opened = continuation
      ? TokenKind.TemplateMiddle
      : TokenKind.TemplateHead;
    while (!this.atEnd()) {
      const c = this.at(0);
      this.cur += 1;
      if (c == kBacktick) {
        return this.push(closed);
      }
      if (c == kDollar && this.at(0) == kLeftBrace) {
        this.cur += 1;
        this.braces.push(0);
        return this.push(opened);
      }
      if (c == kBackslash && !this.atEnd()) {
        this.cur += 1;
      }
    }
    this.push(closed);
  }

  private identifier(hash: boolean): void {
    const start = hash ? this.start + 1 : this.start;
    while (this.identCharAt(0)) {
      this.cur += 1;
    }
    const text = this.source.toString("utf8", start, this.cur);
    const kind = hash ? TokenKind.Identifier : kTokenTable.keywordKind(text);
    const known = hash ? KnownName.None : kTokenTable.knownName(text);
    this.tokens.push({
      kind,
      known,
      start,
      end: this.cur,
      text,
      newline: this.newline,
      hash,
    });
  }
}
