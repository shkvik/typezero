import { replace } from "tz:mem";
import { basename, isAbsolute, join } from "node:path";
import { ManifestReader } from "../manifest-reader/manifest-reader.tz";
import {
  kFirstRange,
  kLatestWord,
  kLocalNames,
  kLocalPrefix,
  kLocalStarts,
  kNpmPrefix,
  kNpmSourceText,
  kRemotePrefixes,
  kUniqueMark,
  kVersionStarts,
} from "./const/package-graph.const.tz";
import {
  DependencySource,
  DependencySourceKind,
  Manifest,
  PackageInfo,
} from "./types/package-graph.types.tz";

export class PackageGraph {
  public readonly packages: PackageInfo[];
  private readonly reader: ManifestReader;
  private readonly names: Set<string>;

  public constructor(reader: Own<ManifestReader>) {
    this.packages = [];
    this.reader = reader;
    this.names = new Set<string>();
  }

  public build(entryDirectory: string): void {
    const path = this.reader.findAbove(entryDirectory);
    if (path == undefined) {
      return;
    }

    const root = this.reader.read(path);
    if (root == undefined) {
      return;
    }

    const locals = this.localManifests(root);
    if (this.reader.errors.length > 0) {
      return;
    }

    const ids = Array.from(locals.keys()).sort();
    const index = new Map<string, int>();

    for (let at = 0; at < ids.length; at++) {
      index.set(ids[at] ?? "", at + 1);
    }

    const first = this.packageOf(root, 0, index);

    this.packages.push(first);

    for (const id of ids) {
      const local = locals.get(id);
      if (local != undefined) {
        const made = this.packageOf(local, index.get(id) ?? 0, index);

        this.packages.push(made);
      }
    }
  }

  public readonly errors(): string[] {
    return this.reader.errors.slice();
  }

  public readonly isPresent(): boolean {
    return this.packages.length > 0;
  }

  public readonly packageAt(index: int): Read<PackageInfo> | undefined {
    return this.packages[index];
  }

  public takePackages(): PackageInfo[] {
    return replace(this.packages, []);
  }

  private packageOf(
    manifest: Read<Manifest>,
    at: int,
    index: Read<Map<string, int>>,
  ): PackageInfo {
    const aliasNames: string[] = [];
    const aliasTargets: int[] = [];
    const remote: string[] = [];

    for (const dependency of manifest.dependencies) {
      const source = this.sourceOf(dependency.spec, manifest.directory);
      if (source.kind == DependencySourceKind.Remote) {
        remote.push(dependency.alias);
      }
      if (source.kind != DependencySourceKind.Local) {
        continue;
      }

      const target = index.get(this.localId(source.directory));
      if (target != undefined) {
        aliasNames.push(dependency.alias);
        aliasTargets.push(target);
      }
    }

    return {
      name: this.packageName(manifest, at),
      directory: manifest.directory,
      manifestPath: manifest.path,
      main: manifest.main,
      exports: manifest.exports.slice(),
      aliasNames,
      aliasTargets,
      remote,
    };
  }

  private packageName(manifest: Read<Manifest>, at: int): string {
    if (at == 0) {
      return "";
    }
    if (manifest.name != "") {
      return this.uniqueName(manifest.name);
    }

    return this.uniqueName(basename(manifest.directory));
  }

  private uniqueName(name: string): string {
    let unique = name;
    let count = 2;

    while (this.names.has(unique)) {
      unique = `${name}${kUniqueMark}${count}`;
      count += 1;
    }

    this.names.add(unique);

    return unique;
  }

  private localManifests(root: Read<Manifest>): Map<string, Manifest> {
    const found = new Map<string, Manifest>();
    const queue: string[] = [];
    const first = this.localDirectories(root);

    this.addLocals(first, found, queue);

    for (let next = 0; next < queue.length; next++) {
      const manifest = found.get(queue[next] ?? "");
      if (manifest == undefined) {
        continue;
      }

      const directories = this.localDirectories(manifest);

      this.addLocals(directories, found, queue);
    }

    return found;
  }

  private localDirectories(manifest: Read<Manifest>): string[] {
    const directories: string[] = [];

    for (const dependency of manifest.dependencies) {
      const source = this.sourceOf(dependency.spec, manifest.directory);
      if (source.kind == DependencySourceKind.Problem) {
        this.reader.errors.push(`${manifest.path}: ${source.message}`);

        continue;
      }
      if (source.kind == DependencySourceKind.Local) {
        directories.push(source.directory);
      }
    }

    return directories;
  }

  private addLocals(
    directories: Read<string[]>,
    found: Map<string, Manifest>,
    queue: string[],
  ): void {
    for (const directory of directories) {
      const id = this.localId(directory);
      if (found.has(id)) {
        continue;
      }

      const local = this.reader.readPackageDirectory(directory);
      if (local != undefined) {
        found.set(id, local);
        queue.push(id);
      }
    }
  }

  private readonly localId(directory: string): string {
    const slashed = directory.replaceAll("\\", "/");

    return `${kLocalPrefix}${slashed}`;
  }

  private readonly sourceOf(spec: string, base: string): DependencySource {
    const isRemote = kRemotePrefixes.some((prefix) => spec.startsWith(prefix));
    if (isRemote) {
      return { kind: DependencySourceKind.Remote };
    }

    const isLocal = spec.startsWith(kLocalPrefix);
    const rest = this.localRest(spec, isLocal);
    const isRelative =
      kLocalStarts.some((start) => rest.startsWith(start)) ||
      kLocalNames.includes(rest);
    if (isLocal || isRelative) {
      return this.localSource(rest, base);
    }
    if (rest.startsWith(kNpmPrefix)) {
      return this.sourceProblem(kNpmSourceText);
    }
    if (this.isVersion(rest)) {
      const range = this.shownRange(rest);

      return this.sourceProblem(
        `'${spec}' is a version, but not where the package comes from; tz takes packages from JSR and git: write e.g. 'jsr:@scope/name@${range}'`,
      );
    }

    return this.sourceProblem(
      `'${spec}' does not say where the package comes from; write 'jsr:@scope/name@^1', 'github:user/repo@v1.0.0', 'git:<address>@v1.0.0' or 'file:<directory>'`,
    );
  }

  private readonly localRest(spec: string, isLocal: boolean): string {
    if (isLocal) {
      return spec.slice(kLocalPrefix.length);
    }

    return spec;
  }

  private readonly localSource(rest: string, base: string): DependencySource {
    const full = this.fullPath(rest, base);
    if (!this.reader.isDirectory(full)) {
      return this.sourceProblem(`there is no directory '${rest}' in ${base}`);
    }

    const directory = this.reader.canonical(full);

    return { kind: DependencySourceKind.Local, directory };
  }

  private readonly fullPath(rest: string, base: string): string {
    if (isAbsolute(rest)) {
      return rest;
    }

    return join(base, rest);
  }

  private readonly isVersion(rest: string): boolean {
    const first = rest.slice(0, 1);

    return rest == kLatestWord || kVersionStarts.includes(first);
  }

  private readonly shownRange(rest: string): string {
    if (rest == kLatestWord) {
      return kFirstRange;
    }

    return rest;
  }

  private readonly sourceProblem(message: string): DependencySource {
    return { kind: DependencySourceKind.Problem, message };
  }
}
