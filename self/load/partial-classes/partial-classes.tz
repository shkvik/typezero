import { basename, dirname, relative, resolve } from "node:path";
import { replace } from "tz:mem";
import { Code } from "../../diagnostic/code.tz";
import {
  Details,
  SourceError,
} from "../../diagnostic/types/message.types.tz";
import { ModulePath } from "../../program/ast/types/ast.types.modules.tz";
import { StmtKind } from "../../program/ast/types/ast.types.statements.tz";
import {
  kPathSeparator,
  kWindowsSeparator,
} from "../../program/module/const/module.const.tz";
import { LinkKind } from "../../program/module/types/module.types.tz";
import { ClassDecl } from "../../program/syntax/types/syntax.types.classes.tz";
import { ImportDecl } from "../../program/syntax/types/syntax.types.modules.tz";
import { OpenModule } from "../loader/types/loader.types.tz";
import {
  ImportedClass,
  PartJoin,
  PartSearch,
  PartTarget,
} from "./types/partial-classes.types.tz";
import {
  kHerePrefix,
  kParentStart,
  kTypeParamJoin,
} from "./const/partial-classes.const.tz";

export class PartialClasses {
  private modules: OpenModule[];
  private readonly order: int[];
  private joins: PartJoin[];
  private readonly joined: Map<string, string[]>;

  public constructor(modules: Own<OpenModule[]>, order: Own<int[]>) {
    this.modules = modules;
    this.order = order;
    this.joins = [];
    this.joined = new Map<string, string[]>();
  }

  public join(): void {
    const order = this.order.slice();

    for (const id of order) {
      this.checkPartLists(id);
    }

    const homes = new Map<string, int>();

    for (const id of order) {
      this.joinModuleParts(id, homes);
    }
  }

  public takeModules(): OpenModule[] {
    return replace(this.modules, []);
  }

  public takeJoins(): PartJoin[] {
    return replace(this.joins, []);
  }

  private checkPartLists(id: int): void {
    const lists = this.partListsOf(id);

    for (const index of lists) {
      this.checkPartList(id, index);
    }
  }

  private readonly partListsOf(id: int): int[] {
    const found: int[] = [];
    const module = this.modules[id];
    if (module == undefined) {
      return found;
    }

    const imports = module.parsed.file.imports;

    for (let index = 0; index < imports.length; index++) {
      if (imports[index]?.isPartList == true) {
        found.push(index);
      }
    }

    return found;
  }

  private readonly importAt(
    id: int,
    index: int,
  ): Read<ImportDecl | undefined> {
    return this.modules[id]?.parsed.file.imports[index];
  }

  private checkPartList(id: int, index: int): void {
    const from = this.importAt(id, index)?.from;
    const loc = this.importAt(id, index)?.loc ?? 0;
    if (from == undefined) {
      return;
    }

    const listed = this.linkedModule(id, from);
    if (listed == undefined || this.hasPartOf(listed, id)) {
      return;
    }

    this.report(id, loc, Code.PartListWithoutPart, { path: from.path });
  }

  private readonly hasPartOf(listed: int, id: int): boolean {
    const parts = this.partsIn(listed);

    return parts.some((part) => this.isPartOf(listed, part, id));
  }

  private readonly partsIn(id: int): int[] {
    const parts: int[] = [];
    const module = this.modules[id];
    if (module == undefined) {
      return parts;
    }

    const items = module.parsed.file.items;

    for (let index = 0; index < items.length; index++) {
      const item = items[index];
      if (item?.kind == StmtKind.Class && item.isPartial) {
        parts.push(index);
      }
    }

    return parts;
  }

  private readonly classAt(
    id: int,
    item: int,
  ): Read<ClassDecl | undefined> {
    const stmt = this.modules[id]?.parsed.file.items[item];
    if (stmt == undefined || stmt.kind != StmtKind.Class) {
      return undefined;
    }

    return stmt;
  }

  private readonly classNameAt(id: int, item: int): string {
    return this.classAt(id, item)?.name ?? "";
  }

  private readonly classLocAt(id: int, item: int): int {
    return this.classAt(id, item)?.loc ?? 0;
  }

  private readonly isPartOf(id: int, item: int, classModule: int): boolean {
    const word = this.classNameAt(id, item);
    const imported = this.importedAs(id, word);
    if (imported == undefined) {
      return false;
    }

    const from = this.linkedModule(id, imported.from);

    return from == classModule;
  }

  private joinModuleParts(id: int, homes: Map<string, int>): void {
    const parts = this.partsIn(id);

    for (const item of parts) {
      this.modules[id]?.partItems.push(item);
      this.joinPart(id, item, homes);
    }
  }

  private joinPart(id: int, item: int, homes: Map<string, int>): void {
    const word = this.classNameAt(id, item);
    const found = this.foundTarget(id, item, word);
    const target = found.target;
    const problem = found.problem;
    if (problem != undefined) {
      this.modules[id]?.problems.push(problem);
    }
    if (target == undefined) {
      return;
    }

    const shape = this.shapeProblems(id, item, word);

    for (const one of shape.drain()) {
      this.modules[id]?.problems.push(one);
    }

    const part: PartTarget = { module: id, item };
    if (!this.hasSameTypeParams(part, target)) {
      const other = this.typeParamsText(target);
      const loc = this.classLocAt(id, item);

      this.report(id, loc, Code.PartTypeParams, { word, other });

      return;
    }

    this.joinMethods(part, target, word, homes);
  }

  private readonly foundTarget(id: int, item: int, word: string): PartSearch {
    const loc = this.classLocAt(id, item);
    const imported = this.importedAs(id, word);
    if (imported == undefined) {
      const other = word.toLowerCase();
      const details = { word, other };

      return { problem: { code: Code.PartClassNotImported, loc, details } };
    }

    const from = imported.from;
    const path = from.path;
    const classModule = this.linkedModule(id, from);
    if (classModule == undefined) {
      return {};
    }
    if (this.isLibraryModule(classModule)) {
      const details = { word, path };

      return { problem: { code: Code.PartOfLibraryClass, loc, details } };
    }

    const declared = this.declaredClass(classModule, imported.name.name);
    if (declared == undefined) {
      const details = { word, path };

      return { problem: { code: Code.PartClassNotDeclared, loc, details } };
    }
    if (!this.listsPart(classModule, id)) {
      const details = {
        word,
        other: basename(this.fileOf(classModule)),
        path: this.importPath(classModule, id),
      };

      return { problem: { code: Code.PartNotListed, loc, details } };
    }
    if (this.extendsValue(classModule, declared)) {
      const details = { word };

      return {
        problem: { code: Code.PartOfClassExtendingValue, loc, details },
      };
    }

    return { target: { module: classModule, item: declared } };
  }

  private readonly extendsValue(id: int, item: int): boolean {
    return this.classAt(id, item)?.baseExpr != undefined;
  }

  private readonly isLibraryModule(id: int): boolean {
    return this.modules[id]?.parsed.source.isLibrary == true;
  }

  private readonly fileOf(id: int): string {
    return this.modules[id]?.file ?? "";
  }

  private readonly importedAs(
    id: int,
    word: string,
  ): ImportedClass | undefined {
    const module = this.modules[id];
    if (module == undefined) {
      return undefined;
    }

    for (const decl of module.parsed.file.imports) {
      const name = decl.names.find((one) => one.as == word);
      if (name != undefined) {
        return { from: decl.from, name };
      }
    }

    return undefined;
  }

  private readonly declaredClass(id: int, name: string): int | undefined {
    const module = this.modules[id];
    if (module == undefined) {
      return undefined;
    }

    const items = module.parsed.file.items;

    for (let index = 0; index < items.length; index++) {
      const item = items[index];
      if (item == undefined || item.kind != StmtKind.Class) {
        continue;
      }
      if (!item.isPartial && item.name == name) {
        return index;
      }
    }

    return undefined;
  }

  private readonly listsPart(classModule: int, id: int): boolean {
    const lists = this.partListsOf(classModule);

    return lists.some((index) => this.listsModule(classModule, index, id));
  }

  private readonly listsModule(module: int, index: int, id: int): boolean {
    const from = this.importAt(module, index)?.from;
    if (from == undefined) {
      return false;
    }

    return this.linkedModule(module, from) == id;
  }

  private readonly shapeProblems(
    id: int,
    item: int,
    word: string,
  ): SourceError[] {
    const found: SourceError[] = [];
    const part = this.classAt(id, item);
    if (part == undefined) {
      return found;
    }

    const field = part.fields[0];
    if (field != undefined) {
      const details = { word, other: field.name };

      found.push({ code: Code.PartHasField, loc: field.loc, details });
    }

    const made = part.constructors[0];
    if (made != undefined) {
      const details = { word };

      found.push({ code: Code.PartHasConstructor, loc: made.loc, details });
    }

    const hasHeader =
      part.base != undefined ||
      part.baseExpr != undefined ||
      part.interfaces.length > 0;
    if (hasHeader) {
      const details = { word };

      found.push({ code: Code.PartHasHeader, loc: part.loc, details });
    }

    const decorator = part.decorators[0];
    if (decorator != undefined) {
      const details = { word };
      const loc = decorator.loc;

      found.push({ code: Code.PartHasDecorators, loc, details });
    }

    return found;
  }

  private readonly hasSameTypeParams(
    part: PartTarget,
    target: PartTarget,
  ): boolean {
    const written = this.classAt(part.module, part.item)?.typeParams;
    const declared = this.classAt(target.module, target.item)?.typeParams;
    if (written == undefined || declared == undefined) {
      return false;
    }
    if (written.length != declared.length) {
      return false;
    }

    for (let index = 0; index < written.length; index++) {
      const param = written[index];
      const same =
        param.name == declared[index]?.name &&
        param.constraint == undefined &&
        param.defaultType == undefined;
      if (!same) {
        return false;
      }
    }

    return true;
  }

  private readonly typeParamsText(target: PartTarget): string {
    const decl = this.classAt(target.module, target.item);
    if (decl == undefined || decl.typeParams.length == 0) {
      return "";
    }

    const names = decl.typeParams.map((param) => param.name);

    return `<${names.join(kTypeParamJoin)}>`;
  }

  private readonly methodNames(target: PartTarget): string[] {
    const decl = this.classAt(target.module, target.item);
    if (decl == undefined) {
      return [];
    }

    return decl.methods.map((method) => method.name);
  }

  private readonly methodPlaces(part: PartTarget): int[] {
    const decl = this.classAt(part.module, part.item);
    if (decl == undefined) {
      return [];
    }

    return decl.methods.map((method) => method.loc);
  }

  private joinMethods(
    part: PartTarget,
    target: PartTarget,
    word: string,
    homes: Map<string, int>,
  ): void {
    const id = part.module;
    const names = this.methodNames(part);
    const places = this.methodPlaces(part);
    const targetKey = `${target.module} ${target.item}`;
    const declared = this.joinedNames(targetKey, target);

    for (let index = 0; index < names.length; index++) {
      const name = names[index];
      const key = `${target.module} ${word} ${name}`;
      const home = homes.get(key) ?? target.module;
      if (declared.includes(name) && home != id) {
        const path = basename(this.fileOf(home));
        const loc = places[index] ?? 0;

        this.report(id, loc, Code.PartMethodTwice, {
          word: name,
          other: word,
          path,
        });
      } else {
        declared.push(name);
        this.joins.push({ target, part, method: index });
        homes.set(key, id);
      }
    }

    this.joined.set(targetKey, declared);
  }

  private readonly joinedNames(key: string, target: PartTarget): string[] {
    const known = this.joined.get(key);
    if (known != undefined) {
      return known.slice();
    }

    return this.methodNames(target);
  }

  private readonly linkedModule(id: int, from: ModulePath): int | undefined {
    const module = this.modules[id];
    const link = module?.links.find((one) => one.from.loc == from.loc);
    if (link == undefined || link.kind != LinkKind.Module) {
      return undefined;
    }

    return link.target;
  }

  private readonly importPath(from: int, to: int): string {
    const base = dirname(resolve(this.fileOf(from)));
    const target = resolve(this.fileOf(to));
    const native = relative(base, target);
    const path = native.replaceAll(kWindowsSeparator, kPathSeparator);
    if (path.startsWith(kParentStart)) {
      return path;
    }

    return `${kHerePrefix}${path}`;
  }

  private report(id: int, loc: int, code: Code, details: Own<Details>): void {
    this.modules[id]?.problems.push({ code, loc, details });
  }
}
