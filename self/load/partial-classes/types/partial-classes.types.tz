import { SourceError } from "../../../diagnostic/types/message.types.tz";
import {
  ModuleName,
  ModulePath,
} from "../../../program/ast/types/ast.types.modules.tz";

export type PartTarget = {
  readonly module: int;
  readonly item: int;
};

export type PartSearch = {
  readonly target?: PartTarget;
  readonly problem?: SourceError;
};

export type ImportedClass = {
  readonly from: ModulePath;
  readonly name: ModuleName;
};

export type PartJoin = {
  readonly target: PartTarget;
  readonly part: PartTarget;
  readonly method: int;
};
