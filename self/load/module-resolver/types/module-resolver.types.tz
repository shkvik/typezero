import { Code } from "../../../diagnostic/code.tz";
import { Details } from "../../../diagnostic/types/message.types.tz";
import { LibraryModule } from "../../../program/library/library-modules/types/library-modules.types.tz";

export enum ResolutionKind {
  File,
  Library,
  Package,
  Problem,
}

export type Resolution =
  | {
      readonly kind: ResolutionKind.File;
      readonly file: string;
      readonly package: int;
    }
  | { readonly kind: ResolutionKind.Library; readonly module: LibraryModule }
  | { readonly kind: ResolutionKind.Package }
  | {
      readonly kind: ResolutionKind.Problem;
      readonly code: Code;
      readonly details: Details;
    };

export enum LocationKind {
  Found,
  OtherCase,
  Absent,
}

export type Location =
  | {
      readonly kind: LocationKind.Found | LocationKind.OtherCase;
      readonly file: string;
      readonly written: string;
    }
  | { readonly kind: LocationKind.Absent };
