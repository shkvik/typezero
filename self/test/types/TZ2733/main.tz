// 'override' replaces a method of the class extended.
class Animal {
  public name: string;

  public constructor(name: string) {
    this.name = name;
  }

  public speak(): string {
    return "...";
  }
}

class Fish extends Animal {
  public constructor() {
    super("fish");
  }

  public override speak(): string {
    return "blub";
  }

  public override swim(): void {}
}
