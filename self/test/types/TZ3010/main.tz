// A value fitting several variants equally chooses none.
class Animal {
  public name: string;

  public constructor(name: string) {
    this.name = name;
  }
}

class Dog extends Animal {}

class Shelter {
  public take(a: Animal, b: Dog): int {
    return 1;
  }

  public take(a: Dog, b: Animal): int {
    return 2;
  }
}

const dog = new Dog("rex");

new Shelter().take(dog, dog);
