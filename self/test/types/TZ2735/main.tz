// An override returns what the method it replaces returns.
class Animal {
  public name: string;

  public constructor(name: string) {
    this.name = name;
  }

  public speak(): string {
    return "...";
  }
}

class Snake extends Animal {
  public constructor() {
    super("snake");
  }

  public speak() {
    return 5;
  }
}

class Worm extends Animal {
  public constructor() {
    super("worm");
  }

  public speak(): int {
    return 0;
  }
}
