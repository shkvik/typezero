// The constructor of a class that extends another calls 'super(...)'.
class Animal {
  public name: string;

  public constructor(name: string) {
    this.name = name;
  }

  public speak(): string {
    return "...";
  }
}

class Dog extends Animal {
  public constructor() {
    super("dog");
  }
}

class Bird extends Animal {
  public constructor() {
    console.log("no super");
  }
}
