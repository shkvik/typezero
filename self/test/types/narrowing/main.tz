// A check narrows the type of a variable or a parameter: in the branch it
// guards, after a branch that leaves, and on the right of '&&' and '||'.
type Dir = "up" | "down" | "left";
type Shape = { side: int };

function present(x: int | undefined): int {
  if (x == undefined) {
    return 0;
  }

  const after = x;

  return after;
}

function inside(x: int | undefined): int {
  if (x != undefined) {
    const within = x;

    return within;
  }

  return 0;
}

function literal(text: string): Dir | undefined {
  if (text == "up" || text == "down") {
    const chosen = text;

    return chosen;
  }

  return undefined;
}

function kinds(v: string | int | boolean): string {
  if (typeof v == "string") {
    const word = v;

    return word;
  }

  const rest = v;

  if (typeof v == "int") {
    return "n";
  }

  const last = v;

  return "b";
}

function anything(v: unknown): string {
  if (typeof v == "string") {
    const word = v;

    return word;
  }

  return "?";
}

function object(s: Shape | undefined): int {
  if (!s) {
    return 0;
  }

  const shape = s;

  return 1;
}

function guarded(x: int | undefined, flag: boolean): int {
  const picked = x != undefined && flag ? x : 0;
  const added = x != undefined && x > 1;

  return picked;
}

function either(x: int | string | undefined): int {
  if (x == undefined || typeof x == "string") {
    const text = x;

    return 0;
  }

  const number = x;

  return number;
}

function stamp(s: Date | string | Map<string, int>): string {
  if (s instanceof Date) {
    return "date";
  }

  const rest = s;

  if (s instanceof Map) {
    return "map";
  }

  return s;
}

function changed(x: int | undefined): int {
  let y = x;

  y = 2;

  if (y == undefined) {
    return 0;
  }

  const still = y;

  return 1;
}
