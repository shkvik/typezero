// The object exists after 'super(...)'.
class Animal {
  public name: string;

  public constructor(name: string) {
    this.name = name;
  }

  public speak(): string {
    return "...";
  }
}

class Dog extends Animal {
  public breed: string;

  public constructor(name: string) {
    console.log(this.breed);
    super(name);
    this.breed = "lab";
  }
}
