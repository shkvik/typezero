function number(text: string): void {
  const read = Number(text);
  if (read.isOk()) {
    const value = read.value;
    const zero = 0.0;

    if (value == zero) {
      console.log(`ok ${1.0 / value}`);
    } else {
      console.log(`ok ${value}`);
    }
  } else {
    console.log(`err ${read.error.code} ${read.error.message}`);
  }
}

function integer(text: string, radix: int): void {
  const read = parseInt(text, radix);
  if (read.isOk()) {
    console.log(`ok ${read.value}`);
  } else {
    console.log(`err ${read.error.code} ${read.error.message}`);
  }
}

