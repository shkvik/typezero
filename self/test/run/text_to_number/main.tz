  for (let index = 0; index < 300; index++) {
    value = value * 1.37 + 0.011;
    if (value > 1e200) {
      value = 0.3;
    }

    const read = Number(`${value}`);
    const back = Number(`${1.0 / value}`);

    if (read.isOk() && back.isOk()) {
      total += read.value - value + back.value - 1.0 / value;
    }
  }

  console.log(total);
  console.log(parseInt("123").unwrapOr(0), Number("2.5").unwrapOr(0.0));
