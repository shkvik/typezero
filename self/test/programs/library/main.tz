// Modules of the library come from files next to the compiler, each read
// once: by its name with and without 'node:', and without an import for the
// global names of the library (URL, fetch). A name the file
// declares itself (Headers) or a property (other.Response) brings nothing.
import { EventEmitter } from "node:events";
import { once } from "events";
import { Readable } from "node:stream";
import { readFileSync } from "node:fs";

class Headers {}

const address = new URL("https://example.com");
const answer = fetch(address);
const other = { Response: 1 };
const status = other.Response;
