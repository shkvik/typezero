import { Code } from "../code.tz";
import { Details, SourceError } from "../types/message.types.tz";
import { TrialMark, WrittenError } from "./types/error-log.types.tz";

export class ErrorLog {
  private lists: Cell<Map<int, SourceError[]>>;
  private reported: Cell<Set<string>>;
  private kept: Cell<Set<string>>;
  private written: Cell<WrittenError[]>;
  private trials: Cell<TrialMark[]>;
  private asked: Cell<int>;

  public constructor() {
    this.lists = new Map<int, SourceError[]>();
    this.reported = new Set<string>();
    this.kept = new Set<string>();
    this.written = [];
    this.trials = [];
    this.asked = 0;
  }

  public readonly of(module: int): SourceError[] {
    return this.lists.get(module)?.slice() ?? [];
  }

  public readonly write(module: int, loc: int, code: Code, details: Details): void {
    const key = this.keyOf(module, loc, code);

    this.asked += 1;

    if (this.reported.has(key)) {
      return;
    }

    this.reported.add(key);
    this.lists.getOrInsert(module, []).push({ code, loc, details });

    if (this.trials.length > 0) {
      this.written.push({ module, loc, code });
    }
  }

  public readonly beginTrial(): void {
    this.trials.push({ written: this.written.length, asked: this.asked });
  }

  public readonly endTrial(): boolean {
    const mark = this.trials.pop();
    if (mark == undefined) {
      return true;
    }

    const count = this.written.length - mark.written;
    const tail = this.written.splice(mark.written, count);

    for (const entry of tail) {
      this.drop(entry);
    }

    return this.asked == mark.asked;
  }

  public readonly count(): int {
    return this.asked;
  }

  public readonly isTrying(): boolean {
    return this.trials.length > 0;
  }

  public readonly mark(): int {
    return this.written.length;
  }

  public readonly keepSince(mark: int): void {
    for (let index = mark; index < this.written.length; index++) {
      const entry = this.written[index];
      if (entry != undefined) {
        const key = this.keyOf(entry.module, entry.loc, entry.code);

        this.kept.add(key);
      }
    }
  }

  private readonly drop(entry: WrittenError): void {
    const key = this.keyOf(entry.module, entry.loc, entry.code);
    if (this.kept.has(key)) {
      return;
    }

    const place = this.lastPlace(entry);
    if (place >= 0) {
      this.lists.get(entry.module)?.splice(place, 1);
    }

    this.reported.delete(key);
  }

  private readonly lastPlace(entry: WrittenError): int {
    const count = this.lists.get(entry.module)?.length ?? 0;

    for (let index = count - 1; index >= 0; index--) {
      const error = this.lists.get(entry.module)?.[index];
      const isSame =
        error != undefined &&
        error.loc == entry.loc &&
        error.code == entry.code;
      if (isSame) {
        return index;
      }
    }

    return -1;
  }

  private readonly keyOf(module: int, loc: int, code: Code): string {
    return `${module} ${loc} ${code}`;
  }
}

export type InternedErrorLog = Interned<ErrorLog>;
