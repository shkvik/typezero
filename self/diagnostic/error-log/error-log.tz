import { Code } from "../code.tz";
import { Details, SourceError } from "../types/message.types.tz";
import { TrialMark, WrittenError } from "./types/error-log.types.tz";

export class ErrorLog {
  private lists: Map<int, SourceError[]>;
  private reported: Set<string>;
  private kept: Set<string>;
  private written: WrittenError[];
  private trials: TrialMark[];
  private asked: int;
  private allowed?: Set<int>;

  public constructor() {
    this.lists = new Map<int, SourceError[]>();
    this.reported = new Set<string>();
    this.kept = new Set<string>();
    this.written = [];
    this.trials = [];
    this.asked = 0;
  }

  public readonly of(module: int): SourceError[] {
    const list = this.lists.get(module);
    if (list == undefined) {
      return [];
    }

    return list.slice();
  }

  public allow(module: int): void {
    if (this.allowed == undefined) {
      this.allowed = new Set<int>();
    }

    this.allowed.add(module);
  }

  public writeFound(module: int, error: SourceError | undefined): void {
    if (error != undefined) {
      this.write(module, error.loc, error.code, error.details);
    }
  }

  public writeAll(module: int, errors: Read<SourceError[]>): void {
    for (const error of errors) {
      this.write(module, error.loc, error.code, error.details);
    }
  }

  public write(module: int, loc: int, code: Code, details: Details): void {
    if (this.allowed != undefined && !this.allowed.has(module)) {
      return;
    }

    const key = this.keyOf(module, loc, code);

    this.asked += 1;

    if (this.reported.has(key)) {
      return;
    }

    this.reported.add(key);

    const error: SourceError = { code, loc, details };
    const list = this.lists.get(module);
    if (list == undefined) {
      this.lists.set(module, [error]);
    } else {
      list.push(error);
    }
    if (this.trials.length > 0) {
      this.written.push({ module, loc, code });
    }
  }

  public beginTrial(): void {
    this.trials.push({ written: this.written.length, asked: this.asked });
  }

  public endTrial(): boolean {
    const mark = this.trials.pop();
    if (mark == undefined) {
      return true;
    }

    const count = this.written.length - mark.written;
    const tail = this.written.splice(mark.written, count);

    for (const entry of tail) {
      this.drop(entry);
    }

    return this.asked == mark.asked;
  }

  public readonly count(): int {
    return this.asked;
  }

  public readonly isTrying(): boolean {
    return this.trials.length > 0;
  }

  public readonly mark(): int {
    return this.written.length;
  }

  public keepSince(mark: int): void {
    for (let index = mark; index < this.written.length; index++) {
      const entry = this.written[index];
      if (entry != undefined) {
        const key = this.keyOf(entry.module, entry.loc, entry.code);

        this.kept.add(key);
      }
    }
  }

  private drop(entry: WrittenError): void {
    const key = this.keyOf(entry.module, entry.loc, entry.code);
    if (this.kept.has(key)) {
      return;
    }

    const place = this.lastPlace(entry);
    const list = this.lists.get(entry.module);
    if (place >= 0 && list != undefined) {
      list.splice(place, 1);
    }

    this.reported.delete(key);
  }

  private readonly lastPlace(entry: WrittenError): int {
    const list = this.lists.get(entry.module);
    if (list == undefined) {
      return -1;
    }

    for (let index = list.length - 1; index >= 0; index--) {
      const error = list[index];
      const isSame =
        error != undefined &&
        error.loc == entry.loc &&
        error.code == entry.code;
      if (isSame) {
        return index;
      }
    }

    return -1;
  }

  private readonly keyOf(module: int, loc: int, code: Code): string {
    return `${module} ${loc} ${code}`;
  }
}

