  [Code.FsEncodingDepends]: {
    text: "the encoding of '{word}' is written as a literal, 'utf8': the type of what it gives depends on it",
  },
  [Code.FsEncodingForText]: {
    text: "an encoding is for text; '{word}' writes the bytes as they are: drop the encoding",
