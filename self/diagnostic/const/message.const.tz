  [Code.StaticTypeParameters]: {
    text: "static field '{word}' cannot use the type parameters of '{first}': every instance of the class shares it",
  },
  [Code.MustCallSuper]: {
    text: "the constructor of '{first}' must call 'super(...)': '{first}' extends '{word}', whose constructor sets the fields it declares",
