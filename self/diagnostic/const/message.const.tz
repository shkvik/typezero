  [Code.CallbackNoValue]: {
    text: "the callback of '{word}' must return a value",
  },
  [Code.CompareNotNumber]: {
    text: "a comparison function must return a number (negative, zero or positive), found '{word}'",
  },
  [Code.CallbackNotFunction]: {
    text: "'{word}' needs a function, found '{first}'",
  },
  [Code.CallbackRest]: {
    text: "{word} takes a rest parameter; pass an arrow that calls it instead",
