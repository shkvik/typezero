  [Code.SpreadMismatch]: {
    text: "cannot spread '{first}' into '{second}'",
  },
  [Code.DefaultedProperty]: {
    text: "'{word} = ...' gives a default value, which only a destructuring pattern such as '({ {word} = 1 } = o)' has; in an object literal write '{word}: ...'",
  },
  [Code.NumberKey]: {
    text: "a number cannot name a field; an object with numbered entries is an array",
  },
  [Code.RuntimeKey]: {
    text: "a key in brackets must be known when compiling: a string literal, or a constant declared with one, such as 'const key = \"name\"'; keys computed when the program runs need a dictionary: declare it as one, e.g. 'const d: Record<string, int> = {}'",
  },
