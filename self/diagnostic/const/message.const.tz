  [Code.StaticNeedsValue]: {
    text: "static field '{word}' needs a value, e.g. 'static {word}: {first} = ...', or make it optional: 'static {word}?: {first}'",
  },
  [Code.StaticNeedsType]: {
    text: "static field '{word}' needs a type: only a literal shows it without checking the value, e.g. 'static {word}: int = ...'",
  },
  [Code.SetLater]: {
    text: "'{word}!' (\"set later\") is not supported: a field gets its value in the constructor; if it may have none, make it optional: '{word}?: T'",
