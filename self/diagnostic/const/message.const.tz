  [Code.FunctionOrAssign]: {
    text: "a function is always truthy, so '||=' never assigns; drop the assignment",
  },
  [Code.NumberAndAssign]: {
    text: "'&&=' cannot test {first}: 0 would count as false; compare it: 'if ({word} != 0) {word} = {other}'",
