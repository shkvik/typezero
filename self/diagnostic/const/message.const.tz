  [Code.CallbackParametersUninferred]: {
    text: "cannot infer type parameter '{first}' of '{second}' for the parameters of this function: nothing else in the call says what it is; give it, e.g. '{second}<int>(...)', or the type of the parameter",
  },
  [Code.NotGenericFunction]: {
    text: "'{word}' is not a generic function; remove the type arguments",
