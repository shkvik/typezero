  [Code.SortObjects]: {
    text: "sorting objects needs a comparison function: 'sort()' without one compares them all as '[object Object]'; pass one, e.g. 'sort((a, b) => a.x - b.x)'",
  },
  [Code.SortMixed]: {
    text: "'sort()' without a comparison function compares the values of '{word}' as strings, numbers and objects among them; pass one, e.g. 'sort((a, b) => ...)'",
  },
  [Code.SortNumbers]: {
    text: "'sort()' without a comparison function compares numbers as strings, as in JavaScript: [2, 10, 1] becomes [1, 10, 2]; pass one: 'sort((x, y) => {other})'",
  },
  [Code.ObjectReadOnlyField]: {
    text: "cannot assign to '{word}' because it is a read-only field of '{first}'",
  },
  [Code.NullishNotOptionalVariable]: {
    text: "'??=' needs a variable that may be undefined; '{word}' has type '{first}'",
  },
  [Code.NullishNotOptionalField]: {
    text: "'??=' needs a field that may be undefined; '{word}' has type '{first}'",
  },
  [Code.VoidFieldValue]: {
    text: "an expression of type 'void' cannot be the value of field '{word}'",
  },
  [Code.ForOfCannot]: {
    text: "cannot iterate over a value of type '{word}'",
  },
  [Code.RecordNotIterable]: {
    text: "a Record is not iterable, as an object is not in JavaScript; walk its keys with 'for...in', or its entries with 'for (const [k, v] of Object.entries(r))'",
