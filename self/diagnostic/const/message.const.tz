  [Code.ArrayTextFunctions]: {
    text: "functions cannot be converted to strings",
  },
  [Code.ArrayTextResults]: {
    text: "Results cannot be converted to strings: JavaScript would give '[object Object]'; make the text of each first, e.g. 'a.map(r => r.match(...)).{word}()'",
