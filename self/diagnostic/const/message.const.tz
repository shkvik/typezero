  [Code.FsFlagLiteral]: {
    text: "the flag of '{word}' is written as a literal: {other}",
  },
  [Code.FsData]: {
    text: "'{word}' writes a string or bytes (a Uint8Array or a Buffer); found '{first}'{other}",
  },
  [Code.FsBigint]: {
    text: "'bigint' is not supported: tz has no bigint; the numbers of Stats are doubles",
  },
  [Code.FsRmdirOptions]: {
    text: "the options of 'rmdirSync' are deprecated in Node; to delete a directory with what is in it, use 'rmSync(path, { recursive: true })'",
