  [Code.GenericClosureNotTopLevel]: {
    text: "a generic arrow or function expression can only be the value of a top-level constant for now, e.g. 'const f = <T>(x: T) => x'; or declare a generic function at the top level: 'function f<T>(x: T) { ... }'",
