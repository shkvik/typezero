  [Code.SuperAbstract]: {
    text: "'{word}' is abstract in '{first}': it has no body to call",
  },
  [Code.ParameterCondition]: {
    text: "a value of type '{first}' cannot be a condition: '{first}' may be a number, and 0 would count as false; check for undefined: '{word} != undefined'",
