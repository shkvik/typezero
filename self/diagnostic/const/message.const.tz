  [Code.InObjectFalse]: {
    text: "operator 'in' is not supported for objects: type '{first}' has no field '{word}', so this would always be false",
  },
  [Code.DeleteOptional]: {
    text: "'delete' cannot remove field '{word}': a field that is not there is undefined; write '{first} = undefined'",
  },
  [Code.DeleteRequired]: {
    text: "'delete' cannot remove field '{word}': an object always has the fields of its type",
  },
  [Code.TupleResized]: {
    text: "a tuple has a fixed length, and '{word}' would change it; to change the length, copy it into an array: '[...{first}]'",
