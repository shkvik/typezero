  [Code.ObjectNumberedKey]: {
    text: "type '{first}' has no numbered fields; read a field by its name, e.g. 'o.name'",
  },
  [Code.ObjectRuntimeKey]: {
    text: "type '{first}' can be indexed only by a key known when compiling: a string literal, or a constant declared with one, such as 'const key = \"name\"'; keys computed when the program runs need a dictionary: declare it as one, e.g. 'const d: Record<string, int> = {}'",
