  [Code.ExtendsItselfThrough]: {
    text: "class '{first}' cannot extend itself through '{word}'",
  },
  [Code.ConstructorCallsOverride]: {
    text: "the constructor of '{first}' calls '{word}', which '{other}' overrides: it would run before the fields of '{other}' are set; call it once the object is made",
