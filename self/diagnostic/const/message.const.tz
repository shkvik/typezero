  [Code.FunctionInSwitch]: {
    text: "a function can be declared only directly in a block; in a 'switch', declare it before the 'switch'",
  },
  [Code.FunctionSetsThis]: {
    text: "'{word}' is not supported: it sets 'this', and a method taken as a value is bound to its object already; call the function directly",
