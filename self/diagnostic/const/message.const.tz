  },
  [Code.ProcessChanged]: {
    text: "'process.{word}' cannot be changed",
  },
  [Code.ChildOptionsAt]: {
    text: "the options of '{word}' come after its arguments, e.g. '{word}(file, [\"--version\"], { cwd })'",
  },
  [Code.ChildZeroFile]: {
    text: "could not run it: the {word} has a zero character in it",
