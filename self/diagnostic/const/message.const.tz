  [Code.ImplementsFieldType]: {
    text: "class '{first}' implements '{second}', whose field '{word}' is '{other}', but in '{first}' it is '{place}'; the types must be the same, or objects of a type down the chain of the interface's, such as 'Dog' for 'Animal'",
