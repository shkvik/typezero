  [Code.NeverNotAssignable]: {
    text: "type '{first}' is not assignable to type '{second}'{place}; nothing fits 'never': if it comes from a type argument left out, write it, e.g. 'new ReadableStream<int, MyError>(...)' for a stream that fails with MyError",
