  [Code.ReturnAwait]: {
    text: "'return await' changes nothing: an async function waits for the Promise it returns; write 'return' without 'await'",
  },
  [Code.PromiseNoCatch]: {
    text: "a Promise is not rejected in tz, so it has no 'catch': an operation that may fail gives a Promise<Result<T, E>>; read it after 'await': 'const r = await p; if (r.isErr()) ...'",
