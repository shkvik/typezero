  },
  [Code.RecordSpreadNotObject]: {
    text: "only objects and Records can be spread into a Record, found '{word}'",
  },
  [Code.RecordSpreadCollection]: {
    text: "only objects and Records can be spread into a Record, found '{word}'; in JavaScript a Map or a Set has no own properties, so this would add nothing",
  },
  [Code.GroupByKeys]: {
    text: "the keys of an object are strings, and JavaScript would turn '{word}' keys into them; return a string, or group into a Map: 'Map.groupBy(...)'",
  },
  [Code.FromEntriesKeys]: {
    text: "the keys of an object are strings, and JavaScript would turn '{word}' keys into them; convert them first, or make a Map: 'new Map(...)'",
  },
  [Code.IterableNotParameter]: {
    text: "'Iterable<T>' can only be the type of a parameter of a function declared at the top level or of a method, which it makes generic: a copy for each kind of iterable; here, write the type itself, e.g. 'int[]', or 'Iterator<int>' for any iterator",
  },
  [Code.IterableConstructor]: {
    text: "a constructor cannot take an 'Iterable<{word}>' yet: it would make a copy of the constructor for each kind of iterable; take an array, e.g. '{word}[]', and pass '[...xs]'",
  },
  [Code.IterableNested]: {
    text: "a parameter 'Iterable<{word}>' makes the function generic, and a generic function can be declared only at the top level for now; take an array, e.g. '{word}[]'",
  },
  [Code.IterableElements]: {
    text: "'{word}' gives values of type '{first}', and the parameter 'Iterable<{other}>' of '{second}' takes values of type '{other}'",
  },
  [Code.IterableNotIterable]: {
    text: "'{word}' cannot be iterated, and the parameter 'Iterable<{other}>' of '{second}' takes something that can: an array, a string, a Map, a Set, an iterator, or an object with '[Symbol.iterator]()'",
  },
  [Code.IteratorMethodResult]: {
    text: "'[Symbol.iterator]()' of '{word}' gives '{first}', which is not an iterator: it needs a method 'next()' that gives '{ done, value }' (IteratorResult<T>); or make it a generator, '*[Symbol.iterator]() { yield ... }'",
  },
  [Code.NextNoUnion]: {
    text: "next() of '{word}' gives '{first}', or '{second}' when it is done, and no union holds both: {other}; iterate it with 'for...of', which ignores what it returns",
  },
  [Code.FlatMapResult]: {
    text: "the callback of 'flatMap' must return an array or an iterator, found '{word}'",
  },
  [Code.IteratorFromSource]: {
    text: "'Iterator.from' needs an array, a string or an iterator, found '{word}'",
  },
  [Code.ArrayStaticRefused]: {
    text: "'Array.{word}' is not supported; of Array only 'Array.from' and 'new Array' are",
  },
  [Code.IndexWriteRange]: {
    text: "cannot prove that the index is within the array; check it first, e.g. 'if (i < a.length)'",
  },
  [Code.IndexWriteHoles]: {
    text: "cannot prove that the index is within the array (0 <= index <= length); writing further would leave holes. Check the index first, e.g. 'if (i < a.length)', or use push()",
  },
  [Code.AsyncCallbackDropped]: {
    text: "the Promise of this async function is dropped here, so nothing waits for it to finish; loop with 'for (const x of xs) await f(x)', or wait for all with 'await Promise.all(xs.map(async x => ...))'",
  },
  [Code.CallbackPromiseDropped]: {
    text: "the function returns a Promise that its caller drops, so nothing waits for it to finish; loop with 'for (const x of xs) await f(x)', or wait for all with 'await Promise.all(xs.map(...))'",
  },
  [Code.PromisesNotAwaited]: {
    text: "the Promises are not awaited, so nothing waits for them and an error in one would end the program; wait for all of them with 'await Promise.all(...)', or keep them in a variable",
  },
  [Code.PromiseRejectParam]: {
    text: "a Promise is not rejected in tz, so its function gets only 'resolve'; an operation that may fail gives a Promise<Result<T, E>>: 'resolve(err(e))'",
  },
  [Code.TimerArguments]: {
    text: "arguments for the callback are not supported; pass an arrow that calls it with them",
  },
  [Code.NothingToCatch]: {
    text: "there is nothing to catch: nothing is thrown or rejected in tz, an error is a Result that the code which gets it handles (docs/errors.md, section 4)",
  },
  [Code.DoubleUnrounded]: {
    text: "a double becomes an integer only after rounding, which says what happens to the fraction: 'Math.trunc({word}).{other}()' (or Math.round, Math.floor, Math.ceil)",
  },
  [Code.DoubleToDecimal]: {
    text: "a double is inexact already, so it becomes a decimal through 'decimal({word})', which says so",
  },
  [Code.MathOneType]: {
    text: "the values of 'Math.min', 'Math.max' and 'Math.clamp' must have one type; found '{first}' and '{second}'{place}",
  },
  [Code.DateYearShort]: {
    text: "the year {word} is {other} in JavaScript, which reads the years 0 to 99 as 1900 to 1999; write the year in full, or set a year before 100 with 'setFullYear'",
  },
  [Code.DateMonthNext]: {
    text: "month 12 is January of the next year in JavaScript: months are counted from 0, so December is 11",
  },
  [Code.DateMonthOutside]: {
    text: "month {word} is outside the year: months are counted from 0 (January) to 11 (December)",
  },
  [Code.DateDayBelow]: {
    text: "day {word} is outside the month: days are counted from 1, and 0 is the last day of the month before",
  },
  [Code.DateDayAbove]: {
    text: "no month has day {word}: days are counted from 1 to 31",
  },
  [Code.DateDayLast]: {
    text: "{word}; the last day of {other} is day 0 of the month after: 'new Date({first}, {second}, 0)'",
  },
  [Code.DateDayFebruary]: {
    text: "{word}; the last day of February is day 0 of March: '{other}({first}2, 0)'",
  },
  [Code.DateDayCount]: {
    text: "{word}; {other} has {first} days",
  },
  [Code.DateTimeRange]: {
    text: "{word} {other} are out of range: {other} are from 0 to {first} (JavaScript would carry the rest over)",
  },
  [Code.DateTextUnreadable]: {
    text: "'{word}' is not a date JavaScript can read, and would be an Invalid Date; write it as 'YYYY-MM-DDTHH:mm' (local time) or 'YYYY-MM-DDTHH:mmZ' (UTC), e.g. '2026-10-23T10:00'",
  },
  [Code.DateTextNoTime]: {
    text: "a date without a time is read as midnight UTC, while the same date with a time is local; write '{word}T00:00' for local midnight or '{word}T00:00Z' for UTC",
  },
  [Code.DateTextNoDay]: {
    text: "'{word}': {other}; write the date that is meant",
  },
  [Code.DateTextOutside]: {
    text: "'{word}' is outside the dates JavaScript has (100 million days around 1970), and would be an Invalid Date",
  },
  [Code.DateNewText]: {
    text: "'new Date' of a text known only when the program runs may fail, and 'new' gives no Result; write 'Date.parse(text)', which gives a Result with the milliseconds, and 'new Date(ms)'",
  },
  [Code.DateNewValue]: {
    text: "'new Date' takes a time in milliseconds, a string or a date, found '{word}'{place}",
  },
  [Code.DateWithoutNew]: {
    text: "'Date()' without 'new' gives the text of the current time and ignores its arguments; write 'new Date(...)'",
  },
  [Code.DateStaticRead]: {
    text: "'Date.{word}' can only be called: 'Date.{word}{other}'",
  },
  [Code.DateGetYear]: {
    text: "'getYear' gives the year minus 1900 (126 for 2026); use 'getFullYear()'",
  },
  [Code.DateSetYear]: {
    text: "'setYear' takes the year minus 1900, and reads 0 to 99 as 1900 to 1999; use 'setFullYear(year)'",
  },
  [Code.DateGmtString]: {
    text: "'toGMTString' is the old name of 'toUTCString'; use 'toUTCString()'",
  },
  [Code.DateMethodRead]: {
    text: "'{word}' of a date can only be called, e.g. 'd.{word}()'",
  },
  [Code.DateGetYearRead]: {
    text: "'getYear' gives the year minus 1900; use 'getFullYear()'",
  },
  [Code.DatePlus]: {
    text: "'+' with a date joins texts in JavaScript (the date as toString() writes it); to move a date by milliseconds write 'new Date(d.getTime() + ms)'",
  },
  [Code.DateMinus]: {
    text: "a date minus a number is a number of milliseconds in JavaScript, not a date; write 'd.getTime() - ms', or 'new Date(d.getTime() - ms)' for a date",
  },
  [Code.DateCompare]: {
    text: "a date is compared with '{word}' only with another date; compare the times: 'd.getTime() {word} ms'",
  },
  [Code.InstanceOfAlwaysTrue]: {
    text: "the value is a '{first}', so 'instanceof {word}' is always true",
  },
  [Code.InstanceOfOrUndefined]: {
    text: "the value is a '{first}' or undefined; test it with '!= undefined'",
  },
  [Code.InstanceOfNeverBuiltin]: {
    text: "a '{first}' is never a '{word}', so 'instanceof {word}' is always false",
  },
  [Code.InstanceOfNoneBuiltin]: {
    text: "a '{first}' is never a '{word}': none of its members is one, so this is always false",
  },
  [Code.InstanceOfAllBuiltin]: {
    text: "every member of '{first}' is a '{word}', so 'instanceof {word}' is always true",
  },
  [Code.InstanceOfUntyped]: {
    text: "'instanceof {word}' cannot tell the types of the keys and values, which tz needs to use a {word}; keep it in a variable of its type, e.g. '{other}'",
  },
  [Code.ObjectNeedsObject]: {
    text: "'Object.{word}' needs an object, found '{first}'",
  },
  [Code.ObjectMaybeUndefined]: {
    text: "the object may be undefined; check it first",
  },
  [Code.ForInIndices]: {
    text: "'for...in' over {word} gives its indices as strings ('0', '1'...), so 'i + 1' would be '01'; walk the elements with 'for (const x of {other})', or the indices with 'for (let i = 0; i < {other}.length; i++)'{place}",
  },
  [Code.ForInUndefined]: {
    text: "the object may be undefined; check it before walking its keys",
  },
  [Code.ForInNotObject]: {
    text: "'for...in' walks the keys of an object, found '{word}'",
  },
  [Code.DestructureNotArray]: {
    text: "only arrays can be destructured, found '{word}'",
  },
  [Code.DestructureMaybeUndefined]: {
    text: "only arrays can be destructured, found '{word}'; the array may be undefined: check it first",
  },
  [Code.DestructureElements]: {
    text: "only arrays can be destructured; the elements are '{word}'",
  },
  [Code.MathSpreadNotNumbers]: {
    text: "only an array of numbers can be spread here, found '{word}'",
  },
  [Code.MathSpreadType]: {
    text: "the values of 'Math.{word}' must have one type; found '{first}' and '{second}'",
  },
  [Code.LogicalAssignSimple]: {
    text: "'{word}' needs a variable, a field or an array element at a simple index, such as 'a[i]'",
  },
  [Code.TupleLengthFixed]: {
    text: "a tuple has a fixed length, which cannot be changed",
  },
  [Code.ObjectValuesNoUnion]: {
    text: "'Object.{word}' puts the values of all the fields in one array, of the union of their types, and the fields of '{first}' have types that no union holds: {other}; read the fields by name",
  },
  [Code.ObjectNoFields]: {
    text: "'{first}' has no fields, so 'Object.{word}' would always be empty",
  },
  [Code.SpreadFieldTypes]: {
    text: "field '{word}' is '{first}' before the spread and '{second}' in '{other}'; a field has one type",
  },
  [Code.ResultValueUnchecked]: {
    text: "'value' is there only when the Result is an Ok: check it first, 'if ({word}.isOk())', or use 'match' or 'unwrapOr'",
  },
  [Code.ResultErrorUnchecked]: {
    text: "'error' is there only when the Result is an Err: check it first, 'if ({word}.isErr())', or use 'match'",
  },
  [Code.ResultMethodRead]: {
    text: "'{word}' is a method of Result; call it: '{other}.{word}(...)'",
  },
  [Code.ResultUnwrapOrTypes]: {
    text: "'unwrapOr' gives '{first}' for an Ok and '{second}' otherwise, and no type holds both; say what each gives with 'match'",
  },
  [Code.ResultNeedsFunction]: {
    text: "'{word}' needs a function, found '{first}'",
  },
  [Code.ResultMatchTypes]: {
    text: "the functions given to 'match' return '{first}' and '{second}', and no type holds both",
  },
  [Code.ResultCallbackNotResult]: {
    text: "the function given to '{word}' must return a Result, 'ok(...)' or 'err(...)', found '{first}'{place}",
  },
  [Code.ResultErrorsNoUnion]: {
    text: "the Result has errors of '{first}' and the function given to '{word}' returns errors of '{second}', which no union holds{other}; convert one with 'mapErr'",
  },
  [Code.ResultValuesNoUnion]: {
    text: "the Result has values of '{first}' and the function given to 'orElse' returns values of '{second}', which no union holds{other}",
  },
  [Code.OkErrTypeArgs]: {
    text: "'{word}' takes two type arguments: '{word}<T, E>(...)'",
  },
  [Code.OkErrVoidValue]: {
    text: "an expression of type 'void' has no value to keep; write '{word}()'",
  },
  [Code.ResultStaticMissing]: {
    text: "'{word}.{other}' does not exist; Result has 'combine' and 'combineWithAllErrors'",
  },
  [Code.ResultCombineNotResult]: {
    text: "'{word}' takes Results, found '{first}'",
  },
  [Code.ResultCombineNotArray]: {
    text: "'{word}' takes an array of Results, found '{first}'",
  },
  [Code.ResultCombineNoUnion]: {
    text: "the Results given to '{word}' have errors that no union holds{other}; convert them with 'mapErr'",
  },
  [Code.CallbackResultDropped]: {
    text: "the function returns a Result that its caller drops, so an error in it would go unchecked; handle it here, e.g. with '.match(...)'",
  },
  [Code.ResultsUnused]: {
    text: "the Results are not used, so errors in them would go unchecked; handle them, e.g. with 'Result.combine(...)', or keep them in a variable",
  },
  [Code.ResultHalfAsValue]: {
    text: "'{word}' can be used only as a type; make a Result with '{other}', and test one with '{first}'",
  },
  [Code.ArraySearchResults]: {
    text: "'{word}' cannot compare Results: in JavaScript each Result is an object of its own, equal to no other; search with a function, e.g. 'some' or 'findIndex'",
  },
  [Code.ResultMethodOnPromise]: {
    text: "'{word}' is a method of Result, not of Promise; await the Promise first: '(await {other}).{word}(...)'",
  },
  [Code.JsonNoMethodNamed]: {
    text: "a Json has no method '{word}' until a check shows what it holds, e.g. 'if (Array.isArray({other})) {other}.{word}(...)' or 'if (typeof {other} == \"string\") {other}.{word}(...)'",
  },
  [Code.JsonNoMethod]: {
    text: "a Json has no method '{word}' until a check shows what it holds; put it in a variable and check that, e.g. 'const items = j.items; if (Array.isArray(items)) items.{word}(...)'",
  },
  [Code.JsonKeyType]: {
    text: "a key of a Json is a string or a number, found '{word}'",
  },
  [Code.JsonReviver]: {
    text: "the reviver of JSON.parse is not supported",
  },
  [Code.JsonToJsonClass]: {
    text: "JSON.stringify does not call the method toJSON of class '{word}': tz calls no code by itself; call it, e.g. 'JSON.stringify(x.toJSON())'",
  },
  [Code.JsonReplacer]: {
    text: "a replacer is not supported: tz calls no code by itself; build the value to write first, and pass 'null' here",
  },
  [Code.JsonSpaceType]: {
    text: "the space of JSON.stringify is a number of spaces or a string, found '{word}'",
  },
  [Code.JsonVoidValue]: {
    text: "an expression of type 'void' has no value to write as JSON",
  },
  [Code.TypeArgsOnlyGeneric]: {
    text: "type arguments can be given only to a generic function",
  },
  [Code.DecimalMethodMissing]: {
    text: "property '{word}' does not exist on type 'decimal'{place}",
  },
  [Code.DecimalStaticMissing]: {
    text: "property '{word}' does not exist on 'decimal'{place}",
  },
  [Code.DecimalPlacesOnly]: {
    text: "decimalPlaces() only counts the places; to round, use 'x.round(places, mode)'",
  },
  [Code.DecimalCountType]: {
    text: "{word} must be an integer ('int'), found '{first}'{place}",
  },
  [Code.RoundingModeUnknown]: {
    text: "unknown rounding mode '{word}'; the modes are 'up', 'down', 'ceil', 'floor', 'half-up', 'half-down', 'half-even', 'half-ceil' and 'half-floor'",
  },
  [Code.RoundingModeRuntime]: {
    text: "a rounding mode known only when the program runs may be no mode; check it first, e.g. 'if (mode == \"up\" || mode == \"down\")'; the modes are 'up', 'down', 'ceil', 'floor', 'half-up', 'half-down', 'half-even', 'half-ceil' and 'half-floor'",
  },
  [Code.DecimalOfType]: {
    text: "decimal() takes a string, a number or a decimal, found '{word}'{place}",
  },
  [Code.DecimalNotNumber]: {
    text: "'{word}' is no decimal number; write it as one, e.g. '12.50', '-1e3' or '0x1f'",
  },
  [Code.DecimalSpreadNotDecimals]: {
    text: "only an array of decimals can be spread here, found '{word}'",
  },
  [Code.DecimalNoValue]: {
    text: "decimal.{word}() needs at least one value",
  },
  [Code.DecimalFunctionRead]: {
    text: "'decimal.{word}' can only be called, e.g. 'decimal.max(a, b)'; decimal has the functions max, min and sum",
  },
  [Code.DecimalNameValue]: {
    text: "'decimal' is used as 'decimal(x)', which makes a decimal of x, or through its functions, e.g. 'decimal.max(a, b)'",
  },
  [Code.DecimalOutOfRange]: {
    text: "this decimal is out of range: a decimal has at most 10000001 digits before the point",
  },
  [Code.ArrayIn]: {
    text: "operator 'in' is not supported for arrays, which have no holes; compare the index with the length instead: '{word}'",
  },
  [Code.DeleteArrayHole]: {
    text: "'delete' would leave a hole in the array, and arrays have none; remove the element with '{word}.splice({other}, 1)', or replace it: '{word}[{other}] = ...'",
  },
  [Code.DeleteCharacter]: {
    text: "strings are immutable; a character cannot be deleted",
  },
  [Code.DeleteTupleHole]: {
    text: "'delete' would leave a hole in the tuple, which has a fixed length; assign the element instead",
  },
  [Code.DeleteNotField]: {
    text: "'delete' removes fields of objects, and this is not a field",
  },
  [Code.TemplateRaw]: {
    text: "'raw' is not supported: a tag gets the texts of its template as a plain 'string[]', with the escapes already applied",
  },
  [Code.StringRawCall]: {
    text: "String.raw can only tag a template, e.g. String.raw`C:\\dir`",
  },
  [Code.TaggedArgumentCount]: {
    text: "expected {word}, but the tagged template passes {other}: the array of its texts{place}",
  },
  [Code.LiteralFitNoField]: {
    text: "the object literal does not fit '{first}': it has no field '{word}'; an object must have exactly the fields of its type",
  },
  [Code.LiteralFitNotMethod]: {
    text: "the object literal does not fit '{first}': '{word}' is a field of type '{second}' there, not a method",
  },
  [Code.LiteralFitReplaceable]: {
    text: "the object literal does not fit '{first}': '{word}' is a field there that code may replace, which a method cannot be; write it as a field: '{word}: (...) => ...'",
  },
  [Code.LiteralFitOtherType]: {
    text: "the object literal does not fit '{first}': '{word}' is '{second}' here and '{other}' there",
  },
  [Code.LiteralFitMissing]: {
    text: "the object literal does not fit '{first}': it has no '{word}'",
  },
  [Code.LiteralFitOverloads]: {
    text: "the object literal does not fit '{first}': its method '{word}' has several signatures, and only a class implements those, each with a variant of its own",
  },
  [Code.LiteralMethodsSpread]: {
    text: "an object literal with methods cannot take the fields of another object with '...'; write them out",
  },
  [Code.SpreadMethods]: {
    text: "an object with methods cannot be spread into an object literal yet; copy the fields by name",
  },
  [Code.ObjectListingMethods]: {
    text: "'Object.{word}' of an object with methods is not supported; read the fields by name",
  },
  [Code.UnionMethodsDiffer]: {
    text: "the members of '{first}' have methods '{word}' of different types, '{second}' and '{other}'; narrow it first",
  },
  [Code.LiteralOverloadsTarget]: {
    text: "an object literal cannot be of type '{first}': its method '{word}' has several signatures, and only a class implements those, each with a variant of its own",
  },
  [Code.OverloadedMethodReplaced]: {
    text: "'{word}' is a method of '{first}' with several signatures and cannot be replaced",
  },
  [Code.ImplementsMustField]: {
    text: "'{word}' is a field in '{first}' that code may replace, so in '{second}', which implements it, it must be a field too: '{word} = (...) => ...'; or declare it in '{first}' as a method, '{word}(...): ...'",
  },
  [Code.ImplementsFieldAsMethod]: {
    text: "'{word}' is a field of type '{other}' in '{first}', which '{second}' implements, so it cannot be a method",
  },
  [Code.ImplementsNoVariant]: {
    text: "class '{first}' implements '{second}', but has no variant of '{word}' for its signature '{other}'; each signature needs a variant with these parameters",
  },
  [Code.UnionMethodBase]: {
    text: "'{word}' is called on '{first}', and '{second}' is an interface that classes implement; narrow it first, or declare the members to be one type with '{word}'",
  },
  [Code.UnionFieldNotFunction]: {
    text: "'{word}' may be a '{first}', whose '{other}' is not a function; narrow it first",
  },
  [Code.ConstructorTypeArgs]: {
    text: "'Constructor' takes the type of the objects the class makes, e.g. 'Constructor<User>', or nothing for any class",
  },
  [Code.ConstructorNotObject]: {
    text: "a class makes objects, and '{word}' is not an object type; give the type of its objects, e.g. 'Constructor<User>'",
  },
  [Code.ValueNewNotClass]: {
    text: "'new' makes an object of a class, and this is a '{word}'",
  },
  [Code.ClassValuePrototype]: {
    text: "there are no prototypes in tz: the methods belong to the class itself, and a decorator gets the class; use it as it is",
  },
  [Code.ClassValueRuntime]: {
    text: "'{word}' is some class known only when the program runs, which has only its 'name'; make an object of it with 'new', or use reflection (docs/decorators.md, section 6)",
  },
  [Code.ClassValueStatics]: {
    text: "'{word}' is some class known only when the program runs, whose static members are not known; call its methods through reflection (docs/decorators.md, section 6)",
  },
  [Code.ClassNameCondition]: {
    text: "{first} is always truthy, so the condition is always true; drop the check",
  },
  [Code.ClassNameNot]: {
    text: "{first} is always truthy, so '!' always gives false; drop the check",
  },
  [Code.ExtendsRuntimeClass]: {
    text: "the class extended must be known when compiling: the fields of an object lie at places fixed then, and '{word}' is some class known only when the program runs (docs/decorators.md, section 5); extend a class by its name, or take it in a generic function, 'function Mixin<B extends Constructor>(Base: B)'",
  },
  [Code.ExtendsNotClassValue]: {
    text: "a class can extend only a class, and this is a '{word}'",
  },
  [Code.ConstructorArgsSubclass]: {
    text: "'ConstructorArgs' is the list of the parameters of the constructor of the class extended, for the constructor of a class that extends another: 'constructor(...args: ConstructorArgs) { super(...args) }'",
  },
  [Code.ClassExprStaticCapture]: {
    text: "a class expression cannot use '{word}', a variable of the function around it: the class is made once, not at each call, and its static fields get their values the first time; pass the value to its constructor, or keep it in a global",
  },
  [Code.ClassExprLaterCapture]: {
    text: "a class expression cannot use '{word}', a variable of the function around it: the class is made once, not at each call, and its code runs later; pass the value to its constructor, or keep it in a global",
  },
  [Code.DecoratorAccessor]: {
    text: "a decorator cannot decorate an 'accessor' field: in tz it is an ordinary field, and reading or writing it never runs code",
  },
  [Code.DecoratorAbstract]: {
    text: "a decorator cannot decorate an abstract method, which has no code; decorate the methods that implement it",
  },
  [Code.DecoratorArguments]: {
    text: "{word} cannot decorate {first}: it takes {other} arguments, and a decorator of {first} gets {second}, {place}",
  },
  [Code.DecoratorDescriptorParameter]: {
    text: "{word} takes the descriptor of a method: it decorates methods, not parameters",
  },
  [Code.DecoratorPositionMethod]: {
    text: "{word} takes the position of a parameter: it decorates parameters, not methods",
  },
  [Code.DecoratorGenericDescriptor]: {
    text: "a decorator that takes the descriptor of a method of a generic class is not supported yet: each instance of '{word}' has a method of its own; decorate a method of a class that is not generic, or take only the class and the name",
  },
  [Code.DecoratorRuntimeClass]: {
    text: "{word} returns '{first}', some class known only when the program runs, and the class it gives in place of '{second}' must be known when compiling: make the decorator generic, '<T extends Constructor>(cls: T)', and return 'cls' or a class that extends it",
  },
  [Code.DecoratorClassResult]: {
    text: "{word} returns '{first}': a class decorator gives back nothing, the class it got, or a class that extends it, which then replaces it",
  },
  [Code.DecoratorMethodResult]: {
    text: "{word} returns '{first}': a decorator of a method returns nothing, or the descriptor it got",
  },
  [Code.DecoratorOtherResult]: {
    text: "{word} returns '{first}', which a decorator of {second} cannot give back; return nothing",
  },
  [Code.DecoratedSameName]: {
    text: "{first} of '{word}' are decorated, and {second} for both would be one: metadata is kept on the class itself, by the member's name (docs/decorators.md, section 3); give one of them another name",
  },
  [Code.DecoratedConstructors]: {
    text: "two constructors of '{word}' have decorated parameters, and the record 'design:paramtypes' the compiler writes for the class would be one: metadata is kept on the class itself (docs/decorators.md, section 3); decorate the parameters of one of them",
  },
  [Code.DecoratorParameterPlace]: {
    text: "a decorator of a parameter can decorate only a parameter of a method or a constructor of a class",
  },
  [Code.ThisBindUnsupported]: {
    text: "'bind' is not supported: pass the 'this' with every call, 'f.call(obj, ...)'",
  },
  [Code.ThisFunctionProperty]: {
    text: "a function has no property '{word}'; call it with '.call(obj, ...)' or '.apply(obj, args)'",
  },
  [Code.ThisArgumentFirst]: {
    text: "'{word}' takes the 'this' of the call first, e.g. 'f.{word}(this{other}'",
  },
  [Code.ThisApplyArguments]: {
    text: "'apply' takes two arguments: the 'this' of the call and the list of the arguments, e.g. 'f.apply(this, args)'",
  },
  [Code.ArrowThisParameter]: {
    text: "an arrow function cannot have a 'this' parameter: it sees the 'this' of the function around it; write a 'function'",
  },
  [Code.MethodThisParameter]: {
    text: "a method cannot have a 'this' parameter: its 'this' is its object",
  },
  [Code.CompoundJoinsText]: {
    text: "operator '+=' cannot be applied to types 'string' and '{first}' (JavaScript would join them as text){other}",
  },
  [Code.CompoundBitsOfDouble]: {
    text: "operator '{other}' works on the bits of integers, and this is a double; drop the fraction first, e.g. 'Math.trunc(x).toInt()'",
  },
  [Code.CompoundNothingChanged]: {
    text: "'{other} 0' changes nothing in tz: integers are exact, and nothing wraps around here; to count modulo 2^32, use 'Bit.Wrap32'",
  },
  [Code.CompoundSignedShift]: {
    text: "'>>>=' shifts in zeros, as a shift of an unsigned type does; '{first}' is signed: use '>>='",
  },
  [Code.CompoundMixedNumbers]: {
    text: "operator '{other}' cannot be applied to types '{first}' and '{second}': a number changes its type only explicitly{place}",
  },
  [Code.ProofNegative]: {
    text: "{word} cannot be negative, found {other}",
  },
  [Code.ProofOutside]: {
    text: "{word} must be {place}, found {other}",
  },
  [Code.ProofNotWhole]: {
    text: "{word} must be a whole number {place}, found '{first}'",
  },
  [Code.ProofBetween]: {
    text: "cannot prove that {word} is {place}, and JavaScript would throw a RangeError; check it first, e.g. 'if ({other})'",
  },
  [Code.NewArrayNeedsElement]: {
    text: "'new Array' needs an element type, e.g. 'new Array<int>(n)'",
  },
  [Code.LoopVariableTyped]: {
    text: "a '{word}' variable cannot have a type annotation",
  },
  [Code.StringElementAssigned]: {
    text: "strings are immutable; a character cannot be assigned to",
  },
  [Code.BytesStoreUnproven]: {
    text: "cannot prove that the index is within the {first} (0 <= index < length): it never grows, and JavaScript would drop the write; check the index first, e.g. 'if ({other})'",
  },
  [Code.AssignToConstant]: {
    text: "cannot assign to '{word}' because it is a constant",
  },
  [Code.AssignToImported]: {
    text: "cannot assign to '{word}' because it is imported",
  },
  [Code.TupleMethodDestructure]: {
    text: "'{word}' is not supported on tuples; destructure it instead, e.g. 'const [a, b] = {first}'",
  },
  [Code.AssignToImportedVariable]: {
    text: "cannot assign to '{word}' because it is imported; change it in the file that declares it, e.g. with a function that file exports",
  },
  [Code.ObjectPatternAssignmentNotStatement]: {
    text: "destructuring assignment can only be a statement, e.g. '({ a, b } = o)'",
  },
  [Code.ExportNotYet]: {
    text: "'{word}' of '{path}' is not supported yet{other}",
  },
  [Code.ExportTakesCallback]: {
    text: "'{word}' of '{path}' takes a callback, which tz does not have; import '{word}' from \"node:fs/promises\", which gives a Promise, or '{other}', which gives what it reads{place}",
  },
  [Code.ExportSyncOnly]: {
    text: "'{word}' of '{path}' takes a callback, which tz does not have; import '{other}' and use what it returns",
  },
  [Code.NoExportNamedHint]: {
    text: "'{path}' has no export named '{word}'{other}",
  },
  [Code.ExportAsyncChild]: {
    text: "'{word}' of '{path}' is not supported yet: it comes with EventEmitter and the streams of Node (docs/process.md, step 2); use '{word}Sync', which waits for the program and gives what it printed",
  },
  [Code.ExportFork]: {
    text: "'{word}' of '{path}' is not possible: it starts another Node with a channel to it, and tz has no Node (docs/process.md, section 4); for parallel work use async functions (docs/async.md), and to run a program 'spawnSync(process.execPath, [...])'",
  },
  [Code.LengthNotProven]: {
    text: "cannot prove that the new length is from 0 to the old one: an array of '{first}' cannot grow by setting its length, which would leave elements without a value; check it first, e.g. 'if (n >= 0 && n <= {word}.length)', or use push()",
  },
  [Code.VariableWriteType]: {
    text: "variable '{word}' needs a type annotation or an initializer; write the type: 'let {word}: {first}'",
  },
  [Code.UndefinedLetWriteType]: {
    text: "cannot infer a type from 'undefined'; write the type: 'let {word}: {first}'",
  },
  [Code.GenericCallRefused]: {
    text: "cannot call '{word}' with {first}: {other}",
  },
  [Code.GenericClassRefused]: {
    text: "cannot use '{word}' with {first}: {other}",
  },
  [Code.BytesLengthFraction]: {
    text: "the length of a typed array must be an integer, found 'double'; round it with Math.floor(x) or drop the fraction with 'x | 0'",
  },
  [Code.ByteCountNotWritten]: {
    text: "the byte count of '{word}' must be written as a number from 1 to 6",
  },
  [Code.ByteValueUnproven]: {
    text: "cannot prove that the value fits in {word} ({place}), and node would throw a RangeError; check it first",
  },
  [Code.ByteFitConstant]: {
    text: "{word} does not fit in {first} ({place}): JavaScript would store {second}; write a value that fits, or cut it explicitly: '{other}'",
  },
  [Code.ByteFitUnproven]: {
    text: "cannot prove that the value fits in {first} ({place}), and JavaScript would cut it without a word; check it first, e.g. 'if ({second})', or cut it explicitly: '{other}'",
  },
  [Code.OffsetUnproven]: {
    text: "cannot prove that {word} {first} is from 0 to {place}, and JavaScript would throw a RangeError; check it first, e.g. 'if ({other} <= {place})'",
  },
  [Code.BufferSlice]: {
    text: "'slice' of a Buffer is not supported: in node it shares the memory, unlike 'slice' of a Uint8Array, and is deprecated; use 'subarray(start, end)' for the same memory, or 'Buffer.from(b.subarray(start, end))' for a copy",
  },
  [Code.NewBuffer]: {
    text: "'new Buffer(...)' is not supported, as in node, where it is deprecated: make one with 'Buffer.from(values)' or 'Buffer.alloc(size)'",
  },
  [Code.BytesSourceKind]: {
    text: "a {word} is made from a length, an array or an iterator of numbers, another typed array or an ArrayBuffer, found '{first}'{other}",
  },
  [Code.BytesFromSource]: {
    text: "{word} takes an array, a typed array or an iterator, found '{first}'",
  },
  [Code.BytesSourceNotNumbers]: {
    text: "the elements of '{first}' are not numbers, which a {word} holds",
  },
  [Code.BytesSourceDoubles]: {
    text: "the elements of '{first}' are doubles, which an element of '{word}' cannot hold without an explicit conversion; convert them, e.g. '{word}.from({other}, x => Math.round(x) & 0xff)'",
  },
  [Code.BytesSourceMayNotFit]: {
    text: "the elements of '{first}' ({second}) may not fit in an element of '{word}' ({place}), and JavaScript would cut them without a word; convert them explicitly, e.g. '{other}'",
  },
  [Code.BytesSourceUnproven]: {
    text: "cannot prove that the elements of '{first}' fit in an element of '{word}' ({place}), and JavaScript would cut them without a word; write the values in the literal, or convert them explicitly, e.g. '{other}'",
  },
  [Code.BytesSetIterator]: {
    text: "'set' takes an array or a typed array; collect the values of the iterator first, e.g. '[...it]'",
  },
  [Code.BytesSetUnproven]: {
    text: "cannot prove that the values fit, '{word}', and JavaScript would throw a RangeError; check it first, with the offset written as a number",
  },
  [Code.BytesWithIndex]: {
    text: "cannot prove that the index is within the array, and JavaScript would throw a RangeError; check it first, e.g. 'if (i >= 0 && i < {word}.length)'",
  },
  [Code.BufferValueArgument]: {
    text: "'{word}' takes a number, a string or a Uint8Array, found '{first}'",
  },
  [Code.BufferAllocFill]: {
    text: "'Buffer.alloc' fills with a number, a string or a Uint8Array, found '{first}'",
  },
  [Code.BytesMapUnproven]: {
    text: "cannot prove that what the function returns fits in {word} ({place}), and JavaScript would cut it without a word; pass an arrow that cuts it explicitly, e.g. 'x => {other}'",
  },
  [Code.ViewOffsetAligned]: {
    text: "the offset of {word} must be a multiple of {other}, written as a number; JavaScript throws a RangeError otherwise",
  },
  [Code.ViewSizeAligned]: {
    text: "cannot prove that the size of the buffer is a multiple of {other} for {word}, and JavaScript would throw a RangeError; give the length: 'new X(buffer, offset, length)'",
  },
  [Code.ViewNotFits]: {
    text: "cannot prove that {word} fits in the buffer, '{other} <= {first}.byteLength', and JavaScript would throw a RangeError; check it first, with the offset or the length written as a number",
  },
  [Code.ViewOverBuffer]: {
    text: "a DataView is made over an ArrayBuffer, found '{first}'{other}",
  },
  [Code.ViewOffsetOnly]: {
    text: "'new {word}' takes an offset and a length only with an ArrayBuffer, found '{first}'",
  },
  [Code.BufferEncodingUnknown]: {
    text: "unknown encoding '{word}' (node throws a TypeError); Buffer knows utf8, utf16le, latin1, ascii, base64, base64url and hex",
  },
  [Code.BufferEncodingNotKnown]: {
    text: "an encoding known only when the program runs may be one Buffer does not know, which node would throw a TypeError for; check it first, e.g. 'if (enc == \"hex\" || enc == \"base64\")', or give it the type 'BufferEncoding'",
  },
  [Code.BytesLengthFixed]: {
    text: "the length of '{word}' cannot change; make a new one of the length wanted",
  },
  [Code.BytesFlatMap]: {
    text: "typed arrays have no 'flatMap'; spread the elements into an array first, e.g. '[...u].flatMap(f)'",
  },
  [Code.BytesLocale]: {
    text: "'toLocaleString' of a typed array is not supported; join the elements with 'join()', or format each with toLocaleString",
  },
  [Code.BytesNotIndexed]: {
    text: "type '{first}' cannot be indexed; {other}",
  },
  [Code.BytesNoText]: {
    text: "a value of type '{first}' cannot be converted to a string: JavaScript would give '[object {first}]'; print it with console.log{other}",
  },
  [Code.DecoderLabelUnknown]: {
    text: "'{word}' is not an encoding TextDecoder knows (JavaScript throws a RangeError); e.g. 'utf-8', 'utf-16le', 'windows-1251', 'latin1'",
  },
  [Code.DecoderLabelNotKnown]: {
    text: "a label known only when the program runs may name no encoding, which JavaScript would throw a RangeError for; parse it with 'TextDecoder.parse(label)', which gives a Result, or check it first, e.g. 'if (label == \"utf-8\" || label == \"windows-1251\")'",
  },
  [Code.DecodeInput]: {
    text: "'decode' takes a typed array, a DataView or an ArrayBuffer, found '{first}'",
  },
  [Code.FatalDecoderNew]: {
    text: "a FatalTextDecoder is made by 'new TextDecoder(label, { fatal: true })'",
  },
  [Code.ResizableBuffer]: {
    text: "an ArrayBuffer that can change its size is not supported yet (docs/bytes.md, section 7); make a new one of the size wanted",
  },
  [Code.BytesUnionNarrow]: {
    text: "property '{word}' of '{first}' is not supported yet; narrow it first",
  },
  [Code.BytesUnionLacking]: {
    text: "property '{word}' does not exist on '{second}', which '{first}' may be; narrow it first{other}",
  },
  [Code.IntlUnknownService]: {
    text: "'Intl.{word}' is not supported yet; Intl has DateTimeFormat, NumberFormat, Collator, PluralRules, RelativeTimeFormat, ListFormat, DisplayNames, Segmenter and Locale",
  },
  [Code.IntlWithNew]: {
    text: "'Intl.{word}' is made with 'new': 'new Intl.{word}(...)', and JavaScript would throw a TypeError without it",
  },
  [Code.IntlNewNoType]: {
    text: "Intl.DisplayNames needs the option 'type', e.g. 'new Intl.DisplayNames(\"ru\", { type: \"region\" })', which JavaScript would throw a TypeError without",
  },
  [Code.LanguageTagUnknown]: {
    text: "a language known only when the program runs may be no language tag, which JavaScript would throw a RangeError for; parse it first: 'Intl.Locale.parse(tag)' gives a Result with an Intl.Locale, which {word} takes",
  },
  [Code.LanguageTagUnknownLocale]: {
    text: "a language known only when the program runs may be no language tag, which JavaScript would throw a RangeError for; parse it with 'Intl.Locale.parse(tag)', which gives a Result",
  },
  [Code.LanguageTagNot]: {
    text: "'{word}' is not a language tag, and JavaScript would throw a RangeError; write it as BCP 47 does, e.g. 'en-US' or 'ru'",
  },
  [Code.LanguageTagTakes]: {
    text: "{word} takes the language as a string, e.g. \"ru-RU\", or an Intl.Locale, found '{first}'{other}",
  },
  [Code.LanguageTagList]: {
    text: "{word} takes a language or an array of them, found '{first}'",
  },
  [Code.LanguageTagListOpen]: {
    text: "languages known only when the program runs may be no language tags, which JavaScript would throw a RangeError for; parse each with 'Intl.Locale.parse(tag)', which gives a Result, and pass them to {word} one by one",
  },
  [Code.LanguageTagSpread]: {
    text: "{word} takes the languages written in the array, not spread",
  },
  [Code.IntlLocaleOptions]: {
    text: "the options of Intl.Locale are not supported; write them into the tag, e.g. 'new Intl.Locale(\"th-TH-u-ca-buddhist\")'",
  },
  [Code.IntlLocaleWithNew]: {
    text: "'Intl.Locale' is made with 'new': 'new Intl.Locale(tag)' or 'Intl.Locale.parse(tag)', and JavaScript would throw a TypeError without it",
  },
  [Code.IntlValuesOf]: {
    text: "'Intl.supportedValuesOf' is not supported yet",
  },
  [Code.IntlStaticOnly]: {
    text: "'{word}' is not supported; of the classes of Intl, only 'supportedLocalesOf' is",
  },
  [Code.IntlOnlyCalled]: {
    text: "property '{word}' of {first} can only be called, '{word}(...)'; as values there are only 'format' of Intl.NumberFormat and Intl.DateTimeFormat and 'compare' of Intl.Collator",
  },
  [Code.IntlNotNumber]: {
    text: "'{word}' takes a number or a decimal, found '{first}'{other}",
  },
  [Code.ClosedArgUnknown]: {
    text: 'a string known only when the program runs may be no {word}, which JavaScript would throw a RangeError for; compare it with them first, e.g. \'if (x == "{first}" || x == "{second}")\'',
  },
  [Code.ClosedArgNotAllowed]: {
    text: "'{first}' is no {word}, and JavaScript would throw a RangeError",
  },
  [Code.IntlRangeUnsupported]: {
    text: "'{word}' is not supported yet; format both numbers",
  },
  [Code.IntlSelectRange]: {
    text: "'selectRange' is not supported yet; select each number",
  },
  [Code.IntlRelativeUnit]: {
    text: "'{word}' is not a unit of Intl.RelativeTimeFormat, and JavaScript would throw a RangeError; the units are year, quarter, month, week, day, hour, minute and second, also in the plural",
  },
  [Code.IntlBadForm]: {
    text: "'{word}' is not a normalization form, and JavaScript would throw a RangeError; it is 'NFC', 'NFD', 'NFKC' or 'NFKD'",
  },
  [Code.IntlOptionsNoType]: {
    text: "Intl.DisplayNames needs the option 'type', e.g. '{ type: \"region\" }', which JavaScript would throw a TypeError without",
  },
  [Code.IntlOptionsNotObject]: {
    text: "{word} takes its options as an object, e.g. '{ style: \"percent\" }', found '{first}'",
  },
  [Code.IntlOptionUnknown]: {
    text: "'{word}' is not an option of {first}; the options are {other}",
  },
  [Code.IntlOptionKindWrong]: {
    text: "the option '{word}' is {first}, found '{second}'",
  },
  [Code.IntlOptionValue]: {
    text: "'{first}' is not a value of the option '{word}', and JavaScript would throw a RangeError; it is {other}",
  },
  [Code.IntlOptionOpen]: {
    text: "the option '{word}' is {other}, and a string known only when the program runs may be another, which JavaScript would throw a RangeError for; compare it with them first, e.g. 'if ({first})'",
  },
  [Code.IntlCurrency]: {
    text: "'{word}' is not a currency code, and JavaScript would throw a RangeError; a code is three letters, e.g. 'RUB' or 'USD'",
  },
  [Code.IntlUnit]: {
    text: "'{word}' is not a unit of Intl, and JavaScript would throw a RangeError; the units are those like 'kilometer', 'liter', 'percent' or 'megabyte', and two joined by '-per-', e.g. 'kilometer-per-hour'",
  },
  [Code.IntlKeyword]: {
    text: "'{word}' is not a {first}, and JavaScript would throw a RangeError; it is 3 to 8 letters or digits, e.g. '{other}'",
  },
  [Code.IntlStyleCurrency]: {
    text: "style 'currency' needs the option 'currency', e.g. '{ style: \"currency\", currency: \"RUB\" }', which JavaScript would throw a TypeError without",
  },
  [Code.IntlStyleUnit]: {
    text: "style 'unit' needs the option 'unit', e.g. '{ style: \"unit\", unit: \"kilometer\" }', which JavaScript would throw a TypeError without",
  },
  [Code.IntlDigitRange]: {
    text: "{word} is from {first} to {second}, and JavaScript would throw a RangeError",
  },
  [Code.IntlDigitRangeOpen]: {
    text: "{word} is from {first} to {second}, and a number known only when the program runs may be outside, which JavaScript would throw a RangeError for; give an int and check it first, e.g. 'if (n >= {first} && n <= {second})'",
  },
  [Code.IntlDigitsAbove]: {
    text: "{word} is above {first}, and JavaScript would throw a RangeError",
  },
  [Code.IntlDigitsMayAbove]: {
    text: "{word} may be above {first}, which JavaScript would throw a RangeError for; check it first, e.g. 'if (low <= high)'",
  },
  [Code.IntlIncrements]: {
    text: "roundingIncrement is one of 1, 2, 5, 10, 20, 25, 50, 100, 200, 250, 500, 1000, 2000, 2500 and 5000, and JavaScript would throw a RangeError",
  },
  [Code.IntlIncrementsOpen]: {
    text: "roundingIncrement is one of 1, 2, 5, 10, 20, 25, 50, 100, 200, 250, 500, 1000, 2000, 2500 and 5000, and a number known only when the program runs may be another, which JavaScript would throw a RangeError for; compare it with them first",
  },
  [Code.IntlIncrementSignificant]: {
    text: "roundingIncrement rounds to fraction digits, and with significant digits JavaScript would throw a TypeError",
  },
  [Code.IntlIncrementSame]: {
    text: "roundingIncrement needs minimumFractionDigits and maximumFractionDigits, and the same, e.g. '{ roundingIncrement: 5, minimumFractionDigits: 0, maximumFractionDigits: 0 }', or JavaScript may throw a RangeError",
  },
  [Code.DateOptionsNotObject]: {
    text: "{word} takes its options as an object, e.g. '{ month: \"long\" }', found '{first}'",
  },
  [Code.DateOptionUnknown]: {
    text: "'{word}' is not an option of {first}; the options are weekday, era, year, month, day, dayPeriod, hour, minute, second, fractionalSecondDigits, timeZoneName, timeZone, hour12, hourCycle, dateStyle, timeStyle, calendar, numberingSystem, localeMatcher and formatMatcher",
  },
  [Code.DateStyleOnly]: {
    text: "'{word}' is not an option of {first}, which JavaScript would throw a TypeError for; use toLocaleString",
  },
  [Code.DateStyleParts]: {
    text: "dateStyle and timeStyle cannot go with weekday, year, month, day, hour and the other parts, which JavaScript would throw a TypeError for; use either the styles or the parts",
  },
  [Code.DateDigitsOpen]: {
    text: "fractionalSecondDigits known only when the program runs may be out of 1 to 3, which JavaScript would throw a RangeError for; give it the type '1 | 2 | 3'",
  },
  [Code.DateOptionUnknownValue]: {
    text: "the option '{word}' known only when the program runs may be no value of it, which JavaScript would throw a RangeError for; check it first, e.g. 'if ({other} == \"{first}\" || {other} == \"{second}\")'",
  },
  [Code.DateFormatRange]: {
    text: "'{word}' is not supported yet; format both dates",
  },
  [Code.FsEncodingLiteral]: {
    text: "the encoding of '{word}' is written as a literal, 'utf8'",
  },
  [Code.FsEncodingUtf8Only]: {
    text: "'{word}' gives names in utf8 only; drop the encoding '{first}'",
