  [Code.MethodOverField]: {
    text: "'{word}' is a field of '{first}', so a class that extends it cannot have a method of that name",
  },
  [Code.ArrowOverride]: {
    text: "'{word}' is an arrow in a field of '{first}', which each object holds itself in JavaScript, so a method of a class that extends it would never run; override it with a field too: '{word} = (...) => ...'",
