  [Code.ChildZeroArg]: {
    text: "could not run it: args[{word}] has a zero character in it",
  },
  [Code.ChildEncoding]: {
    text: "the option 'encoding' of '{word}' is written as a literal, e.g. 'utf8': it decides whether the output is a string or a Buffer",
  },
  [Code.ChildStdio]: {
    text: 'the option \'stdio\' of \'{word}\' is written as a literal, e.g. "inherit" or ["pipe", "inherit", "pipe"]: whether there is output depends on it',
  },
  [Code.ChildStdioThree]: {
    text: "only stdin, stdout and stderr are supported in 'stdio'; more streams come with the async functions (docs/process.md, step 2)",
  },
  [Code.ChildStdioLiteral]: {
    text: 'each stream of \'stdio\' is written as a literal: "pipe", "inherit", "ignore" or a file descriptor such as 2',
  },
  [Code.ChildStdioIpc]: {
    text: "'ipc' is the channel to another Node that fork starts, which tz does not have (docs/process.md, section 4)",
  },
  [Code.ChildStdioUnknown]: {
    text: 'unknown stdio \'{word}\'; a stream is "pipe", "inherit", "ignore" or a file descriptor such as 2',
  },
  [Code.ChildStdioSpread]: {
    text: "write each stream of 'stdio' in the literal",
  },
  [Code.ChildStdioNoFd]: {
    text: "there is no file descriptor {word}",
  },
  [Code.ChildZeroCwd]: {
    text: "could not run it: cwd has a zero character in it",
  },
  [Code.ChildNegative]: {
    text: "could not run it: {word} must be 0 or more",
  },
  [Code.ChildNoSignal]: {
    text: "could not run it: there is no signal {word} (killSignal)",
  },
  [Code.ChildInput]: {
    text: "'input' of '{word}' is the text or the bytes the program reads (a string, a Buffer or a Uint8Array); found '{first}'",
  },
  [Code.ChildBufferText]: {
    text: "text input with the encoding 'buffer' is a TypeError in Node (Unknown encoding: buffer); pass its bytes, 'Buffer.from(text)', or drop the encoding",
  },
  [Code.ChildKillSignal]: {
    text: "'killSignal' is the name of a signal, e.g. \"SIGKILL\", or its number; found '{first}'",
  },
  [Code.ChildExecShell]: {
    text: "'execSync' always runs the command through a shell; 'shell' may name another one, e.g. shell: \"powershell.exe\", and to run a program without one, use 'execFileSync'",
  },
  [Code.ChildShellFlag]: {
    text: "the option 'shell' of '{word}' is written as a literal, true or false: what can go wrong, and so the type of the error, depends on it",
  },
  [Code.ChildShell]: {
    text: "'shell' is true, false or the path of a shell; found '{first}'",
  },
  [Code.WeakRefNotYet]: {
    text: "a WeakRef of '{word}' is not supported yet; it refers to objects of the program's types",
  },
  [Code.WeakRefNotObject]: {
    text: "a WeakRef refers to an object, not to a value of type '{word}'{other}",
  },
  [Code.WeakRefOneObject]: {
    text: "'new WeakRef' takes the object it refers to, e.g. 'new WeakRef(node)'",
  },
  [Code.WeakRefTypeArguments]: {
    text: "'WeakRef' takes one type argument, the type of its object",
  },
  [Code.WeakRefNoMethod]: {
    text: "property '{word}' does not exist on type '{first}'; it has 'deref()'",
  },
  [Code.WeakRefDerefValue]: {
    text: "property '{word}' of a WeakRef can only be called: 'deref()'",
  },
  [Code.RegexFlagsInvalid]: {
    text: "invalid regular expression flags '{word}': the flags are d, g, i, m, s, u, v and y, each at most once, and not u with v",
  },
  [Code.RegexTestGlobal]: {
    text: "'test' of a regex with the 'g' flag starts where the previous match ended (lastIndex), so the same call can give true and then false; remove 'g'",
  },
  [Code.RegexCompile]: {
    text: "'compile' is a legacy method that changes the regex in place; make a new one instead: 'new RegExp(pattern, flags)'",
  },
  [Code.RegexNoMember]: {
    text: "property '{word}' does not exist on type 'RegExp'{other}",
  },
  [Code.RegexStaticEscape]: {
    text: "'RegExp.escape' can be used as a value only where a function type is expected, e.g. as a callback",
  },
  [Code.RegexStaticLegacy]: {
    text: "'RegExp.{word}' is a legacy property that holds what the last match of any regex found; read it from the match itself, e.g. 'm[1]'",
  },
  [Code.RegexStaticNoMember]: {
    text: "property '{word}' does not exist on 'RegExp'",
  },
  [Code.RegexNewUnknown]: {
    text: "'new RegExp' of a pattern known only when the program runs may fail, and 'new' gives no Result; write 'RegExp.parse(pattern{other})', which gives a Result<RegExp, RegexError>",
  },
  [Code.RegexMatchFlag]: {
    text: "what 'match' gives depends on the g flag (all the texts that match, or one match with its groups), and the regex is known only when the program runs (it is not a literal, nor a variable that holds one all along); for one match write 're.exec(s)', for all of them 's.matchAll(re)'",
  },
  [Code.RegexNeedsGlobal]: {
    text: "'{word}' needs a regex with the g flag (JavaScript throws a TypeError without it), e.g. '/{first}/{other}g'",
  },
  [Code.RegexNotPattern]: {
    text: "'{word}' takes a regex{other}, found '{first}'",
  },
  [Code.RegexTextReplace]: {
    text: '\'replace\' with a string replaces only the first occurrence ("a-b-c".replace("-", "+") is "a+b-c" in JavaScript); to replace all of them write \'replaceAll({word}, ...)\', for only the first one a regex: \'replace({first}, ...)\'',
  },
  [Code.RegexTextSearch]: {
    text: "'search' takes a regex, and JavaScript makes one of a string, where '.' matches any character; to find the text write 'indexOf({word})', for a regex '{first}'",
  },
  [Code.RegexTextInclude]: {
    text: "'{word}' takes a regex, and JavaScript makes one of a string, where '.' matches any character; to check for the text write 'includes({first})', for a regex '{other}'",
  },
  [Code.RegexFunctionText]: {
    text: "a function as the replacement needs a regex: 'replaceAll({word}, ...)'",
  },
  [Code.RegexNoGroup]: {
    text: "the regex has {word} group{other}, so there is no group {first} for '${first}' (JavaScript would insert it as it is); write '$$' for '$'",
  },
  [Code.RegexNoNamedGroup]: {
    text: "the regex has no group named '{word}' for '$<{word}>'",
  },
  [Code.RegexNoNamedGroups]: {
    text: "the regex has no named groups, so JavaScript would insert '$<{word}>' as it is; name a group with '(?<{word}>...)'",
  },
  [Code.RegexOnlyMatch]: {
    text: "the function gets only the match: the regex is known only when the program runs (it is not a literal, nor a variable that holds one all along), so its groups are not known when compiling",
  },
  [Code.RegexPasses]: {
    text: "'{word}' passes {first} arguments: the match, {second} group{other}, the offset and the string{place}",
  },
  [Code.CryptoHashAnyLength]: {
    text: "'{word}' gives output of any length, which HMAC and the KDFs cannot use; use a hash such as 'sha256'",
  },
  [Code.CryptoHashTurnedOff]: {
    text: "'{word}' is turned off in node 24 (it throws ERR_OSSL_EVP_UNSUPPORTED) and in tz; use 'sha256'",
  },
  [Code.CryptoHashUnknown]: {
    text: "unknown hash '{word}'; node has those getHashes() lists, e.g. 'sha256', 'sha512', 'sha3-256', 'md5'",
  },
  [Code.CryptoCipherTurnedOff]: {
    text: "'{word}' is turned off in node 24 (it throws ERR_OSSL_EVP_UNSUPPORTED) and in tz; use 'aes-256-gcm'",
  },
  [Code.CryptoCipherUnknown]: {
    text: "unknown cipher '{word}'; node has those getCiphers() lists, e.g. 'aes-256-gcm', 'aes-256-cbc', 'chacha20-poly1305'",
  },
  [Code.CryptoKeyBytes]: {
    text: "{word} needs a {first}-byte key, but this one has {second} bytes",
  },
  [Code.CryptoIvEmpty]: {
    text: "{word} needs an IV of 1 byte or more, but it is empty",
  },
  [Code.CryptoIvBytes]: {
    text: "{word} needs a {first}-byte IV, but this one has {second} bytes",
  },
  [Code.CryptoWhole]: {
    text: "{word} must be a whole number of {first} or more, not {second}",
  },
  [Code.CryptoScryptCost]: {
    text: "N must be a power of two greater than 1, not {word}",
  },
  [Code.CryptoTagLength]: {
    text: "'{word}' needs the length of its tag: '{ authTagLength: 16 }'",
  },
  [Code.CryptoOptionsLiteral]: {
    text: "the options of '{word}' are written in the call, as an object literal, e.g. '{ {first}: ... }'",
  },
  [Code.CryptoOptionsByName]: {
    text: "write each option of '{word}' by its name, e.g. '{ {first}: ... }'",
  },
  [Code.CryptoOptionUnknown]: {
    text: "'{word}' has no option '{first}'; it takes {other}",
  },
  [Code.CryptoOptionsTogether]: {
    text: "option '{word}' cannot be used together with '{first}': they are one option",
  },
  [Code.CryptoAsyncCallback]: {
    text: "'{word}' with a callback is not supported: tz has no callbacks (docs/crypto.md, section 5); without one it returns a Promise: 'const result = await {word}(...)'",
  },
  [Code.CryptoSyncCallback]: {
    text: "'{word}' with a callback is not supported: tz has no callback forms of node:crypto (docs/crypto.md, section 5); call it without one and use what it returns: {other}, or run it on the thread pool with '{word}Async' of \"tz:crypto\": 'await {word}Async(...)'",
  },
  [Code.CryptoCurveUnknown]: {
    text: "unknown curve '{word}'; node has those getCurves() lists, e.g. 'prime256v1', 'secp384r1', 'secp256k1'",
  },
  [Code.CryptoChoiceUnknown]: {
    text: "unknown {word} '{first}'; it is {other}",
  },
  [Code.CryptoPairOption]: {
    text: "the option '{word}' of 'rsa-pss' keys is not supported yet",
  },
  [Code.CryptoPairModulus]: {
    text: "'{word}' keys need '{ modulusLength: 2048 }'",
  },
  [Code.CryptoPairCurve]: {
    text: "'ec' keys need '{ namedCurve: \"P-256\" }'",
  },
  [Code.CryptoPairSmall]: {
    text: "an RSA key needs a modulusLength of 512 bits or more, not {word}",
  },
  [Code.CryptoNewCertificate]: {
    text: "'new X509Certificate' may fail on the data it reads, and 'new' gives no Result; write 'X509Certificate.parse(pem)', which gives a Result<X509Certificate, ParseCertificateError>",
  },
  [Code.CryptoNewClass]: {
    text: "'new {word}' is not how node makes one: {other}",
  },
  [Code.CryptoNoMethod]: {
    text: "property '{word}' does not exist on type '{first}'; it has {other}",
  },
  [Code.CryptoStreamMethod]: {
    text: "'{word}' of {first} is not supported yet: in node it is a stream too, and tz has no streams yet (docs/streams.md); use {other}",
  },
  [Code.CryptoOnlyCalled]: {
    text: "property '{word}' of {first} can only be called; it has {other}",
  },
  [Code.CryptoKeyDetails]: {
    text: "'asymmetricKeyDetails' is not supported yet: node gives the exponent of RSA as a bigint, which tz has not",
  },
  [Code.CryptoIssuerCertificate]: {
    text: "'issuerCertificate' comes only with TLS (docs/net.md)",
  },
  [Code.CryptoNotData]: {
    text: "the {word} is {other} (a Buffer, a typed array or a DataView{first}); found '{second}'{place}",
  },
  [Code.CryptoEncodingLiteral]: {
    text: "the encoding of '{word}' is written as a literal, e.g. 'hex': the type of what it gives depends on it",
  },
  [Code.CryptoRandomValues]: {
    text: "'getRandomValues' fills an array of integers (a Uint8Array, an Int32Array, a Buffer...); found '{word}'",
  },
  [Code.CryptoGlobalMember]: {
    text: "'crypto.{word}' does not exist; the global crypto has 'randomUUID' and 'getRandomValues'",
  },
  [Code.CryptoGlobalCalled]: {
    text: "'crypto.{word}' can only be called",
  },
  [Code.GlobalThisMember]: {
    text: "'globalThis.{word}' is not supported: tz has only 'globalThis.crypto'; write '{word}'",
  },
  [Code.ReadlineOption]: {
    text: "the option '{word}' of 'createInterface' is not supported yet",
  },
  [Code.ReadlineNoInput]: {
    text: "'createInterface' needs the input: '{ input: process.stdin }'",
  },
  [Code.ReadlineNotStdin]: {
    text: "readline reads only stdin yet: the input is 'process.stdin'; for the lines of a file, 'readFile' it and split them",
  },
  [Code.ReadlineOutput]: {
    text: "the output of readline is 'process.stdout' or 'process.stderr'",
  },
  [Code.CryptoRandomArgs]: {
    text: "'randomInt' takes a minimum and a maximum",
  },
  [Code.CryptoRandomInt]: {
    text: "'randomInt' takes whole numbers ('int'), found '{word}'",
  },
  [Code.CryptoGreaterMinimum]: {
    text: "cannot prove that the maximum is greater than the minimum, and JavaScript would throw a RangeError; check it first, e.g. 'if ({word} < {other})'",
  },
  [Code.CryptoGreaterZero]: {
    text: "cannot prove that the maximum is greater than 0, and JavaScript would throw a RangeError; check it first, e.g. 'if ({word} < {other})'",
  },
  [Code.CryptoKeyLengthNeeded]: {
    text: "'{word}' needs the length of the key in bits: '{ length: 256 }'",
  },
  [Code.CryptoAesKeyLength]: {
    text: "the length of an AES key is 128, 192 or 256, written as a number; JavaScript throws a TypeError otherwise",
  },
  [Code.ForeignPlain]: {
    text: "a function in C takes plain parameters: no type parameters, no rest",
  },
  [Code.ForeignOptional]: {
    text: "a function in C has no optional parameters",
  },
  [Code.ForeignTakes]: {
    text: "a function in C cannot take a value of type '{word}'; it takes numbers, 'boolean', 'cstring', handles ('declare class'), arrays of numbers and handles, 'Buffer' and 'Out<T>'",
  },
  [Code.ForeignGives]: {
    text: "a function in C cannot give a value of type '{word}'; it gives numbers, 'boolean', 'cstring' and handles ('declare class')",
  },
  [Code.ForeignNoReturn]: {
    text: "a function in C needs its return type written: tz cannot see its code",
  },
  [Code.ForeignHandleNew]: {
    text: "'{word}' is a handle from C ('declare class'): only functions in C give it out",
  },
  [Code.CallbackAsyncTest]: {
    text: "'{word}' uses what the function returns as '{first}', but an async function returns a Promise; a Promise is always truthy, so JavaScript would take every element as passing: await the tests first, e.g. 'const passed = await Promise.all(xs.map(async x => ...))', then test 'passed[i]'",
  },
  [Code.CallbackAsyncValue]: {
    text: "'{word}' uses what the function returns as '{first}', but an async function returns a Promise; drop 'async', or await what the function needs before the call",
  },
  [Code.CallbackAsyncReplace]: {
    text: "'{word}' uses what the function returns as '{first}', but an async function returns a Promise; JavaScript would insert \"[object Promise]\" for each match: work out the replacements first, then replace with a function that is not async",
  },
  [Code.AwaitMixed]: {
    text: "'await' of '{word}' gives the value of the Promise or the value itself, which make no one type; check what it holds first",
  },
  [Code.PromiseListMayBe]: {
    text: "'{word}' of values that may be promises ('{first}') is not supported yet; await each first, or make each a Promise",
  },
  [Code.PromiseListNotArray]: {
    text: "'{word}' needs an array of promises, found '{first}'{other}",
  },
  [Code.EmbedLiteral]: {
    text: "the path of {word} must be a string literal: the file is read when the program is compiled, e.g. '{other}'",
  },
  [Code.EmbedBackslash]: {
    text: "write '/' in the path, not '\\', as on every system",
  },
  [Code.EmbedRelative]: {
    text: "the path of {word} is relative to the file it is written in, e.g. '{other}'",
  },
  [Code.EmbedUnread]: {
    text: "cannot read '{word}': {other}",
  },
  [Code.ForAwaitPlace]: {
    text: "'for await' can only be used in an async function or in top-level code; make the function async",
  },
  [Code.ForAwaitNotIterable]: {
    text: "'for await' needs an async iterator, an array or an iterator, found '{word}'",
  },
  [Code.ForOfLater]: {
    text: "'{word}' gives its values later: iterate it with 'for await (const x of ...)'",
  },
  [Code.AsyncNextNotYet]: {
    text: "'{word}()' of an async iterator is not supported yet; iterate it with 'for await'",
  },
  [Code.ObjectNumberEnum]: {
    text: "'Object.{word}' of numeric enum '{first}' is not supported: in JavaScript it mixes the names of the members with their numbers; list the members you need, e.g. '[{first}.{other}]'",
  },
  [Code.EnumTypeMemberMissing]: {
    text: "enum '{word}' has no member '{other}'",
  },
  [Code.ClassNotTopLevel]: {
    text: "a class can be declared only at the top level of a file; here, make it with a class expression, 'const {word} = class { ... }'",
  },
  [Code.TemplateHole]: {
    text: "a template literal type holds strings, numbers, booleans and undefined, not '{word}'",
  },
  [Code.TextChangeNotString]: {
    text: "'{word}' takes a string type, such as a string literal type, not '{other}'",
  },
  [Code.MappedRename]: {
    text: "a mapped type renames its keys to names of fields, string literal types such as `get${Capitalize<K>}`, not '{word}'",
  },
  [Code.ReflectGetJson]: {
    text: "Reflect.get takes an object of the language; read a key of a Json as JavaScript does, 'j[key]'",
  },
  [Code.ReflectGetNotObject]: {
    text: "Reflect.get takes an object, and this is a '{word}'",
  },
  [Code.ReflectApplyNotFunction]: {
    text: "Reflect.apply calls a function, and this is a '{word}'",
  },
  [Code.ReflectConstructThird]: {
    text: "the third argument of Reflect.construct, the class whose prototype the object gets, is not supported: there are no prototypes in tz; make an object of that class",
  },
  [Code.ReflectConstructNotClass]: {
    text: "Reflect.construct makes an object of a class, and this is a '{word}'",
  },
  [Code.ReflectArgumentsTuple]: {
    text: "the arguments are an array, and this is a tuple; copy it into one, '[...t]'",
  },
  [Code.ReflectMetadataValue]: {
    text: "'Reflect.metadata(key, value)' makes a decorator; write it as one, before a class or a member: '@Reflect.metadata(key, value)'",
  },
  [Code.ReflectMetadataKeys]: {
    text: "'Reflect.{word}' is not supported: the keys of records are decorators, classes and strings, which no one type holds; ask for each key with 'Reflect.hasMetadata(key, target)'",
  },
  [Code.ReflectUnknown]: {
    text: "'Reflect.{word}' is not supported; Reflect has get, apply, construct, fill, defineMetadata, getMetadata, getOwnMetadata, hasMetadata, hasOwnMetadata and deleteMetadata",
  },
  [Code.MetadataKeyType]: {
    text: "a key of metadata is a decorator, a class or a constant, whose records have the type of what is written, or a string, whose records are 'unknown'; found '{word}'",
  },
  [Code.MetadataKeyDesign]: {
    text: "the records 'design:*' are what the compiler writes for decorated members; write a key of your own",
  },
  [Code.MetadataVoidValue]: {
    text: "an expression of type 'void' has no value to record",
  },
  [Code.MetadataTarget]: {
    text: "the target of metadata is an object, such as a class, found '{word}'",
  },
  [Code.WholeImportUses]: {
    text: "{word}; import the names this file uses: 'import { {first} } from \"{path}\"'",
  },
  [Code.WholeImportTypical]: {
    text: "{word}; import the names you need, e.g. 'import { {first} } from \"{path}\"'",
  },
  [Code.WholeImportProcess]: {
    text: "{word}; 'process' is global, as in Node, so the import is not needed: drop it",
  },
  [Code.WholeImportBuffer]: {
    text: "{word}; 'Buffer' is global, as in Node: import it as 'import { Buffer } from \"{path}\"', or drop the import",
  },
  [Code.ObjectNameValue]: {
    text: "'{word}' can only be used through its properties, e.g. '{other}'",
  },
  [Code.PrintVoid]: {
    text: "an expression of type 'void' cannot be printed",
  },
  [Code.PerformanceOther]: {
    text: "'performance.{word}' is not supported yet; only 'performance.now()' is",
  },
  [Code.ResultImportBuiltIn]: {
    text: "Result, ok and err are built in: remove the import from 'neverthrow'",
  },
  [Code.ResultExportBuiltIn]: {
    text: "Result, ok and err are built in: remove the export from 'neverthrow'",
  },
  [Code.JsonIsJsonKnown]: {
    text: "Json.isJson tells whether an 'unknown' value holds a Json; a value of type '{word}' is known when the program is built{other}",
  },
  [Code.FsZeroPath]: {
    text: "the path has a zero character in it, which no file name can have",
  },
  [Code.NodeOnlyCalled]: {
    text: "'{word}' of '{other}' can only be called; where a function is expected, pass an arrow that calls it, e.g. 'x => {word}(x)'",
  },
  [Code.NodeModuleValue]: {
    text: "this is not a value: the functions of '{word}' are used by their names, e.g. '{other}'",
  },
  [Code.NodeNotFunction]: {
    text: "'{word}' is not a function: call the functions of '{other}' by their names",
  },
  [Code.NodeStringCalled]: {
    text: "'{word}' is a string, not a function",
  },
  [Code.NodeSubmoduleCalled]: {
    text: "'{word}' is not a function: call its functions, e.g. '{word}.join(a, b)'",
  },
  [Code.FsConstantsValue]: {
    text: "'constants' of 'node:fs' is used as 'constants.F_OK' and the like",
  },
  [Code.CryptoConstantsValue]: {
    text: "'constants' of 'node:crypto' is used as 'constants.RSA_PKCS1_PSS_PADDING' and the like",
  },
  [Code.NodeCryptoType]: {
    text: "'{word}' of 'node:crypto' is a type: its objects come from the functions of 'node:crypto'",
  },
  [Code.FsClassNew]: {
    text: "'new {word}' is not possible: only the functions of node:fs make {word}",
  },
  [Code.CryptoNeeds]: {
    text: "the parameters of '{word}' need '{other}'",
  },
  [Code.CryptoNeedsKey]: {
    text: "the options of '{word}' need 'key'",
  },
  [Code.CryptoPrimeBigint]: {
    text: "'bigint' is not supported: tz has no bigint (docs/numbers.md); the prime comes as an ArrayBuffer",
  },
  [Code.GeneratorNotAsync]: {
    text: "an async generator returns an async iterator: declare its type as 'AsyncGenerator<{word}>'",
  },
  [Code.YieldPromiseOther]: {
    text: "the Promise gives '{word}', but {first} yields '{other}'",
  },
  [Code.YieldPromiseMixed]: {
    text: "'yield' of '{word}' gives the value of the Promise or the value itself, which make no one type; check what it holds first",
  },
  [Code.AsyncIteratorMethodResult]: {
    text: "'[Symbol.asyncIterator]()' of '{word}' gives '{first}', which is not an async iterator; make it an async generator, 'async *[Symbol.asyncIterator]() { yield ... }'",
  },
  [Code.ReadlineNoMember]: {
    text: "property '{word}' does not exist on type '{first}'; it has 'question()' and 'close()', and 'for await (const line of rl)' gives the lines",
  },
  [Code.ReadlineEvents]: {
    text: "'{word}' of readline is not supported yet: its Interface is no EventEmitter yet (docs/events.md); read the lines with 'for await (const line of rl)' or ask with 'question()'",
  },
  [Code.FsPromisesOpen]: {
    text: "'open' of 'node:fs/promises' is not supported yet: there is no FileHandle; use 'readFile', 'writeFile' or 'appendFile', which read and write Buffers too",
  },
  [Code.ReflectFillCannot]: {
    text: "Reflect.fill cannot fill '{word}': {other} (Reflect.fill gives the fields of a class without a constructor their values)",
  },
  [Code.ReflectFillNotClass]: {
    text: "Reflect.fill makes an object of a class, and this is a '{word}'",
  },
  [Code.GenericClassConstructor]: {
    text: "type 'typeof {word}' is not assignable to type '{first}'; each list of type arguments of '{word}' makes a class of its own, and 'new' of this value could make none of them: give a class that extends it, e.g. '{other}', or take the class as an 'object'",
  },
  [Code.StatsDateAssign]: {
    text: "'{word}' cannot be assigned: it is made from '{word}Ms' when it is read; keep the date in a variable of its own",
  },
  [Code.KeyedReadonly]: {
    text: "a readonly field cannot be assigned through a key",
  },
  [Code.KeyedByName]: {
    text: "fields of type '{word}' are assigned by name, as in 'o.name = v'; through a key of literals only fields of a plain type are, or fields named by the members of a string enum",
  },
  [Code.BodyDeclared]: {
    text: "a declaration cannot be the whole body here; wrap it in '{ }'",
  },
  [Code.ParamFieldNeedsType]: {
    text: "parameter '{word}' declares a field and needs a type, e.g. 'public {word}: int'",
  },
  [Code.JsonTextInvalid]: {
    text: "this text is not JSON, so JSON.parse would always fail: {word} (line {first}, column {other})",
  },
  [Code.JsonTextBom]: {
    text: "this text is not JSON, so JSON.parse would always fail: it starts with a byte order mark (BOM)",
  },
  [Code.JsonNeverNull]: {
    text: 'after \'typeof {word} {first} "{other}"\' {word} is never null here: the typeof of null is "null"; drop this check',
  },
  [Code.JsonNeverArray]: {
    text: 'after \'typeof {word} {first} "{other}"\' {word} is never an array here: the typeof of an array is "array"; drop this check',
  },
  [Code.KeyedFieldsDiffer]: {
    text: "the fields that '{word}' names must all be in '{other}' and have one type",
  },
  [Code.KeyedNotOptional]: {
    text: "the fields that '{word}' names are of type '{other}', not optional; the object gets only one of them, so the others would be missing",
  },
  [Code.KeyedValuesDiffer]: {
    text: "field '{word}' gets values of different types; declare the type of the object",
  },
  [Code.CStringNul]: {
    text: "type '{first}' is not assignable to type '{second}'; a 'cstring' holds no '\\0' inside: C would see only the text before it",
  },
  [Code.CStringText]: {
    text: "type '{first}' is not assignable to type '{second}'; make one with 'text.toCString()', which gives undefined when the text holds '\\0'",
  },
  [Code.DisposeShape]: {
    text: "'[Symbol.dispose]' is an instance method with no parameters that gives nothing: tz calls it when the last reference to the object is gone",
  },
  [Code.DisposeNoSuper]: {
    text: "the '[Symbol.dispose]' of '{word}' is called by itself right after this one, so 'super[Symbol.dispose]()' here would free what '{word}' holds twice",
  },
  [Code.DisposeThisLeaves]: {
    text: "'this' cannot leave '[Symbol.dispose]': the object is dying; use its fields",
  },
  [Code.DisposeManual]: {
    text: "tz calls '[Symbol.dispose]' itself when the last reference to the object is gone; a second call would free what it holds twice; give the class a method of its own to close it early",
  },
  [Code.UsingNotDisposable]: {
    text: "'using' takes an object whose class has '[Symbol.dispose]'; '{word}' has none",
  },
  [Code.UsingOutlives]: {
    text: "'{word}' of 'using' cannot outlive its block: '[Symbol.dispose]' runs when the block ends",
  },
  [Code.StaticUsedEarly]: {
    text: "'{word}' is used before class '{other}' is declared, which sets it",
  },
  [Code.StaticReadBeforeSet]: {
    text: "'{word}' is read before it is set: the static fields are set in the order they are declared",
  },
  [Code.ClassUsedEarly]: {
    text: "class '{word}' is used before its declaration, which JavaScript has not run yet here (a ReferenceError); move the class up",
  },
  [Code.GenericLiteralClass]: {
    text: "generic function '{word}' cannot return an object literal with methods yet: each copy of it makes a class of its own; declare a class, or give the object function fields, 'f: () => ...'",
  },
  [Code.PrintSpread]: {
    text: "only an array can be spread into console.log, found '{word}'",
  },
  [Code.GenericIndexKey]: {
    text: "'{word}' is indexed by its keys, such as 'k: K' with 'K extends keyof {word}', not by '{other}'",
  },
  [Code.UtilityNotFunction]: {
    text: "'{word}' takes a function type, not '{other}'",
  },
  [Code.ReturnsCycleDiffer]: {
    text: "{word} returns values of different types; a function returns values of one type",
  },
  [Code.ListParamMethod]: {
    text: "a list of parameters has no method '{word}' here; it has 'length' and 'join', and goes on with '...args'",
  },
  [Code.AliasNests]: {
    text: "type alias '{word}' nests more than 50 instances of itself, so it may never end; TypeScript stops there too, and a branch that is the alias itself, '... ? {word}<...> : ...', may go 1000 deep",
  },
  [Code.GenericChainEndless]: {
    text: "calling '{word}' here needs another copy of it for each copy of the functions that lead here, without end: its type arguments keep growing ('{first}' by now); generic functions that call each other must pass their type parameters on unchanged",
  },
  [Code.TupleTypeList]: {
    text: "'{word}' is a list of types; spread it into the tuple, '...{word}'",
  },
  [Code.ListArgumentsMany]: {
    text: "too many arguments for the parameters '{word}'",
  },
  [Code.ListSpreadWrong]: {
    text: "'...{word}' is spread where the parameters '{first}' take {other}",
  },
  [Code.ListNotSpread]: {
    text: "the arguments for the parameters '{word}' of some function are spread from a list of them, e.g. '...args'",
  },
  [Code.ListMissing]: {
    text: "the parameters '{word}' take {other} too, after these arguments",
  },
  [Code.MetadataRecordType]: {
    text: "type '{first}' is not assignable to type '{second}' of the records of '{word}'",
  },
  [Code.MetadataUndefinedRecord]: {
    text: "cannot tell the type of the records of '{word}' from 'undefined'; write a value of the type first",
  },
  [Code.MetadataNoRecord]: {
    text: "the records of '{word}' have the type of the first one written, 'Reflect.defineMetadata({word}, value, target)', and none is written before this; write one first, give the type where this one goes (e.g. 'const x: string[] = ...'), or use a string key, whose records are 'unknown'",
  },
  [Code.ReflectNewMayFail]: {
    text: "'new' of a class known only when the program runs may fail: '{word}' can be here, and {other}; write 'Reflect.construct(cls, [...])', which gives a Result",
  },
  [Code.ReadWhileLoading]: {
    text: "{word} reads {first} while it loads, but {second} is not loaded yet: {other}; compute the value inside a function, or move '{place}' to a file outside the cycle",
  },
  [Code.ImportBackReturn]: {
    text: "cannot tell what {word} returns: it uses a file that imports it back and calls it while loading; declare its return type, e.g. '): int'",
  },
  [Code.PromiseStaticTypeArgs]: {
    text: "type arguments can be given to 'Promise.withResolvers<T>()'; the other functions of Promise take their types from what they get",
  },
  [Code.PromiseVoidGiven]: {
    text: "a value of type 'void' cannot be given to '{word}'",
  },
  [Code.PromiseResolversTypeArgs]: {
    text: "'Promise.withResolvers' takes one type argument, the type of the value",
  },
  [Code.PromiseResolversUnknown]: {
    text: "'Promise.withResolvers' needs the type of the value; write it, e.g. 'Promise.withResolvers<int>()'",
  },
  [Code.PromiseListNoType]: {
    text: "'{word}' of no promises needs the type of their values; give the array a type, e.g. 'const ps: Promise<int>[] = []'",
  },
  [Code.PromiseAllVoid]: {
    text: "'Promise.all' collects the values, and a Promise<void> has none; await it on its own",
  },
  [Code.PromiseRaceDiffer]: {
    text: "'{word}' gives a value of one of the promises, but they give '{first}' and '{second}'; make them give one type",
  },
  [Code.PromiseValueNotInferred]: {
    text: "cannot tell the type of the Promise's value from what is given to 'resolve'; write it, e.g. 'new Promise<int>(...)'",
  },
  [Code.CryptoFillFits]: {
    text: "cannot prove that the offset and the size fit in the bytes, and JavaScript would throw a RangeError; check it first, e.g. 'if ({word} <= buf.length - {other})'",
  },
  [Code.ReferenceDirective]: {
    text: "'/// <reference>' is not supported: files are joined by imports; import what the file needs by name, e.g. 'import { a } from \"./x\"'",
  },
  [Code.RegexInvalid]: {
    text: "invalid regular expression: {word}",
  },
  [Code.PackageNpm]: {
    text: "npm packages are not supported: npm has compiled JavaScript, not TypeScript sources (docs/packages.md); look for the package on JSR or take its sources from git",
  },
  [Code.PackageWithoutManifest]: {
    text: "'{word}' is the name of a package, but there is no package.json to list packages in; make one with 'tz init' and add the package with 'tz add {word}' (a file of the program is imported by its relative path, e.g. './{word}')",
  },
  [Code.PackageJsrNotName]: {
    text: "'{word}' does not name a JSR package: 'jsr:@scope/name@^1'",
  },
  [Code.PackageJsrByName]: {
    text: "import a package by its name in package.json: add it with 'tz add jsr:{word}' and write 'from \"{first}\"'",
  },
  [Code.PackageBadName]: {
    text: "'{word}' does not name a package: a scoped name is '@scope/name'",
  },
  [Code.PackageNotDependency]: {
    text: "'{word}' is not a dependency in {path}; add it with 'tz add {word}'",
  },
  [Code.PackageNotDependencyOf]: {
    text: "'{word}' is not a dependency of package {other}{place}",
  },
  [Code.PackageNoExport]: {
    text: "'{word}' names nothing {other} exports; it exports {path}",
  },
  [Code.PackageFileMissing]: {
    text: "cannot find '{word}' in package {other} ({path}), which '{place}' names",
  },
  [Code.PackageFilesMissing]: {
    text: "cannot find '{word}': package {other} has no {first} or {second} (in {path})",
  },
  [Code.PackageNoEntry]: {
    text: 'package {other} names no file to import: it has no package.json with "main" or "exports", and none of {word} (in {path})',
  },
  [Code.PackageForeignNamed]: {
    text: "'{word}' names {path}, and the files of tz end in .tz: rename it to {other}",
  },
  [Code.DecoratorOldObject]: {
    text: "the decorator gives '{word}' another class in its place, and static field '{other}' holds an object made before, of the class as declared; make that object where it is used, or keep it outside the class",
  },
  [Code.UrlNotValid]: {
    text: "'{word}' is not a valid URL{other}",
  },
  [Code.UrlNotProtocol]: {
    text: "'{word}' is not a protocol: a protocol is a letter, then letters, digits and +-., e.g. 'https:'",
  },
  [Code.UrlNotPort]: {
    text: "'{word}' is not a port: a port is digits from 0 to 65535, or '' for none",
  },
  [Code.UrlNotHost]: {
    text: "'{word}' is not a host{other}",
  },
  [Code.UrlNewUnknown]: {
    text: "'new URL' of a text known only when the program runs may fail, and 'new' gives no Result; write 'URL.parse(text{other})', which gives a Result<URL, UrlError>",
  },
  [Code.UrlNewBase]: {
    text: "'new URL' with a base known only when the program runs may fail, and 'new' gives no Result; write 'URL.parse(input, base)', which gives a Result<URL, UrlError>",
  },
  [Code.HeaderNameNotToken]: {
    text: "'{word}' is not a name of a header: a name is letters, digits and !#$%&'*+-.^_`|~, without spaces",
  },
  [Code.HeaderValueBreak]: {
    text: "the value of a header cannot hold a line break or NUL",
  },
  [Code.ResponseStatusNoBody]: {
    text: "a response with status {word} has no body; write 'new Response(undefined, { status: {word} })'",
  },
  [Code.ResponseStatusText]: {
    text: "a statusText holds only tabs, spaces and visible characters up to U+00FF: no line breaks, no other control characters",
  },
  [Code.RequestCredentials]: {
    text: "a request cannot go to a URL with a user name or a password in it, as in node: send them in a header, e.g. 'authorization'",
  },
  [Code.RequestUnknownInput]: {
    text: "'new Request' of a text known only when the program runs may fail, and 'new' gives no Result; parse the text with 'URL.parse(text)' and pass the URL, or give the text to fetch, which gives a Result",
  },
  [Code.RequestMethodInvalid]: {
    text: "'{word}' is not a valid HTTP method",
  },
  [Code.RequestMethodForbidden]: {
    text: "fetch does not make requests with method '{word}'",
  },
  [Code.RequestGetBody]: {
    text: "a {word} request has no body{other}; give the method, e.g. 'method: \"POST\"'",
  },
  [Code.LibrarySetterMethod]: {
    text: "'{word}' is a method of '{first}'; change it with '{other}(...)'",
  },
  [Code.LibraryMethodAssigned]: {
    text: "'{word}' is a method of '{first}' and cannot be assigned: the object changes what it gives itself",
  },
  [Code.ForOfConcurrentMap]: {
    text: "a ConcurrentMap is not iterated directly, as other tasks change it during the loop; iterate a snapshot: 'for (const [key, value] of map.entries())'",
  },
  [Code.EventMapInvalid]: {
    text: "the type argument of 'EventEmitter' is its event map: each event with the arguments its listeners get, as a tuple, e.g. 'EventEmitter<{ data: [chunk: string]; end: [] }>'; {word}",
  },
  [Code.EventServiceInMap]: {
    text: "every emitter has the event '{word}', whose listeners get the name of the event and the listener, '[change: { event: string; listener: unknown }]', but the event map gives it '{first}'; leave it out of the map",
  },
  [Code.EventSeveral]: {
    text: "{word} carries '{first}', but an event carries one value: give it an object, e.g. 'message: [message: { from: User; text: string }]' (docs/events.md, section 2)",
  },
  [Code.EventNotInMap]: {
    text: "the emitter has no event '{word}': its event map has {first}{other}",
  },
  [Code.EventNameUnknown]: {
    text: "the name of the event must be known when compiling, as a string literal, e.g. '{word}(\"data\", ...)'; to name events known only when the program runs, give the emitter a map that takes any name, e.g. 'new EventEmitter<{ [name: string]: [msg: string] }>()'",
  },
  [Code.EmitTypeArgs]: {
    text: "'{word}' takes no type arguments: the event map of the emitter gives the types",
  },
  [Code.EmitArity]: {
    text: "the listeners of '{word}' get '{first}': {second}, but got {other}",
  },
  [Code.EmitterMethodValue]: {
    text: "'{word}' of an emitter can only be called: the event map checks each call by the name of its event; wrap it in an arrow, e.g. '(listener) => bus.{word}(\"data\", listener)'",
  },
  [Code.ListenerNotFunction]: {
    text: "a listener is a function, but this is '{first}'",
  },
  [Code.ListenerGets]: {
    text: "the listeners of '{word}' get '{first}', but this function is '{second}'; pass an arrow that calls it with what it needs",
  },
  [Code.ListenerAsyncResult]: {
    text: "an async listener returns 'Promise<void>', but this one returns '{first}', which the emitter would drop; wrap it, e.g. 'async (...) => { await f(...) }'",
  },
  [Code.ListenerThisType]: {
    text: "the listener takes 'this' of type '{first}', but it gets the emitter, of type '{second}'",
  },
  [Code.ListenerAsyncThis]: {
    text: "an async listener cannot take 'this'; use the emitter by name",
  },
  [Code.EventsNotEmitter]: {
    text: "'{word}' takes an emitter of node:events{other}, but this is '{first}'",
  },
  [Code.EventsTargetOn]: {
    text: "'on' of node:events takes an emitter of node:events; the events of an EventTarget are not supported yet: listen with 'addEventListener', or wait for one with 'await once(target, name)'",
  },
  [Code.ObjectListingEmitter]: {
    text: "'Object.{word}' of an emitter is not supported: its fields are the listeners it keeps; read the fields of its class by name",
  },
  [Code.TargetListenerEvent]: {
    text: "a listener of an EventTarget takes an Event, or a kind of it such as 'CustomEvent<int>', but this one takes '{first}'",
  },
  [Code.EventErrorUnheard]: {
    text: "'error' is emitted here, but nothing in the program listens for 'error' on this emitter, so the error would be lost (node would end the program); listen for it, e.g. 'bus.on(\"error\", (e) => ...)'",
  },
  [Code.StreamPipe]: {
    text: "'pipe' is not supported: it does not pass an error on, so the source stops and the destination stays open; join the streams with 'await pipeline(source, destination)', which gives a Result",
  },
  [Code.StreamNotReadable]: {
    text: "'{word}' has no {other}(): it is not readable",
  },
  [Code.StreamNotWritable]: {
    text: "'{word}' has no {other}(): it is not writable",
  },
  [Code.StreamPushUndefined]: {
    text: "'{word}(undefined)' does not end a stream: a chunk is never undefined; end the stream with 'pushEnd()'",
  },
  [Code.StreamByteChunk]: {
    text: "'{word}' of a stream of {first} takes a string, a Buffer or a Uint8Array, but this is '{second}'; to write objects, make the stream one of their type, e.g. 'class Users extends Readable<User>'",
  },
  [Code.StreamTextChunk]: {
    text: "'{word}' of a stream of {first} takes a string, but this is '{second}'; a Writable<string> gives its onWrite() the strings written; make it a Writable<Buffer> to write bytes",
  },
  [Code.StreamAbstract]: {
    text: "'{word}' is abstract: write a class that extends it and puts its work in '{first}', e.g. '{second}'",
  },
  [Code.StreamAbstractReadable]: {
    text: "'Readable' is abstract: write a class that extends it and puts its work in 'onRead', e.g. 'class Lines extends Readable<string> { protected onRead() { ... } }'; for a stream of values you already have, use 'Readable.from(values)'",
  },
  [Code.StreamUntypedNew]: {
    text: "'{word}' needs the type of its chunks, e.g. 'new {word}<Buffer>()', 'new {word}<string>()' or 'new {word}<User>()'",
  },
  [Code.StreamUntypedBase]: {
    text: "'{word}' needs the type of its chunks, e.g. '{word}<Buffer>', '{word}<string>' or '{word}<User>'",
  },
  [Code.StreamHookOther]: {
    text: "'{word}' is what node:stream calls, as '{first}', and a method with other parameters is another variant of the name, which it never calls; take those parameters, or leave out their types",
  },
  [Code.StreamHookOtherChunks]: {
    text: "'{word}' is what node:stream calls, as '{first}', and a method with other parameters is another variant of the name, which it never calls; take those parameters, or leave out their types; for chunks of another type, give the class it extends type arguments, e.g. 'extends Writable<string>'",
  },
  [Code.StreamEncodingObjects]: {
    text: "setEncoding() decodes the Buffers of a stream of bytes, and this is a stream of {word}; push strings into it instead",
  },
  [Code.StreamEncodingUnreadable]: {
    text: "'{word}' has no setEncoding(): it is not readable",
  },
  [Code.StreamEncodingListened]: {
    text: "setEncoding() on a stream that is used elsewhere already, which sees its chunks as Buffers, but strings would come: it got listeners ({word}()) before this; give the stream its encoding where it is created, e.g. 'createReadStream(path, \"utf8\")', or call setEncoding() first",
  },
  [Code.StreamStageChunk]: {
    text: "{word}() writes chunks of {first} to '{second}', which takes {other}",
  },
  [Code.StreamPipelineUnwritable]: {
    text: "pipeline() writes the chunks before it to each stream after the first, but '{word}' is not writable",
  },
  [Code.StreamComposeOther]: {
    text: "compose() takes streams, and this is '{word}'; to put a function between them, use pipeline()",
  },
  [Code.StreamComposeFew]: {
    text: "compose() takes the streams to make one Duplex of, e.g. 'compose(a, b)'",
  },
  [Code.StreamFromSource]: {
    text: "'Readable.from' takes an iterable, an async iterable, a string or a Buffer, but this is '{word}'",
  },
  [Code.EventNotEmitted]: {
    text: "no code of the program emits '{word}' on this emitter; it emits {first}{other}",
  },
  [Code.EventNeverEmitted]: {
    text: "no code of the program emits '{word}' on this emitter, nor any other event: an emitter without an event map has the events that emit() calls give it, e.g. 'bus.emit(\"{word}\", ...)'",
  },
  [Code.EventEmittedCount]: {
    text: "'{word}' is emitted with {first} at {second}, but with {other} here",
  },
  [Code.EventEmittedType]: {
    text: "'{word}' is emitted with {first} at {second}, but with '{other}' here; an event has one type of arguments",
  },
  [Code.ProtectedElsewhere]: {
    text: "'{word}' is protected in class '{first}'; '{second}' may use it only on its own objects, and this one is of class '{other}'",
  },
  [Code.ListenerKeeps]: {
    text: "the listener keeps '{word}', which nothing else holds, so nothing tells when its subscription ends; keep the state in an object and subscribe its method, e.g. 'bus.on(\"data\", counter.add)' (docs/events.md, section 6)",
  },
  [Code.TimerKeeps]: {
    text: "the interval keeps '{word}', which nothing else holds, so nothing tells when it should stop; keep the state in an object and pass its method, e.g. 'setInterval(counter.tick, 1000)' (docs/events.md, section 7)",
  },
  [Code.ListenerCaptures]: {
    text: "the listener captures {first}, but it may depend on one object only, the one whose life it follows; store what it needs from {second} in a field of '{other}' (docs/events.md, section 6)",
  },
  [Code.TimerCaptures]: {
    text: "the interval captures {first}, but it may depend on one object only, the one whose life it follows; store what it needs from {second} in a field of '{other}' (docs/events.md, section 7)",
  },
  [Code.ListenerUnknown]: {
    text: "can't tell what this listener captures, so not when its subscription ends; pass a method here, e.g. 'this.onData', or an arrow that uses one object, e.g. '(chunk) => this.add(chunk)' (docs/events.md, section 6)",
  },
  [Code.TimerUnknown]: {
    text: "can't tell what this interval captures, so not when it should stop; pass a method here, e.g. 'this.onData', or an arrow that uses one object, e.g. '(chunk) => this.add(chunk)' (docs/events.md, section 7)",
  },
  [Code.EmitterDropped]: {
    text: "the new {word} is held by nothing, so the listeners its constructor adds would stop at once; store it, e.g. 'const {other} = new {word}(...)' (docs/events.md, section 6)",
  },
  [Code.EventsWaitEndless]: {
    text: "{word} may never emit this event, so the wait may never end; give it a time limit, e.g. '{first}(emitter, \"done\", { timeout: 5000 })' (docs/events.md, section 6)",
  },
  [Code.EmitOneValue]: {
    text: "an event carries one value: pass an object, e.g. 'emit(\"{word}\", { from, text })' (docs/events.md, section 2)",
  },
  [Code.EventErrorPaths]: {
    text: "{word} may emit 'error', and nothing listens for it on every path here, so the error would be lost (node would end the program); listen in this function: '{first}.on(\"error\", (e) => ...)'",
  },
  [Code.ModeNeedsType]: {
    text: "'{word}' needs the type it wraps, e.g. '{other}'",
  },
  [Code.ModeTakesOne]: {
    text: "'{word}' takes one type, the one it wraps, e.g. '{other}'",
  },
  [Code.OwnMovedUsed]: {
    text: "'{word}' was given away on line {other}, so it cannot be used here",
  },
  [Code.OwnMovedInLoop]: {
    text: "'{word}' is given away inside the loop: on the next pass it is already gone",
  },
  [Code.OwnInUse]: {
    text: "'{word}' cannot be changed here: '{other}' still looks at it until line {first}",
  },
  [Code.OwnChangedInUse]: {
    text: "'{word}' cannot be used here: '{other}' changes it until line {first}",
  },
  [Code.OwnTakeBorrowed]: {
    text: "'{word}' is only lent here, so it cannot be given away; give a copy (structuredClone) or take it with replace / take",
  },
  [Code.OwnStoreBorrow]: {
    text: "'{word}' only looks at a value it does not own, and a borrow cannot be kept; keep the value itself or a copy",
  },
  [Code.OwnNeedsOwnParam]: {
    text: "parameter '{word}' is only lent to the function; to keep it, write 'Own<T>' as its type",
  },
  [Code.OwnArgumentTwice]: {
    text: "'{word}' is passed to be changed and, in the same call, once more",
  },
  [Code.OwnReturnPart]: {
    text: "'{word}' belongs to '{other}', so it cannot be returned as a value of its own; return 'Read<T>' to lend it, or a copy",
  },
  [Code.OwnReturnSource]: {
    text: "the result is lent from {word}, but this value comes from '{other}'",
  },
  [Code.OwnLentMissing]: {
    text: "a function that returns a borrow says where it comes from: write 'Lent<T>' as the type of that parameter",
  },
  [Code.OwnFreshBorrow]: {
    text: "a new value cannot be returned as a borrow: nothing would own it",
  },
  [Code.OwnKeptLet]: {
    text: "a callback that is kept cannot use 'let {word}': it would keep a copy of its own; keep the state in an object it takes, or share it (Shared, Atomic)",
  },
  [Code.OwnKeptThis]: {
    text: "a callback that is kept cannot use 'this': the method only borrows it; use SharedMut and WeakRef",
  },
  [Code.OwnKeptBorrow]: {
    text: "a callback that is kept cannot use '{word}': it is only lent here",
  },
  [Code.OwnGlobalLet]: {
    text: "a module cannot have 'let {word}' at its top level: use 'const' (an array, Map or object in it can still be filled from functions) or a static field",
  },
  [Code.OwnReadChanged]: {
    text: "'{word}' is only lent for reading here, so it cannot be changed",
  },
  [Code.OwnLoopChanged]: {
    text: "'{word}' cannot be changed while 'for...of' goes over it (line {other})",
  },
  [Code.OwnReadonlyArray]: {
    text: "'{word}' is a readonly array, so it cannot be changed",
  },
  [Code.OwnTakeElement]: {
    text: "'{word}' is an element of an array, so it cannot be given away; take it out with pop, shift or splice, or give a copy (structuredClone)",
  },
  [Code.OwnBorrowField]: {
    text: "the field '{word}' cannot hold a borrow: a borrow lives only inside a function; keep the value itself or a copy",
  },
  [Code.OwnEqualsMissing]: {
    text: "'{word}' is copied, so it has no address to compare by; give it a [Symbol.equals](other) method",
  },
  [Code.OwnKeyHash]: {
    text: "'{word}' is copied, so a key of it needs both [Symbol.equals](other) and [Symbol.hash](hasher)",
  },
  [Code.OwnWeakCopy]: {
    text: "'{word}' is copied, so it has no address for a weak reference to follow",
  },
  [Code.OwnUnsafeOutside]: {
    text: "'{word}' of tz:unsafe is a dangerous operation: call it only inside a function or method marked @Unsafe({ uses, reason })",
  },
  [Code.OwnUnsafeReason]: {
    text: "@Unsafe needs 'reason': a string that says why the dangerous operations here are right",
  },
  [Code.OwnUnsafeUses]: {
    text: "the function does '{word}' operations of tz:unsafe, so @Unsafe lists UnsafeUse.{word} in 'uses' (UnsafeUse has Memory and Foreign)",
  },
  [Code.OwnUnsafeUnused]: {
    text: "@Unsafe lists UnsafeUse.{word}, but the function does no such operation; take it out of 'uses'",
  },
  [Code.OwnCloneField]: {
    text: "'{word}' cannot be copied by structuredClone: it is {other}; give its class a [Symbol.clone]() method that says how to copy it",
  },
  [Code.OwnUnsafeRequires]: {
    text: "'{word}' asks its caller to keep a condition (@Unsafe 'requires'), so call it only inside a function or method marked @Unsafe",
  },
  [Code.OwnCopyShared]: {
    text: "'{word}' has a changeable type and is passed as the copy type '{first}', so both would share one value; give '{word}' the type '{first}' where it is made",
  },
  [Code.OwnCopyWidened]: {
    text: "'{word}' holds copied values, and as '{other}' each of them would have one owner, while other copies of '{first}' may still share them; build it as '{other}' from the start, or copy the items with structuredClone",
  },
  [Code.OwnMutVariance]: {
    text: "'{word}' is passed to be changed as a wider type, so the function may put another kind of value into it; take Read<...> if it only reads, or pass a copy",
  },
  [Code.OwnMutCopy]: {
    text: "'{word}' is copied when passed, so changing it changes nothing for the caller; give the new value back as the result",
  },
  [Code.OwnMemPlace]: {
    text: "'{word}' takes a place (a variable, a field or an element) and puts a value back into it; a new value is no place",
  },
  [Code.OwnUsingBorrow]: {
    text: "'{word}' only looks at an item the array still owns, so 'using' cannot free it; go over '{other}.drain()'",
  },
  [Code.OwnLentCopy]: {
    text: "'{word}' is copied when passed, so it needs no Lent; take it as is",
  },
  [Code.OwnTakeEmpty]: {
    text: "'{word}' has no empty value to leave in its place, so it cannot be taken; write replace({word}, value)",
  },
  [Code.OwnGiveGlobal]: {
    text: "'{word}' is a module constant, so it cannot be given away; give a copy (structuredClone)",
  },
  [Code.OwnStaticReplaced]: {
    text: "'{word}' is a static field, so a function cannot put another value in its place; change what it holds, or give it its value where it is declared",
  },
  [Code.OwnStaticGiven]: {
    text: "'{word}' belongs to a static field, so it cannot be given away; give a copy (structuredClone)",
  },
  [Code.OwnStaticLent]: {
    text: "the result is lent from the static field '{other}', which is changed elsewhere while the caller may still look at it; return a copy (structuredClone)",
  },
  [Code.OwnOverrideReadonly]: {
    text: "'{word}' overrides a readonly method of '{first}', so it must be readonly too: a call through '{first}' lends 'this' only for reading",
  },
  [Code.OwnReadonlyPromise]: {
    text: "'{word}' is readonly in '{first}', but in '{second}' it may change 'this'; write 'readonly' before '{word}' in '{second}'",
  },
  [Code.OwnConstantLent]: {
    text: "the result is lent from the module constant '{other}', which is changed elsewhere while the caller may still look at it; return a copy (structuredClone)",
  },
  [Code.OwnStaticCallChanges]: {
    text: "'{word}' may change '{other}', but '{first}' still looks into it until line {second}; read '{other}' again after the call, or copy the value with structuredClone",
  },
};
