  [Code.ArrayTextObjects]: {
    text: "objects cannot be converted to strings: JavaScript would give '[object Object]'; map them to text first, e.g. 'a.map(o => o.name).{word}()'",
  },
  [Code.SortFunctions]: {
    text: "sorting functions needs a comparison function: 'sort()' without one compares their source code",
  },
  [Code.SortUnknown]: {
    text: "sorting unknown values needs a comparison function: 'sort()' without one compares them as strings, objects as '[object Object]'; pass one, e.g. 'sort((a, b) => ...)'",
  },
  [Code.SortJson]: {
    text: "sorting Json values needs a comparison function: 'sort()' without one compares them as strings, objects as '[object Object]'; pass one, e.g. 'sort((a, b) => ...)'",
  },
  [Code.SortDates]: {
    text: "sorting dates needs a comparison function: 'sort()' without one compares the texts of toString(), 'Thu Feb 29 2024 ...', which puts them in the order of the names of the days; pass one: 'sort((a, b) => a.getTime() - b.getTime())'",
  },
  [Code.SortObjects]: {
    text: "sorting objects needs a comparison function: 'sort()' without one compares them all as '[object Object]'; pass one, e.g. 'sort((a, b) => a.x - b.x)'",
  },
  [Code.SortMixed]: {
    text: "'sort()' without a comparison function compares the values of '{word}' as strings, numbers and objects among them; pass one, e.g. 'sort((a, b) => ...)'",
  },
  [Code.SortNumbers]: {
    text: "'sort()' without a comparison function compares numbers as strings, as in JavaScript: [2, 10, 1] becomes [1, 10, 2]; pass one: 'sort((x, y) => {other})'",
  },
  [Code.ObjectReadOnlyField]: {
    text: "cannot assign to '{word}' because it is a read-only field of '{first}'",
  },
  [Code.NullishNotOptionalVariable]: {
    text: "'??=' needs a variable that may be undefined; '{word}' has type '{first}'",
  },
  [Code.NullishNotOptionalField]: {
    text: "'??=' needs a field that may be undefined; '{word}' has type '{first}'",
  },
  [Code.VoidFieldValue]: {
    text: "an expression of type 'void' cannot be the value of field '{word}'",
  },
  [Code.ForOfCannot]: {
    text: "cannot iterate over a value of type '{word}'",
  },
  [Code.RecordNotIterable]: {
    text: "a Record is not iterable, as an object is not in JavaScript; walk its keys with 'for...in', or its entries with 'for (const [k, v] of Object.entries(r))'",
  },
  [Code.NewArrayNoDefault]: {
    text: "'new Array<T>(n)' fills the array with a default value, and '{word}' has none; start from '[]' and use push()",
  },
  [Code.AssignThroughUndefined]: {
    text: "the value may be undefined; check it before assigning to '{word}'",
  },
  [Code.OwnInitializer]: {
    text: "'{word}' is used in its own initializer, before it has a value",
  },
  [Code.YieldDelegateNotIterable]: {
    text: "'yield*' needs an array, a string or an iterator, found '{word}'",
  },
  [Code.YieldSentUnknown]: {
    text: "the value of 'yield' is what next(x) sends, and nothing says its type; declare it in the return type, e.g. ': Generator<{word}, void, string>'",
  },
  [Code.GeneratorNoYield]: {
    text: "cannot tell what {word} yields: it has no 'yield'; declare its type, e.g. ': Generator<int>'",
  },
  [Code.YieldsDiffer]: {
    text: "{word} yields '{first}' here and '{second}' elsewhere; a generator yields values of one type",
