  [Code.NodeOptionsByName]: {
    text: "write each option of '{word}' by its name, e.g. '{ {first}: ... }'",
  },
  [Code.NodeOptionUnknown]: {
    text: "'{word}' has no option '{first}'; it takes {other}",
  },
  [Code.NodeOptionFlag]: {
    text: "the option '{first}' of '{word}' is written as a literal, true or false: the type of what it gives depends on it",
  },
  [Code.ProcessNotYet]: {
    text: "'process.{word}' is not supported yet",
  },
  [Code.ProcessOnlyCalled]: {
    text: "'process.{word}' can only be called: 'process.{word}()'",
  },
  [Code.ProcessNotFunction]: {
    text: "'process.{word}' is not a function",
  },
  [Code.ProcessSignal]: {
