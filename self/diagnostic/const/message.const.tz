  [Code.OkAsValue]: {
    text: "'{word}' can be used as a value only where a function type is expected, e.g. 'xs.map({word})'",
  },
  [Code.ArgumentsName]: {
    text: "'arguments' is not supported; use a rest parameter, e.g. '...args: int[]'",
