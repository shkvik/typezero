  [Code.FieldAccessNarrower]: {
    text: "'{word}' is {other} in '{first}', so it cannot be {second} in '{place}'",
  },
  [Code.FieldRedeclaredNoValue]: {
    text: "'{word}' is a field of '{first}' already; declared again in a class without a constructor, JavaScript would set it to undefined after the constructor of '{first}' set it: drop the declaration, or set it in a constructor",
