  [Code.GeneratorNotIterator]: {
    text: "a generator returns an iterator: declare its type as 'Generator<{word}>'",
  },
  [Code.ForOfResumes]: {
    text: "'for...of' resumes each 'yield' of '{word}' without a value, but it expects '{first}' from next(x); call next(x) yourself, or let the generator take '{first} | undefined'",
  },
  [Code.SpreadResumes]: {
    text: "a spread resumes each 'yield' of '{word}' without a value, but it expects '{first}' from next(x); call next(x) yourself, or let the generator take '{first} | undefined'",
  },
  [Code.IteratorNoThrow]: {
    text: "an iterator has no 'throw()' in tz: an error is a value, not something thrown into a generator",
  },
  [Code.IteratorNoReturn]: {
    text: "'return()' of an iterator is not supported yet; stop with 'break' in 'for of'",
  },
  [Code.IteratorNoLength]: {
    text: "property '{word}' does not exist on type '{first}'; an iterator does not know how many values it gives: collect them with '[...it]'",
  },
  [Code.DictNoLength]: {
    text: "property 'length' does not exist on type '{first}'; the number of entries is '{word}.size'",
  },
  [Code.DictMethodValue]: {
    text: "'{word}.{other}' can only be called, e.g. '{word}.{other}(...)'; pass an arrow that calls it where a function is expected",
  },
  [Code.MapHasNoAdd]: {
    text: "property '{other}' does not exist on type '{first}'; a Map sets an entry with '{word}.set(key, value)'",
  },
  [Code.SetHasNoGet]: {
    text: "property '{other}' does not exist on type '{first}'; a Set adds a value with '{word}.add(value)' and checks one with '{word}.has(value)'",
