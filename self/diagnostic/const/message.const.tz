  [Code.IndexMaybeUndefined]: {
    text: "the value may be undefined; check it before indexing",
  },
  [Code.NotIndexable]: {
    text: "type '{first}' cannot be indexed",
  },
  [Code.TupleKeyNotNumber]: {
    text: "a tuple is indexed by a number, found '{first}'",
  },
  [Code.TupleKeyNotConstant]: {
    text: "a tuple can be indexed only by a constant, such as '[0]': each element has its own type; or destructure it: 'const [a, b] = t'",
