  [Code.ImplementsClassExtended]: {
    text: "'{word}' is a class, and a class implements only interfaces",
  },
  [Code.ImplementsMissing]: {
    text: "class '{first}' implements '{second}', but has no '{word}'; declare it, e.g. '{other}'",
  },
  [Code.ImplementsParameters]: {
    text: "class '{first}' implements '{second}', whose '{word}' is '{other}', but '{first}.{word}' takes other parameters: {place}",
