  [Code.NotGenericMethod]: {
    text: "'{word}' is not a generic method; remove the type arguments",
  },
  [Code.InstanceMemberViaClass]: {
    text: "'{word}' is a member of the instances of '{first}', not of the class: create one with 'new {first}(...)'",
