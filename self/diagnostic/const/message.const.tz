  [Code.StaticThisMethod]: {
    text: "in a static method 'this' would be the class itself; use the class's name: '{first}.{word}'",
  },
  [Code.StaticThisField]: {
    text: "in a static field 'this' would be the class itself; use the class's name: '{first}.{word}'",
  },
  [Code.ThisInFunction]: {
    text: "a 'function' has no 'this' of its own; use an arrow function, which sees the 'this' of the method around it",
  },
  [Code.SuperRead]: {
    text: "'super.{word}' can only be called, 'super.{word}(...)'; to read the field or the method, use 'this.{word}'",
