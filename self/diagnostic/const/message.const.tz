  [Code.OwnInitializer]: {
    text: "'{word}' is used in its own initializer, before it has a value",
  },
  [Code.YieldDelegateNotIterable]: {
    text: "'yield*' needs an array, a string or an iterator, found '{word}'",
  },
  [Code.YieldSentUnknown]: {
    text: "the value of 'yield' is what next(x) sends, and nothing says its type; declare it in the return type, e.g. ': Generator<{word}, void, string>'",
