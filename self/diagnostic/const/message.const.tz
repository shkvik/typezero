  },
  [Code.NoSuchStreamField]: {
    text: "type '{first}' has no field '{word}'; an object must have exactly the fields of its type; an error with fields of its own has a type of its own, e.g. 'interface MyError extends StreamError { ... }', and the stream names it: 'new ReadableStream<int, MyError>(...)', 'class Lines extends Readable<string, MyError>'",
  },
  [Code.FieldMissing]: {
    text: "field '{word}' is missing; type '{first}' requires it",
  },
  [Code.UndefinedField]: {
    text: "cannot infer the type of field '{word}' from 'undefined'; declare the type of the object, e.g. 'const o: { {word}?: int } = ...'",
  },
  [Code.RecordDefaulted]: {
    text: "'{word} = ...' gives a default value, which only a destructuring pattern has; in an object literal write '{word}: ...'",
  },
  [Code.RecordMethod]: {
    text: "a Record holds values, not methods; store a function, '{word}: (...) => ...'",
  },
  [Code.RecordNumberKey]: {
    text: "the keys of a Record are strings, and JavaScript would turn this '{first}' into one, so 1 and \"1\" would be one key; convert it, 'String(i)', or use a Map, whose keys may be numbers",
  },
  [Code.JsonSpread]: {
    text: "a spread is not supported in a Json literal; write the keys one by one",
  },
  [Code.JsonFunction]: {
    text: "a Json holds no functions",
  },
  [Code.JsonDefaulted]: {
    text: "'{word} = ...' belongs to a destructuring pattern; write '{word}: ...'",
  },
  [Code.JsonKey]: {
    text: "a key of a Json is a string, found '{first}'",
  },
  [Code.NullValue]: {
    text: "'null' is not supported: the only value for nothing is 'undefined'; write 'undefined' (null exists only in Json values)",
  },
};
