  [Code.InterfaceFieldLayout]: {
    text: "field '{word}' of '{first}' is '{second}', and '{other}' declares it as '{place}'; an interface can narrow a field of one it extends only to objects of a type down the chain of its type, such as 'Dog' for 'Animal', which lie in memory as they do",
  },
  [Code.CallbackMissing]: {
    text: "'{word}' needs a function",
