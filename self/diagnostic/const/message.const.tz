  [Code.InstanceOfNotClass]: {
    text: "the right side of 'instanceof' must be a class",
  },
  [Code.InstanceOfNeverUnion]: {
    text: "a '{first}' is never a '{word}': none of its members is or extends it, so this is always false",
  },
  [Code.DuplicateMember]: {
    text: "duplicate member '{word}' in class '{first}'",
  },
  [Code.FieldMethodClash]: {
    text: "duplicate member '{word}' in class '{first}': a field and a method cannot share a name",
