  [Code.CallbackParamType]: {
    text: "{word} takes '{first}' as its {second} argument, but '{other}' passes '{place}'",
  },
  [Code.CallbackExtraParam]: {
    text: "{word} would also get the {other} in its optional parameter{first}: '{second}' calls it with {place}; pass an arrow that gives it only what it needs",
