import { kTokenTable } from "../load/token/const/token.const.tz";
import { Code } from "./code.tz";
import { Details } from "./types/message.types.tz";
import { kMessages } from "./const/message.const.tz";

export function messageText(code: Code, details: Details): string {
  const message = kMessages[code];
  let text = message.text;
  const expected = details.expected;
  if (expected != undefined) {
    const spelling = kTokenTable.spelling(expected);

    text = text.replaceAll("{expected}", spelling);
  }

  const found = details.found;
  if (found != undefined) {
    const spelling = kTokenTable.spelling(found);

    text = text.replaceAll("{found}", spelling);
  }

  const word = details.word;
  if (word != undefined) {
    text = text.replaceAll("{word}", word);
  }

  const other = details.other;
  if (other != undefined) {
    text = text.replaceAll("{other}", other);
  }

  const path = details.path;
  if (path != undefined) {
    text = text.replaceAll("{path}", path);
  }

  const first = details.first;
  if (first != undefined) {
    text = text.replaceAll("{first}", first);
  }

  const second = details.second;
  if (second != undefined) {
    text = text.replaceAll("{second}", second);
  }

  return text;
}
