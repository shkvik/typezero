import { Dumper } from "../ast-dump.tz";
import {
  FunctionDecl,
  Param,
  ParamKind,
  ParamProperty,
} from "../../../../program/ast/types/ast.types.functions.tz";
import {
  ClassDecl,
  ClassField,
  Decorator,
} from "../../../../program/ast/types/ast.types.classes.tz";
import {
  TypeParamDecl,
} from "../../../../program/ast/types/ast.types.types.tz";

partial class Dumper {
  private readonly role(declaration: FunctionDecl): string {
    const member = declaration.role;
    if (member == undefined) {
      return "plain";
    }

    const isOverride = this.flag(member.isOverride);

    return (
      `member ${member.access} ${isOverride} ${member.method} ` +
      `${this.tree.decoratorsOf(member.decoratorsList).length}`
    );
  }

  private dumpFunction(declaration: FunctionDecl): void {
    const name = this.quote(declaration.name);
    const isArrow = this.flag(declaration.isArrow);
    const concise = this.flag(declaration.concise);
    const ownName = this.quote(declaration.ownName);
    const isGenerator = this.flag(declaration.isGenerator);
    const isAsync = this.flag(declaration.isAsync);
    const role = this.role(declaration);
    const source = this.span(declaration.source);

    this.line(
      `Function ${declaration.loc} ${name} arrow=${isArrow} concise=${concise} ` +
        `own=${ownName} place=${declaration.place} body=${declaration.bodySource} ` +
        `gen=${isGenerator} async=${isAsync} role=${role} src=${source} ` +
        `tp=${this.tree.typeParamsOf(declaration.typeParamsList).length} params=${this.tree.paramsOf(declaration.paramsList).length}`,
    );
    this.nested();
    const member = declaration.role;
    if (member != undefined) {
      const decorators = this.tree.decoratorsOf(member.decoratorsList);

      this.dumpDecorators(decorators);
    }

    const typeParams = this.tree.typeParamsOf(declaration.typeParamsList);

    this.dumpTypeParams(typeParams);

    for (const param of this.tree.paramsOf(declaration.paramsList)) {
      this.dumpParam(param);
    }

    const returnType = this.tree.typeRefAt(declaration.returnTypeId);

    this.dumpOptionalType(returnType);
    const bodyBlock = this.tree.blockAt(declaration.bodyId);

    this.dumpOptionalStmt(bodyBlock);
    this.back();
  }

  private dumpParam(param: Param): void {
    const prop = this.propertyText(param.property);

    const name = this.quote(param.name);
    const pattern = this.span(param.pattern);

    this.line(
      `Param ${param.loc} ${name} form=${param.form.kind} ` +
        `prop=${prop} pattern=${pattern} dec=${this.tree.decoratorsOf(param.decoratorsList).length}`,
    );
    this.nested();
    const decorators = this.tree.decoratorsOf(param.decoratorsList);

    this.dumpDecorators(decorators);
    const typeRef = this.tree.typeRefAt(param.typeId);

    this.dumpOptionalType(typeRef);
    const form = param.form;
    if (form.kind == ParamKind.Defaulted) {
      const defaultValue = this.tree.exprOf(form.defaultValueId);

      this.dumpExpr(defaultValue);
    }

    this.back();
  }

  private dumpTypeParams(params: Read<TypeParamDecl[]>): void {
    for (const param of params) {
      const name = this.quote(param.name);

      this.line(`TypeParam ${param.loc} ${name}`);
      this.nested();
      const constraint = this.tree.typeRefAt(param.constraintId);

      this.dumpOptionalType(constraint);
      const defaultType = this.tree.typeRefAt(param.defaultTypeId);

      this.dumpOptionalType(defaultType);
      this.back();
    }
  }

  private dumpDecorators(decorators: Read<Decorator[]>): void {
    for (const decorator of decorators) {
      this.line(`Decorator ${decorator.loc}`);
      const expr = this.tree.exprOf(decorator.exprId);

      this.dumpChildren([expr]);
    }
  }

  private dumpClass(declaration: ClassDecl): void {
    const written = declaration.name ?? "";
    const name = this.quote(written);
    const isAbstract = this.flag(declaration.isAbstract);
    const isPartial = this.flag(declaration.isPartial);
    const expression = this.flag(declaration.expression);
    const generic = this.flag(
      this.tree.typeParamsOf(declaration.typeParamsList).length > 0,
    );
    const source = this.span(declaration.source);
    const hasBase = this.flag(
      this.tree.typeRefAt(declaration.baseId) != undefined,
    );
    const hasBaseExpr = this.flag(
      this.tree.exprAt(declaration.baseExprId) != undefined,
    );

    this.line(
      `Class ${declaration.loc} ${name} abstract=${isAbstract} partial=${isPartial} ` +
        `expr=${expression} generic=${generic} src=${source} ` +
        `tp=${this.tree.typeParamsOf(declaration.typeParamsList).length} base=${hasBase} ` +
        `baseExpr=${hasBaseExpr} baseArgs=${this.tree.typeRefsOf(declaration.baseArgsList).length} ` +
        `ifaces=${this.tree.typeRefsOf(declaration.interfacesList).length} dec=${this.tree.decoratorsOf(declaration.decoratorsList).length} ` +
        `fields=${this.tree.fieldsOf(declaration.fieldsList).length} methods=${this.tree.functionsOf(declaration.methodsList).length} ` +
        `ctors=${this.tree.functionsOf(declaration.constructorsList).length}`,
    );
    this.nested();
    const decorators = this.tree.decoratorsOf(declaration.decoratorsList);

    this.dumpDecorators(decorators);
    const typeParams = this.tree.typeParamsOf(declaration.typeParamsList);

    this.dumpTypeParams(typeParams);
    const base = this.tree.typeRefAt(declaration.baseId);
    if (base != undefined) {
      this.dumpType(base);
    }

    const baseExpr = this.tree.exprAt(declaration.baseExprId);
    if (baseExpr != undefined) {
      this.dumpExpr(baseExpr);
    }

    const baseArgsItem = this.tree.typeRefsOf(declaration.baseArgsList);

    this.dumpTypes(baseArgsItem);
    const interfaces = this.tree.typeRefsOf(declaration.interfacesList);

    this.dumpTypes(interfaces);

    for (const field of this.tree.fieldsOf(declaration.fieldsList)) {
      this.dumpField(field);
    }

    for (const method of this.tree.functionsOf(declaration.methodsList)) {
      this.dumpFunction(method);
    }

    for (const ctor of this.tree.functionsOf(declaration.constructorsList)) {
      this.dumpFunction(ctor);
    }

    this.back();
  }

  private dumpField(field: ClassField): void {
    const name = this.quote(field.name);
    const isReadonly = this.flag(field.readonly);
    const isOverride = this.flag(field.isOverride);
    const accessor = this.flag(field.accessor);

    this.line(
      `Field ${field.loc} ${name} form=${field.form} ` +
        `presence=${field.presence} ro=${isReadonly} ` +
        `override=${isOverride} access=${field.access} ` +
        `accessor=${accessor} dec=${this.tree.decoratorsOf(field.decoratorsList).length}`,
    );
    this.nested();
    const decorators = this.tree.decoratorsOf(field.decoratorsList);

    this.dumpDecorators(decorators);
    const typeRef = this.tree.typeRefAt(field.typeId);

    this.dumpOptionalType(typeRef);
    const init = this.tree.exprAt(field.initId);

    this.dumpOptionalExpr(init);
    this.back();
  }

  private readonly propertyText(property: ParamProperty | undefined): string {
    if (property == undefined) {
      return "-";
    }

    const isReadonly = this.flag(property.readonly);

    return `${isReadonly}${property.access}`;
  }
}
