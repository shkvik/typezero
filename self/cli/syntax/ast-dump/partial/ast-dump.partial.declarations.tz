import { Dumper } from "../ast-dump.tz";
import { TypeParamDecl } from "../../../../program/ast/types/ast.types.types.tz";
import {
  FunctionDecl,
  Param,
  ParamKind,
  ParamProperty,
} from "../../../../program/ast/types/ast.types.functions.tz";
import {
  ClassDecl,
  ClassField,
  Decorator,
} from "../../../../program/ast/types/ast.types.classes.tz";

partial class Dumper {
  private role(declaration: FunctionDecl): string {
    const member = declaration.role;
    if (member == undefined) {
      return "plain";
    }

    const isOverride = this.flag(member.isOverride);

    return (
      `member ${member.access} ${isOverride} ${member.method} ` +
      `${member.decorators.length}`
    );
  }

  private dumpFunction(declaration: FunctionDecl): void {
    const name = this.quote(declaration.name);
    const isArrow = this.flag(declaration.isArrow);
    const concise = this.flag(declaration.concise);
    const ownName = this.quote(declaration.ownName);
    const isGenerator = this.flag(declaration.isGenerator);
    const isAsync = this.flag(declaration.isAsync);
    const role = this.role(declaration);
    const source = this.span(declaration.source);

    this.line(
      `Function ${declaration.loc} ${name} arrow=${isArrow} concise=${concise} ` +
        `own=${ownName} place=${declaration.place} body=${declaration.bodySource} ` +
        `gen=${isGenerator} async=${isAsync} role=${role} src=${source} ` +
        `tp=${declaration.typeParams.length} params=${declaration.params.length}`,
    );
    this.nested();
    const member = declaration.role;
    if (member != undefined) {
      this.dumpDecorators(member.decorators);
    }

    this.dumpTypeParams(declaration.typeParams);

    for (const param of declaration.params) {
      this.dumpParam(param);
    }

    this.dumpOptionalType(declaration.returnType);
    this.dumpOptionalStmt(declaration.body);
    this.back();
  }

  private dumpParam(param: Param): void {
    const prop = this.propertyText(param.property);

    const name = this.quote(param.name);
    const pattern = this.span(param.pattern);

    this.line(
      `Param ${param.loc} ${name} form=${param.form.kind} ` +
        `prop=${prop} pattern=${pattern} dec=${param.decorators.length}`,
    );
    this.nested();
    this.dumpDecorators(param.decorators);
    this.dumpOptionalType(param.type);
    const form = param.form;
    if (form.kind == ParamKind.Defaulted) {
      this.dumpExpr(form.defaultValue);
    }

    this.back();
  }

  private dumpTypeParams(params: TypeParamDecl[]): void {
    for (const param of params) {
      const name = this.quote(param.name);

      this.line(`TypeParam ${param.loc} ${name}`);
      this.nested();
      this.dumpOptionalType(param.constraint);
      this.dumpOptionalType(param.defaultType);
      this.back();
    }
  }

  private dumpDecorators(decorators: Decorator[]): void {
    for (const decorator of decorators) {
      this.line(`Decorator ${decorator.loc}`);
      this.dumpChildren([decorator.expr]);
    }
  }

  private dumpClass(declaration: ClassDecl): void {
    const written = declaration.name ?? "";
    const name = this.quote(written);
    const isAbstract = this.flag(declaration.isAbstract);
    const isPartial = this.flag(declaration.isPartial);
    const expression = this.flag(declaration.expression);
    const generic = this.flag(declaration.typeParams.length > 0);
    const source = this.span(declaration.source);
    const hasBase = this.flag(declaration.base != undefined);
    const hasBaseExpr = this.flag(declaration.baseExpr != undefined);

    this.line(
      `Class ${declaration.loc} ${name} abstract=${isAbstract} partial=${isPartial} ` +
        `expr=${expression} generic=${generic} src=${source} ` +
        `tp=${declaration.typeParams.length} base=${hasBase} baseExpr=${hasBaseExpr} ` +
        `ifaces=${declaration.interfaces.length} dec=${declaration.decorators.length} ` +
        `fields=${declaration.fields.length} methods=${declaration.methods.length} ` +
        `ctors=${declaration.constructors.length}`,
    );
    this.nested();
    this.dumpDecorators(declaration.decorators);
    this.dumpTypeParams(declaration.typeParams);
    const base = declaration.base;
    if (base != undefined) {
      this.dumpType(base);
    }

    const baseExpr = declaration.baseExpr;
    if (baseExpr != undefined) {
      this.dumpExpr(baseExpr);
    }

    this.dumpTypes(declaration.interfaces);

    for (const field of declaration.fields) {
      this.dumpField(field);
    }

    for (const method of declaration.methods) {
      this.dumpFunction(method);
    }

    for (const ctor of declaration.constructors) {
      this.dumpFunction(ctor);
    }

    this.back();
  }

  private dumpField(field: ClassField): void {
    const name = this.quote(field.name);
    const isReadonly = this.flag(field.readonly);
    const isOverride = this.flag(field.isOverride);
    const accessor = this.flag(field.accessor);

    this.line(
      `Field ${field.loc} ${name} form=${field.form} ` +
        `presence=${field.presence} ro=${isReadonly} ` +
        `override=${isOverride} access=${field.access} ` +
        `accessor=${accessor} dec=${field.decorators.length}`,
    );
    this.nested();
    this.dumpDecorators(field.decorators);
    this.dumpOptionalType(field.type);
    this.dumpOptionalExpr(field.init);
    this.back();
  }

  private propertyText(property: ParamProperty | undefined): string {
    if (property == undefined) {
      return "-";
    }

    const isReadonly = this.flag(property.readonly);

    return `${isReadonly}${property.access}`;
  }
}
