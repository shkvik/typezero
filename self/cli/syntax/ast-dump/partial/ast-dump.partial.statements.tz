import { Dumper } from "../ast-dump.tz";
import {
  BindingKind,
  VarDeclarator,
} from "../../../../program/ast/types/ast.types.patterns.tz";
import {
  Stmt,
  StmtKind,
} from "../../../../program/ast/types/ast.types.statements.tz";
import { kNoLocation } from "../const/ast-dump.const.tz";

partial class Dumper {
  private dumpOptionalStmt(stmt: Stmt | undefined): void {
    if (stmt == undefined) {
      return this.missing();
    }

    this.dumpStmt(stmt);
  }

  private dumpStmts(stmts: Stmt[]): void {
    this.nested();

    for (const stmt of stmts) {
      this.dumpStmt(stmt);
    }

    this.back();
  }

  private dumpStmt(stmt: Stmt): void {
    const loc = stmt.loc;

    switch (stmt.kind) {
      case StmtKind.Block: {
        const end = stmt.end ?? kNoLocation;

        this.line(`Block ${loc} end=${end} n=${stmt.body.length}`);

        return this.dumpStmts(stmt.body);
      }
      case StmtKind.VarDecl: {
        const isConst = this.flag(stmt.isConst);
        const isUsing = this.flag(stmt.isUsing);

        this.line(
          `VarDecl ${loc} const=${isConst} using=${isUsing} n=${stmt.decls.length}`,
        );
        this.nested();

        for (const declarator of stmt.decls) {
          this.dumpDeclarator(declarator);
        }

        return this.back();
      }
      case StmtKind.Function:
        return this.dumpFunction(stmt);
      case StmtKind.Expr:
        this.line(`ExprStmt ${loc}`);
        return this.dumpChildren([stmt.expr]);
      case StmtKind.If:
        this.line(`If ${loc}`);
        this.nested();
        this.dumpExpr(stmt.cond);
        this.dumpStmt(stmt.thenStmt);
        this.dumpOptionalStmt(stmt.elseStmt);
        return this.back();
      case StmtKind.While:
        this.line(`While ${loc}`);
        this.nested();
        this.dumpExpr(stmt.cond);
        this.dumpStmt(stmt.body);
        return this.back();
      case StmtKind.DoWhile:
        this.line(`DoWhile ${loc}`);
        this.nested();
        this.dumpStmt(stmt.body);
        this.dumpExpr(stmt.cond);
        return this.back();
      case StmtKind.For:
        this.line(`For ${loc}`);
        this.nested();
        this.dumpOptionalStmt(stmt.init);
        this.dumpOptionalExpr(stmt.cond);
        this.dumpOptionalExpr(stmt.step);
        this.dumpOptionalStmt(stmt.body);
        return this.back();
      case StmtKind.ForOf: {
        const isConst = this.flag(stmt.isConst);
        const keys = this.flag(stmt.keys);
        const isAwait = this.flag(stmt.isAwait);

        this.line(
          `ForOf ${loc} const=${isConst} keys=${keys} await=${isAwait}`,
        );
        this.nested();
        this.dumpDeclarator(stmt.binding);
        this.dumpExpr(stmt.iterable);
        this.dumpStmt(stmt.body);

        return this.back();
      }
      case StmtKind.Switch:
        this.line(`Switch ${loc} n=${stmt.cases.length}`);
        this.nested();
        this.dumpExpr(stmt.discriminant);
        for (const switchCase of stmt.cases) {
          this.line(`Case ${switchCase.loc} n=${switchCase.body.length}`);
          this.nested();
          this.dumpOptionalExpr(switchCase.test);
          this.back();
          this.dumpStmts(switchCase.body);
        }
        return this.back();
      case StmtKind.Labeled: {
        const label = this.quote(stmt.label);

        this.line(`Labeled ${loc} ${label}`);

        return this.dumpStmts([stmt.body]);
      }
      case StmtKind.Return:
        this.line(`Return ${loc}`);
        this.nested();
        this.dumpOptionalExpr(stmt.value);
        return this.back();
      case StmtKind.Break: {
        const label = this.quote(stmt.label);

        return this.line(`Break ${loc} ${label}`);
      }
      case StmtKind.Continue: {
        const label = this.quote(stmt.label);

        return this.line(`Continue ${loc} ${label}`);
      }
      case StmtKind.Empty:
        return this.line(`Empty ${loc}`);
      case StmtKind.Debugger:
        return this.line(`Debugger ${loc}`);
      case StmtKind.TypeAlias: {
        const name = this.quote(stmt.name);
        const isHandle = this.flag(stmt.isHandle);

        this.line(
          `TypeAlias ${loc} ${name} handle=${isHandle} ` +
            `tp=${stmt.typeParams.length} bases=${stmt.bases.length}`,
        );
        this.nested();
        this.dumpTypeParams(stmt.typeParams);
        this.dumpType(stmt.type);
        this.dumpTypes(stmt.bases);

        return this.back();
      }
      case StmtKind.Enum: {
        const name = this.quote(stmt.name);

        this.line(`Enum ${loc} ${name} n=${stmt.members.length}`);
        this.nested();

        for (const member of stmt.members) {
          const memberName = this.quote(member.name);

          this.line(`EnumMember ${member.loc} ${memberName}`);
          this.nested();
          this.dumpOptionalExpr(member.init);
          this.back();
        }

        return this.back();
      }
      case StmtKind.Class:
        return this.dumpClass(stmt);
    }
  }

  private dumpDeclarator(declarator: VarDeclarator): void {
    const form = declarator.form;
    let shape = "form=plain";

    if (form.kind == BindingKind.Object) {
      shape = "form=object";
    } else if (form.kind == BindingKind.Array) {
      const rest = this.flag(form.rest);

      shape = `form=array ${form.length} ${rest}`;
    }

    const name = this.quote(declarator.name);

    this.line(`Declarator ${declarator.loc} ${name} ${shape}`);
    this.nested();
    this.dumpOptionalType(declarator.typeAnn);
    this.dumpOptionalExpr(declarator.init);
    this.back();
  }
}
