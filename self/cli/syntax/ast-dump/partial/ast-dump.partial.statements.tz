import { Dumper } from "../ast-dump.tz";
import {
  BindingForm,
  BindingKind,
  VarDeclarator,
} from "../../../../program/ast/types/ast.types.patterns.tz";
import {
  Stmt,
  StmtKind,
} from "../../../../program/ast/types/ast.types.statements.tz";
import { kNoLocation } from "../const/ast-dump.const.tz";

partial class Dumper {
  private dumpOptionalStmt(stmt: Stmt | undefined): void {
    if (stmt == undefined) {
      return this.missing();
    }

    this.dumpStmt(stmt);
  }

  private dumpStmts(stmts: Read<Stmt[]>): void {
    this.nested();

    for (const stmt of stmts) {
      this.dumpStmt(stmt);
    }

    this.back();
  }

  private dumpStmt(stmt: Stmt): void {
    const loc = stmt.loc;

    switch (stmt.kind) {
      case StmtKind.Block: {
        const end = stmt.end ?? kNoLocation;

        this.line(
          `Block ${loc} end=${end} n=${this.tree.stmtsOf(stmt.bodyList).length}`,
        );

        const body = this.tree.stmtsOf(stmt.bodyList);

        return this.dumpStmts(body);
      }
      case StmtKind.VarDecl: {
        const isConst = this.flag(stmt.isConst);
        const isUsing = this.flag(stmt.isUsing);

        this.line(
          `VarDecl ${loc} const=${isConst} using=${isUsing} n=${this.tree.declaratorsOf(stmt.declsList).length}`,
        );
        this.nested();

        for (const declarator of this.tree.declaratorsOf(stmt.declsList)) {
          this.dumpDeclarator(declarator);
        }

        return this.back();
      }
      case StmtKind.Function:
        return this.dumpFunction(stmt);
      case StmtKind.Expr:
        this.line(`ExprStmt ${loc}`);
        const expr = this.tree.exprOf(stmt.exprId);

        return this.dumpChildren([expr]);
      case StmtKind.If:
        this.line(`If ${loc}`);
        this.nested();
        const cond = this.tree.exprOf(stmt.condId);

        this.dumpExpr(cond);
        const thenStmt = this.tree.stmtOf(stmt.thenStmtId);

        this.dumpStmt(thenStmt);
        const elseStmt = this.tree.stmtAt(stmt.elseStmtId);

        this.dumpOptionalStmt(elseStmt);
        return this.back();
      case StmtKind.While:
        this.line(`While ${loc}`);
        this.nested();
        const condExpr = this.tree.exprOf(stmt.condId);

        this.dumpExpr(condExpr);
        const bodyStmt = this.tree.stmtOf(stmt.bodyId);

        this.dumpStmt(bodyStmt);
        return this.back();
      case StmtKind.DoWhile:
        this.line(`DoWhile ${loc}`);
        this.nested();
        const stmtBody = this.tree.stmtOf(stmt.bodyId);

        this.dumpStmt(stmtBody);
        const stmtCond = this.tree.exprOf(stmt.condId);

        this.dumpExpr(stmtCond);
        return this.back();
      case StmtKind.For:
        this.line(`For ${loc}`);
        this.nested();
        const init = this.tree.stmtAt(stmt.initId);

        this.dumpOptionalStmt(init);
        this.dumpOptionalExpr(this.tree.exprAt(stmt.condId));
        const step = this.tree.exprAt(stmt.stepId);

        this.dumpOptionalExpr(step);
        this.dumpOptionalStmt(this.tree.stmtAt(stmt.bodyId));
        return this.back();
      case StmtKind.ForOf: {
        const isConst = this.flag(stmt.isConst);
        const isUsing = this.flag(stmt.isUsing);
        const keys = this.flag(stmt.keys);
        const isAwait = this.flag(stmt.isAwait);
        const words = `const=${isConst} using=${isUsing}`;

        this.line(`ForOf ${loc} ${words} keys=${keys} await=${isAwait}`);
        this.nested();
        this.dumpDeclarator(stmt.binding);
        const iterable = this.tree.exprOf(stmt.iterableId);

        this.dumpExpr(iterable);
        this.dumpStmt(this.tree.stmtOf(stmt.bodyId));

        return this.back();
      }
      case StmtKind.Switch:
        this.line(
          `Switch ${loc} n=${this.tree.casesOf(stmt.casesList).length}`,
        );
        this.nested();
        const discriminant = this.tree.exprOf(stmt.discriminantId);

        this.dumpExpr(discriminant);
        for (const switchCase of this.tree.casesOf(stmt.casesList)) {
          this.line(
            `Case ${switchCase.loc} n=${this.tree.stmtsOf(switchCase.bodyList).length}`,
          );
          this.nested();
          const test = this.tree.exprAt(switchCase.testId);

          this.dumpOptionalExpr(test);
          this.back();
          const bodyItem = this.tree.stmtsOf(switchCase.bodyList);

          this.dumpStmts(bodyItem);
        }
        return this.back();
      case StmtKind.Labeled: {
        const label = this.quote(stmt.label);

        this.line(`Labeled ${loc} ${label}`);

        return this.dumpStmts([this.tree.stmtOf(stmt.bodyId)]);
      }
      case StmtKind.Return:
        this.line(`Return ${loc}`);
        this.nested();
        const value = this.tree.exprAt(stmt.valueId);

        this.dumpOptionalExpr(value);
        return this.back();
      case StmtKind.Break: {
        const label = this.quote(stmt.label);

        return this.line(`Break ${loc} ${label}`);
      }
      case StmtKind.Continue: {
        const label = this.quote(stmt.label);

        return this.line(`Continue ${loc} ${label}`);
      }
      case StmtKind.Empty:
        return this.line(`Empty ${loc}`);
      case StmtKind.Debugger:
        return this.line(`Debugger ${loc}`);
      case StmtKind.TypeAlias: {
        const name = this.quote(stmt.name);

        this.line(
          `TypeAlias ${loc} ${name} ` +
            `tp=${this.tree.typeParamsOf(stmt.typeParamsList).length} bases=${this.tree.typeRefsOf(stmt.basesList).length}`,
        );
        this.nested();
        const typeParams = this.tree.typeParamsOf(stmt.typeParamsList);

        this.dumpTypeParams(typeParams);
        const typeRef = this.tree.typeRefOf(stmt.typeId);

        this.dumpType(typeRef);
        const basesItem = this.tree.typeRefsOf(stmt.basesList);

        this.dumpTypes(basesItem);

        return this.back();
      }
      case StmtKind.Handle: {
        const name = this.quote(stmt.name);

        return this.line(`Handle ${loc} ${name}`);
      }
      case StmtKind.Enum: {
        const name = this.quote(stmt.name);

        this.line(
          `Enum ${loc} ${name} n=${this.tree.enumMembersOf(stmt.membersList).length}`,
        );
        this.nested();

        for (const member of this.tree.enumMembersOf(stmt.membersList)) {
          const memberName = this.quote(member.name);

          this.line(`EnumMember ${member.loc} ${memberName}`);
          this.nested();
          const initExpr = this.tree.exprAt(member.initId);

          this.dumpOptionalExpr(initExpr);
          this.back();
        }

        return this.back();
      }
      case StmtKind.Class:
        return this.dumpClass(stmt);
    }
  }

  private dumpDeclarator(declarator: VarDeclarator): void {
    const shape = this.bindingShape(declarator.form);
    const name = this.quote(declarator.name);

    this.line(`Declarator ${declarator.loc} ${name} ${shape}`);
    this.nested();
    const typeAnn = this.tree.typeRefAt(declarator.typeAnnId);

    this.dumpOptionalType(typeAnn);
    const init = this.tree.exprAt(declarator.initId);

    this.dumpOptionalExpr(init);
    this.back();
  }

  private readonly bindingShape(form: BindingForm): string {
    switch (form.kind) {
      case BindingKind.Object:
        return "form=object";
      case BindingKind.Array: {
        const rest = this.flag(form.rest);

        return `form=array ${form.length} ${rest}`;
      }
      default:
        return "form=plain";
    }
  }
}
