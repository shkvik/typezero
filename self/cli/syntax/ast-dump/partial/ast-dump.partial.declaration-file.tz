import { Dumper } from "../ast-dump.tz";
import {
  DeclaredClass,
  DeclaredMember,
  DeclaredMemberForm,
  DeclaredMemberKind,
} from "../../../../program/ast/types/ast.types.declarations.tz";

partial class Dumper {
  private dumpDeclaredClass(declared: DeclaredClass): void {
    const name = this.quote(declared.name);
    const isAbstract = this.flag(declared.isAbstract);

    this.line(
      `DeclaredClass ${declared.loc} ${name} abstract=${isAbstract} ` +
        `tp=${this.tree.typeParamsOf(declared.typeParamsList).length} members=${this.tree.declaredMembersOf(declared.membersList).length}`,
    );
    this.nested();
    const typeParams = this.tree.typeParamsOf(declared.typeParamsList);

    this.dumpTypeParams(typeParams);

    for (const member of this.tree.declaredMembersOf(declared.membersList)) {
      this.dumpDeclaredMember(member);
    }

    this.back();
  }

  private dumpDeclaredMember(member: DeclaredMember): void {
    const name = this.quote(member.name);
    const accessWritten = this.flag(member.accessWritten);
    const isStatic = this.flag(member.isStatic);
    const form = this.declaredFormText(member.form);

    this.line(
      `Declared ${member.loc} ${name} access=${member.access} ` +
        `written=${accessWritten} static=${isStatic} ${form}`,
    );
    this.nested();
    this.dumpDeclaredSignature(member.form);
    const typeRef = this.tree.typeRefAt(member.typeId);

    this.dumpOptionalType(typeRef);
    this.back();
  }

  private readonly declaredFormText(form: Read<DeclaredMemberForm>): string {
    if (form.kind == DeclaredMemberKind.Field) {
      const isReadonly = this.flag(form.readonly);
      const optional = this.flag(form.optional);

      return `field ro=${isReadonly} optional=${optional}`;
    }

    const word = this.signatureWord(form.kind);

    return `${word} tp=${this.tree.typeParamsOf(form.typeParamsList).length} params=${this.tree.paramsOf(form.paramsList).length}`;
  }

  private readonly signatureWord(kind: DeclaredMemberKind): string {
    if (kind == DeclaredMemberKind.Constructor) {
      return "constructor";
    }

    return "method";
  }

  private dumpDeclaredSignature(form: Read<DeclaredMemberForm>): void {
    if (form.kind == DeclaredMemberKind.Field) {
      return;
    }

    const typeParams = this.tree.typeParamsOf(form.typeParamsList);

    this.dumpTypeParams(typeParams);

    for (const param of this.tree.paramsOf(form.paramsList)) {
      this.dumpParam(param);
    }
  }
}
