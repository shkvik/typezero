import { Dumper } from "../ast-dump.tz";
import {
  BinaryOp,
  CallArgument,
  Expr,
  ExprKind,
  NewExpr,
  NewKind,
  Property,
  PropertyKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { Quoting } from "../types/ast-dump.types.tz";

partial class Dumper {
  private dumpOptionalExpr(expr: Expr | undefined): void {
    if (expr == undefined) {
      return this.missing();
    }

    this.dumpExpr(expr);
  }

  private dumpChildren(exprs: Read<Expr[]>): void {
    this.nested();

    for (const expr of exprs) {
      this.dumpExpr(expr);
    }

    this.back();
  }

  private readonly propertyForm(prop: Property): string {
    const form = prop.form;

    switch (form.kind) {
      case PropertyKind.Value:
        return "Value";
      case PropertyKind.Method:
        return "Method";
      case PropertyKind.Defaulted:
        return "Defaulted";
      case PropertyKind.Computed:
        return "Computed";
      case PropertyKind.Spread: {
        const locs: string[] = [];

        for (const key of this.tree.indexExprsOf(form.omitKeysList)) {
          locs.push(`${key.loc}`);
        }

        const keys = locs.join(",");
        const omitItem = this.tree.textsOf(form.omitList);
        const omit = this.quoteAll(omitItem);

        return `Spread omit=${omit} keys=[${keys}]`;
      }
    }
  }

  private dumpExpr(expr: Expr): void {
    const loc = expr.loc;

    switch (expr.kind) {
      case ExprKind.IntLit: {
        const text = this.spanText(expr.text);
        const quoted = this.quote(text);

        return this.line(`IntLit ${loc} ${expr.value} ${quoted}`);
      }
      case ExprKind.FloatLit: {
        const bits = this.bits(expr.value);
        const text = this.spanText(expr.text);
        const quoted = this.quote(text);
        const beyond = this.flag(expr.beyondDouble);

        return this.line(`FloatLit ${loc} ${bits} ${quoted} beyond=${beyond}`);
      }
      case ExprKind.BoolLit: {
        const value = this.flag(expr.value);

        return this.line(`BoolLit ${loc} ${value}`);
      }
      case ExprKind.StringLit: {
        const value = this.quote(expr.value, Quoting.EscapeUnicode);

        return this.line(`StringLit ${loc} ${value}`);
      }
      case ExprKind.Undefined:
        return this.line(`Undefined ${loc}`);
      case ExprKind.RegexLit: {
        const pattern = this.quote(expr.pattern, Quoting.EscapeUnicode);
        const flags = this.quote(expr.flags, Quoting.EscapeUnicode);

        return this.line(
          `RegexLit ${loc} ${pattern} ${flags} written=${expr.written}`,
        );
      }
      case ExprKind.Template: {
        const parts: string[] = [];

        for (const quasi of this.tree.textsOf(expr.quasisList)) {
          const text = this.quote(quasi, Quoting.EscapeUnicode);

          parts.push(` ${text}`);
        }

        const quasis = parts.join("");

        this.line(
          `Template ${loc} n=${this.tree.textsOf(expr.quasisList).length}${quasis}`,
        );

        const exprs = this.tree.exprsOf(expr.exprsList);

        return this.dumpChildren(exprs);
      }
      case ExprKind.ArrayLit:
        this.line(
          `ArrayLit ${loc} n=${this.tree.elementsOf(expr.elementsList).length}`,
        );
        this.nested();
        for (const element of this.tree.elementsOf(expr.elementsList)) {
          const spread = this.flag(element.spread);
          const hole = this.flag(element.hole);

          this.line(`Element ${spread} ${hole}`);
          const exprExpr = this.tree.exprOf(element.exprId);

          this.dumpChildren([exprExpr]);
        }
        return this.back();
      case ExprKind.ObjectLit:
        this.line(
          `ObjectLit ${loc} n=${this.tree.propertiesOf(expr.propsList).length}`,
        );
        this.nested();
        for (const prop of this.tree.propertiesOf(expr.propsList)) {
          this.dumpProperty(prop);
        }
        return this.back();
      default:
        return this.dumpCompound(expr);
    }
  }

  private dumpProperty(prop: Property): void {
    const name = this.quote(prop.name);
    const formText = this.propertyForm(prop);

    this.line(`Property ${prop.loc} ${name} ${formText}`);
    this.nested();
    const form = prop.form;
    if (form.kind == PropertyKind.Computed) {
      const key = this.tree.exprOf(form.keyId);

      this.dumpExpr(key);
    }

    const value = this.tree.exprOf(prop.valueId);

    this.dumpExpr(value);
    this.back();
  }

  private dumpCompound(expr: Expr): void {
    const loc = expr.loc;

    switch (expr.kind) {
      case ExprKind.Name: {
        const name = this.quote(expr.name);

        this.line(
          `Name ${loc} ${name} targs=${this.tree.typeRefsOf(expr.typeArgsList).length}`,
        );
        this.nested();
        const typeArgs = this.tree.typeRefsOf(expr.typeArgsList);

        this.dumpTypes(typeArgs);

        return this.back();
      }
      case ExprKind.Member: {
        const name = this.quote(expr.name);
        const optional = this.flag(expr.optional);

        this.line(
          `Member ${loc} ${name} opt=${optional} targs=${this.tree.typeRefsOf(expr.typeArgsList).length}`,
        );
        this.nested();
        const object = this.tree.exprOf(expr.objectId);

        this.dumpExpr(object);
        const typeArgsItem = this.tree.typeRefsOf(expr.typeArgsList);

        this.dumpTypes(typeArgsItem);

        return this.back();
      }
      case ExprKind.Index: {
        const optional = this.flag(expr.optional);

        this.line(`Index ${loc} opt=${optional}`);

        return this.dumpChildren([
          this.tree.exprOf(expr.objectId),
          this.tree.exprOf(expr.indexId),
        ]);
      }
      case ExprKind.Unary:
        this.line(`Unary ${loc} ${expr.op}`);
        const operand = this.tree.exprOf(expr.operandId);

        return this.dumpChildren([operand]);
      case ExprKind.Binary: {
        const source = this.span(expr.source);

        this.line(`Binary ${loc} ${expr.op} src=${source}`);

        return this.dumpChildren([
          this.tree.exprOf(expr.lhsId),
          this.tree.exprOf(expr.rhsId),
        ]);
      }
      case ExprKind.Assign: {
        const opText = this.operatorText(expr.op);
        const source = this.span(expr.source);

        this.line(`Assign ${loc} ${opText} src=${source}`);

        return this.dumpChildren([
          this.tree.exprOf(expr.targetId),
          this.tree.exprOf(expr.valueId),
        ]);
      }
      case ExprKind.Update: {
        const increment = this.flag(expr.increment);
        const prefix = this.flag(expr.prefix);

        this.line(`Update ${loc} inc=${increment} prefix=${prefix}`);

        const target = this.tree.exprOf(expr.targetId);

        return this.dumpChildren([target]);
      }
      case ExprKind.Conditional:
        this.line(`Conditional ${loc}`);
        return this.dumpChildren([
          this.tree.exprOf(expr.condId),
          this.tree.exprOf(expr.thenExprId),
          this.tree.exprOf(expr.elseExprId),
        ]);
      case ExprKind.Cast:
        this.line(`Cast ${loc}`);
        this.nested();
        const operandExpr = this.tree.exprOf(expr.operandId);

        this.dumpExpr(operandExpr);
        const targetRef = this.tree.typeRefOf(expr.targetId);

        this.dumpType(targetRef);
        return this.back();
      case ExprKind.Sequence:
        this.line(
          `Sequence ${loc} n=${this.tree.exprsOf(expr.exprsList).length}`,
        );
        const exprs = this.tree.exprsOf(expr.exprsList);

        return this.dumpChildren(exprs);
      default:
        return this.dumpCall(expr);
    }
  }

  private dumpNew(expr: NewExpr): void {
    const form = expr.form;
    const counts = `targs=${this.tree.typeRefsOf(expr.typeArgsList).length} n=${this.tree.argumentsOf(expr.argsList).length}`;
    const args = this.tree.argumentsOf(expr.argsList);
    const spread = this.spreadFlags(args);

    if (form.kind == NewKind.Named) {
      const name = this.quote(form.name);
      const memberText = form.member ?? "";
      const member = this.quote(memberText);
      const callee = this.flag(false);

      this.line(
        `New ${expr.loc} ${name} ${member} ${counts} callee=${callee} ` +
          `spread=${spread}`,
      );
      this.nested();
    } else {
      const empty = this.quote("");
      const callee = this.flag(true);

      this.line(
        `New ${expr.loc} ${empty} ${empty} ${counts} callee=${callee} ` +
          `spread=${spread}`,
      );
      this.nested();
      const calleeExpr = this.tree.exprOf(form.calleeId);

      this.dumpExpr(calleeExpr);
    }

    const typeArgs = this.tree.typeRefsOf(expr.typeArgsList);

    this.dumpTypes(typeArgs);

    for (const argument of this.tree.argumentsOf(expr.argsList)) {
      const exprExpr = this.tree.exprOf(argument.exprId);

      this.dumpExpr(exprExpr);
    }

    this.back();
  }

  private readonly spreadFlags(args: Read<CallArgument[]>): string {
    const spreads = args.map((argument) => argument.spread);
    if (!spreads.includes(true)) {
      return "-";
    }

    return this.flags(spreads);
  }

  private dumpCall(expr: Expr): void {
    const loc = expr.loc;

    switch (expr.kind) {
      case ExprKind.Call: {
        const optional = this.flag(expr.optional);
        const tagged = this.flag(expr.tagged);
        const args = this.tree.argumentsOf(expr.argsList);
        const spread = this.spreadFlags(args);
        const values = this.tree
          .argumentsOf(expr.argsList)
          .map((argument) => this.tree.exprOf(argument.exprId));

        this.line(
          `Call ${loc} opt=${optional} tagged=${tagged} ` +
            `n=${this.tree.argumentsOf(expr.argsList).length} spread=${spread}`,
        );
        const children = [this.tree.exprOf(expr.calleeId)].concat(values);

        return this.dumpChildren(children);
      }
      case ExprKind.New:
        return this.dumpNew(expr);
      case ExprKind.OptionalChain:
        this.line(`OptionalChain ${loc}`);
        const chain = this.tree.exprOf(expr.chainId);

        return this.dumpChildren([chain]);
      case ExprKind.Function:
        this.line(`FunctionExpr ${loc}`);
        this.nested();
        const fn = this.tree.functionOf(expr.fnId);

        this.dumpFunction(fn);
        return this.back();
      case ExprKind.Yield: {
        const delegate = this.flag(expr.delegate);

        this.line(`Yield ${loc} delegate=${delegate}`);
        this.nested();
        const value = this.tree.exprAt(expr.valueId);

        this.dumpOptionalExpr(value);

        return this.back();
      }
      case ExprKind.Await:
        this.line(`Await ${loc}`);
        const valueExpr = this.tree.exprOf(expr.valueId);

        return this.dumpChildren([valueExpr]);
      case ExprKind.Class:
        this.line(`ClassExpr ${loc}`);
        this.nested();
        const decl = this.tree.classOf(expr.declId);

        this.dumpClass(decl);
        return this.back();
      default:
        return this.line(`Unknown ${loc}`);
    }
  }

  private readonly operatorText(op: BinaryOp | undefined): string {
    if (op == undefined) {
      return "-";
    }

    return `${op}`;
  }
}
