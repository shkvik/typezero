import { Dumper } from "../ast-dump.tz";
import {
  Expr,
  ExprKind,
  NewExpr,
  NewKind,
  Property,
  PropertyKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { Quoting } from "../types/ast-dump.types.tz";

partial class Dumper {
  private dumpOptionalExpr(expr: Expr | undefined): void {
    if (expr == undefined) {
      return this.missing();
    }

    this.dumpExpr(expr);
  }

  private dumpChildren(exprs: Expr[]): void {
    this.nested();

    for (const expr of exprs) {
      this.dumpExpr(expr);
    }

    this.back();
  }

  private propertyForm(prop: Property): string {
    const form = prop.form;

    switch (form.kind) {
      case PropertyKind.Value:
        return "Value";
      case PropertyKind.Method:
        return "Method";
      case PropertyKind.Defaulted:
        return "Defaulted";
      case PropertyKind.Computed:
        return "Computed";
      case PropertyKind.Spread: {
        const locs: string[] = [];

        for (const key of form.omitKeys) {
          locs.push(`${key.loc}`);
        }

        const keys = locs.join(",");
        const omit = this.quoteAll(form.omit);

        return `Spread omit=${omit} keys=[${keys}]`;
      }
    }
  }

  private dumpExpr(expr: Expr): void {
    const loc = expr.loc;

    switch (expr.kind) {
      case ExprKind.IntLit: {
        const text = this.spanText(expr.text);
        const quoted = this.quote(text);

        return this.line(`IntLit ${loc} ${expr.value} ${quoted}`);
      }
      case ExprKind.FloatLit: {
        const bits = this.bits(expr.value);
        const text = this.spanText(expr.text);
        const quoted = this.quote(text);

        return this.line(`FloatLit ${loc} ${bits} ${quoted}`);
      }
      case ExprKind.BoolLit: {
        const value = this.flag(expr.value);

        return this.line(`BoolLit ${loc} ${value}`);
      }
      case ExprKind.StringLit: {
        const value = this.quote(expr.value, Quoting.EscapeUnicode);

        return this.line(`StringLit ${loc} ${value}`);
      }
      case ExprKind.Undefined:
        return this.line(`Undefined ${loc}`);
      case ExprKind.RegexLit: {
        const pattern = this.quote(expr.pattern, Quoting.EscapeUnicode);
        const flags = this.quote(expr.flags, Quoting.EscapeUnicode);

        return this.line(
          `RegexLit ${loc} ${pattern} ${flags} written=${expr.written}`,
        );
      }
      case ExprKind.Template: {
        const parts: string[] = [];

        for (const quasi of expr.quasis) {
          const text = this.quote(quasi, Quoting.EscapeUnicode);

          parts.push(` ${text}`);
        }

        const quasis = parts.join("");

        this.line(`Template ${loc} n=${expr.quasis.length}${quasis}`);

        return this.dumpChildren(expr.exprs);
      }
      case ExprKind.ArrayLit:
        this.line(`ArrayLit ${loc} n=${expr.elements.length}`);
        this.nested();
        for (const element of expr.elements) {
          const spread = this.flag(element.spread);
          const hole = this.flag(element.hole);

          this.line(`Element ${spread} ${hole}`);
          this.dumpChildren([element.expr]);
        }
        return this.back();
      case ExprKind.ObjectLit:
        this.line(`ObjectLit ${loc} n=${expr.props.length}`);
        this.nested();
        for (const prop of expr.props) {
          this.dumpProperty(prop);
        }
        return this.back();
      default:
        return this.dumpCompound(expr);
    }
  }

  private dumpProperty(prop: Property): void {
    const name = this.quote(prop.name);
    const formText = this.propertyForm(prop);

    this.line(`Property ${prop.loc} ${name} ${formText}`);
    this.nested();
    const form = prop.form;
    if (form.kind == PropertyKind.Computed) {
      this.dumpExpr(form.key);
    }

    this.dumpExpr(prop.value);
    this.back();
  }

  private dumpCompound(expr: Expr): void {
    const loc = expr.loc;

    switch (expr.kind) {
      case ExprKind.Name: {
        const name = this.quote(expr.name);

        this.line(`Name ${loc} ${name} targs=${expr.typeArgs.length}`);
        this.nested();
        this.dumpTypes(expr.typeArgs);

        return this.back();
      }
      case ExprKind.Member: {
        const name = this.quote(expr.name);
        const optional = this.flag(expr.optional);

        this.line(
          `Member ${loc} ${name} opt=${optional} targs=${expr.typeArgs.length}`,
        );
        this.nested();
        this.dumpExpr(expr.object);
        this.dumpTypes(expr.typeArgs);

        return this.back();
      }
      case ExprKind.Index: {
        const optional = this.flag(expr.optional);

        this.line(`Index ${loc} opt=${optional}`);

        return this.dumpChildren([expr.object, expr.index]);
      }
      case ExprKind.Unary:
        this.line(`Unary ${loc} ${expr.op}`);
        return this.dumpChildren([expr.operand]);
      case ExprKind.Binary: {
        const source = this.span(expr.source);

        this.line(`Binary ${loc} ${expr.op} src=${source}`);

        return this.dumpChildren([expr.lhs, expr.rhs]);
      }
      case ExprKind.Assign: {
        const op = expr.op;
        let opText = "-";

        if (op != undefined) {
          opText = `${op}`;
        }

        const source = this.span(expr.source);

        this.line(`Assign ${loc} ${opText} src=${source}`);

        return this.dumpChildren([expr.target, expr.value]);
      }
      case ExprKind.Update: {
        const increment = this.flag(expr.increment);
        const prefix = this.flag(expr.prefix);

        this.line(`Update ${loc} inc=${increment} prefix=${prefix}`);

        return this.dumpChildren([expr.target]);
      }
      case ExprKind.Conditional:
        this.line(`Conditional ${loc}`);
        return this.dumpChildren([expr.cond, expr.thenExpr, expr.elseExpr]);
      case ExprKind.Cast:
        this.line(`Cast ${loc}`);
        this.nested();
        this.dumpExpr(expr.operand);
        this.dumpType(expr.target);
        return this.back();
      case ExprKind.Sequence:
        this.line(`Sequence ${loc} n=${expr.exprs.length}`);
        return this.dumpChildren(expr.exprs);
      default:
        return this.dumpCall(expr);
    }
  }

  private dumpNew(expr: NewExpr): void {
    const form = expr.form;
    const counts = `targs=${expr.typeArgs.length} n=${expr.args.length}`;

    if (form.kind == NewKind.Named) {
      const name = this.quote(form.name);
      const memberText = form.member ?? "";
      const member = this.quote(memberText);
      const callee = this.flag(false);

      this.line(`New ${expr.loc} ${name} ${member} ${counts} callee=${callee}`);
      this.nested();
    } else {
      const empty = this.quote("");
      const callee = this.flag(true);

      this.line(`New ${expr.loc} ${empty} ${empty} ${counts} callee=${callee}`);
      this.nested();
      this.dumpExpr(form.callee);
    }

    this.dumpTypes(expr.typeArgs);

    for (const arg of expr.args) {
      this.dumpExpr(arg);
    }

    this.back();
  }

  private dumpCall(expr: Expr): void {
    const loc = expr.loc;

    switch (expr.kind) {
      case ExprKind.Call: {
        const optional = this.flag(expr.optional);
        const tagged = this.flag(expr.tagged);
        const spread = this.flags(expr.spread);

        this.line(
          `Call ${loc} opt=${optional} tagged=${tagged} ` +
            `n=${expr.args.length} spread=${spread}`,
        );
        const children = [expr.callee].concat(expr.args);

        return this.dumpChildren(children);
      }
      case ExprKind.New:
        return this.dumpNew(expr);
      case ExprKind.OptionalChain:
        this.line(`OptionalChain ${loc}`);
        return this.dumpChildren([expr.chain]);
      case ExprKind.Function:
        this.line(`FunctionExpr ${loc}`);
        this.nested();
        this.dumpFunction(expr.fn);
        return this.back();
      case ExprKind.Yield: {
        const delegate = this.flag(expr.delegate);

        this.line(`Yield ${loc} delegate=${delegate}`);
        this.nested();
        this.dumpOptionalExpr(expr.value);

        return this.back();
      }
      case ExprKind.Await:
        this.line(`Await ${loc}`);
        return this.dumpChildren([expr.value]);
      case ExprKind.Class:
        this.line(`ClassExpr ${loc}`);
        this.nested();
        this.dumpClass(expr.decl);
        return this.back();
      default:
        return this.line(`Unknown ${loc}`);
    }
  }
}
