import { Dumper } from "../ast-dump.tz";
import {
  FunctionTypeForm,
  ModifierChange,
  ObjectTypeField,
  TypeRefKind,
  TypeRef,
} from "../../../../program/ast/types/ast.types.types.tz";
import { Quoting } from "../types/ast-dump.types.tz";

partial class Dumper {
  private dumpOptionalType(ref: TypeRef | undefined): void {
    if (ref == undefined) {
      return this.missing();
    }

    this.dumpType(ref);
  }

  private dumpTypes(refs: TypeRef[]): void {
    for (const ref of refs) {
      this.dumpType(ref);
    }
  }

  private typeExtras(ref: TypeRef): string {
    const form = ref.form;

    switch (form.kind) {
      case TypeRefKind.Function: {
        const paramNames = form.params.map((param) => param.name);
        const optionalParams = form.params.map((param) => param.optional);
        const names = this.quoteAll(paramNames);
        const optional = this.flags(optionalParams);
        const rest = this.flag(form.rest);

        return ` names=${names} opt=${optional} rest=${rest}`;
      }
      case TypeRefKind.Object:
        return this.objectExtras(form.fields);
      case TypeRefKind.Tuple: {
        const readonlyElements = form.elements.map(() => form.readonly);
        const spreadElements = form.elements.map((element) => element.spread);
        const readonlyFlags = this.flags(readonlyElements);
        const spread = this.flags(spreadElements);

        return ` ro=${readonlyFlags} spread=${spread}`;
      }
      case TypeRefKind.Literal: {
        const text = this.quote(form.text, Quoting.EscapeUnicode);
        const numberBits = this.bits(form.number);
        const integer = this.flag(form.integer);
        const beyond = this.flag(form.beyondDouble);

        return (
          ` text=${text} number=${numberBits} int=${integer} ` +
          `beyond=${beyond}`
        );
      }
      case TypeRefKind.Predicate: {
        const isAsserts = this.flag(form.asserts);

        return ` asserts=${isAsserts}`;
      }
      case TypeRefKind.TypeOf: {
        const names = this.quoteAll(form.names);

        return ` names=${names}`;
      }
      case TypeRefKind.Mapped: {
        const optional = this.changeNumber(form.optionalChange);
        const readonlyChange = this.changeNumber(form.readonlyChange);

        return ` opt=${optional} ro=${readonlyChange}`;
      }
      case TypeRefKind.Template: {
        const parts: string[] = [];

        for (const text of form.texts) {
          const part = this.quote(text, Quoting.EscapeUnicode);

          parts.push(part);
        }

        const texts = parts.join(",");

        return ` texts=[${texts}]`;
      }
      default:
        return "";
    }
  }

  private objectExtras(fields: ObjectTypeField[]): string {
    const fieldNames = fields.map((field) => field.name);
    const fieldLocs = fields.map((field) => `${field.loc}`);
    const optionalFields = fields.map((field) => field.optional);
    const readonlyFields = fields.map((field) => field.readonly);
    const methodFields = fields.map((field) => field.method);
    const throughLastMethod = this.upToLastTrue(methodFields);
    const names = this.quoteAll(fieldNames);
    const locs = fieldLocs.join(",");
    const optional = this.flags(optionalFields);
    const readonlyFlags = this.flags(readonlyFields);
    const methods = this.flags(throughLastMethod);
    const generic = this.genericText(fields);
    const calls = this.callsText(fields);

    return (
      ` names=${names} locs=[${locs}] opt=${optional} ` +
      `ro=${readonlyFlags} methods=${methods}${generic}${calls}`
    );
  }

  private callsText(fields: ObjectTypeField[]): string {
    const callFields = fields.map((field) => field.call);
    if (!callFields.includes(true)) {
      return "";
    }

    const calls = this.flags(callFields);

    return ` calls=${calls}`;
  }

  private genericText(fields: ObjectTypeField[]): string {
    const counts = fields.map((field) => field.typeParams.length);
    if (!counts.some((count) => count > 0)) {
      return "";
    }

    return ` generic=${counts.join("")}`;
  }

  private innerTypes(ref: TypeRef): TypeRef[] {
    const form = ref.form;

    switch (form.kind) {
      case TypeRefKind.Object:
        return form.fields.map((field) => field.type);
      case TypeRefKind.Tuple:
        return form.elements.map((element) => element.type);
      case TypeRefKind.Function:
        return this.signatureTypes(form);
      default:
        return ref.args;
    }
  }

  private signatureTypes(form: FunctionTypeForm): TypeRef[] {
    const types = form.params.map((param) => param.type);
    const result = form.result;
    if (result != undefined) {
      types.push(result);
    }

    return types;
  }

  private dumpType(ref: TypeRef): void {
    const kind = this.typeRefKindName(ref.form.kind);
    const name = this.quote(ref.name);
    const source = this.span(ref.source);
    const extras = this.typeExtras(ref);
    const inner = this.innerTypes(ref);

    this.line(
      `Type ${ref.loc} ${kind} ${name} src=${source} ` +
        `n=${inner.length}${extras}`,
    );
    this.nested();
    this.dumpTypes(inner);
    this.back();
  }

  private upToLastTrue(flags: boolean[]): boolean[] {
    let end = flags.length;

    while (end > 0 && flags[end - 1] == false) {
      end -= 1;
    }

    return flags.slice(0, end);
  }

  private changeNumber(change: ModifierChange): int {
    switch (change) {
      case ModifierChange.Add:
        return 1;
      case ModifierChange.Remove:
        return -1;
      default:
        return 0;
    }
  }

  private typeRefKindName(kind: TypeRefKind): string {
    switch (kind) {
      case TypeRefKind.Name:
        return "Name";
      case TypeRefKind.Array:
        return "Array";
      case TypeRefKind.Union:
        return "Union";
      case TypeRefKind.Generic:
        return "Generic";
      case TypeRefKind.Function:
        return "Function";
      case TypeRefKind.Object:
        return "Object";
      case TypeRefKind.Tuple:
        return "Tuple";
      case TypeRefKind.Literal:
        return "Literal";
      case TypeRefKind.Predicate:
        return "Predicate";
      case TypeRefKind.KeyOf:
        return "KeyOf";
      case TypeRefKind.Indexed:
        return "Indexed";
      case TypeRefKind.TypeOf:
        return "TypeOf";
      case TypeRefKind.Mapped:
        return "Mapped";
      case TypeRefKind.Conditional:
        return "Conditional";
      case TypeRefKind.Infer:
        return "Infer";
      case TypeRefKind.Template:
        return "Template";
      case TypeRefKind.Invalid:
        return "Invalid";
      default:
        return "Intersection";
    }
  }
}
