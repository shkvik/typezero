import { Span } from "../../../program/ast/types/ast.types.span.tz";
import {
  ModifierChange,
  TypeKind,
  TypeParamDecl,
  TypeRef,
} from "../../../program/ast/types/ast.types.types.tz";
import {
  Expr,
  ExprKind,
  NewExpr,
  NewKind,
  Property,
  PropertyKind,
} from "../../../program/ast/types/ast.types.expressions.tz";
import {
  BindingKind,
  VarDeclarator,
} from "../../../program/ast/types/ast.types.patterns.tz";
import {
  Stmt,
  StmtKind,
} from "../../../program/ast/types/ast.types.statements.tz";
import {
  FunctionDecl,
  Param,
  ParamKind,
} from "../../../program/ast/types/ast.types.functions.tz";
import {
  ClassDecl,
  ClassField,
  Decorator,
} from "../../../program/ast/types/ast.types.classes.tz";
import {
  ModuleName,
  SourceFile,
} from "../../../program/ast/types/ast.types.modules.tz";
import { Quoting } from "./types/ast-dump.types.tz";
import {
  kBackslash,
  kDelete,
  kHex,
  kHigh,
  kNoLocation,
  kQuote,
  kSpace,
} from "./const/ast-dump.const.tz";

export class Dumper {
  private readonly source: Buffer;
  private readonly lines: string[];
  private readonly indents: string[];
  private depth: int;

  public constructor(source: Buffer) {
    this.source = source;
    this.lines = [];
    this.indents = [""];
    this.depth = 0;
  }

  public text(): string {
    return this.lines.join("\n");
  }

  public dumpFile(file: SourceFile): void {
    this.line(`items ${file.items.length}`);
    for (const item of file.items) {
      this.dumpStmt(item);
    }
    this.dumpModules(file);
    this.dumpTables(file);
  }

  private line(text: string): void {
    while (this.indents.length <= this.depth) {
      const last = this.indents[this.indents.length - 1] ?? "";
      this.indents.push(`${last}  `);
    }
    const indent = this.indents[this.depth] ?? "";
    this.lines.push(`${indent}${text}`);
  }

  private hex4(value: int): string {
    const digits: string[] = [];
    for (let shift = 12; shift >= 0; shift -= 4) {
      const digit = (value >> shift) & 15;
      const hex = kHex.charAt(digit);
      digits.push(hex);
    }

    return digits.join("");
  }

  private unicodeEscape(c: int): string {
    const hex = this.hex4(c);

    return `\\u${hex}`;
  }

  private needsEscape(c: int, quoting: Quoting): boolean {
    const control = c < kSpace || c == kDelete;
    const delimiter = c == kQuote || c == kBackslash;
    if (control || delimiter) {
      return true;
    }

    return quoting == Quoting.EscapeUnicode && c >= kHigh;
  }

  private quote(text: string, quoting: Quoting = Quoting.KeepUnicode): string {
    const parts: string[] = [];
    for (let i = 0; i < text.length; i++) {
      const c = text.charCodeAt(i);
      if (this.needsEscape(c, quoting)) {
        const escape = this.unicodeEscape(c);
        parts.push(escape);
        continue;
      }
      const character = text.charAt(i);
      parts.push(character);
    }
    const joined = parts.join("");

    return `"${joined}"`;
  }

  private bits(value: double): string {
    const buffer = Buffer.alloc(8);
    buffer.writeDoubleBE(value, 0);

    return buffer.toString("hex");
  }

  private flag(value: boolean): string {
    return value ? "1" : "0";
  }

  private flags(values: boolean[]): string {
    if (values.length == 0) {
      return "-";
    }
    const parts: string[] = [];
    for (const value of values) {
      const part = this.flag(value);
      parts.push(part);
    }

    return parts.join("");
  }

  private quoteAll(names: string[]): string {
    const parts: string[] = [];
    for (const name of names) {
      const part = this.quote(name);
      parts.push(part);
    }
    const joined = parts.join(",");

    return `[${joined}]`;
  }

  private span(text?: Span): string {
    if (text == undefined || text.end <= text.start) {
      return "-";
    }

    return `${text.start}-${text.end}`;
  }

  private spanText(text?: Span): string {
    if (text == undefined || text.end <= text.start) {
      return "";
    }

    return this.source.toString("utf8", text.start, text.end);
  }

  private missing(): void {
    this.line("-");
  }

  private nested(): void {
    this.depth += 1;
  }

  private back(): void {
    this.depth -= 1;
  }

  private dumpModules(file: SourceFile): void {
    this.line(`imports ${file.imports.length}`);
    for (const decl of file.imports) {
      const from = decl.from;
      const path = this.quote(from.path);
      const whole = decl.whole;
      const wholeName = this.quote(whole?.name ?? "");
      const wholeLoc = whole?.loc ?? kNoLocation;
      const wholeIsDefault = this.flag(whole?.isDefault ?? false);
      const isPartList = this.flag(decl.isPartList);
      this.line(
        `Import ${decl.loc} ${path} ${from.loc} ${wholeName} ${wholeLoc} ` +
          `${wholeIsDefault} ${isPartList} ${decl.names.length}`,
      );
      this.dumpModuleNames(decl.names);
    }
    this.line(`exports ${file.exports.length}`);
    for (const decl of file.exports) {
      const from = decl.from;
      const path = this.quote(from?.path ?? "");
      const pathLoc = from?.loc ?? kNoLocation;
      this.line(
        `Export ${decl.loc} ${decl.form} ${path} ${pathLoc} ${decl.names.length}`,
      );
      this.dumpModuleNames(decl.names);
    }
  }

  private dumpModuleNames(names: ModuleName[]): void {
    this.nested();
    for (const name of names) {
      const quotedName = this.quote(name.name);
      const quotedAs = this.quote(name.as);
      this.line(`Name ${quotedName} ${name.loc} ${quotedAs} ${name.asLoc}`);
    }
    this.back();
  }

  private dumpTables(file: SourceFile): void {
    const fields: string[] = [];
    for (const field of file.fieldNames) {
      fields.push(field);
    }
    fields.sort();
    const quotedFields: string[] = [];
    for (const field of fields) {
      const quoted = this.quote(field);
      quotedFields.push(` ${quoted}`);
    }
    const fieldList = quotedFields.join("");
    this.line(`fields ${fields.length}${fieldList}`);
    const keys: string[] = [];
    for (const key of file.stringConstants.keys()) {
      keys.push(key);
    }
    keys.sort();
    this.line(`constants ${keys.length}`);
    for (const key of keys) {
      const found = file.stringConstants.get(key);
      const values = found ?? [];
      const quotedValues: string[] = [];
      for (const value of values) {
        const quoted = this.quote(value);
        quotedValues.push(` ${quoted}`);
      }
      const valueList = quotedValues.join("");
      const quotedKey = this.quote(key);
      this.line(`  ${quotedKey} ${values.length}${valueList}`);
    }
  }

  private dumpOptionalStmt(stmt: Stmt | undefined): void {
    if (stmt == undefined) {
      return this.missing();
    }
    this.dumpStmt(stmt);
  }

  private dumpStmts(stmts: Stmt[]): void {
    this.nested();
    for (const stmt of stmts) {
      this.dumpStmt(stmt);
    }
    this.back();
  }

  private dumpStmt(stmt: Stmt): void {
    const loc = stmt.loc;
    switch (stmt.kind) {
      case StmtKind.Block: {
        const end = stmt.end ?? kNoLocation;
        this.line(`Block ${loc} end=${end} n=${stmt.body.length}`);
        return this.dumpStmts(stmt.body);
      }
      case StmtKind.VarDecl: {
        const isConst = this.flag(stmt.isConst);
        const isUsing = this.flag(stmt.isUsing);
        this.line(
          `VarDecl ${loc} const=${isConst} using=${isUsing} n=${stmt.decls.length}`,
        );
        this.nested();
        for (const d of stmt.decls) {
          this.dumpDeclarator(d);
        }
        return this.back();
      }
      case StmtKind.Function:
        return this.dumpFunction(stmt);
      case StmtKind.Expr:
        this.line(`ExprStmt ${loc}`);
        return this.dumpChildren([stmt.expr]);
      case StmtKind.If:
        this.line(`If ${loc}`);
        this.nested();
        this.dumpExpr(stmt.cond);
        this.dumpStmt(stmt.thenStmt);
        this.dumpOptionalStmt(stmt.elseStmt);
        return this.back();
      case StmtKind.While:
        this.line(`While ${loc}`);
        this.nested();
        this.dumpExpr(stmt.cond);
        this.dumpStmt(stmt.body);
        return this.back();
      case StmtKind.DoWhile:
        this.line(`DoWhile ${loc}`);
        this.nested();
        this.dumpStmt(stmt.body);
        this.dumpExpr(stmt.cond);
        return this.back();
      case StmtKind.For:
        this.line(`For ${loc}`);
        this.nested();
        this.dumpOptionalStmt(stmt.init);
        this.dumpOptionalExpr(stmt.cond);
        this.dumpOptionalExpr(stmt.step);
        this.dumpOptionalStmt(stmt.body);
        return this.back();
      case StmtKind.ForOf: {
        const isConst = this.flag(stmt.isConst);
        const keys = this.flag(stmt.keys);
        const isAwait = this.flag(stmt.isAwait);
        this.line(
          `ForOf ${loc} const=${isConst} keys=${keys} await=${isAwait}`,
        );
        this.nested();
        this.dumpDeclarator(stmt.binding);
        this.dumpExpr(stmt.iterable);
        this.dumpStmt(stmt.body);
        return this.back();
      }
      case StmtKind.Switch:
        this.line(`Switch ${loc} n=${stmt.cases.length}`);
        this.nested();
        this.dumpExpr(stmt.discriminant);
        for (const c of stmt.cases) {
          this.line(`Case ${c.loc} n=${c.body.length}`);
          this.nested();
          this.dumpOptionalExpr(c.test);
          this.back();
          this.dumpStmts(c.body);
        }
        return this.back();
      case StmtKind.Labeled: {
        const label = this.quote(stmt.label);
        this.line(`Labeled ${loc} ${label}`);
        return this.dumpStmts([stmt.body]);
      }
      case StmtKind.Return:
        this.line(`Return ${loc}`);
        this.nested();
        this.dumpOptionalExpr(stmt.value);
        return this.back();
      case StmtKind.Break: {
        const label = this.quote(stmt.label);
        return this.line(`Break ${loc} ${label}`);
      }
      case StmtKind.Continue: {
        const label = this.quote(stmt.label);
        return this.line(`Continue ${loc} ${label}`);
      }
      case StmtKind.Empty:
        return this.line(`Empty ${loc}`);
      case StmtKind.Debugger:
        return this.line(`Debugger ${loc}`);
      case StmtKind.TypeAlias: {
        const name = this.quote(stmt.name);
        const isHandle = this.flag(stmt.isHandle);
        this.line(
          `TypeAlias ${loc} ${name} handle=${isHandle} ` +
            `tp=${stmt.typeParams.length} bases=${stmt.bases.length}`,
        );
        this.nested();
        this.dumpTypeParams(stmt.typeParams);
        this.dumpType(stmt.type);
        this.dumpTypes(stmt.bases);
        return this.back();
      }
      case StmtKind.Enum: {
        const name = this.quote(stmt.name);
        this.line(`Enum ${loc} ${name} n=${stmt.members.length}`);
        this.nested();
        for (const member of stmt.members) {
          const memberName = this.quote(member.name);
          this.line(`EnumMember ${member.loc} ${memberName}`);
          this.nested();
          this.dumpOptionalExpr(member.init);
          this.back();
        }
        return this.back();
      }
      case StmtKind.Class:
        return this.dumpClass(stmt);
    }
  }

  private dumpDeclarator(d: VarDeclarator): void {
    const form = d.form;
    let shape = "form=plain";
    if (form.kind == BindingKind.Object) {
      shape = "form=object";
    } else if (form.kind == BindingKind.Array) {
      const rest = this.flag(form.rest);
      shape = `form=array ${form.length} ${rest}`;
    }
    const name = this.quote(d.name);
    this.line(`Declarator ${d.loc} ${name} ${shape}`);
    this.nested();
    this.dumpOptionalType(d.typeAnn);
    this.dumpOptionalExpr(d.init);
    this.back();
  }

  private role(fn: FunctionDecl): string {
    const member = fn.role;
    if (member == undefined) {
      return "plain";
    }
    const isOverride = this.flag(member.isOverride);

    return (
      `member ${member.access} ${isOverride} ${member.method} ` +
      `${member.decorators.length}`
    );
  }

  private dumpFunction(fn: FunctionDecl): void {
    const name = this.quote(fn.name);
    const isArrow = this.flag(fn.isArrow);
    const concise = this.flag(fn.concise);
    const ownName = this.quote(fn.ownName);
    const isGenerator = this.flag(fn.isGenerator);
    const isAsync = this.flag(fn.isAsync);
    const role = this.role(fn);
    const source = this.span(fn.source);
    this.line(
      `Function ${fn.loc} ${name} arrow=${isArrow} concise=${concise} ` +
        `own=${ownName} place=${fn.place} body=${fn.bodySource} ` +
        `gen=${isGenerator} async=${isAsync} role=${role} src=${source} ` +
        `tp=${fn.typeParams.length} params=${fn.params.length}`,
    );
    this.nested();
    const member = fn.role;
    if (member != undefined) {
      this.dumpDecorators(member.decorators);
    }
    this.dumpTypeParams(fn.typeParams);
    for (const param of fn.params) {
      this.dumpParam(param);
    }
    this.dumpOptionalType(fn.returnType);
    this.dumpOptionalStmt(fn.body);
    this.back();
  }

  private dumpParam(param: Param): void {
    const property = param.property;
    let prop = "-";
    if (property != undefined) {
      const isReadonly = this.flag(property.readonly);
      prop = `${isReadonly}${property.access}`;
    }
    const name = this.quote(param.name);
    const pattern = this.span(param.pattern);
    this.line(
      `Param ${param.loc} ${name} form=${param.form.kind} ` +
        `prop=${prop} pattern=${pattern} dec=${param.decorators.length}`,
    );
    this.nested();
    this.dumpDecorators(param.decorators);
    this.dumpOptionalType(param.type);
    const form = param.form;
    if (form.kind == ParamKind.Defaulted) {
      this.dumpExpr(form.defaultValue);
    }
    this.back();
  }

  private dumpTypeParams(params: TypeParamDecl[]): void {
    for (const param of params) {
      const name = this.quote(param.name);
      this.line(`TypeParam ${param.loc} ${name}`);
      this.nested();
      this.dumpOptionalType(param.constraint);
      this.dumpOptionalType(param.defaultType);
      this.back();
    }
  }

  private dumpDecorators(decorators: Decorator[]): void {
    for (const decorator of decorators) {
      this.line(`Decorator ${decorator.loc}`);
      this.dumpChildren([decorator.expr]);
    }
  }

  private dumpClass(cls: ClassDecl): void {
    const written = cls.name ?? "";
    const name = this.quote(written);
    const isAbstract = this.flag(cls.isAbstract);
    const isPartial = this.flag(cls.isPartial);
    const expression = this.flag(cls.expression);
    const generic = this.flag(cls.typeParams.length > 0);
    const source = this.span(cls.source);
    const hasBase = this.flag(cls.base != undefined);
    const hasBaseExpr = this.flag(cls.baseExpr != undefined);
    this.line(
      `Class ${cls.loc} ${name} abstract=${isAbstract} partial=${isPartial} ` +
        `expr=${expression} generic=${generic} src=${source} ` +
        `tp=${cls.typeParams.length} base=${hasBase} baseExpr=${hasBaseExpr} ` +
        `ifaces=${cls.interfaces.length} dec=${cls.decorators.length} ` +
        `fields=${cls.fields.length} methods=${cls.methods.length} ` +
        `ctors=${cls.constructors.length}`,
    );
    this.nested();
    this.dumpDecorators(cls.decorators);
    this.dumpTypeParams(cls.typeParams);
    const base = cls.base;
    if (base != undefined) {
      this.dumpType(base);
    }
    const baseExpr = cls.baseExpr;
    if (baseExpr != undefined) {
      this.dumpExpr(baseExpr);
    }
    this.dumpTypes(cls.interfaces);
    for (const field of cls.fields) {
      this.dumpField(field);
    }
    for (const method of cls.methods) {
      this.dumpFunction(method);
    }
    for (const ctor of cls.constructors) {
      this.dumpFunction(ctor);
    }
    this.back();
  }

  private dumpField(field: ClassField): void {
    const name = this.quote(field.name);
    const isReadonly = this.flag(field.readonly);
    const isOverride = this.flag(field.isOverride);
    const accessor = this.flag(field.accessor);
    this.line(
      `Field ${field.loc} ${name} form=${field.form} ` +
        `presence=${field.presence} ro=${isReadonly} ` +
        `override=${isOverride} access=${field.access} ` +
        `accessor=${accessor} dec=${field.decorators.length}`,
    );
    this.nested();
    this.dumpDecorators(field.decorators);
    this.dumpOptionalType(field.type);
    this.dumpOptionalExpr(field.init);
    this.back();
  }

  private dumpOptionalExpr(expr: Expr | undefined): void {
    if (expr == undefined) {
      return this.missing();
    }
    this.dumpExpr(expr);
  }

  private dumpChildren(exprs: Expr[]): void {
    this.nested();
    for (const expr of exprs) {
      this.dumpExpr(expr);
    }
    this.back();
  }

  private propertyForm(prop: Property): string {
    const form = prop.form;
    switch (form.kind) {
      case PropertyKind.Value:
        return "Value";
      case PropertyKind.Method:
        return "Method";
      case PropertyKind.Defaulted:
        return "Defaulted";
      case PropertyKind.Computed:
        return "Computed";
      case PropertyKind.Spread: {
        const locs: string[] = [];
        for (const key of form.omitKeys) {
          locs.push(`${key.loc}`);
        }
        const keys = locs.join(",");
        const omit = this.quoteAll(form.omit);
        return `Spread omit=${omit} keys=[${keys}]`;
      }
    }
  }

  private dumpExpr(expr: Expr): void {
    const loc = expr.loc;
    switch (expr.kind) {
      case ExprKind.IntLit: {
        const text = this.spanText(expr.text);
        const quoted = this.quote(text);
        return this.line(`IntLit ${loc} ${expr.value} ${quoted}`);
      }
      case ExprKind.FloatLit: {
        const bits = this.bits(expr.value);
        const text = this.spanText(expr.text);
        const quoted = this.quote(text);
        return this.line(`FloatLit ${loc} ${bits} ${quoted}`);
      }
      case ExprKind.BoolLit: {
        const value = this.flag(expr.value);
        return this.line(`BoolLit ${loc} ${value}`);
      }
      case ExprKind.StringLit: {
        const value = this.quote(expr.value, Quoting.EscapeUnicode);
        return this.line(`StringLit ${loc} ${value}`);
      }
      case ExprKind.Undefined:
        return this.line(`Undefined ${loc}`);
      case ExprKind.RegexLit: {
        const pattern = this.quote(expr.pattern, Quoting.EscapeUnicode);
        const flags = this.quote(expr.flags, Quoting.EscapeUnicode);
        return this.line(
          `RegexLit ${loc} ${pattern} ${flags} written=${expr.written}`,
        );
      }
      case ExprKind.Template: {
        const parts: string[] = [];
        for (const quasi of expr.quasis) {
          const text = this.quote(quasi, Quoting.EscapeUnicode);
          parts.push(` ${text}`);
        }
        const quasis = parts.join("");
        this.line(`Template ${loc} n=${expr.quasis.length}${quasis}`);
        return this.dumpChildren(expr.exprs);
      }
      case ExprKind.ArrayLit:
        this.line(`ArrayLit ${loc} n=${expr.elements.length}`);
        this.nested();
        for (const element of expr.elements) {
          const spread = this.flag(element.spread);
          const hole = this.flag(element.hole);
          this.line(`Element ${spread} ${hole}`);
          this.dumpChildren([element.expr]);
        }
        return this.back();
      case ExprKind.ObjectLit:
        this.line(`ObjectLit ${loc} n=${expr.props.length}`);
        this.nested();
        for (const prop of expr.props) {
          this.dumpProperty(prop);
        }
        return this.back();
      default:
        return this.dumpCompound(expr);
    }
  }

  private dumpProperty(prop: Property): void {
    const name = this.quote(prop.name);
    const formText = this.propertyForm(prop);
    this.line(`Property ${prop.loc} ${name} ${formText}`);
    this.nested();
    const form = prop.form;
    if (form.kind == PropertyKind.Computed) {
      this.dumpExpr(form.key);
    }
    this.dumpExpr(prop.value);
    this.back();
  }

  private dumpCompound(expr: Expr): void {
    const loc = expr.loc;
    switch (expr.kind) {
      case ExprKind.Name: {
        const name = this.quote(expr.name);
        this.line(`Name ${loc} ${name} targs=${expr.typeArgs.length}`);
        this.nested();
        this.dumpTypes(expr.typeArgs);
        return this.back();
      }
      case ExprKind.Member: {
        const name = this.quote(expr.name);
        const optional = this.flag(expr.optional);
        this.line(
          `Member ${loc} ${name} opt=${optional} targs=${expr.typeArgs.length}`,
        );
        this.nested();
        this.dumpExpr(expr.object);
        this.dumpTypes(expr.typeArgs);
        return this.back();
      }
      case ExprKind.Index: {
        const optional = this.flag(expr.optional);
        this.line(`Index ${loc} opt=${optional}`);
        return this.dumpChildren([expr.object, expr.index]);
      }
      case ExprKind.Unary:
        this.line(`Unary ${loc} ${expr.op}`);
        return this.dumpChildren([expr.operand]);
      case ExprKind.Binary: {
        const source = this.span(expr.source);
        this.line(`Binary ${loc} ${expr.op} src=${source}`);
        return this.dumpChildren([expr.lhs, expr.rhs]);
      }
      case ExprKind.Assign: {
        const op = expr.op;
        const opText = op == undefined ? "-" : `${op}`;
        const source = this.span(expr.source);
        this.line(`Assign ${loc} ${opText} src=${source}`);
        return this.dumpChildren([expr.target, expr.value]);
      }
      case ExprKind.Update: {
        const increment = this.flag(expr.increment);
        const prefix = this.flag(expr.prefix);
        this.line(`Update ${loc} inc=${increment} prefix=${prefix}`);
        return this.dumpChildren([expr.target]);
      }
      case ExprKind.Conditional:
        this.line(`Conditional ${loc}`);
        return this.dumpChildren([expr.cond, expr.thenExpr, expr.elseExpr]);
      case ExprKind.Cast:
        this.line(`Cast ${loc}`);
        this.nested();
        this.dumpExpr(expr.operand);
        this.dumpType(expr.target);
        return this.back();
      case ExprKind.Sequence:
        this.line(`Sequence ${loc} n=${expr.exprs.length}`);
        return this.dumpChildren(expr.exprs);
      default:
        return this.dumpCall(expr);
    }
  }

  private dumpNew(expr: NewExpr): void {
    const form = expr.form;
    const counts = `targs=${expr.typeArgs.length} n=${expr.args.length}`;
    if (form.kind == NewKind.Named) {
      const name = this.quote(form.name);
      const memberText = form.member ?? "";
      const member = this.quote(memberText);
      const callee = this.flag(false);
      this.line(`New ${expr.loc} ${name} ${member} ${counts} callee=${callee}`);
      this.nested();
    } else {
      const empty = this.quote("");
      const callee = this.flag(true);
      this.line(`New ${expr.loc} ${empty} ${empty} ${counts} callee=${callee}`);
      this.nested();
      this.dumpExpr(form.callee);
    }
    this.dumpTypes(expr.typeArgs);
    for (const arg of expr.args) {
      this.dumpExpr(arg);
    }
    this.back();
  }

  private dumpCall(expr: Expr): void {
    const loc = expr.loc;
    switch (expr.kind) {
      case ExprKind.Call: {
        const optional = this.flag(expr.optional);
        const tagged = this.flag(expr.tagged);
        const spread = this.flags(expr.spread);
        this.line(
          `Call ${loc} opt=${optional} tagged=${tagged} ` +
            `n=${expr.args.length} spread=${spread}`,
        );
        const children = [expr.callee].concat(expr.args);
        return this.dumpChildren(children);
      }
      case ExprKind.New:
        return this.dumpNew(expr);
      case ExprKind.OptionalChain:
        this.line(`OptionalChain ${loc}`);
        return this.dumpChildren([expr.chain]);
      case ExprKind.Function:
        this.line(`FunctionExpr ${loc}`);
        this.nested();
        this.dumpFunction(expr.fn);
        return this.back();
      case ExprKind.Yield: {
        const delegate = this.flag(expr.delegate);
        this.line(`Yield ${loc} delegate=${delegate}`);
        this.nested();
        this.dumpOptionalExpr(expr.value);
        return this.back();
      }
      case ExprKind.Await:
        this.line(`Await ${loc}`);
        return this.dumpChildren([expr.value]);
      case ExprKind.Class:
        this.line(`ClassExpr ${loc}`);
        this.nested();
        this.dumpClass(expr.decl);
        return this.back();
      default:
        return this.line(`Unknown ${loc}`);
    }
  }

  private dumpOptionalType(ref: TypeRef | undefined): void {
    if (ref == undefined) {
      return this.missing();
    }
    this.dumpType(ref);
  }

  private dumpTypes(refs: TypeRef[]): void {
    for (const ref of refs) {
      this.dumpType(ref);
    }
  }

  private typeExtras(ref: TypeRef): string {
    const form = ref.form;
    switch (form.kind) {
      case TypeKind.Function: {
        const names = this.quoteAll(form.names);
        const optional = this.flags(form.optional);
        const rest = this.flag(form.rest);
        return ` names=${names} opt=${optional} rest=${rest}`;
      }
      case TypeKind.Object: {
        const locTexts: string[] = [];
        for (const loc of form.locs) {
          locTexts.push(`${loc}`);
        }
        const locs = locTexts.join(",");
        const names = this.quoteAll(form.names);
        const optional = this.flags(form.optional);
        const readonlyFlags = this.flags(form.readonly);
        const throughLastMethod = this.upToLastTrue(form.methods);
        const methods = this.flags(throughLastMethod);
        return (
          ` names=${names} locs=[${locs}] opt=${optional} ` +
          `ro=${readonlyFlags} methods=${methods}`
        );
      }
      case TypeKind.Tuple: {
        const readonlyFlags = this.flags(form.readonly);
        const spread = this.flags(form.spread);
        return ` ro=${readonlyFlags} spread=${spread}`;
      }
      case TypeKind.Literal: {
        const text = this.quote(form.text, Quoting.EscapeUnicode);
        const numberBits = this.bits(form.number);
        const integer = this.flag(form.integer);
        return ` text=${text} number=${numberBits} int=${integer}`;
      }
      case TypeKind.Predicate: {
        const isAsserts = this.flag(form.asserts);
        return ` asserts=${isAsserts}`;
      }
      case TypeKind.TypeOf: {
        const names = this.quoteAll(form.names);
        return ` names=${names}`;
      }
      case TypeKind.Mapped: {
        const optional = this.changeNumber(form.optionalChange);
        const readonlyChange = this.changeNumber(form.readonlyChange);
        return ` opt=${optional} ro=${readonlyChange}`;
      }
      case TypeKind.Template: {
        const parts: string[] = [];
        for (const text of form.texts) {
          const part = this.quote(text, Quoting.EscapeUnicode);
          parts.push(part);
        }
        const texts = parts.join(",");
        return ` texts=[${texts}]`;
      }
      default:
        return "";
    }
  }

  private dumpType(ref: TypeRef): void {
    const kind = this.typeKindName(ref.form.kind);
    const name = this.quote(ref.name);
    const source = this.span(ref.source);
    const extras = this.typeExtras(ref);
    const loc = ref.loc ?? kNoLocation;
    this.line(
      `Type ${loc} ${kind} ${name} src=${source} ` +
        `n=${ref.args.length}${extras}`,
    );
    this.nested();
    this.dumpTypes(ref.args);
    this.back();
  }

  private upToLastTrue(flags: boolean[]): boolean[] {
    let end = flags.length;
    while (end > 0 && flags[end - 1] == false) {
      end -= 1;
    }

    return flags.slice(0, end);
  }

  private changeNumber(change: ModifierChange): int {
    switch (change) {
      case ModifierChange.Add:
        return 1;
      case ModifierChange.Remove:
        return -1;
      default:
        return 0;
    }
  }

  private typeKindName(kind: TypeKind): string {
    switch (kind) {
      case TypeKind.Name:
        return "Name";
      case TypeKind.Array:
        return "Array";
      case TypeKind.Union:
        return "Union";
      case TypeKind.Generic:
        return "Generic";
      case TypeKind.Function:
        return "Function";
      case TypeKind.Object:
        return "Object";
      case TypeKind.Tuple:
        return "Tuple";
      case TypeKind.Literal:
        return "Literal";
      case TypeKind.Predicate:
        return "Predicate";
      case TypeKind.KeyOf:
        return "KeyOf";
      case TypeKind.Indexed:
        return "Indexed";
      case TypeKind.TypeOf:
        return "TypeOf";
      case TypeKind.Mapped:
        return "Mapped";
      case TypeKind.Conditional:
        return "Conditional";
      case TypeKind.Infer:
        return "Infer";
      case TypeKind.Template:
        return "Template";
      default:
        return "Intersection";
    }
  }
}
