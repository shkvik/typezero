import "./partial/ast-dump.partial.statements.tz";
import "./partial/ast-dump.partial.declarations.tz";
import "./partial/ast-dump.partial.expressions.tz";
import "./partial/ast-dump.partial.types.tz";
import "./partial/ast-dump.partial.declaration-file.tz";
import { Span } from "../../../program/ast/types/ast.types.span.tz";
import {
  ExportDecl,
  ImportDecl,
  ModuleName,
  SourceFile,
} from "../../../program/ast/types/ast.types.modules.tz";
import { AstTree } from "../../../program/ast/ast-tree/ast-tree.tz";
import { Quoting } from "./types/ast-dump.types.tz";
import {
  kBackslash,
  kDelete,
  kHex,
  kHigh,
  kNoLocation,
  kQuote,
  kSpace,
} from "./const/ast-dump.const.tz";
import {
  DeclarationFile,
} from "../../../program/ast/types/ast.types.declarations.tz";

export class Dumper {
  private readonly source: Buffer;
  private readonly tree: AstTree;
  private readonly lines: string[];
  private readonly indents: string[];
  private depth: int;

  public constructor(source: Read<Buffer>, tree: Own<AstTree>) {
    this.source = Buffer.from(source);
    this.tree = tree;
    this.lines = [];
    this.indents = [""];
    this.depth = 0;
  }

  public readonly text(): string {
    return this.lines.join("\n");
  }

  public dumpFile(file: Read<SourceFile>): void {
    const itemsItem = this.tree.stmtsOf(file.itemsList);

    this.line(`items ${itemsItem.length}`);

    for (const item of this.tree.stmtsOf(file.itemsList)) {
      this.dumpStmt(item);
    }

    this.dumpModules(
      this.tree.importsOf(file.importsList),
      this.tree.exportsOf(file.exportsList),
    );
  }

  public dumpDeclarationFile(file: Read<DeclarationFile>): void {
    const itemsItem = this.tree.stmtsOf(file.itemsList);

    this.line(`items ${itemsItem.length}`);

    for (const item of this.tree.stmtsOf(file.itemsList)) {
      this.dumpStmt(item);
    }

    this.line(
      `classes ${this.tree.declaredClassesOf(file.classesList).length}`,
    );

    for (const declared of this.tree.declaredClassesOf(file.classesList)) {
      this.dumpDeclaredClass(declared);
    }

    this.dumpModules(
      this.tree.importsOf(file.importsList),
      this.tree.exportsOf(file.exportsList),
    );
  }

  private line(text: string): void {
    while (this.indents.length <= this.depth) {
      const last = this.indents[this.indents.length - 1] ?? "";

      this.indents.push(`${last}  `);
    }

    const indent = this.indents[this.depth] ?? "";

    this.lines.push(`${indent}${text}`);
  }

  private readonly hex4(value: int): string {
    const digits: string[] = [];

    for (let shift = 12; shift >= 0; shift -= 4) {
      const digit = (value >> shift) & 15;
      const hex = kHex.charAt(digit);

      digits.push(hex);
    }

    return digits.join("");
  }

  private readonly unicodeEscape(code: int): string {
    const hex = this.hex4(code);

    return `\\u${hex}`;
  }

  private readonly needsEscape(code: int, quoting: Quoting): boolean {
    const control = code < kSpace || code == kDelete;
    const delimiter = code == kQuote || code == kBackslash;
    if (control || delimiter) {
      return true;
    }

    return quoting == Quoting.EscapeUnicode && code >= kHigh;
  }

  private readonly quote(
    text: string,
    quoting: Quoting = Quoting.KeepUnicode,
  ): string {
    const parts: string[] = [];

    for (let i = 0; i < text.length; i++) {
      const code = text.charCodeAt(i);
      if (this.needsEscape(code, quoting)) {
        const escape = this.unicodeEscape(code);

        parts.push(escape);

        continue;
      }

      const character = text.charAt(i);

      parts.push(character);
    }

    const joined = parts.join("");

    return `"${joined}"`;
  }

  private readonly bits(value: double): string {
    const buffer = Buffer.alloc(8);

    buffer.writeDoubleBE(value, 0);

    return buffer.toString("hex");
  }

  private readonly flag(value: boolean): string {
    if (value) {
      return "1";
    }

    return "0";
  }

  private readonly flags(values: Read<boolean[]>): string {
    if (values.length == 0) {
      return "-";
    }

    const parts: string[] = [];

    for (const value of values) {
      const part = this.flag(value);

      parts.push(part);
    }

    return parts.join("");
  }

  private readonly quoteAll(names: Read<string[]>): string {
    const parts: string[] = [];

    for (const name of names) {
      const part = this.quote(name);

      parts.push(part);
    }

    const joined = parts.join(",");

    return `[${joined}]`;
  }

  private readonly span(text?: Span): string {
    if (text == undefined || text.end <= text.start) {
      return "-";
    }

    return `${text.start}-${text.end}`;
  }

  private readonly spanText(text?: Span): string {
    if (text == undefined || text.end <= text.start) {
      return "";
    }

    return this.source.toString("utf8", text.start, text.end);
  }

  private missing(): void {
    this.line("-");
  }

  private nested(): void {
    this.depth += 1;
  }

  private back(): void {
    this.depth -= 1;
  }

  private dumpModules(
    imports: Read<ImportDecl[]>,
    exports: Read<ExportDecl[]>,
  ): void {
    this.line(`imports ${imports.length}`);

    for (const decl of imports) {
      const from = decl.from;
      const path = this.quote(from.path);
      const whole = decl.whole;
      const wholeName = this.quote(whole?.name ?? "");
      const wholeLoc = whole?.loc ?? kNoLocation;
      const wholeIsDefault = this.flag(whole?.isDefault ?? false);
      const isPartList = this.flag(decl.isPartList);

      this.line(
        `Import ${decl.loc} ${path} ${from.loc} ${wholeName} ${wholeLoc} ` +
          `${wholeIsDefault} ${isPartList} ${this.tree.namesOf(decl.namesList).length}`,
      );
      const names = this.tree.namesOf(decl.namesList);

      this.dumpModuleNames(names);
    }

    this.line(`exports ${exports.length}`);

    for (const decl of exports) {
      const from = decl.from;
      const path = this.quote(from?.path ?? "");
      const pathLoc = from?.loc ?? kNoLocation;

      this.line(
        `Export ${decl.loc} ${decl.form} ${path} ${pathLoc} ${this.tree.namesOf(decl.namesList).length}`,
      );
      const namesItem = this.tree.namesOf(decl.namesList);

      this.dumpModuleNames(namesItem);
    }
  }

  private dumpModuleNames(names: Read<ModuleName[]>): void {
    this.nested();

    for (const name of names) {
      const quotedName = this.quote(name.name);
      const quotedAs = this.quote(name.as);

      this.line(`Name ${quotedName} ${name.loc} ${quotedAs} ${name.asLoc}`);
    }

    this.back();
  }

  public dumpTables(
    fieldNames: Read<Set<string>>,
    constants: Read<Map<string, string[]>>,
  ): void {
    const fields: string[] = [];

    for (const field of fieldNames) {
      fields.push(field);
    }

    fields.sort();
    const quotedFields: string[] = [];

    for (const field of fields) {
      const quoted = this.quote(field);

      quotedFields.push(` ${quoted}`);
    }

    const fieldList = quotedFields.join("");

    this.line(`fields ${fields.length}${fieldList}`);
    const keys: string[] = [];

    for (const key of constants.keys()) {
      keys.push(key);
    }

    keys.sort();
    this.line(`constants ${keys.length}`);

    for (const key of keys) {
      const values = constants.get(key)?.slice() ?? [];
      const quotedValues: string[] = [];

      for (const value of values) {
        const quoted = this.quote(value);

        quotedValues.push(` ${quoted}`);
      }

      const valueList = quotedValues.join("");
      const quotedKey = this.quote(key);

      this.line(`  ${quotedKey} ${values.length}${valueList}`);
    }
  }
}
