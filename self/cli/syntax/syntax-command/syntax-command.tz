import { existsSync, readFileSync } from "node:fs";
import { ErrorPrinter } from "../../../diagnostic/error-printer/error-printer.tz";
import { Lexer } from "../../../load/lexer/lexer.tz";
import { Parser } from "../../../load/parser/parser.tz";
import { SourceText } from "../../../load/parser/types/parser.types.tz";
import { SourceError } from "../../../diagnostic/types/message.types.tz";
import { SourceFile } from "../../../program/ast/types/ast.types.modules.tz";
import { DeclarationFile } from "../../../program/ast/types/ast.types.declarations.tz";
import { Dumper } from "../ast-dump/ast-dump.tz";
import { Sources, SyntaxMode } from "./types/syntax-command.types.tz";
import {
  kDeclarationSuffix,
  kDefaultRepeat,
  kHoldMilliseconds,
  kLineFeed,
  kListPrefix,
  kMaxRepeat,
  kProgramName,
  kSourceSuffix,
  kUsage,
} from "./const/syntax-command.const.tz";

export class SyntaxCommand {
  private readonly modeWord?: string;
  private readonly target?: string;
  private readonly repeatText: string;

  public constructor(args: string[]) {
    this.modeWord = args[2];
    this.target = args[3];
    this.repeatText = args[4] ?? "";
  }

  public run(): void {
    const mode = this.modeOf(this.modeWord);
    const target = this.target;
    if (mode == undefined || target == undefined) {
      console.log(kUsage);

      return;
    }

    const files = this.sourcePaths(target);
    const sources = this.readSources(files);

    switch (mode) {
      case SyntaxMode.Tokens:
        return this.printTokens(sources);
      case SyntaxMode.Tree:
        return this.printTrees(sources);
      case SyntaxMode.Check:
        return this.checkSources(sources);
      case SyntaxMode.Each:
        return this.checkEachLine(sources);
      case SyntaxMode.Time:
        return this.timeSources(sources);
      case SyntaxMode.Hold:
        return this.holdSources(sources, true);
      case SyntaxMode.Read:
        return this.holdSources(sources, false);
    }
  }

  private modeOf(word?: string): SyntaxMode | undefined {
    switch (word) {
      case "tokens":
        return SyntaxMode.Tokens;
      case "tree":
        return SyntaxMode.Tree;
      case "check":
        return SyntaxMode.Check;
      case "each":
        return SyntaxMode.Each;
      case "time":
        return SyntaxMode.Time;
      case "hold":
        return SyntaxMode.Hold;
      case "read":
        return SyntaxMode.Read;
      default:
        return undefined;
    }
  }

  private sourcePaths(target: string): string[] {
    if (!target.startsWith(kListPrefix)) {
      return [target];
    }

    const listPath = target.slice(kListPrefix.length);

    return this.readList(listPath);
  }

  private readList(path: string): string[] {
    const text = readFileSync(path, "utf8");
    if (text.isErr()) {
      this.cannotRead(path);

      return [];
    }

    const lines = text.value.split("\n");

    return lines.map((line) => line.trim()).filter((line) => line.length > 0);
  }

  private readSources(files: string[]): Sources {
    const sources: Sources = { files: [], declarations: [] };

    for (const path of files) {
      const text = readFileSync(path);
      if (text.isErr()) {
        this.cannotRead(path);
        continue;
      }

      const isLibrary = path.replaceAll("\\", "/").includes("/library/");
      const source: SourceText = { path, text: text.value, isLibrary };

      if (this.isDeclaration(path)) {
        sources.declarations.push(source);
      } else {
        sources.files.push(source);
      }
    }

    return sources;
  }

  private isDeclaration(path: string): boolean {
    if (!path.endsWith(kDeclarationSuffix)) {
      return false;
    }

    const stem = path.slice(0, path.length - kDeclarationSuffix.length);

    return existsSync(`${stem}${kSourceSuffix}`);
  }

  private everySource(sources: Sources): SourceText[] {
    return sources.files.concat(sources.declarations);
  }

  private cannotRead(path: string): void {
    console.error(`${kProgramName}: cannot read '${path}'`);
    process.exitCode = 1;
  }

  private printTokens(sources: Sources): void {
    for (const source of this.everySource(sources)) {
      console.log(`== ${source.path}`);

      const lexer = new Lexer(source.text);
      const lexed = lexer.run();

      for (const token of lexed.tokens) {
        const length = token.end - token.start;
        const newline = this.bit(token.newline);
        const hash = this.bit(token.hash);

        console.log(`${token.kind} ${token.start} ${length} ${newline} ${hash}`);
      }
    }
  }

  private printTrees(sources: Sources): void {
    const parser = new Parser(sources.files);

    for (const parsed of parser.run()) {
      const dumper = new Dumper(parsed.source.text);

      dumper.dumpFile(parsed.file);
      this.printTree(parsed.source, dumper, parsed.errors);
    }

    const declarationParser = new Parser(sources.declarations);

    for (const parsed of declarationParser.runDeclarations()) {
      const dumper = new Dumper(parsed.source.text);

      dumper.dumpDeclarationFile(parsed.file);
      this.printTree(parsed.source, dumper, parsed.errors);
    }
  }

  private printTree(
    source: SourceText,
    dumper: Dumper,
    errors: SourceError[],
  ): void {
    console.log(`== ${source.path}`);
    const text = dumper.text();

    console.log(text);

    for (const error of errors) {
      console.log(`!! ${error.loc}`);
    }
  }

  private checkSources(sources: Sources): void {
    const parser = new Parser(sources.files);

    for (const parsed of parser.run()) {
      this.printErrors(parsed.source, parsed.errors);
    }

    const declarationParser = new Parser(sources.declarations);

    for (const parsed of declarationParser.runDeclarations()) {
      this.printErrors(parsed.source, parsed.errors);
    }
  }

  private printErrors(source: SourceText, errors: SourceError[]): void {
    if (errors.length == 0) {
      return;
    }

    const printer = new ErrorPrinter(source);

    printer.print(errors);
    process.exitCode = 1;
  }

  private checkEachLine(sources: Sources): void {
    for (const source of sources.files) {
      const lines = this.linesOf(source);

      for (const line of lines) {
        this.checkSources({ files: [line], declarations: [] });
      }
    }

    for (const source of sources.declarations) {
      const lines = this.linesOf(source);

      for (const line of lines) {
        this.checkSources({ files: [], declarations: [line] });
      }
    }
  }

  private linesOf(source: SourceText): SourceText[] {
    const text = source.text;
    const lines: SourceText[] = [];
    let start = 0;

    for (let end = 0; end <= text.length; end++) {
      if (!this.endsLine(text, end)) {
        continue;
      }

      const number = lines.length + 1;

      lines.push({
        path: `${source.path}:${number}`,
        text: text.subarray(start, end),
        isLibrary: source.isLibrary,
      });
      start = end + 1;
    }

    return lines;
  }

  private endsLine(text: Buffer, at: int): boolean {
    const byte = text[at];
    if (byte == undefined) {
      return true;
    }

    return byte.toInt() == kLineFeed;
  }

  private lexAll(sources: Sources): int {
    let tokens = 0;

    for (const source of this.everySource(sources)) {
      const lexer = new Lexer(source.text);
      const lexed = lexer.run();

      tokens += lexed.tokens.length - 1;
    }

    return tokens;
  }

  private parseAll(sources: Sources): int {
    const files: SourceFile[] = [];
    const declarations: DeclarationFile[] = [];

    this.parseInto(sources, files, declarations);

    return this.itemCount(files, declarations);
  }

  private parseInto(
    sources: Sources,
    files: SourceFile[],
    declarations: DeclarationFile[],
  ): void {
    const parser = new Parser(sources.files);

    for (const parsed of parser.run()) {
      files.push(parsed.file);
    }

    const declarationParser = new Parser(sources.declarations);

    for (const parsed of declarationParser.runDeclarations()) {
      declarations.push(parsed.file);
    }
  }

  private itemCount(
    files: SourceFile[],
    declarations: DeclarationFile[],
  ): int {
    let items = 0;

    for (const file of files) {
      items += file.items.length;
    }

    for (const file of declarations) {
      items += file.items.length + file.classes.length;
    }

    return items;
  }

  private sourceCount(sources: Sources): int {
    return sources.files.length + sources.declarations.length;
  }

  private timeSources(sources: Sources): void {
    const parsedRepeat = parseInt(this.repeatText);
    const repeat = parsedRepeat.unwrapOr(kDefaultRepeat);
    if (repeat < 1 || repeat > kMaxRepeat) {
      return;
    }

    let tokens = 0;
    let items = 0;

    const lexStarted = performance.now();

    for (let pass = 0; pass < repeat; pass++) {
      tokens = this.lexAll(sources);
    }

    const parseStarted = performance.now();

    for (let pass = 0; pass < repeat; pass++) {
      items = this.parseAll(sources);
    }

    const parseEnded = performance.now();
    const passes = repeat.toDouble();
    const lexMs = (parseStarted - lexStarted) / passes;
    const parseMs = (parseEnded - parseStarted) / passes;
    const lexText = lexMs.toFixed(2);
    const parseText = parseMs.toFixed(2);

    const count = this.sourceCount(sources);

    console.log(`files ${count}, tokens ${tokens}, nodes ${items}`);
    console.log(`lex ${lexText} ms, lex + parse ${parseText} ms per pass`);
  }

  private holdSources(sources: Sources, parseThem: boolean): void {
    const files: SourceFile[] = [];
    const declarations: DeclarationFile[] = [];

    if (parseThem) {
      this.parseInto(sources, files, declarations);
    }

    const items = this.itemCount(files, declarations);
    const now = performance.now();
    const until = now + kHoldMilliseconds;
    let spins = 0;

    while (performance.now() < until) {
      spins += 1;
    }

    const count = this.sourceCount(sources);
    const held = files.length + declarations.length;
    const counts = `files ${count}, items ${items}`;

    console.log(`${counts}, held ${held}, spins ${spins}`);
  }

  private bit(value: boolean): int {
    if (value) {
      return 1;
    }

    return 0;
  }
}
