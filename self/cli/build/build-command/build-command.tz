import { spawnSync } from "node:child_process";
import { mkdtempSync, rmSync } from "node:fs";
import { tmpdir } from "node:os";
import { basename, dirname, extname, join } from "node:path";
import { kSourceExtension } from "../../../program/module/const/module.const.tz";
import { Program } from "../../../program/module/types/module.types.tz";
import { SourceLines } from "../../../program/source-lines/source-lines.tz";
import { TypeStore } from "../../../program/type/type-store/type-store.tz";
import { IrModule } from "../../../lower/ir-module/ir-module.tz";
import { Lowering } from "../../../lower/lowering/lowering.tz";
import { Unlowered } from "../../../lower/lowering/types/lowering.types.tz";
import { FrontEnd } from "../../../pipeline/front-end/front-end.tz";
import { OwnershipCheck } from "../../../semantic/ownership/ownership-check/ownership-check.tz";
import { ExpressionTypes } from "../../../semantic/code/expression-types/expression-types.tz";
import { kProgramName } from "../../const/cli.const.tz";
import { ProgramReport } from "../../program-report/program-report.tz";
import { ProgramSource } from "../../program-source/program-source.tz";
import {
  kEmitIrOption,
  kExecutableExtension,
  kIrExtension,
  kLibraryOption,
  kLinkerArguments,
  kLinkerTool,
  kObjectFile,
  kOutputOption,
  kRuntimeLibrary,
  kSystemLibraries,
  kTemporaryPrefix,
} from "./const/build-command.const.tz";
import { BuildOptions } from "./types/build-command.types.tz";

export class BuildCommand {
  private readonly args: string[];
  private readonly report: ProgramReport;
  private readonly store: TypeStore;

  public constructor(args: Own<string[]>) {
    this.args = args;
    this.report = new ProgramReport();
    this.store = new TypeStore();
  }

  public run(): void {
    const options = this.optionsOf();
    const entry = options.entry;
    if (options.isWrong || entry == undefined) {
      return this.report.wrongUsage();
    }
    if (extname(entry) != kSourceExtension) {
      return this.report.notSource(entry);
    }

    const source = new ProgramSource();
    const loaded = source.loadWith(entry, [], true);
    const program = loaded.program;

    this.report.loadProblems(loaded);
    this.report.moduleErrors(program);

    const front = new FrontEnd(this.store, program);
    if (this.report.hasFailed() && !front.isCheckable(loaded)) {
      return;
    }

    const checked = front.run();

    for (const problems of front.problems(checked)) {
      this.report.sourceErrors(problems.source, problems.errors);
    }

    if (this.report.hasFailed()) {
      return;
    }

    this.checkOwnership(program, checked.values);

    if (this.report.hasFailed()) {
      return;
    }

    const lowering = new Lowering(this.store, program, checked);
    const lowered = lowering.run();
    if (lowered.unlowered.length > 0) {
      return this.unloweredReport(program, lowered.unlowered);
    }

    const ir = lowering.ir;
    if (!ir.isValid()) {
      return this.report.failure(
        `${kProgramName}: LLVM rejected the lowered program`,
      );
    }

    const output = this.outputOf(options, entry);

    if (options.isEmittingIr) {
      return this.irWritten(ir, output);
    }

    this.executableMade(ir, output, options.libraries);
  }

  private readonly optionsOf(): BuildOptions {
    let entry: string | undefined = undefined;
    let output: string | undefined = undefined;
    const libraries: string[] = [];
    let isEmittingIr = false;
    let isWrong = false;

    for (let index = 3; index < this.args.length; index++) {
      const arg = this.args[index] ?? "";
      if (arg == kOutputOption) {
        index += 1;
        output = this.args[index];
        isWrong = isWrong || output == undefined;
      } else if (arg == kLibraryOption) {
        index += 1;

        const library = this.args[index];

        isWrong = isWrong || library == undefined;
        libraries.push(library ?? "");
      } else if (arg == kEmitIrOption) {
        isEmittingIr = true;
      } else if (entry == undefined) {
        entry = arg;
      } else {
        isWrong = true;
      }
    }

    return { entry, output, libraries, isEmittingIr, isWrong };
  }

  private readonly outputOf(options: Read<BuildOptions>, entry: string): string {
    const given = options.output;
    if (given != undefined) {
      return given;
    }

    const stem = basename(entry, kSourceExtension);

    if (options.isEmittingIr) {
      return `${stem}${kIrExtension}`;
    }

    return `${stem}${kExecutableExtension}`;
  }

  private checkOwnership(program: Program, values: Own<ExpressionTypes>): void {
    const ownership = new OwnershipCheck(this.store, values, program);

    ownership.run();

    for (const module of program.modules) {
      const errors = ownership.problems(module.id);
      if (errors.length > 0) {
        const sorted = errors.slice();

        sorted.sort((first, second) => first.loc - second.loc);
        this.report.sourceErrors(module.source, sorted);
      }
    }
  }

  private unloweredReport(program: Program, unlowered: Read<Unlowered[]>): void {
    for (const one of unlowered) {
      const module = program.modules[one.module];
      if (module == undefined) {
        continue;
      }

      const lines = new SourceLines(module.source.text);
      const place = lines.placeOf(one.loc);
      const where = `${module.source.path}:${place.line}:${place.column}`;

      this.report.failure(
        `${where}: error: lowering of ${one.form} is not done yet`,
      );
    }
  }

  private irWritten(ir: IrModule, path: string): void {
    if (!ir.printed(path)) {
      this.report.failure(`${kProgramName}: cannot write '${path}'`);
    }
  }

  private executableMade(
    ir: IrModule,
    output: string,
    libraries: Own<string[]>,
  ): void {
    const prefix = join(tmpdir(), kTemporaryPrefix);
    const folder = mkdtempSync(prefix);
    if (folder.isErr()) {
      const reason = folder.error.message;

      this.report.failure(
        `${kProgramName}: cannot make a temporary folder: ${reason}`,
      );

      return;
    }

    const objectPath = join(folder.value, kObjectFile);
    const isMade =
      this.objectMade(ir, objectPath) &&
      this.linked(objectPath, output, libraries);
    const removed = rmSync(folder.value, { force: true, recursive: true });
    if (isMade && removed.isErr()) {
      const reason = removed.error.message;

      this.report.failure(
        `${kProgramName}: cannot remove '${folder.value}': ${reason}`,
      );
    }
  }

  private objectMade(ir: IrModule, objectPath: string): boolean {
    if (ir.emitted(objectPath)) {
      return true;
    }

    this.report.failure(`${kProgramName}: cannot write '${objectPath}'`);

    return false;
  }

  private linked(
    objectPath: string,
    output: string,
    libraries: Own<string[]>,
  ): boolean {
    const linker = this.toolPath(kLinkerTool);
    const runtime = this.toolPath(kRuntimeLibrary);
    const inputs = [`/out:${output}`, objectPath, runtime].concat(libraries);
    const args = kLinkerArguments.concat(inputs, kSystemLibraries);

    return this.toolRan(linker, args);
  }

  private readonly toolPath(name: string): string {
    const home = dirname(process.execPath);

    return join(home, name);
  }

  private toolRan(path: string, args: Read<string[]>): boolean {
    const ran = spawnSync(path, args, { encoding: "utf8" });
    if (ran.isErr()) {
      this.report.failure(
        `${kProgramName}: cannot run '${path}': ${ran.error.message}`,
      );

      return false;
    }

    const done = ran.value;
    if (done.status != 0) {
      const said = `${done.stdout ?? ""}${done.stderr ?? ""}`;
      const tool = basename(path);

      this.report.failure(`${said}${kProgramName}: '${tool}' failed`);

      return false;
    }

    return true;
  }
}
