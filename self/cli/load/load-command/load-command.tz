import { extname } from "node:path";
import { kSourceExtension } from "../../../program/module/const/module.const.tz";
import {
  LinkKind,
  Module,
  ModuleLink,
  Program,
} from "../../../program/module/types/module.types.tz";
import { ProgramReport } from "../../program-report/program-report.tz";
import { ProgramSource } from "../../program-source/program-source.tz";
import { kLibraryMark } from "../../const/cli.const.tz";

export class LoadCommand {
  private readonly entry?: string;
  private readonly report: ProgramReport;

  public constructor(args: Read<string[]>) {
    this.entry = args[3];
    this.report = new ProgramReport();
  }

  public run(): void {
    const entry = this.entry;
    if (entry == undefined) {
      return this.report.wrongUsage();
    }
    if (extname(entry) != kSourceExtension) {
      return this.report.notSource(entry);
    }

    const source = new ProgramSource();
    const loaded = source.load(entry);

    this.report.loadProblems(loaded);
    this.printProgram(loaded.program);
    this.report.moduleErrors(loaded.program);
  }

  private readonly printProgram(program: Program): void {
    const ambient = program.ambient;
    const modules = program.order.filter((one) => !ambient.includes(one));

    console.log(`modules ${modules.length}`);

    for (const module of modules) {
      this.printModule(program, module);
    }
  }

  private readonly printModule(program: Program, module: Module): void {
    if (module.source.isLibrary) {
      console.log(`${module.name}${kLibraryMark}`);

      return;
    }

    console.log(module.name);

    const declaration = module.declaration;
    if (declaration != undefined) {
      console.log(`  declaration ${declaration.source.path}`);
    }

    for (const part of module.parts) {
      const name = part.name ?? "";
      const names = part.methods.map((method) => method.name);
      const methods = names.join(" ");

      console.log(`  part ${name}: ${methods}`);
    }

    for (const link of module.links) {
      const target = this.targetText(program, link);
      const from = link.from;

      console.log(`  "${from.path}" ${from.loc} -> ${target}`);
    }
  }

  private readonly targetText(program: Program, link: ModuleLink): string {
    switch (link.kind) {
      case LinkKind.Module:
        return this.moduleName(program, link.target);
      case LinkKind.Package:
        return "package";
      case LinkKind.Json:
        return "json";
      default:
        return "missing";
    }
  }

  private readonly moduleName(program: Program, id: int): string {
    const module = program.modules[id];
    if (module == undefined) {
      return "";
    }

    return module.name;
  }
}
