import { extname } from "node:path";
import {
  DeclarationForm,
  ModuleTypes,
  TypedDeclaration,
} from "../../../program/module-types/types/module-types.types.tz";
import { kSourceExtension } from "../../../program/module/const/module.const.tz";
import { SourceLines } from "../../../program/source-lines/source-lines.tz";
import { FrontEnd } from "../../../pipeline/front-end/front-end.tz";
import { ProgramReport } from "../../program-report/program-report.tz";
import { ProgramSource } from "../../program-source/program-source.tz";
import { Program } from "../../../program/module/types/module.types.tz";
import { ExpressionTypes } from "../../../semantic/code/expression-types/expression-types.tz";
import { OwnershipCheck } from "../../../semantic/ownership/ownership-check/ownership-check.tz";
import { TypeSystem } from "../../../semantic/types/type-system/type-system.tz";
import { Overlay } from "../../../load/loader/types/loader.types.tz";
import {
  kOverlayFlag,
  kOwnershipFlag,
  kQuietFlag,
} from "./const/types-command.const.tz";

export class TypesCommand {
  private readonly entry?: string;
  private readonly isOwnershipChecked: boolean;
  private readonly isQuiet: boolean;
  private readonly overlays: Overlay[];
  private readonly report: ProgramReport;

  public constructor(args: Read<string[]>) {
    this.entry = args[3];
    this.isOwnershipChecked = args.includes(kOwnershipFlag);
    this.isQuiet = args.includes(kQuietFlag);
    this.overlays = [];
    this.report = new ProgramReport();

    this.readOverlays(args);
  }

  public run(): void {
    const entry = this.entry;
    if (entry == undefined) {
      return this.report.wrongUsage();
    }
    if (extname(entry) != kSourceExtension) {
      return this.report.notSource(entry);
    }

    const source = new ProgramSource();
    const loaded = source.loadWith(entry, this.overlays, false);

    this.report.loadProblems(loaded);
    this.report.moduleErrors(loaded.program);

    const front = new FrontEnd();
    if (this.report.hasFailed() && !front.isCheckable(loaded)) {
      return;
    }

    const checked = front.run(loaded.program);

    if (!this.isQuiet) {
      for (const typed of checked.typed) {
        this.printTypes(typed, checked.values.types);
      }
    }

    const found = front.problems(checked);
    const program = checked.values.types.program;

    for (const problems of found) {
      const module = program.modules[problems.module];
      if (module != undefined) {
        this.report.sourceErrors(module.source, problems.errors);
      }
    }

    if (this.isOwnershipChecked) {
      this.checkOwnership(checked.values);
    }
  }

  private readOverlays(args: Read<string[]>): void {
    for (let index = 0; index < args.length; index++) {
      const path = args[index + 1];
      const textFile = args[index + 2];
      if (args[index] != kOverlayFlag) {
        continue;
      }
      if (path == undefined || textFile == undefined) {
        continue;
      }

      this.overlays.push({ path, textFile });
    }
  }

  private checkOwnership(values: Own<ExpressionTypes>): void {
    const ownership = new OwnershipCheck(values);

    ownership.run();

    for (const line of ownership.hints()) {
      console.log(line);
    }

    const program = ownership.values.types.program;

    for (const module of program.modules) {
      const errors = ownership.problems(module.id);
      if (errors.length > 0) {
        const sorted = errors.slice();

        sorted.sort((first, second) => first.loc - second.loc);
        this.report.sourceErrors(module.source, sorted);
      }
    }
  }

  private readonly printTypes(
    types: Read<ModuleTypes>,
    system: Read<TypeSystem>,
  ): void {
    const module = system.program.modules[types.module];
    if (module == undefined) {
      return;
    }

    const lines = new SourceLines(module.source.text);

    console.log(module.name);

    for (const declaration of types.declarations) {
      const place = lines.placeOf(declaration.loc);
      const text = this.declarationText(declaration, system);

      console.log(`  ${place.line}:${place.column} ${text}`);
    }
  }

  private readonly declarationText(
    declaration: TypedDeclaration,
    system: Read<TypeSystem>,
  ): string {
    const name = declaration.name;

    switch (declaration.form) {
      case DeclarationForm.TypeAlias: {
        const type = system.structureText(declaration.type);

        return `type ${name} = ${type}`;
      }
      case DeclarationForm.Enum: {
        const type = system.structureText(declaration.type);

        return `enum ${name} = ${type}`;
      }
      default: {
        const type = system.typeText(declaration.type);

        return `${name}: ${type}`;
      }
    }
  }
}
