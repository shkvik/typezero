import { KnownName } from "./token.tz";

export enum UnaryOp {
  Neg,
  Plus,
  Not,
  BitNot,
  TypeOf,
  Void,
  Delete,
  NonNull,
}

export enum BinaryOp {
  Add,
  Sub,
  Mul,
  Div,
  Rem,
  Pow,
  BitAnd,
  BitOr,
  BitXor,
  Shl,
  Shr,
  UShr,
  Lt,
  Le,
  Gt,
  Ge,
  Eq,
  Ne,
  LogAnd,
  LogOr,
  Nullish,
  In,
  InstanceOf,
}

export enum Access {
  Public,
  Protected,
  Private,
}

export enum FunctionPlace {
  Declared,
  Expression,
  Lifted,
}

export enum BodySource {
  Written,
  External,
  Intrinsic,
  Foreign,
}

export enum MethodKind {
  Instance,
  Static,
  Constructor,
  Abstract,
}

export enum FieldKind {
  Instance,
  ArrowMethod,
  Static,
  Parameter,
}

export enum FieldPresence {
  Required,
  Optional,
  Definite,
}

export enum ParamKind {
  Required,
  Optional,
  Defaulted,
  Rest,
}

export enum BindingKind {
  Plain,
  Array,
  Object,
}

export enum PropertyKind {
  Value,
  Method,
  Defaulted,
  Computed,
  Spread,
}

export enum NewKind {
  Named,
  Callee,
}

export enum ExportForm {
  Local,
  Re,
  All,
}

export enum TypeKind {
  Name,
  Array,
  Union,
  Generic,
  Function,
  Object,
  Tuple,
  Literal,
  Predicate,
  KeyOf,
  Indexed,
  TypeOf,
  Mapped,
  Conditional,
  Infer,
  Template,
  Intersection,
}

export enum ExprKind {
  IntLit,
  FloatLit,
  BoolLit,
  StringLit,
  Undefined,
  Template,
  ArrayLit,
  ObjectLit,
  Name,
  Member,
  Index,
  Unary,
  Binary,
  Assign,
  Update,
  Call,
  New,
  Conditional,
  Cast,
  Sequence,
  OptionalChain,
  Function,
  Yield,
  RegexLit,
  Await,
  Class,
}

export enum StmtKind {
  Block,
  VarDecl,
  Function,
  Expr,
  If,
  While,
  DoWhile,
  For,
  ForOf,
  Switch,
  Labeled,
  Return,
  Break,
  Continue,
  Empty,
  Debugger,
  TypeAlias,
  Enum,
  Class,
}

export type Span = { readonly start: int; readonly end: int };

export const kNoSpan: Span = { start: -1, end: -1 };

export type PlainTypeForm = {
  readonly kind:
    | TypeKind.Name
    | TypeKind.Array
    | TypeKind.Union
    | TypeKind.Generic
    | TypeKind.KeyOf
    | TypeKind.Indexed
    | TypeKind.Conditional
    | TypeKind.Infer
    | TypeKind.Intersection;
};
export type FunctionTypeForm = {
  readonly kind: TypeKind.Function;
  readonly names: string[];
  readonly optional: boolean[];
  rest: boolean;
};
export type ObjectTypeForm = {
  readonly kind: TypeKind.Object;
  readonly names: string[];
  readonly locs: int[];
  readonly optional: boolean[];
  readonly readonly: boolean[];
  readonly methods: boolean[];
};
export type TupleTypeForm = {
  readonly kind: TypeKind.Tuple;
  readonly: boolean[];
  readonly spread: boolean[];
};
export type LiteralTypeForm = {
  readonly kind: TypeKind.Literal;
  readonly text: string;
  readonly number: double;
  readonly integer: boolean;
};
export type PredicateTypeForm = {
  readonly kind: TypeKind.Predicate;
  readonly asserts: boolean;
};
export type TypeOfTypeForm = {
  readonly kind: TypeKind.TypeOf;
  readonly names: string[];
};
export type MappedTypeForm = {
  readonly kind: TypeKind.Mapped;
  mappedOptional: int;
  readonly mappedReadonly: int;
};
export type TemplateTypeForm = {
  readonly kind: TypeKind.Template;
  readonly texts: string[];
};
export type TypeForm =
  | PlainTypeForm
  | FunctionTypeForm
  | ObjectTypeForm
  | TupleTypeForm
  | LiteralTypeForm
  | PredicateTypeForm
  | TypeOfTypeForm
  | MappedTypeForm
  | TemplateTypeForm;

export type TypeRef = {
  form: TypeForm;
  name: string;
  loc: int;
  args: TypeRef[];
  source: Span;
};

export function typeRef(loc: int): TypeRef {
  return {
    form: { kind: TypeKind.Name },
    name: "",
    loc,
    args: [],
    source: kNoSpan,
  };
}

export type TypeParamDecl = {
  readonly name: string;
  readonly loc: int;
  readonly constraint?: TypeRef;
  readonly defaultType?: TypeRef;
};

export type Decorator = { readonly loc: int; readonly expr: Expr };

export type IntLitExpr = {
  readonly kind: ExprKind.IntLit;
  readonly loc: int;
  readonly value: uint64;
  readonly text: Span;
};
export type FloatLitExpr = {
  readonly kind: ExprKind.FloatLit;
  readonly loc: int;
  readonly value: double;
  readonly text: Span;
};
export type BoolLitExpr = {
  readonly kind: ExprKind.BoolLit;
  readonly loc: int;
  readonly value: boolean;
};
export type StringLitExpr = {
  readonly kind: ExprKind.StringLit;
  readonly loc: int;
  readonly value: string;
};
export type UndefinedExpr = {
  readonly kind: ExprKind.Undefined;
  readonly loc: int;
};
export type TemplateExpr = {
  readonly kind: ExprKind.Template;
  readonly loc: int;
  readonly quasis: string[];
  readonly exprs: Expr[];
};
export type ArrayElement = {
  readonly expr: Expr;
  readonly spread: boolean;
  readonly hole: boolean;
};
export type ArrayLitExpr = {
  readonly kind: ExprKind.ArrayLit;
  readonly loc: int;
  readonly elements: ArrayElement[];
};
export type PlainProperty = {
  readonly kind:
    PropertyKind.Value | PropertyKind.Method | PropertyKind.Defaulted;
};
export type ComputedProperty = {
  readonly kind: PropertyKind.Computed;
  readonly key: Expr;
};
export type SpreadProperty = {
  readonly kind: PropertyKind.Spread;
  readonly omit: string[];
  readonly omitKeys: IndexExpr[];
};
export type PropertyForm = PlainProperty | ComputedProperty | SpreadProperty;
export type Property = {
  readonly name: string;
  readonly loc: int;
  readonly value: Expr;
  readonly form: PropertyForm;
};
export type ObjectLitExpr = {
  readonly kind: ExprKind.ObjectLit;
  readonly loc: int;
  readonly props: Property[];
};
export type NameExpr = {
  readonly kind: ExprKind.Name;
  readonly loc: int;
  readonly name: string;
  readonly known: KnownName;
  typeArgs: TypeRef[];
};
export type MemberExpr = {
  readonly kind: ExprKind.Member;
  readonly loc: int;
  readonly object: Expr;
  readonly name: string;
  readonly known: KnownName;
  readonly optional: boolean;
  typeArgs: TypeRef[];
};
export type IndexExpr = {
  readonly kind: ExprKind.Index;
  readonly loc: int;
  readonly object: Expr;
  readonly index: Expr;
  readonly optional: boolean;
};
export type UnaryExpr = {
  readonly kind: ExprKind.Unary;
  readonly loc: int;
  readonly op: UnaryOp;
  readonly operand: Expr;
};
export type BinaryExpr = {
  readonly kind: ExprKind.Binary;
  readonly loc: int;
  readonly op: BinaryOp;
  readonly lhs: Expr;
  readonly rhs: Expr;
  readonly source: Span;
};
export type AssignExpr = {
  readonly kind: ExprKind.Assign;
  readonly loc: int;
  readonly op?: BinaryOp;
  readonly target: Expr;
  readonly value: Expr;
  readonly source: Span;
};
export type UpdateExpr = {
  readonly kind: ExprKind.Update;
  readonly loc: int;
  readonly increment: boolean;
  readonly prefix: boolean;
  readonly target: Expr;
};
export type CallExpr = {
  readonly kind: ExprKind.Call;
  readonly loc: int;
  readonly callee: Expr;
  readonly args: Expr[];
  readonly spread: boolean[];
  readonly optional: boolean;
  readonly tagged: boolean;
};
export type NamedNew = {
  readonly kind: NewKind.Named;
  readonly name: string;
  readonly member?: string;
};
export type CalleeNew = {
  readonly kind: NewKind.Callee;
  readonly callee: Expr;
};
export type NewForm = NamedNew | CalleeNew;
export type NewExpr = {
  readonly kind: ExprKind.New;
  readonly loc: int;
  readonly form: NewForm;
  readonly typeArgs: TypeRef[];
  readonly args: Expr[];
};
export type ConditionalExpr = {
  readonly kind: ExprKind.Conditional;
  readonly loc: int;
  readonly cond: Expr;
  readonly thenExpr: Expr;
  readonly elseExpr: Expr;
};
export type CastExpr = {
  readonly kind: ExprKind.Cast;
  readonly loc: int;
  readonly operand: Expr;
  readonly target: TypeRef;
};
export type SequenceExpr = {
  readonly kind: ExprKind.Sequence;
  readonly loc: int;
  readonly exprs: Expr[];
};
export type OptionalChainExpr = {
  readonly kind: ExprKind.OptionalChain;
  readonly loc: int;
  readonly chain: Expr;
};
export type FunctionExpr = {
  readonly kind: ExprKind.Function;
  readonly loc: int;
  readonly fn: FunctionDecl;
};
export type YieldExpr = {
  readonly kind: ExprKind.Yield;
  readonly loc: int;
  readonly value?: Expr;
  readonly delegate: boolean;
};
export type RegexLitExpr = {
  readonly kind: ExprKind.RegexLit;
  readonly loc: int;
  readonly pattern: string;
  readonly flags: string;
  readonly written: int;
};
export type AwaitExpr = {
  readonly kind: ExprKind.Await;
  readonly loc: int;
  readonly value: Expr;
};
export type ClassExpr = {
  readonly kind: ExprKind.Class;
  readonly loc: int;
  readonly decl: ClassDecl;
};

export type Expr =
  | IntLitExpr
  | FloatLitExpr
  | BoolLitExpr
  | StringLitExpr
  | UndefinedExpr
  | TemplateExpr
  | ArrayLitExpr
  | ObjectLitExpr
  | NameExpr
  | MemberExpr
  | IndexExpr
  | UnaryExpr
  | BinaryExpr
  | AssignExpr
  | UpdateExpr
  | CallExpr
  | NewExpr
  | ConditionalExpr
  | CastExpr
  | SequenceExpr
  | OptionalChainExpr
  | FunctionExpr
  | YieldExpr
  | RegexLitExpr
  | AwaitExpr
  | ClassExpr;

export type PlainBinding = {
  readonly kind: BindingKind.Plain | BindingKind.Object;
};
export type ArrayBinding = {
  readonly kind: BindingKind.Array;
  readonly length: int;
  readonly rest: boolean;
};
export type BindingForm = PlainBinding | ArrayBinding;

export enum NameOrigin {
  Written,
  Generated,
}

export type VarDeclarator = {
  readonly name: string;
  readonly origin: NameOrigin;
  readonly loc: int;
  readonly typeAnn?: TypeRef;
  readonly init?: Expr;
  readonly form: BindingForm;
};

export type BlockStmt = {
  readonly kind: StmtKind.Block;
  readonly loc: int;
  body: Stmt[];
  readonly end: int;
};
export type VarDeclStmt = {
  readonly kind: StmtKind.VarDecl;
  readonly loc: int;
  readonly isConst: boolean;
  readonly isUsing: boolean;
  readonly decls: VarDeclarator[];
};
export type ExprStmt = {
  readonly kind: StmtKind.Expr;
  readonly loc: int;
  readonly expr: Expr;
};
export type IfStmt = {
  readonly kind: StmtKind.If;
  readonly loc: int;
  readonly cond: Expr;
  readonly thenStmt: Stmt;
  readonly elseStmt?: Stmt;
};
export type WhileStmt = {
  readonly kind: StmtKind.While;
  readonly loc: int;
  readonly cond: Expr;
  readonly body: Stmt;
};
export type DoWhileStmt = {
  readonly kind: StmtKind.DoWhile;
  readonly loc: int;
  readonly body: Stmt;
  readonly cond: Expr;
};
export type ForStmt = {
  readonly kind: StmtKind.For;
  readonly loc: int;
  readonly init?: Stmt;
  readonly cond?: Expr;
  readonly step?: Expr;
  readonly body?: Stmt;
};
export type ForOfStmt = {
  readonly kind: StmtKind.ForOf;
  readonly loc: int;
  readonly isConst: boolean;
  readonly keys: boolean;
  readonly isAwait: boolean;
  readonly binding: VarDeclarator;
  readonly iterable: Expr;
  readonly body: Stmt;
};
export type SwitchCase = {
  readonly loc: int;
  readonly test?: Expr;
  readonly body: Stmt[];
};
export type SwitchStmt = {
  readonly kind: StmtKind.Switch;
  readonly loc: int;
  readonly discriminant: Expr;
  readonly cases: SwitchCase[];
};
export type LabeledStmt = {
  readonly kind: StmtKind.Labeled;
  readonly loc: int;
  readonly label: string;
  readonly body: Stmt;
};
export type ReturnStmt = {
  readonly kind: StmtKind.Return;
  readonly loc: int;
  readonly value?: Expr;
};
export type JumpStmt = {
  readonly kind: StmtKind.Break | StmtKind.Continue;
  readonly loc: int;
  readonly label: string;
};
export type MarkerStmt = {
  readonly kind: StmtKind.Empty | StmtKind.Debugger;
  readonly loc: int;
};
export type TypeAliasDecl = {
  readonly kind: StmtKind.TypeAlias;
  readonly loc: int;
  readonly name: string;
  readonly typeParams: TypeParamDecl[];
  readonly type: TypeRef;
  readonly bases: TypeRef[];
  readonly isHandle: boolean;
};
export type EnumMember = {
  readonly name: string;
  readonly loc: int;
  readonly init?: Expr;
};
export type EnumDecl = {
  readonly kind: StmtKind.Enum;
  readonly loc: int;
  readonly name: string;
  readonly members: EnumMember[];
};

export type ParamProperty = { readonly: boolean; access: Access };
export type PlainParam = {
  readonly kind: ParamKind.Required | ParamKind.Optional | ParamKind.Rest;
};
export type DefaultedParam = {
  readonly kind: ParamKind.Defaulted;
  readonly defaultValue: Expr;
};
export type ParamForm = PlainParam | DefaultedParam;
export type Param = {
  readonly name: string;
  readonly loc: int;
  readonly type?: TypeRef;
  readonly form: ParamForm;
  readonly property?: ParamProperty;
  readonly pattern: Span;
  readonly decorators: Decorator[];
};

export type ClassMember = {
  readonly access: Access;
  readonly isOverride: boolean;
  readonly decorators: Decorator[];
  readonly method: MethodKind;
};

export type FunctionDecl = {
  readonly kind: StmtKind.Function;
  readonly loc: int;
  readonly name: string;
  readonly typeParams: TypeParamDecl[];
  readonly params: Param[];
  readonly returnType?: TypeRef;
  body?: BlockStmt;
  readonly source: Span;
  readonly isArrow: boolean;
  readonly concise: boolean;
  readonly ownName: string;
  readonly place: FunctionPlace;
  bodySource: BodySource;
  readonly isGenerator: boolean;
  readonly isAsync: boolean;
  readonly role?: ClassMember;
};

export function isConstructor(fn: FunctionDecl): boolean {
  const role = fn.role;

  return role != undefined && role.method == MethodKind.Constructor;
}

export type ClassField = {
  readonly name: string;
  readonly loc: int;
  readonly type?: TypeRef;
  readonly init?: Expr;
  readonly form: FieldKind;
  readonly presence: FieldPresence;
  readonly readonly: boolean;
  readonly isOverride: boolean;
  readonly access: Access;
  readonly decorators: Decorator[];
  readonly accessor: boolean;
};

export type ClassDecl = {
  readonly kind: StmtKind.Class;
  readonly loc: int;
  name?: string;
  isAbstract: boolean;
  isPartial: boolean;
  readonly base?: TypeRef;
  readonly baseExpr?: Expr;
  readonly interfaces: TypeRef[];
  readonly fields: ClassField[];
  readonly methods: FunctionDecl[];
  readonly constructors: FunctionDecl[];
  readonly expression: boolean;
  decorators: Decorator[];
  readonly typeParams: TypeParamDecl[];
  source: Span;
};

export type Stmt =
  | BlockStmt
  | VarDeclStmt
  | FunctionDecl
  | ExprStmt
  | IfStmt
  | WhileStmt
  | DoWhileStmt
  | ForStmt
  | ForOfStmt
  | SwitchStmt
  | LabeledStmt
  | ReturnStmt
  | JumpStmt
  | MarkerStmt
  | TypeAliasDecl
  | EnumDecl
  | ClassDecl;

export function marker(
  kind: StmtKind.Empty | StmtKind.Debugger,
  loc: int,
): Stmt {
  return { kind, loc };
}

export type ModuleName = {
  readonly name: string;
  readonly loc: int;
  readonly as: string;
  readonly asLoc: int;
};

export type ImportDecl = {
  readonly loc: int;
  readonly names: ModuleName[];
  readonly path: string;
  readonly pathLoc: int;
  readonly whole: string;
  readonly wholeLoc: int;
  readonly wholeIsDefault: boolean;
  readonly isPartList: boolean;
};

export type ExportDecl = {
  readonly loc: int;
  readonly form: ExportForm;
  readonly names: ModuleName[];
  readonly path: string;
  readonly pathLoc: int;
};

export type SourceFile = {
  readonly items: Stmt[];
  readonly imports: ImportDecl[];
  readonly exports: ExportDecl[];
  readonly fieldNames: Set<string>;
  readonly stringConstants: Map<string, string[]>;
};
