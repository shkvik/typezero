import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  ClassDecl,
  MethodKind,
} from "../../../../../program/ast/types/ast.types.classes.tz";
import {
  CallArgument,
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../../program/ast/types/ast.types.functions.tz";
import {
  FunctionShape,
  FunctionType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { kNoPlace, kParentDepth } from "../../const/expression-types.const.tz";
import {
  CallKind,
  CallTarget,
  ClassMemberEntry,
  RankedVariant,
} from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private variantRules(decl: ClassDecl, module: int): void {
    const groups = this.variantGroups(decl);

    for (const variants of groups) {
      const what = this.variantsWhat(variants);

      this.variantPairs(decl, variants, what, module);
    }
  }

  private readonly variantGroups(decl: ClassDecl): FunctionDecl[][] {
    const tree = this.types.program.tree;

    const seen = new Set<string>();
    const groups: FunctionDecl[][] = [];

    for (const fn of tree.functionsOf(decl.methodsList)) {
      const key = `${this.types.isStaticMethod(fn)} ${fn.name}`;
      if (seen.has(key)) {
        continue;
      }

      seen.add(key);

      const isStatic = this.types.isStaticMethod(fn);
      const named = this.types.classMethodsNamed(decl, fn.name);
      const variants = named.filter(
        (one) => this.types.isStaticMethod(one) == isStatic,
      );

      groups.push(variants);
    }

    const constructors = tree.functionsOf(decl.constructorsList);

    groups.push(constructors);

    return groups;
  }

  private readonly variantsWhat(variants: Read<FunctionDecl[]>): string {
    const first = variants[0];
    const isConstructor = first?.role?.method == MethodKind.Constructor;
    if (first == undefined || isConstructor) {
      return "the constructor";
    }

    return `'${first.name}'`;
  }

  private variantPairs(
    decl: ClassDecl,
    variants: Read<FunctionDecl[]>,
    what: string,
    module: int,
  ): void {
    if (variants.length < 2) {
      return;
    }

    const types = variants.map((fn) => this.ownMethodType(decl, fn, module));

    for (let later = 1; later < variants.length; later++) {
      for (let earlier = 0; earlier < later; earlier++) {
        const first = variants[earlier];
        const second = variants[later];
        const one = types[earlier];
        const other = types[later];
        if (first == undefined || second == undefined) {
          continue;
        }
        if (one == undefined || other == undefined) {
          continue;
        }
        if (this.variantPairCheck(first, second, one, other, what, module)) {
          break;
        }
      }
    }
  }

  private variantPairCheck(
    first: FunctionDecl,
    second: FunctionDecl,
    one: FunctionType,
    other: FunctionType,
    what: string,
    module: int,
  ): boolean {
    const checked = this.types.variantPairCheck(
      first,
      second,
      one,
      other,
      what,
    );

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private overloadCall(
    expr: CallExpr,
    member: MemberExpr,
    entry: Read<ClassMemberEntry>,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const error = this.types.store.plain(TypeKind.Error);
    const ranked = this.rankedVariants(entry);
    const isGeneric = entry.methods.some(
      (fn) => tree.typeParamsOf(fn.typeParamsList).length > 0,
    );
    if (ranked.length == 0 || isGeneric) {
      for (const arg of tree.argumentsOf(expr.argsList)) {
        const exprExpr = tree.exprOf(arg.exprId);

        this.listenerLoose(exprExpr, module);
      }

      return error;
    }

    const what = `'${member.name}'`;
    const chosen = this.chosenVariant(
      tree.argumentsOf(expr.argsList),
      ranked,
      what,
      member.loc,
      module,
    );
    if (chosen == undefined) {
      return error;
    }

    return this.calledWith(expr, chosen.type, member.loc, CallKind.Own, module);
  }

  private rankedVariants(entry: Read<ClassMemberEntry>): RankedVariant[] {
    const ranked: RankedVariant[] = [];
    const seen = new Set<string>();
    let current: ClassMemberEntry | undefined = entry;

    for (let depth = 0; depth < kParentDepth && current != undefined; depth++) {
      this.addVariants(current, ranked);

      const name = current.methods[0]?.name ?? "";
      const key = `${current.instance.module} ${current.owner.loc}`;
      if (seen.has(key)) {
        break;
      }

      seen.add(key);
      current = this.parentVariants(current, name);
    }

    return ranked;
  }

  private addVariants(
    entry: Read<ClassMemberEntry>,
    ranked: RankedVariant[],
  ): void {
    for (const fn of entry.methods) {
      const type = this.methodTypeOf(entry, fn);
      if (type.kind != TypeKind.Function) {
        continue;
      }

      const isHidden = ranked.some((one) =>
        this.types.isSameParameters(one.type, type),
      );
      if (!isHidden) {
        ranked.push({ fn, type, ranks: [], isAdapted: false, failed: -1 });
      }
    }
  }

  private readonly parentVariants(
    entry: Read<ClassMemberEntry>,
    name: string,
  ): ClassMemberEntry | undefined {
    const parent = this.types.parentOf(entry.instance, entry.owner);
    if (parent == undefined || name == "") {
      return undefined;
    }

    const foundLookup = this.classMember(parent, name);
    if (
      foundLookup.entry == undefined ||
      foundLookup.entry.field != undefined
    ) {
      return undefined;
    }

    return foundLookup.entry;
  }

  private chosenVariant(
    args: Read<CallArgument[]>,
    ranked: Own<RankedVariant[]>,
    what: string,
    loc: int,
    module: int,
  ): RankedVariant | undefined {
    const texts = ranked.map((one) =>
      this.types.overloadText(one.fn, one.type),
    );
    const list = this.types.variantList(texts);

    if (args.some((arg) => arg.spread)) {
      this.errors.write(module, loc, Code.VariantSpread, { word: what });
      this.looseArguments(args, module);

      return undefined;
    }

    const count = args.length;
    const counted = this.countFitting(ranked, count);
    if (counted.length == 0) {
      this.errors.write(module, loc, Code.VariantCount, {
        word: what,
        other: `${count}`,
        place: this.types.classPluralMark(count),
        first: list,
      });
      this.looseArguments(args, module);

      return undefined;
    }

    return this.rankedChoice(args, counted, what, loc, module);
  }

  private readonly countFitting(
    ranked: Own<RankedVariant[]>,
    count: int,
  ): RankedVariant[] {
    const counted: RankedVariant[] = [];

    for (const one of ranked.drain()) {
      if (this.types.isCountFitting(one.type, count)) {
        counted.push(one);
      }
    }

    return counted;
  }

  private rankedChoice(
    args: Read<CallArgument[]>,
    counted: Own<RankedVariant[]>,
    what: string,
    loc: int,
    module: int,
  ): RankedVariant | undefined {
    const given = this.quietArguments(args, module);
    const fitting: int[] = [];
    const reasons: string[] = [];
    let hint = "";

    for (let index = 0; index < counted.length; index++) {
      const variant = counted[index];
      if (variant == undefined) {
        continue;
      }

      const reason = this.variantRanks(args, given, variant, module);
      if (reason == "") {
        fitting.push(index);
      } else {
        reasons.push(reason);
      }
      if (reason != "" && hint == "") {
        hint = this.types.variantHint(args, given, variant, module);
      }
    }

    if (fitting.length == 0) {
      this.errors.write(module, loc, Code.VariantNoFit, {
        word: what,
        first: reasons.map((one) => `; ${one}`).join(""),
        second: hint,
      });
      this.looseArguments(args, module);

      return undefined;
    }

    const best = this.bestVariantAt(counted, fitting);
    if (best != undefined) {
      return counted.splice(best, 1).pop();
    }
    if (given.some((type) => type.kind == TypeKind.Error)) {
      this.looseArguments(args, module);

      return undefined;
    }

    this.reportTie(counted, fitting, what, loc, module);
    this.looseArguments(args, module);

    return undefined;
  }

  private readonly bestVariantAt(
    counted: Read<RankedVariant[]>,
    fitting: Read<int[]>,
  ): int | undefined {
    for (const index of fitting) {
      const one = counted[index];
      const isBest =
        one != undefined && this.types.isBestAmong(one, counted, fitting);
      if (isBest) {
        return index;
      }
    }

    return undefined;
  }

  private reportTie(
    counted: Read<RankedVariant[]>,
    fitting: Read<int[]>,
    what: string,
    loc: int,
    module: int,
  ): void {
    const tied: string[] = [];
    let isAdapted = true;

    for (const index of fitting) {
      const one = counted[index];
      if (one != undefined) {
        tied.push(this.types.overloadText(one.fn, one.type));
        isAdapted = isAdapted && one.isAdapted;
      }
    }

    const code = this.types.tieCode(isAdapted);

    this.errors.write(module, loc, code, {
      word: what,
      first: this.types.variantList(tied),
    });
  }

  private quietArguments(args: Read<CallArgument[]>, module: int): Type[] {
    const tree = this.types.program.tree;

    return args.map((arg) => this.peekType(tree.exprOf(arg.exprId), module));
  }

  private variantRanks(
    args: Read<CallArgument[]>,
    given: Read<Type[]>,
    variant: RankedVariant,
    module: int,
  ): string {
    const tree = this.types.program.tree;

    variant.ranks = [];
    variant.isAdapted = false;

    for (let index = 0; index < args.length; index++) {
      const arg = args[index];
      const type = given[index];
      const param = this.types.variantParam(variant.type, index);
      if (arg == undefined || type == undefined || param == undefined) {
        continue;
      }

      const rank = this.argumentRank(
        tree.exprOf(arg.exprId),
        type,
        param,
        variant,
        module,
      );
      if (rank < 0) {
        variant.failed = index;

        const shown = this.types.overloadText(variant.fn, variant.type);
        const wanted = this.types.typeText(param);
        const found = this.types.typeText(type);

        return `${shown} takes '${wanted}' as argument ${index + 1}, which is '${found}'`;
      }

      variant.ranks.push(rank);
    }

    return "";
  }

  private argumentRank(
    expr: Expr,
    type: Type,
    param: Type,
    variant: RankedVariant,
    module: int,
  ): int {
    if (
      type.kind == TypeKind.Error ||
      this.types.apparent(type).id == param.id
    ) {
      return 0;
    }
    const goal = this.types.definedType(param);
    if (this.isEncodingParam(goal) && this.isTextType(type)) {
      return 1;
    }
    if (this.types.converts(type, param)) {
      return 1;
    }

    if (!this.isAdaptingLiteral(expr, type, param, module)) {
      return -1;
    }

    variant.isAdapted = true;

    return 1;
  }

  private isAdaptingLiteral(
    expr: Expr,
    type: Type,
    param: Type,
    module: int,
  ): boolean {
    const base = this.types.apparent(type);
    const goal = this.types.definedType(param);
    const isFraction = base.kind == TypeKind.Double;
    if (isFraction && goal.kind == TypeKind.Decimal) {
      return this.isWholeTree(expr, module) || this.types.isNumberLiteral(expr);
    }
    if (expr.kind == ExprKind.ObjectLit || expr.kind == ExprKind.ArrayLit) {
      return this.isFittingLiteral(expr, param, module);
    }

    this.errors.beginTrial();

    const adapted = this.literalTarget(expr, base, param, module);

    this.errors.endTrial();

    return adapted != undefined;
  }

  private isFittingLiteral(expr: Expr, param: Type, module: int): boolean {
    this.errors.beginTrial();
    this.checked(expr, param, module, kNoPlace);

    return this.errors.endTrial();
  }

  private variantValueCheck(
    expr: MemberExpr,
    entry: Read<ClassMemberEntry>,
    module: int,
  ): void {
    const ranked = this.rankedVariants(entry);

    this.rankedValueCheck(expr, ranked, module);
  }

  private rankedValueCheck(
    expr: MemberExpr,
    ranked: Read<RankedVariant[]>,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    if (this.argumentExprs.has(expr.id) || this.isTypedInit(expr, module)) {
      return;
    }

    const last = ranked[ranked.length - 1];
    if (ranked.length < 2 || last == undefined) {
      return;
    }

    const texts = ranked.map((one) =>
      this.types.overloadText(one.fn, one.type),
    );
    const shape = this.types
      .overloadText(last.fn, last.type)
      .slice(last.fn.name.length);
    const result = this.types.typeText(
      this.types.store.returnTypeOf(last.type),
    );

    this.errors.write(module, expr.loc, Code.VariantValue, {
      word: expr.name,
      first: this.types.variantList(texts),
      second: `${shape} => ${result}`,
      other: this.types.operandName(tree.exprOf(expr.objectId)),
    });
  }

  private readonly isTypedInit(expr: Expr, module: int): boolean {
    const tree = this.types.program.tree;

    const variables = this.record(module)?.variables;
    if (variables == undefined) {
      return false;
    }

    for (const variable of variables.values()) {
      const decl = variable.decl;
      if (
        decl.initId == expr.id &&
        tree.typeRefAt(decl.typeAnnId) != undefined
      ) {
        return true;
      }
    }

    return false;
  }

  private constructorChoice(
    expr: Expr,
    args: Read<CallArgument[]>,
    targets: Read<CallTarget[]>,
    variants: Read<FunctionDecl[]>,
    name: string,
    module: int,
  ): int | undefined {
    const ranked: RankedVariant[] = [];

    for (let index = 0; index < variants.length; index++) {
      const fn = variants[index];
      const target = targets[index];
      if (fn == undefined || target == undefined) {
        continue;
      }

      const result = this.types.store.plain(TypeKind.Void);
      const shape: FunctionShape = {
        params: target.params.slice(),
        rest: target.rest,
        result,
      };
      const type = this.types.store.functionOf(shape);
      if (type.kind == TypeKind.Function) {
        ranked.push({ fn, type, ranks: [], isAdapted: false, failed: -1 });
      }
    }

    const what = `the constructor of '${name}'`;
    const chosen = this.chosenVariant(args, ranked, what, expr.loc, module);
    if (chosen == undefined) {
      return undefined;
    }

    const chosenId = chosen.fn.id;
    const index = variants.findIndex((one) => one.id == chosenId);
    if (index < 0) {
      return undefined;
    }

    return index;
  }
}
