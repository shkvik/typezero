import { kBufferClass } from "../../../../library/byte-number-rules/const/byte-number-rules.const.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import { ExpressionTypes } from "../../expression-types.tz";
import {
  DeclaredClass,
  DeclaredMember,
  DeclaredMemberKind,
} from "../../../../../program/ast/types/ast.types.declarations.tz";
import { NewExpr } from "../../../../../program/ast/types/ast.types.expressions.tz";
import { TypeRef } from "../../../../../program/ast/types/ast.types.types.tz";
import {
  DictKind,
  InstanceType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  ParameterSite,
  TypeContext,
  TypePlace,
} from "../../../../types/type-resolver/types/type-resolver.types.tz";
import { kSetClass } from "../../const/expression-types.const.tz";
import { CallTarget, ValueTarget } from "../../types/expression-types.types.tz";
import { kDateName } from "../../../../types/type-questions/const/type-questions.const.tz";
import { kMapClass } from "../../../class-rules/const/class-rules.const.tz";
import { kPromiseClass } from "../../../../library/library-rules/const/library-rules.const.tz";

partial class ExpressionTypes {
  private libraryNew(
    expr: NewExpr,
    name: string,
    target: ValueTarget,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const written = this.writtenArguments(
      tree.typeRefsOf(expr.typeArgsList),
      module,
    );
    if (written == undefined) {
      return this.types.store.plain(TypeKind.Error);
    }
    if (name == kBufferClass) {
      this.errors.write(module, expr.loc, Code.NewBuffer, kNoDetails);
      const args = tree.argumentsOf(expr.argsList);

      this.looseArguments(args, module);

      return this.types.store.plain(TypeKind.Error);
    }

    const isDict = name == kMapClass || name == kSetClass;
    const key = written[0];
    if (
      isDict &&
      this.types.keyCheck(tree.typeRefsOf(expr.typeArgsList)[0], key, module)
    ) {
      return this.types.store.plain(TypeKind.Error);
    }

    switch (name) {
      case kMapClass:
        return this.dictSourceTyped(
          expr,
          DictKind.Map,
          written,
          wanted,
          module,
        );
      case kSetClass:
        return this.dictSourceTyped(
          expr,
          DictKind.Set,
          written,
          wanted,
          module,
        );
      case kPromiseClass:
        return this.promiseNew(expr, written, wanted, module);
      case kDateName:
        return this.dateNew(expr, module);
      default:
        return this.declaredNew(expr, target, written, module);
    }
  }

  private writtenArguments(
    refs: Read<TypeRef[]>,
    module: int,
  ): Type[] | undefined {
    const context: TypeContext = {
      module,
      bindings: new Map<int, Type>(),
      place: TypePlace.Plain,
    };
    const written = refs.map((ref) => this.types.resolve(ref, context));
    if (written.some((type) => type.kind == TypeKind.Error)) {
      return undefined;
    }

    return written;
  }

  private declaredNew(
    expr: NewExpr,
    target: ValueTarget,
    written: Read<Type[]>,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const home = target.module;
    const opened = this.types.program.modules[home];
    const declared = tree
      .declaredClassesOf(opened?.declaredList)
      .find((one) => one.loc == target.loc);
    if (declared == undefined) {
      return this.types.store.plain(TypeKind.Error);
    }

    const instance = this.types.declaredInstance(home, declared, written);
    if (instance == undefined || instance.kind != TypeKind.Instance) {
      return this.types.store.plain(TypeKind.Error);
    }

    const makers = tree.declaredMembersOf(declared.membersList).filter(
      (one) => one.form.kind == DeclaredMemberKind.Constructor,
    );
    const form = makers[0]?.form;
    if (makers.length > 1) {
      return this.overloadedNew(expr, instance, makers, declared, module);
    }
    if (makers.length != 1 || form == undefined) {
      return instance;
    }
    if (
      form.kind == DeclaredMemberKind.Field ||
      tree.typeParamsOf(form.typeParamsList).length > 0
    ) {
      return instance;
    }

    const sites: ParameterSite[] = [];

    for (const param of tree.paramsOf(form.paramsList)) {
      const type = tree.typeRefAt(param.typeId);
      if (type == undefined) {
        return instance;
      }

      sites.push({
        name: param.name,
        loc: param.loc,
        kind: param.form.kind,
        type,
        isDeclared: false,
      });
    }

    const context = this.types.classContext(
      instance,
      tree.typeParamsOf(declared.typeParamsList),
      home,
    );
    const signature = this.types.signature(sites, undefined, context);
    if (signature.kind != TypeKind.Function) {
      return instance;
    }

    const shape = this.types.store.functionShapeOf(signature);
    const params = shape.params.slice();
    const rest = shape.rest;
    const loc = expr.loc;
    const call: CallTarget = { params, rest, loc, isLenient: true };
    const isPassed = this.argumentsCheck(
      expr.argsList,
      tree.argumentsOf(expr.argsList),
      call,
      module,
    );
    if (!isPassed) {
      return this.types.store.plain(TypeKind.Error);
    }

    return instance;
  }

  private overloadedNew(
    expr: NewExpr,
    instance: InstanceType,
    makers: Read<DeclaredMember[]>,
    declared: DeclaredClass,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const context = this.types.classContext(
      instance,
      tree.typeParamsOf(declared.typeParamsList),
      instance.module,
    );
    const variants = this.variantsOf(makers, context);
    const name = declared.name;
    const chosen = this.quietVariant(
      tree.argumentsOf(expr.argsList),
      name,
      variants,
      module,
    );
    if (chosen == undefined) {
      const args = tree.argumentsOf(expr.argsList);

      this.looseValues(args, module);

      return instance;
    }

    const shape = this.types.store.functionShapeOf(chosen);
    const call: CallTarget = {
      params: shape.params,
      rest: shape.rest,
      loc: expr.loc,
      isLenient: true,
    };
    const isPassed = this.argumentsCheck(
      expr.argsList,
      tree.argumentsOf(expr.argsList),
      call,
      module,
    );
    if (!isPassed) {
      return this.types.store.plain(TypeKind.Error);
    }

    return instance;
  }
}
