import { kBufferClass } from "../../../../library/byte-number-rules/const/byte-number-rules.const.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import { ExpressionTypes } from "../../expression-types.tz";
import {
  DeclaredClass,
  DeclaredMember,
  DeclaredMemberKind,
} from "../../../../../program/ast/types/ast.types.declarations.tz";
import { NewExpr } from "../../../../../program/ast/types/ast.types.expressions.tz";
import { TypeRef } from "../../../../../program/ast/types/ast.types.types.tz";
import {
  DictKind,
  InstanceType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  ParameterSite,
  TypeContext,
  TypePlace,
} from "../../../../types/type-resolver/types/type-resolver.types.tz";
import { kSetClass } from "../../const/expression-types.const.tz";
import { CallTarget, ValueTarget } from "../../types/expression-types.types.tz";
import { kDateName } from "../../../../types/type-questions/const/type-questions.const.tz";
import { kMapClass } from "../../../class-rules/const/class-rules.const.tz";
import { kPromiseClass } from "../../../../library/library-rules/const/library-rules.const.tz";

partial class ExpressionTypes {
  private libraryNew(
    expr: NewExpr,
    name: string,
    target: ValueTarget,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const written = this.writtenArguments(expr.typeArgs, module);
    if (written == undefined) {
      return this.store.plain(TypeKind.Error);
    }
    if (name == kBufferClass) {
      this.report(module, expr.loc, Code.NewBuffer, kNoDetails);
      this.looseArguments(expr.args, module);

      return this.store.plain(TypeKind.Error);
    }

    const isDict = name == kMapClass || name == kSetClass;
    const key = written[0];
    if (isDict && this.resolver.keyCheck(expr.typeArgs[0], key, module)) {
      return this.store.plain(TypeKind.Error);
    }

    switch (name) {
      case kMapClass:
        return this.dictSourceTyped(
          expr,
          DictKind.Map,
          written,
          wanted,
          module,
        );
      case kSetClass:
        return this.dictSourceTyped(
          expr,
          DictKind.Set,
          written,
          wanted,
          module,
        );
      case kPromiseClass:
        return this.calls.promiseNew(written, wanted);
      case kDateName:
        return this.dateNew(expr, module);
      default:
        return this.declaredNew(expr, target, written, module);
    }
  }

  private writtenArguments(refs: TypeRef[], module: int): Type[] | undefined {
    const context: TypeContext = {
      module,
      bindings: new Map<int, Type>(),
      place: TypePlace.Plain,
    };
    const written = refs.map((ref) => this.resolver.resolve(ref, context));
    if (written.some((type) => type.kind == TypeKind.Error)) {
      return undefined;
    }

    return written;
  }

  private declaredNew(
    expr: NewExpr,
    target: ValueTarget,
    written: Type[],
    module: int,
  ): Type {
    const home = target.module;
    const opened = this.program.modules[home];
    const declared = opened?.declared.find((one) => one.loc == target.loc);
    if (declared == undefined) {
      return this.store.plain(TypeKind.Error);
    }

    const instance = this.resolver.declaredInstance(home, declared, written);
    if (instance == undefined || instance.kind != TypeKind.Instance) {
      return this.store.plain(TypeKind.Error);
    }

    const makers = declared.members.filter(
      (one) => one.form.kind == DeclaredMemberKind.Constructor,
    );
    const form = makers[0]?.form;
    if (makers.length > 1) {
      return this.overloadedNew(expr, instance, makers, declared, module);
    }
    if (makers.length != 1 || form == undefined) {
      return instance;
    }
    if (form.kind == DeclaredMemberKind.Field || form.typeParams.length > 0) {
      return instance;
    }

    const sites: ParameterSite[] = [];

    for (const param of form.params) {
      const type = param.type;
      if (type == undefined) {
        return instance;
      }

      sites.push({
        name: param.name,
        loc: param.loc,
        kind: param.form.kind,
        type,
        isDeclared: false,
      });
    }

    const context = this.resolver.classContext(
      instance,
      declared.typeParams,
      home,
    );
    const signature = this.resolver.signature(sites, undefined, context);
    if (signature.kind != TypeKind.Function) {
      return instance;
    }

    const shape = signature.shape;
    const params = shape.params;
    const rest = shape.rest;
    const loc = expr.loc;
    const call: CallTarget = { params, rest, loc, isLenient: true };
    const isPassed = this.argumentsCheck(expr.args, call, module);
    if (!isPassed) {
      return this.store.plain(TypeKind.Error);
    }

    return instance;
  }

  private overloadedNew(
    expr: NewExpr,
    instance: InstanceType,
    makers: DeclaredMember[],
    declared: DeclaredClass,
    module: int,
  ): Type {
    const context = this.resolver.classContext(
      instance,
      declared.typeParams,
      instance.module,
    );
    const variants = this.variantsOf(makers, context);
    const name = declared.name;
    const chosen = this.quietVariant(expr.args, name, variants, module);
    if (chosen == undefined) {
      this.looseValues(expr.args, module);

      return instance;
    }

    const shape = chosen.shape;
    const call: CallTarget = {
      params: shape.params,
      rest: shape.rest,
      loc: expr.loc,
      isLenient: true,
    };
    const isPassed = this.argumentsCheck(expr.args, call, module);
    if (!isPassed) {
      return this.store.plain(TypeKind.Error);
    }

    return instance;
  }
}
