import { replace } from "tz:mem";
import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
  NameExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  BodySource,
  FunctionDecl,
} from "../../../../../program/ast/types/ast.types.functions.tz";
import { StmtKind } from "../../../../../program/ast/types/ast.types.statements.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import {
  FunctionType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  kCountedGlobals,
  kNumberErrorName,
  kNumberName,
  kPushName,
  kStrictGlobals,
  kTextStatics,
  kSystemModulePrefix,
  kUnsafeModuleName,
} from "../../const/expression-types.const.tz";
import { DoorState } from "../../../../types/type-resolver/types/type-resolver.types.tz";
import {
  CallKind,
  CallTarget,
  GenericTarget,
  ValueTarget,
} from "../../types/expression-types.types.tz";
import { kDateName } from "../../../../types/type-questions/const/type-questions.const.tz";

partial class ExpressionTypes {
  private callTyped(
    expr: CallExpr,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const callee = tree.exprOf(expr.calleeId);

    if (expr.tagged && !this.isOwnTag(callee, module)) {
      if (callee.kind == ExprKind.Member) {
        this.stringRawCheck(expr, callee, module);
      }

      return this.types.store.plain(TypeKind.Error);
    }

    if (this.isSuperName(callee, module)) {
      return this.superCallTyped(expr, callee, module);
    }

    switch (callee.kind) {
      case ExprKind.Name:
        return this.namedCall(expr, callee, wanted, module);
      case ExprKind.Member:
        return this.memberCall(expr, callee, wanted, module);
      default:
        return this.valueCall(expr, module);
    }
  }

  private readonly isOwnTag(callee: Expr, module: int): boolean {
    if (callee.kind != ExprKind.Name) {
      return false;
    }

    const target = this.targetOfName(callee, module);
    if (target == undefined || target.kind != SymbolKind.Function) {
      return false;
    }

    return !this.types.isLibraryModule(target.module);
  }

  private namedCall(
    expr: CallExpr,
    callee: NameExpr,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    this.stringCallCheck(expr, callee, module);

    if (this.nodeCallCheck(expr, callee, module)) {
      return this.types.store.plain(TypeKind.Error);
    }
    if (this.isResultMakerCall(callee, module)) {
      return this.resultMakerCall(expr, callee, wanted, module);
    }
    if (this.isDecimalName(callee, module)) {
      return this.decimalOfCall(expr, callee, module);
    }

    const target = this.targetOfName(callee, module);
    if (target == undefined) {
      return this.types.store.plain(TypeKind.Error);
    }

    const eventsMade = this.eventsFunctionCall(expr, callee, target, module);
    if (eventsMade != undefined) {
      return eventsMade;
    }

    const isLibrary = this.types.isLibraryModule(target.module);
    const isClass = target.kind == SymbolKind.Class;
    if (isLibrary && isClass && callee.name == kDateName) {
      return this.dateFunctionCall(expr, callee, module);
    }
    if (isLibrary && callee.name == kNumberName) {
      return this.numberCall(expr, module);
    }
    if (isLibrary && target.kind != SymbolKind.Function) {
      return this.types.store.plain(TypeKind.Error);
    }

    this.earlyCallCheck(expr, callee, target, module);

    switch (target.kind) {
      case SymbolKind.Function:
        return this.functionCall(expr, callee, target, wanted, module);
      case SymbolKind.Class:
        this.errors.write(module, callee.loc, Code.NameNotFunction, {
          word: callee.name,
        });
        const args = tree.argumentsOf(expr.argsList);

        this.looseArguments(args, module);

        return this.types.store.plain(TypeKind.Error);
      default:
        return this.valueCall(expr, module);
    }
  }

  private numberCall(expr: CallExpr, module: int): Type {
    const tree = this.types.program.tree;

    const double = this.types.store.plain(TypeKind.Double);
    const arg = tree.argumentsOf(expr.argsList)[0];
    if (arg == undefined) {
      return double;
    }

    const exprExpr = tree.exprOf(arg.exprId);
    const given = this.typed(exprExpr, undefined, module);
    if (!this.types.isDecimalTextType(given)) {
      return double;
    }

    const error = this.types.libraryShape(kNumberErrorName, []);
    if (error == undefined) {
      return this.types.store.plain(TypeKind.Error);
    }

    return this.types.store.resultOf(double, error);
  }

  private functionCall(
    expr: CallExpr,
    callee: NameExpr,
    target: ValueTarget,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const fn = this.record(target.module)?.functions.get(target.loc);
    if (fn == undefined) {
      return this.types.store.plain(TypeKind.Error);
    }
    if (
      tree.typeParamsOf(fn.typeParamsList).length == 0 &&
      tree.typeRefsOf(callee.typeArgsList).length > 0
    ) {
      this.errors.write(module, callee.loc, Code.NotGenericFunction, {
        word: callee.name,
      });
    }
    const home = target.module;
    const isLibraryHome = this.types.isLibraryModule(home);
    if (isLibraryHome && this.isOverloaded(fn, home)) {
      return this.overloadedLibraryCall(expr, callee, fn, home, module);
    }
    if (!this.isCallable(fn, target.module)) {
      return this.types.store.plain(TypeKind.Error);
    }

    const key = `${target.module} ${target.loc}`;
    const door = this.functionDoors.get(key);
    const isInferring =
      door != undefined &&
      door.state == DoorState.InWork &&
      tree.typeRefAt(fn.returnTypeId) == undefined;
    const isAssumed = door?.isAssumed == true;
    if (isInferring && !isAssumed) {
      const caller = this.walking[this.walking.length - 1];

      if (caller != key) {
        this.calledBack.add(key);
      }

      this.recursions.push(key);

      return this.types.store.plain(TypeKind.Error);
    }
    if (isInferring) {
      this.assumedCalls.push(key);
    }

    const type = this.functionAt(target.module, target.loc);
    if (type.kind != TypeKind.Function) {
      return this.types.store.plain(TypeKind.Error);
    }
    const owner = this.types.program.modules[target.module]?.name ?? "";
    if (owner == kUnsafeModuleName) {
      this.unsafeCallCheck(callee, module, false);
    }
    if (owner.startsWith(kSystemModulePrefix)) {
      this.unsafeCallCheck(callee, module, true);
    }
    const typeParams = tree.typeParamsOf(fn.typeParamsList);
    if (typeParams.length > 0) {
      const generic = this.genericFunction(callee, fn, type, target);

      return this.genericResult(expr, generic, wanted, module);
    }

    const shape = this.types.store.functionShapeOf(type);
    const params = this.types.directParams(shape.params, shape.self);
    const rest = shape.rest;

    const loc = callee.loc;
    const isLenient = this.types.isLibraryModule(target.module);
    const isListed = kStrictGlobals.includes(callee.name);
    const isStrict = isLenient && isListed && this.types.isStrictShape(params);
    const isCounted = isStrict || kCountedGlobals.includes(callee.name);
    const call: CallTarget = {
      params,
      rest,
      loc,
      isLenient: isLenient && !isStrict,
      kind: this.types.libraryKind(isLenient),
      isCounted: isLenient && isCounted,
      method: callee.name,
      isTagged: expr.tagged,
    };

    if (isLenient) {
      this.lenientCalls.add(expr.id);
    }

    const isPassed = this.argumentsCheck(
      expr.argsList,
      tree.argumentsOf(expr.argsList),
      call,
      module,
    );

    if (!isLenient && isPassed) {
      this.changedArguments(expr, module);
    }
    if (!isPassed) {
      return this.types.store.plain(TypeKind.Error);
    }

    return shape.result;
  }

  private genericFunction(
    callee: NameExpr,
    fn: FunctionDecl,
    type: FunctionType,
    target: ValueTarget,
  ): GenericTarget {
    const tree = this.types.program.tree;

    const home = target.module;

    return {
      name: fn.name,
      params: this.types.parameterTypes(
        home,
        tree.typeParamsOf(fn.typeParamsList),
      ),
      decls: tree.typeParamsOf(fn.typeParamsList),
      home,
      shape: this.types.store.functionShapeOf(type),
      loc: callee.loc,
      typeArgs: tree.typeRefsOf(callee.typeArgsList),
      isLenient: this.types.isLibraryModule(home),
    };
  }

  private takenFrom(object: Expr, module: int): void {
    const key = this.pathKey(object, module);
    if (key != undefined) {
      this.forgetAllLengths();
    }
  }

  private changedArguments(expr: CallExpr, module: int): void {
    const tree = this.types.program.tree;

    const args = tree.argumentsOf(expr.argsList);

    this.forgetLengths(args, module);
    this.forgetAllLengths();
  }

  private genericResult(
    expr: CallExpr,
    generic: Own<GenericTarget>,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const isLenient = generic.isLenient;
    if (isLenient) {
      this.lenientCalls.add(expr.id);
    }

    const result = this.genericCall(
      generic,
      expr.argsList,
      tree.argumentsOf(expr.argsList),
      wanted,
      module,
    );

    if (!isLenient) {
      this.changedArguments(expr, module);
    }

    if (isLenient && this.types.isOpaqueResult(result)) {
      return this.types.store.plain(TypeKind.Error);
    }

    return result;
  }

  private readonly isCallable(fn: FunctionDecl, module: int): boolean {
    if (this.isOverloaded(fn, module)) {
      return false;
    }
    if (fn.bodySource == BodySource.Written) {
      return true;
    }

    if (fn.bodySource == BodySource.Foreign) {
      return true;
    }

    return (
      fn.bodySource == BodySource.External &&
      this.types.isLibraryModule(module)
    );
  }

  private readonly isOverloaded(fn: FunctionDecl, module: int): boolean {
    const tree = this.types.program.tree;

    const items =
      tree.stmtsOf(this.types.program.modules[module]?.file.itemsList) ?? [];
    const same = items.filter(
      (item) => item.kind == StmtKind.Function && item.name == fn.name,
    );

    return same.length > 1;
  }

  private valueCall(expr: CallExpr, module: int): Type {
    const tree = this.types.program.tree;

    const callee = tree.exprOf(expr.calleeId);
    const type = this.typed(callee, undefined, module);
    const link = this.linkOf(type, expr.optional);

    return this.calledValue(expr, link, module);
  }

  private calledValue(expr: CallExpr, type: Type, module: int): Type {
    const tree = this.types.program.tree;

    const callee = tree.exprOf(expr.calleeId);
    const loc = callee.loc;

    if (type.kind == TypeKind.Function) {
      return this.calledWith(expr, type, loc, CallKind.Own, module);
    }
    if (type.kind == TypeKind.Union && this.types.isOptionalFunction(type)) {
      this.errors.write(module, loc, Code.FunctionMayBeUndefined, kNoDetails);
      const args = tree.argumentsOf(expr.argsList);

      this.looseArguments(args, module);

      return this.types.store.plain(TypeKind.Error);
    }
    if (!this.types.isUncallable(type)) {
      return this.types.store.plain(TypeKind.Error);
    }

    const first = this.types.typeText(type);

    if (callee.kind == ExprKind.Name) {
      const word = callee.name;

      this.errors.write(module, loc, Code.NotFunction, { word, first });
    } else {
      this.errors.write(module, loc, Code.NotCallable, { first });
    }

    const argsItem = tree.argumentsOf(expr.argsList);

    this.looseArguments(argsItem, module);

    return this.types.store.plain(TypeKind.Error);
  }

  private calledWith(
    expr: CallExpr,
    type: FunctionType,
    loc: int,
    kind: CallKind,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const isLenient = kind != CallKind.Own;
    const positions = replace(this.positionMask, []);
    const method = this.positionMethod;
    const shape = this.types.store.functionShapeOf(type);

    this.positionMethod = "";

    if (shape.self != undefined) {
      this.errors.write(module, loc, Code.FunctionTakesThis, kNoDetails);
      const args = tree.argumentsOf(expr.argsList);

      this.looseArguments(args, module);

      return shape.result;
    }

    const params = shape.params.slice();
    const rest = shape.rest;
    const isOpen = this.types.isOpenRest(params, rest);
    const isChecked = kind != CallKind.Own;
    const isPlainRest = !rest || this.types.isPlainRest(params);
    const isStrict =
      isChecked && isPlainRest && this.types.isStrictShape(params);
    const isLoose = (isLenient && !isStrict) || isOpen;
    const call: CallTarget = {
      params,
      rest,
      loc,
      isLenient: isLoose,
      kind,
      positions,
      method,
      isCounted: isChecked && !isOpen,
    };

    if (isLenient) {
      this.lenientCalls.add(expr.id);
    }
    if (this.spreadRefused(expr, kind, method, module)) {
      return this.types.store.plain(TypeKind.Error);
    }

    const isPassed = this.argumentsCheck(
      expr.argsList,
      tree.argumentsOf(expr.argsList),
      call,
      module,
    );
    const isUnknown = isLenient && this.types.isOpaqueResult(shape.result);
    if (!isPassed || isUnknown) {
      return this.types.store.plain(TypeKind.Error);
    }

    return shape.result;
  }

  private spreadRefused(
    expr: CallExpr,
    kind: CallKind,
    method: string,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const spread = tree.argumentsOf(expr.argsList).find((arg) => arg.spread);
    if (spread == undefined) {
      return false;
    }

    const isPositional = kind == CallKind.Positional && method != kPushName;
    const isStatic = kind == CallKind.Library && kTextStatics.includes(method);
    if (!isPositional && !isStatic) {
      return false;
    }

    this.errors.write(
      module,
      tree.exprOf(spread.exprId).loc,
      Code.SpreadNotRest,
      kNoDetails,
    );
    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args, module);

    return true;
  }
}
