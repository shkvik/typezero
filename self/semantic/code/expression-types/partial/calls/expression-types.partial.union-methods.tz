import { ExpressionTypes } from "../../expression-types.tz";
import {
  CallExpr,
  MemberExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  FunctionType,
  ObjectType,
  Type,
  TypeKind,
  UnionType,
} from "../../../../../program/type/types/type.types.tz";
import { CallKind } from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private unionShapeCall(
    expr: CallExpr,
    member: MemberExpr,
    object: UnionType,
    common: Type | undefined,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const parts = this.shapeParts(object);
    if (common != undefined || parts == undefined) {
      return undefined;
    }

    const shared = this.sharedMethod(member, object, parts, module);
    if (shared == undefined) {
      const args = tree.argumentsOf(expr.argsList);

      this.looseArguments(args, module);

      return this.types.store.plain(TypeKind.Error);
    }

    return this.calledWith(expr, shared, member.loc, CallKind.Own, module);
  }

  private readonly shapeParts(object: UnionType): ObjectType[] | undefined {
    const parts: ObjectType[] = [];

    for (const part of this.types.store.partsOf(object)) {
      if (part.kind != TypeKind.Object || this.types.isLibraryShape(part)) {
        return undefined;
      }

      parts.push(part);
    }

    if (this.types.sharedTag(object) != undefined) {
      return undefined;
    }

    return parts;
  }

  private sharedMethod(
    member: MemberExpr,
    object: UnionType,
    parts: Read<ObjectType[]>,
    module: int,
  ): FunctionType | undefined {
    const checked = this.types.sharedMethod(member, object, parts);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }
}
