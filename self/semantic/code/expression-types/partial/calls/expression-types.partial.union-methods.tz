import { ExpressionTypes } from "../../expression-types.tz";
import {
  CallExpr,
  MemberExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  FunctionType,
  ObjectType,
  Type,
  TypeKind,
  UnionType,
} from "../../../../../program/type/types/type.types.tz";
import { CallKind } from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private unionShapeCall(
    expr: CallExpr,
    member: MemberExpr,
    object: UnionType,
    common: Type | undefined,
    module: int,
  ): Type | undefined {
    const parts = this.shapeParts(object);
    if (common != undefined || parts == undefined) {
      return undefined;
    }

    const shared = this.sharedMethod(member, object, parts, module);
    if (shared == undefined) {
      this.looseArguments(expr.args, module);

      return this.store.plain(TypeKind.Error);
    }

    return this.calledWith(expr, shared, member.loc, CallKind.Own, module);
  }

  private shapeParts(object: UnionType): ObjectType[] | undefined {
    const parts: ObjectType[] = [];

    for (const part of object.parts) {
      if (part.kind != TypeKind.Object || this.resolver.isLibraryShape(part)) {
        return undefined;
      }

      parts.push(part);
    }

    if (this.mismatches.sharedTag(object) != undefined) {
      return undefined;
    }

    return parts;
  }

  private sharedMethod(
    member: MemberExpr,
    object: UnionType,
    parts: ObjectType[],
    module: int,
  ): FunctionType | undefined {
    const checked = this.calls.sharedMethod(member, object, parts);

    this.reportFound(module, checked.error);

    return checked.value;
  }
}
