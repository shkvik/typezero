import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  ArrayLitExpr,
  CallArgument,
  ExprKind,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import {
  FunctionParameter,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  kRoundingNames,
  kNoPlace,
} from "../../const/expression-types.const.tz";
import {
  ArgumentSlot,
  CallKind,
  CallTarget,
} from "../../types/expression-types.types.tz";
import { AstList } from "../../../../../program/ast/types/ast.types.span.tz";
import {
  SyntheticNode,
} from "../../../../../program/ast/ast-tree/types/ast-tree.types.synthetic.tz";

partial class ExpressionTypes {
  private argumentsCheck(
    list: AstList | undefined,
    args: Read<CallArgument[]>,
    target: Read<CallTarget>,
    module: int,
  ): boolean {
    if (this.listArgumentsCheck(args, target, module)) {
      return true;
    }
    if (target.isLenient && this.countCheck(args, target, module)) {
      return true;
    }
    if (target.isLenient) {
      this.closureArguments(args, target, module);

      return true;
    }

    const slots = this.argumentSlots(args, module);
    const params = target.params;
    const fixed = this.types.callFixedCount(target);
    const limit = this.types.spreadLimit(target, fixed, slots.length);
    const spread = slots.find((slot, index) => slot.spread && index < limit);
    if (spread != undefined) {
      this.errors.write(
        module,
        spread.expr.loc,
        Code.SpreadNotRest,
        kNoDetails,
      );
      this.looseArguments(args, module);

      return false;
    }

    const least = this.types.leastArguments(target);
    const count = slots.length;
    const isTooMany = !target.rest && count > params.length;
    if (count < least || isTooMany) {
      const word = this.types.argumentCountText(
        least,
        params.length,
        target.rest,
      );
      const other = `${count}`;

      if (target.isTagged ?? false) {
        this.errors.write(module, target.loc, Code.TaggedArgumentCount, {
          word,
          other,
          place: this.types.taggedPlace(count),
        });
      } else {
        this.errors.write(module, target.loc, Code.ArgumentCount, {
          word,
          other,
        });
      }

      this.looseArguments(args, module);

      return true;
    }

    for (let index = 0; index < fixed; index++) {
      const slot = slots[index];
      const param = params[index];
      if (slot != undefined && param != undefined) {
        this.kindArgumentCheck(slot, param, index, target, module);
      }
    }

    const restParam = params[fixed];
    if (target.rest && restParam != undefined) {
      const rest = slots.slice(fixed);

      const restList = this.restList(list, fixed, rest.length);

      this.restCheck(rest, restList, restParam.type, target.loc, module);
    }

    return true;
  }

  private countCheck(
    args: Read<CallArgument[]>,
    target: Read<CallTarget>,
    module: int,
  ): boolean {
    const isSpread = args.some((arg) => arg.spread);
    if (!(target.isCounted ?? false) || isSpread) {
      return false;
    }

    const params = target.params;
    const least = this.types.leastArguments(target);
    const count = args.length;
    const isTooMany = !target.rest && count > params.length;
    if (count >= least && !isTooMany) {
      return false;
    }

    const word = this.types.argumentCountText(
      least,
      params.length,
      target.rest,
    );
    const other = `${count}`;

    this.errors.write(module, target.loc, Code.ArgumentCount, { word, other });
    this.looseArguments(args, module);

    return true;
  }

  private closureArguments(
    args: Read<CallArgument[]>,
    target: Read<CallTarget>,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    for (let index = 0; index < args.length; index++) {
      const arg = args[index];
      const param = target.params[index];
      if (arg != undefined && param != undefined && !arg.spread) {
        const expr = tree.exprOf(arg.exprId);

        this.lenientClosure(expr, param.type, module);
      }
    }
  }

  private argumentSlots(
    args: Read<CallArgument[]>,
    module: int,
  ): ArgumentSlot[] {
    const tree = this.types.program.tree;

    const slots: ArgumentSlot[] = [];

    for (const arg of args) {
      const items = this.spreadItems(arg, module);
      if (items == undefined) {
        const exprExpr = tree.exprOf(arg.exprId);

        slots.push({ expr: exprExpr, spread: arg.spread });

        continue;
      }

      for (const item of items) {
        slots.push({
          expr: tree.exprOf(arg.exprId),
          spread: false,
          element: item,
        });
      }
    }

    return slots;
  }

  private spreadItems(arg: CallArgument, module: int): Type[] | undefined {
    const tree = this.types.program.tree;

    const expr = tree.exprOf(arg.exprId);
    if (!arg.spread || expr.kind != ExprKind.Name) {
      return undefined;
    }

    const target = this.targetOfName(expr, module);
    const isValue =
      target != undefined &&
      (target.kind == SymbolKind.Variable ||
        target.kind == SymbolKind.Parameter);
    if (!isValue) {
      return undefined;
    }

    const type = this.typed(expr, undefined, module);
    const isFixed =
      type.kind == TypeKind.Tuple &&
      type.rest < 0 &&
      type.required == this.types.store.itemsOf(type).length;
    if (!isFixed || type.kind != TypeKind.Tuple) {
      return undefined;
    }

    return this.types.store.itemsOf(type);
  }

  private kindArgumentCheck(
    slot: ArgumentSlot,
    param: FunctionParameter,
    index: int,
    target: Read<CallTarget>,
    module: int,
  ): void {
    const wanted = this.types.parameterWanted(param);
    const kind = target.kind ?? CallKind.Own;
    const isPlain = slot.element == undefined && !slot.spread;
    if (
      isPlain &&
      this.iterableArgumentCheck(slot, param.type, target, module)
    ) {
      return;
    }
    if (kind == CallKind.Own || !isPlain) {
      return this.argumentCheck(slot, wanted, module);
    }
    if (this.isEncodingParam(param.type)) {
      return this.encodingArgumentCheck(slot.expr, module);
    }
    if (slot.expr.kind == ExprKind.Undefined && param.optional) {
      return this.argumentCheck(slot, wanted, module);
    }

    const to = param.type;
    const base = this.types.definedType(to);
    const isMarked = target.positions?.[index] ?? false;
    const isPosition = kind == CallKind.Positional && isMarked;
    const isMath = kind == CallKind.Math && base.kind == TypeKind.Double;
    if (isPosition) {
      return this.positionCheck(slot, to, target.method ?? "", module);
    }
    if (isMath) {
      return this.mathArgumentCheck(slot, to, target.method ?? "", module);
    }

    this.argumentCheck(slot, to, module);
  }

  private positionCheck(
    slot: ArgumentSlot,
    to: Type,
    method: string,
    module: int,
  ): void {
    const given = this.typed(slot.expr, to, module);
    const base = this.types.apparent(this.types.definedType(given));
    if (given.kind == TypeKind.Error) {
      return;
    }
    if (base.kind == TypeKind.Int && !this.types.isOptional(given)) {
      return this.coerce(slot.expr, given, to, module, kNoPlace);
    }

    const code = this.types.positionCode(given, base);
    const word = this.types.typeText(given);

    this.errors.write(module, slot.expr.loc, code, { word });
    const positionUseErrors = this.types.positionUseErrors(slot, word, method);

    this.errors.writeAll(module, positionUseErrors);
  }

  private mathArgumentCheck(
    slot: ArgumentSlot,
    to: Type,
    method: string,
    module: int,
  ): void {
    const given = this.typed(slot.expr, to, module);
    if (given.kind == TypeKind.Error) {
      return;
    }

    const base = this.types.apparent(this.types.definedType(given));
    const isRounding = kRoundingNames.includes(method);
    if (
      base.kind == TypeKind.Int &&
      isRounding &&
      !this.types.isOptional(given)
    ) {
      this.errors.write(module, slot.expr.loc, Code.MathRoundsInteger, {
        word: method,
        first: this.types.typeText(given),
      });

      return;
    }
    if (base.kind == TypeKind.Int && !this.types.isOptional(given)) {
      return this.coerce(slot.expr, given, to, module, kNoPlace);
    }
    if (this.types.converts(given, to)) {
      return;
    }
    if (this.literalTarget(slot.expr, given, to, module) != undefined) {
      return;
    }

    const code = this.types.mathArgumentCode(given, base);

    this.errors.write(module, slot.expr.loc, code, {
      word: this.types.typeText(given),
    });
  }

  private argumentCheck(slot: ArgumentSlot, to: Type, module: int): void {
    const element = slot.element;
    if (element != undefined) {
      return this.coerce(slot.expr, element, to, module, kNoPlace);
    }
    if (to.kind == TypeKind.Error) {
      this.typed(slot.expr, undefined, module);

      return;
    }

    this.checked(slot.expr, to, module, kNoPlace);
  }

  private listArgumentsCheck(
    args: Read<CallArgument[]>,
    target: Read<CallTarget>,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const only = target.params[0];
    if (!target.rest || target.params.length != 1 || only == undefined) {
      return false;
    }

    const slots: ArgumentSlot[] = args.map((arg) => ({
      expr: tree.exprOf(arg.exprId),
      spread: arg.spread,
    }));

    return this.listRestCheck(slots, only.type, target.loc, module);
  }

  private listRestCheck(
    slots: Read<ArgumentSlot[]>,
    to: Type,
    loc: int,
    module: int,
  ): boolean {
    const parts = this.listParts(to);
    if (parts.length == 0) {
      return false;
    }

    const given = slots.map((slot) => this.typed(slot.expr, undefined, module));
    const word = this.types.typeText(to);

    for (let index = 0; index < slots.length; index++) {
      const slot = slots[index];
      const type = given[index];
      const part = parts[index];
      if (slot == undefined || type == undefined) {
        continue;
      }
      if (part == undefined) {
        this.errors.write(module, slot.expr.loc, Code.ListArgumentsMany, {
          word,
        });

        return true;
      }

      const isList = this.types.isListParameter(part);
      if (slot.spread && type.id != part.id) {
        this.errors.write(module, slot.expr.loc, Code.ListSpreadWrong, {
          word: this.types.typeText(type),
          first: word,
          other: this.listPartText(part),
        });

        return true;
      }
      if (!slot.spread && isList) {
        this.errors.write(module, slot.expr.loc, Code.ListNotSpread, {
          word: this.types.typeText(part),
        });

        return true;
      }
    }

    const missing = parts[slots.length];
    if (missing != undefined) {
      this.errors.write(module, loc, Code.ListMissing, {
        word,
        other: this.listPartText(missing),
      });
    }

    return true;
  }

  private readonly listParts(to: Type): Type[] {
    if (to.kind == TypeKind.TypeParameter && this.types.isListParameter(to)) {
      return [to];
    }
    if (to.kind != TypeKind.Tuple) {
      return [];
    }

    const hasList = this.types.store
      .itemsOf(to)
      .some((item) => this.types.isListParameter(item));
    if (!hasList) {
      return [];
    }

    return this.types.store.itemsOf(to);
  }

  private readonly listPartText(part: Type): string {
    const name = this.types.typeText(part);
    if (this.types.isListParameter(part)) {
      return `'...${name}'`;
    }

    return `'${name}'`;
  }

  private restCheck(
    slots: Read<ArgumentSlot[]>,
    list: AstList | undefined,
    to: Type,
    loc: int,
    module: int,
  ): void {
    if (to.kind == TypeKind.Error) {
      for (const slot of slots) {
        this.typed(slot.expr, undefined, module);
      }

      return;
    }

    const isExpanded = slots.some((slot) => slot.element != undefined);
    if (isExpanded || list == undefined) {
      return this.restSlotsCheck(slots, to, module);
    }

    const tree = this.types.program.tree;
    const first = slots[0];
    const base = first?.expr.id ?? 0;
    const id = tree.syntheticId(SyntheticNode.RestArguments, base);
    const literal: ArrayLitExpr = {
      kind: ExprKind.ArrayLit,
      id,
      loc: first?.expr.loc ?? loc,
      elementsList: list,
    };

    this.checked(literal, to, module, kNoPlace);
  }

  private restSlotsCheck(
    slots: Read<ArgumentSlot[]>,
    to: Type,
    module: int,
  ): void {
    const item = this.types.restItem(to);

    for (const slot of slots) {
      if (slot.spread) {
        this.checked(slot.expr, to, module, kNoPlace);
      } else {
        this.argumentCheck(slot, item, module);
      }
    }
  }

  private looseArguments(args: Read<CallArgument[]>, module: int): void {
    const tree = this.types.program.tree;

    for (const arg of args) {
      const expr = tree.exprOf(arg.exprId);

      this.typed(expr, undefined, module);
    }
  }

  private readonly restList(
    list: AstList | undefined,
    fixed: int,
    count: int,
  ): AstList | undefined {
    if (list == undefined || list.end - list.start != fixed + count) {
      return undefined;
    }

    return { start: list.start + fixed, end: list.end };
  }
}
