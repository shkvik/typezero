import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  CallArgument,
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  NameExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import {
  FunctionType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  kArgumentsName,
  kCallbackOrdinals,
  kFunctionValueNames,
  kFunctionValueStatics,
  kHolderNames,
  kOkValueNames,
  kTestingCallbacks,
} from "../../const/expression-types.const.tz";
import {
  ArrayCallback,
  CallbackPlan,
} from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private callbackArgumentsCheck(
    expr: CallExpr,
    plan: CallbackPlan,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const member = plan.member;
    const word = member.name;
    const count = tree.argumentsOf(expr.argsList).length;
    const isReduce = plan.kind == ArrayCallback.Reduce;

    if (count == 0) {
      return this.errors.write(module, member.loc, Code.CallbackMissing, {
        word,
      });
    }

    const extraCallbackArgumentsError = this.types.extraCallbackArgumentsError(
      expr,
      plan,
    );

    this.errors.writeFound(module, extraCallbackArgumentsError);

    const first = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (first != undefined) {
      plan.isValue = this.functionValueCheck(first, plan, module);
      this.booleanCallbackCheck(first, plan, module);
    }
  }

  private functionValueCheck(
    arg: Expr,
    plan: Read<CallbackPlan>,
    module: int,
  ): boolean {
    const name = this.functionValueName(arg, module);
    const most = this.functionValueLimit(arg, module);
    if (name == undefined || most == undefined) {
      return false;
    }

    const offered = Math.min(most, this.types.offeredCount(plan.kind));
    const primary = this.types.primaryCount(plan.kind);
    if (offered <= primary) {
      return true;
    }

    const method = plan.member.name;

    this.errors.write(module, arg.loc, Code.CallbackValueExtra, {
      word: name,
      other: this.types.callbackArgumentName(plan.kind, primary),
      first: kCallbackOrdinals[primary] ?? "",
      second: method,
      place: this.types.callbackShapeText(plan.kind),
    });

    return true;
  }

  private readonly functionValueName(
    arg: Expr,
    module: int,
  ): string | undefined {
    const tree = this.types.program.tree;

    if (arg.kind == ExprKind.Name && this.isGlobalUse(arg, module)) {
      return arg.name;
    }
    if (arg.kind != ExprKind.Member) {
      return undefined;
    }

    const object = tree.exprOf(arg.objectId);
    if (object.kind != ExprKind.Name || !this.isGlobalUse(object, module)) {
      return undefined;
    }

    return `${object.name}.${arg.name}`;
  }

  private readonly functionValueLimit(arg: Expr, module: int): int | undefined {
    const name = this.functionValueName(arg, module);
    if (name == undefined) {
      return undefined;
    }

    return kFunctionValueNames.get(name) ?? kFunctionValueStatics.get(name);
  }

  private readonly isGlobalUse(expr: NameExpr, module: int): boolean {
    const use = this.record(module)?.uses.get(expr.loc);

    return use != undefined && use.symbol == undefined;
  }

  private callbackResultCheck(
    expr: CallExpr,
    plan: Read<CallbackPlan>,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const arg = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (arg == undefined || plan.isValue) {
      return;
    }
    if (arg.kind == ExprKind.Function) {
      this.asyncCallbackCheck(expr, arg, plan, module);

      return this.literalCallbackCheck(arg, plan, module);
    }

    const type = this.typed(arg, undefined, module);

    this.passedFunctionCheck(arg, type, plan, module);
  }

  private literalCallbackCheck(
    arg: Expr,
    plan: Read<CallbackPlan>,
    module: int,
  ): void {
    const type = this.closureTypes.get(arg.id);
    if (type == undefined || type.kind != TypeKind.Function) {
      return;
    }

    const result = this.types.store.returnTypeOf(type);
    const word = plan.member.name;

    if (plan.kind == ArrayCallback.ForEach) {
      const droppedPromiseErrors = this.types.droppedPromiseCheck(arg, result);

      return this.errors.writeAll(module, droppedPromiseErrors);
    }

    const isMapping =
      plan.kind == ArrayCallback.Map || plan.kind == ArrayCallback.FlatMap;
    const isEmpty =
      result.kind == TypeKind.Void || result.kind == TypeKind.Undefined;
    if (isMapping && isEmpty) {
      return this.errors.write(module, arg.loc, Code.CallbackNoValue, { word });
    }
    if (
      plan.kind != ArrayCallback.Compare ||
      this.types.isNumberResult(result)
    ) {
      return;
    }

    const found = this.types.typeText(result);

    this.errors.write(module, arg.loc, Code.CompareNotNumber, { word: found });
  }

  private passedFunctionCheck(
    arg: Expr,
    type: Type,
    plan: Read<CallbackPlan>,
    module: int,
  ): void {
    const method = plan.member.name;

    if (type.kind == TypeKind.Error) {
      return;
    }
    if (type.kind != TypeKind.Function) {
      const first = this.types.typeText(type);

      return this.errors.write(module, arg.loc, Code.CallbackNotFunction, {
        word: method,
        first,
      });
    }

    const name = this.callbackName(arg, module);

    if (this.types.store.hasRest(type)) {
      return this.errors.write(module, arg.loc, Code.CallbackRest, {
        word: name,
      });
    }
    if (plan.params.length == 0) {
      return;
    }
    if (this.callbackParamsCheck(arg, type, plan, name, module)) {
      return;
    }

    const least = this.types.requiredCallbackParams(type);
    if (least > plan.params.length) {
      const passes = this.types.argumentCountText(
        plan.params.length,
        plan.params.length,
        false,
      );

      return this.errors.write(module, arg.loc, Code.CallbackTooFew, {
        word: method,
        other: passes,
        first: name,
        second: `${least}`,
      });
    }

    const passedResultErrors = this.types.passedResultCheck(
      arg,
      type,
      plan,
      name,
    );

    this.errors.writeAll(module, passedResultErrors);
  }

  private readonly callbackName(arg: Expr, module: int): string {
    if (arg.kind != ExprKind.Name) {
      return "the function";
    }

    const target = this.targetOfName(arg, module);
    const isNamed =
      target?.kind == SymbolKind.Function ||
      (target?.kind == SymbolKind.Variable &&
        this.isConstFunction(target.module, target.loc));
    if (!isNamed) {
      return "the function";
    }

    return `'${arg.name}'`;
  }

  private readonly isConstFunction(module: int, loc: int): boolean {
    const tree = this.types.program.tree;

    const variable = this.record(module)?.variables.get(loc);
    const init = tree.exprAt(variable?.decl.initId);

    return variable?.isConst == true && init?.kind == ExprKind.Function;
  }

  private callbackParamsCheck(
    arg: Expr,
    type: FunctionType,
    plan: Read<CallbackPlan>,
    name: string,
    module: int,
  ): boolean {
    const method = plan.member.name;
    const params = this.types.store.paramsOf(type);
    const passed = Math.min(params.length, plan.params.length);
    const primary = this.types.primaryCount(plan.kind);
    const least = this.types.requiredCallbackParams(type);

    for (let index = 0; index < passed; index++) {
      const param = params[index];
      const given = plan.params[index];
      if (param == undefined || given == undefined) {
        continue;
      }

      const isFitting =
        param.type.id == given.id ||
        (param.optional && this.types.definedType(param.type).id == given.id);
      if (!isFitting) {
        this.errors.write(module, arg.loc, Code.CallbackParamType, {
          word: name,
          first: this.types.typeText(param.type),
          second: kCallbackOrdinals[index] ?? "next",
          other: method,
          place: this.types.typeText(given),
        });

        return true;
      }
      if (index >= primary && index >= least) {
        this.errors.write(module, arg.loc, Code.CallbackExtraParam, {
          word: name,
          other: this.types.callbackArgumentName(plan.kind, index),
          first: this.optionalParamName(arg, index, module),
          second: method,
          place: this.types.callbackShapeText(plan.kind),
        });

        return true;
      }
    }

    return false;
  }

  private readonly optionalParamName(
    arg: Expr,
    index: int,
    module: int,
  ): string {
    const tree = this.types.program.tree;

    if (arg.kind != ExprKind.Name) {
      return "";
    }

    const target = this.targetOfName(arg, module);
    if (target == undefined || target.kind != SymbolKind.Function) {
      return "";
    }

    const fn = this.record(target.module)?.functions.get(target.loc);
    const param = tree.paramsOf(fn?.paramsList)[index];
    if (param == undefined) {
      return "";
    }

    return ` '${param.name}'`;
  }

  private noteArguments(args: Read<CallArgument[]>): void {
    const tree = this.types.program.tree;

    for (const arg of args) {
      const expr = tree.exprOf(arg.exprId);

      this.argumentExprs.add(expr.id);
    }
  }

  private isLooseValue(expr: Expr, wanted: Type | undefined): boolean {
    return (
      !this.types.isFunctionWanted(wanted) && !this.argumentExprs.has(expr.id)
    );
  }

  private builtinValueCheck(
    expr: NameExpr,
    wanted: Type | undefined,
    module: int,
  ): boolean {
    const use = this.record(module)?.uses.get(expr.loc);
    if (expr.name == kArgumentsName && use?.symbol == undefined) {
      this.errors.write(module, expr.loc, Code.ArgumentsName, kNoDetails);

      return true;
    }
    if (!this.isLooseValue(expr, wanted) || !this.isGlobalUse(expr, module)) {
      return false;
    }

    const word = expr.name;
    if (kOkValueNames.includes(word)) {
      this.errors.write(module, expr.loc, Code.OkAsValue, { word });

      return true;
    }
    if (!kFunctionValueNames.has(word) || !this.types.isLooseBuiltin(word)) {
      return false;
    }

    const first = this.types.builtinResultText(word);

    this.errors.write(module, expr.loc, Code.BuiltinAsValue, { word, first });

    return true;
  }

  private builtinFunctionValue(
    expr: NameExpr,
    wanted: Type | undefined,
    module: int,
  ): Type | undefined {
    const name = expr.name;
    const isBuiltin =
      kFunctionValueNames.has(name) && !kOkValueNames.includes(name);
    if (wanted == undefined || !isBuiltin) {
      return undefined;
    }

    const goal = this.types.definedType(wanted);
    if (goal.kind != TypeKind.Function || !this.isGlobalUse(expr, module)) {
      return undefined;
    }

    const target = this.targetOfName(expr, module);
    if (target == undefined || target.kind != SymbolKind.Function) {
      return undefined;
    }

    const own = this.usedFunction(target.module, target.loc);
    if (own.kind != TypeKind.Function) {
      return undefined;
    }

    const forwardedResultError = this.types.forwardedResultCheck(
      expr,
      this.types.store.returnTypeOf(own),
      this.types.store.returnTypeOf(goal),
    );

    this.errors.writeFound(module, forwardedResultError);

    return goal;
  }

  private isHolderFunction(
    expr: MemberExpr,
    holder: string,
    module: int,
  ): boolean {
    if (kFunctionValueStatics.has(`${holder}.${expr.name}`)) {
      return true;
    }

    this.errors.beginTrial();

    const type = this.memberTyped(expr, module);

    this.errors.endTrial();

    return type.kind == TypeKind.Function;
  }

  private holderValueCheck(
    expr: MemberExpr,
    wanted: Type | undefined,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const object = tree.exprOf(expr.objectId);
    if (object.kind != ExprKind.Name || !this.isLooseValue(expr, wanted)) {
      return false;
    }
    if (!kHolderNames.includes(object.name)) {
      return false;
    }
    if (!this.isGlobalUse(object, module)) {
      return false;
    }
    if (!this.isHolderFunction(expr, object.name, module)) {
      return false;
    }

    this.errors.write(module, expr.loc, Code.StaticAsValue, {
      word: object.name,
      first: expr.name,
    });

    return true;
  }

  private asyncCallbackCheck(
    expr: CallExpr,
    arg: Expr,
    plan: Read<CallbackPlan>,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    if (arg.kind != ExprKind.Function || !tree.functionOf(arg.fnId).isAsync) {
      return;
    }

    const word = plan.member.name;
    if (kTestingCallbacks.includes(plan.kind)) {
      return this.errors.write(module, arg.loc, Code.CallbackAsyncTest, {
        word,
        first: "boolean",
      });
    }

    const initial = tree.exprAt(tree.argumentsOf(expr.argsList)[1]?.exprId);
    if (plan.kind != ArrayCallback.Reduce || initial == undefined) {
      return;
    }

    const given = this.peekType(initial, module);
    const base = this.types.definedType(given);
    const isPlain =
      base.kind != TypeKind.Promise && base.kind != TypeKind.Error;
    if (isPlain) {
      const first = this.types.typeText(given);

      this.errors.write(module, arg.loc, Code.CallbackAsyncValue, {
        word,
        first,
      });
    }
  }
}
