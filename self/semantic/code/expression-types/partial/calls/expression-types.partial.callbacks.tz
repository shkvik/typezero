import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  CallArgument,
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  NameExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { StmtKind } from "../../../../../program/ast/types/ast.types.statements.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import {
  FunctionType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  kArgumentsName,
  kCallbackMethods,
  kCallbackOrdinals,
  kFunctionValueNames,
  kFunctionValueStatics,
  kHolderNames,
  kOkValueNames,
  kUriValueNames,
} from "../../const/expression-types.const.tz";
import {
  ArrayCallback,
  CallbackPlan,
} from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private callbackPlan(
    expr: CallExpr,
    member: MemberExpr,
    object: Type,
  ): CallbackPlan | undefined {
    if (object.kind != TypeKind.Array) {
      return undefined;
    }

    const kind = kCallbackMethods.get(member.name);
    if (kind == undefined) {
      return undefined;
    }
    if (kind == ArrayCallback.Compare && expr.args.length == 0) {
      return undefined;
    }

    const params = this.callbackParams(kind, object);

    return { kind, member, array: object, params, isValue: false };
  }

  private callbackParams(kind: ArrayCallback, array: Type): Type[] {
    const item = this.elementOf(array);
    const index = this.store.integer(64, false);

    switch (kind) {
      case ArrayCallback.Compare:
        return [item, item];
      case ArrayCallback.Reduce:
        return [];
      default:
        return [item, index, array];
    }
  }

  private elementOf(array: Type): Type {
    if (array.kind != TypeKind.Array) {
      return this.store.plain(TypeKind.Error);
    }

    return array.item;
  }

  private callbackArgumentsCheck(
    expr: CallExpr,
    plan: CallbackPlan,
    module: int,
  ): void {
    const member = plan.member;
    const word = member.name;
    const count = expr.args.length;
    const isReduce = plan.kind == ArrayCallback.Reduce;

    if (count == 0) {
      return this.report(module, member.loc, Code.CallbackMissing, { word });
    }

    this.extraCallbackArguments(expr, plan, module);

    const first = expr.args[0]?.expr;
    if (first != undefined) {
      plan.isValue = this.functionValueCheck(first, plan, module);
      this.booleanCallbackCheck(first, plan, module);
    }
  }

  private extraCallbackArguments(
    expr: CallExpr,
    plan: CallbackPlan,
    module: int,
  ): void {
    const member = plan.member;
    const word = member.name;
    const count = expr.args.length;
    const isReduce = plan.kind == ArrayCallback.Reduce;
    const most = this.callbackArgumentLimit(isReduce);
    const second = expr.args[1]?.expr;
    if (count == 2 && !isReduce && second != undefined) {
      return this.report(module, second.loc, Code.CallbackThisArg, { word });
    }
    if (count <= most) {
      return;
    }

    const wanted = this.argumentCountText(1, most, false);

    this.report(module, member.loc, Code.ArgumentCount, {
      word: wanted,
      other: `${count}`,
    });
  }

  private callbackArgumentLimit(isReduce: boolean): int {
    if (isReduce) {
      return 2;
    }

    return 1;
  }

  private functionValueCheck(
    arg: Expr,
    plan: CallbackPlan,
    module: int,
  ): boolean {
    const name = this.functionValueName(arg, module);
    const most = this.functionValueLimit(arg, module);
    if (name == undefined || most == undefined) {
      return false;
    }

    const offered = Math.min(most, this.offeredCount(plan.kind));
    const primary = this.primaryCount(plan.kind);
    if (offered <= primary) {
      return true;
    }

    const method = plan.member.name;

    this.report(module, arg.loc, Code.CallbackValueExtra, {
      word: name,
      other: this.callbackArgumentName(plan.kind, primary),
      first: kCallbackOrdinals[primary] ?? "",
      second: method,
      place: this.callbackShapeText(plan.kind),
    });

    return true;
  }

  private functionValueName(arg: Expr, module: int): string | undefined {
    if (arg.kind == ExprKind.Name && this.isGlobalUse(arg, module)) {
      return arg.name;
    }
    if (arg.kind != ExprKind.Member) {
      return undefined;
    }

    const object = arg.object;
    if (object.kind != ExprKind.Name || !this.isGlobalUse(object, module)) {
      return undefined;
    }

    return `${object.name}.${arg.name}`;
  }

  private functionValueLimit(arg: Expr, module: int): int | undefined {
    const name = this.functionValueName(arg, module);
    if (name == undefined) {
      return undefined;
    }

    return kFunctionValueNames.get(name) ?? kFunctionValueStatics.get(name);
  }

  private isGlobalUse(expr: NameExpr, module: int): boolean {
    const use = this.record(module)?.uses.get(expr.loc);

    return use != undefined && use.symbol == undefined;
  }

  private offeredCount(kind: ArrayCallback): int {
    switch (kind) {
      case ArrayCallback.Compare:
        return 2;
      case ArrayCallback.Reduce:
        return 4;
      default:
        return 3;
    }
  }

  private primaryCount(kind: ArrayCallback): int {
    if (kind == ArrayCallback.Compare || kind == ArrayCallback.Reduce) {
      return 2;
    }

    return 1;
  }

  private callbackArgumentName(kind: ArrayCallback, index: int): string {
    const reduceNames = ["accumulator", "value", "index", "array"];
    const names = ["value", "index", "array"];

    if (kind == ArrayCallback.Reduce) {
      return reduceNames[index] ?? "array";
    }

    return names[index] ?? "array";
  }

  private callbackShapeText(kind: ArrayCallback): string {
    switch (kind) {
      case ArrayCallback.Reduce:
        return "(accumulator, value, index, array)";
      case ArrayCallback.Compare:
        return "(a, b)";
      default:
        return "(value, index, array)";
    }
  }

  private callbackResultCheck(
    expr: CallExpr,
    plan: CallbackPlan,
    module: int,
  ): void {
    const arg = expr.args[0]?.expr;
    if (arg == undefined || plan.isValue) {
      return;
    }
    if (arg.kind == ExprKind.Function) {
      return this.literalCallbackCheck(arg, plan, module);
    }

    const type = this.typed(arg, undefined, module);

    this.passedFunctionCheck(arg, type, plan, module);
  }

  private droppedPromiseCheck(arg: Expr, result: Type, module: int): void {
    if (arg.kind == ExprKind.Function && arg.fn.isAsync) {
      this.report(module, arg.loc, Code.AsyncCallbackDropped, kNoDetails);

      return;
    }
    const kind = this.types.definedType(result).kind;
    if (kind == TypeKind.Promise) {
      const loc = this.conciseValueLoc(arg);

      this.report(module, loc, Code.CallbackPromiseDropped, kNoDetails);
    }
    if (kind == TypeKind.Result && arg.kind == ExprKind.Function) {
      const loc = this.conciseValueLoc(arg);

      this.report(module, loc, Code.CallbackResultDropped, kNoDetails);
    }
  }

  private conciseValueLoc(arg: Expr): int {
    if (arg.kind != ExprKind.Function || !arg.fn.concise) {
      return arg.loc;
    }

    const first = arg.fn.body?.body[0];
    if (first == undefined) {
      return arg.loc;
    }
    if (first.kind != StmtKind.Return) {
      return arg.loc;
    }

    return first.value?.loc ?? arg.loc;
  }

  private literalCallbackCheck(
    arg: Expr,
    plan: CallbackPlan,
    module: int,
  ): void {
    const type = this.closureTypes.get(arg);
    if (type == undefined || type.kind != TypeKind.Function) {
      return;
    }

    const result = type.shape.result;
    const word = plan.member.name;

    if (plan.kind == ArrayCallback.ForEach) {
      return this.droppedPromiseCheck(arg, result, module);
    }

    const isMapping =
      plan.kind == ArrayCallback.Map || plan.kind == ArrayCallback.FlatMap;
    const isEmpty =
      result.kind == TypeKind.Void || result.kind == TypeKind.Undefined;
    if (isMapping && isEmpty) {
      return this.report(module, arg.loc, Code.CallbackNoValue, { word });
    }
    if (plan.kind != ArrayCallback.Compare || this.isNumberResult(result)) {
      return;
    }

    const found = this.text.of(result);

    this.report(module, arg.loc, Code.CompareNotNumber, { word: found });
  }

  private isNumberResult(result: Type): boolean {
    switch (result.kind) {
      case TypeKind.Int:
      case TypeKind.Double:
      case TypeKind.Decimal:
      case TypeKind.Error:
        return true;
      case TypeKind.Literal:
        return this.truth.isNumberMember(result);
      default:
        return false;
    }
  }

  private passedFunctionCheck(
    arg: Expr,
    type: Type,
    plan: CallbackPlan,
    module: int,
  ): void {
    const method = plan.member.name;

    if (type.kind == TypeKind.Error) {
      return;
    }
    if (type.kind != TypeKind.Function) {
      const first = this.text.of(type);

      return this.report(module, arg.loc, Code.CallbackNotFunction, {
        word: method,
        first,
      });
    }

    const name = this.callbackName(arg, module);

    if (type.shape.rest) {
      return this.report(module, arg.loc, Code.CallbackRest, { word: name });
    }
    if (plan.params.length == 0) {
      return;
    }
    if (this.callbackParamsCheck(arg, type, plan, name, module)) {
      return;
    }

    const least = this.requiredCallbackParams(type);
    if (least > plan.params.length) {
      const passes = this.argumentCountText(
        plan.params.length,
        plan.params.length,
        false,
      );

      return this.report(module, arg.loc, Code.CallbackTooFew, {
        word: method,
        other: passes,
        first: name,
        second: `${least}`,
      });
    }

    this.passedResultCheck(arg, type, plan, name, module);
  }

  private callbackName(arg: Expr, module: int): string {
    if (arg.kind != ExprKind.Name) {
      return "the function";
    }

    const target = this.targetOfName(arg, module);
    const isNamed =
      target?.kind == SymbolKind.Function ||
      (target?.kind == SymbolKind.Variable &&
        this.isConstFunction(target.module, target.loc));
    if (!isNamed) {
      return "the function";
    }

    return `'${arg.name}'`;
  }

  private isConstFunction(module: int, loc: int): boolean {
    const variable = this.record(module)?.variables.get(loc);
    const init = variable?.decl.init;

    return variable?.isConst == true && init?.kind == ExprKind.Function;
  }

  private callbackParamsCheck(
    arg: Expr,
    type: FunctionType,
    plan: CallbackPlan,
    name: string,
    module: int,
  ): boolean {
    const method = plan.member.name;
    const params = type.shape.params;
    const passed = Math.min(params.length, plan.params.length);
    const primary = this.primaryCount(plan.kind);
    const least = this.requiredCallbackParams(type);

    for (let index = 0; index < passed; index++) {
      const param = params[index];
      const given = plan.params[index];
      if (param == undefined || given == undefined) {
        continue;
      }

      const isFitting =
        param.type == given ||
        (param.optional && this.types.definedType(param.type) == given);
      if (!isFitting) {
        this.report(module, arg.loc, Code.CallbackParamType, {
          word: name,
          first: this.text.of(param.type),
          second: kCallbackOrdinals[index] ?? "next",
          other: method,
          place: this.text.of(given),
        });

        return true;
      }
      if (index >= primary && index >= least) {
        this.report(module, arg.loc, Code.CallbackExtraParam, {
          word: name,
          other: this.callbackArgumentName(plan.kind, index),
          first: this.optionalParamName(arg, index, module),
          second: method,
          place: this.callbackShapeText(plan.kind),
        });

        return true;
      }
    }

    return false;
  }

  private optionalParamName(arg: Expr, index: int, module: int): string {
    if (arg.kind != ExprKind.Name) {
      return "";
    }

    const target = this.targetOfName(arg, module);
    if (target == undefined || target.kind != SymbolKind.Function) {
      return "";
    }

    const fn = this.record(target.module)?.functions.get(target.loc);
    const param = fn?.params[index];
    if (param == undefined) {
      return "";
    }

    return ` '${param.name}'`;
  }

  private requiredCallbackParams(type: FunctionType): int {
    let least = 0;

    for (const param of type.shape.params) {
      if (param.optional) {
        break;
      }

      least += 1;
    }

    if (type.shape.rest && least > 0) {
      return least - 1;
    }

    return least;
  }

  private passedResultCheck(
    arg: Expr,
    type: FunctionType,
    plan: CallbackPlan,
    name: string,
    module: int,
  ): void {
    const method = plan.member.name;
    const result = type.shape.result;

    if (plan.kind == ArrayCallback.ForEach) {
      return this.droppedResultCheck(arg, result, name, method, module);
    }

    const wanted = this.callbackWanted(plan.kind);
    if (wanted == undefined || result == wanted) {
      return;
    }
    if (result.kind == TypeKind.Error) {
      return;
    }

    this.report(module, arg.loc, Code.CallbackReturn, {
      word: method,
      first: this.text.of(wanted),
      other: name,
      second: this.text.of(result),
    });
  }

  private callbackWanted(kind: ArrayCallback): Type | undefined {
    switch (kind) {
      case ArrayCallback.Filter:
      case ArrayCallback.Find:
      case ArrayCallback.FindIndex:
      case ArrayCallback.Test:
        return this.store.plain(TypeKind.Boolean);
      default:
        return undefined;
    }
  }

  private droppedResultCheck(
    arg: Expr,
    result: Type,
    name: string,
    method: string,
    module: int,
  ): void {
    if (result.kind == TypeKind.Result) {
      return this.report(module, arg.loc, Code.CallbackDropsResult, {
        word: name,
        other: method,
      });
    }
    if (result.kind == TypeKind.Promise) {
      this.report(module, arg.loc, Code.CallbackDropsPromise, {
        word: name,
        other: method,
      });
    }
  }

  private noteArguments(args: CallArgument[]): void {
    for (const arg of args) {
      this.argumentExprs.add(arg.expr);
    }
  }

  private isLooseValue(expr: Expr, wanted: Type | undefined): boolean {
    return !this.isFunctionWanted(wanted) && !this.argumentExprs.has(expr);
  }

  private builtinValueCheck(
    expr: NameExpr,
    wanted: Type | undefined,
    module: int,
  ): boolean {
    const use = this.record(module)?.uses.get(expr.loc);
    if (expr.name == kArgumentsName && use?.symbol == undefined) {
      this.report(module, expr.loc, Code.ArgumentsName, kNoDetails);

      return true;
    }
    if (!this.isLooseValue(expr, wanted) || !this.isGlobalUse(expr, module)) {
      return false;
    }

    const word = expr.name;
    if (kOkValueNames.includes(word)) {
      this.report(module, expr.loc, Code.OkAsValue, { word });

      return true;
    }
    if (!kFunctionValueNames.has(word) || !this.isLooseBuiltin(word)) {
      return false;
    }

    const first = this.builtinResultText(word);

    this.report(module, expr.loc, Code.BuiltinAsValue, { word, first });

    return true;
  }

  private builtinFunctionValue(
    expr: NameExpr,
    wanted: Type | undefined,
    module: int,
  ): Type | undefined {
    const name = expr.name;
    const isBuiltin =
      kFunctionValueNames.has(name) && !kOkValueNames.includes(name);
    if (wanted == undefined || !isBuiltin) {
      return undefined;
    }

    const goal = this.types.definedType(wanted);
    if (goal.kind != TypeKind.Function || !this.isGlobalUse(expr, module)) {
      return undefined;
    }

    const target = this.targetOfName(expr, module);
    if (target == undefined || target.kind != SymbolKind.Function) {
      return undefined;
    }

    const own = this.usedFunction(target.module, target.loc);
    if (own.kind != TypeKind.Function) {
      return undefined;
    }

    this.forwardedResultCheck(
      expr,
      own.shape.result,
      goal.shape.result,
      module,
    );

    return goal;
  }

  private forwardedResultCheck(
    expr: Expr,
    result: Type,
    wanted: Type,
    module: int,
  ): void {
    const isOpen =
      wanted.kind == TypeKind.Void ||
      wanted.kind == TypeKind.Error ||
      result.kind == TypeKind.Error;
    if (isOpen || this.relation.converts(result, wanted)) {
      return;
    }

    this.report(module, expr.loc, Code.NotAssignable, {
      first: this.text.of(result),
      second: this.text.of(wanted),
      place: "",
    });
  }

  private isLooseBuiltin(name: string): boolean {
    return name.startsWith("parse") || kUriValueNames.includes(name);
  }

  private builtinResultText(name: string): string {
    if (kUriValueNames.includes(name)) {
      return "string";
    }

    return "double";
  }

  private isHolderFunction(
    expr: MemberExpr,
    holder: string,
    module: int,
  ): boolean {
    if (kFunctionValueStatics.has(`${holder}.${expr.name}`)) {
      return true;
    }

    this.quiet += 1;

    const type = this.memberTyped(expr, module);

    this.quiet -= 1;

    return type.kind == TypeKind.Function;
  }

  private isFunctionWanted(wanted: Type | undefined): boolean {
    if (wanted == undefined) {
      return false;
    }

    return this.types.definedType(wanted).kind == TypeKind.Function;
  }

  private holderValueCheck(
    expr: MemberExpr,
    wanted: Type | undefined,
    module: int,
  ): boolean {
    const object = expr.object;
    if (object.kind != ExprKind.Name || !this.isLooseValue(expr, wanted)) {
      return false;
    }
    if (!kHolderNames.includes(object.name)) {
      return false;
    }
    if (!this.isGlobalUse(object, module)) {
      return false;
    }
    if (!this.isHolderFunction(expr, object.name, module)) {
      return false;
    }

    this.report(module, expr.loc, Code.StaticAsValue, {
      word: object.name,
      first: expr.name,
    });

    return true;
  }
}
