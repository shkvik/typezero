import { ExpressionTypes } from "../../expression-types.tz";
import {
  DictKind,
  FunctionType,
  ObjectType,
  Type,
  TypeKind,
  UnionType,
} from "../../../../../program/type/types/type.types.tz";
import {
  CandidateStrength,
  InferenceSet,
} from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private inferArgument(
    set: InferenceSet,
    pattern: Type,
    actual: Type,
    strength: CandidateStrength,
    isIntLiteral: boolean,
  ): void {
    set.isWeak = strength == CandidateStrength.Weak;
    set.isIntLiteral = isIntLiteral;

    this.inferPair(set, pattern, actual);

    set.isWeak = false;
    set.isIntLiteral = false;
  }

  private inferPair(set: InferenceSet, pattern: Type, actual: Type): void {
    if (actual.kind == TypeKind.Error) {
      return;
    }

    const index = set.params.findIndex((one) => one.id == pattern.id);

    if (actual.kind == TypeKind.Void) {
      return this.types.addVoid(set, index, CandidateStrength.Strong);
    }
    if (index >= 0) {
      return this.types.inferParameter(set, index, actual);
    }
    if (!this.isMentioning(pattern, set.params)) {
      return;
    }

    this.inferInside(set, pattern, actual);
  }

  private inferHeld(set: InferenceSet, pattern: Type, actual: Type): void {
    const index = set.params.findIndex((one) => one.id == pattern.id);
    if (index >= 0 && actual.kind == TypeKind.Void) {
      const strength = this.types.heldStrength(set);

      return this.types.addVoid(set, index, strength);
    }

    this.inferPair(set, pattern, actual);
  }

  private inferInside(set: InferenceSet, pattern: Type, actual: Type): void {
    if (!this.types.isSameShape(pattern, actual)) {
      set.isUnmatched = true;

      return;
    }

    switch (pattern.kind) {
      case TypeKind.Union:
        return this.inferUnion(set, pattern, actual);
      case TypeKind.Array:
        if (actual.kind == TypeKind.Array) {
          this.inferPair(
            set,
            this.types.store.itemOf(pattern),
            this.types.store.itemOf(actual),
          );
        }

        return;
      case TypeKind.Tuple:
        if (actual.kind == TypeKind.Tuple) {
          this.inferItems(
            set,
            this.types.store.itemsOf(pattern),
            this.types.store.itemsOf(actual),
          );
        }

        return;
      case TypeKind.Object:
        return this.inferObject(set, pattern, actual);
      case TypeKind.Function:
        return this.inferFunction(set, pattern, actual);
      case TypeKind.Result:
        if (actual.kind == TypeKind.Result) {
          this.inferHeld(
            set,
            this.types.store.valueOf(pattern),
            this.types.store.valueOf(actual),
          );
          this.inferPair(
            set,
            this.types.store.errorOf(pattern),
            this.types.store.errorOf(actual),
          );
        }

        return;
      case TypeKind.Promise:
        if (actual.kind == TypeKind.Promise) {
          this.inferHeld(
            set,
            this.types.store.valueOf(pattern),
            this.types.store.valueOf(actual),
          );
        }

        return;
      case TypeKind.Class:
        if (actual.kind == TypeKind.Class) {
          this.inferPair(
            set,
            this.types.store.classInstanceOf(pattern),
            this.types.store.classInstanceOf(actual),
          );
        }

        return;
      default:
        return this.inferHolder(set, pattern, actual);
    }
  }

  private inferHolder(set: InferenceSet, pattern: Type, actual: Type): void {
    switch (pattern.kind) {
      case TypeKind.Iterator: {
        if (actual.kind != TypeKind.Iterator) {
          return;
        }

        const want = this.types.store.iteratorShapeOf(pattern);
        const have = this.types.store.iteratorShapeOf(actual);

        this.inferPair(set, want.yielded, have.yielded);
        this.inferPair(set, want.returned, have.returned);
        this.inferPair(set, want.sent, have.sent);

        return;
      }
      case TypeKind.Dict:
        return this.inferDict(set, pattern, actual);
      case TypeKind.Instance:
        return this.inferInstance(set, pattern, actual);
      default:
        return;
    }
  }

  private inferItems(
    set: InferenceSet,
    want: Read<Type[]>,
    have: Read<Type[]>,
  ): void {
    const shared = Math.min(want.length, have.length);

    for (let index = 0; index < shared; index++) {
      const pattern = want[index];
      const actual = have[index];
      if (pattern != undefined && actual != undefined) {
        this.inferPair(set, pattern, actual);
      }
    }
  }

  private inferUnion(
    set: InferenceSet,
    pattern: UnionType,
    actual: Type,
  ): void {
    if (this.types.isOptional(pattern)) {
      if (actual.kind == TypeKind.Undefined) {
        return;
      }

      const inner = this.types.definedType(pattern);
      const value = this.types.definedType(actual);

      return this.inferPair(set, inner, value);
    }

    const open = this.types.store
      .partsOf(pattern)
      .filter((part) => this.isMentioning(part, set.params));
    const fixed = this.types.store
      .partsOf(pattern)
      .filter((part) => !this.isMentioning(part, set.params));
    const first = open[0];

    if (open.length > 1) {
      return this.inferMember(set, open, actual);
    }
    if (first == undefined) {
      return;
    }

    const value = this.types.definedType(actual);
    const members = this.types.partsOfType(value);
    const rest = members.filter(
      (member) => !fixed.some((one) => one.id == member.id),
    );
    if (rest.length == 0) {
      return;
    }

    const joined = this.types.store.unionOf(rest);

    this.inferPair(set, first, joined);
  }

  private inferMember(
    set: InferenceSet,
    open: Read<Type[]>,
    actual: Type,
  ): void {
    const value = this.types.definedType(actual);

    for (const member of open) {
      if (this.types.isInstanceOfMember(value, member)) {
        return this.inferPair(set, member, value);
      }
    }
  }

  private inferInstance(set: InferenceSet, pattern: Type, actual: Type): void {
    if (
      pattern.kind != TypeKind.Instance ||
      this.types.store.argsOf(pattern).length == 0
    ) {
      return;
    }

    const found = this.types.sameClassIn(actual, pattern);
    if (found == undefined || found.kind != TypeKind.Instance) {
      return;
    }

    this.inferItems(
      set,
      this.types.store.argsOf(pattern),
      this.types.store.argsOf(found),
    );
  }

  private inferObject(
    set: InferenceSet,
    pattern: ObjectType,
    actual: Type,
  ): void {
    if (actual.kind != TypeKind.Object) {
      return;
    }

    const key = `${pattern.id} ${actual.id}`;
    if (set.visited.has(key)) {
      return;
    }

    set.visited.add(key);

    for (const field of this.types.store.fieldsOf(pattern)) {
      const own = this.types.store
        .fieldsOf(actual)
        .find((one) => one.name == field.name);
      if (own != undefined) {
        this.inferPair(set, field.type, own.type);
      }
    }
  }

  private inferFunction(
    set: InferenceSet,
    pattern: FunctionType,
    actual: Type,
  ): void {
    if (actual.kind != TypeKind.Function) {
      return;
    }

    const want = this.types.store.functionShapeOf(pattern);
    const have = this.types.store.functionShapeOf(actual);
    const wanted = want.params.map((param) => param.type);
    const given = have.params.map((param) => param.type);

    this.inferItems(set, wanted, given);

    const returned = set.params.findIndex((one) => one.id == want.result.id);
    if (returned >= 0 && have.result.kind == TypeKind.Void) {
      return this.types.addVoid(set, returned, CandidateStrength.Strong);
    }
    if (want.result.kind != TypeKind.Void) {
      this.inferPair(set, want.result, have.result);
    }
  }

  private inferDict(set: InferenceSet, pattern: Type, actual: Type): void {
    if (pattern.kind != TypeKind.Dict) {
      return;
    }

    const isRecord = pattern.dict == DictKind.Record;
    if (isRecord && actual.kind == TypeKind.Object) {
      for (const field of this.types.store.fieldsOf(actual)) {
        this.inferPair(set, this.types.store.valueOf(pattern), field.type);
      }

      return;
    }
    if (actual.kind != TypeKind.Dict || actual.dict != pattern.dict) {
      return;
    }

    this.inferPair(
      set,
      this.types.store.keyOf(pattern),
      this.types.store.keyOf(actual),
    );
    this.inferPair(
      set,
      this.types.store.valueOf(pattern),
      this.types.store.valueOf(actual),
    );
  }

  private readonly isMentioning(type: Type, params: Read<Type[]>): boolean {
    const ids = new Set<int>();

    for (const param of params) {
      ids.add(param.id);
    }

    return this.types.mentions(type, ids);
  }
}
