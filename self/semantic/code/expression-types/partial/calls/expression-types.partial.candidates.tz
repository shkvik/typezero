import { ExpressionTypes } from "../../expression-types.tz";
import {
  DictKind,
  FunctionType,
  ObjectType,
  Type,
  TypeKind,
  UnionType,
} from "../../../../../program/type/types/type.types.tz";
import {
  CandidateStrength,
  InferenceSet,
} from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private readonly inferArgument(
    set: InferenceSet,
    pattern: Type,
    actual: Type,
    strength: CandidateStrength,
    isIntLiteral: boolean,
  ): void {
    set.isWeak = strength == CandidateStrength.Weak;
    set.isIntLiteral = isIntLiteral;

    this.inferPair(set, pattern, actual);

    set.isWeak = false;
    set.isIntLiteral = false;
  }

  private readonly inferPair(set: InferenceSet, pattern: Type, actual: Type): void {
    if (actual.kind == TypeKind.Error) {
      return;
    }

    const index = set.params.indexOf(pattern);

    if (actual.kind == TypeKind.Void) {
      return this.generics.addVoid(set, index, CandidateStrength.Strong);
    }
    if (index >= 0) {
      return this.generics.inferParameter(set, index, actual);
    }
    if (!this.isMentioning(pattern, set.params)) {
      return;
    }

    this.inferInside(set, pattern, actual);
  }

  private readonly inferHeld(set: InferenceSet, pattern: Type, actual: Type): void {
    const index = set.params.indexOf(pattern);
    if (index >= 0 && actual.kind == TypeKind.Void) {
      const strength = this.generics.heldStrength(set);

      return this.generics.addVoid(set, index, strength);
    }

    this.inferPair(set, pattern, actual);
  }

  private readonly inferInside(set: InferenceSet, pattern: Type, actual: Type): void {
    if (!this.generics.isSameShape(pattern, actual)) {
      set.isUnmatched = true;

      return;
    }

    switch (pattern.kind) {
      case TypeKind.Union:
        return this.inferUnion(set, pattern, actual);
      case TypeKind.Array:
        if (actual.kind == TypeKind.Array) {
          this.inferPair(set, pattern.item, actual.item);
        }

        return;
      case TypeKind.Tuple:
        if (actual.kind == TypeKind.Tuple) {
          this.inferItems(set, pattern.items, actual.items);
        }

        return;
      case TypeKind.Object:
        return this.inferObject(set, pattern, actual);
      case TypeKind.Function:
        return this.inferFunction(set, pattern, actual);
      case TypeKind.Result:
        if (actual.kind == TypeKind.Result) {
          this.inferHeld(set, pattern.value, actual.value);
          this.inferPair(set, pattern.error, actual.error);
        }

        return;
      case TypeKind.Promise:
        if (actual.kind == TypeKind.Promise) {
          this.inferHeld(set, pattern.value, actual.value);
        }

        return;
      case TypeKind.Class:
        if (actual.kind == TypeKind.Class) {
          this.inferPair(set, pattern.instance, actual.instance);
        }

        return;
      default:
        return this.inferHolder(set, pattern, actual);
    }
  }

  private readonly inferHolder(set: InferenceSet, pattern: Type, actual: Type): void {
    switch (pattern.kind) {
      case TypeKind.Iterator: {
        if (actual.kind != TypeKind.Iterator) {
          return;
        }

        const want = pattern.shape;
        const have = actual.shape;

        this.inferPair(set, want.yielded, have.yielded);
        this.inferPair(set, want.returned, have.returned);
        this.inferPair(set, want.sent, have.sent);

        return;
      }
      case TypeKind.Dict:
        return this.inferDict(set, pattern, actual);
      case TypeKind.Instance:
        return this.inferInstance(set, pattern, actual);
      default:
        return;
    }
  }

  private readonly inferItems(set: InferenceSet, want: Read<Type[]>, have: Read<Type[]>): void {
    const shared = Math.min(want.length, have.length);

    for (let index = 0; index < shared; index++) {
      const pattern = want[index];
      const actual = have[index];
      if (pattern != undefined && actual != undefined) {
        this.inferPair(set, pattern, actual);
      }
    }
  }

  private readonly inferUnion(
    set: InferenceSet,
    pattern: UnionType,
    actual: Type,
  ): void {
    if (this.types.isOptional(pattern)) {
      if (actual.kind == TypeKind.Undefined) {
        return;
      }

      const inner = this.types.definedType(pattern);
      const value = this.types.definedType(actual);

      return this.inferPair(set, inner, value);
    }

    const open = pattern.parts.filter((part) =>
      this.isMentioning(part, set.params),
    );
    const fixed = pattern.parts.filter(
      (part) => !this.isMentioning(part, set.params),
    );
    const first = open[0];

    if (open.length > 1) {
      return this.inferMember(set, open, actual);
    }
    if (first == undefined) {
      return;
    }

    const value = this.types.definedType(actual);
    const members = this.generics.partsOfType(value);
    const rest = members.filter((member) => !fixed.includes(member));
    if (rest.length == 0) {
      return;
    }

    const joined = this.store.unionOf(rest);

    this.inferPair(set, first, joined);
  }

  private readonly inferMember(set: InferenceSet, open: Read<Type[]>, actual: Type): void {
    const value = this.types.definedType(actual);

    for (const member of open) {
      if (this.generics.isInstanceOfMember(value, member)) {
        return this.inferPair(set, member, value);
      }
    }
  }

  private readonly inferInstance(set: InferenceSet, pattern: Type, actual: Type): void {
    if (pattern.kind != TypeKind.Instance || pattern.args.length == 0) {
      return;
    }

    const found = this.generics.sameClassIn(actual, pattern);
    if (found == undefined || found.kind != TypeKind.Instance) {
      return;
    }

    this.inferItems(set, pattern.args, found.args);
  }

  private readonly inferObject(
    set: InferenceSet,
    pattern: ObjectType,
    actual: Type,
  ): void {
    if (actual.kind != TypeKind.Object) {
      return;
    }

    const key = `${pattern.id} ${actual.id}`;
    if (set.visited.has(key)) {
      return;
    }

    set.visited.add(key);

    for (const field of pattern.fields) {
      const own = actual.fields.find((one) => one.name == field.name);
      if (own != undefined) {
        this.inferPair(set, field.type, own.type);
      }
    }
  }

  private readonly inferFunction(
    set: InferenceSet,
    pattern: FunctionType,
    actual: Type,
  ): void {
    if (actual.kind != TypeKind.Function) {
      return;
    }

    const want = pattern.shape;
    const have = actual.shape;
    const wanted = want.params.map((param) => param.type);
    const given = have.params.map((param) => param.type);

    this.inferItems(set, wanted, given);

    const returned = set.params.indexOf(want.result);
    if (returned >= 0 && have.result.kind == TypeKind.Void) {
      return this.generics.addVoid(set, returned, CandidateStrength.Strong);
    }
    if (want.result.kind != TypeKind.Void) {
      this.inferPair(set, want.result, have.result);
    }
  }

  private readonly inferDict(set: InferenceSet, pattern: Type, actual: Type): void {
    if (pattern.kind != TypeKind.Dict) {
      return;
    }

    const isRecord = pattern.dict == DictKind.Record;
    if (isRecord && actual.kind == TypeKind.Object) {
      for (const field of actual.fields) {
        this.inferPair(set, pattern.value, field.type);
      }

      return;
    }
    if (actual.kind != TypeKind.Dict || actual.dict != pattern.dict) {
      return;
    }

    this.inferPair(set, pattern.key, actual.key);
    this.inferPair(set, pattern.value, actual.value);
  }

  private readonly isMentioning(type: Type, params: Read<Type[]>): boolean {
    const ids = new Set<int>();

    for (const param of params) {
      ids.add(param.id);
    }

    return this.resolver.mentions(type, ids);
  }
}
