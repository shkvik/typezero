import { ExpressionTypes } from "../../expression-types.tz";
import {
  CallExpr,
  ExprKind,
  MemberExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  FunctionType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { CallKind } from "../../types/expression-types.types.tz";
import {
  SyntheticNode,
} from "../../../../../program/ast/ast-tree/types/ast-tree.types.synthetic.tz";
import { AstList } from "../../../../../program/ast/types/ast.types.span.tz";

partial class ExpressionTypes {
  private thisMethodCall(
    expr: CallExpr,
    member: MemberExpr,
    type: FunctionType,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const word = member.name;
    const error = this.types.store.plain(TypeKind.Error);
    const code = this.types.thisCallProblem(expr, word);
    if (code != undefined) {
      this.errors.write(module, member.loc, code, {
        word,
        other: this.types.thisCallTail(word),
      });
      const args = tree.argumentsOf(expr.argsList);

      this.looseArguments(args, module);

      return error;
    }
    if (word == "apply") {
      const argsItem = tree.argumentsOf(expr.argsList);

      this.looseArguments(argsItem, module);

      return this.types.store.returnTypeOf(type);
    }

    const first = tree.argumentsOf(expr.argsList)[0];
    if (first != undefined) {
      this.typed(
        tree.exprOf(first.exprId),
        this.types.store.selfTypeOf(type),
        module,
      );
    }

    const id = tree.syntheticId(SyntheticNode.ThisCallRest, expr.id);
    const argsList = this.listAfterFirst(expr.argsList);
    const rest: CallExpr = {
      kind: ExprKind.Call,
      id,
      loc: expr.loc,
      calleeId: expr.calleeId,
      argsList,
      optional: expr.optional,
      tagged: false,
    };
    const shape = this.types.store.functionShapeOf(type);
    const plain = this.types.store.functionOf({
      params: shape.params,
      rest: shape.rest,
      result: shape.result,
    });
    if (plain.kind != TypeKind.Function) {
      return error;
    }

    return this.calledWith(rest, plain, member.loc, CallKind.Own, module);
  }

  private readonly listAfterFirst(list: AstList): AstList {
    if (list.start >= list.end) {
      return list;
    }

    return { start: list.start + 1, end: list.end };
  }
}
