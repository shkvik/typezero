import { ExpressionTypes } from "../expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import { messageText } from "../../../../diagnostic/message.tz";
import { Details } from "../../../../diagnostic/types/message.types.tz";
import {
  BinaryExpr,
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  UnaryExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { ForOfStmt } from "../../../../program/ast/types/ast.types.statements.tz";
import {
  DictKind,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import {
  kDictIterating,
  kLengthName,
  kThisName,
  kUnsupportedMark,
} from "../const/expression-types.const.tz";

partial class ExpressionTypes {
  private collectionOf(type: Type): DictKind | undefined {
    const base = this.definedType(type);
    if (base.kind != TypeKind.Dict || base.dict == DictKind.Record) {
      return undefined;
    }

    return base.dict;
  }

  private collectionWord(dict: DictKind): string {
    if (dict == DictKind.Map) {
      return "Map";
    }

    return "Set";
  }

  private dictMemberCheck(
    expr: MemberExpr,
    object: Type,
    isCalled: boolean,
    module: int,
  ): boolean {
    const dict = this.collectionOf(object);
    if (dict == undefined) {
      return false;
    }

    const name = expr.name;
    const word = this.dictText(expr.object, dict);
    const first = this.text.of(object);

    if (name == kLengthName) {
      this.report(module, expr.loc, Code.DictNoLength, { word, first });

      return true;
    }
    if (isCalled) {
      return this.dictMissingCall(expr, dict, word, first, module);
    }

    const receiver = this.libraryReceiver(object);
    if (receiver == undefined) {
      return false;
    }

    const method = this.receiverMember(receiver, name, true);
    if (method == undefined || method.kind != TypeKind.Function) {
      return false;
    }

    this.report(module, expr.loc, Code.DictMethodValue, { word, other: name });

    return true;
  }

  private dictMissingCall(
    expr: MemberExpr,
    dict: DictKind,
    word: string,
    first: string,
    module: int,
  ): boolean {
    const name = expr.name;
    const isMap = dict == DictKind.Map;
    const details: Details = { word, first, other: name };

    if (isMap && name == "add") {
      this.report(module, expr.loc, Code.MapHasNoAdd, details);

      return true;
    }
    if (!isMap && (name == "set" || name == "get")) {
      this.report(module, expr.loc, Code.SetHasNoGet, details);

      return true;
    }
    if (!kDictIterating.includes(name)) {
      return false;
    }

    const place = this.iteratingSource(isMap);

    this.report(module, expr.loc, Code.DictNotIterating, {
      word,
      first,
      other: name,
      place,
    });

    return true;
  }

  private iteratingSource(isMap: boolean): string {
    if (isMap) {
      return ".entries()";
    }

    return ".values()";
  }

  private dictTargetCheck(target: Expr, module: int): boolean {
    if (target.kind != ExprKind.Member && target.kind != ExprKind.Index) {
      return false;
    }

    const holder = target.object;
    if (holder.kind == ExprKind.Name && holder.name == kThisName) {
      return false;
    }

    this.quiet += 1;

    const object = this.typed(target.object, undefined, module);

    this.quiet -= 1;

    const dict = this.collectionOf(object);
    if (dict == undefined) {
      return false;
    }

    const word = this.dictText(target.object, dict);

    if (dict == DictKind.Set) {
      return this.setTargetCheck(target, word, module);
    }

    const access = this.dictAccess(target);

    this.report(module, target.loc, Code.MapPropertySet, {
      word,
      other: access,
    });

    return true;
  }

  private dictAccess(target: Expr): string {
    if (target.kind == ExprKind.Member) {
      return `.${target.name}`;
    }

    return "[key]";
  }

  private setTargetCheck(target: Expr, word: string, module: int): boolean {
    if (target.kind == ExprKind.Index) {
      this.report(module, target.loc, Code.SetIndexSet, { word });

      return true;
    }
    if (target.kind == ExprKind.Member && target.name == "size") {
      this.report(module, target.loc, Code.SetSizeSet, { word });

      return true;
    }

    return false;
  }

  private dictDeleteCheck(expr: UnaryExpr, module: int): boolean {
    const target = expr.operand;
    if (target.kind != ExprKind.Member && target.kind != ExprKind.Index) {
      return false;
    }

    this.quiet += 1;

    const object = this.typed(target.object, undefined, module);

    this.quiet -= 1;

    const dict = this.collectionOf(object);
    if (dict == undefined) {
      return false;
    }

    const isMap = dict == DictKind.Map;

    this.report(module, expr.loc, Code.DictDelete, {
      word: this.collectionWord(dict),
      first: this.dictText(target.object, dict),
      other: this.entryPart(isMap),
    });

    return true;
  }

  private entryPart(isMap: boolean): string {
    if (isMap) {
      return "key";
    }

    return "value";
  }

  private dictInCheck(expr: BinaryExpr, object: Type, module: int): boolean {
    const dict = this.collectionOf(object);
    if (dict == undefined) {
      return false;
    }

    const isMap = dict == DictKind.Map;

    this.report(module, expr.loc, Code.DictIn, {
      word: this.collectionWord(dict),
      first: this.dictText(expr.rhs, dict),
      other: this.entryPart(isMap),
    });

    return true;
  }

  private dictKeysCheck(expr: CallExpr, module: int): void {
    const callee = expr.callee;
    const arg = expr.args[0]?.expr;
    if (callee.kind != ExprKind.Member || arg == undefined) {
      return;
    }

    const holder = callee.object;
    const isObject =
      holder.kind == ExprKind.Name &&
      holder.name == "Object" &&
      this.isGlobalUse(holder, module);
    const isListing =
      callee.name == "keys" ||
      callee.name == "values" ||
      callee.name == "entries";
    if (!isObject || !isListing) {
      return;
    }

    this.quiet += 1;

    const type = this.typed(arg, undefined, module);

    this.quiet -= 1;

    const dict = this.collectionOf(type);
    if (dict == undefined) {
      this.objectArgumentCheck(arg, type, callee.name, module);

      return this.listedFieldsCheck(arg, type, callee.name, module);
    }

    const isSetEntries = dict == DictKind.Set && callee.name == "entries";
    const method = this.listingMethod(callee.name, isSetEntries);

    this.report(module, arg.loc, Code.DictObjectEmpty, {
      word: callee.name,
      first: this.collectionWord(dict),
      second: this.dictText(arg, dict),
      other: method,
    });
  }

  private objectArgumentCheck(
    arg: Expr,
    type: Type,
    word: string,
    module: int,
  ): void {
    const base = this.definedType(type);
    const isHolder =
      base.kind == TypeKind.Object ||
      base.kind == TypeKind.Dict ||
      base.kind == TypeKind.Instance;
    if (this.isOptional(type) && isHolder) {
      this.report(module, arg.loc, Code.ObjectMaybeUndefined, kNoDetails);

      return;
    }
    if (!this.isNeverObject(type)) {
      return;
    }

    this.report(module, arg.loc, Code.ObjectNeedsObject, {
      word,
      first: this.text.of(type),
    });
  }

  private listedFieldsCheck(
    arg: Expr,
    type: Type,
    word: string,
    module: int,
  ): void {
    const base = this.apparent(type);
    const isValues = word == "values" || word == "entries";
    if (isValues && this.hasMethodFields(type)) {
      this.report(module, arg.loc, Code.ObjectListingMethods, { word });

      return;
    }
    if (!isValues || base.kind != TypeKind.Object) {
      return;
    }
    if (this.resolver.isLibraryShape(base)) {
      return;
    }

    const first = this.text.of(base);
    let element: Type | undefined = undefined;

    for (const field of base.fields) {
      const candidate = this.definedType(field.type);
      const both = this.listedElement(element, candidate);
      const problem = this.resolver.unionProblem(both);
      if (problem != undefined) {
        const full = messageText(problem.code, problem.details);
        const mark = full.indexOf(kUnsupportedMark);
        const other = full.slice(mark + kUnsupportedMark.length);

        this.report(module, arg.loc, Code.ObjectValuesNoUnion, {
          word,
          first,
          other,
        });

        return;
      }

      element = both;
    }
    if (element == undefined) {
      this.report(module, arg.loc, Code.ObjectNoFields, { word, first });
    }
  }

  private listedElement(element: Type | undefined, candidate: Type): Type {
    if (element == undefined) {
      return candidate;
    }

    return this.store.unionOf([element, candidate]);
  }

  private isNeverObject(type: Type): boolean {
    const base = this.apparent(type);

    switch (base.kind) {
      case TypeKind.Int:
      case TypeKind.Double:
      case TypeKind.Decimal:
      case TypeKind.Boolean:
      case TypeKind.String:
      case TypeKind.Template:
      case TypeKind.Array:
      case TypeKind.Tuple:
        return true;
      case TypeKind.Instance:
        return this.isBuiltinValue(base);
      default:
        return false;
    }
  }

  private listingMethod(name: string, isSetEntries: boolean): string {
    if (isSetEntries) {
      return "values";
    }

    return name;
  }

  private dictText(expr: Expr, dict: DictKind): string {
    if (expr.kind == ExprKind.Name) {
      return expr.name;
    }

    const holder = this.memberHolder(expr);
    if (holder != undefined) {
      return holder;
    }

    switch (dict) {
      case DictKind.Map:
        return "m";
      case DictKind.Set:
        return "s";
      default:
        return "r";
    }
  }

  private memberHolder(expr: Expr): string | undefined {
    if (expr.kind != ExprKind.Member) {
      return undefined;
    }

    const object = expr.object;
    if (object.kind != ExprKind.Name) {
      return undefined;
    }

    return `${object.name}.${expr.name}`;
  }
}
