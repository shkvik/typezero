import { ExpressionTypes } from "../../expression-types.tz";
import {
  ArrayLitExpr,
  Expr,
  ExprKind,
  ObjectLitExpr,
  PropertyKind,
  UnaryExpr,
  UnaryOp,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import {
  FunctionShape,
  ObjectField,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { kResultMakers } from "../../const/expression-types.const.tz";

partial class ExpressionTypes {
  private literalShapeOf(expr: Expr): Type | undefined {
    switch (expr.kind) {
      case ExprKind.IntLit:
        return this.types.store.integer(64, false);
      case ExprKind.FloatLit:
        return this.types.store.plain(TypeKind.Double);
      case ExprKind.StringLit:
        return this.types.store.plain(TypeKind.String);
      case ExprKind.BoolLit:
        return this.types.store.plain(TypeKind.Boolean);
      case ExprKind.Undefined:
        return this.types.store.plain(TypeKind.Undefined);
      case ExprKind.Unary:
        return this.signedShape(expr);
      case ExprKind.ArrayLit:
        return this.arrayShape(expr);
      case ExprKind.ObjectLit:
        return this.objectShape(expr);
      default:
        return undefined;
    }
  }

  private signedShape(expr: UnaryExpr): Type | undefined {
    const tree = this.types.program.tree;

    const operand = tree.exprOf(expr.operandId);
    const isNumber =
      operand.kind == ExprKind.IntLit || operand.kind == ExprKind.FloatLit;
    if (expr.op != UnaryOp.Neg || !isNumber) {
      return undefined;
    }

    return this.literalShapeOf(operand);
  }

  private arrayShape(expr: ArrayLitExpr): Type | undefined {
    const tree = this.types.program.tree;

    let element: Type | undefined = undefined;

    for (const item of tree.elementsOf(expr.elementsList)) {
      if (item.spread || item.hole) {
        return undefined;
      }

      const exprExpr = tree.exprOf(item.exprId);
      const shape = this.literalShapeOf(exprExpr);
      if (shape == undefined) {
        return undefined;
      }

      const joined = this.types.joinedWith(element, shape);
      if (joined == undefined) {
        return undefined;
      }

      element = joined;
    }

    if (element == undefined || element.kind == TypeKind.Undefined) {
      return undefined;
    }

    return this.types.store.arrayOf(element);
  }

  private objectShape(expr: ObjectLitExpr): Type | undefined {
    const tree = this.types.program.tree;

    const fields: ObjectField[] = [];

    for (const prop of tree.propertiesOf(expr.propsList)) {
      if (prop.form.kind != PropertyKind.Value) {
        return undefined;
      }

      const value = tree.exprOf(prop.valueId);
      const type = this.literalShapeOf(value);
      const name = prop.name;
      const isRepeated = fields.some((field) => field.name == name);
      if (type == undefined || type.kind == TypeKind.Undefined || isRepeated) {
        return undefined;
      }

      fields.push({ name, type, optional: false, readonly: false });
    }

    return this.types.store.objectOf(fields);
  }

  private readonly isContextual(expr: Expr, module: int): boolean {
    if (this.types.isNeedingContext(expr)) {
      return true;
    }

    return this.isResultMaker(expr, module) || this.isBareGeneric(expr, module);
  }

  private readonly isResultMaker(expr: Expr, module: int): boolean {
    if (expr.kind != ExprKind.Name || !kResultMakers.includes(expr.name)) {
      return false;
    }

    const target = this.targetOfName(expr, module);

    return target != undefined && this.types.isLibraryModule(target.module);
  }

  private readonly isBareGeneric(expr: Expr, module: int): boolean {
    const tree = this.types.program.tree;

    if (
      expr.kind != ExprKind.Name ||
      tree.typeRefsOf(expr.typeArgsList).length > 0
    ) {
      return false;
    }

    const target = this.targetOfName(expr, module);
    if (target == undefined || target.kind != SymbolKind.Function) {
      return false;
    }

    const fn = this.record(target.module)?.functions.get(target.loc);

    return fn != undefined && tree.typeParamsOf(fn.typeParamsList).length > 0;
  }

  private readonly hasOperationParameter(shape: Read<FunctionShape>): boolean {
    const seen = new Set<int>();

    return shape.params.some((param) =>
      this.isOperationInside(param.type, seen),
    );
  }

  private readonly isOperationInside(type: Type, seen: Set<int>): boolean {
    if (seen.has(type.id)) {
      return false;
    }

    seen.add(type.id);

    if (this.types.hasAliasOrigin(type)) {
      return false;
    }
    if (type.kind == TypeKind.Operation || type.kind == TypeKind.Template) {
      return true;
    }

    const parts = this.types.typeParts(type);

    return parts.some((part) => this.isOperationInside(part, seen));
  }

  private lenientClosure(expr: Expr, pattern: Type, module: int): void {
    if (expr.kind != ExprKind.Function) {
      return;
    }

    const wanted = this.types.definedType(pattern);
    if (
      wanted.kind != TypeKind.Function ||
      this.types.mentionsParameter(wanted)
    ) {
      return;
    }

    const shape = this.types.store.functionShapeOf(wanted);
    const params = shape.params.slice();
    const rest = shape.rest;
    const result = this.types.store.plain(TypeKind.Error);
    const open = this.types.store.functionOf({ params, rest, result });

    this.typed(expr, open, module);
  }
}
