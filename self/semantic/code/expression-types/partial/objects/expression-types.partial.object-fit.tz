import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  AssignExpr,
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  NameExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import { kStringClass } from "../../const/expression-types.const.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { kLengthName } from "../../../expression-shapes/const/expression-shapes.const.tz";

partial class ExpressionTypes {
  private isPlacedLiteral(expr: Expr, wanted: Type, module: int): boolean {
    if (expr.kind != ExprKind.Name) {
      return false;
    }

    const target = this.targetOfName(expr, module);
    if (target == undefined || target.kind != SymbolKind.Variable) {
      return false;
    }

    const variable = this.record(target.module)?.variables.get(target.loc);
    const init = variable?.decl.init;
    if (variable == undefined || init == undefined) {
      return false;
    }
    if (variable.decl.typeAnn != undefined) {
      return false;
    }

    const isLiteral =
      init.kind == ExprKind.ObjectLit || init.kind == ExprKind.ArrayLit;

    return isLiteral && this.isFitting(init, wanted, target.module);
  }

  private objectTargetCheck(
    target: MemberExpr,
    object: Type,
    module: int,
  ): void {
    if (object.kind == TypeKind.Tuple && target.name == kLengthName) {
      this.report(module, target.loc, Code.TupleLengthFixed, kNoDetails);

      return;
    }

    const isOwn =
      object.kind == TypeKind.Object && !this.resolver.isLibraryShape(object);
    if (!isOwn || object.kind != TypeKind.Object) {
      return;
    }

    const word = target.name;
    const first = this.text.of(object);
    const field = object.fields.find((one) => one.name == word);
    if (field == undefined) {
      return this.report(module, target.loc, Code.PropertyMissing, {
        word,
        first,
      });
    }

    if (field.method ?? false) {
      return this.report(module, target.loc, Code.MethodReplaced, {
        word,
        first,
      });
    }

    const count = object.fields.filter((one) => one.name == word).length;
    if (count > 1) {
      return this.report(module, target.loc, Code.OverloadedMethodReplaced, {
        word,
        first,
      });
    }

    if (!field.readonly) {
      return;
    }
    if (!this.isInferredName(target.object, module)) {
      this.report(module, target.loc, Code.ObjectReadOnlyField, {
        word,
        first,
      });
    }
  }

  private isInferredName(expr: Expr, module: int): boolean {
    if (expr.kind != ExprKind.Name) {
      return false;
    }

    const target = this.targetOfName(expr, module);
    if (target == undefined || target.kind != SymbolKind.Variable) {
      return false;
    }

    const variable = this.record(target.module)?.variables.get(target.loc);
    const init = variable?.decl.init;

    return (
      variable?.decl.typeAnn == undefined && init?.kind == ExprKind.ObjectLit
    );
  }

  private updateTargetCheck(target: Expr, module: int): void {
    if (target.kind != ExprKind.Member) {
      return;
    }

    this.errors.beginTrial();

    const object = this.typed(target.object, undefined, module);

    this.errors.endTrial();

    if (object.kind == TypeKind.Instance) {
      return this.instanceTargetCheck(target, object, module);
    }

    this.objectTargetCheck(target, object, module);
  }

  private nullishTargetCheck(
    expr: AssignExpr,
    declared: Type,
    module: int,
  ): void {
    if (declared.kind == TypeKind.Error || this.types.isOptional(declared)) {
      return;
    }

    const first = this.text.of(declared);
    const target = expr.target;
    const isKeyed =
      target.kind == ExprKind.Member &&
      this.recordValueOf(target.object, module) != undefined;
    if (isKeyed) {
      return;
    }

    switch (target.kind) {
      case ExprKind.Name:
        return this.report(module, expr.loc, Code.NullishNotOptionalVariable, {
          word: target.name,
          first,
        });
      case ExprKind.Member:
        return this.report(module, expr.loc, Code.NullishNotOptionalField, {
          word: target.name,
          first,
        });
      default:
        return;
    }
  }

  private stringCallCheck(expr: CallExpr, callee: NameExpr, module: int): void {
    const arg = expr.args[0]?.expr;
    const isString =
      callee.name == kStringClass && this.isGlobalUse(callee, module);
    if (!isString || arg == undefined || expr.args.length != 1) {
      return;
    }

    this.errors.beginTrial();

    const type = this.typed(arg, undefined, module);

    this.errors.endTrial();

    const base = this.types.definedType(type);
    const isObject =
      base.kind == TypeKind.Object ||
      base.kind == TypeKind.Instance ||
      base.kind == TypeKind.Dict ||
      base.kind == TypeKind.Json;
    if (isObject) {
      this.textCheck(arg, type, module);
    }
  }
}
