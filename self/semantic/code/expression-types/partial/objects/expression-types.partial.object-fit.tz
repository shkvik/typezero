import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  AssignExpr,
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  NameExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  kBothEnd,
  kBothStart,
  kStringClass,
} from "../../const/expression-types.const.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { kLengthName } from "../../../expression-shapes/const/expression-shapes.const.tz";

partial class ExpressionTypes {
  private isPlacedLiteral(expr: Expr, wanted: Type, module: int): boolean {
    const tree = this.types.program.tree;

    if (expr.kind != ExprKind.Name) {
      return false;
    }

    const target = this.targetOfName(expr, module);
    if (target == undefined || target.kind != SymbolKind.Variable) {
      return false;
    }

    const variable = this.record(target.module)?.variables.get(target.loc);
    const init = tree.exprAt(variable?.decl.initId);
    if (variable == undefined || init == undefined) {
      return false;
    }
    const typeAnn = tree.typeRefAt(variable.decl.typeAnnId);
    if (typeAnn != undefined) {
      return false;
    }

    const isLiteral =
      init.kind == ExprKind.ObjectLit || init.kind == ExprKind.ArrayLit;
    const places = this.conflictPlaces(variable, init, target.module);

    return (
      isLiteral &&
      places.length == 0 &&
      this.isFitting(init, wanted, target.module)
    );
  }

  private bothText(expr: Expr, wanted: Type, module: int): string {
    const tree = this.types.program.tree;

    if (expr.kind != ExprKind.Name) {
      return "";
    }

    const target = this.targetOfName(expr, module);
    if (target == undefined || target.kind != SymbolKind.Variable) {
      return "";
    }

    const variable = this.record(target.module)?.variables.get(target.loc);
    const init = tree.exprAt(variable?.decl.initId);
    if (variable == undefined || init == undefined) {
      return "";
    }

    const places = this.conflictPlaces(variable, init, target.module);
    const goal = this.types.definedType(wanted);
    const other = places.find(
      (one) => this.types.definedType(one).id != goal.id,
    );
    if (other == undefined) {
      return "";
    }

    const word = this.types.typeText(this.types.definedType(other));

    return `${kBothStart}${word}${kBothEnd}`;
  }

  private objectTargetCheck(
    target: MemberExpr,
    object: Type,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    if (object.kind == TypeKind.Tuple && target.name == kLengthName) {
      this.errors.write(module, target.loc, Code.TupleLengthFixed, kNoDetails);

      return;
    }

    const isOwn =
      object.kind == TypeKind.Object && !this.types.isLibraryShape(object);
    if (!isOwn || object.kind != TypeKind.Object) {
      return;
    }

    const word = target.name;
    const first = this.types.typeText(object);
    const field = this.types.store
      .fieldsOf(object)
      .find((one) => one.name == word);
    if (field == undefined) {
      return this.errors.write(module, target.loc, Code.PropertyMissing, {
        word,
        first,
      });
    }

    if (field.method ?? false) {
      return this.errors.write(module, target.loc, Code.MethodReplaced, {
        word,
        first,
      });
    }

    const count = this.types.store
      .fieldsOf(object)
      .filter((one) => one.name == word).length;
    if (count > 1) {
      return this.errors.write(
        module,
        target.loc,
        Code.OverloadedMethodReplaced,
        {
          word,
          first,
        },
      );
    }

    if (!field.readonly) {
      return;
    }
    const objectExpr = tree.exprOf(target.objectId);
    if (!this.isInferredName(objectExpr, module)) {
      this.errors.write(module, target.loc, Code.ObjectReadOnlyField, {
        word,
        first,
      });
    }
  }

  private readonly isInferredName(expr: Expr, module: int): boolean {
    const tree = this.types.program.tree;

    if (expr.kind != ExprKind.Name) {
      return false;
    }

    const target = this.targetOfName(expr, module);
    if (target == undefined || target.kind != SymbolKind.Variable) {
      return false;
    }

    const variable = this.record(target.module)?.variables.get(target.loc);
    const init = tree.exprAt(variable?.decl.initId);

    return (
      tree.typeRefAt(variable?.decl.typeAnnId) == undefined &&
      init?.kind == ExprKind.ObjectLit
    );
  }

  private updateTargetCheck(target: Expr, module: int): void {
    const tree = this.types.program.tree;

    if (target.kind != ExprKind.Member) {
      return;
    }

    const objectExpr = tree.exprOf(target.objectId);
    const object = this.peekType(objectExpr, module);

    if (object.kind == TypeKind.Instance) {
      return this.instanceTargetCheck(target, object, module);
    }

    this.objectTargetCheck(target, object, module);
  }

  private nullishTargetCheck(
    expr: AssignExpr,
    declared: Type,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    if (declared.kind == TypeKind.Error || this.types.isOptional(declared)) {
      return;
    }

    const first = this.types.typeText(declared);
    const target = tree.exprOf(expr.targetId);
    const isKeyed =
      target.kind == ExprKind.Member &&
      this.recordValueOf(tree.exprOf(target.objectId), module) != undefined;
    if (isKeyed) {
      return;
    }

    switch (target.kind) {
      case ExprKind.Name:
        return this.errors.write(
          module,
          expr.loc,
          Code.NullishNotOptionalVariable,
          {
            word: target.name,
            first,
          },
        );
      case ExprKind.Member:
        return this.errors.write(
          module,
          expr.loc,
          Code.NullishNotOptionalField,
          {
            word: target.name,
            first,
          },
        );
      default:
        return;
    }
  }

  private stringCallCheck(expr: CallExpr, callee: NameExpr, module: int): void {
    const tree = this.types.program.tree;

    const arg = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    const isString =
      callee.name == kStringClass && this.isGlobalUse(callee, module);
    if (
      !isString ||
      arg == undefined ||
      tree.argumentsOf(expr.argsList).length != 1
    ) {
      return;
    }

    const type = this.peekType(arg, module);

    const base = this.types.definedType(type);
    const isObject =
      base.kind == TypeKind.Object ||
      base.kind == TypeKind.Instance ||
      base.kind == TypeKind.Dict ||
      base.kind == TypeKind.Json;
    if (isObject) {
      this.textCheck(arg, type, module);
    }
  }
}
