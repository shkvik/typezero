import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  ObjectLitExpr,
  Property,
  PropertyKind,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  ObjectField,
  ObjectType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { SpreadSlot } from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private spreadObject(
    expr: ObjectLitExpr,
    target: Type | undefined,
    module: int,
  ): Type {
    const slots: SpreadSlot[] = [];
    let isTyped = true;

    for (const property of expr.props) {
      const isTaken = this.spreadProperty(property, target, slots, module);

      isTyped = isTyped && isTaken;
    }

    if (!isTyped) {
      return this.store.plain(TypeKind.Error);
    }

    const fields: ObjectField[] = slots.map((slot) => ({
      name: slot.name,
      type: slot.type,
      optional: false,
      readonly: false,
    }));
    const result = this.store.objectOf(fields);
    if (target == undefined || target.kind != TypeKind.Object) {
      return result;
    }
    if (this.objects.isSpreadFitting(slots, target)) {
      return target;
    }

    return result;
  }

  private spreadProperty(
    property: Property,
    target: Type | undefined,
    slots: SpreadSlot[],
    module: int,
  ): boolean {
    if (property.form.kind == PropertyKind.Spread) {
      return this.spreadMerged(property, slots, module);
    }

    const hint = this.objects.spreadFieldHint(target, property.name);
    const type = this.typed(property.value, hint, module);
    if (type.kind == TypeKind.Error) {
      return false;
    }

    const slot = slots.find((one) => one.name == property.name);
    if (slot == undefined) {
      slots.push({ name: property.name, type: type });

      return true;
    }
    if (type.kind == TypeKind.Undefined) {
      slot.type = this.types.optional(slot.type);

      return true;
    }

    slot.type = type;

    return true;
  }

  private spreadMerged(
    property: Property,
    slots: SpreadSlot[],
    module: int,
  ): boolean {
    this.quiet += 1;

    const type = this.typed(property.value, undefined, module);

    this.quiet -= 1;

    const base = this.types.apparent(type);
    if (
      base.kind != TypeKind.Object ||
      this.dictionaries.spreadCode(type) != undefined
    ) {
      return false;
    }

    const form = property.form;
    if (form.kind != PropertyKind.Spread) {
      return false;
    }

    for (const field of base.fields) {
      if (form.omit.includes(field.name)) {
        continue;
      }

      const isMerged = this.mergeSpreadField(
        property,
        field,
        base,
        slots,
        module,
      );
      if (!isMerged) {
        return false;
      }
    }

    return true;
  }

  private mergeSpreadField(
    property: Property,
    field: ObjectField,
    spread: ObjectType,
    slots: SpreadSlot[],
    module: int,
  ): boolean {
    const type = this.objects.fieldWanted(field);
    const slot = slots.find((one) => one.name == field.name);
    if (slot == undefined) {
      slots.push({ name: field.name, type });

      return true;
    }
    if (!this.types.isOptional(type)) {
      slot.type = type;

      return true;
    }

    const joined = this.unifier.unify(
      this.types.definedType(slot.type),
      this.types.definedType(type),
    );
    if (joined == undefined || joined.kind == TypeKind.Error) {
      this.report(module, property.loc, Code.SpreadFieldTypes, {
        word: field.name,
        first: this.text.of(slot.type),
        second: this.text.of(type),
        other: this.text.of(spread),
      });

      return false;
    }
    if (this.types.isOptional(slot.type)) {
      slot.type = this.types.optional(joined);

      return true;
    }

    slot.type = joined;

    return true;
  }
}
