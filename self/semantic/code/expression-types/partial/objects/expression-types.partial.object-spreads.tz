import { ExpressionTypes } from "../../expression-types.tz";
import {
  ObjectLitExpr,
  Property,
  PropertyKind,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  ObjectField,
  ObjectType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { SpreadSlot } from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private spreadObject(
    expr: ObjectLitExpr,
    target: Type | undefined,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const slots: SpreadSlot[] = [];
    let isTyped = true;

    for (const property of tree.propertiesOf(expr.propsList)) {
      const isTaken = this.spreadProperty(property, target, slots, module);

      isTyped = isTyped && isTaken;
    }

    if (!isTyped) {
      return this.types.store.plain(TypeKind.Error);
    }

    const fields: ObjectField[] = slots.map((slot) => ({
      name: slot.name,
      type: slot.type,
      optional: false,
      readonly: false,
    }));
    const result = this.types.store.objectOf(fields);
    if (target == undefined || target.kind != TypeKind.Object) {
      return result;
    }
    if (this.types.isSpreadFitting(slots, target)) {
      return target;
    }

    return result;
  }

  private spreadProperty(
    property: Property,
    target: Type | undefined,
    slots: SpreadSlot[],
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    if (property.form.kind == PropertyKind.Spread) {
      return this.spreadMerged(property, slots, module);
    }

    const hint = this.types.spreadFieldHint(target, property.name);
    const value = tree.exprOf(property.valueId);
    const type = this.typed(value, hint, module);
    if (type.kind == TypeKind.Error) {
      return false;
    }

    if (!slots.some((one) => one.name == property.name)) {
      slots.push({ name: property.name, type: type });

      return true;
    }

    const slot = slots.find((one) => one.name == property.name);
    if (slot == undefined) {
      return true;
    }
    if (type.kind == TypeKind.Undefined) {
      slot.type = this.types.optional(slot.type);

      return true;
    }

    slot.type = type;

    return true;
  }

  private spreadMerged(
    property: Property,
    slots: SpreadSlot[],
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const value = tree.exprOf(property.valueId);
    const type = this.peekType(value, module);

    const base = this.types.apparent(type);
    if (
      base.kind != TypeKind.Object ||
      this.types.spreadCode(type) != undefined
    ) {
      return false;
    }

    const form = property.form;
    if (form.kind != PropertyKind.Spread) {
      return false;
    }

    for (const field of this.types.store.fieldsOf(base)) {
      const omit = tree.textsOf(form.omitList);
      if (omit.includes(field.name)) {
        continue;
      }

      const isMerged = this.mergeSpreadField(
        property,
        field,
        base,
        slots,
        module,
      );
      if (!isMerged) {
        return false;
      }
    }

    return true;
  }

  private mergeSpreadField(
    property: Property,
    field: ObjectField,
    spread: ObjectType,
    slots: SpreadSlot[],
    module: int,
  ): boolean {
    const checked = this.types.mergeSpreadField(
      property,
      field,
      spread,
      slots,
    );

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }
}
