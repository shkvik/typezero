import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  ExprKind,
  ObjectLitExpr,
  Property,
  PropertyKind,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  ObjectField,
  ObjectType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { ThisPlace } from "../../types/expression-types.types.tz";
import { StmtKind } from "../../../../../program/ast/types/ast.types.statements.tz";

partial class ExpressionTypes {
  private methodObject(
    expr: ObjectLitExpr,
    target: Type | undefined,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const error = this.types.store.plain(TypeKind.Error);
    const isSpread = tree.propertiesOf(expr.propsList).some(
      (property) => property.form.kind == PropertyKind.Spread,
    );
    if (isSpread) {
      this.errors.write(
        module,
        expr.loc,
        Code.LiteralMethodsSpread,
        kNoDetails,
      );

      return error;
    }

    if (this.genericLiteralCheck(expr, module)) {
      return error;
    }

    const goal = this.types.methodGoal(target);
    const reserved = this.types.store.reserveObject();
    const fields = this.literalValueFields(expr, goal, module);
    if (fields == undefined) {
      return error;
    }

    this.types.store.fillObject(reserved, fields);
    this.types.store.label(
      reserved,
      this.types.methodObjectName(expr, fields),
    );

    const methods = this.literalMethods(expr, reserved, goal, module);

    this.types.store.fillObject(reserved, methods);

    if (goal == undefined) {
      return reserved;
    }
    if (!this.methodTargetCheck(expr, goal, methods, module)) {
      return error;
    }

    this.types.store.inherit(reserved, [goal]);
    this.types.store.markBase(goal);

    return reserved;
  }

  private genericLiteralCheck(expr: ObjectLitExpr, module: int): boolean {
    const tree = this.types.program.tree;

    const fn = this.openFunctions[this.openFunctions.length - 1];
    const body = tree.blockAt(fn?.bodyId);
    if (
      fn == undefined ||
      body == undefined ||
      tree.typeParamsOf(fn.typeParamsList).length == 0
    ) {
      return false;
    }

    const isReturned = tree.stmtsOf(body.bodyList).some(
      (statement) =>
        statement.kind == StmtKind.Return && statement.valueId == expr.id,
    );
    if (!isReturned) {
      return false;
    }

    this.errors.write(module, expr.loc, Code.GenericLiteralClass, {
      word: fn.name,
    });

    return true;
  }

  private literalValueFields(
    expr: ObjectLitExpr,
    goal: ObjectType | undefined,
    module: int,
  ): ObjectField[] | undefined {
    const tree = this.types.program.tree;

    const fields: ObjectField[] = [];
    let isTyped = true;

    for (const property of tree.propertiesOf(expr.propsList)) {
      if (property.form.kind == PropertyKind.Method) {
        continue;
      }
      if (property.form.kind == PropertyKind.Computed) {
        return undefined;
      }

      const wanted = this.types.goalField(goal, property.name);
      const value = tree.exprOf(property.valueId);
      const type = this.typed(value, wanted, module);

      isTyped = isTyped && type.kind != TypeKind.Error;
      fields.push({
        name: property.name,
        type,
        optional: false,
        readonly: false,
      });
    }

    if (!isTyped) {
      return undefined;
    }

    return fields;
  }

  private literalMethods(
    expr: ObjectLitExpr,
    reserved: Type,
    goal: ObjectType | undefined,
    module: int,
  ): ObjectField[] {
    const tree = this.types.program.tree;

    const methods: ObjectField[] = [];

    for (const property of tree.propertiesOf(expr.propsList)) {
      const value = tree.exprOf(property.valueId);
      const isMethod = property.form.kind == PropertyKind.Method;
      if (isMethod && value.kind == ExprKind.Function) {
        const fn = tree.functionOf(value.fnId);

        this.literalOwners.set(fn.id, reserved);
      }
    }

    this.selves.push(reserved);
    this.thisPlaces.push(ThisPlace.Method);

    for (const property of tree.propertiesOf(expr.propsList)) {
      const type = this.literalMethodType(property, goal, module);
      if (type != undefined) {
        methods.push({
          name: property.name,
          type,
          optional: false,
          readonly: true,
          method: true,
        });
      }
    }

    this.thisPlaces.pop();
    this.selves.pop();

    return methods;
  }

  private literalMethodType(
    property: Property,
    goal: ObjectType | undefined,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const value = tree.exprOf(property.valueId);
    if (property.form.kind != PropertyKind.Method) {
      return undefined;
    }
    if (value.kind != ExprKind.Function) {
      return undefined;
    }

    const member = this.types.plainMember(goal, property.name);
    const isTyped =
      member != undefined &&
      member.readonly &&
      member.type.kind == TypeKind.Function;
    if (isTyped && member != undefined) {
      return this.typed(value, member.type, module);
    }

    const fn = tree.functionOf(value.fnId);

    return this.functionType(fn, module);
  }

  private methodTargetCheck(
    expr: ObjectLitExpr,
    goal: ObjectType,
    methods: Read<ObjectField[]>,
    module: int,
  ): boolean {
    const checked = this.types.methodTargetCheck(expr, goal, methods);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }
}
