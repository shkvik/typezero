import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  ExprKind,
  ObjectLitExpr,
  Property,
  PropertyKind,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  ObjectField,
  ObjectType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { ThisPlace } from "../../types/expression-types.types.tz";
import { StmtKind } from "../../../../../program/ast/types/ast.types.statements.tz";

partial class ExpressionTypes {
  private readonly methodObject(
    expr: ObjectLitExpr,
    target: Type | undefined,
    module: int,
  ): Type {
    const error = this.store.plain(TypeKind.Error);
    const isSpread = expr.props.some(
      (property) => property.form.kind == PropertyKind.Spread,
    );
    if (isSpread) {
      this.report(module, expr.loc, Code.LiteralMethodsSpread, kNoDetails);

      return error;
    }

    if (this.genericLiteralCheck(expr, module)) {
      return error;
    }

    const goal = this.objects.methodGoal(target);
    const reserved = this.store.reserveObject();
    const fields = this.literalValueFields(expr, goal, module);
    if (fields == undefined) {
      return error;
    }

    this.store.fillObject(reserved, fields);
    this.store.label(
      reserved,
      this.objectMembers.methodObjectName(expr, fields),
    );

    const methods = this.literalMethods(expr, reserved, goal, module);

    this.store.fillObject(reserved, methods);

    if (goal == undefined) {
      return reserved;
    }
    if (!this.methodTargetCheck(expr, goal, methods, module)) {
      return error;
    }

    this.store.inherit(reserved, [goal]);
    this.store.markBase(goal);

    return reserved;
  }

  private readonly genericLiteralCheck(expr: ObjectLitExpr, module: int): boolean {
    const fn = this.openFunctions[this.openFunctions.length - 1];
    const body = fn?.body;
    if (fn == undefined || body == undefined || fn.typeParams.length == 0) {
      return false;
    }

    const isReturned = body.body.some(
      (statement) =>
        statement.kind == StmtKind.Return && statement.value == expr,
    );
    if (!isReturned) {
      return false;
    }

    this.report(module, expr.loc, Code.GenericLiteralClass, { word: fn.name });

    return true;
  }

  private readonly literalValueFields(
    expr: ObjectLitExpr,
    goal: ObjectType | undefined,
    module: int,
  ): ObjectField[] | undefined {
    const fields: ObjectField[] = [];
    let isTyped = true;

    for (const property of expr.props) {
      if (property.form.kind == PropertyKind.Method) {
        continue;
      }
      if (property.form.kind == PropertyKind.Computed) {
        return undefined;
      }

      const wanted = this.objects.goalField(goal, property.name);
      const type = this.typed(property.value, wanted, module);

      isTyped = isTyped && type.kind != TypeKind.Error;
      fields.push({
        name: property.name,
        type,
        optional: false,
        readonly: false,
      });
    }

    if (!isTyped) {
      return undefined;
    }

    return fields;
  }

  private readonly literalMethods(
    expr: ObjectLitExpr,
    reserved: Type,
    goal: ObjectType | undefined,
    module: int,
  ): ObjectField[] {
    const methods: ObjectField[] = [];

    for (const property of expr.props) {
      const value = property.value;
      const isMethod = property.form.kind == PropertyKind.Method;
      if (isMethod && value.kind == ExprKind.Function) {
        this.literalOwners.set(value.fn, reserved);
      }
    }

    this.selves.push(reserved);
    this.thisPlaces.push(ThisPlace.Method);

    for (const property of expr.props) {
      const type = this.literalMethodType(property, goal, module);
      if (type != undefined) {
        methods.push({
          name: property.name,
          type,
          optional: false,
          readonly: true,
          method: true,
        });
      }
    }

    this.thisPlaces.pop();
    this.selves.pop();

    return methods;
  }

  private readonly literalMethodType(
    property: Property,
    goal: ObjectType | undefined,
    module: int,
  ): Type | undefined {
    const value = property.value;
    if (property.form.kind != PropertyKind.Method) {
      return undefined;
    }
    if (value.kind != ExprKind.Function) {
      return undefined;
    }

    const member = this.objectMembers.plainMember(goal, property.name);
    const isTyped =
      member != undefined &&
      member.readonly &&
      member.type.kind == TypeKind.Function;
    if (isTyped && member != undefined) {
      return this.typed(value, member.type, module);
    }

    return this.functionType(value.fn, module);
  }

  private readonly methodTargetCheck(
    expr: ObjectLitExpr,
    goal: ObjectType,
    methods: Read<ObjectField[]>,
    module: int,
  ): boolean {
    const checked = this.objectMembers.methodTargetCheck(expr, goal, methods);

    this.reportFound(module, checked.error);

    return checked.value;
  }
}
