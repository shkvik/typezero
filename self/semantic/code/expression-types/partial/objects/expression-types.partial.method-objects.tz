import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  ExprKind,
  ObjectLitExpr,
  Property,
  PropertyKind,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  ObjectField,
  ObjectType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { ThisPlace } from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private hasMethods(expr: ObjectLitExpr): boolean {
    return expr.props.some(
      (property) => property.form.kind == PropertyKind.Method,
    );
  }

  private methodObject(
    expr: ObjectLitExpr,
    target: Type | undefined,
    module: int,
  ): Type {
    const error = this.store.plain(TypeKind.Error);
    const isSpread = expr.props.some(
      (property) => property.form.kind == PropertyKind.Spread,
    );
    if (isSpread) {
      this.report(module, expr.loc, Code.LiteralMethodsSpread, kNoDetails);

      return error;
    }

    const goal = this.methodGoal(target);
    const reserved = this.store.reserveObject();
    const fields = this.literalValueFields(expr, goal, module);
    if (fields == undefined) {
      return error;
    }

    this.store.fillObject(reserved, fields);
    this.store.label(reserved, this.methodObjectName(expr, fields));

    const methods = this.literalMethods(expr, reserved, goal, module);

    this.store.fillObject(reserved, methods);

    if (goal == undefined) {
      return reserved;
    }
    if (!this.methodTargetCheck(expr, goal, methods, module)) {
      return error;
    }

    this.store.inherit(reserved, [goal]);
    this.store.markBase(goal);

    return reserved;
  }

  private methodGoal(target: Type | undefined): ObjectType | undefined {
    if (target == undefined || target.kind != TypeKind.Object) {
      return undefined;
    }

    return target;
  }

  private literalValueFields(
    expr: ObjectLitExpr,
    goal: ObjectType | undefined,
    module: int,
  ): ObjectField[] | undefined {
    const fields: ObjectField[] = [];
    let isTyped = true;

    for (const property of expr.props) {
      if (property.form.kind == PropertyKind.Method) {
        continue;
      }
      if (property.form.kind == PropertyKind.Computed) {
        return undefined;
      }

      const wanted = this.goalField(goal, property.name);
      const type = this.typed(property.value, wanted, module);

      isTyped = isTyped && type.kind != TypeKind.Error;
      fields.push({
        name: property.name,
        type,
        optional: false,
        readonly: false,
      });
    }

    if (!isTyped) {
      return undefined;
    }

    return fields;
  }

  private goalField(
    goal: ObjectType | undefined,
    name: string,
  ): Type | undefined {
    const field = goal?.fields.find((one) => one.name == name);
    if (field == undefined) {
      return undefined;
    }

    return this.fieldWanted(field);
  }

  private methodObjectName(expr: ObjectLitExpr, fields: ObjectField[]): string {
    const calls = expr.props
      .filter((property) => property.form.kind == PropertyKind.Method)
      .map((property) => `${property.name}()`)
      .join("; ");
    if (fields.length == 0) {
      return `{ ${calls} }`;
    }

    const plain = this.text.of(this.store.objectOf(fields));

    return `${plain.slice(0, plain.length - 2)}; ${calls} }`;
  }

  private literalMethods(
    expr: ObjectLitExpr,
    reserved: Type,
    goal: ObjectType | undefined,
    module: int,
  ): ObjectField[] {
    const methods: ObjectField[] = [];

    for (const property of expr.props) {
      const value = property.value;
      const isMethod = property.form.kind == PropertyKind.Method;
      if (isMethod && value.kind == ExprKind.Function) {
        this.literalOwners.set(value.fn, reserved);
      }
    }

    this.selves.push(reserved);
    this.thisPlaces.push(ThisPlace.Method);

    for (const property of expr.props) {
      const type = this.literalMethodType(property, goal, module);
      if (type != undefined) {
        methods.push({
          name: property.name,
          type,
          optional: false,
          readonly: true,
          method: true,
        });
      }
    }

    this.thisPlaces.pop();
    this.selves.pop();

    return methods;
  }

  private literalMethodType(
    property: Property,
    goal: ObjectType | undefined,
    module: int,
  ): Type | undefined {
    const value = property.value;
    if (property.form.kind != PropertyKind.Method) {
      return undefined;
    }
    if (value.kind != ExprKind.Function) {
      return undefined;
    }

    const member = this.plainMember(goal, property.name);
    const isTyped =
      member != undefined &&
      member.readonly &&
      member.type.kind == TypeKind.Function;
    if (isTyped && member != undefined) {
      return this.typed(value, member.type, module);
    }

    return this.functionType(value.fn, module);
  }

  private methodTargetCheck(
    expr: ObjectLitExpr,
    goal: ObjectType,
    methods: ObjectField[],
    module: int,
  ): boolean {
    const first = this.text.of(goal);

    for (const property of expr.props) {
      const isFitting = this.methodPropertyFits(
        property,
        goal,
        methods,
        first,
        module,
      );
      if (!isFitting) {
        return false;
      }
    }

    for (const member of goal.fields) {
      const isGiven = expr.props.some(
        (property) => property.name == member.name,
      );
      const isPlain = this.plainMember(goal, member.name) != undefined;
      if (!isGiven && isPlain) {
        this.report(module, expr.loc, Code.LiteralFitMissing, {
          first,
          word: member.name,
        });

        return false;
      }
    }

    const overloaded = goal.fields.find(
      (member) =>
        goal.fields.filter((other) => other.name == member.name).length > 1,
    );
    if (overloaded != undefined) {
      this.report(module, expr.loc, Code.LiteralFitOverloads, {
        first,
        word: overloaded.name,
      });

      return false;
    }

    return true;
  }

  private methodPropertyFits(
    property: Property,
    goal: ObjectType,
    methods: ObjectField[],
    first: string,
    module: int,
  ): boolean {
    const word = property.name;
    const member = this.plainMember(goal, word);
    if (member == undefined) {
      this.report(module, property.loc, Code.LiteralFitNoField, {
        first,
        word,
      });

      return false;
    }
    if (property.form.kind != PropertyKind.Method) {
      return true;
    }
    if (member.type.kind != TypeKind.Function) {
      this.report(module, property.loc, Code.LiteralFitNotMethod, {
        first,
        word,
        second: this.text.of(member.type),
      });

      return false;
    }
    if (!member.readonly) {
      this.report(module, property.loc, Code.LiteralFitReplaceable, {
        first,
        word,
      });

      return false;
    }

    const mine = methods.find((one) => one.name == word)?.type;
    if (mine == undefined || mine.kind == TypeKind.Error) {
      return true;
    }
    if (this.relation.converts(mine, member.type)) {
      return true;
    }

    this.report(module, property.loc, Code.LiteralFitOtherType, {
      first,
      word,
      second: this.text.of(mine),
      other: this.text.of(member.type),
    });

    return false;
  }

  private plainMember(
    goal: ObjectType | undefined,
    name: string,
  ): ObjectField | undefined {
    const same = goal?.fields.filter((one) => one.name == name) ?? [];
    if (same.length != 1) {
      return undefined;
    }

    return same[0];
  }

  private hasMethodFields(type: Type): boolean {
    const base = this.types.definedType(type);
    if (base.kind != TypeKind.Object) {
      return false;
    }

    return base.fields.some((field) => field.method ?? false);
  }
}
