import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  Expr,
  ExprKind,
  ObjectLitExpr,
  Property,
  PropertyKind,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  ObjectType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { kNoPlace } from "../../const/expression-types.const.tz";

partial class ExpressionTypes {
  private keyedLiteralCheck(
    expr: ObjectLitExpr,
    target: Type | undefined,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const seen = new Map<string, Type>();

    for (const property of tree.propertiesOf(expr.propsList)) {
      const form = property.form;
      if (form.kind != PropertyKind.Computed) {
        continue;
      }

      const key = tree.exprOf(form.keyId);
      if (this.constantKey(key, module) != undefined) {
        continue;
      }
      if (this.isEnumMemberKey(key, module)) {
        continue;
      }

      const keyType = this.peekType(key, module);
      if (keyType.kind != TypeKind.Union) {
        continue;
      }
      if (!this.types.isLiteralKeys(keyType)) {
        continue;
      }

      const isFailed = this.keyedPropertyFails(
        property,
        key,
        keyType,
        target,
        seen,
        module,
      );
      if (isFailed) {
        return;
      }
    }
  }

  private readonly isEnumMemberKey(key: Expr, module: int): boolean {
    const tree = this.types.program.tree;

    if (key.kind != ExprKind.Member) {
      return false;
    }

    const object = tree.exprOf(key.objectId);

    return this.enumHomeOf(object, module) != undefined;
  }

  private keyedPropertyFails(
    property: Property,
    key: Expr,
    keyType: Type,
    target: Type | undefined,
    seen: Map<string, Type>,
    module: int,
  ): boolean {
    if (target == undefined) {
      return this.inferredKeyFails(property, key, keyType, seen, module);
    }
    if (target.kind == TypeKind.Object) {
      return this.targetedKeyFails(property, key, keyType, target, module);
    }

    return false;
  }

  private targetedKeyFails(
    property: Property,
    key: Expr,
    keyType: Type,
    target: ObjectType,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const word = this.types.typeText(keyType);
    const field = this.keyedFieldType(target, keyType);
    if (field == undefined) {
      this.errors.write(module, key.loc, Code.KeyedFieldsDiffer, {
        word,
        other: this.types.typeText(target),
      });

      return true;
    }
    if (!this.types.isOptional(field)) {
      this.errors.write(module, key.loc, Code.KeyedNotOptional, {
        word,
        other: this.types.typeText(field),
      });

      return true;
    }

    const value = tree.exprOf(property.valueId);

    this.checked(value, field, module, kNoPlace);

    return false;
  }

  private inferredKeyFails(
    property: Property,
    key: Expr,
    keyType: Type,
    seen: Map<string, Type>,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const valueExpr = tree.exprOf(property.valueId);
    const value = this.typed(valueExpr, undefined, module);
    if (value.kind == TypeKind.Error) {
      return true;
    }

    const optional = this.types.optional(value);

    for (const part of this.types.partsOfType(keyType)) {
      if (part.kind != TypeKind.Literal) {
        continue;
      }

      const name = part.text;
      const same = seen.get(name);
      if (same != undefined && same.id != optional.id) {
        this.errors.write(module, key.loc, Code.KeyedValuesDiffer, {
          word: name,
        });

        return true;
      }

      seen.set(name, optional);
    }

    return false;
  }
}
