import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  Expr,
  ExprKind,
  ObjectLitExpr,
  Property,
  PropertyKind,
  UnaryOp,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  LiteralKind,
  ObjectField,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { FieldEntry, ObjectDraft } from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private objectTyped(
    expr: ObjectLitExpr,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const target = this.types.wantedPart(wanted);
    if (target != undefined && target.kind == TypeKind.Json) {
      return this.jsonObject(expr, target, module);
    }
    if (target != undefined && this.types.isRecord(target)) {
      return this.recordObject(expr, target, module);
    }

    const draft = this.objectKeys(expr, module);

    const uniqueErrors = this.types.uniqueErrors(draft);

    this.errors.writeAll(module, uniqueErrors);

    if (draft.deferred && this.types.hasMethods(expr)) {
      return this.methodObject(expr, target, module);
    }
    if (draft.deferred && this.types.isSpreadOnly(expr)) {
      return this.spreadObject(expr, target, module);
    }
    if (draft.deferred) {
      this.keyedLiteralCheck(expr, target, module);

      return this.types.store.plain(TypeKind.Error);
    }
    if (target == undefined) {
      return this.inferredObject(draft, module);
    }
    if (target.kind == TypeKind.Union) {
      return this.unionObject(expr, draft, target, module);
    }
    if (target.kind == TypeKind.Object) {
      return this.targetedObject(expr, draft, target, module);
    }

    return this.inferredObject(draft, module);
  }

  private unionObject(
    expr: ObjectLitExpr,
    draft: ObjectDraft,
    target: Type,
    module: int,
  ): Type {
    if (target.kind != TypeKind.Union) {
      return this.inferredObject(draft, module);
    }

    const member = this.literalMember(
      draft,
      this.types.store.partsOf(target),
      module,
    );
    if (member != undefined) {
      return this.targetedObject(expr, draft, member, module);
    }

    const record = this.types.store.partsOf(target).find((part) =>
      this.types.isRecord(part),
    );
    if (record != undefined) {
      return this.recordObject(expr, record, module);
    }

    return this.inferredObject(draft, module);
  }

  private objectKeys(expr: ObjectLitExpr, module: int): ObjectDraft {
    const tree = this.types.program.tree;

    const draft: ObjectDraft = { entries: [], typed: true, deferred: false };

    for (const property of tree.propertiesOf(expr.propsList)) {
      const entry = this.keyEntry(property, draft, module);

      draft.entries.push(entry);
    }

    return draft;
  }

  private keyEntry(
    property: Property,
    draft: ObjectDraft,
    module: int,
  ): FieldEntry {
    const tree = this.types.program.tree;

    const name = property.name;
    const value = tree.exprOf(property.valueId);
    const form = property.form;

    switch (form.kind) {
      case PropertyKind.Spread:
        draft.deferred = true;
        this.spreadCheck(property, module);

        return { property, name, value, named: false };
      case PropertyKind.Method:
        draft.deferred = true;
        const literalMethodError =
          this.types.literalMethodCheck(property);

        this.errors.writeFound(module, literalMethodError);

        return { property, name, value, named: true };
      case PropertyKind.Defaulted: {
        const fallback = this.types.fallbackOf(value);

        this.errors.write(module, property.loc, Code.DefaultedProperty, {
          word: name,
        });
        draft.typed = false;

        return { property, name, value: fallback, named: true };
      }
      case PropertyKind.Computed:
        return this.computedEntry(
          property,
          tree.exprOf(form.keyId),
          draft,
          module,
        );
      default:
        return { property, name, value, named: true };
    }
  }

  private computedEntry(
    property: Property,
    key: Expr,
    draft: ObjectDraft,
    module: int,
  ): FieldEntry {
    const tree = this.types.program.tree;

    const value = tree.exprOf(property.valueId);
    const keyType = this.typed(key, undefined, module);
    const constant = this.constantKey(key, module);
    if (constant != undefined) {
      return { property, name: constant, value, named: true };
    }

    const entry: FieldEntry = { property, name: "", value, named: false };
    const isUnknown = keyType.kind == TypeKind.Error;
    if (isUnknown || this.types.isLiteralKeys(keyType)) {
      draft.deferred = true;

      return entry;
    }

    draft.typed = false;

    const keyError = this.types.objectMemberKeyError(key, keyType);

    this.errors.writeFound(module, keyError);

    return entry;
  }

  private constantKey(key: Expr, module: int): string | undefined {
    const tree = this.types.program.tree;

    switch (key.kind) {
      case ExprKind.StringLit:
        return key.value;
      case ExprKind.Template:
        const exprs = tree.exprsOf(key.exprsList);
        if (exprs.length > 0) {
          return undefined;
        }

        return tree.textsOf(key.quasisList)[0];
      case ExprKind.Name: {
        const literal = this.doorOfName(key, module)?.literal;
        if (literal == undefined || literal.kind != LiteralKind.String) {
          return undefined;
        }

        return literal.text;
      }
      case ExprKind.Member: {
        const member = this.enumLiteral(key, module);
        if (member == undefined || member.kind != LiteralKind.String) {
          return undefined;
        }

        return member.text;
      }
      default:
        return undefined;
    }
  }

  private inferredObject(draft: ObjectDraft, module: int): Type {
    const fields: ObjectField[] = [];

    for (const entry of draft.entries) {
      const type = this.typed(entry.value, undefined, module);

      if (!entry.named) {
        continue;
      }

      const voidFieldErrors = this.types.voidFieldCheck(
        entry.value,
        type,
        entry.name,
      );

      this.errors.writeAll(module, voidFieldErrors);

      if (!this.isUsableField(entry, type, module)) {
        draft.typed = false;
      }

      fields.push({
        name: entry.name,
        type,
        optional: false,
        readonly: false,
      });
    }

    if (!draft.typed) {
      return this.types.store.plain(TypeKind.Error);
    }

    return this.types.store.objectOf(fields);
  }

  private isUsableField(entry: FieldEntry, type: Type, module: int): boolean {
    const checked = this.types.isUsableField(entry, type);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private targetedObject(
    expr: ObjectLitExpr,
    draft: ObjectDraft,
    target: Type,
    module: int,
  ): Type {
    if (target.kind != TypeKind.Object) {
      return this.inferredObject(draft, module);
    }

    for (const entry of draft.entries) {
      const field = this.types.store
        .fieldsOf(target)
        .find((one) => one.name == entry.name);
      if (!entry.named || field == undefined) {
        const noFieldError = this.types.noFieldError(entry, target);

        this.errors.writeFound(module, noFieldError);
        this.typed(entry.value, undefined, module);

        continue;
      }

      const wanted = this.types.fieldWanted(field);
      const place = this.types.fieldPlace(entry.name);

      this.checked(entry.value, wanted, module, place);
    }

    const first = this.types.typeText(target);

    for (const field of this.types.store.fieldsOf(target)) {
      const isGiven = draft.entries.some((entry) => entry.name == field.name);
      if (!isGiven && !this.types.isOptionalField(field)) {
        this.errors.write(module, expr.loc, Code.FieldMissing, {
          word: field.name,
          first,
        });
      }
    }

    const overloaded = this.types.overloadedNames(target);

    for (const word of overloaded) {
      this.errors.write(module, expr.loc, Code.LiteralOverloadsTarget, {
        first,
        word,
      });
    }

    return target;
  }

  private literalMember(
    draft: Read<ObjectDraft>,
    members: Read<Type[]>,
    module: int,
  ): Type | undefined {
    let best: Type | undefined = undefined;
    let bestScore = -1;
    let isAmbiguous = false;

    for (const member of members) {
      const score = this.candidateScore(draft, member, module);
      if (score == undefined) {
        continue;
      }
      if (score > bestScore) {
        best = member;
        bestScore = score;
        isAmbiguous = false;

        continue;
      }
      if (score == bestScore) {
        isAmbiguous = true;
      }
    }

    if (isAmbiguous) {
      return undefined;
    }

    return best;
  }

  private candidateScore(
    draft: Read<ObjectDraft>,
    member: Type,
    module: int,
  ): int | undefined {
    if (!this.types.hasFittingNames(draft, member)) {
      return undefined;
    }

    let score = 0;

    for (const entry of draft.entries) {
      const gained = this.propertyScore(entry, member, module);
      if (gained == undefined) {
        return undefined;
      }

      score += gained;
    }

    return score;
  }

  private propertyScore(
    entry: FieldEntry,
    member: Type,
    module: int,
  ): int | undefined {
    if (member.kind != TypeKind.Object) {
      return 0;
    }

    const field = this.types.store
      .fieldsOf(member)
      .find((one) => one.name == entry.name);
    const tag = this.propertyTag(entry.value, module);
    if (field == undefined || tag == undefined) {
      return 0;
    }

    const fieldType = this.types.definedType(field.type);
    const isChoice =
      this.types.isLiteralSet(fieldType) || fieldType.kind == TypeKind.Union;
    const isConvertible = this.types.isTagConvertible(tag, fieldType);
    if (!isConvertible && isChoice) {
      return undefined;
    }
    if (!isConvertible) {
      return 0;
    }

    const hasAtoms =
      fieldType.kind == TypeKind.Union &&
      this.types.store
        .partsOf(fieldType)
        .some((part) => part.kind == TypeKind.Literal);
    if (this.types.isLiteralSet(fieldType) || hasAtoms) {
      return 1;
    }

    return 0;
  }

  private propertyTag(value: Expr, module: int): Type | undefined {
    const isPlus = value.kind == ExprKind.Unary && value.op == UnaryOp.Plus;

    if (value.kind == ExprKind.Name) {
      return this.knownLiteralSet(value, module);
    }

    const literal = this.literalOf(value, module);
    if (literal == undefined || isPlus) {
      return undefined;
    }

    return this.types.store.literal(literal.kind, literal.text);
  }

  private knownLiteralSet(value: Expr, module: int): Type | undefined {
    if (value.kind != ExprKind.Name) {
      return undefined;
    }

    const type = this.valueOfName(value, module);
    if (type == undefined || !this.types.isLiteralSet(type)) {
      return undefined;
    }

    return type;
  }
}
