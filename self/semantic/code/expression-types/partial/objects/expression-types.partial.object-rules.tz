import { ProofRange } from "../../../../flow/proof-rules/types/proof-rules.types.tz";
import { kArrayLengthWhat } from "../../../../flow/proof-rules/const/proof-rules.const.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  Expr,
  ExprKind,
  MemberExpr,
  NameExpr,
  NewExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { ForOfStmt } from "../../../../../program/ast/types/ast.types.statements.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import {
  DictKind,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  TypeContext,
  TypePlace,
} from "../../../../types/type-resolver/types/type-resolver.types.tz";
import { kArrayClass, kThisName } from "../../const/expression-types.const.tz";
import {
  DeclaredVariable,
  ValueTarget,
  VariableDoor,
} from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private loopCannotCheck(loop: ForOfStmt, base: Type, module: int): void {
    const loc = loop.iterable.loc;

    switch (base.kind) {
      case TypeKind.Dict:
        if (base.dict == DictKind.Record) {
          this.report(module, loc, Code.RecordNotIterable, kNoDetails);
        }

        return;
      case TypeKind.Instance:
        return this.instanceLoopCheck(loop.iterable, base, module);
      case TypeKind.Object:
        if (this.types.isIterableTarget(base)) {
          return;
        }
        if (this.matchItem(base) != undefined) {
          return;
        }

        this.report(module, loc, Code.ForOfCannot, {
          word: this.text.of(base),
        });

        return;
      case TypeKind.Int:
      case TypeKind.Double:
      case TypeKind.Decimal:
      case TypeKind.Boolean:
      case TypeKind.Function:
      case TypeKind.Result:
      case TypeKind.Promise:
        this.report(module, loc, Code.ForOfCannot, {
          word: this.text.of(base),
        });

        return;
      default:
        return;
    }
  }

  private arrayNew(
    expr: NewExpr,
    name: string,
    wanted: Type | undefined,
    module: int,
  ): Type | undefined {
    if (name != kArrayClass || expr.args.length != 1) {
      return undefined;
    }

    const target = this.targetOfUse(expr.loc, name, module);
    if (target != undefined && !this.modules.isLibraryModule(target.module)) {
      return undefined;
    }

    const element = this.arrayNewElement(expr, wanted, module);
    const length = expr.args[0];
    if (element == undefined || length == undefined) {
      return undefined;
    }

    this.typed(length.expr, this.store.integer(64, false), module);

    return this.store.arrayOf(element);
  }

  private readonly arrayNewElement(
    expr: NewExpr,
    wanted: Type | undefined,
    module: int,
  ): Type | undefined {
    const written = expr.typeArgs[0];
    if (written != undefined) {
      const context: TypeContext = {
        module,
        bindings: new Map<int, Type>(),
        place: TypePlace.Plain,
      };

      return this.resolver.value(written, context);
    }

    const goal = this.types.wantedPart(wanted);
    if (goal == undefined || goal.kind != TypeKind.Array) {
      return undefined;
    }

    return goal.item;
  }

  private newArrayCheck(
    expr: NewExpr,
    name: string,
    wanted: Type | undefined,
    module: int,
  ): void {
    if (name != kArrayClass) {
      return;
    }
    const goal = this.types.wantedPart(wanted);
    const isFromExpected = goal != undefined && goal.kind == TypeKind.Array;
    if (expr.typeArgs.length == 0 && !isFromExpected) {
      this.report(module, expr.loc, Code.NewArrayNeedsElement, kNoDetails);

      return;
    }

    const written = expr.typeArgs[0];
    const length = expr.args[0];
    const isSized = expr.args.length == 1 && expr.typeArgs.length == 1;
    if (!isSized || written == undefined || length == undefined) {
      return;
    }

    const context: TypeContext = {
      module,
      bindings: new Map<int, Type>(),
      place: TypePlace.Plain,
    };
    const element = this.resolver.value(written, context);
    if (!this.objects.hasZeroValue(element)) {
      this.report(module, expr.loc, Code.NewArrayNoDefault, {
        word: this.text.of(element),
      });
    }

    const range: ProofRange = { what: kArrayLengthWhat, low: 0 };

    const given = this.peekType(length.expr, module);
    this.requireBetween(length.expr, given, range, module);
  }

  private undefinedTargetCheck(target: MemberExpr, module: int): boolean {
    const object = target.object;
    if (object.kind == ExprKind.Name && object.name == kThisName) {
      return false;
    }

    const type = this.peekType(object, module);

    if (!this.types.isOptional(type) || target.optional) {
      return false;
    }
    if (this.library.isJsonHolder(type)) {
      return false;
    }

    this.report(module, object.loc, Code.AssignThroughUndefined, {
      word: target.name,
    });

    return true;
  }

  private openVariable(
    door: VariableDoor,
    variable: DeclaredVariable,
    module: int,
  ): void {
    const init = variable.decl.init;
    const isValue =
      init?.kind == ExprKind.ObjectLit || init?.kind == ExprKind.ArrayLit;
    const key = `${module} ${variable.decl.loc}`;

    if (isValue) {
      this.initializing.push({ key, depth: this.openFunctions.length });
    }

    this.open(door, variable, module);

    if (isValue) {
      this.initializing.pop();
    }
  }

  private readonly ownInitializerCheck(
    expr: NameExpr,
    target: ValueTarget,
    module: int,
  ): void {
    if (target.kind != SymbolKind.Variable) {
      return;
    }

    const key = `${target.module} ${target.loc}`;
    const frame = this.initializing.find((one) => one.key == key);
    if (frame == undefined) {
      return;
    }

    const inner = this.openFunctions.slice(frame.depth);
    if (!inner.every((fn) => this.shapes.isClosure(fn))) {
      return;
    }

    this.report(module, expr.loc, Code.OwnInitializer, { word: expr.name });
  }

  private assignedFieldNames(): Set<string> {
    if (this.writtenFields != undefined) {
      return new Set<string>(this.writtenFields);
    }

    const names = new Set<string>();

    for (let index = 0; index < this.program.modules.length; index++) {
      const opened = this.program.modules[index];
      if (opened != undefined && !opened.source.isLibrary) {
        this.collectWrittenFields(index, names);
      }
    }

    this.writtenFields = new Set<string>(names);

    return names;
  }

  private readonly collectWrittenFields(module: int, names: Set<string>): void {
    const record = this.record(module);
    if (record == undefined) {
      return;
    }

    for (const change of record.changes) {
      const target = this.bounds.changedTarget(change);
      if (target != undefined && target.kind == ExprKind.Member) {
        names.add(target.name);
      }
    }
  }

  private forgetFieldsNamed(target: Expr): void {
    if (target.kind != ExprKind.Member) {
      return;
    }

    const names = new Set<string>([target.name]);
    const kept = new Map<string, Type>();

    for (const [key, type] of this.facts) {
      if (!this.objects.isCalledPath(key, names)) {
        kept.set(key, type);
      }
    }

    this.facts = kept;
  }

  private forgetCalledFields(): void {
    const names = this.assignedFieldNames();
    const kept = new Map<string, Type>();

    for (const [key, type] of this.facts) {
      if (!this.objects.isCalledPath(key, names)) {
        kept.set(key, type);
      }
    }

    this.facts = kept;
  }

  private isOwnCall(callee: Expr, module: int): boolean {
    if (callee.kind == ExprKind.Name) {
      const target = this.targetOfName(callee, module);

      return (
        target != undefined && !this.modules.isLibraryModule(target.module)
      );
    }
    if (callee.kind != ExprKind.Member) {
      return false;
    }

    const object = this.peekType(callee.object, module);

    return (
      object.kind == TypeKind.Instance &&
      !this.modules.isLibraryModule(object.module)
    );
  }
}
