import { ProofRange } from "../../../../flow/proof-rules/types/proof-rules.types.tz";
import { kArrayLengthWhat } from "../../../../flow/proof-rules/const/proof-rules.const.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  Expr,
  ExprKind,
  MemberExpr,
  NameExpr,
  NewExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { ForOfStmt } from "../../../../../program/ast/types/ast.types.statements.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import {
  DictKind,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  TypeContext,
  TypePlace,
} from "../../../../types/type-resolver/types/type-resolver.types.tz";
import { kArrayClass, kThisName } from "../../const/expression-types.const.tz";
import {
  DeclaredVariable,
  ValueTarget,
  VariableDoor,
} from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private loopCannotCheck(loop: ForOfStmt, base: Type, module: int): void {
    const tree = this.types.program.tree;

    const loc = tree.exprOf(loop.iterableId).loc;

    switch (base.kind) {
      case TypeKind.Dict:
        if (base.dict == DictKind.Record) {
          this.errors.write(module, loc, Code.RecordNotIterable, kNoDetails);
        }

        return;
      case TypeKind.Instance:
        return this.instanceLoopCheck(
          tree.exprOf(loop.iterableId),
          base,
          module,
        );
      case TypeKind.Object:
        if (this.types.isIterableTarget(base)) {
          return;
        }
        if (this.matchItem(base) != undefined) {
          return;
        }

        this.errors.write(module, loc, Code.ForOfCannot, {
          word: this.types.typeText(base),
        });

        return;
      case TypeKind.Int:
      case TypeKind.Double:
      case TypeKind.Decimal:
      case TypeKind.Boolean:
      case TypeKind.Function:
      case TypeKind.Result:
      case TypeKind.Promise:
        this.errors.write(module, loc, Code.ForOfCannot, {
          word: this.types.typeText(base),
        });

        return;
      default:
        return;
    }
  }

  private arrayNew(
    expr: NewExpr,
    name: string,
    wanted: Type | undefined,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    if (name != kArrayClass || tree.argumentsOf(expr.argsList).length != 1) {
      return undefined;
    }

    const target = this.targetOfUse(expr.loc, name, module);
    if (target != undefined && !this.types.isLibraryModule(target.module)) {
      return undefined;
    }

    const element = this.arrayNewElement(expr, wanted, module);
    const length = tree.argumentsOf(expr.argsList)[0];
    if (element == undefined || length == undefined) {
      return undefined;
    }

    this.typed(
      tree.exprOf(length.exprId),
      this.types.store.integer(64, false),
      module,
    );

    return this.types.store.arrayOf(element);
  }

  private arrayNewElement(
    expr: NewExpr,
    wanted: Type | undefined,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const written = tree.typeRefsOf(expr.typeArgsList)[0];
    if (written != undefined) {
      const context: TypeContext = {
        module,
        bindings: new Map<int, Type>(),
        place: TypePlace.Plain,
      };

      return this.types.value(written, context);
    }

    const goal = this.types.wantedPart(wanted);
    if (goal == undefined || goal.kind != TypeKind.Array) {
      return undefined;
    }

    return this.types.store.itemOf(goal);
  }

  private newArrayCheck(
    expr: NewExpr,
    name: string,
    wanted: Type | undefined,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    if (name != kArrayClass) {
      return;
    }
    const goal = this.types.wantedPart(wanted);
    const isFromExpected = goal != undefined && goal.kind == TypeKind.Array;
    if (tree.typeRefsOf(expr.typeArgsList).length == 0 && !isFromExpected) {
      this.errors.write(
        module,
        expr.loc,
        Code.NewArrayNeedsElement,
        kNoDetails,
      );

      return;
    }

    const written = tree.typeRefsOf(expr.typeArgsList)[0];
    const length = tree.argumentsOf(expr.argsList)[0];
    const isSized =
      tree.argumentsOf(expr.argsList).length == 1 &&
      tree.typeRefsOf(expr.typeArgsList).length == 1;
    if (!isSized || written == undefined || length == undefined) {
      return;
    }

    const context: TypeContext = {
      module,
      bindings: new Map<int, Type>(),
      place: TypePlace.Plain,
    };
    const element = this.types.value(written, context);
    if (!this.types.hasZeroValue(element)) {
      this.errors.write(module, expr.loc, Code.NewArrayNoDefault, {
        word: this.types.typeText(element),
      });
    }

    const range: ProofRange = { what: kArrayLengthWhat, low: 0 };

    const exprExpr = tree.exprOf(length.exprId);
    const given = this.peekType(exprExpr, module);
    const lengthExpr = tree.exprOf(length.exprId);

    this.requireBetween(lengthExpr, given, range, module);
  }

  private undefinedTargetCheck(target: MemberExpr, module: int): boolean {
    const tree = this.types.program.tree;

    const object = tree.exprOf(target.objectId);
    if (object.kind == ExprKind.Name && object.name == kThisName) {
      return false;
    }

    const type = this.peekType(object, module);

    if (!this.types.isOptional(type) || target.optional) {
      return false;
    }
    if (this.types.isJsonHolder(type)) {
      return false;
    }

    this.errors.write(module, object.loc, Code.AssignThroughUndefined, {
      word: target.name,
    });

    return true;
  }

  private openVariable(
    key: string,
    variable: DeclaredVariable,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const init = tree.exprAt(variable.decl.initId);
    const isValue =
      init?.kind == ExprKind.ObjectLit || init?.kind == ExprKind.ArrayLit;

    if (isValue) {
      this.initializing.push({ key, depth: this.openFunctions.length });
    }

    this.open(key, variable, module);

    if (isValue) {
      this.initializing.pop();
    }
  }

  private ownInitializerCheck(
    expr: NameExpr,
    target: ValueTarget,
    module: int,
  ): void {
    if (target.kind != SymbolKind.Variable) {
      return;
    }

    const key = `${target.module} ${target.loc}`;
    const frame = this.initializing.find((one) => one.key == key);
    if (frame == undefined) {
      return;
    }

    const inner = this.openFunctions.slice(frame.depth);
    if (!inner.every((fn) => this.types.isClosure(fn))) {
      return;
    }

    this.errors.write(module, expr.loc, Code.OwnInitializer, {
      word: expr.name,
    });
  }

  private assignedFieldNames(): Read<Set<string>> {
    if (this.writtenKnown) {
      return this.writtenFields;
    }

    const names = new Set<string>();

    for (let index = 0; index < this.types.program.modules.length; index++) {
      const opened = this.types.program.modules[index];
      if (opened != undefined && !opened.source.isLibrary) {
        this.collectWrittenFields(index, names);
      }
    }

    this.writtenFields = names;
    this.writtenKnown = true;

    return this.writtenFields;
  }

  private readonly collectWrittenFields(module: int, names: Set<string>): void {
    const record = this.record(module);
    if (record == undefined) {
      return;
    }

    for (const change of record.changes) {
      const target = this.types.changedTarget(change);
      if (target != undefined && target.kind == ExprKind.Member) {
        names.add(target.name);
      }
    }
  }

  private forgetFieldsNamed(target: Expr): void {
    if (target.kind != ExprKind.Member) {
      return;
    }

    const names = new Set<string>([target.name]);
    const kept = new Map<string, Type>();

    for (const [key, type] of this.facts) {
      if (!this.types.isCalledPath(key, names)) {
        kept.set(key, type);
      }
    }

    this.facts = kept;
  }

  private forgetCalledFields(): void {
    const names = this.assignedFieldNames();
    const kept = new Map<string, Type>();

    for (const [key, type] of this.facts) {
      if (!this.types.isCalledPath(key, names)) {
        kept.set(key, type);
      }
    }

    this.facts = kept;
  }

  private isOwnCall(callee: Expr, module: int): boolean {
    const tree = this.types.program.tree;

    if (callee.kind == ExprKind.Name) {
      const target = this.targetOfName(callee, module);

      return (
        target != undefined && !this.types.isLibraryModule(target.module)
      );
    }
    if (callee.kind != ExprKind.Member) {
      return false;
    }

    const objectExpr = tree.exprOf(callee.objectId);
    const object = this.peekType(objectExpr, module);

    return (
      object.kind == TypeKind.Instance &&
      !this.types.isLibraryModule(object.module)
    );
  }
}
