import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  Expr,
  IndexExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  BindingKind,
  VarDeclarator,
} from "../../../../../program/ast/types/ast.types.patterns.tz";
import { TypeRef } from "../../../../../program/ast/types/ast.types.types.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  TypeContext,
  TypePlace,
} from "../../../../types/type-resolver/types/type-resolver.types.tz";
import {
  kMatchArrayClass,
  kNoPlace,
} from "../../const/expression-types.const.tz";
import {
  DeclaredVariable,
  VariableDoor,
} from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private patternSource(
    door: VariableDoor,
    variable: DeclaredVariable,
    module: int,
  ): void {
    const decl = variable.decl;
    const init = decl.init;
    const loop = variable.loop;
    if (loop != undefined) {
      const item = this.loopItem(loop, module);

      door.type = item;

      return this.loopShapeCheck(decl, item, module);
    }
    if (init == undefined) {
      return;
    }

    const given = this.patternGiven(init, decl.typeAnn, module);
    if (decl.form.kind != BindingKind.Array) {
      door.type = given;

      return;
    }

    door.type = this.patternArray(init, given, module);
  }

  private patternGiven(
    init: Expr,
    written: TypeRef | undefined,
    module: int,
  ): Type {
    if (written == undefined) {
      return this.typed(init, undefined, module);
    }

    const context: TypeContext = {
      module,
      bindings: new Map<int, Type>(),
      place: TypePlace.Plain,
    };
    const type = this.resolver.value(written, context);
    if (type.kind != TypeKind.Error) {
      this.checked(init, type, module, kNoPlace);
    }

    return type;
  }

  private patternArray(init: Expr, given: Type, module: int): Type {
    const base = this.types.apparent(given);
    if (this.library.isJsonHolder(given)) {
      return given;
    }

    switch (base.kind) {
      case TypeKind.Array:
      case TypeKind.Tuple:
      case TypeKind.Error:
      case TypeKind.Json:
        return given;
      default:
        break;
    }
    if (this.isMatchArray(base)) {
      return given;
    }

    const item = this.iteratedItem(given);
    if (item == undefined) {
      return this.notPatternArray(init, given, module);
    }

    return this.store.arrayOf(item);
  }

  private isMatchArray(type: Type): boolean {
    if (type.kind == TypeKind.Instance) {
      const isLibrary = this.modules.isLibraryModule(type.module);

      return isLibrary && type.name == kMatchArrayClass;
    }

    const isNamed = this.store.labelOf(type) == kMatchArrayClass;

    return isNamed && this.resolver.isLibraryShape(type);
  }

  private notPatternArray(init: Expr, given: Type, module: int): Type {
    const defined = this.types.definedType(given);
    const isMaybe =
      this.types.isOptional(given) && defined.kind == TypeKind.Array;
    const word = this.text.of(given);
    const error = this.store.plain(TypeKind.Error);
    if (isMaybe) {
      this.report(module, init.loc, Code.DestructureMaybeUndefined, { word });

      return error;
    }

    this.report(module, init.loc, Code.DestructureNotArray, { word });

    return error;
  }

  private loopShapeCheck(decl: VarDeclarator, item: Type, module: int): void {
    if (decl.form.kind != BindingKind.Array) {
      return;
    }

    const base = this.types.apparent(item);
    const isList =
      base.kind == TypeKind.Array ||
      base.kind == TypeKind.Tuple ||
      base.kind == TypeKind.Error;
    if (!isList && !this.isMatchArray(base)) {
      this.report(module, decl.loc, Code.DestructureElements, {
        word: this.text.of(item),
      });
    }
  }

  private patternElement(expr: IndexExpr, module: int): Type {
    const object = this.typed(expr.object, undefined, module);
    const base = this.types.apparent(object);
    if (this.library.isJsonHolder(object)) {
      return this.types.optional(this.store.plain(TypeKind.Json));
    }

    switch (base.kind) {
      case TypeKind.Array:
        return base.item;
      case TypeKind.Tuple:
        return this.tupleIndexed(expr, base, module);
      case TypeKind.Json:
        return base;
      default:
        return this.store.plain(TypeKind.Error);
    }
  }
}
