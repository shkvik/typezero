import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  Expr,
  IndexExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  BindingKind,
  VarDeclarator,
} from "../../../../../program/ast/types/ast.types.patterns.tz";
import { TypeRef } from "../../../../../program/ast/types/ast.types.types.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  TypeContext,
  TypePlace,
} from "../../../../types/type-resolver/types/type-resolver.types.tz";
import {
  kMatchArrayClass,
  kNoPlace,
} from "../../const/expression-types.const.tz";
import {
  DeclaredVariable,
  VariableDoor,
} from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private patternSource(
    key: string,
    variable: DeclaredVariable,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const decl = variable.decl;
    const init = tree.exprAt(decl.initId);
    const loop = variable.loop;
    if (loop != undefined) {
      const item = this.loopItem(loop, module);

      this.setDoorType(key, item);

      return this.loopShapeCheck(decl, item, module);
    }
    if (init == undefined) {
      return;
    }

    const given = this.patternGiven(
      init,
      tree.typeRefAt(decl.typeAnnId),
      module,
    );
    if (decl.form.kind != BindingKind.Array) {
      return this.setDoorType(key, given);
    }

    const array = this.patternArray(init, given, module);

    this.setDoorType(key, array);
  }

  private patternGiven(
    init: Expr,
    written: TypeRef | undefined,
    module: int,
  ): Type {
    if (written == undefined) {
      return this.typed(init, undefined, module);
    }

    const context: TypeContext = {
      module,
      bindings: new Map<int, Type>(),
      place: TypePlace.Plain,
    };
    const type = this.types.value(written, context);
    if (type.kind != TypeKind.Error) {
      this.checked(init, type, module, kNoPlace);
    }

    return type;
  }

  private patternArray(init: Expr, given: Type, module: int): Type {
    const base = this.types.apparent(given);
    if (this.types.isJsonHolder(given)) {
      return given;
    }

    switch (base.kind) {
      case TypeKind.Array:
      case TypeKind.Tuple:
      case TypeKind.Error:
      case TypeKind.Json:
        return given;
      default:
        break;
    }
    if (this.isMatchArray(base)) {
      return given;
    }

    const item = this.iteratedItem(given);
    if (item == undefined) {
      return this.notPatternArray(init, given, module);
    }

    return this.types.store.arrayOf(item);
  }

  private readonly isMatchArray(type: Type): boolean {
    if (type.kind == TypeKind.Instance) {
      const isLibrary = this.types.isLibraryModule(type.module);

      return isLibrary && type.name == kMatchArrayClass;
    }

    const isNamed = this.types.store.labelOf(type) == kMatchArrayClass;

    return isNamed && this.types.isLibraryShape(type);
  }

  private notPatternArray(init: Expr, given: Type, module: int): Type {
    const checked = this.types.notPatternArray(init, given);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private loopShapeCheck(decl: VarDeclarator, item: Type, module: int): void {
    if (decl.form.kind != BindingKind.Array) {
      return;
    }

    const base = this.types.apparent(item);
    const isList =
      base.kind == TypeKind.Array ||
      base.kind == TypeKind.Tuple ||
      base.kind == TypeKind.Error;
    if (!isList && !this.isMatchArray(base)) {
      this.errors.write(module, decl.loc, Code.DestructureElements, {
        word: this.types.typeText(item),
      });
    }
  }

  private patternElement(expr: IndexExpr, module: int): Type {
    const tree = this.types.program.tree;

    const objectExpr = tree.exprOf(expr.objectId);
    const object = this.typed(objectExpr, undefined, module);
    const base = this.types.apparent(object);
    if (this.types.isJsonHolder(object)) {
      return this.types.optional(this.types.store.plain(TypeKind.Json));
    }

    switch (base.kind) {
      case TypeKind.Array:
        return this.types.store.itemOf(base);
      case TypeKind.Tuple:
        return this.tupleIndexed(expr, base, module);
      case TypeKind.Json:
        return base;
      default:
        return this.types.store.plain(TypeKind.Error);
    }
  }
}
