import {
  CallExpr,
  Expr,
  IndexExpr,
  MemberExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  kRewritingMethods,
} from "../../../index-rules/const/index-rules.const.tz";
import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  TupleType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  kResizingMethods,
  kTupleJoin,
} from "../../const/expression-types.const.tz";

partial class ExpressionTypes {
  private indexTyped(expr: IndexExpr, module: int): Type {
    const tree = this.types.program.tree;

    const isMade = tree.exprOf(expr.indexId).loc == expr.loc;
    if (isMade) {
      return this.patternElement(expr, module);
    }

    const objectExpr = tree.exprOf(expr.objectId);
    const home = this.enumHomeOf(objectExpr, module);
    if (home != undefined) {
      return this.enumIndexed(expr, home, module);
    }

    const object = this.receiverOf(
      tree.exprOf(expr.objectId),
      expr.optional,
      module,
    );
    if (this.types.isJsonHolder(object)) {
      return this.jsonIndexed(expr, module);
    }

    const matched = this.matchIndexed(expr, object, module);
    if (matched != undefined) {
      return matched;
    }

    switch (object.kind) {
      case TypeKind.Tuple:
        return this.tupleIndexed(expr, object, module);
      case TypeKind.Object:
        return this.objectIndexed(expr, object, module);
      case TypeKind.Dict:
        return this.dictIndexed(expr, object, module);
      default:
        return this.otherIndexed(expr, object, module);
    }
  }

  private otherIndexed(expr: IndexExpr, object: Type, module: int): Type {
    const tree = this.types.program.tree;

    if (this.unknownIndexCheck(expr, object, module)) {
      return this.types.store.plain(TypeKind.Error);
    }

    if (object.kind == TypeKind.Array || object.kind == TypeKind.String) {
      return this.listIndexed(expr, object, module);
    }

    const element = this.types.elementOf(object);
    if (element != undefined) {
      return this.bytesIndexed(expr, element, module);
    }
    if (this.byteIndexCheck(expr, object, module)) {
      return this.types.store.plain(TypeKind.Error);
    }
    if (this.genericIndexCheck(expr, object, module)) {
      return this.types.store.plain(TypeKind.Error);
    }

    const index = tree.exprOf(expr.indexId);

    this.walkedPart(index, module);

    const defined = this.types.definedType(object);
    const isList =
      defined.kind == TypeKind.Array || defined.kind == TypeKind.String;
    if (this.types.isOptional(object) && isList) {
      this.errors.write(
        module,
        tree.exprOf(expr.objectId).loc,
        Code.IndexMaybeUndefined,
        kNoDetails,
      );

      return this.types.store.plain(TypeKind.Error);
    }
    if (this.types.isUnindexable(object)) {
      const first = this.types.typeText(object);

      this.errors.write(module, expr.loc, Code.NotIndexable, { first });
    }

    return this.types.store.plain(TypeKind.Error);
  }

  private genericIndexCheck(
    expr: IndexExpr,
    object: Type,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    if (object.kind != TypeKind.TypeParameter) {
      return false;
    }

    const index = tree.exprOf(expr.indexId);
    const key = this.peekType(index, module);
    const base = this.types.definedType(key);
    const isText =
      base.kind == TypeKind.String || base.kind == TypeKind.Template;
    if (!isText) {
      return false;
    }

    this.errors.write(
      module,
      tree.exprOf(expr.indexId).loc,
      Code.GenericIndexKey,
      {
        word: this.types.typeText(object),
        other: this.types.typeText(key),
      },
    );

    return true;
  }

  private listIndexed(expr: IndexExpr, list: Type, module: int): Type {
    const tree = this.types.program.tree;

    const int = this.types.store.integer(64, false);
    const index = tree.exprOf(expr.indexId);
    const key = this.typed(index, int, module);
    const item = this.types.listItem(list);
    if (key.kind != TypeKind.Int || item == undefined) {
      const indexExpr = tree.exprOf(expr.indexId);

      this.indexPositionCheck(indexExpr, key, module);

      return this.types.store.plain(TypeKind.Error);
    }
    if (
      this.isProvenIndex(
        tree.exprOf(expr.objectId),
        tree.exprOf(expr.indexId),
        module,
      )
    ) {
      return item;
    }

    return this.types.optional(item);
  }

  private indexPositionCheck(index: Expr, key: Type, module: int): void {
    const base = this.types.apparent(this.types.definedType(key));
    const isNumber = base.kind == TypeKind.Double || base.kind == TypeKind.Int;
    if (key.kind == TypeKind.Error || !isNumber) {
      return;
    }

    const code = this.types.positionCode(key, base);
    const word = this.types.typeText(key);

    this.errors.write(module, index.loc, code, { word });
  }

  private bytesIndexed(expr: IndexExpr, item: Type, module: int): Type {
    const tree = this.types.program.tree;

    const int = this.types.store.integer(64, false);
    const index = tree.exprOf(expr.indexId);
    const key = this.typed(index, int, module);
    if (key.kind != TypeKind.Int) {
      return this.types.store.plain(TypeKind.Error);
    }
    if (
      this.isProvenIndex(
        tree.exprOf(expr.objectId),
        tree.exprOf(expr.indexId),
        module,
      )
    ) {
      return item;
    }
    if (this.isMadeIndex(expr, key, module)) {
      return item;
    }

    return this.types.optional(item);
  }

  private isMadeIndex(expr: IndexExpr, key: Type, module: int): boolean {
    const tree = this.types.program.tree;

    const object = tree.exprOf(expr.objectId);
    const count = this.types.madeCount(object);
    const index = tree.exprOf(expr.indexId);
    const at = this.intConstant(index, key, module);
    if (count == undefined || at == undefined) {
      return false;
    }

    return at >= 0 && at < count.toDecimal();
  }

  private tupleIndexed(expr: IndexExpr, tuple: TupleType, module: int): Type {
    const tree = this.types.program.tree;

    const int = this.types.store.integer(64, false);
    const index = tree.exprOf(expr.indexId);
    const key = this.typed(index, int, module);
    const error = this.types.store.plain(TypeKind.Error);

    if (key.kind == TypeKind.Error) {
      return error;
    }
    if (key.kind != TypeKind.Int && key.kind != TypeKind.Literal) {
      const first = this.types.typeText(key);

      this.errors.write(
        module,
        tree.exprOf(expr.indexId).loc,
        Code.TupleKeyNotNumber,
        {
          first,
        },
      );

      return error;
    }

    const indexExpr = tree.exprOf(expr.indexId);
    const value = this.intConstant(indexExpr, key, module);
    if (value == undefined) {
      this.errors.write(module, expr.loc, Code.TupleKeyNotConstant, kNoDetails);

      return error;
    }

    const position = this.types.positionOf(
      value,
      this.types.store.itemsOf(tuple).length,
    );
    const item = this.types.store.itemsOf(tuple)[position];
    if (position < 0 || item == undefined) {
      const tupleRangeError = this.types.tupleRangeError(
        expr,
        tuple,
        `${value}`,
      );

      this.errors.writeFound(module, tupleRangeError);

      return error;
    }
    if (position >= tuple.required) {
      return this.types.optional(item);
    }

    return item;
  }

  private tupleCall(
    expr: CallExpr,
    member: MemberExpr,
    tuple: TupleType,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const word = member.name;
    const object = tree.exprOf(member.objectId);
    const first = this.types.sourceTupleText(object);
    const error = this.types.store.plain(TypeKind.Error);
    const element = this.types.tupleElement(tuple);
    const isResizing = kResizingMethods.includes(word);
    const isRewriting = kRewritingMethods.includes(word);

    if (word == kTupleJoin || !this.isArrayMethod(word, tuple)) {
      return error;
    }
    if (element != undefined && !isResizing && !isRewriting) {
      const list = this.types.store.arrayOf(element);

      this.tupleCalls.add(expr.id);

      return this.receiverCall(expr, member, list, undefined, module);
    }
    if (isResizing) {
      this.errors.write(module, member.loc, Code.TupleResized, { word, first });

      return error;
    }

    if (this.tupleUnion(tuple) == undefined) {
      const code = Code.TupleMethodDestructure;

      this.errors.write(module, member.loc, code, { word, first });

      return error;
    }

    this.errors.write(module, member.loc, Code.TupleMethodCopy, {
      word,
      first,
    });

    return error;
  }

  private tupleUnion(tuple: TupleType): Type | undefined {
    let joined: Type | undefined = undefined;

    for (const item of this.types.store.itemsOf(tuple)) {
      joined = this.joinedUnion(joined, item);
      if (joined == undefined || joined.kind == TypeKind.Error) {
        return undefined;
      }
    }

    return joined;
  }

  private joinedUnion(joined: Type | undefined, item: Type): Type | undefined {
    if (joined == undefined) {
      return item;
    }

    return this.types.unionUnify(joined, item);
  }

  private isArrayMethod(name: string, tuple: TupleType): boolean {
    const item =
      this.types.store.itemsOf(tuple)[0] ??
      this.types.store.plain(TypeKind.Error);
    const list = this.types.store.arrayOf(item);
    const receiver = this.libraryReceiver(list);
    if (receiver == undefined) {
      return false;
    }

    return this.receiverMember(receiver, name, true) != undefined;
  }
}
