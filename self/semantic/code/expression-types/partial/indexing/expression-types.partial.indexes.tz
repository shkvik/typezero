import {
  BinaryExpr,
  CallExpr,
  Expr,
  ExprKind,
  IndexExpr,
  MemberExpr,
  UnaryExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { kRewritingMethods } from "../../../index-rules/const/index-rules.const.tz";
import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  DictKind,
  DictType,
  LiteralKind,
  ObjectType,
  TupleType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  kResizingMethods,
  kTupleJoin,
} from "../../const/expression-types.const.tz";

partial class ExpressionTypes {
  private indexTyped(expr: IndexExpr, module: int): Type {
    const isMade = expr.index.loc == expr.loc;
    if (isMade) {
      return this.patternElement(expr, module);
    }

    const home = this.enumHomeOf(expr.object, module);
    if (home != undefined) {
      return this.enumIndexed(expr, home, module);
    }

    const object = this.receiverOf(expr.object, expr.optional, module);
    if (this.library.isJsonHolder(object)) {
      return this.jsonIndexed(expr, module);
    }

    switch (object.kind) {
      case TypeKind.Tuple:
        return this.tupleIndexed(expr, object, module);
      case TypeKind.Object:
        return this.objectIndexed(expr, object, module);
      case TypeKind.Dict:
        return this.dictIndexed(expr, object, module);
      default:
        return this.otherIndexed(expr, object, module);
    }
  }

  private otherIndexed(expr: IndexExpr, object: Type, module: int): Type {
    if (this.unknownIndexCheck(expr, object, module)) {
      return this.store.plain(TypeKind.Error);
    }

    if (object.kind == TypeKind.Array || object.kind == TypeKind.String) {
      return this.listIndexed(expr, object, module);
    }

    const element = this.bytes.elementOf(object);
    if (element != undefined) {
      return this.bytesIndexed(expr, element, module);
    }
    if (this.byteIndexCheck(expr, object, module)) {
      return this.store.plain(TypeKind.Error);
    }
    if (this.genericIndexCheck(expr, object, module)) {
      return this.store.plain(TypeKind.Error);
    }

    this.walkedPart(expr.index, module);

    const defined = this.types.definedType(object);
    const isList =
      defined.kind == TypeKind.Array || defined.kind == TypeKind.String;
    if (this.types.isOptional(object) && isList) {
      this.report(
        module,
        expr.object.loc,
        Code.IndexMaybeUndefined,
        kNoDetails,
      );

      return this.store.plain(TypeKind.Error);
    }
    if (this.indexes.isUnindexable(object)) {
      const first = this.text.of(object);

      this.report(module, expr.loc, Code.NotIndexable, { first });
    }

    return this.store.plain(TypeKind.Error);
  }

  private genericIndexCheck(
    expr: IndexExpr,
    object: Type,
    module: int,
  ): boolean {
    if (object.kind != TypeKind.TypeParameter) {
      return false;
    }

    const key = this.peekType(expr.index, module);
    const base = this.types.definedType(key);
    const isText =
      base.kind == TypeKind.String || base.kind == TypeKind.Template;
    if (!isText) {
      return false;
    }

    this.report(module, expr.index.loc, Code.GenericIndexKey, {
      word: this.text.of(object),
      other: this.text.of(key),
    });

    return true;
  }

  private listIndexed(expr: IndexExpr, list: Type, module: int): Type {
    const int = this.store.integer(64, false);
    const key = this.typed(expr.index, int, module);
    const item = this.indexes.listItem(list);
    if (key.kind != TypeKind.Int || item == undefined) {
      this.indexPositionCheck(expr.index, key, module);

      return this.store.plain(TypeKind.Error);
    }
    if (this.isProvenIndex(expr.object, expr.index, module)) {
      return item;
    }

    return this.types.optional(item);
  }

  private indexPositionCheck(index: Expr, key: Type, module: int): void {
    const base = this.types.apparent(this.types.definedType(key));
    const isNumber = base.kind == TypeKind.Double || base.kind == TypeKind.Int;
    if (key.kind == TypeKind.Error || !isNumber) {
      return;
    }

    const code = this.calls.positionCode(key, base);
    const word = this.text.of(key);

    this.report(module, index.loc, code, { word });
  }

  private bytesIndexed(expr: IndexExpr, item: Type, module: int): Type {
    const int = this.store.integer(64, false);
    const key = this.typed(expr.index, int, module);
    if (key.kind != TypeKind.Int) {
      return this.store.plain(TypeKind.Error);
    }
    if (this.isProvenIndex(expr.object, expr.index, module)) {
      return item;
    }
    if (this.isMadeIndex(expr, key, module)) {
      return item;
    }

    return this.types.optional(item);
  }

  private isMadeIndex(expr: IndexExpr, key: Type, module: int): boolean {
    const count = this.shapes.madeCount(expr.object);
    const at = this.intConstant(expr.index, key, module);
    if (count == undefined || at == undefined) {
      return false;
    }

    return at >= 0 && at < count.toDecimal();
  }

  private tupleIndexed(expr: IndexExpr, tuple: TupleType, module: int): Type {
    const int = this.store.integer(64, false);
    const key = this.typed(expr.index, int, module);
    const error = this.store.plain(TypeKind.Error);

    if (key.kind == TypeKind.Error) {
      return error;
    }
    if (key.kind != TypeKind.Int && key.kind != TypeKind.Literal) {
      const first = this.text.of(key);

      this.report(module, expr.index.loc, Code.TupleKeyNotNumber, { first });

      return error;
    }

    const value = this.intConstant(expr.index, key, module);
    if (value == undefined) {
      this.report(module, expr.loc, Code.TupleKeyNotConstant, kNoDetails);

      return error;
    }

    const position = this.indexes.positionOf(value, tuple.items.length);
    const item = tuple.items[position];
    if (position < 0 || item == undefined) {
      const tupleRangeError = this.indexes.tupleRangeError(
        expr,
        tuple,
        `${value}`,
      );

      this.reportFound(module, tupleRangeError);

      return error;
    }
    if (position >= tuple.required) {
      return this.types.optional(item);
    }

    return item;
  }

  private objectIndexed(
    expr: IndexExpr,
    object: ObjectType,
    module: int,
  ): Type {
    const key = this.typed(expr.index, undefined, module);
    const error = this.store.plain(TypeKind.Error);

    if (key.kind == TypeKind.Error || this.resolver.isLibraryShape(object)) {
      return error;
    }

    const name = this.constantKeyOf(expr.index, key, module);
    if (name != undefined) {
      const member = this.indexes.keyedMember(expr, name);

      return this.memberOf(member, object, module);
    }

    const choices = this.keyChoices(expr.index, key, module);
    const chosen = this.chosenField(object, choices);
    if (chosen != undefined) {
      return chosen;
    }

    const first = this.text.of(object);
    const defined = this.types.definedType(key);
    if (this.types.isNumber(defined)) {
      this.report(module, expr.loc, Code.ObjectNumberedKey, { first });

      return error;
    }
    if (defined.kind == TypeKind.String || defined.kind == TypeKind.Template) {
      this.report(module, expr.loc, Code.ObjectRuntimeKey, { first });

      return error;
    }
    if (defined.kind == TypeKind.Boolean) {
      const shown = this.text.of(key);

      this.report(module, expr.index.loc, Code.ObjectKeyNotString, {
        first: shown,
      });
    }

    return error;
  }

  private chosenField(
    object: ObjectType,
    choices: Type | undefined,
  ): Type | undefined {
    if (choices == undefined) {
      return undefined;
    }

    return this.keyedFieldType(object, choices);
  }

  private keyChoices(index: Expr, key: Type, module: int): Type | undefined {
    if (this.isTextChoice(key)) {
      return key;
    }
    if (index.kind != ExprKind.Name) {
      return undefined;
    }

    const texts = this.doorOfName(index, module)?.texts;
    if (texts == undefined) {
      return undefined;
    }

    const literals = texts.map((text) =>
      this.store.literal(LiteralKind.String, text),
    );

    return this.store.unionOf(literals);
  }

  private isTextChoice(key: Type): boolean {
    const parts = this.generics.partsOfType(key);

    return parts.every(
      (part) =>
        part.kind == TypeKind.Literal && part.literal == LiteralKind.String,
    );
  }

  private keyedFieldType(object: ObjectType, key: Type): Type | undefined {
    let common: Type | undefined = undefined;

    for (const part of this.generics.partsOfType(key)) {
      if (part.kind != TypeKind.Literal) {
        return undefined;
      }

      const name = part.text;
      const field = object.fields.find((one) => one.name == name);
      if (field == undefined) {
        return undefined;
      }

      const type = this.objects.fieldWanted(field);
      if (common != undefined && type != common) {
        return undefined;
      }

      common = type;
    }

    return common;
  }

  private keyedWriteCheck(target: Expr, module: int): boolean {
    if (target.kind != ExprKind.Index) {
      return false;
    }

    const holder = this.peekType(target.object, module);
    const object = this.types.definedType(holder);
    if (object.kind != TypeKind.Object) {
      return false;
    }

    const key = this.peekType(target.index, module);
    if (this.constantKeyOf(target.index, key, module) != undefined) {
      return false;
    }
    if (this.isEnumKey(key)) {
      return false;
    }

    const choices = this.keyChoices(target.index, key, module);
    const field = this.chosenField(object, choices);
    if (choices == undefined || field == undefined) {
      return false;
    }

    const names: string[] = [];

    for (const part of this.generics.partsOfType(choices)) {
      if (part.kind == TypeKind.Literal) {
        names.push(part.text);
      }
    }

    return this.keyedFieldWrite(target, object, field, names, module);
  }

  private isEnumKey(key: Type): boolean {
    const label = this.store.labelOf(key);
    if (label == undefined) {
      return false;
    }

    for (let index = 0; index < this.program.modules.length; index++) {
      const opened = this.program.modules[index];
      if (opened == undefined || opened.source.isLibrary) {
        continue;
      }

      const record = this.record(index);
      if (record == undefined) {
        continue;
      }

      for (const decl of record.enums.values()) {
        if (decl.name == label) {
          return true;
        }
      }
    }

    return false;
  }

  private keyedFieldWrite(
    target: Expr,
    object: ObjectType,
    field: Type,
    names: string[],
    module: int,
  ): boolean {
    const isReadonly = object.fields.some(
      (one) => names.includes(one.name) && one.readonly,
    );
    if (isReadonly) {
      this.report(module, target.loc, Code.KeyedReadonly, kNoDetails);

      return true;
    }

    const assigned = this.assignedFieldNames();
    const isKnown = names.every((name) => assigned.has(name));
    const isLoose =
      this.types.isOptional(field) ||
      field.kind == TypeKind.Union ||
      field.kind == TypeKind.Literal;
    if (!isLoose || isKnown) {
      return false;
    }

    this.report(module, target.loc, Code.KeyedByName, {
      word: this.text.of(field),
    });

    return true;
  }

  private constantKeyOf(
    index: Expr,
    key: Type,
    module: int,
  ): string | undefined {
    if (index.kind == ExprKind.StringLit) {
      return index.value;
    }
    if (key.kind == TypeKind.Literal && key.literal == LiteralKind.String) {
      return key.text;
    }
    if (index.kind != ExprKind.Name) {
      return undefined;
    }

    const door = this.doorOfName(index, module);
    const literal = door?.literal;
    if (literal == undefined || literal.kind != LiteralKind.String) {
      return undefined;
    }

    return literal.text;
  }

  private dictIndexed(expr: IndexExpr, dict: DictType, module: int): Type {
    const word = this.sources.tupleText(expr.object);
    const error = this.store.plain(TypeKind.Error);

    switch (dict.dict) {
      case DictKind.Map:
        this.walkedPart(expr.index, module);
        this.report(module, expr.loc, Code.MapIndex, { word });

        return error;
      case DictKind.Set:
        this.walkedPart(expr.index, module);
        this.report(module, expr.loc, Code.SetIndex, { word });

        return error;
      default:
        return this.recordIndexed(expr, dict, module);
    }
  }

  private recordIndexed(expr: IndexExpr, dict: DictType, module: int): Type {
    const key = this.typed(expr.index, dict.key, module);
    const defined = this.types.definedType(key);
    if (defined.kind == TypeKind.Int || defined.kind == TypeKind.Double) {
      const first = this.text.of(key);

      this.report(module, expr.index.loc, Code.RecordNumberKey, { first });

      return this.store.plain(TypeKind.Error);
    }

    return this.types.optional(dict.value);
  }

  private keyInTyped(expr: BinaryExpr, module: int): Type {
    const boolean = this.store.plain(TypeKind.Boolean);
    const object = this.typed(expr.rhs, undefined, module);

    this.walkedPart(expr.lhs, module);

    if (this.dictInCheck(expr, object, module)) {
      return boolean;
    }
    if (this.listInCheck(expr, object, module)) {
      return boolean;
    }

    const lhs = expr.lhs;
    const isUnion = object.kind == TypeKind.Union;

    if (lhs.kind == ExprKind.StringLit && object.kind == TypeKind.Union) {
      this.unionInCheck(expr, lhs.value, object, module);
    }
    if (lhs.kind != ExprKind.StringLit || object.kind != TypeKind.Object) {
      return boolean;
    }
    if (isUnion || this.resolver.isLibraryShape(object)) {
      return boolean;
    }

    const name = lhs.value;
    const field = object.fields.find((one) => one.name == name);
    if (field == undefined) {
      const first = this.text.of(object);

      this.report(module, expr.loc, Code.InObjectFalse, { word: name, first });

      return boolean;
    }
    if (field.optional || this.types.isOptional(field.type)) {
      const word = `${this.sources.tupleText(expr.rhs)}.${name}`;

      this.report(module, expr.loc, Code.InObjectMaybe, { word });

      return boolean;
    }

    this.report(module, expr.loc, Code.InObjectTrue, kNoDetails);

    return boolean;
  }

  private deleteTyped(expr: UnaryExpr, module: int): Type {
    const target = expr.operand;
    const boolean = this.store.plain(TypeKind.Boolean);

    if (this.dictDeleteCheck(expr, module)) {
      return boolean;
    }
    if (this.plainDeleteCheck(expr, target, module)) {
      return boolean;
    }
    if (target.kind == ExprKind.Index) {
      if (this.indexDeleteCheck(expr, target, module)) {
        return boolean;
      }
    }

    const name = this.deletedName(target, module);
    const holder = this.indexes.deletedHolder(target);
    if (name == undefined || holder == undefined) {
      return boolean;
    }

    const object = this.typed(holder, undefined, module);
    if (
      object.kind != TypeKind.Object ||
      this.resolver.isLibraryShape(object)
    ) {
      return boolean;
    }

    const field = object.fields.find((one) => one.name == name);
    if (field == undefined) {
      return boolean;
    }
    if (field.optional || this.types.isOptional(field.type)) {
      const first = `${this.sources.tupleText(holder)}.${name}`;

      this.report(module, expr.loc, Code.DeleteOptional, { word: name, first });

      return boolean;
    }

    this.report(module, expr.loc, Code.DeleteRequired, { word: name });

    return boolean;
  }

  private deletedName(target: Expr, module: int): string | undefined {
    if (target.kind == ExprKind.Member) {
      return target.name;
    }
    if (target.kind == ExprKind.Index) {
      return this.constantKey(target.index, module);
    }

    return undefined;
  }

  private tupleCall(
    expr: CallExpr,
    member: MemberExpr,
    tuple: TupleType,
    module: int,
  ): Type {
    const word = member.name;
    const first = this.sources.tupleText(member.object);
    const error = this.store.plain(TypeKind.Error);
    const element = this.indexes.tupleElement(tuple);
    const isResizing = kResizingMethods.includes(word);
    const isRewriting = kRewritingMethods.includes(word);

    if (word == kTupleJoin || !this.isArrayMethod(word, tuple)) {
      return error;
    }
    if (element != undefined && !isResizing && !isRewriting) {
      const list = this.store.arrayOf(element);

      this.tupleCalls.add(expr);

      return this.receiverCall(expr, member, list, undefined, module);
    }
    if (isResizing) {
      this.report(module, member.loc, Code.TupleResized, { word, first });

      return error;
    }

    if (this.tupleUnion(tuple) == undefined) {
      const code = Code.TupleMethodDestructure;

      this.report(module, member.loc, code, { word, first });

      return error;
    }

    this.report(module, member.loc, Code.TupleMethodCopy, { word, first });

    return error;
  }

  private tupleUnion(tuple: TupleType): Type | undefined {
    let joined: Type | undefined = undefined;

    for (const item of tuple.items) {
      joined = this.joinedUnion(joined, item);
      if (joined == undefined || joined.kind == TypeKind.Error) {
        return undefined;
      }
    }

    return joined;
  }

  private joinedUnion(joined: Type | undefined, item: Type): Type | undefined {
    if (joined == undefined) {
      return item;
    }

    return this.unifier.unionUnify(joined, item);
  }

  private isArrayMethod(name: string, tuple: TupleType): boolean {
    const item = tuple.items[0] ?? this.store.plain(TypeKind.Error);
    const list = this.store.arrayOf(item);
    const receiver = this.libraryReceiver(list);
    if (receiver == undefined) {
      return false;
    }

    return this.receiverMember(receiver, name, true) != undefined;
  }
}
