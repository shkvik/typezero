import { ExpressionTypes } from "../../expression-types.tz";
import { ForOfStmt } from "../../../../../program/ast/types/ast.types.statements.tz";
import { Type } from "../../../../../program/type/types/type.types.tz";

partial class ExpressionTypes {
  private readonly forInKeys(loop: ForOfStmt, iterable: Type, module: int): Type {
    const checked = this.dictionaries.forInKeys(loop, iterable);

    this.reportFound(module, checked.error);

    return checked.value;
  }
}
