import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  ArrayElement,
  ArrayLitExpr,
  Expr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { kNoPlace } from "../../const/expression-types.const.tz";
import { ArrayDraft } from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private arrayTyped(
    expr: ArrayLitExpr,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const expected = this.arrays.jsonArrayOr(wanted);
    const array = this.arrays.wantedArray(expected);
    const hole = expr.elements.find((element) => element.hole);
    if (hole != undefined) {
      this.report(module, hole.expr.loc, Code.ArrayHole, kNoDetails);

      return this.looseElements(expr, module);
    }

    const plain = this.types.wantedPart(array);
    if (plain != undefined && plain.kind == TypeKind.Tuple) {
      return this.tupleTyped(expr, plain, module);
    }

    const item = this.arrays.wantedItem(plain);

    return this.listTyped(expr, item, module);
  }

  private looseElements(expr: ArrayLitExpr, module: int): Type {
    for (const element of expr.elements) {
      if (!element.hole) {
        this.typed(element.expr, undefined, module);
      }
    }

    return this.store.plain(TypeKind.Error);
  }

  private tupleTyped(expr: ArrayLitExpr, tuple: Type, module: int): Type {
    if (tuple.kind != TypeKind.Tuple) {
      return this.store.plain(TypeKind.Error);
    }

    const first = this.text.of(tuple);
    const spread = expr.elements.find((element) => element.spread);
    if (spread != undefined) {
      this.report(module, spread.expr.loc, Code.TupleTakesNoSpread, {
        first,
      });

      return this.looseElements(expr, module);
    }

    const want = tuple.items.length;
    const got = expr.elements.length;
    if (want != got) {
      this.report(module, expr.loc, Code.TupleLength, {
        first,
        word: `${want}`,
        other: `${got}`,
      });

      return this.looseElements(expr, module);
    }

    for (let index = 0; index < want; index++) {
      const element = expr.elements[index];
      const item = tuple.items[index];
      if (element == undefined || item == undefined) {
        continue;
      }

      const place = this.arrays.elementPlace(index);

      this.checked(element.expr, item, module, place);
    }

    return tuple;
  }

  private listTyped(
    expr: ArrayLitExpr,
    item: Type | undefined,
    module: int,
  ): Type {
    const draft: ArrayDraft = {
      types: new Map<int, Type>(),
      spreads: new Map<int, Type>(),
      hasDecimal: false,
    };

    this.firstPass(expr, item, draft, module);

    const hint = this.arrays.literalHint(expr, draft);

    this.secondPass(expr, hint, draft, module);

    const element = item ?? this.joinedElement(expr, draft, module);
    if (element == undefined || element.kind == TypeKind.Error) {
      return this.store.plain(TypeKind.Error);
    }

    const array = this.store.arrayOf(element);

    this.coerceElements(expr, element, array, draft, module);

    return array;
  }

  private firstPass(
    expr: ArrayLitExpr,
    item: Type | undefined,
    draft: ArrayDraft,
    module: int,
  ): void {
    let index = 0;

    for (const element of expr.elements) {
      this.firstPassElement(element, index, item, draft, module);

      index += 1;
    }
  }

  private firstPassElement(
    element: ArrayElement,
    index: int,
    item: Type | undefined,
    draft: ArrayDraft,
    module: int,
  ): void {
    if (element.spread) {
      return this.spreadElement(element.expr, index, item, draft, module);
    }
    if (item == undefined && this.shapes.isNumberTree(element.expr)) {
      return;
    }

    const hint = this.arrays.elementHint(element.expr, item, draft.seen);
    const type = this.typed(element.expr, hint, module);

    draft.types.set(index, type);
    draft.hasDecimal = draft.hasDecimal || this.arrays.isDecimalLike(type);

    this.arrays.seeElement(draft, type);
  }

  private spreadElement(
    expr: Expr,
    index: int,
    item: Type | undefined,
    draft: ArrayDraft,
    module: int,
  ): void {
    const hint = this.arrays.spreadHint(item);
    const type = this.typed(expr, hint, module);

    const resumedError = this.functions.resumedCheck(
      expr,
      type,
      Code.SpreadResumes,
    );

    this.reportFound(module, resumedError);

    const element = this.spreadItem(expr, type, module);
    const source = this.arrays.spreadSource(type);

    draft.types.set(index, element);
    draft.spreads.set(index, source);

    if (type.kind == TypeKind.Array) {
      draft.hasDecimal = draft.hasDecimal || this.arrays.isDecimalLike(element);
    }
  }

  private spreadItem(expr: Expr, type: Type, module: int): Type {
    const matched = this.matchItem(type);
    if (matched != undefined) {
      return matched;
    }

    const isLibrary =
      (type.kind == TypeKind.Instance &&
        this.modules.isLibraryModule(type.module)) ||
      this.resolver.isLibraryShape(type);
    if (isLibrary || this.arrays.isUnsupportedSpread(type)) {
      return this.store.plain(TypeKind.Error);
    }

    switch (type.kind) {
      case TypeKind.Error:
      case TypeKind.String:
        return type;
      case TypeKind.Array:
        return type.item;
      case TypeKind.Tuple:
        return this.tupleItem(expr, type, module);
      case TypeKind.Dict:
        return this.refusedSpread(expr, type, Code.RecordNotSpreadable, module);
      default:
        return this.refusedSpread(expr, type, Code.NotSpreadable, module);
    }
  }

  private refusedSpread(expr: Expr, type: Type, code: Code, module: int): Type {
    const checked = this.arrays.refusedSpread(expr, type, code);

    this.reportFound(module, checked.error);

    return checked.value;
  }

  private tupleItem(expr: Expr, tuple: Type, module: int): Type {
    const checked = this.arrays.tupleItem(expr, tuple);

    this.reportFound(module, checked.error);

    return checked.value;
  }

  private secondPass(
    expr: ArrayLitExpr,
    hint: Type | undefined,
    draft: ArrayDraft,
    module: int,
  ): void {
    let index = 0;

    for (const element of expr.elements) {
      if (!draft.types.has(index)) {
        const type = this.typed(element.expr, hint, module);

        draft.types.set(index, type);
      }

      index += 1;
    }
  }

  private joinedElement(
    expr: ArrayLitExpr,
    draft: ArrayDraft,
    module: int,
  ): Type | undefined {
    const checked = this.arrays.joinedElement(expr, draft);

    this.reportFound(module, checked.error);

    return checked.value;
  }

  private coerceElements(
    expr: ArrayLitExpr,
    element: Type,
    array: Type,
    draft: ArrayDraft,
    module: int,
  ): void {
    let index = 0;

    for (const item of expr.elements) {
      const given = draft.types.get(index) ?? this.store.plain(TypeKind.Error);
      const spread = draft.spreads.get(index) ?? given;
      const source = this.matchList(spread) ?? spread;

      index += 1;

      if (!item.spread) {
        this.coerce(item.expr, given, element, module, kNoPlace);

        continue;
      }
      if (!this.arrays.spreadFits(source, element, array)) {
        const first = this.text.of(source);
        const second = this.text.of(array);

        this.report(module, item.expr.loc, Code.SpreadMismatch, {
          first,
          second,
        });
      }
    }
  }
}
