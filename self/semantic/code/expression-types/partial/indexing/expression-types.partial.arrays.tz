import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  ArrayElement,
  ArrayLitExpr,
  Expr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { kNoPlace } from "../../const/expression-types.const.tz";
import { ArrayDraft } from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private arrayTyped(
    expr: ArrayLitExpr,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const expected = this.types.jsonArrayOr(wanted);
    const array = this.types.wantedArray(expected);
    const hole = tree
      .elementsOf(expr.elementsList)
      .find((element) => element.hole);
    if (hole != undefined) {
      this.errors.write(
        module,
        tree.exprOf(hole.exprId).loc,
        Code.ArrayHole,
        kNoDetails,
      );

      return this.looseElements(expr, module);
    }

    const plain = this.types.wantedPart(array);
    if (plain != undefined && plain.kind == TypeKind.Tuple) {
      return this.tupleTyped(expr, plain, module);
    }

    const item = this.types.wantedItem(plain);

    return this.listTyped(expr, item, module);
  }

  private looseElements(expr: ArrayLitExpr, module: int): Type {
    const tree = this.types.program.tree;

    for (const element of tree.elementsOf(expr.elementsList)) {
      if (!element.hole) {
        const exprExpr = tree.exprOf(element.exprId);

        this.typed(exprExpr, undefined, module);
      }
    }

    return this.types.store.plain(TypeKind.Error);
  }

  private tupleTyped(expr: ArrayLitExpr, tuple: Type, module: int): Type {
    const tree = this.types.program.tree;

    if (tuple.kind != TypeKind.Tuple) {
      return this.types.store.plain(TypeKind.Error);
    }

    const first = this.types.typeText(tuple);
    const spread = tree
      .elementsOf(expr.elementsList)
      .find((element) => element.spread);
    if (spread != undefined) {
      this.errors.write(
        module,
        tree.exprOf(spread.exprId).loc,
        Code.TupleTakesNoSpread,
        {
          first,
        },
      );

      return this.looseElements(expr, module);
    }

    const want = this.types.store.itemsOf(tuple).length;
    const got = tree.elementsOf(expr.elementsList).length;
    if (want != got) {
      this.errors.write(module, expr.loc, Code.TupleLength, {
        first,
        word: `${want}`,
        other: `${got}`,
      });

      return this.looseElements(expr, module);
    }

    for (let index = 0; index < want; index++) {
      const element = tree.elementsOf(expr.elementsList)[index];
      const item = this.types.store.itemsOf(tuple)[index];
      if (element == undefined || item == undefined) {
        continue;
      }

      const place = this.types.elementPlace(index);

      const exprExpr = tree.exprOf(element.exprId);

      this.checked(exprExpr, item, module, place);
    }

    return tuple;
  }

  private listTyped(
    expr: ArrayLitExpr,
    item: Type | undefined,
    module: int,
  ): Type {
    const draft: ArrayDraft = {
      types: new Map<int, Type>(),
      spreads: new Map<int, Type>(),
      hasDecimal: false,
    };

    this.firstPass(expr, item, draft, module);

    const hint = this.types.literalHint(expr, draft);

    this.secondPass(expr, hint, draft, module);

    const element = item ?? this.joinedElement(expr, draft, module);
    if (element == undefined || element.kind == TypeKind.Error) {
      return this.types.store.plain(TypeKind.Error);
    }

    const array = this.types.store.arrayOf(element);

    this.coerceElements(expr, element, array, draft, module);

    return array;
  }

  private firstPass(
    expr: ArrayLitExpr,
    item: Type | undefined,
    draft: ArrayDraft,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    let index = 0;

    for (const element of tree.elementsOf(expr.elementsList)) {
      this.firstPassElement(element, index, item, draft, module);

      index += 1;
    }
  }

  private firstPassElement(
    element: ArrayElement,
    index: int,
    item: Type | undefined,
    draft: ArrayDraft,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    if (element.spread) {
      return this.spreadElement(
        tree.exprOf(element.exprId),
        index,
        item,
        draft,
        module,
      );
    }
    if (
      item == undefined &&
      this.types.isNumberTree(tree.exprOf(element.exprId))
    ) {
      return;
    }

    const hint = this.types.elementHint(
      tree.exprOf(element.exprId),
      item,
      draft.seen,
    );
    const expr = tree.exprOf(element.exprId);
    const type = this.typed(expr, hint, module);

    draft.types.set(index, type);
    draft.hasDecimal = draft.hasDecimal || this.types.isDecimalLike(type);

    this.types.seeElement(draft, type);
  }

  private spreadElement(
    expr: Expr,
    index: int,
    item: Type | undefined,
    draft: ArrayDraft,
    module: int,
  ): void {
    const hint = this.types.spreadHint(item);
    const type = this.typed(expr, hint, module);

    const resumedError = this.types.resumedCheck(
      expr,
      type,
      Code.SpreadResumes,
    );

    this.errors.writeFound(module, resumedError);

    const element = this.spreadItem(expr, type, module);
    const source = this.types.spreadSource(type);

    draft.types.set(index, element);
    draft.spreads.set(index, source);

    if (type.kind == TypeKind.Array) {
      draft.hasDecimal = draft.hasDecimal || this.types.isDecimalLike(element);
    }
  }

  private spreadItem(expr: Expr, type: Type, module: int): Type {
    const matched = this.matchItem(type);
    if (matched != undefined) {
      return matched;
    }

    const isLibrary =
      (type.kind == TypeKind.Instance &&
        this.types.isLibraryModule(type.module)) ||
      this.types.isLibraryShape(type);
    if (isLibrary || this.types.isUnsupportedSpread(type)) {
      return this.types.store.plain(TypeKind.Error);
    }

    switch (type.kind) {
      case TypeKind.Error:
      case TypeKind.String:
        return type;
      case TypeKind.Array:
        return this.types.store.itemOf(type);
      case TypeKind.Tuple:
        return this.tupleItem(expr, type, module);
      case TypeKind.Dict:
        return this.refusedSpread(expr, type, Code.RecordNotSpreadable, module);
      default:
        return this.refusedSpread(expr, type, Code.NotSpreadable, module);
    }
  }

  private refusedSpread(expr: Expr, type: Type, code: Code, module: int): Type {
    const checked = this.types.refusedSpread(expr, type, code);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private tupleItem(expr: Expr, tuple: Type, module: int): Type {
    const checked = this.types.tupleItem(expr, tuple);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private secondPass(
    expr: ArrayLitExpr,
    hint: Type | undefined,
    draft: ArrayDraft,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    let index = 0;

    for (const element of tree.elementsOf(expr.elementsList)) {
      if (!draft.types.has(index)) {
        const exprExpr = tree.exprOf(element.exprId);
        const type = this.typed(exprExpr, hint, module);

        draft.types.set(index, type);
      }

      index += 1;
    }
  }

  private joinedElement(
    expr: ArrayLitExpr,
    draft: Read<ArrayDraft>,
    module: int,
  ): Type | undefined {
    const checked = this.types.joinedElement(expr, draft);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private coerceElements(
    expr: ArrayLitExpr,
    element: Type,
    array: Type,
    draft: Read<ArrayDraft>,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    let index = 0;

    for (const item of tree.elementsOf(expr.elementsList)) {
      const given =
        draft.types.get(index) ?? this.types.store.plain(TypeKind.Error);
      const spread = draft.spreads.get(index) ?? given;
      const source = this.matchList(spread) ?? spread;

      index += 1;

      if (!item.spread) {
        const exprExpr = tree.exprOf(item.exprId);

        this.coerce(exprExpr, given, element, module, kNoPlace);

        continue;
      }
      if (!this.types.spreadFits(source, element, array)) {
        const first = this.types.typeText(source);
        const second = this.types.typeText(array);

        this.errors.write(
          module,
          tree.exprOf(item.exprId).loc,
          Code.SpreadMismatch,
          {
            first,
            second,
          },
        );
      }
    }
  }
}
