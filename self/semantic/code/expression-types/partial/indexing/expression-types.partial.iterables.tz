import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import { MethodKind } from "../../../../../program/ast/types/ast.types.classes.tz";
import { Expr } from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  FunctionDecl,
  FunctionPlace,
} from "../../../../../program/ast/types/ast.types.functions.tz";
import { TypeRef } from "../../../../../program/ast/types/ast.types.types.tz";
import {
  InstanceType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  TypeContext,
  TypePlace,
} from "../../../../types/type-resolver/types/type-resolver.types.tz";
import {
  ArgumentSlot,
  CallTarget,
} from "../../types/expression-types.types.tz";
import { kIteratorKey } from "../../../../types/type-questions/const/type-questions.const.tz";
import { kIterableName } from "../../../index-rules/const/index-rules.const.tz";
import { kConcurrentMapName } from "../../../../library/fetch-rules/const/fetch-rules.const.tz";

partial class ExpressionTypes {
  private iterablePlaceCheck(fn: FunctionDecl, module: int): void {
    const tree = this.types.program.tree;

    for (const param of tree.paramsOf(fn.paramsList)) {
      const typeRef = tree.typeRefAt(param.typeId);
      const ref = this.iterableRef(typeRef);
      if (ref != undefined) {
        this.iterableParamCheck(fn, ref, module);
      }
    }

    const returnType = tree.typeRefAt(fn.returnTypeId);
    const result = this.iterableRef(returnType);
    if (result != undefined) {
      this.errors.write(
        module,
        result.loc,
        Code.IterableNotParameter,
        kNoDetails,
      );
    }
  }

  private iterableParamCheck(
    fn: FunctionDecl,
    ref: TypeRef,
    module: int,
  ): void {
    const word = this.iterableElementText(ref, module);
    if (fn.place == FunctionPlace.Expression || fn.isArrow) {
      this.errors.write(module, ref.loc, Code.IterableNotParameter, kNoDetails);

      return;
    }
    if (fn.role?.method == MethodKind.Constructor) {
      this.errors.write(module, ref.loc, Code.IterableConstructor, { word });

      return;
    }
    if (fn.role == undefined && !this.isTopFunction(fn, module)) {
      this.errors.write(module, ref.loc, Code.IterableNested, { word });
    }
  }

  private readonly isTopFunction(fn: FunctionDecl, module: int): boolean {
    const tree = this.types.program.tree;

    const items =
      tree.stmtsOf(this.types.program.modules[module]?.file.itemsList) ?? [];

    return items.some((one) => one.id == fn.id);
  }

  private readonly iterableRef(root: TypeRef | undefined): TypeRef | undefined {
    if (root == undefined) {
      return undefined;
    }

    return this.types.namedRefs(root, kIterableName)[0];
  }

  private iterableElementText(ref: TypeRef, module: int): string {
    const tree = this.types.program.tree;

    const arg = tree.typeRefsOf(ref.argsList)[0];
    if (arg == undefined) {
      return "T";
    }

    const context: TypeContext = {
      module,
      bindings: new Map<int, Type>(),
      place: TypePlace.Plain,
    };
    const type = this.types.resolve(arg, context);

    return this.types.typeText(type);
  }

  private iterableAnnotationCheck(ref: TypeRef | undefined, module: int): void {
    const found = this.iterableRef(ref);
    if (found != undefined) {
      this.errors.write(
        module,
        found.loc,
        Code.IterableNotParameter,
        kNoDetails,
      );
    }
  }

  private iterableArgumentCheck(
    slot: ArgumentSlot,
    to: Type,
    target: Read<CallTarget>,
    module: int,
  ): boolean {
    const wanted = this.types.iterableItem(to);
    if (wanted == undefined) {
      return false;
    }

    const given = this.typed(slot.expr, undefined, module);
    if (given.kind == TypeKind.Error) {
      return true;
    }

    const item = this.iteratedItem(given);
    const second = target.method ?? "";
    const word = this.types.typeText(given);
    const other = this.types.typeText(wanted);
    if (item == undefined) {
      this.errors.write(module, target.loc, Code.IterableNotIterable, {
        word,
        other,
        second,
      });

      return true;
    }
    if (item.kind == TypeKind.Error || this.types.converts(item, wanted)) {
      return true;
    }

    this.errors.write(module, target.loc, Code.IterableElements, {
      word,
      first: this.types.typeText(item),
      other,
      second,
    });

    return true;
  }

  public iteratedItem(given: Type): Type | undefined {
    const base = this.types.apparent(given);

    switch (base.kind) {
      case TypeKind.Array:
        return this.types.store.itemOf(base);
      case TypeKind.String:
      case TypeKind.Template:
        return this.types.store.plain(TypeKind.String);
      case TypeKind.Iterator:
        return this.types.store.iteratorShapeOf(base).yielded;
      case TypeKind.Dict:
        return this.types.iteratedDictItem(
          base.dict,
          this.types.store.keyOf(base),
          this.types.store.valueOf(base),
        );
      case TypeKind.Instance:
        return this.instanceItem(base);
      case TypeKind.Object:
        return this.matchItem(base);
      case TypeKind.Error:
        return base;
      default:
        return undefined;
    }
  }

  private instanceItem(instance: InstanceType): Type | undefined {
    if (this.isDeclaredLibrary(instance.module, instance.loc)) {
      return this.types.store.plain(TypeKind.Error);
    }

    const entryLookup = this.classMember(instance, kIteratorKey);

    const entry = entryLookup.entry;
    const method = entry?.methods[0];
    if (entry == undefined || method == undefined) {
      return undefined;
    }

    const type = this.methodTypeOf(entry, method);
    if (type.kind != TypeKind.Function) {
      return this.types.store.plain(TypeKind.Error);
    }

    const result = this.types.store.returnTypeOf(type);
    if (result.kind != TypeKind.Iterator) {
      return this.types.store.plain(TypeKind.Error);
    }

    return this.types.store.iteratorShapeOf(result).yielded;
  }

  private instanceLoopCheck(
    loop: Expr,
    instance: InstanceType,
    module: int,
  ): void {
    if (this.isDeclaredLibrary(instance.module, instance.loc)) {
      return;
    }

    const lookup = this.classMember(instance, kIteratorKey);
    const entry = lookup.entry;
    const word = this.types.typeText(instance);
    if (!lookup.isKnown) {
      return;
    }
    if (entry == undefined && this.isConcurrentMap(instance)) {
      this.errors.write(module, loop.loc, Code.ForOfConcurrentMap, kNoDetails);

      return;
    }
    if (entry == undefined) {
      this.errors.write(module, loop.loc, Code.ForOfCannot, { word });

      return;
    }

    const method = entry.methods[0];
    if (method == undefined) {
      return;
    }

    const type = this.methodTypeOf(entry, method);
    if (type.kind != TypeKind.Function) {
      return;
    }

    const result = this.types.store.returnTypeOf(type);
    const isOpen =
      result.kind == TypeKind.Iterator ||
      result.kind == TypeKind.Error ||
      this.types.hasNextMethod(result);
    if (isOpen) {
      return;
    }

    this.errors.write(module, loop.loc, Code.IteratorMethodResult, {
      word,
      first: this.types.typeText(result),
    });
  }

  private readonly isConcurrentMap(instance: InstanceType): boolean {
    return (
      this.types.isTypedLibrary(instance.module) &&
      instance.name == kConcurrentMapName
    );
  }
}
