import { ProofRange } from "../../../../flow/proof-rules/types/proof-rules.types.tz";
import { kArrayLengthWhat } from "../../../../flow/proof-rules/const/proof-rules.const.tz";
import { kLengthName } from "../../../expression-shapes/const/expression-shapes.const.tz";
import {
  kLengthTerm,
  kZeroTerm,
} from "../../../../flow/bound-rules/const/bound-rules.const.tz";
import {
  AssignExpr,
  BinaryOp,
  Expr,
  ExprKind,
  IndexExpr,
  MemberExpr,
  NameExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { ValueTarget } from "../../types/expression-types.types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { kNoPlace } from "../../const/expression-types.const.tz";
import { ExpressionTypes } from "../../expression-types.tz";

partial class ExpressionTypes {
  private lengthAssignCheck(expr: AssignExpr, given: Type, module: int): void {
    const tree = this.types.program.tree;

    const target = tree.exprOf(expr.targetId);
    const isLength =
      expr.op == undefined &&
      target.kind == ExprKind.Member &&
      target.name == kLengthName;
    if (!isLength || target.kind != ExprKind.Member) {
      return;
    }

    const objectExpr = tree.exprOf(target.objectId);
    const object = this.peekType(objectExpr, module);

    const base = this.types.definedType(object);
    if (base.kind != TypeKind.Array || given.kind == TypeKind.Error) {
      return;
    }
    if (this.types.hasZeroValue(this.types.store.itemOf(base))) {
      const range: ProofRange = { what: kArrayLengthWhat, low: 0 };

      const value = tree.exprOf(expr.valueId);

      this.requireBetween(value, given, range, module);

      return;
    }
    if (
      this.isProvenLength(
        tree.exprOf(target.objectId),
        tree.exprOf(expr.valueId),
        module,
      )
    ) {
      return;
    }

    this.errors.write(
      module,
      tree.exprOf(expr.valueId).loc,
      Code.LengthNotProven,
      {
        first: this.types.typeText(this.types.store.itemOf(base)),
        word: this.types.valueText(tree.exprOf(target.objectId), module),
      },
    );
  }

  private isProvenLength(object: Expr, value: Expr, module: int): boolean {
    const at = this.linearOf(value, module);
    const key = this.pathKey(object, module);
    if (at == undefined || key == undefined) {
      return false;
    }
    if (at.term == kZeroTerm && at.offset == 0) {
      return true;
    }

    const isNatural = this.canProve(kZeroTerm, at.term, -at.offset);

    return isNatural && this.canProve(at.term, kLengthTerm + key, at.offset);
  }

  private compoundValue(
    expr: AssignExpr,
    op: BinaryOp,
    type: Type,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const value = tree.exprOf(expr.valueId);
    const isLiteralTree = this.types.isIntTree(value);
    const hint = this.types.compoundHint(op, type, isLiteralTree);
    const valueExpr = tree.exprOf(expr.valueId);
    const given = this.typed(valueExpr, hint, module);

    const target = tree.exprOf(expr.targetId);
    const isUnchecked =
      this.isLibraryTarget(target, module) ||
      this.isPlacedLiteral(target, given, module);
    if (isUnchecked) {
      return given;
    }
    if (type.kind == TypeKind.String) {
      const joinError = this.types.stringCompoundError(
        expr,
        op,
        type,
        given,
        module,
      );

      this.errors.writeFound(module, joinError);

      return given;
    }

    this.numericCompoundCheck(expr, op, type, given, module);

    return given;
  }

  private numericCompoundCheck(
    expr: AssignExpr,
    op: BinaryOp,
    type: Type,
    given: Type,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const isBits = this.types.isIntegerOnly(op);
    const isBroken =
      type.kind == TypeKind.Error || given.kind == TypeKind.Error;
    const isDecimal = type.kind == TypeKind.Decimal && !isBits;
    if (isBroken || isDecimal) {
      return;
    }

    const value = tree.exprOf(expr.valueId);
    const isShift = this.types.isShift(op);
    const isOther =
      !isShift && given.kind == TypeKind.Int && given.id != type.id;
    const isAdapting =
      isOther && this.literalTarget(value, given, type, module) != undefined;
    const isWrapping = !isShift && this.types.isWrapping(type, given);
    const operandsError = this.types.compoundOperandsError(
      expr,
      op,
      type,
      given,
      isAdapting || isWrapping,
    );
    if (operandsError != undefined) {
      return this.errors.writeFound(module, operandsError);
    }
    if (isAdapting) {
      return;
    }

    const isDividing = op == BinaryOp.Div || op == BinaryOp.Rem;
    const isCounted = isWrapping || type.kind == TypeKind.Int;
    const isByZero =
      isCounted && isDividing && this.intConstant(value, given, module) == 0;
    if (isByZero) {
      this.errors.write(module, value.loc, Code.DivisionByZero, kNoDetails);
    }
    if (isWrapping || isShift) {
      return;
    }

    this.coerce(value, given, type, module, kNoPlace);
  }

  private compoundUndefinedCheck(
    expr: AssignExpr,
    tested: Type,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const op = expr.op;
    const isArithmetic =
      op != undefined &&
      op != BinaryOp.LogOr &&
      op != BinaryOp.LogAnd &&
      op != BinaryOp.Nullish;
    const isMaybe =
      this.types.isOptional(tested) || tested.kind == TypeKind.Undefined;
    if (!isArithmetic || !isMaybe || op == undefined) {
      return false;
    }

    const value = tree.exprOf(expr.valueId);
    const given = this.peekType(value, module);

    this.errors.write(module, expr.loc, Code.OperandTypesUndefined, {
      first: this.types.typeText(tested),
      second: this.types.typeText(given),
      other: `${this.types.operatorText(op)}=`,
    });

    return true;
  }

  private logicalTargetCheck(expr: AssignExpr, module: int): boolean {
    const checked = this.types.logicalTargetCheck(expr);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private arrayWriteCheck(
    target: IndexExpr,
    isCompound: boolean,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const objectExpr = tree.exprOf(target.objectId);
    const object = this.peekType(objectExpr, module);

    const base = this.types.definedType(object);
    if (base.kind == TypeKind.Tuple) {
      const tupleWriteError = this.types.tupleWriteCheck(target, base);

      return this.errors.writeFound(module, tupleWriteError);
    }
    if (base.kind == TypeKind.String) {
      const code = Code.StringElementAssigned;

      return this.errors.write(module, target.loc, code, kNoDetails);
    }
    if (this.types.elementOf(base) != undefined) {
      return this.bytesStoreCheck(target, base, module);
    }
    if (base.kind != TypeKind.Array) {
      return;
    }

    this.writeIndexCheck(target, isCompound, module);
  }

  private assignedDeclared(target: Expr, module: int): Type | undefined {
    if (target.kind == ExprKind.Member) {
      return this.memberTargetDeclared(target, module);
    }
    if (target.kind == ExprKind.Index) {
      return this.elementDeclared(target, module);
    }
    if (target.kind != ExprKind.Name) {
      return undefined;
    }
    if (this.isThisName(target, module)) {
      this.errors.write(module, target.loc, Code.ThisAssigned, kNoDetails);

      return undefined;
    }

    const found = this.targetOfName(target, module);
    if (found == undefined) {
      return undefined;
    }
    if (this.fixedTargetCheck(target, found, module)) {
      return undefined;
    }

    return this.declaredOf(found);
  }

  private readonly importedCode(home: int): Code {
    if (this.types.isLibraryModule(home)) {
      return Code.AssignToImported;
    }

    return Code.AssignToImportedVariable;
  }

  private fixedTargetCheck(
    target: NameExpr,
    found: ValueTarget,
    module: int,
  ): boolean {
    if (found.kind != SymbolKind.Variable) {
      return false;
    }

    const word = target.name;
    if (found.module != module) {
      const code = this.importedCode(found.module);

      this.errors.write(module, target.loc, code, { word });

      return true;
    }

    const variable = this.record(module)?.variables.get(found.loc);
    if (variable == undefined || !variable.isConst) {
      return false;
    }

    this.errors.write(module, target.loc, Code.AssignToConstant, { word });

    return true;
  }

  private bytesStoreCheck(target: IndexExpr, object: Type, module: int): void {
    const tree = this.types.program.tree;

    if (
      this.isProvenIndex(
        tree.exprOf(target.objectId),
        tree.exprOf(target.indexId),
        module,
      )
    ) {
      return;
    }

    const index = tree.exprOf(target.indexId);
    const key = this.peekType(index, module);

    if (key.kind == TypeKind.Error) {
      return;
    }

    const indexExpr = tree.exprOf(target.indexId);
    const constant = this.intConstant(indexExpr, key, module);
    const shownObject = this.types.valueText(
      tree.exprOf(target.objectId),
      module,
    );
    const shownIndex = this.types.valueText(
      tree.exprOf(target.indexId),
      module,
    );
    const storeError = this.types.storeError(
      target,
      object,
      constant,
      shownObject,
      shownIndex,
    );

    this.errors.writeFound(module, storeError);
  }

  private elementDeclared(target: IndexExpr, module: int): Type | undefined {
    const tree = this.types.program.tree;

    const objectExpr = tree.exprOf(target.objectId);
    const object = this.peekType(objectExpr, module);

    const base = this.types.definedType(object);
    if (base.kind == TypeKind.Array) {
      return this.types.store.itemOf(base);
    }
    if (this.types.isClamped(base)) {
      return this.types.store.integer(64, false);
    }

    return this.types.elementOf(base);
  }

  private fieldDeclared(target: MemberExpr, module: int): Type | undefined {
    const key = this.pathKey(target, module);
    if (key == undefined) {
      return undefined;
    }

    const before = this.factsCopy();

    this.forgetPath(key);
    const declared = this.peekType(target, module);
    this.facts = before;

    return declared;
  }

  private isLibraryTarget(target: Expr, module: int): boolean {
    const tree = this.types.program.tree;

    if (target.kind != ExprKind.Member) {
      return false;
    }

    const objectExpr = tree.exprOf(target.objectId);
    const object = this.peekType(objectExpr, module);

    const isInstance =
      object.kind == TypeKind.Instance &&
      this.types.isLibraryModule(object.module);

    return isInstance || this.types.isLibraryShape(object);
  }
}
