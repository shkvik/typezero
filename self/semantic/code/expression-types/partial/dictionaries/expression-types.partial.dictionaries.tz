import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  Expr,
  ObjectLitExpr,
  Property,
  PropertyKind,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { kKeyPlace, kValuePlace } from "../../const/expression-types.const.tz";

partial class ExpressionTypes {
  private recordObject(expr: ObjectLitExpr, record: Type, module: int): Type {
    const tree = this.types.program.tree;

    if (record.kind != TypeKind.Dict) {
      return this.types.store.plain(TypeKind.Error);
    }

    let failed = false;

    for (const property of tree.propertiesOf(expr.propsList)) {
      const isFailed = this.recordProperty(property, record, module);

      failed = failed || isFailed;
    }

    if (failed) {
      return this.types.store.plain(TypeKind.Error);
    }

    return record;
  }

  private recordProperty(
    property: Property,
    record: Type,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    if (record.kind != TypeKind.Dict) {
      return true;
    }

    const name = property.name;
    const value = this.types.store.valueOf(record);
    const form = property.form;
    const place = this.types.keyPlace(name);

    switch (form.kind) {
      case PropertyKind.Method:
        this.errors.write(module, property.loc, Code.RecordMethod, {
          word: name,
        });
        const valueExpr = tree.exprOf(property.valueId);

        this.typed(valueExpr, undefined, module);

        return true;
      case PropertyKind.Spread: {
        if (this.recordSpreadCheck(property, module)) {
          return true;
        }

        const spread = this.typed(
          tree.exprOf(property.valueId),
          record,
          module,
        );

        return spread.kind == TypeKind.Error;
      }
      case PropertyKind.Defaulted: {
        const propertyValue = tree.exprOf(property.valueId);
        const fallback = this.types.fallbackOf(propertyValue);

        this.errors.write(module, property.loc, Code.RecordDefaulted, {
          word: name,
        });
        this.checked(fallback, value, module, place);

        return true;
      }
      case PropertyKind.Computed:
        const key = tree.exprOf(form.keyId);

        this.recordKey(key, module);
        this.checked(tree.exprOf(property.valueId), value, module, kValuePlace);

        return false;
      default:
        this.checked(tree.exprOf(property.valueId), value, module, place);

        return false;
    }
  }

  private recordKey(key: Expr, module: int): void {
    const text = this.types.store.plain(TypeKind.String);
    const keyType = this.typed(key, text, module);
    const plain = this.types.definedType(keyType);
    if (this.types.isNumeric(plain)) {
      const first = this.types.typeText(keyType);

      return this.errors.write(module, key.loc, Code.RecordNumberKey, {
        first,
      });
    }

    this.coerce(key, keyType, text, module, kKeyPlace);
  }

  private jsonObject(expr: ObjectLitExpr, json: Type, module: int): Type {
    const tree = this.types.program.tree;

    for (const property of tree.propertiesOf(expr.propsList)) {
      this.jsonProperty(property, json, module);
    }

    return json;
  }

  private jsonProperty(property: Property, json: Type, module: int): void {
    const tree = this.types.program.tree;

    const form = property.form;
    const loc = property.loc;
    const word = property.name;

    if (form.kind == PropertyKind.Spread) {
      this.errors.write(module, loc, Code.JsonSpread, kNoDetails);
      const value = tree.exprOf(property.valueId);

      this.typed(value, undefined, module);

      return;
    }
    if (form.kind == PropertyKind.Method) {
      this.errors.write(module, loc, Code.JsonFunction, kNoDetails);
      const valueExpr = tree.exprOf(property.valueId);

      this.typed(valueExpr, undefined, module);

      return;
    }
    if (form.kind == PropertyKind.Defaulted) {
      const propertyValue = tree.exprOf(property.valueId);
      const fallback = this.types.fallbackOf(propertyValue);

      this.errors.write(module, loc, Code.JsonDefaulted, { word });
      this.typed(fallback, undefined, module);

      return;
    }
    if (form.kind == PropertyKind.Computed) {
      const key = tree.exprOf(form.keyId);

      this.jsonKey(key, module);
    }

    const given = this.typed(tree.exprOf(property.valueId), json, module);
    const target = this.types.jsonTarget(json, given);
    const place = this.types.keyPlace(word);

    this.coerce(tree.exprOf(property.valueId), given, target, module, place);
  }

  private jsonKey(key: Expr, module: int): void {
    const keyType = this.typed(key, undefined, module);
    const isText = keyType.kind == TypeKind.String;
    if (isText || keyType.kind == TypeKind.Error) {
      return;
    }

    const first = this.types.typeText(keyType);

    this.errors.write(module, key.loc, Code.JsonKey, { first });
  }
}
