import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  Expr,
  ObjectLitExpr,
  Property,
  PropertyKind,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { kKeyPlace, kValuePlace } from "../../const/expression-types.const.tz";

partial class ExpressionTypes {
  private recordObject(expr: ObjectLitExpr, record: Type, module: int): Type {
    if (record.kind != TypeKind.Dict) {
      return this.store.plain(TypeKind.Error);
    }

    let failed = false;

    for (const property of expr.props) {
      const isFailed = this.recordProperty(property, record, module);

      failed = failed || isFailed;
    }

    if (failed) {
      return this.store.plain(TypeKind.Error);
    }

    return record;
  }

  private recordProperty(
    property: Property,
    record: Type,
    module: int,
  ): boolean {
    if (record.kind != TypeKind.Dict) {
      return true;
    }

    const name = property.name;
    const value = record.value;
    const form = property.form;
    const place = this.dictionaries.keyPlace(name);

    switch (form.kind) {
      case PropertyKind.Method:
        this.report(module, property.loc, Code.RecordMethod, { word: name });
        this.typed(property.value, undefined, module);

        return true;
      case PropertyKind.Spread: {
        if (this.recordSpreadCheck(property, module)) {
          return true;
        }

        const spread = this.typed(property.value, record, module);

        return spread.kind == TypeKind.Error;
      }
      case PropertyKind.Defaulted: {
        const fallback = this.objects.fallbackOf(property.value);

        this.report(module, property.loc, Code.RecordDefaulted, { word: name });
        this.checked(fallback, value, module, place);

        return true;
      }
      case PropertyKind.Computed:
        this.recordKey(form.key, module);
        this.checked(property.value, value, module, kValuePlace);

        return false;
      default:
        this.checked(property.value, value, module, place);

        return false;
    }
  }

  private recordKey(key: Expr, module: int): void {
    const text = this.store.plain(TypeKind.String);
    const keyType = this.typed(key, text, module);
    const plain = this.types.definedType(keyType);
    if (this.types.isNumeric(plain)) {
      const first = this.text.of(keyType);

      return this.report(module, key.loc, Code.RecordNumberKey, { first });
    }

    this.coerce(key, keyType, text, module, kKeyPlace);
  }

  private jsonObject(expr: ObjectLitExpr, json: Type, module: int): Type {
    for (const property of expr.props) {
      this.jsonProperty(property, json, module);
    }

    return json;
  }

  private jsonProperty(property: Property, json: Type, module: int): void {
    const form = property.form;
    const loc = property.loc;
    const word = property.name;

    if (form.kind == PropertyKind.Spread) {
      this.report(module, loc, Code.JsonSpread, kNoDetails);
      this.typed(property.value, undefined, module);

      return;
    }
    if (form.kind == PropertyKind.Method) {
      this.report(module, loc, Code.JsonFunction, kNoDetails);
      this.typed(property.value, undefined, module);

      return;
    }
    if (form.kind == PropertyKind.Defaulted) {
      const fallback = this.objects.fallbackOf(property.value);

      this.report(module, loc, Code.JsonDefaulted, { word });
      this.typed(fallback, undefined, module);

      return;
    }
    if (form.kind == PropertyKind.Computed) {
      this.jsonKey(form.key, module);
    }

    const given = this.typed(property.value, json, module);
    const target = this.dictionaries.jsonTarget(json, given);
    const place = this.dictionaries.keyPlace(word);

    this.coerce(property.value, given, target, module, place);
  }

  private jsonKey(key: Expr, module: int): void {
    const keyType = this.typed(key, undefined, module);
    const isText = keyType.kind == TypeKind.String;
    if (isText || keyType.kind == TypeKind.Error) {
      return;
    }

    const first = this.text.of(keyType);

    this.report(module, key.loc, Code.JsonKey, { first });
  }
}
