import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { messageText } from "../../../../../diagnostic/message.tz";
import {
  BinaryExpr,
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  UnaryExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  DictKind,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  kThisName,
  kUnsupportedMark,
} from "../../const/expression-types.const.tz";
import { kLengthName } from "../../../expression-shapes/const/expression-shapes.const.tz";

partial class ExpressionTypes {
  private dictMemberCheck(
    expr: MemberExpr,
    object: Type,
    isCalled: boolean,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const dict = this.types.collectionOf(object);
    if (dict == undefined) {
      return false;
    }

    const name = expr.name;
    const word = this.types.dictionaryDictText(
      tree.exprOf(expr.objectId),
      dict,
    );
    const first = this.types.typeText(object);

    if (name == kLengthName) {
      this.errors.write(module, expr.loc, Code.DictNoLength, { word, first });

      return true;
    }
    if (isCalled) {
      return this.dictMissingCall(expr, dict, word, first, module);
    }

    const receiver = this.libraryReceiver(object);
    if (receiver == undefined) {
      return false;
    }

    const method = this.receiverMember(receiver, name, true);
    if (method == undefined || method.kind != TypeKind.Function) {
      return false;
    }

    this.errors.write(module, expr.loc, Code.DictMethodValue, {
      word,
      other: name,
    });

    return true;
  }

  private dictMissingCall(
    expr: MemberExpr,
    dict: DictKind,
    word: string,
    first: string,
    module: int,
  ): boolean {
    const checked = this.types.dictMissingCall(expr, dict, word, first);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private dictTargetCheck(target: Expr, module: int): boolean {
    const tree = this.types.program.tree;

    if (target.kind != ExprKind.Member && target.kind != ExprKind.Index) {
      return false;
    }

    const holder = tree.exprOf(target.objectId);
    if (holder.kind == ExprKind.Name && holder.name == kThisName) {
      return false;
    }

    const objectExpr = tree.exprOf(target.objectId);
    const object = this.peekType(objectExpr, module);

    const dict = this.types.collectionOf(object);
    if (dict == undefined) {
      return false;
    }

    const word = this.types.dictionaryDictText(
      tree.exprOf(target.objectId),
      dict,
    );

    if (dict == DictKind.Set) {
      return this.setTargetCheck(target, word, module);
    }

    const access = this.types.dictAccess(target);

    this.errors.write(module, target.loc, Code.MapPropertySet, {
      word,
      other: access,
    });

    return true;
  }

  private setTargetCheck(target: Expr, word: string, module: int): boolean {
    const checked = this.types.setTargetCheck(target, word);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private dictDeleteCheck(expr: UnaryExpr, module: int): boolean {
    const tree = this.types.program.tree;

    const target = tree.exprOf(expr.operandId);
    if (target.kind != ExprKind.Member && target.kind != ExprKind.Index) {
      return false;
    }

    const objectExpr = tree.exprOf(target.objectId);
    const object = this.peekType(objectExpr, module);

    const dict = this.types.collectionOf(object);
    if (dict == undefined) {
      return false;
    }

    const isMap = dict == DictKind.Map;

    this.errors.write(module, expr.loc, Code.DictDelete, {
      word: this.types.collectionWord(dict),
      first: this.types.dictionaryDictText(tree.exprOf(target.objectId), dict),
      other: this.types.entryPart(isMap),
    });

    return true;
  }

  private dictInCheck(expr: BinaryExpr, object: Type, module: int): boolean {
    const checked = this.types.dictInCheck(expr, object);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private dictKeysCheck(expr: CallExpr, module: int): void {
    const tree = this.types.program.tree;

    const callee = tree.exprOf(expr.calleeId);
    const arg = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (callee.kind != ExprKind.Member || arg == undefined) {
      return;
    }

    const holder = tree.exprOf(callee.objectId);
    const isObject =
      holder.kind == ExprKind.Name &&
      holder.name == "Object" &&
      this.isGlobalUse(holder, module);
    const isListing =
      callee.name == "keys" ||
      callee.name == "values" ||
      callee.name == "entries";
    if (!isObject || !isListing) {
      return;
    }

    const type = this.peekType(arg, module);

    const dict = this.types.collectionOf(type);
    if (dict == undefined) {
      const objectArgumentError = this.types.objectArgumentCheck(
        arg,
        type,
        callee.name,
      );

      this.errors.writeFound(module, objectArgumentError);

      return this.listedFieldsCheck(arg, type, callee.name, module);
    }

    const isSetEntries = dict == DictKind.Set && callee.name == "entries";
    const method = this.types.listingMethod(callee.name, isSetEntries);

    this.errors.write(module, arg.loc, Code.DictObjectEmpty, {
      word: callee.name,
      first: this.types.collectionWord(dict),
      second: this.types.dictionaryDictText(arg, dict),
      other: method,
    });
  }

  private listedFieldsCheck(
    arg: Expr,
    type: Type,
    word: string,
    module: int,
  ): void {
    const base = this.types.apparent(type);
    const isValues = word == "values" || word == "entries";
    if (isValues && this.isEmitter(base)) {
      this.errors.write(module, arg.loc, Code.ObjectListingEmitter, { word });

      return;
    }
    if (isValues && this.types.hasMethodFields(type)) {
      this.errors.write(module, arg.loc, Code.ObjectListingMethods, { word });

      return;
    }
    if (!isValues || base.kind != TypeKind.Object) {
      return;
    }
    if (this.types.isLibraryShape(base)) {
      return;
    }

    const first = this.types.typeText(base);
    let element: Type | undefined = undefined;

    for (const field of this.types.store.fieldsOf(base)) {
      const candidate = this.types.definedType(field.type);
      const both = this.types.listedElement(element, candidate);
      const problem = this.types.unionProblem(both);
      if (problem != undefined) {
        const full = messageText(problem.code, problem.details);
        const mark = full.indexOf(kUnsupportedMark);
        const other = full.slice(mark + kUnsupportedMark.length);

        this.errors.write(module, arg.loc, Code.ObjectValuesNoUnion, {
          word,
          first,
          other,
        });

        return;
      }

      element = both;
    }
    if (element == undefined) {
      this.errors.write(module, arg.loc, Code.ObjectNoFields, { word, first });
    }
  }
}
