import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import { messageText } from "../../../../../diagnostic/message.tz";
import { Details } from "../../../../../diagnostic/types/message.types.tz";
import {
  BinaryExpr,
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  UnaryExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  DictKind,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  kDictIterating,
  kThisName,
  kUnsupportedMark,
} from "../../const/expression-types.const.tz";
import { kLengthName } from "../../../expression-shapes/const/expression-shapes.const.tz";

partial class ExpressionTypes {
  private dictMemberCheck(
    expr: MemberExpr,
    object: Type,
    isCalled: boolean,
    module: int,
  ): boolean {
    const dict = this.dictionaries.collectionOf(object);
    if (dict == undefined) {
      return false;
    }

    const name = expr.name;
    const word = this.dictionaries.dictText(expr.object, dict);
    const first = this.text.of(object);

    if (name == kLengthName) {
      this.report(module, expr.loc, Code.DictNoLength, { word, first });

      return true;
    }
    if (isCalled) {
      return this.dictMissingCall(expr, dict, word, first, module);
    }

    const receiver = this.libraryReceiver(object);
    if (receiver == undefined) {
      return false;
    }

    const method = this.receiverMember(receiver, name, true);
    if (method == undefined || method.kind != TypeKind.Function) {
      return false;
    }

    this.report(module, expr.loc, Code.DictMethodValue, { word, other: name });

    return true;
  }

  private dictMissingCall(
    expr: MemberExpr,
    dict: DictKind,
    word: string,
    first: string,
    module: int,
  ): boolean {
    const name = expr.name;
    const isMap = dict == DictKind.Map;
    const details: Details = { word, first, other: name };

    if (isMap && name == "add") {
      this.report(module, expr.loc, Code.MapHasNoAdd, details);

      return true;
    }
    if (!isMap && (name == "set" || name == "get")) {
      this.report(module, expr.loc, Code.SetHasNoGet, details);

      return true;
    }
    if (!kDictIterating.includes(name)) {
      return false;
    }

    const place = this.dictionaries.iteratingSource(isMap);

    this.report(module, expr.loc, Code.DictNotIterating, {
      word,
      first,
      other: name,
      place,
    });

    return true;
  }

  private dictTargetCheck(target: Expr, module: int): boolean {
    if (target.kind != ExprKind.Member && target.kind != ExprKind.Index) {
      return false;
    }

    const holder = target.object;
    if (holder.kind == ExprKind.Name && holder.name == kThisName) {
      return false;
    }

    this.quiet += 1;

    const object = this.typed(target.object, undefined, module);

    this.quiet -= 1;

    const dict = this.dictionaries.collectionOf(object);
    if (dict == undefined) {
      return false;
    }

    const word = this.dictionaries.dictText(target.object, dict);

    if (dict == DictKind.Set) {
      return this.setTargetCheck(target, word, module);
    }

    const access = this.dictionaries.dictAccess(target);

    this.report(module, target.loc, Code.MapPropertySet, {
      word,
      other: access,
    });

    return true;
  }

  private setTargetCheck(target: Expr, word: string, module: int): boolean {
    if (target.kind == ExprKind.Index) {
      this.report(module, target.loc, Code.SetIndexSet, { word });

      return true;
    }
    if (target.kind == ExprKind.Member && target.name == "size") {
      this.report(module, target.loc, Code.SetSizeSet, { word });

      return true;
    }

    return false;
  }

  private dictDeleteCheck(expr: UnaryExpr, module: int): boolean {
    const target = expr.operand;
    if (target.kind != ExprKind.Member && target.kind != ExprKind.Index) {
      return false;
    }

    this.quiet += 1;

    const object = this.typed(target.object, undefined, module);

    this.quiet -= 1;

    const dict = this.dictionaries.collectionOf(object);
    if (dict == undefined) {
      return false;
    }

    const isMap = dict == DictKind.Map;

    this.report(module, expr.loc, Code.DictDelete, {
      word: this.dictionaries.collectionWord(dict),
      first: this.dictionaries.dictText(target.object, dict),
      other: this.dictionaries.entryPart(isMap),
    });

    return true;
  }

  private dictInCheck(expr: BinaryExpr, object: Type, module: int): boolean {
    const dict = this.dictionaries.collectionOf(object);
    if (dict == undefined) {
      return false;
    }

    const isMap = dict == DictKind.Map;

    this.report(module, expr.loc, Code.DictIn, {
      word: this.dictionaries.collectionWord(dict),
      first: this.dictionaries.dictText(expr.rhs, dict),
      other: this.dictionaries.entryPart(isMap),
    });

    return true;
  }

  private dictKeysCheck(expr: CallExpr, module: int): void {
    const callee = expr.callee;
    const arg = expr.args[0]?.expr;
    if (callee.kind != ExprKind.Member || arg == undefined) {
      return;
    }

    const holder = callee.object;
    const isObject =
      holder.kind == ExprKind.Name &&
      holder.name == "Object" &&
      this.isGlobalUse(holder, module);
    const isListing =
      callee.name == "keys" ||
      callee.name == "values" ||
      callee.name == "entries";
    if (!isObject || !isListing) {
      return;
    }

    this.quiet += 1;

    const type = this.typed(arg, undefined, module);

    this.quiet -= 1;

    const dict = this.dictionaries.collectionOf(type);
    if (dict == undefined) {
      this.objectArgumentCheck(arg, type, callee.name, module);

      return this.listedFieldsCheck(arg, type, callee.name, module);
    }

    const isSetEntries = dict == DictKind.Set && callee.name == "entries";
    const method = this.dictionaries.listingMethod(callee.name, isSetEntries);

    this.report(module, arg.loc, Code.DictObjectEmpty, {
      word: callee.name,
      first: this.dictionaries.collectionWord(dict),
      second: this.dictionaries.dictText(arg, dict),
      other: method,
    });
  }

  private objectArgumentCheck(
    arg: Expr,
    type: Type,
    word: string,
    module: int,
  ): void {
    const base = this.types.definedType(type);
    const isHolder =
      base.kind == TypeKind.Object ||
      base.kind == TypeKind.Dict ||
      base.kind == TypeKind.Instance;
    if (this.types.isOptional(type) && isHolder) {
      this.report(module, arg.loc, Code.ObjectMaybeUndefined, kNoDetails);

      return;
    }
    if (!this.dictionaries.isNeverObject(type)) {
      return;
    }

    this.report(module, arg.loc, Code.ObjectNeedsObject, {
      word,
      first: this.text.of(type),
    });
  }

  private listedFieldsCheck(
    arg: Expr,
    type: Type,
    word: string,
    module: int,
  ): void {
    const base = this.types.apparent(type);
    const isValues = word == "values" || word == "entries";
    if (isValues && this.types.hasMethodFields(type)) {
      this.report(module, arg.loc, Code.ObjectListingMethods, { word });

      return;
    }
    if (!isValues || base.kind != TypeKind.Object) {
      return;
    }
    if (this.resolver.isLibraryShape(base)) {
      return;
    }

    const first = this.text.of(base);
    let element: Type | undefined = undefined;

    for (const field of base.fields) {
      const candidate = this.types.definedType(field.type);
      const both = this.dictionaries.listedElement(element, candidate);
      const problem = this.resolver.unionProblem(both);
      if (problem != undefined) {
        const full = messageText(problem.code, problem.details);
        const mark = full.indexOf(kUnsupportedMark);
        const other = full.slice(mark + kUnsupportedMark.length);

        this.report(module, arg.loc, Code.ObjectValuesNoUnion, {
          word,
          first,
          other,
        });

        return;
      }

      element = both;
    }
    if (element == undefined) {
      this.report(module, arg.loc, Code.ObjectNoFields, { word, first });
    }
  }
}
