import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  NewExpr,
  Property,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  DictKind,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { kNoPlace, kSetCombiners } from "../../const/expression-types.const.tz";

partial class ExpressionTypes {
  private dictSourceTyped(
    expr: NewExpr,
    dict: DictKind,
    written: Read<Type[]>,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const first = written[0];
    const second = written[1] ?? first;
    const source = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (first != undefined && second != undefined) {
      const typed = this.types.store.dictOf(dict, first, second);

      this.dictSourceCheck(source, dict, first, second, module);

      return typed;
    }

    const goal = this.types.wantedDict(wanted, dict);
    if (goal != undefined && goal.kind == TypeKind.Dict) {
      this.dictSourceCheck(
        source,
        dict,
        this.types.store.keyOf(goal),
        this.types.store.valueOf(goal),
        module,
      );

      return goal;
    }
    if (source == undefined) {
      const code = this.types.dictTypesCode(dict);

      this.errors.write(module, expr.loc, code, kNoDetails);

      return this.types.store.plain(TypeKind.Error);
    }
    if (dict == DictKind.Map) {
      return this.mapFromPairs(source, module);
    }

    return this.setFromValues(source, module);
  }

  private dictSourceCheck(
    source: Expr | undefined,
    dict: DictKind,
    key: Type,
    value: Type,
    module: int,
  ): void {
    if (source == undefined || source.kind != ExprKind.ArrayLit) {
      return;
    }

    const element = this.types.dictElement(dict, key, value);
    const list = this.types.store.arrayOf(element);

    this.checked(source, list, module, kNoPlace);
  }

  private mapFromPairs(source: Expr, module: int): Type {
    const tree = this.types.program.tree;

    const error = this.types.store.plain(TypeKind.Error);
    if (source.kind != ExprKind.ArrayLit) {
      const from = this.typed(source, undefined, module);

      return this.mapFromValue(from);
    }

    let key: Type | undefined = undefined;
    let value: Type | undefined = undefined;

    for (const element of tree.elementsOf(source.elementsList)) {
      const pair = tree.exprOf(element.exprId);
      if (element.spread || pair.kind != ExprKind.ArrayLit) {
        const found = this.typed(pair, undefined, module);

        this.errors.write(module, source.loc, Code.MapNotPairs, {
          word: this.types.typeText(this.types.widened(found)),
        });

        return error;
      }

      const parts = tree.elementsOf(pair.elementsList);
      const head = tree.exprAt(parts[0]?.exprId);
      const tail = tree.exprAt(parts[1]?.exprId);
      if (parts.length != 2 || head == undefined || tail == undefined) {
        return error;
      }

      const keyType = this.types.widened(
        this.typed(head, undefined, module),
      );
      const valueType = this.types.widened(
        this.typed(tail, undefined, module),
      );

      if (key != undefined && key.id != keyType.id) {
        const pairsDifferError = this.types.pairsDifferError(
          head,
          Code.MapKeysDiffer,
          key,
          keyType,
        );

        this.errors.writeFound(module, pairsDifferError);

        return error;
      }
      if (value != undefined && value.id != valueType.id) {
        const pairsDifferError2 = this.types.pairsDifferError(
          tail,
          Code.MapValuesDiffer,
          value,
          valueType,
        );

        this.errors.writeFound(module, pairsDifferError2);

        return error;
      }

      key = keyType;
      value = valueType;
    }

    if (key == undefined || value == undefined) {
      return error;
    }

    return this.types.store.dictOf(DictKind.Map, key, value);
  }

  private mapFromValue(from: Type): Type {
    const base = this.types.apparent(from);
    if (base.kind == TypeKind.Dict && base.dict == DictKind.Map) {
      return this.types.store.dictOf(
        DictKind.Map,
        this.types.store.keyOf(base),
        this.types.store.valueOf(base),
      );
    }
    if (
      base.kind != TypeKind.Array ||
      this.types.store.itemOf(base).kind != TypeKind.Tuple
    ) {
      return this.types.store.plain(TypeKind.Error);
    }

    const pair = this.types.store.itemOf(base);
    const items = this.types.store.itemsOf(pair);
    const key = items[0];
    const value = items[1];
    if (key == undefined || value == undefined || items.length != 2) {
      return this.types.store.plain(TypeKind.Error);
    }

    return this.types.store.dictOf(DictKind.Map, key, value);
  }

  private setFromValues(source: Expr, module: int): Type {
    const type = this.typed(source, undefined, module);
    const base = this.types.apparent(type);
    const error = this.types.store.plain(TypeKind.Error);

    switch (base.kind) {
      case TypeKind.Array:
        return this.types.store.dictOf(
          DictKind.Set,
          this.types.store.itemOf(base),
          this.types.store.itemOf(base),
        );
      case TypeKind.Dict:
        return this.types.store.dictOf(
          DictKind.Set,
          this.types.store.valueOf(base),
          this.types.store.valueOf(base),
        );
      default:
        return error;
    }
  }

  private setCombineCheck(
    expr: CallExpr,
    member: MemberExpr,
    object: Type,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const base = this.types.definedType(object);
    const arg = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    const isSet = base.kind == TypeKind.Dict && base.dict == DictKind.Set;
    if (!isSet || arg == undefined || !kSetCombiners.includes(member.name)) {
      return false;
    }
    if (base.kind != TypeKind.Dict) {
      return false;
    }

    const given = this.peekType(arg, module);

    const other = this.types.definedType(given);
    const isDict = other.kind == TypeKind.Dict && other.dict != DictKind.Record;
    if (isDict || other.kind == TypeKind.Error) {
      return false;
    }

    this.errors.write(module, arg.loc, Code.SetCombineNeedsSet, {
      word: member.name,
      first: this.types.typeText(this.types.store.valueOf(base)),
      other: this.types.typeText(given),
    });

    return true;
  }

  private recordTargetCheck(target: Expr, module: int): boolean {
    const tree = this.types.program.tree;

    if (target.kind != ExprKind.Member && target.kind != ExprKind.Index) {
      return false;
    }

    const holder = tree.exprOf(target.objectId);

    const object = this.peekType(holder, module);

    const base = this.types.definedType(object);
    if (base.kind != TypeKind.Dict || base.dict != DictKind.Record) {
      return false;
    }

    const word = this.types.recordKeyText(target);
    const code = this.types.recordMissingCode(this.types.store.valueOf(base));

    this.errors.write(module, target.loc, code, { word });

    return true;
  }

  private recordValueOf(holder: Expr, module: int): Type | undefined {
    const object = this.peekType(holder, module);

    const base = this.types.definedType(object);
    if (base.kind != TypeKind.Dict || base.dict != DictKind.Record) {
      return undefined;
    }

    return this.types.store.valueOf(base);
  }

  private recordMethodCheck(
    expr: CallExpr,
    member: MemberExpr,
    object: Type,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const base = this.types.definedType(object);
    if (base.kind != TypeKind.Dict || base.dict != DictKind.Record) {
      return false;
    }
    if (member.name != "hasOwnProperty") {
      return false;
    }

    const objectExpr = tree.exprOf(member.objectId);
    const other = this.types.sourceTupleText(objectExpr);

    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args, module);
    this.errors.write(module, member.loc, Code.RecordHasOwn, {
      word: `${other}.${member.name}`,
      other,
    });

    return true;
  }

  private spreadCheck(property: Property, module: int): void {
    const tree = this.types.program.tree;

    const value = tree.exprOf(property.valueId);
    const type = this.peekType(value, module);

    if (this.types.hasMethodFields(type)) {
      this.errors.write(
        module,
        tree.exprOf(property.valueId).loc,
        Code.SpreadMethods,
        kNoDetails,
      );

      return;
    }

    const code = this.types.spreadCode(type);
    if (code == undefined) {
      return;
    }

    this.errors.write(module, tree.exprOf(property.valueId).loc, code, {
      word: this.types.typeText(type),
    });
  }

  private recordSpreadCheck(property: Property, module: int): boolean {
    const tree = this.types.program.tree;

    const value = tree.exprOf(property.valueId);
    const type = this.peekType(value, module);

    const base = this.types.apparent(type);
    const code = this.types.recordSpreadCode(base);
    if (code == undefined) {
      return false;
    }

    this.errors.write(module, tree.exprOf(property.valueId).loc, code, {
      word: this.types.typeText(type),
    });

    return true;
  }

  private objectKeysCheck(expr: CallExpr, module: int): void {
    const tree = this.types.program.tree;

    const callee = tree.exprOf(expr.calleeId);
    if (callee.kind != ExprKind.Member) {
      return;
    }

    const holder = tree.exprOf(callee.objectId);
    const isObject =
      holder.kind == ExprKind.Name &&
      holder.name == "Object" &&
      this.isGlobalUse(holder, module);
    if (!isObject) {
      return;
    }
    if (callee.name == "groupBy") {
      return this.groupByKeysCheck(expr, module);
    }
    if (callee.name == "fromEntries") {
      this.fromEntriesKeysCheck(expr, module);
    }
    if (callee.name == "values" || callee.name == "entries") {
      this.numberEnumListCheck(expr, callee.name, module);
    }
  }

  private numberEnumListCheck(expr: CallExpr, name: string, module: int): void {
    const tree = this.types.program.tree;

    const listed = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (listed == undefined || tree.argumentsOf(expr.argsList).length != 1) {
      return;
    }

    const home = this.enumHomeOf(listed, module);
    if (home == undefined) {
      return;
    }

    const decl = home.decl;
    const isText = tree.enumMembersOf(decl.membersList).some((member) =>
      this.isTextInit(tree.exprAt(member.initId)),
    );
    if (isText) {
      return;
    }

    const other = tree.enumMembersOf(decl.membersList)[0]?.name ?? "A";

    this.errors.write(module, listed.loc, Code.ObjectNumberEnum, {
      word: name,
      first: decl.name,
      other,
    });
  }

  private groupByKeysCheck(expr: CallExpr, module: int): void {
    const tree = this.types.program.tree;

    const items = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    const callback = tree.exprAt(tree.argumentsOf(expr.argsList)[1]?.exprId);
    if (items == undefined || callback == undefined) {
      return;
    }
    if (callback.kind != ExprKind.Function) {
      return;
    }

    this.errors.beginTrial();

    const list = this.typed(items, undefined, module);
    const element = this.types.callbackElementOf(this.types.apparent(list));
    const result = this.types.store.plain(TypeKind.Error);
    const params = [{ type: element, optional: false }];
    const wanted = this.types.store.functionOf({ params, rest: false, result });
    const typed = this.typed(callback, wanted, module);

    this.errors.endTrial();

    if (typed.kind != TypeKind.Function) {
      return;
    }

    const key = this.types.apparent(this.types.store.returnTypeOf(typed));
    const isNumeric = key.kind == TypeKind.Int || key.kind == TypeKind.Double;
    if (!isNumeric) {
      return;
    }

    this.errors.write(module, callback.loc, Code.GroupByKeys, {
      word: this.types.typeText(key),
    });
  }

  private fromEntriesKeysCheck(expr: CallExpr, module: int): void {
    const tree = this.types.program.tree;

    const pairs = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (pairs == undefined || pairs.kind != ExprKind.ArrayLit) {
      return;
    }

    const first = tree.exprAt(tree.elementsOf(pairs.elementsList)[0]?.exprId);
    if (first == undefined || first.kind != ExprKind.ArrayLit) {
      return;
    }

    const head = tree.exprAt(tree.elementsOf(first.elementsList)[0]?.exprId);
    if (head == undefined) {
      return;
    }

    this.errors.beginTrial();

    const key = this.types.apparent(this.typed(head, undefined, module));

    this.errors.endTrial();

    const isNumeric = key.kind == TypeKind.Int || key.kind == TypeKind.Double;
    if (!isNumeric) {
      return;
    }

    this.errors.write(module, pairs.loc, Code.FromEntriesKeys, {
      word: this.types.typeText(key),
    });
  }

  private readonly isTextInit(init: Expr | undefined): boolean {
    if (init == undefined) {
      return false;
    }

    return init.kind == ExprKind.StringLit || init.kind == ExprKind.Template;
  }
}
