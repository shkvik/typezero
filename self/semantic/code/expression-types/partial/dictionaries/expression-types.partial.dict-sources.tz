import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  NewExpr,
  Property,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  DictKind,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { kNoPlace, kSetCombiners } from "../../const/expression-types.const.tz";

partial class ExpressionTypes {
  private dictSourceTyped(
    expr: NewExpr,
    dict: DictKind,
    written: Type[],
    wanted: Type | undefined,
    module: int,
  ): Type {
    const first = written[0];
    const second = written[1] ?? first;
    const source = expr.args[0]?.expr;
    if (first != undefined && second != undefined) {
      const typed = this.store.dictOf(dict, first, second);

      this.dictSourceCheck(source, dict, first, second, module);

      return typed;
    }

    const goal = this.dictionaries.wantedDict(wanted, dict);
    if (goal != undefined && goal.kind == TypeKind.Dict) {
      this.dictSourceCheck(source, dict, goal.key, goal.value, module);

      return goal;
    }
    if (source == undefined) {
      const code = this.dictionaries.dictTypesCode(dict);

      this.report(module, expr.loc, code, kNoDetails);

      return this.store.plain(TypeKind.Error);
    }
    if (dict == DictKind.Map) {
      return this.mapFromPairs(source, module);
    }

    return this.setFromValues(source, module);
  }

  private dictSourceCheck(
    source: Expr | undefined,
    dict: DictKind,
    key: Type,
    value: Type,
    module: int,
  ): void {
    if (source == undefined || source.kind != ExprKind.ArrayLit) {
      return;
    }

    const element = this.dictionaries.dictElement(dict, key, value);
    const list = this.store.arrayOf(element);

    this.checked(source, list, module, kNoPlace);
  }

  private mapFromPairs(source: Expr, module: int): Type {
    const error = this.store.plain(TypeKind.Error);
    if (source.kind != ExprKind.ArrayLit) {
      this.typed(source, undefined, module);

      return error;
    }

    let key: Type | undefined = undefined;
    let value: Type | undefined = undefined;

    for (const element of source.elements) {
      const pair = element.expr;
      if (element.spread || pair.kind != ExprKind.ArrayLit) {
        const found = this.typed(pair, undefined, module);

        this.report(module, source.loc, Code.MapNotPairs, {
          word: this.text.of(this.functions.widened(found)),
        });

        return error;
      }

      const parts = pair.elements;
      const head = parts[0]?.expr;
      const tail = parts[1]?.expr;
      if (parts.length != 2 || head == undefined || tail == undefined) {
        return error;
      }

      const keyType = this.functions.widened(
        this.typed(head, undefined, module),
      );
      const valueType = this.functions.widened(
        this.typed(tail, undefined, module),
      );

      if (key != undefined && key != keyType) {
        const pairsDifferError = this.dictionaries.pairsDifferError(
          head,
          Code.MapKeysDiffer,
          key,
          keyType,
        );

        this.reportFound(module, pairsDifferError);

        return error;
      }
      if (value != undefined && value != valueType) {
        const pairsDifferError2 = this.dictionaries.pairsDifferError(
          tail,
          Code.MapValuesDiffer,
          value,
          valueType,
        );

        this.reportFound(module, pairsDifferError2);

        return error;
      }

      key = keyType;
      value = valueType;
    }

    if (key == undefined || value == undefined) {
      return error;
    }

    return this.store.dictOf(DictKind.Map, key, value);
  }

  private setFromValues(source: Expr, module: int): Type {
    const type = this.typed(source, undefined, module);
    const base = this.types.apparent(type);
    const error = this.store.plain(TypeKind.Error);

    switch (base.kind) {
      case TypeKind.Array:
        return this.store.dictOf(DictKind.Set, base.item, base.item);
      case TypeKind.Dict:
        return this.store.dictOf(DictKind.Set, base.value, base.value);
      default:
        return error;
    }
  }

  private setCombineCheck(
    expr: CallExpr,
    member: MemberExpr,
    object: Type,
    module: int,
  ): boolean {
    const base = this.types.definedType(object);
    const arg = expr.args[0]?.expr;
    const isSet = base.kind == TypeKind.Dict && base.dict == DictKind.Set;
    if (!isSet || arg == undefined || !kSetCombiners.includes(member.name)) {
      return false;
    }
    if (base.kind != TypeKind.Dict) {
      return false;
    }

    const given = this.peekType(arg, module);

    const other = this.types.definedType(given);
    const isDict = other.kind == TypeKind.Dict && other.dict != DictKind.Record;
    if (isDict || other.kind == TypeKind.Error) {
      return false;
    }

    this.report(module, arg.loc, Code.SetCombineNeedsSet, {
      word: member.name,
      first: this.text.of(base.value),
      other: this.text.of(given),
    });

    return true;
  }

  private recordTargetCheck(target: Expr, module: int): boolean {
    if (target.kind != ExprKind.Member && target.kind != ExprKind.Index) {
      return false;
    }

    const holder = target.object;

    const object = this.peekType(holder, module);

    const base = this.types.definedType(object);
    if (base.kind != TypeKind.Dict || base.dict != DictKind.Record) {
      return false;
    }

    const word = this.dictionaries.recordKeyText(target);
    const code = this.dictionaries.recordMissingCode(base.value);

    this.report(module, target.loc, code, { word });

    return true;
  }

  private recordValueOf(holder: Expr, module: int): Type | undefined {
    const object = this.peekType(holder, module);

    const base = this.types.definedType(object);
    if (base.kind != TypeKind.Dict || base.dict != DictKind.Record) {
      return undefined;
    }

    return base.value;
  }

  private recordMethodCheck(
    expr: CallExpr,
    member: MemberExpr,
    object: Type,
    module: int,
  ): boolean {
    const base = this.types.definedType(object);
    if (base.kind != TypeKind.Dict || base.dict != DictKind.Record) {
      return false;
    }
    if (member.name != "hasOwnProperty") {
      return false;
    }

    const other = this.sources.tupleText(member.object);

    this.looseArguments(expr.args, module);
    this.report(module, member.loc, Code.RecordHasOwn, {
      word: `${other}.${member.name}`,
      other,
    });

    return true;
  }

  private spreadCheck(property: Property, module: int): void {
    const type = this.peekType(property.value, module);

    if (this.types.hasMethodFields(type)) {
      this.report(module, property.value.loc, Code.SpreadMethods, kNoDetails);

      return;
    }

    const code = this.dictionaries.spreadCode(type);
    if (code == undefined) {
      return;
    }

    this.report(module, property.value.loc, code, {
      word: this.text.of(type),
    });
  }

  private recordSpreadCheck(property: Property, module: int): boolean {
    const type = this.peekType(property.value, module);

    const base = this.types.apparent(type);
    const code = this.dictionaries.recordSpreadCode(base);
    if (code == undefined) {
      return false;
    }

    this.report(module, property.value.loc, code, {
      word: this.text.of(type),
    });

    return true;
  }

  private objectKeysCheck(expr: CallExpr, module: int): void {
    const callee = expr.callee;
    if (callee.kind != ExprKind.Member) {
      return;
    }

    const holder = callee.object;
    const isObject =
      holder.kind == ExprKind.Name &&
      holder.name == "Object" &&
      this.isGlobalUse(holder, module);
    if (!isObject) {
      return;
    }
    if (callee.name == "groupBy") {
      return this.groupByKeysCheck(expr, module);
    }
    if (callee.name == "fromEntries") {
      this.fromEntriesKeysCheck(expr, module);
    }
    if (callee.name == "values" || callee.name == "entries") {
      this.numberEnumListCheck(expr, callee.name, module);
    }
  }

  private numberEnumListCheck(expr: CallExpr, name: string, module: int): void {
    const listed = expr.args[0]?.expr;
    if (listed == undefined || expr.args.length != 1) {
      return;
    }

    const home = this.enumHomeOf(listed, module);
    if (home == undefined) {
      return;
    }

    const decl = home.decl;
    const isText = decl.members.some(
      (member) =>
        member.init != undefined &&
        (member.init.kind == ExprKind.StringLit ||
          member.init.kind == ExprKind.Template),
    );
    if (isText) {
      return;
    }

    const other = decl.members[0]?.name ?? "A";

    this.report(module, listed.loc, Code.ObjectNumberEnum, {
      word: name,
      first: decl.name,
      other,
    });
  }

  private groupByKeysCheck(expr: CallExpr, module: int): void {
    const items = expr.args[0]?.expr;
    const callback = expr.args[1]?.expr;
    if (items == undefined || callback == undefined) {
      return;
    }
    if (callback.kind != ExprKind.Function) {
      return;
    }

    this.errors.beginTrial();

    const list = this.typed(items, undefined, module);
    const element = this.callbacks.elementOf(this.types.apparent(list));
    const result = this.store.plain(TypeKind.Error);
    const params = [{ type: element, optional: false }];
    const wanted = this.store.functionOf({ params, rest: false, result });
    const typed = this.typed(callback, wanted, module);

    this.errors.endTrial();

    if (typed.kind != TypeKind.Function) {
      return;
    }

    const key = this.types.apparent(typed.shape.result);
    const isNumeric = key.kind == TypeKind.Int || key.kind == TypeKind.Double;
    if (!isNumeric) {
      return;
    }

    this.report(module, callback.loc, Code.GroupByKeys, {
      word: this.text.of(key),
    });
  }

  private fromEntriesKeysCheck(expr: CallExpr, module: int): void {
    const pairs = expr.args[0]?.expr;
    if (pairs == undefined || pairs.kind != ExprKind.ArrayLit) {
      return;
    }

    const first = pairs.elements[0]?.expr;
    if (first == undefined || first.kind != ExprKind.ArrayLit) {
      return;
    }

    const head = first.elements[0]?.expr;
    if (head == undefined) {
      return;
    }

    this.errors.beginTrial();

    const key = this.types.apparent(this.typed(head, undefined, module));

    this.errors.endTrial();

    const isNumeric = key.kind == TypeKind.Int || key.kind == TypeKind.Double;
    if (!isNumeric) {
      return;
    }

    this.report(module, pairs.loc, Code.FromEntriesKeys, {
      word: this.text.of(key),
    });
  }
}
