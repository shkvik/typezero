import { ExpressionTypes } from "../expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import {
  Expr,
  ExprKind,
  UnaryExpr,
  UnaryOp,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";
import {
  kDot,
  kHiddenMark,
  kOptionalDot,
  kUnaryTexts,
  kUnnamedOperand,
} from "../const/expression-types.const.tz";

partial class ExpressionTypes {
  private unaryTyped(
    expr: UnaryExpr,
    wanted: Type | undefined,
    module: int,
  ): Type {
    switch (expr.op) {
      case UnaryOp.Neg:
      case UnaryOp.Plus:
        return this.signTyped(expr, wanted, module);
      case UnaryOp.BitNot:
        return this.bitNotTyped(expr, wanted, module);
      case UnaryOp.Not:
        return this.notTyped(expr, module);
      case UnaryOp.TypeOf:
        return this.typeofTyped(expr, module);
      case UnaryOp.Void:
        return this.voidTyped(expr, module);
      case UnaryOp.NonNull:
        return this.nonNullTyped(expr, wanted, module);
      default:
        return this.store.plain(TypeKind.Error);
    }
  }

  private voidTyped(expr: UnaryExpr, module: int): Type {
    const type = this.typed(expr.operand, undefined, module);
    const isPromised = type.kind == TypeKind.Promise;
    const dropped = this.droppedValue(type);
    if (this.holdsKind(dropped, TypeKind.Result)) {
      const code = this.droppedCode(isPromised);

      this.report(module, expr.loc, code, kNoDetails);
    }

    return this.store.plain(TypeKind.Undefined);
  }

  private droppedValue(type: Type): Type {
    if (type.kind != TypeKind.Promise) {
      return type;
    }

    return type.value;
  }

  private droppedCode(isPromised: boolean): Code {
    if (isPromised) {
      return Code.VoidDropsAsyncResult;
    }

    return Code.VoidDropsResult;
  }

  private nonNullTyped(
    expr: UnaryExpr,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const type = this.typed(expr.operand, wanted, module);
    const word = this.assertedText(expr.operand) ?? kUnnamedOperand;

    if (type.kind == TypeKind.Error) {
      return type;
    }
    if (type.kind == TypeKind.Undefined) {
      this.report(module, expr.loc, Code.NonNullUndefined, kNoDetails);

      return this.store.plain(TypeKind.Error);
    }
    if (!this.isOptional(type)) {
      this.report(module, expr.loc, Code.NonNullNever, { word });

      return type;
    }

    this.report(module, expr.loc, Code.NonNullCheck, { word });

    return this.definedType(type);
  }

  private assertedText(expr: Expr): string | undefined {
    switch (expr.kind) {
      case ExprKind.Name:
        if (expr.name.startsWith(kHiddenMark)) {
          return undefined;
        }

        return expr.name;
      case ExprKind.IntLit:
        return `${expr.value}`;
      case ExprKind.Member: {
        const object = this.assertedText(expr.object);
        const dot = this.memberDot(expr.optional);

        if (object == undefined) {
          return undefined;
        }

        return `${object}${dot}${expr.name}`;
      }
      case ExprKind.Index: {
        const object = this.assertedText(expr.object);
        const index = this.assertedText(expr.index);
        if (object == undefined || index == undefined) {
          return undefined;
        }

        return `${object}[${index}]`;
      }
      default:
        return undefined;
    }
  }

  private memberDot(optional: boolean): string {
    if (optional) {
      return kOptionalDot;
    }

    return kDot;
  }

  private signTyped(
    expr: UnaryExpr,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const hint = this.signHint(expr, wanted);
    const type = this.operandTyped(expr.operand, hint, module);
    const other = this.unaryText(expr.op);
    const isPlus = expr.op == UnaryOp.Plus;

    if (type.kind == TypeKind.String) {
      this.report(module, expr.loc, Code.SignOfText, { other });

      return this.store.plain(TypeKind.Error);
    }
    if (type.kind == TypeKind.Boolean) {
      this.report(module, expr.loc, Code.SignOfBoolean, { other });

      return this.store.plain(TypeKind.Error);
    }
    if (this.isDate(type) && isPlus) {
      return this.store.plain(TypeKind.Error);
    }

    const isLiteral =
      expr.operand.kind == ExprKind.IntLit ||
      expr.operand.kind == ExprKind.FloatLit;
    if (type.kind == TypeKind.Decimal && isPlus && !isLiteral) {
      this.report(module, expr.loc, Code.DecimalPlus, kNoDetails);

      return this.store.plain(TypeKind.Error);
    }

    const isNumber = this.isNumberLike(type) || type.kind == TypeKind.Error;
    if (!isNumber) {
      const first = this.text.of(type);

      this.report(module, expr.loc, Code.UnaryOperandType, { other, first });

      return this.store.plain(TypeKind.Error);
    }

    this.foldUnary(expr, type, module);

    return type;
  }

  private signHint(
    expr: UnaryExpr,
    wanted: Type | undefined,
  ): Type | undefined {
    const plain = this.wantedPart(wanted);
    if (plain == undefined) {
      return undefined;
    }

    const isFraction = expr.operand.kind == ExprKind.FloatLit;
    const member = this.numberMember(plain, isFraction);
    const target = member ?? plain;
    if (!this.isNumberLike(target)) {
      return undefined;
    }

    return target;
  }

  private numberMember(type: Type, isFraction: boolean): Type | undefined {
    if (type.kind != TypeKind.Union) {
      return undefined;
    }

    return type.parts.find(
      (part) =>
        this.isNumberLike(part) && (!isFraction || part.kind != TypeKind.Int),
    );
  }

  private bitNotTyped(
    expr: UnaryExpr,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const expected = this.wantedPart(wanted);
    const hint = this.integerOf(expected);
    const type = this.operandTyped(expr.operand, hint, module);
    if (type.kind == TypeKind.Double) {
      this.report(module, expr.loc, Code.BitNotOfDouble, kNoDetails);

      return this.store.plain(TypeKind.Error);
    }

    const isInteger = type.kind == TypeKind.Int || type.kind == TypeKind.Error;
    if (!isInteger) {
      const other = this.unaryText(expr.op);
      const first = this.text.of(type);

      this.report(module, expr.loc, Code.UnaryOperandType, { other, first });

      return this.store.plain(TypeKind.Error);
    }

    this.foldUnary(expr, type, module);

    return type;
  }

  private integerOf(type: Type | undefined): Type | undefined {
    if (type == undefined || type.kind != TypeKind.Int) {
      return undefined;
    }

    return type;
  }

  private unaryText(op: UnaryOp): string {
    const row = kUnaryTexts.find((one) => one.op == op);

    return row?.text ?? "";
  }
}
