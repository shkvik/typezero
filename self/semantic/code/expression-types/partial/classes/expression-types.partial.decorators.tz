import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  ClassDecl,
  ClassField,
  FieldKind,
  MethodKind,
} from "../../../../../program/ast/types/ast.types.classes.tz";
import {
  Expr,
  ExprKind,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import {
  Stmt,
  StmtKind,
} from "../../../../../program/ast/types/ast.types.statements.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  kMetadataName,
  kReflectName,
} from "../../const/expression-types.const.tz";
import {
  DecorateRun,
  DecoratorPlace,
  DecoratorUse,
  StaticOwner,
} from "../../types/expression-types.types.tz";
import { kDecoratorPlaces } from "../../../decorator-rules/const/decorator-rules.const.tz";

partial class ExpressionTypes {
  private decoratorChecks(decl: ClassDecl, module: int): void {
    if (!this.types.isDecoratedClass(decl)) {
      return;
    }

    const decoratedNamesErrors = this.types.decoratedNamesCheck(decl);

    this.errors.writeAll(module, decoratedNamesErrors);
    const decoratedConstructorsError =
      this.types.decoratedConstructorsCheck(decl);

    this.errors.writeFound(module, decoratedConstructorsError);

    const runs = this.types.memberRuns(decl);

    for (const run of runs) {
      this.decorate(run, module);
    }

    const uses = this.types.classUses(decl);
    const at = uses[0]?.decorator.loc;
    if (at == undefined) {
      return;
    }

    this.decorate(
      {
        decl,
        uses,
        place: DecoratorPlace.Class,
        isStatic: false,
        at,
      },
      module,
    );
  }

  private decorate(run: Read<DecorateRun>, module: int): void {
    const tree = this.types.program.tree;

    if (run.field?.accessor == true) {
      return this.errors.write(
        module,
        run.at,
        Code.DecoratorAccessor,
        kNoDetails,
      );
    }
    if (run.method?.role?.method == MethodKind.Abstract) {
      return this.errors.write(
        module,
        run.at,
        Code.DecoratorAbstract,
        kNoDetails,
      );
    }

    const types: Type[] = [];
    let isFitting = true;
    let hasDescriptor = false;

    for (const use of run.uses) {
      const place = this.types.usePlace(run, use);
      const type = this.decoratorType(
        tree.exprOf(use.decorator.exprId),
        module,
      );
      const count = this.decoratorFit(use, place, type, module);

      types.push(type);
      isFitting = isFitting && count >= 0;
      hasDescriptor =
        hasDescriptor || this.types.isDescriptorUse(place, count);
    }

    if (!isFitting) {
      return;
    }
    if (
      hasDescriptor &&
      tree.typeParamsOf(run.decl.typeParamsList).length > 0
    ) {
      return this.errors.write(
        module,
        run.at,
        Code.DecoratorGenericDescriptor,
        {
          word: run.decl.name ?? "",
        },
      );
    }

    for (let index = run.uses.length - 1; index >= 0; index--) {
      const use = run.uses[index];
      const type = types[index];
      if (use != undefined && type != undefined) {
        this.decoratorResultCheck(run, use, type, hasDescriptor, module);
      }
    }
  }

  private decoratorType(expr: Expr, module: int): Type {
    if (this.isMetadataDecorator(expr, module)) {
      return this.types.store.plain(TypeKind.Error);
    }
    if (expr.kind != ExprKind.Name) {
      return this.typed(expr, undefined, module);
    }

    const target = this.targetOfName(expr, module);
    if (target == undefined || target.kind != SymbolKind.Function) {
      return this.typed(expr, undefined, module);
    }

    return this.functionAt(target.module, target.loc);
  }

  private readonly isMetadataDecorator(expr: Expr, module: int): boolean {
    const tree = this.types.program.tree;

    if (expr.kind != ExprKind.Call) {
      return false;
    }

    const callee = tree.exprOf(expr.calleeId);
    if (callee.kind != ExprKind.Member || callee.name != kMetadataName) {
      return false;
    }

    const object = tree.exprOf(callee.objectId);
    if (object.kind != ExprKind.Name || object.name != kReflectName) {
      return false;
    }

    return this.targetOfName(object, module) == undefined;
  }

  private decoratorFit(
    use: DecoratorUse,
    place: DecoratorPlace,
    type: Type,
    module: int,
  ): int {
    const checked = this.types.decoratorFit(use, place, type);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private decoratorResultCheck(
    run: Read<DecorateRun>,
    use: DecoratorUse,
    type: Type,
    hasDescriptor: boolean,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    if (type.kind != TypeKind.Function) {
      return;
    }

    const result = this.types.store.returnTypeOf(type);
    const place = this.types.usePlace(run, use);
    const isClassPlace = place == DecoratorPlace.Class;
    const isReplacing =
      this.isReplacement(run.decl, type, module) ||
      this.isExtendingDecorator(
        tree.exprOf(use.decorator.exprId),
        result,
        module,
      );
    if (isClassPlace && isReplacing) {
      return this.oldObjectCheck(run.decl, module);
    }

    const isNothing =
      result.kind == TypeKind.Void ||
      result.kind == TypeKind.Undefined ||
      result.kind == TypeKind.Error;
    if (isNothing || this.types.mentionsParameter(result)) {
      return;
    }

    const third = this.types.store.paramsOf(type)[2]?.type;
    const isDescriptor = place == DecoratorPlace.Method && hasDescriptor;
    if (isDescriptor && result.id == third?.id) {
      return;
    }
    if (isClassPlace && this.isReplacing(run.decl, result, module)) {
      return;
    }

    const expr = tree.exprOf(use.decorator.exprId);
    const word = this.types.decoratorLabel(expr);
    const first = this.types.typeText(result);
    const loc = use.decorator.loc;
    if (isClassPlace && result.kind == TypeKind.Class && !result.exact) {
      return this.errors.write(module, loc, Code.DecoratorRuntimeClass, {
        word,
        first,
        second: run.decl.name ?? "",
      });
    }
    if (isClassPlace) {
      return this.errors.write(module, loc, Code.DecoratorClassResult, {
        word,
        first,
      });
    }
    if (isDescriptor) {
      return this.errors.write(module, loc, Code.DecoratorMethodResult, {
        word,
        first,
      });
    }

    const row = kDecoratorPlaces.find((one) => one.place == place);

    this.errors.write(module, loc, Code.DecoratorOtherResult, {
      word,
      first,
      second: row?.noun ?? "",
    });
  }

  private isReplacement(
    decl: ClassDecl,
    decorator: Type,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    if (
      decorator.kind != TypeKind.Function ||
      tree.typeParamsOf(decl.typeParamsList).length > 0
    ) {
      return false;
    }

    const result = this.types.store.returnTypeOf(decorator);
    if (result.kind != TypeKind.Class || !result.exact) {
      return false;
    }

    const own = this.types.classInstance(module, decl, []);
    if (this.types.store.classInstanceOf(result).id == own.id) {
      return false;
    }

    const given = this.types.store.paramsOf(decorator)[0]?.type;
    if (given?.kind == TypeKind.TypeParameter) {
      return this.isBuiltOnGiven(this.types.store.classInstanceOf(result));
    }

    return this.types.converts(this.types.store.classInstanceOf(result), own);
  }

  private readonly isExtendingDecorator(
    expr: Expr,
    result: Type,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    if (result.kind != TypeKind.Error || expr.kind != ExprKind.Name) {
      return false;
    }

    const target = this.targetOfName(expr, module);
    if (target == undefined || target.kind != SymbolKind.Function) {
      return false;
    }

    const fn = this.record(target.module)?.functions.get(target.loc);
    const given = tree.paramsOf(fn?.paramsList)[0]?.name;
    const body = tree.blockAt(fn?.bodyId);
    if (
      given == undefined ||
      body == undefined ||
      tree.typeParamsOf(fn?.typeParamsList).length == 0
    ) {
      return false;
    }

    const returned = tree
      .stmtsOf(body.bodyList)
      .filter((one) => one.kind == StmtKind.Return);

    return (
      returned.length > 0 &&
      returned.every((one) => this.isGivenSubclass(one, given))
    );
  }

  private readonly isGivenSubclass(statement: Stmt, given: string): boolean {
    const tree = this.types.program.tree;

    if (statement.kind != StmtKind.Return) {
      return false;
    }

    const value = tree.exprAt(statement.valueId);
    if (value == undefined || value.kind != ExprKind.Class) {
      return false;
    }

    const decl = tree.classOf(value.declId);
    const base = tree.exprAt(decl.baseExprId);
    if (base != undefined && base.kind == ExprKind.Name) {
      return base.name == given;
    }

    return tree.typeRefAt(decl.baseId)?.name == given;
  }

  private readonly isBuiltOnGiven(instance: Type): boolean {
    const tree = this.types.program.tree;

    if (instance.kind != TypeKind.Instance) {
      return false;
    }

    const made = this.classOf(instance);
    const module = instance.module;
    const base = tree.typeRefAt(made?.baseId);
    if (base != undefined) {
      const target = this.targetOfUse(base.loc, base.name, module);

      return target?.kind == SymbolKind.Parameter;
    }

    const expr = tree.exprAt(made?.baseExprId);
    if (expr == undefined || expr.kind != ExprKind.Name) {
      return false;
    }

    return this.targetOfName(expr, module)?.kind == SymbolKind.Parameter;
  }

  private oldObjectCheck(decl: ClassDecl, module: int): void {
    const tree = this.types.program.tree;

    const own = this.types.classInstance(module, decl, []);
    const owner: StaticOwner = { decl, module };

    for (const field of tree.fieldsOf(decl.fieldsList)) {
      if (field.form != FieldKind.Static) {
        continue;
      }

      const type = this.staticHeldType(field, owner);
      if (type != undefined && this.isHolding(type, own)) {
        return this.errors.write(module, field.loc, Code.DecoratorOldObject, {
          word: decl.name ?? "",
          other: field.name,
        });
      }
    }
  }

  private staticHeldType(
    field: ClassField,
    owner: StaticOwner,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const typeRef = tree.typeRefAt(field.typeId);
    if (typeRef != undefined) {
      return this.staticFieldType(
        tree.typeRefAt(field.typeId),
        field.presence,
        owner,
      );
    }
    const init = tree.exprAt(field.initId);
    if (init == undefined) {
      return undefined;
    }

    return this.peekType(init, owner.module);
  }

  private readonly isHolding(type: Type, own: Type): boolean {
    if (type.id == own.id) {
      return true;
    }

    return this.types.typeParts(type).some((part) => this.isHolding(part, own));
  }

  private isReplacing(decl: ClassDecl, result: Type, module: int): boolean {
    const tree = this.types.program.tree;

    if (result.kind != TypeKind.Class || !result.exact) {
      return false;
    }
    const typeParams = tree.typeParamsOf(decl.typeParamsList);
    if (typeParams.length > 0) {
      return true;
    }

    const own = this.types.classInstance(module, decl, []);

    return this.types.converts(this.types.store.classInstanceOf(result), own);
  }
}
