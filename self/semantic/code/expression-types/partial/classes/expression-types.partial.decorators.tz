import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  ClassDecl,
  ClassField,
  FieldKind,
  MethodKind,
} from "../../../../../program/ast/types/ast.types.classes.tz";
import {
  Expr,
  ExprKind,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import {
  Stmt,
  StmtKind,
} from "../../../../../program/ast/types/ast.types.statements.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  kMetadataName,
  kReflectName,
} from "../../const/expression-types.const.tz";
import {
  DecorateRun,
  DecoratorPlace,
  DecoratorUse,
  StaticOwner,
} from "../../types/expression-types.types.tz";
import { kDecoratorPlaces } from "../../../decorator-rules/const/decorator-rules.const.tz";

partial class ExpressionTypes {
  private readonly decoratorChecks(decl: ClassDecl, module: int): void {
    if (!this.decorators.isDecoratedClass(decl)) {
      return;
    }

    const decoratedNamesErrors = this.decorators.decoratedNamesCheck(decl);

    this.reportAll(module, decoratedNamesErrors);
    const decoratedConstructorsError =
      this.decorators.decoratedConstructorsCheck(decl);

    this.reportFound(module, decoratedConstructorsError);

    for (const run of this.decorators.memberRuns(decl)) {
      this.decorate(run, module);
    }

    const uses = this.decorators.classUses(decl);
    const at = uses[0]?.decorator.loc;
    if (at == undefined) {
      return;
    }

    this.decorate(
      {
        decl,
        uses,
        place: DecoratorPlace.Class,
        isStatic: false,
        at,
      },
      module,
    );
  }

  private readonly decorate(run: Read<DecorateRun>, module: int): void {
    if (run.field?.accessor == true) {
      return this.report(module, run.at, Code.DecoratorAccessor, kNoDetails);
    }
    if (run.method?.role?.method == MethodKind.Abstract) {
      return this.report(module, run.at, Code.DecoratorAbstract, kNoDetails);
    }

    const types: Type[] = [];
    let isFitting = true;
    let hasDescriptor = false;

    for (const use of run.uses) {
      const place = this.decorators.usePlace(run, use);
      const type = this.decoratorType(use.decorator.expr, module);
      const count = this.decoratorFit(use, place, type, module);

      types.push(type);
      isFitting = isFitting && count >= 0;
      hasDescriptor =
        hasDescriptor || this.decorators.isDescriptorUse(place, count);
    }

    if (!isFitting) {
      return;
    }
    if (hasDescriptor && run.decl.typeParams.length > 0) {
      return this.report(module, run.at, Code.DecoratorGenericDescriptor, {
        word: run.decl.name ?? "",
      });
    }

    for (let index = run.uses.length - 1; index >= 0; index--) {
      const use = run.uses[index];
      const type = types[index];
      if (use != undefined && type != undefined) {
        this.decoratorResultCheck(run, use, type, hasDescriptor, module);
      }
    }
  }

  private readonly decoratorType(expr: Expr, module: int): Type {
    if (this.isMetadataDecorator(expr, module)) {
      return this.store.plain(TypeKind.Error);
    }
    if (expr.kind != ExprKind.Name) {
      return this.typed(expr, undefined, module);
    }

    const target = this.targetOfName(expr, module);
    if (target == undefined || target.kind != SymbolKind.Function) {
      return this.typed(expr, undefined, module);
    }

    return this.functionAt(target.module, target.loc);
  }

  private readonly isMetadataDecorator(expr: Expr, module: int): boolean {
    if (expr.kind != ExprKind.Call) {
      return false;
    }

    const callee = expr.callee;
    if (callee.kind != ExprKind.Member || callee.name != kMetadataName) {
      return false;
    }

    const object = callee.object;
    if (object.kind != ExprKind.Name || object.name != kReflectName) {
      return false;
    }

    return this.targetOfName(object, module) == undefined;
  }

  private readonly decoratorFit(
    use: DecoratorUse,
    place: DecoratorPlace,
    type: Type,
    module: int,
  ): int {
    const checked = this.decorators.decoratorFit(use, place, type);

    this.reportFound(module, checked.error);

    return checked.value;
  }

  private readonly decoratorResultCheck(
    run: Read<DecorateRun>,
    use: DecoratorUse,
    type: Type,
    hasDescriptor: boolean,
    module: int,
  ): void {
    if (type.kind != TypeKind.Function) {
      return;
    }

    const result = type.shape.result;
    const place = this.decorators.usePlace(run, use);
    const isClassPlace = place == DecoratorPlace.Class;
    const isReplacing =
      this.isReplacement(run.decl, type, module) ||
      this.isExtendingDecorator(use.decorator.expr, result, module);
    if (isClassPlace && isReplacing) {
      return this.oldObjectCheck(run.decl, module);
    }

    const isNothing =
      result.kind == TypeKind.Void ||
      result.kind == TypeKind.Undefined ||
      result.kind == TypeKind.Error;
    if (isNothing || this.parts.mentionsParameter(result)) {
      return;
    }

    const third = type.shape.params[2]?.type;
    const isDescriptor = place == DecoratorPlace.Method && hasDescriptor;
    if (isDescriptor && result == third) {
      return;
    }
    if (isClassPlace && this.isReplacing(run.decl, result, module)) {
      return;
    }

    const word = this.decorators.decoratorLabel(use.decorator.expr);
    const first = this.text.of(result);
    const loc = use.decorator.loc;
    if (isClassPlace && result.kind == TypeKind.Class && !result.exact) {
      return this.report(module, loc, Code.DecoratorRuntimeClass, {
        word,
        first,
        second: run.decl.name ?? "",
      });
    }
    if (isClassPlace) {
      return this.report(module, loc, Code.DecoratorClassResult, {
        word,
        first,
      });
    }
    if (isDescriptor) {
      return this.report(module, loc, Code.DecoratorMethodResult, {
        word,
        first,
      });
    }

    const row = kDecoratorPlaces.find((one) => one.place == place);

    this.report(module, loc, Code.DecoratorOtherResult, {
      word,
      first,
      second: row?.noun ?? "",
    });
  }

  private readonly isReplacement(
    decl: ClassDecl,
    decorator: Type,
    module: int,
  ): boolean {
    if (decorator.kind != TypeKind.Function || decl.typeParams.length > 0) {
      return false;
    }

    const result = decorator.shape.result;
    if (result.kind != TypeKind.Class || !result.exact) {
      return false;
    }

    const own = this.resolver.classInstance(module, decl, []);
    if (result.instance == own) {
      return false;
    }

    const given = decorator.shape.params[0]?.type;
    if (given?.kind == TypeKind.TypeParameter) {
      return this.isBuiltOnGiven(result.instance);
    }

    return this.relation.converts(result.instance, own);
  }

  private readonly isExtendingDecorator(
    expr: Expr,
    result: Type,
    module: int,
  ): boolean {
    if (result.kind != TypeKind.Error || expr.kind != ExprKind.Name) {
      return false;
    }

    const target = this.targetOfName(expr, module);
    if (target == undefined || target.kind != SymbolKind.Function) {
      return false;
    }

    const fn = this.record(target.module)?.functions.get(target.loc);
    const given = fn?.params[0]?.name;
    const body = fn?.body;
    if (given == undefined || body == undefined || fn?.typeParams.length == 0) {
      return false;
    }

    const returned = body.body.filter((one) => one.kind == StmtKind.Return);

    return (
      returned.length > 0 &&
      returned.every((one) => this.isGivenSubclass(one, given))
    );
  }

  private readonly isGivenSubclass(statement: Stmt, given: string): boolean {
    if (statement.kind != StmtKind.Return) {
      return false;
    }

    const value = statement.value;
    if (value == undefined || value.kind != ExprKind.Class) {
      return false;
    }

    const decl = value.decl;
    const base = decl.baseExpr;
    if (base != undefined && base.kind == ExprKind.Name) {
      return base.name == given;
    }

    return decl.base?.name == given;
  }

  private readonly isBuiltOnGiven(instance: Type): boolean {
    if (instance.kind != TypeKind.Instance) {
      return false;
    }

    const made = this.classOf(instance);
    const module = instance.module;
    const base = made?.base;
    if (base != undefined) {
      const target = this.targetOfUse(base.loc, base.name, module);

      return target?.kind == SymbolKind.Parameter;
    }

    const expr = made?.baseExpr;
    if (expr == undefined || expr.kind != ExprKind.Name) {
      return false;
    }

    return this.targetOfName(expr, module)?.kind == SymbolKind.Parameter;
  }

  private readonly oldObjectCheck(decl: ClassDecl, module: int): void {
    const own = this.resolver.classInstance(module, decl, []);
    const owner: StaticOwner = { decl, module };

    for (const field of decl.fields) {
      if (field.form != FieldKind.Static) {
        continue;
      }

      const type = this.staticHeldType(field, owner);
      if (type != undefined && this.isHolding(type, own)) {
        return this.report(module, field.loc, Code.DecoratorOldObject, {
          word: decl.name ?? "",
          other: field.name,
        });
      }
    }
  }

  private readonly staticHeldType(
    field: ClassField,
    owner: StaticOwner,
  ): Type | undefined {
    if (field.type != undefined) {
      return this.staticFieldType(field.type, field.presence, owner);
    }
    if (field.init == undefined) {
      return undefined;
    }

    return this.peekType(field.init, owner.module);
  }

  private readonly isHolding(type: Type, own: Type): boolean {
    if (type == own) {
      return true;
    }

    return this.parts.typeParts(type).some((part) => this.isHolding(part, own));
  }

  private readonly isReplacing(decl: ClassDecl, result: Type, module: int): boolean {
    if (result.kind != TypeKind.Class || !result.exact) {
      return false;
    }
    if (decl.typeParams.length > 0) {
      return true;
    }

    const own = this.resolver.classInstance(module, decl, []);

    return this.relation.converts(result.instance, own);
  }
}
