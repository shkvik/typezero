import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  ClassDecl,
  MethodKind,
} from "../../../../../program/ast/types/ast.types.classes.tz";
import {
  CallExpr,
  MemberExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../../program/ast/types/ast.types.functions.tz";
import { TypeRef } from "../../../../../program/ast/types/ast.types.types.tz";
import {
  InstanceType,
  ObjectField,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { TypePlace } from "../../../../types/type-resolver/types/type-resolver.types.tz";
import { ClassMemberEntry } from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private contractChecks(decl: ClassDecl, module: int): void {
    const tree = this.types.program.tree;

    const typeParams = tree.typeParamsOf(decl.typeParamsList);
    if (typeParams.length > 0) {
      return;
    }

    const instance = this.types.classInstance(module, decl, []);
    if (instance.kind != TypeKind.Instance) {
      return;
    }

    this.extendsCheck(decl, module);
    const abstractMethodsErrors = this.types.abstractMethodsCheck(decl);

    this.errors.writeAll(module, abstractMethodsErrors);
    this.abstractParentsCheck(decl, instance, module);

    for (const ref of tree.typeRefsOf(decl.interfacesList)) {
      this.implementsCheck(decl, instance, ref, module);
    }
  }

  private extendsCheck(decl: ClassDecl, module: int): void {
    const tree = this.types.program.tree;

    const base = tree.typeRefAt(decl.baseId);
    if (base == undefined) {
      return;
    }

    const context = this.types.contextOf(module, TypePlace.Base);
    const type = this.types.resolve(base, context);
    if (type.kind != TypeKind.Object) {
      return;
    }

    const word = base.name;
    const first = decl.name ?? "";

    this.errors.write(module, base.loc, Code.ExtendsNotClass, { word, first });
  }

  private abstractParentsCheck(
    decl: ClassDecl,
    instance: InstanceType,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    if (decl.isAbstract) {
      return;
    }

    const done = new Set<string>();
    const parent = this.types.parentOf(instance, decl);

    for (const method of tree.functionsOf(decl.methodsList)) {
      const hook = this.streamHookVariant(method, decl, parent, module);
      if (hook == undefined) {
        done.add(method.name);
      }
    }

    const seen = new Set<int>();

    seen.add(decl.id);
    let current: InstanceType | undefined = this.types.parentOf(
      instance,
      decl,
    );
    let owner: ClassDecl | undefined = this.parentDeclOf(current);

    while (owner != undefined && current != undefined) {
      if (seen.has(owner.id)) {
        return;
      }

      seen.add(owner.id);
      this.abstractOwnerCheck(decl, owner, current, done, module);

      const parent = this.types.parentOf(current, owner);

      current = parent;
      owner = this.parentDeclOf(parent);
    }
  }

  private readonly parentDeclOf(
    parent: InstanceType | undefined,
  ): ClassDecl | undefined {
    if (parent == undefined) {
      return undefined;
    }

    return this.classOf(parent);
  }

  private abstractOwnerCheck(
    decl: ClassDecl,
    owner: ClassDecl,
    instance: InstanceType,
    done: Set<string>,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    for (const method of tree.functionsOf(owner.methodsList)) {
      const isAbstract = method.role?.method == MethodKind.Abstract;
      if (!isAbstract && !this.types.isStaticMethod(method)) {
        done.add(method.name);
      }
    }

    for (const method of tree.functionsOf(owner.methodsList)) {
      const isAbstract = method.role?.method == MethodKind.Abstract;
      if (isAbstract && !done.has(method.name)) {
        this.reportAbstract(decl, owner, instance, method, module);
        done.add(method.name);
      }
    }
  }

  private reportAbstract(
    decl: ClassDecl,
    owner: ClassDecl,
    instance: InstanceType,
    method: FunctionDecl,
    module: int,
  ): void {
    const entry: ClassMemberEntry = {
      owner,
      instance,
      methods: [method],
      isStatic: false,
    };
    const type = this.methodTypeOf(entry, method);
    if (type.kind != TypeKind.Function) {
      return;
    }

    const first = decl.name ?? "";
    const second = owner.name ?? "";
    const other = this.types.variantText(method, type);

    this.errors.write(module, decl.loc, Code.AbstractNotImplemented, {
      first,
      second,
      other,
    });
  }

  private implementsCheck(
    decl: ClassDecl,
    instance: InstanceType,
    ref: TypeRef,
    module: int,
  ): void {
    const context = this.types.contextOf(module, TypePlace.Base);
    const type = this.types.resolve(ref, context);
    const word = ref.name;

    if (
      type.kind == TypeKind.Instance &&
      !this.types.isLibraryModule(type.module)
    ) {
      const implementsClassError = this.types.implementsClassError(
        decl,
        ref,
      );

      return this.errors.writeFound(module, implementsClassError);
    }
    if (type.kind != TypeKind.Object) {
      return;
    }

    const done = new Set<string>();

    for (const field of this.types.store.fieldsOf(type)) {
      const same = this.types.store
        .fieldsOf(type)
        .filter((one) => one.name == field.name);
      if (same.length == 1) {
        this.contractMember(decl, instance, word, field, module);
      }
      if (same.length > 1 && !done.has(field.name)) {
        done.add(field.name);
        this.contractSignatures(decl, instance, word, same, module);
      }
    }
  }

  private contractMember(
    decl: ClassDecl,
    instance: InstanceType,
    iface: string,
    field: ObjectField,
    module: int,
  ): void {
    const lookup = this.classMember(instance, field.name);
    const entry = lookup.entry;
    const first = decl.name ?? "";

    if (!lookup.isKnown) {
      return;
    }
    if (entry == undefined) {
      if (!field.optional) {
        const missingMemberError = this.types.classOverrideMissingMemberError(
          decl,
          iface,
          field,
        );

        this.errors.writeFound(module, missingMemberError);
      }

      return;
    }

    const own = entry.field;
    const method = entry.methods[0];

    if (own != undefined) {
      return this.contractField(entry, iface, field, first, module);
    }
    if (method == undefined) {
      return;
    }

    const wanted = this.types.fieldWanted(field);
    const word = field.name;
    if (wanted.kind != TypeKind.Function) {
      return this.errors.write(
        module,
        method.loc,
        Code.ImplementsFieldAsMethod,
        {
          word,
          first: iface,
          second: first,
          other: this.types.typeText(wanted),
        },
      );
    }
    if (!field.readonly) {
      return this.errors.write(module, method.loc, Code.ImplementsMustField, {
        word,
        first: iface,
        second: first,
      });
    }

    this.readonlyPromiseCheck(entry, iface, field, first, module);
    this.contractMethods(entry, iface, field, first, module);
  }

  private readonlyPromiseCheck(
    entry: Read<ClassMemberEntry>,
    iface: string,
    field: ObjectField,
    second: string,
    module: int,
  ): void {
    if (field.isReadonlyMethod != true) {
      return;
    }

    const word = field.name;

    for (const method of entry.methods) {
      if (method.role?.isReadonly != true) {
        this.errors.write(module, method.loc, Code.OwnReadonlyPromise, {
          word,
          first: iface,
          second,
        });
      }
    }
  }

  private contractField(
    entry: Read<ClassMemberEntry>,
    iface: string,
    field: ObjectField,
    first: string,
    module: int,
  ): void {
    const own = entry.field;
    if (own == undefined || field.type.kind == TypeKind.Function) {
      return;
    }

    const type = this.fieldTypeOf(entry, own);
    const isPlain =
      this.types.isScalarField(type) &&
      this.types.isScalarField(field.type);
    if (type.id == field.type.id || !isPlain) {
      return;
    }

    this.errors.write(module, own.loc, Code.ImplementsFieldType, {
      word: field.name,
      first,
      second: iface,
      other: this.types.typeText(field.type),
      place: this.types.typeText(type),
    });
  }

  private contractMethod(
    entry: Read<ClassMemberEntry>,
    method: FunctionDecl,
    iface: string,
    field: ObjectField,
    first: string,
    module: int,
  ): void {
    const wanted = field.type;
    const type = this.methodTypeOf(entry, method);
    if (wanted.kind != TypeKind.Function || type.kind != TypeKind.Function) {
      return;
    }
    if (!this.types.isSameParameters(type, wanted)) {
      this.errors.write(module, method.loc, Code.ImplementsParameters, {
        word: field.name,
        first,
        second: iface,
        other: this.types.typeText(wanted),
        place: this.types.variantText(method, type),
      });

      return;
    }

    const contractResultError = this.types.contractResultError(
      method,
      type,
      wanted,
      iface,
      first,
    );

    this.errors.writeFound(module, contractResultError);
  }

  private superMethodCall(
    expr: CallExpr,
    member: MemberExpr,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const owner = this.ownerClasses[this.ownerClasses.length - 1];
    const error = this.types.store.plain(TypeKind.Error);

    if (
      owner == undefined ||
      tree.typeParamsOf(owner.decl.typeParamsList).length > 0
    ) {
      return error;
    }

    const self = this.types.classInstance(owner.module, owner.decl, []);
    if (self.kind != TypeKind.Instance) {
      return error;
    }

    const parent = this.types.parentOf(self, owner.decl);
    if (parent == undefined) {
      return error;
    }

    const lookup = this.classMember(parent, member.name);
    const method = lookup.entry?.methods[0];
    const isAbstract = method?.role?.method == MethodKind.Abstract;
    if (isAbstract && lookup.entry != undefined) {
      const first = lookup.entry.owner.name ?? "";

      this.errors.write(module, member.loc, Code.SuperAbstract, {
        word: member.name,
        first,
      });

      return error;
    }

    return this.methodCall(expr, member, parent, wanted, module);
  }
}
