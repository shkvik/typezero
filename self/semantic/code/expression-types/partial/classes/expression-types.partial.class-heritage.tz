import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  TypeContext,
  TypePlace,
} from "../../../../types/type-resolver/types/type-resolver.types.tz";
import {
  Access,
  ClassDecl,
  MethodKind,
} from "../../../../../program/ast/types/ast.types.classes.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  NameExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../../program/ast/types/ast.types.functions.tz";
import {
  Stmt,
  StmtKind,
} from "../../../../../program/ast/types/ast.types.statements.tz";
import {
  FunctionType,
  InstanceType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  CallTarget,
  ClassMemberEntry,
  SuperFrame,
  ThisPlace,
} from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private readonly superFrameOf(
    decl: ClassDecl,
    fn: FunctionDecl,
    module: int,
  ): SuperFrame {
    const roots = new Set<Expr>();
    const parent = this.parentClassName(decl, module);
    const isMaker = fn.role?.method == MethodKind.Constructor;
    const isDerived = decl.base != undefined || decl.baseExpr != undefined;
    const isConstructor = isMaker && isDerived;

    for (const statement of fn.body?.body ?? []) {
      const call = this.rootSuperOf(statement, module);
      if (call != undefined && isConstructor) {
        roots.add(call);
      }
    }

    return { isConstructor, roots, parent: parent ?? "", isBefore: true };
  }

  private readonly rootSuperOf(statement: Stmt, module: int): Expr | undefined {
    if (statement.kind != StmtKind.Expr) {
      return undefined;
    }

    const expr = statement.expr;
    if (expr.kind != ExprKind.Call) {
      return undefined;
    }
    if (!this.isSuperName(expr.callee, module)) {
      return undefined;
    }

    return expr;
  }

  private readonly parentClassName(decl: ClassDecl, module: int): string | undefined {
    if (decl.base == undefined) {
      return undefined;
    }

    const params = this.resolver.parameterTypes(module, decl.typeParams);
    const instance = this.resolver.classInstance(module, decl, params);
    if (instance.kind != TypeKind.Instance) {
      return undefined;
    }

    const parent = this.classes.parentOf(instance, decl);

    return parent?.name;
  }

  private readonly superCheck(decl: ClassDecl, fn: FunctionDecl, module: int): void {
    const frame = this.superFrames[this.superFrames.length - 1];
    if (frame == undefined || !frame.isConstructor || frame.roots.size > 0) {
      return;
    }
    if (frame.parent == "") {
      return;
    }

    const first = decl.name ?? "";
    const word = frame.parent;

    this.report(module, fn.loc, Code.MustCallSuper, { word, first });
  }

  private superCallTyped(expr: CallExpr, callee: Expr, module: int): Type {
    const frame = this.superFrames[this.superFrames.length - 1];
    const nothing = this.store.plain(TypeKind.Void);
    const place = this.thisPlaces[this.thisPlaces.length - 1];
    const isInside = frame != undefined && place != ThisPlace.Function;
    if (frame == undefined || !frame.isConstructor || !isInside) {
      this.report(module, callee.loc, Code.SuperOutside, kNoDetails);

      return nothing;
    }
    if (!frame.roots.has(expr)) {
      this.report(module, callee.loc, Code.SuperNotStatement, kNoDetails);

      return nothing;
    }
    if (!frame.isBefore && frame.parent != "") {
      this.report(module, callee.loc, Code.SuperTwice, { word: frame.parent });
    }

    frame.isBefore = false;
    this.superFieldsSet();
    this.superArgumentsCheck(expr, module);

    return nothing;
  }

  private superArgumentsCheck(expr: CallExpr, module: int): void {
    const target = this.parentConstructor(expr.loc);
    if (target == undefined) {
      for (const arg of expr.args) {
        this.listenerLoose(arg.expr, module);
      }

      return;
    }

    this.argumentsCheck(expr.args, target, module);
  }

  private readonly parentConstructor(loc: int): CallTarget | undefined {
    const owner = this.ownerClasses[this.ownerClasses.length - 1];
    if (owner == undefined) {
      return undefined;
    }

    const decl = owner.decl;
    const params = this.resolver.parameterTypes(owner.module, decl.typeParams);
    const self = this.resolver.classInstance(owner.module, decl, params);
    if (self.kind != TypeKind.Instance) {
      return undefined;
    }

    const parent = this.classes.parentOf(self, decl);
    const parentDecl = this.parentDeclOf(parent);
    if (parent == undefined || parentDecl == undefined) {
      return undefined;
    }

    const maker = this.makerOf(parent, parentDecl);
    if (maker == undefined) {
      return undefined;
    }

    const constructors = this.visibleConstructors(maker.owner);
    const chosen = constructors[0];
    if (chosen == undefined || constructors.length > 1) {
      return undefined;
    }

    return this.constructorTarget(maker, chosen, loc);
  }

  private readonly thisBeforeSuper(expr: NameExpr, module: int): void {
    const frame = this.superFrames[this.superFrames.length - 1];
    if (frame == undefined || !frame.isConstructor || !frame.isBefore) {
      return;
    }
    if (frame.parent == "") {
      return;
    }

    this.report(module, expr.loc, Code.ThisBeforeSuper, {
      word: frame.parent,
    });
  }

  private readonly returnBeforeSuper(loc: int, module: int): void {
    const frame = this.superFrames[this.superFrames.length - 1];
    if (frame == undefined || !frame.isConstructor || !frame.isBefore) {
      return;
    }

    this.report(module, loc, Code.ReturnBeforeSuper, kNoDetails);
  }

  private overrideChecks(decl: ClassDecl, module: int): void {
    if (decl.base == undefined) {
      return;
    }

    const isOpen = decl.typeParams.length > 0;
    const params = this.resolver.parameterTypes(module, decl.typeParams);
    const instance = this.resolver.classInstance(module, decl, params);
    if (instance.kind != TypeKind.Instance) {
      return;
    }

    const parent = this.classes.parentOf(instance, decl);
    if (parent == undefined || this.classOf(parent) == undefined) {
      return;
    }

    for (const method of decl.methods) {
      if (!this.classes.isStaticMethod(method)) {
        this.overrideCheck(method, decl, parent, isOpen, module);
      }
    }
  }

  private overrideCheck(
    method: FunctionDecl,
    decl: ClassDecl,
    parent: InstanceType,
    isOpen: boolean,
    module: int,
  ): void {
    const word = method.name;
    const lookup = this.classMember(parent, word);
    const entry = lookup.entry;
    const isMarked = method.role?.isOverride == true;

    if (!lookup.isKnown) {
      return;
    }
    if (entry != undefined) {
      if (this.methodOverFieldCheck(method, entry, parent, module)) {
        return;
      }
    }
    if (entry == undefined && isMarked) {
      this.report(module, method.loc, Code.OverrideMissing, {
        word,
        first: parent.name,
      });

      return;
    }
    if (isOpen) {
      return;
    }

    const theirs = entry?.methods[0];
    const isSingle = entry != undefined && entry.methods.length == 1;
    if (entry == undefined || theirs == undefined || !isSingle) {
      return;
    }

    const theirType = this.methodTypeOf(entry, theirs);
    const ownType = this.ownMethodType(decl, method, module);
    if (theirType.kind != TypeKind.Function || ownType == undefined) {
      return;
    }
    const isSame =
      this.classes.isSameParameters(ownType, theirType) ||
      this.isLibraryHookPrefix(ownType, theirType, entry.instance.module);
    if (!isSame) {
      this.streamHookCheck(method, decl, parent, module);
      if (isMarked) {
        const other = this.classes.variantText(theirs, theirType);

        this.report(module, method.loc, Code.OverrideParameters, {
          word,
          first: parent.name,
          other,
        });
      }

      return;
    }

    const overrideResultError = this.overrides.overrideResultCheck(
      method,
      decl,
      ownType,
      theirType,
      parent,
    );

    this.reportFound(module, overrideResultError);
    const overrideAccessError = this.overrides.overrideAccessCheck(
      method,
      theirs,
      parent,
    );

    this.reportFound(module, overrideAccessError);
  }

  private ownMethodType(
    decl: ClassDecl,
    method: FunctionDecl,
    module: int,
  ): FunctionType | undefined {
    const type = this.methodFunction(decl, method, module);
    if (type.kind != TypeKind.Function) {
      return undefined;
    }

    return type;
  }

  private inheritedResult(fn: FunctionDecl, module: int): Type | undefined {
    const owner = this.ownerClasses[this.ownerClasses.length - 1];
    const isMethod = fn.role != undefined && !this.classes.isStaticMethod(fn);
    if (owner == undefined || !isMethod || owner.decl.typeParams.length > 0) {
      return undefined;
    }

    const decl = owner.decl;
    const instance = this.resolver.classInstance(owner.module, decl, []);
    if (instance.kind != TypeKind.Instance) {
      return undefined;
    }
    if (decl.base == undefined) {
      return this.contractResultOf(decl, fn, owner.module);
    }

    const parent = this.classes.parentOf(instance, decl);
    if (parent == undefined) {
      return this.contractResultOf(decl, fn, owner.module);
    }

    const entry = this.parentEntry(parent, fn);
    const theirs = entry?.methods[0];
    if (entry == undefined || theirs == undefined) {
      return undefined;
    }
    if (theirs.params.length != fn.params.length) {
      return undefined;
    }

    const type = this.methodTypeOf(entry, theirs);
    if (type.kind != TypeKind.Function) {
      return undefined;
    }

    const result = type.shape.result;
    if (result.kind == TypeKind.Error) {
      return undefined;
    }

    return result;
  }

  private readonly contractResultOf(
    decl: ClassDecl,
    fn: FunctionDecl,
    module: int,
  ): Type | undefined {
    const context: TypeContext = {
      module,
      bindings: new Map<int, Type>(),
      place: TypePlace.Base,
    };

    for (const ref of decl.interfaces) {
      const type = this.resolver.resolve(ref, context);
      if (type.kind != TypeKind.Object) {
        continue;
      }

      const same = type.fields.filter((one) => one.name == fn.name);
      const field = same[0];
      if (field != undefined && same.length == 1) {
        return this.overrides.contractFieldResult(field.type);
      }
    }

    return undefined;
  }

  private readonly parentEntry(
    parent: InstanceType,
    fn: FunctionDecl,
  ): ClassMemberEntry | undefined {
    const lookup = this.classMember(parent, fn.name);
    const entry = lookup.entry;
    if (entry == undefined || entry.methods.length != 1) {
      return undefined;
    }

    return entry;
  }

  private readonly isLibraryHookPrefix(own: Type, theirs: Type, home: int): boolean {
    const isFunctions =
      own.kind == TypeKind.Function && theirs.kind == TypeKind.Function;
    if (!isFunctions || !this.modules.isTypedLibrary(home)) {
      return false;
    }
    if (own.kind != TypeKind.Function || theirs.kind != TypeKind.Function) {
      return false;
    }

    const mine = own.shape.params;
    const wider = theirs.shape.params;

    return (
      mine.length < wider.length &&
      mine.every((param, index) => param.type == wider[index]?.type)
    );
  }

  private protectedElsewhere(
    owner: ClassDecl,
    access: Access,
    expr: MemberExpr,
    module: int,
  ): boolean {
    const current = this.ownerClasses[this.ownerClasses.length - 1];
    const isOwnInside = this.isInsideClass(owner);
    if (access != Access.Protected || current == undefined || isOwnInside) {
      return false;
    }
    if (!this.isDerivedInside(owner)) {
      return false;
    }

    const object = expr.object;
    const isSelf =
      this.isThisName(object, module) || this.isSuperName(object, module);
    if (isSelf) {
      return false;
    }

    const given = this.types.definedType(this.peekType(object, module));
    if (given.kind != TypeKind.Instance) {
      return false;
    }

    const ownLoc = current.decl.loc;
    const ownModule = current.module;
    const isOwn = this.types
      .ancestorsOf(given)
      .some(
        (one) =>
          one.kind == TypeKind.Instance &&
          one.loc == ownLoc &&
          one.module == ownModule,
      );
    if (isOwn) {
      return false;
    }

    this.report(module, expr.loc, Code.ProtectedElsewhere, {
      word: expr.name,
      first: owner.name ?? "",
      second: current.decl.name ?? "",
      other: given.name,
    });

    return true;
  }
}
