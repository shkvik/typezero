import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  TypeContext,
  TypePlace,
} from "../../../../types/type-resolver/types/type-resolver.types.tz";
import {
  Access,
  ClassDecl,
  MethodKind,
} from "../../../../../program/ast/types/ast.types.classes.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  NameExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../../program/ast/types/ast.types.functions.tz";
import {
  Stmt,
  StmtKind,
} from "../../../../../program/ast/types/ast.types.statements.tz";
import {
  FunctionType,
  InstanceType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  CallTarget,
  ClassMemberEntry,
  SuperFrame,
  ThisPlace,
} from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private superFrameOf(
    decl: ClassDecl,
    fn: FunctionDecl,
    module: int,
  ): SuperFrame {
    const tree = this.types.program.tree;

    const roots = new Set<int>();
    const parent = this.parentClassName(decl, module);
    const isMaker = fn.role?.method == MethodKind.Constructor;
    const isDerived =
      tree.typeRefAt(decl.baseId) != undefined ||
      tree.exprAt(decl.baseExprId) != undefined;
    const isConstructor = isMaker && isDerived;

    for (const statement of tree.stmtsOf(tree.blockAt(fn.bodyId)?.bodyList) ??
      []) {
      const call = this.rootSuperOf(statement, module);
      if (call != undefined && isConstructor) {
        roots.add(call.id);
      }
    }

    return { isConstructor, roots, parent: parent ?? "", isBefore: true };
  }

  private readonly rootSuperOf(statement: Stmt, module: int): Expr | undefined {
    const tree = this.types.program.tree;

    if (statement.kind != StmtKind.Expr) {
      return undefined;
    }

    const expr = tree.exprOf(statement.exprId);
    if (expr.kind != ExprKind.Call) {
      return undefined;
    }
    const callee = tree.exprOf(expr.calleeId);
    if (!this.isSuperName(callee, module)) {
      return undefined;
    }

    return expr;
  }

  private parentClassName(decl: ClassDecl, module: int): string | undefined {
    const tree = this.types.program.tree;

    const base = tree.typeRefAt(decl.baseId);
    if (base == undefined) {
      return undefined;
    }

    const params = this.types.parameterTypes(
      module,
      tree.typeParamsOf(decl.typeParamsList),
    );
    const instance = this.types.classInstance(module, decl, params);
    if (instance.kind != TypeKind.Instance) {
      return undefined;
    }

    const parent = this.types.parentOf(instance, decl);

    return parent?.name;
  }

  private superCheck(decl: ClassDecl, fn: FunctionDecl, module: int): void {
    const frame = this.superFrames[this.superFrames.length - 1];
    if (frame == undefined || !frame.isConstructor || frame.roots.size > 0) {
      return;
    }
    if (frame.parent == "") {
      return;
    }

    const first = decl.name ?? "";
    const word = frame.parent;

    this.errors.write(module, fn.loc, Code.MustCallSuper, { word, first });
  }

  private superCallTyped(expr: CallExpr, callee: Expr, module: int): Type {
    const frame = this.superFrames[this.superFrames.length - 1];
    const nothing = this.types.store.plain(TypeKind.Void);
    const place = this.thisPlaces[this.thisPlaces.length - 1];
    const isInside = frame != undefined && place != ThisPlace.Function;
    if (frame == undefined || !frame.isConstructor || !isInside) {
      this.errors.write(module, callee.loc, Code.SuperOutside, kNoDetails);

      return nothing;
    }
    if (!frame.roots.has(expr.id)) {
      this.errors.write(module, callee.loc, Code.SuperNotStatement, kNoDetails);

      return nothing;
    }
    if (!frame.isBefore && frame.parent != "") {
      this.errors.write(module, callee.loc, Code.SuperTwice, {
        word: frame.parent,
      });
    }

    frame.isBefore = false;
    this.superFieldsSet();
    this.superArgumentsCheck(expr, module);

    return nothing;
  }

  private superArgumentsCheck(expr: CallExpr, module: int): void {
    const tree = this.types.program.tree;

    const target = this.parentConstructor(expr.loc);
    if (target == undefined) {
      for (const arg of tree.argumentsOf(expr.argsList)) {
        const exprExpr = tree.exprOf(arg.exprId);

        this.listenerLoose(exprExpr, module);
      }

      return;
    }

    this.argumentsCheck(
      expr.argsList,
      tree.argumentsOf(expr.argsList),
      target,
      module,
    );
  }

  private parentConstructor(loc: int): CallTarget | undefined {
    const tree = this.types.program.tree;

    const owner = this.ownerClasses[this.ownerClasses.length - 1];
    if (owner == undefined) {
      return undefined;
    }

    const decl = owner.decl;
    const params = this.types.parameterTypes(
      owner.module,
      tree.typeParamsOf(decl.typeParamsList),
    );
    const self = this.types.classInstance(owner.module, decl, params);
    if (self.kind != TypeKind.Instance) {
      return undefined;
    }

    const parent = this.types.parentOf(self, decl);
    const parentDecl = this.parentDeclOf(parent);
    if (parent == undefined || parentDecl == undefined) {
      return undefined;
    }

    const maker = this.makerOf(parent, parentDecl);
    if (maker == undefined) {
      return undefined;
    }

    const constructors = this.visibleConstructors(maker.owner);
    const chosen = constructors[0];
    if (chosen == undefined || constructors.length > 1) {
      return undefined;
    }

    return this.constructorTarget(maker, chosen, loc);
  }

  private thisBeforeSuper(expr: NameExpr, module: int): void {
    const frame = this.superFrames[this.superFrames.length - 1];
    if (frame == undefined || !frame.isConstructor || !frame.isBefore) {
      return;
    }
    if (frame.parent == "") {
      return;
    }

    this.errors.write(module, expr.loc, Code.ThisBeforeSuper, {
      word: frame.parent,
    });
  }

  private returnBeforeSuper(loc: int, module: int): void {
    const frame = this.superFrames[this.superFrames.length - 1];
    if (frame == undefined || !frame.isConstructor || !frame.isBefore) {
      return;
    }

    this.errors.write(module, loc, Code.ReturnBeforeSuper, kNoDetails);
  }

  private overrideChecks(decl: ClassDecl, module: int): void {
    const tree = this.types.program.tree;

    const base = tree.typeRefAt(decl.baseId);
    if (base == undefined) {
      return;
    }

    const isOpen = tree.typeParamsOf(decl.typeParamsList).length > 0;
    const params = this.types.parameterTypes(
      module,
      tree.typeParamsOf(decl.typeParamsList),
    );
    const instance = this.types.classInstance(module, decl, params);
    if (instance.kind != TypeKind.Instance) {
      return;
    }

    const parent = this.types.parentOf(instance, decl);
    if (parent == undefined || this.classOf(parent) == undefined) {
      return;
    }

    for (const method of tree.functionsOf(decl.methodsList)) {
      if (!this.types.isStaticMethod(method)) {
        this.overrideCheck(method, decl, parent, isOpen, module);
      }
    }
  }

  private overrideCheck(
    method: FunctionDecl,
    decl: ClassDecl,
    parent: InstanceType,
    isOpen: boolean,
    module: int,
  ): void {
    const word = method.name;
    const lookup = this.classMember(parent, word);
    const entry = lookup.entry;
    const isMarked = method.role?.isOverride == true;

    if (!lookup.isKnown) {
      return;
    }
    if (entry != undefined) {
      if (this.methodOverFieldCheck(method, entry, parent, module)) {
        return;
      }
    }
    if (entry == undefined && isMarked) {
      this.errors.write(module, method.loc, Code.OverrideMissing, {
        word,
        first: parent.name,
      });

      return;
    }

    const overridden = entry?.methods[0];
    if (overridden != undefined) {
      this.overrideReadonlyCheck(method, overridden, parent, module);
    }
    if (isOpen) {
      return;
    }

    const theirs = entry?.methods[0];
    const isSingle = entry != undefined && entry.methods.length == 1;
    if (entry == undefined || theirs == undefined || !isSingle) {
      return;
    }

    const theirType = this.methodTypeOf(entry, theirs);
    const ownType = this.ownMethodType(decl, method, module);
    if (theirType.kind != TypeKind.Function || ownType == undefined) {
      return;
    }
    const isSame =
      this.types.isSameParameters(ownType, theirType) ||
      this.isLibraryHookPrefix(ownType, theirType, entry.instance.module);
    if (!isSame) {
      this.streamHookCheck(method, decl, parent, module);
      if (isMarked) {
        const other = this.types.variantText(theirs, theirType);

        this.errors.write(module, method.loc, Code.OverrideParameters, {
          word,
          first: parent.name,
          other,
        });
      }

      return;
    }

    const overrideResultError = this.types.overrideResultCheck(
      method,
      decl,
      ownType,
      theirType,
      parent,
    );

    this.errors.writeFound(module, overrideResultError);
    const overrideAccessError = this.types.overrideAccessCheck(
      method,
      theirs,
      parent,
    );

    this.errors.writeFound(module, overrideAccessError);
  }

  private overrideReadonlyCheck(
    method: FunctionDecl,
    theirs: FunctionDecl,
    parent: InstanceType,
    module: int,
  ): void {
    const isTheirsReadonly = theirs.role?.isReadonly == true;
    if (!isTheirsReadonly || method.role?.isReadonly == true) {
      return;
    }

    this.errors.write(module, method.loc, Code.OwnOverrideReadonly, {
      word: method.name,
      first: parent.name,
    });
  }

  private ownMethodType(
    decl: ClassDecl,
    method: FunctionDecl,
    module: int,
  ): FunctionType | undefined {
    const type = this.methodFunction(decl, method, module);
    if (type.kind != TypeKind.Function) {
      return undefined;
    }

    return type;
  }

  private inheritedResult(fn: FunctionDecl, module: int): Type | undefined {
    const tree = this.types.program.tree;

    const owner = this.ownerClasses[this.ownerClasses.length - 1];
    const isMethod = fn.role != undefined && !this.types.isStaticMethod(fn);
    if (
      owner == undefined ||
      !isMethod ||
      tree.typeParamsOf(owner.decl.typeParamsList).length > 0
    ) {
      return undefined;
    }

    const decl = owner.decl;
    const instance = this.types.classInstance(owner.module, decl, []);
    if (instance.kind != TypeKind.Instance) {
      return undefined;
    }
    const base = tree.typeRefAt(decl.baseId);
    if (base == undefined) {
      return this.contractResultOf(decl, fn, owner.module);
    }

    const parent = this.types.parentOf(instance, decl);
    if (parent == undefined) {
      return this.contractResultOf(decl, fn, owner.module);
    }

    const entry = this.parentEntry(parent, fn);
    const theirs = entry?.methods[0];
    if (entry == undefined || theirs == undefined) {
      return undefined;
    }
    if (
      tree.paramsOf(theirs.paramsList).length !=
      tree.paramsOf(fn.paramsList).length
    ) {
      return undefined;
    }

    const type = this.methodTypeOf(entry, theirs);
    if (type.kind != TypeKind.Function) {
      return undefined;
    }

    const result = this.types.store.returnTypeOf(type);
    if (result.kind == TypeKind.Error) {
      return undefined;
    }

    return result;
  }

  private contractResultOf(
    decl: ClassDecl,
    fn: FunctionDecl,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const context: TypeContext = {
      module,
      bindings: new Map<int, Type>(),
      place: TypePlace.Base,
    };

    for (const ref of tree.typeRefsOf(decl.interfacesList)) {
      const type = this.types.resolve(ref, context);
      if (type.kind != TypeKind.Object) {
        continue;
      }

      const same = this.types.store
        .fieldsOf(type)
        .filter((one) => one.name == fn.name);
      const field = same[0];
      if (field != undefined && same.length == 1) {
        return this.types.contractFieldResult(field.type);
      }
    }

    return undefined;
  }

  private readonly parentEntry(
    parent: InstanceType,
    fn: FunctionDecl,
  ): ClassMemberEntry | undefined {
    const lookup = this.classMember(parent, fn.name);
    if (lookup.entry == undefined || lookup.entry.methods.length != 1) {
      return undefined;
    }

    return lookup.entry;
  }

  private readonly isLibraryHookPrefix(
    own: Type,
    theirs: Type,
    home: int,
  ): boolean {
    const isFunctions =
      own.kind == TypeKind.Function && theirs.kind == TypeKind.Function;
    if (!isFunctions || !this.types.isTypedLibrary(home)) {
      return false;
    }
    if (own.kind != TypeKind.Function || theirs.kind != TypeKind.Function) {
      return false;
    }

    const mine = this.types.store.paramsOf(own);
    const wider = this.types.store.paramsOf(theirs);

    return (
      mine.length < wider.length &&
      mine.every((param, index) => param.type.id == wider[index]?.type.id)
    );
  }

  private protectedElsewhere(
    owner: ClassDecl,
    access: Access,
    expr: MemberExpr,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const current = this.ownerClasses[this.ownerClasses.length - 1];
    const isOwnInside = this.isInsideClass(owner);
    if (access != Access.Protected || current == undefined || isOwnInside) {
      return false;
    }
    if (!this.isDerivedInside(owner)) {
      return false;
    }

    const object = tree.exprOf(expr.objectId);
    const isSelf =
      this.isThisName(object, module) || this.isSuperName(object, module);
    if (isSelf) {
      return false;
    }

    const given = this.types.definedType(this.peekType(object, module));
    if (given.kind != TypeKind.Instance) {
      return false;
    }

    const ownLoc = current.decl.loc;
    const ownModule = current.module;
    const isOwn = this.types
      .ancestorsOf(given)
      .some(
        (one) =>
          one.kind == TypeKind.Instance &&
          one.loc == ownLoc &&
          one.module == ownModule,
      );
    if (isOwn) {
      return false;
    }

    this.errors.write(module, expr.loc, Code.ProtectedElsewhere, {
      word: expr.name,
      first: owner.name ?? "",
      second: current.decl.name ?? "",
      other: given.name,
    });

    return true;
  }
}
