import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  ClassDecl,
  ClassField,
  FieldKind,
  FieldPresence,
} from "../../../../../program/ast/types/ast.types.classes.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  NameExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../../program/ast/types/ast.types.functions.tz";
import { TypeRef } from "../../../../../program/ast/types/ast.types.types.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  TypeContext,
  TypePlace,
} from "../../../../types/type-resolver/types/type-resolver.types.tz";
import {
  kClassNameMember,
  kPrototypeName,
  kThisName,
} from "../../const/expression-types.const.tz";
import {
  CallKind,
  StaticField,
  StaticOwner,
} from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private walkClass(decl: ClassDecl, module: int): void {
    const tree = this.types.program.tree;

    this.redeclareChecks(decl, module);
    this.decoratorChecks(decl, module);
    this.extendsCycleCheck(decl, module);
    this.inPlaceChecks(decl, module);
    this.checkFields(decl, module);
    this.parentMethodChecks(decl, module);
    this.fieldStartChecks(decl, module);

    for (const fn of tree.functionsOf(decl.constructorsList)) {
      this.methodFunction(decl, fn, module);
    }

    for (const fn of tree.functionsOf(decl.methodsList)) {
      const body = tree.blockAt(fn.bodyId);
      if (body != undefined) {
        this.methodFunction(decl, fn, module);
      }
    }

    this.genericClassRules(decl, module);
    this.variantRules(decl, module);
    this.overrideChecks(decl, module);
    this.contractChecks(decl, module);
    this.overriddenCallChecks(decl, module);
  }

  private methodFunction(decl: ClassDecl, fn: FunctionDecl, module: int): Type {
    const part = this.partOf(decl, fn);
    const home = this.partModule(part, module);
    const self = this.selfOf(decl, fn, module);

    const place = this.types.methodPlace(fn);
    const frame = this.superFrameOf(decl, fn, home);
    const init = this.types.initFrameOf(decl, fn);

    this.selves.push(self);
    this.ownerClasses.push({ decl, module });
    this.thisPlaces.push(place);
    this.currentMethods.push(fn);
    this.superFrames.push(frame);
    this.initFrames.push(init);

    const type = this.functionType(fn, home);

    this.superCheck(decl, fn, home);
    this.initFrames.pop();
    this.superFrames.pop();
    this.currentMethods.pop();
    this.thisPlaces.pop();
    this.ownerClasses.pop();
    this.selves.pop();

    return type;
  }

  private selfOf(decl: ClassDecl, fn: FunctionDecl, module: int): Type {
    const tree = this.types.program.tree;

    if (this.types.isStaticMethod(fn)) {
      return this.types.store.plain(TypeKind.Error);
    }

    const part = this.partOf(decl, fn);
    const home = this.partModule(part, module);
    const params = this.types.parameterTypes(
      home,
      tree.typeParamsOf(part.typeParamsList),
    );

    return this.types.classInstance(module, decl, params);
  }

  private thisTyped(expr: NameExpr, module: int): Type {
    const self = this.selves[this.selves.length - 1];

    if (this.thisInFunction(expr, module)) {
      return this.types.store.plain(TypeKind.Error);
    }

    this.thisBeforeSuper(expr, module);
    this.thisReadyCheck(expr, module);

    if (self != undefined) {
      return self;
    }

    this.errors.write(module, expr.loc, Code.ThisOutsideMethod, kNoDetails);

    return this.types.store.plain(TypeKind.Error);
  }

  private readonly isThisName(expr: Expr, module: int): boolean {
    if (expr.kind != ExprKind.Name || expr.name != kThisName) {
      return false;
    }

    const use = this.record(module)?.uses.get(expr.loc);

    return use?.symbol == undefined;
  }

  private readonly isInsideClass(owner: ClassDecl): boolean {
    return this.ownerClasses.some((one) => one.decl.id == owner.id);
  }

  private isDerivedInside(owner: ClassDecl): boolean {
    const tree = this.types.program.tree;

    const current = this.ownerClasses[this.ownerClasses.length - 1];
    if (
      current == undefined ||
      tree.typeParamsOf(current.decl.typeParamsList).length > 0
    ) {
      return false;
    }

    const self = this.types.classInstance(current.module, current.decl, []);
    const chain = this.types.ancestorsOf(self);

    return chain.some(
      (one) => one.kind == TypeKind.Instance && one.loc == owner.loc,
    );
  }

  public staticFieldOf(
    expr: MemberExpr,
    module: int,
  ): StaticField | undefined {
    const tree = this.types.program.tree;

    const object = tree.exprOf(expr.objectId);
    const owner = this.classOfName(object, module);
    if (owner == undefined) {
      return undefined;
    }

    const decl = owner.decl;
    const name = expr.name;
    const field = tree
      .fieldsOf(decl.fieldsList)
      .find((one) => one.name == name && one.form == FieldKind.Static);
    if (field == undefined) {
      return undefined;
    }

    const className = decl.name ?? "";
    const word = `${className}.${name}`;
    const type = this.staticTypeOf(field, owner);

    return { module: owner.module, loc: field.loc, word, type };
  }

  public readonly classOfName(
    expr: Expr,
    module: int,
  ): StaticOwner | undefined {
    if (expr.kind != ExprKind.Name) {
      return undefined;
    }

    const target = this.targetOfName(expr, module);
    if (target == undefined || target.kind != SymbolKind.Class) {
      return undefined;
    }
    if (this.isDeclaredLibrary(target.module, target.loc)) {
      return undefined;
    }

    const decl = this.record(target.module)?.classes.get(target.loc);
    if (decl == undefined) {
      return undefined;
    }

    return { decl, module: target.module };
  }

  public staticFieldsOf(module: int, decl: ClassDecl): StaticField[] {
    const tree = this.types.program.tree;

    const owner: StaticOwner = { decl, module };
    const className = decl.name ?? "";
    const fields: StaticField[] = [];

    for (const field of tree.fieldsOf(decl.fieldsList)) {
      if (field.form != FieldKind.Static) {
        continue;
      }

      const word = `${className}.${field.name}`;
      const type = this.staticTypeOf(field, owner);

      fields.push({ module, loc: field.loc, word, type });
    }

    return fields;
  }

  private staticTypeOf(field: ClassField, owner: StaticOwner): Type {
    const tree = this.types.program.tree;

    const written = tree.typeRefAt(field.typeId);
    const init = tree.exprAt(field.initId);
    if (written != undefined || init == undefined) {
      return this.staticFieldType(written, field.presence, owner);
    }
    if (field.readonly && this.types.isFieldLiteral(init)) {
      return this.peekType(init, owner.module);
    }
    if (init.kind == ExprKind.Template) {
      return this.types.store.plain(TypeKind.String);
    }

    const shown = this.literalShapeOf(init);
    if (shown != undefined) {
      return shown;
    }

    return this.staticFieldType(written, field.presence, owner);
  }

  private staticOwner(object: Expr, module: int): StaticOwner | undefined {
    if (object.kind != ExprKind.Name) {
      return undefined;
    }

    const target = this.targetOfName(object, module);
    if (target == undefined) {
      return undefined;
    }
    if (target.kind != SymbolKind.Class) {
      return this.valueOwner(target);
    }
    if (this.isDeclaredLibrary(target.module, target.loc)) {
      return undefined;
    }

    const decl = this.record(target.module)?.classes.get(target.loc);
    if (decl == undefined) {
      return undefined;
    }

    return { decl, module: target.module };
  }

  private staticMemberTyped(
    expr: MemberExpr,
    owner: StaticOwner,
    module: int,
  ): Type {
    const found = this.staticMember(expr, owner, module);
    if (found == undefined) {
      return this.types.store.plain(TypeKind.Error);
    }
    if (found.kind == TypeKind.Function) {
      return this.types.store.plain(TypeKind.Error);
    }
    if (this.staticOrderCheck(expr, owner, module)) {
      return this.types.store.plain(TypeKind.Error);
    }

    return found;
  }

  private staticOrderCheck(
    expr: MemberExpr,
    owner: StaticOwner,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const decl = owner.decl;
    const index = tree.fieldsOf(decl.fieldsList).findIndex(
      (field) => field.form == FieldKind.Static && field.name == expr.name,
    );
    if (index < 0) {
      return false;
    }

    const className = decl.name ?? "";
    const word = `${className}.${expr.name}`;
    const isTopLevel = this.openFunctions.length == 0;
    const isEarly =
      isTopLevel &&
      !decl.expression &&
      owner.module == module &&
      !this.walkedClasses.has(decl.id);
    if (isEarly) {
      this.errors.write(module, expr.loc, Code.StaticUsedEarly, {
        word,
        other: className,
      });

      return true;
    }

    const current = this.staticFields[this.staticFields.length - 1];
    const position = tree
      .fieldsOf(decl.fieldsList)
      .findIndex((field) => field.loc == current?.loc);
    if (current == undefined || position < 0 || index < position) {
      return false;
    }

    this.errors.write(module, expr.loc, Code.StaticReadBeforeSet, { word });

    return true;
  }

  private staticCall(
    expr: CallExpr,
    member: MemberExpr,
    owner: StaticOwner,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const found = this.staticMember(member, owner, module);
    if (found == undefined) {
      const args = tree.argumentsOf(expr.argsList);

      this.looseArguments(args, module);

      return this.types.store.plain(TypeKind.Error);
    }

    return this.fieldValueCall(expr, member, found, CallKind.Own, module);
  }

  private staticMember(
    expr: MemberExpr,
    owner: StaticOwner,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const decl = owner.decl;
    const name = expr.name;
    if (name == kPrototypeName) {
      this.errors.write(module, expr.loc, Code.NoPrototype, kNoDetails);

      return undefined;
    }

    const field = tree.fieldsOf(decl.fieldsList).find(
      (one) => one.name == name && one.form == FieldKind.Static,
    );
    const methods = this.types
      .classMethodsNamed(decl, name)
      .filter((one) => this.types.isStaticMethod(one));
    const isMissing = field == undefined && methods.length == 0;
    if (isMissing && name == kClassNameMember) {
      return this.types.store.plain(TypeKind.String);
    }
    if (isMissing && this.types.hasInstanceMember(decl, name)) {
      const word = name;
      const first = decl.name ?? "";

      this.errors.write(module, expr.loc, Code.InstanceMemberViaClass, {
        word,
        first,
      });

      return undefined;
    }
    if (
      isMissing &&
      tree.typeRefAt(decl.baseId) == undefined &&
      tree.exprAt(decl.baseExprId) == undefined
    ) {
      const word = name;
      const first = decl.name ?? "";

      this.errors.write(module, expr.loc, Code.StaticMissing, { word, first });

      return undefined;
    }
    if (field != undefined) {
      this.reportAccess(decl, field.access, name, expr.loc, module);

      return this.staticTypeOf(field, owner);
    }

    const method = methods[0];
    if (method == undefined || methods.length > 1) {
      return this.types.store.plain(TypeKind.Error);
    }

    const access = this.types.classAccessOf(method);

    this.reportAccess(decl, access, name, expr.loc, module);

    const typeParams = tree.typeParamsOf(method.typeParamsList);
    if (typeParams.length > 0) {
      return this.types.store.plain(TypeKind.Error);
    }

    return this.methodFunction(decl, method, owner.module);
  }

  private staticFieldType(
    written: TypeRef | undefined,
    presence: FieldPresence,
    owner: StaticOwner,
  ): Type {
    if (written == undefined) {
      return this.types.store.plain(TypeKind.Error);
    }

    const context: TypeContext = {
      module: owner.module,
      bindings: new Map<int, Type>(),
      place: TypePlace.Plain,
    };
    const type = this.types.resolve(written, context);

    if (presence == FieldPresence.Optional) {
      return this.types.optional(type);
    }

    return type;
  }
}
