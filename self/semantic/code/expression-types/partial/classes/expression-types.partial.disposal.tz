import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import { ClassDecl } from "../../../../../program/ast/types/ast.types.classes.tz";
import {
  CallExpr,
  ExprKind,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Stmt,
  VarDeclStmt,
} from "../../../../../program/ast/types/ast.types.statements.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { kSuperName } from "../../../dispose-rules/const/dispose-rules.const.tz";

partial class ExpressionTypes {
  private disposeCheck(decl: ClassDecl, module: int): void {
    const dispose = this.types.ownDispose(decl);
    if (dispose == undefined || this.types.isLibraryModule(module)) {
      return;
    }

    const type = this.functionDoors.get(`${module} ${dispose.loc}`)?.type;
    const result = this.resultOfFunction(type);
    const isGivingValue =
      result != undefined &&
      result.kind != TypeKind.Void &&
      result.kind != TypeKind.Error;
    const inherited = this.inheritedDispose(decl, module);
    const disposeErrors = this.types.disposeErrors(
      dispose,
      isGivingValue,
      inherited,
    );

    this.errors.writeAll(module, disposeErrors);
  }

  private readonly resultOfFunction(type: Type | undefined): Type | undefined {
    if (type == undefined || type.kind != TypeKind.Function) {
      return undefined;
    }

    return this.types.store.returnTypeOf(type);
  }

  private inheritedDispose(decl: ClassDecl, module: int): string | undefined {
    const tree = this.types.program.tree;

    const typeParams = tree.typeParamsOf(decl.typeParamsList);
    if (typeParams.length > 0) {
      return undefined;
    }

    const instance = this.types.classInstance(module, decl, []);
    let base = this.types.baseClassOf(instance);

    while (base != undefined && base.kind == TypeKind.Instance) {
      const owner = this.record(base.module)?.classes.get(base.loc);
      if (owner == undefined) {
        return undefined;
      }
      if (this.types.ownDispose(owner) != undefined) {
        return owner.name;
      }

      base = this.types.baseClassOf(base);
    }

    return undefined;
  }

  private usingCheck(
    statement: VarDeclStmt,
    following: Read<Stmt[]>,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const first = tree.declaratorsOf(statement.declsList)[0];
    if (first == undefined || this.types.isLibraryModule(module)) {
      return;
    }

    const type = this.door(module, first.loc)?.type;
    const isKnown = type != undefined && type.kind != TypeKind.Error;
    if (isKnown && type != undefined && !this.isDisposable(type)) {
      this.errors.write(module, statement.loc, Code.UsingNotDisposable, {
        word: this.types.typeText(type),
      });
    }

    const outlivesErrors = this.types.outlivesErrors(statement, following);

    this.errors.writeAll(module, outlivesErrors);
  }

  private isDisposable(type: Type): boolean {
    let current: Type | undefined = this.types.definedType(type);

    while (current != undefined && current.kind == TypeKind.Instance) {
      if (this.types.isLibraryModule(current.module)) {
        return false;
      }

      const owner = this.record(current.module)?.classes.get(current.loc);
      if (owner == undefined) {
        return false;
      }
      if (this.types.ownDispose(owner) != undefined) {
        return true;
      }

      current = this.types.baseClassOf(current);
    }

    return false;
  }

  private disposeCallCheck(expr: CallExpr, module: int): void {
    const tree = this.types.program.tree;

    const callee = tree.exprOf(expr.calleeId);
    if (callee.kind != ExprKind.Index || this.types.isLibraryModule(module)) {
      return;
    }
    if (!this.types.isDisposeCall(expr)) {
      return;
    }

    const fn = this.openFunctions[this.openFunctions.length - 1];
    const object = tree.exprOf(callee.objectId);
    const isSuper = object.kind == ExprKind.Name && object.name == kSuperName;
    if (isSuper && this.types.isDisposeMethod(fn)) {
      return;
    }

    this.errors.write(module, callee.loc, Code.DisposeManual, kNoDetails);
  }
}
