import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  Access,
  ClassDecl,
  ClassField,
  FieldKind,
} from "../../../../../program/ast/types/ast.types.classes.tz";
import { MemberExpr } from "../../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../../program/ast/types/ast.types.functions.tz";
import {
  InstanceType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  ClassMemberEntry,
  OverriddenSite,
} from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private redeclareChecks(decl: ClassDecl, module: int): void {
    const hasParent = decl.base != undefined || decl.baseExpr != undefined;
    const self = this.declaredInstance(decl, module);
    if (self == undefined) {
      return;
    }

    const parent = this.parentOf(self, decl);

    for (const field of decl.fields) {
      if (field.form == FieldKind.Static) {
        continue;
      }
      if (parent == undefined) {
        this.lonelyOverrideCheck(decl, field, hasParent, module);

        continue;
      }

      this.redeclareCheck(decl, self, field, parent, module);
    }
  }

  private declaredInstance(
    decl: ClassDecl,
    module: int,
  ): InstanceType | undefined {
    const params = this.resolver.parameterTypes(module, decl.typeParams);
    const instance = this.resolver.classInstance(module, decl, params);
    if (instance.kind != TypeKind.Instance) {
      return undefined;
    }

    return instance;
  }

  private lonelyOverrideCheck(
    decl: ClassDecl,
    field: ClassField,
    hasParent: boolean,
    module: int,
  ): void {
    if (!field.isOverride || hasParent) {
      return;
    }

    const word = field.name;
    const first = decl.name ?? "";

    this.report(module, field.loc, Code.FieldOverrideNoParent, {
      word,
      first,
    });
  }

  private redeclareCheck(
    decl: ClassDecl,
    self: InstanceType,
    field: ClassField,
    parent: InstanceType,
    module: int,
  ): void {
    const word = field.name;
    const lookup = this.classMember(parent, word);
    const entry = lookup.entry;

    if (!lookup.isKnown) {
      return;
    }

    const inherited = entry?.field;
    if (inherited != undefined && this.isArrowField(inherited)) {
      return;
    }
    if (entry == undefined || inherited == undefined) {
      return this.newFieldCheck(field, parent, module);
    }

    const owner = entry.owner.name ?? "";

    if (inherited.access == Access.Private) {
      this.report(module, field.loc, Code.FieldPrivateInParent, {
        word,
        first: owner,
      });

      return;
    }

    this.fieldAccessCheck(decl, field, inherited, owner, module);
    this.redeclaredValueCheck(decl, field, owner, module);

    const own: ClassMemberEntry = {
      owner: decl,
      instance: self,
      field,
      methods: [],
      isStatic: false,
    };

    this.fieldLayoutCheck(decl, own, entry, module);
  }

  private newFieldCheck(
    field: ClassField,
    parent: InstanceType,
    module: int,
  ): void {
    if (!field.isOverride) {
      return;
    }

    const word = field.name;
    const first = parent.name;

    this.report(module, field.loc, Code.FieldOverrideMissing, { word, first });
  }

  private parentMethodChecks(decl: ClassDecl, module: int): void {
    const self = this.declaredInstance(decl, module);
    if (self == undefined) {
      return;
    }

    const parent = this.parentOf(self, decl);
    if (parent == undefined) {
      return;
    }

    for (const field of decl.fields) {
      if (field.form != FieldKind.Static) {
        this.parentMethodCheck(field, parent, module);
      }
    }
  }

  private parentMethodCheck(
    field: ClassField,
    parent: InstanceType,
    module: int,
  ): void {
    const word = field.name;
    const entry = this.classMember(parent, word).entry;
    if (entry == undefined || entry.isStatic || entry.methods.length == 0) {
      return;
    }
    if (entry.field != undefined) {
      return;
    }

    const first = parent.name;

    this.report(module, field.loc, Code.ParentMethodField, { word, first });
  }

  private fieldAccessCheck(
    decl: ClassDecl,
    field: ClassField,
    inherited: ClassField,
    owner: string,
    module: int,
  ): void {
    const ownRank = this.accessRank(field.access);
    const theirRank = this.accessRank(inherited.access);
    if (ownRank <= theirRank) {
      return;
    }

    this.report(module, field.loc, Code.FieldAccessNarrower, {
      word: field.name,
      other: this.accessWord(inherited.access),
      first: owner,
      second: this.accessWord(field.access),
      place: decl.name ?? "",
    });
  }

  private redeclaredValueCheck(
    decl: ClassDecl,
    field: ClassField,
    owner: string,
    module: int,
  ): void {
    const isGiven =
      field.init != undefined || field.form == FieldKind.Parameter;
    if (isGiven || decl.constructors.length > 0) {
      return;
    }

    this.report(module, field.loc, Code.FieldRedeclaredNoValue, {
      word: field.name,
      first: owner,
    });
  }

  private fieldLayoutCheck(
    decl: ClassDecl,
    own: ClassMemberEntry,
    theirs: ClassMemberEntry,
    module: int,
  ): void {
    const field = own.field;
    const inherited = theirs.field;
    if (field == undefined || inherited == undefined) {
      return;
    }

    const ownType = this.fieldTypeOf(own, field);
    const theirType = this.fieldTypeOf(theirs, inherited);
    const isOpen =
      ownType.kind == TypeKind.Error || theirType.kind == TypeKind.Error;
    if (isOpen || this.isSameLayout(ownType, theirType)) {
      return;
    }

    this.report(module, field.loc, Code.FieldLayout, {
      word: field.name,
      first: decl.name ?? "",
      second: this.text.of(ownType),
      other: theirs.owner.name ?? "",
      place: this.text.of(theirType),
    });
  }

  private isSameLayout(own: Type, theirs: Type): boolean {
    if (own == theirs) {
      return true;
    }
    if (own.kind == TypeKind.Array && theirs.kind == TypeKind.Array) {
      return this.isSameLayout(own.item, theirs.item);
    }
    if (own.kind != TypeKind.Instance || theirs.kind != TypeKind.Instance) {
      return false;
    }

    return this.ancestorsOf(own).includes(theirs);
  }

  private methodOverFieldCheck(
    method: FunctionDecl,
    entry: ClassMemberEntry,
    parent: InstanceType,
    module: int,
  ): boolean {
    const field = entry.field;
    if (field == undefined || entry.isStatic) {
      return false;
    }

    const word = method.name;
    const first = entry.owner.name ?? parent.name;

    if (this.isArrowField(field)) {
      this.report(module, method.loc, Code.ArrowOverride, { word, first });

      return true;
    }

    this.report(module, method.loc, Code.MethodOverField, { word, first });

    return true;
  }

  private extendsCycleCheck(decl: ClassDecl, module: int): void {
    const base = decl.base;
    const self = this.declaredInstance(decl, module);
    if (base == undefined || self == undefined) {
      return;
    }

    const cycle = this.cycleThrough(self, decl);
    const earliest = this.earliestOf(cycle);
    if (earliest == undefined) {
      return;
    }

    const before = this.previousInCycle(cycle, earliest);
    if (before != self) {
      return;
    }
    if (earliest == self) {
      this.report(module, base.loc, Code.ExtendsItself, {
        first: self.name,
      });

      return;
    }

    this.report(module, base.loc, Code.ExtendsItselfThrough, {
      first: self.name,
      word: earliest.name,
    });
  }

  private previousInCycle(
    cycle: InstanceType[],
    member: InstanceType,
  ): InstanceType | undefined {
    const at = cycle.indexOf(member);
    if (at == 0) {
      return cycle[cycle.length - 1];
    }

    return cycle[at - 1];
  }

  private cycleThrough(self: InstanceType, decl: ClassDecl): InstanceType[] {
    const chain: InstanceType[] = [self];
    let current = this.parentOf(self, decl);

    while (current != undefined) {
      const step = current;
      if (this.isSameClass(step, self)) {
        return chain;
      }

      const known = chain.some((one) => this.isSameClass(one, step));
      const stepDecl = this.classOf(step);
      if (known || stepDecl == undefined) {
        return [];
      }

      chain.push(step);
      current = this.parentOf(step, stepDecl);
    }

    return [];
  }

  private earliestOf(cycle: InstanceType[]): InstanceType | undefined {
    let earliest: InstanceType | undefined = undefined;

    for (const one of cycle) {
      if (earliest == undefined || this.isDeclaredBefore(one, earliest)) {
        earliest = one;
      }
    }

    return earliest;
  }

  private isDeclaredBefore(one: InstanceType, other: InstanceType): boolean {
    if (one.module != other.module) {
      return one.module < other.module;
    }

    return one.loc < other.loc;
  }

  private noteSelfCall(member: MemberExpr, module: int): void {
    const fn = this.openFunctions[this.openFunctions.length - 1];
    if (fn == undefined || fn.role == undefined || fn.isArrow) {
      return;
    }
    if (!this.isThisName(member.object, module)) {
      return;
    }

    const calls = this.selfCalls.get(fn) ?? [];

    if (!calls.includes(member)) {
      calls.push(member);
    }

    this.selfCalls.set(fn, calls);
  }

  private overriddenCallChecks(decl: ClassDecl, module: int): void {
    const self = this.declaredInstance(decl, module);
    if (self == undefined || decl.typeParams.length > 0) {
      return;
    }

    const children = this.childClassesOf(self);
    if (children.length == 0) {
      return;
    }

    for (const fn of decl.constructors) {
      for (const site of this.selfCalls.get(fn) ?? []) {
        const visited = new Set<FunctionDecl>([fn]);
        const found: OverriddenSite = { self, children, visited, module };

        this.overriddenCall(found, site, site, decl);
      }
    }
  }

  private overriddenCall(
    found: OverriddenSite,
    site: MemberExpr,
    call: MemberExpr,
    decl: ClassDecl,
  ): boolean {
    const word = call.name;
    const overrider = this.overridingChild(found.children, word);
    if (overrider != undefined) {
      const first = decl.name ?? "";
      const other = overrider.name ?? "";
      const code = this.overriddenCode(site, call);

      this.report(found.module, site.loc, code, { first, word, other });

      return true;
    }

    const method = this.classMember(found.self, word).entry?.methods[0];
    if (method == undefined || found.visited.has(method)) {
      return false;
    }

    found.visited.add(method);

    for (const inner of this.selfCalls.get(method) ?? []) {
      if (this.overriddenCall(found, site, inner, decl)) {
        return true;
      }
    }

    return false;
  }

  private overriddenCode(site: MemberExpr, call: MemberExpr): Code {
    if (site == call) {
      return Code.ConstructorCallsOverride;
    }

    return Code.ConstructorReachesOverride;
  }

  private overridingChild(
    children: ClassDecl[],
    name: string,
  ): ClassDecl | undefined {
    return children.find((child) =>
      child.methods.some(
        (method) => method.name == name && !this.isStaticMethod(method),
      ),
    );
  }

  private childClassesOf(self: InstanceType): ClassDecl[] {
    const children: ClassDecl[] = [];

    for (const [module, record] of this.records) {
      for (const decl of record.classes.values()) {
        if (this.isChildClass(decl, module, self)) {
          children.push(decl);
        }
      }
    }

    return children;
  }

  private isChildClass(
    decl: ClassDecl,
    module: int,
    ancestor: InstanceType,
  ): boolean {
    if (decl.base == undefined || decl.typeParams.length > 0) {
      return false;
    }

    const own = this.declaredInstance(decl, module);
    if (own == undefined || this.isSameClass(own, ancestor)) {
      return false;
    }

    const chain = this.cycleFreeParents(own, decl);

    return chain.some((one) => this.isSameClass(one, ancestor));
  }

  private cycleFreeParents(
    self: InstanceType,
    decl: ClassDecl,
  ): InstanceType[] {
    const chain: InstanceType[] = [];
    let current = this.parentOf(self, decl);

    while (current != undefined) {
      const step = current;
      const known = chain.some((one) => this.isSameClass(one, step));
      const stepDecl = this.classOf(step);
      if (known || stepDecl == undefined) {
        return chain;
      }

      chain.push(step);
      current = this.parentOf(step, stepDecl);
    }

    return chain;
  }
}
