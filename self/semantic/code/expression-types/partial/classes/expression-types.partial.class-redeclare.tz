import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  Access,
  ClassDecl,
  ClassField,
  FieldKind,
} from "../../../../../program/ast/types/ast.types.classes.tz";
import { MemberExpr } from "../../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../../program/ast/types/ast.types.functions.tz";
import {
  InstanceType,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  ClassMemberEntry,
  ModuleClass,
  OverriddenSite,
} from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private redeclareChecks(decl: ClassDecl, module: int): void {
    const tree = this.types.program.tree;

    const hasParent =
      tree.typeRefAt(decl.baseId) != undefined ||
      tree.exprAt(decl.baseExprId) != undefined;
    const self = this.declaredInstance(decl, module);
    if (self == undefined) {
      return;
    }

    const parent = this.types.parentOf(self, decl);

    for (const field of tree.fieldsOf(decl.fieldsList)) {
      if (field.form == FieldKind.Static) {
        continue;
      }
      if (parent == undefined) {
        const lonelyOverrideError = this.types.lonelyOverrideCheck(
          decl,
          field,
          hasParent,
        );

        this.errors.writeFound(module, lonelyOverrideError);

        continue;
      }

      this.redeclareCheck(decl, self, field, parent, module);
    }
  }

  private declaredInstance(
    decl: ClassDecl,
    module: int,
  ): InstanceType | undefined {
    const tree = this.types.program.tree;

    const params = this.types.parameterTypes(
      module,
      tree.typeParamsOf(decl.typeParamsList),
    );
    const instance = this.types.classInstance(module, decl, params);
    if (instance.kind != TypeKind.Instance) {
      return undefined;
    }

    return instance;
  }

  private redeclareCheck(
    decl: ClassDecl,
    self: InstanceType,
    field: ClassField,
    parent: InstanceType,
    module: int,
  ): void {
    const word = field.name;
    const lookup = this.classMember(parent, word);
    const entry = lookup.entry;

    if (!lookup.isKnown) {
      return;
    }

    const inherited = entry?.field;
    if (inherited != undefined && this.types.isArrowField(inherited)) {
      return;
    }
    if (entry == undefined || inherited == undefined) {
      const newFieldError = this.types.newFieldCheck(field, parent);

      return this.errors.writeFound(module, newFieldError);
    }

    const owner = entry.owner.name ?? "";

    if (inherited.access == Access.Private) {
      this.errors.write(module, field.loc, Code.FieldPrivateInParent, {
        word,
        first: owner,
      });

      return;
    }

    const fieldAccessError = this.types.fieldAccessCheck(
      decl,
      field,
      inherited,
      owner,
    );

    this.errors.writeFound(module, fieldAccessError);
    const redeclaredValueError = this.types.redeclaredValueCheck(
      decl,
      field,
      owner,
    );

    this.errors.writeFound(module, redeclaredValueError);

    const own: ClassMemberEntry = {
      owner: decl,
      instance: self,
      field,
      methods: [],
      isStatic: false,
    };

    this.fieldLayoutCheck(decl, own, entry, module);
  }

  private parentMethodChecks(decl: ClassDecl, module: int): void {
    const tree = this.types.program.tree;

    const self = this.declaredInstance(decl, module);
    if (self == undefined) {
      return;
    }

    const parent = this.types.parentOf(self, decl);
    if (parent == undefined) {
      return;
    }

    for (const field of tree.fieldsOf(decl.fieldsList)) {
      if (field.form != FieldKind.Static) {
        this.parentMethodCheck(field, parent, module);
      }
    }
  }

  private parentMethodCheck(
    field: ClassField,
    parent: InstanceType,
    module: int,
  ): void {
    const word = field.name;
    const entryLookup = this.classMember(parent, word);
    const entry = entryLookup.entry;
    if (entry == undefined || entry.isStatic || entry.methods.length == 0) {
      return;
    }
    if (entry.field != undefined) {
      return;
    }

    const first = parent.name;

    this.errors.write(module, field.loc, Code.ParentMethodField, {
      word,
      first,
    });
  }

  private fieldLayoutCheck(
    decl: ClassDecl,
    own: Read<ClassMemberEntry>,
    theirs: Read<ClassMemberEntry>,
    module: int,
  ): void {
    const field = own.field;
    const inherited = theirs.field;
    if (field == undefined || inherited == undefined) {
      return;
    }

    const ownType = this.fieldTypeOf(own, field);
    const theirType = this.fieldTypeOf(theirs, inherited);
    const isOpen =
      ownType.kind == TypeKind.Error || theirType.kind == TypeKind.Error;
    if (isOpen || this.types.isClassSameLayout(ownType, theirType)) {
      return;
    }

    this.errors.write(module, field.loc, Code.FieldLayout, {
      word: field.name,
      first: decl.name ?? "",
      second: this.types.typeText(ownType),
      other: theirs.owner.name ?? "",
      place: this.types.typeText(theirType),
    });
  }

  private methodOverFieldCheck(
    method: FunctionDecl,
    entry: Read<ClassMemberEntry>,
    parent: InstanceType,
    module: int,
  ): boolean {
    const checked = this.types.methodOverFieldCheck(method, entry, parent);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private extendsCycleCheck(decl: ClassDecl, module: int): void {
    const tree = this.types.program.tree;

    const base = tree.typeRefAt(decl.baseId);
    const self = this.declaredInstance(decl, module);
    if (base == undefined || self == undefined) {
      return;
    }

    const cycle = this.cycleThrough(self, decl);
    const earliest = this.types.earliestOf(cycle);
    if (earliest == undefined) {
      return;
    }

    const before = this.types.previousInCycle(cycle, earliest);
    if (before == undefined || before.id != self.id) {
      return;
    }
    if (earliest.id == self.id) {
      this.errors.write(module, base.loc, Code.ExtendsItself, {
        first: self.name,
      });

      return;
    }

    this.errors.write(module, base.loc, Code.ExtendsItselfThrough, {
      first: self.name,
      word: earliest.name,
    });
  }

  private readonly cycleThrough(
    self: InstanceType,
    decl: ClassDecl,
  ): InstanceType[] {
    const chain: InstanceType[] = [self];
    let current = this.types.parentOf(self, decl);

    while (current != undefined) {
      const step = current;
      if (this.types.isSameClass(step, self)) {
        return chain;
      }

      const known = chain.some((one) => this.types.isSameClass(one, step));
      const stepDecl = this.classOf(step);
      if (known || stepDecl == undefined) {
        return [];
      }

      chain.push(step);
      current = this.types.parentOf(step, stepDecl);
    }

    return [];
  }

  private noteSelfCall(member: MemberExpr, module: int): void {
    const tree = this.types.program.tree;

    const fn = this.openFunctions[this.openFunctions.length - 1];
    if (fn == undefined || fn.role == undefined || fn.isArrow) {
      return;
    }
    const object = tree.exprOf(member.objectId);
    if (!this.isThisName(object, module)) {
      return;
    }

    const isKnown = this.selfCalls.get(fn.id)?.includes(member) ?? false;
    if (isKnown) {
      return;
    }
    if (!this.selfCalls.has(fn.id)) {
      this.selfCalls.set(fn.id, []);
    }

    this.selfCalls.get(fn.id)?.push(member);
  }

  private overriddenCallChecks(decl: ClassDecl, module: int): void {
    const tree = this.types.program.tree;

    const self = this.declaredInstance(decl, module);
    if (
      self == undefined ||
      tree.typeParamsOf(decl.typeParamsList).length > 0
    ) {
      return;
    }

    const children = this.childClassesOf(self);
    if (children.length == 0) {
      return;
    }

    for (const fn of tree.functionsOf(decl.constructorsList)) {
      const count = this.selfCalls.get(fn.id)?.length ?? 0;

      for (let at = 0; at < count; at++) {
        const site = this.selfCallAt(fn, at);
        if (site == undefined) {
          continue;
        }

        const visited = new Set<int>([fn.id]);
        const found: OverriddenSite = {
          self,
          children: children.slice(),
          visited,
          module,
        };

        this.overriddenCall(found, site, site, decl);
      }
    }
  }

  private readonly selfCallAt(
    fn: FunctionDecl,
    at: int,
  ): MemberExpr | undefined {
    const calls = this.selfCalls.get(fn.id) ?? [];

    return calls[at];
  }

  private overriddenCall(
    found: OverriddenSite,
    site: MemberExpr,
    call: MemberExpr,
    decl: ClassDecl,
  ): boolean {
    const word = call.name;
    const overrider = this.types.overridingChild(found.children, word);
    if (overrider != undefined) {
      const first = decl.name ?? "";
      const other = overrider.name ?? "";
      const code = this.types.overriddenCode(site, call);

      this.errors.write(found.module, site.loc, code, { first, word, other });

      return true;
    }

    const lookup = this.classMember(found.self, word);
    const method = lookup.entry?.methods[0];
    if (method == undefined || found.visited.has(method.id)) {
      return false;
    }

    found.visited.add(method.id);

    const count = this.selfCalls.get(method.id)?.length ?? 0;

    for (let at = 0; at < count; at++) {
      const inner = this.selfCallAt(method, at);
      if (inner != undefined && this.overriddenCall(found, site, inner, decl)) {
        return true;
      }
    }

    return false;
  }

  private childClassesOf(self: InstanceType): ClassDecl[] {
    const classes: ModuleClass[] = [];
    const children: ClassDecl[] = [];

    for (const [module, record] of this.records) {
      for (const decl of record.classes.values()) {
        classes.push({ module, decl });
      }
    }

    for (const one of classes) {
      if (this.isChildClass(one.decl, one.module, self)) {
        children.push(one.decl);
      }
    }

    return children;
  }

  private isChildClass(
    decl: ClassDecl,
    module: int,
    ancestor: InstanceType,
  ): boolean {
    const tree = this.types.program.tree;

    if (
      tree.typeRefAt(decl.baseId) == undefined ||
      tree.typeParamsOf(decl.typeParamsList).length > 0
    ) {
      return false;
    }

    const own = this.declaredInstance(decl, module);
    if (own == undefined || this.types.isSameClass(own, ancestor)) {
      return false;
    }

    const chain = this.cycleFreeParents(own, decl);

    return chain.some((one) => this.types.isSameClass(one, ancestor));
  }

  private readonly cycleFreeParents(
    self: InstanceType,
    decl: ClassDecl,
  ): InstanceType[] {
    const chain: InstanceType[] = [];
    let current = this.types.parentOf(self, decl);

    while (current != undefined) {
      const step = current;
      const known = chain.some((one) => this.types.isSameClass(one, step));
      const stepDecl = this.classOf(step);
      if (known || stepDecl == undefined) {
        return chain;
      }

      chain.push(step);
      current = this.types.parentOf(step, stepDecl);
    }

    return chain;
  }
}
