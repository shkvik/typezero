import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  ClassDecl,
  ClassField,
  FieldKind,
  FieldPresence,
} from "../../../../../program/ast/types/ast.types.classes.tz";
import {
  Expr,
  ExprKind,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { kNoPlace } from "../../const/expression-types.const.tz";
import { StaticOwner, ThisPlace } from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private checkFields(decl: ClassDecl, module: int): void {
    for (let index = 0; index < decl.fields.length; index++) {
      const memberNameErrors = this.overrides.memberNameErrors(decl, index);

      this.reportAll(module, memberNameErrors);
    }

    for (const field of decl.fields) {
      this.checkField(decl, field, module);
    }
  }

  private checkField(decl: ClassDecl, field: ClassField, module: int): void {
    const word = field.name;

    if (field.presence == FieldPresence.Definite) {
      this.report(module, field.loc, Code.SetLater, { word });
    }

    this.checkFieldValue(decl, field, module);

    const isParameter = field.form == FieldKind.Parameter;
    if (!isParameter && field.type == undefined && field.init == undefined) {
      this.report(module, field.loc, Code.FieldNeedsType, { word });

      return;
    }

    const init = field.init;
    const isStatic = field.form == FieldKind.Static;
    const isShown = init == undefined || this.shapes.isFieldLiteral(init);
    if (isStatic && field.type == undefined && !isShown) {
      this.report(module, field.loc, Code.StaticNeedsType, { word });

      return;
    }
    if (isStatic) {
      this.staticValue(decl, field, module);
    }
  }

  private checkFieldValue(
    decl: ClassDecl,
    field: ClassField,
    module: int,
  ): void {
    const init = field.init;
    const word = field.name;
    const isFunction = init != undefined && init.kind == ExprKind.Function;
    const isValued =
      field.form != FieldKind.Static && init != undefined && !isFunction;
    if (!isValued || init == undefined) {
      return;
    }
    if (decl.constructors.length > 0) {
      this.report(module, field.loc, Code.FieldValueWithConstructor, {
        word,
      });

      return;
    }
    if (field.type == undefined || !this.shapes.isFieldLiteral(init)) {
      this.report(module, field.loc, Code.FieldValueNotLiteral, { word });

      return;
    }

    const owner: StaticOwner = { decl, module };
    const type = this.staticFieldType(field.type, field.presence, owner);

    this.checked(init, type, module, kNoPlace);
  }

  private staticValue(decl: ClassDecl, field: ClassField, module: int): void {
    const owner: StaticOwner = { decl, module };
    const init = field.init;
    const word = field.name;
    const type = this.staticFieldType(field.type, field.presence, owner);
    const params = this.parts.genericParameters(type) ?? [];
    if (params.length > 0) {
      const first = decl.name ?? "";

      this.report(module, field.loc, Code.StaticTypeParameters, {
        word,
        first,
      });

      return;
    }
    if (init == undefined) {
      const isOptional = field.presence == FieldPresence.Optional;
      if (!isOptional && type.kind != TypeKind.Error) {
        const first = this.text.of(type);

        this.report(module, field.loc, Code.StaticNeedsValue, {
          word,
          first,
        });
      }

      return;
    }

    const unknown = this.store.plain(TypeKind.Error);

    this.ownerClasses.push(owner);
    this.selves.push(unknown);
    this.thisPlaces.push(ThisPlace.StaticField);
    this.staticInit(init, field, type, module);
    this.thisPlaces.pop();
    this.selves.pop();
    this.ownerClasses.pop();
  }

  private staticInit(
    init: Expr,
    field: ClassField,
    type: Type,
    module: int,
  ): void {
    if (field.type == undefined || type.kind == TypeKind.Error) {
      this.typed(init, undefined, module);

      return;
    }

    const place = ` of static field '${field.name}'`;

    this.checked(init, type, module, place);
  }
}
