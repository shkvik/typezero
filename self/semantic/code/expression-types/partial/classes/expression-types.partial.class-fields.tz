import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  ClassDecl,
  ClassField,
  FieldKind,
  FieldPresence,
} from "../../../../../program/ast/types/ast.types.classes.tz";
import {
  Expr,
  ExprKind,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { kNoPlace } from "../../const/expression-types.const.tz";
import { StaticOwner, ThisPlace } from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private checkFields(decl: ClassDecl, module: int): void {
    const tree = this.types.program.tree;

    for (
      let index = 0;
      index < tree.fieldsOf(decl.fieldsList).length;
      index++
    ) {
      const memberNameErrors = this.types.memberNameErrors(decl, index);

      this.errors.writeAll(module, memberNameErrors);
    }

    for (const field of tree.fieldsOf(decl.fieldsList)) {
      this.checkField(decl, field, module);
    }
  }

  private checkField(decl: ClassDecl, field: ClassField, module: int): void {
    const tree = this.types.program.tree;

    const word = field.name;

    if (field.presence == FieldPresence.Definite) {
      this.errors.write(module, field.loc, Code.SetLater, { word });
    }

    this.checkFieldValue(decl, field, module);

    const isParameter = field.form == FieldKind.Parameter;
    if (isParameter && tree.typeRefAt(field.typeId) == undefined) {
      this.errors.write(module, field.loc, Code.ParamFieldNeedsType, { word });

      return;
    }
    if (
      !isParameter &&
      tree.typeRefAt(field.typeId) == undefined &&
      tree.exprAt(field.initId) == undefined
    ) {
      this.errors.write(module, field.loc, Code.FieldNeedsType, { word });

      return;
    }

    const init = tree.exprAt(field.initId);
    const isStatic = field.form == FieldKind.Static;
    const isShown = init == undefined || this.types.isFieldLiteral(init);
    if (isStatic && tree.typeRefAt(field.typeId) == undefined && !isShown) {
      this.errors.write(module, field.loc, Code.StaticNeedsType, { word });

      return;
    }
    if (isStatic) {
      this.staticValue(decl, field, module);
    }
  }

  private checkFieldValue(
    decl: ClassDecl,
    field: ClassField,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const init = tree.exprAt(field.initId);
    const word = field.name;
    const isFunction = init != undefined && init.kind == ExprKind.Function;
    const isValued =
      field.form != FieldKind.Static && init != undefined && !isFunction;
    if (!isValued || init == undefined) {
      return;
    }
    const constructors = tree.countOf(decl.constructorsList);
    if (constructors > 0) {
      this.errors.write(module, field.loc, Code.FieldValueWithConstructor, {
        word,
      });

      return;
    }
    if (
      tree.typeRefAt(field.typeId) == undefined ||
      !this.types.isFieldLiteral(init)
    ) {
      this.errors.write(module, field.loc, Code.FieldValueNotLiteral, { word });

      return;
    }

    const owner: StaticOwner = { decl, module };
    const type = this.staticFieldType(
      tree.typeRefAt(field.typeId),
      field.presence,
      owner,
    );

    this.checked(init, type, module, kNoPlace);
  }

  private staticValue(decl: ClassDecl, field: ClassField, module: int): void {
    const tree = this.types.program.tree;

    const owner: StaticOwner = { decl, module };
    const init = tree.exprAt(field.initId);
    const word = field.name;
    const type = this.staticFieldType(
      tree.typeRefAt(field.typeId),
      field.presence,
      owner,
    );
    const params = this.types.genericParameters(type) ?? [];
    if (params.length > 0) {
      const first = decl.name ?? "";

      this.errors.write(module, field.loc, Code.StaticTypeParameters, {
        word,
        first,
      });

      return;
    }
    if (init == undefined) {
      const isOptional = field.presence == FieldPresence.Optional;
      if (!isOptional && type.kind != TypeKind.Error) {
        const first = this.types.typeText(type);

        this.errors.write(module, field.loc, Code.StaticNeedsValue, {
          word,
          first,
        });
      }

      return;
    }

    const unknown = this.types.store.plain(TypeKind.Error);

    this.ownerClasses.push(owner);
    this.selves.push(unknown);
    this.thisPlaces.push(ThisPlace.StaticField);
    this.staticFields.push(field);
    this.staticInit(init, field, type, module);
    this.staticFields.pop();
    this.thisPlaces.pop();
    this.selves.pop();
    this.ownerClasses.pop();
  }

  private staticInit(
    init: Expr,
    field: ClassField,
    type: Type,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    if (
      tree.typeRefAt(field.typeId) == undefined ||
      type.kind == TypeKind.Error
    ) {
      this.typed(init, undefined, module);

      return;
    }

    const place = ` of static field '${field.name}'`;

    this.checked(init, type, module, place);
  }
}
