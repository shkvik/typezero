import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { SourceError } from "../../../../../diagnostic/types/message.types.tz";
import {
  ClassDecl,
  ClassField,
  FieldKind,
  FieldPresence,
} from "../../../../../program/ast/types/ast.types.classes.tz";
import {
  Expr,
  ExprKind,
  MemberExpr,
  NameExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../../program/ast/types/ast.types.functions.tz";
import {
  BlockStmt,
  ReturnStmt,
  StmtKind,
  SwitchCase,
  SwitchStmt,
} from "../../../../../program/ast/types/ast.types.statements.tz";
import { TypeRef } from "../../../../../program/ast/types/ast.types.types.tz";
import {
  InstanceType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { kFieldSetKey } from "../../const/expression-types.const.tz";
import { InitFrame } from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private readonly constructorFrame(): Read<InitFrame> | undefined {
    const frame = this.initFrames[this.initFrames.length - 1];
    if (frame == undefined || !frame.isConstructor) {
      return undefined;
    }

    const parent = this.superFrames[this.superFrames.length - 1];
    if (parent != undefined && parent.isConstructor && parent.isBefore) {
      return undefined;
    }

    return frame;
  }

  private readonly isInInit(frame: Read<InitFrame>): boolean {
    return this.openFunctions[this.openFunctions.length - 1]?.id == frame.fn.id;
  }

  private readonly isInsideInitClosure(frame: Read<InitFrame>): boolean {
    const id = frame.fn.id;
    const ids = this.openFunctions.map((one) => one.id);
    const start = ids.lastIndexOf(id);
    const last = this.openFunctions.length - 1;
    if (start < 0 || start == last) {
      return false;
    }

    const inner = this.openFunctions.slice(start + 1);

    return inner.every((fn) => fn.isArrow);
  }

  private readonly firstUnset(frame: Read<InitFrame>): string | undefined {
    const tree = this.types.program.tree;

    for (const field of tree.fieldsOf(frame.decl.fieldsList)) {
      const key = `${kFieldSetKey}${field.name}`;
      if (this.types.isRequiredField(field) && !this.facts.has(key)) {
        return field.name;
      }
    }

    return undefined;
  }

  private markFieldSet(name: string): void {
    const key = `${kFieldSetKey}${name}`;
    const mark = this.types.store.plain(TypeKind.Void);

    this.facts = this.types.withFact(this.facts, key, mark);
  }

  private initStart(fn: FunctionDecl): void {
    const tree = this.types.program.tree;

    const frame = this.initFrames[this.initFrames.length - 1];
    if (frame == undefined || !frame.isConstructor || frame.fn.id != fn.id) {
      return;
    }

    const decl = frame.decl;
    const isDerived = frame.isDerived;

    for (const field of tree.fieldsOf(decl.fieldsList)) {
      const isOptional = field.presence == FieldPresence.Optional;
      const isValued =
        !isDerived &&
        field.form == FieldKind.Instance &&
        tree.exprAt(field.initId) != undefined;
      const isParameter = !isDerived && field.form == FieldKind.Parameter;
      if (isOptional || isValued || isParameter) {
        this.markFieldSet(field.name);
      }
    }
  }

  private initEnd(fn: FunctionDecl, body: BlockStmt, module: int): void {
    const frame = this.constructorFrame();
    if (frame == undefined || frame.fn.id != fn.id) {
      return;
    }
    if (this.isAlwaysReturning(body, module)) {
      return;
    }

    const problem = this.unsetPathProblem(frame, fn.loc);

    this.errors.writeFound(module, problem);
  }

  private returnFieldsCheck(
    statement: ReturnStmt,
    fn: FunctionDecl | undefined,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const frame = this.constructorFrame();
    if (
      frame == undefined ||
      frame.fn.id != fn?.id ||
      tree.exprAt(statement.valueId) != undefined
    ) {
      return;
    }

    const problem = this.unsetPathProblem(frame, statement.loc);

    this.errors.writeFound(module, problem);
  }

  private readonly unsetPathProblem(
    frame: Read<InitFrame>,
    loc: int,
  ): SourceError | undefined {
    const word = this.firstUnset(frame);
    if (word == undefined) {
      return undefined;
    }

    const first = frame.decl.name ?? "";

    return { code: Code.FieldsNotSet, loc, details: { word, first } };
  }

  private fieldSetMark(target: Expr, module: int): void {
    if (target.kind != ExprKind.Member) {
      return;
    }
    if (this.initThisMember(target, module) == undefined) {
      return;
    }

    this.markFieldSet(target.name);
  }

  private superFieldsSet(): void {
    const tree = this.types.program.tree;

    const frame = this.initFrames[this.initFrames.length - 1];
    if (frame == undefined || !frame.isConstructor) {
      return;
    }

    const decl = frame.decl;

    for (const field of tree.fieldsOf(decl.fieldsList)) {
      const isValued =
        field.form == FieldKind.Instance &&
        tree.exprAt(field.initId) != undefined;
      if (isValued || field.form == FieldKind.Parameter) {
        this.markFieldSet(field.name);
      }
    }
  }

  private readonly initThisMember(
    expr: MemberExpr,
    module: int,
  ): Read<InitFrame> | undefined {
    const tree = this.types.program.tree;

    const frame = this.constructorFrame();
    if (frame == undefined || !this.isInInit(frame)) {
      return undefined;
    }
    const object = tree.exprOf(expr.objectId);
    if (!this.isThisName(object, module)) {
      return undefined;
    }

    return frame;
  }

  private fieldReadEarly(target: Expr, module: int): boolean {
    if (target.kind != ExprKind.Member) {
      return false;
    }

    const frame = this.initThisMember(target, module);
    if (frame == undefined) {
      return false;
    }

    const field = this.types.ownValueField(frame, target.name);
    const key = `${kFieldSetKey}${target.name}`;
    if (field == undefined || this.facts.has(key)) {
      return false;
    }
    if (!this.types.isRequiredField(field)) {
      return false;
    }

    const word = target.name;

    this.errors.write(module, target.loc, Code.FieldReadEarly, { word });

    return true;
  }

  private memberReadEarly(expr: MemberExpr, module: int): boolean {
    if (this.writtenTargets.has(expr.id)) {
      return false;
    }
    if (this.fieldReadEarly(expr, module)) {
      return true;
    }

    this.methodEarly(expr, Code.MethodTakenEarly, module);

    return false;
  }

  private callReadEarly(member: MemberExpr, module: int): boolean {
    if (this.fieldReadEarly(member, module)) {
      return true;
    }

    this.methodEarly(member, Code.MethodCalledEarly, module);

    return false;
  }

  private methodEarly(member: MemberExpr, code: Code, module: int): void {
    const frame = this.initThisMember(member, module);
    if (frame == undefined) {
      return;
    }
    if (this.types.ownValueField(frame, member.name) != undefined) {
      return;
    }
    if (!this.isInitMethod(frame, member.name)) {
      return;
    }

    const first = this.firstUnset(frame);
    if (first == undefined) {
      return;
    }

    const word = member.name;

    this.errors.write(module, member.loc, code, { word, first });
  }

  private readonly isInitMethod(frame: Read<InitFrame>, name: string): boolean {
    const tree = this.types.program.tree;

    const self = this.selves[this.selves.length - 1];
    if (self == undefined || self.kind != TypeKind.Instance) {
      return this.types
        .classMethodsNamed(frame.decl, name)
        .some((method) => !this.types.isStaticMethod(method));
    }

    const entryLookup = this.classMember(self, name);

    const entry = entryLookup.entry;
    if (entry == undefined || entry.isStatic) {
      return false;
    }

    const field = entry.field;
    if (field != undefined && this.types.isArrowField(field)) {
      return true;
    }

    return entry.methods.length > 0;
  }

  private thisReadyCheck(expr: NameExpr, module: int): void {
    const problem = this.thisReadyProblem(expr);

    this.errors.writeFound(module, problem);
  }

  private readonly thisReadyProblem(expr: NameExpr): SourceError | undefined {
    const frame = this.constructorFrame();
    if (frame == undefined) {
      return undefined;
    }
    if (this.isInsideInitClosure(frame)) {
      return this.types.closureThisCheck(frame, expr);
    }
    if (!this.isInInit(frame) || this.thisObjects.has(expr.id)) {
      return undefined;
    }

    const word = this.firstUnset(frame);
    if (word == undefined) {
      return undefined;
    }

    return { code: Code.ThisUsedEarly, loc: expr.loc, details: { word } };
  }

  private markThisObject(object: Expr, module: int): void {
    if (this.isThisName(object, module)) {
      this.thisObjects.add(object.id);
    }
  }

  private readonly isInitClosure(): boolean {
    const frame = this.initFrames[this.initFrames.length - 1];

    return frame != undefined && frame.isConstructor && this.isInInit(frame);
  }

  private enterInitClosure(isInit: boolean): void {
    const top = this.initFrames[this.initFrames.length - 1];
    if (!isInit || top == undefined) {
      return;
    }

    const parent = this.superFrames[this.superFrames.length - 1];
    const isBefore =
      parent != undefined && parent.isConstructor && parent.isBefore;
    const isSet = this.firstUnset(top) == undefined;
    const frame = this.initFrames[this.initFrames.length - 1];

    frame?.closures.push(isSet && !isBefore);
  }

  private leaveInitClosure(isInit: boolean): void {
    const frame = this.initFrames[this.initFrames.length - 1];
    if (isInit && frame != undefined) {
      frame.closures.pop();
    }
  }

  private readonly isSwitchExit(
    option: SwitchCase,
    isLast: boolean,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const last = tree.stmtsOf(option.bodyList)[
      tree.stmtsOf(option.bodyList).length - 1
    ];
    if (last == undefined) {
      return false;
    }

    const isReturning = tree.stmtsOf(option.bodyList).some((statement) =>
      this.isAlwaysReturning(statement, module),
    );
    if (isReturning) {
      return false;
    }
    if (last.kind == StmtKind.Break) {
      return last.label == "";
    }

    return isLast;
  }

  private switchFieldsJoined(
    statement: SwitchStmt,
    exits: Read<Map<string, Type>[]>,
  ): void {
    const tree = this.types.program.tree;

    const hasDefault = tree
      .casesOf(statement.casesList)
      .some((one) => tree.exprAt(one.testId) == undefined);
    const first = exits[0];
    if (!hasDefault || first == undefined) {
      return;
    }

    for (const key of first.keys()) {
      const isEverywhere = exits.every((facts) => facts.has(key));
      if (key.startsWith(kFieldSetKey) && isEverywhere) {
        this.markFieldSet(key.slice(kFieldSetKey.length));
      }
    }
  }

  private fieldStartChecks(decl: ClassDecl, module: int): void {
    const tree = this.types.program.tree;

    const constructors = tree.countOf(decl.constructorsList);
    if (constructors > 0) {
      return;
    }

    const params = this.types.parameterTypes(
      module,
      tree.typeParamsOf(decl.typeParamsList),
    );
    const instance = this.types.classInstance(module, decl, params);
    if (instance.kind != TypeKind.Instance) {
      return;
    }

    const isMade = this.hasMakerChain(instance);

    for (const field of tree.fieldsOf(decl.fieldsList)) {
      this.fieldStartCheck(instance, decl, field, isMade, module);
    }
  }

  private fieldStartCheck(
    instance: InstanceType,
    decl: ClassDecl,
    field: ClassField,
    isMade: boolean,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const written = tree.typeRefAt(field.typeId);
    const isRequired =
      field.form == FieldKind.Instance &&
      field.presence == FieldPresence.Required;
    if (
      !isRequired ||
      tree.exprAt(field.initId) != undefined ||
      written == undefined
    ) {
      return;
    }

    const type = this.declaredFieldType(instance, decl, written);
    if (type.kind == TypeKind.Error) {
      return;
    }

    const word = field.name;
    const first = this.types.typeText(type);

    if (isMade) {
      this.errors.write(module, field.loc, Code.FieldNeverSet, { word, first });

      return;
    }

    const visiting = new Set<int>([decl.id]);
    if (this.hasEmptyValue(type, written, visiting)) {
      return;
    }

    this.errors.write(module, field.loc, Code.FieldNoStart, { word, first });
  }

  private declaredFieldType(
    instance: InstanceType,
    decl: ClassDecl,
    written: TypeRef,
  ): Type {
    const tree = this.types.program.tree;

    const context = this.types.classContext(
      instance,
      tree.typeParamsOf(decl.typeParamsList),
      instance.module,
    );

    return this.types.resolve(written, context);
  }

  private readonly hasMakerChain(instance: InstanceType): boolean {
    const tree = this.types.program.tree;

    const seen = new Set<int>();
    let current: InstanceType | undefined = instance;

    while (
      current != undefined &&
      !this.types.isLibraryModule(current.module)
    ) {
      const decl = this.classOf(current);
      if (decl == undefined || seen.has(decl.id)) {
        return false;
      }
      const constructors = tree.countOf(decl.constructorsList);
      if (constructors > 0) {
        return true;
      }

      seen.add(decl.id);
      current = this.types.parentOf(current, decl);
    }

    return false;
  }

  private hasEmptyValue(
    type: Type,
    written: TypeRef | undefined,
    visiting: Set<int>,
  ): boolean {
    switch (type.kind) {
      case TypeKind.String:
      case TypeKind.Template:
      case TypeKind.Int:
      case TypeKind.Decimal:
      case TypeKind.Double:
      case TypeKind.Boolean:
      case TypeKind.Literal:
      case TypeKind.Array:
        return true;
      case TypeKind.Dict:
        return this.types.hasEmptyCollection(type.dict, written);
      case TypeKind.Union:
        return this.types.store
          .partsOf(type)
          .every((part) => part.kind == TypeKind.Literal);
      case TypeKind.Instance:
        return this.hasEmptyInstance(type, visiting);
      case TypeKind.Object:
        return this.types.store.fieldsOf(type).every(
          (field) =>
            field.optional ||
            this.hasEmptyValue(field.type, undefined, visiting),
        );
      default:
        return false;
    }
  }

  private hasEmptyInstance(
    instance: InstanceType,
    visiting: Set<int>,
  ): boolean {
    const tree = this.types.program.tree;

    if (this.isDeclaredLibrary(instance.module, instance.loc)) {
      return false;
    }

    const decl = this.classOf(instance);
    if (decl == undefined || decl.name == undefined || decl.isAbstract) {
      return false;
    }
    if (
      tree.typeParamsOf(decl.typeParamsList).length > 0 ||
      this.hasMakerChain(instance)
    ) {
      return false;
    }
    if (visiting.has(decl.id)) {
      return false;
    }

    visiting.add(decl.id);

    const isEmpty = this.hasEmptyFamily(instance, visiting);

    visiting.delete(decl.id);

    return isEmpty;
  }

  private hasEmptyFamily(
    instance: InstanceType,
    visiting: Set<int>,
  ): boolean {
    const tree = this.types.program.tree;

    const decl = this.classOf(instance);
    if (decl == undefined) {
      return true;
    }

    const parent = this.types.parentOf(instance, decl);
    if (parent != undefined && !this.hasEmptyFamily(parent, visiting)) {
      return false;
    }

    for (const field of tree.fieldsOf(decl.fieldsList)) {
      const held = this.heldInstance(instance, decl, field);
      if (held != undefined && !this.hasEmptyInstance(held, visiting)) {
        return false;
      }
    }

    return true;
  }

  private heldInstance(
    instance: InstanceType,
    decl: ClassDecl,
    field: ClassField,
  ): InstanceType | undefined {
    const tree = this.types.program.tree;

    const written = tree.typeRefAt(field.typeId);
    const isDefaulted =
      field.form == FieldKind.Instance &&
      field.presence != FieldPresence.Optional &&
      tree.exprAt(field.initId) == undefined;
    if (!isDefaulted || written == undefined) {
      return undefined;
    }

    const type = this.declaredFieldType(instance, decl, written);
    if (type.kind != TypeKind.Instance) {
      return undefined;
    }

    return type;
  }
}
