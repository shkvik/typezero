import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  CallExpr,
  ClassExpr,
  Expr,
  ExprKind,
  MemberExpr,
  NameExpr,
  NewExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../../program/ast/types/ast.types.functions.tz";
import { TypeRefKind } from "../../../../../program/ast/types/ast.types.types.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import {
  ClassType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  kBusExample,
  kConstructorArgsName,
  kExampleEnd,
  kIntExample,
} from "../../const/expression-types.const.tz";
import {
  StaticOwner,
  ValueTarget,
} from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private readonly genericClassValueCheck(
    expr: NameExpr,
    target: ValueTarget,
    wanted: Type | undefined,
    module: int,
  ): boolean {
    const decl = this.record(target.module)?.classes.get(target.loc);
    if (wanted == undefined || decl == undefined) {
      return false;
    }

    const goal = this.types.definedType(wanted);
    if (decl.typeParams.length == 0 || goal.kind != TypeKind.Class) {
      return false;
    }

    const word = decl.name ?? expr.name;
    const other = this.genericClassExample(word, target.module);

    this.report(module, expr.loc, Code.GenericClassConstructor, {
      word,
      first: this.text.of(wanted),
      other,
    });

    return true;
  }

  private readonly genericClassExample(word: string, home: int): string {
    if (this.modules.isLibraryModule(home)) {
      return `${kBusExample}${word}${kExampleEnd}`;
    }

    return `${kIntExample}${word} extends ${word}<int>${kExampleEnd}`;
  }

  private readonly classValue(target: ValueTarget): Type {
    const error = this.store.plain(TypeKind.Error);
    if (this.modules.isLibraryModule(target.module)) {
      return error;
    }

    const decl = this.record(target.module)?.classes.get(target.loc);
    if (decl == undefined || decl.typeParams.length > 0) {
      return error;
    }

    const instance = this.resolver.classInstance(target.module, decl, []);
    if (instance.kind != TypeKind.Instance) {
      return error;
    }

    return this.store.classOf(instance, true);
  }

  private valueNew(expr: NewExpr, callee: Type, loc: int, module: int): Type {
    const error = this.store.plain(TypeKind.Error);

    switch (callee.kind) {
      case TypeKind.Error:
      case TypeKind.TypeParameter:
        return error;
      case TypeKind.Class:
        return this.classValueNew(expr, callee, module);
      default:
        this.report(module, loc, Code.ValueNewNotClass, {
          word: this.text.of(callee),
        });

        return error;
    }
  }

  private classValueNew(expr: NewExpr, callee: ClassType, module: int): Type {
    const instance = callee.instance;
    const isSpread = expr.args.some((arg) => arg.spread);
    if (!isSpread) {
      this.requireConstruct(instance, expr.args.length);
    }
    if (!callee.exact && !isSpread) {
      this.reflectedNewNote(expr, instance, module);
    }
    if (!callee.exact || instance.kind != TypeKind.Instance) {
      return instance;
    }

    const decl = this.classOf(instance);
    if (decl == undefined) {
      return this.store.plain(TypeKind.Error);
    }

    return this.constructed(expr, instance, decl, module);
  }

  private namedValueNew(
    expr: NewExpr,
    target: ValueTarget,
    module: int,
  ): Type | undefined {
    const isValue =
      target.kind == SymbolKind.Variable || target.kind == SymbolKind.Parameter;
    if (!isValue || this.modules.isLibraryModule(target.module)) {
      return undefined;
    }

    const type = this.targetValue(target);

    return this.valueNew(expr, type, expr.loc, module);
  }

  private targetValue(target: ValueTarget): Type {
    const fact = this.factOf(target);
    if (fact != undefined) {
      return fact;
    }
    if (target.kind == SymbolKind.Parameter) {
      return this.parameterTyped(target);
    }

    const door = this.door(target.module, target.loc);

    return door?.type ?? this.store.plain(TypeKind.Error);
  }

  private readonly classValueMember(
    expr: MemberExpr,
    object: ClassType,
    module: int,
  ): Type {
    const checked = this.classValues.classValueMember(expr, object);

    this.reportFound(module, checked.error);

    return checked.value;
  }

  private classValueCall(
    expr: CallExpr,
    member: MemberExpr,
    object: ClassType,
    module: int,
  ): Type {
    if (!object.exact) {
      this.report(module, member.loc, Code.ClassValueStatics, {
        word: this.text.of(object),
      });
    }

    this.looseArguments(expr.args, module);

    return this.store.plain(TypeKind.Error);
  }

  private valueOwner(target: ValueTarget): StaticOwner | undefined {
    const isValue =
      target.kind == SymbolKind.Variable || target.kind == SymbolKind.Parameter;
    if (!isValue) {
      return undefined;
    }

    const type = this.targetValue(target);
    if (type.kind != TypeKind.Class || !type.exact) {
      return undefined;
    }

    const instance = type.instance;
    if (instance.kind != TypeKind.Instance) {
      return undefined;
    }

    const decl = this.classOf(instance);
    if (decl == undefined) {
      return undefined;
    }

    return { decl, module: instance.module };
  }

  private readonly classNameCode(expr: Expr, code: Code, base: Type, module: int): Code {
    if (base.kind != TypeKind.Class || expr.kind != ExprKind.Name) {
      return code;
    }

    const target = this.targetOfName(expr, module);
    if (target == undefined || target.kind != SymbolKind.Class) {
      return code;
    }
    if (code == Code.ObjectCondition) {
      return Code.ClassNameCondition;
    }
    if (code == Code.ObjectNot) {
      return Code.ClassNameNot;
    }

    return code;
  }

  private valueClassOf(expr: Expr, module: int): ClassType | undefined {
    if (expr.kind != ExprKind.Name) {
      return undefined;
    }

    const target = this.targetOfName(expr, module);
    const isValue =
      target?.kind == SymbolKind.Variable ||
      target?.kind == SymbolKind.Parameter;
    if (target == undefined || !isValue) {
      return undefined;
    }

    const type = this.targetValue(target);
    if (type.kind != TypeKind.Class) {
      return undefined;
    }

    return type;
  }

  private classExprTyped(expr: ClassExpr, module: int): Type {
    const error = this.store.plain(TypeKind.Error);
    const decl = expr.decl;
    const base = decl.baseExpr;
    const parent = this.baseValue(base, module);
    if (decl.typeParams.length > 0 || parent == undefined) {
      return error;
    }

    const instance = this.resolver.classInstance(module, decl, []);
    if (instance.kind != TypeKind.Instance) {
      return error;
    }
    if (parent.kind == TypeKind.Instance) {
      const known = this.store.parentsOf(instance);
      const parents: Type[] = [parent];

      this.store.inherit(instance, parents.concat(known));
      this.store.markBase(parent);
    }

    const name = this.classExprName(expr, module);
    if (name != undefined) {
      this.store.label(instance, name);
    }

    return this.store.classOf(instance, true);
  }

  private readonly classExprName(expr: ClassExpr, module: int): string | undefined {
    if (expr.decl.name != undefined) {
      return undefined;
    }

    const variables = this.record(module)?.variables;
    if (variables == undefined) {
      return undefined;
    }

    for (const variable of variables.values()) {
      if (variable.decl.init == expr) {
        return variable.decl.name;
      }
    }

    return undefined;
  }

  private baseValue(base: Expr | undefined, module: int): Type | undefined {
    if (base == undefined) {
      return this.store.plain(TypeKind.Void);
    }

    const type = this.typed(base, undefined, module);
    const isOpen =
      type.kind == TypeKind.Error || type.kind == TypeKind.TypeParameter;
    if (isOpen) {
      return undefined;
    }

    const word = this.text.of(type);
    if (type.kind != TypeKind.Class) {
      this.report(module, base.loc, Code.ExtendsNotClassValue, { word });

      return undefined;
    }
    if (!type.exact) {
      this.report(module, base.loc, Code.ExtendsRuntimeClass, { word });

      return undefined;
    }

    return type.instance;
  }

  private readonly constructorArgsCheck(fn: FunctionDecl, module: int): void {
    const owner = this.ownerClasses[this.ownerClasses.length - 1]?.decl;
    const isDerived =
      owner != undefined &&
      (owner.base != undefined || owner.baseExpr != undefined);
    const isConstructor = owner?.constructors.includes(fn) == true;
    if (isDerived && isConstructor) {
      return;
    }

    for (const param of fn.params) {
      const ref = param.type;
      const isArgs =
        ref != undefined &&
        ref.form.kind == TypeRefKind.Name &&
        ref.name == kConstructorArgsName;
      if (isArgs && ref != undefined) {
        this.report(module, ref.loc, Code.ConstructorArgsSubclass, kNoDetails);
      }
    }
  }
}
