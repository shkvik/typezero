import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  CallExpr,
  ClassExpr,
  Expr,
  ExprKind,
  MemberExpr,
  NameExpr,
  NewExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../../program/ast/types/ast.types.functions.tz";
import { TypeRefKind } from "../../../../../program/ast/types/ast.types.types.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import {
  ClassType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  kBusExample,
  kConstructorArgsName,
  kExampleEnd,
  kIntExample,
} from "../../const/expression-types.const.tz";
import {
  StaticOwner,
  ValueTarget,
} from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private genericClassValueCheck(
    expr: NameExpr,
    target: ValueTarget,
    wanted: Type | undefined,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const decl = this.record(target.module)?.classes.get(target.loc);
    if (wanted == undefined || decl == undefined) {
      return false;
    }

    const goal = this.types.definedType(wanted);
    if (
      tree.typeParamsOf(decl.typeParamsList).length == 0 ||
      goal.kind != TypeKind.Class
    ) {
      return false;
    }

    const word = decl.name ?? expr.name;
    const other = this.genericClassExample(word, target.module);

    this.errors.write(module, expr.loc, Code.GenericClassConstructor, {
      word,
      first: this.types.typeText(wanted),
      other,
    });

    return true;
  }

  private readonly genericClassExample(word: string, home: int): string {
    if (this.types.isLibraryModule(home)) {
      return `${kBusExample}${word}${kExampleEnd}`;
    }

    return `${kIntExample}${word} extends ${word}<int>${kExampleEnd}`;
  }

  private classValue(target: ValueTarget): Type {
    const tree = this.types.program.tree;

    const error = this.types.store.plain(TypeKind.Error);
    if (this.types.isLibraryModule(target.module)) {
      return error;
    }

    const decl = this.record(target.module)?.classes.get(target.loc);
    if (
      decl == undefined ||
      tree.typeParamsOf(decl.typeParamsList).length > 0
    ) {
      return error;
    }

    const instance = this.types.classInstance(target.module, decl, []);
    if (instance.kind != TypeKind.Instance) {
      return error;
    }

    return this.types.store.classOf(instance, true);
  }

  private valueNew(expr: NewExpr, callee: Type, loc: int, module: int): Type {
    const error = this.types.store.plain(TypeKind.Error);

    switch (callee.kind) {
      case TypeKind.Error:
      case TypeKind.TypeParameter:
        return error;
      case TypeKind.Class:
        return this.classValueNew(expr, callee, module);
      default:
        this.errors.write(module, loc, Code.ValueNewNotClass, {
          word: this.types.typeText(callee),
        });

        return error;
    }
  }

  private classValueNew(expr: NewExpr, callee: ClassType, module: int): Type {
    const tree = this.types.program.tree;

    const instance = this.types.store.classInstanceOf(callee);
    const isSpread = tree.argumentsOf(expr.argsList).some((arg) => arg.spread);
    if (!isSpread) {
      const args = tree.argumentsOf(expr.argsList);

      this.requireConstruct(instance, args.length);
    }
    if (!callee.exact && !isSpread) {
      this.reflectedNewNote(expr, instance, module);
    }
    if (!callee.exact || instance.kind != TypeKind.Instance) {
      return instance;
    }

    const decl = this.classOf(instance);
    if (decl == undefined) {
      return this.types.store.plain(TypeKind.Error);
    }

    return this.constructed(expr, instance, decl, module);
  }

  private namedValueNew(
    expr: NewExpr,
    target: ValueTarget,
    module: int,
  ): Type | undefined {
    const isValue =
      target.kind == SymbolKind.Variable || target.kind == SymbolKind.Parameter;
    if (!isValue || this.types.isLibraryModule(target.module)) {
      return undefined;
    }

    const type = this.targetValue(target);

    return this.valueNew(expr, type, expr.loc, module);
  }

  private targetValue(target: ValueTarget): Type {
    const fact = this.factOf(target);
    if (fact != undefined) {
      return fact;
    }
    if (target.kind == SymbolKind.Parameter) {
      return this.parameterTyped(target);
    }

    const door = this.door(target.module, target.loc);

    return door?.type ?? this.types.store.plain(TypeKind.Error);
  }

  private classValueMember(
    expr: MemberExpr,
    object: ClassType,
    module: int,
  ): Type {
    const checked = this.types.classValueMember(expr, object);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private classValueCall(
    expr: CallExpr,
    member: MemberExpr,
    object: ClassType,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    if (!object.exact) {
      this.errors.write(module, member.loc, Code.ClassValueStatics, {
        word: this.types.typeText(object),
      });
    }

    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args, module);

    return this.types.store.plain(TypeKind.Error);
  }

  private valueOwner(target: ValueTarget): StaticOwner | undefined {
    const isValue =
      target.kind == SymbolKind.Variable || target.kind == SymbolKind.Parameter;
    if (!isValue) {
      return undefined;
    }

    const type = this.targetValue(target);
    if (type.kind != TypeKind.Class || !type.exact) {
      return undefined;
    }

    const instance = this.types.store.classInstanceOf(type);
    if (instance.kind != TypeKind.Instance) {
      return undefined;
    }

    const decl = this.classOf(instance);
    if (decl == undefined) {
      return undefined;
    }

    return { decl, module: instance.module };
  }

  private readonly classNameCode(
    expr: Expr,
    code: Code,
    base: Type,
    module: int,
  ): Code {
    if (base.kind != TypeKind.Class || expr.kind != ExprKind.Name) {
      return code;
    }

    const target = this.targetOfName(expr, module);
    if (target == undefined || target.kind != SymbolKind.Class) {
      return code;
    }
    if (code == Code.ObjectCondition) {
      return Code.ClassNameCondition;
    }
    if (code == Code.ObjectNot) {
      return Code.ClassNameNot;
    }

    return code;
  }

  private valueClassOf(expr: Expr, module: int): ClassType | undefined {
    if (expr.kind != ExprKind.Name) {
      return undefined;
    }

    const target = this.targetOfName(expr, module);
    const isValue =
      target?.kind == SymbolKind.Variable ||
      target?.kind == SymbolKind.Parameter;
    if (target == undefined || !isValue) {
      return undefined;
    }

    const type = this.targetValue(target);
    if (type.kind != TypeKind.Class) {
      return undefined;
    }

    return type;
  }

  private classExprTyped(expr: ClassExpr, module: int): Type {
    const tree = this.types.program.tree;

    const error = this.types.store.plain(TypeKind.Error);
    const decl = tree.classOf(expr.declId);
    const base = tree.exprAt(decl.baseExprId);
    const parent = this.baseValue(base, module);
    if (
      tree.typeParamsOf(decl.typeParamsList).length > 0 ||
      parent == undefined
    ) {
      return error;
    }

    const instance = this.types.classInstance(module, decl, []);
    if (instance.kind != TypeKind.Instance) {
      return error;
    }
    if (parent.kind == TypeKind.Instance) {
      const known = this.types.store.parentsOf(instance);
      const parents: Type[] = [parent];

      this.types.store.inherit(instance, parents.concat(known));
      this.types.store.markBase(parent);
    }

    const name = this.classExprName(expr, module);
    if (name != undefined) {
      this.types.store.label(instance, name);
    }

    return this.types.store.classOf(instance, true);
  }

  private readonly classExprName(
    expr: ClassExpr,
    module: int,
  ): string | undefined {
    const tree = this.types.program.tree;

    const declClass = tree.classOf(expr.declId);
    if (declClass.name != undefined) {
      return undefined;
    }

    const variables = this.record(module)?.variables;
    if (variables == undefined) {
      return undefined;
    }

    for (const variable of variables.values()) {
      if (variable.decl.initId == expr.id) {
        return variable.decl.name;
      }
    }

    return undefined;
  }

  private baseValue(base: Expr | undefined, module: int): Type | undefined {
    if (base == undefined) {
      return this.types.store.plain(TypeKind.Void);
    }

    const type = this.typed(base, undefined, module);
    const isOpen =
      type.kind == TypeKind.Error || type.kind == TypeKind.TypeParameter;
    if (isOpen) {
      return undefined;
    }

    const word = this.types.typeText(type);
    if (type.kind != TypeKind.Class) {
      this.errors.write(module, base.loc, Code.ExtendsNotClassValue, { word });

      return undefined;
    }
    if (!type.exact) {
      this.errors.write(module, base.loc, Code.ExtendsRuntimeClass, { word });

      return undefined;
    }

    return this.types.store.classInstanceOf(type);
  }

  private constructorArgsCheck(fn: FunctionDecl, module: int): void {
    const tree = this.types.program.tree;

    const owner = this.ownerClasses[this.ownerClasses.length - 1]?.decl;
    const isDerived =
      owner != undefined &&
      (tree.typeRefAt(owner.baseId) != undefined ||
        tree.exprAt(owner.baseExprId) != undefined);
    const isConstructor =
      tree.holdsStmt(owner?.constructorsList, fn.id) == true;
    if (isDerived && isConstructor) {
      return;
    }

    for (const param of tree.paramsOf(fn.paramsList)) {
      const ref = tree.typeRefAt(param.typeId);
      const isArgs =
        ref != undefined &&
        ref.form.kind == TypeRefKind.Name &&
        ref.name == kConstructorArgsName;
      if (isArgs && ref != undefined) {
        this.errors.write(
          module,
          ref.loc,
          Code.ConstructorArgsSubclass,
          kNoDetails,
        );
      }
    }
  }
}
