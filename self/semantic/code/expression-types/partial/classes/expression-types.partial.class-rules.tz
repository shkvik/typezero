import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  ClassDecl,
  FieldKind,
  MethodKind,
} from "../../../../../program/ast/types/ast.types.classes.tz";
import {
  BinaryExpr,
  Expr,
  ExprKind,
  MemberExpr,
  NameExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import {
  InstanceType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  kCollectionExamples,
  kSetClass,
  kSuperName,
  kThisName,
} from "../../const/expression-types.const.tz";
import { StaticOwner, ThisPlace } from "../../types/expression-types.types.tz";
import { kDateName } from "../../../../types/type-questions/const/type-questions.const.tz";
import { kMapClass } from "../../../class-rules/const/class-rules.const.tz";

partial class ExpressionTypes {
  private instanceofTyped(expr: BinaryExpr, module: int): Type {
    const left = this.typed(expr.lhs, undefined, module);
    const boolean = this.store.plain(TypeKind.Boolean);
    if (this.collectionInstanceof(expr, left, module)) {
      return boolean;
    }
    if (this.bytesInstanceof(expr, left, module)) {
      return boolean;
    }
    const decl = this.testedClass(expr.rhs, module);
    if (decl == undefined) {
      return boolean;
    }

    const instance = this.testedInstance(expr.rhs, decl, module);
    const home = this.classHomeOf(expr.rhs, module);
    if (instance == undefined && home != undefined) {
      this.genericInstanceofCheck(expr, left, decl, home, module);

      return boolean;
    }
    if (instance == undefined) {
      return boolean;
    }

    const instanceofErrors = this.classValues.instanceofCheck(
      expr,
      left,
      instance,
      decl,
    );

    this.reportAll(module, instanceofErrors);

    return boolean;
  }

  private collectionInstanceof(
    expr: BinaryExpr,
    left: Type,
    module: int,
  ): boolean {
    const rhs = expr.rhs;
    if (rhs.kind != ExprKind.Name || !this.isGlobalUse(rhs, module)) {
      return false;
    }

    const word = rhs.name;
    const isCollection =
      word == kDateName || word == kMapClass || word == kSetClass;
    if (!isCollection) {
      return false;
    }

    const base = this.types.definedType(left);
    const isOpaque =
      base.kind == TypeKind.Unknown || base.kind == TypeKind.AnyObject;
    const example = kCollectionExamples.find((one) => one.name == word);
    if (isOpaque && example != undefined) {
      this.report(module, expr.loc, Code.InstanceOfUntyped, {
        word,
        other: example.example,
      });

      return true;
    }
    if (isOpaque || this.classValues.isOpenTested(base)) {
      return true;
    }
    if (base.kind == TypeKind.Union) {
      const collectionUnionErrors = this.classValues.collectionUnionCheck(
        expr,
        left,
        base.parts,
        word,
      );

      this.reportAll(module, collectionUnionErrors);

      return true;
    }

    const collectionTypeError = this.classValues.collectionTypeCheck(
      expr,
      left,
      base,
      word,
    );

    this.reportFound(module, collectionTypeError);

    return true;
  }

  private testedClass(rhs: Expr, module: int): ClassDecl | undefined {
    if (rhs.kind != ExprKind.Name) {
      this.typed(rhs, undefined, module);

      return undefined;
    }

    const target = this.targetOfName(rhs, module);
    if (target != undefined && target.kind == SymbolKind.Class) {
      return this.record(target.module)?.classes.get(target.loc);
    }

    const type = this.typed(rhs, undefined, module);
    const isClass = type.kind == TypeKind.Class;
    if (type.kind != TypeKind.Error && !isClass) {
      this.report(module, rhs.loc, Code.InstanceOfNotClass, kNoDetails);
    }

    return undefined;
  }

  private classHomeOf(rhs: Expr, module: int): int | undefined {
    if (rhs.kind != ExprKind.Name) {
      return undefined;
    }

    return this.targetOfName(rhs, module)?.module;
  }

  private testedInstance(
    rhs: Expr,
    decl: ClassDecl,
    module: int,
  ): Type | undefined {
    if (rhs.kind != ExprKind.Name || decl.typeParams.length > 0) {
      return undefined;
    }

    const target = this.targetOfName(rhs, module);
    if (target == undefined || this.modules.isLibraryModule(target.module)) {
      return undefined;
    }

    return this.resolver.classInstance(target.module, decl, []);
  }

  private memberTargetDeclared(
    target: MemberExpr,
    module: int,
  ): Type | undefined {
    const owner = this.staticOwner(target.object, module);
    if (owner != undefined) {
      return this.staticTargetDeclared(target, owner, module);
    }

    if (this.undefinedTargetCheck(target, module)) {
      return this.store.plain(TypeKind.Error);
    }

    const keyed = this.recordValueOf(target.object, module);
    if (keyed != undefined) {
      return keyed;
    }

    const declared = this.fieldDeclared(target, module);

    if (this.isMadeThis(target.object, module)) {
      return declared;
    }

    const object = this.peekType(target.object, module);

    if (object.kind == TypeKind.Instance) {
      this.instanceTargetCheck(target, object, module);
    }

    this.objectTargetCheck(target, object, module);

    return declared;
  }

  private isMadeThis(object: Expr, module: int): boolean {
    const isThis = object.kind == ExprKind.Name && object.name == kThisName;

    return isThis && !this.isThisName(object, module);
  }

  private instanceTargetCheck(
    target: MemberExpr,
    object: Type,
    module: int,
  ): void {
    if (
      object.kind != TypeKind.Instance ||
      this.isDeclaredLibrary(object.module, object.loc)
    ) {
      return;
    }

    const lookup = this.classMember(object, target.name);
    const entry = lookup.entry;
    const word = target.name;

    if (!lookup.isKnown) {
      return;
    }
    if (entry == undefined) {
      const first = this.text.of(object);

      this.report(module, target.loc, Code.PropertyMissing, { word, first });

      return;
    }

    const owner = entry.owner;
    const first = owner.name ?? "";
    const field = entry.field;

    if (entry.isStatic) {
      return;
    }
    if (field == undefined) {
      return this.methodTargetReport(object, target, owner, module);
    }
    if (this.checkAccess(entry, field.access, target, module)) {
      return;
    }
    if (field.readonly && !this.isConstructorOf(owner)) {
      this.report(module, target.loc, Code.ReadOnlyField, { word, first });
    }
  }

  private isConstructorOf(owner: ClassDecl): boolean {
    const method = this.currentMethods[this.currentMethods.length - 1];
    const current = this.ownerClasses[this.ownerClasses.length - 1];
    if (method == undefined || current == undefined) {
      return false;
    }

    const isMaker = method.role?.method == MethodKind.Constructor;

    return isMaker && current.decl == owner;
  }

  private staticTargetDeclared(
    target: MemberExpr,
    owner: StaticOwner,
    module: int,
  ): Type | undefined {
    const decl = owner.decl;
    const name = target.name;
    const first = decl.name ?? "";
    const field = decl.fields.find(
      (one) => one.name == name && one.form == FieldKind.Static,
    );
    const isMethod = decl.methods.some(
      (one) => one.name == name && this.classes.isStaticMethod(one),
    );

    if (field != undefined) {
      this.reportAccess(decl, field.access, name, target.loc, module);

      if (field.readonly) {
        const word = `${first}.${name}`;

        this.report(module, target.loc, Code.ReadOnlyStatic, { word });
      }

      return this.staticFieldType(field.type, field.presence, owner);
    }
    if (isMethod) {
      this.report(module, target.loc, Code.StaticMethodReplaced, {
        word: name,
        first,
      });

      return this.store.plain(TypeKind.Error);
    }
    if (decl.base == undefined && decl.baseExpr == undefined) {
      this.report(module, target.loc, Code.StaticFieldMissing, {
        word: name,
        first,
      });
    }

    return this.store.plain(TypeKind.Error);
  }

  private thisPlaceCheck(expr: MemberExpr, module: int): boolean {
    if (!this.isThisName(expr.object, module)) {
      return false;
    }

    const place = this.thisPlaces[this.thisPlaces.length - 1];
    const owner = this.ownerClasses[this.ownerClasses.length - 1];
    const isStatic =
      place == ThisPlace.StaticMethod || place == ThisPlace.StaticField;
    if (!isStatic || owner == undefined) {
      return false;
    }

    const first = owner.decl.name ?? "";
    const word = expr.name;
    const loc = expr.object.loc;

    if (place == ThisPlace.StaticField) {
      this.report(module, loc, Code.StaticThisField, { word, first });
    } else {
      this.report(module, loc, Code.StaticThisMethod, { word, first });
    }

    return true;
  }

  private superReadCheck(expr: MemberExpr, module: int): boolean {
    if (!this.isSuperName(expr.object, module)) {
      return false;
    }

    this.report(module, expr.loc, Code.SuperRead, { word: expr.name });

    return true;
  }

  private isSuperName(expr: Expr, module: int): boolean {
    if (expr.kind != ExprKind.Name || expr.name != kSuperName) {
      return false;
    }

    const use = this.record(module)?.uses.get(expr.loc);

    return use?.symbol == undefined;
  }

  private thisInFunction(expr: NameExpr, module: int): boolean {
    const place = this.thisPlaces[this.thisPlaces.length - 1];
    if (place != ThisPlace.Function) {
      return false;
    }

    const isInMethod = this.thisPlaces.some(
      (one) => one == ThisPlace.Method || one == ThisPlace.StaticMethod,
    );
    if (!isInMethod) {
      return false;
    }

    this.report(module, expr.loc, Code.ThisInFunction, kNoDetails);

    return true;
  }

  private methodTargetReport(
    object: InstanceType,
    target: MemberExpr,
    owner: ClassDecl,
    module: int,
  ): void {
    const word = target.name;
    const first = owner.name ?? "";
    if (!this.modules.isTypedLibrary(object.module)) {
      return this.report(module, target.loc, Code.MethodReplaced, {
        word,
        first,
      });
    }

    const head = word.slice(0, 1).toUpperCase();
    const setter = `set${head}${word.slice(1)}`;
    const found = this.classMember(object, setter).entry;
    if (found != undefined && found.field == undefined) {
      return this.report(module, target.loc, Code.LibrarySetterMethod, {
        word,
        first,
        other: setter,
      });
    }

    this.report(module, target.loc, Code.LibraryMethodAssigned, {
      word,
      first,
    });
  }
}
