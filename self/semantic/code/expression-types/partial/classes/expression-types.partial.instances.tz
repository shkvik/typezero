import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  Access,
  ClassDecl,
  ClassField,
  FieldKind,
  FieldPresence,
  TypeAliasDecl,
} from "../../../../../program/ast/types/ast.types.classes.tz";
import {
  ExprKind,
  MemberExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  FunctionDecl,
} from "../../../../../program/ast/types/ast.types.functions.tz";
import {
  InstanceType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  ClassLookup,
  ClassMemberEntry,
} from "../../types/expression-types.types.tz";
import {
  InstanceField,
} from "../../../../../program/expression-answers/types/expression-answers.types.tz";

partial class ExpressionTypes {
  private instanceMember(
    expr: MemberExpr,
    instance: InstanceType,
    module: int,
  ): Type {
    if (
      this.isDeclaredLibrary(instance.module, instance.loc) &&
      this.types.isDate(instance)
    ) {
      return this.dateMemberRead(expr, instance, module);
    }
    if (this.isDeclaredLibrary(instance.module, instance.loc)) {
      const intlMember = this.intlMemberRead(expr, instance, module);
      if (intlMember != undefined) {
        return intlMember;
      }

      const weakRead = this.weakRefRead(expr, instance, module);
      if (weakRead != undefined) {
        return weakRead;
      }

      const regexRead = this.regexMemberRead(expr, instance, module);
      if (regexRead != undefined) {
        return regexRead;
      }

      const cryptoRead = this.cryptoMemberRead(expr, instance, module);
      if (cryptoRead != undefined) {
        return cryptoRead;
      }

      const byteMember = this.byteMemberRead(expr, instance, module);

      return byteMember ?? this.libraryMemberTyped(expr, instance, module);
    }

    const lookup = this.classMember(instance, expr.name);
    const entry = lookup.entry;

    if (!lookup.isKnown) {
      return this.types.store.plain(TypeKind.Error);
    }
    if (entry == undefined) {
      const word = expr.name;
      const first = this.types.typeText(instance);

      this.errors.write(module, expr.loc, Code.PropertyMissing, {
        word,
        first,
      });

      return this.types.store.plain(TypeKind.Error);
    }
    if (entry.isStatic) {
      const staticError = this.types.staticError(expr, entry);

      this.errors.writeFound(module, staticError);

      return this.types.store.plain(TypeKind.Error);
    }

    const field = entry.field;
    if (field != undefined) {
      this.checkAccess(entry, field.access, expr, module);

      return this.fieldTypeOf(entry, field);
    }

    const method = entry.methods[0];
    if (entry.methods.length > 1) {
      this.variantValueCheck(expr, entry, module);

      return this.types.store.plain(TypeKind.Error);
    }
    if (method == undefined) {
      return this.types.store.plain(TypeKind.Error);
    }

    const access = this.types.classAccessOf(method);

    this.checkAccess(entry, access, expr, module);

    if (this.genericMethodValue(expr, method, module)) {
      return this.types.store.plain(TypeKind.Error);
    }

    return this.methodTypeOf(entry, method);
  }

  private checkAccess(
    entry: Read<ClassMemberEntry>,
    access: Access,
    expr: MemberExpr,
    module: int,
  ): boolean {
    if (this.protectedElsewhere(entry.owner, access, expr, module)) {
      return true;
    }

    return this.reportAccess(entry.owner, access, expr.name, expr.loc, module);
  }

  private reportAccess(
    owner: ClassDecl,
    access: Access,
    word: string,
    loc: int,
    module: int,
  ): boolean {
    const first = owner.name ?? "";

    if (access == Access.Public || this.isInsideClass(owner)) {
      return false;
    }
    if (access == Access.Protected && this.isDerivedInside(owner)) {
      return false;
    }
    if (access == Access.Protected) {
      this.errors.write(module, loc, Code.ProtectedMember, { word, first });

      return true;
    }

    this.errors.write(module, loc, Code.PrivateMember, { word, first });

    return true;
  }

  public readonly classDeclOf(type: Type): ClassDecl | undefined {
    if (type.kind != TypeKind.Instance) {
      return undefined;
    }

    return this.classOf(type);
  }

  public declaredClassType(module: int, decl: ClassDecl): Type {
    const tree = this.types.program.tree;

    const params = this.types.parameterTypes(
      module,
      tree.typeParamsOf(decl.typeParamsList),
    );

    return this.types.classInstance(module, decl, params);
  }

  public declaredAliasType(module: int, decl: TypeAliasDecl): Type {
    return this.types.declaredAlias(module, decl);
  }

  public instanceFields(type: Type): InstanceField[] | undefined {
    const tree = this.types.program.tree;

    const decl = this.classDeclOf(type);
    if (decl == undefined || type.kind != TypeKind.Instance) {
      return undefined;
    }

    const fields: InstanceField[] = [];

    for (const field of tree.fieldsOf(decl.fieldsList)) {
      if (field.form == FieldKind.Static) {
        continue;
      }

      const entry = this.types.ownMember(type, decl, field.name);
      if (entry == undefined) {
        return undefined;
      }

      const fieldType = this.seenFieldType(entry, field);
      if (fieldType == undefined) {
        return undefined;
      }

      fields.push({ name: field.name, loc: field.loc, type: fieldType });
    }

    return fields;
  }

  private seenFieldType(
    entry: Read<ClassMemberEntry>,
    field: ClassField,
  ): Type | undefined {
    if (this.isArrowFieldOf(field)) {
      return this.arrowFields.get(`${entry.instance.module} ${field.loc}`);
    }

    return this.writtenFieldType(entry, field);
  }

  private readonly isArrowFieldOf(field: ClassField): boolean {
    const tree = this.types.program.tree;

    const isArrow = this.types.isArrowField(field);

    return (
      field.form == FieldKind.ArrowMethod ||
      (isArrow && tree.typeRefAt(field.typeId) == undefined)
    );
  }

  private readonly classOf(instance: InstanceType): ClassDecl | undefined {
    if (this.isDeclaredLibrary(instance.module, instance.loc)) {
      return undefined;
    }

    return this.record(instance.module)?.classes.get(instance.loc);
  }

  private readonly classMember(
    instance: InstanceType,
    name: string,
  ): ClassLookup {
    const tree = this.types.program.tree;

    const decl = this.classOf(instance);
    if (
      decl == undefined ||
      tree.decoratorsOf(decl.decoratorsList).length > 0
    ) {
      return { isKnown: false };
    }

    const own = this.types.ownMember(instance, decl, name);
    if (own != undefined) {
      return { isKnown: true, entry: own };
    }

    const parent = this.types.parentOf(instance, decl);
    if (parent == undefined) {
      const isKnown =
        tree.typeRefAt(decl.baseId) == undefined &&
        tree.exprAt(decl.baseExprId) == undefined;

      return { isKnown };
    }

    return this.classMember(parent, name);
  }

  private arrowFieldType(
    entry: Read<ClassMemberEntry>,
    field: ClassField,
  ): Type {
    const tree = this.types.program.tree;

    const init = tree.exprAt(field.initId);
    const owner = entry.owner;
    if (init == undefined || init.kind != ExprKind.Function) {
      return this.types.store.plain(TypeKind.Error);
    }
    const typeParams = tree.typeParamsOf(owner.typeParamsList);
    if (typeParams.length > 0) {
      return this.types.store.plain(TypeKind.Error);
    }

    return this.methodFunction(
      owner,
      tree.functionOf(init.fnId),
      entry.instance.module,
    );
  }

  private fieldTypeOf(entry: Read<ClassMemberEntry>, field: ClassField): Type {
    if (!this.isArrowFieldOf(field)) {
      return this.writtenFieldType(entry, field);
    }

    const type = this.arrowFieldType(entry, field);

    this.arrowFields.set(`${entry.instance.module} ${field.loc}`, type);

    return type;
  }

  private writtenFieldType(
    entry: Read<ClassMemberEntry>,
    field: ClassField,
  ): Type {
    const tree = this.types.program.tree;

    const written = tree.typeRefAt(field.typeId);
    if (written == undefined) {
      return this.types.store.plain(TypeKind.Error);
    }

    const owner = entry.owner;
    const instance = entry.instance;
    const context = this.types.classContext(
      instance,
      tree.typeParamsOf(owner.typeParamsList),
      instance.module,
    );
    const type = this.types.resolve(written, context);

    if (field.presence == FieldPresence.Optional) {
      return this.types.optional(type);
    }

    return type;
  }

  private methodTypeOf(
    entry: Read<ClassMemberEntry>,
    method: FunctionDecl,
  ): Type {
    const tree = this.types.program.tree;

    const written = tree.typeRefAt(method.returnTypeId);
    const owner = entry.owner;

    const typeParams = tree.typeParamsOf(method.typeParamsList);
    if (typeParams.length > 0) {
      return this.types.store.plain(TypeKind.Error);
    }
    const typeParamsItem = tree.typeParamsOf(owner.typeParamsList);
    if (typeParamsItem.length == 0) {
      return this.methodFunction(owner, method, entry.instance.module);
    }
    if (written == undefined) {
      return this.inferredGenericMethod(entry, method);
    }

    const sites = this.types.parameterSites(method);
    if (sites == undefined) {
      return this.types.store.plain(TypeKind.Error);
    }

    const instance = entry.instance;
    const part = this.partOf(entry.owner, method);
    const context = this.types.classContext(
      instance,
      tree.typeParamsOf(part.typeParamsList),
      this.partModule(part, instance.module),
    );

    return this.types.signature(sites, written, context);
  }

  private inferredGenericMethod(
    entry: Read<ClassMemberEntry>,
    method: FunctionDecl,
  ): Type {
    const tree = this.types.program.tree;

    const instance = entry.instance;
    const part = this.partOf(entry.owner, method);
    const home = this.partModule(part, instance.module);
    const opened = this.types.parameterTypes(
      home,
      tree.typeParamsOf(part.typeParamsList),
    );
    const generic = this.methodFunction(entry.owner, method, instance.module);
    if (generic.kind != TypeKind.Function) {
      return this.types.store.plain(TypeKind.Error);
    }

    const bound = new Map<int, Type>();

    for (let index = 0; index < opened.length; index++) {
      const param = opened[index];
      const arg = this.types.store.argsOf(instance)[index];
      if (param != undefined && arg != undefined) {
        bound.set(param.id, arg);
      }
    }

    return this.types.substitute(generic, bound);
  }

  private readonly partOf(owner: ClassDecl, method: FunctionDecl): ClassDecl {
    const part = this.methodParts.get(method.id);
    if (part == undefined || part.name != owner.name) {
      return owner;
    }

    return part;
  }

  private readonly partModule(part: ClassDecl, module: int): int {
    return this.partHomes.get(part.id) ?? module;
  }
}
