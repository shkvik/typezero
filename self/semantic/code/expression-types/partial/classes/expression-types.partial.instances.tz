import { kIntlName } from "../../../../library/intl-rules/const/intl-rules.const.tz";
import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  Access,
  ClassDecl,
  ClassField,
  FieldKind,
  FieldPresence,
} from "../../../../../program/ast/types/ast.types.classes.tz";
import {
  ExprKind,
  MemberExpr,
  NewExpr,
  NewKind,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../../program/ast/types/ast.types.functions.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import {
  InstanceType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  CallTarget,
  ClassLookup,
  ClassMemberEntry,
} from "../../types/expression-types.types.tz";
import { kConstructorName } from "../../../object-rules/const/object-rules.const.tz";
import { InstanceField } from "../../../../../program/expression-answers/types/expression-answers.types.tz";

partial class ExpressionTypes {
  private instanceMember(
    expr: MemberExpr,
    instance: InstanceType,
    module: int,
  ): Type {
    if (
      this.isDeclaredLibrary(instance.module, instance.loc) &&
      this.types.isDate(instance)
    ) {
      return this.dateMemberRead(expr, instance, module);
    }
    if (this.isDeclaredLibrary(instance.module, instance.loc)) {
      const intlMember = this.intlMemberRead(expr, instance, module);
      if (intlMember != undefined) {
        return intlMember;
      }

      const weakRead = this.weakRefRead(expr, instance, module);
      if (weakRead != undefined) {
        return weakRead;
      }

      const regexRead = this.regexMemberRead(expr, instance, module);
      if (regexRead != undefined) {
        return regexRead;
      }

      const cryptoRead = this.cryptoMemberRead(expr, instance, module);
      if (cryptoRead != undefined) {
        return cryptoRead;
      }

      const byteMember = this.byteMemberRead(expr, instance, module);

      return byteMember ?? this.libraryMemberTyped(expr, instance, module);
    }

    const lookup = this.classMember(instance, expr.name);
    const entry = lookup.entry;

    if (!lookup.isKnown) {
      return this.store.plain(TypeKind.Error);
    }
    if (entry == undefined) {
      const word = expr.name;
      const first = this.text.of(instance);

      this.report(module, expr.loc, Code.PropertyMissing, { word, first });

      return this.store.plain(TypeKind.Error);
    }
    if (entry.isStatic) {
      const staticError = this.classValues.staticError(expr, entry);

      this.reportFound(module, staticError);

      return this.store.plain(TypeKind.Error);
    }

    const field = entry.field;
    if (field != undefined) {
      this.checkAccess(entry, field.access, expr, module);

      return this.fieldTypeOf(entry, field);
    }

    const method = entry.methods[0];
    if (entry.methods.length > 1) {
      this.variantValueCheck(expr, entry, module);

      return this.store.plain(TypeKind.Error);
    }
    if (method == undefined) {
      return this.store.plain(TypeKind.Error);
    }

    const access = this.classes.accessOf(method);

    this.checkAccess(entry, access, expr, module);

    if (this.genericMethodValue(expr, method, module)) {
      return this.store.plain(TypeKind.Error);
    }

    return this.methodTypeOf(entry, method);
  }

  private checkAccess(
    entry: Read<ClassMemberEntry>,
    access: Access,
    expr: MemberExpr,
    module: int,
  ): boolean {
    if (this.protectedElsewhere(entry.owner, access, expr, module)) {
      return true;
    }

    return this.reportAccess(entry.owner, access, expr.name, expr.loc, module);
  }

  private readonly reportAccess(
    owner: ClassDecl,
    access: Access,
    word: string,
    loc: int,
    module: int,
  ): boolean {
    const first = owner.name ?? "";

    if (access == Access.Public || this.isInsideClass(owner)) {
      return false;
    }
    if (access == Access.Protected && this.isDerivedInside(owner)) {
      return false;
    }
    if (access == Access.Protected) {
      this.report(module, loc, Code.ProtectedMember, { word, first });

      return true;
    }

    this.report(module, loc, Code.PrivateMember, { word, first });

    return true;
  }

  public readonly classDeclOf(type: Type): ClassDecl | undefined {
    if (type.kind != TypeKind.Instance) {
      return undefined;
    }

    return this.classOf(type);
  }

  public readonly instanceFields(type: Type): InstanceField[] | undefined {
    const decl = this.classDeclOf(type);
    if (decl == undefined || type.kind != TypeKind.Instance) {
      return undefined;
    }

    const fields: InstanceField[] = [];

    for (const field of decl.fields) {
      if (field.form == FieldKind.Static) {
        continue;
      }

      const entry = this.classes.ownMember(type, decl, field.name);
      if (entry == undefined) {
        return undefined;
      }

      const fieldType = this.seenFieldType(entry, field);
      if (fieldType == undefined) {
        return undefined;
      }

      fields.push({ name: field.name, loc: field.loc, type: fieldType });
    }

    return fields;
  }

  private readonly seenFieldType(entry: Read<ClassMemberEntry>, field: ClassField): Type | undefined {
    if (this.isArrowFieldOf(field)) {
      return this.arrowFields.get(`${entry.instance.module} ${field.loc}`);
    }

    return this.writtenFieldType(entry, field);
  }

  private readonly isArrowFieldOf(field: ClassField): boolean {
    const isArrow = this.classes.isArrowField(field);

    return field.form == FieldKind.ArrowMethod || (isArrow && field.type == undefined);
  }

  private readonly classOf(instance: InstanceType): ClassDecl | undefined {
    if (this.isDeclaredLibrary(instance.module, instance.loc)) {
      return undefined;
    }

    return this.record(instance.module)?.classes.get(instance.loc);
  }

  private readonly classMember(instance: InstanceType, name: string): ClassLookup {
    const decl = this.classOf(instance);
    if (decl == undefined || decl.decorators.length > 0) {
      return { isKnown: false };
    }

    const own = this.classes.ownMember(instance, decl, name);
    if (own != undefined) {
      return { isKnown: true, entry: own };
    }

    const parent = this.classes.parentOf(instance, decl);
    if (parent == undefined) {
      const isKnown = decl.base == undefined && decl.baseExpr == undefined;

      return { isKnown };
    }

    return this.classMember(parent, name);
  }

  private arrowFieldType(entry: Read<ClassMemberEntry>, field: ClassField): Type {
    const init = field.init;
    const owner = entry.owner;
    if (init == undefined || init.kind != ExprKind.Function) {
      return this.store.plain(TypeKind.Error);
    }
    if (owner.typeParams.length > 0) {
      return this.store.plain(TypeKind.Error);
    }

    return this.methodFunction(owner, init.fn, entry.instance.module);
  }

  private fieldTypeOf(entry: Read<ClassMemberEntry>, field: ClassField): Type {
    if (!this.isArrowFieldOf(field)) {
      return this.writtenFieldType(entry, field);
    }

    const type = this.arrowFieldType(entry, field);

    this.arrowFields.set(`${entry.instance.module} ${field.loc}`, type);

    return type;
  }

  private readonly writtenFieldType(entry: Read<ClassMemberEntry>, field: ClassField): Type {
    const written = field.type;
    if (written == undefined) {
      return this.store.plain(TypeKind.Error);
    }

    const owner = entry.owner;
    const instance = entry.instance;
    const context = this.resolver.classContext(
      instance,
      owner.typeParams,
      instance.module,
    );
    const type = this.resolver.resolve(written, context);

    if (field.presence == FieldPresence.Optional) {
      return this.types.optional(type);
    }

    return type;
  }

  private methodTypeOf(entry: Read<ClassMemberEntry>, method: FunctionDecl): Type {
    const written = method.returnType;
    const owner = entry.owner;

    if (method.typeParams.length > 0) {
      return this.store.plain(TypeKind.Error);
    }
    if (owner.typeParams.length == 0) {
      return this.methodFunction(owner, method, entry.instance.module);
    }
    if (written == undefined) {
      return this.inferredGenericMethod(entry, method);
    }

    const sites = this.classes.parameterSites(method);
    if (sites == undefined) {
      return this.store.plain(TypeKind.Error);
    }

    const instance = entry.instance;
    const part = this.partOf(entry.owner, method);
    const context = this.resolver.classContext(
      instance,
      part.typeParams,
      this.partModule(part, instance.module),
    );

    return this.resolver.signature(sites, written, context);
  }

  private inferredGenericMethod(
    entry: Read<ClassMemberEntry>,
    method: FunctionDecl,
  ): Type {
    const instance = entry.instance;
    const part = this.partOf(entry.owner, method);
    const home = this.partModule(part, instance.module);
    const opened = this.resolver.parameterTypes(home, part.typeParams);
    const generic = this.methodFunction(entry.owner, method, instance.module);
    if (generic.kind != TypeKind.Function) {
      return this.store.plain(TypeKind.Error);
    }

    const bound = new Map<int, Type>();

    for (let index = 0; index < opened.length; index++) {
      const param = opened[index];
      const arg = instance.args[index];
      if (param != undefined && arg != undefined) {
        bound.set(param.id, arg);
      }
    }

    return this.resolver.substitute(generic, bound);
  }

  private readonly partOf(owner: ClassDecl, method: FunctionDecl): ClassDecl {
    const part = this.methodParts.get(method);
    if (part == undefined || part.name != owner.name) {
      return owner;
    }

    return part;
  }

  private readonly partModule(part: ClassDecl, module: int): int {
    return this.partHomes.get(part) ?? module;
  }

  private newTyped(expr: NewExpr, wanted: Type | undefined, module: int): Type {
    const form = expr.form;
    if (form.kind == NewKind.Callee) {
      const callee = this.typed(form.callee, undefined, module);

      return this.valueNew(expr, callee, form.callee.loc, module);
    }
    const owned = form.member;
    if (owned != undefined) {
      return this.memberNew(expr, form.name, owned, module);
    }

    this.newArrayCheck(expr, form.name, wanted, module);
    this.madeSizeCheck(expr, form.name, module);

    const arrayMade = this.arrayNew(expr, form.name, wanted, module);
    if (arrayMade != undefined) {
      return arrayMade;
    }

    const executorErrors = this.library.executorCheck(expr, form.name);

    this.reportAll(module, executorErrors);

    const target = this.targetOfUse(expr.loc, form.name, module);
    if (target == undefined) {
      return this.store.plain(TypeKind.Error);
    }
    const handleMade = this.handleNew(expr, form.name, target, module);
    if (handleMade != undefined) {
      return handleMade;
    }
    if (target.kind != SymbolKind.Class) {
      const made = this.namedValueNew(expr, target, module);

      return made ?? this.store.plain(TypeKind.Error);
    }
    if (this.modules.isLibraryModule(target.module)) {
      const fileMade = this.fileClassNew(
        expr,
        form.name,
        target.module,
        module,
      );
      if (fileMade != undefined) {
        return fileMade;
      }

      const cryptoMade = this.cryptoNew(expr, form.name, target.module, module);
      if (cryptoMade != undefined) {
        return cryptoMade;
      }

      const regExpMade = this.regExpNew(expr, module);
      if (regExpMade != undefined) {
        return regExpMade;
      }

      const weakMade = this.weakRefNew(expr, form.name, target, wanted, module);
      if (weakMade != undefined) {
        return weakMade;
      }

      if (this.isDeclaredLibrary(target.module, target.loc)) {
        const made = this.libraryNew(expr, form.name, target, wanted, module);

        this.newSourceCheck(expr, made, module);

        return this.codedNew(expr, made, module);
      }
    }

    const decl = this.record(target.module)?.classes.get(target.loc);
    if (decl == undefined) {
      return this.store.plain(TypeKind.Error);
    }

    const isEarly =
      this.openFunctions.length == 0 &&
      target.module == module &&
      !this.walkedClasses.has(decl);
    if (isEarly) {
      this.report(module, expr.loc, Code.ClassUsedEarly, {
        word: decl.name ?? form.name,
      });
      this.looseArguments(expr.args, module);

      return this.store.plain(TypeKind.Error);
    }
    const emitterMade = this.emitterNew(expr, decl, target.module, module);
    if (emitterMade != undefined) {
      return emitterMade;
    }

    const streamMade = this.streamNew(
      expr,
      decl,
      target.module,
      wanted,
      module,
    );
    if (streamMade != undefined) {
      return streamMade;
    }
    if (decl.typeParams.length > 0 && expr.typeArgs.length == 0) {
      const inferred = this.genericNew(
        expr,
        decl,
        target.module,
        wanted,
        module,
      );

      this.copyVariantsCheck(expr, inferred, decl, module);

      return inferred;
    }

    const written = this.newArguments(expr, decl, module);
    if (written == undefined) {
      return this.store.plain(TypeKind.Error);
    }

    const instance = this.resolver.classInstance(target.module, decl, written);
    if (instance.kind != TypeKind.Instance) {
      return this.store.plain(TypeKind.Error);
    }
    if (decl.isAbstract) {
      this.report(module, expr.loc, Code.AbstractNew, {
        word: decl.name ?? "",
      });

      return this.store.plain(TypeKind.Error);
    }

    const made = this.constructed(expr, instance, decl, module);

    this.copyVariantsCheck(expr, made, decl, module);
    this.fetchNewCheck(expr, decl, target.module, made, module);
    this.emitterMapCheck(expr, made, module);

    return made;
  }

  private readonly newArguments(
    expr: NewExpr,
    decl: ClassDecl,
    module: int,
  ): Type[] | undefined {
    const count = expr.typeArgs.length;
    const params = decl.typeParams.length;
    const word = decl.name ?? "";
    if (params == 0 && count > 0) {
      this.report(module, expr.loc, Code.ClassNotGeneric, { word });

      return undefined;
    }
    if (count > params) {
      this.report(module, expr.loc, Code.TypeArgumentsMany, {
        word,
        other: `${params}`,
        place: this.classes.pluralMark(params),
        first: `${count}`,
      });

      return undefined;
    }
    const missing = decl.typeParams.slice(count);
    const isDefaulted = missing.every(
      (param) => param.defaultType != undefined,
    );
    if (count != params && !isDefaulted) {
      return undefined;
    }

    return this.writtenArguments(expr.typeArgs, module);
  }

  private constructed(
    expr: NewExpr,
    instance: InstanceType,
    decl: ClassDecl,
    module: int,
  ): Type {
    const maker = this.makerOf(instance, decl);
    if (maker == undefined) {
      return instance;
    }

    const constructors = this.visibleConstructors(maker.owner);
    const isLibraryEmpty =
      maker.owner != decl &&
      this.modules.isLibraryModule(instance.module) &&
      constructors.every((fn) => fn.params.length == 0);
    if ((constructors.length == 0 || isLibraryEmpty) && expr.args.length > 0) {
      this.report(module, expr.loc, Code.NoConstructor, {
        word: decl.name ?? "",
      });
      this.looseArguments(expr.args, module);

      return this.store.plain(TypeKind.Error);
    }

    const chosen = constructors[0];
    if (constructors.length > 1) {
      return this.variantNew(expr, instance, maker, constructors, decl, module);
    }
    if (chosen == undefined) {
      return instance;
    }

    const word = kConstructorName;
    const access = this.classes.accessOf(chosen);

    this.reportAccess(maker.owner, access, word, expr.loc, module);

    const target = this.constructorTarget(maker, chosen, expr.loc);
    if (target == undefined) {
      return instance;
    }

    const isPassed = this.argumentsCheck(expr.args, target, module);
    if (!isPassed) {
      return this.store.plain(TypeKind.Error);
    }

    return instance;
  }

  private readonly visibleConstructors(owner: ClassDecl): FunctionDecl[] {
    const all = owner.constructors;
    const visible = all.filter((fn) => this.isVisibleConstructor(owner, fn));
    if (visible.length == 0) {
      return all;
    }

    return visible;
  }

  private readonly isVisibleConstructor(owner: ClassDecl, fn: FunctionDecl): boolean {
    const access = this.classes.accessOf(fn);
    if (access == Access.Public || this.isInsideClass(owner)) {
      return true;
    }

    return access == Access.Protected && this.isDerivedInside(owner);
  }

  private variantNew(
    expr: NewExpr,
    instance: InstanceType,
    maker: Read<ClassMemberEntry>,
    constructors: Read<FunctionDecl[]>,
    decl: ClassDecl,
    module: int,
  ): Type {
    const targets: CallTarget[] = [];

    for (const fn of constructors) {
      const target = this.constructorTarget(maker, fn, expr.loc);
      if (target == undefined) {
        return instance;
      }

      targets.push(target);
    }

    const name = maker.owner.name ?? decl.name ?? "";
    const chosen = this.constructorChoice(
      expr,
      expr.args,
      targets,
      constructors,
      name,
      module,
    );
    if (chosen == undefined) {
      return this.store.plain(TypeKind.Error);
    }

    const isPassed = this.argumentsCheck(expr.args, chosen, module);
    if (!isPassed) {
      return this.store.plain(TypeKind.Error);
    }

    return instance;
  }

  private readonly makerOf(
    instance: InstanceType,
    decl: ClassDecl,
  ): ClassMemberEntry | undefined {
    const entry: ClassMemberEntry = {
      owner: decl,
      instance,
      methods: [],
      isStatic: false,
    };

    if (decl.constructors.length > 0) {
      return entry;
    }

    const parent = this.classes.parentOf(instance, decl);
    if (parent == undefined) {
      const isRoot = decl.base == undefined && decl.baseExpr == undefined;
      if (!isRoot) {
        return undefined;
      }

      return entry;
    }

    const parentDecl = this.classOf(parent);
    if (parentDecl == undefined) {
      return undefined;
    }

    return this.makerOf(parent, parentDecl);
  }

  private readonly constructorTarget(
    maker: Read<ClassMemberEntry>,
    chosen: FunctionDecl,
    loc: int,
  ): CallTarget | undefined {
    const sites = this.classes.parameterSites(chosen);
    if (sites == undefined) {
      return undefined;
    }

    const owner = maker.owner;
    const instance = maker.instance;
    const context = this.resolver.classContext(
      instance,
      owner.typeParams,
      instance.module,
    );
    const signature = this.resolver.signature(sites, undefined, context);
    if (signature.kind != TypeKind.Function) {
      return undefined;
    }

    const shape = signature.shape;

    const params = shape.params;
    const rest = shape.rest;

    return { params, rest, loc, isLenient: false };
  }

  private memberNew(
    expr: NewExpr,
    owner: string,
    name: string,
    module: int,
  ): Type {
    if (owner != kIntlName) {
      return this.store.plain(TypeKind.Error);
    }

    return this.intlNew(expr, name, module);
  }

  private readonly isDeclaredLibrary(module: int, loc: int): boolean {
    if (!this.modules.isLibraryModule(module)) {
      return false;
    }
    if (!this.modules.isTypedLibrary(module)) {
      return true;
    }

    return this.record(module)?.classes.get(loc) == undefined;
  }
}
