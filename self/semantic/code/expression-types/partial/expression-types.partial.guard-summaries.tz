import { ExpressionTypes } from "../expression-types.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../program/ast/types/ast.types.functions.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";
import {
  kDot,
  kLengthTerm,
  kValueTerm,
  kZeroTerm,
} from "../const/expression-types.const.tz";
import {
  FunctionFrame,
  GuardBuild,
  GuardSummary,
} from "../types/expression-types.types.tz";

partial class ExpressionTypes {
  private noteGuardExit(
    value: Expr | undefined,
    frame: FunctionFrame,
    module: int,
  ): void {
    if (value == undefined || frame.fn == undefined) {
      return;
    }

    const guard = frame.guard;
    const isTrue = this.isLiteralTruth(value, true);
    const isFalse = this.isLiteralTruth(value, false);

    if (!isFalse) {
      const whenTrue = this.exitFacts(value, true, module);

      guard.whenTrue = this.joinedSide(guard.whenTrue, whenTrue);
    }
    if (!isTrue) {
      const whenFalse = this.exitFacts(value, false, module);

      guard.whenFalse = this.joinedSide(guard.whenFalse, whenFalse);
    }
  }

  private isLiteralTruth(value: Expr, truth: boolean): boolean {
    return value.kind == ExprKind.BoolLit && value.value == truth;
  }

  private exitFacts(
    value: Expr,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> {
    this.quiet += 1;

    const facts = this.factsOf(value, isTrue, module);

    this.quiet -= 1;

    return this.mergedFacts(this.facts, facts);
  }

  private joinedSide(
    side: Map<string, Type> | undefined,
    facts: Map<string, Type>,
  ): Map<string, Type> {
    if (side == undefined) {
      return facts;
    }

    return this.joinedFacts(side, facts);
  }

  private rememberGuard(
    fn: FunctionDecl,
    frame: FunctionFrame,
    module: int,
  ): void {
    if (fn.isGenerator) {
      return;
    }

    const params = fn.params.map((param) => `${module} ${param.loc}`);
    const guard = frame.guard;
    const summary: GuardSummary = {
      params,
      whenTrue: this.projectedSide(guard, true, params),
      whenFalse: this.projectedSide(guard, false, params),
    };

    this.guardSummaries.set(`${module} ${fn.loc}`, summary);
  }

  private projectedSide(
    guard: GuardBuild,
    isTrue: boolean,
    params: string[],
  ): Map<string, Type> | undefined {
    const side = this.guardSide(guard, isTrue);
    if (side == undefined) {
      return undefined;
    }

    const projected = new Map<string, Type>();

    for (const [key, type] of side) {
      const isParam = params.some((param) => this.isParamPath(key, param));
      if (isParam || this.isParamBound(key, params)) {
        projected.set(key, type);
      }
    }

    return projected;
  }

  private guardSide(
    guard: GuardBuild,
    isTrue: boolean,
  ): Map<string, Type> | undefined {
    if (isTrue) {
      return guard.whenTrue;
    }

    return guard.whenFalse;
  }

  private isParamBound(key: string, params: string[]): boolean {
    const terms = this.boundTerms(key);
    if (terms.length == 0) {
      return false;
    }

    return terms.every(
      (term) =>
        term == kZeroTerm ||
        params.some(
          (param) =>
            term == kValueTerm + param || term == kLengthTerm + param,
        ),
    );
  }

  private isParamPath(key: string, param: string): boolean {
    return key == param || key.startsWith(param + kDot);
  }

  private summaryFacts(
    call: CallExpr,
    fn: FunctionDecl,
    home: int,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> | undefined {
    const type = this.functionAt(home, fn.loc);
    const summary = this.guardSummaries.get(`${home} ${fn.loc}`);
    if (summary == undefined || !this.isBooleanFunction(type)) {
      return undefined;
    }

    const facts = new Map<string, Type>();
    const side = this.summarySide(summary, isTrue);
    if (side == undefined) {
      return facts;
    }

    const moves = this.boundMoves(call, summary, module);

    for (const [key, narrowed] of side) {
      const moved = this.movedBound(key, moves);
      if (moved != "") {
        facts.set(moved, narrowed);

        continue;
      }

      this.appliedFact(call, summary, key, narrowed, facts, module);
    }

    return facts;
  }

  private boundMoves(
    call: CallExpr,
    summary: GuardSummary,
    module: int,
  ): Map<string, string> {
    const moves = new Map<string, string>();

    for (let index = 0; index < summary.params.length; index++) {
      const param = summary.params[index];
      const arg = call.args[index];
      if (param == undefined || arg == undefined || arg.spread) {
        continue;
      }

      const key = this.pathKey(arg.expr, module);
      if (key == undefined) {
        continue;
      }

      moves.set(kValueTerm + param, kValueTerm + key);
      moves.set(kLengthTerm + param, kLengthTerm + key);
    }

    return moves;
  }

  private summarySide(
    summary: GuardSummary,
    isTrue: boolean,
  ): Map<string, Type> | undefined {
    if (isTrue) {
      return summary.whenTrue;
    }

    return summary.whenFalse;
  }

  private isBooleanFunction(type: Type): boolean {
    if (type.kind != TypeKind.Function) {
      return false;
    }

    const result = this.apparent(type.shape.result);

    return result.kind == TypeKind.Boolean;
  }

  private appliedFact(
    call: CallExpr,
    summary: GuardSummary,
    key: string,
    narrowed: Type,
    facts: Map<string, Type>,
    module: int,
  ): void {
    const index = summary.params.findIndex((param) =>
      this.isParamPath(key, param),
    );
    const param = summary.params[index];
    const arg = call.args[index];
    if (param == undefined || arg == undefined || arg.spread) {
      return;
    }

    const slot = this.narrowable(arg.expr, module);
    if (slot == undefined || narrowed.kind == TypeKind.Error) {
      return;
    }

    const path = key.slice(param.length);

    facts.set(slot.key + path, narrowed);
  }
}
