import { ExpressionTypes } from "../expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import {
  AssignExpr,
  BinaryOp,
  Expr,
  ExprKind,
  IndexExpr,
  MemberExpr,
  PropertyKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../program/ast/types/ast.types.functions.tz";
import { Stmt } from "../../../../program/ast/types/ast.types.statements.tz";
import { SymbolKind } from "../../../../program/scopes/types/scopes.types.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";
import {
  kDot,
  kHiddenMark,
  kNoPlace,
  kThisName,
} from "../const/expression-types.const.tz";
import {
  BoundSide,
  DeclaredVariable,
  Destination,
  ParamSlot,
  ValueRecord,
} from "../types/expression-types.types.tz";
import { TruthUse } from "../../../flow/truth-rules/types/truth-rules.types.tz";

partial class ExpressionTypes {
  private pathKey(expr: Expr, module: int): string | undefined {
    if (expr.kind == ExprKind.OptionalChain) {
      return this.pathKey(expr.chain, module);
    }
    if (expr.kind == ExprKind.Member) {
      const object = this.pathKey(expr.object, module);
      if (object == undefined) {
        return undefined;
      }

      return object + kDot + expr.name;
    }
    if (expr.kind != ExprKind.Name) {
      return undefined;
    }
    if (this.isThisName(expr, module)) {
      return kThisName;
    }

    const target = this.targetOfName(expr, module);
    const isValue =
      target != undefined &&
      (target.kind == SymbolKind.Variable ||
        target.kind == SymbolKind.Parameter);
    if (target == undefined || !isValue) {
      return undefined;
    }

    const key = `${target.module} ${target.loc}`;
    const variable = this.record(target.module)?.variables.get(target.loc);
    if (variable != undefined && variable.isConst) {
      this.constKeys.add(key);
    }

    return key;
  }

  private pathFact(expr: Expr, module: int): Type | undefined {
    const key = this.pathKey(expr, module);
    if (key == undefined) {
      return undefined;
    }

    const fact = this.knownFact(key);
    if (fact != undefined) {
      return fact;
    }

    return this.unknownPrefix(key);
  }

  private unknownPrefix(key: string): Type | undefined {
    let dot = key.lastIndexOf(kDot);

    while (dot > 0) {
      const prefix = key.slice(0, dot);
      const fact = this.facts.get(prefix);
      if (fact != undefined && fact.kind == TypeKind.Error) {
        return fact;
      }

      dot = prefix.lastIndexOf(kDot);
    }

    return undefined;
  }

  private assignedTyped(expr: AssignExpr, module: int): Type {
    const target = expr.target;

    this.writtenTargets.add(target);

    if (this.logicalTargetCheck(expr, module)) {
      this.typed(expr.value, undefined, module);

      return this.store.plain(TypeKind.Error);
    }

    const isCompound = expr.op != undefined && expr.op != BinaryOp.Nullish;
    const isRefused =
      this.dictTargetCheck(target, module) ||
      this.unionTargetCheck(target, module) ||
      (isCompound && this.recordTargetCheck(target, module));
    if (isRefused) {
      this.typed(expr.value, undefined, module);

      return this.store.plain(TypeKind.Error);
    }
    if (expr.op != undefined && this.fieldReadEarly(target, module)) {
      this.typed(expr.value, undefined, module);
      this.fieldSetMark(target, module);

      return this.store.plain(TypeKind.Error);
    }

    const source = expr.value;
    const isMade =
      source.kind == ExprKind.Name && source.name.startsWith(kHiddenMark);
    if (target.kind == ExprKind.Index && !isMade) {
      this.arrayWriteCheck(target, expr.op != undefined, module);
    }

    const key = this.pathKey(target, module);
    const declared = this.assignedDeclared(target, module);
    const current = this.assignedCurrent(key, declared);

    if (declared == undefined || declared.kind == TypeKind.Error) {
      this.forgetPatterned(target, module);
      this.fieldSetMark(target, module);

      return this.store.plain(TypeKind.Error);
    }

    if (expr.op == BinaryOp.Nullish) {
      this.nullishTargetCheck(expr, declared, module);
    }
    const isOwnTarget = !this.isLibraryTarget(target, module);
    const tested = current ?? declared;

    this.decimalAssignCheck(expr, tested, module);

    if (isOwnTarget && this.compoundUndefinedCheck(expr, tested, module)) {
      this.typed(expr.value, undefined, module);

      return this.store.plain(TypeKind.Error);
    }
    if (expr.op == BinaryOp.LogOr || expr.op == BinaryOp.LogAnd) {
      const tested = current ?? declared;
      const use = this.assignUse(expr.op);

      this.checkTruthy(target, tested, use, expr.value, module);
    }

    const wanted = this.assignedWanted(expr.op, declared);
    const given = this.typed(expr.value, wanted, module);

    const isChecked =
      !this.isLibraryTarget(target, module) &&
      !this.isPlacedLiteral(target, given, module);
    if (wanted != undefined && isChecked) {
      this.coerce(expr.value, given, wanted, module, kNoPlace);
    }

    this.forgetPatterned(target, module);
    this.fieldSetMark(target, module);

    if (key == undefined) {
      return given;
    }

    const fact = this.assignedFact(expr.op, declared, current, given);

    this.forgetPath(key);
    this.forgetFieldsNamed(target);

    if (fact != undefined) {
      this.facts = this.withFact(this.facts, key, fact);
    }

    this.assignedBounds(expr, module);

    return given;
  }

  private tupleWriteCheck(target: IndexExpr, tuple: Type, module: int): void {
    const index = target.index;
    if (tuple.kind != TypeKind.Tuple || !tuple.readonly) {
      return;
    }
    if (index.kind != ExprKind.IntLit) {
      return;
    }

    this.report(module, target.loc, Code.ObjectReadOnlyField, {
      word: `${index.value}`,
      first: this.text.of(tuple),
    });
  }

  private compoundUndefinedCheck(
    expr: AssignExpr,
    tested: Type,
    module: int,
  ): boolean {
    const op = expr.op;
    const isArithmetic =
      op != undefined &&
      op != BinaryOp.LogOr &&
      op != BinaryOp.LogAnd &&
      op != BinaryOp.Nullish;
    const isMaybe =
      this.types.isOptional(tested) || tested.kind == TypeKind.Undefined;
    if (!isArithmetic || !isMaybe || op == undefined) {
      return false;
    }

    this.quiet += 1;

    const given = this.typed(expr.value, undefined, module);

    this.quiet -= 1;

    this.report(module, expr.loc, Code.OperandTypesUndefined, {
      first: this.text.of(tested),
      second: this.text.of(given),
      other: `${this.operatorText(op)}=`,
    });

    return true;
  }

  private logicalTargetCheck(expr: AssignExpr, module: int): boolean {
    const op = expr.op;
    const isLogical = op == BinaryOp.LogAnd || op == BinaryOp.LogOr;
    if (!isLogical || this.isSimpleTarget(expr.target)) {
      return false;
    }

    const word = this.logicalAssignWord(op == BinaryOp.LogAnd);

    this.report(module, expr.target.loc, Code.LogicalAssignSimple, { word });

    return true;
  }

  private logicalAssignWord(isAnd: boolean): string {
    if (isAnd) {
      return "&&=";
    }

    return "||=";
  }

  private isSimpleTarget(target: Expr): boolean {
    switch (target.kind) {
      case ExprKind.Name:
        return true;
      case ExprKind.Member:
        return !target.optional && this.isSimpleChain(target.object);
      case ExprKind.Index:
        return (
          !target.optional &&
          this.isSimpleChain(target.object) &&
          this.isSimpleChain(target.index)
        );
      default:
        return false;
    }
  }

  private isSimpleChain(expr: Expr): boolean {
    switch (expr.kind) {
      case ExprKind.Name:
      case ExprKind.IntLit:
      case ExprKind.StringLit:
        return true;
      case ExprKind.Member:
        return !expr.optional && this.isSimpleChain(expr.object);
      default:
        return false;
    }
  }

  private arrayWriteCheck(
    target: IndexExpr,
    isCompound: boolean,
    module: int,
  ): void {
    this.quiet += 1;

    const object = this.typed(target.object, undefined, module);

    this.quiet -= 1;

    const base = this.types.definedType(object);
    if (base.kind == TypeKind.Tuple) {
      return this.tupleWriteCheck(target, base, module);
    }
    if (base.kind != TypeKind.Array) {
      return;
    }

    this.writeIndexCheck(target, isCompound, module);
  }

  private assignUse(op: BinaryOp | undefined): TruthUse {
    if (op == BinaryOp.LogOr) {
      return TruthUse.OrAssign;
    }

    return TruthUse.AndAssign;
  }

  private assignedDeclared(target: Expr, module: int): Type | undefined {
    if (target.kind == ExprKind.Member) {
      return this.memberTargetDeclared(target, module);
    }
    if (target.kind != ExprKind.Name) {
      return undefined;
    }
    if (this.isThisName(target, module)) {
      this.report(module, target.loc, Code.ThisAssigned, kNoDetails);

      return undefined;
    }

    const found = this.targetOfName(target, module);
    if (found == undefined) {
      return undefined;
    }

    return this.declaredOf(found);
  }

  private fieldDeclared(target: MemberExpr, module: int): Type | undefined {
    const key = this.pathKey(target, module);
    if (key == undefined) {
      return undefined;
    }

    const before = this.facts;

    this.forgetPath(key);
    this.quiet += 1;

    const declared = this.typed(target, undefined, module);

    this.quiet -= 1;
    this.facts = before;

    return declared;
  }

  private isLibraryTarget(target: Expr, module: int): boolean {
    if (target.kind != ExprKind.Member) {
      return false;
    }

    this.quiet += 1;

    const object = this.typed(target.object, undefined, module);

    this.quiet -= 1;

    const isInstance =
      object.kind == TypeKind.Instance && this.isLibraryModule(object.module);

    return isInstance || this.resolver.isLibraryShape(object);
  }

  private assignedCurrent(
    key: string | undefined,
    declared: Type | undefined,
  ): Type | undefined {
    if (key == undefined) {
      return declared;
    }

    return this.knownFact(key) ?? declared;
  }

  private assignedWanted(
    op: BinaryOp | undefined,
    declared: Type | undefined,
  ): Type | undefined {
    const isPlain =
      op == undefined || op == BinaryOp.LogOr || op == BinaryOp.Nullish;
    if (!isPlain || declared == undefined) {
      return undefined;
    }
    if (declared.kind == TypeKind.Error) {
      return undefined;
    }

    return declared;
  }

  private assignedFact(
    op: BinaryOp | undefined,
    declared: Type,
    current: Type | undefined,
    given: Type,
  ): Type | undefined {
    const isDefaulting = op == BinaryOp.LogOr || op == BinaryOp.Nullish;

    if (declared.kind != TypeKind.Union) {
      return undefined;
    }
    if (isDefaulting && current != undefined) {
      return this.defaultedFact(declared, current, given);
    }
    if (op != undefined || given.kind == TypeKind.Error) {
      return undefined;
    }
    if (!this.relation.converts(given, declared)) {
      return undefined;
    }

    return given;
  }

  private defaultedFact(declared: Type, current: Type, given: Type): Type {
    const defined = this.types.definedType(current);
    const isKnown =
      given.kind != TypeKind.Error && this.relation.converts(given, declared);
    if (!isKnown) {
      return defined;
    }

    return this.store.unionOf([defined, given]);
  }

  private updatedTyped(target: Expr, module: int): Type {
    if (this.dictTargetCheck(target, module)) {
      return this.store.plain(TypeKind.Error);
    }
    if (target.kind == ExprKind.Index) {
      this.arrayWriteCheck(target, true, module);
    }
    if (this.recordTargetCheck(target, module)) {
      return this.store.plain(TypeKind.Error);
    }

    this.updateTargetCheck(target, module);

    const type = this.typed(target, undefined, module);
    const key = this.pathKey(target, module);
    if (key != undefined) {
      this.forgetPath(key);
    }

    return type;
  }

  private forgetPatterned(target: Expr, module: int): void {
    switch (target.kind) {
      case ExprKind.Name:
      case ExprKind.Member: {
        const key = this.pathKey(target, module);
        if (key != undefined) {
          this.forgetPath(key);
        }

        return;
      }
      case ExprKind.ArrayLit:
        for (const element of target.elements) {
          this.forgetPatterned(element.expr, module);
        }

        return;
      case ExprKind.ObjectLit:
        for (const property of target.props) {
          if (property.form.kind != PropertyKind.Computed) {
            this.forgetPatterned(property.value, module);
          }
        }

        return;
      case ExprKind.Assign:
        return this.forgetPatterned(target.target, module);
      default:
        return;
    }
  }

  private forgetPath(key: string): void {
    this.forgetFacts(key);
    this.forgetBounds(key, BoundSide.None);
  }

  private forgetFacts(key: string): void {
    const prefix = key + kDot;
    const kept = new Map<string, Type>();

    for (const [known, type] of this.facts) {
      if (known != key && !known.startsWith(prefix)) {
        kept.set(known, type);
      }
    }

    this.facts = kept;
  }

  private withFact(
    facts: Map<string, Type>,
    key: string,
    type: Type,
  ): Map<string, Type> {
    const copy = new Map<string, Type>(facts);

    copy.set(key, type);

    return copy;
  }

  private forgetLooped(statement: Stmt, module: int): void {
    const record = this.record(module);
    if (record == undefined) {
      return;
    }

    const scratch: ValueRecord = {
      uses: record.uses,
      hidden: record.hidden,
      variables: new Map<int, DeclaredVariable>(),
      functions: new Map<int, FunctionDecl>(),
      params: new Map<int, ParamSlot>(),
      assigned: new Set<int>(),
      changes: [],
      enums: record.enums,
      classes: record.classes,
      destinations: new Map<int, Destination[]>(),
      owners: [],
      reported: new Set<string>(),
      errors: [],
    };

    this.indexStatement(statement, scratch);

    for (const loc of scratch.assigned) {
      const side = this.loopDirection(scratch.changes, loc, module);
      const key = `${module} ${loc}`;

      this.forgetFacts(key);
      this.forgetBounds(key, side);
    }

    for (const change of scratch.changes) {
      this.forgetChangedPart(change, module);
    }
  }

  private forgetChangedPart(change: Expr, module: int): void {
    const target = this.changedTarget(change);
    if (target == undefined) {
      return;
    }
    if (target.kind == ExprKind.Member) {
      const key = this.pathKey(target, module);
      if (key != undefined) {
        this.forgetFacts(key);
      }

      return;
    }
    if (target.kind != ExprKind.Index) {
      return;
    }

    const key = this.pathKey(target.object, module);
    if (key != undefined) {
      this.forgetFacts(key);
    }
  }

  private branchesJoined(
    before: Map<string, Type>,
    thenStart: Map<string, Type>,
    thenEnd: Map<string, Type>,
    elseStart: Map<string, Type>,
    elseEnd: Map<string, Type>,
  ): Map<string, Type> {
    const joined = new Map<string, Type>(before);
    const keys = new Set<string>(thenEnd.keys());

    for (const key of elseEnd.keys()) {
      keys.add(key);
    }

    for (const key of before.keys()) {
      keys.add(key);
    }

    for (const key of keys) {
      const isThenChanged = thenEnd.get(key) != thenStart.get(key);
      const isElseChanged = elseEnd.get(key) != elseStart.get(key);
      if (!isThenChanged && !isElseChanged) {
        continue;
      }

      const thenType = thenEnd.get(key);
      const elseType = elseEnd.get(key);

      joined.delete(key);

      if (thenType != undefined && elseType != undefined) {
        const union = this.store.unionOf([thenType, elseType]);

        joined.set(key, union);
      }
    }

    return joined;
  }
}
