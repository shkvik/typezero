import { ExpressionTypes } from "../expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";
import {
  kAllSettledName,
  kAnyName,
  kPromiseStatics,
  kCatchName,
  kFinallyName,
  kPromiseClass,
  kPromisePlaceholder,
  kRejectName,
  kResultMethods,
  kThenName,
} from "../const/expression-types.const.tz";

partial class ExpressionTypes {
  private promiseMisuse(
    expr: CallExpr,
    member: MemberExpr,
    object: Type,
    module: int,
  ): boolean {
    const name = member.name;
    const loc = member.loc;

    switch (name) {
      case kCatchName:
        this.report(module, loc, Code.PromiseNoCatch, kNoDetails);
        this.looseArguments(expr.args, module);

        return true;
      case kFinallyName:
        this.report(module, loc, Code.PromiseNoFinally, kNoDetails);
        this.looseArguments(expr.args, module);

        return true;
      case kThenName:
        return this.thenTwoCheck(expr, module);
      default:
        if (this.resultOnPromiseCheck(expr, member, object, module)) {
          return true;
        }

        return this.promiseMissing(member, object, module);
    }
  }

  private resultOnPromiseCheck(
    expr: CallExpr,
    member: MemberExpr,
    object: Type,
    module: int,
  ): boolean {
    if (object.kind != TypeKind.Promise) {
      return false;
    }

    const value = this.definedType(object.value);
    const isMethod = kResultMethods.some((one) => one.name == member.name);
    if (value.kind != TypeKind.Result || !isMethod) {
      return false;
    }

    const holder = member.object;
    const other = this.promiseHolderText(holder);

    this.report(module, member.loc, Code.ResultMethodOnPromise, {
      word: member.name,
      other,
    });
    this.looseArguments(expr.args, module);

    return true;
  }

  private promiseHolderText(holder: Expr): string {
    if (holder.kind == ExprKind.Name) {
      return holder.name;
    }

    return kPromisePlaceholder;
  }

  private thenTwoCheck(expr: CallExpr, module: int): boolean {
    const second = expr.args[1];
    if (second == undefined) {
      return false;
    }

    this.report(module, second.expr.loc, Code.PromiseThenTwo, kNoDetails);
    this.looseArguments(expr.args, module);

    return true;
  }

  private promiseMissing(
    member: MemberExpr,
    object: Type,
    module: int,
  ): boolean {
    const receiver = this.libraryReceiver(object);
    if (receiver == undefined) {
      return false;
    }

    const found = this.receiverMember(receiver, member.name, true);
    if (found != undefined) {
      return false;
    }

    const word = member.name;
    const first = this.text.of(object);

    this.report(module, member.loc, Code.PromiseNoMethod, { word, first });

    return true;
  }

  private promiseStatic(member: MemberExpr, module: int): boolean {
    const object = member.object;
    if (object.kind != ExprKind.Name || object.name != kPromiseClass) {
      return false;
    }

    const target = this.targetOfName(object, module);
    if (target == undefined || !this.isLibraryModule(target.module)) {
      return false;
    }

    const loc = member.loc;

    switch (member.name) {
      case kRejectName:
        this.report(module, loc, Code.PromiseRejected, kNoDetails);

        return true;
      case kAllSettledName:
        this.report(module, loc, Code.PromiseAllSettled, kNoDetails);

        return true;
      case kAnyName:
        this.report(module, loc, Code.PromiseAny, kNoDetails);

        return true;
      default:
        return this.promiseMissingCheck(member, module);
    }
  }

  private promiseMissingCheck(member: MemberExpr, module: int): boolean {
    if (kPromiseStatics.includes(member.name)) {
      return false;
    }

    this.report(module, member.loc, Code.PromiseStaticRefused, {
      word: member.name,
    });

    return true;
  }
}
