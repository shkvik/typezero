import { ExpressionTypes } from "../expression-types.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";
import { UnifyAnswer } from "../types/expression-types.types.tz";

partial class ExpressionTypes {
  private unify(first: Type, second: Type): Type | undefined {
    const known = this.shortUnify(first, second);
    if (known.decided) {
      return known.type;
    }

    const plainFirst = this.definedType(first);
    const plainSecond = this.definedType(second);
    const isResults =
      plainFirst.kind == TypeKind.Result && plainSecond.kind == TypeKind.Result;
    if (isResults && plainFirst != plainSecond) {
      const result = this.resultUnify(plainFirst, plainSecond);

      return this.optionalLike(first, second, result);
    }

    const base = this.baseUnify(plainFirst, plainSecond);

    return this.optionalLike(first, second, base);
  }

  private unionUnify(first: Type, second: Type): Type | undefined {
    const common = this.unify(first, second);
    if (common != undefined) {
      return common;
    }

    return this.unionFallback(first, second);
  }

  private shortUnify(first: Type, second: Type): UnifyAnswer {
    if (first == second) {
      return this.decided(first);
    }
    if (first.kind == TypeKind.Error || second.kind == TypeKind.Error) {
      const error = this.store.plain(TypeKind.Error);

      return this.decided(error);
    }
    if (first.kind == TypeKind.Never) {
      return this.decided(second);
    }
    if (second.kind == TypeKind.Never) {
      return this.decided(first);
    }
    if (first.kind == TypeKind.Void || second.kind == TypeKind.Void) {
      return this.decided(undefined);
    }
    if (first.kind == TypeKind.Undefined) {
      const optional = this.optional(second);

      return this.decided(optional);
    }
    if (second.kind == TypeKind.Undefined) {
      const optional = this.optional(first);

      return this.decided(optional);
    }
    if (first.kind == TypeKind.Unknown || second.kind == TypeKind.Unknown) {
      const unknown = this.store.plain(TypeKind.Unknown);

      return this.decided(unknown);
    }

    const plainFirst = this.definedType(first);
    const plainSecond = this.definedType(second);
    if (this.isChoice(plainFirst) || this.isChoice(plainSecond)) {
      const wider = this.commonType(plainFirst, plainSecond);
      const unified = this.optionalLike(first, second, wider);

      return this.decided(unified);
    }

    const isText =
      plainFirst.kind == TypeKind.String && plainSecond.kind == TypeKind.String;
    if (isText) {
      const unified = this.optionalLike(first, second, plainFirst);

      return this.decided(unified);
    }

    return { decided: false };
  }

  private decided(type: Type | undefined): UnifyAnswer {
    return { decided: true, type };
  }

  private isChoice(type: Type): boolean {
    return type.kind == TypeKind.Literal || type.kind == TypeKind.Union;
  }

  private resultUnify(first: Type, second: Type): Type | undefined {
    if (first.kind != TypeKind.Result || second.kind != TypeKind.Result) {
      return undefined;
    }

    const value = this.halfUnify(first.value, second.value);
    const error = this.halfUnify(first.error, second.error);
    if (value == undefined || error == undefined) {
      return undefined;
    }

    return this.store.resultOf(value, error);
  }

  private halfUnify(first: Type, second: Type): Type | undefined {
    if (first == second || second.kind == TypeKind.Never) {
      return first;
    }
    if (first.kind == TypeKind.Never) {
      return second;
    }
    if (first.kind == TypeKind.Void || second.kind == TypeKind.Void) {
      return undefined;
    }

    const common = this.unionUnify(first, second);
    if (common == undefined || common.kind == TypeKind.Error) {
      return undefined;
    }

    return common;
  }

  private baseUnify(first: Type, second: Type): Type | undefined {
    if (first == second) {
      return first;
    }

    return (
      this.widerOfRelated(first, second) ??
      this.widerJson(first, second) ??
      this.commonParent(first, second) ??
      this.widerArray(first, second) ??
      this.settledPromise(first, second) ??
      this.commonAnyObject(first, second)
    );
  }

  private widerOfRelated(first: Type, second: Type): Type | undefined {
    const isNumbers = this.isNumberLike(first) && this.isNumberLike(second);
    const isObjects = this.isObjectKind(first) && this.isObjectKind(second);
    const isIterators =
      first.kind == TypeKind.Iterator && second.kind == TypeKind.Iterator;
    if (!isNumbers && !isObjects && !isIterators) {
      return undefined;
    }

    return this.commonType(first, second);
  }

  private widerJson(first: Type, second: Type): Type | undefined {
    if (first.kind != TypeKind.Json && second.kind != TypeKind.Json) {
      return undefined;
    }

    return this.commonType(second, first);
  }

  private commonParent(first: Type, second: Type): Type | undefined {
    if (first.kind != TypeKind.Instance || second.kind != TypeKind.Instance) {
      return undefined;
    }

    let current: Type | undefined = first;

    while (current != undefined) {
      if (this.relation.converts(second, current)) {
        return current;
      }

      current = this.baseClassOf(current);
    }

    return undefined;
  }

  private baseClassOf(type: Type): Type | undefined {
    const parents = this.store.parentsOf(type);

    return parents.find((parent) => parent.kind == TypeKind.Instance);
  }

  private widerArray(first: Type, second: Type): Type | undefined {
    if (first.kind != TypeKind.Array || second.kind != TypeKind.Array) {
      return undefined;
    }

    return this.commonType(first, second);
  }

  private settledPromise(first: Type, second: Type): Type | undefined {
    if (first.kind != TypeKind.Promise || second.kind != TypeKind.Promise) {
      return undefined;
    }
    if (first.value.kind == TypeKind.Never) {
      return second;
    }
    if (second.value.kind == TypeKind.Never) {
      return first;
    }

    return undefined;
  }

  private commonAnyObject(first: Type, second: Type): Type | undefined {
    const hasAnyObject =
      first.kind == TypeKind.AnyObject || second.kind == TypeKind.AnyObject;
    const isReferences =
      this.isObjectReference(first) && this.isObjectReference(second);
    if (!hasAnyObject || !isReferences) {
      return undefined;
    }

    return this.store.plain(TypeKind.AnyObject);
  }

  private unionFallback(first: Type, second: Type): Type | undefined {
    if (first.kind == TypeKind.Error || second.kind == TypeKind.Error) {
      return this.store.plain(TypeKind.Error);
    }
    if (first.kind == TypeKind.Void || second.kind == TypeKind.Void) {
      return undefined;
    }

    const plainFirst = this.definedType(first);
    const plainSecond = this.definedType(second);
    if (this.isNumberLike(plainFirst) && this.isNumberLike(plainSecond)) {
      return undefined;
    }

    const joined = this.store.unionOf([first, second]);
    const problem = this.resolver.unionProblem(joined);
    if (joined.kind == TypeKind.Error || problem != undefined) {
      return undefined;
    }

    return joined;
  }

  private commonType(first: Type, second: Type): Type | undefined {
    if (this.relation.converts(first, second)) {
      return second;
    }
    if (this.relation.converts(second, first)) {
      return first;
    }

    return undefined;
  }

  private optionalLike(
    first: Type,
    second: Type,
    base: Type | undefined,
  ): Type | undefined {
    if (base == undefined) {
      return undefined;
    }
    if (this.isOptional(first) || this.isOptional(second)) {
      return this.optional(base);
    }

    return base;
  }

  private isNumberLike(type: Type): boolean {
    switch (type.kind) {
      case TypeKind.Int:
      case TypeKind.Double:
      case TypeKind.Decimal:
        return true;
      default:
        return false;
    }
  }

  private isObjectKind(type: Type): boolean {
    switch (type.kind) {
      case TypeKind.Object:
      case TypeKind.Instance:
      case TypeKind.Tuple:
      case TypeKind.AnyObject:
        return true;
      default:
        return false;
    }
  }

  private isObjectReference(type: Type): boolean {
    switch (type.kind) {
      case TypeKind.Iterator:
      case TypeKind.Dict:
      case TypeKind.Promise:
        return true;
      case TypeKind.Union:
        return this.isObjectUnion(type.parts);
      default:
        return this.isObjectKind(type);
    }
  }

  private isObjectUnion(parts: Type[]): boolean {
    const first = parts[0];
    if (first == undefined || this.relation.isTagged(parts)) {
      return false;
    }

    const isHolder =
      first.kind == TypeKind.Dict || first.kind == TypeKind.Promise;

    return isHolder || this.isObjectKind(first);
  }

  private isOptional(type: Type): boolean {
    if (type.kind != TypeKind.Union) {
      return false;
    }

    return type.parts.some((part) => part.kind == TypeKind.Undefined);
  }

  private optional(type: Type): Type {
    const nothing = this.store.plain(TypeKind.Undefined);

    return this.store.unionOf([type, nothing]);
  }

  private definedType(type: Type): Type {
    const parts = this.definedParts(type);
    if (parts.length == 0) {
      return type;
    }

    return this.store.unionOf(parts);
  }

  private wantedPart(wanted: Type | undefined): Type | undefined {
    if (wanted == undefined) {
      return undefined;
    }

    return this.definedType(wanted);
  }
}
