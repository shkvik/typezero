import { ExpressionTypes } from "../expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import { Details } from "../../../../diagnostic/types/message.types.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import {
  LiteralKind,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import {
  kArgumentsCall,
  kBooleanName,
  kClassNoun,
  kDateName,
  kNumberName,
  kDecimalNoun,
  kLengthName,
  kMaybeSuffix,
  kNarrowedCodes,
  kNegation,
  kNumberNoun,
  kObjectNoun,
  kOtherPlaceholder,
  kPlainCall,
  kPromiseNoun,
  kTruthCodes,
  kUnnamedOperand,
} from "../const/expression-types.const.tz";
import {
  CallbackPlan,
  TruthCodes,
  TruthProblem,
  TruthUse,
} from "../types/expression-types.types.tz";

partial class ExpressionTypes {
  private checkTruthy(
    expr: Expr,
    type: Type,
    use: TruthUse,
    other: Expr | undefined,
    module: int,
    shown: string = "",
  ): boolean {
    if (type.kind == TypeKind.Void) {
      this.report(module, expr.loc, Code.VoidTested, kNoDetails);

      return false;
    }

    const base = this.apparent(this.definedType(type));

    const parameter = this.openParameterOf(type);
    if (parameter != undefined) {
      const word = this.shownWord(expr, shown);
      const first = this.text.of(type);
      const second = this.text.of(parameter);
      const tail = this.otherHint(other);
      const code = this.parameterTruthCode(use);

      this.report(module, expr.loc, code, {
        word,
        first,
        second,
        other: tail,
      });

      return false;
    }

    const problem = this.truthProblem(type, base);
    if (problem == TruthProblem.None) {
      return true;
    }

    const codes = kTruthCodes.find((row) => row.use == use);
    if (codes == undefined) {
      return false;
    }

    const word = this.shownWord(expr, shown);
    const otherText = this.otherHint(other);
    const truthCode = this.truthCode(problem, codes, type, base, use);
    const code = this.lengthCode(expr, truthCode);
    const narrowed = this.narrowedCode(expr, code, module);
    if (narrowed != undefined) {
      const first = this.holderNoun(base);

      this.report(module, expr.loc, narrowed, { word, first });

      return false;
    }

    const details = this.truthDetails(code, type, base, word, otherText, use);
    const shownCode = this.classNameCode(expr, code, base, module);

    this.report(module, expr.loc, shownCode, details);

    return false;
  }

  private shownWord(expr: Expr, shown: string): string {
    if (shown != "") {
      return shown;
    }

    return this.hintText(expr, kUnnamedOperand);
  }

  private booleanCallCheck(expr: CallExpr, module: int): void {
    const callee = expr.callee;
    const arg = expr.args[0];
    const isBoolean =
      callee.kind == ExprKind.Name &&
      callee.name == kBooleanName &&
      this.isGlobalUse(callee, module);
    if (!isBoolean || arg == undefined || expr.args.length != 1) {
      return;
    }

    this.quiet += 1;

    const type = this.typed(arg.expr, undefined, module);

    this.quiet -= 1;
    this.checkTruthy(arg.expr, type, TruthUse.Condition, undefined, module);
  }

  private numberCallCheck(expr: CallExpr, module: int): void {
    const callee = expr.callee;
    const arg = expr.args[0];
    const isNumber =
      callee.kind == ExprKind.Name &&
      callee.name == kNumberName &&
      this.isGlobalUse(callee, module);
    if (!isNumber || arg == undefined || expr.args.length != 1) {
      return;
    }

    this.quiet += 1;

    const type = this.typed(arg.expr, undefined, module);

    this.quiet -= 1;

    const code = this.numberSourceCode(type);
    if (code != undefined) {
      this.report(module, arg.expr.loc, code, { word: this.text.of(type) });
    }
  }

  private numberSourceCode(type: Type): Code | undefined {
    if (type.kind == TypeKind.Error) {
      return undefined;
    }
    if (this.isOptional(type) || type.kind == TypeKind.Undefined) {
      return Code.NumberOfUndefined;
    }

    const base = this.apparent(type);

    switch (base.kind) {
      case TypeKind.Int:
      case TypeKind.Double:
      case TypeKind.Decimal:
      case TypeKind.Boolean:
      case TypeKind.String:
      case TypeKind.Template:
      case TypeKind.Error:
      case TypeKind.TypeParameter:
        return undefined;
      case TypeKind.Instance:
        return this.dateSourceCode(base.name);
      default:
        return Code.NumberOfWrongType;
    }
  }

  private dateSourceCode(name: string): Code | undefined {
    if (name == kDateName) {
      return undefined;
    }

    return Code.NumberOfWrongType;
  }

  private booleanCallbackCheck(
    arg: Expr,
    plan: CallbackPlan,
    module: int,
  ): void {
    const isBoolean =
      arg.kind == ExprKind.Name &&
      arg.name == kBooleanName &&
      this.isGlobalUse(arg, module);
    const item = plan.params[0];
    if (!isBoolean || item == undefined) {
      return;
    }

    const use = TruthUse.Condition;

    this.checkTruthy(arg, item, use, undefined, module, kUnnamedOperand);
  }

  private narrowedCode(expr: Expr, code: Code, module: int): Code | undefined {
    const row = kNarrowedCodes.find((one) => one.code == code);
    if (row == undefined || expr.kind != ExprKind.Name) {
      return undefined;
    }

    const target = this.targetOfName(expr, module);
    if (target == undefined || this.factOf(target) == undefined) {
      return undefined;
    }

    const declared = this.declaredOf(target);
    if (declared == undefined || !this.isOptional(declared)) {
      return undefined;
    }

    return row.narrowed;
  }

  private holderNoun(base: Type): string {
    switch (base.kind) {
      case TypeKind.Array:
        return "an array";
      case TypeKind.Function:
        return "a function";
      case TypeKind.Promise:
        return "a Promise";
      case TypeKind.Class:
        return kClassNoun;
      default:
        return "an object";
    }
  }

  private isOpenParameter(type: Type): boolean {
    const isParameter = type.kind == TypeKind.TypeParameter;

    return isParameter && this.store.constraintOf(type) == undefined;
  }

  private openParameterOf(type: Type): Type | undefined {
    const base = this.definedType(type);
    const isParameter = base.kind == TypeKind.TypeParameter;
    if (!isParameter || this.store.constraintOf(base) != undefined) {
      return undefined;
    }

    return base;
  }

  private parameterTruthCode(use: TruthUse): Code {
    switch (use) {
      case TruthUse.Not:
        return Code.ParameterNot;
      case TruthUse.And:
        return Code.ParameterAnd;
      case TruthUse.Or:
        return Code.ParameterOr;
      case TruthUse.OrAssign:
        return Code.ParameterOrAssign;
      case TruthUse.AndAssign:
        return Code.ParameterAndAssign;
      default:
        return Code.ParameterCondition;
    }
  }

  private otherHint(other: Expr | undefined): string {
    if (other == undefined) {
      return kOtherPlaceholder;
    }

    return this.hintText(other, kOtherPlaceholder);
  }

  private truthProblem(type: Type, base: Type): TruthProblem {
    if (this.isTestable(type, base)) {
      return TruthProblem.None;
    }

    switch (base.kind) {
      case TypeKind.Union:
      case TypeKind.Literal:
        return this.unionTruthProblem(type, base);
      case TypeKind.Json:
        return TruthProblem.Json;
      case TypeKind.Unknown:
        return TruthProblem.Unknown;
      case TypeKind.Result:
        return TruthProblem.Result;
      case TypeKind.Int:
      case TypeKind.Double:
      case TypeKind.Decimal:
        return TruthProblem.Number;
      default:
        return TruthProblem.Truthy;
    }
  }

  private isTestable(type: Type, base: Type): boolean {
    const isPlain =
      type.kind == TypeKind.Undefined ||
      type.kind == TypeKind.Error ||
      base.kind == TypeKind.Error ||
      base.kind == TypeKind.Never ||
      base.kind == TypeKind.TypeParameter ||
      base.kind == TypeKind.Boolean ||
      base.kind == TypeKind.String ||
      base.kind == TypeKind.Template;
    if (isPlain) {
      return true;
    }

    return this.isOptional(type) && this.isHolder(base);
  }

  private isHolder(base: Type): boolean {
    switch (base.kind) {
      case TypeKind.Array:
      case TypeKind.Class:
      case TypeKind.Function:
      case TypeKind.Result:
      case TypeKind.Iterator:
      case TypeKind.Dict:
      case TypeKind.Promise:
        return true;
      default:
        return this.isObjectKind(base);
    }
  }

  private unionTruthProblem(type: Type, base: Type): TruthProblem {
    const number = this.unionNumber(base);
    const isFalsy = this.isOptional(type) || this.hasFalsyMember(base);

    if (number != undefined) {
      return TruthProblem.UnionNumber;
    }
    if (isFalsy) {
      return TruthProblem.None;
    }

    return TruthProblem.UnionTruthy;
  }

  private unionMembers(base: Type): Type[] {
    if (base.kind != TypeKind.Union) {
      return [base];
    }

    return base.parts;
  }

  private unionNumber(base: Type): Type | undefined {
    let number: Type | undefined = undefined;

    for (const member of this.unionMembers(base)) {
      if (this.isNumberMember(member)) {
        number = member;
      }
    }

    return number;
  }

  private isNumberMember(member: Type): boolean {
    const plain = this.relation.baseOf(member) ?? member;
    const isOpen =
      plain.kind == TypeKind.TypeParameter || plain.kind == TypeKind.Json;

    return this.isNumberLike(plain) || isOpen;
  }

  private hasFalsyMember(base: Type): boolean {
    return this.unionMembers(base).some((member) => this.isFalsyMember(member));
  }

  private isFalsyMember(member: Type): boolean {
    if (member.kind != TypeKind.Literal) {
      return member.kind == TypeKind.Boolean || member.kind == TypeKind.String;
    }
    if (member.literal == LiteralKind.String) {
      return member.text == "";
    }

    return member.text == "0";
  }

  private truthCode(
    problem: TruthProblem,
    codes: TruthCodes,
    type: Type,
    base: Type,
    use: TruthUse,
  ): Code {
    switch (problem) {
      case TruthProblem.UnionTruthy:
        return Code.UnionTruthy;
      case TruthProblem.UnionNumber:
        return Code.UnionNumberTruthy;
      case TruthProblem.Json:
        return codes.json;
      case TruthProblem.Unknown:
        return codes.unknown;
      case TruthProblem.Result:
        return this.resultTruthCode(use);
      case TruthProblem.Number:
        return this.numberTruthCode(codes, type, base);
      default:
        return this.objectTruthCode(codes, base);
    }
  }

  private lengthCode(expr: Expr, code: Code): Code {
    if (!this.isLength(expr)) {
      return code;
    }

    switch (code) {
      case Code.NumberCondition:
        return Code.LengthCondition;
      case Code.NumberAnd:
        return Code.LengthAnd;
      case Code.NumberOr:
        return Code.LengthOr;
      case Code.MaybeNumberCondition:
        return Code.MaybeLengthCondition;
      case Code.MaybeNumberNot:
        return Code.MaybeLengthNot;
      case Code.MaybeNumberAnd:
        return Code.MaybeLengthAnd;
      default:
        return code;
    }
  }

  private isLength(expr: Expr): boolean {
    if (expr.kind == ExprKind.OptionalChain) {
      return this.isLength(expr.chain);
    }

    return expr.kind == ExprKind.Member && expr.name == kLengthName;
  }

  private resultTruthCode(use: TruthUse): Code {
    if (use == TruthUse.Not) {
      return Code.ResultTruthyNot;
    }

    return Code.ResultTruthy;
  }

  private numberTruthCode(codes: TruthCodes, type: Type, base: Type): Code {
    if (this.isOptional(type)) {
      return codes.maybe;
    }
    if (base.kind == TypeKind.Double) {
      return codes.fraction;
    }

    return codes.number;
  }

  private objectTruthCode(codes: TruthCodes, base: Type): Code {
    if (base.kind == TypeKind.Array) {
      return codes.array;
    }
    if (this.isTruthyObject(base)) {
      return codes.object;
    }

    return codes.function;
  }

  private isTruthyObject(base: Type): boolean {
    switch (base.kind) {
      case TypeKind.Iterator:
      case TypeKind.Dict:
      case TypeKind.Promise:
      case TypeKind.Class:
        return true;
      default:
        return this.isObjectKind(base);
    }
  }

  private truthDetails(
    code: Code,
    type: Type,
    base: Type,
    word: string,
    other: string,
    use: TruthUse,
  ): Details {
    if (code == Code.UnionTruthy) {
      return { first: this.text.of(type) };
    }
    if (code == Code.UnionNumberTruthy) {
      return this.unionNumberDetails(type, base, word);
    }

    const first = this.truthNoun(type, base);
    const second = this.text.of(base);

    if (base.kind != TypeKind.Function) {
      return { first, second, word, other };
    }

    const call = this.callOf(base, word, use);

    return { first, second, word: call, other };
  }

  private unionNumberDetails(type: Type, base: Type, word: string): Details {
    const number = this.unionNumber(base);
    const first = this.text.of(type);

    if (number == undefined) {
      return { first, word };
    }

    const second = this.text.of(number);

    return { first, second, word };
  }

  private truthNoun(type: Type, base: Type): string {
    if (base.kind == TypeKind.Promise) {
      return kPromiseNoun;
    }
    if (base.kind == TypeKind.Class) {
      return kClassNoun;
    }
    if (!this.isNumberLike(base)) {
      return kObjectNoun;
    }

    const noun = this.numberNoun(base);

    if (!this.isOptional(type)) {
      return noun;
    }

    return noun + kMaybeSuffix;
  }

  private numberNoun(base: Type): string {
    if (base.kind == TypeKind.Decimal) {
      return kDecimalNoun;
    }

    return kNumberNoun;
  }

  private callOf(base: Type, word: string, use: TruthUse): string {
    const prefix = this.negationOf(use);

    if (this.minArguments(base) == 0) {
      return prefix + word + kPlainCall;
    }

    return prefix + word + kArgumentsCall;
  }

  private negationOf(use: TruthUse): string {
    if (use == TruthUse.Not) {
      return kNegation;
    }

    return "";
  }

  private minArguments(base: Type): int {
    if (base.kind != TypeKind.Function) {
      return 0;
    }

    const shape = base.shape;
    let count = 0;
    let index = 0;

    for (const param of shape.params) {
      const isRest = shape.rest && index == shape.params.length - 1;
      if (!param.optional && !isRest) {
        count += 1;
      }

      index += 1;
    }

    return count;
  }
}
