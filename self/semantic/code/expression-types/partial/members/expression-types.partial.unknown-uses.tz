import { ExpressionTypes } from "../../expression-types.tz";
import {
  CallExpr,
  Expr,
  IndexExpr,
  MemberExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";

partial class ExpressionTypes {
  private unknownMemberCheck(
    expr: MemberExpr,
    object: Type,
    module: int,
  ): boolean {
    const checked = this.objects.unknownMemberCheck(expr, object);

    this.reportFound(module, checked.error);

    return checked.value;
  }

  private unknownCallCheck(
    expr: CallExpr,
    member: MemberExpr,
    object: Type,
    module: int,
  ): boolean {
    if (!this.objects.isUnknownValue(object)) {
      return false;
    }

    const what = `method '${member.name}'`;

    this.looseArguments(expr.args, module);
    const unknownUseError = this.objects.unknownUseError(
      member.object,
      object,
      what,
    );

    this.reportFound(module, unknownUseError);

    return true;
  }

  private unknownIndexCheck(
    expr: IndexExpr,
    object: Type,
    module: int,
  ): boolean {
    if (!this.objects.isUnknownValue(object)) {
      return false;
    }

    this.walkedPart(expr.index, module);
    const unknownUseError = this.objects.unknownUseError(
      expr.object,
      object,
      "",
    );

    this.reportFound(module, unknownUseError);

    return true;
  }

  private unknownCheckText(expr: Expr, given: Type, wanted: Type): string {
    const shown = this.sources.operandName(expr);
    const only = this.types.onlyPart(wanted);
    const target = this.types.definedType(only);
    if (target.kind == TypeKind.Instance) {
      return `${shown} instanceof ${this.text.of(target)}`;
    }
    if (given.kind == TypeKind.AnyObject) {
      return `${shown} instanceof C`;
    }

    return this.typeofCheckText(shown, target);
  }

  private typeofCheckText(shown: string, target: Type): string {
    const base = this.types.apparent(target);

    switch (base.kind) {
      case TypeKind.Int:
      case TypeKind.Double:
      case TypeKind.Decimal:
        return `typeof ${shown} == "number"`;
      case TypeKind.Boolean:
        return `typeof ${shown} == "boolean"`;
      case TypeKind.Array:
        return `Array.isArray(${shown})`;
      case TypeKind.AnyObject:
        return `typeof ${shown} == "object"`;
      default:
        return `typeof ${shown} == "string"`;
    }
  }
}
