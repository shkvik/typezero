import { ExpressionTypes } from "../../expression-types.tz";
import {
  CallExpr,
  Expr,
  IndexExpr,
  MemberExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";

partial class ExpressionTypes {
  private unknownMemberCheck(
    expr: MemberExpr,
    object: Type,
    module: int,
  ): boolean {
    const checked = this.types.unknownMemberCheck(expr, object);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private unknownCallCheck(
    expr: CallExpr,
    member: MemberExpr,
    object: Type,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    if (!this.types.isUnknownValue(object)) {
      return false;
    }

    const what = `method '${member.name}'`;

    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args, module);
    const unknownUseError = this.types.unknownUseError(
      tree.exprOf(member.objectId),
      object,
      what,
    );

    this.errors.writeFound(module, unknownUseError);

    return true;
  }

  private unknownIndexCheck(
    expr: IndexExpr,
    object: Type,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    if (!this.types.isUnknownValue(object)) {
      return false;
    }

    const index = tree.exprOf(expr.indexId);

    this.walkedPart(index, module);
    const unknownUseError = this.types.unknownUseError(
      tree.exprOf(expr.objectId),
      object,
      "",
    );

    this.errors.writeFound(module, unknownUseError);

    return true;
  }

  private unknownCheckText(expr: Expr, given: Type, wanted: Type): string {
    const shown = this.types.operandName(expr);
    const only = this.types.onlyPart(wanted);
    const target = this.types.definedType(only);
    if (target.kind == TypeKind.Instance) {
      return `${shown} instanceof ${this.types.typeText(target)}`;
    }
    if (given.kind == TypeKind.AnyObject) {
      return `${shown} instanceof C`;
    }

    return this.typeofCheckText(shown, target);
  }

  private readonly typeofCheckText(shown: string, target: Type): string {
    const base = this.types.apparent(target);

    switch (base.kind) {
      case TypeKind.Int:
      case TypeKind.Double:
      case TypeKind.Decimal:
        return `typeof ${shown} == "number"`;
      case TypeKind.Boolean:
        return `typeof ${shown} == "boolean"`;
      case TypeKind.Array:
        return `Array.isArray(${shown})`;
      case TypeKind.AnyObject:
        return `typeof ${shown} == "object"`;
      default:
        return `typeof ${shown} == "string"`;
    }
  }
}
