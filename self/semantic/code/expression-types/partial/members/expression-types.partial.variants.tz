import { kErrnoHint, kErrnoName } from "../../const/expression-types.const.tz";
import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  BinaryExpr,
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Type,
  TypeKind,
  UnionType,
} from "../../../../../program/type/types/type.types.tz";

partial class ExpressionTypes {
  private variantMember(expr: MemberExpr, union: UnionType, module: int): Type {
    const isUnknown = this.types.store.partsOf(union).some(
      (part) => part.kind == TypeKind.Error || part.kind == TypeKind.Operation,
    );
    if (isUnknown) {
      return this.types.store.plain(TypeKind.Error);
    }

    const byteMember = this.byteUnionMember(expr, union, module);
    if (byteMember != undefined) {
      return byteMember;
    }

    const base = this.types.apparent(union);
    if (base.kind != TypeKind.Union) {
      return this.memberOf(expr, base, module);
    }

    const common = this.commonBaseWith(union, expr.name);
    if (common != undefined) {
      return this.memberOf(expr, common, module);
    }
    if (this.types.isTagged(this.types.store.partsOf(union))) {
      return this.reportValueMember(expr, union, module);
    }

    const types: Type[] = [];

    for (const part of this.types.store.partsOf(union)) {
      const found = this.variantField(expr, part, union, module);
      if (found == undefined) {
        return this.types.store.plain(TypeKind.Error);
      }
      if (!types.some((one) => one.id == found.id)) {
        types.push(found);
      }
    }

    const joined = this.types.store.unionOf(types);
    if (this.types.unionProblem(joined) != undefined) {
      return this.types.store.plain(TypeKind.Error);
    }

    return joined;
  }

  private reportValueMember(
    expr: MemberExpr,
    union: UnionType,
    module: int,
  ): Type {
    const checked = this.types.reportValueMember(expr, union);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private variantField(
    expr: MemberExpr,
    part: Type,
    union: UnionType,
    module: int,
  ): Type | undefined {
    if (part.kind != TypeKind.Object && part.kind != TypeKind.Instance) {
      return undefined;
    }
    if (part.kind == TypeKind.Instance) {
      const lookup = this.classMember(part, expr.name);
      if (!lookup.isKnown) {
        return undefined;
      }

      const entry = lookup.entry;
      const field = entry?.field;
      if (entry != undefined && field != undefined) {
        this.checkAccess(entry, field.access, expr, module);

        return this.fieldTypeOf(entry, field);
      }
    }

    const found = this.partField(part, expr.name);
    if (found != undefined) {
      return found;
    }

    this.reportLacking(expr, part, union, module);

    return undefined;
  }

  private partField(part: Type, name: string): Type | undefined {
    if (part.kind == TypeKind.Object) {
      const field = this.types.store
        .fieldsOf(part)
        .find((one) => one.name == name);
      if (field == undefined) {
        return undefined;
      }

      return this.types.fieldWanted(field);
    }
    if (part.kind != TypeKind.Instance) {
      return undefined;
    }

    const entryLookup = this.classMember(part, name);

    const entry = entryLookup.entry;
    const field = entry?.field;
    if (entry == undefined || field == undefined) {
      return undefined;
    }

    return this.fieldTypeOf(entry, field);
  }

  private reportLacking(
    expr: MemberExpr,
    part: Type,
    union: UnionType,
    module: int,
  ): void {
    const word = expr.name;
    const isPlain = this.types.store.partsOf(union).every(
      (one) =>
        one.kind == TypeKind.Object && this.partField(one, word) == undefined,
    );
    if (isPlain) {
      const first = this.types.typeText(union);
      const place = this.errnoHint(word);

      return this.errors.write(module, expr.loc, Code.UnionNoField, {
        word,
        first,
        place,
      });
    }

    const first = this.types.typeText(part);
    const second = this.types.typeText(union);
    const place = this.lackingHint(expr, union);

    this.errors.write(module, expr.loc, Code.UnionMayLack, {
      word,
      first,
      second,
      place,
    });
  }

  private lackingHint(expr: MemberExpr, union: UnionType): string {
    const first = this.types.store.partsOf(union)[0];
    let fallback = "";

    if (first != undefined && first.kind == TypeKind.Object) {
      for (const tag of this.types.store.fieldsOf(first)) {
        const hint = this.tagHint(expr, union, tag.name);
        if (hint != undefined && this.isTagUnique(expr, union, tag.name)) {
          return hint;
        }
        if (hint != undefined && fallback == "") {
          fallback = hint;
        }
      }
    }

    if (fallback != "") {
      return fallback;
    }

    return this.holderHint(expr, union);
  }

  private tagHint(
    expr: MemberExpr,
    union: UnionType,
    tagName: string,
  ): string | undefined {
    const tree = this.types.program.tree;

    if (!this.isTagField(union, tagName)) {
      return undefined;
    }

    const tag = this.holderTag(expr, union, tagName);
    if (tag == undefined) {
      return undefined;
    }

    const object = tree.exprOf(expr.objectId);
    const field = this.types.chainField(object, tagName);
    const shown = this.types.typeText(tag);

    return `, e.g. 'if (${field} == ${shown})'`;
  }

  private isTagField(union: UnionType, tagName: string): boolean {
    return this.types.store.partsOf(union).every((part) => {
      const type = this.partField(part, tagName);

      return type != undefined && this.types.isLiteralSet(type);
    });
  }

  private holderTag(
    expr: MemberExpr,
    union: UnionType,
    tagName: string,
  ): Type | undefined {
    for (const part of this.types.store.partsOf(union)) {
      const tag = this.partField(part, tagName);
      const holds = this.partField(part, expr.name) != undefined;
      if (holds && tag != undefined && tag.kind == TypeKind.Literal) {
        return tag;
      }
    }

    return undefined;
  }

  private isTagUnique(
    expr: MemberExpr,
    union: UnionType,
    tagName: string,
  ): boolean {
    const tag = this.holderTag(expr, union, tagName);
    if (tag == undefined) {
      return false;
    }

    for (const part of this.types.store.partsOf(union)) {
      const isLacking = this.partField(part, expr.name) == undefined;
      const set = this.partField(part, tagName);
      if (
        isLacking &&
        set != undefined &&
        this.types.holdsLiteral(set, tag)
      ) {
        return false;
      }
    }

    return true;
  }

  private holderHint(expr: MemberExpr, union: UnionType): string {
    const holders = this.types.store.partsOf(union).filter(
      (part) => this.partField(part, expr.name) != undefined,
    );
    const holder = holders[holders.length - 1];
    if (holder == undefined) {
      return "";
    }
    if (holder.kind == TypeKind.Instance) {
      return `, e.g. 'if (x instanceof ${this.types.typeText(holder)})'`;
    }

    return `, e.g. 'if ("${expr.name}" in x)'`;
  }

  private commonBaseWith(union: UnionType, name: string): Type | undefined {
    const isAllClasses = this.types.store.partsOf(union).every(
      (part) => part.kind == TypeKind.Instance,
    );
    const first = this.types.store.partsOf(union)[0];
    if (!isAllClasses || first == undefined) {
      return undefined;
    }

    const chain: Type[] = [first];

    for (let index = 0; index < chain.length; index++) {
      const candidate = chain[index];
      if (candidate == undefined) {
        break;
      }
      if (this.isCommonBase(candidate, union, name)) {
        return candidate;
      }

      for (const parent of this.types.store.parentsOf(candidate)) {
        if (!chain.some((one) => one.id == parent.id)) {
          chain.push(parent);
        }
      }
    }

    return undefined;
  }

  private lackingVariantCheck(
    expr: CallExpr,
    member: MemberExpr,
    union: UnionType,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const lacking = this.types.store.partsOf(union).find((part) =>
      this.isLackingMethod(part, member.name),
    );
    if (lacking == undefined) {
      return;
    }

    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args, module);
    this.errors.write(module, member.loc, Code.VariantLacksMethod, {
      word: this.types.typeText(union),
      first: this.types.typeText(lacking),
      other: member.name,
    });
  }

  private readonly isLackingMethod(part: Type, name: string): boolean {
    if (
      part.kind != TypeKind.Instance ||
      this.types.isLibraryModule(part.module)
    ) {
      return false;
    }

    const lookup = this.classMember(part, name);

    return lookup.entry == undefined;
  }

  private unionInCheck(
    expr: BinaryExpr,
    name: string,
    union: UnionType,
    module: int,
  ): void {
    const parts = this.types.store.partsOf(union);
    const isObjects = parts.every(
      (part) =>
        part.kind == TypeKind.Object && !this.types.isLibraryShape(part),
    );
    if (!isObjects) {
      return;
    }

    const having = parts.filter((part) =>
      this.types.hasFieldNamed(part, name),
    );
    const first = this.types.typeText(union);
    if (having.length == parts.length) {
      this.errors.write(module, expr.loc, Code.InUnionTrue, {
        word: name,
        first,
      });
    }
    if (having.length == 0) {
      this.errors.write(module, expr.loc, Code.InUnionFalse, {
        word: name,
        first,
      });
    }
  }

  private unionTargetCheck(target: Expr, module: int): boolean {
    const tree = this.types.program.tree;

    if (target.kind != ExprKind.Member) {
      return false;
    }

    const objectExpr = tree.exprOf(target.objectId);
    const object = this.peekType(objectExpr, module);

    if (object.kind != TypeKind.Union || this.types.isOptional(object)) {
      return false;
    }

    const types: Type[] = [];

    for (const part of this.types.store.partsOf(object)) {
      const field = this.ownFieldType(part, target.name);
      if (field == undefined) {
        return false;
      }
      if (!types.some((one) => one.id == field.id)) {
        types.push(field);
      }
    }

    const first = types[0];
    const second = types[1];
    if (first == undefined || second == undefined) {
      return false;
    }

    this.errors.write(module, target.loc, Code.UnionFieldsDiffer, {
      word: this.types.typeText(object),
      other: target.name,
      first: this.types.typeText(first),
      second: this.types.typeText(second),
    });

    return true;
  }

  private readonly ownFieldType(part: Type, name: string): Type | undefined {
    if (part.kind != TypeKind.Object || this.types.isLibraryShape(part)) {
      return undefined;
    }

    return this.types.store.fieldsOf(part).find((field) => field.name == name)
      ?.type;
  }

  private isCommonBase(
    candidate: Type,
    union: UnionType,
    name: string,
  ): boolean {
    const isShared = this.types.store.partsOf(union).every((part) =>
      this.types.converts(part, candidate),
    );
    if (!isShared) {
      return false;
    }
    if (candidate.kind == TypeKind.Object) {
      return this.types.store
        .fieldsOf(candidate)
        .some((field) => field.name == name);
    }
    if (candidate.kind != TypeKind.Instance) {
      return false;
    }

    const entryLookup = this.classMember(candidate, name);

    const entry = entryLookup.entry;

    return entry != undefined && !entry.isStatic;
  }

  private readonly errnoHint(word: string): string {
    if (word == kErrnoName) {
      return kErrnoHint;
    }

    return "";
  }
}
