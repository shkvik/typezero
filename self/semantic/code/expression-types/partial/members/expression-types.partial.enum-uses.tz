import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { IndexExpr } from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  LiteralKind,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { EnumHome } from "../../../../types/type-resolver/types/type-resolver.types.tz";

partial class ExpressionTypes {
  private enumIndexed(expr: IndexExpr, home: EnumHome, module: int): Type {
    const tree = this.types.program.tree;

    const whole = this.types.store.integer(64, false);
    const indexExpr = tree.exprOf(expr.indexId);
    const index = this.typed(indexExpr, whole, module);
    const error = this.types.store.plain(TypeKind.Error);
    if (index.kind == TypeKind.Error) {
      return error;
    }

    const decl = home.decl;
    const values = this.types.declaredEnum(home.module, decl);
    if (values.kind != TypeKind.Int) {
      this.errors.write(module, expr.loc, Code.EnumStringIndex, {
        word: decl.name,
      });

      return error;
    }

    const base = this.types.apparent(index);
    if (base.kind != TypeKind.Int) {
      this.errors.write(
        module,
        tree.exprOf(expr.indexId).loc,
        Code.EnumIndexNotInteger,
        {
          word: this.types.typeText(index),
        },
      );

      return error;
    }

    return this.enumNameType(expr, home, whole, module);
  }

  private enumNameType(
    expr: IndexExpr,
    home: EnumHome,
    whole: Type,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const index = tree.exprOf(expr.indexId);
    const value = this.intConstant(index, whole, module);
    const text = this.types.store.plain(TypeKind.String);
    if (value == undefined) {
      const nothing = this.types.store.plain(TypeKind.Undefined);

      return this.types.store.unionOf([text, nothing]);
    }

    const name = this.memberNamed(home, value);
    if (name == undefined) {
      return this.types.store.plain(TypeKind.Undefined);
    }

    return this.types.store.literal(LiteralKind.String, name);
  }

  private memberNamed(home: EnumHome, value: decimal): string | undefined {
    const tree = this.types.program.tree;

    let found: string | undefined = undefined;

    for (const member of tree.enumMembersOf(home.decl.membersList)) {
      const step = this.types.enumMember(
        home.module,
        home.decl,
        member.name,
      );
      const number = step?.number;
      if (number != undefined && decimal(number) == value) {
        found = member.name;
      }
    }

    return found;
  }
}
