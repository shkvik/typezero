import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { EnumDecl } from "../../../../../program/ast/types/ast.types.classes.tz";
import {
  Expr,
  ExprKind,
  MemberExpr,
  OptionalChainExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import {
  LiteralKind,
  ObjectType,
  TupleType,
  Type,
  TypeKind,
  UnionType,
} from "../../../../../program/type/types/type.types.tz";
import { EnumHome } from "../../../../types/type-resolver/types/type-resolver.types.tz";
import { LiteralValue } from "../../types/expression-types.types.tz";
import {
  kCryptoName,
  kGlobalThisName,
} from "../../const/expression-types.const.tz";

partial class ExpressionTypes {
  private memberTyped(expr: MemberExpr, module: int): Type {
    const tree = this.types.program.tree;

    const isRefused =
      this.thisPlaceCheck(expr, module) || this.superReadCheck(expr, module);
    if (isRefused || this.memberReadEarly(expr, module)) {
      return this.types.store.plain(TypeKind.Error);
    }
    if (this.nodeMemberReadCheck(expr, module)) {
      return this.types.store.plain(TypeKind.Error);
    }

    const fact = this.pathFact(expr, module);
    if (fact != undefined) {
      const objectExpr = tree.exprOf(expr.objectId);

      this.objectAnswered(objectExpr, module);

      return fact;
    }

    const exprObject = tree.exprOf(expr.objectId);
    const home = this.enumHomeOf(exprObject, module);
    if (home != undefined) {
      return this.enumMemberTyped(expr, home, module);
    }
    if (this.isDateName(tree.exprOf(expr.objectId), module)) {
      return this.dateStaticRead(expr, module);
    }
    if (this.isDecimalName(tree.exprOf(expr.objectId), module)) {
      return this.decimalStaticRead(expr, module);
    }
    if (this.isRegExpName(tree.exprOf(expr.objectId), module)) {
      return this.regExpStaticRead(expr, module);
    }

    const globalCrypto = this.globalCryptoRead(expr, module);
    if (globalCrypto != undefined) {
      return globalCrypto;
    }

    const globalThisValue = this.globalThisRead(expr, module);
    if (globalThisValue != undefined) {
      return globalThisValue;
    }

    const performanceValue = this.performanceRead(expr, module);
    if (performanceValue != undefined) {
      return performanceValue;
    }

    const owner = this.staticOwner(tree.exprOf(expr.objectId), module);
    if (owner != undefined) {
      return this.staticMemberTyped(expr, owner, module);
    }

    const object = this.receiverOf(
      tree.exprOf(expr.objectId),
      expr.optional,
      module,
    );
    if (this.dictMemberCheck(expr, object, false, module)) {
      return this.types.store.plain(TypeKind.Error);
    }
    if (this.rawTextsCheck(expr, object, module)) {
      return this.types.store.plain(TypeKind.Error);
    }

    return this.memberOf(expr, object, module);
  }

  private chainTyped(
    expr: OptionalChainExpr,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const before = this.shortCircuits;
    const chain = tree.exprOf(expr.chainId);
    const inner = this.typed(chain, wanted, module);
    const isShort = this.shortCircuits > before;

    this.shortCircuits = before;

    if (!isShort || inner.kind == TypeKind.Error) {
      return inner;
    }

    return this.types.optional(inner);
  }

  private receiverOf(object: Expr, optional: boolean, module: int): Type {
    this.memberObjects.add(object.id);
    this.markThisObject(object, module);

    const type = this.typed(object, undefined, module);

    return this.linkOf(type, optional);
  }

  private linkOf(type: Type, optional: boolean): Type {
    if (!optional || !this.types.isOptional(type)) {
      return type;
    }

    this.shortCircuits += 1;

    return this.types.definedType(type);
  }

  private memberOf(expr: MemberExpr, object: Type, module: int): Type {
    if (this.unknownMemberCheck(expr, object, module)) {
      return this.types.store.plain(TypeKind.Error);
    }
    if (this.readlineMemberRead(expr, object, module)) {
      return this.types.store.plain(TypeKind.Error);
    }
    if (this.fsConstantCheck(expr, module)) {
      return this.types.store.plain(TypeKind.Error);
    }
    const processStream = this.processStreamTyped(expr, module);
    if (processStream != undefined) {
      return processStream;
    }
    if (this.processMemberRead(expr, module)) {
      return this.types.store.plain(TypeKind.Error);
    }
    if (this.emitterMethodValueCheck(expr, object, module)) {
      return this.types.store.plain(TypeKind.Error);
    }

    const keyed = this.types.recordMemberTyped(expr, object);
    if (keyed != undefined) {
      return keyed;
    }

    const matched = this.matchMemberRead(expr, object, module);
    if (matched != undefined) {
      return matched;
    }

    switch (object.kind) {
      case TypeKind.Union:
        return this.unionMemberOf(expr, object, module);
      case TypeKind.TypeParameter:
        return this.parameterMemberOf(expr, object, module);
      case TypeKind.Object:
        return this.objectField(expr, object, module);
      case TypeKind.Class:
        return this.classValueMember(expr, object, module);
      case TypeKind.Tuple:
        return this.tupleMember(expr, object, module);
      case TypeKind.Instance:
        return this.instanceMember(expr, object, module);
      case TypeKind.Result:
        return this.resultMemberRead(expr, object, module);
      case TypeKind.Json:
        return this.types.optional(object);
      case TypeKind.Dict:
      case TypeKind.Promise:
        return this.libraryMemberTyped(expr, object, module);
      case TypeKind.Literal: {
        const base = this.types.apparent(object);

        return this.valueMember(expr, base, module);
      }
      case TypeKind.String:
      case TypeKind.Template:
      case TypeKind.Array:
      case TypeKind.Iterator:
      case TypeKind.Int:
      case TypeKind.Double:
      case TypeKind.Decimal:
      case TypeKind.Boolean:
      case TypeKind.Function:
        return this.valueMember(expr, object, module);
      default:
        return this.types.store.plain(TypeKind.Error);
    }
  }

  private unionMemberOf(
    expr: MemberExpr,
    object: UnionType,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    if (!this.types.isOptional(object)) {
      return this.variantMember(expr, object, module);
    }

    const defined = this.types.definedType(object);
    if (defined.kind == TypeKind.Json) {
      return this.types.optional(defined);
    }
    if (defined.kind != TypeKind.Error) {
      this.errors.write(
        module,
        tree.exprOf(expr.objectId).loc,
        Code.ReadOfUndefined,
        {
          word: expr.name,
        },
      );
    }

    return this.types.store.plain(TypeKind.Error);
  }

  private parameterMemberOf(expr: MemberExpr, object: Type, module: int): Type {
    const constraint = this.types.store.constraintOf(object);
    if (constraint == undefined) {
      const word = expr.name;
      const first = this.types.typeText(object);

      this.errors.write(module, expr.loc, Code.PropertyMissing, {
        word,
        first,
      });

      return this.types.store.plain(TypeKind.Error);
    }

    return this.memberOf(expr, constraint, module);
  }

  private objectField(expr: MemberExpr, object: ObjectType, module: int): Type {
    const fields = this.types.store
      .fieldsOf(object)
      .filter((one) => one.name == expr.name);
    const field = fields[0];
    const isLibrary = this.types.isLibraryShape(object);
    const isData = this.types.store
      .fieldsOf(object)
      .every((one) => one.type.kind != TypeKind.Function);
    if (field == undefined && isLibrary && !isData) {
      this.namespaceReadCheck(expr, module);

      return this.types.store.plain(TypeKind.Error);
    }
    if (field == undefined) {
      const missingFieldError = this.types.missingFieldError(expr, object);

      this.errors.writeFound(module, missingFieldError);

      return this.types.store.plain(TypeKind.Error);
    }

    const type = this.types.fieldWanted(field);
    const isMethod =
      type.kind == TypeKind.Function &&
      this.types.store.selfTypeOf(type) == undefined;
    if (isLibrary && isMethod) {
      return this.types.store.plain(TypeKind.Error);
    }
    if (fields.length > 1) {
      this.signatureValueCheck(expr, fields, module);

      return this.types.store.plain(TypeKind.Error);
    }

    return type;
  }

  private tupleMember(expr: MemberExpr, tuple: TupleType, module: int): Type {
    const checked = this.types.objectMemberTupleMember(expr, tuple);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private valueMember(expr: MemberExpr, object: Type, module: int): Type {
    const checked = this.types.valueMember(expr, object);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private readonly enumOfObject(
    object: Expr,
    module: int,
  ): EnumDecl | undefined {
    return this.enumHomeOf(object, module)?.decl;
  }

  private readonly enumHomeOf(object: Expr, module: int): EnumHome | undefined {
    if (object.kind != ExprKind.Name) {
      return undefined;
    }

    const target = this.targetOfName(object, module);
    if (target == undefined || target.kind != SymbolKind.Enum) {
      return undefined;
    }

    const decl = this.record(target.module)?.enums.get(target.loc);
    if (decl == undefined) {
      return undefined;
    }

    return { module: target.module, decl };
  }

  private objectAnswered(object: Expr, module: int): void {
    if (this.answers.isVisited(object)) {
      return;
    }

    this.errors.beginTrial();
    this.typed(object, undefined, module);
    this.errors.endTrial();
  }

  private enumMemberTyped(expr: MemberExpr, home: EnumHome, module: int): Type {
    const step = this.types.enumMember(home.module, home.decl, expr.name);
    if (step == undefined) {
      this.errors.write(module, expr.loc, Code.EnumMemberMissing, {
        word: expr.name,
        other: home.decl.name,
      });
    }

    return this.types.store.plain(TypeKind.Error);
  }

  private enumLiteral(expr: MemberExpr, module: int): LiteralValue | undefined {
    const tree = this.types.program.tree;

    const object = tree.exprOf(expr.objectId);
    const home = this.enumHomeOf(object, module);
    if (home == undefined) {
      return undefined;
    }

    const step = this.types.enumMember(home.module, home.decl, expr.name);
    if (step == undefined) {
      return undefined;
    }

    const type = step.type;
    if (type.kind != TypeKind.Literal) {
      return undefined;
    }
    if (type.literal == LiteralKind.String) {
      return this.types.plainLiteral(LiteralKind.String, type.text);
    }

    const number = step.number;
    if (number == undefined) {
      return undefined;
    }

    return this.types.wholeLiteral(number);
  }

  private enumConstant(expr: MemberExpr, module: int): decimal | undefined {
    const literal = this.enumLiteral(expr, module);
    if (literal == undefined || literal.kind != LiteralKind.Int) {
      return undefined;
    }

    const value = decimal(literal.text);
    if (value.isErr()) {
      return undefined;
    }

    return value.value;
  }

  private enumWhole(expr: MemberExpr, module: int): Type {
    const tree = this.types.program.tree;

    const object = tree.exprOf(expr.objectId);
    const home = this.enumHomeOf(object, module);
    if (home == undefined) {
      return this.types.store.plain(TypeKind.String);
    }

    return this.types.declaredEnum(home.module, home.decl);
  }

  private globalThisRead(expr: MemberExpr, module: int): Type | undefined {
    const tree = this.types.program.tree;

    const object = tree.exprOf(expr.objectId);
    const isGlobal =
      object.kind == ExprKind.Name &&
      object.name == kGlobalThisName &&
      this.isGlobalUse(object, module);
    if (!isGlobal || expr.name == kCryptoName) {
      return undefined;
    }

    this.errors.write(module, expr.loc, Code.GlobalThisMember, {
      word: expr.name,
    });

    return this.types.store.plain(TypeKind.Error);
  }
}
