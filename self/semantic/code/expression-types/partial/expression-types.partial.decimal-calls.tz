import { ExpressionTypes } from "../expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import {
  AssignExpr,
  BinaryOp,
  CallArgument,
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  NameExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import {
  LiteralKind,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import { DecimalText } from "../../../library/decimal-text/decimal-text.tz";
import {
  kDecimalError,
  kDecimalMethods,
  kDecimalName,
  kDecimalReplacements,
  kDecimalStatics,
  kMathName,
  kNoPlace,
  kRoundingModes,
} from "../const/expression-types.const.tz";
import {
  DecimalArgument,
  DecimalMethod,
  DecimalResult,
} from "../types/expression-types.types.tz";

partial class ExpressionTypes {
  private isDecimalName(expr: Expr, module: int): boolean {
    if (expr.kind != ExprKind.Name || expr.name != kDecimalName) {
      return false;
    }

    return this.isGlobalUse(expr, module);
  }

  private decimalType(): Type {
    return this.store.plain(TypeKind.Decimal);
  }

  private decimalOfCall(expr: CallExpr, callee: NameExpr, module: int): Type {
    const error = this.store.plain(TypeKind.Error);
    const arg = expr.args[0]?.expr;
    if (arg == undefined || expr.args.length != 1) {
      this.report(module, callee.loc, Code.ArgumentCount, {
        word: this.argumentCountText(1, 1, false),
        other: `${expr.args.length}`,
      });

      return error;
    }

    const hint = this.decimalOfHint(arg);
    const type = this.typed(arg, hint, module);
    const base = this.types.apparent(this.types.definedType(type));
    if (type.kind == TypeKind.Error) {
      return error;
    }
    if (this.isTextType(type)) {
      return this.decimalOfText(arg, type, module);
    }

    const isNumber =
      base.kind == TypeKind.Int ||
      base.kind == TypeKind.Double ||
      base.kind == TypeKind.Decimal;
    if (isNumber && !this.types.isOptional(type)) {
      return this.decimalType();
    }

    this.report(module, arg.loc, Code.DecimalOfType, {
      word: this.text.of(type),
      place: this.maybePlace(this.types.isOptional(type)),
    });

    return error;
  }

  private decimalOfHint(arg: Expr): Type | undefined {
    const isLiteral =
      arg.kind == ExprKind.IntLit || arg.kind == ExprKind.FloatLit;
    if (isLiteral) {
      return this.decimalType();
    }

    return undefined;
  }

  private maybePlace(isOptional: boolean): string {
    if (isOptional) {
      return "; the value may be undefined: check it first or give a default with '??'";
    }

    return "";
  }

  private isTextType(type: Type): boolean {
    if (this.types.isOptional(type)) {
      return false;
    }

    const base = this.types.apparent(type);
    if (base.kind == TypeKind.String || base.kind == TypeKind.Template) {
      return true;
    }
    if (type.kind != TypeKind.Union) {
      return false;
    }

    return type.parts.every(
      (part) =>
        part.kind == TypeKind.Literal && part.literal == LiteralKind.String,
    );
  }

  private decimalOfText(arg: Expr, type: Type, module: int): Type {
    const texts = this.knownTextsOf(arg, type, module);
    if (texts == undefined) {
      const failure = this.resolver.libraryShape(kDecimalError, []);
      if (failure == undefined) {
        return this.store.plain(TypeKind.Error);
      }

      return this.store.resultOf(this.decimalType(), failure);
    }

    const reader = new DecimalText();
    const wrong = texts.find((text) => !reader.isNumber(text));
    if (wrong != undefined) {
      this.report(module, arg.loc, Code.DecimalNotNumber, { word: wrong });

      return this.store.plain(TypeKind.Error);
    }

    return this.decimalType();
  }

  private knownTextsOf(
    arg: Expr,
    type: Type,
    module: int,
  ): string[] | undefined {
    if (arg.kind == ExprKind.StringLit) {
      return [arg.value];
    }
    if (arg.kind == ExprKind.Template && arg.exprs.length == 0) {
      return arg.quasis.slice(0, 1);
    }
    if (type.kind == TypeKind.Literal && type.literal == LiteralKind.String) {
      return [type.text];
    }
    if (type.kind == TypeKind.Union && this.isTextType(type)) {
      return type.parts.map((part) => this.literalPartText(part));
    }
    if (arg.kind == ExprKind.Name) {
      return this.doorOfName(arg, module)?.texts;
    }
    if (arg.kind == ExprKind.Conditional) {
      const first = this.branchTexts(arg.cond, arg.thenExpr, true, module);
      const second = this.branchTexts(arg.cond, arg.elseExpr, false, module);
      if (first == undefined || second == undefined) {
        return undefined;
      }

      return first.concat(second);
    }

    return undefined;
  }

  private branchTexts(
    cond: Expr,
    branch: Expr,
    isTrue: boolean,
    module: int,
  ): string[] | undefined {
    this.quiet += 1;

    const facts = this.factsOf(cond, isTrue, module);
    const before = this.underFacts(facts);
    const type = this.typed(branch, undefined, module);
    const texts = this.knownTextsOf(branch, type, module);

    this.facts = before;
    this.quiet -= 1;

    return texts;
  }

  private literalPartText(part: Type): string {
    if (part.kind == TypeKind.Literal) {
      return part.text;
    }

    return "";
  }

  private decimalStaticCall(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): Type | undefined {
    if (!this.isDecimalName(member.object, module)) {
      return undefined;
    }

    const error = this.store.plain(TypeKind.Error);
    const name = member.name;
    if (!kDecimalStatics.includes(name)) {
      this.decimalStaticMissing(member, module);
      this.looseArguments(expr.args, module);

      return error;
    }

    let isFitting = true;
    let hasValue = false;

    for (const arg of expr.args) {
      if (!arg.spread) {
        this.checked(arg.expr, this.decimalType(), module, kNoPlace);

        hasValue = true;

        continue;
      }

      const isSpread = this.decimalSpreadCheck(arg, module);

      isFitting = isFitting && isSpread;
      hasValue = hasValue || this.isFilledSource(arg.expr, module);
    }

    if (!isFitting) {
      return error;
    }

    const isSum = name == "sum";
    if (expr.args.length == 0 && !isSum) {
      this.report(module, member.loc, Code.DecimalNoValue, { word: name });

      return error;
    }
    if (hasValue || isSum) {
      return this.decimalType();
    }

    return this.types.optional(this.decimalType());
  }

  private decimalSpreadCheck(arg: CallArgument, module: int): boolean {
    const list = this.store.arrayOf(this.decimalType());
    const type = this.typed(arg.expr, list, module);
    if (type == list || type.kind == TypeKind.Error) {
      return true;
    }

    this.report(module, arg.expr.loc, Code.DecimalSpreadNotDecimals, {
      word: this.text.of(type),
    });

    return false;
  }

  private decimalStaticMissing(member: MemberExpr, module: int): void {
    const name = member.name;

    this.report(module, member.loc, Code.DecimalStaticMissing, {
      word: name,
      place: this.decimalStaticHint(name),
    });
  }

  private decimalStaticHint(name: string): string {
    if (name == "maximum" || name == "minimum") {
      return `; use 'decimal.${name.slice(0, 3)}'`;
    }
    if (name == "config" || name == "set") {
      return ": there are no settings for all decimals; division takes its places and rounding as arguments, 'a.div(b, places, mode)'";
    }

    return "";
  }

  private decimalStaticRead(expr: MemberExpr, module: int): Type {
    if (kDecimalStatics.includes(expr.name)) {
      this.report(module, expr.loc, Code.DecimalFunctionRead, {
        word: expr.name,
      });
    } else {
      this.decimalStaticMissing(expr, module);
    }

    return this.store.plain(TypeKind.Error);
  }

  private decimalMethodCall(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): Type {
    const error = this.store.plain(TypeKind.Error);
    const name = member.name;
    const method = kDecimalMethods.find((one) => one.name == name);
    if (method == undefined) {
      this.report(module, member.loc, Code.DecimalMethodMissing, {
        word: name,
        place: this.decimalMissingHint(name),
      });
      this.looseArguments(expr.args, module);

      return error;
    }

    const count = expr.args.length;
    if (name == "decimalPlaces" && count > 0) {
      this.report(module, member.loc, Code.DecimalPlacesOnly, kNoDetails);
      this.looseArguments(expr.args, module);

      return error;
    }
    if (count < method.least || count > method.most) {
      this.report(module, member.loc, Code.ArgumentCount, {
        word: this.argumentCountText(method.least, method.most, false),
        other: `${count}`,
      });

      return error;
    }

    for (let index = 0; index < count; index++) {
      const arg = expr.args[index]?.expr;
      const kind = method.args[index];
      if (arg != undefined && kind != undefined) {
        this.decimalArgument(arg, kind, module);
      }
    }

    const divisor = expr.args[0]?.expr;
    if (name == "div" && divisor != undefined) {
      this.decimalZeroCheck(divisor, module);
    }

    return this.decimalMethodResult(method);
  }

  private decimalMissingHint(name: string): string {
    const replacement = kDecimalReplacements.find((one) => one.name == name);
    let hint = "";

    if (replacement != undefined) {
      hint = `; a decimal uses ${replacement.use}`;
    }
    if (name == "isNaN" || name == "isFinite") {
      hint = `${hint}; a decimal is never NaN or infinite`;
    }

    return hint;
  }

  private decimalArgument(arg: Expr, kind: DecimalArgument, module: int): void {
    switch (kind) {
      case DecimalArgument.Decimal:
        this.checked(arg, this.decimalType(), module, kNoPlace);

        return;
      case DecimalArgument.Places:
        return this.decimalCount(arg, "the number of decimal places", module);
      case DecimalArgument.Digits:
        return this.decimalCount(
          arg,
          "the number of significant digits",
          module,
        );
      case DecimalArgument.Base:
        return this.decimalCount(arg, "the base", module);
      case DecimalArgument.Power:
        return this.decimalCount(arg, "the power of ten", module);
      default:
        return this.roundingModeCheck(arg, module);
    }
  }

  private decimalCount(arg: Expr, what: string, module: int): void {
    const int = this.store.integer(64, false);
    const type = this.typed(arg, int, module);
    const base = this.types.apparent(type);
    if (type.kind == TypeKind.Error) {
      return;
    }
    if (base.kind == TypeKind.Int && !this.types.isOptional(type)) {
      return;
    }

    this.report(module, arg.loc, Code.DecimalCountType, {
      word: what,
      first: this.text.of(type),
      place: this.maybePlace(this.types.isOptional(type)),
    });
  }

  private roundingModeCheck(arg: Expr, module: int): void {
    const string = this.store.plain(TypeKind.String);
    const type = this.checked(arg, string, module, kNoPlace);
    if (type.kind == TypeKind.Error) {
      return;
    }

    const modes = this.knownTextsOf(arg, type, module);
    if (modes == undefined) {
      this.report(module, arg.loc, Code.RoundingModeRuntime, kNoDetails);

      return;
    }

    const unknown = modes.find((mode) => !kRoundingModes.includes(mode));
    if (unknown != undefined) {
      this.report(module, arg.loc, Code.RoundingModeUnknown, {
        word: unknown,
      });
    }
  }

  private decimalMethodResult(method: DecimalMethod): Type {
    switch (method.result) {
      case DecimalResult.Text:
        return this.store.plain(TypeKind.String);
      case DecimalResult.Truth:
        return this.store.plain(TypeKind.Boolean);
      case DecimalResult.Whole:
        return this.store.integer(64, false);
      case DecimalResult.List:
        return this.store.arrayOf(this.decimalType());
      default:
        return this.decimalType();
    }
  }

  private decimalRangeCheck(expr: Expr, module: int): void {
    if (expr.kind != ExprKind.FloatLit) {
      return;
    }

    const span = expr.text;
    const source = this.program.modules[module]?.source.text;
    if (span == undefined || source == undefined) {
      return;
    }

    const text = source.toString("utf8", span.start, span.end);
    const top = this.decimalTop(text);
    if (top != undefined && top > 10000000) {
      this.report(module, expr.loc, Code.DecimalOutOfRange, kNoDetails);
    }
  }

  private decimalTop(text: string): int | undefined {
    const clean = text.replaceAll("_", "").toLowerCase();
    const mark = clean.indexOf("e");
    const mantissa = this.mantissaOf(clean, mark);
    const exponent = this.exponentOf(clean, mark);
    const dot = mantissa.indexOf(".");
    const whole = this.wholeDigits(mantissa, dot);
    if (whole.length > 0) {
      return whole.length - 1 + exponent;
    }

    const fraction = mantissa.slice(dot + 1);
    const zeros = this.leadingZeros(fraction);
    if (zeros == fraction.length) {
      return undefined;
    }

    return exponent - zeros - 1;
  }

  private mantissaOf(clean: string, mark: int): string {
    if (mark < 0) {
      return clean;
    }

    return clean.slice(0, mark);
  }

  private exponentOf(clean: string, mark: int): int {
    if (mark < 0) {
      return 0;
    }

    const parsed = parseInt(clean.slice(mark + 1));
    const value = parsed.unwrapOr(0);
    if (value > 1000000000000) {
      return 1000000000000;
    }
    if (value < -1000000000000) {
      return -1000000000000;
    }

    return value;
  }

  private wholeDigits(mantissa: string, dot: int): string {
    const whole = this.wholePart(mantissa, dot);

    return whole.slice(this.leadingZeros(whole));
  }

  private leadingZeros(text: string): int {
    let count = 0;

    while (count < text.length && text.charAt(count) == "0") {
      count += 1;
    }

    return count;
  }

  private wholePart(mantissa: string, dot: int): string {
    if (dot < 0) {
      return mantissa;
    }

    return mantissa.slice(0, dot);
  }

  private mathDecimalCheck(expr: CallExpr, module: int): boolean {
    const callee = expr.callee;
    if (callee.kind != ExprKind.Member) {
      return false;
    }

    const holder = callee.object;
    const isMath =
      holder.kind == ExprKind.Name &&
      holder.name == kMathName &&
      this.isGlobalUse(holder, module);
    if (!isMath) {
      return false;
    }

    for (const arg of expr.args) {
      this.quiet += 1;

      const type = this.typed(arg.expr, undefined, module);

      this.quiet -= 1;

      if (!arg.spread && this.types.apparent(type).kind == TypeKind.Decimal) {
        this.report(module, arg.expr.loc, Code.MathArgumentDecimal, {
          word: this.text.of(type),
        });
        this.looseArguments(expr.args, module);

        return true;
      }
    }

    return false;
  }

  private decimalAssignCheck(
    expr: AssignExpr,
    tested: Type,
    module: int,
  ): void {
    const isDividing = expr.op == BinaryOp.Div || expr.op == BinaryOp.Rem;
    if (isDividing && this.types.apparent(tested).kind == TypeKind.Decimal) {
      this.decimalZeroCheck(expr.value, module);
    }
  }

  private decimalZeroCheck(divisor: Expr, module: int): void {
    const value = this.plainConstant(divisor, module);
    const isZero = value != undefined && value == 0;
    if (isZero || this.isZeroLiteral(divisor)) {
      this.report(module, divisor.loc, Code.DecimalDivisionByZero, kNoDetails);
    }
  }
}
