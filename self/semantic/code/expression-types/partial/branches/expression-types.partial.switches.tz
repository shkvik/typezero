import { replace } from "tz:mem";
import {
  Expr,
  ExprKind,
  UnaryOp,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { SwitchStmt } from "../../../../../program/ast/types/ast.types.statements.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { FunctionFrame } from "../../types/expression-types.types.tz";
import { ExpressionTypes } from "../../expression-types.tz";

partial class ExpressionTypes {
  private walkSwitch(
    statement: SwitchStmt,
    frame: FunctionFrame,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const switchFunctionsErrors =
      this.types.switchFunctionsCheck(statement);

    this.errors.writeAll(module, switchFunctionsErrors);

    const subject = this.typed(
      tree.exprOf(statement.discriminantId),
      undefined,
      module,
    );
    const tests = this.caseTypes(statement, subject, module);

    this.typeOfCasesCheck(statement, module);

    this.casesCheck(statement, subject, tests, module);

    this.forgetLooped(statement, module);

    const before = this.factsCopy();
    const discriminant = tree.exprOf(statement.discriminantId);
    let reached: Map<string, Type> | undefined = undefined;
    let passed = new Map<string, Type>();
    const exits: Map<string, Type>[] = [];
    const lastCase = tree.casesOf(statement.casesList)[
      tree.casesOf(statement.casesList).length - 1
    ];

    for (const option of tree.casesOf(statement.casesList)) {
      const test = tree.exprAt(option.testId);
      const facts = this.caseFacts(discriminant, test, passed, module);

      reached = this.reachedFacts(reached, facts);

      if (test != undefined) {
        passed = this.types.mergedFacts(
          passed,
          this.factsOfCase(discriminant, test, passed, false, module),
        );
      }
      const bodyItem = tree.stmtsOf(option.bodyList);
      if (bodyItem.length == 0) {
        continue;
      }

      const entered = this.types.mergedFacts(before, reached);

      this.facts = entered;
      const body = tree.stmtsOf(option.bodyList);

      this.walkStatements(body, frame, module);

      const left = replace(this.facts, new Map<string, Type>(before));

      if (this.isSwitchExit(option, option.loc == lastCase?.loc, module)) {
        exits.push(left);
      }

      reached = undefined;
    }

    this.switchFieldsJoined(statement, exits);
  }

  private caseFacts(
    discriminant: Expr,
    test: Expr | undefined,
    passed: Read<Map<string, Type>>,
    module: int,
  ): Map<string, Type> {
    if (test == undefined) {
      return new Map<string, Type>(passed);
    }

    const facts = this.factsOfCase(discriminant, test, passed, true, module);

    return this.types.mergedFacts(passed, facts);
  }

  private factsOfCase(
    discriminant: Expr,
    test: Expr,
    passed: Read<Map<string, Type>>,
    isEqual: boolean,
    module: int,
  ): Map<string, Type> {
    const before = this.underFacts(passed);
    const facts = this.equalityFacts(discriminant, test, isEqual, module);

    this.facts = before;

    return facts;
  }

  private reachedFacts(
    reached: Read<Map<string, Type> | undefined>,
    facts: Own<Map<string, Type>>,
  ): Map<string, Type> {
    if (reached == undefined) {
      return facts;
    }

    return this.types.joinedFacts(reached, facts);
  }

  private caseTypes(statement: SwitchStmt, subject: Type, module: int): Type[] {
    const tree = this.types.program.tree;

    const tests: Type[] = [];

    if (subject.kind == TypeKind.Error) {
      return tests;
    }

    for (const option of tree.casesOf(statement.casesList)) {
      const test = tree.exprAt(option.testId);
      if (test != undefined) {
        const type = this.typed(test, subject, module);

        const caseTypeError = this.types.caseTypeCheck(
          test,
          type,
          subject,
        );

        this.errors.writeFound(module, caseTypeError);
        tests.push(type);
      }
    }

    return tests;
  }

  private casesCheck(
    statement: SwitchStmt,
    subject: Type,
    tests: Read<Type[]>,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const key = `${module} ${statement.loc}`;
    const isUnknown =
      subject.kind == TypeKind.Error ||
      tests.some((test) => test.kind == TypeKind.Error);
    if (isUnknown) {
      this.coveredSwitches.add(key);

      return;
    }

    const hasDefault = tree.casesOf(statement.casesList).some(
      (option) => tree.exprAt(option.testId) == undefined,
    );
    const isListed =
      !this.types.isOptional(subject) && this.types.isLiteralSet(subject);
    if (hasDefault || !isListed) {
      return;
    }

    const left = this.types
      .unionMembers(subject)
      .filter((part) => !tests.some((one) => one.id == part.id));
    const first = left[0];
    if (first == undefined) {
      this.coveredSwitches.add(key);

      return;
    }

    const names = left.map((part) => this.types.typeText(part));
    const word = this.types.listedNames(names);
    const other = this.types.typeText(first);

    this.errors.write(
      module,
      tree.exprOf(statement.discriminantId).loc,
      Code.SwitchCasesLeft,
      {
        word,
        other,
      },
    );
  }

  private typeOfCasesCheck(statement: SwitchStmt, module: int): void {
    const tree = this.types.program.tree;

    const subject = tree.exprOf(statement.discriminantId);
    if (subject.kind != ExprKind.Unary || subject.op != UnaryOp.TypeOf) {
      return;
    }

    const operand = tree.exprOf(subject.operandId);
    const tested = this.peekType(operand, module);

    for (const option of tree.casesOf(statement.casesList)) {
      const test = tree.exprAt(option.testId);
      if (test == undefined || test.kind != ExprKind.StringLit) {
        continue;
      }

      const answer = this.types.typeOfAnswerOf(tested, test.value);
      if (answer != undefined) {
        this.errors.write(module, test.loc, answer.code, answer.details);
      }
    }
  }
}
