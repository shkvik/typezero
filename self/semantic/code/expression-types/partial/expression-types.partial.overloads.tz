import { ExpressionTypes } from "../expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { ClassDecl } from "../../../../program/ast/types/ast.types.classes.tz";
import {
  CallArgument,
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  UnaryOp,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../program/ast/types/ast.types.functions.tz";
import {
  FunctionShape,
  FunctionType,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import { kParentDepth } from "../const/expression-types.const.tz";
import {
  CallKind,
  CallTarget,
  ClassMemberEntry,
  RankedVariant,
} from "../types/expression-types.types.tz";

partial class ExpressionTypes {
  private variantRules(decl: ClassDecl, module: int): void {
    const seen = new Set<string>();

    for (const fn of decl.methods) {
      const key = `${this.isStaticMethod(fn)} ${fn.name}`;
      if (seen.has(key)) {
        continue;
      }

      seen.add(key);

      const variants = decl.methods.filter(
        (one) =>
          one.name == fn.name &&
          this.isStaticMethod(one) == this.isStaticMethod(fn),
      );

      this.variantPairs(decl, variants, `'${fn.name}'`, module);
    }

    this.variantPairs(decl, decl.constructors, "the constructor", module);
  }

  private variantPairs(
    decl: ClassDecl,
    variants: FunctionDecl[],
    what: string,
    module: int,
  ): void {
    if (variants.length < 2) {
      return;
    }

    const types = variants.map((fn) => this.ownMethodType(decl, fn, module));

    for (let later = 1; later < variants.length; later++) {
      for (let earlier = 0; earlier < later; earlier++) {
        const first = variants[earlier];
        const second = variants[later];
        const one = types[earlier];
        const other = types[later];
        if (first == undefined || second == undefined) {
          continue;
        }
        if (one == undefined || other == undefined) {
          continue;
        }
        if (this.variantPairCheck(first, second, one, other, what, module)) {
          break;
        }
      }
    }
  }

  private variantPairCheck(
    first: FunctionDecl,
    second: FunctionDecl,
    one: FunctionType,
    other: FunctionType,
    what: string,
    module: int,
  ): boolean {
    if (this.isSameParameters(one, other)) {
      const isReturnOnly = one.shape.result != other.shape.result;
      if (isReturnOnly && first.returnType != undefined) {
        this.report(module, second.loc, Code.VariantReturnOnly, { word: what });

        return true;
      }

      this.report(module, second.loc, Code.VariantDuplicate, {
        word: this.overloadText(second, other),
      });

      return true;
    }

    const count = this.sharedCount(one, other);
    if (count < 0) {
      return false;
    }

    this.report(module, second.loc, Code.VariantAmbiguous, {
      first: this.overloadText(first, one),
      second: this.overloadText(second, other),
      other: `${count}`,
      place: this.pluralMark(count),
    });

    return true;
  }

  private sharedCount(one: FunctionType, other: FunctionType): int {
    const least = Math.max(this.leastOf(one), this.leastOf(other));
    const most = Math.min(one.shape.params.length, other.shape.params.length);

    for (let count = least; count <= most; count++) {
      if (this.isSamePrefix(one, other, count)) {
        return count;
      }
    }

    return -1;
  }

  private isSamePrefix(one: FunctionType, other: FunctionType, count: int): boolean {
    for (let index = 0; index < count; index++) {
      const mine = one.shape.params[index];
      const theirs = other.shape.params[index];
      if (mine == undefined || theirs == undefined || mine.type != theirs.type) {
        return false;
      }
    }

    return true;
  }

  private leastOf(type: FunctionType): int {
    let least = 0;

    for (const param of type.shape.params) {
      if (!param.optional) {
        least += 1;
      }
    }

    if (type.shape.rest && least > 0) {
      return least - 1;
    }

    return least;
  }

  private overloadText(fn: FunctionDecl, type: FunctionType): string {
    const parts: string[] = [];

    for (let index = 0; index < fn.params.length; index++) {
      const param = fn.params[index];
      const shown = type.shape.params[index];
      if (param == undefined || shown == undefined) {
        continue;
      }

      const mark = this.optionalMark(shown.optional);
      const written = this.text.of(shown.type);

      parts.push(`${param.name}${mark}: ${written}`);
    }

    const name = this.variantName(fn);

    return `${name}(${parts.join(", ")})`;
  }

  private optionalMark(isOptional: boolean): string {
    if (isOptional) {
      return "?";
    }

    return "";
  }

  private variantName(fn: FunctionDecl): string {
    if (fn.name == "" || fn.name == "constructor") {
      return "constructor";
    }

    return fn.name;
  }

  private variantList(texts: string[]): string {
    const last = texts[texts.length - 1];
    if (texts.length < 2 || last == undefined) {
      return texts.join("");
    }

    const head = texts.slice(0, texts.length - 1);

    return `${head.join(", ")} and ${last}`;
  }

  private overloadCall(
    expr: CallExpr,
    member: MemberExpr,
    entry: ClassMemberEntry,
    module: int,
  ): Type {
    const error = this.store.plain(TypeKind.Error);
    const ranked = this.rankedVariants(entry);
    const isGeneric = entry.methods.some((fn) => fn.typeParams.length > 0);
    if (ranked.length == 0 || isGeneric) {
      this.looseArguments(expr.args, module);

      return error;
    }

    const what = `'${member.name}'`;
    const chosen = this.chosenVariant(expr.args, ranked, what, member.loc, module);
    if (chosen == undefined) {
      return error;
    }

    return this.calledWith(expr, chosen.type, member.loc, CallKind.Own, module);
  }

  private rankedVariants(entry: ClassMemberEntry): RankedVariant[] {
    const ranked: RankedVariant[] = [];
    const seen = new Set<string>();
    let current: ClassMemberEntry | undefined = entry;

    for (let depth = 0; depth < kParentDepth && current != undefined; depth++) {
      this.addVariants(current, ranked);

      const name = current.methods[0]?.name ?? "";
      const key = `${current.instance.module} ${current.owner.loc}`;
      if (seen.has(key)) {
        break;
      }

      seen.add(key);
      current = this.parentVariants(current, name);
    }

    return ranked;
  }

  private addVariants(entry: ClassMemberEntry, ranked: RankedVariant[]): void {
    for (const fn of entry.methods) {
      const type = this.methodTypeOf(entry, fn);
      if (type.kind != TypeKind.Function) {
        continue;
      }

      const isHidden = ranked.some((one) => this.isSameParameters(one.type, type));
      if (!isHidden) {
        ranked.push({ fn, type, ranks: [], isAdapted: false, failed: -1 });
      }
    }
  }

  private parentVariants(
    entry: ClassMemberEntry,
    name: string,
  ): ClassMemberEntry | undefined {
    const parent = this.parentOf(entry.instance, entry.owner);
    if (parent == undefined || name == "") {
      return undefined;
    }

    const found = this.classMember(parent, name).entry;
    if (found == undefined || found.field != undefined) {
      return undefined;
    }

    return found;
  }

  private chosenVariant(
    args: CallArgument[],
    ranked: RankedVariant[],
    what: string,
    loc: int,
    module: int,
  ): RankedVariant | undefined {
    const texts = ranked.map((one) => this.overloadText(one.fn, one.type));
    const list = this.variantList(texts);

    if (args.some((arg) => arg.spread)) {
      this.report(module, loc, Code.VariantSpread, { word: what });
      this.looseArguments(args, module);

      return undefined;
    }

    const count = args.length;
    const counted = ranked.filter((one) => this.isCountFitting(one.type, count));
    if (counted.length == 0) {
      this.report(module, loc, Code.VariantCount, {
        word: what,
        other: `${count}`,
        place: this.pluralMark(count),
        first: list,
      });
      this.looseArguments(args, module);

      return undefined;
    }

    return this.rankedChoice(args, counted, what, loc, module);
  }

  private isCountFitting(type: FunctionType, count: int): boolean {
    const least = this.leastOf(type);
    const most = type.shape.params.length;

    return count >= least && (count <= most || type.shape.rest);
  }

  private rankedChoice(
    args: CallArgument[],
    counted: RankedVariant[],
    what: string,
    loc: int,
    module: int,
  ): RankedVariant | undefined {
    const given = this.quietArguments(args, module);
    const applicable: RankedVariant[] = [];
    const reasons: string[] = [];
    let hint = "";

    for (const variant of counted) {
      const reason = this.variantRanks(args, given, variant, module);
      if (reason == "") {
        applicable.push(variant);
      } else {
        reasons.push(reason);
      }
      if (reason != "" && hint == "") {
        hint = this.variantHint(args, given, variant, module);
      }
    }

    if (applicable.length == 0) {
      this.report(module, loc, Code.VariantNoFit, {
        word: what,
        first: reasons.map((one) => `; ${one}`).join(""),
        second: hint,
      });
      this.looseArguments(args, module);

      return undefined;
    }

    const best = applicable.find((one) => this.isBestVariant(one, applicable));
    if (best != undefined) {
      return best;
    }
    if (given.some((type) => type.kind == TypeKind.Error)) {
      this.looseArguments(args, module);

      return undefined;
    }

    const tied = applicable.map((one) => this.overloadText(one.fn, one.type));
    const isAdapted = applicable.every((one) => one.isAdapted);
    const code = this.tieCode(isAdapted);

    this.report(module, loc, code, { word: what, first: this.variantList(tied) });
    this.looseArguments(args, module);

    return undefined;
  }

  private tieCode(isAdapted: boolean): Code {
    if (isAdapted) {
      return Code.VariantTieLiteral;
    }

    return Code.VariantTie;
  }

  private quietArguments(args: CallArgument[], module: int): Type[] {
    this.quiet += 1;

    const types = args.map((arg) => this.typed(arg.expr, undefined, module));

    this.quiet -= 1;

    return types;
  }

  private variantRanks(
    args: CallArgument[],
    given: Type[],
    variant: RankedVariant,
    module: int,
  ): string {
    variant.ranks = [];
    variant.isAdapted = false;

    for (let index = 0; index < args.length; index++) {
      const arg = args[index];
      const type = given[index];
      const param = this.variantParam(variant.type, index);
      if (arg == undefined || type == undefined || param == undefined) {
        continue;
      }

      const rank = this.argumentRank(arg.expr, type, param, variant, module);
      if (rank < 0) {
        variant.failed = index;

        const shown = this.overloadText(variant.fn, variant.type);
        const wanted = this.text.of(param);
        const found = this.text.of(type);

        return `${shown} takes '${wanted}' as argument ${index + 1}, which is '${found}'`;
      }

      variant.ranks.push(rank);
    }

    return "";
  }

  private variantParam(type: FunctionType, index: int): Type | undefined {
    const params = type.shape.params;
    const param = params[index] ?? params[params.length - 1];
    if (param == undefined) {
      return undefined;
    }

    const isRest = type.shape.rest && index >= params.length - 1;
    if (isRest && param.type.kind == TypeKind.Array) {
      return param.type.item;
    }

    return param.type;
  }

  private argumentRank(
    expr: Expr,
    type: Type,
    param: Type,
    variant: RankedVariant,
    module: int,
  ): int {
    if (type.kind == TypeKind.Error || this.apparent(type) == param) {
      return 0;
    }
    if (this.relation.converts(type, param)) {
      return 1;
    }

    if (!this.isAdaptingLiteral(expr, type, param, module)) {
      return -1;
    }

    variant.isAdapted = true;

    return 1;
  }

  private isAdaptingLiteral(
    expr: Expr,
    type: Type,
    param: Type,
    module: int,
  ): boolean {
    const base = this.apparent(type);
    const goal = this.definedType(param);
    const isFraction = base.kind == TypeKind.Double;
    if (isFraction && goal.kind == TypeKind.Decimal) {
      return this.isWholeTree(expr, module) || this.isNumberLiteral(expr);
    }

    this.quiet += 1;

    const adapted = this.literalTarget(expr, base, param, module);

    this.quiet -= 1;

    return adapted != undefined;
  }

  private isNumberLiteral(expr: Expr): boolean {
    if (expr.kind == ExprKind.FloatLit || expr.kind == ExprKind.IntLit) {
      return true;
    }

    return (
      expr.kind == ExprKind.Unary &&
      expr.op == UnaryOp.Neg &&
      this.isNumberLiteral(expr.operand)
    );
  }

  private variantHint(
    args: CallArgument[],
    given: Type[],
    variant: RankedVariant,
    module: int,
  ): string {
    const index = variant.failed;
    const arg = args[index];
    const type = given[index];
    const param = this.variantParam(variant.type, index);
    if (arg == undefined || type == undefined || param == undefined) {
      return "";
    }

    const code = this.numberCode(this.apparent(type), param);
    const word = this.operandName(arg.expr);
    const other = this.conversionName(param);
    if (code == Code.ConvertExplicitly) {
      return `; convert it explicitly: '${word}.${other}()'`;
    }
    if (code == Code.RoundThenConvert) {
      return `; round it first, then convert: 'Math.trunc(${word}).${other}()' (or Math.round, Math.floor, Math.ceil)`;
    }

    return "";
  }

  private isBestVariant(
    variant: RankedVariant,
    applicable: RankedVariant[],
  ): boolean {
    return applicable.every(
      (other) => other == variant || this.isBetterVariant(variant, other),
    );
  }

  private isBetterVariant(variant: RankedVariant, other: RankedVariant): boolean {
    const isFuller = !this.isLeavingOut(variant) && this.isLeavingOut(other);
    let isStrictly = isFuller;

    for (let index = 0; index < variant.ranks.length; index++) {
      const mine = variant.ranks[index] ?? 0;
      const theirs = other.ranks[index] ?? 0;
      if (mine > theirs) {
        return false;
      }
      if (mine < theirs) {
        isStrictly = true;
      }
    }

    return isStrictly;
  }

  private isLeavingOut(variant: RankedVariant): boolean {
    const shape = variant.type.shape;

    return shape.rest || variant.ranks.length < shape.params.length;
  }

  private variantValueCheck(
    expr: MemberExpr,
    entry: ClassMemberEntry,
    module: int,
  ): void {
    const ranked = this.rankedVariants(entry);

    this.rankedValueCheck(expr, ranked, module);
  }

  private rankedValueCheck(
    expr: MemberExpr,
    ranked: RankedVariant[],
    module: int,
  ): void {
    if (this.argumentExprs.has(expr) || this.isTypedInit(expr, module)) {
      return;
    }

    const last = ranked[ranked.length - 1];
    if (ranked.length < 2 || last == undefined) {
      return;
    }

    const texts = ranked.map((one) => this.overloadText(one.fn, one.type));
    const shape = this.overloadText(last.fn, last.type).slice(last.fn.name.length);
    const result = this.text.of(last.type.shape.result);

    this.report(module, expr.loc, Code.VariantValue, {
      word: expr.name,
      first: this.variantList(texts),
      second: `${shape} => ${result}`,
      other: this.operandName(expr.object),
    });
  }

  private isTypedInit(expr: Expr, module: int): boolean {
    const variables = this.record(module)?.variables;
    if (variables == undefined) {
      return false;
    }

    for (const variable of variables.values()) {
      const decl = variable.decl;
      if (decl.init == expr && decl.typeAnn != undefined) {
        return true;
      }
    }

    return false;
  }

  private constructorChoice(
    expr: Expr,
    args: CallArgument[],
    targets: CallTarget[],
    variants: FunctionDecl[],
    name: string,
    module: int,
  ): CallTarget | undefined {
    const ranked: RankedVariant[] = [];

    for (let index = 0; index < variants.length; index++) {
      const fn = variants[index];
      const target = targets[index];
      if (fn == undefined || target == undefined) {
        continue;
      }

      const result = this.store.plain(TypeKind.Void);
      const shape: FunctionShape = {
        params: target.params,
        rest: target.rest,
        result,
      };
      const type = this.store.functionOf(shape);
      if (type.kind == TypeKind.Function) {
        ranked.push({ fn, type, ranks: [], isAdapted: false, failed: -1 });
      }
    }

    const what = `the constructor of '${name}'`;
    const chosen = this.chosenVariant(args, ranked, what, expr.loc, module);
    if (chosen == undefined) {
      return undefined;
    }

    const index = variants.indexOf(chosen.fn);

    return targets[index];
  }
}
