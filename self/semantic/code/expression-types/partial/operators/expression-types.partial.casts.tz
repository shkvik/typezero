import { ExpressionTypes } from "../../expression-types.tz";
import {
  CastExpr,
  ExprKind,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  TypeContext,
  TypePlace,
} from "../../../../types/type-resolver/types/type-resolver.types.tz";

partial class ExpressionTypes {
  private castTyped(expr: CastExpr, module: int): Type {
    const tree = this.types.program.tree;

    const context: TypeContext = {
      module,
      bindings: new Map<int, Type>(),
      place: TypePlace.Plain,
    };
    const target = tree.typeRefOf(expr.targetId);
    const to = this.types.resolve(target, context);
    const isArray = tree.exprOf(expr.operandId).kind == ExprKind.ArrayLit;
    const hint = this.types.castHint(isArray, to);
    const operand = tree.exprOf(expr.operandId);
    const from = this.typed(operand, hint, module);
    if (from.kind == TypeKind.Error) {
      return to;
    }

    const code = this.types.castCode(from, to, isArray);
    const word = this.types.castWord(expr, code, to);
    const other = this.types.conversionName(to);

    this.errors.write(module, expr.loc, code, {
      word,
      other,
      first: this.types.typeText(from),
      second: this.types.typeText(to),
    });

    return to;
  }
}
