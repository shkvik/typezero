import { ExpressionTypes } from "../../expression-types.tz";
import {
  Expr,
  ExprKind,
  UnaryExpr,
  UnaryOp,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  LiteralKind,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { kLargestInt } from "../../../integer-math/const/integer-math.const.tz";

partial class ExpressionTypes {
  public readonly enumText(expr: Expr, module: int): string | undefined {
    if (expr.kind != ExprKind.Member) {
      return undefined;
    }

    const literal = this.enumLiteral(expr, module);
    if (literal == undefined || literal.kind != LiteralKind.String) {
      return undefined;
    }

    return literal.text;
  }

  public readonly enumNumber(expr: Expr, module: int): decimal | undefined {
    if (expr.kind != ExprKind.Member) {
      return undefined;
    }

    return this.enumConstant(expr, module);
  }

  private readonly intConstant(
    expr: Expr,
    type: Type,
    module: int,
  ): decimal | undefined {
    const value = this.rawConstant(expr, type, module);
    if (value == undefined || value > kLargestInt) {
      return undefined;
    }

    return value;
  }

  private readonly rawConstant(
    expr: Expr,
    type: Type,
    module: int,
  ): decimal | undefined {
    if (type.kind != TypeKind.Int) {
      return undefined;
    }

    const value = this.plainConstant(expr, module);
    if (value == undefined || !this.integers.isInside(value, type)) {
      return undefined;
    }

    return value;
  }

  private readonly plainConstant(expr: Expr, module: int): decimal | undefined {
    switch (expr.kind) {
      case ExprKind.IntLit:
        return expr.value.toDecimal();
      case ExprKind.Name:
        return this.doorOfName(expr, module)?.constant;
      case ExprKind.Unary:
        return this.unaryConstant(expr);
      case ExprKind.Binary:
        return this.answers.foldedOf(expr);
      case ExprKind.Member:
        return this.enumConstant(expr, module);
      default:
        return undefined;
    }
  }

  private readonly unaryConstant(expr: UnaryExpr): decimal | undefined {
    const operand = expr.operand;
    if (operand.kind != ExprKind.IntLit) {
      return this.answers.foldedOf(expr);
    }

    const value = operand.value.toDecimal();

    switch (expr.op) {
      case UnaryOp.Plus:
        return value;
      case UnaryOp.Neg:
        return -value;
      default:
        return this.answers.foldedOf(expr);
    }
  }

  private readonly isWholeTree(expr: Expr, module: int): boolean {
    switch (expr.kind) {
      case ExprKind.IntLit:
        return true;
      case ExprKind.Name:
        return this.doorOfName(expr, module)?.isWhole == true;
      case ExprKind.Member:
        return this.enumConstant(expr, module) != undefined;
      case ExprKind.Unary:
        return (
          this.shapes.isSign(expr.op) && this.isWholeTree(expr.operand, module)
        );
      case ExprKind.Binary:
        return (
          this.shapes.isWholeArithmetic(expr.op) &&
          this.isWholeTree(expr.lhs, module) &&
          this.isWholeTree(expr.rhs, module)
        );
      default:
        return false;
    }
  }

  private readonly literalTarget(
    expr: Expr,
    type: Type,
    to: Type,
    module: int,
  ): Type | undefined {
    const cstring = this.cstringLiteral(expr, to);
    if (cstring != undefined) {
      return cstring;
    }

    const target = this.numberTarget(to);
    const isLiteral =
      target != undefined &&
      type.kind == TypeKind.Int &&
      type != target &&
      this.isWholeTree(expr, module);
    if (!isLiteral || target == undefined) {
      return undefined;
    }

    switch (target.kind) {
      case TypeKind.Double:
      case TypeKind.Decimal:
        return target;
      case TypeKind.Int: {
        const value = this.intConstant(expr, type, module);
        if (value == undefined || !this.integers.isInside(value, target)) {
          return undefined;
        }

        return target;
      }
      default:
        return undefined;
    }
  }

  private readonly numberTarget(to: Type): Type | undefined {
    const target = this.types.definedType(to);
    if (target.kind != TypeKind.Union) {
      return target;
    }

    return target.parts.find((part) => this.types.isNumberLike(part));
  }
}
