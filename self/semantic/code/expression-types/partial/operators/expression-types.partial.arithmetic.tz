import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  BinaryExpr,
  BinaryOp,
  Expr,
  ExprKind,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  LogicSide,
  OperandHints,
  OperandPair,
} from "../../types/expression-types.types.tz";
import { ConcatLink } from "../../../concatenation-rules/types/concatenation-rules.types.tz";

partial class ExpressionTypes {
  private binaryTyped(
    expr: BinaryExpr,
    wanted: Type | undefined,
    module: int,
  ): Type {
    switch (expr.op) {
      case BinaryOp.Add:
      case BinaryOp.Sub:
      case BinaryOp.Mul:
      case BinaryOp.Div:
      case BinaryOp.Rem:
      case BinaryOp.Pow:
      case BinaryOp.BitAnd:
      case BinaryOp.BitOr:
      case BinaryOp.BitXor:
        return this.arithmeticTyped(expr, wanted, module, undefined);
      case BinaryOp.Shl:
      case BinaryOp.Shr:
      case BinaryOp.UShr:
        return this.shiftTyped(expr, wanted, module);
      case BinaryOp.Eq:
      case BinaryOp.Ne:
        return this.equalityTyped(expr, module);
      case BinaryOp.Lt:
      case BinaryOp.Le:
      case BinaryOp.Gt:
      case BinaryOp.Ge:
        return this.orderTyped(expr, module);
      case BinaryOp.Nullish:
        return this.nullishTyped(expr, wanted, module);
      case BinaryOp.LogAnd:
      case BinaryOp.LogOr:
        return this.logicalTyped(expr, wanted, LogicSide.Value, module);
      case BinaryOp.InstanceOf:
        return this.instanceofTyped(expr, module);
      case BinaryOp.In:
        return this.keyInTyped(expr, module);
      default:
        return this.childrenTyped(expr, module);
    }
  }

  private parameterArithmetic(
    expr: BinaryExpr,
    pair: OperandPair,
    module: int,
  ): Type {
    const checked = this.operators.parameterArithmetic(expr, pair);

    this.reportFound(module, checked.error);
    this.requireJoin(expr, pair);

    return checked.value;
  }

  private arithmeticTyped(
    expr: BinaryExpr,
    wanted: Type | undefined,
    module: int,
    chain: ConcatLink[] | undefined,
  ): Type {
    const links = chain ?? [];
    const operands = this.arithmeticOperands(expr, wanted, module, links);
    const type = this.arithmeticResult(expr, operands, module);

    if (expr.op != BinaryOp.Add) {
      return type;
    }

    links.push({
      binary: expr,
      left: operands.left,
      right: operands.right,
      type,
    });

    if (chain == undefined) {
      this.checkMixedConcat(links, module);
    }

    return type;
  }

  private arithmeticOperands(
    expr: BinaryExpr,
    wanted: Type | undefined,
    module: int,
    links: ConcatLink[],
  ): OperandPair {
    const expected = this.types.wantedPart(wanted);
    const hints = this.operators.operandHints(expr.op, expected);
    const isLiteralLeft =
      this.shapes.isNumberTree(expr.lhs) &&
      !this.shapes.isNumberTree(expr.rhs) &&
      (hints.canHint || this.shapes.isIntTree(expr.lhs));
    if (isLiteralLeft) {
      return this.literalLeftOperands(expr, hints, module, links);
    }

    const left = this.leftTyped(expr, hints.left, module, links);
    const isLiteralRight = hints.canHint && this.shapes.isNumberTree(expr.rhs);
    const literalHint = this.operators.literalSideHint(
      isLiteralRight,
      left,
      hints.right,
    );
    const rightHint = this.integerHint(
      expr.rhs,
      expr.lhs,
      left,
      literalHint,
      hints.isBitwise,
      module,
    );
    const right = this.operandTyped(expr.rhs, rightHint, module);

    return this.adapted(expr, { left, right }, module);
  }

  private literalLeftOperands(
    expr: BinaryExpr,
    hints: OperandHints,
    module: int,
    links: ConcatLink[],
  ): OperandPair {
    const right = this.operandTyped(expr.rhs, hints.right, module);
    const literalHint = this.operators.literalSideHint(
      hints.canHint,
      right,
      hints.left,
    );
    const leftHint = this.integerHint(
      expr.lhs,
      expr.rhs,
      right,
      literalHint,
      hints.isBitwise,
      module,
    );
    const left = this.leftTyped(expr, leftHint, module, links);

    return this.adapted(expr, { left, right }, module);
  }

  private leftTyped(
    expr: BinaryExpr,
    hint: Type | undefined,
    module: int,
    links: ConcatLink[],
  ): Type {
    const left = expr.lhs;
    if (expr.op != BinaryOp.Add || left.kind != ExprKind.Binary) {
      return this.operandTyped(left, hint, module);
    }
    if (left.op != BinaryOp.Add) {
      return this.operandTyped(left, hint, module);
    }

    const type = this.arithmeticTyped(left, hint, module, links);

    return this.types.apparent(type);
  }

  private operandTyped(expr: Expr, hint: Type | undefined, module: int): Type {
    const type = this.valueTyped(expr, hint, module);

    return this.types.apparent(type);
  }

  private valueTyped(expr: Expr, hint: Type | undefined, module: int): Type {
    if (expr.kind == ExprKind.Name) {
      return this.named(expr, hint, module);
    }

    return this.typed(expr, hint, module);
  }

  private integerHint(
    literal: Expr,
    other: Expr,
    otherType: Type,
    hint: Type | undefined,
    isBitwise: boolean,
    module: int,
  ): Type | undefined {
    const type = this.types.definedType(otherType);
    const isFraction = type.kind == TypeKind.Double && !isBitwise;
    const isOtherNumber = type.kind == TypeKind.Int || isFraction;
    if (!isOtherNumber || !this.shapes.isIntTree(literal)) {
      return hint;
    }
    if (this.isWholeTree(other, module)) {
      return hint;
    }

    return type;
  }

  private adapted(
    expr: BinaryExpr,
    pair: OperandPair,
    module: int,
  ): OperandPair {
    const left = pair.left;
    const right = pair.right;
    const isBroken =
      left.kind == TypeKind.Error || right.kind == TypeKind.Error;
    if (left == right || isBroken) {
      return pair;
    }

    const isBitwise =
      this.operators.isBitwise(expr.op) || this.operators.isShift(expr.op);
    const hasNumbers =
      this.types.isNumberLike(left) && this.types.isNumberLike(right);
    const hasIntegers = left.kind == TypeKind.Int && right.kind == TypeKind.Int;
    if (!hasNumbers || (isBitwise && !hasIntegers)) {
      return pair;
    }

    const isPower = expr.op == BinaryOp.Pow;
    const toRight = this.literalTarget(expr.lhs, left, right, module);
    const isRightDecimal = right.kind == TypeKind.Decimal;
    if (toRight != undefined && !(isPower && isRightDecimal)) {
      return { left: toRight, right };
    }

    const toLeft = this.literalTarget(expr.rhs, right, left, module);
    const isLeftFraction =
      left.kind == TypeKind.Decimal || left.kind == TypeKind.Double;
    if (toLeft != undefined && !(isPower && isLeftFraction)) {
      return { left, right: toLeft };
    }

    return pair;
  }

  private arithmeticResult(
    expr: BinaryExpr,
    given: OperandPair,
    module: int,
  ): Type {
    const pair = this.operators.withoutNever(given);
    const left = pair.left;
    const right = pair.right;
    const isBroken =
      left.kind == TypeKind.Error ||
      right.kind == TypeKind.Error ||
      left.kind == TypeKind.TypeParameter ||
      right.kind == TypeKind.TypeParameter;
    if (isBroken) {
      return this.parameterArithmetic(expr, pair, module);
    }

    const hasText =
      left.kind == TypeKind.String || right.kind == TypeKind.String;
    if (expr.op == BinaryOp.Add && hasText) {
      return this.concatenated(expr, pair, module);
    }
    if (this.types.isDate(left) || this.types.isDate(right)) {
      return this.dateArithmetic(expr, pair, module);
    }
    if (this.operators.isBitwise(expr.op)) {
      return this.bitsResult(expr, pair, module);
    }
    if (left.kind == TypeKind.Decimal || right.kind == TypeKind.Decimal) {
      return this.decimalResult(expr, pair, module);
    }

    const isWrapping =
      this.operators.isWrapping(left) || this.operators.isWrapping(right);
    const hasIntegers = left.kind == TypeKind.Int && right.kind == TypeKind.Int;
    if (isWrapping && hasIntegers) {
      return this.wrappingResult(expr, pair, module);
    }

    return this.numberResult(expr, pair, module);
  }

  private numberResult(expr: BinaryExpr, pair: OperandPair, module: int): Type {
    const left = pair.left;
    const written = pair.right;
    const isFloatPower =
      expr.op == BinaryOp.Pow &&
      left.kind == TypeKind.Double &&
      written.kind == TypeKind.Int;
    const right = this.operators.powerSide(isFloatPower, left, written);
    const hasNumbers =
      this.types.isNumeric(left) && this.types.isNumeric(right);
    const common = this.operators.commonNumber(hasNumbers, left, right);
    if (hasNumbers && common == undefined) {
      const mixedError = this.operators.mixedError(expr, pair, module);

      this.reportFound(module, mixedError);

      return this.store.plain(TypeKind.Error);
    }
    if (common == undefined) {
      const operandsError = this.operators.operandsError(expr, pair);

      this.reportFound(module, operandsError);

      return this.store.plain(TypeKind.Error);
    }
    if (common.kind == TypeKind.Int) {
      this.integerChecks(expr, common, written, module);
      this.foldBinary(expr, common, module);
    }

    return common;
  }

  private integerChecks(
    expr: BinaryExpr,
    common: Type,
    right: Type,
    module: int,
  ): void {
    if (expr.op == BinaryOp.Pow) {
      const exponent = this.intConstant(expr.rhs, right, module);
      const isNegative = exponent != undefined && exponent < 0;
      if (isNegative) {
        const first = this.text.of(common);

        this.report(module, expr.rhs.loc, Code.NegativePower, { first });
      }

      return;
    }

    this.divisorCheck(expr, right, module);
  }

  private divisorCheck(expr: BinaryExpr, right: Type, module: int): void {
    const isDividing = expr.op == BinaryOp.Div || expr.op == BinaryOp.Rem;
    if (!isDividing) {
      return;
    }

    const divisor = this.intConstant(expr.rhs, right, module);
    if (divisor == undefined || divisor != 0) {
      return;
    }

    this.report(module, expr.rhs.loc, Code.DivisionByZero, kNoDetails);
  }

  private wrappingResult(
    expr: BinaryExpr,
    pair: OperandPair,
    module: int,
  ): Type {
    const left = pair.left;
    const right = pair.right;
    const isBoth =
      this.operators.isWrapping(left) && this.operators.isWrapping(right);
    if (isBoth && left != right) {
      const mixedError = this.operators.mixedError(expr, pair, module);

      this.reportFound(module, mixedError);

      return this.store.plain(TypeKind.Error);
    }

    this.divisorCheck(expr, right, module);

    if (this.operators.isWrapping(left)) {
      return left;
    }

    return right;
  }

  private shiftTyped(
    expr: BinaryExpr,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const expected = this.types.wantedPart(wanted);
    const isInteger = expected != undefined && expected.kind == TypeKind.Int;
    const hint = this.operators.shiftHint(expr, isInteger, expected);
    const left = this.operandTyped(expr.lhs, hint, module);
    const right = this.operandTyped(expr.rhs, undefined, module);
    const pair = this.adapted(expr, { left, right }, module);
    const isBroken =
      pair.left.kind == TypeKind.Error || pair.right.kind == TypeKind.Error;
    if (isBroken) {
      return this.store.plain(TypeKind.Error);
    }

    return this.bitsResult(expr, pair, module);
  }

  private bitsResult(expr: BinaryExpr, pair: OperandPair, module: int): Type {
    const left = pair.left;
    const right = pair.right;

    if (this.reportsBits(expr, pair, module)) {
      return this.store.plain(TypeKind.Error);
    }
    if (this.operators.isShift(expr.op)) {
      this.shiftConstants(expr, pair, module);

      return left;
    }
    if (this.operators.isWrapping(left) || this.operators.isWrapping(right)) {
      return this.wrappingResult(expr, pair, module);
    }
    if (left != right) {
      const mixedError = this.operators.mixedError(expr, pair, module);

      this.reportFound(module, mixedError);

      return this.store.plain(TypeKind.Error);
    }

    this.foldBinary(expr, left, module);

    return left;
  }

  private reportsBits(
    expr: BinaryExpr,
    pair: OperandPair,
    module: int,
  ): boolean {
    const checked = this.operators.reportsBits(expr, pair, module);

    this.reportFound(module, checked.error);

    return checked.value;
  }

  private shiftConstants(
    expr: BinaryExpr,
    pair: OperandPair,
    module: int,
  ): void {
    const shifted = pair.left;
    if (shifted.kind != TypeKind.Int || shifted.wraps) {
      return;
    }

    const value = this.intConstant(expr.lhs, shifted, module);
    const count = this.intConstant(expr.rhs, shifted, module);
    const isWide = shifted.unsigned && shifted.bits == 64;
    if (value == undefined || count == undefined || isWide) {
      return;
    }

    const width = shifted.bits;
    const isInside = count >= 0 && count < width.toDecimal();
    if (isInside) {
      return this.foldShift(expr, shifted, value, count, module);
    }

    const first = this.text.of(shifted);
    const last = width - 1;

    this.report(module, expr.rhs.loc, Code.ShiftCount, {
      word: `${count}`,
      other: `${last}`,
      first,
    });
  }
}
