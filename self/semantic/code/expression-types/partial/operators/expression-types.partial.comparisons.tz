import {
  ComparedPair,
  ComparedSide,
  OperandPair,
  RequirementKind,
} from "../../types/expression-types.types.tz";
import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  BinaryExpr,
  Expr,
  ExprKind,
  UnaryOp,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";

partial class ExpressionTypes {
  private equalityTyped(expr: BinaryExpr, module: int): Type {
    const tree = this.types.program.tree;

    const boolean = this.types.store.plain(TypeKind.Boolean);
    const isNull =
      this.isNullSide(tree.exprOf(expr.lhsId), module) ||
      this.isNullSide(tree.exprOf(expr.rhsId), module);
    if (isNull) {
      this.nullEquality(expr, module);

      return boolean;
    }

    const sides = this.comparedOperands(expr, module);

    const rhsExpr = tree.exprOf(expr.rhsId);

    this.typeOfCheck(sides.left, rhsExpr, module);
    const lhs = tree.exprOf(expr.lhsId);

    this.typeOfCheck(sides.right, lhs, module);

    const pair: OperandPair = {
      left: sides.left.type,
      right: sides.right.type,
    };

    this.equalOperands(expr, pair, module);

    return boolean;
  }

  private equalOperands(
    expr: BinaryExpr,
    pair: OperandPair,
    module: int,
  ): void {
    const left = pair.left;
    const right = pair.right;
    const plainLeft = this.types.definedType(left);
    const plainRight = this.types.definedType(right);

    if (left.kind == TypeKind.Error || right.kind == TypeKind.Error) {
      return;
    }
    if (left.kind == TypeKind.Void || right.kind == TypeKind.Void) {
      const operandsError = this.types.operandsError(expr, pair);

      return this.errors.writeFound(module, operandsError);
    }
    if (left.kind == TypeKind.Undefined || right.kind == TypeKind.Undefined) {
      return;
    }

    const hasJson =
      plainLeft.kind == TypeKind.Json || plainRight.kind == TypeKind.Json;
    if (hasJson) {
      const jsonEqualityError = this.types.jsonEqualityError(expr, pair);

      return this.errors.writeFound(module, jsonEqualityError);
    }

    const hasResult =
      plainLeft.kind == TypeKind.Result || plainRight.kind == TypeKind.Result;
    if (hasResult) {
      const other = this.types.operatorText(expr.op);

      return this.errors.write(module, expr.loc, Code.ResultsCompared, {
        other,
      });
    }

    const hasParameter =
      plainLeft.kind == TypeKind.TypeParameter ||
      plainRight.kind == TypeKind.TypeParameter;
    if (hasParameter && plainLeft.id == plainRight.id) {
      const word = this.types.operatorText(expr.op);

      return this.requireOf(plainLeft, RequirementKind.Compare, word);
    }
    if (hasParameter) {
      return;
    }

    const adapted = this.adapted(expr, pair, module);
    const hasIntegers =
      adapted.left.kind == TypeKind.Int && adapted.right.kind == TypeKind.Int;
    if (hasIntegers) {
      return;
    }

    const common = this.types.comparisonType(adapted.left, adapted.right);
    if (common == undefined) {
      const incomparableError = this.types.incomparableError(
        expr,
        adapted,
        module,
      );

      this.errors.writeFound(module, incomparableError);
    }
  }

  private comparedOperands(expr: BinaryExpr, module: int): ComparedPair {
    const tree = this.types.program.tree;

    const lhs = tree.exprOf(expr.lhsId);
    const isLiteralLeft = this.types.isComparedLiteral(lhs);
    const isLiteralRight = this.types.isComparedLiteral(
      tree.exprOf(expr.rhsId),
    );
    if (isLiteralLeft && !isLiteralRight) {
      const right = this.comparedSide(
        tree.exprOf(expr.rhsId),
        undefined,
        module,
      );
      const leftHint = this.types.comparisonHint(
        right.type,
        tree.exprOf(expr.lhsId),
      );
      const lhsExpr = tree.exprOf(expr.lhsId);
      const left = this.comparedSide(lhsExpr, leftHint, module);

      return { left, right };
    }

    const exprLhs = tree.exprOf(expr.lhsId);
    const left = this.comparedSide(exprLhs, undefined, module);
    const rightHint = this.types.literalComparisonHint(
      isLiteralRight,
      left.type,
      tree.exprOf(expr.rhsId),
    );
    const rhs = tree.exprOf(expr.rhsId);
    const right = this.comparedSide(rhs, rightHint, module);

    return { left, right };
  }

  private comparedSide(
    expr: Expr,
    hint: Type | undefined,
    module: int,
  ): ComparedSide {
    const tree = this.types.program.tree;

    if (expr.kind != ExprKind.Unary || expr.op != UnaryOp.TypeOf) {
      return { type: this.typed(expr, hint, module) };
    }

    const operand = tree.exprOf(expr.operandId);
    const tested = this.typed(operand, undefined, module);
    const type = this.types.store.plain(TypeKind.String);

    return { type, tested };
  }

  private readonly isNullSide(expr: Expr, module: int): boolean {
    return expr.kind == ExprKind.Name && this.isNullName(expr, module);
  }

  private nullEquality(expr: BinaryExpr, module: int): void {
    const tree = this.types.program.tree;

    const lhs = tree.exprOf(expr.lhsId);
    const isLeftNull = this.isNullSide(lhs, module);
    const rhs = tree.exprOf(expr.rhsId);
    const isRightNull = this.isNullSide(rhs, module);
    const nullSide = this.types.nullOperand(isLeftNull, expr);
    const type = this.nullOther(isLeftNull, isRightNull, expr, module);
    const plain = this.types.definedType(type);
    if (type.kind == TypeKind.Error || plain.kind == TypeKind.Json) {
      return;
    }

    const first = this.types.typeText(type);
    const other = this.types.operatorText(expr.op);

    this.errors.write(module, nullSide.loc, Code.NullNeverEqual, {
      first,
      other,
    });
  }

  private nullOther(
    isLeftNull: boolean,
    isRightNull: boolean,
    expr: BinaryExpr,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    if (isLeftNull && isRightNull) {
      return this.types.store.plain(TypeKind.Undefined);
    }
    if (isLeftNull) {
      const rhs = tree.exprOf(expr.rhsId);

      return this.typed(rhs, undefined, module);
    }

    const lhs = tree.exprOf(expr.lhsId);

    return this.typed(lhs, undefined, module);
  }

  private orderTyped(expr: BinaryExpr, module: int): Type {
    const boolean = this.types.store.plain(TypeKind.Boolean);
    const sides = this.comparedOperands(expr, module);
    const written = sides.left.type;
    const isSameParameter =
      written.kind == TypeKind.TypeParameter &&
      written.id == sides.right.type.id;
    if (isSameParameter) {
      const word = this.types.operatorText(expr.op);

      this.requireOf(written, RequirementKind.Compare, word);

      return boolean;
    }

    const left = this.types.apparent(written);
    const right = this.types.apparent(sides.right.type);

    this.orderOperands(expr, { left, right }, module);

    return boolean;
  }

  private orderOperands(
    expr: BinaryExpr,
    pair: OperandPair,
    module: int,
  ): void {
    const left = pair.left;
    const right = pair.right;
    const isBroken =
      left.kind == TypeKind.Error || right.kind == TypeKind.Error;
    const isText =
      left.kind == TypeKind.String && right.kind == TypeKind.String;
    if (isBroken || isText) {
      return;
    }
    if (this.types.isDate(left) || this.types.isDate(right)) {
      const dateComparisonErrors = this.types.dateComparisonErrors(expr, pair);

      return this.errors.writeAll(module, dateComparisonErrors);
    }
    if (left.kind == TypeKind.Decimal || right.kind == TypeKind.Decimal) {
      return this.decimalComparison(expr, pair, module);
    }
    if (!this.types.isNumeric(left) || !this.types.isNumeric(right)) {
      const operandsError = this.types.operandsError(expr, pair);

      return this.errors.writeFound(module, operandsError);
    }

    const adapted = this.adapted(expr, pair, module);
    const isSame = adapted.left.id == adapted.right.id;
    const hasIntegers =
      adapted.left.kind == TypeKind.Int && adapted.right.kind == TypeKind.Int;
    if (!isSame && !hasIntegers) {
      const mixedError = this.types.mixedError(expr, adapted, module);

      this.errors.writeFound(module, mixedError);
    }
  }

  private decimalComparison(
    expr: BinaryExpr,
    pair: OperandPair,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const isLeftFitting = this.isDecimalSide(
      tree.exprOf(expr.lhsId),
      pair.left,
      module,
    );
    const isRightFitting = this.isDecimalSide(
      tree.exprOf(expr.rhsId),
      pair.right,
      module,
    );
    if (!isLeftFitting || !isRightFitting) {
      const decimalMixError = this.types.decimalMixError(expr, pair, module);

      this.errors.writeFound(module, decimalMixError);
    }
  }

  private nullishTyped(
    expr: BinaryExpr,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const expected = this.types.wantedPart(wanted);
    const lhs = tree.exprOf(expr.lhsId);
    const given = this.typed(lhs, expected, module);
    const rhs = tree.exprOf(expr.rhsId);
    const left = this.matchBeforeList(given, rhs);
    if (left.kind == TypeKind.Error) {
      return left;
    }

    const hint = this.types.nullishHint(left, expected);
    const rhsExpr = tree.exprOf(expr.rhsId);
    const right = this.typed(rhsExpr, hint, module);
    const pair: OperandPair = { left, right };

    if (left.kind == TypeKind.Error || right.kind == TypeKind.Error) {
      return this.types.store.plain(TypeKind.Error);
    }
    if (left.kind == TypeKind.Void || right.kind == TypeKind.Void) {
      const operandsError = this.types.operandsError(expr, pair);

      this.errors.writeFound(module, operandsError);

      return this.types.store.plain(TypeKind.Error);
    }
    if (left.kind == TypeKind.Undefined) {
      return right;
    }

    const base = this.types.nullishBase(left, right);
    if (base == undefined || base.kind == TypeKind.Error) {
      const operandsError2 = this.types.operandsError(expr, pair);

      this.errors.writeFound(module, operandsError2);

      return this.types.store.plain(TypeKind.Error);
    }
    if (this.types.isOptional(right) || right.kind == TypeKind.Undefined) {
      return this.types.optional(base);
    }

    return base;
  }
}
