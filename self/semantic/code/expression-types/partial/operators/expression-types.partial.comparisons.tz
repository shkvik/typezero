import {
  ComparedPair,
  ComparedSide,
  OperandPair,
  RequirementKind,
} from "../../types/expression-types.types.tz";
import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  BinaryExpr,
  Expr,
  ExprKind,
  UnaryOp,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";

partial class ExpressionTypes {
  private equalityTyped(expr: BinaryExpr, module: int): Type {
    const boolean = this.store.plain(TypeKind.Boolean);
    const isNull =
      this.isNullSide(expr.lhs, module) || this.isNullSide(expr.rhs, module);
    if (isNull) {
      this.nullEquality(expr, module);

      return boolean;
    }

    const sides = this.comparedOperands(expr, module);

    this.typeOfCheck(sides.left, expr.rhs, module);
    this.typeOfCheck(sides.right, expr.lhs, module);

    const pair = { left: sides.left.type, right: sides.right.type };

    this.equalOperands(expr, pair, module);

    return boolean;
  }

  private equalOperands(
    expr: BinaryExpr,
    pair: OperandPair,
    module: int,
  ): void {
    const left = pair.left;
    const right = pair.right;
    const plainLeft = this.types.definedType(left);
    const plainRight = this.types.definedType(right);

    if (left.kind == TypeKind.Error || right.kind == TypeKind.Error) {
      return;
    }
    if (left.kind == TypeKind.Void || right.kind == TypeKind.Void) {
      const operandsError = this.operators.operandsError(expr, pair);

      return this.reportFound(module, operandsError);
    }
    if (left.kind == TypeKind.Undefined || right.kind == TypeKind.Undefined) {
      return;
    }

    const hasJson =
      plainLeft.kind == TypeKind.Json || plainRight.kind == TypeKind.Json;
    if (hasJson) {
      const jsonEqualityError = this.comparisons.jsonEqualityError(expr, pair);

      return this.reportFound(module, jsonEqualityError);
    }

    const hasResult =
      plainLeft.kind == TypeKind.Result || plainRight.kind == TypeKind.Result;
    if (hasResult) {
      const other = this.sources.operatorText(expr.op);

      return this.report(module, expr.loc, Code.ResultsCompared, { other });
    }

    const hasParameter =
      plainLeft.kind == TypeKind.TypeParameter ||
      plainRight.kind == TypeKind.TypeParameter;
    if (hasParameter && plainLeft == plainRight) {
      const word = this.sources.operatorText(expr.op);

      return this.requireOf(plainLeft, RequirementKind.Compare, word);
    }
    if (hasParameter) {
      return;
    }

    const adapted = this.adapted(expr, pair, module);
    const hasIntegers =
      adapted.left.kind == TypeKind.Int && adapted.right.kind == TypeKind.Int;
    if (hasIntegers) {
      return;
    }

    const common = this.comparisons.comparisonType(adapted.left, adapted.right);
    if (common == undefined) {
      const incomparableError = this.comparisons.incomparableError(
        expr,
        adapted,
        module,
      );

      this.reportFound(module, incomparableError);
    }
  }

  private comparedOperands(expr: BinaryExpr, module: int): ComparedPair {
    const isLiteralLeft = this.comparisons.isComparedLiteral(expr.lhs);
    const isLiteralRight = this.comparisons.isComparedLiteral(expr.rhs);
    if (isLiteralLeft && !isLiteralRight) {
      const right = this.comparedSide(expr.rhs, undefined, module);
      const leftHint = this.comparisons.comparisonHint(right.type, expr.lhs);
      const left = this.comparedSide(expr.lhs, leftHint, module);

      return { left, right };
    }

    const left = this.comparedSide(expr.lhs, undefined, module);
    const rightHint = this.comparisons.literalComparisonHint(
      isLiteralRight,
      left.type,
      expr.rhs,
    );
    const right = this.comparedSide(expr.rhs, rightHint, module);

    return { left, right };
  }

  private comparedSide(
    expr: Expr,
    hint: Type | undefined,
    module: int,
  ): ComparedSide {
    if (expr.kind != ExprKind.Unary || expr.op != UnaryOp.TypeOf) {
      return { type: this.typed(expr, hint, module) };
    }

    const tested = this.typed(expr.operand, undefined, module);
    const type = this.store.plain(TypeKind.String);

    return { type, tested };
  }

  private isNullSide(expr: Expr, module: int): boolean {
    return expr.kind == ExprKind.Name && this.isNullName(expr, module);
  }

  private nullEquality(expr: BinaryExpr, module: int): void {
    const isLeftNull = this.isNullSide(expr.lhs, module);
    const isRightNull = this.isNullSide(expr.rhs, module);
    const nullSide = this.comparisons.nullOperand(isLeftNull, expr);
    const type = this.nullOther(isLeftNull, isRightNull, expr, module);
    const plain = this.types.definedType(type);
    if (type.kind == TypeKind.Error || plain.kind == TypeKind.Json) {
      return;
    }

    const first = this.text.of(type);
    const other = this.sources.operatorText(expr.op);

    this.report(module, nullSide.loc, Code.NullNeverEqual, { first, other });
  }

  private nullOther(
    isLeftNull: boolean,
    isRightNull: boolean,
    expr: BinaryExpr,
    module: int,
  ): Type {
    if (isLeftNull && isRightNull) {
      return this.store.plain(TypeKind.Undefined);
    }
    if (isLeftNull) {
      return this.typed(expr.rhs, undefined, module);
    }

    return this.typed(expr.lhs, undefined, module);
  }

  private orderTyped(expr: BinaryExpr, module: int): Type {
    const boolean = this.store.plain(TypeKind.Boolean);
    const sides = this.comparedOperands(expr, module);
    const written = sides.left.type;
    const isSameParameter =
      written.kind == TypeKind.TypeParameter && written == sides.right.type;
    if (isSameParameter) {
      const word = this.sources.operatorText(expr.op);

      this.requireOf(written, RequirementKind.Compare, word);

      return boolean;
    }

    const left = this.types.apparent(written);
    const right = this.types.apparent(sides.right.type);

    this.orderOperands(expr, { left, right }, module);

    return boolean;
  }

  private orderOperands(
    expr: BinaryExpr,
    pair: OperandPair,
    module: int,
  ): void {
    const left = pair.left;
    const right = pair.right;
    const isBroken =
      left.kind == TypeKind.Error || right.kind == TypeKind.Error;
    const isText =
      left.kind == TypeKind.String && right.kind == TypeKind.String;
    if (isBroken || isText) {
      return;
    }
    if (this.types.isDate(left) || this.types.isDate(right)) {
      const dateComparisonErrors = this.dates.dateComparisonErrors(expr, pair);

      return this.reportAll(module, dateComparisonErrors);
    }
    if (left.kind == TypeKind.Decimal || right.kind == TypeKind.Decimal) {
      return this.decimalComparison(expr, pair, module);
    }
    if (!this.types.isNumeric(left) || !this.types.isNumeric(right)) {
      const operandsError = this.operators.operandsError(expr, pair);

      return this.reportFound(module, operandsError);
    }

    const adapted = this.adapted(expr, pair, module);
    const isSame = adapted.left == adapted.right;
    const hasIntegers =
      adapted.left.kind == TypeKind.Int && adapted.right.kind == TypeKind.Int;
    if (!isSame && !hasIntegers) {
      const mixedError = this.operators.mixedError(expr, adapted, module);

      this.reportFound(module, mixedError);
    }
  }

  private decimalComparison(
    expr: BinaryExpr,
    pair: OperandPair,
    module: int,
  ): void {
    const isLeftFitting = this.isDecimalSide(expr.lhs, pair.left, module);
    const isRightFitting = this.isDecimalSide(expr.rhs, pair.right, module);
    if (!isLeftFitting || !isRightFitting) {
      const decimalMixError = this.decimals.decimalMixError(expr, pair, module);

      this.reportFound(module, decimalMixError);
    }
  }

  private nullishTyped(
    expr: BinaryExpr,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const expected = this.types.wantedPart(wanted);
    const left = this.typed(expr.lhs, expected, module);
    if (left.kind == TypeKind.Error) {
      return left;
    }

    const hint = this.comparisons.nullishHint(left, expected);
    const right = this.typed(expr.rhs, hint, module);
    const pair: OperandPair = { left, right };

    if (left.kind == TypeKind.Error || right.kind == TypeKind.Error) {
      return this.store.plain(TypeKind.Error);
    }
    if (left.kind == TypeKind.Void || right.kind == TypeKind.Void) {
      const operandsError = this.operators.operandsError(expr, pair);

      this.reportFound(module, operandsError);

      return this.store.plain(TypeKind.Error);
    }
    if (left.kind == TypeKind.Undefined) {
      return right;
    }

    const base = this.comparisons.nullishBase(left, right);
    if (base == undefined || base.kind == TypeKind.Error) {
      const operandsError2 = this.operators.operandsError(expr, pair);

      this.reportFound(module, operandsError2);

      return this.store.plain(TypeKind.Error);
    }
    if (this.types.isOptional(right) || right.kind == TypeKind.Undefined) {
      return this.types.optional(base);
    }

    return base;
  }
}
