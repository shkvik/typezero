import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  BinaryExpr,
  BinaryOp,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";

partial class ExpressionTypes {
  private reportNothingChanged(
    expr: BinaryExpr,
    left: Type,
    module: int,
  ): void {
    const other = this.sources.operatorText(expr.op);
    const texts = this.sources.operandTexts(expr, module);
    const word = this.sources.namedText(texts.left);

    if (left.kind == TypeKind.Double) {
      return this.report(module, expr.loc, Code.NoOpBitsTrunc, {
        word,
        other,
      });
    }

    const first = this.sources.shownOperand(texts.left);

    if (expr.op == BinaryOp.UShr) {
      return this.report(module, expr.loc, Code.NoOpBitsWrapUnsigned, {
        word,
        other,
        first,
      });
    }

    this.report(module, expr.loc, Code.NoOpBitsWrap, { word, other, first });
  }

  private reportBitsOfDouble(expr: BinaryExpr, left: Type, module: int): void {
    const other = this.sources.operatorText(expr.op);
    const texts = this.sources.operandTexts(expr, module);
    const fraction = this.operators.fractionText(left, texts);
    const word = this.sources.shownOperand(fraction);

    this.report(module, expr.loc, Code.BitsOfDouble, { other, word });
  }

  private reportSignedShift(expr: BinaryExpr, left: Type, module: int): void {
    if (left.kind != TypeKind.Int) {
      return;
    }

    const texts = this.sources.operandTexts(expr, module);
    const word = this.sources.shownOperand(texts.left);
    const second = this.sources.countText(texts.right);
    const unsigned = this.store.integer(left.bits, true);
    const other = this.mismatches.conversionName(unsigned);
    const first = this.text.of(left);

    this.report(module, expr.loc, Code.SignedShift, {
      first,
      word,
      other,
      second,
    });
  }
}
