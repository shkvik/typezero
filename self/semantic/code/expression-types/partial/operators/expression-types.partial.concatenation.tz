import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import { Details } from "../../../../../diagnostic/types/message.types.tz";
import {
  BinaryExpr,
  Expr,
  ExprKind,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  kToStringName,
  kBacktick,
  kCloseValue,
  kDictTexts,
  kDollar,
  kEscape,
  kOpenBrace,
  kOpenValue,
  kQuotes,
  kRegExpName,
  kTemplateFrame,
} from "../../const/expression-types.const.tz";
import {
  ConcatLink,
  ConcatPart,
  OperandPair,
  TemplatePiece,
  TemplateText,
} from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private concatenated(expr: BinaryExpr, pair: OperandPair, module: int): Type {
    this.textCheck(expr.lhs, pair.left, module);
    this.textCheck(expr.rhs, pair.right, module);

    return this.store.plain(TypeKind.String);
  }

  private textCheck(operand: Expr, type: Type, module: int): void {
    const base = this.types.definedType(type);
    const isText = type.kind == TypeKind.String || type.kind == TypeKind.Error;

    if (base.kind == TypeKind.Instance) {
      return this.instanceTextCheck(operand, base, module);
    }
    if (isText || base.kind == TypeKind.TypeParameter) {
      return;
    }

    const code = this.textProblem(type, base);
    if (code == undefined) {
      return;
    }

    const details = this.textDetails(code, type, base);

    this.report(module, operand.loc, code, details);
  }

  private instanceTextCheck(operand: Expr, base: Type, module: int): void {
    if (base.kind != TypeKind.Instance || this.isLibraryModule(base.module)) {
      return;
    }

    const decl = this.classOf(base);
    if (decl == undefined || decl.typeParams.length > 0) {
      return;
    }

    const hasOwn = decl.methods.some((one) => one.name == kToStringName);
    if (!hasOwn) {
      this.report(module, operand.loc, Code.ObjectToText, kNoDetails);

      return;
    }

    const word = this.tupleText(operand);

    this.report(module, operand.loc, Code.OwnToString, { word });
  }

  private textProblem(type: Type, base: Type): Code | undefined {
    if (this.holdsKind(type, TypeKind.Function)) {
      return Code.FunctionToText;
    }
    if (base.kind == TypeKind.Tuple) {
      return Code.TupleToText;
    }
    if (this.holdsKind(type, TypeKind.Result)) {
      return Code.ResultToText;
    }
    if (base.kind == TypeKind.Dict) {
      return Code.DictToText;
    }
    if (base.kind == TypeKind.Iterator) {
      return Code.IteratorToText;
    }
    if (this.holdsKind(type, TypeKind.Unknown)) {
      return Code.UnknownToText;
    }
    if (this.holdsKind(type, TypeKind.Json)) {
      return Code.JsonToText;
    }
    if (this.holdsObjects(type)) {
      return Code.ObjectToText;
    }
    if (this.textMember(base) != undefined) {
      return Code.UnionToText;
    }

    return undefined;
  }

  private textDetails(code: Code, type: Type, base: Type): Details {
    if (code == Code.DictToText && base.kind == TypeKind.Dict) {
      const dict = base.dict;
      const row = kDictTexts.find((one) => one.dict == dict);

      return { word: row?.kind ?? "", other: row?.shown ?? "" };
    }

    const member = this.textMember(base);
    if (code != Code.UnionToText || member == undefined) {
      return kNoDetails;
    }

    const first = this.text.of(type);
    const second = this.text.of(member);

    return { first, second };
  }

  private holdsKind(type: Type, kind: TypeKind): boolean {
    const held = this.types.definedType(type);
    if (held.kind == TypeKind.Array) {
      return this.holdsKind(held.item, kind);
    }

    return held.kind == kind;
  }

  private textMember(base: Type): Type | undefined {
    if (base.kind != TypeKind.Union || !this.relation.isTagged(base.parts)) {
      return undefined;
    }

    return base.parts.find((part) => this.isHeldMember(part));
  }

  private isHeldMember(part: Type): boolean {
    const isSpecial = this.isDate(part) || this.isRegExp(part);
    if (this.types.isObjectKind(part) && !isSpecial) {
      return true;
    }

    switch (part.kind) {
      case TypeKind.Dict:
      case TypeKind.Function:
      case TypeKind.Iterator:
        return true;
      default:
        return false;
    }
  }

  private isRegExp(type: Type): boolean {
    return type.kind == TypeKind.Instance && type.name == kRegExpName;
  }

  private checkMixedConcat(links: ConcatLink[], module: int): void {
    const first = links.find((link) => this.isMixing(link.left, link.right));
    const root = links[links.length - 1];
    if (first == undefined || root == undefined) {
      return;
    }

    const parts = this.concatParts(root, links, module);
    const joined = this.concatTemplate(parts);
    const left = this.text.of(first.left);
    const right = this.text.of(first.right);
    const loc = first.binary.loc;

    if (joined.only != "") {
      return this.report(module, loc, Code.MixedConcatString, {
        first: left,
        second: right,
        word: joined.only,
      });
    }

    const sum = this.sumHint(parts);
    if (sum != "") {
      return this.report(module, loc, Code.MixedConcatSum, {
        first: left,
        second: right,
        other: sum,
        word: joined.text,
      });
    }

    this.report(module, loc, Code.MixedConcatTemplate, {
      first: left,
      second: right,
      word: joined.text,
    });
  }

  private isMixing(left: Type, right: Type): boolean {
    const isLeftText = left.kind == TypeKind.String && this.joinsAsText(right);
    const isRightText = right.kind == TypeKind.String && this.joinsAsText(left);

    return isLeftText || isRightText;
  }

  private joinsAsText(type: Type): boolean {
    const base = this.types.definedType(type);

    return this.types.isNumberLike(base) || base.kind == TypeKind.Boolean;
  }

  private concatParts(
    root: ConcatLink,
    links: ConcatLink[],
    module: int,
  ): ConcatPart[] {
    const chain: ConcatLink[] = [root];
    let below = this.linkBelow(root, links);

    while (below != undefined) {
      chain.push(below);
      below = this.linkBelow(below, links);
    }

    const parts: ConcatPart[] = [];
    const first = chain[chain.length - 1] ?? root;
    const texts = this.operandTexts(first.binary, module);

    parts.push({ expr: first.binary.lhs, text: texts.left, type: first.left });

    for (let index = chain.length - 1; index >= 0; index--) {
      const link = chain[index];
      if (link == undefined) {
        continue;
      }

      const linkTexts = this.operandTexts(link.binary, module);

      parts.push({
        expr: link.binary.rhs,
        text: linkTexts.right,
        type: link.right,
      });
    }

    return parts;
  }

  private linkBelow(
    link: ConcatLink,
    links: ConcatLink[],
  ): ConcatLink | undefined {
    const left = link.binary.lhs;

    return links.find(
      (one) => one.binary == left && one.type.kind == TypeKind.String,
    );
  }

  private concatTemplate(parts: ConcatPart[]): TemplateText {
    let text = kBacktick;
    let values = 0;
    let only = "";

    for (const part of parts) {
      if (part.text == "") {
        return { text: "", only: "" };
      }

      const piece = this.templatePiece(part);

      text = text + piece.text;

      if (piece.value != undefined) {
        values += 1;
        only = piece.value;
      }
    }

    const isSingle = values == 1 && text.length == only.length + kTemplateFrame;
    const closed = text + kBacktick;

    if (!isSingle) {
      return { text: closed, only: "" };
    }

    return { text: closed, only };
  }

  private templatePiece(part: ConcatPart): TemplatePiece {
    const text = part.text;
    const head = text.slice(0, 1);
    const tail = text.slice(text.length - 1);
    const isQuoted = text.length >= 2 && head == tail;
    const isString = part.expr.kind == ExprKind.StringLit;
    if (isString && isQuoted && kQuotes.includes(head)) {
      return { text: this.escapedBody(text) };
    }

    const isTemplate = part.expr.kind == ExprKind.Template;
    if (isTemplate && isQuoted && head == kBacktick) {
      return { text: text.slice(1, text.length - 1) };
    }

    const value = this.withoutParens(text);

    return { text: kOpenValue + value + kCloseValue, value };
  }

  private escapedBody(text: string): string {
    const body = text.slice(1, text.length - 1);
    let escaped = "";
    let index = 0;

    while (index < body.length) {
      const unit = body.charAt(index);
      const next = body.charAt(index + 1);

      if (unit == kEscape && index + 1 < body.length) {
        escaped = escaped + unit + next;
        index += 2;

        continue;
      }

      const isOpening = unit == kDollar && next == kOpenBrace;
      if (unit == kBacktick || isOpening) {
        escaped = escaped + kEscape;
      }

      escaped = escaped + unit;
      index += 1;
    }

    return escaped;
  }

  private sumHint(parts: ConcatPart[]): string {
    const first = parts[0];
    const second = parts[1];
    if (parts.length != 2 || first == undefined || second == undefined) {
      return "";
    }
    if (this.isNumeric(first.type) && this.isTextValue(second)) {
      return `${first.text} + Number(${second.text})`;
    }
    if (this.isTextValue(first) && this.isNumeric(second.type)) {
      return `Number(${first.text}) + ${second.text}`;
    }

    return "";
  }

  private isTextValue(part: ConcatPart): boolean {
    const kind = part.expr.kind;
    const isWritten = kind == ExprKind.StringLit || kind == ExprKind.Template;

    return part.type.kind == TypeKind.String && !isWritten;
  }
}
