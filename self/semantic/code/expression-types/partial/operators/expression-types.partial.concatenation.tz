import {
  OperandPair,
  RequirementKind,
} from "../../types/expression-types.types.tz";
import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  BinaryExpr,
  Expr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { kToStringName } from "../../const/expression-types.const.tz";
import { ConcatLink } from "../../../concatenation-rules/types/concatenation-rules.types.tz";

partial class ExpressionTypes {
  private concatenated(expr: BinaryExpr, pair: OperandPair, module: int): Type {
    const tree = this.types.program.tree;

    const lhs = tree.exprOf(expr.lhsId);

    this.textCheck(lhs, pair.left, module);
    const rhs = tree.exprOf(expr.rhsId);

    this.textCheck(rhs, pair.right, module);

    return this.types.store.plain(TypeKind.String);
  }

  private textCheck(operand: Expr, type: Type, module: int): void {
    const base = this.types.definedType(type);
    const isText = type.kind == TypeKind.String || type.kind == TypeKind.Error;

    if (base.kind == TypeKind.Instance) {
      return this.instanceTextCheck(operand, base, module);
    }
    if (isText || base.kind == TypeKind.TypeParameter) {
      return this.requireOf(base, RequirementKind.Text, "");
    }

    const answer = this.types.textAnswer(type, base);
    if (answer != undefined) {
      this.errors.write(module, operand.loc, answer.code, answer.details);
    }
  }

  private instanceTextCheck(operand: Expr, base: Type, module: int): void {
    const tree = this.types.program.tree;

    if (this.byteTextCheck(operand, base, module)) {
      return;
    }
    if (
      base.kind != TypeKind.Instance ||
      this.types.isLibraryModule(base.module)
    ) {
      return;
    }

    const decl = this.classOf(base);
    if (
      decl == undefined ||
      tree.typeParamsOf(decl.typeParamsList).length > 0
    ) {
      return;
    }

    const hasOwn = this.types.hasClassMethod(decl, kToStringName);
    if (!hasOwn) {
      this.errors.write(module, operand.loc, Code.ObjectToText, kNoDetails);

      return;
    }

    const word = this.types.sourceTupleText(operand);

    this.errors.write(module, operand.loc, Code.OwnToString, { word });
  }

  private checkMixedConcat(links: Read<ConcatLink[]>, module: int): void {
    const answer = this.types.mixedAnswer(links, module);
    if (answer != undefined) {
      this.errors.write(module, answer.loc, answer.code, answer.details);
    }
  }
}
