import {
  OperandPair,
  RequirementKind,
} from "../../types/expression-types.types.tz";
import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  BinaryExpr,
  Expr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { kToStringName } from "../../const/expression-types.const.tz";
import { ConcatLink } from "../../../concatenation-rules/types/concatenation-rules.types.tz";

partial class ExpressionTypes {
  private readonly concatenated(expr: BinaryExpr, pair: OperandPair, module: int): Type {
    this.textCheck(expr.lhs, pair.left, module);
    this.textCheck(expr.rhs, pair.right, module);

    return this.store.plain(TypeKind.String);
  }

  private readonly textCheck(operand: Expr, type: Type, module: int): void {
    const base = this.types.definedType(type);
    const isText = type.kind == TypeKind.String || type.kind == TypeKind.Error;

    if (base.kind == TypeKind.Instance) {
      return this.instanceTextCheck(operand, base, module);
    }
    if (isText || base.kind == TypeKind.TypeParameter) {
      return this.requireOf(base, RequirementKind.Text, "");
    }

    const answer = this.concatenations.textAnswer(type, base);
    if (answer != undefined) {
      this.report(module, operand.loc, answer.code, answer.details);
    }
  }

  private readonly instanceTextCheck(operand: Expr, base: Type, module: int): void {
    if (this.byteTextCheck(operand, base, module)) {
      return;
    }
    if (
      base.kind != TypeKind.Instance ||
      this.modules.isLibraryModule(base.module)
    ) {
      return;
    }

    const decl = this.classOf(base);
    if (decl == undefined || decl.typeParams.length > 0) {
      return;
    }

    const hasOwn = decl.methods.some((one) => one.name == kToStringName);
    if (!hasOwn) {
      this.report(module, operand.loc, Code.ObjectToText, kNoDetails);

      return;
    }

    const word = this.sources.tupleText(operand);

    this.report(module, operand.loc, Code.OwnToString, { word });
  }

  private readonly checkMixedConcat(links: Read<ConcatLink[]>, module: int): void {
    const answer = this.concatenations.mixedAnswer(links, module);
    if (answer != undefined) {
      this.report(module, answer.loc, answer.code, answer.details);
    }
  }
}
