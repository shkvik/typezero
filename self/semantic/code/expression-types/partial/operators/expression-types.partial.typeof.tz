import { ExpressionTypes } from "../../expression-types.tz";
import {
  Expr,
  ExprKind,
  UnaryExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { ComparedSide } from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private typeofTyped(expr: UnaryExpr, module: int): Type {
    const tree = this.types.program.tree;

    const operand = tree.exprOf(expr.operandId);

    this.typed(operand, undefined, module);

    return this.types.store.plain(TypeKind.String);
  }

  private typeOfCheck(side: ComparedSide, other: Expr, module: int): void {
    const tested = side.tested;
    if (tested == undefined || other.kind != ExprKind.StringLit) {
      return;
    }

    const answer = this.types.typeOfAnswerOf(tested, other.value);
    if (answer != undefined) {
      this.errors.write(module, other.loc, answer.code, answer.details);
    }
  }
}
