import { ExpressionTypes } from "../../expression-types.tz";
import {
  BinaryExpr,
  BinaryOp,
  Expr,
  UnaryExpr,
  UnaryOp,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  IntType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { kRoundDown } from "../../const/expression-types.const.tz";

partial class ExpressionTypes {
  private foldBinary(expr: BinaryExpr, type: Type, module: int): void {
    if (type.kind != TypeKind.Int || type.wraps) {
      return;
    }
    if (type.unsigned && type.bits == 64) {
      return this.foldUnsigned(expr, type, module);
    }

    const left = this.intConstant(expr.lhs, type, module);
    const right = this.intConstant(expr.rhs, type, module);
    if (left == undefined || right == undefined) {
      return;
    }

    switch (expr.op) {
      case BinaryOp.Add:
        return this.settle(expr, type, left + right, module);
      case BinaryOp.Sub:
        return this.settle(expr, type, left - right, module);
      case BinaryOp.Mul:
        return this.settle(expr, type, left * right, module);
      case BinaryOp.Div:
      case BinaryOp.Rem:
        return this.foldDivision(expr, type, left, right, module);
      case BinaryOp.Pow:
        return this.foldPower(expr, type, left, right, module);
      case BinaryOp.BitAnd:
      case BinaryOp.BitOr:
      case BinaryOp.BitXor:
        return this.foldBits(expr, type, left, right);
      default:
        return;
    }
  }

  private foldUnsigned(expr: BinaryExpr, type: IntType, module: int): void {
    const left = this.rawConstant(expr.lhs, type, module);
    const right = this.rawConstant(expr.rhs, type, module);
    if (left == undefined || right == undefined) {
      return;
    }

    const value = this.integers.unsignedValue(expr.op, left, right);
    if (value == undefined) {
      return;
    }
    if (this.integers.isInside(value, type)) {
      this.answers.fold(expr, value);

      return;
    }

    const overflowError = this.operators.overflowError(
      expr,
      type,
      `${value}`,
      0,
    );

    this.reportFound(module, overflowError);
  }

  private foldUnary(expr: UnaryExpr, type: Type, module: int): void {
    if (type.kind != TypeKind.Int || type.wraps) {
      return;
    }

    const value = this.intConstant(expr.operand, type, module);
    if (value == undefined) {
      return;
    }

    switch (expr.op) {
      case UnaryOp.Plus:
        this.answers.fold(expr, value);

        return;
      case UnaryOp.Neg:
        return this.settle(expr, type, -value, module);
      case UnaryOp.BitNot: {
        const pattern = this.integers.wrapTo(value, type);
        const inverted = this.integers.wrapTo(-pattern - 1, type);

        this.answers.fold(expr, inverted);

        return;
      }
      default:
        return;
    }
  }

  private readonly settle(expr: Expr, type: IntType, value: decimal, module: int): void {
    if (this.integers.isInside(value, type)) {
      this.answers.fold(expr, value);

      return;
    }

    const wrapped = this.integers.wrapTo(value, type);

    const overflowError = this.operators.overflowError(
      expr,
      type,
      `${value}`,
      wrapped,
    );

    this.reportFound(module, overflowError);
  }

  private readonly foldDivision(
    expr: BinaryExpr,
    type: IntType,
    left: decimal,
    right: decimal,
    module: int,
  ): void {
    if (right == 0) {
      return;
    }
    if (expr.op == BinaryOp.Rem) {
      return this.settle(expr, type, left % right, module);
    }

    const quotient = left.div(right, 0, kRoundDown);

    this.settle(expr, type, quotient, module);
  }

  private readonly foldPower(
    expr: BinaryExpr,
    type: IntType,
    base: decimal,
    exponent: decimal,
    module: int,
  ): void {
    if (exponent < 0) {
      return;
    }

    const exact = this.integers.exactPower(base, exponent);
    if (exact != undefined && this.integers.isInside(exact, type)) {
      this.answers.fold(expr, exact);

      return;
    }

    const shown = this.integers.powerShown(exact, base, exponent);
    const wrapped = this.integers.wrappedPower(base, exponent, type);

    const overflowError = this.operators.overflowError(
      expr,
      type,
      shown,
      wrapped,
    );

    this.reportFound(module, overflowError);
  }

  private readonly foldBits(
    expr: BinaryExpr,
    type: IntType,
    left: decimal,
    right: decimal,
  ): void {
    const span = this.integers.spanOf(type);
    let first = this.integers.patternOf(left, span);
    let second = this.integers.patternOf(right, span);
    let result: decimal = 0;
    let place: decimal = 1;

    for (let index = 0; index < type.bits; index += 1) {
      const one = first % 2;
      const other = second % 2;
      const bit = this.integers.bitOf(expr.op, one, other);

      result += bit * place;
      first = (first - one) / 2;
      second = (second - other) / 2;
      place *= 2;
    }

    const value = this.integers.wrapTo(result, type);

    this.answers.fold(expr, value);
  }

  private readonly foldShift(
    expr: BinaryExpr,
    shifted: IntType,
    value: decimal,
    count: decimal,
    module: int,
  ): void {
    const factor = this.integers.twoPower(count);

    if (expr.op != BinaryOp.Shl) {
      const dropped = this.integers.patternOf(value, factor);
      const moved = (value - dropped).div(factor, 0, kRoundDown);

      this.answers.fold(expr, moved);

      return;
    }

    const exact = value * factor;
    if (this.integers.isInside(exact, shifted)) {
      this.answers.fold(expr, exact);

      return;
    }

    const overflowError = this.operators.overflowError(
      expr,
      shifted,
      `${exact}`,
      0,
    );

    this.reportFound(module, overflowError);
  }
}
