import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  BinaryExpr,
  BinaryOp,
  ConditionalExpr,
  Expr,
  ExprKind,
  UnaryExpr,
  UnaryOp,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { LogicSide } from "../../types/expression-types.types.tz";
import { TruthUse } from "../../../../flow/truth-rules/types/truth-rules.types.tz";

partial class ExpressionTypes {
  private notTyped(expr: UnaryExpr, module: int): Type {
    const tree = this.types.program.tree;

    const operand = tree.exprOf(expr.operandId);

    this.branchCheck(operand, TruthUse.Not, module);

    return this.types.store.plain(TypeKind.Boolean);
  }

  private branchCheck(expr: Expr, use: TruthUse, module: int): void {
    const tree = this.types.program.tree;

    if (this.types.isLogical(expr) && expr.kind == ExprKind.Binary) {
      const isAnd = expr.op == BinaryOp.LogAnd;

      const lhs = tree.exprOf(expr.lhsId);

      this.branchCheck(lhs, TruthUse.Condition, module);

      const lhsExpr = tree.exprOf(expr.lhsId);
      const facts = this.factsOf(lhsExpr, isAnd, module);
      const before = this.underFacts(facts);

      const rhs = tree.exprOf(expr.rhsId);

      this.branchCheck(rhs, TruthUse.Condition, module);
      this.facts = before;
      this.redundantTestsCheck(expr, module);

      return;
    }
    if (expr.kind == ExprKind.Unary && expr.op == UnaryOp.Not) {
      return this.branchCheck(
        tree.exprOf(expr.operandId),
        TruthUse.Not,
        module,
      );
    }

    const boolean = this.types.store.plain(TypeKind.Boolean);
    const type = this.typed(expr, boolean, module);

    if (expr.kind == ExprKind.Assign && expr.op == undefined) {
      const assignmentConditionError = this.types.assignmentConditionError(
        expr,
        type,
        use,
      );

      return this.errors.writeFound(module, assignmentConditionError);
    }
    if (type.kind != TypeKind.Boolean) {
      this.checkTruthy(expr, type, use, undefined, module);
    }
  }

  private logicalTyped(
    expr: BinaryExpr,
    wanted: Type | undefined,
    side: LogicSide,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const isAnd = expr.op == BinaryOp.LogAnd;
    const use = this.types.logicalUse(isAnd);
    const expected = this.types.wantedPart(wanted);
    const written = this.testedValue(
      tree.exprOf(expr.lhsId),
      expected,
      use,
      module,
    );
    const left = this.types.apparent(written);
    const isLeftTruthy = this.checkTruthy(
      tree.exprOf(expr.lhsId),
      left,
      use,
      tree.exprOf(expr.rhsId),
      module,
    );
    const hint = this.types.rightHint(isAnd, left, expected);
    const lhs = tree.exprOf(expr.lhsId);
    const facts = this.factsOf(lhs, isAnd, module);
    const before = this.underFacts(facts);
    const right = this.logicalRight(expr, hint, side, module);

    this.facts = before;
    this.redundantTestsCheck(expr, module);

    const isRightTruthy =
      side == LogicSide.Value ||
      this.checkTruthy(
        tree.exprOf(expr.rhsId),
        right,
        TruthUse.Condition,
        undefined,
        module,
      );
    if (!isLeftTruthy || !isRightTruthy) {
      return this.types.store.plain(TypeKind.Error);
    }

    return this.logicalResult(expr, left, right, isAnd, module);
  }

  private testedValue(
    expr: Expr,
    expected: Type | undefined,
    use: TruthUse,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    if (this.types.isLogical(expr) && expr.kind == ExprKind.Binary) {
      return this.logicalTyped(expr, expected, LogicSide.Tested, module);
    }
    if (expr.kind == ExprKind.Unary && expr.op == UnaryOp.Not) {
      const operand = tree.exprOf(expr.operandId);

      this.branchCheck(operand, TruthUse.Not, module);

      return this.types.store.plain(TypeKind.Boolean);
    }

    return this.typed(expr, expected, module);
  }

  private logicalRight(
    expr: BinaryExpr,
    hint: Type | undefined,
    side: LogicSide,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    if (side == LogicSide.Value) {
      const rhs = tree.exprOf(expr.rhsId);

      return this.typed(rhs, hint, module);
    }

    return this.testedValue(
      tree.exprOf(expr.rhsId),
      hint,
      TruthUse.Condition,
      module,
    );
  }

  private logicalResult(
    expr: BinaryExpr,
    left: Type,
    right: Type,
    isAnd: boolean,
    module: int,
  ): Type {
    const checked = this.types.logicalResult(expr, left, right, isAnd);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private reportRightVoid(expr: BinaryExpr, isAnd: boolean, module: int): Type {
    const checked = this.types.rightVoid(expr, isAnd);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private conditionalTyped(
    expr: ConditionalExpr,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const cond = tree.exprOf(expr.condId);

    this.branchCheck(cond, TruthUse.Condition, module);

    const start = this.recursions.length;
    const thenExpr = tree.exprOf(expr.thenExprId);
    const isThenWaiting = this.types.isWaiting(thenExpr);
    const elseExpr = tree.exprOf(expr.elseExprId);
    const isElseWaiting = this.types.isWaiting(elseExpr);
    if (isThenWaiting && !isElseWaiting) {
      const elseType = this.branchTyped(expr, false, wanted, module);
      const thenHint = this.types.branchHint(
        tree.exprOf(expr.thenExprId),
        elseType,
        wanted,
      );
      const thenType = this.branchTyped(expr, true, thenHint, module);

      return this.joinedBranches(expr, thenType, elseType, start, module);
    }

    const thenType = this.branchTyped(expr, true, wanted, module);
    const elseHint = this.types.elseHint(
      expr,
      thenType,
      wanted,
      isElseWaiting && !isThenWaiting,
    );
    const elseType = this.branchTyped(expr, false, elseHint, module);

    return this.joinedBranches(expr, thenType, elseType, start, module);
  }

  private branchTyped(
    expr: ConditionalExpr,
    isThen: boolean,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const branch = this.types.sideOf(
      isThen,
      tree.exprOf(expr.thenExprId),
      tree.exprOf(expr.elseExprId),
    );
    const cond = tree.exprOf(expr.condId);
    const facts = this.factsOf(cond, isThen, module);
    const before = this.underFacts(facts);
    const type = this.typed(branch, wanted, module);

    this.facts = before;

    return type;
  }

  private joinedBranches(
    expr: ConditionalExpr,
    thenType: Type,
    elseType: Type,
    start: int,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const isThenBroken = thenType.kind == TypeKind.Error;
    const isElseBroken = elseType.kind == TypeKind.Error;
    if (isThenBroken || isElseBroken) {
      return this.failedBranches(thenType, elseType, start);
    }

    const isDifferent = thenType.id != elseType.id;
    const thenTarget = this.adaptedBranch(
      isDifferent,
      tree.exprOf(expr.thenExprId),
      thenType,
      elseType,
      module,
    );
    const elseTarget = this.adaptedBranch(
      isDifferent && thenTarget.id == thenType.id,
      tree.exprOf(expr.elseExprId),
      elseType,
      thenType,
      module,
    );
    const common = this.types.unionUnify(thenTarget, elseTarget);
    if (common != undefined) {
      return common;
    }

    const first = this.types.typeText(thenTarget);
    const second = this.types.typeText(elseTarget);

    this.errors.write(module, expr.loc, Code.BranchesIncompatible, {
      first,
      second,
    });

    return this.types.store.plain(TypeKind.Error);
  }

  private readonly failedBranches(
    thenType: Type,
    elseType: Type,
    start: int,
  ): Type {
    const isPending = this.recursions.length > start;
    const isThenBroken = thenType.kind == TypeKind.Error;
    const isElseBroken = elseType.kind == TypeKind.Error;
    if (!isPending || isThenBroken == isElseBroken) {
      return this.types.store.plain(TypeKind.Error);
    }
    if (isThenBroken) {
      return elseType;
    }

    return thenType;
  }

  private adaptedBranch(
    isAdapting: boolean,
    branch: Expr,
    type: Type,
    other: Type,
    module: int,
  ): Type {
    if (!isAdapting) {
      return type;
    }

    const target = this.literalTarget(branch, type, other, module);
    if (target == undefined) {
      return type;
    }

    return other;
  }
}
