import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  BinaryExpr,
  BinaryOp,
  ConditionalExpr,
  Expr,
  ExprKind,
  UnaryExpr,
  UnaryOp,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { LogicSide } from "../../types/expression-types.types.tz";
import { TruthUse } from "../../../../flow/truth-rules/types/truth-rules.types.tz";

partial class ExpressionTypes {
  private readonly notTyped(expr: UnaryExpr, module: int): Type {
    this.branchCheck(expr.operand, TruthUse.Not, module);

    return this.store.plain(TypeKind.Boolean);
  }

  private readonly branchCheck(expr: Expr, use: TruthUse, module: int): void {
    if (this.shapes.isLogical(expr) && expr.kind == ExprKind.Binary) {
      const isAnd = expr.op == BinaryOp.LogAnd;

      this.branchCheck(expr.lhs, TruthUse.Condition, module);

      const facts = this.factsOf(expr.lhs, isAnd, module);
      const before = this.underFacts(facts);

      this.branchCheck(expr.rhs, TruthUse.Condition, module);
      this.facts = before;
      this.redundantTestsCheck(expr, module);

      return;
    }
    if (expr.kind == ExprKind.Unary && expr.op == UnaryOp.Not) {
      return this.branchCheck(expr.operand, TruthUse.Not, module);
    }

    const boolean = this.store.plain(TypeKind.Boolean);
    const type = this.typed(expr, boolean, module);

    if (expr.kind == ExprKind.Assign && expr.op == undefined) {
      const assignmentConditionError = this.logic.assignmentConditionError(
        expr,
        type,
        use,
      );

      return this.reportFound(module, assignmentConditionError);
    }
    if (type.kind != TypeKind.Boolean) {
      this.checkTruthy(expr, type, use, undefined, module);
    }
  }

  private readonly logicalTyped(
    expr: BinaryExpr,
    wanted: Type | undefined,
    side: LogicSide,
    module: int,
  ): Type {
    const isAnd = expr.op == BinaryOp.LogAnd;
    const use = this.logic.logicalUse(isAnd);
    const expected = this.types.wantedPart(wanted);
    const written = this.testedValue(expr.lhs, expected, use, module);
    const left = this.types.apparent(written);
    const isLeftTruthy = this.checkTruthy(
      expr.lhs,
      left,
      use,
      expr.rhs,
      module,
    );
    const hint = this.logic.rightHint(isAnd, left, expected);
    const facts = this.factsOf(expr.lhs, isAnd, module);
    const before = this.underFacts(facts);
    const right = this.logicalRight(expr, hint, side, module);

    this.facts = before;
    this.redundantTestsCheck(expr, module);

    const isRightTruthy =
      side == LogicSide.Value ||
      this.checkTruthy(expr.rhs, right, TruthUse.Condition, undefined, module);
    if (!isLeftTruthy || !isRightTruthy) {
      return this.store.plain(TypeKind.Error);
    }

    return this.logicalResult(expr, left, right, isAnd, module);
  }

  private readonly testedValue(
    expr: Expr,
    expected: Type | undefined,
    use: TruthUse,
    module: int,
  ): Type {
    if (this.shapes.isLogical(expr) && expr.kind == ExprKind.Binary) {
      return this.logicalTyped(expr, expected, LogicSide.Tested, module);
    }
    if (expr.kind == ExprKind.Unary && expr.op == UnaryOp.Not) {
      this.branchCheck(expr.operand, TruthUse.Not, module);

      return this.store.plain(TypeKind.Boolean);
    }

    return this.typed(expr, expected, module);
  }

  private readonly logicalRight(
    expr: BinaryExpr,
    hint: Type | undefined,
    side: LogicSide,
    module: int,
  ): Type {
    if (side == LogicSide.Value) {
      return this.typed(expr.rhs, hint, module);
    }

    return this.testedValue(expr.rhs, hint, TruthUse.Condition, module);
  }

  private readonly logicalResult(
    expr: BinaryExpr,
    left: Type,
    right: Type,
    isAnd: boolean,
    module: int,
  ): Type {
    const checked = this.logic.logicalResult(expr, left, right, isAnd);

    this.reportFound(module, checked.error);

    return checked.value;
  }

  private readonly reportRightVoid(expr: BinaryExpr, isAnd: boolean, module: int): Type {
    const checked = this.logic.rightVoid(expr, isAnd);

    this.reportFound(module, checked.error);

    return checked.value;
  }

  private readonly conditionalTyped(
    expr: ConditionalExpr,
    wanted: Type | undefined,
    module: int,
  ): Type {
    this.branchCheck(expr.cond, TruthUse.Condition, module);

    const start = this.recursions.length;
    const isThenWaiting = this.shapes.isWaiting(expr.thenExpr);
    const isElseWaiting = this.shapes.isWaiting(expr.elseExpr);
    if (isThenWaiting && !isElseWaiting) {
      const elseType = this.branchTyped(expr, false, wanted, module);
      const thenHint = this.logic.branchHint(expr.thenExpr, elseType, wanted);
      const thenType = this.branchTyped(expr, true, thenHint, module);

      return this.joinedBranches(expr, thenType, elseType, start, module);
    }

    const thenType = this.branchTyped(expr, true, wanted, module);
    const elseHint = this.logic.elseHint(
      expr,
      thenType,
      wanted,
      isElseWaiting && !isThenWaiting,
    );
    const elseType = this.branchTyped(expr, false, elseHint, module);

    return this.joinedBranches(expr, thenType, elseType, start, module);
  }

  private readonly branchTyped(
    expr: ConditionalExpr,
    isThen: boolean,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const branch = this.narrowings.sideOf(isThen, expr.thenExpr, expr.elseExpr);
    const facts = this.factsOf(expr.cond, isThen, module);
    const before = this.underFacts(facts);
    const type = this.typed(branch, wanted, module);

    this.facts = before;

    return type;
  }

  private readonly joinedBranches(
    expr: ConditionalExpr,
    thenType: Type,
    elseType: Type,
    start: int,
    module: int,
  ): Type {
    const isThenBroken = thenType.kind == TypeKind.Error;
    const isElseBroken = elseType.kind == TypeKind.Error;
    if (isThenBroken || isElseBroken) {
      return this.failedBranches(thenType, elseType, start);
    }

    const isDifferent = thenType != elseType;
    const thenTarget = this.adaptedBranch(
      isDifferent,
      expr.thenExpr,
      thenType,
      elseType,
      module,
    );
    const elseTarget = this.adaptedBranch(
      isDifferent && thenTarget == thenType,
      expr.elseExpr,
      elseType,
      thenType,
      module,
    );
    const common = this.unifier.unionUnify(thenTarget, elseTarget);
    if (common != undefined) {
      return common;
    }

    const first = this.text.of(thenTarget);
    const second = this.text.of(elseTarget);

    this.report(module, expr.loc, Code.BranchesIncompatible, {
      first,
      second,
    });

    return this.store.plain(TypeKind.Error);
  }

  private readonly failedBranches(thenType: Type, elseType: Type, start: int): Type {
    const isPending = this.recursions.length > start;
    const isThenBroken = thenType.kind == TypeKind.Error;
    const isElseBroken = elseType.kind == TypeKind.Error;
    if (!isPending || isThenBroken == isElseBroken) {
      return this.store.plain(TypeKind.Error);
    }
    if (isThenBroken) {
      return elseType;
    }

    return thenType;
  }

  private readonly adaptedBranch(
    isAdapting: boolean,
    branch: Expr,
    type: Type,
    other: Type,
    module: int,
  ): Type {
    if (!isAdapting) {
      return type;
    }

    const target = this.literalTarget(branch, type, other, module);
    if (target == undefined) {
      return type;
    }

    return other;
  }
}
