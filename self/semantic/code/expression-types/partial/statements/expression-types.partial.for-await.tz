import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import { ForOfStmt } from "../../../../../program/ast/types/ast.types.statements.tz";
import {
  InstanceType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  CallExpr,
  Expr,
  MemberExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { kAsyncIteratorKey } from "../../../../types/type-questions/const/type-questions.const.tz";
import { ExpressionTypes } from "../../expression-types.tz";

partial class ExpressionTypes {
  private forAwaitCheck(statement: ForOfStmt, module: int): void {
    const tree = this.types.program.tree;

    if (statement.keys || this.types.isLibraryModule(module)) {
      return;
    }

    const fn = this.openFunctions[this.openFunctions.length - 1];
    const isOutside = fn != undefined && !fn.isAsync;
    if (statement.isAwait && isOutside) {
      this.errors.write(module, statement.loc, Code.ForAwaitPlace, kNoDetails);

      return;
    }

    const iterable = tree.exprOf(statement.iterableId);
    const given = this.peekType(iterable, module);
    const base = this.types.definedType(given);
    if (base.kind == TypeKind.Error) {
      return;
    }

    const isAsyncIterator =
      base.kind == TypeKind.Iterator &&
      this.types.store.iteratorShapeOf(base).async;
    if (!statement.isAwait && isAsyncIterator) {
      const word = this.types.typeText(given);

      this.errors.write(module, iterable.loc, Code.ForOfLater, { word });

      return;
    }

    if (statement.isAwait && base.kind == TypeKind.Instance) {
      return this.asyncMethodCheck(iterable, base, module);
    }

    const isPlainValue =
      base.kind == TypeKind.Int ||
      base.kind == TypeKind.Double ||
      base.kind == TypeKind.Decimal ||
      base.kind == TypeKind.Boolean;
    if (statement.isAwait && isPlainValue) {
      const word = this.types.typeText(given);

      this.errors.write(module, iterable.loc, Code.ForAwaitNotIterable, {
        word,
      });
    }
  }

  private asyncNextCall(
    expr: CallExpr,
    member: MemberExpr,
    object: Type,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const base = this.types.definedType(object);
    const isAsync =
      base.kind == TypeKind.Iterator &&
      this.types.store.iteratorShapeOf(base).async;
    if (!isAsync || member.name != "next") {
      return undefined;
    }

    this.errors.write(module, member.loc, Code.AsyncNextNotYet, {
      word: member.name,
    });
    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args, module);

    return this.types.store.plain(TypeKind.Error);
  }

  private asyncMethodCheck(
    iterable: Expr,
    instance: InstanceType,
    module: int,
  ): void {
    if (this.types.isLibraryModule(instance.module)) {
      return;
    }

    const entryLookup = this.classMember(instance, kAsyncIteratorKey);

    const entry = entryLookup.entry;
    const method = entry?.methods[0];
    if (entry == undefined || method == undefined) {
      return;
    }

    const type = this.methodTypeOf(entry, method);
    if (type.kind != TypeKind.Function) {
      return;
    }

    const result = this.types.store.returnTypeOf(type);
    const isAsync =
      result.kind == TypeKind.Iterator &&
      this.types.store.iteratorShapeOf(result).async;
    if (isAsync || result.kind == TypeKind.Error) {
      return;
    }

    this.errors.write(module, iterable.loc, Code.AsyncIteratorMethodResult, {
      word: this.types.typeText(instance),
      first: this.types.typeText(result),
    });
  }

  private awaitLoopItem(given: Type): Type {
    const base = this.types.definedType(given);

    switch (base.kind) {
      case TypeKind.Iterator:
        return this.awaitedItem(this.types.store.iteratorShapeOf(base).yielded);
      case TypeKind.Array:
        return this.awaitedItem(this.types.store.itemOf(base));
      case TypeKind.Instance:
        return this.asyncInstanceItem(base);
      default:
        return this.types.store.plain(TypeKind.Error);
    }
  }

  private asyncInstanceItem(instance: InstanceType): Type {
    const entryLookup = this.classMember(instance, kAsyncIteratorKey);
    const entry = entryLookup.entry;
    const method = entry?.methods[0];
    if (entry == undefined || method == undefined) {
      const item = this.instanceItem(instance);

      return this.awaitedItem(item ?? this.types.store.plain(TypeKind.Error));
    }

    const type = this.methodTypeOf(entry, method);
    if (type.kind != TypeKind.Function) {
      return this.types.store.plain(TypeKind.Error);
    }

    const result = this.types.store.returnTypeOf(type);
    if (result.kind != TypeKind.Iterator) {
      return this.types.store.plain(TypeKind.Error);
    }

    return this.types.store.iteratorShapeOf(result).yielded;
  }

  private readonly awaitedItem(item: Type): Type {
    if (item.kind == TypeKind.Promise) {
      return this.types.store.valueOf(item);
    }

    return item;
  }
}
