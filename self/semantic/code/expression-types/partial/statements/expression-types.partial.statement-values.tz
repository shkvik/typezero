import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  Expr,
  ExprKind,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";

partial class ExpressionTypes {
  private usedCheck(
    expr: Expr,
    type: Type,
    at: int | undefined,
    module: int,
  ): void {
    if (this.lenientCalls.has(expr)) {
      return this.libraryUsedCheck(expr, type, at, module);
    }

    const isKept =
      expr.kind == ExprKind.Assign || this.statements.isTakingElement(expr);
    if (isKept) {
      return;
    }

    const defined = this.types.definedType(type);
    const held = this.statements.heldType(type);
    if (held.kind != defined.kind) {
      return;
    }
    if (defined.kind == TypeKind.Promise) {
      const promiseUsedError = this.statements.promiseUsedError(
        expr,
        defined.value,
        at,
        module,
      );

      return this.reportFound(module, promiseUsedError);
    }
    if (defined.kind == TypeKind.Result) {
      this.report(module, expr.loc, Code.ResultUnused, kNoDetails);
    }
  }

  private libraryUsedCheck(
    expr: Expr,
    type: Type,
    at: int | undefined,
    module: int,
  ): void {
    const defined = this.types.definedType(type);
    const loc = this.statements.calleeLoc(expr);
    if (!this.isValueMethodCall(expr, module)) {
      return;
    }
    if (defined.kind == TypeKind.Array) {
      const item = this.types.definedType(defined.item);
      if (item.kind == TypeKind.Promise) {
        this.report(module, loc, Code.PromisesNotAwaited, kNoDetails);
      }
      if (item.kind == TypeKind.Result && this.statements.isMappingCall(expr)) {
        this.report(module, loc, Code.ResultsUnused, kNoDetails);
      }

      return;
    }
    if (defined.kind != TypeKind.Promise) {
      return;
    }

    const held = this.statements.heldType(defined.value);
    if (held.kind == TypeKind.Result) {
      return;
    }

    const text = this.sources.statementText(at, module);
    if (text == "") {
      return this.report(module, loc, Code.PromiseNotAwaited, kNoDetails);
    }

    this.report(module, loc, Code.PromiseNotAwaitedHere, { word: text });
  }

  private isValueMethodCall(expr: Expr, module: int): boolean {
    if (expr.kind != ExprKind.Call) {
      return false;
    }

    const callee = expr.callee;
    if (callee.kind != ExprKind.Member) {
      return false;
    }

    this.errors.beginTrial();

    const object = this.typed(callee.object, undefined, module);

    this.errors.endTrial();

    const base = this.types.definedType(object);

    return base.kind == TypeKind.Array || base.kind == TypeKind.Promise;
  }
}
