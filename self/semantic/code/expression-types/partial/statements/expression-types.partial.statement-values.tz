import { RequirementKind } from "../../types/expression-types.types.tz";
import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  Expr,
  ExprKind,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";

partial class ExpressionTypes {
  private usedCheck(
    expr: Expr,
    type: Type,
    at: int | undefined,
    module: int,
  ): void {
    if (this.lenientCalls.has(expr.id)) {
      return this.libraryUsedCheck(expr, type, at, module);
    }

    const isKept =
      expr.kind == ExprKind.Assign || this.types.isTakingElement(expr);
    if (isKept) {
      return;
    }

    const defined = this.types.definedType(type);
    const held = this.types.heldType(type);
    if (held.kind != defined.kind) {
      return;
    }

    this.requireOf(defined, RequirementKind.Unused, "");

    if (defined.kind == TypeKind.Promise) {
      const promiseUsedError = this.types.promiseUsedError(
        expr,
        this.types.store.valueOf(defined),
        at,
        module,
      );

      return this.errors.writeFound(module, promiseUsedError);
    }
    if (defined.kind == TypeKind.Result) {
      this.errors.write(module, expr.loc, Code.ResultUnused, kNoDetails);
    }
  }

  private libraryUsedCheck(
    expr: Expr,
    type: Type,
    at: int | undefined,
    module: int,
  ): void {
    const defined = this.types.definedType(type);
    const loc = this.types.calleeLoc(expr);
    if (!this.isValueMethodCall(expr, module)) {
      return;
    }
    if (defined.kind == TypeKind.Array) {
      const item = this.types.definedType(this.types.store.itemOf(defined));
      if (item.kind == TypeKind.Promise) {
        this.errors.write(module, loc, Code.PromisesNotAwaited, kNoDetails);
      }
      if (item.kind == TypeKind.Result && this.types.isMappingCall(expr)) {
        this.errors.write(module, loc, Code.ResultsUnused, kNoDetails);
      }

      return;
    }
    if (defined.kind != TypeKind.Promise) {
      return;
    }

    const held = this.types.heldType(this.types.store.valueOf(defined));
    if (held.kind == TypeKind.Result) {
      return;
    }

    const text = this.types.statementText(at, module);
    if (text == "") {
      return this.errors.write(module, loc, Code.PromiseNotAwaited, kNoDetails);
    }

    this.errors.write(module, loc, Code.PromiseNotAwaitedHere, { word: text });
  }

  private isValueMethodCall(expr: Expr, module: int): boolean {
    const tree = this.types.program.tree;

    if (expr.kind != ExprKind.Call) {
      return false;
    }

    const callee = tree.exprOf(expr.calleeId);
    if (callee.kind != ExprKind.Member) {
      return false;
    }

    const objectExpr = tree.exprOf(callee.objectId);
    const object = this.peekType(objectExpr, module);

    const base = this.types.definedType(object);

    return base.kind == TypeKind.Array || base.kind == TypeKind.Promise;
  }
}
