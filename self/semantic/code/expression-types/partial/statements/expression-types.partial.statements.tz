import { replace } from "tz:mem";
import { ClassDecl } from "../../../../../program/ast/types/ast.types.classes.tz";
import {
  Expr,
  ExprKind,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  ForOfStmt,
  ForStmt,
  IfStmt,
  Stmt,
  StmtKind,
} from "../../../../../program/ast/types/ast.types.statements.tz";
import {
  TupleType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { FunctionFrame } from "../../types/expression-types.types.tz";
import { TruthUse } from "../../../../flow/truth-rules/types/truth-rules.types.tz";

partial class ExpressionTypes {
  public checkModule(module: int): void {
    const tree = this.types.program.tree;

    const opened = this.types.program.modules[module];
    if (opened == undefined || this.checkedModules.has(module)) {
      return;
    }

    const frame: FunctionFrame = {
      isAsync: false,
      returns: [],
      recursive: [],
      hasEmptyReturn: false,
      guard: {},
    };

    this.checkedModules.add(module);
    const items = tree.stmtsOf(opened.file.itemsList);

    this.walkStatements(items, frame, module);
  }

  private walkStatements(
    statements: Read<Stmt[]>,
    frame: FunctionFrame,
    module: int,
  ): void {
    for (let index = 0; index < statements.length; index++) {
      const statement = statements[index];
      if (statement == undefined) {
        continue;
      }

      this.walkStatement(statement, frame, module);

      if (statement.kind == StmtKind.VarDecl && statement.isUsing) {
        this.usingCheck(statement, statements.slice(index + 1), module);
      }
    }
  }

  private walkOptionalStatement(
    statement: Stmt | undefined,
    frame: FunctionFrame,
    module: int,
  ): void {
    if (statement != undefined) {
      this.walkStatement(statement, frame, module);
    }
  }

  private walkStatement(
    statement: Stmt,
    frame: FunctionFrame,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    switch (statement.kind) {
      case StmtKind.Block:
        return this.walkStatements(
          tree.stmtsOf(statement.bodyList),
          frame,
          module,
        );
      case StmtKind.VarDecl:
        for (const decl of tree.declaratorsOf(statement.declsList)) {
          const typeAnn = tree.typeRefAt(decl.typeAnnId);

          this.iterableAnnotationCheck(typeAnn, module);
          this.declaredFact(module, decl.loc);
          this.declaredBounds(decl, module);
        }

        return;
      case StmtKind.Function:
        const nestedGenericError = this.types.nestedGenericCheck(
          statement,
          frame,
        );

        this.errors.writeFound(module, nestedGenericError);
        this.functionType(statement, module);

        return;
      case StmtKind.Class:
        this.walkedClasses.add(statement.id);
        this.classPlaceCheck(statement, module);
        this.walkClass(statement, module);
        this.disposeCheck(statement, module);

        return;
      case StmtKind.Expr: {
        const exprExpr = tree.exprOf(statement.exprId);
        if (exprExpr.kind == ExprKind.Yield) {
          const expr = tree.exprOf(statement.exprId);

          this.unusedYields.add(expr.id);
        }

        return this.statementUsed(
          tree.exprOf(statement.exprId),
          statement.loc,
          module,
        );
      }
      case StmtKind.If:
        const thenStmt = tree.stmtOf(statement.thenStmtId);

        this.bodyCheck(thenStmt, module);
        const elseStmt = tree.stmtAt(statement.elseStmtId);

        this.optionalBodyCheck(elseStmt, module);

        return this.walkIf(statement, frame, module);
      case StmtKind.While:
        const body = tree.stmtOf(statement.bodyId);

        this.bodyCheck(body, module);
        this.forgetLooped(statement, module);
        this.branchCheck(
          tree.exprOf(statement.condId),
          TruthUse.Condition,
          module,
        );

        return this.walkLoop(
          tree.exprOf(statement.condId),
          tree.stmtOf(statement.bodyId),
          frame,
          module,
        );
      case StmtKind.DoWhile:
        const bodyStmt = tree.stmtOf(statement.bodyId);

        this.bodyCheck(bodyStmt, module);
        this.forgetLooped(statement, module);
        this.branchCheck(
          tree.exprOf(statement.condId),
          TruthUse.Condition,
          module,
        );

        return this.walkLoop(
          undefined,
          tree.stmtOf(statement.bodyId),
          frame,
          module,
        );
      case StmtKind.For:
        const statementBody = tree.stmtAt(statement.bodyId);

        this.optionalBodyCheck(statementBody, module);
        this.walkOptionalStatement(
          tree.stmtAt(statement.initId),
          frame,
          module,
        );
        this.forgetLooped(statement, module);
        const cond = tree.exprAt(statement.condId);

        this.conditionCheck(cond, module);

        return this.walkFor(statement, frame, module);
      case StmtKind.ForOf: {
        this.bodyCheck(tree.stmtOf(statement.bodyId), module);
        this.forAwaitCheck(statement, module);
        this.loopVariableCheck(statement, module);
        this.localDoor(module, statement.binding.loc);
        this.forgetLooped(statement, module);
        this.rememberLoopElement(statement, module);

        const before = this.factsCopy();

        this.walkStatement(tree.stmtOf(statement.bodyId), frame, module);
        this.facts = before;

        return;
      }
      case StmtKind.Switch:
        return this.walkSwitch(statement, frame, module);
      case StmtKind.Labeled:
        return this.walkStatement(tree.stmtOf(statement.bodyId), frame, module);
      case StmtKind.Return:
        return this.walkReturn(statement, frame, module);
      default:
        return;
    }
  }

  private declaredFact(module: int, loc: int): void {
    const door = this.localDoor(module, loc);
    const given = door?.given;
    if (door == undefined || given == undefined) {
      return;
    }

    const isNarrower =
      door.type.kind == TypeKind.Union && given.id != door.type.id;
    if (isNarrower) {
      this.facts = this.types.withFact(this.facts, `${module} ${loc}`, given);
    }
  }

  private walkIf(statement: IfStmt, frame: FunctionFrame, module: int): void {
    const tree = this.types.program.tree;

    const cond = tree.exprOf(statement.condId);

    this.branchCheck(cond, TruthUse.Condition, module);

    const thenFacts = this.factsOf(cond, true, module);
    const elseFacts = this.factsOf(cond, false, module);
    const before = this.underFacts(thenFacts);
    const thenStart = this.factsCopy();

    const thenStmt = tree.stmtOf(statement.thenStmtId);

    this.walkStatement(thenStmt, frame, module);

    const thenEnd = replace(this.facts, new Map<string, Type>(before));

    this.underFacts(elseFacts);

    const elseStart = this.factsCopy();

    this.walkOptionalStatement(
      tree.stmtAt(statement.elseStmtId),
      frame,
      module,
    );

    const elseEnd = replace(this.facts, new Map<string, Type>(before));
    const isThenLeaving = this.isLeaving(
      tree.stmtOf(statement.thenStmtId),
      module,
    );
    const isElseLeaving = this.isLeaving(
      tree.stmtAt(statement.elseStmtId),
      module,
    );

    if (isThenLeaving && isElseLeaving) {
      return;
    }
    if (isThenLeaving) {
      this.facts = elseEnd;

      return;
    }
    if (isElseLeaving) {
      this.facts = thenEnd;

      return;
    }

    this.facts = this.types.branchesJoined(
      before,
      thenStart,
      thenEnd,
      elseStart,
      elseEnd,
    );
  }

  private readonly isLeaving(
    statement: Stmt | undefined,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    if (statement == undefined) {
      return false;
    }
    if (this.isAlwaysReturning(statement, module)) {
      return true;
    }

    switch (statement.kind) {
      case StmtKind.Break:
      case StmtKind.Continue:
        return true;
      case StmtKind.Block:
        return tree
          .stmtsOf(statement.bodyList)
          .some((one) => this.isLeaving(one, module));
      case StmtKind.If:
        return (
          this.isLeaving(tree.stmtOf(statement.thenStmtId), module) &&
          this.isLeaving(tree.stmtAt(statement.elseStmtId), module)
        );
      default:
        return false;
    }
  }

  private walkLoop(
    cond: Expr | undefined,
    body: Stmt | undefined,
    frame: FunctionFrame,
    module: int,
  ): void {
    const facts = this.loopFacts(cond, module);
    const before = this.underFacts(facts);

    this.walkOptionalStatement(body, frame, module);
    this.facts = before;
  }

  private walkFor(statement: ForStmt, frame: FunctionFrame, module: int): void {
    const tree = this.types.program.tree;

    const cond = tree.exprAt(statement.condId);
    const facts = this.loopFacts(cond, module);
    const before = this.underFacts(facts);

    const body = tree.stmtAt(statement.bodyId);

    this.walkOptionalStatement(body, frame, module);
    const step = tree.exprAt(statement.stepId);

    this.stepCheck(step, module);
    this.facts = before;
  }

  private stepCheck(step: Expr | undefined, module: int): void {
    if (step != undefined) {
      this.statementUsed(step, undefined, module);
    }
  }

  private statementUsed(expr: Expr, at: int | undefined, module: int): void {
    const tree = this.types.program.tree;

    if (expr.kind != ExprKind.Sequence) {
      const type = this.typed(expr, undefined, module);

      this.noteDroppedNew(expr, type, module);

      return this.usedCheck(expr, type, at, module);
    }

    let last = this.types.store.plain(TypeKind.Error);

    for (const part of tree.exprsOf(expr.exprsList)) {
      last = this.typed(part, undefined, module);
    }

    this.usedCheck(expr, last, at, module);
  }

  private loopFacts(cond: Expr | undefined, module: int): Map<string, Type> {
    if (cond == undefined) {
      return new Map<string, Type>();
    }

    return this.factsOf(cond, true, module);
  }

  private conditionCheck(cond: Expr | undefined, module: int): void {
    if (cond != undefined) {
      this.branchCheck(cond, TruthUse.Condition, module);
    }
  }

  private valueCheck(value: Expr | undefined, module: int): void {
    if (value != undefined) {
      this.typed(value, undefined, module);
    }
  }

  private loopItem(loop: ForOfStmt, module: int): Type {
    const tree = this.types.program.tree;

    const iterable = this.typed(
      tree.exprOf(loop.iterableId),
      undefined,
      module,
    );
    if (loop.keys) {
      return this.forInKeys(loop, iterable, module);
    }
    if (loop.isAwait) {
      return this.awaitLoopItem(iterable);
    }

    const base = this.types.apparent(iterable);

    this.loopCannotCheck(loop, base, module);
    const resumedError = this.types.resumedCheck(
      tree.exprOf(loop.iterableId),
      iterable,
      Code.ForOfResumes,
    );

    this.errors.writeFound(module, resumedError);

    const matched = this.matchItem(base);
    if (matched != undefined) {
      return matched;
    }

    switch (base.kind) {
      case TypeKind.Tuple:
        return this.tupleLoopItem(loop, base, module);
      case TypeKind.Array:
        return this.types.store.itemOf(base);
      case TypeKind.String:
      case TypeKind.Template:
        return this.types.store.plain(TypeKind.String);
      case TypeKind.Iterator:
        return this.types.store.iteratorShapeOf(base).yielded;
      case TypeKind.Dict:
        return this.types.dictItem(
          base.dict,
          this.types.store.keyOf(base),
          this.types.store.valueOf(base),
        );
      default:
        return this.types.store.plain(TypeKind.Error);
    }
  }

  private tupleLoopItem(loop: ForOfStmt, tuple: TupleType, module: int): Type {
    const checked = this.types.tupleLoopItem(loop, tuple);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private loopVariableCheck(loop: ForOfStmt, module: int): void {
    const tree = this.types.program.tree;

    const written = tree.typeRefAt(loop.binding.typeAnnId);
    if (written == undefined) {
      return;
    }

    const word = this.types.loopWord(loop);

    this.errors.write(module, written.loc, Code.LoopVariableTyped, { word });
  }

  private classPlaceCheck(statement: ClassDecl, module: int): void {
    const tree = this.types.program.tree;

    const opened = this.types.program.modules[module];
    if (
      opened == undefined ||
      tree.stmtsOf(opened.file.itemsList).some((one) => one.id == statement.id)
    ) {
      return;
    }

    this.errors.write(module, statement.loc, Code.ClassNotTopLevel, {
      word: statement.name ?? "",
    });
  }

  private optionalBodyCheck(body: Stmt | undefined, module: int): void {
    if (body != undefined) {
      this.bodyCheck(body, module);
    }
  }

  private bodyCheck(body: Stmt, module: int): void {
    switch (body.kind) {
      case StmtKind.VarDecl:
      case StmtKind.TypeAlias:
      case StmtKind.Enum:
      case StmtKind.Function:
        return this.errors.write(
          module,
          body.loc,
          Code.BodyDeclared,
          kNoDetails,
        );
      default:
        return;
    }
  }
}
