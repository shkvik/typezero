import { ClassDecl } from "../../../../../program/ast/types/ast.types.classes.tz";
import {
  Expr,
  ExprKind,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  ForOfStmt,
  ForStmt,
  IfStmt,
  Stmt,
  StmtKind,
} from "../../../../../program/ast/types/ast.types.statements.tz";
import {
  TupleType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { FunctionFrame } from "../../types/expression-types.types.tz";
import { TruthUse } from "../../../../flow/truth-rules/types/truth-rules.types.tz";

partial class ExpressionTypes {
  public checkModule(module: int): void {
    const opened = this.program.modules[module];
    if (opened == undefined || this.checkedModules.has(module)) {
      return;
    }

    const frame: FunctionFrame = {
      isAsync: false,
      returns: [],
      recursive: [],
      hasEmptyReturn: false,
      guard: {},
    };

    this.checkedModules.add(module);
    this.walkStatements(opened.file.items, frame, module);
  }

  private walkStatements(
    statements: Stmt[],
    frame: FunctionFrame,
    module: int,
  ): void {
    for (const statement of statements) {
      this.walkStatement(statement, frame, module);
    }
  }

  private walkOptionalStatement(
    statement: Stmt | undefined,
    frame: FunctionFrame,
    module: int,
  ): void {
    if (statement != undefined) {
      this.walkStatement(statement, frame, module);
    }
  }

  private walkStatement(
    statement: Stmt,
    frame: FunctionFrame,
    module: int,
  ): void {
    switch (statement.kind) {
      case StmtKind.Block:
        return this.walkStatements(statement.body, frame, module);
      case StmtKind.VarDecl:
        for (const decl of statement.decls) {
          this.iterableAnnotationCheck(decl.typeAnn, module);
          this.declaredFact(module, decl.loc);
          this.declaredBounds(decl, module);
        }

        return;
      case StmtKind.Function:
        const nestedGenericError = this.genericCalls.nestedGenericCheck(
          statement,
          frame,
        );

        this.reportFound(module, nestedGenericError);
        this.functionType(statement, module);

        return;
      case StmtKind.Class:
        this.classPlaceCheck(statement, module);

        return this.walkClass(statement, module);
      case StmtKind.Expr: {
        if (statement.expr.kind == ExprKind.Yield) {
          this.unusedYields.add(statement.expr);
        }

        return this.statementUsed(statement.expr, statement.loc, module);
      }
      case StmtKind.If:
        return this.walkIf(statement, frame, module);
      case StmtKind.While:
        this.forgetLooped(statement, module);
        this.branchCheck(statement.cond, TruthUse.Condition, module);

        return this.walkLoop(statement.cond, statement.body, frame, module);
      case StmtKind.DoWhile:
        this.forgetLooped(statement, module);
        this.branchCheck(statement.cond, TruthUse.Condition, module);

        return this.walkLoop(undefined, statement.body, frame, module);
      case StmtKind.For:
        this.walkOptionalStatement(statement.init, frame, module);
        this.forgetLooped(statement, module);
        this.conditionCheck(statement.cond, module);

        return this.walkFor(statement, frame, module);
      case StmtKind.ForOf: {
        this.forAwaitCheck(statement, module);
        this.loopVariableCheck(statement, module);
        this.localDoor(module, statement.binding.loc);
        this.forgetLooped(statement, module);

        const before = this.facts;

        this.walkStatement(statement.body, frame, module);
        this.facts = before;

        return;
      }
      case StmtKind.Switch:
        return this.walkSwitch(statement, frame, module);
      case StmtKind.Labeled:
        return this.walkStatement(statement.body, frame, module);
      case StmtKind.Return:
        return this.walkReturn(statement, frame, module);
      default:
        return;
    }
  }

  private declaredFact(module: int, loc: int): void {
    const door = this.localDoor(module, loc);
    const given = door?.given;
    if (door == undefined || given == undefined) {
      return;
    }

    const isNarrower = door.type.kind == TypeKind.Union && given != door.type;
    if (isNarrower) {
      this.facts = this.flows.withFact(this.facts, `${module} ${loc}`, given);
    }
  }

  private walkIf(statement: IfStmt, frame: FunctionFrame, module: int): void {
    const cond = statement.cond;

    this.branchCheck(cond, TruthUse.Condition, module);

    const thenFacts = this.factsOf(cond, true, module);
    const elseFacts = this.factsOf(cond, false, module);
    const before = this.underFacts(thenFacts);
    const thenStart = this.facts;

    this.walkStatement(statement.thenStmt, frame, module);

    const thenEnd = this.facts;

    this.facts = before;
    this.underFacts(elseFacts);

    const elseStart = this.facts;

    this.walkOptionalStatement(statement.elseStmt, frame, module);

    const elseEnd = this.facts;
    const isThenLeaving = this.isLeaving(statement.thenStmt, module);
    const isElseLeaving = this.isLeaving(statement.elseStmt, module);

    this.facts = before;

    if (isThenLeaving && isElseLeaving) {
      return;
    }
    if (isThenLeaving) {
      this.facts = elseEnd;

      return;
    }
    if (isElseLeaving) {
      this.facts = thenEnd;

      return;
    }

    this.facts = this.flows.branchesJoined(
      before,
      thenStart,
      thenEnd,
      elseStart,
      elseEnd,
    );
  }

  private isLeaving(statement: Stmt | undefined, module: int): boolean {
    if (statement == undefined) {
      return false;
    }
    if (this.isAlwaysReturning(statement, module)) {
      return true;
    }

    switch (statement.kind) {
      case StmtKind.Break:
      case StmtKind.Continue:
        return true;
      case StmtKind.Block:
        return statement.body.some((one) => this.isLeaving(one, module));
      case StmtKind.If:
        return (
          this.isLeaving(statement.thenStmt, module) &&
          this.isLeaving(statement.elseStmt, module)
        );
      default:
        return false;
    }
  }

  private walkLoop(
    cond: Expr | undefined,
    body: Stmt | undefined,
    frame: FunctionFrame,
    module: int,
  ): void {
    const facts = this.loopFacts(cond, module);
    const before = this.underFacts(facts);

    this.walkOptionalStatement(body, frame, module);
    this.facts = before;
  }

  private walkFor(statement: ForStmt, frame: FunctionFrame, module: int): void {
    const facts = this.loopFacts(statement.cond, module);
    const before = this.underFacts(facts);

    this.walkOptionalStatement(statement.body, frame, module);
    this.stepCheck(statement.step, module);
    this.facts = before;
  }

  private stepCheck(step: Expr | undefined, module: int): void {
    if (step != undefined) {
      this.statementUsed(step, undefined, module);
    }
  }

  private statementUsed(expr: Expr, at: int | undefined, module: int): void {
    if (expr.kind != ExprKind.Sequence) {
      const type = this.typed(expr, undefined, module);

      return this.usedCheck(expr, type, at, module);
    }

    let last = this.store.plain(TypeKind.Error);

    for (const part of expr.exprs) {
      last = this.typed(part, undefined, module);
    }

    this.usedCheck(expr, last, at, module);
  }

  private loopFacts(cond: Expr | undefined, module: int): Map<string, Type> {
    if (cond == undefined) {
      return new Map<string, Type>();
    }

    return this.factsOf(cond, true, module);
  }

  private conditionCheck(cond: Expr | undefined, module: int): void {
    if (cond != undefined) {
      this.branchCheck(cond, TruthUse.Condition, module);
    }
  }

  private valueCheck(value: Expr | undefined, module: int): void {
    if (value != undefined) {
      this.typed(value, undefined, module);
    }
  }

  private loopItem(loop: ForOfStmt, module: int): Type {
    const iterable = this.typed(loop.iterable, undefined, module);
    if (loop.keys) {
      return this.forInKeys(loop, iterable, module);
    }
    if (loop.isAwait) {
      return this.store.plain(TypeKind.Error);
    }

    const base = this.types.apparent(iterable);

    this.loopCannotCheck(loop, base, module);
    const resumedError = this.functions.resumedCheck(
      loop.iterable,
      iterable,
      Code.ForOfResumes,
    );

    this.reportFound(module, resumedError);

    switch (base.kind) {
      case TypeKind.Tuple:
        return this.tupleLoopItem(loop, base, module);
      case TypeKind.Array:
        return base.item;
      case TypeKind.String:
      case TypeKind.Template:
        return this.store.plain(TypeKind.String);
      case TypeKind.Iterator:
        return base.shape.yielded;
      case TypeKind.Dict:
        return this.statements.dictItem(base.dict, base.key, base.value);
      default:
        return this.store.plain(TypeKind.Error);
    }
  }

  private tupleLoopItem(loop: ForOfStmt, tuple: TupleType, module: int): Type {
    const checked = this.statements.tupleLoopItem(loop, tuple);

    this.reportFound(module, checked.error);

    return checked.value;
  }

  private loopVariableCheck(loop: ForOfStmt, module: int): void {
    const written = loop.binding.typeAnn;
    if (written == undefined) {
      return;
    }

    const word = this.statements.loopWord(loop);

    this.report(module, written.loc, Code.LoopVariableTyped, { word });
  }

  private classPlaceCheck(statement: ClassDecl, module: int): void {
    const opened = this.program.modules[module];
    if (opened == undefined || opened.file.items.includes(statement)) {
      return;
    }

    this.report(module, statement.loc, Code.ClassNotTopLevel, {
      word: statement.name ?? "",
    });
  }
}
