import { kObjectExamples } from "../../const/expression-types.const.tz";
import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import { NameExpr } from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Stmt,
  StmtKind,
} from "../../../../../program/ast/types/ast.types.statements.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { ValueTarget } from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private named(expr: NameExpr, wanted: Type | undefined, module: int): Type {
    if (this.isNullName(expr, module)) {
      return this.nullTyped(expr, wanted, module);
    }
    if (this.isThisName(expr, module)) {
      return this.thisTyped(expr, module);
    }
    if (this.legacyValueCheck(expr, module)) {
      return this.types.store.plain(TypeKind.Error);
    }
    if (this.isDecimalName(expr, module)) {
      this.errors.write(module, expr.loc, Code.DecimalNameValue, kNoDetails);

      return this.types.store.plain(TypeKind.Error);
    }
    if (this.builtinValueCheck(expr, wanted, module)) {
      return this.types.store.plain(TypeKind.Error);
    }
    if (this.objectValueCheck(expr, module)) {
      return this.types.store.plain(TypeKind.Error);
    }
    if (this.nodeValueCheck(expr, module)) {
      return this.types.store.plain(TypeKind.Error);
    }

    const forwarded = this.builtinFunctionValue(expr, wanted, module);
    if (forwarded != undefined) {
      return forwarded;
    }
    if (this.notLoadedCheck(expr, module)) {
      return this.types.store.plain(TypeKind.Error);
    }

    const target = this.targetOfName(expr, module);
    if (target == undefined) {
      return this.types.store.plain(TypeKind.Error);
    }

    this.laterBlockCheck(expr, target, module);
    this.ownInitializerCheck(expr, target, module);
    this.importBackCheck(target, module);

    const fact = this.factOf(target);
    if (fact != undefined) {
      return fact;
    }

    switch (target.kind) {
      case SymbolKind.Variable:
        return this.variableTyped(target, wanted);
      case SymbolKind.Parameter:
        return this.parameterTyped(target);
      case SymbolKind.Function: {
        const value = this.genericValue(expr, target, wanted, module);

        return value ?? this.usedFunction(target.module, target.loc);
      }
      case SymbolKind.Class:
        if (this.genericClassValueCheck(expr, target, wanted, module)) {
          return this.types.store.plain(TypeKind.Error);
        }

        return this.classValue(target);
      case SymbolKind.Enum:
        if (this.types.isRecordWanted(wanted)) {
          return this.types.store.plain(TypeKind.Error);
        }

        this.errors.write(module, expr.loc, Code.EnumAsValue, {
          word: expr.name,
        });

        return this.types.store.plain(TypeKind.Error);
      default:
        return this.types.store.plain(TypeKind.Error);
    }
  }

  private valueOfName(expr: NameExpr, module: int): Type | undefined {
    const target = this.targetOfName(expr, module);
    if (target == undefined) {
      return undefined;
    }

    const fact = this.factOf(target);
    if (fact != undefined) {
      return fact;
    }

    switch (target.kind) {
      case SymbolKind.Variable:
        return this.door(target.module, target.loc)?.type;
      case SymbolKind.Parameter:
        return this.parameterTyped(target);
      default:
        return undefined;
    }
  }

  private variableTyped(target: ValueTarget, wanted: Type | undefined): Type {
    const door = this.door(target.module, target.loc);
    if (door == undefined) {
      return this.types.store.plain(TypeKind.Error);
    }

    const key = `${target.module} ${target.loc}`;
    const texts = this.doorTexts.get(key)?.slice();
    if (wanted == undefined || texts == undefined) {
      return door.type;
    }

    return this.types.textChoice(texts, wanted) ?? door.type;
  }

  private parameterTyped(target: ValueTarget): Type {
    const key = `${target.module} ${target.loc}`;
    const known = this.paramTypes.get(key);
    if (known != undefined) {
      return known;
    }

    const slot = this.record(target.module)?.params.get(target.loc);
    if (slot == undefined) {
      return this.types.store.plain(TypeKind.Error);
    }

    this.functionAt(target.module, slot.fn.loc);

    return this.paramTypes.get(key) ?? this.types.store.plain(TypeKind.Error);
  }

  private readonly isLibraryName(expr: NameExpr, module: int): boolean {
    const symbol = this.record(module)?.uses.get(expr.loc)?.symbol;
    if (symbol == undefined) {
      return true;
    }

    const target = this.targetOfName(expr, module);
    if (target == undefined) {
      return false;
    }

    const opened = this.types.program.modules[target.module];

    return opened != undefined && opened.source.isLibrary;
  }

  public readonly valueTargetOf(
    expr: NameExpr,
    module: int,
  ): ValueTarget | undefined {
    return this.targetOfName(expr, module);
  }

  private readonly targetOfName(
    expr: NameExpr,
    module: int,
  ): ValueTarget | undefined {
    return this.targetOfUse(expr.loc, expr.name, module);
  }

  private readonly targetOfUse(
    loc: int,
    name: string,
    module: int,
  ): ValueTarget | undefined {
    const record = this.record(module);
    const hidden = record?.hidden.get(name);
    if (hidden != undefined) {
      return { module, kind: hidden.kind, loc: hidden.loc };
    }

    const use = record?.uses.get(loc);
    const symbol = use?.symbol;
    if (use != undefined && symbol == undefined) {
      return this.globalValue(name);
    }
    if (symbol == undefined) {
      return undefined;
    }
    if (symbol.kind != SymbolKind.Import) {
      return { module, kind: symbol.kind, loc: symbol.loc };
    }

    const target = symbol.target;
    if (target == undefined) {
      return undefined;
    }

    return this.exportedValue(target.module, target.name);
  }

  private readonly globalValue(name: string): ValueTarget | undefined {
    if (this.overloadedGlobals.has(name)) {
      return undefined;
    }

    return this.globalValues.get(name);
  }

  private indexGlobalValues(): void {
    const tree = this.types.program.tree;

    for (const module of this.types.program.globals) {
      const opened = this.types.program.modules[module];
      const items = tree.stmtsOf(opened?.file.itemsList);
      const classes = tree.declaredClassesOf(opened?.declaredList);

      for (const item of items) {
        this.indexGlobalItem(item, module);
      }

      for (const declared of classes) {
        this.keepGlobal(declared.name, {
          module,
          kind: SymbolKind.Class,
          loc: declared.loc,
        });
      }
    }
  }

  private indexGlobalItem(item: Stmt, module: int): void {
    const tree = this.types.program.tree;

    switch (item.kind) {
      case StmtKind.VarDecl:
        for (const decl of tree.declaratorsOf(item.declsList)) {
          this.keepGlobal(decl.name, {
            module,
            kind: SymbolKind.Variable,
            loc: decl.loc,
          });
        }

        return;
      case StmtKind.Function:
        return this.keepGlobal(item.name, {
          module,
          kind: SymbolKind.Function,
          loc: item.loc,
        });
      default:
        return;
    }
  }

  private keepGlobal(name: string, target: ValueTarget): void {
    if (this.globalValues.has(name)) {
      this.overloadedGlobals.add(name);
    }

    this.globalValues.set(name, target);
  }

  private readonly exportedValue(
    module: int,
    name: string,
  ): ValueTarget | undefined {
    const tree = this.types.program.tree;

    const opened = this.types.program.modules[module];
    if (module < 0 || opened == undefined) {
      return undefined;
    }

    for (const item of tree.stmtsOf(opened.file.itemsList)) {
      const found = this.types.itemTarget(item, module, name);
      if (found != undefined) {
        return found;
      }
    }

    const declared = tree
      .declaredClassesOf(opened.declaredList)
      .find((one) => one.name == name);
    if (declared == undefined) {
      return undefined;
    }

    return { module, kind: SymbolKind.Class, loc: declared.loc };
  }

  private objectValueCheck(expr: NameExpr, module: int): boolean {
    const found = kObjectExamples.find((one) => one.name == expr.name);
    if (found == undefined || this.memberObjects.has(expr.id)) {
      return false;
    }
    if (!this.isGlobalUse(expr, module)) {
      return false;
    }

    this.errors.write(module, expr.loc, Code.ObjectNameValue, {
      word: expr.name,
      other: found.example,
    });

    return true;
  }
}
