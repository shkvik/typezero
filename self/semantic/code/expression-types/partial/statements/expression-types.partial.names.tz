import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import { NameExpr } from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Stmt,
  StmtKind,
} from "../../../../../program/ast/types/ast.types.statements.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import {
  DictKind,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { ValueTarget } from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private named(expr: NameExpr, wanted: Type | undefined, module: int): Type {
    if (this.isNullName(expr, module)) {
      return this.nullTyped(expr, wanted, module);
    }
    if (this.isThisName(expr, module)) {
      return this.thisTyped(expr, module);
    }
    if (this.legacyValueCheck(expr, module)) {
      return this.store.plain(TypeKind.Error);
    }
    if (this.isDecimalName(expr, module)) {
      this.report(module, expr.loc, Code.DecimalNameValue, kNoDetails);

      return this.store.plain(TypeKind.Error);
    }
    if (this.builtinValueCheck(expr, wanted, module)) {
      return this.store.plain(TypeKind.Error);
    }

    const forwarded = this.builtinFunctionValue(expr, wanted, module);
    if (forwarded != undefined) {
      return forwarded;
    }

    const target = this.targetOfName(expr, module);
    if (target == undefined) {
      return this.store.plain(TypeKind.Error);
    }

    this.laterBlockCheck(expr, target, module);
    this.ownInitializerCheck(expr, target, module);

    const fact = this.factOf(target);
    if (fact != undefined) {
      return fact;
    }

    switch (target.kind) {
      case SymbolKind.Variable:
        return this.variableTyped(target, wanted);
      case SymbolKind.Parameter:
        return this.parameterTyped(target);
      case SymbolKind.Function: {
        const value = this.genericValue(expr, target, wanted, module);

        return value ?? this.usedFunction(target.module, target.loc);
      }
      case SymbolKind.Class:
        return this.classValue(target);
      case SymbolKind.Enum:
        if (this.isRecordWanted(wanted)) {
          return this.store.plain(TypeKind.Error);
        }

        this.report(module, expr.loc, Code.EnumAsValue, { word: expr.name });

        return this.store.plain(TypeKind.Error);
      default:
        return this.store.plain(TypeKind.Error);
    }
  }

  private valueOfName(expr: NameExpr, module: int): Type | undefined {
    const target = this.targetOfName(expr, module);
    if (target == undefined) {
      return undefined;
    }

    const fact = this.factOf(target);
    if (fact != undefined) {
      return fact;
    }

    switch (target.kind) {
      case SymbolKind.Variable:
        return this.door(target.module, target.loc)?.type;
      case SymbolKind.Parameter:
        return this.parameterTyped(target);
      default:
        return undefined;
    }
  }

  private variableTyped(target: ValueTarget, wanted: Type | undefined): Type {
    const door = this.door(target.module, target.loc);
    if (door == undefined) {
      return this.store.plain(TypeKind.Error);
    }

    const texts = door.texts;
    if (wanted == undefined || texts == undefined) {
      return door.type;
    }

    return this.textChoice(texts, wanted) ?? door.type;
  }

  private parameterTyped(target: ValueTarget): Type {
    const key = `${target.module} ${target.loc}`;
    const known = this.paramTypes.get(key);
    if (known != undefined) {
      return known;
    }

    const slot = this.record(target.module)?.params.get(target.loc);
    if (slot == undefined) {
      return this.store.plain(TypeKind.Error);
    }

    this.functionAt(target.module, slot.fn.loc);

    return this.paramTypes.get(key) ?? this.store.plain(TypeKind.Error);
  }

  private isLibraryName(expr: NameExpr, module: int): boolean {
    const symbol = this.record(module)?.uses.get(expr.loc)?.symbol;
    if (symbol == undefined) {
      return true;
    }

    const target = this.targetOfName(expr, module);
    if (target == undefined) {
      return false;
    }

    const opened = this.program.modules[target.module];

    return opened != undefined && opened.source.isLibrary;
  }

  private isRecordWanted(wanted: Type | undefined): boolean {
    if (wanted == undefined) {
      return false;
    }

    const goal = this.types.definedType(wanted);

    return goal.kind == TypeKind.Dict && goal.dict == DictKind.Record;
  }

  private targetOfName(expr: NameExpr, module: int): ValueTarget | undefined {
    return this.targetOfUse(expr.loc, expr.name, module);
  }

  private targetOfUse(
    loc: int,
    name: string,
    module: int,
  ): ValueTarget | undefined {
    const record = this.record(module);
    const hidden = record?.hidden.get(name);
    if (hidden != undefined) {
      return { module, kind: hidden.kind, loc: hidden.loc };
    }

    const use = record?.uses.get(loc);
    const symbol = use?.symbol;
    if (use != undefined && symbol == undefined) {
      return this.globalValue(name);
    }
    if (symbol == undefined) {
      return undefined;
    }
    if (symbol.kind != SymbolKind.Import) {
      return { module, kind: symbol.kind, loc: symbol.loc };
    }

    const target = symbol.target;
    if (target == undefined) {
      return undefined;
    }

    return this.exportedValue(target.module, target.name);
  }

  private globalValue(name: string): ValueTarget | undefined {
    if (this.globalValues.size == 0) {
      this.indexGlobalValues();
    }
    if (this.overloadedGlobals.has(name)) {
      return undefined;
    }

    return this.globalValues.get(name);
  }

  private indexGlobalValues(): void {
    for (const opened of this.program.globals) {
      const module = opened.id;

      for (const item of opened.file.items) {
        this.indexGlobalItem(item, module);
      }

      for (const declared of opened.declared) {
        this.keepGlobal(declared.name, {
          module,
          kind: SymbolKind.Class,
          loc: declared.loc,
        });
      }
    }
  }

  private indexGlobalItem(item: Stmt, module: int): void {
    switch (item.kind) {
      case StmtKind.VarDecl:
        for (const decl of item.decls) {
          this.keepGlobal(decl.name, {
            module,
            kind: SymbolKind.Variable,
            loc: decl.loc,
          });
        }

        return;
      case StmtKind.Function:
        return this.keepGlobal(item.name, {
          module,
          kind: SymbolKind.Function,
          loc: item.loc,
        });
      default:
        return;
    }
  }

  private keepGlobal(name: string, target: ValueTarget): void {
    if (this.globalValues.has(name)) {
      this.overloadedGlobals.add(name);
    }

    this.globalValues.set(name, target);
  }

  private exportedValue(module: int, name: string): ValueTarget | undefined {
    const opened = this.program.modules[module];
    if (module < 0 || opened == undefined) {
      return undefined;
    }

    for (const item of opened.file.items) {
      const found = this.itemTarget(item, module, name);
      if (found != undefined) {
        return found;
      }
    }

    return undefined;
  }

  private itemTarget(
    item: Stmt,
    module: int,
    name: string,
  ): ValueTarget | undefined {
    switch (item.kind) {
      case StmtKind.VarDecl: {
        const decl = item.decls.find((one) => one.name == name);
        if (decl == undefined) {
          return undefined;
        }

        return { module, kind: SymbolKind.Variable, loc: decl.loc };
      }
      case StmtKind.Function:
        return this.namedTarget(item.name, name, {
          module,
          kind: SymbolKind.Function,
          loc: item.loc,
        });
      case StmtKind.Class:
        return this.namedTarget(item.name ?? "", name, {
          module,
          kind: SymbolKind.Class,
          loc: item.loc,
        });
      case StmtKind.Enum:
        return this.namedTarget(item.name, name, {
          module,
          kind: SymbolKind.Enum,
          loc: item.loc,
        });
      default:
        return undefined;
    }
  }

  private namedTarget(
    declared: string,
    name: string,
    target: ValueTarget,
  ): ValueTarget | undefined {
    if (declared != name) {
      return undefined;
    }

    return target;
  }
}
