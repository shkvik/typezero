import {
  RequirementKind,
  ValueTarget,
} from "../../types/expression-types.types.tz";
import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  NameExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../../program/ast/types/ast.types.functions.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  kAlreadyStarted,
  kChainArrow,
  kFunctionMethods,
  kNotLoadedYet,
  kTextMethods,
} from "../../const/expression-types.const.tz";
import { LinkKind } from "../../../../../program/module/types/module.types.tz";
import { DoorState } from "../../../../types/type-resolver/types/type-resolver.types.tz";

partial class ExpressionTypes {
  private readonly laterBlockCheck(
    expr: NameExpr,
    target: ValueTarget,
    module: int,
  ): void {
    const isLater =
      target.kind == SymbolKind.Variable &&
      target.module == module &&
      target.loc > expr.loc;
    const closure = this.openFunctions[this.openFunctions.length - 1];
    if (!isLater || closure == undefined || !this.shapes.isClosure(closure)) {
      return;
    }
    if (this.statements.isInsideFunction(closure, target.loc)) {
      return;
    }

    const outer = this.openFunctions.slice(0, this.openFunctions.length - 1);
    const isLocal = outer.some((fn) =>
      this.statements.isInsideFunction(fn, target.loc),
    );
    if (!isLocal) {
      return;
    }

    this.report(module, expr.loc, Code.LaterInBlock, { word: expr.name });
  }

  private readonly notLoadedCheck(expr: NameExpr, module: int): boolean {
    const symbol = this.record(module)?.uses.get(expr.loc)?.symbol;
    const source = symbol?.target;
    if (this.openFunctions.length > 0 || source == undefined) {
      return false;
    }
    if (symbol?.kind != SymbolKind.Import) {
      return false;
    }

    const target = this.exportedValue(source.module, source.name);
    const isValue =
      target?.kind == SymbolKind.Variable || target?.kind == SymbolKind.Class;
    if (!isValue || this.modules.isLibraryModule(source.module)) {
      return false;
    }

    const reader = this.loadIndex(module);
    const later = this.loadIndex(source.module);
    if (reader < 0 || later <= reader) {
      return false;
    }

    this.report(module, expr.loc, Code.ReadWhileLoading, {
      word: this.moduleName(module),
      first: this.loadLabel(expr.name, source.name, source.module),
      second: this.moduleName(source.module),
      other: this.loadChain(module, source.module),
      place: source.name,
    });

    return true;
  }

  private readonly importBackCheck(target: ValueTarget, module: int): void {
    if (target.kind != SymbolKind.Variable || target.module == module) {
      return;
    }

    const door = this.doors.get(`${target.module} ${target.loc}`);
    if (door == undefined || door.state != DoorState.InWork) {
      return;
    }

    const variable = this.record(target.module)?.variables.get(target.loc);
    const init = variable?.decl.init;
    if (variable == undefined || init == undefined) {
      return;
    }
    if (init.kind != ExprKind.Function || init.fn.returnType != undefined) {
      return;
    }

    this.report(target.module, init.loc, Code.ImportBackReturn, {
      word: `'${variable.decl.name}'`,
    });
  }

  private readonly loadIndex(module: int): int {
    return this.program.order.findIndex((one) => one.id == module);
  }

  private readonly moduleName(module: int): string {
    return this.program.modules[module]?.name ?? "";
  }

  private readonly loadLabel(name: string, declared: string, source: int): string {
    const file = this.moduleName(source);
    if (name != declared) {
      return `'${name}' ('${declared}' of ${file})`;
    }

    return `'${name}' of ${file}`;
  }

  private readonly loadChain(reader: int, source: int): string {
    const paths = new Map<int, int[]>();

    this.walkLoads(0, [], paths);

    const path = paths.get(reader) ?? [reader];
    const names = path.map((one) => this.moduleName(one));
    const state = this.loadState(path.includes(source));

    return `${names.join(kChainArrow)}${kChainArrow}(${this.moduleName(source)}${state})`;
  }

  private readonly loadState(isStarted: boolean): string {
    if (isStarted) {
      return kAlreadyStarted;
    }

    return kNotLoadedYet;
  }

  private readonly walkLoads(id: int, path: Read<int[]>, paths: Map<int, int[]>): void {
    const own = path.concat([id]);

    paths.set(id, own.slice());

    for (const link of this.program.modules[id]?.links ?? []) {
      if (link.kind == LinkKind.Module && !paths.has(link.target)) {
        this.walkLoads(link.target, own, paths);
      }
    }
  }

  private readonly earlyCallCheck(
    expr: CallExpr,
    callee: NameExpr,
    target: ValueTarget,
    module: int,
  ): void {
    if (target.kind != SymbolKind.Function || target.module != module) {
      return;
    }

    const owner = this.openFunctions[this.openFunctions.length - 1];
    const fn = this.record(module)?.functions.get(target.loc);
    if (
      owner == undefined ||
      fn == undefined ||
      !this.statements.isInsideFunction(owner, fn.loc)
    ) {
      return;
    }

    const later = this.laterCapture(fn, owner, expr.loc, module);
    if (later == undefined) {
      return;
    }

    this.report(module, callee.loc, Code.UsedBeforeDeclared, {
      word: fn.name,
      first: later,
    });
  }

  private readonly laterCapture(
    fn: FunctionDecl,
    owner: FunctionDecl,
    at: int,
    module: int,
  ): string | undefined {
    const record = this.record(module);
    if (record == undefined) {
      return undefined;
    }

    for (const [loc, use] of record.uses) {
      const symbol = use.symbol;
      if (symbol == undefined || !this.statements.isInsideFunction(fn, loc)) {
        continue;
      }

      const isOuterLocal =
        symbol.kind == SymbolKind.Variable &&
        !this.statements.isInsideFunction(fn, symbol.loc) &&
        this.statements.isInsideFunction(owner, symbol.loc);
      if (isOuterLocal && symbol.loc > at) {
        return use.name;
      }
    }

    return undefined;
  }

  private readonly functionMemberCall(
    member: MemberExpr,
    object: Type,
    module: int,
  ): Type {
    const word = member.name;

    if (this.isLibraryFunctionName(member.object, module)) {
      return this.store.plain(TypeKind.Error);
    }
    if (kFunctionMethods.includes(word)) {
      this.report(module, member.loc, Code.FunctionSetsThis, { word });

      return this.store.plain(TypeKind.Error);
    }

    const first = this.text.of(object);

    this.report(module, member.loc, Code.PropertyMissing, { word, first });

    return this.store.plain(TypeKind.Error);
  }

  private readonly isLibraryFunctionName(expr: Expr, module: int): boolean {
    if (expr.kind != ExprKind.Name) {
      return false;
    }

    const target = this.targetOfName(expr, module);
    if (target == undefined || target.kind != SymbolKind.Function) {
      return false;
    }

    return this.modules.isLibraryModule(target.module);
  }

  private readonly arrayTextCheck(member: MemberExpr, object: Type, module: int): void {
    if (object.kind != TypeKind.Array || !kTextMethods.includes(member.name)) {
      return;
    }

    const held = this.statements.heldValue(object.item);
    const word = member.name;
    const code = this.textElementsCode(held);
    if (code != undefined) {
      this.report(module, member.loc, code, { word });
    }
  }

  private readonly textElementsCode(held: Type): Code | undefined {
    switch (held.kind) {
      case TypeKind.Function:
        return Code.ArrayTextFunctions;
      case TypeKind.Result:
        return Code.ArrayTextResults;
      case TypeKind.Unknown:
        return this.unknownCode(Code.ArrayTextUnknown);
      case TypeKind.Json:
        return Code.ArrayTextJson;
      case TypeKind.Object:
      case TypeKind.Dict:
      case TypeKind.Tuple:
      case TypeKind.AnyObject:
        return Code.ArrayTextObjects;
      case TypeKind.Instance:
        return this.statements.instanceTextCode(held);
      default:
        return undefined;
    }
  }

  private readonly unknownCode(code: Code): Code | undefined {
    const isGeneric = this.openFunctions.some((fn) => fn.typeParams.length > 0);
    if (isGeneric) {
      return undefined;
    }

    return code;
  }

  private readonly arraySortCheck(
    expr: CallExpr,
    member: MemberExpr,
    object: Type,
    module: int,
  ): void {
    const isPlainSort = member.name == "sort" && expr.args.length == 0;
    if (object.kind != TypeKind.Array || !isPlainSort) {
      return;
    }

    const element = object.item;
    const code = this.sortProblem(element);
    if (code == undefined) {
      const held = this.types.definedType(element);

      return this.requireOf(held, RequirementKind.Sort, "");
    }

    const word = this.text.of(this.types.definedType(element));
    const other = this.statements.sortExample(element);

    this.report(module, member.loc, code, { word, other });
  }

  private readonly sortProblem(element: Type): Code | undefined {
    const held = this.statements.heldValue(element);

    switch (held.kind) {
      case TypeKind.Function:
        return Code.SortFunctions;
      case TypeKind.Unknown:
        return this.unknownCode(Code.SortUnknown);
      case TypeKind.Json:
        return Code.SortJson;
      case TypeKind.Object:
      case TypeKind.Dict:
      case TypeKind.Tuple:
      case TypeKind.AnyObject:
      case TypeKind.Result:
        return Code.SortObjects;
      case TypeKind.Instance:
        return this.statements.instanceSortCode(held);
      default:
        return this.statements.plainSortProblem(element);
    }
  }
}
