import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  Expr,
  ExprKind,
  NameExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  LiteralKind,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import { kNullName } from "../../const/expression-types.const.tz";
import { LiteralValue } from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private literalOf(expr: Expr, module: int): LiteralValue | undefined {
    switch (expr.kind) {
      case ExprKind.IntLit:
        return {
          kind: LiteralKind.Int,
          text: `${expr.value}`,
          whole: expr.value,
          negative: false,
        };
      case ExprKind.FloatLit:
        return this.literals.plainLiteral(LiteralKind.Double, `${expr.value}`);
      case ExprKind.BoolLit: {
        const text = this.sources.truthText(expr.value);

        return this.literals.plainLiteral(LiteralKind.Boolean, text);
      }
      case ExprKind.StringLit:
        return this.literals.plainLiteral(LiteralKind.String, expr.value);
      case ExprKind.Unary:
        return this.literals.signedLiteral(expr);
      case ExprKind.Name:
        return this.doorOfName(expr, module)?.literal;
      case ExprKind.Member:
        return this.enumLiteral(expr, module);
      default:
        return undefined;
    }
  }

  private literalTyped(
    expr: Expr,
    literal: LiteralValue,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const base = this.baseType(expr, literal, module);

    if (wanted == undefined) {
      return base;
    }

    const parts = this.types.definedParts(wanted);

    switch (literal.kind) {
      case LiteralKind.String:
        if (parts.some((part) => this.literals.isTextual(part))) {
          return this.store.literal(LiteralKind.String, literal.text);
        }

        return base;
      case LiteralKind.Boolean:
        if (this.literals.hasLiteral(parts, LiteralKind.Boolean)) {
          return this.store.literal(LiteralKind.Boolean, literal.text);
        }

        return base;
      case LiteralKind.Double: {
        const fraction = this.literals.fractionTyped(
          expr,
          literal,
          parts,
          base,
        );
        if (fraction.kind == TypeKind.Decimal) {
          this.decimalRangeCheck(expr, module);
        }

        return fraction;
      }
      default:
        return this.wholeTyped(expr, literal, parts, base, module);
    }
  }

  private baseType(expr: Expr, literal: LiteralValue, module: int): Type {
    if (expr.kind == ExprKind.Name) {
      return this.named(expr, undefined, module);
    }
    if (expr.kind == ExprKind.Member && literal.kind == LiteralKind.String) {
      return this.enumWhole(expr, module);
    }

    const int = this.store.integer(64, false);

    switch (literal.kind) {
      case LiteralKind.String:
        return this.store.plain(TypeKind.String);
      case LiteralKind.Boolean:
        return this.store.plain(TypeKind.Boolean);
      case LiteralKind.Double:
        return this.store.plain(TypeKind.Double);
      default:
        if (int.kind == TypeKind.Int && this.literals.fits(literal, int)) {
          return int;
        }

        return this.store.plain(TypeKind.Double);
    }
  }

  private wholeTyped(
    expr: Expr,
    literal: LiteralValue,
    parts: Type[],
    base: Type,
    module: int,
  ): Type {
    const exact = this.store.literal(LiteralKind.Int, literal.text);
    const hasWholes = this.literals.hasLiteral(parts, LiteralKind.Int);
    const hasDoubles = this.literals.hasLiteral(parts, LiteralKind.Double);
    const isListed = parts.includes(exact) || !hasDoubles;
    const hasLiterals = hasWholes || hasDoubles;
    if (expr.kind == ExprKind.Name && hasLiterals) {
      return base;
    }
    if (hasWholes && isListed) {
      return exact;
    }
    if (hasDoubles) {
      return this.store.literal(LiteralKind.Double, literal.text);
    }

    const target = parts.find((part) => this.types.isNumber(part));
    if (target == undefined) {
      return base;
    }
    if (target.kind != TypeKind.Int || this.literals.fits(literal, target)) {
      return target;
    }
    if (expr.kind == ExprKind.Name) {
      return base;
    }

    const word = this.text.of(target);
    const loc = this.literals.literalPlace(expr);

    this.report(module, loc, Code.IntegerLiteralTooBig, { word });

    return target;
  }

  private isNullName(expr: NameExpr, module: int): boolean {
    const symbol = this.record(module)?.uses.get(expr.loc)?.symbol;

    return expr.name == kNullName && symbol == undefined;
  }

  private nullTyped(
    expr: NameExpr,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const target = this.types.wantedPart(wanted);
    if (target != undefined && target.kind == TypeKind.Json) {
      return target;
    }

    this.report(module, expr.loc, Code.NullValue, kNoDetails);

    return this.store.plain(TypeKind.Error);
  }
}
