import {
  CallArgument,
  Expr,
  ExprKind,
  NewExpr,
  NewKind,
  SequenceExpr,
  TemplateExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import { ExpressionTypes } from "../../expression-types.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";

partial class ExpressionTypes {
  private templateTyped(
    expr: TemplateExpr,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    for (const part of tree.exprsOf(expr.exprsList)) {
      this.templatePart(part, module);
    }

    return this.types.templated(wanted);
  }

  private templatePart(part: Expr, module: int): void {
    if (this.isHintNeeded(part, module)) {
      return;
    }

    const type = this.typed(part, undefined, module);

    this.textCheck(part, type, module);
  }

  private sequenceTyped(
    expr: SequenceExpr,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const exprs = tree.exprsOf(expr.exprsList);
    let last: Type = this.types.store.plain(TypeKind.Undefined);

    for (let index: int = 0; index < exprs.length; index++) {
      const part = exprs[index];
      if (part == undefined) {
        continue;
      }

      const isLast = index == exprs.length - 1;
      const asked = this.lastWanted(isLast, wanted);

      last = this.typed(part, asked, module);
    }

    return last;
  }

  private readonly lastWanted(
    isLast: boolean,
    wanted: Type | undefined,
  ): Type | undefined {
    if (isLast) {
      return wanted;
    }

    return undefined;
  }

  private childrenTyped(expr: Expr, module: int): Type {
    for (const part of this.types.childrenOf(expr)) {
      this.walkedPart(part, module);
    }

    return this.types.store.plain(TypeKind.Error);
  }

  private walkedArguments(args: Read<CallArgument[]>, module: int): void {
    const tree = this.types.program.tree;

    for (const arg of args) {
      const exprExpr = tree.exprOf(arg.exprId);
      if (!this.answers.isVisited(exprExpr)) {
        const expr = tree.exprOf(arg.exprId);

        this.walkedPart(expr, module);
      }
    }
  }

  private walkedPart(expr: Expr, module: int): void {
    if (this.isHintNeeded(expr, module)) {
      return;
    }

    this.typed(expr, undefined, module);
  }

  private readonly isHintNeeded(expr: Expr, module: int): boolean {
    const tree = this.types.program.tree;

    switch (expr.kind) {
      case ExprKind.ArrayLit:
      case ExprKind.ObjectLit:
      case ExprKind.Undefined:
        return true;
      case ExprKind.Function:
        return tree
          .paramsOf(tree.functionOf(expr.fnId).paramsList)
          .some((param) => tree.typeRefAt(param.typeId) == undefined);
      case ExprKind.Name:
        return (
          this.isNullName(expr, module) ||
          this.enumOfObject(expr, module) != undefined
        );
      case ExprKind.Conditional:
        return (
          this.isHintNeeded(tree.exprOf(expr.thenExprId), module) ||
          this.isHintNeeded(tree.exprOf(expr.elseExprId), module)
        );
      case ExprKind.Binary:
        return (
          this.types.isLogicOp(expr.op) &&
          this.isHintNeeded(tree.exprOf(expr.rhsId), module)
        );
      case ExprKind.New: {
        const isBare =
          tree.typeRefsOf(expr.typeArgsList).length == 0 &&
          tree.argumentsOf(expr.argsList).length == 0;

        return isBare && !this.isPlainNew(expr, module);
      }
      default:
        return false;
    }
  }

  private readonly isPlainNew(expr: NewExpr, module: int): boolean {
    const tree = this.types.program.tree;

    const form = expr.form;
    if (form.kind != NewKind.Named || form.member != undefined) {
      return false;
    }

    const target = this.targetOfUse(expr.loc, form.name, module);
    if (target == undefined || target.kind != SymbolKind.Class) {
      return false;
    }

    const opened = this.types.program.modules[target.module];
    const declared = tree
      .declaredClassesOf(opened?.declaredList)
      .find((one) => one.loc == target.loc);
    if (declared != undefined) {
      return tree.typeParamsOf(declared.typeParamsList).length == 0;
    }

    const decl = this.record(target.module)?.classes.get(target.loc);

    return (
      decl != undefined && tree.typeParamsOf(decl.typeParamsList).length == 0
    );
  }
}
