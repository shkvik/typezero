import { replace } from "tz:mem";
import {
  BindingKind,
  NameOrigin,
  VarDeclarator,
} from "../../../../../program/ast/types/ast.types.patterns.tz";
import {
  DeclaredVariable,
  Destination,
  UnknownType,
  DestinationKind,
  HiddenName,
  ParamSlot,
  ValueDraft,
  ValueRecord,
  LiteralValue,
  VariableDoor,
} from "../../types/expression-types.types.tz";
import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  Expr,
  ExprKind,
  NameExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  ClassDecl,
  EnumDecl,
} from "../../../../../program/ast/types/ast.types.classes.tz";
import { FunctionDecl } from "../../../../../program/ast/types/ast.types.functions.tz";
import {
  NameUse,
  SymbolKind,
} from "../../../../../program/scopes/types/scopes.types.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  DoorState,
  TypeContext,
  TypePlace,
} from "../../../../types/type-resolver/types/type-resolver.types.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  kNoPlace,
  kShortTextLength,
} from "../../const/expression-types.const.tz";

partial class ExpressionTypes {
  public readonly variableOf(module: int, loc: int): Type | undefined {
    return this.doors.get(`${module} ${loc}`)?.type;
  }

  public prepare(): void {
    for (const module of this.types.program.modules) {
      this.madeRecord(module.id);
    }

    this.indexGlobalValues();
  }

  private readonly record(module: int): Read<ValueRecord> | undefined {
    return this.records.get(module);
  }

  private readonly destinationsOf(module: int, loc: int): Destination[] {
    const list = this.records.get(module)?.destinations.get(loc);
    if (list == undefined) {
      return [];
    }

    return list.slice();
  }

  private madeRecord(module: int): void {
    const tree = this.types.program.tree;

    const opened = this.types.program.modules[module];
    if (this.records.has(module) || opened == undefined) {
      return;
    }

    const uses = new Map<int, NameUse>();

    for (const use of this.types.usesOf(module)) {
      if (!use.isType) {
        uses.set(use.loc, use);
      }
    }

    const record: ValueDraft = {
      uses,
      hidden: new Map<string, HiddenName>(),
      variables: new Map<int, DeclaredVariable>(),
      functions: new Map<int, FunctionDecl>(),
      params: new Map<int, ParamSlot>(),
      assigned: new Set<int>(),
      changes: [],
      enums: new Map<int, EnumDecl>(),
      classes: new Map<int, ClassDecl>(),
      destinations: new Map<int, Destination[]>(),
      owners: [],
    };

    const items = tree.stmtsOf(opened.file.itemsList);

    this.indexStatements(items, record);

    for (const part of tree.classesOf(opened.partsList)) {
      this.indexClass(part, record);
    }

    this.records.set(module, this.frozenRecord(record));

    const isQuiet =
      this.types.isTypedLibrary(module) &&
      !this.types.isCheckedLibrary(module);
    if (!isQuiet) {
      this.errors.allow(module);
    }
  }

  private readonly frozenRecord(draft: Own<ValueDraft>): ValueRecord {
    return {
      uses: draft.uses,
      hidden: draft.hidden,
      variables: draft.variables,
      functions: draft.functions,
      params: draft.params,
      assigned: draft.assigned,
      changes: draft.changes,
      enums: draft.enums,
      classes: draft.classes,
      destinations: draft.destinations,
      owners: draft.owners,
    };
  }

  private doorOfName(expr: NameExpr, module: int): VariableDoor | undefined {
    const target = this.targetOfName(expr, module);
    if (target == undefined || target.kind != SymbolKind.Variable) {
      return undefined;
    }

    return this.door(target.module, target.loc);
  }

  private door(module: int, loc: int): VariableDoor | undefined {
    const before = replace(this.facts, new Map<string, Type>());

    const door = this.localDoor(module, loc);

    this.facts = before;

    return door;
  }

  private localDoor(module: int, loc: int): VariableDoor | undefined {
    const key = `${module} ${loc}`;
    const known = this.doors.get(key);
    if (known != undefined) {
      return known;
    }

    const variable = this.record(module)?.variables.get(loc);
    if (variable == undefined) {
      return undefined;
    }

    this.noteLate("variable", module, loc);

    const error = this.types.store.plain(TypeKind.Error);
    const owned = this.errors.mark();

    this.doors.set(key, {
      state: DoorState.InWork,
      type: error,
      isWhole: false,
    });
    this.doorOrder.push(key);
    this.openVariable(key, variable, module);
    this.unknownTypeCheck(key, variable, owned, module);
    this.errors.keepSince(owned);

    return this.variableDone(key);
  }

  private unknownTypeCheck(
    key: string,
    variable: DeclaredVariable,
    owned: int,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const door = this.doors.get(key);
    const init = tree.exprAt(variable.decl.initId);
    const written = tree.typeRefAt(variable.decl.typeAnnId);
    const isWritten = variable.decl.origin == NameOrigin.Written;
    if (door == undefined || init == undefined || written != undefined) {
      return;
    }
    if (!isWritten) {
      return;
    }
    if (door.type.kind != TypeKind.Error || this.errors.mark() != owned) {
      return;
    }

    const last = this.lastLocOf(init);
    if (this.hasErrorWithin(module, variable.decl.loc, last)) {
      return;
    }
    if (this.usesUnknown(init, module)) {
      return;
    }

    const word = variable.decl.name;
    const other = this.shortText(init, module);
    const loc = variable.decl.loc;

    this.unknownTypes.push({ module, loc, word, other });
  }

  private reportUnknownTypes(): void {
    const unknown = this.unknownTypes.splice(0, this.unknownTypes.length);
    const failed = new Set<int>();

    for (const one of unknown) {
      if (this.hasModuleErrors(one.module)) {
        failed.add(one.module);
      }
    }

    for (const one of unknown) {
      if (failed.has(one.module)) {
        continue;
      }

      this.errors.write(one.module, one.loc, Code.TypeNotWorkedOut, {
        word: one.word,
        other: one.other,
      });
    }
  }

  private readonly usesUnknown(expr: Expr, module: int): boolean {
    const exprs: Expr[] = [expr];

    this.types.exprs(expr, exprs, false);

    for (const one of exprs) {
      if (one.kind != ExprKind.Name) {
        continue;
      }

      const target = this.targetOfName(one, module);
      if (target == undefined) {
        return true;
      }

      const key = `${target.module} ${target.loc}`;
      const door = this.doors.get(key);
      const param = this.paramTypes.get(key);
      const isDoorUnknown = door != undefined && door.type.kind == TypeKind.Error;
      const isParamUnknown = param != undefined && param.kind == TypeKind.Error;
      if (isDoorUnknown || isParamUnknown) {
        return true;
      }
    }

    return false;
  }

  private readonly firstLocOf(expr: Expr): int {
    const exprs: Expr[] = [];
    let first: int = expr.loc;

    this.types.exprs(expr, exprs, false);

    for (const one of exprs) {
      if (one.loc < first) {
        first = one.loc;
      }
    }

    return first;
  }

  private readonly lastLocOf(expr: Expr): int {
    const exprs: Expr[] = [];
    let last: int = expr.loc;

    this.types.exprs(expr, exprs, false);

    for (const one of exprs) {
      if (one.loc > last) {
        last = one.loc;
      }
    }

    return last;
  }

  private readonly shortText(expr: Expr, module: int): string {
    const opened = this.types.program.modules[module];
    if (opened == undefined) {
      return "";
    }

    const start = this.firstLocOf(expr);
    const end = start + kShortTextLength;
    const rest = opened.source.text.toString("utf8", start, end);
    const line = rest.indexOf("\n");
    if (line >= 0) {
      return rest.slice(0, line).trimEnd();
    }
    if (rest.length < kShortTextLength) {
      return rest;
    }

    return `${rest}...`;
  }

  private readonly hasModuleErrors(module: int): boolean {
    const own = this.errors.of(module).length;
    const types = this.types.problems(module).length;
    const scopes = this.types.scopeErrors(module).length;

    return own + types + scopes > 0;
  }

  private readonly hasErrorWithin(module: int, from: int, to: int): boolean {
    const errors = this.errors.of(module);

    return errors.some((one) => one.loc >= from && one.loc <= to);
  }

  private variableDone(key: string): VariableDoor | undefined {
    const door = this.doors.get(key);
    if (door == undefined) {
      return undefined;
    }

    const done: VariableDoor = { ...door, state: DoorState.Done };

    this.doors.set(key, done);

    return done;
  }

  private setDoorType(key: string, type: Type): void {
    const door = this.doors.get(key);
    if (door != undefined) {
      const changed: VariableDoor = { ...door, type };

      this.doors.set(key, changed);
    }
  }

  private setDoorGiven(key: string, given: Type): void {
    const door = this.doors.get(key);
    if (door != undefined) {
      const changed: VariableDoor = { ...door, given };

      this.doors.set(key, changed);
    }
  }

  private setDoorLiteral(key: string, literal: LiteralValue | undefined): void {
    const door = this.doors.get(key);
    if (door != undefined) {
      const changed: VariableDoor = { ...door, literal };

      this.doors.set(key, changed);
    }
  }

  private setDoorConstant(key: string, constant: decimal | undefined): void {
    const door = this.doors.get(key);
    if (door != undefined) {
      const changed: VariableDoor = { ...door, constant };

      this.doors.set(key, changed);
    }
  }

  private setDoorWhole(key: string, isWhole: boolean): void {
    const door = this.doors.get(key);
    if (door != undefined) {
      const changed: VariableDoor = { ...door, isWhole };

      this.doors.set(key, changed);
    }
  }

  private doorTextsOfName(expr: NameExpr, module: int): string[] | undefined {
    const target = this.targetOfName(expr, module);
    if (target == undefined || target.kind != SymbolKind.Variable) {
      return undefined;
    }

    const key = `${target.module} ${target.loc}`;

    this.door(target.module, target.loc);

    return this.doorTexts.get(key)?.slice();
  }

  private open(
    key: string,
    variable: DeclaredVariable,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const decl = variable.decl;
    const written = tree.typeRefAt(decl.typeAnnId);
    const init = tree.exprAt(decl.initId);
    const loop = variable.loop;
    const isPattern =
      decl.form.kind != BindingKind.Plain &&
      decl.origin == NameOrigin.Generated;
    if (isPattern) {
      return this.patternSource(key, variable, module);
    }
    if (loop != undefined) {
      const item = this.loopItem(loop, module);

      return this.setDoorType(key, item);
    }

    const isPlain =
      decl.form.kind == BindingKind.Plain && decl.origin == NameOrigin.Written;
    if (!isPlain) {
      return;
    }
    if (written != undefined) {
      const context: TypeContext = {
        module,
        bindings: new Map<int, Type>(),
        place: TypePlace.Plain,
      };
      const type = this.types.value(written, context);

      this.setDoorType(key, type);

      if (init == undefined || type.kind == TypeKind.Error) {
        return;
      }

      const given = this.checked(init, type, module, kNoPlace);
      const constant = this.keptConstant(variable, init, given, module);

      this.setDoorGiven(key, given);

      return this.setDoorConstant(key, constant);
    }
    if (init == undefined) {
      const first = this.assignedTypeText(decl, false, module);
      const code = this.types.untypedCode(first, false);

      this.errors.write(module, decl.loc, code, { word: decl.name, first });

      return;
    }

    const destination = this.destinationOf(variable, init, module);
    const given = this.typed(init, destination, module);
    if (given.kind == TypeKind.Void) {
      this.errors.write(module, init.loc, Code.VoidInitializer, kNoDetails);

      return;
    }
    if (given.kind == TypeKind.Undefined && !variable.isConst) {
      const first = this.assignedTypeText(decl, true, module);
      const code = this.types.untypedCode(first, true);

      return this.errors.write(module, decl.loc, code, {
        word: decl.name,
        first,
      });
    }
    if (given.kind == TypeKind.Undefined) {
      const undefinedError = this.types.undefinedError(variable, init);

      return this.errors.writeFound(module, undefinedError);
    }

    const placed = this.placedType(given, destination);

    this.setDoorType(key, placed);

    if (variable.isConst) {
      const literal = this.literalOf(init, module);

      this.setDoorLiteral(key, literal);
    }
    if (variable.isConst && given.kind == TypeKind.String) {
      const texts = this.constTexts(init, module);
      if (texts != undefined) {
        this.doorTexts.set(key, texts);
      }
    }

    const constant = this.keptConstant(variable, init, given, module);

    this.setDoorConstant(key, constant);

    const isWhole = this.isWholeConstant(constant, init, given, module);

    this.setDoorWhole(key, isWhole);
  }

  private constTexts(init: Expr, module: int): string[] | undefined {
    if (init.kind == ExprKind.Name) {
      return this.doorTextsOfName(init, module);
    }

    const texts: string[] = [];

    if (!this.collectTexts(init, texts)) {
      return undefined;
    }

    return texts;
  }

  private readonly collectTexts(expr: Expr, texts: string[]): boolean {
    const tree = this.types.program.tree;

    if (expr.kind == ExprKind.Conditional) {
      return (
        this.collectTexts(tree.exprOf(expr.thenExprId), texts) &&
        this.collectTexts(tree.exprOf(expr.elseExprId), texts)
      );
    }
    if (expr.kind != ExprKind.StringLit) {
      return false;
    }
    if (!texts.includes(expr.value)) {
      texts.push(expr.value);
    }

    return true;
  }

  private keptConstant(
    variable: DeclaredVariable,
    init: Expr,
    given: Type,
    module: int,
  ): decimal | undefined {
    if (variable.isConst && given.kind == TypeKind.Decimal) {
      return this.plainConstant(init, module);
    }
    if (variable.isConst) {
      return this.rawConstant(init, given, module);
    }

    return undefined;
  }

  private isWholeConstant(
    constant: decimal | undefined,
    init: Expr,
    given: Type,
    module: int,
  ): boolean {
    if (given.kind != TypeKind.Int || constant == undefined) {
      return false;
    }
    if (given.bits != 64 || given.unsigned) {
      return false;
    }

    return this.isWholeTree(init, module);
  }

  private assignedTypeText(
    decl: VarDeclarator,
    isUndefined: boolean,
    module: int,
  ): string {
    const list = this.destinationsOf(module, decl.loc);
    let joined: Type | undefined = undefined;

    if (isUndefined) {
      joined = this.types.store.plain(TypeKind.Undefined);
    }

    for (const one of list) {
      const value = one.value;
      if (one.kind != DestinationKind.Assigned || value == undefined) {
        continue;
      }

      const given = this.peekType(value, module);

      joined = this.assignedJoin(joined, given);
    }

    const isKnown =
      joined != undefined &&
      joined.kind != TypeKind.Error &&
      joined.kind != TypeKind.Undefined;
    if (!isKnown || joined == undefined) {
      return "";
    }

    return this.types.typeText(joined);
  }

  private assignedJoin(joined: Type | undefined, given: Type): Type {
    if (joined == undefined) {
      return given;
    }

    const isMixed =
      this.types.isNumeric(joined) &&
      this.types.isNumeric(given) &&
      joined.kind != given.kind;
    if (isMixed) {
      return this.types.store.plain(TypeKind.Double);
    }

    return (
      this.types.unify(joined, given) ?? this.types.store.plain(TypeKind.Error)
    );
  }
}
