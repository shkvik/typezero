import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  Expr,
  ExprKind,
  NameExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  BindingKind,
  NameOrigin,
} from "../../../../../program/ast/types/ast.types.patterns.tz";
import {
  ClassDecl,
  EnumDecl,
} from "../../../../../program/ast/types/ast.types.classes.tz";
import { FunctionDecl } from "../../../../../program/ast/types/ast.types.functions.tz";
import {
  NameUse,
  SymbolKind,
} from "../../../../../program/scopes/types/scopes.types.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  DoorState,
  TypeContext,
  TypePlace,
} from "../../../../types/type-resolver/types/type-resolver.types.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import { kNoPlace } from "../../const/expression-types.const.tz";
import {
  DeclaredVariable,
  HiddenName,
  Destination,
  ParamSlot,
  ValueRecord,
  VariableDoor,
} from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private record(module: int): ValueRecord | undefined {
    const known = this.records.get(module);
    if (known != undefined) {
      return known;
    }

    const opened = this.program.modules[module];
    if (module < 0 || opened == undefined) {
      return undefined;
    }

    const uses = new Map<int, NameUse>();
    const record: ValueRecord = {
      uses,
      hidden: new Map<string, HiddenName>(),
      variables: new Map<int, DeclaredVariable>(),
      functions: new Map<int, FunctionDecl>(),
      params: new Map<int, ParamSlot>(),
      assigned: new Set<int>(),
      changes: [],
      enums: new Map<int, EnumDecl>(),
      classes: new Map<int, ClassDecl>(),
      destinations: new Map<int, Destination[]>(),
      owners: [],
      reported: new Set<string>(),
      errors: [],
    };

    for (const use of this.scopes.get(module)?.uses ?? []) {
      if (!use.isType) {
        uses.set(use.loc, use);
      }
    }

    this.records.set(module, record);
    this.indexStatements(opened.file.items, record);

    for (const part of opened.parts) {
      this.indexClass(part, record);
    }

    return record;
  }

  private doorOfName(expr: NameExpr, module: int): VariableDoor | undefined {
    const target = this.targetOfName(expr, module);
    if (target == undefined || target.kind != SymbolKind.Variable) {
      return undefined;
    }

    return this.door(target.module, target.loc);
  }

  private door(module: int, loc: int): VariableDoor | undefined {
    const before = this.facts;

    this.facts = new Map<string, Type>();

    const door = this.localDoor(module, loc);

    this.facts = before;

    return door;
  }

  private localDoor(module: int, loc: int): VariableDoor | undefined {
    const key = `${module} ${loc}`;
    const known = this.doors.get(key);
    if (known != undefined) {
      return known;
    }

    const variable = this.record(module)?.variables.get(loc);
    if (variable == undefined) {
      return undefined;
    }

    const door: VariableDoor = {
      state: DoorState.InWork,
      type: this.store.plain(TypeKind.Error),
      isWhole: false,
    };

    this.doors.set(key, door);
    this.doorOrder.push(key);
    this.openVariable(door, variable, module);
    door.state = DoorState.Done;

    return door;
  }

  private open(
    door: VariableDoor,
    variable: DeclaredVariable,
    module: int,
  ): void {
    const decl = variable.decl;
    const written = decl.typeAnn;
    const init = decl.init;
    const loop = variable.loop;
    const isPattern =
      decl.form.kind != BindingKind.Plain &&
      decl.origin == NameOrigin.Generated;
    if (isPattern) {
      return this.patternSource(door, variable, module);
    }
    if (loop != undefined) {
      door.type = this.loopItem(loop, module);

      return;
    }

    const isPlain =
      decl.form.kind == BindingKind.Plain && decl.origin == NameOrigin.Written;
    if (!isPlain) {
      return;
    }
    if (written != undefined) {
      const context: TypeContext = {
        module,
        bindings: new Map<int, Type>(),
        place: TypePlace.Plain,
      };
      const type = this.resolver.value(written, context);

      door.type = type;

      if (init == undefined || type.kind == TypeKind.Error) {
        return;
      }

      const given = this.checked(init, type, module, kNoPlace);

      door.given = given;

      return this.keepConstant(door, variable, init, given, module);
    }
    if (init == undefined) {
      this.report(module, decl.loc, Code.VariableNeedsType, {
        word: decl.name,
      });

      return;
    }

    const destination = this.destinationOf(variable, init, module);
    const given = this.typed(init, destination, module);
    if (given.kind == TypeKind.Void) {
      this.report(module, init.loc, Code.VoidInitializer, kNoDetails);

      return;
    }
    if (given.kind == TypeKind.Undefined) {
      const undefinedError = this.statements.undefinedError(variable, init);

      return this.reportFound(module, undefinedError);
    }

    door.type = this.placedType(given, destination);

    if (variable.isConst) {
      door.literal = this.literalOf(init, module);
    }
    if (variable.isConst && given.kind == TypeKind.String) {
      door.texts = this.constTexts(init, module);
    }

    this.keepConstant(door, variable, init, given, module);

    door.isWhole = this.isWholeConstant(door, init, given, module);
  }

  private constTexts(init: Expr, module: int): string[] | undefined {
    if (init.kind == ExprKind.Name) {
      return this.doorOfName(init, module)?.texts;
    }

    const texts: string[] = [];

    if (!this.collectTexts(init, texts)) {
      return undefined;
    }

    return texts;
  }

  private collectTexts(expr: Expr, texts: string[]): boolean {
    if (expr.kind == ExprKind.Conditional) {
      return (
        this.collectTexts(expr.thenExpr, texts) &&
        this.collectTexts(expr.elseExpr, texts)
      );
    }
    if (expr.kind != ExprKind.StringLit) {
      return false;
    }
    if (!texts.includes(expr.value)) {
      texts.push(expr.value);
    }

    return true;
  }

  private keepConstant(
    door: VariableDoor,
    variable: DeclaredVariable,
    init: Expr,
    given: Type,
    module: int,
  ): void {
    if (variable.isConst && given.kind == TypeKind.Decimal) {
      door.constant = this.plainConstant(init, module);

      return;
    }
    if (variable.isConst) {
      door.constant = this.rawConstant(init, given, module);
    }
  }

  private isWholeConstant(
    door: VariableDoor,
    init: Expr,
    given: Type,
    module: int,
  ): boolean {
    if (given.kind != TypeKind.Int || door.constant == undefined) {
      return false;
    }
    if (given.bits != 64 || given.unsigned) {
      return false;
    }

    return this.isWholeTree(init, module);
  }
}
