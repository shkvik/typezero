import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  BinaryExpr,
  CallExpr,
  Expr,
  ExprKind,
  IndexExpr,
  MemberExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { kStringClass } from "../../const/expression-types.const.tz";
import { OperandPair } from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private listInCheck(expr: BinaryExpr, object: Type, module: int): boolean {
    const tree = this.types.program.tree;

    const right = this.types.definedType(object);
    if (right.kind != TypeKind.Array && right.kind != TypeKind.String) {
      return false;
    }

    const lhs = tree.exprOf(expr.lhsId);
    const left = this.peekType(lhs, module);

    if (left.kind == TypeKind.Error || object.kind == TypeKind.Error) {
      return true;
    }
    if (right.kind == TypeKind.String) {
      const pair: OperandPair = { left, right: object };

      const operandsError = this.types.operandsError(expr, pair);

      this.errors.writeFound(module, operandsError);

      return true;
    }

    const lhsExpr = tree.exprOf(expr.lhsId);
    const key = this.types.simpleText(lhsExpr);
    const isKnown = this.types.apparent(left).kind == TypeKind.Int && key != "";
    const index = this.types.knownOr(isKnown, key, "i");
    const rhs = tree.exprOf(expr.rhsId);
    const array = this.types.simpleOr(rhs, "a");
    const below = `${index} < ${array}.length`;
    const word = this.types.boundsText(
      tree.exprOf(expr.lhsId).kind == ExprKind.IntLit,
      index,
      below,
    );

    this.errors.write(module, expr.loc, Code.ArrayIn, { word });

    return true;
  }

  private indexDeleteCheck(
    expr: Expr,
    target: IndexExpr,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const objectExpr = tree.exprOf(target.objectId);
    const object = this.typed(objectExpr, undefined, module);
    const base = this.types.definedType(object);

    switch (base.kind) {
      case TypeKind.Array:
        const index = tree.exprOf(target.indexId);

        this.typed(index, undefined, module);
        this.errors.write(module, expr.loc, Code.DeleteArrayHole, {
          word: this.types.simpleOr(tree.exprOf(target.objectId), "a"),
          other: this.types.simpleOr(tree.exprOf(target.indexId), "i"),
        });

        return true;
      case TypeKind.String:
      case TypeKind.Template:
        const indexExpr = tree.exprOf(target.indexId);

        this.typed(indexExpr, undefined, module);
        this.errors.write(module, expr.loc, Code.DeleteCharacter, kNoDetails);

        return true;
      case TypeKind.Tuple:
        const targetIndex = tree.exprOf(target.indexId);

        this.typed(targetIndex, undefined, module);
        this.errors.write(module, expr.loc, Code.DeleteTupleHole, kNoDetails);

        return true;
      default:
        return false;
    }
  }

  private plainDeleteCheck(expr: Expr, target: Expr, module: int): boolean {
    const isPath =
      target.kind == ExprKind.Member || target.kind == ExprKind.Index;
    if (isPath) {
      return false;
    }

    const type = this.typed(target, undefined, module);
    if (type.kind != TypeKind.Error) {
      this.errors.write(module, expr.loc, Code.DeleteNotField, kNoDetails);
    }

    return true;
  }

  private rawTextsCheck(expr: MemberExpr, object: Type, module: int): boolean {
    const checked = this.types.rawTextsCheck(expr, object);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private stringRawCheck(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const object = tree.exprOf(member.objectId);
    const isRaw =
      member.name == "raw" &&
      object.kind == ExprKind.Name &&
      object.name == kStringClass &&
      this.isGlobalUse(object, module);
    if (!isRaw) {
      return false;
    }
    if (!expr.tagged) {
      this.errors.write(module, member.loc, Code.StringRawCall, kNoDetails);
    }

    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args, module);

    return true;
  }
}
