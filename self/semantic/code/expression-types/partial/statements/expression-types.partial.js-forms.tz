import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  BinaryExpr,
  CallExpr,
  Expr,
  ExprKind,
  IndexExpr,
  MemberExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { kStringClass } from "../../const/expression-types.const.tz";
import { OperandPair } from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  private listInCheck(expr: BinaryExpr, object: Type, module: int): boolean {
    const right = this.types.definedType(object);
    if (right.kind != TypeKind.Array && right.kind != TypeKind.String) {
      return false;
    }

    this.quiet += 1;

    const left = this.typed(expr.lhs, undefined, module);

    this.quiet -= 1;

    if (left.kind == TypeKind.Error || object.kind == TypeKind.Error) {
      return true;
    }
    if (right.kind == TypeKind.String) {
      const pair: OperandPair = { left, right: object };

      this.reportOperands(expr, pair, module);

      return true;
    }

    const key = this.simpleText(expr.lhs);
    const isKnown = this.types.apparent(left).kind == TypeKind.Int && key != "";
    const index = this.knownOr(isKnown, key, "i");
    const array = this.simpleOr(expr.rhs, "a");
    const below = `${index} < ${array}.length`;
    const word = this.boundsText(
      expr.lhs.kind == ExprKind.IntLit,
      index,
      below,
    );

    this.report(module, expr.loc, Code.ArrayIn, { word });

    return true;
  }

  private boundsText(isLiteral: boolean, index: string, below: string): string {
    if (isLiteral) {
      return below;
    }

    return `${index} >= 0 && ${below}`;
  }

  private simpleText(expr: Expr): string {
    if (expr.kind == ExprKind.Name) {
      return expr.name;
    }
    if (expr.kind == ExprKind.IntLit) {
      return `${expr.value}`;
    }

    return "";
  }

  private simpleOr(expr: Expr, fallback: string): string {
    const text = this.simpleText(expr);
    if (text == "") {
      return fallback;
    }

    return text;
  }

  private knownOr(isKnown: boolean, text: string, fallback: string): string {
    if (isKnown) {
      return text;
    }

    return fallback;
  }

  private indexDeleteCheck(
    expr: Expr,
    target: IndexExpr,
    module: int,
  ): boolean {
    const object = this.typed(target.object, undefined, module);
    const base = this.types.definedType(object);

    switch (base.kind) {
      case TypeKind.Array:
        this.typed(target.index, undefined, module);
        this.report(module, expr.loc, Code.DeleteArrayHole, {
          word: this.simpleOr(target.object, "a"),
          other: this.simpleOr(target.index, "i"),
        });

        return true;
      case TypeKind.String:
      case TypeKind.Template:
        this.typed(target.index, undefined, module);
        this.report(module, expr.loc, Code.DeleteCharacter, kNoDetails);

        return true;
      case TypeKind.Tuple:
        this.typed(target.index, undefined, module);
        this.report(module, expr.loc, Code.DeleteTupleHole, kNoDetails);

        return true;
      default:
        return false;
    }
  }

  private plainDeleteCheck(expr: Expr, target: Expr, module: int): boolean {
    const isPath =
      target.kind == ExprKind.Member || target.kind == ExprKind.Index;
    if (isPath) {
      return false;
    }

    const type = this.typed(target, undefined, module);
    if (type.kind != TypeKind.Error) {
      this.report(module, expr.loc, Code.DeleteNotField, kNoDetails);
    }

    return true;
  }

  private rawTextsCheck(expr: MemberExpr, object: Type, module: int): boolean {
    if (expr.name != "raw" || object.kind != TypeKind.Array) {
      return false;
    }
    if (this.types.definedType(object.item).kind != TypeKind.String) {
      return false;
    }

    this.report(module, expr.loc, Code.TemplateRaw, kNoDetails);

    return true;
  }

  private stringRawCheck(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): boolean {
    const object = member.object;
    const isRaw =
      member.name == "raw" &&
      object.kind == ExprKind.Name &&
      object.name == kStringClass &&
      this.isGlobalUse(object, module);
    if (!isRaw) {
      return false;
    }
    if (!expr.tagged) {
      this.report(module, member.loc, Code.StringRawCall, kNoDetails);
    }

    this.looseArguments(expr.args, module);

    return true;
  }

  private taggedPlace(count: int): string {
    if (count == 2) {
      return " and 1 value";
    }
    if (count != 1) {
      return ` and ${count - 1} values`;
    }

    return "";
  }
}
