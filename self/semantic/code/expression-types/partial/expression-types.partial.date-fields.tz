import { ExpressionTypes } from "../expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import { Details } from "../../../../diagnostic/types/message.types.tz";
import {
  CallArgument,
  Expr,
  ExprKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { Type } from "../../../../program/type/types/type.types.tz";
import { DateReader } from "../../../library/date-reader/date-reader.tz";
import {
  DateFields,
  DayValue,
} from "../../../library/date-reader/types/date-reader.types.tz";
import {
  kDateFieldLimit,
  kDateLocalLimit,
  kDateTimeLimit,
  kDateYearLimit,
  kDateYearShift,
  kDayMilliseconds,
  kDaysInCycle,
  kEpochYear,
  kFirstTimeField,
  kHourMilliseconds,
  kLastShortYear,
  kMinuteMilliseconds,
  kMonthDays,
  kMonthNames,
  kMonthStarts,
  kSecondMilliseconds,
  kShortYearBase,
  kTimeFieldMost,
  kTimeFieldNames,
  kUnknownYear,
  kYearsInCycle,
} from "../const/expression-types.const.tz";
import {
  CarriedDay,
  DateFieldValues,
} from "../types/expression-types.types.tz";

partial class ExpressionTypes {
  private dateFieldsCheck(
    args: CallArgument[],
    first: int,
    setter: string,
    module: int,
  ): void {
    const values: (int | undefined)[] = [];

    for (const arg of args) {
      const type = this.timeArgument(arg.expr, module);
      const value = this.dateConstant(arg.expr, type, module);

      values.push(value);
    }

    const fields: DateFieldValues = { args, first, setter, values };

    this.yearFieldCheck(fields, module);

    const month = this.validMonth(fields, module);

    this.dayFieldCheck(fields, month, module);
    this.timeFieldsCheck(fields, module);
  }

  private dateConstant(arg: Expr, type: Type, module: int): int | undefined {
    const base = this.types.apparent(type);
    const value = this.intConstant(arg, base, module);
    if (value == undefined) {
      return undefined;
    }

    const double = Number(value);
    if (double < -kDateFieldLimit || double > kDateFieldLimit) {
      return undefined;
    }

    return Math.trunc(double).toInt();
  }

  private fieldValue(fields: DateFieldValues, field: int): int | undefined {
    return fields.values[field - fields.first];
  }

  private reportField(
    fields: DateFieldValues,
    field: int,
    code: Code,
    module: int,
    details: Details,
  ): void {
    const arg = fields.args[field - fields.first]?.expr;
    if (arg != undefined) {
      this.report(module, arg.loc, code, details);
    }
  }

  private isShortYear(fields: DateFieldValues, year: int): boolean {
    return fields.setter == "" && year >= 0 && year <= kLastShortYear;
  }

  private yearFieldCheck(fields: DateFieldValues, module: int): void {
    const year = this.fieldValue(fields, 0);
    if (year == undefined || !this.isShortYear(fields, year)) {
      return;
    }

    this.reportField(fields, 0, Code.DateYearShort, module, {
      word: `${year}`,
      other: `${kShortYearBase + year}`,
    });
  }

  private validMonth(fields: DateFieldValues, module: int): int | undefined {
    const month = this.fieldValue(fields, 1);
    if (month == undefined || (month >= 0 && month <= 11)) {
      return month;
    }
    if (month == 12) {
      this.reportField(fields, 1, Code.DateMonthNext, module, kNoDetails);

      return undefined;
    }

    this.reportField(fields, 1, Code.DateMonthOutside, module, {
      word: `${month}`,
    });

    return undefined;
  }

  private dayFieldCheck(
    fields: DateFieldValues,
    month: int | undefined,
    module: int,
  ): void {
    const day = this.fieldValue(fields, 2);
    if (day == undefined) {
      return;
    }
    if (day < 0) {
      return this.reportField(fields, 2, Code.DateDayBelow, module, {
        word: `${day}`,
      });
    }
    if (month != undefined) {
      return this.dayInMonthCheck(fields, day, month, module);
    }
    if (day > 31) {
      this.reportField(fields, 2, Code.DateDayAbove, module, {
        word: `${day}`,
      });
    }
  }

  private knownYear(fields: DateFieldValues): int | undefined {
    const year = this.fieldValue(fields, 0);
    if (year == undefined) {
      return undefined;
    }
    if (this.isShortYear(fields, year)) {
      return kShortYearBase + year;
    }

    return year;
  }

  private dayInMonthCheck(
    fields: DateFieldValues,
    day: int,
    month: int,
    module: int,
  ): void {
    const year = this.knownYear(fields);
    const last = this.lastDayOf(year, month);
    if (day <= last) {
      return;
    }

    const missing = this.missingDay(year, month, day);
    const other = this.monthName(month);

    if (fields.setter == "") {
      return this.reportField(fields, 2, Code.DateDayLast, module, {
        word: missing,
        other,
        first: this.nextYearText(year, month),
        second: `${(month + 1) % 12}`,
      });
    }
    if (month == 1) {
      return this.reportField(fields, 2, Code.DateDayFebruary, module, {
        word: missing,
        other: fields.setter,
        first: this.yearPart(year),
      });
    }

    this.reportField(fields, 2, Code.DateDayCount, module, {
      word: missing,
      other,
      first: `${last}`,
    });
  }

  private nextYearText(year: int | undefined, month: int): string {
    if (year == undefined) {
      return kUnknownYear;
    }
    if (month == 11) {
      return `${year + 1}`;
    }

    return `${year}`;
  }

  private yearPart(year: int | undefined): string {
    if (year == undefined) {
      return "";
    }

    return `${year}, `;
  }

  private timeFieldsCheck(fields: DateFieldValues, module: int): void {
    const end = fields.first + fields.args.length;
    const start = Math.max(fields.first, kFirstTimeField);

    for (let field = start; field < end; field++) {
      const value = this.fieldValue(fields, field);
      const most = kTimeFieldMost[field - kFirstTimeField];
      const other = kTimeFieldNames[field - kFirstTimeField];
      if (value == undefined || most == undefined || other == undefined) {
        continue;
      }
      if (value >= 0 && value <= most) {
        continue;
      }

      this.reportField(fields, field, Code.DateTimeRange, module, {
        word: `${value}`,
        other,
        first: `${most}`,
      });
    }
  }

  private monthName(month: int): string {
    return kMonthNames[month] ?? "";
  }

  private isLeapYear(year: int): boolean {
    const isCentury = year % 100 == 0;

    return year % 4 == 0 && (!isCentury || year % 400 == 0);
  }

  private daysInMonth(year: int, month: int): int {
    if (month == 1 && this.isLeapYear(year)) {
      return 29;
    }

    return kMonthDays[month] ?? 31;
  }

  private lastDayOf(year: int | undefined, month: int): int {
    if (year != undefined) {
      return this.daysInMonth(year, month);
    }
    if (month == 1) {
      return 29;
    }

    return this.daysInMonth(2001, month);
  }

  private missingDay(year: int | undefined, month: int, day: int): string {
    const name = this.monthName(month);
    if (year == undefined) {
      const after = this.monthName((month + 1) % 12);
      const lack = `${name} has no day ${day}`;

      return `${lack}, and JavaScript would move on to ${after}`;
    }

    const carried = this.carriedDay(year, month, day);
    const lack = `${name} ${year} has no day ${day}`;
    const moved = `${this.monthName(carried.month)} ${carried.day}`;

    return `${lack}, and JavaScript would make it ${moved}`;
  }

  private carriedDay(year: int, month: int, day: int): CarriedDay {
    const cycles = (day - 1) / kDaysInCycle;
    let currentYear = year + cycles * kYearsInCycle;
    let currentMonth = month;
    let currentDay = day - cycles * kDaysInCycle;

    while (currentDay > this.daysInMonth(currentYear, currentMonth)) {
      currentDay -= this.daysInMonth(currentYear, currentMonth);
      currentMonth += 1;

      if (currentMonth == 12) {
        currentMonth = 0;
        currentYear += 1;
      }
    }

    return { month: currentMonth, day: currentDay };
  }

  private dateTextOf(expr: Expr): string | undefined {
    if (expr.kind == ExprKind.StringLit) {
      return expr.value;
    }
    if (expr.kind == ExprKind.Template && expr.exprs.length == 0) {
      return expr.quasis[0];
    }

    return undefined;
  }

  private dateTextCheck(expr: Expr, module: int): void {
    const text = this.dateTextOf(expr);
    if (text == undefined) {
      return;
    }

    const reader = new DateReader(text);
    const fields = reader.read();
    const loc = expr.loc;
    if (fields == undefined) {
      return this.report(module, loc, Code.DateTextUnreadable, { word: text });
    }
    if (fields.isDateOnly) {
      return this.report(module, loc, Code.DateTextNoTime, { word: text });
    }

    const day = fields.day;
    if (day.day > this.daysInMonth(day.year, day.month)) {
      const other = this.missingDay(day.year, day.month, day.day);

      return this.report(module, loc, Code.DateTextNoDay, {
        word: text,
        other,
      });
    }
    if (!this.isDateInRange(fields)) {
      this.report(module, loc, Code.DateTextOutside, { word: text });
    }
  }

  private isDateInRange(fields: DateFields): boolean {
    const day = fields.day;
    if (day.year < -kDateYearLimit || day.year > kDateYearLimit) {
      return false;
    }

    const time = fields.time;
    const clock =
      time.hour * kHourMilliseconds +
      time.minute * kMinuteMilliseconds +
      time.second * kSecondMilliseconds +
      time.millisecond;
    const local = this.daysFromEpoch(day) * kDayMilliseconds + clock;
    const zone = fields.zone;
    if (zone.isLocal) {
      return local >= -kDateLocalLimit && local <= kDateLocalLimit;
    }

    const value = local - zone.offset * kSecondMilliseconds;

    return value >= -kDateTimeLimit && value <= kDateTimeLimit;
  }

  private daysFromEpoch(day: DayValue): int {
    const shifted = day.year + kDateYearShift;
    const epoch = kEpochYear + kDateYearShift;
    const before = this.shiftedDays(shifted) - this.shiftedDays(epoch);
    const start = kMonthStarts[day.month] ?? 0;
    const isLeapShift = this.isLeapYear(day.year) && day.month >= 2;
    const leap = this.leapDay(isLeapShift);

    return before + start + leap - 1 + day.day;
  }

  private shiftedDays(shifted: int): int {
    return 365 * shifted + shifted / 4 - shifted / 100 + shifted / 400;
  }

  private leapDay(isLeap: boolean): int {
    if (isLeap) {
      return 1;
    }

    return 0;
  }
}
