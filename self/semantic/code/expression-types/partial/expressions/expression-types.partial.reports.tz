import { Code } from "../../../../../diagnostic/code.tz";
import {
  Details,
  SourceError,
} from "../../../../../diagnostic/types/message.types.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../expression-types.tz";

partial class ExpressionTypes {
  public readonly problems(module: int): SourceError[] {
    return this.errors.of(module);
  }

  private moduleChecksDone(module: int): void {
    this.unreadResultsCheck(module);
    this.pendingCallsCheck(module);
    this.reflectedNewsCheck(module);
    this.unheardErrorsCheck(module);
    this.unemittedListensCheck(module);
    this.droppedNewsCheck(module);
  }

  public variable(module: int, loc: int): Type {
    const door = this.door(module, loc);
    if (door == undefined) {
      return this.store.plain(TypeKind.Error);
    }

    return door.type;
  }

  private readonly reportFound(module: int, error: SourceError | undefined): void {
    if (error != undefined) {
      this.report(module, error.loc, error.code, error.details);
    }
  }

  private readonly reportAll(module: int, errors: Read<SourceError[]>): void {
    for (const error of errors) {
      this.report(module, error.loc, error.code, error.details);
    }
  }

  private readonly report(module: int, loc: int, code: Code, details: Details): void {
    const record = this.record(module);
    const isQuiet =
      this.modules.isTypedLibrary(module) &&
      !this.modules.isCheckedLibrary(module);
    if (record == undefined || isQuiet) {
      return;
    }

    this.errors.write(module, loc, code, details);
  }
}
