import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { AwaitExpr } from "../../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../../program/ast/types/ast.types.functions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  kAsyncArrow,
  kAsyncFunction,
  kAsyncMethodEnd,
  kAsyncWord,
} from "../../const/expression-types.const.tz";

partial class ExpressionTypes {
  private awaitTyped(expr: AwaitExpr, module: int): Type {
    this.awaitPlaceCheck(expr, module);

    const value = this.typed(expr.value, undefined, module);
    if (value.kind == TypeKind.Promise) {
      return value.value;
    }

    const parts = this.generics.partsOfType(value);
    const hasPromise = parts.some((part) => part.kind == TypeKind.Promise);
    if (hasPromise) {
      return this.store.plain(TypeKind.Error);
    }

    return value;
  }

  private awaitPlaceCheck(expr: AwaitExpr, module: int): void {
    const fn = this.openFunctions[this.openFunctions.length - 1];
    if (fn == undefined || fn.isAsync) {
      return;
    }

    const word = this.asyncHint(fn);

    this.report(module, expr.loc, Code.AwaitOutsideAsync, { word });
  }

  private asyncHint(fn: FunctionDecl): string {
    if (fn.role != undefined) {
      return `${kAsyncWord}${fn.name}${kAsyncMethodEnd}`;
    }
    if (fn.isArrow) {
      return kAsyncArrow;
    }

    return `${kAsyncFunction}${fn.name}`;
  }
}
