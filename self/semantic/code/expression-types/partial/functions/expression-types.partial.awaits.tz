import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { AwaitExpr } from "../../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../../program/ast/types/ast.types.functions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  kAsyncArrow,
  kAsyncFunction,
  kAsyncMethodEnd,
  kAsyncWord,
} from "../../const/expression-types.const.tz";

partial class ExpressionTypes {
  private awaitTyped(expr: AwaitExpr, module: int): Type {
    const tree = this.types.program.tree;

    this.awaitPlaceCheck(expr, module);

    const valueExpr = tree.exprOf(expr.valueId);
    const value = this.typed(valueExpr, undefined, module);

    this.forgetCallChanged(module);

    if (value.kind == TypeKind.Promise) {
      return this.types.store.valueOf(value);
    }

    const parts = this.types.partsOfType(value);
    const hasPromise = parts.some((part) => part.kind == TypeKind.Promise);
    if (!hasPromise) {
      return value;
    }

    const awaited = this.awaitedType(value);
    if (awaited == undefined) {
      const word = this.types.typeText(value);

      this.errors.write(
        module,
        tree.exprOf(expr.valueId).loc,
        Code.AwaitMixed,
        { word },
      );

      return this.types.store.plain(TypeKind.Error);
    }

    return awaited;
  }

  private awaitedType(type: Type): Type | undefined {
    const defined = this.types.definedType(type);
    const awaited = this.awaitedPlain(defined);
    if (awaited == undefined || !this.types.isOptional(type)) {
      return awaited;
    }
    if (awaited.kind == TypeKind.Void) {
      return awaited;
    }

    return this.types.optional(awaited);
  }

  private awaitedPlain(type: Type): Type | undefined {
    if (type.kind == TypeKind.Promise) {
      return this.types.store.valueOf(type);
    }
    if (type.kind != TypeKind.Union) {
      return type;
    }

    const hasPromise = this.types.store
      .partsOf(type)
      .some((part) => part.kind == TypeKind.Promise);
    if (!hasPromise) {
      return type;
    }

    let result: Type | undefined = undefined;

    for (const part of this.types.store.partsOf(type)) {
      const candidate = this.promisedOrSelf(part);
      const joined = this.joinedAwaited(result, candidate);
      if (joined == undefined || joined.kind == TypeKind.Error) {
        return undefined;
      }

      result = joined;
    }

    return result;
  }

  private readonly promisedOrSelf(type: Type): Type {
    if (type.kind == TypeKind.Promise) {
      return this.types.store.valueOf(type);
    }

    return type;
  }

  private joinedAwaited(
    result: Type | undefined,
    candidate: Type,
  ): Type | undefined {
    if (result == undefined) {
      return candidate;
    }

    const isVoid =
      result.kind == TypeKind.Void || candidate.kind == TypeKind.Void;
    if (isVoid && result.id != candidate.id) {
      return undefined;
    }

    return this.types.unionUnify(result, candidate);
  }

  private awaitPlaceCheck(expr: AwaitExpr, module: int): void {
    const fn = this.openFunctions[this.openFunctions.length - 1];
    if (fn == undefined || fn.isAsync) {
      return;
    }

    const word = this.asyncHint(fn);

    this.errors.write(module, expr.loc, Code.AwaitOutsideAsync, { word });
  }

  private readonly asyncHint(fn: FunctionDecl): string {
    if (fn.role != undefined) {
      return `${kAsyncWord}${fn.name}${kAsyncMethodEnd}`;
    }
    if (fn.isArrow) {
      return kAsyncArrow;
    }

    return `${kAsyncFunction}${fn.name}`;
  }
}
