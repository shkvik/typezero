import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { FunctionExpr } from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  FunctionDecl,
  Param,
  ParamKind,
} from "../../../../../program/ast/types/ast.types.functions.tz";
import {
  FunctionParameter,
  FunctionType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { kThisParameter } from "../../../../types/type-resolver/const/type-resolver.const.tables.tz";
import {
  TypeContext,
  TypePlace,
} from "../../../../types/type-resolver/types/type-resolver.types.tz";
import { ParameterShape } from "../../types/expression-types.types.tz";
import { kDot } from "../../../source-texts/const/source-texts.const.tz";
import { kZeroTerm } from "../../../../flow/bound-rules/const/bound-rules.const.tz";
import { kValueTerm } from "../../const/expression-types.const.tz";

partial class ExpressionTypes {
  private closureTyped(
    expr: FunctionExpr,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const fn = tree.functionOf(expr.fnId);
    const isPlain =
      tree.typeParamsOf(fn.typeParamsList).length == 0 && !fn.isGenerator;
    if (!isPlain || tree.blockAt(fn.bodyId) == undefined) {
      return this.types.store.plain(TypeKind.Error);
    }

    const goal = this.types.contextualFunction(wanted);
    const context: TypeContext = {
      module,
      bindings: new Map<int, Type>(),
      place: TypePlace.Plain,
    };
    const before = this.factsCopy();
    const shape = this.closureShape(fn, goal, context, module);
    if (this.types.isParameterClash(shape, goal)) {
      return this.types.store.plain(TypeKind.Error);
    }

    const isInitClosure = this.isInitClosure();

    this.enterInitClosure(isInitClosure);
    this.facts = this.constFacts(before);

    const owner = shape.self ?? this.literalOwners.get(fn.id);
    const place = this.types.functionPlace(fn, owner);

    if (place != undefined) {
      this.thisPlaces.push(place);
    }
    if (owner != undefined) {
      this.selves.push(owner);
    }

    this.openFunctions.push(fn);

    const result = this.closureResult(fn, goal, context, module);

    this.openFunctions.pop();
    this.leaveInitClosure(isInitClosure);

    if (owner != undefined) {
      this.selves.pop();
    }
    if (place != undefined) {
      this.thisPlaces.pop();
    }

    this.facts = before;

    const params = this.types.adaptedParams(shape.params, goal);
    const rest = shape.rest;
    const self = shape.self ?? this.types.store.selfTypeOf(goal);
    const isBroken = params.some((param) => param.type.kind == TypeKind.Error);
    if (isBroken) {
      return this.types.store.plain(TypeKind.Error);
    }

    const made = this.types.store.functionOf({ params, rest, self, result });

    this.closureTypes.set(expr.id, made);

    return made;
  }

  private closureShape(
    fn: FunctionDecl,
    goal: FunctionType | undefined,
    context: Read<TypeContext>,
    module: int,
  ): ParameterShape {
    const tree = this.types.program.tree;

    const params: FunctionParameter[] = [];
    let self: Type | undefined = undefined;
    let rest = false;
    let index = 0;

    for (const param of tree.paramsOf(fn.paramsList)) {
      const kind = param.form.kind;
      const given = this.closureGiven(
        goal,
        index,
        param.name == kThisParameter,
      );
      const type = this.closureParameter(param, given, context, module);
      const isTaken =
        tree.typeRefAt(param.typeId) == undefined &&
        kind == ParamKind.Required &&
        given != undefined &&
        given.optional;
      const inside = this.closureInside(type, kind, isTaken);

      this.paramTypes.set(`${module} ${param.loc}`, inside);

      if (param.name == kThisParameter) {
        const thisParameterErrors = this.types.thisParameterCheck(fn, param);

        this.errors.writeAll(module, thisParameterErrors);
        self = type;

        continue;
      }

      const optional =
        kind == ParamKind.Optional || kind == ParamKind.Defaulted || isTaken;

      rest = rest || kind == ParamKind.Rest;
      params.push({ type, optional });
      index += 1;
    }

    return { params, rest, self };
  }

  private readonly closureGiven(
    goal: FunctionType | undefined,
    index: int,
    isThis: boolean,
  ): FunctionParameter | undefined {
    if (!isThis) {
      return this.types.store.paramsOf(goal)[index];
    }

    const self = this.types.store.selfTypeOf(goal);
    if (self == undefined) {
      return undefined;
    }

    return { type: self, optional: false };
  }

  private closureInside(type: Type, kind: ParamKind, isTaken: boolean): Type {
    if (isTaken) {
      return this.types.optional(type);
    }

    return this.types.insideType(type, kind);
  }

  private closureParameter(
    param: Param,
    given: FunctionParameter | undefined,
    context: Read<TypeContext>,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const isWritten =
      tree.typeRefAt(param.typeId) != undefined ||
      param.form.kind == ParamKind.Defaulted;
    if (isWritten) {
      const type = this.parameterOf(param, context, module);

      return this.checkedParameter(param, type, given, module);
    }
    if (given != undefined) {
      return given.type;
    }

    this.errors.write(module, param.loc, Code.ClosureParameterNeedsType, {
      word: param.name,
    });

    return this.types.store.plain(TypeKind.Error);
  }

  private checkedParameter(
    param: Param,
    type: Type,
    given: FunctionParameter | undefined,
    module: int,
  ): Type {
    const checked = this.types.checkedParameter(param, type, given);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private closureResult(
    fn: FunctionDecl,
    goal: FunctionType | undefined,
    context: Read<TypeContext>,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const written = tree.typeRefAt(fn.returnTypeId);
    if (written != undefined) {
      const result = this.types.returnType(written, context);

      this.walkWritten(fn, result, module);

      return result;
    }

    if (goal == undefined) {
      return this.inferredClosure(fn, false, module);
    }

    const expected = this.types.store.returnTypeOf(goal);
    if (expected.kind == TypeKind.Void) {
      this.inferredClosure(fn, true, module);

      return expected;
    }
    if (expected.kind == TypeKind.Error) {
      return this.inferredClosure(fn, false, module);
    }
    if (fn.isAsync && !this.isPromising(expected)) {
      return this.inferredClosure(fn, false, module);
    }

    this.walkWritten(fn, expected, module);

    return expected;
  }

  private readonly isPromising(type: Type): boolean {
    if (type.kind == TypeKind.Union) {
      return this.types.store
        .partsOf(type)
        .some((part) => part.kind == TypeKind.Promise);
    }

    return type.kind == TypeKind.Promise;
  }

  private inferredClosure(
    fn: FunctionDecl,
    isQuiet: boolean,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const frame = this.types.frameOf(fn, undefined);
    const body = tree.stmtsOf(tree.blockAt(fn.bodyId)?.bodyList) ?? [];

    this.walkStatements(body, frame, module);

    if (isQuiet) {
      return this.quietResult(fn, frame, module);
    }

    return this.frameResult(fn, frame, module);
  }

  private readonly constFacts(
    facts: Read<Map<string, Type>>,
  ): Map<string, Type> {
    const kept = new Map<string, Type>();

    for (const [key, type] of facts) {
      if (this.isConstPath(key) || this.isConstBound(key)) {
        kept.set(key, type);
      }
    }

    return kept;
  }

  private readonly isConstBound(key: string): boolean {
    const edge = this.types.edgeOf(key);
    if (edge == undefined) {
      return false;
    }

    return this.isConstTerm(edge.upper) && this.isConstTerm(edge.lower);
  }

  private readonly isConstTerm(term: string): boolean {
    if (term == kZeroTerm) {
      return true;
    }
    if (!term.startsWith(kValueTerm)) {
      return false;
    }

    return this.constKeys.has(term.slice(kValueTerm.length));
  }

  private readonly isConstPath(key: string): boolean {
    const dot = key.indexOf(kDot);
    const root = this.types.rootOf(key, dot);

    return this.constKeys.has(root);
  }
}
