import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { messageText } from "../../../../../diagnostic/message.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  YieldExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../../program/ast/types/ast.types.functions.tz";
import {
  IteratorShape,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  kArrayClass,
  kFlatMapName,
  kIteratorClass,
  kNoPlace,
  kUnsupportedMark,
} from "../../const/expression-types.const.tz";
import {
  FunctionFrame,
  GeneratorFrame,
} from "../../types/expression-types.types.tz";
import { kNextName } from "../../../index-rules/const/index-rules.const.tz";

partial class ExpressionTypes {
  private enterGenerator(
    frame: Read<FunctionFrame>,
    result: Type | undefined,
  ): void {
    const fn = frame.fn;
    if (fn == undefined || !fn.isGenerator) {
      return;
    }

    const generator = this.types.generatorFrameOf(fn, result);

    this.generatorFrames.push(generator);
  }

  private leaveGenerator(frame: FunctionFrame): void {
    const fn = frame.fn;
    if (fn == undefined || !fn.isGenerator) {
      return;
    }

    frame.generator = this.generatorFrames.pop();
  }

  private addYield(value: Expr, type: Type): void {
    const frame = this.generatorFrames[this.generatorFrames.length - 1];
    if (frame != undefined) {
      frame.yields.push({ value, type });
    }
  }

  private readonly sentOf(sent: Type | undefined): Type {
    if (sent == undefined) {
      return this.types.store.plain(TypeKind.Error);
    }

    return sent;
  }

  private iteratorCallCheck(
    member: MemberExpr,
    object: Type,
    module: int,
  ): boolean {
    const checked = this.types.iteratorCallCheck(member, object);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private iteratorMissingCheck(
    member: MemberExpr,
    object: Type,
    module: int,
  ): boolean {
    const checked = this.types.iteratorMissingCheck(member, object);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private readonly isOwnYield(): boolean {
    const frame = this.generatorFrames[this.generatorFrames.length - 1];
    const open = this.openFunctions[this.openFunctions.length - 1];

    return frame != undefined && open?.id == frame.fn.id;
  }

  private yieldTyped(expr: YieldExpr, module: int): Type {
    const tree = this.types.program.tree;

    const value = tree.exprAt(expr.valueId);
    if (!this.isOwnYield()) {
      return this.childrenTyped(expr, module);
    }

    const frame = this.generatorFrames[this.generatorFrames.length - 1];
    if (frame == undefined) {
      return this.childrenTyped(expr, module);
    }

    const fn = frame.fn;
    const yielded = frame.yielded;
    const sent = frame.sent;

    if (expr.delegate) {
      return this.delegateTyped(value, module);
    }

    const given = this.yieldValue(fn, yielded, value, module);

    if (value != undefined) {
      this.yieldOf.set(value.id, expr.loc);
    }

    if (!this.unusedYields.has(expr.id) && sent == undefined) {
      this.errors.write(module, expr.loc, Code.YieldSentUnknown, {
        word: this.types.typeText(this.types.widened(given)),
      });
    }

    if (value != undefined) {
      this.addYield(value, given);
    }

    return this.sentOf(sent);
  }

  private yieldValue(
    fn: FunctionDecl,
    yielded: Type | undefined,
    value: Expr | undefined,
    module: int,
  ): Type {
    if (value == undefined) {
      return this.types.store.plain(TypeKind.Undefined);
    }

    const promised = this.asyncYieldValue(fn, yielded, value, module);
    if (promised != undefined) {
      return promised;
    }
    if (yielded == undefined) {
      return this.typed(value, undefined, module);
    }

    return this.checked(value, yielded, module, kNoPlace);
  }

  private asyncYieldValue(
    fn: FunctionDecl,
    yielded: Type | undefined,
    value: Expr,
    module: int,
  ): Type | undefined {
    if (!fn.isAsync) {
      return undefined;
    }

    const peeked = this.peekType(value, module);
    const parts = this.types.partsOfType(peeked);
    if (!parts.some((part) => part.kind == TypeKind.Promise)) {
      return undefined;
    }

    const given = this.typed(value, undefined, module);
    const awaited = this.awaitedType(given);
    if (awaited == undefined) {
      const word = this.types.typeText(given);

      this.errors.write(module, value.loc, Code.YieldPromiseMixed, { word });

      return this.types.store.plain(TypeKind.Error);
    }

    this.yieldPromiseCheck(fn, value, awaited, yielded, module);

    return awaited;
  }

  private yieldPromiseCheck(
    fn: FunctionDecl,
    value: Expr,
    awaited: Type,
    yielded: Type | undefined,
    module: int,
  ): void {
    if (yielded == undefined || awaited.kind == TypeKind.Error) {
      return;
    }
    if (this.types.converts(awaited, yielded)) {
      return;
    }

    this.errors.write(module, value.loc, Code.YieldPromiseOther, {
      word: this.types.typeText(awaited),
      first: this.types.functionName(fn),
      other: this.types.typeText(yielded),
    });
  }

  private delegateTyped(value: Expr | undefined, module: int): Type {
    const error = this.types.store.plain(TypeKind.Error);

    if (value == undefined) {
      return error;
    }

    const type = this.typed(value, undefined, module);
    const item = this.delegatedItem(value, type, module);

    this.addYield(value, item);

    return error;
  }

  private delegatedItem(value: Expr, type: Type, module: int): Type {
    const checked = this.types.delegatedItem(value, type);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private generatorResult(
    fn: FunctionDecl,
    frame: Read<FunctionFrame>,
    generator: Read<GeneratorFrame>,
    module: int,
  ): Type {
    const written = generator.yields.slice();
    const yields = written.filter((one) => one.type.kind != TypeKind.Error);
    if (written.length > 0 && yields.length == 0) {
      return this.types.store.plain(TypeKind.Error);
    }
    if (yields.length == 0) {
      const word = this.types.functionName(fn);

      this.errors.write(module, fn.loc, Code.GeneratorNoYield, { word });

      return this.types.store.plain(TypeKind.Error);
    }

    const yielded = this.joinedReturns(fn, yields, module, Code.YieldsDiffer);
    if (yielded == undefined || yielded.kind == TypeKind.Error) {
      return this.types.store.plain(TypeKind.Error);
    }

    const returned = this.generatorReturned(fn, frame, module);
    const nothing = this.types.store.plain(TypeKind.Void);
    const shape: IteratorShape = {
      yielded: this.types.widened(yielded),
      returned,
      sent: nothing,
      async: fn.isAsync,
    };

    return this.types.store.iteratorOf(shape);
  }

  private generatorReturned(
    fn: FunctionDecl,
    frame: Read<FunctionFrame>,
    module: int,
  ): Type {
    const valued = frame.returns.filter(
      (one) => !this.types.isVoided(one.value),
    );
    if (valued.length == 0) {
      return this.types.store.plain(TypeKind.Void);
    }

    const joined = this.joinedReturns(fn, valued, module, Code.ReturnsDiffer);

    return this.types.widened(joined);
  }

  private nextUnionCheck(member: MemberExpr, object: Type, module: int): void {
    if (object.kind != TypeKind.Iterator || member.name != kNextName) {
      return;
    }

    const shape = this.types.store.iteratorShapeOf(object);
    const returned = shape.returned;
    const isPlain =
      returned.kind == TypeKind.Void ||
      returned.kind == TypeKind.Undefined ||
      returned.kind == TypeKind.Error;
    if (isPlain) {
      return;
    }

    const joined = this.types.store.unionOf([shape.yielded, returned]);
    const problem = this.types.unionProblem(joined);
    if (problem == undefined) {
      return;
    }

    const full = messageText(problem.code, problem.details);
    const mark = full.indexOf(kUnsupportedMark);
    const other = full.slice(mark + kUnsupportedMark.length);

    this.errors.write(module, member.loc, Code.NextNoUnion, {
      word: this.types.typeText(object),
      first: this.types.typeText(shape.yielded),
      second: this.types.typeText(returned),
      other,
    });
  }

  private flatMapResultCheck(
    expr: CallExpr,
    member: MemberExpr,
    object: Type,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const callback = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    const isFlat =
      object.kind == TypeKind.Iterator && member.name == kFlatMapName;
    if (
      !isFlat ||
      callback == undefined ||
      callback.kind != ExprKind.Function
    ) {
      return;
    }
    if (object.kind != TypeKind.Iterator) {
      return;
    }

    const params = [
      {
        type: this.types.store.iteratorShapeOf(object).yielded,
        optional: false,
      },
    ];
    const result = this.types.store.plain(TypeKind.Error);
    const wanted = this.types.store.functionOf({ params, rest: false, result });

    this.errors.beginTrial();

    const typed = this.typed(callback, wanted, module);

    this.errors.endTrial();

    if (typed.kind != TypeKind.Function) {
      return;
    }

    const given = this.types.apparent(this.types.store.returnTypeOf(typed));
    const isFlattened =
      given.kind == TypeKind.Array ||
      given.kind == TypeKind.Iterator ||
      given.kind == TypeKind.Error;
    if (isFlattened) {
      return;
    }

    this.errors.write(module, callback.loc, Code.FlatMapResult, {
      word: this.types.typeText(given),
    });
  }

  private staticSourceCheck(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const object = tree.exprOf(member.objectId);
    if (object.kind != ExprKind.Name || !this.isGlobalUse(object, module)) {
      return false;
    }
    if (object.name == kArrayClass && member.name == "of") {
      this.errors.write(module, member.loc, Code.ArrayStaticRefused, {
        word: member.name,
      });
      const args = tree.argumentsOf(expr.argsList);

      this.looseArguments(args, module);

      return true;
    }
    if (object.name != kIteratorClass || member.name != "from") {
      return false;
    }

    return this.iteratorSourceCheck(expr, module);
  }

  private iteratorSourceCheck(expr: CallExpr, module: int): boolean {
    const tree = this.types.program.tree;

    const arg = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (arg == undefined) {
      return false;
    }

    const type = this.peekType(arg, module);

    const base = this.types.apparent(type);

    switch (base.kind) {
      case TypeKind.Array:
      case TypeKind.String:
      case TypeKind.Template:
      case TypeKind.Iterator:
      case TypeKind.Error:
      case TypeKind.Dict:
      case TypeKind.Instance:
      case TypeKind.Object:
      case TypeKind.TypeParameter:
        return false;
      default:
        this.errors.write(module, arg.loc, Code.IteratorFromSource, {
          word: this.types.typeText(type),
        });

        return true;
    }
  }
}
