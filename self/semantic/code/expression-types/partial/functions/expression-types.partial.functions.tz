import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import { MethodKind } from "../../../../../program/ast/types/ast.types.classes.tz";
import {
  BodySource,
  FunctionDecl,
  Param,
  ParamKind,
} from "../../../../../program/ast/types/ast.types.functions.tz";
import {
  FunctionParameter,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { kThisParameter } from "../../../../types/type-resolver/const/type-resolver.const.tables.tz";
import {
  DoorState,
  ParameterSite,
  TypeContext,
  TypePlace,
} from "../../../../types/type-resolver/types/type-resolver.types.tz";
import {
  kInferenceRounds,
  kNoPlace,
} from "../../const/expression-types.const.tz";
import {
  FunctionDoor,
  FunctionFrame,
  ParameterShape,
  ReturnedValue,
} from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  public functionOf(module: int, loc: int): Type {
    return this.functionAt(module, loc);
  }

  private functionAt(module: int, loc: int): Type {
    const fn = this.record(module)?.functions.get(loc);
    if (fn == undefined) {
      return this.store.plain(TypeKind.Error);
    }

    return this.functionType(fn, module);
  }

  private functionType(fn: FunctionDecl, module: int): Type {
    const key = `${module} ${fn.loc}`;
    const known = this.functionDoors.get(key);
    if (known != undefined) {
      return known.type;
    }

    const door: FunctionDoor = {
      state: DoorState.InWork,
      type: this.store.plain(TypeKind.Error),
      isAssumed: false,
    };

    const before = this.facts;
    const owned = this.errors.mark();

    this.facts = new Map<string, Type>();
    this.functionDoors.set(key, door);
    this.functionOrder.push(key);
    this.walking.push(key);
    this.openFunction(door, fn, module);
    this.errors.keepSince(owned);
    this.walking.pop();
    this.facts = before;
    door.state = DoorState.Done;

    return door.type;
  }

  private openFunction(
    door: FunctionDoor,
    fn: FunctionDecl,
    module: int,
  ): void {
    const context: TypeContext = {
      module,
      bindings: new Map<int, Type>(),
      place: TypePlace.Plain,
    };

    this.resolver.typeParameters(module, fn.typeParams);
    this.captureRequirements(fn, module);
    this.iterablePlaceCheck(fn, module);
    this.constructorArgsCheck(fn, module);
    const parameterPlaceErrors = this.decorators.parameterPlaceCheck(fn);

    this.reportAll(module, parameterPlaceErrors);

    const shape = this.parameterShape(fn, context, module);

    this.foreignCheck(fn, shape, context, module);

    const self = shape.self ?? this.literalOwners.get(fn);
    const place = this.functions.functionPlace(fn, self);

    if (self != undefined) {
      this.selves.push(self);
    }
    if (place != undefined) {
      this.thisPlaces.push(place);
    }

    this.openFunctions.push(fn);
    this.openBody(door, fn, shape, context, module);
    this.openFunctions.pop();

    if (place != undefined) {
      this.thisPlaces.pop();
    }
    if (self != undefined) {
      this.selves.pop();
    }
  }

  private openBody(
    door: FunctionDoor,
    fn: FunctionDecl,
    shape: ParameterShape,
    context: TypeContext,
    module: int,
  ): void {
    const written = fn.returnType;

    if (written != undefined) {
      const result = this.resolver.returnType(written, context);

      const asyncResultError = this.functions.asyncResultCheck(
        fn,
        written,
        result,
      );

      this.reportFound(module, asyncResultError);
      this.predicateDeclCheck(fn, written, module);

      door.type = this.functions.signatureOf(shape, result);

      return this.walkWritten(fn, result, module);
    }

    const inherited = this.inheritedResult(fn, module);
    if (inherited != undefined) {
      door.type = this.functions.signatureOf(shape, inherited);

      return this.walkWritten(fn, inherited, module);
    }

    this.inferRounds(door, fn, shape, module);
  }

  private inferRounds(
    door: FunctionDoor,
    fn: FunctionDecl,
    shape: ParameterShape,
    module: int,
  ): void {
    const key = `${module} ${fn.loc}`;
    let assumed: Type | undefined = undefined;

    for (let round = 1; round <= kInferenceRounds; round++) {
      const doors = this.doorOrder.length;
      const functions = this.functionOrder.length;
      const pending = this.recursions.length;
      const used = this.assumedCalls.length;
      const frame = this.inferredFrame(fn, module);
      if (frame == undefined) {
        const unknown = this.store.plain(TypeKind.Error);

        door.type = this.functions.signatureOf(shape, unknown);

        return;
      }

      const hits = this.recursions.slice(pending);
      const uses = this.assumedCalls.slice(used);
      const isOwn = hits.includes(key) || uses.includes(key);
      if (!isOwn && hits.length > 0) {
        const found = this.quietResult(fn, frame, module);

        this.stall(fn, frame, hits, module);
        door.type = this.functions.signatureOf(shape, found);

        return;
      }

      const found = this.cycleResult(fn, frame, isOwn, assumed, module);
      const next = this.functions.widenedResult(assumed, found);
      if (isOwn && assumed != undefined && next.kind == TypeKind.Error) {
        const word = this.functions.functionName(fn);

        this.report(module, fn.loc, Code.ReturnsCycleDiffer, { word });
        door.type = this.functions.signatureOf(shape, next);

        return;
      }

      const isLast = round == kInferenceRounds || next.kind == TypeKind.Error;
      if (!isOwn || next == assumed || isLast) {
        const result = this.frameResult(fn, frame, module);

        door.type = this.functions.signatureOf(shape, result);

        return;
      }

      assumed = next;
      door.type = this.functions.signatureOf(shape, next);
      door.isAssumed = true;
      this.forgetSince(doors, functions);
    }
  }

  private stall(
    fn: FunctionDecl,
    frame: FunctionFrame,
    hits: string[],
    module: int,
  ): void {
    const isValued = frame.returns.some(
      (one) => !this.functions.isVoided(one.value),
    );
    if (isValued || frame.recursive.length == 0) {
      return;
    }

    for (const hit of hits) {
      const list = this.stalled.get(hit) ?? [];

      list.push({ fn, module });
      this.stalled.set(hit, list);
    }
  }

  private forgetSince(doors: int, functions: int): void {
    for (const key of this.doorOrder.slice(doors)) {
      this.doors.delete(key);
    }

    for (const key of this.functionOrder.slice(functions)) {
      this.functionDoors.delete(key);
    }
  }

  private cycleResult(
    fn: FunctionDecl,
    frame: FunctionFrame,
    isOwn: boolean,
    assumed: Type | undefined,
    module: int,
  ): Type {
    const found = this.quietResult(fn, frame, module);
    if (!isOwn || assumed != undefined || found.kind != TypeKind.Error) {
      return found;
    }

    const known = frame.returns.filter(
      (one) =>
        !this.functions.isVoided(one.value) && one.type.kind != TypeKind.Error,
    );
    if (known.length == 0 || known.length == frame.returns.length) {
      return found;
    }

    this.errors.beginTrial();

    const joined = this.joinedReturns(fn, known, module);

    this.errors.endTrial();

    return joined ?? found;
  }

  private quietResult(
    fn: FunctionDecl,
    frame: FunctionFrame,
    module: int,
  ): Type {
    this.errors.beginTrial();

    const result = this.frameResult(fn, frame, module);

    this.errors.endTrial();

    return result;
  }

  private usedFunction(module: int, loc: int): Type {
    const fn = this.record(module)?.functions.get(loc);
    const type = this.functionAt(module, loc);

    if (fn == undefined || fn.typeParams.length > 0) {
      return this.store.plain(TypeKind.Error);
    }
    if (type.kind != TypeKind.Function) {
      return type;
    }

    const shape = type.shape;
    const isBroken =
      shape.result.kind == TypeKind.Error ||
      shape.params.some((param) => param.type.kind == TypeKind.Error);
    if (isBroken) {
      return this.store.plain(TypeKind.Error);
    }

    return type;
  }

  private parameterShape(
    fn: FunctionDecl,
    context: TypeContext,
    module: int,
  ): ParameterShape {
    const params: FunctionParameter[] = [];
    let self: Type | undefined = undefined;
    let rest = false;
    let isAfterOptional = false;

    for (const param of fn.params) {
      const kind = param.form.kind;
      const type = this.methodParameter(fn, param, context, module);
      const inside = this.functions.insideType(type, kind);

      this.paramTypes.set(`${module} ${param.loc}`, inside);

      if (param.name == kThisParameter) {
        const thisParameterErrors = this.calls.thisParameterCheck(fn, param);

        this.reportAll(module, thisParameterErrors);
        self = type;

        continue;
      }
      if (kind == ParamKind.Required && isAfterOptional) {
        this.report(module, param.loc, Code.RequiredAfterOptional, kNoDetails);
      }

      const optional =
        kind == ParamKind.Optional || kind == ParamKind.Defaulted;

      isAfterOptional = isAfterOptional || kind == ParamKind.Optional;
      rest = rest || kind == ParamKind.Rest;
      params.push({ type, optional });
    }

    return { params, rest, self };
  }

  private parameterOf(param: Param, context: TypeContext, module: int): Type {
    const written = param.type;
    const form = param.form;
    const word = param.name;

    if (written != undefined) {
      const site: ParameterSite = {
        name: word,
        loc: param.loc,
        kind: form.kind,
        type: written,
        isDeclared: true,
      };
      const type = this.resolver.parameterType(site, context);
      if (form.kind == ParamKind.Defaulted && type.kind != TypeKind.Error) {
        this.checked(form.defaultValue, type, module, kNoPlace);
      }

      return type;
    }
    if (form.kind != ParamKind.Defaulted) {
      this.report(module, param.loc, Code.ParameterNeedsType, {
        word: this.sources.parameterText(param, module),
      });

      return this.store.plain(TypeKind.Error);
    }
    if (!this.shapes.isPlainLiteral(form.defaultValue)) {
      this.report(module, param.loc, Code.DefaultNeedsType, { word });

      return this.store.plain(TypeKind.Error);
    }

    return this.typed(form.defaultValue, undefined, module);
  }

  private methodParameter(
    fn: FunctionDecl,
    param: Param,
    context: TypeContext,
    module: int,
  ): Type {
    const isOpen =
      param.type == undefined &&
      param.form.kind != ParamKind.Defaulted &&
      fn.role != undefined &&
      this.isExtending();
    if (isOpen || this.isLibraryOverride(fn)) {
      return this.store.plain(TypeKind.Error);
    }

    return this.parameterOf(param, context, module);
  }

  private isLibraryOverride(fn: FunctionDecl): boolean {
    const current = this.ownerClasses[this.ownerClasses.length - 1];
    if (current == undefined || fn.role == undefined) {
      return false;
    }

    const decl = current.decl;
    if (decl.base == undefined || decl.typeParams.length > 0) {
      return false;
    }

    const self = this.resolver.classInstance(current.module, decl, []);
    if (self.kind != TypeKind.Instance) {
      return false;
    }

    const parent = this.classes.parentOf(self, decl);
    if (parent == undefined || !this.modules.isLibraryModule(parent.module)) {
      return false;
    }

    const owner = this.record(parent.module)?.classes.get(parent.loc);
    const isOwn = owner?.methods.some((one) => one.name == fn.name) == true;

    return isOwn || this.receiverMember(parent, fn.name, true) != undefined;
  }

  private isExtending(): boolean {
    const current = this.ownerClasses[this.ownerClasses.length - 1];

    return current != undefined && current.decl.base != undefined;
  }

  private isBodyWalked(fn: FunctionDecl, module: int): boolean {
    const opened = this.program.modules[module];
    if (opened == undefined) {
      return false;
    }
    if (opened.source.isLibrary && !this.modules.isTypedLibrary(module)) {
      return false;
    }
    if (fn.role?.method == MethodKind.Abstract) {
      return false;
    }

    return fn.body != undefined && fn.bodySource == BodySource.Written;
  }

  private walkWritten(fn: FunctionDecl, result: Type, module: int): void {
    const body = fn.body;
    if (body == undefined || !this.isBodyWalked(fn, module)) {
      return;
    }
    if (this.functions.isAssertion(fn)) {
      return;
    }

    const inner = this.functions.innerResult(result, fn);
    const frame = this.functions.frameOf(fn, inner);

    this.enterGenerator(frame, result);
    this.initStart(fn);
    this.walkStatements(body.body, frame, module);
    this.initEnd(fn, body, module);
    this.leaveGenerator(frame);
    this.rememberGuard(fn, frame, module);
    const writtenResultError = this.functions.writtenResultCheck(
      fn,
      result,
      frame,
    );

    this.reportFound(module, writtenResultError);

    const isOpen =
      inner.kind == TypeKind.Void ||
      inner.kind == TypeKind.Error ||
      inner.kind == TypeKind.Unknown ||
      inner.kind == TypeKind.Undefined ||
      this.types.isOptional(inner);
    if (isOpen || this.isAlwaysReturning(body, module)) {
      return;
    }

    const word = this.functions.functionLabel(fn);
    const first = this.text.of(inner);

    this.report(module, fn.loc, Code.ReturnOnEveryPath, { word, first });
  }

  private inferredFrame(
    fn: FunctionDecl,
    module: int,
  ): FunctionFrame | undefined {
    const body = fn.body;
    if (body == undefined || !this.isBodyWalked(fn, module)) {
      return undefined;
    }

    const frame = this.functions.frameOf(fn, undefined);

    this.facts = new Map<string, Type>();
    this.enterGenerator(frame, undefined);
    this.initStart(fn);
    this.walkStatements(body.body, frame, module);
    this.initEnd(fn, body, module);
    this.leaveGenerator(frame);
    this.rememberGuard(fn, frame, module);

    return frame;
  }

  private frameResult(
    fn: FunctionDecl,
    frame: FunctionFrame,
    module: int,
  ): Type {
    const generator = frame.generator;
    if (generator != undefined) {
      return this.generatorResult(fn, frame, generator, module);
    }
    if (fn.isGenerator) {
      return this.store.plain(TypeKind.Error);
    }

    const value = this.commonResult(fn, frame, module);
    if (!fn.isAsync || value.kind == TypeKind.Error) {
      return value;
    }

    return this.store.promiseOf(value);
  }

  private commonResult(
    fn: FunctionDecl,
    frame: FunctionFrame,
    module: int,
  ): Type {
    const returns = frame.returns;
    const isValued = returns.some((one) => !this.functions.isVoided(one.value));
    if (!isValued && frame.recursive.length > 0) {
      return this.reportRecursive(fn, frame, module);
    }
    if (!isValued) {
      return this.store.plain(TypeKind.Void);
    }

    const isUnknown = returns.some((one) => one.type.kind == TypeKind.Error);
    if (isUnknown) {
      return this.store.plain(TypeKind.Error);
    }

    const common = this.joinedReturns(fn, returns, module);
    if (common != undefined && common.kind == TypeKind.Error) {
      return common;
    }

    const isFallingOff = !this.isAlwaysReturning(fn.body, module);
    const isUndefined =
      isFallingOff ||
      frame.hasEmptyReturn ||
      returns.some((one) => one.type.kind == TypeKind.Undefined);
    if (common != undefined && isUndefined && common.kind != TypeKind.Void) {
      return this.types.optional(common);
    }
    if (common != undefined) {
      return common;
    }

    const word = this.functions.functionName(fn);

    this.report(module, fn.loc, Code.ReturnsOnlyUndefined, { word });

    return this.store.plain(TypeKind.Error);
  }

  private reportRecursive(
    fn: FunctionDecl,
    frame: FunctionFrame,
    module: int,
  ): Type {
    const key = `${module} ${fn.loc}`;
    const word = this.functions.functionName(fn);
    const isSelfOnly =
      !this.calledBack.has(key) && frame.recursive.every((call) => call == key);

    if (isSelfOnly) {
      this.report(module, fn.loc, Code.ReturnsOnlySelfCalls, { word });
    } else {
      this.report(module, fn.loc, Code.ReturnsOnlyCalledBack, { word });
    }

    for (const one of this.stalled.get(key) ?? []) {
      const other = this.functions.functionName(one.fn);

      this.report(one.module, one.fn.loc, Code.ReturnsOnlyCalledBack, {
        word: other,
      });
    }

    return this.store.plain(TypeKind.Error);
  }

  private joinedReturns(
    fn: FunctionDecl,
    returns: ReturnedValue[],
    module: int,
    code: Code = Code.ReturnsDiffer,
  ): Type | undefined {
    const ordered = this.literalsLast(returns, module);
    let common: Type | undefined = undefined;

    for (const one of ordered) {
      if (common == undefined) {
        common = one.type;

        continue;
      }

      const adapted = this.literalTarget(one.value, one.type, common, module);
      if (one.type != common && adapted != undefined) {
        continue;
      }

      const joined = this.unifier.unionUnify(common, one.type);
      if (joined == undefined || joined.kind == TypeKind.Error) {
        const word = this.functions.functionName(fn);
        const first = this.text.of(one.type);
        const second = this.text.of(common);

        const at = this.yieldOf.get(one.value) ?? one.value.loc;

        this.report(module, at, code, { word, first, second });

        return this.store.plain(TypeKind.Error);
      }

      common = joined;
    }

    return common;
  }

  private literalsLast(returns: ReturnedValue[], module: int): ReturnedValue[] {
    const typed = returns.filter((one) => one.type.kind != TypeKind.Undefined);
    const plain = typed.filter((one) => !this.isWholeReturn(one, module));
    const wholes = typed.filter((one) => this.isWholeReturn(one, module));

    return plain.concat(wholes);
  }

  private isWholeReturn(one: ReturnedValue, module: int): boolean {
    return one.type.kind == TypeKind.Int && this.isWholeTree(one.value, module);
  }
}
