import { replace } from "tz:mem";
import { ExpressionTypes } from "../../expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  FunctionDecl,
  Param,
  ParamKind,
} from "../../../../../program/ast/types/ast.types.functions.tz";
import {
  FunctionParameter,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  kThisParameter,
} from "../../../../types/type-resolver/const/type-resolver.const.tables.tz";
import {
  DoorState,
  ParameterSite,
  TypeContext,
  TypePlace,
} from "../../../../types/type-resolver/types/type-resolver.types.tz";
import {
  kNoPlace,
  kUnsafeMemory,
  kUnsafeReason,
  kUnsafeForeign,
  kUnsafeUses,
  kUnsafeUsesName,
} from "../../const/expression-types.const.tz";
import {
  Expr,
  ExprKind,
  NameExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  FunctionDoor,
  ParameterShape,
} from "../../types/expression-types.types.tz";

partial class ExpressionTypes {
  public readonly functionOf(module: int, loc: int): Type {
    const door = this.functionDoors.get(`${module} ${loc}`);
    if (door == undefined) {
      return this.types.store.plain(TypeKind.Error);
    }

    return door.type;
  }

  public functionTyped(module: int, loc: int): Type {
    return this.functionAt(module, loc);
  }

  private unsafeMarkCheck(fn: FunctionDecl, module: int): void {
    const tree = this.types.program.tree;

    const mark = fn.unsafe;
    if (mark == undefined) {
      return;
    }

    const options = tree.exprAt(mark.optionsId);
    const reason = this.unsafeReason(options);
    if (reason == undefined || reason.trim().length == 0) {
      this.errors.write(module, mark.loc, Code.OwnUnsafeReason, kNoDetails);
    }
  }

  private readonly unsafeReason(options: Expr | undefined): string | undefined {
    const tree = this.types.program.tree;

    if (options == undefined || options.kind != ExprKind.ObjectLit) {
      return undefined;
    }

    for (const property of tree.propertiesOf(options.propsList)) {
      const value = tree.exprOf(property.valueId);
      const isReason =
        property.name == kUnsafeReason && value.kind == ExprKind.StringLit;
      if (isReason && value.kind == ExprKind.StringLit) {
        return value.value;
      }
    }

    return undefined;
  }

  private unsafeUsesCheck(fn: FunctionDecl, module: int): void {
    const tree = this.types.program.tree;

    const mark = fn.unsafe;
    if (mark == undefined) {
      return;
    }

    const options = tree.exprAt(mark.optionsId);
    const listed = this.unsafeUses(options);
    const isUsed = this.unsafeUsed.has(fn.id);
    const isForeign = this.foreignUsed.has(fn.id);

    for (const name of listed) {
      const isMemory = name == kUnsafeMemory && isUsed;
      const isSystem = name == kUnsafeForeign && isForeign;
      if (!kUnsafeUses.includes(name)) {
        this.errors.write(module, mark.loc, Code.OwnUnsafeUses, { word: name });
      } else if (!isMemory && !isSystem) {
        this.errors.write(module, mark.loc, Code.OwnUnsafeUnused, {
          word: name,
        });
      }
    }

    if (isUsed && !listed.includes(kUnsafeMemory)) {
      this.errors.write(module, mark.loc, Code.OwnUnsafeUses, {
        word: kUnsafeMemory,
      });
    }
    if (isForeign && !listed.includes(kUnsafeForeign)) {
      this.errors.write(module, mark.loc, Code.OwnUnsafeUses, {
        word: kUnsafeForeign,
      });
    }
  }

  private readonly unsafeUses(options: Expr | undefined): string[] {
    const tree = this.types.program.tree;

    const names: string[] = [];
    if (options == undefined || options.kind != ExprKind.ObjectLit) {
      return names;
    }

    for (const property of tree.propertiesOf(options.propsList)) {
      const value = tree.exprOf(property.valueId);
      if (property.name != kUnsafeUsesName || value.kind != ExprKind.ArrayLit) {
        continue;
      }

      for (const element of tree.elementsOf(value.elementsList)) {
        const item = tree.exprOf(element.exprId);
        if (item.kind == ExprKind.Member) {
          names.push(item.name);
        }
      }
    }

    return names;
  }

  private unsafeCallCheck(
    name: NameExpr,
    module: int,
    isForeign: boolean,
  ): void {
    const open = this.openFunctions.slice();

    for (let index = open.length - 1; index >= 0; index--) {
      const fn = open[index];
      if (fn == undefined) {
        continue;
      }
      if (fn.unsafe != undefined && isForeign) {
        this.foreignUsed.add(fn.id);

        return;
      }
      if (fn.unsafe != undefined) {
        this.unsafeUsed.add(fn.id);

        return;
      }
      if (!fn.isArrow) {
        break;
      }
    }

    this.errors.write(module, name.loc, Code.OwnUnsafeOutside, {
      word: name.name,
    });
  }

  public readonly typedFunctionOf(module: int, loc: int): Type | undefined {
    const door = this.functionDoors.get(`${module} ${loc}`);
    if (door == undefined || door.state != DoorState.Done) {
      return undefined;
    }

    return door.type;
  }

  private functionAt(module: int, loc: int): Type {
    const fn = this.record(module)?.functions.get(loc);
    if (fn == undefined) {
      return this.types.store.plain(TypeKind.Error);
    }

    return this.functionType(fn, module);
  }

  private functionType(fn: FunctionDecl, module: int): Type {
    const key = `${module} ${fn.loc}`;
    const known = this.functionDoors.get(key);
    if (known != undefined) {
      return known.type;
    }

    const error = this.types.store.plain(TypeKind.Error);
    const door: FunctionDoor = {
      state: DoorState.InWork,
      type: error,
      isAssumed: false,
    };

    this.noteLate("function", module, fn.loc);

    const before = replace(this.facts, new Map<string, Type>());
    const owned = this.errors.mark();

    this.functionDoors.set(key, door);
    this.functionOrder.push(key);
    this.walking.push(key);
    this.openFunction(key, fn, module);
    this.errors.keepSince(owned);
    this.walking.pop();
    this.facts = before;

    return this.functionDone(key, error);
  }

  private functionDone(key: string, error: Type): Type {
    const door = this.functionDoors.get(key);
    if (door == undefined) {
      return error;
    }

    const type = door.type;

    this.functionDoors.set(key, {
      state: DoorState.Done,
      type,
      isAssumed: door.isAssumed,
    });

    return type;
  }

  private setFunctionType(key: string, type: Type): void {
    const door = this.functionDoors.get(key);
    if (door == undefined) {
      return;
    }

    const state = door.state;
    const isAssumed = door.isAssumed;

    this.functionDoors.set(key, { state, type, isAssumed });
  }

  private assumeFunctionType(key: string, type: Type): void {
    const door = this.functionDoors.get(key);
    if (door == undefined) {
      return;
    }

    const state = door.state;

    this.functionDoors.set(key, { state, type, isAssumed: true });
  }

  private openFunction(key: string, fn: FunctionDecl, module: int): void {
    const tree = this.types.program.tree;

    const context: TypeContext = {
      module,
      bindings: new Map<int, Type>(),
      place: TypePlace.Plain,
    };

    const typeParams = tree.typeParamsOf(fn.typeParamsList);

    this.types.typeParameters(module, typeParams);
    this.captureRequirements(fn, module);
    this.iterablePlaceCheck(fn, module);
    this.constructorArgsCheck(fn, module);
    const parameterPlaceErrors = this.types.parameterPlaceCheck(fn);

    this.errors.writeAll(module, parameterPlaceErrors);

    const shape = this.parameterShape(fn, context, module);

    this.foreignCheck(fn, shape, context, module);

    const self = shape.self ?? this.literalOwners.get(fn.id);
    const place = this.types.functionPlace(fn, self);

    if (self != undefined) {
      this.selves.push(self);
    }
    if (place != undefined) {
      this.thisPlaces.push(place);
    }

    this.unsafeMarkCheck(fn, module);
    this.openFunctions.push(fn);
    this.openBody(key, fn, shape, context, module);
    this.errorPathsCheck(fn, module);
    this.openFunctions.pop();
    this.unsafeUsesCheck(fn, module);

    if (place != undefined) {
      this.thisPlaces.pop();
    }
    if (self != undefined) {
      this.selves.pop();
    }
  }

  private openBody(
    key: string,
    fn: FunctionDecl,
    shape: Read<ParameterShape>,
    context: Read<TypeContext>,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const written = tree.typeRefAt(fn.returnTypeId);

    if (written != undefined) {
      const result = this.types.returnType(written, context);

      const asyncResultError = this.types.asyncResultCheck(fn, written, result);

      this.errors.writeFound(module, asyncResultError);
      this.predicateDeclCheck(fn, written, module);

      const signature = this.types.signatureOf(shape, result);

      this.setFunctionType(key, signature);

      return this.walkWritten(fn, result, module);
    }

    const inherited = this.inheritedResult(fn, module);
    if (inherited != undefined) {
      const signature = this.types.signatureOf(shape, inherited);

      this.setFunctionType(key, signature);

      return this.walkWritten(fn, inherited, module);
    }

    this.inferRounds(key, fn, shape, module);
  }

  private parameterShape(
    fn: FunctionDecl,
    context: Read<TypeContext>,
    module: int,
  ): ParameterShape {
    const tree = this.types.program.tree;

    const params: FunctionParameter[] = [];
    let self: Type | undefined = undefined;
    let rest = false;
    let isAfterOptional = false;

    for (const param of tree.paramsOf(fn.paramsList)) {
      const kind = param.form.kind;
      const type = this.methodParameter(fn, param, context, module);
      const inside = this.types.insideType(type, kind);

      this.paramTypes.set(`${module} ${param.loc}`, inside);

      if (param.name == kThisParameter) {
        const thisParameterErrors = this.types.thisParameterCheck(fn, param);

        this.errors.writeAll(module, thisParameterErrors);
        self = type;

        continue;
      }
      if (kind == ParamKind.Required && isAfterOptional) {
        this.errors.write(
          module,
          param.loc,
          Code.RequiredAfterOptional,
          kNoDetails,
        );
      }

      const optional =
        kind == ParamKind.Optional || kind == ParamKind.Defaulted;

      isAfterOptional = isAfterOptional || kind == ParamKind.Optional;
      rest = rest || kind == ParamKind.Rest;
      params.push({ type, optional });
    }

    return { params, rest, self };
  }

  private parameterOf(
    param: Param,
    context: Read<TypeContext>,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const written = tree.typeRefAt(param.typeId);
    const form = param.form;
    const word = param.name;

    if (written != undefined) {
      const site: ParameterSite = {
        name: word,
        loc: param.loc,
        kind: form.kind,
        type: written,
        isDeclared: true,
      };
      const type = this.types.parameterType(site, context);
      if (form.kind == ParamKind.Defaulted && type.kind != TypeKind.Error) {
        const defaultValue = tree.exprOf(form.defaultValueId);

        this.checked(defaultValue, type, module, kNoPlace);
      }

      return type;
    }
    if (form.kind != ParamKind.Defaulted) {
      this.errors.write(module, param.loc, Code.ParameterNeedsType, {
        word: this.types.parameterText(param, module),
      });

      return this.types.store.plain(TypeKind.Error);
    }
    const formDefaultValue = tree.exprOf(form.defaultValueId);
    if (!this.types.isPlainLiteral(formDefaultValue)) {
      this.errors.write(module, param.loc, Code.DefaultNeedsType, { word });

      return this.types.store.plain(TypeKind.Error);
    }

    const defaultValueExpr = tree.exprOf(form.defaultValueId);

    return this.typed(defaultValueExpr, undefined, module);
  }

  private methodParameter(
    fn: FunctionDecl,
    param: Param,
    context: Read<TypeContext>,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const isOpen =
      tree.typeRefAt(param.typeId) == undefined &&
      param.form.kind != ParamKind.Defaulted &&
      fn.role != undefined &&
      this.isExtending();
    if (isOpen || this.isLibraryOverride(fn)) {
      return this.types.store.plain(TypeKind.Error);
    }

    const type = this.parameterOf(param, context, module);

    return this.hookedParameter(fn, param, type);
  }

  private isLibraryOverride(fn: FunctionDecl): boolean {
    const tree = this.types.program.tree;

    const current = this.ownerClasses[this.ownerClasses.length - 1];
    if (current == undefined || fn.role == undefined) {
      return false;
    }

    const decl = current.decl;
    if (
      tree.typeRefAt(decl.baseId) == undefined ||
      tree.typeParamsOf(decl.typeParamsList).length > 0
    ) {
      return false;
    }

    const self = this.types.classInstance(current.module, decl, []);
    if (self.kind != TypeKind.Instance) {
      return false;
    }

    const parent = this.types.parentOf(self, decl);
    if (parent == undefined || !this.types.isLibraryModule(parent.module)) {
      return false;
    }
    if (this.types.isTypedLibrary(parent.module)) {
      return false;
    }

    const owner = this.record(parent.module)?.classes.get(parent.loc);
    const isOwn = this.types.hasClassMethod(owner, fn.name) == true;

    return isOwn || this.receiverMember(parent, fn.name, true) != undefined;
  }

  private readonly isExtending(): boolean {
    const tree = this.types.program.tree;

    const current = this.ownerClasses[this.ownerClasses.length - 1];

    return (
      current != undefined && tree.typeRefAt(current.decl.baseId) != undefined
    );
  }
}
