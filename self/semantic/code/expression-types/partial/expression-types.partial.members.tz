import { ExpressionTypes } from "../expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { EnumDecl } from "../../../../program/ast/types/ast.types.classes.tz";
import {
  Expr,
  ExprKind,
  MemberExpr,
  OptionalChainExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { SymbolKind } from "../../../../program/scopes/types/scopes.types.tz";
import {
  LiteralKind,
  ObjectType,
  TupleType,
  Type,
  TypeKind,
  UnionType,
} from "../../../../program/type/types/type.types.tz";
import {
  kLengthName,
  kPrototypeNames,
  kRawName,
  kWrappedValueName,
} from "../const/expression-types.const.tz";
import { EnumHome } from "../../../types/type-resolver/types/type-resolver.types.tz";
import { LiteralValue } from "../types/expression-types.types.tz";

partial class ExpressionTypes {
  private memberTyped(expr: MemberExpr, module: int): Type {
    const isRefused =
      this.thisPlaceCheck(expr, module) || this.superReadCheck(expr, module);
    if (isRefused || this.memberReadEarly(expr, module)) {
      return this.store.plain(TypeKind.Error);
    }

    const fact = this.pathFact(expr, module);
    if (fact != undefined) {
      return fact;
    }

    const home = this.enumHomeOf(expr.object, module);
    if (home != undefined) {
      return this.enumMemberTyped(expr, home, module);
    }
    if (this.isDateName(expr.object, module)) {
      return this.dateStaticRead(expr, module);
    }
    if (this.isDecimalName(expr.object, module)) {
      return this.decimalStaticRead(expr, module);
    }

    const owner = this.staticOwner(expr.object, module);
    if (owner != undefined) {
      return this.staticMemberTyped(expr, owner, module);
    }

    const object = this.receiverOf(expr.object, expr.optional, module);
    if (this.dictMemberCheck(expr, object, false, module)) {
      return this.store.plain(TypeKind.Error);
    }
    if (this.rawTextsCheck(expr, object, module)) {
      return this.store.plain(TypeKind.Error);
    }

    return this.memberOf(expr, object, module);
  }

  private chainTyped(
    expr: OptionalChainExpr,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const before = this.shortCircuits;
    const inner = this.typed(expr.chain, wanted, module);
    const isShort = this.shortCircuits > before;

    this.shortCircuits = before;

    if (!isShort || inner.kind == TypeKind.Error) {
      return inner;
    }

    return this.optional(inner);
  }

  private receiverOf(object: Expr, optional: boolean, module: int): Type {
    this.markThisObject(object, module);

    const type = this.typed(object, undefined, module);

    return this.linkOf(type, optional);
  }

  private linkOf(type: Type, optional: boolean): Type {
    if (!optional || !this.isOptional(type)) {
      return type;
    }

    this.shortCircuits += 1;

    return this.definedType(type);
  }

  private memberOf(expr: MemberExpr, object: Type, module: int): Type {
    if (this.unknownMemberCheck(expr, object, module)) {
      return this.store.plain(TypeKind.Error);
    }

    const keyed = this.recordMemberTyped(expr, object);
    if (keyed != undefined) {
      return keyed;
    }

    switch (object.kind) {
      case TypeKind.Union:
        return this.unionMemberOf(expr, object, module);
      case TypeKind.TypeParameter:
        return this.parameterMemberOf(expr, object, module);
      case TypeKind.Object:
        return this.objectField(expr, object, module);
      case TypeKind.Class:
        return this.classValueMember(expr, object, module);
      case TypeKind.Tuple:
        return this.tupleMember(expr, object, module);
      case TypeKind.Instance:
        return this.instanceMember(expr, object, module);
      case TypeKind.Result:
        return this.resultMemberRead(expr, object, module);
      case TypeKind.Json:
        return this.optional(object);
      case TypeKind.Dict:
      case TypeKind.Promise:
        return this.libraryMemberTyped(expr, object, module);
      case TypeKind.Literal: {
        const base = this.apparent(object);

        return this.valueMember(expr, base, module);
      }
      case TypeKind.String:
      case TypeKind.Template:
      case TypeKind.Array:
      case TypeKind.Iterator:
      case TypeKind.Int:
      case TypeKind.Double:
      case TypeKind.Decimal:
      case TypeKind.Boolean:
      case TypeKind.Function:
        return this.valueMember(expr, object, module);
      default:
        return this.store.plain(TypeKind.Error);
    }
  }

  private unionMemberOf(
    expr: MemberExpr,
    object: UnionType,
    module: int,
  ): Type {
    if (!this.isOptional(object)) {
      return this.variantMember(expr, object, module);
    }

    const defined = this.definedType(object);
    if (defined.kind == TypeKind.Json) {
      return this.optional(defined);
    }
    if (defined.kind != TypeKind.Error) {
      this.report(module, expr.object.loc, Code.ReadOfUndefined, {
        word: expr.name,
      });
    }

    return this.store.plain(TypeKind.Error);
  }

  private parameterMemberOf(expr: MemberExpr, object: Type, module: int): Type {
    const constraint = this.store.constraintOf(object);
    if (constraint == undefined) {
      const word = expr.name;
      const first = this.text.of(object);

      this.report(module, expr.loc, Code.PropertyMissing, { word, first });

      return this.store.plain(TypeKind.Error);
    }

    return this.memberOf(expr, constraint, module);
  }

  private objectField(expr: MemberExpr, object: ObjectType, module: int): Type {
    const fields = object.fields.filter((one) => one.name == expr.name);
    const field = fields[0];
    const isLibrary = this.resolver.isLibraryShape(object);
    if (field == undefined && isLibrary) {
      return this.store.plain(TypeKind.Error);
    }
    if (field == undefined) {
      this.reportMissingField(expr, object, module);

      return this.store.plain(TypeKind.Error);
    }

    const type = this.fieldWanted(field);
    const isMethod = type.kind == TypeKind.Function && type.shape.self == undefined;
    if (isLibrary && isMethod) {
      return this.store.plain(TypeKind.Error);
    }
    if (fields.length > 1) {
      this.signatureValueCheck(expr, fields, module);

      return this.store.plain(TypeKind.Error);
    }

    return type;
  }

  private reportMissingField(
    expr: MemberExpr,
    object: Type,
    module: int,
  ): void {
    const word = expr.name;
    const first = this.text.of(object);

    if (kPrototypeNames.includes(word)) {
      return this.report(module, expr.loc, Code.PrototypeMember, {
        word,
        first,
      });
    }

    this.report(module, expr.loc, Code.PropertyMissing, { word, first });
  }

  private tupleMember(expr: MemberExpr, tuple: TupleType, module: int): Type {
    if (expr.name == kLengthName) {
      return this.store.integer(64, false);
    }

    const word = expr.name;
    const first = this.text.of(tuple);

    this.report(module, expr.loc, Code.PropertyMissing, { word, first });

    return this.store.plain(TypeKind.Error);
  }

  private valueMember(expr: MemberExpr, object: Type, module: int): Type {
    const name = expr.name;
    const isSized = this.isSized(object);
    if (isSized && name == kLengthName) {
      return this.store.integer(64, false);
    }
    if (this.isWrappedValue(object, name)) {
      return this.unsignedOf(object);
    }
    if (this.isTextList(object) && name == kRawName) {
      return this.store.plain(TypeKind.Error);
    }

    const word = name;
    const first = this.text.of(object);

    if (isSized || object.kind == TypeKind.Iterator) {
      this.report(module, expr.loc, Code.MethodNotCalled, { word, first });

      return this.store.plain(TypeKind.Error);
    }

    this.report(module, expr.loc, Code.PropertyMissing, { word, first });

    return this.store.plain(TypeKind.Error);
  }

  private isSized(type: Type): boolean {
    switch (type.kind) {
      case TypeKind.String:
      case TypeKind.Template:
      case TypeKind.Array:
        return true;
      default:
        return false;
    }
  }

  private isWrappedValue(type: Type, name: string): boolean {
    return type.kind == TypeKind.Int && type.wraps && name == kWrappedValueName;
  }

  private unsignedOf(type: Type): Type {
    if (type.kind != TypeKind.Int) {
      return type;
    }

    return this.store.integer(type.bits, true);
  }

  private isTextList(type: Type): boolean {
    return type.kind == TypeKind.Array && type.item.kind == TypeKind.String;
  }

  private enumOfObject(object: Expr, module: int): EnumDecl | undefined {
    return this.enumHomeOf(object, module)?.decl;
  }

  private enumHomeOf(object: Expr, module: int): EnumHome | undefined {
    if (object.kind != ExprKind.Name) {
      return undefined;
    }

    const target = this.targetOfName(object, module);
    if (target == undefined || target.kind != SymbolKind.Enum) {
      return undefined;
    }

    const decl = this.record(target.module)?.enums.get(target.loc);
    if (decl == undefined) {
      return undefined;
    }

    return { module: target.module, decl };
  }

  private enumMemberTyped(
    expr: MemberExpr,
    home: EnumHome,
    module: int,
  ): Type {
    const step = this.resolver.enumMember(home.module, home.decl, expr.name);
    if (step == undefined) {
      this.report(module, expr.loc, Code.EnumMemberMissing, {
        word: expr.name,
        other: home.decl.name,
      });
    }

    return this.store.plain(TypeKind.Error);
  }

  private enumLiteral(expr: MemberExpr, module: int): LiteralValue | undefined {
    const home = this.enumHomeOf(expr.object, module);
    if (home == undefined) {
      return undefined;
    }

    const step = this.resolver.enumMember(home.module, home.decl, expr.name);
    if (step == undefined) {
      return undefined;
    }

    const type = step.type;
    if (type.kind != TypeKind.Literal) {
      return undefined;
    }
    if (type.literal == LiteralKind.String) {
      return this.plainLiteral(LiteralKind.String, type.text);
    }

    const number = step.number;
    if (number == undefined) {
      return undefined;
    }

    return this.wholeLiteral(number);
  }

  private wholeLiteral(number: int): LiteralValue {
    const text = `${number}`;

    if (number >= 0) {
      const whole = number.toUint64();

      return { kind: LiteralKind.Int, text, whole, negative: false };
    }

    const below = -(number + 1);
    const whole = below.toUint64() + 1;

    return { kind: LiteralKind.Int, text, whole, negative: true };
  }

  private enumConstant(expr: MemberExpr, module: int): decimal | undefined {
    const literal = this.enumLiteral(expr, module);
    if (literal == undefined || literal.kind != LiteralKind.Int) {
      return undefined;
    }

    const value = decimal(literal.text);
    if (value.isErr()) {
      return undefined;
    }

    return value.value;
  }

  private enumWhole(expr: MemberExpr, module: int): Type {
    const home = this.enumHomeOf(expr.object, module);
    if (home == undefined) {
      return this.store.plain(TypeKind.String);
    }

    return this.resolver.declaredEnum(home.module, home.decl);
  }
}
