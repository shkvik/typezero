import { ExpressionTypes } from "../expression-types.tz";
import {
  DictKind,
  FunctionType,
  ObjectType,
  Type,
  TypeKind,
  UnionType,
} from "../../../../program/type/types/type.types.tz";
import {
  Candidate,
  CandidateStrength,
  InferenceSet,
} from "../types/expression-types.types.tz";

partial class ExpressionTypes {
  private inferenceSet(params: Type[]): InferenceSet {
    return {
      params,
      candidates: [],
      undefinedSeen: new Set<int>(),
      visited: new Set<string>(),
      isWeak: false,
      isIntLiteral: false,
      isUnmatched: false,
    };
  }

  private inferArgument(
    set: InferenceSet,
    pattern: Type,
    actual: Type,
    strength: CandidateStrength,
    isIntLiteral: boolean,
  ): void {
    set.isWeak = strength == CandidateStrength.Weak;
    set.isIntLiteral = isIntLiteral;

    this.inferPair(set, pattern, actual);

    set.isWeak = false;
    set.isIntLiteral = false;
  }

  private inferPair(set: InferenceSet, pattern: Type, actual: Type): void {
    if (actual.kind == TypeKind.Error) {
      return;
    }

    const index = set.params.indexOf(pattern);

    if (actual.kind == TypeKind.Void) {
      return this.addVoid(set, index, CandidateStrength.Strong);
    }
    if (index >= 0) {
      return this.inferParameter(set, index, actual);
    }
    if (!this.isMentioning(pattern, set.params)) {
      return;
    }

    this.inferInside(set, pattern, actual);
  }

  private addVoid(
    set: InferenceSet,
    index: int,
    strength: CandidateStrength,
  ): void {
    if (index < 0) {
      return;
    }

    const type = this.store.plain(TypeKind.Void);

    set.candidates.push({ index, type, strength });
  }

  private inferParameter(set: InferenceSet, index: int, actual: Type): void {
    if (actual.kind == TypeKind.Undefined) {
      set.undefinedSeen.add(index);

      return;
    }
    if (this.hasUnknownInside(actual)) {
      return;
    }

    const strength = this.currentStrength(set);

    set.candidates.push({ index, type: actual, strength });
  }

  private currentStrength(set: InferenceSet): CandidateStrength {
    if (set.isIntLiteral) {
      return CandidateStrength.Literal;
    }
    if (set.isWeak) {
      return CandidateStrength.Weak;
    }

    return CandidateStrength.Strong;
  }

  private heldStrength(set: InferenceSet): CandidateStrength {
    if (set.isWeak) {
      return CandidateStrength.Weak;
    }

    return CandidateStrength.Strong;
  }

  private inferHeld(set: InferenceSet, pattern: Type, actual: Type): void {
    const index = set.params.indexOf(pattern);
    if (index >= 0 && actual.kind == TypeKind.Void) {
      const strength = this.heldStrength(set);

      return this.addVoid(set, index, strength);
    }

    this.inferPair(set, pattern, actual);
  }

  private inferInside(set: InferenceSet, pattern: Type, actual: Type): void {
    if (!this.isSameShape(pattern, actual)) {
      set.isUnmatched = true;

      return;
    }

    switch (pattern.kind) {
      case TypeKind.Union:
        return this.inferUnion(set, pattern, actual);
      case TypeKind.Array:
        if (actual.kind == TypeKind.Array) {
          this.inferPair(set, pattern.item, actual.item);
        }

        return;
      case TypeKind.Tuple:
        if (actual.kind == TypeKind.Tuple) {
          this.inferItems(set, pattern.items, actual.items);
        }

        return;
      case TypeKind.Object:
        return this.inferObject(set, pattern, actual);
      case TypeKind.Function:
        return this.inferFunction(set, pattern, actual);
      case TypeKind.Result:
        if (actual.kind == TypeKind.Result) {
          this.inferHeld(set, pattern.value, actual.value);
          this.inferPair(set, pattern.error, actual.error);
        }

        return;
      case TypeKind.Promise:
        if (actual.kind == TypeKind.Promise) {
          this.inferHeld(set, pattern.value, actual.value);
        }

        return;
      default:
        return this.inferHolder(set, pattern, actual);
    }
  }

  private isSameShape(pattern: Type, actual: Type): boolean {
    switch (pattern.kind) {
      case TypeKind.Union:
        return true;
      case TypeKind.Instance:
        return this.sameClassIn(actual, pattern) != undefined;
      case TypeKind.Dict:
        return actual.kind == TypeKind.Dict || actual.kind == TypeKind.Object;
      default:
        return pattern.kind == actual.kind;
    }
  }

  private inferHolder(set: InferenceSet, pattern: Type, actual: Type): void {
    switch (pattern.kind) {
      case TypeKind.Iterator: {
        if (actual.kind != TypeKind.Iterator) {
          return;
        }

        const want = pattern.shape;
        const have = actual.shape;

        this.inferPair(set, want.yielded, have.yielded);
        this.inferPair(set, want.returned, have.returned);
        this.inferPair(set, want.sent, have.sent);

        return;
      }
      case TypeKind.Dict:
        return this.inferDict(set, pattern, actual);
      case TypeKind.Instance:
        return this.inferInstance(set, pattern, actual);
      default:
        return;
    }
  }

  private inferItems(set: InferenceSet, want: Type[], have: Type[]): void {
    const shared = Math.min(want.length, have.length);

    for (let index = 0; index < shared; index++) {
      const pattern = want[index];
      const actual = have[index];
      if (pattern != undefined && actual != undefined) {
        this.inferPair(set, pattern, actual);
      }
    }
  }

  private inferUnion(
    set: InferenceSet,
    pattern: UnionType,
    actual: Type,
  ): void {
    if (this.isOptional(pattern)) {
      if (actual.kind == TypeKind.Undefined) {
        return;
      }

      const inner = this.definedType(pattern);
      const value = this.definedType(actual);

      return this.inferPair(set, inner, value);
    }

    const open = pattern.parts.filter((part) =>
      this.isMentioning(part, set.params),
    );
    const fixed = pattern.parts.filter(
      (part) => !this.isMentioning(part, set.params),
    );
    const first = open[0];

    if (open.length > 1) {
      return this.inferMember(set, open, actual);
    }
    if (first == undefined) {
      return;
    }

    const value = this.definedType(actual);
    const members = this.partsOfType(value);
    const rest = members.filter((member) => !fixed.includes(member));
    if (rest.length == 0) {
      return;
    }

    const joined = this.store.unionOf(rest);

    this.inferPair(set, first, joined);
  }

  private partsOfType(type: Type): Type[] {
    if (type.kind == TypeKind.Union) {
      return type.parts;
    }

    return [type];
  }

  private inferMember(set: InferenceSet, open: Type[], actual: Type): void {
    const value = this.definedType(actual);

    for (const member of open) {
      if (this.isInstanceOfMember(value, member)) {
        return this.inferPair(set, member, value);
      }
    }
  }

  private isInstanceOfMember(value: Type, member: Type): boolean {
    if (member.kind != TypeKind.Instance || member.args.length == 0) {
      return false;
    }

    return this.sameClassIn(value, member) != undefined;
  }

  private sameClassIn(value: Type, member: Type): Type | undefined {
    if (member.kind != TypeKind.Instance) {
      return undefined;
    }

    const home = member.module;
    const loc = member.loc;
    const chain = this.ancestorsOf(value);

    return chain.find(
      (one) =>
        one.kind == TypeKind.Instance && one.module == home && one.loc == loc,
    );
  }

  private inferInstance(set: InferenceSet, pattern: Type, actual: Type): void {
    if (pattern.kind != TypeKind.Instance || pattern.args.length == 0) {
      return;
    }

    const found = this.sameClassIn(actual, pattern);
    if (found == undefined || found.kind != TypeKind.Instance) {
      return;
    }

    this.inferItems(set, pattern.args, found.args);
  }

  private inferObject(
    set: InferenceSet,
    pattern: ObjectType,
    actual: Type,
  ): void {
    if (actual.kind != TypeKind.Object) {
      return;
    }

    const key = `${pattern.id} ${actual.id}`;
    if (set.visited.has(key)) {
      return;
    }

    set.visited.add(key);

    for (const field of pattern.fields) {
      const own = actual.fields.find((one) => one.name == field.name);
      if (own != undefined) {
        this.inferPair(set, field.type, own.type);
      }
    }
  }

  private inferFunction(
    set: InferenceSet,
    pattern: FunctionType,
    actual: Type,
  ): void {
    if (actual.kind != TypeKind.Function) {
      return;
    }

    const want = pattern.shape;
    const have = actual.shape;
    const wanted = want.params.map((param) => param.type);
    const given = have.params.map((param) => param.type);

    this.inferItems(set, wanted, given);

    const returned = set.params.indexOf(want.result);
    if (returned >= 0 && have.result.kind == TypeKind.Void) {
      return this.addVoid(set, returned, CandidateStrength.Strong);
    }
    if (want.result.kind != TypeKind.Void) {
      this.inferPair(set, want.result, have.result);
    }
  }

  private inferDict(set: InferenceSet, pattern: Type, actual: Type): void {
    if (pattern.kind != TypeKind.Dict) {
      return;
    }

    const isRecord = pattern.dict == DictKind.Record;
    if (isRecord && actual.kind == TypeKind.Object) {
      for (const field of actual.fields) {
        this.inferPair(set, pattern.value, field.type);
      }

      return;
    }
    if (actual.kind != TypeKind.Dict || actual.dict != pattern.dict) {
      return;
    }

    this.inferPair(set, pattern.key, actual.key);
    this.inferPair(set, pattern.value, actual.value);
  }

  private isMentioning(type: Type, params: Type[]): boolean {
    const ids = new Set<int>();

    for (const param of params) {
      ids.add(param.id);
    }

    return this.resolver.mentions(type, ids);
  }

  private candidatesOf(
    set: InferenceSet,
    index: int,
    strength: CandidateStrength,
  ): Type[] {
    const found = set.candidates.filter(
      (one) => one.index == index && one.strength == strength,
    );

    return found.map((one) => one.type);
  }

  private adoptCandidates(
    set: InferenceSet,
    index: int,
    other: InferenceSet,
  ): void {
    const kept = set.candidates.filter((one) => one.index != index);
    const taken = other.candidates.filter(
      (one) => one.index == index && one.strength == CandidateStrength.Strong,
    );
    const next: Candidate[] = kept.concat(taken);

    set.candidates.splice(0, set.candidates.length);

    for (const one of next) {
      set.candidates.push(one);
    }

    set.undefinedSeen.delete(index);

    if (other.undefinedSeen.has(index)) {
      set.undefinedSeen.add(index);
    }
  }
}
