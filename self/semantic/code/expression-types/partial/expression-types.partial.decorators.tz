import { ExpressionTypes } from "../expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import {
  ClassDecl,
  Decorator,
  FieldKind,
  MethodKind,
} from "../../../../program/ast/types/ast.types.classes.tz";
import {
  Expr,
  ExprKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../program/ast/types/ast.types.functions.tz";
import { SymbolKind } from "../../../../program/scopes/types/scopes.types.tz";
import {
  FunctionType,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import {
  kDecoratorPlaces,
  kDescriptorValueName,
  kHiddenMark,
  kMetadataName,
  kReflectName,
} from "../const/expression-types.const.tz";
import {
  DecoratedName,
  DecorateRun,
  DecoratorPlace,
  DecoratorUse,
} from "../types/expression-types.types.tz";

partial class ExpressionTypes {
  private decoratorChecks(decl: ClassDecl, module: int): void {
    if (!this.isDecoratedClass(decl)) {
      return;
    }

    this.decoratedNamesCheck(decl, module);
    this.decoratedConstructorsCheck(decl, module);

    for (const run of this.memberRuns(decl)) {
      this.decorate(run, module);
    }

    const uses = this.classUses(decl);
    const at = uses[0]?.decorator.loc;
    if (at == undefined) {
      return;
    }

    this.decorate(
      {
        decl,
        uses,
        place: DecoratorPlace.Class,
        isStatic: false,
        at,
      },
      module,
    );
  }

  private isDecoratedClass(decl: ClassDecl): boolean {
    const isMethod = decl.methods.some((fn) => this.isDecoratedFunction(fn));
    const isMade = decl.constructors.some((fn) => this.hasDecoratedParams(fn));
    const isField = decl.fields.some((field) => field.decorators.length > 0);

    return decl.decorators.length > 0 || isMethod || isMade || isField;
  }

  private isDecoratedFunction(fn: FunctionDecl): boolean {
    const own = fn.role?.decorators ?? [];

    return own.length > 0 || this.hasDecoratedParams(fn);
  }

  private hasDecoratedParams(fn: FunctionDecl): boolean {
    return fn.params.some((param) => param.decorators.length > 0);
  }

  private decoratedNamesCheck(decl: ClassDecl, module: int): void {
    const members = this.decoratedNames(decl);

    for (let index = 1; index < members.length; index++) {
      const later = members[index];
      if (later != undefined) {
        this.nameClashCheck(decl, members.slice(0, index), later, module);
      }
    }
  }

  private decoratedNames(decl: ClassDecl): DecoratedName[] {
    const members: DecoratedName[] = [];

    for (const field of decl.fields) {
      const decorators = this.decoratorNames(field.decorators);
      if (decorators.length > 0) {
        members.push({
          name: field.name,
          loc: field.loc,
          isStatic: field.form == FieldKind.Static,
          decorators,
        });
      }
    }

    for (const fn of decl.methods) {
      const decorators = this.methodDecoratorNames(fn);
      if (decorators.length > 0) {
        members.push({
          name: fn.name,
          loc: fn.loc,
          isStatic: this.isStaticMethod(fn),
          decorators,
        });
      }
    }

    return members;
  }

  private decoratorNames(decorators: Decorator[]): string[] {
    return decorators.map((decorator) => this.decoratorName(decorator.expr));
  }

  private methodDecoratorNames(fn: FunctionDecl): string[] {
    const names = this.decoratorNames(fn.role?.decorators ?? []);

    for (const param of fn.params) {
      const more = this.decoratorNames(param.decorators);

      names.push(...more);
    }

    return names;
  }

  private nameClashCheck(
    decl: ClassDecl,
    earlier: DecoratedName[],
    later: DecoratedName,
    module: int,
  ): void {
    const other = earlier.find((one) => one.name == later.name);
    if (other == undefined) {
      return;
    }

    const first = this.clashWhat(other, later);
    const second = this.clashRecords(other, later);

    this.report(module, later.loc, Code.DecoratedSameName, {
      word: decl.name ?? "",
      first,
      second,
    });
  }

  private clashWhat(earlier: DecoratedName, later: DecoratedName): string {
    const name = later.name;
    if (earlier.isStatic != later.isStatic) {
      return `both the static member '${name}' and the member '${name}'`;
    }

    return `two variants of '${name}'`;
  }

  private clashRecords(earlier: DecoratedName, later: DecoratedName): string {
    const names = later.decorators.slice().reverse();
    const shared = names.find(
      (name) => name != "" && earlier.decorators.includes(name),
    );
    if (shared == undefined) {
      return "the records 'design:*' the compiler writes";
    }

    return `the records of '@${shared}'`;
  }

  private decoratedConstructorsCheck(decl: ClassDecl, module: int): void {
    const decorated = decl.constructors.filter((fn) =>
      this.hasDecoratedParams(fn),
    );
    const second = decorated[1];
    if (second == undefined) {
      return;
    }

    this.report(module, second.loc, Code.DecoratedConstructors, {
      word: decl.name ?? "",
    });
  }

  private memberRuns(decl: ClassDecl): DecorateRun[] {
    const runs: DecorateRun[] = [];

    for (const field of decl.fields) {
      const uses = this.ownUses(field.decorators);
      const first = uses[0];
      if (first != undefined) {
        runs.push({
          decl,
          field,
          uses,
          place: DecoratorPlace.Field,
          isStatic: field.form == FieldKind.Static,
          at: first.decorator.loc,
        });
      }
    }

    for (const fn of decl.methods) {
      const uses = this.ownUses(fn.role?.decorators ?? []);

      this.addParamUses(uses, fn);

      const first = uses[0];
      if (first != undefined) {
        runs.push({
          decl,
          method: fn,
          uses,
          place: DecoratorPlace.Method,
          isStatic: this.isStaticMethod(fn),
          at: first.decorator.loc,
        });
      }
    }

    const instance = runs.filter((run) => !run.isStatic);
    const statics = runs.filter((run) => run.isStatic);

    return instance.concat(statics);
  }

  private ownUses(decorators: Decorator[]): DecoratorUse[] {
    return decorators.map((decorator) => ({ decorator, param: -1 }));
  }

  private addParamUses(uses: DecoratorUse[], fn: FunctionDecl): void {
    for (let index = 0; index < fn.params.length; index++) {
      const param = fn.params[index];

      for (const decorator of param?.decorators ?? []) {
        uses.push({ decorator, param: index });
      }
    }
  }

  private classUses(decl: ClassDecl): DecoratorUse[] {
    const uses = this.ownUses(decl.decorators);

    for (const fn of decl.constructors) {
      this.addParamUses(uses, fn);
    }

    return uses;
  }

  private decorate(run: DecorateRun, module: int): void {
    if (run.field?.accessor == true) {
      return this.report(module, run.at, Code.DecoratorAccessor, kNoDetails);
    }
    if (run.method?.role?.method == MethodKind.Abstract) {
      return this.report(module, run.at, Code.DecoratorAbstract, kNoDetails);
    }

    const types: Type[] = [];
    let isFitting = true;
    let hasDescriptor = false;

    for (const use of run.uses) {
      const place = this.usePlace(run, use);
      const type = this.decoratorType(use.decorator.expr, module);
      const count = this.decoratorFit(use, place, type, module);

      types.push(type);
      isFitting = isFitting && count >= 0;
      hasDescriptor = hasDescriptor || this.isDescriptorUse(place, count);
    }

    if (!isFitting) {
      return;
    }
    if (hasDescriptor && run.decl.typeParams.length > 0) {
      return this.report(module, run.at, Code.DecoratorGenericDescriptor, {
        word: run.decl.name ?? "",
      });
    }

    for (let index = run.uses.length - 1; index >= 0; index--) {
      const use = run.uses[index];
      const type = types[index];
      if (use != undefined && type != undefined) {
        this.decoratorResultCheck(run, use, type, hasDescriptor, module);
      }
    }
  }

  private isDescriptorUse(place: DecoratorPlace, count: int): boolean {
    return place == DecoratorPlace.Method && count >= 3;
  }

  private usePlace(run: DecorateRun, use: DecoratorUse): DecoratorPlace {
    if (use.param >= 0) {
      return DecoratorPlace.Parameter;
    }

    return run.place;
  }

  private decoratorType(expr: Expr, module: int): Type {
    if (this.isMetadataDecorator(expr, module)) {
      return this.store.plain(TypeKind.Error);
    }
    if (expr.kind != ExprKind.Name) {
      return this.typed(expr, undefined, module);
    }

    const target = this.targetOfName(expr, module);
    if (target == undefined || target.kind != SymbolKind.Function) {
      return this.typed(expr, undefined, module);
    }

    return this.functionAt(target.module, target.loc);
  }

  private isMetadataDecorator(expr: Expr, module: int): boolean {
    if (expr.kind != ExprKind.Call) {
      return false;
    }

    const callee = expr.callee;
    if (callee.kind != ExprKind.Member || callee.name != kMetadataName) {
      return false;
    }

    const object = callee.object;
    if (object.kind != ExprKind.Name || object.name != kReflectName) {
      return false;
    }

    return this.targetOfName(object, module) == undefined;
  }

  private decoratorFit(
    use: DecoratorUse,
    place: DecoratorPlace,
    type: Type,
    module: int,
  ): int {
    const row = kDecoratorPlaces.find((one) => one.place == place);
    const given = row?.given ?? 3;
    if (row == undefined || type.kind != TypeKind.Function || type.shape.rest) {
      return given;
    }

    const params = type.shape.params;
    const isUnknown = params.some((param) => param.type.kind == TypeKind.Error);
    if (isUnknown) {
      return given;
    }

    const count = params.length;
    const needs = Math.min(this.leastOf(type), count);
    const word = this.decoratorLabel(use.decorator.expr);
    const loc = use.decorator.loc;
    if (needs > given) {
      this.report(module, loc, Code.DecoratorArguments, {
        word,
        first: row.noun,
        other: `${needs}`,
        second: `${given}`,
        place: row.args,
      });

      return -1;
    }

    const third = this.thirdParameter(type);
    const isDescriptor = third != undefined && this.isDescriptorType(third);
    if (isDescriptor && place == DecoratorPlace.Parameter) {
      this.report(module, loc, Code.DecoratorDescriptorParameter, { word });

      return -1;
    }

    const isPosition = third != undefined && this.isPositionType(third);
    if (isPosition && place == DecoratorPlace.Method) {
      this.report(module, loc, Code.DecoratorPositionMethod, { word });

      return -1;
    }

    return count;
  }

  private thirdParameter(type: FunctionType): Type | undefined {
    const third = type.shape.params[2];
    if (third == undefined) {
      return undefined;
    }

    return this.definedType(third.type);
  }

  private isDescriptorType(type: Type): boolean {
    if (type.kind != TypeKind.Object) {
      return false;
    }

    return type.fields.some((field) => field.name == kDescriptorValueName);
  }

  private isPositionType(type: Type): boolean {
    return type.kind == TypeKind.Int || type.kind == TypeKind.Double;
  }

  private decoratorName(expr: Expr): string {
    const names: string[] = [];
    let link = this.withoutCalls(expr);

    while (link.kind == ExprKind.Member) {
      names.push(link.name);
      link = this.withoutCalls(link.object);
    }

    if (link.kind != ExprKind.Name || link.name.startsWith(kHiddenMark)) {
      return "";
    }

    return [link.name].concat(names.reverse()).join(".");
  }

  private withoutCalls(expr: Expr): Expr {
    let callee = expr;

    while (callee.kind == ExprKind.Call) {
      callee = callee.callee;
    }

    return callee;
  }

  private decoratorLabel(expr: Expr): string {
    const name = this.decoratorName(expr);
    if (name == "") {
      return "the decorator";
    }

    return `'${name}'`;
  }

  private decoratorResultCheck(
    run: DecorateRun,
    use: DecoratorUse,
    type: Type,
    hasDescriptor: boolean,
    module: int,
  ): void {
    if (type.kind != TypeKind.Function) {
      return;
    }

    const result = type.shape.result;
    const place = this.usePlace(run, use);
    const isNothing =
      result.kind == TypeKind.Void ||
      result.kind == TypeKind.Undefined ||
      result.kind == TypeKind.Error;
    if (isNothing || this.mentionsParameter(result)) {
      return;
    }

    const third = type.shape.params[2]?.type;
    const isDescriptor = place == DecoratorPlace.Method && hasDescriptor;
    if (isDescriptor && result == third) {
      return;
    }
    const isClassPlace = place == DecoratorPlace.Class;
    if (isClassPlace && this.isReplacing(run.decl, result, module)) {
      return;
    }

    const word = this.decoratorLabel(use.decorator.expr);
    const first = this.text.of(result);
    const loc = use.decorator.loc;
    if (isClassPlace && result.kind == TypeKind.Class && !result.exact) {
      return this.report(module, loc, Code.DecoratorRuntimeClass, {
        word,
        first,
        second: run.decl.name ?? "",
      });
    }
    if (isClassPlace) {
      return this.report(module, loc, Code.DecoratorClassResult, {
        word,
        first,
      });
    }
    if (isDescriptor) {
      return this.report(module, loc, Code.DecoratorMethodResult, {
        word,
        first,
      });
    }

    const row = kDecoratorPlaces.find((one) => one.place == place);

    this.report(module, loc, Code.DecoratorOtherResult, {
      word,
      first,
      second: row?.noun ?? "",
    });
  }

  private isReplacing(decl: ClassDecl, result: Type, module: int): boolean {
    if (result.kind != TypeKind.Class || !result.exact) {
      return false;
    }
    if (decl.typeParams.length > 0) {
      return true;
    }

    const own = this.resolver.classInstance(module, decl, []);

    return this.relation.converts(result.instance, own);
  }

  private parameterPlaceCheck(fn: FunctionDecl, module: int): void {
    if (fn.role != undefined) {
      return;
    }

    for (const param of fn.params) {
      const first = param.decorators[0];
      if (first != undefined) {
        this.report(module, first.loc, Code.DecoratorParameterPlace, kNoDetails);
      }
    }
  }
}
