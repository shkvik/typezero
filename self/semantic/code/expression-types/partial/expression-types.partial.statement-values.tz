import { ExpressionTypes } from "../expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import {
  Expr,
  ExprKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";
import {
  kClosingMarks,
  kCommentStart,
  kLineEnds,
  kMostShownStatement,
  kOpeningMarks,
  kPromisePlaceholder,
  kStatementEnd,
  kTakingMethods,
} from "../const/expression-types.const.tz";

partial class ExpressionTypes {
  private usedCheck(
    expr: Expr,
    type: Type,
    at: int | undefined,
    module: int,
  ): void {
    if (this.lenientCalls.has(expr)) {
      return this.libraryUsedCheck(expr, type, at, module);
    }

    const isKept =
      expr.kind == ExprKind.Assign || this.isTakingElement(expr);
    if (isKept) {
      return;
    }

    const defined = this.definedType(type);
    const held = this.heldType(type);
    if (held.kind != defined.kind) {
      return;
    }
    if (defined.kind == TypeKind.Promise) {
      return this.promiseUsed(expr, defined.value, at, module);
    }
    if (defined.kind == TypeKind.Result) {
      this.report(module, expr.loc, Code.ResultUnused, kNoDetails);
    }
  }

  private libraryUsedCheck(
    expr: Expr,
    type: Type,
    at: int | undefined,
    module: int,
  ): void {
    const defined = this.definedType(type);
    const loc = this.calleeLoc(expr);
    if (!this.isValueMethodCall(expr, module)) {
      return;
    }
    if (defined.kind == TypeKind.Array) {
      const item = this.definedType(defined.item);
      if (item.kind == TypeKind.Promise) {
        this.report(module, loc, Code.PromisesNotAwaited, kNoDetails);
      }
      if (item.kind == TypeKind.Result && this.isMappingCall(expr)) {
        this.report(module, loc, Code.ResultsUnused, kNoDetails);
      }

      return;
    }
    if (defined.kind != TypeKind.Promise) {
      return;
    }

    const held = this.heldType(defined.value);
    if (held.kind == TypeKind.Result) {
      return;
    }

    const text = this.statementText(at, module);
    if (text == "") {
      return this.report(module, loc, Code.PromiseNotAwaited, kNoDetails);
    }

    this.report(module, loc, Code.PromiseNotAwaitedHere, { word: text });
  }

  private isMappingCall(expr: Expr): boolean {
    if (expr.kind != ExprKind.Call) {
      return false;
    }

    const callee = expr.callee;
    if (callee.kind != ExprKind.Member) {
      return false;
    }

    return callee.name == "map" || callee.name == "flatMap";
  }

  private isValueMethodCall(expr: Expr, module: int): boolean {
    if (expr.kind != ExprKind.Call) {
      return false;
    }

    const callee = expr.callee;
    if (callee.kind != ExprKind.Member) {
      return false;
    }

    this.quiet += 1;

    const object = this.typed(callee.object, undefined, module);

    this.quiet -= 1;

    const base = this.definedType(object);

    return base.kind == TypeKind.Array || base.kind == TypeKind.Promise;
  }

  private calleeLoc(expr: Expr): int {
    if (expr.kind == ExprKind.Call && expr.callee.kind == ExprKind.Member) {
      return expr.callee.loc;
    }

    return expr.loc;
  }

  private promiseUsed(
    expr: Expr,
    value: Type,
    at: int | undefined,
    module: int,
  ): void {
    const text = this.statementText(at, module);
    const held = this.heldType(value);
    if (held.kind == TypeKind.Result) {
      const word = this.shownText(text);

      return this.report(module, expr.loc, Code.PromiseResultUnchecked, {
        word,
      });
    }
    if (text == "") {
      return this.report(module, expr.loc, Code.PromiseNotAwaited, kNoDetails);
    }

    this.report(module, expr.loc, Code.PromiseNotAwaitedHere, { word: text });
  }

  private shownText(text: string): string {
    if (text == "") {
      return kPromisePlaceholder;
    }

    return text;
  }

  private heldType(type: Type): Type {
    const defined = this.definedType(type);
    if (defined.kind == TypeKind.Array) {
      return this.heldType(defined.item);
    }

    return defined;
  }

  private isTakingElement(expr: Expr): boolean {
    if (expr.kind != ExprKind.Call) {
      return false;
    }

    const callee = expr.callee;

    return (
      callee.kind == ExprKind.Member && kTakingMethods.includes(callee.name)
    );
  }

  private statementText(at: int | undefined, module: int): string {
    const source = this.program.modules[module]?.source.text;
    if (at == undefined || source == undefined) {
      return "";
    }

    const end = Math.min(source.length, at + kMostShownStatement * 4);
    const line = source.toString("utf8", at, end);
    let depth = 0;
    let taken = "";

    for (const unit of line) {
      const rest = line.slice(taken.length);
      const isEnd =
        kLineEnds.includes(unit) ||
        (depth == 0 &&
          (unit == kStatementEnd || rest.startsWith(kCommentStart)));
      if (isEnd) {
        break;
      }
      if (kOpeningMarks.includes(unit)) {
        depth += 1;
      }
      if (kClosingMarks.includes(unit)) {
        depth -= 1;
      }

      taken += unit;
    }

    const text = taken.trimEnd();
    if (depth != 0 || text.length > kMostShownStatement) {
      return "";
    }

    return text;
  }
}
