import { ExpressionTypes } from "../expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import {
  Expr,
  ExprKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import {
  LiteralKind,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import {
  kConversionPrefix,
  kIntervalSeparator,
  kManyLiterals,
  kUnnamedOperand,
} from "../const/expression-types.const.tz";
import { kWideBits } from "../../../types/type-relation/const/type-relation.const.tz";
import { Bound, Interval } from "../types/expression-types.types.tz";

partial class ExpressionTypes {
  private mismatch(
    expr: Expr,
    given: Type,
    wanted: Type,
    module: int,
    place: string,
  ): void {
    const source = this.innerObject(given, wanted);
    const target = this.innerObject(wanted, given);
    const only = this.onlyPart(wanted);
    const goal = this.definedType(wanted);
    const intervals = this.rangeIntervals(given, goal);
    const holds = this.rangeText(intervals);
    const code = this.mismatchCode(given, wanted, source, target, holds);
    if (!this.isReported(expr, given, wanted, code)) {
      return;
    }

    const first = this.text.of(given);
    const second = this.text.of(wanted);
    const word = this.mismatchWord(expr, code, target, intervals);
    const other = this.mismatchOther(code, holds, only);

    this.report(module, expr.loc, code, {
      first,
      second,
      word,
      other,
      place,
    });
  }

  private mismatchCode(
    given: Type,
    wanted: Type,
    source: Type,
    target: Type,
    holds: string,
  ): Code {
    if (holds != "" && given.kind == TypeKind.Literal) {
      return Code.LiteralOutsideRange;
    }
    if (holds != "") {
      return Code.ValueOutsideRange;
    }

    const isPlainObject =
      source.kind == TypeKind.Object || source.kind == TypeKind.Tuple;
    if (isPlainObject && target.kind == TypeKind.Instance) {
      return Code.LiteralNotInstance;
    }
    if (isPlainObject && this.hasObjectMember(target)) {
      return this.unionCode(target);
    }
    if (source.kind == TypeKind.Tuple && target.kind == TypeKind.Array) {
      return Code.TupleNotArray;
    }

    const value = this.definedType(given);
    const goal = this.definedType(wanted);

    if (value.kind == TypeKind.Json) {
      return Code.JsonUnchecked;
    }
    if (goal.kind == TypeKind.AnyObject) {
      return Code.NotAnObject;
    }
    if (goal.kind == TypeKind.Json) {
      return this.jsonCode(source, value);
    }

    const only = this.onlyPart(wanted);

    return this.numberCode(given, only);
  }

  private hasObjectMember(target: Type): boolean {
    if (target.kind != TypeKind.Union) {
      return false;
    }

    return target.parts.some((part) => this.isObjectKind(part));
  }

  private unionCode(target: Type): Code {
    if (this.sharedTag(target) == undefined) {
      return Code.ObjectIntoUnion;
    }

    return Code.ObjectIntoTaggedUnion;
  }

  private sharedTag(target: Type): string | undefined {
    if (target.kind != TypeKind.Union) {
      return undefined;
    }

    const parts = target.parts;
    const front = parts[0];
    if (front == undefined || front.kind != TypeKind.Object) {
      return undefined;
    }

    const tag = front.fields.find((field) =>
      parts.every((part) => this.hasLiteralField(part, field.name)),
    );

    return tag?.name;
  }

  private hasLiteralField(part: Type, name: string): boolean {
    if (part.kind != TypeKind.Object) {
      return false;
    }

    const field = part.fields.find((one) => one.name == name);

    return (
      field != undefined &&
      !field.optional &&
      field.type.kind == TypeKind.Literal
    );
  }

  private jsonCode(source: Type, value: Type): Code {
    if (this.isObjectKind(source) || value.kind == TypeKind.Array) {
      return Code.ObjectIntoJson;
    }
    if (value.kind == TypeKind.Dict) {
      return this.dictionaryCode(value.value);
    }
    if (value.kind == TypeKind.Decimal) {
      return Code.DecimalIntoJson;
    }

    return Code.NotAssignable;
  }

  private numberCode(given: Type, target: Type): Code {
    if (given.kind == TypeKind.Int && this.isNumber(target)) {
      return Code.ConvertExplicitly;
    }
    if (given.kind == TypeKind.Double && target.kind == TypeKind.Int) {
      return Code.RoundThenConvert;
    }
    if (given.kind == TypeKind.Double && target.kind == TypeKind.Decimal) {
      return Code.DoubleIntoDecimal;
    }
    if (given.kind == TypeKind.Decimal && this.isNumber(target)) {
      return Code.DecimalIntoNumber;
    }

    return Code.NotAssignable;
  }

  private dictionaryCode(value: Type): Code {
    const parts = this.definedParts(value);
    const isWide = parts.some(
      (part) => part.kind == TypeKind.Int && part.bits >= kWideBits,
    );
    if (isWide) {
      return Code.WideIntegersIntoJson;
    }

    return Code.NotAssignable;
  }

  private isReported(
    expr: Expr,
    given: Type,
    wanted: Type,
    code: Code,
  ): boolean {
    if (this.isFresh(expr) || this.isCertain(code)) {
      return true;
    }

    const source = this.innerObject(given, wanted);
    const target = this.innerObject(wanted, given);
    const from = this.onlyPart(given);
    const to = this.onlyPart(wanted);
    const isPlain =
      this.isPlainValue(from) ||
      this.isPlainValue(to) ||
      this.isPlainValue(source) ||
      this.isPlainValue(target);

    return isPlain || !this.isWidening(source, target);
  }

  private isUndecided(expr: Expr, wanted: Type): boolean {
    const goal = this.definedType(wanted);
    if (goal.kind == TypeKind.Operation) {
      return true;
    }

    return goal.kind == TypeKind.Never && expr.kind == ExprKind.Name;
  }

  private isWidening(source: Type, target: Type): boolean {
    if (!this.isObjectKind(target)) {
      return false;
    }

    return this.isObjectKind(source) || source.kind == TypeKind.Union;
  }

  private isFresh(expr: Expr): boolean {
    switch (expr.kind) {
      case ExprKind.ArrayLit:
      case ExprKind.ObjectLit:
        return true;
      case ExprKind.Conditional:
        return this.isFresh(expr.thenExpr) && this.isFresh(expr.elseExpr);
      default:
        return false;
    }
  }

  private isCertain(code: Code): boolean {
    switch (code) {
      case Code.LiteralNotInstance:
      case Code.TupleNotArray:
      case Code.JsonUnchecked:
      case Code.NotAnObject:
      case Code.ObjectIntoJson:
        return true;
      default:
        return false;
    }
  }

  private innerObject(type: Type, other: Type): Type {
    const inner = this.definedType(type);
    const otherInner = this.definedType(other);
    if (inner.kind == TypeKind.Array && otherInner.kind == TypeKind.Array) {
      return this.innerObject(inner.item, otherInner.item);
    }

    return inner;
  }

  private mismatchWord(
    expr: Expr,
    code: Code,
    target: Type,
    intervals: Interval[],
  ): string {
    switch (code) {
      case Code.LiteralNotInstance:
        return this.text.of(target);
      case Code.ObjectIntoTaggedUnion:
        return this.sharedTag(target) ?? "";
      case Code.ValueOutsideRange:
        return this.rangeCheck(expr, intervals);
      default:
        return this.operandName(expr);
    }
  }

  private mismatchOther(code: Code, holds: string, only: Type): string {
    if (code == Code.LiteralOutsideRange || code == Code.ValueOutsideRange) {
      return holds;
    }

    return this.conversionName(only);
  }

  private isPlainValue(type: Type): boolean {
    switch (type.kind) {
      case TypeKind.Int:
      case TypeKind.Double:
      case TypeKind.Decimal:
      case TypeKind.String:
      case TypeKind.Boolean:
      case TypeKind.Literal:
      case TypeKind.Template:
      case TypeKind.Undefined:
      case TypeKind.Json:
        return true;
      case TypeKind.Union:
        return type.parts.every((part) => this.isPlainValue(part));
      default:
        return false;
    }
  }

  private onlyPart(wanted: Type): Type {
    const parts = this.definedParts(wanted);
    const only = parts[0];
    if (parts.length != 1 || only == undefined) {
      return wanted;
    }

    return only;
  }

  private operandName(expr: Expr): string {
    if (expr.kind == ExprKind.Name) {
      return expr.name;
    }

    return kUnnamedOperand;
  }

  private conversionName(target: Type): string {
    const name = this.text.of(target);
    const head = name.slice(0, 1).toUpperCase();
    const tail = name.slice(1);

    return `${kConversionPrefix}${head}${tail}`;
  }

  private rangeIntervals(given: Type, target: Type): Interval[] {
    const isWhole =
      given.kind == TypeKind.Literal && given.literal == LiteralKind.Int;
    if (!isWhole && !this.isWordInt(given)) {
      return [];
    }

    return this.wholeIntervals(target);
  }

  private isWordInt(type: Type): boolean {
    if (type.kind != TypeKind.Int) {
      return false;
    }

    return type.bits == 64 && !type.unsigned && !type.wraps;
  }

  private wholeIntervals(target: Type): Interval[] {
    if (target.kind != TypeKind.Union) {
      return [];
    }

    const values: Bound[] = [];

    for (const part of target.parts) {
      const value = this.wholeValue(part);
      if (value == undefined) {
        return [];
      }

      values.push(value);
    }

    const intervals = this.intervalsOf(values);
    if (intervals.length > 1 && values.length < kManyLiterals) {
      return [];
    }

    return intervals;
  }

  private rangeText(intervals: Interval[]): string {
    const texts = intervals.map((interval) => this.intervalText(interval));

    return texts.join(kIntervalSeparator);
  }

  private rangeCheck(expr: Expr, intervals: Interval[]): string {
    const name = this.operandName(expr);
    const widest = this.widestInterval(intervals);
    if (widest == undefined) {
      return name;
    }

    const low = widest.low.text;
    const high = widest.high.text;

    return `${name} >= ${low} && ${name} <= ${high}`;
  }

  private widestInterval(intervals: Interval[]): Interval | undefined {
    let widest: Interval | undefined = undefined;

    for (const interval of intervals) {
      const size = interval.high.value - interval.low.value;
      const isWider =
        widest == undefined || widest.high.value - widest.low.value < size;
      if (isWider) {
        widest = interval;
      }
    }

    return widest;
  }

  private isRangeProven(
    expr: Expr,
    given: Type,
    wanted: Type,
    module: int,
  ): boolean {
    if (!this.isWordInt(given)) {
      return false;
    }

    const goal = this.definedType(wanted);
    const intervals = this.wholeIntervals(goal);
    if (intervals.length == 0) {
      return false;
    }

    const value = this.intConstant(expr, given, module);
    if (value == undefined) {
      return true;
    }

    return intervals.some(
      (interval) => interval.low.value <= value && value <= interval.high.value,
    );
  }

  private wholeValue(part: Type): Bound | undefined {
    if (part.kind != TypeKind.Literal || part.literal != LiteralKind.Int) {
      return undefined;
    }

    const value = decimal(part.text);
    if (value.isErr()) {
      return undefined;
    }

    return { value: value.value, text: part.text };
  }

  private intervalsOf(values: Bound[]): Interval[] {
    const intervals: Interval[] = [];

    values.sort((first, second) => this.order(first.value, second.value));

    for (const bound of values) {
      const last = intervals[intervals.length - 1];
      if (last != undefined && last.high.value + 1 >= bound.value) {
        last.high = bound;

        continue;
      }

      intervals.push({ low: bound, high: bound });
    }

    return intervals;
  }

  private order(first: decimal, second: decimal): int {
    if (first < second) {
      return -1;
    }
    if (first > second) {
      return 1;
    }

    return 0;
  }

  private intervalText(interval: Interval): string {
    if (interval.low == interval.high) {
      return interval.low.text;
    }

    return `${interval.low.text} to ${interval.high.text}`;
  }
}
