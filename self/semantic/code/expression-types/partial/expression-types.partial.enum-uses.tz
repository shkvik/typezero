import { ExpressionTypes } from "../expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { IndexExpr } from "../../../../program/ast/types/ast.types.expressions.tz";
import {
  LiteralKind,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import { EnumHome } from "../../../types/type-resolver/types/type-resolver.types.tz";

partial class ExpressionTypes {
  private enumIndexed(expr: IndexExpr, home: EnumHome, module: int): Type {
    const whole = this.store.integer(64, false);
    const index = this.typed(expr.index, whole, module);
    const error = this.store.plain(TypeKind.Error);
    if (index.kind == TypeKind.Error) {
      return error;
    }

    const decl = home.decl;
    const values = this.resolver.declaredEnum(home.module, decl);
    if (values.kind != TypeKind.Int) {
      this.report(module, expr.loc, Code.EnumStringIndex, { word: decl.name });

      return error;
    }

    const base = this.apparent(index);
    if (base.kind != TypeKind.Int) {
      this.report(module, expr.index.loc, Code.EnumIndexNotInteger, {
        word: this.text.of(index),
      });

      return error;
    }

    return this.enumNameType(expr, home, whole, module);
  }

  private enumNameType(
    expr: IndexExpr,
    home: EnumHome,
    whole: Type,
    module: int,
  ): Type {
    const value = this.intConstant(expr.index, whole, module);
    const text = this.store.plain(TypeKind.String);
    if (value == undefined) {
      const nothing = this.store.plain(TypeKind.Undefined);

      return this.store.unionOf([text, nothing]);
    }

    const name = this.memberNamed(home, value);
    if (name == undefined) {
      return this.store.plain(TypeKind.Undefined);
    }

    return this.store.literal(LiteralKind.String, name);
  }

  private memberNamed(home: EnumHome, value: decimal): string | undefined {
    let found: string | undefined = undefined;

    for (const member of home.decl.members) {
      const step = this.resolver.enumMember(home.module, home.decl, member.name);
      const number = step?.number;
      if (number != undefined && decimal(number) == value) {
        found = member.name;
      }
    }

    return found;
  }
}
