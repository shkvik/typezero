  { bits: 8, unsigned: false, highest: 127, lowest: 128 },
  { bits: 16, unsigned: false, highest: 32767, lowest: 32768 },
  { bits: 32, unsigned: false, highest: 2147483647, lowest: 2147483648 },
  {
    bits: 64,
    unsigned: false,
