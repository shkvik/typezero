  { bits: 8, unsigned: true, highest: 255, lowest: 0 },
  { bits: 16, unsigned: true, highest: 65535, lowest: 0 },
  { bits: 32, unsigned: true, highest: 4294967295, lowest: 0 },
  { bits: 64, unsigned: true, highest: 18446744073709551615, lowest: 0 },
