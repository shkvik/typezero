} from "../../../diagnostic/types/message.types.tz";
import {
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../program/ast/types/ast.types.functions.tz";
import { Program } from "../../../program/module/types/module.types.tz";
import { ModuleScopes } from "../../../program/scopes/types/scopes.types.tz";
import { TypeStore } from "../../../program/type/type-store/type-store.tz";
import { TypeText } from "../../../program/type/type-text/type-text.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import { TypeRelation } from "../../types/type-relation/type-relation.tz";
import { TypeResolver } from "../../types/type-resolver/type-resolver.tz";
import {
  FunctionDoor,
  GeneratorFrame,
  GuardSummary,
  InitFrame,
  InitializingVariable,
  StalledFunction,
  StaticOwner,
  SuperFrame,
  ThisPlace,
  ValueRecord,
  ValueTarget,
  VariableDoor,
} from "./types/expression-types.types.tz";
import { TypeQuestions } from "../../types/type-questions/type-questions.tz";
import { TruthRules } from "../../flow/truth-rules/truth-rules.tz";
import { TypeUnifier } from "../../types/type-unifier/type-unifier.tz";
import { ModuleQuestions } from "../../declaration/module-questions/module-questions.tz";
import { LiteralRanges } from "../../types/literal-ranges/literal-ranges.tz";
import { MismatchRules } from "../../types/mismatch-rules/mismatch-rules.tz";
import { TypeOfRules } from "../../types/type-of-rules/type-of-rules.tz";
import { SourceTexts } from "../source-texts/source-texts.tz";
import { ConcatenationRules } from "../concatenation-rules/concatenation-rules.tz";
import { IntegerMath } from "../integer-math/integer-math.tz";
import { TypeParts } from "../../types/type-parts/type-parts.tz";
import { ExpressionShapes } from "../expression-shapes/expression-shapes.tz";
import { ArrayRules } from "../array-rules/array-rules.tz";
import { OverloadRules } from "../overload-rules/overload-rules.tz";
import { OperatorRules } from "../operator-rules/operator-rules.tz";
import { ComparisonRules } from "../comparison-rules/comparison-rules.tz";
import { LogicRules } from "../logic-rules/logic-rules.tz";
import { CallbackRules } from "../callback-rules/callback-rules.tz";
import { CallRules } from "../call-rules/call-rules.tz";
import { DictionaryRules } from "../dictionary-rules/dictionary-rules.tz";
import { FunctionRules } from "../function-rules/function-rules.tz";
import { LiteralRules } from "../literal-rules/literal-rules.tz";
import { IndexRules } from "../index-rules/index-rules.tz";
import { ObjectRules } from "../object-rules/object-rules.tz";
import { DecoratorRules } from "../decorator-rules/decorator-rules.tz";
import { ClassRules } from "../class-rules/class-rules.tz";
import { StatementRules } from "../statement-rules/statement-rules.tz";
import { NarrowingRules } from "../../flow/narrowing-rules/narrowing-rules.tz";
import { BoundRules } from "../../flow/bound-rules/bound-rules.tz";
import { FlowRules } from "../../flow/flow-rules/flow-rules.tz";
import { GenericRules } from "../../generics/generic-rules/generic-rules.tz";
import { DateRules } from "../../library/date-rules/date-rules.tz";
import { DecimalRules } from "../../library/decimal-rules/decimal-rules.tz";
import { ResultRules } from "../../library/result-rules/result-rules.tz";
import { LibraryRules } from "../../library/library-rules/library-rules.tz";

export class ExpressionTypes {
  private readonly store: TypeStore;
  private readonly text: TypeText;
  private readonly relation: TypeRelation;
  private readonly types: TypeQuestions;
  private readonly modules: ModuleQuestions;
  private readonly ranges: LiteralRanges;
  private readonly sources: SourceTexts;
  private readonly integers: IntegerMath;
  private readonly unifier: TypeUnifier;
  private readonly truth: TruthRules;
  private readonly mismatches: MismatchRules;
  private readonly typeOfs: TypeOfRules;
  private readonly concatenations: ConcatenationRules;
  private readonly parts: TypeParts;
  private readonly shapes: ExpressionShapes;
  private readonly arrays: ArrayRules;
  private readonly operators: OperatorRules;
  private readonly logic: LogicRules;
  private readonly dictionaries: DictionaryRules;
  private readonly functions: FunctionRules;
  private readonly literals: LiteralRules;
  private readonly indexes: IndexRules;
  private readonly objects: ObjectRules;
  private readonly calls: CallRules;
  private readonly callbacks: CallbackRules;
  private readonly classes: ClassRules;
  private readonly overloads: OverloadRules;
  private readonly decorators: DecoratorRules;
  private readonly narrowings: NarrowingRules;
  private readonly bounds: BoundRules;
  private readonly flows: FlowRules;
  private readonly generics: GenericRules;
  private readonly dates: DateRules;
  private readonly decimals: DecimalRules;
  private readonly comparisons: ComparisonRules;
  private readonly statements: StatementRules;
  private readonly results: ResultRules;
  private readonly library: LibraryRules;
  private readonly resolver: TypeResolver;
  private readonly program: Program;
  private readonly scopes: Map<int, ModuleScopes>;
  private readonly records: Map<int, ValueRecord>;
  private readonly doors: Map<string, VariableDoor>;
  private readonly folded: Map<Expr, decimal>;
  private readonly functionDoors: Map<string, FunctionDoor>;
  private readonly paramTypes: Map<string, Type>;
  private readonly checkedModules: Set<int>;
  private readonly coveredSwitches: Set<string>;
  private readonly recursions: string[];
  private readonly assumedCalls: string[];
  private readonly doorOrder: string[];
  private readonly functionOrder: string[];
  private readonly walking: string[];
  private readonly calledBack: Set<string>;
  private readonly stalled: Map<string, StalledFunction[]>;
  private readonly globalValues: Map<string, ValueTarget>;
  private readonly overloadedGlobals: Set<string>;
  private facts: Map<string, Type>;
  private shortCircuits: int;
  private quiet: int;
  private muted: int;
  private readonly lenientCalls: Set<Expr>;
  private readonly constKeys: Set<string>;
  private readonly selves: Type[];
  private readonly literalOwners: Map<FunctionDecl, Type>;
  private readonly ownerClasses: StaticOwner[];
  private readonly visited: Set<Expr>;
  private readonly thisPlaces: ThisPlace[];
  private readonly currentMethods: FunctionDecl[];
  private readonly superFrames: SuperFrame[];
  private readonly openFunctions: FunctionDecl[];
  private readonly initFrames: InitFrame[];
  private readonly thisObjects: Set<Expr>;
  private readonly writtenTargets: Set<Expr>;
  private readonly selfCalls: Map<FunctionDecl, MemberExpr[]>;
  private readonly closureTypes: Map<Expr, Type>;
  private readonly argumentExprs: Set<Expr>;
  private readonly tupleCalls: Set<Expr>;
  private readonly initializing: InitializingVariable[];
  private readonly generatorFrames: GeneratorFrame[];
  private readonly guardSummaries: Map<string, GuardSummary>;
  private positionMask: boolean[];
  private readonly resultsChecked: Set<int>;
  private positionMethod: string;
  private readonly unusedYields: Set<Expr>;
  private readonly yieldOf: Map<Expr, int>;
  private writtenFields?: Set<string>;

  public constructor(
    store: TypeStore,
    resolver: TypeResolver,
    program: Program,
    resolved: ModuleScopes[],
  ) {
    const relation = new TypeRelation(store);
    const text = new TypeText(store);
    const types = new TypeQuestions(store, relation);
    const modules = new ModuleQuestions(program);
    const ranges = new LiteralRanges();
    const sources = new SourceTexts(program);
    const integers = new IntegerMath();
    const unifier = new TypeUnifier(store, relation, types, resolver);
    const truth = new TruthRules(store, text, relation, types);
    const mismatches = new MismatchRules(
      text,
      relation,
      types,
      modules,
      ranges,
    );
    const typeOfs = new TypeOfRules(store, text, relation, types);
    const concatenations = new ConcatenationRules(
      text,
      relation,
      types,
      sources,
    );
    const parts = new TypeParts(store);
    const shapes = new ExpressionShapes();
    const arrays = new ArrayRules(
      store,
      relation,
      types,
      unifier,
      shapes,
      text,
    );
    const operators = new OperatorRules(
      store,
      text,
      relation,
      types,
      sources,
      unifier,
      mismatches,
      shapes,
      integers,
    );
    const logic = new LogicRules(
      store,
      types,
      truth,
      shapes,
      sources,
      text,
      unifier,
    );
    const dictionaries = new DictionaryRules(
      store,
      types,
      modules,
      sources,
      text,
    );
    const functions = new FunctionRules(store, relation, types, unifier, text);
    const literals = new LiteralRules(store, types, text);
    const indexes = new IndexRules(store, text, types);
    const objects = new ObjectRules(
      store,
      text,
      relation,
      types,
      sources,
      unifier,
      typeOfs,
    );
    const calls = new CallRules(store, types, parts, text, objects);
    const callbacks = new CallbackRules(
      store,
      types,
      truth,
      calls,
      text,
      relation,
    );
    const classes = new ClassRules(text, types, modules, relation, store);
    const overloads = new OverloadRules(
      text,
      types,
      sources,
      mismatches,
      classes,
    );
    const decorators = new DecoratorRules(types, overloads, classes);
    const narrowings = new NarrowingRules(
      store,
      text,
      relation,
      types,
      modules,
      typeOfs,
    );
    const bounds = new BoundRules(store);
    const flows = new FlowRules(store, relation, types, text, shapes);
    const generics = new GenericRules(
      store,
      types,
      modules,
      unifier,
      parts,
      calls,
      literals,
      text,
    );
    const dates = new DateRules(types, text, calls, sources, operators, store);
    const decimals = new DecimalRules(store, types, sources, text, operators);
    const comparisons = new ComparisonRules(
      types,
      unifier,
      shapes,
      store,
      relation,
      operators,
      decimals,
    );
    const statements = new StatementRules(
      store,
      relation,
      types,
      modules,
      text,
      comparisons,
      functions,
      sources,
      indexes,
    );
    const results = new ResultRules(store, types, unifier, bounds, text);
    const library = new LibraryRules(types, modules, sources, mismatches);

    this.store = store;
    this.text = text;
    this.relation = relation;
    this.types = types;
    this.modules = modules;
    this.ranges = ranges;
    this.sources = sources;
    this.integers = integers;
    this.unifier = unifier;
    this.truth = truth;
    this.mismatches = mismatches;
    this.typeOfs = typeOfs;
    this.concatenations = concatenations;
    this.parts = parts;
    this.shapes = shapes;
    this.arrays = arrays;
    this.operators = operators;
    this.logic = logic;
    this.dictionaries = dictionaries;
    this.functions = functions;
    this.literals = literals;
    this.indexes = indexes;
    this.objects = objects;
    this.calls = calls;
    this.callbacks = callbacks;
    this.classes = classes;
    this.overloads = overloads;
    this.decorators = decorators;
    this.narrowings = narrowings;
    this.bounds = bounds;
    this.flows = flows;
    this.generics = generics;
    this.dates = dates;
    this.decimals = decimals;
    this.comparisons = comparisons;
    this.statements = statements;
    this.results = results;
    this.library = library;
    this.resolver = resolver;
    this.program = program;
    this.scopes = new Map<int, ModuleScopes>();
    this.records = new Map<int, ValueRecord>();
    this.doors = new Map<string, VariableDoor>();
    this.folded = new Map<Expr, decimal>();
    this.functionDoors = new Map<string, FunctionDoor>();
    this.paramTypes = new Map<string, Type>();
    this.checkedModules = new Set<int>();
    this.coveredSwitches = new Set<string>();
    this.recursions = [];
    this.assumedCalls = [];
    this.doorOrder = [];
    this.functionOrder = [];
    this.walking = [];
    this.calledBack = new Set<string>();
    this.stalled = new Map<string, StalledFunction[]>();
    this.globalValues = new Map<string, ValueTarget>();
    this.overloadedGlobals = new Set<string>();
    this.facts = new Map<string, Type>();
    this.shortCircuits = 0;
    this.quiet = 0;
    this.muted = 0;
    this.lenientCalls = new Set<Expr>();
    this.constKeys = new Set<string>();
    this.selves = [];
    this.literalOwners = new Map<FunctionDecl, Type>();
    this.ownerClasses = [];
    this.visited = new Set<Expr>();
    this.thisPlaces = [];
    this.currentMethods = [];
    this.superFrames = [];
    this.openFunctions = [];
    this.initFrames = [];
    this.thisObjects = new Set<Expr>();
    this.writtenTargets = new Set<Expr>();
    this.selfCalls = new Map<FunctionDecl, MemberExpr[]>();
    this.closureTypes = new Map<Expr, Type>();
    this.argumentExprs = new Set<Expr>();
    this.tupleCalls = new Set<Expr>();
    this.initializing = [];
    this.generatorFrames = [];
    this.guardSummaries = new Map<string, GuardSummary>();
    this.positionMask = [];
    this.resultsChecked = new Set<int>();
    this.positionMethod = "";
    this.unusedYields = new Set<Expr>();
    this.yieldOf = new Map<Expr, int>();

    for (const scopes of resolved) {
      this.scopes.set(scopes.module.id, scopes);
    }
  }

  public problems(module: int): SourceError[] {
    this.unreadResultsCheck(module);

    const record = this.records.get(module);
    if (record == undefined) {
      return [];
    }

    return record.errors;
  }

  public variable(module: int, loc: int): Type {
    const door = this.door(module, loc);
    if (door == undefined) {
      return this.store.plain(TypeKind.Error);
    }

    return door.type;
  }

  private typed(expr: Expr, wanted: Type | undefined, module: int): Type {
    this.visited.add(expr);

    const literal = this.literalOf(expr, module);
    if (literal != undefined) {
      return this.literalTyped(expr, literal, wanted, module);
    }

    switch (expr.kind) {
      case ExprKind.Undefined:
        return this.store.plain(TypeKind.Undefined);
      case ExprKind.Template:
        return this.templateTyped(expr, wanted, module);
      case ExprKind.ArrayLit:
        return this.arrayTyped(expr, wanted, module);
      case ExprKind.ObjectLit:
        return this.objectTyped(expr, wanted, module);
      case ExprKind.Name:
        return this.named(expr, wanted, module);
      case ExprKind.Binary:
        return this.binaryTyped(expr, wanted, module);
      case ExprKind.Unary:
        return this.unaryTyped(expr, wanted, module);
      case ExprKind.Conditional:
        return this.conditionalTyped(expr, wanted, module);
      case ExprKind.Member:
        if (this.holderValueCheck(expr, wanted, module)) {
          return this.store.plain(TypeKind.Error);
        }

        return this.memberTyped(expr, module);
      case ExprKind.Index:
        return this.indexTyped(expr, module);
      case ExprKind.Await:
        return this.awaitTyped(expr, module);
      case ExprKind.OptionalChain:
        return this.chainTyped(expr, wanted, module);
      case ExprKind.Call: {
        this.noteArguments(expr.args);
        this.dictKeysCheck(expr, module);
        this.objectKeysCheck(expr, module);
        this.booleanCallCheck(expr, module);
        this.numberCallCheck(expr, module);
        this.timerArgumentsCheck(expr, module);
        this.mathOneTypeCheck(expr, module);
        this.uncaughtCheck(expr, module);

        if (this.legacyCallCheck(expr, module)) {
          return this.store.plain(TypeKind.Error);
        }

        const type = this.callTyped(expr, wanted, module);

        if (this.isOwnCall(expr.callee, module)) {
          this.forgetCalledFields();
        }

        this.walkedArguments(expr.args, module);

        return type;
      }
      case ExprKind.New: {
        const type = this.newTyped(expr, wanted, module);

        this.walkedArguments(expr.args, module);

        return type;
      }
      case ExprKind.Class:
        return this.classExprTyped(expr, module);
      case ExprKind.Function:
        this.genericClosureCheck(expr, module);
        this.iterablePlaceCheck(expr.fn, module);

        return this.closureTyped(expr, wanted, module);
      case ExprKind.Assign:
        return this.assignedTyped(expr, module);
      case ExprKind.Update:
        return this.updatedTyped(expr.target, module);
      case ExprKind.Yield:
        return this.yieldTyped(expr, module);
      case ExprKind.Cast:
        return this.castTyped(expr, module);
      default:
        return this.childrenTyped(expr, module);
    }
  }

  private checked(expr: Expr, wanted: Type, module: int, place: string): Type {
    const given = this.typed(expr, wanted, module);

    this.coerce(expr, given, wanted, module, place);

    return given;
  }

  private coerce(
    expr: Expr,
    given: Type,
    wanted: Type,
    module: int,
    place: string,
  ): void {
    if (this.relation.converts(given, wanted)) {
      return;
    }
    if (this.literalTarget(expr, given, wanted, module) != undefined) {
      return;
    }
    if (this.isRangeProven(expr, given, wanted, module)) {
      return;
    }
    if (this.functions.isFunctionAdapting(expr, given, wanted, module)) {
      return;
    }
    if (this.mismatches.isUndecided(wanted)) {
      return;
    }
    if (this.mismatches.isIteratorFromClass(given, wanted)) {
      return;
    }

    this.mismatch(expr, given, wanted, module, place);
  }

  private reportFound(module: int, error: SourceError | undefined): void {
    if (error != undefined) {
      this.report(module, error.loc, error.code, error.details);
    }
  }

  private reportAll(module: int, errors: SourceError[]): void {
    for (const error of errors) {
      this.report(module, error.loc, error.code, error.details);
    }
  }

  private report(module: int, loc: int, code: Code, details: Details): void {
    const record = this.record(module);
    const key = `${loc} ${code}`;

    if (this.quiet > 0) {
      this.muted += 1;

      return;
    }
    if (record == undefined || record.reported.has(key)) {
      return;
    }

    record.reported.add(key);
    record.errors.push({ code, loc, details });
  }
}
