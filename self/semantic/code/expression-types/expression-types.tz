export class ExpressionTypes {
  private readonly store: TypeStore;
  private readonly text: TypeText;
  private readonly relation: TypeRelation;
  private readonly types: TypeQuestions;
  private readonly modules: ModuleQuestions;
  private readonly ranges: LiteralRanges;
  private readonly sources: SourceTexts;
  private readonly integers: IntegerMath;
  private readonly unifier: TypeUnifier;
  private readonly truth: TruthRules;
  private readonly mismatches: MismatchRules;
  private readonly typeOfs: TypeOfRules;
  private readonly concatenations: ConcatenationRules;
  private readonly parts: TypeParts;
  private readonly shapes: ExpressionShapes;
  private readonly arrays: ArrayRules;
  private readonly operators: OperatorRules;
  private readonly logic: LogicRules;
  private readonly dictionaries: DictionaryRules;
  private readonly functions: FunctionRules;
  private readonly literals: LiteralRules;
  private readonly indexes: IndexRules;
  private readonly objects: ObjectRules;
  private readonly calls: CallRules;
  private readonly callbacks: CallbackRules;
  private readonly classes: ClassRules;
  private readonly overloads: OverloadRules;
  private readonly decorators: DecoratorRules;
  private readonly narrowings: NarrowingRules;
  private readonly bounds: BoundRules;
  private readonly flows: FlowRules;
  private readonly generics: GenericRules;
  private readonly dates: DateRules;
  private readonly decimals: DecimalRules;
  private readonly comparisons: ComparisonRules;
  private readonly statements: StatementRules;
  private readonly results: ResultRules;
  private readonly library: LibraryRules;
  private readonly assignments: AssignmentRules;
  private readonly destinations: DestinationRules;
  private readonly proofs: ProofRules;
  private readonly intervals: IntervalMath;
  private readonly bytes: BytesRules;
  private readonly embedded: EmbeddedFiles;
  private readonly byteNumbers: ByteNumberRules;
  private readonly classValues: ClassValueRules;
  private readonly overrides: ClassOverrideRules;
  private readonly objectMembers: ObjectMemberRules;
  private readonly genericCalls: GenericCallRules;
  private readonly byteSources: ByteSourceRules;
  private readonly textCoders: TextCoderRules;
  private readonly intl: IntlRules;
  private readonly fs: FsRules;
  private readonly process: ProcessRules;
  private readonly child: ChildRules;
  private readonly weakRefs: WeakRefRules;
  private readonly regexes: RegexRules;
  private readonly crypto: CryptoRules;
  private readonly foreign: ForeignRules;
  private readonly nodeValues: NodeValueRules;
  private readonly jsonTexts: JsonText;
  private readonly collector: ExpressionCollector;
  private readonly disposes: DisposeRules;
  private readonly intlDates: IntlDateRules;
  private readonly fetches: FetchRules;
  private readonly events: EventRules;
  private readonly resolver: TypeResolver;
  private readonly errors: ErrorLog;
  private memberObjects: Set<Expr>;
  private walkedClasses: Set<ClassDecl>;
  private staticFields: ClassField[];
  private readonly program: Program;
  private scopes: Map<int, ModuleScopes>;
  private records: Map<int, ValueRecord>;
  private doors: Map<string, VariableDoor>;
  private functionDoors: Map<string, FunctionDoor>;
  private paramTypes: Map<string, Type>;
  private checkedModules: Set<int>;
  private coveredSwitches: Set<string>;
  private recursions: string[];
  private assumedCalls: string[];
  private doorOrder: string[];
  private functionOrder: string[];
  private walking: string[];
  private calledBack: Set<string>;
  private stalled: Map<string, StalledFunction[]>;
  private globalValues: Map<string, ValueTarget>;
  private overloadedGlobals: Set<string>;
  private facts: Map<string, Type>;
  private isFinished: boolean;
  private lateWork: string[];
  private arrowFields: Map<string, Type>;
  private shortCircuits: int;
  private lenientCalls: Set<Expr>;
  private constKeys: Set<string>;
  private selves: Type[];
  private literalOwners: Map<FunctionDecl, Type>;
  private ownerClasses: StaticOwner[];
  public readonly answers: ExpressionAnswers;
  private thisPlaces: ThisPlace[];
  private currentMethods: FunctionDecl[];
  private superFrames: SuperFrame[];
  private openFunctions: FunctionDecl[];
  private initFrames: InitFrame[];
  private thisObjects: Set<Expr>;
  private writtenTargets: Set<Expr>;
  private selfCalls: Map<FunctionDecl, MemberExpr[]>;
  private closureTypes: Map<Expr, Type>;
  private argumentExprs: Set<Expr>;
  private tupleCalls: Set<Expr>;
  private initializing: InitializingVariable[];
  private generatorFrames: GeneratorFrame[];
  private guardSummaries: Map<string, GuardSummary>;
  private positionMask: boolean[];
  private resultsChecked: Set<int>;
  private positionMethod: string;
  private unusedYields: Set<Expr>;
  private yieldOf: Map<Expr, int>;
  private indexParams: Set<string>;
  private elementRanges: Map<string, ValueRange>;
  private fixedLengths: Set<string>;
  private fixedCounts: Map<string, decimal>;
  private requirements: Map<int, Requirement[]>;
  private pendingCalls: PendingCall[];
  private metadataRecords: Map<string, Type>;
  private callChanged: Map<int, string[]>;
  private readonly eventMarks: EventMarks;
  private constructorCasts: ConstructorCast[];
  private constructorWidenings: Map<int, Type[]>;
  private reflectedNews: ReflectedNew[];
  private ownedCalls: Map<string, PendingCall[]>;
  private writtenFields?: Set<string>;
  private methodParts: Map<FunctionDecl, ClassDecl>;
  private partHomes: Map<ClassDecl, int>;
  private unsafeUsed: Set<FunctionDecl>;
  private typeArguments: Map<string, readonly Type[]>;

  public constructor(
    store: TypeStore,
    resolver: Own<TypeResolver>,
    program: Own<Program>,
    resolved: Read<ModuleScopes[]>,
  ) {
    const relation = new TypeRelation(store);
    const text = new TypeText(store);
    const types = new TypeQuestions(store, relation);
    const modules = new ModuleQuestions(program);
    const ranges = new LiteralRanges();
    const sources = new SourceTexts(program);
    const integers = new IntegerMath();
    const unifier = new TypeUnifier(store, relation, types, resolver);
    const truth = new TruthRules(store, text, relation, types);
    const mismatches = new MismatchRules(
      text,
      relation,
      types,
      modules,
      ranges,
    );
    const typeOfs = new TypeOfRules(store, text, relation, types);
    const concatenations = new ConcatenationRules(
      text,
      relation,
      types,
      sources,
    );
    const parts = new TypeParts(store);
    const shapes = new ExpressionShapes();
    const arrays = new ArrayRules(
      store,
      relation,
      types,
      unifier,
      shapes,
      text,
    );
    const operators = new OperatorRules(
      store,
      text,
      relation,
      types,
      sources,
      unifier,
      mismatches,
      shapes,
      integers,
    );
    const logic = new LogicRules(
      store,
      types,
      truth,
      shapes,
      sources,
      text,
      unifier,
    );
    const dictionaries = new DictionaryRules(
      store,
      types,
      modules,
      sources,
      text,
    );
    const functions = new FunctionRules(store, relation, types, unifier, text);
    const literals = new LiteralRules(store, types, text);
    const indexes = new IndexRules(store, text, types);
    const objects = new ObjectRules(store, text, relation, types, unifier);
    const calls = new CallRules(store, types, parts, text, objects);
    const callbacks = new CallbackRules(
      store,
      types,
      truth,
      calls,
      text,
      relation,
    );
    const classes = new ClassRules(text, types);
    const overloads = new OverloadRules(
      text,
      types,
      sources,
      mismatches,
      classes,
    );
    const decorators = new DecoratorRules(types, overloads, classes);
    const narrowings = new NarrowingRules(
      store,
      text,
      relation,
      types,
      modules,
      typeOfs,
    );
    const bounds = new BoundRules(store);
    const flows = new FlowRules(store, relation, types, text, shapes);
    const generics = new GenericRules(
      store,
      types,
      unifier,
      parts,
      calls,
      literals,
    );
    const dates = new DateRules(types, text, calls, sources, operators, store);
    const decimals = new DecimalRules(store, types, sources, text, operators);
    const comparisons = new ComparisonRules(
      types,
      unifier,
      shapes,
      store,
      relation,
      operators,
      decimals,
    );
    const statements = new StatementRules(
      store,
      relation,
      types,
      modules,
      text,
      comparisons,
      functions,
      sources,
      indexes,
    );
    const results = new ResultRules(store, types, unifier, bounds, text);
    const library = new LibraryRules(types, modules, sources, mismatches);
    const assignments = new AssignmentRules(text, types, sources, mismatches);
    const destinations = new DestinationRules();
    const proofs = new ProofRules(text);
    const intervals = new IntervalMath(integers);
    const bytes = new BytesRules(text, types, modules);
    const embedded = new EmbeddedFiles();
    const byteNumbers = new ByteNumberRules(types, modules, integers);
    const classValues = new ClassValueRules(
      text,
      types,
      modules,
      store,
      classes,
    );
    const overrides = new ClassOverrideRules(text, relation, classes);
    const objectMembers = new ObjectMemberRules(
      store,
      text,
      relation,
      types,
      sources,
      typeOfs,
    );
    const genericCalls = new GenericCallRules(modules, parts, text, generics);
    const byteSources = new ByteSourceRules(
      text,
      types,
      bytes,
      byteNumbers,
      modules,
    );
    const textCoders = new TextCoderRules(text, types, byteSources);
    const intl = new IntlRules(text, types);
    const fs = new FsRules(text, types, byteSources);
    const process = new ProcessRules();
    const child = new ChildRules(text);
    const weakRefs = new WeakRefRules(text, types, modules);
    const regexes = new RegexRules(store, text, types);
    const crypto = new CryptoRules(text, types, modules, byteSources);
    const foreign = new ForeignRules(
      program,
      text,
      types,
      modules,
      byteSources,
    );
    const nodeValues = new NodeValueRules();
    const jsonTexts = new JsonText();
    const collector = new ExpressionCollector();
    const disposes = new DisposeRules(collector);
    const intlDates = new IntlDateRules(text, intl);
    const fetches = new FetchRules();
    const events = new EventRules(store, text);

    this.store = store;
    this.text = text;
    this.relation = relation;
    this.types = types;
    this.modules = modules;
    this.ranges = ranges;
    this.sources = sources;
    this.integers = integers;
    this.unifier = unifier;
    this.truth = truth;
    this.mismatches = mismatches;
    this.typeOfs = typeOfs;
    this.concatenations = concatenations;
    this.parts = parts;
    this.shapes = shapes;
    this.arrays = arrays;
    this.operators = operators;
    this.logic = logic;
    this.dictionaries = dictionaries;
    this.functions = functions;
    this.literals = literals;
    this.indexes = indexes;
    this.objects = objects;
    this.calls = calls;
    this.callbacks = callbacks;
    this.classes = classes;
    this.overloads = overloads;
    this.decorators = decorators;
    this.narrowings = narrowings;
    this.bounds = bounds;
    this.flows = flows;
    this.generics = generics;
    this.dates = dates;
    this.decimals = decimals;
    this.comparisons = comparisons;
    this.statements = statements;
    this.results = results;
    this.library = library;
    this.assignments = assignments;
    this.destinations = destinations;
    this.proofs = proofs;
    this.intervals = intervals;
    this.bytes = bytes;
    this.embedded = embedded;
    this.byteNumbers = byteNumbers;
    this.classValues = classValues;
    this.overrides = overrides;
    this.objectMembers = objectMembers;
    this.genericCalls = genericCalls;
    this.byteSources = byteSources;
    this.textCoders = textCoders;
    this.intl = intl;
    this.fs = fs;
    this.process = process;
    this.child = child;
    this.weakRefs = weakRefs;
    this.regexes = regexes;
    this.crypto = crypto;
    this.foreign = foreign;
    this.nodeValues = nodeValues;
    this.jsonTexts = jsonTexts;
    this.collector = collector;
    this.disposes = disposes;
    this.intlDates = intlDates;
    this.fetches = fetches;
    this.events = events;
    this.resolver = resolver;
    this.errors = new ErrorLog();
    this.memberObjects = new Set<Expr>();
    this.walkedClasses = new Set<ClassDecl>();
    this.staticFields = [];
    this.program = program;
    this.scopes = new Map<int, ModuleScopes>();
    this.records = new Map<int, ValueRecord>();
    this.doors = new Map<string, VariableDoor>();
    this.functionDoors = new Map<string, FunctionDoor>();
    this.paramTypes = new Map<string, Type>();
    this.checkedModules = new Set<int>();
    this.coveredSwitches = new Set<string>();
    this.recursions = [];
    this.assumedCalls = [];
    this.doorOrder = [];
    this.functionOrder = [];
    this.walking = [];
    this.calledBack = new Set<string>();
    this.stalled = new Map<string, StalledFunction[]>();
    this.globalValues = new Map<string, ValueTarget>();
    this.overloadedGlobals = new Set<string>();
    this.facts = new Map<string, Type>();
    this.isFinished = false;
    this.lateWork = [];
    this.arrowFields = new Map<string, Type>();
    this.shortCircuits = 0;
    this.lenientCalls = new Set<Expr>();
    this.constKeys = new Set<string>();
    this.selves = [];
    this.literalOwners = new Map<FunctionDecl, Type>();
    this.ownerClasses = [];
    this.answers = new ExpressionAnswers();
    this.thisPlaces = [];
    this.currentMethods = [];
    this.superFrames = [];
    this.openFunctions = [];
    this.initFrames = [];
    this.thisObjects = new Set<Expr>();
    this.writtenTargets = new Set<Expr>();
    this.selfCalls = new Map<FunctionDecl, MemberExpr[]>();
    this.closureTypes = new Map<Expr, Type>();
    this.argumentExprs = new Set<Expr>();
    this.tupleCalls = new Set<Expr>();
    this.initializing = [];
    this.generatorFrames = [];
    this.guardSummaries = new Map<string, GuardSummary>();
    this.positionMask = [];
    this.resultsChecked = new Set<int>();
    this.positionMethod = "";
    this.unusedYields = new Set<Expr>();
    this.yieldOf = new Map<Expr, int>();
    this.indexParams = new Set<string>();
    this.elementRanges = new Map<string, ValueRange>();
    this.fixedLengths = new Set<string>();
    this.fixedCounts = new Map<string, decimal>();
    this.requirements = new Map<int, Requirement[]>();
    this.pendingCalls = [];
    this.metadataRecords = new Map<string, Type>();
    this.callChanged = new Map<int, string[]>();
    this.eventMarks = new EventMarks();
    this.constructorCasts = [];
    this.constructorWidenings = new Map<int, Type[]>();
    this.reflectedNews = [];
    this.ownedCalls = new Map<string, PendingCall[]>();
    this.methodParts = new Map<FunctionDecl, ClassDecl>();
    this.partHomes = new Map<ClassDecl, int>();
    this.unsafeUsed = new Set<FunctionDecl>();
    this.typeArguments = new Map<string, readonly Type[]>();

    for (const scopes of resolved) {
      this.scopes.set(scopes.module.id, scopes);
    }

    for (const opened of this.program.modules) {
      for (const part of opened.parts) {
        this.indexPart(part, opened.id);
      }
    }
  }

  public readonly functionDeclAt(
    module: int,
    loc: int,
  ): FunctionDecl | undefined {
    return this.record(module)?.functions.get(loc);
  }

  public finish(): void {
    for (const module of this.program.modules) {
      if (module.isDeclarationOnly) {
        this.declaredFunctionsTyped(module);
      } else {
        this.checkModule(module.id);
      }
    }
    for (const module of this.program.modules) {
      this.moduleChecksDone(module.id);
    }

    this.isFinished = true;
  }

  private declaredFunctionsTyped(module: Read<Module>): void {
    for (const item of module.file.items) {
      if (item.kind == StmtKind.Function) {
        this.functionTyped(module.id, item.loc);
      }
    }
  }

  public readonly lateWorkList(): string[] {
    return this.lateWork.slice();
  }

  private noteLate(kind: string, module: int, loc: int): void {
    if (!this.isFinished) {
      return;
    }

    const name = this.program.modules[module]?.name ?? "";

    this.lateWork.push(`late ${kind} ${name} ${module} ${loc}`);
  }

  public readonly typeArgumentsOf(
    module: int,
    loc: int,
  ): readonly Type[] | undefined {
    return this.typeArguments.get(`${module} ${loc}`);
  }

  private indexPart(part: ClassDecl, module: int): void {
    if (!this.partHomes.has(part)) {
      this.partHomes.set(part, module);
    }

    for (const method of part.methods) {
      if (!this.methodParts.has(method)) {
        this.methodParts.set(method, part);
      }
    }
  }
}
