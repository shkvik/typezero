import { Code } from "../../../../diagnostic/code.tz";
import { SourceError } from "../../../../diagnostic/types/message.types.tz";
import {
  BinaryExpr,
  BinaryOp,
  CallArgument,
  CallExpr,
  Expr,
  Property,
  UnaryOp,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import {
  ClassDecl,
  ClassField,
  EnumDecl,
} from "../../../../program/ast/types/ast.types.classes.tz";
import {
  FunctionDecl,
  Param,
} from "../../../../program/ast/types/ast.types.functions.tz";
import { VarDeclarator } from "../../../../program/ast/types/ast.types.patterns.tz";
import {
  TypeParamDecl,
  TypeRef,
} from "../../../../program/ast/types/ast.types.types.tz";
import { ForOfStmt } from "../../../../program/ast/types/ast.types.statements.tz";
import {
  NameUse,
  SymbolKind,
} from "../../../../program/scopes/types/scopes.types.tz";
import {
  DictKind,
  FunctionParameter,
  FunctionShape,
  InstanceType,
  LiteralKind,
  PlainKind,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import { DoorState } from "../../../types/type-resolver/types/type-resolver.types.tz";

export type DeclaredVariable = {
  readonly decl: VarDeclarator;
  readonly isConst: boolean;
  readonly loop?: ForOfStmt;
};

export type ParamSlot = {
  readonly fn: FunctionDecl;
  readonly param: Param;
};

export type ValueRecord = {
  readonly uses: Map<int, NameUse>;
  readonly variables: Map<int, DeclaredVariable>;
  readonly functions: Map<int, FunctionDecl>;
  readonly params: Map<int, ParamSlot>;
  readonly assigned: Set<int>;
  readonly changes: Expr[];
  readonly enums: Map<int, EnumDecl>;
  readonly classes: Map<int, ClassDecl>;
  readonly destinations: Map<int, Destination[]>;
  readonly owners: FunctionDecl[];
  readonly reported: Set<string>;
  readonly errors: SourceError[];
};

export type NarrowSlot = {
  readonly key: string;
  readonly type: Type;
};

export type TypeOfType = {
  readonly name: string;
  readonly kind: PlainKind | TypeKind.Int;
  readonly bits: int;
  readonly unsigned: boolean;
};

export type ValueTarget = {
  readonly module: int;
  readonly kind: SymbolKind;
  readonly loc: int;
};

export type FunctionDoor = {
  state: DoorState;
  type: Type;
  isAssumed: boolean;
};

export type StalledFunction = {
  readonly fn: FunctionDecl;
  readonly module: int;
};

export type ReturnedValue = {
  readonly value: Expr;
  readonly type: Type;
};

export type FunctionFrame = {
  readonly fn?: FunctionDecl;
  readonly isAsync: boolean;
  readonly result?: Type;
  readonly returns: ReturnedValue[];
  readonly recursive: string[];
  hasEmptyReturn: boolean;
};

export type ParameterShape = {
  readonly params: FunctionParameter[];
  readonly rest: boolean;
  readonly self?: Type;
};

export enum DestinationKind {
  Argument,
  Declared,
  Returned,
}

export type Destination = {
  readonly kind: DestinationKind;
  readonly call?: CallExpr;
  readonly index: int;
  readonly written?: TypeRef;
  readonly fn?: FunctionDecl;
};

export type StaticOwner = {
  readonly decl: ClassDecl;
  readonly module: int;
};

export type ClassMemberEntry = {
  readonly owner: ClassDecl;
  readonly instance: InstanceType;
  readonly field?: ClassField;
  readonly methods: FunctionDecl[];
  readonly isStatic: boolean;
};

export type ClassLookup = {
  readonly isKnown: boolean;
  readonly entry?: ClassMemberEntry;
};

export type ArgumentSlot = {
  readonly expr: Expr;
  readonly spread: boolean;
  readonly element?: Type;
};

export type CallTarget = {
  readonly params: FunctionParameter[];
  readonly rest: boolean;
  readonly loc: int;
  readonly isLenient: boolean;
};

export type LiteralValue = {
  readonly kind: LiteralKind;
  readonly text: string;
  readonly whole: uint64;
  readonly negative: boolean;
};

export type VariableDoor = {
  state: DoorState;
  type: Type;
  given?: Type;
  literal?: LiteralValue;
  constant?: decimal;
  isWhole: boolean;
  texts?: string[];
};

export type IntLimit = {
  readonly bits: int;
  readonly unsigned: boolean;
  readonly highest: uint64;
  readonly lowest: uint64;
};

export type Bound = {
  readonly value: decimal;
  readonly text: string;
};

export type Interval = {
  readonly low: Bound;
  high: Bound;
};

export type ArrayDraft = {
  readonly types: Map<int, Type>;
  readonly spreads: Map<int, Type>;
  seen?: Type;
  hasDecimal: boolean;
};

export type FieldEntry = {
  readonly property: Property;
  readonly name: string;
  readonly value: Expr;
  readonly named: boolean;
};

export type ObjectDraft = {
  readonly entries: FieldEntry[];
  typed: boolean;
  deferred: boolean;
};

export type UnifyAnswer = {
  readonly decided: boolean;
  readonly type?: Type;
};

export type OperandPair = {
  readonly left: Type;
  readonly right: Type;
};

export type OperandHints = {
  readonly left?: Type;
  readonly right?: Type;
  readonly isBitwise: boolean;
  readonly canHint: boolean;
};

export type OperandTexts = {
  readonly left: string;
  readonly right: string;
};

export type NumberConversion = {
  readonly target: Type;
  readonly isLeftConverted: boolean;
};

export type ConcatLink = {
  readonly binary: BinaryExpr;
  readonly left: Type;
  readonly right: Type;
  readonly type: Type;
};

export type ConcatPart = {
  readonly expr: Expr;
  readonly text: string;
  readonly type: Type;
};

export type TemplatePiece = {
  readonly text: string;
  readonly value?: string;
};

export type TemplateText = {
  readonly text: string;
  readonly only: string;
};

export type OperatorText = {
  readonly op: BinaryOp;
  readonly text: string;
};

export type UnaryText = {
  readonly op: UnaryOp;
  readonly text: string;
};

export enum TruthUse {
  Condition,
  Not,
  And,
  Or,
}

export enum TruthProblem {
  None,
  UnionTruthy,
  UnionNumber,
  Json,
  Unknown,
  Result,
  Number,
  Truthy,
}

export enum LogicSide {
  Value,
  Tested,
}

export type TruthCodes = {
  readonly use: TruthUse;
  readonly number: Code;
  readonly fraction: Code;
  readonly maybe: Code;
  readonly json: Code;
  readonly unknown: Code;
  readonly array: Code;
  readonly object: Code;
  readonly function: Code;
};

export type ComparedSide = {
  readonly type: Type;
  readonly tested?: Type;
};

export type ComparedPair = {
  readonly left: ComparedSide;
  readonly right: ComparedSide;
};

export type DictText = {
  readonly dict: DictKind;
  readonly kind: string;
  readonly shown: string;
};

export type SuperFrame = {
  readonly isConstructor: boolean;
  readonly roots: Set<Expr>;
  readonly parent: string;
  isBefore: boolean;
};

export type Linear = {
  readonly term: string;
  readonly offset: decimal;
};

export type BoundEdge = {
  readonly upper: string;
  readonly lower: string;
  readonly room: decimal;
};

export enum BoundSide {
  None,
  Lower,
  Upper,
  Both,
}

export enum ThisPlace {
  Method,
  StaticMethod,
  StaticField,
  Function,
}

export type GenericTarget = {
  readonly name: string;
  readonly params: Type[];
  readonly decls: TypeParamDecl[];
  readonly home: int;
  readonly shape: FunctionShape;
  readonly loc: int;
  readonly typeArgs: TypeRef[];
  readonly isLenient: boolean;
};

export enum CandidateStrength {
  Strong,
  Weak,
  Literal,
}

export type Candidate = {
  readonly index: int;
  readonly type: Type;
  readonly strength: CandidateStrength;
};

export type InferenceSet = {
  readonly params: Type[];
  readonly candidates: Candidate[];
  readonly undefinedSeen: Set<int>;
  readonly visited: Set<string>;
  isWeak: boolean;
  isIntLiteral: boolean;
  isUnmatched: boolean;
};

export enum ArgumentForm {
  Plain,
  Inferred,
  Shape,
  Contextual,
  LiteralText,
}

export type GenericDraft = {
  readonly target: GenericTarget;
  readonly args: CallArgument[];
  readonly wanted?: Type;
  readonly bound: Map<int, Type>;
  readonly given: Map<int, Type>;
  readonly settled: Set<int>;
  readonly literals: int[];
  readonly contextual: int[];
  readonly inference: InferenceSet;
  isInferred: boolean;
};
