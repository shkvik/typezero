import { Code } from "../../../../diagnostic/code.tz";
import {
  CallArgument,
  CallExpr,
  Expr,
  MemberExpr,
  Property,
  UnaryOp,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import {
  ClassDecl,
  ClassField,
  Decorator,
  EnumDecl,
} from "../../../../program/ast/types/ast.types.classes.tz";
import {
  FunctionDecl,
  Param,
} from "../../../../program/ast/types/ast.types.functions.tz";
import { VarDeclarator } from "../../../../program/ast/types/ast.types.patterns.tz";
import {
  TypeParamDecl,
  TypeRef,
} from "../../../../program/ast/types/ast.types.types.tz";
import { ForOfStmt } from "../../../../program/ast/types/ast.types.statements.tz";
import {
  NameUse,
  SymbolKind,
} from "../../../../program/scopes/types/scopes.types.tz";
import {
  FunctionParameter,
  FunctionShape,
  FunctionType,
  InstanceType,
  LiteralKind,
  PlainKind,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import { DoorState } from "../../../types/type-resolver/types/type-resolver.types.tz";

export type DeclaredVariable = {
  readonly decl: VarDeclarator;
  readonly isConst: boolean;
  readonly loop?: ForOfStmt;
};

export type ParamSlot = {
  readonly fn: FunctionDecl;
  readonly param: Param;
};

export type ValueRecord = {
  readonly uses: Map<int, NameUse>;
  readonly hidden: Map<string, HiddenName>;
  readonly variables: Map<int, DeclaredVariable>;
  readonly functions: Map<int, FunctionDecl>;
  readonly params: Map<int, ParamSlot>;
  readonly assigned: Set<int>;
  readonly changes: Expr[];
  readonly enums: Map<int, EnumDecl>;
  readonly classes: Map<int, ClassDecl>;
  readonly destinations: Map<int, Destination[]>;
  readonly owners: FunctionDecl[];
};

export type NarrowSlot = {
  readonly key: string;
  readonly type: Type;
};

export type TypeOfType = {
  readonly name: string;
  readonly kind: PlainKind | TypeKind.Int;
  readonly bits: int;
  readonly unsigned: boolean;
};

export type HiddenName = {
  readonly kind: SymbolKind;
  readonly loc: int;
};

export enum DecimalArgument {
  Decimal,
  Places,
  Digits,
  Base,
  Power,
  Rounding,
}

export enum DecimalResult {
  Number,
  Text,
  Truth,
  Whole,
  List,
}

export type DecimalMethod = {
  readonly name: string;
  readonly least: int;
  readonly most: int;
  readonly args: DecimalArgument[];
  readonly result: DecimalResult;
};

export type DecimalReplacement = {
  readonly name: string;
  readonly use: string;
};

export type CombineDraft = {
  readonly what: string;
  readonly isAll: boolean;
};

export type ResultMethod = {
  readonly name: string;
  readonly count: int;
};

export type SpreadSlot = {
  readonly name: string;
  type: Type;
};

export type ValueTarget = {
  readonly module: int;
  readonly kind: SymbolKind;
  readonly loc: int;
};

export type FunctionDoor = {
  state: DoorState;
  type: Type;
  isAssumed: boolean;
};

export type StalledFunction = {
  readonly fn: FunctionDecl;
  readonly module: int;
};

export type ReturnedValue = {
  readonly value: Expr;
  readonly type: Type;
};

export type FunctionFrame = {
  readonly fn?: FunctionDecl;
  readonly isAsync: boolean;
  readonly result?: Type;
  readonly returns: ReturnedValue[];
  readonly recursive: string[];
  hasEmptyReturn: boolean;
  generator?: GeneratorFrame;
  readonly guard: GuardBuild;
};

export type GuardBuild = {
  whenTrue?: Map<string, Type>;
  whenFalse?: Map<string, Type>;
};

export type GuardSummary = {
  readonly params: string[];
  readonly whenTrue?: Map<string, Type>;
  readonly whenFalse?: Map<string, Type>;
};

export type GeneratorFrame = {
  readonly fn: FunctionDecl;
  readonly yields: ReturnedValue[];
  readonly isOpen: boolean;
  readonly yielded?: Type;
  readonly sent?: Type;
};

export type ParameterShape = {
  readonly params: FunctionParameter[];
  readonly rest: boolean;
  readonly self?: Type;
};

export enum DestinationKind {
  Argument,
  Declared,
  Returned,
  Assigned,
}

export type Destination = {
  readonly kind: DestinationKind;
  readonly call?: CallExpr;
  readonly index: int;
  readonly written?: TypeRef;
  readonly fn?: FunctionDecl;
  readonly value?: Expr;
};

export type StaticOwner = {
  readonly decl: ClassDecl;
  readonly module: int;
};

export type ClassMemberEntry = {
  readonly owner: ClassDecl;
  readonly instance: InstanceType;
  readonly field?: ClassField;
  readonly methods: FunctionDecl[];
  readonly isStatic: boolean;
};

export type ClassLookup = {
  readonly isKnown: boolean;
  readonly entry?: ClassMemberEntry;
};

export type ArgumentSlot = {
  readonly expr: Expr;
  readonly spread: boolean;
  readonly element?: Type;
};

export type RankedVariant = {
  readonly fn: FunctionDecl;
  readonly type: FunctionType;
  ranks: int[];
  isAdapted: boolean;
  failed: int;
};

export type CallTarget = {
  readonly params: FunctionParameter[];
  readonly rest: boolean;
  readonly loc: int;
  readonly isLenient: boolean;
  readonly kind?: CallKind;
  readonly positions?: boolean[];
  readonly method?: string;
  readonly isCounted?: boolean;
  readonly isTagged?: boolean;
};

export enum CallKind {
  Own,
  Library,
  Positional,
  Math,
}

export type LiteralValue = {
  readonly kind: LiteralKind;
  readonly text: string;
  readonly whole: uint64;
  readonly negative: boolean;
};

export type VariableDoor = {
  state: DoorState;
  type: Type;
  given?: Type;
  literal?: LiteralValue;
  constant?: decimal;
  isWhole: boolean;
  texts?: string[];
};

export type ArrayDraft = {
  readonly types: Map<int, Type>;
  readonly spreads: Map<int, Type>;
  seen?: Type;
  hasDecimal: boolean;
};

export type FieldEntry = {
  readonly property: Property;
  readonly name: string;
  readonly value: Expr;
  readonly named: boolean;
};

export type ObjectDraft = {
  readonly entries: FieldEntry[];
  typed: boolean;
  deferred: boolean;
};

export type OperandPair = {
  readonly left: Type;
  readonly right: Type;
};

export type OperandHints = {
  readonly left?: Type;
  readonly right?: Type;
  readonly isBitwise: boolean;
  readonly canHint: boolean;
};

export type UnaryText = {
  readonly op: UnaryOp;
  readonly text: string;
};

export enum LogicSide {
  Value,
  Tested,
}

export type NarrowedCode = {
  readonly code: Code;
  readonly narrowed: Code;
};

export type ComparedSide = {
  readonly type: Type;
  readonly tested?: Type;
};

export type ComparedPair = {
  readonly left: ComparedSide;
  readonly right: ComparedSide;
};

export type InitFrame = {
  readonly isConstructor: boolean;
  readonly fn: FunctionDecl;
  readonly decl: ClassDecl;
  readonly isDerived: boolean;
  readonly closures: boolean[];
};

export type OverriddenSite = {
  readonly self: InstanceType;
  readonly children: ClassDecl[];
  readonly visited: Set<FunctionDecl>;
  readonly module: int;
};

export enum ArrayCallback {
  ForEach,
  Map,
  FlatMap,
  Filter,
  Reduce,
  Find,
  FindIndex,
  Test,
  Compare,
}

export type CallbackPlan = {
  readonly kind: ArrayCallback;
  readonly member: MemberExpr;
  readonly array: Type;
  readonly params: Type[];
  isValue: boolean;
};

export type InitializingVariable = {
  readonly key: string;
  readonly depth: int;
};

export type SuperFrame = {
  readonly isConstructor: boolean;
  readonly roots: Set<Expr>;
  readonly parent: string;
  isBefore: boolean;
};

export type Linear = {
  readonly term: string;
  readonly offset: decimal;
};

export type BoundEdge = {
  readonly upper: string;
  readonly lower: string;
  readonly room: decimal;
};

export enum BoundSide {
  None,
  Lower,
  Upper,
  Both,
}

export enum ThisPlace {
  Method,
  StaticMethod,
  StaticField,
  Function,
}

export type GenericTarget = {
  readonly name: string;
  readonly params: Type[];
  readonly decls: TypeParamDecl[];
  readonly home: int;
  readonly shape: FunctionShape;
  readonly loc: int;
  readonly typeArgs: TypeRef[];
  readonly isLenient: boolean;
};

export enum CandidateStrength {
  Strong,
  Weak,
  Literal,
}

export type Candidate = {
  readonly index: int;
  readonly type: Type;
  readonly strength: CandidateStrength;
};

export type InferenceSet = {
  readonly params: Type[];
  readonly candidates: Candidate[];
  readonly undefinedSeen: Set<int>;
  readonly visited: Set<string>;
  isWeak: boolean;
  isIntLiteral: boolean;
  isUnmatched: boolean;
};

export enum ArgumentForm {
  Plain,
  Inferred,
  Shape,
  Contextual,
  LiteralText,
}

export type GenericDraft = {
  readonly target: GenericTarget;
  readonly args: CallArgument[];
  readonly wanted?: Type;
  readonly bound: Map<int, Type>;
  readonly given: Map<int, Type>;
  readonly settled: Set<int>;
  readonly literals: int[];
  readonly contextual: int[];
  readonly inference: InferenceSet;
  isInferred: boolean;
};

export type DateFieldValues = {
  readonly args: CallArgument[];
  readonly first: int;
  readonly setter: string;
  readonly values: (int | undefined)[];
};

export type DateStatic = {
  readonly name: string;
  readonly example: string;
};

export type DateSetter = {
  readonly name: string;
  readonly first: int;
};

export enum DecoratorPlace {
  Class,
  Field,
  Method,
  Parameter,
}

export type DecoratorUse = {
  readonly decorator: Decorator;
  readonly param: int;
};

export type DecorateRun = {
  readonly decl: ClassDecl;
  readonly field?: ClassField;
  readonly method?: FunctionDecl;
  readonly uses: DecoratorUse[];
  readonly place: DecoratorPlace;
  readonly isStatic: boolean;
  readonly at: int;
};

export type DecoratedName = {
  readonly name: string;
  readonly loc: int;
  readonly isStatic: boolean;
  readonly decorators: string[];
};

export type DecoratorPlaceText = {
  readonly place: DecoratorPlace;
  readonly noun: string;
  readonly given: int;
  readonly args: string;
};

export enum RequirementKind {
  Text,
  Compare,
  Sort,
  Unused,
  Follows,
  Construct,
  LaterCapture,
  StaticCapture,
}

export type Requirement = {
  readonly kind: RequirementKind;
  readonly word: string;
  readonly other: int;
};

export type PendingCall = {
  readonly name: string;
  readonly params: Type[];
  readonly bound: Map<int, Type>;
  readonly loc: int;
  readonly module: int;
  readonly owner: string;
};

export type OpenVariant = {
  readonly params: Param[];
  readonly result?: Type;
};

export type LibraryVariants = {
  readonly types: FunctionType[];
  readonly open: OpenVariant[];
};
export type HeldStep = {
  readonly type: Type;
  readonly isLeave: boolean;
};
export type JsonTest = {
  readonly tested: Expr;
  readonly isNullTest: boolean;
};

export type ConstructorCast = {
  readonly decl: ClassDecl;
  readonly instance: InstanceType;
  readonly target: Type;
};

export type ReflectedNew = {
  readonly loc: int;
  readonly made: Type;
  readonly exprs: Expr[];
  readonly args: Type[];
  readonly module: int;
};
