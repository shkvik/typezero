import {
  Expr,
  ExprKind,
  NewExpr,
  NewKind,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../program/ast/types/ast.types.functions.tz";
import {
  Stmt,
  StmtKind,
  SwitchCase,
} from "../../../program/ast/types/ast.types.statements.tz";

export class ExpressionCollector {
  public readonly optionalPart(expr: Expr | undefined): Expr[] {
    if (expr == undefined) {
      return [];
    }

    return [expr];
  }

  public readonly functionExprs(fn: FunctionDecl, isDeep: boolean): Expr[] {
    const exprs: Expr[] = [];
    const values: Expr[] = [];
    const body = fn.body;
    if (body == undefined) {
      return exprs;
    }

    for (const statement of body.body) {
      this.statementExprs(statement, exprs, values, isDeep);
    }

    return exprs;
  }

  public readonly statementExprs(
    statement: Stmt,
    exprs: Expr[],
    values: Expr[],
    isDeep: boolean,
  ): void {
    switch (statement.kind) {
      case StmtKind.Block:
        for (const inner of statement.body) {
          this.statementExprs(inner, exprs, values, isDeep);
        }

        return;
      case StmtKind.VarDecl:
        for (const decl of statement.decls) {
          this.optionalExprs(decl.init, exprs, isDeep);
        }

        return;
      case StmtKind.Expr:
        return this.exprs(statement.expr, exprs, isDeep);
      case StmtKind.If:
        this.exprs(statement.cond, exprs, isDeep);
        this.statementExprs(statement.thenStmt, exprs, values, isDeep);

        return this.optionalStatement(
          statement.elseStmt,
          exprs,
          values,
          isDeep,
        );
      case StmtKind.While:
      case StmtKind.DoWhile:
        this.exprs(statement.cond, exprs, isDeep);

        return this.statementExprs(statement.body, exprs, values, isDeep);
      case StmtKind.For:
        this.optionalStatement(statement.init, exprs, values, isDeep);
        this.optionalExprs(statement.cond, exprs, isDeep);
        this.optionalExprs(statement.step, exprs, isDeep);

        return this.optionalStatement(statement.body, exprs, values, isDeep);
      case StmtKind.ForOf:
        this.exprs(statement.iterable, exprs, isDeep);

        return this.statementExprs(statement.body, exprs, values, isDeep);
      case StmtKind.Switch:
        return this.switchExprs(
          statement.discriminant,
          statement.cases,
          exprs,
          values,
          isDeep,
        );
      case StmtKind.Labeled:
        return this.statementExprs(statement.body, exprs, values, isDeep);
      case StmtKind.Return: {
        const value = statement.value;
        if (value != undefined) {
          values.push(value);
          this.exprs(value, exprs, isDeep);
        }

        return;
      }
      default:
        return;
    }
  }

  private readonly switchExprs(
    discriminant: Expr,
    cases: Read<SwitchCase[]>,
    exprs: Expr[],
    values: Expr[],
    isDeep: boolean,
  ): void {
    this.exprs(discriminant, exprs, isDeep);

    for (const option of cases) {
      this.optionalExprs(option.test, exprs, isDeep);

      for (const inner of option.body) {
        this.statementExprs(inner, exprs, values, isDeep);
      }
    }
  }

  private readonly optionalStatement(
    statement: Stmt | undefined,
    exprs: Expr[],
    values: Expr[],
    isDeep: boolean,
  ): void {
    if (statement != undefined) {
      this.statementExprs(statement, exprs, values, isDeep);
    }
  }

  private readonly optionalExprs(
    expr: Expr | undefined,
    exprs: Expr[],
    isDeep: boolean,
  ): void {
    if (expr != undefined) {
      this.exprs(expr, exprs, isDeep);
    }
  }

  public readonly exprs(expr: Expr, exprs: Expr[], isDeep: boolean): void {
    exprs.push(expr);

    if (expr.kind == ExprKind.Function) {
      return this.innerExprs(expr.fn, exprs, isDeep);
    }

    for (const child of this.children(expr)) {
      this.exprs(child, exprs, isDeep);
    }
  }

  private readonly innerExprs(fn: FunctionDecl, exprs: Expr[], isDeep: boolean): void {
    const body = fn.body;
    const values: Expr[] = [];
    if (!isDeep || body == undefined) {
      return;
    }

    for (const statement of body.body) {
      this.statementExprs(statement, exprs, values, isDeep);
    }
  }

  private readonly children(expr: Expr): Expr[] {
    switch (expr.kind) {
      case ExprKind.Member:
        return [expr.object];
      case ExprKind.Index:
        return [expr.object, expr.index];
      case ExprKind.Unary:
      case ExprKind.Cast:
        return [expr.operand];
      case ExprKind.Binary:
        return [expr.lhs, expr.rhs];
      case ExprKind.Assign:
        return [expr.target, expr.value];
      case ExprKind.Update:
        return [expr.target];
      case ExprKind.Call:
        return [expr.callee, ...expr.args.map((arg) => arg.expr)];
      case ExprKind.New:
        return this.newChildren(expr);
      case ExprKind.Conditional:
        return [expr.cond, expr.thenExpr, expr.elseExpr];
      case ExprKind.Sequence:
      case ExprKind.Template:
        return expr.exprs;
      case ExprKind.OptionalChain:
        return [expr.chain];
      case ExprKind.Yield:
        return this.optionalPart(expr.value);
      case ExprKind.Await:
        return [expr.value];
      case ExprKind.ArrayLit:
        return expr.elements.map((element) => element.expr);
      case ExprKind.ObjectLit:
        return expr.props.map((property) => property.value);
      default:
        return [];
    }
  }

  private readonly newChildren(expr: NewExpr): Expr[] {
    const args = expr.args.map((arg) => arg.expr);
    const form = expr.form;
    if (form.kind == NewKind.Named) {
      return args;
    }

    return [form.callee, ...args];
  }
}
