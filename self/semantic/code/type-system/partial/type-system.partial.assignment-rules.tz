import { TypeSystem } from "../../../types/type-system/type-system.tz";
import { Code } from "../../../../diagnostic/code.tz";
import {
  Details,
  SourceError,
} from "../../../../diagnostic/types/message.types.tz";
import {
  AssignExpr,
  BinaryOp,
  ExprKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";
import {
  kAssignSuffix,
  kConvertWithString,
} from "../../assignment-rules/const/assignment-rules.const.tz";

partial class TypeSystem {
  public readonly isArithmetic(op: BinaryOp | undefined): boolean {
    switch (op) {
      case undefined:
      case BinaryOp.LogOr:
      case BinaryOp.LogAnd:
      case BinaryOp.Nullish:
        return false;
      default:
        return true;
    }
  }

  public readonly isShift(op: BinaryOp): boolean {
    return op == BinaryOp.Shl || op == BinaryOp.Shr || op == BinaryOp.UShr;
  }

  public readonly isIntegerOnly(op: BinaryOp): boolean {
    return this.isBitwise(op) || this.isShift(op);
  }

  public readonly isWrapping(type: Type, given: Type): boolean {
    if (type.kind != TypeKind.Int || given.kind != TypeKind.Int) {
      return false;
    }

    return type.wraps && (!given.wraps || given.id == type.id);
  }

  public readonly compoundTarget(declared: Type, narrowed: Type): Type {
    const isPlain =
      this.isNumber(declared) || declared.kind == TypeKind.String;
    if (isPlain) {
      return declared;
    }

    return narrowed;
  }

  public readonly compoundHint(
    op: BinaryOp,
    type: Type,
    isLiteralTree: boolean,
  ): Type | undefined {
    const isPower = type.kind == TypeKind.Decimal && op == BinaryOp.Pow;
    const isBitsOfOther = this.isIntegerOnly(op) && type.kind != TypeKind.Int;
    const isPlainShift = this.isShift(op) && !isLiteralTree;
    const isHintless = isPower || isBitsOfOther || isPlainShift;
    if (type.kind == TypeKind.String || isHintless) {
      return undefined;
    }

    return type;
  }

  public stringCompoundError(
    expr: AssignExpr,
    op: BinaryOp,
    type: Type,
    given: Type,
    module: int,
  ): SourceError | undefined {
    if (given.kind == TypeKind.Error) {
      return undefined;
    }
    if (op != BinaryOp.Add) {
      return this.operandTypesError(expr, op, type, given);
    }

    const base = this.definedType(given);
    const isJoining =
      this.isNumeric(base) || base.kind == TypeKind.Boolean;
    if (!isJoining) {
      return undefined;
    }

    const first = this.typeText(given);
    const other = this.joinHint(expr, module);

    return {
      code: Code.CompoundJoinsText,
      loc: expr.loc,
      details: { first, other },
    };
  }

  public compoundOperandsError(
    expr: AssignExpr,
    op: BinaryOp,
    type: Type,
    given: Type,
    isSettled: boolean,
  ): SourceError | undefined {
    const other = this.spelling(op);
    const loc = expr.loc;
    const isBits = this.isIntegerOnly(op);
    const hasDouble =
      type.kind == TypeKind.Double || given.kind == TypeKind.Double;
    if (isBits && hasDouble) {
      return { code: Code.CompoundBitsOfDouble, loc, details: { other } };
    }
    if (this.isWrongTarget(isBits, type)) {
      return this.operandTypesError(expr, op, type, given);
    }

    const isSame = op == BinaryOp.BitOr || op == BinaryOp.UShr;
    if (isSame && this.isZero(expr) && !this.wraps(type)) {
      return { code: Code.CompoundNothingChanged, loc, details: { other } };
    }

    const first = this.typeText(type);
    if (op == BinaryOp.UShr && !this.isUnsigned(type)) {
      return { code: Code.CompoundSignedShift, loc, details: { first } };
    }

    const isMixed =
      this.isBitwise(op) && given.kind == TypeKind.Int && given.id != type.id;
    if (isSettled || !isMixed) {
      return undefined;
    }

    const second = this.typeText(given);
    const place = this.conversionHint(expr, type);
    const details: Details = { other, first, second, place };

    return { code: Code.CompoundMixedNumbers, loc, details };
  }

  private readonly isBitwise(op: BinaryOp): boolean {
    switch (op) {
      case BinaryOp.BitAnd:
      case BinaryOp.BitOr:
      case BinaryOp.BitXor:
        return true;
      default:
        return false;
    }
  }

  private readonly isWrongTarget(isBits: boolean, type: Type): boolean {
    if (isBits) {
      return type.kind != TypeKind.Int;
    }

    return !this.isNumber(type);
  }

  private readonly isZero(expr: AssignExpr): boolean {
    const tree = this.program.tree;

    const value = tree.exprOf(expr.valueId);

    return value.kind == ExprKind.IntLit && value.value == 0;
  }

  private readonly wraps(type: Type): boolean {
    return type.kind == TypeKind.Int && type.wraps;
  }

  private readonly isUnsigned(type: Type): boolean {
    return type.kind == TypeKind.Int && type.unsigned;
  }

  private readonly spelling(op: BinaryOp): string {
    return `${this.operatorText(op)}${kAssignSuffix}`;
  }

  private readonly operandTypesError(
    expr: AssignExpr,
    op: BinaryOp,
    type: Type,
    given: Type,
  ): SourceError {
    const first = this.typeText(type);
    const second = this.typeText(given);
    const other = this.spelling(op);
    const code = this.operandTypesCode(type, given);

    return { code, loc: expr.loc, details: { first, second, other } };
  }

  private readonly operandTypesCode(type: Type, given: Type): Code {
    const isUndefined =
      this.isOptional(type) ||
      this.isOptional(given) ||
      type.kind == TypeKind.Undefined ||
      given.kind == TypeKind.Undefined;
    if (isUndefined) {
      return Code.OperandTypesUndefined;
    }

    return Code.OperandTypes;
  }

  private readonly joinHint(expr: AssignExpr, module: int): string {
    const texts = this.assignTexts(expr, module);
    if (texts.left == "") {
      return kConvertWithString;
    }

    const shown = this.withoutParens(texts.right);

    return `; write '${texts.left} += String(${shown})'`;
  }

  private conversionHint(expr: AssignExpr, type: Type): string {
    const tree = this.program.tree;

    const target = this.definedType(type);
    if (!this.isNumber(target)) {
      return "";
    }

    const value = tree.exprOf(expr.valueId);
    const shown = this.operandName(value);
    const method = this.conversionName(target);

    return `; convert it explicitly: '${shown}.${method}()'`;
  }
}
