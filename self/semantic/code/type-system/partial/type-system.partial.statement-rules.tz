import { TypeSystem } from "../../../types/type-system/type-system.tz";
import {
  ForOfStmt,
  ReturnStmt,
  Stmt,
  StmtKind,
  SwitchStmt,
} from "../../../../program/ast/types/ast.types.statements.tz";
import {
  kForAwaitWord,
  kForInWord,
  kForOfWord,
  kLastAndSeparator,
  kPromisePlaceholder,
  kTakingMethods,
} from "../../statement-rules/const/statement-rules.const.tz";
import {
  Checked,
  SourceError,
} from "../../../../diagnostic/types/message.types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import {
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import {
  FunctionDecl,
} from "../../../../program/ast/types/ast.types.functions.tz";
import { SymbolKind } from "../../../../program/scopes/types/scopes.types.tz";
import {
  DictKind,
  TupleType,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import {
  DeclaredVariable,
  FunctionFrame,
  ValueTarget,
} from "../../expression-types/types/expression-types.types.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import {
  kNameSeparator,
} from "../../../types/type-of-rules/const/type-of-rules.const.tz";

partial class TypeSystem {
  public readonly boundsText(
    isLiteral: boolean,
    index: string,
    below: string,
  ): string {
    if (isLiteral) {
      return below;
    }

    return `${index} >= 0 && ${below}`;
  }

  public readonly simpleText(expr: Expr): string {
    if (expr.kind == ExprKind.Name) {
      return expr.name;
    }
    if (expr.kind == ExprKind.IntLit) {
      return `${expr.value}`;
    }

    return "";
  }

  public readonly simpleOr(expr: Expr, fallback: string): string {
    const text = this.simpleText(expr);
    if (text == "") {
      return fallback;
    }

    return text;
  }

  public readonly knownOr(
    isKnown: boolean,
    text: string,
    fallback: string,
  ): string {
    if (isKnown) {
      return text;
    }

    return fallback;
  }

  public readonly taggedPlace(count: int): string {
    if (count == 2) {
      return " and 1 value";
    }
    if (count != 1) {
      return ` and ${count - 1} values`;
    }

    return "";
  }

  public isRecordWanted(wanted: Type | undefined): boolean {
    if (wanted == undefined) {
      return false;
    }

    const goal = this.definedType(wanted);

    return goal.kind == TypeKind.Dict && goal.dict == DictKind.Record;
  }

  public readonly itemTarget(
    item: Stmt,
    module: int,
    name: string,
  ): ValueTarget | undefined {
    const tree = this.program.tree;

    switch (item.kind) {
      case StmtKind.VarDecl: {
        const decl = tree
          .declaratorsOf(item.declsList)
          .find((one) => one.name == name);
        if (decl == undefined) {
          return undefined;
        }

        return { module, kind: SymbolKind.Variable, loc: decl.loc };
      }
      case StmtKind.Function:
        return this.namedTarget(item.name, name, {
          module,
          kind: SymbolKind.Function,
          loc: item.loc,
        });
      case StmtKind.Class:
        return this.namedTarget(item.name ?? "", name, {
          module,
          kind: SymbolKind.Class,
          loc: item.loc,
        });
      case StmtKind.Enum:
        return this.namedTarget(item.name, name, {
          module,
          kind: SymbolKind.Enum,
          loc: item.loc,
        });
      default:
        return undefined;
    }
  }

  public readonly isMappingCall(expr: Expr): boolean {
    const tree = this.program.tree;

    if (expr.kind != ExprKind.Call) {
      return false;
    }

    const callee = tree.exprOf(expr.calleeId);
    if (callee.kind != ExprKind.Member) {
      return false;
    }

    return callee.name == "map" || callee.name == "flatMap";
  }

  public readonly calleeLoc(expr: Expr): int {
    const tree = this.program.tree;

    if (
      expr.kind == ExprKind.Call &&
      tree.exprOf(expr.calleeId).kind == ExprKind.Member
    ) {
      return tree.exprOf(expr.calleeId).loc;
    }

    return expr.loc;
  }

  public readonly shownText(text: string): string {
    if (text == "") {
      return kPromisePlaceholder;
    }

    return text;
  }

  public heldType(type: Type): Type {
    const defined = this.definedType(type);
    if (defined.kind == TypeKind.Array) {
      return this.heldType(this.store.itemOf(defined));
    }

    return defined;
  }

  public readonly isTakingElement(expr: Expr): boolean {
    const tree = this.program.tree;

    if (expr.kind != ExprKind.Call) {
      return false;
    }

    const callee = tree.exprOf(expr.calleeId);

    return (
      callee.kind == ExprKind.Member && kTakingMethods.includes(callee.name)
    );
  }

  public readonly caseCode(hasResult: boolean): Code {
    if (hasResult) {
      return Code.CaseResultsCompared;
    }

    return Code.CaseNotComparable;
  }

  public readonly listedNames(names: Read<string[]>): string {
    const last = names[names.length - 1];
    if (names.length < 2 || last == undefined) {
      return names.join("");
    }

    const front = names.slice(0, names.length - 1);

    return `${front.join(kNameSeparator)}${kLastAndSeparator}${last}`;
  }

  public isShapedType(type: Type): boolean {
    if (type.kind == TypeKind.Error) {
      return false;
    }
    if (type.kind == TypeKind.Result) {
      return true;
    }

    let held = this.definedType(type);

    while (held.kind == TypeKind.Array) {
      held = this.definedType(this.store.itemOf(held));
    }

    switch (held.kind) {
      case TypeKind.Object:
      case TypeKind.Instance:
      case TypeKind.Tuple:
      case TypeKind.Dict:
        return true;
      default:
        return false;
    }
  }

  public dictItem(dict: DictKind, key: Type, value: Type): Type {
    switch (dict) {
      case DictKind.Map:
        return this.store.plainTuple([key, value]);
      case DictKind.Set:
        return key;
      default:
        return this.store.plain(TypeKind.Error);
    }
  }

  public readonly isInsideFunction(fn: FunctionDecl, loc: int): boolean {
    const span = fn.source;
    if (span == undefined) {
      return false;
    }

    return loc >= span.start && loc < span.end;
  }

  public heldValue(type: Type): Type {
    let held = this.definedType(type);

    while (held.kind == TypeKind.Array) {
      held = this.definedType(this.store.itemOf(held));
    }

    return held;
  }

  public readonly instanceTextCode(held: Type): Code | undefined {
    if (held.kind != TypeKind.Instance || this.isDateType(held)) {
      return undefined;
    }

    return Code.ArrayTextObjects;
  }

  public readonly instanceSortCode(held: Type): Code {
    if (this.isDateType(held)) {
      return Code.SortDates;
    }

    return Code.SortObjects;
  }

  public plainSortProblem(element: Type): Code | undefined {
    const base = this.definedType(element);
    if (
      base.kind == TypeKind.Union &&
      !this.isTextualUnion(this.store.partsOf(base))
    ) {
      return Code.SortMixed;
    }

    const apparent = this.baseOf(base) ?? base;
    const isNumber =
      apparent.kind == TypeKind.Int ||
      apparent.kind == TypeKind.Double ||
      apparent.kind == TypeKind.Decimal;
    if (isNumber) {
      return Code.SortNumbers;
    }

    return undefined;
  }

  public readonly sortExample(element: Type): string {
    if (this.isOptional(element)) {
      return "(x ?? 0) - (y ?? 0)";
    }

    return "x - y";
  }

  public readonly isItemDeclaring(item: Stmt, loc: int): boolean {
    const tree = this.program.tree;

    if (item.kind != StmtKind.VarDecl) {
      return false;
    }

    return tree.declaratorsOf(item.declsList).some((decl) => decl.loc == loc);
  }

  private readonly caseShown(type: Type, subject: Type): Type {
    const parts = this.unionMembers(subject);
    const hasLiterals = parts.some((part) => part.kind == TypeKind.Literal);
    if (hasLiterals && type.kind == TypeKind.Literal) {
      return type;
    }

    return this.widened(type);
  }

  public caseTypeCheck(
    test: Expr,
    type: Type,
    subject: Type,
  ): SourceError | undefined {
    if (type.kind == TypeKind.Error) {
      return undefined;
    }

    const common = this.comparisonType(subject, type);
    if (common != undefined) {
      return undefined;
    }

    const hasResult =
      type.kind == TypeKind.Result || subject.kind == TypeKind.Result;
    const code = this.caseCode(hasResult);

    return {
      code,
      loc: test.loc,
      details: {
        word: this.typeText(this.caseShown(type, subject)),
        first: this.typeText(subject),
      },
    };
  }

  public readonly emptyReturnError(
    statement: ReturnStmt,
    result: Type,
    frame: Read<FunctionFrame>,
  ): SourceError | undefined {
    const isOpen =
      result.kind == TypeKind.Error ||
      result.kind == TypeKind.Undefined ||
      this.isOptional(result);
    if (isOpen || frame.fn == undefined) {
      return undefined;
    }

    const word = this.functionLabel(frame.fn);
    const first = this.typeText(result);

    return {
      code: Code.ReturnValueMissing,
      loc: statement.loc,
      details: {
        word,
        first,
      },
    };
  }

  public promiseUsedError(
    expr: Expr,
    value: Type,
    at: int | undefined,
    module: int,
  ): SourceError | undefined {
    const text = this.statementText(at, module);
    const held = this.heldType(value);
    if (held.kind == TypeKind.Result) {
      const word = this.shownText(text);

      return {
        code: Code.PromiseResultUnchecked,
        loc: expr.loc,
        details: {
          word,
        },
      };
    }
    if (text == "") {
      return {
        code: Code.PromiseNotAwaited,
        loc: expr.loc,
        details: kNoDetails,
      };
    }

    return {
      code: Code.PromiseNotAwaitedHere,
      loc: expr.loc,
      details: { word: text },
    };
  }

  public readonly undefinedError(
    variable: DeclaredVariable,
    init: Expr,
  ): SourceError | undefined {
    const decl = variable.decl;
    const word = decl.name;

    if (variable.isConst) {
      return {
        code: Code.UndefinedConstNeedsType,
        loc: init.loc,
        details: {
          word,
        },
      };
    }

    return {
      code: Code.UndefinedLetNeedsType,
      loc: decl.loc,
      details: { word },
    };
  }

  public readonly returnAwaitCheck(
    value: Expr | undefined,
    frame: Read<FunctionFrame>,
  ): SourceError | undefined {
    const isAsync = frame.fn?.isAsync == true;
    if (value == undefined || !isAsync || value.kind != ExprKind.Await) {
      return undefined;
    }
    if (frame.fn?.concise == true) {
      return { code: Code.ArrowAwait, loc: value.loc, details: kNoDetails };
    }

    return { code: Code.ReturnAwait, loc: value.loc, details: kNoDetails };
  }

  public readonly switchFunctionCheck(statement: Stmt): SourceError[] {
    const errors: SourceError[] = [];

    if (statement.kind == StmtKind.Function) {
      errors.push({
        code: Code.FunctionInSwitch,
        loc: statement.loc,
        details: kNoDetails,
      });
    }

    return errors;
  }

  public rawTextsCheck(expr: MemberExpr, object: Type): Checked<boolean> {
    if (expr.name != "raw" || object.kind != TypeKind.Array) {
      return { value: false };
    }
    if (this.definedType(this.store.itemOf(object)).kind != TypeKind.String) {
      return { value: false };
    }

    return {
      value: true,
      error: { code: Code.TemplateRaw, loc: expr.loc, details: kNoDetails },
    };
  }

  public readonly tupleLoopItem(
    loop: ForOfStmt,
    tuple: TupleType,
  ): Checked<Type> {
    const tree = this.program.tree;

    const element = this.tupleElement(tuple);
    if (element != undefined) {
      return { value: element };
    }

    return {
      value: this.store.plain(TypeKind.Error),
      error: {
        code: Code.TupleIterated,
        loc: tree.exprOf(loop.iterableId).loc,
        details: kNoDetails,
      },
    };
  }

  public readonly switchFunctionsCheck(statement: SwitchStmt): SourceError[] {
    const tree = this.program.tree;

    const errors: SourceError[] = [];

    for (const option of tree.casesOf(statement.casesList)) {
      for (const one of tree.stmtsOf(option.bodyList)) {
        const switchFunctionErrors = this.switchFunctionCheck(one);

        for (const found of switchFunctionErrors) {
          errors.push(found);
        }
      }
    }

    return errors;
  }

  public readonly loopWord(loop: ForOfStmt): string {
    if (loop.isAwait) {
      return kForAwaitWord;
    }
    if (loop.keys) {
      return kForInWord;
    }

    return kForOfWord;
  }

  public readonly untypedCode(first: string, isUndefined: boolean): Code {
    if (first != "" && isUndefined) {
      return Code.UndefinedLetWriteType;
    }
    if (first != "") {
      return Code.VariableWriteType;
    }
    if (isUndefined) {
      return Code.UndefinedLetNeedsType;
    }

    return Code.VariableNeedsType;
  }

  private readonly namedTarget(
    declared: string,
    name: string,
    target: ValueTarget,
  ): ValueTarget | undefined {
    if (declared != name) {
      return undefined;
    }

    return target;
  }

  private readonly isDateType(type: Type): boolean {
    return (
      type.kind == TypeKind.Instance &&
      type.name == "Date" &&
      this.isLibraryModule(type.module)
    );
  }

  private readonly isTextualUnion(parts: Read<Type[]>): boolean {
    return parts.every((part) => {
      const base = this.baseOf(part) ?? part;

      return base.kind == TypeKind.String || base.kind == TypeKind.Boolean;
    });
  }
}
