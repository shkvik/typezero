import { TypeSystem } from "../../../types/type-system/type-system.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import {
  Details,
  Finding,
  SourceError,
} from "../../../../diagnostic/types/message.types.tz";
import {
  ExprKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";
import {
  kDictTexts,
} from "../../../types/type-questions/const/type-questions.const.tz";
import {
  kBacktick,
  kCloseValue,
  kDollar,
  kOpenBrace,
  kOpenValue,
  kQuotes,
  kTemplateFrame,
} from "../../concatenation-rules/const/concatenation-rules.const.tz";
import {
  ConcatLink,
  ConcatPart,
  TemplatePiece,
  TemplateText,
} from "../../concatenation-rules/types/concatenation-rules.types.tz";
import { kEscape } from "../../source-texts/const/source-texts.const.tz";

partial class TypeSystem {
  public textAnswer(type: Type, base: Type): Finding | undefined {
    const code = this.textProblem(type, base);
    if (code == undefined) {
      return undefined;
    }

    const details = this.textDetails(code, type, base);

    return { code, details };
  }

  public mixedAnswer(
    links: Read<ConcatLink[]>,
    module: int,
  ): SourceError | undefined {
    const mixed = links.find((link) => this.isMixing(link.left, link.right));
    const root = links[links.length - 1];
    if (mixed == undefined || root == undefined) {
      return undefined;
    }

    const parts = this.concatParts(root, links, module);
    const joined = this.concatTemplate(parts);
    const first = this.typeText(mixed.left);
    const second = this.typeText(mixed.right);
    const loc = mixed.binary.loc;

    if (joined.only != "") {
      const details: Details = { first, second, word: joined.only };

      return { code: Code.MixedConcatString, loc, details };
    }

    const other = this.sumHint(parts);
    if (other != "") {
      const details: Details = { first, second, other, word: joined.text };

      return { code: Code.MixedConcatSum, loc, details };
    }

    const details: Details = { first, second, word: joined.text };

    return { code: Code.MixedConcatTemplate, loc, details };
  }

  private textProblem(type: Type, base: Type): Code | undefined {
    if (this.holdsKind(type, TypeKind.Function)) {
      return Code.FunctionToText;
    }
    if (base.kind == TypeKind.Tuple) {
      return Code.TupleToText;
    }
    if (this.holdsKind(type, TypeKind.Result)) {
      return Code.ResultToText;
    }
    if (base.kind == TypeKind.Dict) {
      return Code.DictToText;
    }
    if (base.kind == TypeKind.Iterator) {
      return Code.IteratorToText;
    }
    if (this.holdsKind(type, TypeKind.Unknown)) {
      return Code.UnknownToText;
    }
    if (this.holdsKind(type, TypeKind.Json)) {
      return Code.JsonToText;
    }
    if (this.holdsObjects(type)) {
      return Code.ObjectToText;
    }
    if (this.textMember(base) != undefined) {
      return Code.UnionToText;
    }

    return undefined;
  }

  private readonly textDetails(code: Code, type: Type, base: Type): Details {
    if (code == Code.DictToText && base.kind == TypeKind.Dict) {
      const dict = base.dict;
      const row = kDictTexts.find((one) => one.dict == dict);

      return { word: row?.kind ?? "", other: row?.shown ?? "" };
    }

    const member = this.textMember(base);
    if (code != Code.UnionToText || member == undefined) {
      return kNoDetails;
    }

    const first = this.typeText(type);
    const second = this.typeText(member);

    return { first, second };
  }

  private readonly textMember(base: Type): Type | undefined {
    if (
      base.kind != TypeKind.Union ||
      !this.isTagged(this.store.partsOf(base))
    ) {
      return undefined;
    }

    return this.store.partsOf(base).find((part) => this.isHeldMember(part));
  }

  private readonly isHeldMember(part: Type): boolean {
    const isSpecial = this.isDate(part) || this.isRegExp(part);
    if (this.isObjectKind(part) && !isSpecial) {
      return true;
    }

    switch (part.kind) {
      case TypeKind.Dict:
      case TypeKind.Function:
      case TypeKind.Iterator:
        return true;
      default:
        return false;
    }
  }

  private isMixing(left: Type, right: Type): boolean {
    const isLeftText = left.kind == TypeKind.String && this.joinsAsText(right);
    const isRightText = right.kind == TypeKind.String && this.joinsAsText(left);

    return isLeftText || isRightText;
  }

  private joinsAsText(type: Type): boolean {
    const base = this.definedType(type);

    return this.isNumberLike(base) || base.kind == TypeKind.Boolean;
  }

  private readonly concatParts(
    root: ConcatLink,
    links: Read<ConcatLink[]>,
    module: int,
  ): ConcatPart[] {
    const tree = this.program.tree;

    const chain: ConcatLink[] = [root];
    let below = this.linkBelow(root, links);

    while (below != undefined) {
      chain.push(below);
      below = this.linkBelow(below, links);
    }

    const parts: ConcatPart[] = [];
    const first = chain[chain.length - 1] ?? root;
    const texts = this.operandTexts(first.binary, module);

    parts.push({
      expr: tree.exprOf(first.binary.lhsId),
      text: texts.left,
      type: first.left,
    });

    for (let index = chain.length - 1; index >= 0; index--) {
      const link = chain[index];
      if (link == undefined) {
        continue;
      }

      const linkTexts = this.operandTexts(link.binary, module);

      parts.push({
        expr: tree.exprOf(link.binary.rhsId),
        text: linkTexts.right,
        type: link.right,
      });
    }

    return parts;
  }

  private readonly linkBelow(
    link: ConcatLink,
    links: Read<ConcatLink[]>,
  ): ConcatLink | undefined {
    const tree = this.program.tree;

    const left = tree.exprOf(link.binary.lhsId);

    return links.find(
      (one) => one.binary.id == left.id && one.type.kind == TypeKind.String,
    );
  }

  private readonly concatTemplate(parts: Read<ConcatPart[]>): TemplateText {
    let text = kBacktick;
    let values = 0;
    let only = "";

    for (const part of parts) {
      if (part.text == "") {
        return { text: "", only: "" };
      }

      const piece = this.templatePiece(part);

      text = text + piece.text;

      if (piece.value != undefined) {
        values += 1;
        only = piece.value;
      }
    }

    const isSingle = values == 1 && text.length == only.length + kTemplateFrame;
    const closed = text + kBacktick;

    if (!isSingle) {
      return { text: closed, only: "" };
    }

    return { text: closed, only };
  }

  private readonly templatePiece(part: ConcatPart): TemplatePiece {
    const text = part.text;
    const head = text.slice(0, 1);
    const tail = text.slice(text.length - 1);
    const isQuoted = text.length >= 2 && head == tail;
    const isString = part.expr.kind == ExprKind.StringLit;
    if (isString && isQuoted && kQuotes.includes(head)) {
      return { text: this.escapedBody(text) };
    }

    const isTemplate = part.expr.kind == ExprKind.Template;
    if (isTemplate && isQuoted && head == kBacktick) {
      return { text: text.slice(1, text.length - 1) };
    }

    const value = this.withoutParens(text);

    return { text: kOpenValue + value + kCloseValue, value };
  }

  private readonly escapedBody(text: string): string {
    const body = text.slice(1, text.length - 1);
    let escaped = "";
    let index = 0;

    while (index < body.length) {
      const unit = body.charAt(index);
      const next = body.charAt(index + 1);

      if (unit == kEscape && index + 1 < body.length) {
        escaped = escaped + unit + next;
        index += 2;

        continue;
      }

      const isOpening = unit == kDollar && next == kOpenBrace;
      if (unit == kBacktick || isOpening) {
        escaped = escaped + kEscape;
      }

      escaped = escaped + unit;
      index += 1;
    }

    return escaped;
  }

  private readonly sumHint(parts: Read<ConcatPart[]>): string {
    const first = parts[0];
    const second = parts[1];
    if (parts.length != 2 || first == undefined || second == undefined) {
      return "";
    }
    if (this.isNumeric(first.type) && this.isTextValue(second)) {
      return `${first.text} + Number(${second.text})`;
    }
    if (this.isTextValue(first) && this.isNumeric(second.type)) {
      return `Number(${first.text}) + ${second.text}`;
    }

    return "";
  }

  private readonly isTextValue(part: ConcatPart): boolean {
    const kind = part.expr.kind;
    const isWritten = kind == ExprKind.StringLit || kind == ExprKind.Template;

    return part.type.kind == TypeKind.String && !isWritten;
  }
}
