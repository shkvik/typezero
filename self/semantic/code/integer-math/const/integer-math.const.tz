import { IntLimit } from "../types/integer-math.types.tz";

export const kDoubleBits = 53;
export const kDoubleTopBit = 1024;
export const kDoubleLimit: decimal = decimal(2) ** kDoubleTopBit;
export const kExponentMark = "e";
export const kFractionDot = ".";
export const kInfinityText = "inf";
export const kLargestInt: decimal = 9223372036854775807;
export const kMinus = "-";
export const kPlainDoubleLimit: decimal = 1000000000000000000000;
export const kRoundHalfEven = "half-even";
export const kShownDigits = 15;
export const kSmallestInt: decimal = -9223372036854775808;
export const kZeroDigit = "0";

export const kIntLimits: IntLimit[] = [
  { bits: 8, unsigned: false, highest: 127, lowest: 128 },
  { bits: 16, unsigned: false, highest: 32767, lowest: 32768 },
  { bits: 32, unsigned: false, highest: 2147483647, lowest: 2147483648 },
  {
    bits: 64,
    unsigned: false,
    highest: 9223372036854775807,
    lowest: 9223372036854775808,
  },
  { bits: 8, unsigned: true, highest: 255, lowest: 0 },
  { bits: 16, unsigned: true, highest: 65535, lowest: 0 },
  { bits: 32, unsigned: true, highest: 4294967295, lowest: 0 },
  { bits: 64, unsigned: true, highest: 18446744073709551615, lowest: 0 },
];
