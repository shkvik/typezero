import { kOrderingOperators } from "./const/comparison-rules.const.tz";
import { SourceError } from "../../../diagnostic/types/message.types.tz";
import {
  BinaryExpr,
  Expr,
  ExprKind,
  UnaryOp,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import { OperandPair } from "../expression-types/types/expression-types.types.tz";
import { DecimalRules } from "../../library/decimal-rules/decimal-rules.tz";
import { OperatorRules } from "../operator-rules/operator-rules.tz";
import { TypeRelation } from "../../types/type-relation/type-relation.tz";
import { TypeStore } from "../../../program/type/type-store/type-store.tz";
import { kIntLimits } from "../integer-math/const/integer-math.const.tz";
import { TypeQuestions } from "../../types/type-questions/type-questions.tz";
import { TypeUnifier } from "../../types/type-unifier/type-unifier.tz";
import { ExpressionShapes } from "../expression-shapes/expression-shapes.tz";

export class ComparisonRules {
  private readonly types: TypeQuestions;
  private readonly unifier: TypeUnifier;
  private readonly shapes: ExpressionShapes;
  private readonly store: TypeStore;
  private readonly relation: TypeRelation;
  private readonly operators: OperatorRules;
  private readonly decimals: DecimalRules;

  public constructor(
    types: TypeQuestions,
    unifier: TypeUnifier,
    shapes: ExpressionShapes,
    store: TypeStore,
    relation: TypeRelation,
    operators: OperatorRules,
    decimals: DecimalRules,
  ) {
    this.types = types;
    this.unifier = unifier;
    this.shapes = shapes;
    this.store = store;
    this.relation = relation;
    this.operators = operators;
    this.decimals = decimals;
  }

  public literalComparisonHint(
    isLiteral: boolean,
    other: Type,
    self: Expr,
  ): Type | undefined {
    if (!isLiteral) {
      return undefined;
    }

    return this.comparisonHint(other, self);
  }

  public isComparedLiteral(expr: Expr): boolean {
    const isNegated = expr.kind == ExprKind.Unary && expr.op == UnaryOp.Neg;
    const operand = this.negatedOperand(isNegated, expr);
    const kind = operand.kind;
    const isWritten = kind == ExprKind.StringLit || kind == ExprKind.BoolLit;

    return this.shapes.isNumberTree(operand) || isWritten;
  }

  public comparisonHint(other: Type, self: Expr): Type | undefined {
    const type = this.types.definedType(other);
    if (type.kind == TypeKind.Literal || type.kind == TypeKind.Union) {
      return other;
    }

    const isFitting =
      type.kind == TypeKind.Double || this.isFittingLiteral(self, type);
    if (this.types.isNumeric(type) && isFitting) {
      return type;
    }
    if (type.kind == TypeKind.Decimal) {
      return type;
    }

    return undefined;
  }

  public nullOperand(isLeftNull: boolean, expr: BinaryExpr): Expr {
    if (isLeftNull) {
      return expr.lhs;
    }

    return expr.rhs;
  }

  public comparisonType(left: Type, right: Type): Type | undefined {
    if (left.kind == TypeKind.Void || right.kind == TypeKind.Void) {
      return undefined;
    }

    const common = this.unifier.unify(left, right);
    if (common == undefined || common.kind == TypeKind.Error) {
      return common;
    }

    const base = this.types.definedType(common);
    if (!this.isComparable(base)) {
      return undefined;
    }

    return common;
  }

  public nullishHint(left: Type, expected: Type | undefined): Type | undefined {
    if (left.kind == TypeKind.Undefined || left.kind == TypeKind.Error) {
      return expected;
    }

    return this.types.definedType(left);
  }

  public nullishBase(left: Type, right: Type): Type | undefined {
    const plainLeft = this.types.definedType(left);

    if (right.kind == TypeKind.Undefined) {
      return plainLeft;
    }

    const plainRight = this.types.definedType(right);

    return this.unifier.unionUnify(plainLeft, plainRight);
  }

  public jsonEqualityError(
    expr: BinaryExpr,
    pair: OperandPair,
  ): SourceError | undefined {
    const left = pair.left;
    const right = pair.right;
    const isLeftJson = this.types.definedType(left).kind == TypeKind.Json;
    const isRightJson = this.types.definedType(right).kind == TypeKind.Json;
    const type = this.decimals.otherSide(isLeftJson, left, right);
    const json = this.store.plain(TypeKind.Json);
    const plain = this.types.definedType(type);
    const isOptionalJson =
      this.types.isOptional(type) && this.relation.converts(plain, json);
    if ((isLeftJson && isRightJson) || isOptionalJson) {
      return undefined;
    }

    const isPlain =
      type.kind == TypeKind.String ||
      type.kind == TypeKind.Boolean ||
      this.types.isNumeric(type);
    if (isPlain) {
      return undefined;
    }

    const operandsError = this.operators.operandsError(expr, pair);

    return operandsError;
  }

  public incomparableError(
    expr: BinaryExpr,
    pair: OperandPair,
    module: int,
  ): SourceError | undefined {
    const left = pair.left;
    const right = pair.right;
    const plainLeft = this.types.definedType(left);
    const plainRight = this.types.definedType(right);
    const hasDecimal =
      plainLeft.kind == TypeKind.Decimal || plainRight.kind == TypeKind.Decimal;
    if (hasDecimal) {
      const decimalMixError = this.decimals.decimalMixError(expr, pair, module);

      return decimalMixError;
    }

    const hasNumbers =
      this.types.isNumeric(plainLeft) &&
      this.types.isNumeric(plainRight) &&
      !this.types.isOptional(left) &&
      !this.types.isOptional(right);
    if (hasNumbers) {
      const mixedError = this.operators.mixedError(expr, pair, module);

      return mixedError;
    }

    const operandsError = this.operators.operandsError(expr, pair);

    return operandsError;
  }

  public isOrdering(op: string): boolean {
    return kOrderingOperators.includes(op);
  }

  private negatedOperand(isNegated: boolean, expr: Expr): Expr {
    if (!isNegated || expr.kind != ExprKind.Unary) {
      return expr;
    }

    return expr.operand;
  }

  private isFittingLiteral(expr: Expr, type: Type): boolean {
    if (type.kind != TypeKind.Int) {
      return false;
    }

    const bits = type.bits;
    const unsigned = type.unsigned;
    const limit = kIntLimits.find(
      (row) => row.bits == bits && row.unsigned == unsigned,
    );
    const isNegated = expr.kind == ExprKind.Unary && expr.op == UnaryOp.Neg;
    const operand = this.negatedOperand(isNegated, expr);
    if (limit == undefined || operand.kind != ExprKind.IntLit) {
      return false;
    }
    if (!isNegated) {
      return operand.value <= limit.highest;
    }

    return operand.value == 0 || (!unsigned && operand.value <= limit.lowest);
  }

  private isComparable(base: Type): boolean {
    switch (base.kind) {
      case TypeKind.Int:
      case TypeKind.Double:
      case TypeKind.Decimal:
      case TypeKind.Boolean:
      case TypeKind.String:
      case TypeKind.Template:
      case TypeKind.Array:
      case TypeKind.Function:
      case TypeKind.Object:
      case TypeKind.Instance:
      case TypeKind.Tuple:
      case TypeKind.AnyObject:
      case TypeKind.Iterator:
      case TypeKind.Json:
      case TypeKind.Dict:
      case TypeKind.Unknown:
      case TypeKind.Literal:
      case TypeKind.Class:
        return true;
      case TypeKind.Union:
        return base.parts.every((part) => part.kind != TypeKind.TypeParameter);
      default:
        return false;
    }
  }
}
