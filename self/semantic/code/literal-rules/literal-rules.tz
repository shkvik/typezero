import { Checked } from "../../../diagnostic/types/message.types.tz";
import { Code } from "../../../diagnostic/code.tz";
import {
  Expr,
  ExprKind,
  NameExpr,
  UnaryExpr,
  UnaryOp,
} from "../../../program/ast/types/ast.types.expressions.tz";
import {
  IntType,
  LiteralKind,
  Type,
  TypeKind,
} from "../../../program/type/types/type.types.tz";
import { kNoDetails } from "../../../diagnostic/const/message.const.tz";
import { LiteralValue } from "../expression-types/types/expression-types.types.tz";
import { TypeText } from "../../../program/type/type-text/type-text.tz";
import { kIntLimits } from "../integer-math/const/integer-math.const.tz";
import { TypeStore } from "../../../program/type/type-store/type-store.tz";
import { TypeQuestions } from "../../types/type-questions/type-questions.tz";

export class LiteralRules {
  private readonly store: TypeStore;
  private readonly types: TypeQuestions;
  private readonly text: TypeText;

  public constructor(store: TypeStore, types: Own<TypeQuestions>, text: TypeText) {
    this.store = store;
    this.types = types;
    this.text = text;
  }

  public readonly plainLiteral(kind: LiteralKind, text: string): LiteralValue {
    return { kind, text, whole: 0, negative: false };
  }

  public readonly signedLiteral(expr: UnaryExpr): LiteralValue | undefined {
    const operand = expr.operand;
    const negative = expr.op == UnaryOp.Neg;
    if (!negative && expr.op != UnaryOp.Plus) {
      return undefined;
    }
    if (operand.kind == ExprKind.FloatLit) {
      const value = this.signedDouble(operand.value, negative);

      return this.plainLiteral(LiteralKind.Double, `${value}`);
    }
    if (operand.kind != ExprKind.IntLit) {
      return undefined;
    }

    const whole = operand.value;
    const isBelow = negative && whole > 0;
    const text = this.signedText(whole, isBelow);

    return { kind: LiteralKind.Int, text, whole, negative: isBelow };
  }

  public readonly fractionTyped(
    expr: Expr,
    literal: LiteralValue,
    parts: Read<Type[]>,
    base: Type,
  ): Type {
    if (this.hasLiteral(parts, LiteralKind.Double)) {
      return this.store.literal(LiteralKind.Double, literal.text);
    }
    if (expr.kind == ExprKind.Name) {
      return base;
    }

    const target = parts.find(
      (part) => part.kind == TypeKind.Double || part.kind == TypeKind.Decimal,
    );

    return target ?? base;
  }

  public readonly literalPlace(expr: Expr): int {
    if (expr.kind == ExprKind.Unary) {
      return expr.operand.loc;
    }

    return expr.loc;
  }

  public readonly fits(literal: LiteralValue, target: IntType): boolean {
    const limit = kIntLimits.find(
      (row) => row.bits == target.bits && row.unsigned == target.unsigned,
    );
    if (limit == undefined) {
      return false;
    }
    if (literal.negative) {
      return literal.whole <= limit.lowest;
    }

    return literal.whole <= limit.highest;
  }

  public readonly hasLiteral(parts: Read<Type[]>, kind: LiteralKind): boolean {
    return parts.some(
      (part) => part.kind == TypeKind.Literal && part.literal == kind,
    );
  }

  public readonly isTextual(part: Type): boolean {
    if (part.kind == TypeKind.Template) {
      return true;
    }

    return part.kind == TypeKind.Literal && part.literal == LiteralKind.String;
  }

  public readonly templated(wanted: Type | undefined): Type {
    const text = this.store.plain(TypeKind.String);
    const parts = this.types.definedParts(wanted ?? text);
    if (parts.some((part) => this.isTextual(part))) {
      return this.store.plain(TypeKind.Error);
    }

    return text;
  }

  public readonly textChoice(texts: Read<string[]>, wanted: Type): Type | undefined {
    const parts = this.types.definedParts(wanted);
    if (!parts.some((part) => this.isTextual(part))) {
      return undefined;
    }

    const literals = texts.map((text) =>
      this.store.literal(LiteralKind.String, text),
    );

    return this.store.unionOf(literals);
  }

  public readonly nullTyped(expr: NameExpr, wanted: Type | undefined): Checked<Type> {
    const target = this.types.wantedPart(wanted);
    if (target != undefined && target.kind == TypeKind.Json) {
      return { value: target };
    }

    return {
      value: this.store.plain(TypeKind.Error),
      error: { code: Code.NullValue, loc: expr.loc, details: kNoDetails },
    };
  }

  public readonly wholeTyped(
    expr: Expr,
    literal: LiteralValue,
    parts: Read<Type[]>,
    base: Type,
  ): Checked<Type> {
    const exact = this.store.literal(LiteralKind.Int, literal.text);
    const hasWholes = this.hasLiteral(parts, LiteralKind.Int);
    const hasDoubles = this.hasLiteral(parts, LiteralKind.Double);
    const isListed = parts.includes(exact) || !hasDoubles;
    const hasLiterals = hasWholes || hasDoubles;
    if (expr.kind == ExprKind.Name && hasLiterals) {
      return { value: base };
    }
    if (hasWholes && isListed) {
      return { value: exact };
    }
    if (hasDoubles) {
      return { value: this.store.literal(LiteralKind.Double, literal.text) };
    }

    const target = parts.find((part) => this.types.isNumber(part));
    if (target == undefined) {
      return { value: base };
    }
    if (target.kind != TypeKind.Int || this.fits(literal, target)) {
      return { value: target };
    }
    if (expr.kind == ExprKind.Name) {
      return { value: base };
    }

    const word = this.text.of(target);
    const loc = this.literalPlace(expr);

    return {
      value: target,
      error: { code: Code.IntegerLiteralTooBig, loc, details: { word } },
    };
  }

  private readonly signedDouble(value: double, negative: boolean): double {
    if (negative) {
      return -value;
    }

    return value;
  }

  private readonly signedText(whole: uint64, negative: boolean): string {
    if (negative) {
      return `-${whole}`;
    }

    return `${whole}`;
  }
}
