import { Checked } from "../../../diagnostic/types/message.types.tz";
import { Code } from "../../../diagnostic/code.tz";
import { CallArgument } from "../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../program/ast/types/ast.types.functions.tz";
import {
  FunctionType,
  Type,
  TypeKind,
} from "../../../program/type/types/type.types.tz";
import { RankedVariant } from "../expression-types/types/expression-types.types.tz";
import { ClassRules } from "../class-rules/class-rules.tz";
import { TypeText } from "../../../program/type/type-text/type-text.tz";
import { TypeQuestions } from "../../types/type-questions/type-questions.tz";
import { SourceTexts } from "../source-texts/source-texts.tz";
import { MismatchRules } from "../../types/mismatch-rules/mismatch-rules.tz";

export class OverloadRules {
  private readonly text: TypeText;
  private readonly types: TypeQuestions;
  private readonly sources: SourceTexts;
  private readonly mismatches: MismatchRules;
  private readonly classes: ClassRules;

  public constructor(
    text: TypeText,
    types: TypeQuestions,
    sources: SourceTexts,
    mismatches: MismatchRules,
    classes: ClassRules,
  ) {
    this.text = text;
    this.types = types;
    this.sources = sources;
    this.mismatches = mismatches;
    this.classes = classes;
  }

  public sharedCount(one: FunctionType, other: FunctionType): int {
    const least = Math.max(this.leastOf(one), this.leastOf(other));
    const most = Math.min(one.shape.params.length, other.shape.params.length);

    for (let count = least; count <= most; count++) {
      if (this.isSamePrefix(one, other, count)) {
        return count;
      }
    }

    return -1;
  }

  public leastOf(type: FunctionType): int {
    let least = 0;

    for (const param of type.shape.params) {
      if (!param.optional) {
        least += 1;
      }
    }

    if (type.shape.rest && least > 0) {
      return least - 1;
    }

    return least;
  }

  public overloadText(fn: FunctionDecl, type: FunctionType): string {
    const parts: string[] = [];

    for (let index = 0; index < fn.params.length; index++) {
      const param = fn.params[index];
      const shown = type.shape.params[index];
      if (param == undefined || shown == undefined) {
        continue;
      }

      const mark = this.optionalMark(shown.optional);
      const written = this.text.of(shown.type);

      parts.push(`${param.name}${mark}: ${written}`);
    }

    const name = this.variantName(fn);

    return `${name}(${parts.join(", ")})`;
  }

  public variantList(texts: string[]): string {
    const last = texts[texts.length - 1];
    if (texts.length < 2 || last == undefined) {
      return texts.join("");
    }

    const head = texts.slice(0, texts.length - 1);

    return `${head.join(", ")} and ${last}`;
  }

  public isCountFitting(type: FunctionType, count: int): boolean {
    const least = this.leastOf(type);
    const most = type.shape.params.length;

    return count >= least && (count <= most || type.shape.rest);
  }

  public tieCode(isAdapted: boolean): Code {
    if (isAdapted) {
      return Code.VariantTieLiteral;
    }

    return Code.VariantTie;
  }

  public variantParam(type: FunctionType, index: int): Type | undefined {
    const params = type.shape.params;
    const param = params[index] ?? params[params.length - 1];
    if (param == undefined) {
      return undefined;
    }

    const isRest = type.shape.rest && index >= params.length - 1;
    if (isRest && param.type.kind == TypeKind.Array) {
      return param.type.item;
    }

    return param.type;
  }

  public variantHint(
    args: CallArgument[],
    given: Type[],
    variant: RankedVariant,
    module: int,
  ): string {
    const index = variant.failed;
    const arg = args[index];
    const type = given[index];
    const param = this.variantParam(variant.type, index);
    if (arg == undefined || type == undefined || param == undefined) {
      return "";
    }

    const code = this.mismatches.numberCode(this.types.apparent(type), param);
    const word = this.sources.operandName(arg.expr);
    const other = this.mismatches.conversionName(param);
    if (code == Code.ConvertExplicitly) {
      return `; convert it explicitly: '${word}.${other}()'`;
    }
    if (code == Code.RoundThenConvert) {
      return `; round it first, then convert: 'Math.trunc(${word}).${other}()' (or Math.round, Math.floor, Math.ceil)`;
    }

    return "";
  }

  public isBestVariant(
    variant: RankedVariant,
    applicable: RankedVariant[],
  ): boolean {
    return applicable.every(
      (other) => other == variant || this.isBetterVariant(variant, other),
    );
  }

  public variantPairCheck(
    first: FunctionDecl,
    second: FunctionDecl,
    one: FunctionType,
    other: FunctionType,
    what: string,
  ): Checked<boolean> {
    if (this.classes.isSameParameters(one, other)) {
      const isReturnOnly = one.shape.result != other.shape.result;
      if (isReturnOnly && first.returnType != undefined) {
        return {
          value: true,
          error: {
            code: Code.VariantReturnOnly,
            loc: second.loc,
            details: { word: what },
          },
        };
      }

      return {
        value: true,
        error: {
          code: Code.VariantDuplicate,
          loc: second.loc,
          details: {
            word: this.overloadText(second, other),
          },
        },
      };
    }

    const count = this.sharedCount(one, other);
    if (count < 0) {
      return { value: false };
    }

    return {
      value: true,
      error: {
        code: Code.VariantAmbiguous,
        loc: second.loc,
        details: {
          first: this.overloadText(first, one),
          second: this.overloadText(second, other),
          other: `${count}`,
          place: this.classes.pluralMark(count),
        },
      },
    };
  }

  private isSamePrefix(
    one: FunctionType,
    other: FunctionType,
    count: int,
  ): boolean {
    for (let index = 0; index < count; index++) {
      const mine = one.shape.params[index];
      const theirs = other.shape.params[index];
      if (
        mine == undefined ||
        theirs == undefined ||
        mine.type != theirs.type
      ) {
        return false;
      }
    }

    return true;
  }

  private optionalMark(isOptional: boolean): string {
    if (isOptional) {
      return "?";
    }

    return "";
  }

  private variantName(fn: FunctionDecl): string {
    if (fn.name == "" || fn.name == "constructor") {
      return "constructor";
    }

    return fn.name;
  }

  private isBetterVariant(
    variant: RankedVariant,
    other: RankedVariant,
  ): boolean {
    const isFuller = !this.isLeavingOut(variant) && this.isLeavingOut(other);
    let isStrictly = isFuller;

    for (let index = 0; index < variant.ranks.length; index++) {
      const mine = variant.ranks[index] ?? 0;
      const theirs = other.ranks[index] ?? 0;
      if (mine > theirs) {
        return false;
      }
      if (mine < theirs) {
        isStrictly = true;
      }
    }

    return isStrictly;
  }

  private isLeavingOut(variant: RankedVariant): boolean {
    const shape = variant.type.shape;

    return shape.rest || variant.ranks.length < shape.params.length;
  }
}
