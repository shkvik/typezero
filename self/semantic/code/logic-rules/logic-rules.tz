import {
  Checked,
  SourceError,
} from "../../../diagnostic/types/message.types.tz";
import { Code } from "../../../diagnostic/code.tz";
import {
  AssignExpr,
  BinaryExpr,
  ConditionalExpr,
  Expr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import { TruthUse } from "../../flow/truth-rules/types/truth-rules.types.tz";
import { TypeUnifier } from "../../types/type-unifier/type-unifier.tz";
import { TypeText } from "../../../program/type/type-text/type-text.tz";
import {
  kUndefinedText,
  kUnnamedOperand,
} from "../source-texts/const/source-texts.const.tz";
import {
  kAndText,
  kEmptyText,
  kEquals,
  kNotEquals,
  kOrText,
  kOtherPlaceholder,
  kZeroText,
} from "./const/logic-rules.const.tz";
import { SourceTexts } from "../source-texts/source-texts.tz";
import { kNegation } from "../../flow/truth-rules/const/truth-rules.const.tz";
import { TypeStore } from "../../../program/type/type-store/type-store.tz";
import { TypeQuestions } from "../../types/type-questions/type-questions.tz";
import { TruthRules } from "../../flow/truth-rules/truth-rules.tz";
import { ExpressionShapes } from "../expression-shapes/expression-shapes.tz";

export class LogicRules {
  private readonly store: TypeStore;
  private readonly types: TypeQuestions;
  private readonly truth: TruthRules;
  private readonly shapes: ExpressionShapes;
  private readonly sources: SourceTexts;
  private readonly text: TypeText;
  private readonly unifier: TypeUnifier;

  public constructor(
    store: TypeStore,
    types: Own<TypeQuestions>,
    truth: Own<TruthRules>,
    shapes: ExpressionShapes,
    sources: Own<SourceTexts>,
    text: TypeText,
    unifier: Own<TypeUnifier>,
  ) {
    this.store = store;
    this.types = types;
    this.truth = truth;
    this.shapes = shapes;
    this.sources = sources;
    this.text = text;
    this.unifier = unifier;
  }

  public readonly equalsText(isNegated: boolean): string {
    if (isNegated) {
      return kNotEquals;
    }

    return kEquals;
  }

  public readonly emptyTest(type: Type, isNegated: boolean): string {
    const test = this.equalsText(!isNegated);
    const base = this.types.definedType(type);

    if (this.types.isOptional(type)) {
      return `${test} ${kUndefinedText}`;
    }
    if (base.kind == TypeKind.String) {
      return `${test} ${kEmptyText}`;
    }

    return `${test} ${kZeroText}`;
  }

  public readonly logicalUse(isAnd: boolean): TruthUse {
    if (isAnd) {
      return TruthUse.And;
    }

    return TruthUse.Or;
  }

  public readonly rightHint(
    isAnd: boolean,
    left: Type,
    expected: Type | undefined,
  ): Type | undefined {
    const isPlain =
      isAnd || left.kind == TypeKind.Error || left.kind == TypeKind.Undefined;
    if (isPlain) {
      return expected;
    }

    return this.types.definedType(left);
  }

  public readonly logicalText(isAnd: boolean): string {
    if (isAnd) {
      return kAndText;
    }

    return kOrText;
  }

  public readonly negatedText(test: string, isAnd: boolean): string {
    if (isAnd) {
      return test;
    }

    return kNegation + test;
  }

  public readonly keptLeft(left: Type, isAnd: boolean): Type {
    if (!isAnd) {
      return this.types.definedType(left);
    }

    const base = this.types.definedType(left);
    const isAlwaysTruthy =
      base.kind == TypeKind.Array ||
      base.kind == TypeKind.Function ||
      this.truth.isTruthyObject(base);
    if (isAlwaysTruthy) {
      return this.store.plain(TypeKind.Undefined);
    }

    return left;
  }

  public readonly noCommonCode(isAnd: boolean): Code {
    if (isAnd) {
      return Code.LogicalAndNoCommon;
    }

    return Code.LogicalOrNoCommon;
  }

  public readonly branchHint(
    literal: Expr,
    other: Type,
    wanted: Type | undefined,
  ): Type | undefined {
    if (this.shapes.isNumberTree(literal)) {
      return this.decimalHint(other, wanted);
    }
    if (wanted != undefined) {
      return wanted;
    }
    if (other.kind == TypeKind.Error) {
      return undefined;
    }

    return other;
  }

  public readonly elseHint(
    expr: ConditionalExpr,
    thenType: Type,
    wanted: Type | undefined,
    isElseWaitingOnly: boolean,
  ): Type | undefined {
    if (isElseWaitingOnly) {
      return this.branchHint(expr.elseExpr, thenType, wanted);
    }
    if (this.shapes.isNumberTree(expr.elseExpr)) {
      return this.decimalHint(thenType, wanted);
    }

    return wanted;
  }

  public readonly assignmentConditionError(
    expr: AssignExpr,
    type: Type,
    use: TruthUse,
  ): SourceError | undefined {
    const isNegated = use == TruthUse.Not;
    const first = this.sources.hintText(expr.target, kUnnamedOperand);
    const second = this.sources.hintText(expr.value, kOtherPlaceholder);
    const base = this.types.definedType(type);
    const isTestable =
      this.types.isOptional(type) ||
      this.types.isNumberLike(base) ||
      base.kind == TypeKind.String;
    const isCompared =
      this.shapes.isWrittenLiteral(expr.value) ||
      type.kind == TypeKind.Error ||
      !isTestable;
    if (isCompared) {
      const word = this.equalsText(isNegated);

      return {
        code: Code.AssignmentCompared,
        loc: expr.loc,
        details: {
          word,
          first,
          second,
        },
      };
    }

    const other = this.emptyTest(type, isNegated);

    return {
      code: Code.AssignmentTested,
      loc: expr.loc,
      details: {
        first,
        second,
        other,
      },
    };
  }

  public readonly rightVoid(expr: BinaryExpr, isAnd: boolean): Checked<Type> {
    const word = this.logicalText(isAnd);
    const test = this.sources.hintText(expr.lhs, kUnnamedOperand);
    const first = this.negatedText(test, isAnd);
    const second = this.sources.hintText(expr.rhs, kOtherPlaceholder);

    return {
      value: this.store.plain(TypeKind.Error),
      error: {
        code: Code.RightSideVoid,
        loc: expr.loc,
        details: { word, first, second },
      },
    };
  }

  public readonly logicalResult(
    expr: BinaryExpr,
    left: Type,
    right: Type,
    isAnd: boolean,
  ): Checked<Type> {
    const isBroken =
      left.kind == TypeKind.Error || right.kind == TypeKind.Error;
    if (isBroken) {
      return { value: this.store.plain(TypeKind.Error) };
    }

    const isBoolean =
      left.kind == TypeKind.Boolean && right.kind == TypeKind.Boolean;
    if (isBoolean) {
      return { value: left };
    }
    if (right.kind == TypeKind.Void) {
      return this.rightVoid(expr, isAnd);
    }

    const kept = this.keptLeft(left, isAnd);
    const result = this.unifier.unify(kept, right);
    if (result != undefined) {
      return { value: result };
    }

    const first = this.text.of(kept);
    const second = this.text.of(right);
    const code = this.noCommonCode(isAnd);

    return {
      value: this.store.plain(TypeKind.Error),
      error: { code, loc: expr.loc, details: { first, second } },
    };
  }

  private readonly decimalHint(other: Type, hint: Type | undefined): Type | undefined {
    const plain = this.types.definedType(other);
    if (plain.kind == TypeKind.Decimal) {
      return plain;
    }

    return hint;
  }
}
