import { Code } from "../../../diagnostic/code.tz";
import { kNoDetails } from "../../../diagnostic/const/message.const.tz";
import {
  ClassDecl,
  Decorator,
  FieldKind,
} from "../../../program/ast/types/ast.types.classes.tz";
import {
  Expr,
  ExprKind,
} from "../../../program/ast/types/ast.types.expressions.tz";
import {
  FunctionType,
  Type,
  TypeKind,
} from "../../../program/type/types/type.types.tz";
import {
  DecorateRun,
  DecoratedName,
  DecoratorPlace,
  DecoratorUse,
} from "../expression-types/types/expression-types.types.tz";
import {
  kDecoratorPlaces,
  kDescriptorValueName,
} from "./const/decorator-rules.const.tz";
import { ClassRules } from "../class-rules/class-rules.tz";
import {
  Checked,
  SourceError,
} from "../../../diagnostic/types/message.types.tz";
import { OverloadRules } from "../overload-rules/overload-rules.tz";
import { FunctionDecl } from "../../../program/ast/types/ast.types.functions.tz";
import { kHiddenMark } from "../source-texts/const/source-texts.const.tz";
import { TypeQuestions } from "../../types/type-questions/type-questions.tz";

export class DecoratorRules {
  private readonly types: TypeQuestions;
  private readonly overloads: OverloadRules;
  private readonly classes: ClassRules;

  public constructor(
    types: TypeQuestions,
    overloads: OverloadRules,
    classes: ClassRules,
  ) {
    this.types = types;
    this.overloads = overloads;
    this.classes = classes;
  }

  public isDecoratedClass(decl: ClassDecl): boolean {
    const isMethod = decl.methods.some((fn) => this.isDecoratedFunction(fn));
    const isMade = decl.constructors.some((fn) => this.hasDecoratedParams(fn));
    const isField = decl.fields.some((field) => field.decorators.length > 0);

    return decl.decorators.length > 0 || isMethod || isMade || isField;
  }

  public hasDecoratedParams(fn: FunctionDecl): boolean {
    return fn.params.some((param) => param.decorators.length > 0);
  }

  public decoratorNames(decorators: Decorator[]): string[] {
    return decorators.map((decorator) => this.decoratorName(decorator.expr));
  }

  public methodDecoratorNames(fn: FunctionDecl): string[] {
    const names = this.decoratorNames(fn.role?.decorators ?? []);

    for (const param of fn.params) {
      const more = this.decoratorNames(param.decorators);

      names.push(...more);
    }

    return names;
  }

  public clashWhat(earlier: DecoratedName, later: DecoratedName): string {
    const name = later.name;
    if (earlier.isStatic != later.isStatic) {
      return `both the static member '${name}' and the member '${name}'`;
    }

    return `two variants of '${name}'`;
  }

  public clashRecords(earlier: DecoratedName, later: DecoratedName): string {
    const names = later.decorators.slice().reverse();
    const shared = names.find(
      (name) => name != "" && earlier.decorators.includes(name),
    );
    if (shared == undefined) {
      return "the records 'design:*' the compiler writes";
    }

    return `the records of '@${shared}'`;
  }

  public ownUses(decorators: Decorator[]): DecoratorUse[] {
    return decorators.map((decorator) => ({ decorator, param: -1 }));
  }

  public addParamUses(uses: DecoratorUse[], fn: FunctionDecl): void {
    for (let index = 0; index < fn.params.length; index++) {
      const param = fn.params[index];

      for (const decorator of param?.decorators ?? []) {
        uses.push({ decorator, param: index });
      }
    }
  }

  public classUses(decl: ClassDecl): DecoratorUse[] {
    const uses = this.ownUses(decl.decorators);

    for (const fn of decl.constructors) {
      this.addParamUses(uses, fn);
    }

    return uses;
  }

  public isDescriptorUse(place: DecoratorPlace, count: int): boolean {
    return place == DecoratorPlace.Method && count >= 3;
  }

  public usePlace(run: DecorateRun, use: DecoratorUse): DecoratorPlace {
    if (use.param >= 0) {
      return DecoratorPlace.Parameter;
    }

    return run.place;
  }

  public thirdParameter(type: FunctionType): Type | undefined {
    const third = type.shape.params[2];
    if (third == undefined) {
      return undefined;
    }

    return this.types.definedType(third.type);
  }

  public isDescriptorType(type: Type): boolean {
    if (type.kind != TypeKind.Object) {
      return false;
    }

    return type.fields.some((field) => field.name == kDescriptorValueName);
  }

  public isPositionType(type: Type): boolean {
    return type.kind == TypeKind.Int || type.kind == TypeKind.Double;
  }

  public decoratorLabel(expr: Expr): string {
    const name = this.decoratorName(expr);
    if (name == "") {
      return "the decorator";
    }

    return `'${name}'`;
  }

  public decoratedConstructorsCheck(decl: ClassDecl): SourceError | undefined {
    const decorated = decl.constructors.filter((fn) =>
      this.hasDecoratedParams(fn),
    );
    const second = decorated[1];
    if (second == undefined) {
      return undefined;
    }

    return {
      code: Code.DecoratedConstructors,
      loc: second.loc,
      details: {
        word: decl.name ?? "",
      },
    };
  }

  public nameClashCheck(
    decl: ClassDecl,
    earlier: DecoratedName[],
    later: DecoratedName,
  ): SourceError | undefined {
    const other = earlier.find((one) => one.name == later.name);
    if (other == undefined) {
      return undefined;
    }

    const first = this.clashWhat(other, later);
    const second = this.clashRecords(other, later);

    return {
      code: Code.DecoratedSameName,
      loc: later.loc,
      details: {
        word: decl.name ?? "",
        first,
        second,
      },
    };
  }

  public parameterPlaceCheck(fn: FunctionDecl): SourceError[] {
    const errors: SourceError[] = [];

    if (fn.role != undefined) {
      return errors;
    }

    for (const param of fn.params) {
      const first = param.decorators[0];
      if (first != undefined) {
        errors.push({
          code: Code.DecoratorParameterPlace,
          loc: first.loc,
          details: kNoDetails,
        });
      }
    }

    return errors;
  }

  public decoratorFit(
    use: DecoratorUse,
    place: DecoratorPlace,
    type: Type,
  ): Checked<int> {
    const row = kDecoratorPlaces.find((one) => one.place == place);
    const given = row?.given ?? 3;
    if (row == undefined || type.kind != TypeKind.Function || type.shape.rest) {
      return { value: given };
    }

    const params = type.shape.params;
    const isUnknown = params.some((param) => param.type.kind == TypeKind.Error);
    if (isUnknown) {
      return { value: given };
    }

    const count = params.length;
    const needs = Math.min(this.overloads.leastOf(type), count);
    const word = this.decoratorLabel(use.decorator.expr);
    const loc = use.decorator.loc;
    if (needs > given) {
      return {
        value: -1,
        error: {
          code: Code.DecoratorArguments,
          loc,
          details: {
            word,
            first: row.noun,
            other: `${needs}`,
            second: `${given}`,
            place: row.args,
          },
        },
      };
    }

    const third = this.thirdParameter(type);
    const isDescriptor = third != undefined && this.isDescriptorType(third);
    if (isDescriptor && place == DecoratorPlace.Parameter) {
      return {
        value: -1,
        error: {
          code: Code.DecoratorDescriptorParameter,
          loc,
          details: { word },
        },
      };
    }

    const isPosition = third != undefined && this.isPositionType(third);
    if (isPosition && place == DecoratorPlace.Method) {
      return {
        value: -1,
        error: {
          code: Code.DecoratorPositionMethod,
          loc,
          details: { word },
        },
      };
    }

    return { value: count };
  }

  public decoratedNamesCheck(decl: ClassDecl): SourceError[] {
    const errors: SourceError[] = [];

    const members = this.decoratedNames(decl);

    for (let index = 1; index < members.length; index++) {
      const later = members[index];
      if (later != undefined) {
        const nameClashError = this.nameClashCheck(
          decl,
          members.slice(0, index),
          later,
        );

        if (nameClashError != undefined) {
          errors.push(nameClashError);
        }
      }
    }

    return errors;
  }

  public decoratedNames(decl: ClassDecl): DecoratedName[] {
    const members: DecoratedName[] = [];

    for (const field of decl.fields) {
      const decorators = this.decoratorNames(field.decorators);
      if (decorators.length > 0) {
        members.push({
          name: field.name,
          loc: field.loc,
          isStatic: field.form == FieldKind.Static,
          decorators,
        });
      }
    }

    for (const fn of decl.methods) {
      const decorators = this.methodDecoratorNames(fn);
      if (decorators.length > 0) {
        members.push({
          name: fn.name,
          loc: fn.loc,
          isStatic: this.classes.isStaticMethod(fn),
          decorators,
        });
      }
    }

    return members;
  }

  public memberRuns(decl: ClassDecl): DecorateRun[] {
    const runs: DecorateRun[] = [];

    for (const field of decl.fields) {
      const uses = this.ownUses(field.decorators);
      const first = uses[0];
      if (first != undefined) {
        runs.push({
          decl,
          field,
          uses,
          place: DecoratorPlace.Field,
          isStatic: field.form == FieldKind.Static,
          at: first.decorator.loc,
        });
      }
    }

    for (const fn of decl.methods) {
      const uses = this.ownUses(fn.role?.decorators ?? []);

      this.addParamUses(uses, fn);

      const first = uses[0];
      if (first != undefined) {
        runs.push({
          decl,
          method: fn,
          uses,
          place: DecoratorPlace.Method,
          isStatic: this.classes.isStaticMethod(fn),
          at: first.decorator.loc,
        });
      }
    }

    const instance = runs.filter((run) => !run.isStatic);
    const statics = runs.filter((run) => run.isStatic);

    return instance.concat(statics);
  }

  private isDecoratedFunction(fn: FunctionDecl): boolean {
    const own = fn.role?.decorators ?? [];

    return own.length > 0 || this.hasDecoratedParams(fn);
  }

  private decoratorName(expr: Expr): string {
    const names: string[] = [];
    let link = this.withoutCalls(expr);

    while (link.kind == ExprKind.Member) {
      names.push(link.name);
      link = this.withoutCalls(link.object);
    }

    if (link.kind != ExprKind.Name || link.name.startsWith(kHiddenMark)) {
      return "";
    }

    return [link.name].concat(names.reverse()).join(".");
  }

  private withoutCalls(expr: Expr): Expr {
    let callee = expr;

    while (callee.kind == ExprKind.Call) {
      callee = callee.callee;
    }

    return callee;
  }
}
