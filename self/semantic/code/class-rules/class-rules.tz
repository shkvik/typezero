import { SourceError } from "../../../diagnostic/types/message.types.tz";
import { Code } from "../../../diagnostic/code.tz";
import { kNoDetails } from "../../../diagnostic/const/message.const.tz";
import {
  ExprKind,
  NameExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../program/ast/types/ast.types.functions.tz";
import {
  FunctionType,
  InstanceType,
  Type,
  TypeKind,
} from "../../../program/type/types/type.types.tz";
import {
  ClassMemberEntry,
  InitFrame,
  ThisPlace,
} from "../expression-types/types/expression-types.types.tz";
import {
  Access,
  ClassDecl,
  ClassField,
  FieldKind,
  FieldPresence,
  MethodKind,
} from "../../../program/ast/types/ast.types.classes.tz";
import {
  kPrivateWord,
  kProtectedWord,
  kPublicWord,
} from "./const/class-rules.const.tz";
import {
  ParameterSite,
  TypeContext,
  TypePlace,
} from "../../types/type-resolver/types/type-resolver.types.tz";
import { TypeText } from "../../../program/type/type-text/type-text.tz";
import { TypeQuestions } from "../../types/type-questions/type-questions.tz";

export class ClassRules {
  private readonly text: TypeText;
  private readonly types: TypeQuestions;

  public constructor(text: TypeText, types: TypeQuestions) {
    this.text = text;
    this.types = types;
  }

  public contextOf(module: int, place: TypePlace): TypeContext {
    return { module, bindings: new Map<int, Type>(), place };
  }

  public isScalarField(type: Type): boolean {
    switch (type.kind) {
      case TypeKind.Int:
      case TypeKind.Double:
      case TypeKind.Decimal:
      case TypeKind.String:
      case TypeKind.Boolean:
        return true;
      default:
        return false;
    }
  }

  public isSameParameters(own: FunctionType, theirs: FunctionType): boolean {
    const mine = own.shape.params;
    const other = theirs.shape.params;
    if (mine.length != other.length || own.shape.rest != theirs.shape.rest) {
      return false;
    }

    return mine.every((param, index) => {
      const that = other[index];

      return (
        that != undefined &&
        (param.type == that.type || param.type.kind == TypeKind.Error) &&
        param.optional == that.optional
      );
    });
  }

  public accessRank(access: Access): int {
    switch (access) {
      case Access.Public:
        return 0;
      case Access.Protected:
        return 1;
      default:
        return 2;
    }
  }

  public accessWord(access: Access): string {
    switch (access) {
      case Access.Public:
        return kPublicWord;
      case Access.Protected:
        return kProtectedWord;
      default:
        return kPrivateWord;
    }
  }

  public variantText(fn: FunctionDecl, type: FunctionType): string {
    const params = type.shape.params;
    const parts: string[] = [];

    for (let index = 0; index < fn.params.length; index++) {
      const param = fn.params[index];
      const typed = params[index];
      if (param != undefined && typed != undefined) {
        const text = this.text.of(typed.type);

        parts.push(`${param.name}: ${text}`);
      }
    }

    return `${fn.name}(${parts.join(", ")})`;
  }

  public initFrameOf(decl: ClassDecl, fn: FunctionDecl): InitFrame {
    const isConstructor = fn.role?.method == MethodKind.Constructor;
    const isDerived = decl.base != undefined || decl.baseExpr != undefined;

    return { isConstructor, fn, decl, isDerived, closures: [] };
  }

  public isArrowField(field: ClassField): boolean {
    const init = field.init;
    const isArrow = init?.kind == ExprKind.Function && init.fn.isArrow;

    return isArrow || field.form == FieldKind.ArrowMethod;
  }

  public isRequiredField(field: ClassField): boolean {
    const isValueField =
      field.form == FieldKind.Instance || field.form == FieldKind.Parameter;

    return isValueField && field.presence != FieldPresence.Optional;
  }

  public ownValueField(frame: InitFrame, name: string): ClassField | undefined {
    return frame.decl.fields.find(
      (field) =>
        field.name == name &&
        field.form != FieldKind.Static &&
        !this.isArrowField(field),
    );
  }

  public leaveInitClosure(frame: InitFrame | undefined): void {
    if (frame != undefined) {
      frame.closures.pop();
    }
  }

  public isSameLayout(own: Type, theirs: Type): boolean {
    if (own == theirs) {
      return true;
    }
    if (own.kind == TypeKind.Array && theirs.kind == TypeKind.Array) {
      return this.isSameLayout(own.item, theirs.item);
    }
    if (own.kind != TypeKind.Instance || theirs.kind != TypeKind.Instance) {
      return false;
    }

    return this.types.ancestorsOf(own).includes(theirs);
  }

  public previousInCycle(
    cycle: InstanceType[],
    member: InstanceType,
  ): InstanceType | undefined {
    const at = cycle.indexOf(member);
    if (at == 0) {
      return cycle[cycle.length - 1];
    }

    return cycle[at - 1];
  }

  public earliestOf(cycle: InstanceType[]): InstanceType | undefined {
    let earliest: InstanceType | undefined = undefined;

    for (const one of cycle) {
      if (earliest == undefined || this.isDeclaredBefore(one, earliest)) {
        earliest = one;
      }
    }

    return earliest;
  }

  public methodPlace(fn: FunctionDecl): ThisPlace {
    if (this.isStaticMethod(fn)) {
      return ThisPlace.StaticMethod;
    }

    return ThisPlace.Method;
  }

  public hasInstanceMember(decl: ClassDecl, name: string): boolean {
    const isField = decl.fields.some(
      (one) => one.name == name && one.form != FieldKind.Static,
    );
    const isMethod = decl.methods.some(
      (one) => one.name == name && !this.isStaticMethod(one),
    );

    return isField || isMethod;
  }

  public accessOf(method: FunctionDecl): Access {
    return method.role?.access ?? Access.Public;
  }

  public parentOf(
    instance: InstanceType,
    decl: ClassDecl,
  ): InstanceType | undefined {
    if (decl.base == undefined) {
      return undefined;
    }

    const parent = this.types.baseClassOf(instance);
    if (parent == undefined || parent.kind != TypeKind.Instance) {
      return undefined;
    }

    return parent;
  }

  public ownMember(
    instance: InstanceType,
    owner: ClassDecl,
    name: string,
  ): ClassMemberEntry | undefined {
    const field = owner.fields.find(
      (one) => one.name == name && one.form != FieldKind.Static,
    );
    const methods = owner.methods.filter(
      (one) => one.name == name && !this.isStaticMethod(one),
    );
    if (field != undefined || methods.length > 0) {
      return { owner, instance, field, methods, isStatic: false };
    }

    const hasStaticField = owner.fields.some(
      (one) => one.name == name && one.form == FieldKind.Static,
    );
    const hasStaticMethod = owner.methods.some(
      (one) => one.name == name && this.isStaticMethod(one),
    );
    if (hasStaticField || hasStaticMethod) {
      return { owner, instance, methods: [], isStatic: true };
    }

    return undefined;
  }

  public isStaticMethod(method: FunctionDecl): boolean {
    return method.role?.method == MethodKind.Static;
  }

  public parameterSites(fn: FunctionDecl): ParameterSite[] | undefined {
    const sites: ParameterSite[] = [];

    for (const param of fn.params) {
      const type = param.type;
      if (type == undefined) {
        return undefined;
      }

      sites.push({
        name: param.name,
        loc: param.loc,
        kind: param.form.kind,
        type,
        isDeclared: false,
      });
    }

    return sites;
  }

  public pluralMark(count: int): string {
    if (count == 1) {
      return "";
    }

    return "s";
  }

  public closureThisCheck(
    frame: InitFrame,
    expr: NameExpr,
  ): SourceError | undefined {
    const isReady = frame.closures[frame.closures.length - 1] ?? true;
    if (isReady) {
      return undefined;
    }

    return {
      code: Code.ThisInEarlyClosure,
      loc: expr.loc,
      details: kNoDetails,
    };
  }

  public fieldAccessCheck(
    decl: ClassDecl,
    field: ClassField,
    inherited: ClassField,
    owner: string,
  ): SourceError | undefined {
    const ownRank = this.accessRank(field.access);
    const theirRank = this.accessRank(inherited.access);
    if (ownRank <= theirRank) {
      return undefined;
    }

    return {
      code: Code.FieldAccessNarrower,
      loc: field.loc,
      details: {
        word: field.name,
        other: this.accessWord(inherited.access),
        first: owner,
        second: this.accessWord(field.access),
        place: decl.name ?? "",
      },
    };
  }

  private isDeclaredBefore(one: InstanceType, other: InstanceType): boolean {
    if (one.module != other.module) {
      return one.module < other.module;
    }

    return one.loc < other.loc;
  }
}
