import {
  Checked,
  SourceError,
} from "../../../diagnostic/types/message.types.tz";
import { Code } from "../../../diagnostic/code.tz";
import { kNoDetails } from "../../../diagnostic/const/message.const.tz";
import {
  BinaryExpr,
  ExprKind,
  MemberExpr,
  NameExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../program/ast/types/ast.types.functions.tz";
import {
  TypeRef,
  TypeRefKind,
} from "../../../program/ast/types/ast.types.types.tz";
import {
  ClassType,
  DictKind,
  FunctionType,
  InstanceType,
  ObjectField,
  Type,
  TypeKind,
} from "../../../program/type/types/type.types.tz";
import {
  ClassMemberEntry,
  InitFrame,
  ThisPlace,
} from "../expression-types/types/expression-types.types.tz";
import {
  Access,
  ClassDecl,
  ClassField,
  FieldKind,
  FieldPresence,
  MethodKind,
} from "../../../program/ast/types/ast.types.classes.tz";
import { kDateName } from "../../types/type-questions/const/type-questions.const.tz";
import {
  kMapClass,
  kPrivateWord,
  kProtectedWord,
  kPublicWord,
} from "./const/class-rules.const.tz";
import {
  ParameterSite,
  TypeContext,
  TypePlace,
} from "../../types/type-resolver/types/type-resolver.types.tz";
import { TypeStore } from "../../../program/type/type-store/type-store.tz";
import { TypeRelation } from "../../types/type-relation/type-relation.tz";
import { TypeText } from "../../../program/type/type-text/type-text.tz";
import { TypeQuestions } from "../../types/type-questions/type-questions.tz";
import { ModuleQuestions } from "../../declaration/module-questions/module-questions.tz";

export class ClassRules {
  private readonly text: TypeText;
  private readonly types: TypeQuestions;
  private readonly modules: ModuleQuestions;
  private readonly relation: TypeRelation;
  private readonly store: TypeStore;

  public constructor(
    text: TypeText,
    types: TypeQuestions,
    modules: ModuleQuestions,
    relation: TypeRelation,
    store: TypeStore,
  ) {
    this.text = text;
    this.types = types;
    this.modules = modules;
    this.relation = relation;
    this.store = store;
  }

  public contextOf(module: int, place: TypePlace): TypeContext {
    return { module, bindings: new Map<int, Type>(), place };
  }

  public isScalarField(type: Type): boolean {
    switch (type.kind) {
      case TypeKind.Int:
      case TypeKind.Double:
      case TypeKind.Decimal:
      case TypeKind.String:
      case TypeKind.Boolean:
        return true;
      default:
        return false;
    }
  }

  public isSameParameters(own: FunctionType, theirs: FunctionType): boolean {
    const mine = own.shape.params;
    const other = theirs.shape.params;
    if (mine.length != other.length || own.shape.rest != theirs.shape.rest) {
      return false;
    }

    return mine.every((param, index) => {
      const that = other[index];

      return (
        that != undefined &&
        (param.type == that.type || param.type.kind == TypeKind.Error) &&
        param.optional == that.optional
      );
    });
  }

  public accessRank(access: Access): int {
    switch (access) {
      case Access.Public:
        return 0;
      case Access.Protected:
        return 1;
      default:
        return 2;
    }
  }

  public accessWord(access: Access): string {
    switch (access) {
      case Access.Public:
        return kPublicWord;
      case Access.Protected:
        return kProtectedWord;
      default:
        return kPrivateWord;
    }
  }

  public variantText(fn: FunctionDecl, type: FunctionType): string {
    const params = type.shape.params;
    const parts: string[] = [];

    for (let index = 0; index < fn.params.length; index++) {
      const param = fn.params[index];
      const typed = params[index];
      if (param != undefined && typed != undefined) {
        const text = this.text.of(typed.type);

        parts.push(`${param.name}: ${text}`);
      }
    }

    return `${fn.name}(${parts.join(", ")})`;
  }

  public contractFieldResult(type: Type): Type | undefined {
    if (type.kind != TypeKind.Function) {
      return undefined;
    }

    return type.shape.result;
  }

  public initFrameOf(decl: ClassDecl, fn: FunctionDecl): InitFrame {
    const isConstructor = fn.role?.method == MethodKind.Constructor;
    const isDerived = decl.base != undefined || decl.baseExpr != undefined;

    return { isConstructor, fn, decl, isDerived, closures: [] };
  }

  public isArrowField(field: ClassField): boolean {
    const init = field.init;
    const isArrow = init?.kind == ExprKind.Function && init.fn.isArrow;

    return isArrow || field.form == FieldKind.ArrowMethod;
  }

  public isRequiredField(field: ClassField): boolean {
    const isValueField =
      field.form == FieldKind.Instance || field.form == FieldKind.Parameter;

    return isValueField && field.presence != FieldPresence.Optional;
  }

  public ownValueField(frame: InitFrame, name: string): ClassField | undefined {
    return frame.decl.fields.find(
      (field) =>
        field.name == name &&
        field.form != FieldKind.Static &&
        !this.isArrowField(field),
    );
  }

  public leaveInitClosure(frame: InitFrame | undefined): void {
    if (frame != undefined) {
      frame.closures.pop();
    }
  }

  public hasEmptyCollection(
    dict: DictKind,
    written: TypeRef | undefined,
  ): boolean {
    const isCollection = dict == DictKind.Map || dict == DictKind.Set;

    return isCollection && written?.form.kind == TypeRefKind.Generic;
  }

  public isSameLayout(own: Type, theirs: Type): boolean {
    if (own == theirs) {
      return true;
    }
    if (own.kind == TypeKind.Array && theirs.kind == TypeKind.Array) {
      return this.isSameLayout(own.item, theirs.item);
    }
    if (own.kind != TypeKind.Instance || theirs.kind != TypeKind.Instance) {
      return false;
    }

    return this.types.ancestorsOf(own).includes(theirs);
  }

  public previousInCycle(
    cycle: InstanceType[],
    member: InstanceType,
  ): InstanceType | undefined {
    const at = cycle.indexOf(member);
    if (at == 0) {
      return cycle[cycle.length - 1];
    }

    return cycle[at - 1];
  }

  public earliestOf(cycle: InstanceType[]): InstanceType | undefined {
    let earliest: InstanceType | undefined = undefined;

    for (const one of cycle) {
      if (earliest == undefined || this.isDeclaredBefore(one, earliest)) {
        earliest = one;
      }
    }

    return earliest;
  }

  public overriddenCode(site: MemberExpr, call: MemberExpr): Code {
    if (site == call) {
      return Code.ConstructorCallsOverride;
    }

    return Code.ConstructorReachesOverride;
  }

  public overridingChild(
    children: ClassDecl[],
    name: string,
  ): ClassDecl | undefined {
    return children.find((child) =>
      child.methods.some(
        (method) => method.name == name && !this.isStaticMethod(method),
      ),
    );
  }

  public isCollectionOf(word: string, type: Type): boolean {
    if (word == kDateName) {
      return this.types.isDate(type);
    }
    if (type.kind != TypeKind.Dict) {
      return false;
    }
    if (word == kMapClass) {
      return type.dict == DictKind.Map;
    }

    return type.dict == DictKind.Set;
  }

  public isOpenTested(base: Type): boolean {
    switch (base.kind) {
      case TypeKind.Error:
      case TypeKind.Unknown:
      case TypeKind.AnyObject:
      case TypeKind.TypeParameter:
      case TypeKind.Operation:
      case TypeKind.Json:
        return true;
      default:
        return false;
    }
  }

  public isObjectTested(base: Type): boolean {
    switch (base.kind) {
      case TypeKind.Object:
      case TypeKind.Instance:
      case TypeKind.Tuple:
      case TypeKind.Array:
      case TypeKind.Dict:
      case TypeKind.Function:
      case TypeKind.Promise:
      case TypeKind.Result:
      case TypeKind.Iterator:
        return true;
      default:
        return false;
    }
  }

  public canHoldClass(parts: Type[], instance: Type): boolean {
    return parts.some((part) => {
      const isObject =
        part.kind == TypeKind.Object || part.kind == TypeKind.Instance;

      return isObject && !this.isUnrelatedClass(part, instance);
    });
  }

  public isUnrelatedClass(part: Type, instance: Type): boolean {
    if (
      part.kind != TypeKind.Instance ||
      this.modules.isLibraryModule(part.module)
    ) {
      return false;
    }

    return !this.isSameLine(part, instance);
  }

  public methodPlace(fn: FunctionDecl): ThisPlace {
    if (this.isStaticMethod(fn)) {
      return ThisPlace.StaticMethod;
    }

    return ThisPlace.Method;
  }

  public hasInstanceMember(decl: ClassDecl, name: string): boolean {
    const isField = decl.fields.some(
      (one) => one.name == name && one.form != FieldKind.Static,
    );
    const isMethod = decl.methods.some(
      (one) => one.name == name && !this.isStaticMethod(one),
    );

    return isField || isMethod;
  }

  public accessOf(method: FunctionDecl): Access {
    return method.role?.access ?? Access.Public;
  }

  public parentOf(
    instance: InstanceType,
    decl: ClassDecl,
  ): InstanceType | undefined {
    if (decl.base == undefined) {
      return undefined;
    }

    const parent = this.types.baseClassOf(instance);
    if (parent == undefined || parent.kind != TypeKind.Instance) {
      return undefined;
    }

    return parent;
  }

  public ownMember(
    instance: InstanceType,
    owner: ClassDecl,
    name: string,
  ): ClassMemberEntry | undefined {
    const field = owner.fields.find(
      (one) => one.name == name && one.form != FieldKind.Static,
    );
    const methods = owner.methods.filter(
      (one) => one.name == name && !this.isStaticMethod(one),
    );
    if (field != undefined || methods.length > 0) {
      return { owner, instance, field, methods, isStatic: false };
    }

    const hasStaticField = owner.fields.some(
      (one) => one.name == name && one.form == FieldKind.Static,
    );
    const hasStaticMethod = owner.methods.some(
      (one) => one.name == name && this.isStaticMethod(one),
    );
    if (hasStaticField || hasStaticMethod) {
      return { owner, instance, methods: [], isStatic: true };
    }

    return undefined;
  }

  public isStaticMethod(method: FunctionDecl): boolean {
    return method.role?.method == MethodKind.Static;
  }

  public parameterSites(fn: FunctionDecl): ParameterSite[] | undefined {
    const sites: ParameterSite[] = [];

    for (const param of fn.params) {
      const type = param.type;
      if (type == undefined) {
        return undefined;
      }

      sites.push({
        name: param.name,
        loc: param.loc,
        kind: param.form.kind,
        type,
        isDeclared: false,
      });
    }

    return sites;
  }

  public pluralMark(count: int): string {
    if (count == 1) {
      return "";
    }

    return "s";
  }

  public abstractMethodsCheck(decl: ClassDecl): SourceError[] {
    const errors: SourceError[] = [];

    if (decl.isAbstract) {
      return errors;
    }

    for (const method of decl.methods) {
      if (method.role?.method == MethodKind.Abstract) {
        const word = method.name;
        const first = decl.name ?? "";

        errors.push({
          code: Code.AbstractNeedsClass,
          loc: method.loc,
          details: {
            word,
            first,
          },
        });
      }
    }

    return errors;
  }

  public memberNameErrors(decl: ClassDecl, index: int): SourceError[] {
    const errors: SourceError[] = [];

    const field = decl.fields[index];
    if (field == undefined) {
      return errors;
    }

    const word = field.name;
    const first = decl.name ?? "";
    const isStatic = field.form == FieldKind.Static;
    const earlier = decl.fields
      .slice(0, index)
      .find(
        (one) => one.name == word && (one.form == FieldKind.Static) == isStatic,
      );

    if (earlier != undefined) {
      errors.push({
        code: Code.DuplicateMember,
        loc: field.loc,
        details: { word, first },
      });
    }

    for (const method of decl.methods) {
      const isSame =
        method.name == word && this.isStaticMethod(method) == isStatic;
      if (isSame) {
        errors.push({
          code: Code.FieldMethodClash,
          loc: method.loc,
          details: {
            word,
            first,
          },
        });
      }
    }

    return errors;
  }

  public closureThisCheck(
    frame: InitFrame,
    expr: NameExpr,
  ): SourceError | undefined {
    const isReady = frame.closures[frame.closures.length - 1] ?? true;
    if (isReady) {
      return undefined;
    }

    return {
      code: Code.ThisInEarlyClosure,
      loc: expr.loc,
      details: kNoDetails,
    };
  }

  public collectionTypeCheck(
    expr: BinaryExpr,
    left: Type,
    base: Type,
    word: string,
  ): SourceError | undefined {
    if (this.isCollectionOf(word, left)) {
      return {
        code: Code.InstanceOfAlwaysTrue,
        loc: expr.loc,
        details: {
          word,
          first: this.text.of(left),
        },
      };
    }
    if (this.types.isOptional(left) && this.isCollectionOf(word, base)) {
      return {
        code: Code.InstanceOfOrUndefined,
        loc: expr.loc,
        details: {
          first: this.text.of(base),
        },
      };
    }

    return {
      code: Code.InstanceOfNeverBuiltin,
      loc: expr.loc,
      details: {
        word,
        first: this.text.of(left),
      },
    };
  }

  public collectionUnionCheck(
    expr: BinaryExpr,
    left: Type,
    parts: Type[],
    word: string,
  ): SourceError[] {
    const errors: SourceError[] = [];

    const matching = parts.filter((part) => this.isCollectionOf(word, part));
    const first = this.text.of(this.types.definedType(left));
    if (matching.length == 0) {
      errors.push({
        code: Code.InstanceOfNoneBuiltin,
        loc: expr.loc,
        details: {
          word,
          first,
        },
      });

      return errors;
    }

    const isAll = matching.length == parts.length;
    if (isAll && !this.types.isOptional(left)) {
      errors.push({
        code: Code.InstanceOfAllBuiltin,
        loc: expr.loc,
        details: {
          word,
          first,
        },
      });
    }

    return errors;
  }

  public contractResultError(
    method: FunctionDecl,
    type: FunctionType,
    wanted: FunctionType,
    iface: string,
    first: string,
  ): SourceError | undefined {
    const mine = type.shape.result;
    const theirs = wanted.shape.result;

    if (method.returnType == undefined) {
      return undefined;
    }

    const isFitting =
      mine == theirs ||
      mine.kind == TypeKind.Error ||
      this.relation.converts(mine, theirs);
    if (isFitting) {
      return undefined;
    }

    return {
      code: Code.ImplementsReturns,
      loc: method.loc,
      details: {
        word: method.name,
        first: this.text.of(mine),
        second: iface,
        other: first,
        place: this.text.of(theirs),
      },
    };
  }

  public fieldAccessCheck(
    decl: ClassDecl,
    field: ClassField,
    inherited: ClassField,
    owner: string,
  ): SourceError | undefined {
    const ownRank = this.accessRank(field.access);
    const theirRank = this.accessRank(inherited.access);
    if (ownRank <= theirRank) {
      return undefined;
    }

    return {
      code: Code.FieldAccessNarrower,
      loc: field.loc,
      details: {
        word: field.name,
        other: this.accessWord(inherited.access),
        first: owner,
        second: this.accessWord(field.access),
        place: decl.name ?? "",
      },
    };
  }

  public lonelyOverrideCheck(
    decl: ClassDecl,
    field: ClassField,
    hasParent: boolean,
  ): SourceError | undefined {
    if (!field.isOverride || hasParent) {
      return undefined;
    }

    const word = field.name;
    const first = decl.name ?? "";

    return {
      code: Code.FieldOverrideNoParent,
      loc: field.loc,
      details: {
        word,
        first,
      },
    };
  }

  public newFieldCheck(
    field: ClassField,
    parent: InstanceType,
  ): SourceError | undefined {
    if (!field.isOverride) {
      return undefined;
    }

    const word = field.name;
    const first = parent.name;

    return {
      code: Code.FieldOverrideMissing,
      loc: field.loc,
      details: { word, first },
    };
  }

  public overrideAccessCheck(
    method: FunctionDecl,
    theirs: FunctionDecl,
    parent: InstanceType,
  ): SourceError | undefined {
    const own = this.accessOf(method);
    const their = this.accessOf(theirs);
    if (this.accessRank(own) <= this.accessRank(their)) {
      return undefined;
    }

    return {
      code: Code.OverrideAccess,
      loc: method.loc,
      details: {
        word: method.name,
        first: this.accessWord(their),
        second: parent.name,
        other: this.accessWord(own),
      },
    };
  }

  public overrideResultCheck(
    method: FunctionDecl,
    decl: ClassDecl,
    own: FunctionType,
    theirs: FunctionType,
    parent: InstanceType,
  ): SourceError | undefined {
    const mine = own.shape.result;
    const other = theirs.shape.result;
    const isSame = mine == other || mine.kind == TypeKind.Error;
    if (isSame || method.returnType == undefined) {
      return undefined;
    }

    return {
      code: Code.OverrideReturns,
      loc: method.loc,
      details: {
        word: method.name,
        first: this.text.of(mine),
        second: decl.name ?? "",
        other: this.text.of(other),
        place: parent.name,
      },
    };
  }

  public redeclaredValueCheck(
    decl: ClassDecl,
    field: ClassField,
    owner: string,
  ): SourceError | undefined {
    const isGiven =
      field.init != undefined || field.form == FieldKind.Parameter;
    if (isGiven || decl.constructors.length > 0) {
      return undefined;
    }

    return {
      code: Code.FieldRedeclaredNoValue,
      loc: field.loc,
      details: {
        word: field.name,
        first: owner,
      },
    };
  }

  public relatedCheck(
    expr: BinaryExpr,
    base: Type,
    instance: Type,
    word: string,
  ): SourceError[] {
    const errors: SourceError[] = [];

    const first = this.text.of(base);

    if (base.kind == TypeKind.Instance) {
      if (this.isUnrelatedClass(base, instance)) {
        errors.push({
          code: Code.InstanceOfNeverClass,
          loc: expr.loc,
          details: {
            word,
            first,
          },
        });
      }

      return errors;
    }

    const isPlain =
      base.kind == TypeKind.Object && this.store.labelOf(base) == undefined;
    if (!isPlain || this.types.ancestorsOf(instance).includes(base)) {
      return errors;
    }

    errors.push({
      code: Code.InstanceOfNeverMade,
      loc: expr.loc,
      details: { word, first },
    });

    return errors;
  }

  public implementsClassError(
    decl: ClassDecl,
    ref: TypeRef,
  ): SourceError | undefined {
    const word = ref.name;

    if (decl.base != undefined || decl.baseExpr != undefined) {
      return {
        code: Code.ImplementsClassExtended,
        loc: ref.loc,
        details: { word },
      };
    }

    return { code: Code.ImplementsClass, loc: ref.loc, details: { word } };
  }

  public missingMemberError(
    decl: ClassDecl,
    iface: string,
    field: ObjectField,
  ): SourceError | undefined {
    const word = field.name;
    const first = decl.name ?? "";
    const text = this.text.of(field.type);
    const other = `${word}: ${text}`;

    return {
      code: Code.ImplementsMissing,
      loc: decl.loc,
      details: {
        word,
        first,
        second: iface,
        other,
      },
    };
  }

  public staticError(
    expr: MemberExpr,
    entry: ClassMemberEntry,
  ): SourceError | undefined {
    return {
      code: Code.StaticViaInstance,
      loc: expr.loc,
      details: {
        word: expr.name,
        first: entry.owner.name ?? "",
      },
    };
  }

  public methodOverFieldCheck(
    method: FunctionDecl,
    entry: ClassMemberEntry,
    parent: InstanceType,
  ): Checked<boolean> {
    const field = entry.field;
    if (field == undefined || entry.isStatic) {
      return { value: false };
    }

    const word = method.name;
    const first = entry.owner.name ?? parent.name;

    if (this.isArrowField(field)) {
      return {
        value: true,
        error: {
          code: Code.ArrowOverride,
          loc: method.loc,
          details: { word, first },
        },
      };
    }

    return {
      value: true,
      error: {
        code: Code.MethodOverField,
        loc: method.loc,
        details: { word, first },
      },
    };
  }

  public instanceofCheck(
    expr: BinaryExpr,
    left: Type,
    instance: Type,
    decl: ClassDecl,
  ): SourceError[] {
    const errors: SourceError[] = [];

    const base = this.types.definedType(left);
    const word = decl.name ?? "";
    const first = this.text.of(base);

    if (this.isOpenTested(base)) {
      return errors;
    }
    if (base.kind == TypeKind.Union) {
      if (!this.canHoldClass(base.parts, instance)) {
        errors.push({
          code: Code.InstanceOfNeverUnion,
          loc: expr.loc,
          details: {
            word,
            first,
          },
        });
      }

      return errors;
    }
    if (!this.isObjectTested(base)) {
      const shown = this.text.of(left);

      errors.push({
        code: Code.InstanceOfNotObject,
        loc: expr.lhs.loc,
        details: {
          first: shown,
        },
      });

      return errors;
    }

    const relatedErrors = this.relatedCheck(expr, base, instance, word);

    for (const found of relatedErrors) {
      errors.push(found);
    }

    return errors;
  }

  public staticCallError(
    expr: MemberExpr,
    entry: ClassMemberEntry,
  ): SourceError | undefined {
    const owner = entry.owner;
    const isMethod = owner.methods.some(
      (one) => one.name == expr.name && this.isStaticMethod(one),
    );
    if (!isMethod) {
      const staticError = this.staticError(expr, entry);

      return staticError;
    }

    return {
      code: Code.StaticMethodViaInstance,
      loc: expr.loc,
      details: {
        word: expr.name,
        first: owner.name ?? "",
      },
    };
  }

  public classValueMember(expr: MemberExpr, object: ClassType): Checked<Type> {
    const error = this.store.plain(TypeKind.Error);
    if (expr.name == "prototype") {
      return {
        value: error,
        error: {
          code: Code.ClassValuePrototype,
          loc: expr.loc,
          details: kNoDetails,
        },
      };
    }
    if (expr.name == "name") {
      return { value: this.store.plain(TypeKind.String) };
    }
    if (!object.exact) {
      return {
        value: error,
        error: {
          code: Code.ClassValueRuntime,
          loc: expr.loc,
          details: {
            word: this.text.of(object),
          },
        },
      };
    }

    return { value: error };
  }

  private isDeclaredBefore(one: InstanceType, other: InstanceType): boolean {
    if (one.module != other.module) {
      return one.module < other.module;
    }

    return one.loc < other.loc;
  }

  private isSameLine(first: Type, second: Type): boolean {
    const up = this.types.ancestorsOf(first).includes(second);
    const down = this.types.ancestorsOf(second).includes(first);

    return up || down;
  }
}
