import {
  Checked,
  SourceError,
} from "../../../diagnostic/types/message.types.tz";
import { Code } from "../../../diagnostic/code.tz";
import { MemberExpr } from "../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../program/ast/types/ast.types.functions.tz";
import { TypeRef } from "../../../program/ast/types/ast.types.types.tz";
import {
  FunctionType,
  InstanceType,
  ObjectField,
  Type,
  TypeKind,
} from "../../../program/type/types/type.types.tz";
import { ClassMemberEntry } from "../expression-types/types/expression-types.types.tz";
import {
  ClassDecl,
  ClassField,
  FieldKind,
  MethodKind,
} from "../../../program/ast/types/ast.types.classes.tz";
import { TypeRelation } from "../../types/type-relation/type-relation.tz";
import { TypeText } from "../../../program/type/type-text/type-text.tz";
import { ClassRules } from "../class-rules/class-rules.tz";

export class ClassOverrideRules {
  private readonly text: TypeText;
  private readonly relation: TypeRelation;
  private readonly classes: ClassRules;

  public constructor(
    text: TypeText,
    relation: Own<TypeRelation>,
    classes: Own<ClassRules>,
  ) {
    this.text = text;
    this.relation = relation;
    this.classes = classes;
  }

  public readonly contractFieldResult(type: Type): Type | undefined {
    if (type.kind != TypeKind.Function) {
      return undefined;
    }

    return type.shape.result;
  }

  public readonly overriddenCode(site: MemberExpr, call: MemberExpr): Code {
    if (site == call) {
      return Code.ConstructorCallsOverride;
    }

    return Code.ConstructorReachesOverride;
  }

  public readonly overridingChild(
    children: Read<ClassDecl[]>,
    name: string,
  ): ClassDecl | undefined {
    return children.find((child) =>
      child.methods.some(
        (method) => method.name == name && !this.classes.isStaticMethod(method),
      ),
    );
  }

  public readonly abstractMethodsCheck(decl: ClassDecl): SourceError[] {
    const errors: SourceError[] = [];

    if (decl.isAbstract) {
      return errors;
    }

    for (const method of decl.methods) {
      if (method.role?.method == MethodKind.Abstract) {
        const word = method.name;
        const first = decl.name ?? "";

        errors.push({
          code: Code.AbstractNeedsClass,
          loc: method.loc,
          details: {
            word,
            first,
          },
        });
      }
    }

    return errors;
  }

  public readonly memberNameErrors(decl: ClassDecl, index: int): SourceError[] {
    const errors: SourceError[] = [];

    const field = decl.fields[index];
    if (field == undefined) {
      return errors;
    }

    const word = field.name;
    const first = decl.name ?? "";
    const isStatic = field.form == FieldKind.Static;
    const earlier = decl.fields
      .slice(0, index)
      .find(
        (one) => one.name == word && (one.form == FieldKind.Static) == isStatic,
      );

    if (earlier != undefined) {
      errors.push({
        code: Code.DuplicateMember,
        loc: field.loc,
        details: { word, first },
      });
    }

    for (const method of decl.methods) {
      const isSame =
        method.name == word && this.classes.isStaticMethod(method) == isStatic;
      if (isSame) {
        errors.push({
          code: Code.FieldMethodClash,
          loc: method.loc,
          details: {
            word,
            first,
          },
        });
      }
    }

    return errors;
  }

  public readonly contractResultError(
    method: FunctionDecl,
    type: FunctionType,
    wanted: FunctionType,
    iface: string,
    first: string,
  ): SourceError | undefined {
    const mine = type.shape.result;
    const theirs = wanted.shape.result;

    if (method.returnType == undefined) {
      return undefined;
    }

    const isFitting =
      mine == theirs ||
      mine.kind == TypeKind.Error ||
      this.relation.converts(mine, theirs);
    if (isFitting) {
      return undefined;
    }

    return {
      code: Code.ImplementsReturns,
      loc: method.loc,
      details: {
        word: method.name,
        first: this.text.of(mine),
        second: iface,
        other: first,
        place: this.text.of(theirs),
      },
    };
  }

  public readonly lonelyOverrideCheck(
    decl: ClassDecl,
    field: ClassField,
    hasParent: boolean,
  ): SourceError | undefined {
    if (!field.isOverride || hasParent) {
      return undefined;
    }

    const word = field.name;
    const first = decl.name ?? "";

    return {
      code: Code.FieldOverrideNoParent,
      loc: field.loc,
      details: {
        word,
        first,
      },
    };
  }

  public readonly newFieldCheck(
    field: ClassField,
    parent: InstanceType,
  ): SourceError | undefined {
    if (!field.isOverride) {
      return undefined;
    }

    const word = field.name;
    const first = parent.name;

    return {
      code: Code.FieldOverrideMissing,
      loc: field.loc,
      details: { word, first },
    };
  }

  public readonly overrideAccessCheck(
    method: FunctionDecl,
    theirs: FunctionDecl,
    parent: InstanceType,
  ): SourceError | undefined {
    const own = this.classes.accessOf(method);
    const their = this.classes.accessOf(theirs);
    if (this.classes.accessRank(own) <= this.classes.accessRank(their)) {
      return undefined;
    }

    return {
      code: Code.OverrideAccess,
      loc: method.loc,
      details: {
        word: method.name,
        first: this.classes.accessWord(their),
        second: parent.name,
        other: this.classes.accessWord(own),
      },
    };
  }

  public readonly overrideResultCheck(
    method: FunctionDecl,
    decl: ClassDecl,
    own: FunctionType,
    theirs: FunctionType,
    parent: InstanceType,
  ): SourceError | undefined {
    const mine = own.shape.result;
    const other = theirs.shape.result;
    const isSame = mine == other || mine.kind == TypeKind.Error;
    if (isSame || method.returnType == undefined) {
      return undefined;
    }

    return {
      code: Code.OverrideReturns,
      loc: method.loc,
      details: {
        word: method.name,
        first: this.text.of(mine),
        second: decl.name ?? "",
        other: this.text.of(other),
        place: parent.name,
      },
    };
  }

  public readonly redeclaredValueCheck(
    decl: ClassDecl,
    field: ClassField,
    owner: string,
  ): SourceError | undefined {
    const isGiven =
      field.init != undefined || field.form == FieldKind.Parameter;
    if (isGiven || decl.constructors.length > 0) {
      return undefined;
    }

    return {
      code: Code.FieldRedeclaredNoValue,
      loc: field.loc,
      details: {
        word: field.name,
        first: owner,
      },
    };
  }

  public readonly implementsClassError(
    decl: ClassDecl,
    ref: TypeRef,
  ): SourceError | undefined {
    const word = ref.name;

    if (decl.base != undefined || decl.baseExpr != undefined) {
      return {
        code: Code.ImplementsClassExtended,
        loc: ref.loc,
        details: { word },
      };
    }

    return { code: Code.ImplementsClass, loc: ref.loc, details: { word } };
  }

  public readonly missingMemberError(
    decl: ClassDecl,
    iface: string,
    field: ObjectField,
  ): SourceError | undefined {
    const word = field.name;
    const first = decl.name ?? "";
    const text = this.text.of(field.type);
    const other = `${word}: ${text}`;

    return {
      code: Code.ImplementsMissing,
      loc: decl.loc,
      details: {
        word,
        first,
        second: iface,
        other,
      },
    };
  }

  public readonly methodOverFieldCheck(
    method: FunctionDecl,
    entry: Read<ClassMemberEntry>,
    parent: InstanceType,
  ): Checked<boolean> {
    const field = entry.field;
    if (field == undefined || entry.isStatic) {
      return { value: false };
    }

    const word = method.name;
    const first = entry.owner.name ?? parent.name;

    if (this.classes.isArrowField(field)) {
      return {
        value: true,
        error: {
          code: Code.ArrowOverride,
          loc: method.loc,
          details: { word, first },
        },
      };
    }

    return {
      value: true,
      error: {
        code: Code.MethodOverField,
        loc: method.loc,
        details: { word, first },
      },
    };
  }
}
