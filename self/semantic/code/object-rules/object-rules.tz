import {
  Checked,
  SourceError,
} from "../../../diagnostic/types/message.types.tz";
import { Code } from "../../../diagnostic/code.tz";
import {
  Expr,
  ExprKind,
  ObjectLitExpr,
  Property,
  PropertyKind,
} from "../../../program/ast/types/ast.types.expressions.tz";
import {
  LiteralKind,
  ObjectField,
  ObjectType,
  Type,
  TypeKind,
} from "../../../program/type/types/type.types.tz";
import {
  LiteralValue,
  ObjectDraft,
  SpreadSlot,
} from "../expression-types/types/expression-types.types.tz";
import { TypeUnifier } from "../../types/type-unifier/type-unifier.tz";
import { kDot } from "../source-texts/const/source-texts.const.tz";
import { TypeStore } from "../../../program/type/type-store/type-store.tz";
import { TypeText } from "../../../program/type/type-text/type-text.tz";
import { TypeRelation } from "../../types/type-relation/type-relation.tz";
import { TypeQuestions } from "../../types/type-questions/type-questions.tz";
import {
  kChainPlaceholder,
  kIdentifierMarks,
} from "./const/object-rules.const.tz";

export class ObjectRules {
  private readonly store: TypeStore;
  private readonly text: TypeText;
  private readonly relation: TypeRelation;
  private readonly types: TypeQuestions;
  private readonly unifier: TypeUnifier;

  public constructor(
    store: TypeStore,
    text: TypeText,
    relation: Own<TypeRelation>,
    types: Own<TypeQuestions>,
    unifier: Own<TypeUnifier>,
  ) {
    this.store = store;
    this.text = text;
    this.relation = relation;
    this.types = types;
    this.unifier = unifier;
  }

  public readonly wholeLiteral(number: int): LiteralValue {
    const text = `${number}`;

    if (number >= 0) {
      const whole = number.toUint64();

      return { kind: LiteralKind.Int, text, whole, negative: false };
    }

    const below = -(number + 1);
    const whole = below.toUint64() + 1;

    return { kind: LiteralKind.Int, text, whole, negative: true };
  }

  public readonly holdsLiteral(set: Type, literal: Type): boolean {
    if (set == literal) {
      return true;
    }

    return set.kind == TypeKind.Union && set.parts.includes(literal);
  }

  public readonly chainField(object: Expr, field: string): string {
    const chain = this.chainText(object) ?? kChainPlaceholder;

    if (this.isPlainName(field)) {
      return chain + kDot + field;
    }

    return `${chain}["${field}"]`;
  }

  public readonly hasFieldNamed(part: Type, name: string): boolean {
    if (part.kind != TypeKind.Object) {
      return false;
    }

    return part.fields.some((field) => field.name == name);
  }

  public readonly hasMethods(expr: ObjectLitExpr): boolean {
    return expr.props.some(
      (property) => property.form.kind == PropertyKind.Method,
    );
  }

  public readonly methodGoal(target: Type | undefined): ObjectType | undefined {
    if (target == undefined || target.kind != TypeKind.Object) {
      return undefined;
    }

    return target;
  }

  public readonly goalField(
    goal: ObjectType | undefined,
    name: string,
  ): Type | undefined {
    const field = goal?.fields.find((one) => one.name == name);
    if (field == undefined) {
      return undefined;
    }

    return this.fieldWanted(field);
  }

  public readonly hasZeroValue(type: Type): boolean {
    switch (type.kind) {
      case TypeKind.Int:
      case TypeKind.Double:
      case TypeKind.Decimal:
      case TypeKind.Boolean:
      case TypeKind.String:
      case TypeKind.Error:
      case TypeKind.TypeParameter:
        return true;
      default:
        return this.types.isOptional(type);
    }
  }

  public readonly isCalledPath(key: string, names: Read<Set<string>>): boolean {
    if (key.startsWith("#")) {
      return false;
    }

    const parts = key.split(kDot).slice(1);

    return parts.some((part) => names.has(part));
  }

  public readonly spreadFieldHint(
    target: Type | undefined,
    name: string,
  ): Type | undefined {
    if (target == undefined || target.kind != TypeKind.Object) {
      return undefined;
    }

    const field = target.fields.find((one) => one.name == name);
    if (field == undefined) {
      return undefined;
    }

    return this.fieldWanted(field);
  }

  public readonly isSpreadFitting(slots: Read<SpreadSlot[]>, target: ObjectType): boolean {
    const isEvery = slots.every((slot) => {
      const field = target.fields.find((one) => one.name == slot.name);
      if (field == undefined) {
        return false;
      }

      return this.relation.converts(slot.type, this.fieldWanted(field));
    });
    const isFilled = target.fields.every((field) => {
      const isNeeded = !field.optional && !this.types.isOptional(field.type);

      return !isNeeded || slots.some((slot) => slot.name == field.name);
    });

    return isEvery && isFilled;
  }

  public readonly fallbackOf(value: Expr): Expr {
    if (value.kind != ExprKind.Assign) {
      return value;
    }

    return value.value;
  }

  public readonly isLiteralKeys(type: Type): boolean {
    if (type.kind == TypeKind.Union) {
      return type.parts.every((part) => this.isTextLiteral(part));
    }

    return this.isTextLiteral(type);
  }

  public readonly overloadedNames(target: ObjectType): string[] {
    const names: string[] = [];

    for (const field of target.fields) {
      const count = target.fields.filter(
        (one) => one.name == field.name,
      ).length;
      if (count > 1 && !names.includes(field.name)) {
        names.push(field.name);
      }
    }

    return names;
  }

  public readonly fieldWanted(field: ObjectField): Type {
    if (!field.optional) {
      return field.type;
    }

    return this.types.optional(field.type);
  }

  public readonly isOptionalField(field: ObjectField): boolean {
    return field.optional || this.types.isOptional(field.type);
  }

  public readonly fieldPlace(name: string): string {
    return ` of field '${name}'`;
  }

  public readonly hasFittingNames(draft: Read<ObjectDraft>, member: Type): boolean {
    if (member.kind != TypeKind.Object) {
      return false;
    }

    for (const entry of draft.entries) {
      if (!member.fields.some((field) => field.name == entry.name)) {
        return false;
      }
    }

    for (const field of member.fields) {
      const isGiven = draft.entries.some((entry) => entry.name == field.name);
      if (!isGiven && !this.isOptionalField(field)) {
        return false;
      }
    }

    return true;
  }

  public readonly isLiteralSet(type: Type): boolean {
    if (type.kind == TypeKind.Union) {
      return type.parts.every((part) => part.kind == TypeKind.Literal);
    }

    return type.kind == TypeKind.Literal;
  }

  public readonly isTagConvertible(tag: Type, fieldType: Type): boolean {
    if (this.relation.converts(tag, fieldType)) {
      return true;
    }

    const isWhole =
      tag.kind == TypeKind.Literal && tag.literal == LiteralKind.Int;
    const int = this.store.integer(64, false);

    return isWhole && this.relation.converts(int, fieldType);
  }

  public readonly uniqueErrors(draft: ObjectDraft): SourceError[] {
    const errors: SourceError[] = [];

    let index = 0;

    for (const entry of draft.entries) {
      const first = draft.entries.findIndex(
        (one) => one.named && one.name == entry.name,
      );

      if (entry.named && first < index) {
        errors.push({
          code: Code.DuplicateLiteralField,
          loc: entry.property.loc,
          details: {
            word: entry.name,
          },
        });
        draft.typed = false;
      }

      index += 1;
    }

    return errors;
  }

  public readonly mergeSpreadField(
    property: Property,
    field: ObjectField,
    spread: ObjectType,
    slots: SpreadSlot[],
  ): Checked<boolean> {
    const type = this.fieldWanted(field);
    if (!slots.some((one) => one.name == field.name)) {
      slots.push({ name: field.name, type });

      return { value: true };
    }

    const slot = slots.find((one) => one.name == field.name);
    if (slot == undefined) {
      return { value: true };
    }
    if (!this.types.isOptional(type)) {
      slot.type = type;

      return { value: true };
    }

    const joined = this.unifier.unify(
      this.types.definedType(slot.type),
      this.types.definedType(type),
    );
    if (joined == undefined || joined.kind == TypeKind.Error) {
      return {
        value: false,
        error: {
          code: Code.SpreadFieldTypes,
          loc: property.loc,
          details: {
            word: field.name,
            first: this.text.of(slot.type),
            second: this.text.of(type),
            other: this.text.of(spread),
          },
        },
      };
    }
    if (this.types.isOptional(slot.type)) {
      slot.type = this.types.optional(joined);

      return { value: true };
    }

    slot.type = joined;

    return { value: true };
  }

  private readonly chainText(expr: Expr): string | undefined {
    if (expr.kind == ExprKind.Name) {
      return expr.name;
    }
    if (expr.kind != ExprKind.Member || expr.optional) {
      return undefined;
    }

    const object = this.chainText(expr.object);
    if (object == undefined) {
      return undefined;
    }

    return object + kDot + expr.name;
  }

  private readonly isPlainName(field: string): boolean {
    const head = field.slice(0, 1);
    const isDigit = head >= "0" && head <= "9";
    if (field == "" || isDigit) {
      return false;
    }

    for (const unit of field) {
      const isLetter =
        (unit >= "a" && unit <= "z") || (unit >= "A" && unit <= "Z");
      const isDecimal = unit >= "0" && unit <= "9";
      if (!isLetter && !isDecimal && !kIdentifierMarks.includes(unit)) {
        return false;
      }
    }

    return true;
  }

  private readonly isTextLiteral(type: Type): boolean {
    return type.kind == TypeKind.Literal && type.literal == LiteralKind.String;
  }
}
