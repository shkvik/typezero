import { SourceError } from "../../../diagnostic/types/message.types.tz";
import { Code } from "../../../diagnostic/code.tz";
import { kNoDetails } from "../../../diagnostic/const/message.const.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import {
  FunctionType,
  Type,
  TypeKind,
} from "../../../program/type/types/type.types.tz";
import {
  ArrayCallback,
  CallbackPlan,
} from "../expression-types/types/expression-types.types.tz";
import { TypeRelation } from "../../types/type-relation/type-relation.tz";
import { TypeText } from "../../../program/type/type-text/type-text.tz";
import { CallRules } from "../call-rules/call-rules.tz";
import { StmtKind } from "../../../program/ast/types/ast.types.statements.tz";
import { TypeStore } from "../../../program/type/type-store/type-store.tz";
import { TypeQuestions } from "../../types/type-questions/type-questions.tz";
import { TruthRules } from "../../flow/truth-rules/truth-rules.tz";
import {
  kCallbackMethods,
  kUriValueNames,
} from "./const/callback-rules.const.tz";

export class CallbackRules {
  private readonly store: TypeStore;
  private readonly types: TypeQuestions;
  private readonly truth: TruthRules;
  private readonly calls: CallRules;
  private readonly text: TypeText;
  private readonly relation: TypeRelation;

  public constructor(
    store: TypeStore,
    types: TypeQuestions,
    truth: TruthRules,
    calls: CallRules,
    text: TypeText,
    relation: TypeRelation,
  ) {
    this.store = store;
    this.types = types;
    this.truth = truth;
    this.calls = calls;
    this.text = text;
    this.relation = relation;
  }

  public callbackPlan(
    expr: CallExpr,
    member: MemberExpr,
    object: Type,
  ): CallbackPlan | undefined {
    if (object.kind != TypeKind.Array) {
      return undefined;
    }

    const kind = kCallbackMethods.get(member.name);
    if (kind == undefined) {
      return undefined;
    }
    if (kind == ArrayCallback.Compare && expr.args.length == 0) {
      return undefined;
    }

    const params = this.callbackParams(kind, object);

    return { kind, member, array: object, params, isValue: false };
  }

  public elementOf(array: Type): Type {
    if (array.kind != TypeKind.Array) {
      return this.store.plain(TypeKind.Error);
    }

    return array.item;
  }

  public callbackArgumentLimit(isReduce: boolean): int {
    if (isReduce) {
      return 2;
    }

    return 1;
  }

  public offeredCount(kind: ArrayCallback): int {
    switch (kind) {
      case ArrayCallback.Compare:
        return 2;
      case ArrayCallback.Reduce:
        return 4;
      default:
        return 3;
    }
  }

  public primaryCount(kind: ArrayCallback): int {
    if (kind == ArrayCallback.Compare || kind == ArrayCallback.Reduce) {
      return 2;
    }

    return 1;
  }

  public callbackArgumentName(kind: ArrayCallback, index: int): string {
    const reduceNames = ["accumulator", "value", "index", "array"];
    const names = ["value", "index", "array"];

    if (kind == ArrayCallback.Reduce) {
      return reduceNames[index] ?? "array";
    }

    return names[index] ?? "array";
  }

  public callbackShapeText(kind: ArrayCallback): string {
    switch (kind) {
      case ArrayCallback.Reduce:
        return "(accumulator, value, index, array)";
      case ArrayCallback.Compare:
        return "(a, b)";
      default:
        return "(value, index, array)";
    }
  }

  public conciseValueLoc(arg: Expr): int {
    if (arg.kind != ExprKind.Function || !arg.fn.concise) {
      return arg.loc;
    }

    const first = arg.fn.body?.body[0];
    if (first == undefined) {
      return arg.loc;
    }
    if (first.kind != StmtKind.Return) {
      return arg.loc;
    }

    return first.value?.loc ?? arg.loc;
  }

  public isNumberResult(result: Type): boolean {
    switch (result.kind) {
      case TypeKind.Int:
      case TypeKind.Double:
      case TypeKind.Decimal:
      case TypeKind.Error:
        return true;
      case TypeKind.Literal:
        return this.truth.isNumberMember(result);
      default:
        return false;
    }
  }

  public requiredCallbackParams(type: FunctionType): int {
    let least = 0;

    for (const param of type.shape.params) {
      if (param.optional) {
        break;
      }

      least += 1;
    }

    if (type.shape.rest && least > 0) {
      return least - 1;
    }

    return least;
  }

  public callbackWanted(kind: ArrayCallback): Type | undefined {
    switch (kind) {
      case ArrayCallback.Filter:
      case ArrayCallback.Find:
      case ArrayCallback.FindIndex:
      case ArrayCallback.Test:
        return this.store.plain(TypeKind.Boolean);
      default:
        return undefined;
    }
  }

  public isLooseBuiltin(name: string): boolean {
    return name.startsWith("parse") || kUriValueNames.includes(name);
  }

  public builtinResultText(name: string): string {
    if (kUriValueNames.includes(name)) {
      return "string";
    }

    return "double";
  }

  public isFunctionWanted(wanted: Type | undefined): boolean {
    if (wanted == undefined) {
      return false;
    }

    return this.types.definedType(wanted).kind == TypeKind.Function;
  }

  public droppedPromiseCheck(arg: Expr, result: Type): SourceError[] {
    const errors: SourceError[] = [];

    if (arg.kind == ExprKind.Function && arg.fn.isAsync) {
      errors.push({
        code: Code.AsyncCallbackDropped,
        loc: arg.loc,
        details: kNoDetails,
      });

      return errors;
    }
    const kind = this.types.definedType(result).kind;
    if (kind == TypeKind.Promise) {
      const loc = this.conciseValueLoc(arg);

      errors.push({
        code: Code.CallbackPromiseDropped,
        loc: loc,
        details: kNoDetails,
      });
    }
    if (kind == TypeKind.Result && arg.kind == ExprKind.Function) {
      const loc = this.conciseValueLoc(arg);

      errors.push({
        code: Code.CallbackResultDropped,
        loc: loc,
        details: kNoDetails,
      });
    }

    return errors;
  }

  public droppedResultCheck(
    arg: Expr,
    result: Type,
    name: string,
    method: string,
  ): SourceError[] {
    const errors: SourceError[] = [];

    if (result.kind == TypeKind.Result) {
      errors.push({
        code: Code.CallbackDropsResult,
        loc: arg.loc,
        details: {
          word: name,
          other: method,
        },
      });

      return errors;
    }
    if (result.kind == TypeKind.Promise) {
      errors.push({
        code: Code.CallbackDropsPromise,
        loc: arg.loc,
        details: {
          word: name,
          other: method,
        },
      });
    }

    return errors;
  }

  public extraCallbackArgumentsError(
    expr: CallExpr,
    plan: CallbackPlan,
  ): SourceError | undefined {
    const member = plan.member;
    const word = member.name;
    const count = expr.args.length;
    const isReduce = plan.kind == ArrayCallback.Reduce;
    const most = this.callbackArgumentLimit(isReduce);
    const second = expr.args[1]?.expr;
    if (count == 2 && !isReduce && second != undefined) {
      return { code: Code.CallbackThisArg, loc: second.loc, details: { word } };
    }
    if (count <= most) {
      return undefined;
    }

    const wanted = this.calls.argumentCountText(1, most, false);

    return {
      code: Code.ArgumentCount,
      loc: member.loc,
      details: {
        word: wanted,
        other: `${count}`,
      },
    };
  }

  public forwardedResultCheck(
    expr: Expr,
    result: Type,
    wanted: Type,
  ): SourceError | undefined {
    const isOpen =
      wanted.kind == TypeKind.Void ||
      wanted.kind == TypeKind.Error ||
      result.kind == TypeKind.Error;
    if (isOpen || this.relation.converts(result, wanted)) {
      return undefined;
    }

    return {
      code: Code.NotAssignable,
      loc: expr.loc,
      details: {
        first: this.text.of(result),
        second: this.text.of(wanted),
        place: "",
      },
    };
  }

  private callbackParams(kind: ArrayCallback, array: Type): Type[] {
    const item = this.elementOf(array);
    const index = this.store.integer(64, false);

    switch (kind) {
      case ArrayCallback.Compare:
        return [item, item];
      case ArrayCallback.Reduce:
        return [];
      default:
        return [item, index, array];
    }
  }
}
