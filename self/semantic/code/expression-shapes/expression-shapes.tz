import { ViewShape } from "./types/expression-shapes.types.tz";
import {
  kAllocNames,
  kArrayBufferName,
  kBufferName,
  kByteViewClasses,
  kContextFunctions,
  kCopyNames,
  kUtf8Names,
  kContextObjects,
  kEmbedBytesName,
  kLengthName,
  kSizedClasses,
} from "./const/expression-shapes.const.tz";
import {
  ArrayLitExpr,
  BinaryOp,
  CallExpr,
  Expr,
  ExprKind,
  NewKind,
  ObjectLitExpr,
  PropertyKind,
  UnaryOp,
} from "../../../program/ast/types/ast.types.expressions.tz";
import {
  FunctionDecl,
  FunctionPlace,
} from "../../../program/ast/types/ast.types.functions.tz";
import {
  Stmt,
  StmtKind,
} from "../../../program/ast/types/ast.types.statements.tz";

export class ExpressionShapes {
  public readonly isNumberLiteral(expr: Expr): boolean {
    if (expr.kind == ExprKind.FloatLit || expr.kind == ExprKind.IntLit) {
      return true;
    }

    return (
      expr.kind == ExprKind.Unary &&
      expr.op == UnaryOp.Neg &&
      this.isNumberLiteral(expr.operand)
    );
  }

  public readonly isFieldLiteral(init: Expr): boolean {
    if (init.kind == ExprKind.Unary && init.op == UnaryOp.Neg) {
      return this.isFieldLiteral(init.operand);
    }

    switch (init.kind) {
      case ExprKind.IntLit:
      case ExprKind.FloatLit:
      case ExprKind.StringLit:
      case ExprKind.Template:
      case ExprKind.BoolLit:
        return true;
      default:
        return false;
    }
  }

  public readonly isPlainLiteral(expr: Expr): boolean {
    switch (expr.kind) {
      case ExprKind.IntLit:
      case ExprKind.FloatLit:
      case ExprKind.StringLit:
      case ExprKind.BoolLit:
        return true;
      case ExprKind.Unary: {
        const operand = expr.operand;
        const isNumber =
          operand.kind == ExprKind.IntLit || operand.kind == ExprKind.FloatLit;

        return this.isSign(expr.op) && isNumber;
      }
      default:
        return false;
    }
  }

  public readonly isLiteralShaped(expr: Expr): boolean {
    return expr.kind == ExprKind.ArrayLit || expr.kind == ExprKind.ObjectLit;
  }

  public readonly isNumberTree(expr: Expr): boolean {
    switch (expr.kind) {
      case ExprKind.IntLit:
      case ExprKind.FloatLit:
        return true;
      case ExprKind.Unary:
        return this.isSign(expr.op) && this.isNumberTree(expr.operand);
      case ExprKind.Binary:
        return (
          this.isArithmetic(expr.op) &&
          this.isNumberTree(expr.lhs) &&
          this.isNumberTree(expr.rhs)
        );
      default:
        return false;
    }
  }

  public readonly isIntTree(expr: Expr): boolean {
    switch (expr.kind) {
      case ExprKind.IntLit:
        return true;
      case ExprKind.Unary:
        return this.isSign(expr.op) && this.isIntTree(expr.operand);
      case ExprKind.Binary:
        return (
          this.isWholeArithmetic(expr.op) &&
          this.isIntTree(expr.lhs) &&
          this.isIntTree(expr.rhs)
        );
      default:
        return false;
    }
  }

  public readonly isSign(op: UnaryOp): boolean {
    return op == UnaryOp.Neg || op == UnaryOp.Plus;
  }

  public readonly isWholeArithmetic(op: BinaryOp): boolean {
    switch (op) {
      case BinaryOp.Add:
      case BinaryOp.Sub:
      case BinaryOp.Mul:
      case BinaryOp.Rem:
      case BinaryOp.Pow:
        return true;
      default:
        return false;
    }
  }

  public readonly isSpreadOnly(expr: ObjectLitExpr): boolean {
    const hasSpread = expr.props.some(
      (property) => property.form.kind == PropertyKind.Spread,
    );
    const hasOther = expr.props.some(
      (property) =>
        property.form.kind == PropertyKind.Method ||
        property.form.kind == PropertyKind.Computed,
    );

    return hasSpread && !hasOther;
  }

  public readonly isNeedingContext(expr: Expr): boolean {
    switch (expr.kind) {
      case ExprKind.Function:
        return expr.fn.params.some((param) => param.type == undefined);
      case ExprKind.ArrayLit:
        return expr.elements.some(
          (element) => !element.hole && this.isNeedingContext(element.expr),
        );
      case ExprKind.ObjectLit:
        return expr.props.some((prop) => this.isNeedingContext(prop.value));
      case ExprKind.Name:
        return (
          expr.typeArgs.length == 0 && kContextFunctions.includes(expr.name)
        );
      case ExprKind.Member: {
        const object = expr.object;

        return (
          object.kind == ExprKind.Name && kContextObjects.includes(object.name)
        );
      }
      default:
        return false;
    }
  }

  public readonly isWrittenLiteral(expr: Expr): boolean {
    switch (expr.kind) {
      case ExprKind.IntLit:
      case ExprKind.FloatLit:
      case ExprKind.StringLit:
      case ExprKind.BoolLit:
      case ExprKind.Undefined:
        return true;
      case ExprKind.Unary:
        return expr.op == UnaryOp.Neg && this.isWrittenLiteral(expr.operand);
      default:
        return false;
    }
  }

  public readonly isLogical(expr: Expr): boolean {
    if (expr.kind != ExprKind.Binary) {
      return false;
    }

    return expr.op == BinaryOp.LogAnd || expr.op == BinaryOp.LogOr;
  }

  public readonly isWaiting(branch: Expr): boolean {
    return this.isShapedBranch(branch) || this.isNumberTree(branch);
  }

  public readonly isClosure(fn: FunctionDecl): boolean {
    return fn.isArrow || fn.place == FunctionPlace.Expression;
  }

  public readonly childrenOf(expr: Expr): Expr[] {
    switch (expr.kind) {
      case ExprKind.Index:
        return [expr.object, expr.index];
      case ExprKind.Binary:
        return [expr.lhs, expr.rhs];
      case ExprKind.Await:
        return [expr.value];
      case ExprKind.Cast:
        return [expr.operand];
      case ExprKind.Sequence:
        return expr.exprs;
      case ExprKind.Yield: {
        const value = expr.value;
        if (value == undefined) {
          return [];
        }

        return [value];
      }
      default:
        return [];
    }
  }

  public readonly isLogicOp(op: BinaryOp): boolean {
    return (
      op == BinaryOp.Nullish || op == BinaryOp.LogOr || op == BinaryOp.LogAnd
    );
  }

  public readonly isSimpleTarget(target: Expr): boolean {
    switch (target.kind) {
      case ExprKind.Name:
        return true;
      case ExprKind.Member:
        return !target.optional && this.isSimpleChain(target.object);
      case ExprKind.Index:
        return (
          !target.optional &&
          this.isSimpleChain(target.object) &&
          this.isSimpleChain(target.index)
        );
      default:
        return false;
    }
  }

  public readonly isLiteralTruth(value: Expr, truth: boolean): boolean {
    return value.kind == ExprKind.BoolLit && value.value == truth;
  }

  public readonly literalCondition(cond: Expr): boolean | undefined {
    if (cond.kind != ExprKind.BoolLit) {
      return undefined;
    }

    return cond.value;
  }

  public readonly isTrueLiteral(cond: Expr): boolean {
    return this.literalCondition(cond) == true;
  }

  public readonly isForever(cond: Expr | undefined): boolean {
    return cond == undefined || this.isTrueLiteral(cond);
  }

  public readonly hasBreak(statement: Stmt | undefined): boolean {
    return this.breaksOut(statement, false);
  }

  public readonly isLength(expr: Expr): boolean {
    if (expr.kind == ExprKind.OptionalChain) {
      return this.isLength(expr.chain);
    }

    return expr.kind == ExprKind.Member && expr.name == kLengthName;
  }

  public readonly isZeroLiteral(expr: Expr): boolean {
    switch (expr.kind) {
      case ExprKind.IntLit:
        return expr.value == 0;
      case ExprKind.FloatLit:
        return expr.value == 0.0;
      case ExprKind.Unary:
        return expr.op == UnaryOp.Neg && this.isZeroLiteral(expr.operand);
      default:
        return false;
    }
  }

  public readonly isPlainList(literal: ArrayLitExpr): boolean {
    if (literal.elements.length == 0) {
      return false;
    }

    return literal.elements.every(
      (element) => !element.spread && !element.hole,
    );
  }

  public readonly isFresh(expr: Expr): boolean {
    switch (expr.kind) {
      case ExprKind.ArrayLit:
      case ExprKind.ObjectLit:
        return true;
      case ExprKind.Conditional:
        return this.isFresh(expr.thenExpr) && this.isFresh(expr.elseExpr);
      default:
        return false;
    }
  }

  public readonly madeSize(value: Expr): Expr | undefined {
    if (value.kind != ExprKind.New) {
      return undefined;
    }

    const form = value.form;
    if (form.kind != NewKind.Named) {
      return undefined;
    }

    const size = value.args[0];
    const isSized =
      kSizedClasses.includes(form.name) &&
      form.member == undefined &&
      value.args.length == 1;
    if (!isSized || size == undefined || size.spread) {
      return undefined;
    }

    return size.expr;
  }

  public readonly madeCount(value: Expr): int | undefined {
    const size = this.madeSize(value);
    if (size == undefined || size.kind != ExprKind.ArrayLit) {
      return undefined;
    }

    const isPlain = size.elements.every((one) => !one.spread && !one.hole);
    if (!isPlain) {
      return undefined;
    }

    return size.elements.length;
  }

  public readonly embeddedPath(value: Expr): string | undefined {
    if (value.kind != ExprKind.Call) {
      return undefined;
    }

    const callee = value.callee;
    const path = value.args[0]?.expr;
    const isEmbed =
      callee.kind == ExprKind.Name &&
      callee.name == kEmbedBytesName &&
      value.args.length == 1;
    if (!isEmbed || path == undefined || path.kind != ExprKind.StringLit) {
      return undefined;
    }

    return path.value;
  }

  public readonly allocatedSize(value: Expr): Expr | undefined {
    const call = this.bufferCall(value, kAllocNames);
    const size = call?.args[0];
    if (size == undefined || size.spread) {
      return undefined;
    }

    return size.expr;
  }

  public readonly copiedSource(value: Expr): Expr | undefined {
    const call = this.bufferCall(value, kCopyNames);
    const source = call?.args[0];
    if (call == undefined || source == undefined || source.spread) {
      return undefined;
    }

    const encoding = call.args[1]?.expr;
    const isPlain =
      encoding == undefined ||
      (encoding.kind == ExprKind.StringLit &&
        kUtf8Names.includes(encoding.value));
    if (!isPlain || call.args.length > 2) {
      return undefined;
    }

    return source.expr;
  }

  public readonly viewOf(value: Expr): ViewShape | undefined {
    if (value.kind != ExprKind.New) {
      return undefined;
    }

    const form = value.form;
    if (form.kind != NewKind.Named) {
      return undefined;
    }

    const buffer = value.args[0];
    const isView =
      kByteViewClasses.includes(form.name) &&
      form.member == undefined &&
      value.args.length <= 3 &&
      value.args.every((arg) => !arg.spread);
    if (!isView || buffer == undefined) {
      return undefined;
    }

    return {
      name: form.name,
      buffer: buffer.expr,
      offset: value.args[1]?.expr,
      length: value.args[2]?.expr,
    };
  }

  public readonly madeBuffer(value: Expr): Expr | undefined {
    if (value.kind != ExprKind.New) {
      return undefined;
    }

    const form = value.form;
    if (form.kind != NewKind.Named || form.name != kArrayBufferName) {
      return undefined;
    }

    return this.madeSize(value);
  }

  private readonly isArithmetic(op: BinaryOp): boolean {
    return op == BinaryOp.Div || this.isWholeArithmetic(op);
  }

  private readonly isShapedBranch(branch: Expr): boolean {
    if (this.isLiteralShaped(branch)) {
      return true;
    }
    if (branch.kind != ExprKind.Conditional) {
      return false;
    }

    return (
      this.isShapedBranch(branch.thenExpr) ||
      this.isShapedBranch(branch.elseExpr)
    );
  }

  private readonly isSimpleChain(expr: Expr): boolean {
    switch (expr.kind) {
      case ExprKind.Name:
      case ExprKind.IntLit:
      case ExprKind.StringLit:
        return true;
      case ExprKind.Member:
        return !expr.optional && this.isSimpleChain(expr.object);
      default:
        return false;
    }
  }

  private readonly breaksOut(statement: Stmt | undefined, isNested: boolean): boolean {
    if (statement == undefined) {
      return false;
    }

    switch (statement.kind) {
      case StmtKind.Break:
        return !isNested || statement.label != "";
      case StmtKind.Block:
        return statement.body.some((one) => this.breaksOut(one, isNested));
      case StmtKind.If:
        return (
          this.breaksOut(statement.thenStmt, isNested) ||
          this.breaksOut(statement.elseStmt, isNested)
        );
      case StmtKind.Labeled:
        return this.breaksOut(statement.body, isNested);
      case StmtKind.While:
      case StmtKind.DoWhile:
      case StmtKind.ForOf:
        return this.breaksOut(statement.body, true);
      case StmtKind.For:
        return this.breaksOut(statement.body, true);
      case StmtKind.Switch:
        return statement.cases.some((option) =>
          option.body.some((one) => this.breaksOut(one, true)),
        );
      default:
        return false;
    }
  }

  private readonly bufferCall(value: Expr, names: Read<string[]>): CallExpr | undefined {
    if (value.kind != ExprKind.Call) {
      return undefined;
    }

    const callee = value.callee;
    if (callee.kind != ExprKind.Member) {
      return undefined;
    }

    const owner = callee.object;
    const isMaker =
      owner.kind == ExprKind.Name &&
      owner.name == kBufferName &&
      names.includes(callee.name);
    if (!isMaker) {
      return undefined;
    }

    return value;
  }
}
