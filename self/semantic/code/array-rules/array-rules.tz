import {
  Checked,
  SourceError,
} from "../../../diagnostic/types/message.types.tz";
import { Code } from "../../../diagnostic/code.tz";
import {
  ArrayLitExpr,
  Expr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import {
  DictKind,
  LiteralKind,
  Type,
  TypeKind,
} from "../../../program/type/types/type.types.tz";
import { ArrayDraft } from "../expression-types/types/expression-types.types.tz";
import { TypeText } from "../../../program/type/type-text/type-text.tz";
import { kIteratorKey } from "../../types/type-questions/const/type-questions.const.tz";
import { TypeStore } from "../../../program/type/type-store/type-store.tz";
import { TypeRelation } from "../../types/type-relation/type-relation.tz";
import { TypeQuestions } from "../../types/type-questions/type-questions.tz";
import { TypeUnifier } from "../../types/type-unifier/type-unifier.tz";
import { ExpressionShapes } from "../expression-shapes/expression-shapes.tz";
import { kTypeSeparator } from "./const/array-rules.const.tz";

export class ArrayRules {
  private readonly store: TypeStore;
  private readonly relation: TypeRelation;
  private readonly types: TypeQuestions;
  private readonly unifier: TypeUnifier;
  private readonly shapes: ExpressionShapes;
  private readonly text: TypeText;

  public constructor(
    store: TypeStore,
    relation: TypeRelation,
    types: TypeQuestions,
    unifier: TypeUnifier,
    shapes: ExpressionShapes,
    text: TypeText,
  ) {
    this.store = store;
    this.relation = relation;
    this.types = types;
    this.unifier = unifier;
    this.shapes = shapes;
    this.text = text;
  }

  public jsonArrayOr(wanted: Type | undefined): Type | undefined {
    const target = this.types.wantedPart(wanted);
    if (target == undefined || target.kind != TypeKind.Json) {
      return wanted;
    }

    return this.store.arrayOf(target);
  }

  public wantedArray(expected: Type | undefined): Type | undefined {
    if (expected == undefined) {
      return undefined;
    }
    if (expected.kind == TypeKind.Unknown) {
      return this.store.arrayOf(expected);
    }

    const plain = this.types.definedType(expected);
    if (plain.kind != TypeKind.Union) {
      return expected;
    }

    const array = plain.parts.find((part) => part.kind == TypeKind.Array);

    return array ?? expected;
  }

  public wantedItem(plain: Type | undefined): Type | undefined {
    if (plain == undefined || plain.kind != TypeKind.Array) {
      return undefined;
    }

    return plain.item;
  }

  public elementPlace(index: int): string {
    return ` of element ${index}`;
  }

  public elementHint(
    expr: Expr,
    item: Type | undefined,
    seen: Type | undefined,
  ): Type | undefined {
    if (item != undefined) {
      return item;
    }
    if (seen == undefined || !this.types.holdsObjects(seen)) {
      return undefined;
    }
    if (!this.shapes.isLiteralShaped(expr)) {
      return undefined;
    }

    return seen;
  }

  public seeElement(draft: ArrayDraft, type: Type): void {
    const seen = draft.seen;
    const isBroken = seen != undefined && seen.kind == TypeKind.Error;
    if (type.kind != TypeKind.Error && !isBroken) {
      draft.seen = this.seenJoined(seen, type);
    }
    if (draft.seen == undefined) {
      draft.seen = this.store.plain(TypeKind.Error);
    }
  }

  public spreadHint(item: Type | undefined): Type | undefined {
    if (item == undefined) {
      return undefined;
    }

    return this.store.arrayOf(item);
  }

  public isUnsupportedSpread(type: Type): boolean {
    switch (type.kind) {
      case TypeKind.Iterator:
      case TypeKind.Instance:
      case TypeKind.TypeParameter:
      case TypeKind.Operation:
      case TypeKind.Template:
        return true;
      case TypeKind.Dict:
        return type.dict != DictKind.Record;
      case TypeKind.Literal:
        return type.literal == LiteralKind.String;
      case TypeKind.Object:
        return type.fields.some((field) => field.name == kIteratorKey);
      default:
        return false;
    }
  }

  public spreadSource(type: Type): Type {
    if (this.isUnsupportedSpread(type)) {
      return this.store.plain(TypeKind.Error);
    }

    return type;
  }

  public joinedItem(element: Type | undefined, part: Type): Type | undefined {
    if (element == undefined) {
      return part;
    }

    return this.unifier.unionUnify(element, part);
  }

  public literalHint(expr: ArrayLitExpr, draft: ArrayDraft): Type | undefined {
    if (draft.hasDecimal) {
      return this.store.plain(TypeKind.Decimal);
    }

    const seen = draft.seen;
    if (seen != undefined && this.types.isNumeric(seen)) {
      return seen;
    }

    let index = 0;

    for (const element of expr.elements) {
      const type = draft.types.get(index);
      if (element.spread && type != undefined && this.types.isNumeric(type)) {
        return type;
      }

      index += 1;
    }

    index = 0;

    for (const element of expr.elements) {
      const isFraction =
        !draft.types.has(index) && !this.shapes.isIntTree(element.expr);
      if (isFraction) {
        return this.store.plain(TypeKind.Double);
      }

      index += 1;
    }

    return undefined;
  }

  public elementTypes(expr: ArrayLitExpr, draft: ArrayDraft): Type[] {
    const types: Type[] = [];
    let index = 0;

    for (const element of expr.elements) {
      const type = draft.types.get(index) ?? this.store.plain(TypeKind.Error);

      types.push(type);

      index += 1;
    }

    return types;
  }

  public spreadFits(type: Type, element: Type, array: Type): boolean {
    if (type == array || type.kind == TypeKind.Error) {
      return true;
    }

    switch (type.kind) {
      case TypeKind.String:
        return element.kind == TypeKind.String;
      case TypeKind.Array:
        return this.fitsObjectArray(type.item, element);
      case TypeKind.Tuple:
        return type.items.every((part) =>
          this.relation.converts(part, element),
        );
      default:
        return false;
    }
  }

  public isDecimalLike(type: Type): boolean {
    const plain = this.types.definedType(type);

    return plain.kind == TypeKind.Decimal;
  }

  public elementsError(
    expr: ArrayLitExpr,
    types: Type[],
    before: Type | undefined,
    index: int,
  ): SourceError | undefined {
    const element = expr.elements[index];
    const type = types[index];
    if (element == undefined || before == undefined || type == undefined) {
      return undefined;
    }

    const first = this.text.of(before);
    const second = this.text.of(type);
    const hasSpread = expr.elements.some((one) => one.spread);
    const hasFailed = types.some((one) => one.kind == TypeKind.Error);
    if (hasSpread || hasFailed) {
      return {
        code: Code.ElementTypesDiffer,
        loc: element.expr.loc,
        details: {
          first,
          second,
        },
      };
    }

    const texts = types.map((one) => this.text.of(one));
    const other = texts.join(kTypeSeparator);

    return {
      code: Code.ElementTypesNeedTuple,
      loc: element.expr.loc,
      details: {
        first,
        second,
        other,
      },
    };
  }

  public refusedSpread(expr: Expr, type: Type, code: Code): Checked<Type> {
    const first = this.text.of(type);

    return {
      value: this.store.plain(TypeKind.Error),
      error: { code: code, loc: expr.loc, details: { first } },
    };
  }

  public tupleItem(expr: Expr, tuple: Type): Checked<Type> {
    if (tuple.kind != TypeKind.Tuple) {
      return { value: this.store.plain(TypeKind.Error) };
    }

    let element: Type | undefined = undefined;

    for (const part of tuple.items) {
      element = this.joinedItem(element, part);
      if (element == undefined || element.kind == TypeKind.Error) {
        break;
      }
    }

    if (element == undefined || element.kind == TypeKind.Error) {
      const first = this.text.of(tuple);

      return {
        value: this.store.plain(TypeKind.Error),
        error: {
          code: Code.TupleSpreadDiffers,
          loc: expr.loc,
          details: { first },
        },
      };
    }

    return { value: element };
  }

  private seenJoined(seen: Type | undefined, type: Type): Type | undefined {
    if (seen == undefined) {
      return type;
    }

    return this.unifier.unify(seen, type);
  }

  private fitsObjectArray(inner: Type, element: Type): boolean {
    const plainInner = this.types.definedType(inner);
    const plainElement = this.types.definedType(element);
    const isObjects =
      this.types.isObjectReference(plainInner) &&
      this.types.isObjectKind(plainElement);
    const isOptionalFitting =
      this.types.isOptional(inner) == this.types.isOptional(element) ||
      this.types.isOptional(element);

    return (
      isObjects && isOptionalFitting && this.relation.converts(inner, element)
    );
  }
}
