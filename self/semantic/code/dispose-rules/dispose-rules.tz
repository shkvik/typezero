import { Code } from "../../../diagnostic/code.tz";
import { kNoDetails } from "../../../diagnostic/const/message.const.tz";
import { SourceError } from "../../../diagnostic/types/message.types.tz";
import {
  ClassDecl,
  MethodKind,
} from "../../../program/ast/types/ast.types.classes.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { ExpressionCollector } from "../expression-collector/expression-collector.tz";
import { FunctionDecl } from "../../../program/ast/types/ast.types.functions.tz";
import {
  Stmt,
  VarDeclStmt,
} from "../../../program/ast/types/ast.types.statements.tz";
import {
  kDisposeKey,
  kDisposeName,
  kSuperName,
  kSymbolName,
  kThisName,
} from "./const/dispose-rules.const.tz";

export class DisposeRules {
  private readonly collector: ExpressionCollector;

  public constructor(collector: ExpressionCollector) {
    this.collector = collector;
  }

  public ownDispose(decl: ClassDecl): FunctionDecl | undefined {
    return decl.methods.find((method) => method.name == kDisposeKey);
  }

  public isDisposeMethod(fn: FunctionDecl | undefined): boolean {
    return fn != undefined && fn.name == kDisposeKey;
  }

  public disposeErrors(
    dispose: FunctionDecl,
    isGivingValue: boolean,
    inherited: string | undefined,
  ): SourceError[] {
    const errors: SourceError[] = [];
    const loc = dispose.loc;
    const isStatic = dispose.role?.method == MethodKind.Static;
    const isWrong =
      dispose.params.length > 0 ||
      isStatic ||
      dispose.isAsync ||
      dispose.isGenerator ||
      isGivingValue;
    if (isWrong) {
      errors.push({ code: Code.DisposeShape, loc, details: kNoDetails });
    }
    if (inherited != undefined && !this.hasSuperDisposeCall(dispose)) {
      errors.push({
        code: Code.DisposeNoSuper,
        loc,
        details: { word: inherited },
      });
    }
    if (this.isLeavingThis(dispose)) {
      errors.push({ code: Code.DisposeThisLeaves, loc, details: kNoDetails });
    }

    return errors;
  }

  public outlivesErrors(
    statement: VarDeclStmt,
    following: Stmt[],
  ): SourceError[] {
    const errors: SourceError[] = [];

    for (const decl of statement.decls) {
      const isEscaping = following.some((one) =>
        this.isEscaping(decl.name, one),
      );
      if (isEscaping) {
        errors.push({
          code: Code.UsingOutlives,
          loc: decl.loc,
          details: { word: decl.name },
        });
      }
    }

    return errors;
  }

  public isDisposeCall(expr: CallExpr): boolean {
    const callee = expr.callee;
    if (callee.kind != ExprKind.Index) {
      return false;
    }

    return this.isDisposeKey(callee.index);
  }

  public isSuperDisposeCall(expr: CallExpr): boolean {
    const callee = expr.callee;
    if (callee.kind == ExprKind.Member) {
      return callee.name == kDisposeKey;
    }
    if (callee.kind != ExprKind.Index) {
      return false;
    }

    return (
      this.isDisposeKey(callee.index) && this.isNamed(callee.object, kSuperName)
    );
  }

  private isDisposeKey(key: Expr): boolean {
    if (key.kind != ExprKind.Member || key.name != kDisposeName) {
      return false;
    }

    return this.isNamed(key.object, kSymbolName);
  }

  private hasSuperDisposeCall(dispose: FunctionDecl): boolean {
    const exprs = this.collector.functionExprs(dispose, false);

    return exprs.some(
      (expr) => expr.kind == ExprKind.Call && this.isSuperDisposeCall(expr),
    );
  }

  private isLeavingThis(dispose: FunctionDecl): boolean {
    const exprs = this.collector.functionExprs(dispose, false);
    const reads = new Set<Expr>();

    for (const expr of exprs) {
      if (
        expr.kind == ExprKind.Member &&
        this.isNamed(expr.object, kThisName)
      ) {
        reads.add(expr.object);
      }
    }

    return exprs.some((expr) => {
      const isLoose = this.isNamed(expr, kThisName) && !reads.has(expr);

      return isLoose || this.isCaptured(expr, kThisName);
    });
  }

  private isEscaping(name: string, statement: Stmt): boolean {
    const exprs: Expr[] = [];
    const values: Expr[] = [];

    this.collector.statementExprs(statement, exprs, values, false);

    if (values.some((value) => this.isNamed(value, name))) {
      return true;
    }

    return exprs.some((expr) => {
      const isHeld = this.heldParts(expr).some((part) =>
        this.isNamed(part, name),
      );

      return isHeld || this.isCaptured(expr, name);
    });
  }

  private isCaptured(expr: Expr, name: string): boolean {
    if (expr.kind != ExprKind.Function) {
      return false;
    }

    const inner = this.collector.functionExprs(expr.fn, true);

    return inner.some((one) => this.isNamed(one, name));
  }

  private heldParts(expr: Expr): Expr[] {
    switch (expr.kind) {
      case ExprKind.Assign:
        return [expr.value];
      case ExprKind.ArrayLit:
        return expr.elements.map((element) => element.expr);
      case ExprKind.ObjectLit:
        return expr.props.map((property) => property.value);
      case ExprKind.New:
        return expr.args.map((arg) => arg.expr);
      case ExprKind.Yield:
        return this.collector.optionalPart(expr.value);
      default:
        return [];
    }
  }

  private isNamed(expr: Expr, name: string): boolean {
    return expr.kind == ExprKind.Name && expr.name == name;
  }
}
