import { Code } from "../../../diagnostic/code.tz";
import { kNoDetails } from "../../../diagnostic/const/message.const.tz";
import { SourceError } from "../../../diagnostic/types/message.types.tz";
import {
  LiteralKind,
  Type,
  TypeKind,
} from "../../../program/type/types/type.types.tz";
import { ModuleQuestions } from "../../declaration/module-questions/module-questions.tz";
import { TypeQuestions } from "../../types/type-questions/type-questions.tz";
import { ByteSourceRules } from "../byte-source-rules/byte-source-rules.tz";
import { TypeText } from "../../../program/type/type-text/type-text.tz";
import {
  kAsyncCryptoNames,
  kCcmMode,
  kFloatArrays,
  kGlobalCryptoCalls,
  kGlobalCryptoMembers,
  kKeyObjectClass,
  kCryptoClassShapes,
  kIssuerCertificateName,
  kKeyDetailsName,
  kStreamMethods,
  kCertificateClass,
  kCryptoClasses,
  kCurveTypes,
  kModulusTypes,
  kPairTypeLabel,
  kPairTypes,
  kRsaTypes,
  kSmallestModulus,
  kCryptoModules,
  kKeyBytesNames,
  kSyncCryptoNames,
} from "./const/crypto-rules.const.tz";
import {
  kCipherAliases,
  kCipherNames,
  kCurveNames,
  kDirectCiphers,
  kHashNames,
  kKeptCipherPrefixes,
  kTurnedOffCiphers,
  kTurnedOffHashes,
} from "./const/crypto-rules.const.names.tz";
import {
  CryptoClass,
  CryptoDataKinds,
  CryptoNumber,
  DigestUse,
  DirectCipher,
} from "./types/crypto-rules.types.tz";

export class CryptoRules {
  private readonly text: TypeText;
  private readonly types: TypeQuestions;
  private readonly modules: ModuleQuestions;
  private readonly byteSources: ByteSourceRules;

  public constructor(
    text: TypeText,
    types: Own<TypeQuestions>,
    modules: Own<ModuleQuestions>,
    byteSources: Own<ByteSourceRules>,
  ) {
    this.text = text;
    this.types = types;
    this.modules = modules;
    this.byteSources = byteSources;
  }

  public readonly isCryptoModule(name: string): boolean {
    return kCryptoModules.includes(name);
  }

  public readonly syncName(name: string): string {
    const index = kAsyncCryptoNames.indexOf(name);

    return kSyncCryptoNames[index] ?? name;
  }

  public readonly hashError(
    loc: int,
    text: string,
    use: DigestUse,
  ): SourceError | undefined {
    const name = text.toLowerCase();
    const hash = kHashNames.find(
      (one) => one.name == name || one.aliases.includes(name),
    );
    if (hash != undefined && use == DigestUse.Hmac && hash.isAnyLength) {
      return { code: Code.CryptoHashAnyLength, loc, details: { word: text } };
    }
    if (hash != undefined) {
      return undefined;
    }
    if (kTurnedOffHashes.includes(name)) {
      return { code: Code.CryptoHashTurnedOff, loc, details: { word: text } };
    }

    return { code: Code.CryptoHashUnknown, loc, details: { word: text } };
  }

  public readonly cipherError(loc: int, text: string): SourceError | undefined {
    const name = text.toLowerCase();
    const isKnown =
      this.directCipher(text) != undefined || kCipherNames.includes(name);
    if (isKnown) {
      return undefined;
    }
    if (this.isTurnedOffCipher(name)) {
      return { code: Code.CryptoCipherTurnedOff, loc, details: { word: text } };
    }

    return { code: Code.CryptoCipherUnknown, loc, details: { word: text } };
  }

  public readonly directCipher(text: string): DirectCipher | undefined {
    const name = text.toLowerCase();
    const alias = kCipherAliases.find((one) => one.alias == name);
    const canonical = alias?.name ?? name;

    return kDirectCiphers.find((one) => one.name == canonical);
  }

  public readonly needsTagLength(text: string): boolean {
    return text.toLowerCase().includes(kCcmMode);
  }

  public readonly tagLengthError(loc: int, text: string): SourceError {
    return { code: Code.CryptoTagLength, loc, details: { word: text } };
  }

  public readonly isKeyBytes(type: Type): boolean {
    const base = this.types.definedType(type);

    return (
      base.kind == TypeKind.Instance &&
      kKeyBytesNames.includes(base.name) &&
      this.modules.isLibraryModule(base.module)
    );
  }

  public readonly keyError(
    loc: int,
    cipher: DirectCipher,
    have: decimal,
  ): SourceError | undefined {
    if (have == cipher.keyBytes.toDecimal()) {
      return undefined;
    }

    const details = {
      word: cipher.name,
      first: `${cipher.keyBytes}`,
      second: `${have}`,
    };

    return { code: Code.CryptoKeyBytes, loc, details };
  }

  public readonly ivError(
    loc: int,
    cipher: DirectCipher,
    have: decimal,
  ): SourceError | undefined {
    const isEmpty = have == (0).toDecimal();
    if (cipher.isAnyIv && isEmpty) {
      const details = { word: cipher.name };

      return { code: Code.CryptoIvEmpty, loc, details };
    }
    if (cipher.isAnyIv || have == cipher.ivBytes.toDecimal()) {
      return undefined;
    }

    const details = {
      word: cipher.name,
      first: `${cipher.ivBytes}`,
      second: `${have}`,
    };

    return { code: Code.CryptoIvBytes, loc, details };
  }

  public readonly wholeError(
    loc: int,
    name: string,
    least: int,
    number: CryptoNumber,
  ): SourceError | undefined {
    if (number.isWhole && number.value >= least.toDecimal()) {
      return undefined;
    }

    const details = { word: name, first: `${least}`, second: number.shown };

    return { code: Code.CryptoWhole, loc, details };
  }

  public readonly costError(loc: int, number: CryptoNumber): SourceError | undefined {
    const isZero = number.isWhole && number.value == (0).toDecimal();
    if (isZero || (number.isWhole && this.isPowerOfTwo(number.value))) {
      return undefined;
    }

    return {
      code: Code.CryptoScryptCost,
      loc,
      details: { word: number.shown },
    };
  }

  public readonly isAsyncName(name: string): boolean {
    return kAsyncCryptoNames.includes(name);
  }

  public readonly optionsLiteralError(
    loc: int,
    shown: string,
    allowed: Read<string[]>,
  ): SourceError {
    const details = { word: shown, first: allowed[0] ?? "" };

    return { code: Code.CryptoOptionsLiteral, loc, details };
  }

  public readonly optionsByNameError(
    loc: int,
    shown: string,
    allowed: Read<string[]>,
  ): SourceError {
    const details = { word: shown, first: allowed[0] ?? "" };

    return { code: Code.CryptoOptionsByName, loc, details };
  }

  public readonly optionUnknownError(
    loc: int,
    shown: string,
    name: string,
    allowed: Read<string[]>,
  ): SourceError {
    const other = this.andList(allowed);
    const details = { word: shown, first: name, other };

    return { code: Code.CryptoOptionUnknown, loc, details };
  }

  public readonly togetherError(loc: int, first: string, second: string): SourceError {
    const details = { word: first, first: second };

    return { code: Code.CryptoOptionsTogether, loc, details };
  }

  public readonly asyncCallbackError(loc: int, shown: string): SourceError {
    return { code: Code.CryptoAsyncCallback, loc, details: { word: shown } };
  }

  public readonly syncCallbackError(loc: int, name: string, hint: string): SourceError {
    const details = { word: name, other: hint };

    return { code: Code.CryptoSyncCallback, loc, details };
  }

  public readonly curveError(loc: int, name: string): SourceError | undefined {
    if (kCurveNames.includes(name)) {
      return undefined;
    }

    return { code: Code.CryptoCurveUnknown, loc, details: { word: name } };
  }

  public readonly pairTypeError(loc: int, text: string): SourceError | undefined {
    if (kPairTypes.includes(text)) {
      return undefined;
    }

    const other = this.orList(kPairTypes);
    const details = { word: kPairTypeLabel, first: text, other };

    return { code: Code.CryptoChoiceUnknown, loc, details };
  }

  public readonly pairOptionError(loc: int, name: string): SourceError {
    return { code: Code.CryptoPairOption, loc, details: { word: name } };
  }

  public readonly pairNeedsError(
    loc: int,
    type: string,
    hasModulus: boolean,
    hasCurve: boolean,
  ): SourceError | undefined {
    if (kModulusTypes.includes(type) && !hasModulus) {
      return { code: Code.CryptoPairModulus, loc, details: { word: type } };
    }
    if (kCurveTypes.includes(type) && !hasCurve) {
      return { code: Code.CryptoPairCurve, loc, details: kNoDetails };
    }

    return undefined;
  }

  public readonly smallModulusError(
    loc: int,
    type: string,
    number: CryptoNumber,
  ): SourceError | undefined {
    const isSmall = number.value < kSmallestModulus.toDecimal();
    if (!kRsaTypes.includes(type) || !isSmall) {
      return undefined;
    }

    return { code: Code.CryptoPairSmall, loc, details: { word: number.shown } };
  }

  public readonly isCryptoClass(name: string): boolean {
    return kCryptoClasses.includes(name);
  }

  public readonly newError(loc: int, name: string): SourceError {
    if (name == kCertificateClass) {
      return { code: Code.CryptoNewCertificate, loc, details: kNoDetails };
    }

    const other = this.makerHint(name);

    return { code: Code.CryptoNewClass, loc, details: { word: name, other } };
  }

  public readonly classOf(type: Type, home: string): Read<CryptoClass> | undefined {
    const base = this.types.definedType(type);
    if (base.kind != TypeKind.Instance || !this.isCryptoModule(home)) {
      return undefined;
    }

    return kCryptoClassShapes.find((one) => one.name == base.name);
  }

  public readonly methodError(
    loc: int,
    shape: Read<CryptoClass>,
    name: string,
  ): SourceError | undefined {
    if (shape.methods.includes(name)) {
      return undefined;
    }
    if (shape.isStream && kStreamMethods.includes(name)) {
      const details = { word: name, first: shape.name, other: shape.instead };

      return { code: Code.CryptoStreamMethod, loc, details };
    }

    const details = { word: name, first: shape.name, other: shape.text };

    return { code: Code.CryptoNoMethod, loc, details };
  }

  public readonly memberError(
    loc: int,
    shape: Read<CryptoClass>,
    name: string,
  ): SourceError | undefined {
    if (name == kKeyDetailsName) {
      return { code: Code.CryptoKeyDetails, loc, details: kNoDetails };
    }
    if (name == kIssuerCertificateName) {
      return { code: Code.CryptoIssuerCertificate, loc, details: kNoDetails };
    }
    if (shape.properties.includes(name)) {
      return undefined;
    }

    const details = { word: name, first: shape.name, other: shape.text };

    return { code: Code.CryptoOnlyCalled, loc, details };
  }

  public readonly dataError(
    loc: int,
    what: string,
    kinds: CryptoDataKinds,
    type: Type,
  ): SourceError | undefined {
    const base = this.types.definedType(type);
    if (base.kind == TypeKind.Error) {
      return undefined;
    }

    const parts = this.types.unionMembers(type);
    const isFine = parts.every((part) => this.isCryptoData(part, kinds));
    if (isFine && parts.length > 0) {
      return undefined;
    }

    const details = {
      word: what,
      other: this.dataKindsText(kinds.isString),
      first: this.dataExtrasText(kinds),
      second: this.textOf(type),
      place: this.numericHint(type),
    };

    return { code: Code.CryptoNotData, loc, details };
  }

  public readonly encodingLiteralError(loc: int, name: string): SourceError {
    return { code: Code.CryptoEncodingLiteral, loc, details: { word: name } };
  }

  public readonly randomValuesError(loc: int, type: Type): SourceError | undefined {
    const name = this.byteSources.typedName(type);
    const isFilled =
      name != undefined &&
      this.byteSources.isByteView(type) &&
      name != "DataView" &&
      !kFloatArrays.includes(name);
    if (isFilled) {
      return undefined;
    }

    const word = this.textOf(type);

    return { code: Code.CryptoRandomValues, loc, details: { word } };
  }

  public readonly globalMemberError(loc: int, name: string): SourceError | undefined {
    if (kGlobalCryptoCalls.includes(name)) {
      return { code: Code.CryptoGlobalCalled, loc, details: { word: name } };
    }
    if (kGlobalCryptoMembers.includes(name)) {
      return undefined;
    }

    return { code: Code.CryptoGlobalMember, loc, details: { word: name } };
  }

  public readonly greaterCode(hasMinimum: boolean): Code {
    if (hasMinimum) {
      return Code.CryptoGreaterMinimum;
    }

    return Code.CryptoGreaterZero;
  }

  public readonly choiceError(
    loc: int,
    label: string,
    text: string,
    values: Read<string[]>,
  ): SourceError | undefined {
    if (values.includes(text)) {
      return undefined;
    }

    const other = this.orList(values);
    const details = { word: label, first: text, other };

    return { code: Code.CryptoChoiceUnknown, loc, details };
  }

  private readonly isPowerOfTwo(value: decimal): boolean {
    const two = (2).toDecimal();
    const one = (1).toDecimal();
    if (value < two) {
      return false;
    }

    let rest = value;

    while (rest > one && rest % two == (0).toDecimal()) {
      rest = rest / two;
    }

    return rest == one;
  }

  private readonly isTurnedOffCipher(name: string): boolean {
    if (kKeptCipherPrefixes.some((kept) => name.startsWith(kept))) {
      return false;
    }

    return kTurnedOffCiphers.some((one) => {
      if (one.isPrefix) {
        return name.startsWith(one.text);
      }

      return name == one.text;
    });
  }

  private readonly andList(values: Read<string[]>): string {
    const last = values[values.length - 1] ?? "";
    if (values.length <= 1) {
      return last;
    }

    const head = values.slice(0, values.length - 1).join(", ");

    return `${head} and ${last}`;
  }

  private readonly orList(values: Read<string[]>): string {
    const last = values[values.length - 1] ?? "";
    if (values.length <= 1) {
      return `'${last}'`;
    }

    const head = values.slice(0, values.length - 1).join("', '");

    return `'${head}' or '${last}'`;
  }

  private readonly makerHint(name: string): string {
    switch (name) {
      case "KeyObject":
        return "use 'createSecretKey', 'createPublicKey' or 'createPrivateKey'";
      case "ECDH":
        return "use 'createECDH(curve)'";
      case "Sign":
      case "Verify":
      case "Hash":
      case "Hmac":
        return `use 'create${name}(algorithm)'`;
      default:
        return `use 'create${name}(algorithm, key, iv)'`;
    }
  }

  private readonly isCryptoData(type: Type, kinds: CryptoDataKinds): boolean {
    const isText =
      type.kind == TypeKind.String ||
      (type.kind == TypeKind.Literal && type.literal == LiteralKind.String);
    const isKey =
      type.kind == TypeKind.Instance &&
      type.name == kKeyObjectClass &&
      this.modules.isLibraryModule(type.module);

    return (
      (kinds.isString && isText) ||
      this.byteSources.isByteView(type) ||
      (kinds.isArrayBuffer && this.byteSources.isArrayBuffer(type)) ||
      (kinds.isKey && isKey)
    );
  }

  private readonly dataKindsText(isString: boolean): string {
    if (isString) {
      return "a string or bytes";
    }

    return "bytes";
  }

  private readonly dataExtrasText(kinds: CryptoDataKinds): string {
    let text = "";

    if (kinds.isArrayBuffer) {
      text += ", an ArrayBuffer";
    }
    if (kinds.isKey) {
      text += ", a KeyObject";
    }

    return text;
  }

  private readonly numericHint(type: Type): string {
    if (this.types.isNumeric(type)) {
      return "; make text of it with 'String(x)'";
    }

    return "";
  }

  private readonly textOf(type: Type): string {
    return this.text.of(type);
  }
}
