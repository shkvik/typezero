import { replace } from "tz:mem";
import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { ClassDecl } from "../../../../program/ast/types/ast.types.classes.tz";
import { NewExpr } from "../../../../program/ast/types/ast.types.expressions.tz";
import {
  InstanceType,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import {
  CallTarget,
  ReflectedNew,
} from "../../../code/expression-types/types/expression-types.types.tz";
import {
  kAbstractReason,
  kNoArgumentsReason,
  kSeveralReason,
  kTakesReason,
} from "../../library-rules/const/library-rules.const.tz";

partial class ExpressionTypes {
  private constructorCastNote(given: Type, wanted: Type): void {
    const goal = this.types.definedType(wanted);
    if (given.kind != TypeKind.Class || goal.kind != TypeKind.Class) {
      return;
    }
    if (goal.exact) {
      return;
    }
    if (!given.exact) {
      return this.constructorWideningNote(
        this.types.store.classInstanceOf(given),
        this.types.store.classInstanceOf(goal),
      );
    }

    const instance = this.types.store.classInstanceOf(given);
    if (instance.kind != TypeKind.Instance) {
      return;
    }

    const decl = this.classOf(instance);
    const target = this.types.store.classInstanceOf(goal);
    const isKnown = this.constructorCasts.some(
      (one) => one.decl.id == decl?.id && one.target.id == target.id,
    );
    if (decl == undefined || isKnown) {
      return;
    }

    this.constructorCasts.push({ decl, instance, target });
  }

  private constructorWideningNote(from: Type, to: Type): void {
    if (from.id == to.id) {
      return;
    }

    const isKnown =
      this.constructorWidenings.get(from.id)?.includes(to) ?? false;
    if (isKnown) {
      return;
    }
    if (!this.constructorWidenings.has(from.id)) {
      this.constructorWidenings.set(from.id, []);
    }

    this.constructorWidenings.get(from.id)?.push(to);
  }

  private reflectedNewNote(expr: NewExpr, made: Type, module: int): void {
    const tree = this.types.program.tree;

    const exprs = tree
      .argumentsOf(expr.argsList)
      .map((arg) => tree.exprOf(arg.exprId));
    const args = exprs.map((one) => this.peekType(one, module));
    const loc = expr.loc;

    this.reflectedNews.push({ loc, made, exprs, args, module });
  }

  private reflectedNewsCheck(module: int): void {
    const news = replace(this.reflectedNews, []);

    for (const reflected of news) {
      if (reflected.module == module) {
        this.reflectedNewCheck(reflected);
      }
    }

    const added = replace(this.reflectedNews, news);

    this.reflectedNews.push(...added);
  }

  private reflectedNewCheck(reflected: Read<ReflectedNew>): void {
    const reached = this.reachedConstructors(reflected.made);
    const count = this.constructorCasts.length;

    for (let index: int = 0; index < count; index++) {
      const cast = this.constructorCasts[index];
      if (
        cast == undefined ||
        !reached.some((one) => one.id == cast.target.id)
      ) {
        continue;
      }

      const reason = this.constructibleReason(
        cast.decl,
        cast.instance,
        reflected,
      );
      if (reason != "") {
        this.errors.write(
          reflected.module,
          reflected.loc,
          Code.ReflectNewMayFail,
          {
            word: cast.decl.name ?? "",
            other: reason,
          },
        );

        return;
      }
    }
  }

  private readonly reachedConstructors(made: Type): Type[] {
    const reached: Type[] = [];
    const waiting: Type[] = [];

    for (const cast of this.constructorCasts) {
      if (!reached.some((one) => one.id == cast.target.id)) {
        reached.push(cast.target);
        waiting.push(cast.target);
      }
    }

    const reaching: Type[] = [];

    for (const start of waiting) {
      if (this.isReaching(start, made)) {
        reaching.push(start);
      }
    }

    return reaching;
  }

  private readonly isReaching(start: Type, made: Type): boolean {
    const seen: Type[] = [start];
    const waiting: Type[] = [start];

    while (waiting.length > 0) {
      const current = waiting.pop();
      if (current == undefined) {
        continue;
      }
      if (current.id == made.id) {
        return true;
      }

      for (const next of this.constructorWidenings.get(current.id) ?? []) {
        if (!seen.some((one) => one.id == next.id)) {
          seen.push(next);
          waiting.push(next);
        }
      }
    }

    return false;
  }

  private constructibleReason(
    decl: ClassDecl,
    instance: InstanceType,
    reflected: Read<ReflectedNew>,
  ): string {
    const tree = this.types.program.tree;

    if (decl.isAbstract) {
      return kAbstractReason;
    }

    const maker = this.makerOf(instance, decl);
    if (
      maker == undefined ||
      tree.typeParamsOf(decl.typeParamsList).length > 0
    ) {
      return "";
    }

    const constructors = tree.functionsOf(maker.owner.constructorsList);
    if (constructors.length == 0) {
      return this.noConstructorReason(reflected.args.length);
    }

    const targets: CallTarget[] = [];

    for (const made of constructors) {
      const target = this.constructorTarget(maker, made, decl.loc);
      if (target == undefined) {
        return "";
      }

      targets.push(target);
    }

    let fitting: int = 0;
    let exact: int = 0;

    for (const target of targets) {
      if (!this.isConstructing(target, reflected)) {
        continue;
      }

      fitting += 1;

      if (this.isExactConstructor(target, reflected.args)) {
        exact += 1;
      }
    }
    if (fitting == 1 || exact == 1) {
      return "";
    }
    if (fitting > 1) {
      return kSeveralReason;
    }

    return `${kTakesReason}${this.takesText(targets)}`;
  }

  private readonly noConstructorReason(count: int): string {
    if (count == 0) {
      return "";
    }

    return kNoArgumentsReason;
  }

  private isConstructing(
    target: Read<CallTarget>,
    reflected: Read<ReflectedNew>,
  ): boolean {
    const args = reflected.args;
    const least = this.types.leastArguments(target);
    const isTooMany = !target.rest && args.length > target.params.length;
    if (args.length < least || isTooMany) {
      return false;
    }

    return args.every((arg, index) => {
      const param = this.constructorParam(target, index);
      const expr = reflected.exprs[index];
      if (param == undefined || expr == undefined) {
        return false;
      }
      if (this.types.converts(arg, param)) {
        return true;
      }

      return this.isAdaptingLiteral(expr, arg, param, reflected.module);
    });
  }

  private readonly isExactConstructor(
    target: Read<CallTarget>,
    args: Read<Type[]>,
  ): boolean {
    return args.every((arg, index) => {
      const param = this.constructorParam(target, index);

      return param != undefined && this.types.apparent(arg).id == param.id;
    });
  }

  private readonly constructorParam(
    target: Read<CallTarget>,
    index: int,
  ): Type | undefined {
    const last = target.params[target.params.length - 1];
    const param = target.params[index] ?? last;

    return param?.type;
  }

  private readonly takesText(targets: Read<CallTarget[]>): string {
    const shown = targets.map((target) => {
      const params = target.params.map((param) =>
        this.types.typeText(param.type),
      );

      return `(${params.join(", ")})`;
    });

    return shown.join(" or ");
  }
}
