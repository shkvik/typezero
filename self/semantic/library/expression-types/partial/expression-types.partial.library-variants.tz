import {
  DeclaredMember,
  DeclaredMemberKind,
} from "../../../../program/ast/types/ast.types.declarations.tz";
import {
  CallArgument,
  CallExpr,
  ExprKind,
  MemberExpr,
  NameExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../program/ast/types/ast.types.functions.tz";
import { StmtKind } from "../../../../program/ast/types/ast.types.statements.tz";
import {
  FunctionType,
  InstanceType,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import {
  CallKind,
  LibraryVariants,
  OpenVariant,
  RankedVariant,
} from "../../../code/expression-types/types/expression-types.types.tz";
import {
  ParameterSite,
  TypeContext,
} from "../../../types/type-resolver/types/type-resolver.types.tz";

partial class ExpressionTypes {
  private declaredVariants(
    instance: InstanceType,
    name: string,
    isStatic: boolean,
  ): LibraryVariants {
    const tree = this.types.program.tree;

    const opened = this.types.program.modules[instance.module];
    const declared = tree
      .declaredClassesOf(opened?.declaredList)
      .find((one) => one.loc == instance.loc);
    if (declared == undefined) {
      return { types: [], open: [] };
    }

    const members = tree.declaredMembersOf(declared.membersList).filter(
      (one) => one.name == name && one.isStatic == isStatic,
    );
    if (members.length == 0 && !isStatic) {
      return this.parentVariantTypes(instance, name);
    }
    if (members.length < 2) {
      return { types: [], open: [] };
    }

    const context = this.types.classContext(
      instance,
      tree.typeParamsOf(declared.typeParamsList),
      instance.module,
    );

    return this.variantsOf(members, context);
  }

  private variantsOf(
    members: Read<DeclaredMember[]>,
    context: Read<TypeContext>,
  ): LibraryVariants {
    const tree = this.types.program.tree;

    const types: FunctionType[] = [];
    const open: OpenVariant[] = [];

    for (const member of members) {
      const type = this.variantType(member, context);
      const form = member.form;

      if (type != undefined) {
        types.push(type);
      }
      if (type == undefined && form.kind != DeclaredMemberKind.Field) {
        const result = this.openResult(member, context);

        const paramsItem = tree.paramsOf(form.paramsList);

        open.push({ params: paramsItem, result });
      }
    }

    return { types, open };
  }

  private openResult(
    member: DeclaredMember,
    context: Read<TypeContext>,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const written = tree.typeRefAt(member.typeId);
    if (written == undefined) {
      return undefined;
    }

    this.errors.beginTrial();

    const result = this.types.resolve(written, context);

    this.errors.endTrial();

    if (result.kind == TypeKind.Error || this.types.mentionsParameter(result)) {
      return undefined;
    }

    return result;
  }

  private parentVariantTypes(
    instance: InstanceType,
    name: string,
  ): LibraryVariants {
    const parent = this.types.baseClassOf(instance);
    if (parent == undefined || parent.kind != TypeKind.Instance) {
      return { types: [], open: [] };
    }

    return this.declaredVariants(parent, name, false);
  }

  private variantType(
    member: DeclaredMember,
    context: Read<TypeContext>,
  ): FunctionType | undefined {
    const tree = this.types.program.tree;

    const form = member.form;
    if (
      form.kind == DeclaredMemberKind.Field ||
      tree.typeParamsOf(form.typeParamsList).length > 0
    ) {
      return undefined;
    }

    const sites: ParameterSite[] = [];

    for (const param of tree.paramsOf(form.paramsList)) {
      const type = tree.typeRefAt(param.typeId);
      if (type == undefined) {
        return undefined;
      }

      sites.push({
        name: param.name,
        loc: param.loc,
        kind: param.form.kind,
        type,
        isDeclared: false,
      });
    }

    const signature = this.types.signature(
      sites,
      tree.typeRefAt(member.typeId),
      context,
    );
    if (signature.kind != TypeKind.Function) {
      return undefined;
    }

    return signature;
  }

  private variantLibraryCall(
    expr: CallExpr,
    member: MemberExpr,
    variants: Read<LibraryVariants>,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const chosen = this.quietVariant(
      tree.argumentsOf(expr.argsList),
      member.name,
      variants,
      module,
    );
    if (chosen == undefined) {
      const args = tree.argumentsOf(expr.argsList);

      this.looseValues(args, module);

      return this.sharedResult(variants);
    }

    this.positionMethod = member.name;

    return this.calledWith(expr, chosen, member.loc, CallKind.Library, module);
  }

  private looseValues(args: Read<CallArgument[]>, module: int): void {
    const tree = this.types.program.tree;

    for (const arg of args) {
      const exprExpr = tree.exprOf(arg.exprId);
      if (exprExpr.kind != ExprKind.Function) {
        const expr = tree.exprOf(arg.exprId);

        this.typed(expr, undefined, module);
      }
    }
  }

  private quietVariant(
    args: Read<CallArgument[]>,
    name: string,
    variants: Read<LibraryVariants>,
    module: int,
  ): FunctionType | undefined {
    const tree = this.types.program.tree;

    const count = args.length;
    const ranked = this.types.typeVariants(name, variants.types);
    const counted = this.countFitting(ranked, count);
    const hasOthers = variants.open.some((one) =>
      this.types.isCountTaking(one.params, count),
    );
    const isPlain = args.every(
      (arg) => !arg.spread && tree.exprOf(arg.exprId).kind != ExprKind.Function,
    );
    const only = counted[0];
    const isOnly = counted.length == 1 && !hasOthers;
    if (isOnly && only != undefined && !isPlain) {
      return only.type;
    }
    if (!isPlain) {
      return undefined;
    }

    const given = this.quietArguments(args, module);
    const fitting: int[] = [];

    for (let index = 0; index < counted.length; index++) {
      const variant = counted[index];
      if (variant == undefined) {
        continue;
      }

      const reason = this.variantRanks(args, given, variant, module);
      if (reason == "") {
        fitting.push(index);
      }
    }

    const best = this.bestVariantAt(counted, fitting) ?? fitting[0];
    if (best == undefined) {
      return undefined;
    }

    return counted[best]?.type;
  }

  private readonly sharedResult(variants: Read<LibraryVariants>): Type {
    const results: (Type | undefined)[] = [];

    for (const type of variants.types) {
      results.push(this.types.store.returnTypeOf(type));
    }

    for (const other of variants.open) {
      results.push(other.result);
    }

    const first = results[0];
    const isShared =
      first != undefined && results.every((result) => result?.id == first.id);
    if (!isShared || first == undefined) {
      return this.types.store.plain(TypeKind.Error);
    }

    return first;
  }

  private overloadedLibraryCall(
    expr: CallExpr,
    callee: NameExpr,
    fn: FunctionDecl,
    home: int,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const variants = this.functionVariants(fn, home);
    const count = tree.argumentsOf(expr.argsList).length;
    const isPlain = tree.argumentsOf(expr.argsList).every(
      (arg) => !arg.spread && tree.exprOf(arg.exprId).kind != ExprKind.Function,
    );
    const isOpenFitting = variants.open.some((one) =>
      this.types.isCountTaking(one.params, count),
    );
    if (isOpenFitting || !isPlain) {
      return this.types.store.plain(TypeKind.Error);
    }

    const chosen = this.cleanVariant(expr, callee, variants.types, module);
    if (chosen == undefined) {
      return this.sharedResult(variants);
    }

    this.positionMethod = callee.name;

    const result = this.calledWith(
      expr,
      chosen,
      callee.loc,
      CallKind.Library,
      module,
    );

    if (result.kind == TypeKind.Promise) {
      this.lenientCalls.delete(expr.id);
    }

    return result;
  }

  private cleanVariant(
    expr: CallExpr,
    callee: NameExpr,
    types: Read<FunctionType[]>,
    module: int,
  ): FunctionType | undefined {
    const tree = this.types.program.tree;

    const count = tree.argumentsOf(expr.argsList).length;

    for (const type of types) {
      if (!this.types.isCountFitting(type, count)) {
        continue;
      }

      this.errors.beginTrial();
      this.calledWith(expr, type, callee.loc, CallKind.Library, module);

      const isClean = this.errors.endTrial();
      if (isClean) {
        return type;
      }
    }

    return undefined;
  }

  private functionVariants(fn: FunctionDecl, home: int): LibraryVariants {
    const tree = this.types.program.tree;

    const items =
      tree.stmtsOf(this.types.program.modules[home]?.file.itemsList) ?? [];
    const types: FunctionType[] = [];
    const open: OpenVariant[] = [];

    for (const item of items) {
      if (item.kind != StmtKind.Function || item.name != fn.name) {
        continue;
      }
      const typeParams = tree.typeParamsOf(item.typeParamsList);
      if (typeParams.length > 0) {
        const paramsItem = tree.paramsOf(item.paramsList);

        open.push({ params: paramsItem });
        continue;
      }

      const type = this.functionAt(home, item.loc);
      if (type.kind == TypeKind.Function) {
        types.push(type);
      }
    }

    return { types, open };
  }
}
