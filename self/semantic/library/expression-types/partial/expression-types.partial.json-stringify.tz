import {
  CallExpr,
  ExprKind,
  MemberExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { FieldKind } from "../../../../program/ast/types/ast.types.classes.tz";
import {
  InstanceType,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import { kJsonGlobalName } from "../../../code/expression-types/const/expression-types.const.tz";
import { HeldStep } from "../../../code/expression-types/types/expression-types.types.tz";
import {
  kJsonErrorName,
  kStringifyName,
} from "../../library-rules/const/library-rules.const.tz";

partial class ExpressionTypes {
  private readonly stringifiedType(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): Type | undefined {
    const object = member.object;
    const isJson =
      object.kind == ExprKind.Name &&
      object.name == kJsonGlobalName &&
      this.isGlobalUse(object, module);
    const hasSpread = expr.args.some((one) => one.spread);
    const value = expr.args[0]?.expr;
    const count = expr.args.length;
    if (!isJson || member.name != kStringifyName || hasSpread) {
      return undefined;
    }
    if (
      value == undefined ||
      count > 3 ||
      this.modules.isLibraryModule(module)
    ) {
      return undefined;
    }

    const given = this.typed(value, undefined, module);

    for (const arg of expr.args.slice(1)) {
      if (this.isGivenOption(arg.expr, module)) {
        this.typed(arg.expr, undefined, module);
      }
    }

    if (given.kind == TypeKind.Error) {
      return given;
    }

    const text = this.stringifiedText(given);
    if (!this.canHoldItself(given)) {
      return text;
    }

    const fails = this.namedLibraryType(kJsonErrorName, 0, module);
    if (fails.kind == TypeKind.Error) {
      return fails;
    }

    return this.store.resultOf(text, fails);
  }

  private readonly stringifiedText(given: Type): Type {
    const text = this.store.plain(TypeKind.String);
    const isMaybe =
      this.types.isOptional(given) ||
      given.kind == TypeKind.Undefined ||
      given.kind == TypeKind.Function ||
      given.kind == TypeKind.Never ||
      given.kind == TypeKind.Unknown;
    if (isMaybe) {
      return this.types.optional(text);
    }

    return text;
  }

  private readonly canHoldItself(type: Type): boolean {
    const open: Type[] = [];
    const steps: HeldStep[] = [{ type, isLeave: false }];

    while (steps.length > 0) {
      const step = steps.pop();
      if (step == undefined) {
        return false;
      }
      if (step.isLeave) {
        open.pop();
        continue;
      }

      const plain = this.types.definedType(step.type);
      const isOpen =
        plain.kind == TypeKind.TypeParameter ||
        plain.kind == TypeKind.AnyObject;
      if (isOpen) {
        continue;
      }

      const isUnbounded =
        plain.kind == TypeKind.Json ||
        plain.kind == TypeKind.Unknown ||
        open.includes(plain);
      if (isUnbounded) {
        return true;
      }

      open.push(plain);
      steps.push({ type: plain, isLeave: true });

      const parts = this.heldParts(plain);

      for (let index = parts.length - 1; index >= 0; index--) {
        const part = parts[index];
        if (part != undefined) {
          steps.push({ type: part, isLeave: false });
        }
      }
    }

    return false;
  }

  private readonly heldParts(type: Type): Type[] {
    switch (type.kind) {
      case TypeKind.Instance:
        return this.heldFields(type);
      case TypeKind.Array:
        return [type.item];
      case TypeKind.Result:
        return [type.value, type.error];
      case TypeKind.Dict:
        return [type.value];
      case TypeKind.Object:
        return type.fields.map((field) => this.objects.fieldWanted(field));
      case TypeKind.Union:
        return type.parts;
      default:
        return [];
    }
  }

  private readonly heldFields(instance: InstanceType): Type[] {
    const types: Type[] = [];
    let current: Type | undefined = instance;

    while (current != undefined && current.kind == TypeKind.Instance) {
      if (this.isDeclaredLibrary(current.module, current.loc)) {
        return types;
      }

      const decl = this.record(current.module)?.classes.get(current.loc);
      if (decl == undefined) {
        return types;
      }

      for (const field of decl.fields) {
        const isValue =
          field.form != FieldKind.Static && field.form != FieldKind.ArrowMethod;
        const entry = this.classMember(instance, field.name).entry;
        if (isValue && entry != undefined) {
          types.push(this.fieldTypeOf(entry, field));
        }
      }

      current = this.types.baseClassOf(current);
    }

    return types;
  }
}
