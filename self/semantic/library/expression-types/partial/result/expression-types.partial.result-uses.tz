import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";

partial class ExpressionTypes {
  private readonly unreadResultsCheck(module: int): void {
    const record = this.records.get(module);
    if (record == undefined || this.resultsChecked.has(module)) {
      return;
    }

    this.resultsChecked.add(module);

    const reads = this.results.readLocs(record);

    for (const [loc, variable] of record.variables) {
      const door = this.doors.get(`${module} ${loc}`);
      const isSkipped =
        door == undefined || reads.has(loc) || variable.loop != undefined;
      if (isSkipped || door == undefined) {
        continue;
      }

      const code = this.results.resultHoldCode(door.type);
      if (code != undefined) {
        this.report(module, loc, code, { word: variable.decl.name });
      }
    }
  }
}
