import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  CallExpr,
  NameExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  ResultType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  TypeContext,
  TypePlace,
} from "../../../../types/type-resolver/types/type-resolver.types.tz";
import { kNoPlace } from "../../../../code/expression-types/const/expression-types.const.tz";

partial class ExpressionTypes {
  private readonly isResultMakerCall(callee: NameExpr, module: int): boolean {
    const isMaker = callee.name == "ok" || callee.name == "err";

    return isMaker && this.isGlobalUse(callee, module);
  }

  private resultMakerCall(
    expr: CallExpr,
    callee: NameExpr,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const error = this.types.store.plain(TypeKind.Error);
    if (tree.argumentsOf(expr.argsList).some((arg) => arg.spread)) {
      const args = tree.argumentsOf(expr.argsList);

      this.looseArguments(args, module);

      return error;
    }

    const count = tree.argumentsOf(expr.argsList).length;
    if (count > 1) {
      this.errors.write(module, callee.loc, Code.ArgumentCount, {
        word: this.types.argumentCountText(0, 1, false),
        other: `${count}`,
      });

      return error;
    }

    const typeArgs = tree.typeRefsOf(callee.typeArgsList);
    if (typeArgs.length == 0) {
      const goal = this.types.resultGoal(wanted);

      return this.halfValueTyped(expr, callee, goal, false, module);
    }
    if (typeArgs.length != 2) {
      this.errors.write(module, callee.loc, Code.OkErrTypeArgs, {
        word: callee.name,
      });

      return error;
    }

    const written = this.writtenResult(callee, module);
    if (written == undefined) {
      return error;
    }

    return this.halfValueTyped(expr, callee, written, true, module);
  }

  private writtenResult(callee: NameExpr, module: int): ResultType | undefined {
    const tree = this.types.program.tree;

    const context: TypeContext = {
      module,
      bindings: new Map<int, Type>(),
      place: TypePlace.Plain,
    };
    const types = tree.typeRefsOf(callee.typeArgsList).map((ref) =>
      this.types.resolve(ref, context),
    );
    const value = types[0];
    const failure = types[1];
    if (value == undefined || failure == undefined) {
      return undefined;
    }
    if (value.kind == TypeKind.Error || failure.kind == TypeKind.Error) {
      return undefined;
    }

    const made = this.types.store.resultOf(value, failure);
    if (made.kind != TypeKind.Result) {
      return undefined;
    }

    return made;
  }

  private halfValueTyped(
    expr: CallExpr,
    callee: NameExpr,
    goal: ResultType | undefined,
    isWritten: boolean,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const isOk = callee.name == "ok";
    const arg = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (arg == undefined) {
      return this.types.madeResult(
        isOk,
        this.types.store.plain(TypeKind.Void),
        goal,
      );
    }

    const half = this.types.goalHalf(goal, isOk);
    const isHinted =
      half != undefined &&
      half.kind != TypeKind.Never &&
      half.kind != TypeKind.Void;
    const hint = this.types.halfHint(isHinted, half);
    const given = this.typed(arg, hint, module);
    if (given.kind == TypeKind.Void) {
      this.errors.write(module, arg.loc, Code.OkErrVoidValue, {
        word: callee.name,
      });

      return this.types.store.plain(TypeKind.Error);
    }
    if (given.kind == TypeKind.Error) {
      return given;
    }
    if (half != undefined && isHinted && this.types.converts(given, half)) {
      return this.types.madeResult(isOk, half, goal);
    }
    if (half != undefined && isWritten) {
      this.coerce(arg, given, half, module, kNoPlace);

      return this.types.madeResult(isOk, half, goal);
    }

    return this.types.madeResult(isOk, given, goal);
  }
}
