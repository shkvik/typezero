import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { messageText } from "../../../../../diagnostic/message.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  ResultType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { kUnsupportedMark } from "../../../../code/expression-types/const/expression-types.const.tz";
import { kResultMethods } from "../../../result-rules/const/result-rules.const.tz";

partial class ExpressionTypes {
  private resultFacts(
    call: CallExpr,
    callee: MemberExpr,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> {
    const tree = this.types.program.tree;

    const facts = new Map<string, Type>();
    const object = tree.exprOf(callee.objectId);
    const isTest = callee.name == "isOk" || callee.name == "isErr";
    if (!isTest || object.kind != ExprKind.Name) {
      return facts;
    }

    const slot = this.narrowable(object, module);
    if (slot == undefined) {
      return facts;
    }

    const base = this.types.definedType(slot.type);
    if (base.kind != TypeKind.Result) {
      return facts;
    }

    const never = this.types.store.plain(TypeKind.Never);
    const isOk = (callee.name == "isOk") == isTrue;
    if (isOk) {
      facts.set(
        slot.key,
        this.types.store.resultOf(this.types.store.valueOf(base), never),
      );

      return facts;
    }

    facts.set(
      slot.key,
      this.types.store.resultOf(never, this.types.store.errorOf(base)),
    );

    return facts;
  }

  private resultMemberRead(
    expr: MemberExpr,
    result: ResultType,
    module: int,
  ): Type {
    const checked = this.types.resultMemberRead(expr, result);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private resultMethodCall(
    expr: CallExpr,
    member: MemberExpr,
    result: ResultType,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const error = this.types.store.plain(TypeKind.Error);
    if (tree.argumentsOf(expr.argsList).some((arg) => arg.spread)) {
      const args = tree.argumentsOf(expr.argsList);

      this.looseArguments(args, module);

      return error;
    }

    const name = member.name;
    const method = kResultMethods.find((one) => one.name == name);
    if (method == undefined) {
      this.errors.write(module, member.loc, Code.PropertyMissing, {
        word: name,
        first: this.types.typeText(result),
      });
      const argsItem = tree.argumentsOf(expr.argsList);

      this.looseArguments(argsItem, module);

      return error;
    }

    const count = tree.argumentsOf(expr.argsList).length;
    if (count != method.count) {
      const word = this.types.argumentCountText(
        method.count,
        method.count,
        false,
      );

      this.errors.write(module, member.loc, Code.ArgumentCount, {
        word,
        other: `${count}`,
      });

      return error;
    }

    return this.resultMethodTyped(expr, member, result, wanted, module);
  }

  private resultMethodTyped(
    expr: CallExpr,
    member: MemberExpr,
    result: ResultType,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const name = member.name;
    const first = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (name == "isOk" || name == "isErr" || first == undefined) {
      return this.types.store.plain(TypeKind.Boolean);
    }
    if (name == "unwrapOr") {
      return this.unwrapOrTyped(first, result, module);
    }
    if (name == "match") {
      return this.matchTyped(expr, member, result, wanted, module);
    }

    const isOnError = name == "mapErr" || name == "orElse" || name == "orTee";
    const half = this.types.resultHalf(result, isOnError);
    const isTee = name == "andTee" || name == "orTee";
    const hint = this.types.resultCallbackHint(name, wanted, isOnError);
    const returned = this.resultCallback(
      first,
      half,
      hint,
      isTee,
      name,
      module,
    );
    if (returned == undefined || returned.kind == TypeKind.Error) {
      return this.types.store.plain(TypeKind.Error);
    }

    return this.resultCallTyped(name, first, result, returned, module);
  }

  private resultCallback(
    arg: Expr,
    half: Type,
    hint: Type | undefined,
    isTee: boolean,
    name: string,
    module: int,
  ): Type | undefined {
    const isFunction = arg.kind == ExprKind.Function;
    const params = [{ type: this.types.halfParam(half), optional: false }];
    const result = this.types.callbackResult(isFunction, hint, isTee);
    const wanted = this.types.store.functionOf({ params, rest: false, result });
    const typed = this.typed(arg, wanted, module);
    if (typed.kind == TypeKind.Function) {
      return this.types.store.returnTypeOf(typed);
    }
    if (typed.kind != TypeKind.Error) {
      this.errors.write(module, arg.loc, Code.ResultNeedsFunction, {
        word: name,
        first: this.types.typeText(typed),
      });
    }

    return undefined;
  }

  private resultCallTyped(
    name: string,
    arg: Expr,
    result: ResultType,
    returned: Type,
    module: int,
  ): Type {
    switch (name) {
      case "map":
        return this.types.store.resultOf(
          returned,
          this.types.store.errorOf(result),
        );
      case "mapErr":
        return this.types.store.resultOf(
          this.types.store.valueOf(result),
          returned,
        );
      case "andThen":
      case "andThrough":
        return this.chainedTyped(name, arg, result, returned, module);
      case "orElse":
        return this.orElseTyped(arg, result, returned, module);
      default:
        return result;
    }
  }

  private chainedTyped(
    name: string,
    arg: Expr,
    result: ResultType,
    returned: Type,
    module: int,
  ): Type {
    const next = this.types.definedType(returned);
    if (next.kind != TypeKind.Result) {
      return this.notResultReport(name, arg, returned, module);
    }

    const common = this.resultHalfJoin(
      this.types.store.errorOf(result),
      this.types.store.errorOf(next),
    );
    if (common == undefined) {
      this.errors.write(module, arg.loc, Code.ResultErrorsNoUnion, {
        first: this.types.typeText(this.types.store.errorOf(result)),
        word: name,
        second: this.types.typeText(this.types.store.errorOf(next)),
        other: this.resultUnionWhy(
          this.types.store.errorOf(result),
          this.types.store.errorOf(next),
        ),
      });

      return this.types.store.plain(TypeKind.Error);
    }
    if (name == "andThen") {
      return this.types.store.resultOf(this.types.store.valueOf(next), common);
    }

    return this.types.store.resultOf(this.types.store.valueOf(result), common);
  }

  private orElseTyped(
    arg: Expr,
    result: ResultType,
    returned: Type,
    module: int,
  ): Type {
    const next = this.types.definedType(returned);
    if (next.kind != TypeKind.Result) {
      return this.notResultReport("orElse", arg, returned, module);
    }

    const common = this.resultHalfJoin(
      this.types.store.valueOf(result),
      this.types.store.valueOf(next),
    );
    if (common == undefined) {
      this.errors.write(module, arg.loc, Code.ResultValuesNoUnion, {
        first: this.types.typeText(this.types.store.valueOf(result)),
        second: this.types.typeText(this.types.store.valueOf(next)),
        other: this.resultUnionWhy(
          this.types.store.valueOf(result),
          this.types.store.valueOf(next),
        ),
      });

      return this.types.store.plain(TypeKind.Error);
    }

    return this.types.store.resultOf(common, this.types.store.errorOf(next));
  }

  private notResultReport(
    name: string,
    arg: Expr,
    returned: Type,
    module: int,
  ): Type {
    const checked = this.types.notResultReport(name, arg, returned);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private resultHalfJoin(first: Type, second: Type): Type | undefined {
    if (first.id == second.id || second.kind == TypeKind.Never) {
      return first;
    }
    if (first.kind == TypeKind.Never) {
      return second;
    }
    if (first.kind == TypeKind.Void || second.kind == TypeKind.Void) {
      return undefined;
    }

    const joined = this.types.unionUnify(first, second);
    if (joined == undefined || joined.kind == TypeKind.Error) {
      return undefined;
    }
    if (this.types.unionProblem(joined) != undefined) {
      return undefined;
    }

    return joined;
  }

  private resultUnionWhy(first: Type, second: Type): string {
    if (first.kind == TypeKind.Void || second.kind == TypeKind.Void) {
      return ": one of them is nothing, 'ok()'";
    }

    const both = this.types.store.unionOf([first, second]);
    const problem = this.types.unionProblem(both);
    if (problem == undefined) {
      return "";
    }

    const full = messageText(problem.code, problem.details);
    const mark = full.indexOf(kUnsupportedMark);

    return `: ${full.slice(mark + kUnsupportedMark.length)}`;
  }

  private unwrapOrTyped(arg: Expr, result: ResultType, module: int): Type {
    const value = this.types.store.valueOf(result);
    const isGiving =
      value.kind != TypeKind.Never && value.kind != TypeKind.Void;
    const hint = this.types.givingHint(isGiving, value);
    const other = this.typed(arg, hint, module);
    if (other.kind == TypeKind.Error) {
      return other;
    }

    const joined = this.types.unwrapJoin(value, other);
    if (joined == undefined) {
      this.errors.write(module, arg.loc, Code.ResultUnwrapOrTypes, {
        first: this.types.typeText(value),
        second: this.types.typeText(other),
      });

      return this.types.store.plain(TypeKind.Error);
    }

    return joined;
  }

  private matchTyped(
    expr: CallExpr,
    member: MemberExpr,
    result: ResultType,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const onOk = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    const onErr = tree.exprAt(tree.argumentsOf(expr.argsList)[1]?.exprId);
    if (onOk == undefined || onErr == undefined) {
      return this.types.store.plain(TypeKind.Error);
    }

    const goal = this.types.resultWanted(wanted);
    const both = this.types.matchGoal(goal);
    const first = this.resultCallback(
      onOk,
      this.types.store.valueOf(result),
      both,
      false,
      "match",
      module,
    );
    const second = this.resultCallback(
      onErr,
      this.types.store.errorOf(result),
      both,
      false,
      "match",
      module,
    );
    if (first == undefined || second == undefined) {
      return this.types.store.plain(TypeKind.Error);
    }
    if (first.kind == TypeKind.Error || second.kind == TypeKind.Error) {
      return this.types.store.plain(TypeKind.Error);
    }

    return this.matchJoined(member, first, second, module);
  }

  private matchJoined(
    member: MemberExpr,
    first: Type,
    second: Type,
    module: int,
  ): Type {
    const checked = this.types.matchJoined(member, first, second);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }
}
