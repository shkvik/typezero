import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  ArrayLitExpr,
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  ResultType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { kResultName } from "../../../../code/expression-types/const/expression-types.const.tz";
import { CombineDraft } from "../../../../code/expression-types/types/expression-types.types.tz";

partial class ExpressionTypes {
  private resultStaticCall(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const object = tree.exprOf(member.objectId);
    const isResult =
      object.kind == ExprKind.Name &&
      object.name == kResultName &&
      !expr.optional &&
      !member.optional &&
      this.isGlobalUse(object, module);
    if (!isResult) {
      return undefined;
    }

    const error = this.types.store.plain(TypeKind.Error);
    const name = member.name;
    const isCombine = name == "combine" || name == "combineWithAllErrors";
    if (!isCombine) {
      this.errors.write(module, member.loc, Code.ResultStaticMissing, {
        word: kResultName,
        other: name,
      });
      const args = tree.argumentsOf(expr.argsList);

      this.looseArguments(args, module);

      return error;
    }
    if (tree.argumentsOf(expr.argsList).some((arg) => arg.spread)) {
      const argsItem = tree.argumentsOf(expr.argsList);

      this.looseArguments(argsItem, module);

      return error;
    }

    const arg = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (arg == undefined || tree.argumentsOf(expr.argsList).length != 1) {
      this.errors.write(module, member.loc, Code.ArgumentCount, {
        word: this.types.argumentCountText(1, 1, false),
        other: `${tree.argumentsOf(expr.argsList).length}`,
      });

      return error;
    }

    const draft: CombineDraft = {
      what: `${kResultName}.${name}`,
      isAll: name == "combineWithAllErrors",
    };
    if (arg.kind == ExprKind.ArrayLit && this.types.isPlainList(arg)) {
      return this.combinedList(arg, draft, module);
    }

    return this.combinedArray(arg, draft, module);
  }

  private resultSearchCheck(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const name = member.name;
    const isSearch =
      name == "includes" || name == "indexOf" || name == "lastIndexOf";
    if (!isSearch) {
      return false;
    }

    const objectExpr = tree.exprOf(member.objectId);
    const object = this.peekType(objectExpr, module);

    const base = this.types.definedType(object);
    if (
      base.kind != TypeKind.Array ||
      !this.types.holdsResults(this.types.store.itemOf(base))
    ) {
      return false;
    }

    this.errors.write(module, member.loc, Code.ArraySearchResults, {
      word: name,
    });
    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args, module);

    return true;
  }

  private combinedList(
    literal: ArrayLitExpr,
    draft: CombineDraft,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const error = this.types.store.plain(TypeKind.Error);
    const results: ResultType[] = [];
    const types = tree.elementsOf(literal.elementsList).map((element) =>
      this.typed(tree.exprOf(element.exprId), undefined, module),
    );
    if (types.some((type) => type.kind == TypeKind.Error)) {
      return error;
    }

    for (let index = 0; index < types.length; index++) {
      const type = types[index];
      const element = tree.elementsOf(literal.elementsList)[index];
      if (type == undefined || element == undefined) {
        return error;
      }

      const defined = this.types.definedType(type);
      if (defined.kind != TypeKind.Result) {
        this.errors.write(
          module,
          tree.exprOf(element.exprId).loc,
          Code.ResultCombineNotResult,
          {
            word: draft.what,
            first: this.types.typeText(type),
          },
        );

        return error;
      }

      results.push(defined);
    }

    const common = this.combinedCommon(results);
    if (common != undefined) {
      return this.sameCombined(literal, common, draft, module);
    }

    return this.tupleCombined(literal, results, draft, module);
  }

  private combinedCommon(results: Read<ResultType[]>): ResultType | undefined {
    let common = results[0];

    for (const result of results) {
      if (common == undefined) {
        return undefined;
      }

      common = this.sameValues(common, result);
    }

    return common;
  }

  private sameValues(
    first: ResultType,
    second: ResultType,
  ): ResultType | undefined {
    const value = this.types.joinedValue(
      this.types.store.valueOf(first),
      this.types.store.valueOf(second),
    );
    const error = this.resultHalfJoin(
      this.types.store.errorOf(first),
      this.types.store.errorOf(second),
    );
    if (value == undefined || error == undefined) {
      return undefined;
    }

    const made = this.types.store.resultOf(value, error);
    if (made.kind != TypeKind.Result) {
      return undefined;
    }

    return made;
  }

  private sameCombined(
    literal: ArrayLitExpr,
    common: ResultType,
    draft: CombineDraft,
    module: int,
  ): Type {
    const checked = this.types.sameCombined(literal, common, draft);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private tupleCombined(
    literal: ArrayLitExpr,
    results: Read<ResultType[]>,
    draft: CombineDraft,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const values: Type[] = [];
    let error: Type = this.types.store.plain(TypeKind.Never);

    for (let index = 0; index < results.length; index++) {
      const result = results[index];
      const element = tree.elementsOf(literal.elementsList)[index];
      if (result == undefined || element == undefined) {
        return this.types.store.plain(TypeKind.Error);
      }
      if (!this.types.isHoldingValues(draft, result)) {
        const noValuesError = this.types.noValuesError(
          draft,
          result,
          tree.exprOf(element.exprId),
        );

        this.errors.writeFound(module, noValuesError);

        return this.types.store.plain(TypeKind.Error);
      }

      values.push(this.types.store.valueOf(result));

      const joined = this.resultHalfJoin(
        error,
        this.types.store.errorOf(result),
      );
      if (joined == undefined) {
        this.errors.write(
          module,
          tree.exprOf(element.exprId).loc,
          Code.ResultCombineNoUnion,
          {
            word: draft.what,
            other: this.resultUnionWhy(error, this.types.store.errorOf(result)),
          },
        );

        return this.types.store.plain(TypeKind.Error);
      }

      error = joined;
    }

    const tuple = this.types.store.plainTuple(values);

    return this.types.store.resultOf(
      tuple,
      this.types.combinedErrors(draft, error),
    );
  }

  private combinedArray(arg: Expr, draft: CombineDraft, module: int): Type {
    const error = this.types.store.plain(TypeKind.Error);
    const type = this.typed(arg, undefined, module);
    if (type.kind == TypeKind.Error) {
      return type;
    }

    const base = this.types.definedType(type);
    const item = this.types.arrayResultItem(base);
    if (item == undefined) {
      this.errors.write(module, arg.loc, Code.ResultCombineNotArray, {
        word: draft.what,
        first: this.types.typeText(type),
      });

      return error;
    }
    if (!this.types.isHoldingValues(draft, item)) {
      const noValuesError = this.types.noValuesError(draft, item, arg);

      this.errors.writeFound(module, noValuesError);

      return error;
    }

    const values = this.types.store.arrayOf(this.types.store.valueOf(item));

    return this.types.store.resultOf(
      values,
      this.types.combinedErrors(draft, this.types.store.errorOf(item)),
    );
  }
}
