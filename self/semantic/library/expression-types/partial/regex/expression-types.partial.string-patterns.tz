import { Code } from "../../../../../diagnostic/code.tz";
import { SourceError } from "../../../../../diagnostic/types/message.types.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { Param } from "../../../../../program/ast/types/ast.types.functions.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import { RegexShape } from "../../../regex-parser/types/regex-parser.types.tz";
import {
  kMatchAllName,
  kMatchName,
  kReplaceAllName,
  kSearchName,
  kSplitName,
} from "../../../regex-rules/const/regex-rules.const.tz";

partial class ExpressionTypes {
  private stringPatternCall(
    expr: CallExpr,
    member: MemberExpr,
    object: Type,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const method = member.name;
    const receiver = this.types.definedType(object);
    const isBareSplit =
      method == kSplitName && tree.argumentsOf(expr.argsList).length == 0;
    const hasSpread = tree.argumentsOf(expr.argsList).some((arg) => arg.spread);
    const isPattern =
      this.types.isRegexText(receiver) && this.types.isPatternMethod(method);
    if (!isPattern || isBareSplit || hasSpread) {
      return undefined;
    }

    const count = tree.argumentsOf(expr.argsList).length;
    const least = this.types.regexLeastArguments(method);
    const most = this.types.mostArguments(method);
    const pattern = tree.argumentsOf(expr.argsList)[0];
    if (count < least || count > most || pattern == undefined) {
      const word = this.types.argumentCountText(least, most, false);

      this.errors.write(module, member.loc, Code.ArgumentCount, {
        word,
        other: `${count}`,
      });
      const args = tree.argumentsOf(expr.argsList);

      this.looseArguments(args, module);

      return this.types.store.plain(TypeKind.Error);
    }

    const exprExpr = tree.exprOf(pattern.exprId);
    const given = this.typed(exprExpr, undefined, module);

    return this.patternGivenCall(expr, member, given, module);
  }

  private patternGivenCall(
    expr: CallExpr,
    member: MemberExpr,
    given: Type,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    if (given.kind == TypeKind.Error) {
      return this.patternRestLoosely(expr, module);
    }
    if (this.types.isRegexRegExp(given)) {
      return this.regexPatternCall(expr, member, module);
    }
    if (this.types.isRegexText(given)) {
      return this.textPatternCall(expr, member, module);
    }

    const pattern =
      tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId) ?? member;
    const notPattern = this.types.notPatternError(
      pattern.loc,
      member.name,
      given,
    );

    this.errors.writeFound(module, notPattern);

    return this.patternRestLoosely(expr, module);
  }

  private patternRestLoosely(expr: CallExpr, module: int): Type {
    const tree = this.types.program.tree;

    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args.slice(1), module);

    return this.types.store.plain(TypeKind.Error);
  }

  private regexPatternCall(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const method = member.name;
    const pattern =
      tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId) ?? member;
    const shape = this.knownRegex(pattern, module);
    if (method == kMatchName) {
      return this.regexMatchCall(member, shape, module);
    }

    const isNeedingGlobal =
      method == kMatchAllName || method == kReplaceAllName;
    const isMissing = shape != undefined && !this.types.isGlobal(shape);
    if (isNeedingGlobal && isMissing && shape != undefined) {
      const needsGlobal = this.types.needsGlobalError(
        pattern.loc,
        method,
        shape,
      );

      this.errors.writeFound(module, needsGlobal);

      return this.patternRestLoosely(expr, module);
    }

    switch (method) {
      case kMatchAllName:
        return this.allMatches();
      case kSearchName:
        return this.types.store.integer(64, false);
      case kSplitName:
        this.splitLimitCheck(expr, module);

        return this.types.splitType(shape);
      default:
        return this.regexReplaceCall(expr, member, shape, module);
    }
  }

  private regexMatchCall(
    member: MemberExpr,
    shape: Read<RegexShape | undefined>,
    module: int,
  ): Type {
    if (shape == undefined) {
      this.errors.writeFound(module, this.types.matchFlagError(member.loc));

      return this.types.store.plain(TypeKind.Error);
    }
    if (this.types.isGlobal(shape)) {
      const text = this.types.store.plain(TypeKind.String);

      return this.types.optional(this.types.store.arrayOf(text));
    }

    return this.foundMatch();
  }

  private splitLimitCheck(expr: CallExpr, module: int): void {
    const tree = this.types.program.tree;

    const limit = tree.argumentsOf(expr.argsList)[1];
    if (limit != undefined) {
      this.checked(
        tree.exprOf(limit.exprId),
        this.types.store.integer(64, false),
        module,
        "",
      );
    }
  }

  private regexReplaceCall(
    expr: CallExpr,
    member: MemberExpr,
    shape: Read<RegexShape | undefined>,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const replacement = tree.argumentsOf(expr.argsList)[1];
    const text = this.types.store.plain(TypeKind.String);
    if (replacement == undefined) {
      return text;
    }

    const value = tree.exprOf(replacement.exprId);
    if (this.isFunctionReplacement(value, module)) {
      return this.functionReplaceCall(value, member, shape, module);
    }

    this.checked(value, text, module, "");

    if (shape != undefined && value.kind == ExprKind.StringLit) {
      const groupError = this.types.groupReferenceError(
        value.loc,
        shape,
        value.value,
      );

      this.errors.writeFound(module, groupError);
    }

    return text;
  }

  private isFunctionReplacement(value: Expr, module: int): boolean {
    if (value.kind == ExprKind.Function) {
      return true;
    }
    if (value.kind != ExprKind.Name) {
      return false;
    }

    const target = this.targetOfName(value, module);
    if (target == undefined) {
      return false;
    }
    if (target.kind == SymbolKind.Function) {
      return true;
    }
    if (target.kind != SymbolKind.Variable) {
      return false;
    }

    const given = this.peekType(value, module);

    return this.types.definedType(given).kind == TypeKind.Function;
  }

  private functionReplaceCall(
    value: Expr,
    member: MemberExpr,
    shape: Read<RegexShape | undefined>,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const params = this.types.replacerParams(shape);
    const text = this.types.store.plain(TypeKind.String);
    const written = this.closureParams(value);
    if (written.length > params.length) {
      const extraError = this.extraParamsError(member, shape, written, params);

      this.errors.writeFound(module, extraError);
    }

    while (params.length < written.length) {
      params.push(text);
    }

    const replacer = this.types.replacerType(params);
    const peeked = this.peekType(value, module);
    const isAsyncClosure =
      value.kind == ExprKind.Function && tree.functionOf(value.fnId).isAsync;
    const isAsync =
      isAsyncClosure ||
      (peeked.kind == TypeKind.Function &&
        this.types.store.returnTypeOf(peeked).kind == TypeKind.Promise);
    if (isAsync) {
      this.errors.write(module, value.loc, Code.CallbackAsyncReplace, {
        word: member.name,
        first: "string",
      });

      return this.types.store.plain(TypeKind.Error);
    }

    const given = this.checked(value, replacer, module, "");
    if (this.types.definedType(given).kind != TypeKind.Function) {
      return this.types.store.plain(TypeKind.Error);
    }

    return text;
  }

  private readonly closureParams(value: Expr): Param[] {
    const tree = this.types.program.tree;

    if (value.kind != ExprKind.Function) {
      return [];
    }

    const fn = tree.functionOf(value.fnId);

    return tree.paramsOf(fn.paramsList);
  }

  private readonly extraParamsError(
    member: MemberExpr,
    shape: Read<RegexShape | undefined>,
    written: Read<Param[]>,
    params: Read<Type[]>,
  ): SourceError | undefined {
    if (shape == undefined) {
      const second = written[1];
      if (second == undefined) {
        return undefined;
      }

      return this.types.onlyMatchError(second.loc);
    }

    const count = params.length;
    const extra = written[count];
    if (extra == undefined) {
      return undefined;
    }

    return this.types.passesError(extra.loc, member.name, count, shape);
  }

  private textPatternCall(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const method = member.name;
    const pattern =
      tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId) ?? member;
    if (method == kSplitName) {
      this.splitLimitCheck(expr, module);

      return this.types.textsType();
    }
    if (method != kReplaceAllName) {
      const textError = this.types.textPatternError(
        member.loc,
        method,
        pattern,
      );

      this.errors.writeFound(module, textError);

      return this.patternRestLoosely(expr, module);
    }

    const replacement =
      tree.exprAt(tree.argumentsOf(expr.argsList)[1]?.exprId) ?? member;
    if (replacement.kind == ExprKind.Function) {
      const functionError = this.types.functionTextError(
        replacement.loc,
        pattern,
      );

      this.errors.writeFound(module, functionError);

      return this.patternRestLoosely(expr, module);
    }

    const text = this.types.store.plain(TypeKind.String);

    this.checked(replacement, text, module, "");

    return text;
  }
}
