import { Code } from "../../../../../diagnostic/code.tz";
import {
  CallArgument,
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  NameExpr,
  NewExpr,
  NewKind,
  RegexLitExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import {
  InstanceType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import {
  RegexShape,
  RegexText,
} from "../../../regex-parser/types/regex-parser.types.tz";
import {
  kCompileName,
  kEscapeName,
  kExecName,
  kRegExpName,
  kTestName,
} from "../../../regex-rules/const/regex-rules.const.tz";

partial class ExpressionTypes {
  private regexLiteralTyped(expr: RegexLitExpr, module: int): Type {
    const flags = expr.flags;
    if (!this.types.isFlagsValid(flags)) {
      const loc = expr.loc + expr.written - flags.length;

      this.errors.writeFound(module, this.types.flagsError(loc, flags));

      return this.regExpType();
    }

    const written: RegexText = { pattern: expr.pattern, flags };

    this.syntaxCheck(written, expr.loc, true, module);

    return this.regExpType();
  }

  private syntaxCheck(
    written: RegexText,
    loc: int,
    isWritten: boolean,
    module: int,
  ): void {
    const error = this.types.syntaxError(written, loc, isWritten);
    if (error != undefined) {
      this.errors.writeFound(module, error);
    }
  }

  private regExpType(): Type {
    const made = this.types.libraryInstance(kRegExpName, []);

    return made ?? this.types.store.plain(TypeKind.Error);
  }

  private readonly knownRegex(expr: Expr, module: int): RegexShape | undefined {
    const written = this.regexTextOf(expr, module);
    if (written == undefined) {
      return undefined;
    }

    return this.types.shapeOf(written);
  }

  private readonly regexTextOf(expr: Expr, module: int): RegexText | undefined {
    switch (expr.kind) {
      case ExprKind.RegexLit:
        return { pattern: expr.pattern, flags: expr.flags };
      case ExprKind.New:
        return this.madeRegexText(expr, module);
      case ExprKind.Name:
        return this.heldRegexText(expr, module);
      default:
        return undefined;
    }
  }

  private readonly madeRegexText(
    expr: NewExpr,
    module: int,
  ): RegexText | undefined {
    const tree = this.types.program.tree;

    if (!this.isRegExpNew(expr, module)) {
      return undefined;
    }

    const args = tree.argumentsOf(expr.argsList);

    return this.constantRegexText(args);
  }

  private readonly isRegExpNew(expr: NewExpr, module: int): boolean {
    const form = expr.form;
    const isNamed =
      form.kind == NewKind.Named &&
      form.member == undefined &&
      form.name == kRegExpName;
    if (!isNamed) {
      return false;
    }

    const target = this.targetOfUse(expr.loc, kRegExpName, module);

    return (
      target != undefined &&
      target.kind == SymbolKind.Class &&
      this.types.isLibraryModule(target.module)
    );
  }

  private readonly heldRegexText(
    expr: NameExpr,
    module: int,
  ): RegexText | undefined {
    const tree = this.types.program.tree;

    const target = this.targetOfName(expr, module);
    if (target == undefined || target.kind != SymbolKind.Variable) {
      return undefined;
    }

    const record = this.record(target.module);
    const variable = record?.variables.get(target.loc);
    const init = tree.exprAt(variable?.decl.initId);
    if (record == undefined || variable == undefined || init == undefined) {
      return undefined;
    }
    if (!variable.isConst && record.assigned.has(target.loc)) {
      return undefined;
    }
    if (init.kind == ExprKind.Name) {
      return undefined;
    }

    return this.regexTextOf(init, target.module);
  }

  private readonly constantRegexText(
    args: Read<CallArgument[]>,
  ): RegexText | undefined {
    const tree = this.types.program.tree;

    const first = args[0];
    if (first == undefined || args.length > 2) {
      return undefined;
    }

    const expr = tree.exprOf(first.exprId);
    const pattern = this.constantText(expr);
    const second = args[1];
    if (pattern == undefined) {
      return undefined;
    }
    if (second == undefined) {
      return { pattern, flags: "" };
    }

    const exprExpr = tree.exprOf(second.exprId);
    const flags = this.constantText(exprExpr);
    if (flags == undefined) {
      return undefined;
    }

    return { pattern, flags };
  }

  private readonly constantText(expr: Expr): string | undefined {
    const tree = this.types.program.tree;

    if (expr.kind == ExprKind.StringLit) {
      return expr.value;
    }
    if (
      expr.kind == ExprKind.Template &&
      tree.exprsOf(expr.exprsList).length == 0
    ) {
      return tree.textsOf(expr.quasisList)[0];
    }

    return undefined;
  }

  private readonly isRegExpName(expr: Expr, module: int): boolean {
    if (expr.kind != ExprKind.Name || expr.name != kRegExpName) {
      return false;
    }

    return this.isGlobalUse(expr, module);
  }

  private regexMethodCall(
    expr: CallExpr,
    member: MemberExpr,
    instance: InstanceType,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const hasSpread = tree.argumentsOf(expr.argsList).some((arg) => arg.spread);
    if (!this.types.isRegexRegExp(instance) || hasSpread) {
      return undefined;
    }

    switch (member.name) {
      case kCompileName:
        this.errors.writeFound(module, this.types.compileError(member.loc));
        const args = tree.argumentsOf(expr.argsList);

        this.looseArguments(args, module);

        return this.types.store.plain(TypeKind.Error);
      case kTestName:
      case kExecName:
        return this.regexRunCall(expr, member, module);
      default:
        return undefined;
    }
  }

  private regexRunCall(expr: CallExpr, member: MemberExpr, module: int): Type {
    const tree = this.types.program.tree;

    const count = tree.argumentsOf(expr.argsList).length;
    const text = tree.argumentsOf(expr.argsList)[0];
    if (count != 1 || text == undefined) {
      const word = this.types.argumentCountText(1, 1, false);

      this.errors.write(module, member.loc, Code.ArgumentCount, {
        word,
        other: `${count}`,
      });
      const args = tree.argumentsOf(expr.argsList);

      this.looseArguments(args, module);

      return this.types.store.plain(TypeKind.Error);
    }

    this.checked(
      tree.exprOf(text.exprId),
      this.types.store.plain(TypeKind.String),
      module,
      "",
    );

    if (member.name == kExecName) {
      return this.foundMatch();
    }

    const object = tree.exprOf(member.objectId);
    const shape = this.knownRegex(object, module);
    if (shape != undefined && this.types.isGlobal(shape)) {
      this.errors.writeFound(module, this.types.testGlobalError(member.loc));

      return this.types.store.plain(TypeKind.Error);
    }

    return this.types.store.plain(TypeKind.Boolean);
  }

  private regexMemberRead(
    expr: MemberExpr,
    instance: InstanceType,
    module: int,
  ): Type | undefined {
    const isPlain =
      !this.types.isRegexRegExp(instance) || this.types.isField(expr.name);
    if (isPlain) {
      return undefined;
    }

    this.errors.writeFound(module, this.types.readError(expr.loc, expr.name));

    return this.types.store.plain(TypeKind.Error);
  }

  private regExpStaticRead(expr: MemberExpr, module: int): Type {
    this.errors.writeFound(
      module,
      this.types.regexStaticError(expr.loc, expr.name),
    );

    return this.types.store.plain(TypeKind.Error);
  }

  private regExpStaticCall(
    expr: CallExpr,
    member: MemberExpr,
    instance: InstanceType,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const isKnown = this.types.isKnownStatic(member.name);
    if (!this.types.isRegexRegExp(instance) || isKnown) {
      return undefined;
    }

    this.errors.writeFound(
      module,
      this.types.regexStaticError(member.loc, member.name),
    );
    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args, module);

    return this.types.store.plain(TypeKind.Error);
  }

  private regExpNew(expr: NewExpr, module: int): Type | undefined {
    const tree = this.types.program.tree;

    if (!this.isRegExpNew(expr, module)) {
      return undefined;
    }

    const args = tree.argumentsOf(expr.argsList);

    return this.regExpMade(expr.loc, args, module);
  }

  private regExpCalled(expr: CallExpr, module: int): Type | undefined {
    const tree = this.types.program.tree;

    const callee = tree.exprOf(expr.calleeId);
    if (!this.isRegExpName(callee, module)) {
      return undefined;
    }

    const args = tree.argumentsOf(expr.argsList);

    return this.regExpMade(callee.loc, args, module);
  }

  private regExpMade(loc: int, args: Read<CallArgument[]>, module: int): Type {
    const count = args.length;
    const pattern = args[0];
    if (count > 2 || pattern == undefined) {
      const word = this.types.argumentCountText(1, 2, false);

      this.errors.write(module, loc, Code.ArgumentCount, {
        word,
        other: `${count}`,
      });
      this.looseArguments(args, module);

      return this.types.store.plain(TypeKind.Error);
    }

    const constant = this.constantRegexText(args);
    if (constant != undefined) {
      const flags = constant.flags;
      if (!this.types.isFlagsValid(flags)) {
        this.errors.writeFound(module, this.types.flagsError(loc, flags));
      } else {
        this.syntaxCheck(constant, loc, false, module);
      }

      return this.regExpType();
    }

    return this.escapedRegExp(loc, pattern, args[1], module);
  }

  private escapedRegExp(
    loc: int,
    pattern: CallArgument,
    second: CallArgument | undefined,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const flags = this.flagsText(second);
    const expr = tree.exprOf(pattern.exprId);
    const isEscaped = this.isRegExpEscape(expr, module);
    if (!isEscaped || flags == undefined) {
      const hasFlags = second != undefined;

      this.errors.writeFound(module, this.types.unknownNewError(loc, hasFlags));
      this.looseArguments([pattern], module);
      this.looseSecond(second, module);

      return this.types.store.plain(TypeKind.Error);
    }
    if (second != undefined && !this.types.isFlagsValid(flags)) {
      const flagsError = this.types.flagsError(
        tree.exprOf(second.exprId).loc,
        flags,
      );

      this.errors.writeFound(module, flagsError);
      this.looseArguments([pattern, second], module);

      return this.types.store.plain(TypeKind.Error);
    }

    const text = this.types.store.plain(TypeKind.String);

    const exprExpr = tree.exprOf(pattern.exprId);

    this.checked(exprExpr, text, module, "");
    this.looseSecond(second, module);

    return this.regExpType();
  }

  private readonly flagsText(
    second: CallArgument | undefined,
  ): string | undefined {
    const tree = this.types.program.tree;

    if (second == undefined) {
      return "";
    }

    const expr = tree.exprOf(second.exprId);

    return this.constantText(expr);
  }

  private looseSecond(second: CallArgument | undefined, module: int): void {
    if (second != undefined) {
      this.looseArguments([second], module);
    }
  }

  private readonly isRegExpEscape(expr: Expr, module: int): boolean {
    const tree = this.types.program.tree;

    if (expr.kind != ExprKind.Call) {
      return false;
    }

    const callee = tree.exprOf(expr.calleeId);

    return (
      callee.kind == ExprKind.Member &&
      callee.name == kEscapeName &&
      this.isRegExpName(tree.exprOf(callee.objectId), module)
    );
  }
}
