import { kNoPlace } from "../../../../code/expression-types/const/expression-types.const.tz";
import {
  CallArgument,
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  NewExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  InstanceType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import { Linear } from "../../../../code/expression-types/types/expression-types.types.tz";
import { kZeroTerm } from "../../../../flow/bound-rules/const/bound-rules.const.tz";
import { ByteOwner } from "../../../byte-number-rules/types/byte-number-rules.types.tz";
import {
  kAllocName,
  kEndWhat,
  kFillName,
  kFromName,
  kMapName,
  kOffsetWhat,
  kPartNames,
  kSearchNames,
  kSetName,
  kSetOffsetWhat,
  kWithName,
} from "../../../byte-source-rules/const/byte-source-rules.const.tz";

partial class ExpressionTypes {
  private newSourceCheck(expr: NewExpr, made: Type, module: int): void {
    const tree = this.types.program.tree;

    const source = tree.argumentsOf(expr.argsList)[0];
    const hasSpread = tree.argumentsOf(expr.argsList).some((arg) => arg.spread);
    if (source == undefined || hasSpread) {
      return;
    }
    if (this.types.isLibraryModule(module)) {
      return;
    }
    if (this.types.ownerOf(made) == ByteOwner.DataView) {
      const exprExpr = tree.exprOf(source.exprId);

      return this.dataViewCheck(expr, exprExpr, module);
    }

    const name = this.types.typedName(made);
    const isLiteral = tree.exprOf(source.exprId).kind == ExprKind.ArrayLit;
    const element = this.types.elementOf(made);
    if (name == undefined || element == undefined) {
      return;
    }
    if (isLiteral && tree.argumentsOf(expr.argsList).length == 1) {
      const sourceExpr = tree.exprOf(source.exprId);

      this.byteValuesChecked(sourceExpr, made, module);

      return;
    }

    const from = this.peekType(tree.exprOf(source.exprId), module);
    const base = this.types.definedType(from);
    if (this.types.isArrayBuffer(from)) {
      return this.typedViewCheck(expr, made, module);
    }

    const offset = tree.argumentsOf(expr.argsList)[1];
    if (offset != undefined && base.kind != TypeKind.Error) {
      const offsetOnlyError = this.types.offsetOnlyError(
        tree.exprOf(offset.exprId).loc,
        name,
        from,
      );

      return this.errors.writeFound(module, offsetOnlyError);
    }

    const isLength =
      base.kind == TypeKind.Int ||
      base.kind == TypeKind.Double ||
      base.kind == TypeKind.Error;
    if (isLength) {
      return;
    }

    this.byteSourceCheck(tree.exprOf(source.exprId), from, made, module);
  }

  private byteSourceCheck(
    source: Expr,
    from: Type,
    target: Type,
    module: int,
  ): boolean {
    const shape = this.types.sourceShape(from);
    const name = this.types.typedName(target) ?? "";
    if (shape.element == undefined) {
      const notSourceError = this.types.notSourceError(
        source.loc,
        name,
        from,
      );

      this.errors.writeFound(module, notSourceError);

      return false;
    }

    const shown = this.types.valueText(source, module);
    const elementError = this.types.elementError(
      source.loc,
      target,
      from,
      shape,
      shown,
    );

    this.errors.writeFound(module, elementError);

    return elementError == undefined;
  }

  private bytesStaticCheck(
    expr: CallExpr,
    instance: InstanceType,
    member: MemberExpr,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    if (this.types.isLibraryModule(module)) {
      return;
    }

    const owner = this.types.ownerOf(instance);
    if (owner == ByteOwner.Buffer && member.name == kAllocName) {
      return this.allocFillCheck(expr, module);
    }
    if (owner == ByteOwner.Buffer || member.name != kFromName) {
      return;
    }
    if (this.types.typedName(instance) == undefined) {
      return;
    }

    const source = tree.argumentsOf(expr.argsList)[0];
    const element = this.types.elementOf(instance);
    if (source == undefined || source.spread || element == undefined) {
      return;
    }
    if (
      tree.exprOf(source.exprId).kind == ExprKind.ArrayLit &&
      tree.argumentsOf(expr.argsList).length == 1
    ) {
      const exprExpr = tree.exprOf(source.exprId);

      this.byteValuesChecked(exprExpr, instance, module);

      return;
    }
    const sourceExpr = tree.exprOf(source.exprId);
    if (sourceExpr.kind == ExprKind.ArrayLit) {
      return;
    }

    const from = this.peekType(tree.exprOf(source.exprId), module);
    if (from.kind == TypeKind.Error) {
      return;
    }
    const args = tree.argumentsOf(expr.argsList);
    if (args.length == 1) {
      this.byteSourceCheck(tree.exprOf(source.exprId), from, instance, module);

      return;
    }

    this.mappedSourceCheck(
      expr,
      tree.exprOf(source.exprId),
      from,
      instance,
      module,
    );
  }

  private mappedSourceCheck(
    expr: CallExpr,
    source: Expr,
    from: Type,
    instance: InstanceType,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const shape = this.types.sourceShape(from);
    const name = this.types.typedName(instance) ?? "";
    if (shape.element == undefined) {
      const notIterableError = this.types.notIterableError(
        source.loc,
        name,
        from,
      );

      return this.errors.writeFound(module, notIterableError);
    }

    const mapper = tree.argumentsOf(expr.argsList)[1];
    const element = this.types.elementOf(instance);
    if (mapper == undefined || mapper.spread || element == undefined) {
      return;
    }
    const mapperExpr = tree.exprOf(mapper.exprId);
    if (mapperExpr.kind != ExprKind.Function) {
      return this.namedMapperCheck(
        tree.exprOf(mapper.exprId),
        instance,
        module,
      );
    }

    const index = this.types.store.integer(64, false);
    const signature = this.types.store.functionOf({
      params: [
        { type: shape.element, optional: false },
        { type: index, optional: false },
      ],
      rest: false,
      result: element,
    });

    const exprExpr = tree.exprOf(mapper.exprId);

    this.typed(exprExpr, signature, module);
  }

  private namedMapperCheck(mapper: Expr, target: Type, module: int): void {
    if (mapper.kind == ExprKind.Function) {
      return;
    }

    const type = this.peekType(mapper, module);
    const base = this.types.definedType(type);
    const isLibraryFunction =
      base.kind == TypeKind.Error && mapper.kind == ExprKind.Member;
    if (base.kind != TypeKind.Function && !isLibraryFunction) {
      return;
    }

    const mapFitError = this.types.mapFitError(mapper.loc, target);

    this.errors.writeFound(module, mapFitError);
  }

  private allocFillCheck(expr: CallExpr, module: int): void {
    const tree = this.types.program.tree;

    const fill = tree.argumentsOf(expr.argsList)[1];
    if (fill == undefined || fill.spread) {
      return;
    }

    const exprExpr = tree.exprOf(fill.exprId);
    const type = this.peekType(exprExpr, module);
    const base = this.types.definedType(type);
    if (base.kind == TypeKind.Error) {
      return;
    }
    if (!this.types.isFillValue(base)) {
      const allocFillError = this.types.allocFillError(
        tree.exprOf(fill.exprId).loc,
        type,
      );

      return this.errors.writeFound(module, allocFillError);
    }

    const fillExpr = tree.exprOf(fill.exprId);

    this.byteValueFitCheck(fillExpr, base, module);
  }

  private byteValueFitCheck(value: Expr, base: Type, module: int): void {
    const info = this.types.byteSourceByteInfo();
    if (base.kind != TypeKind.Int || info == undefined) {
      return;
    }

    this.byteFitCheck(value, info, this.types.byteRange(), module);
  }

  private typedSetCall(
    expr: CallExpr,
    member: MemberExpr,
    instance: InstanceType,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const element = this.types.elementOf(instance);
    const source = tree.argumentsOf(expr.argsList)[0];
    const count = tree.argumentsOf(expr.argsList).length;
    const isPlain =
      count >= 1 &&
      count <= 2 &&
      tree.argumentsOf(expr.argsList).every((arg) => !arg.spread);
    if (member.name != kSetName || element == undefined) {
      return undefined;
    }
    if (!isPlain || source == undefined) {
      return undefined;
    }

    const isFitting = this.setSourceTyped(
      tree.exprOf(source.exprId),
      element,
      instance,
      module,
    );
    const offset = tree.exprAt(tree.argumentsOf(expr.argsList)[1]?.exprId);
    const isPlaced = this.setOffsetTyped(offset, module);

    if (isFitting && isPlaced) {
      this.setRangeCheck(
        tree.exprOf(member.objectId),
        tree.exprOf(source.exprId),
        offset,
        module,
      );
    }

    return this.types.store.plain(TypeKind.Void);
  }

  private setSourceTyped(
    source: Expr,
    element: Type,
    instance: InstanceType,
    module: int,
  ): boolean {
    if (source.kind == ExprKind.ArrayLit) {
      return this.byteValuesChecked(source, instance, module);
    }

    const from = this.typed(source, undefined, module);
    if (from.kind == TypeKind.Error) {
      return false;
    }

    const iteratorError = this.types.setIteratorError(source.loc, from);
    if (iteratorError != undefined) {
      this.errors.writeFound(module, iteratorError);

      return false;
    }

    return this.byteSourceCheck(source, from, instance, module);
  }

  private byteValuesChecked(values: Expr, target: Type, module: int): boolean {
    const before = this.errors.count();
    const element = this.valueElement(target);
    const wanted = this.types.store.arrayOf(element);
    const given = this.checked(values, wanted, module, kNoPlace);

    return given.kind != TypeKind.Error && this.errors.count() == before;
  }

  private valueElement(target: Type): Type {
    const element = this.types.elementOf(target);
    if (element == undefined || this.types.isClamped(target)) {
      return this.types.store.integer(64, false);
    }

    return element;
  }

  private setOffsetTyped(offset: Expr | undefined, module: int): boolean {
    if (offset == undefined) {
      return true;
    }

    const int = this.types.store.integer(64, false);
    const given = this.typed(offset, int, module);
    return this.requireBetween(
      offset,
      given,
      { what: kSetOffsetWhat, low: 0 },
      module,
    );
  }

  private setRangeCheck(
    target: Expr,
    source: Expr,
    offset: Expr | undefined,
    module: int,
  ): void {
    if (this.types.isLibraryModule(module)) {
      return;
    }

    const at = this.pinnedLinear(this.offsetLinear(offset, module));
    const most = this.pinnedLinear(this.mostLength(source, module));
    const length =
      this.constLength(target, module) ?? this.measuredLength(target, module);
    if (at != undefined && most != undefined && length != undefined) {
      const sum = this.types.linearSum(at, most);
      if (sum != undefined && this.isLinearUpTo(sum, length, 0)) {
        return;
      }
    }

    const shownOffset = this.shownOffset(offset, module);
    const shownSource = this.types.valueText(source, module);
    const shownTarget = this.types.valueText(target, module);
    const setFitError = this.types.setFitError(
      source.loc,
      shownOffset,
      shownSource,
      shownTarget,
    );

    this.errors.writeFound(module, setFitError);
  }

  private offsetLinear(
    offset: Expr | undefined,
    module: int,
  ): Linear | undefined {
    if (offset == undefined) {
      return { term: kZeroTerm, offset: 0 };
    }

    return this.linearOf(offset, module);
  }

  private mostLength(source: Expr, module: int): Linear | undefined {
    const tree = this.types.program.tree;

    switch (source.kind) {
      case ExprKind.ArrayLit: {
        const isPlain = tree.elementsOf(source.elementsList).every(
          (one) => !one.spread && !one.hole,
        );
        if (!isPlain) {
          return undefined;
        }

        return {
          term: kZeroTerm,
          offset: tree.elementsOf(source.elementsList).length.toDecimal(),
        };
      }
      case ExprKind.Call:
        return this.partLength(source, module);
      default:
        return (
          this.madeLinear(source, module) ?? this.measuredLength(source, module)
        );
    }
  }

  private partLength(call: CallExpr, module: int): Linear | undefined {
    const tree = this.types.program.tree;

    const callee = tree.exprOf(call.calleeId);
    const first = tree.exprAt(tree.argumentsOf(call.argsList)[0]?.exprId);
    const second = tree.exprAt(tree.argumentsOf(call.argsList)[1]?.exprId);
    const isPart =
      callee.kind == ExprKind.Member &&
      kPartNames.includes(callee.name) &&
      tree.argumentsOf(call.argsList).length == 2;
    if (!isPart || first == undefined || second == undefined) {
      return undefined;
    }

    const from = this.partBound(first, module);
    const to = this.partBound(second, module);
    if (from == undefined || to == undefined || from < 0 || to < from) {
      return undefined;
    }

    return { term: kZeroTerm, offset: to - from };
  }

  private partBound(value: Expr, module: int): decimal | undefined {
    const given = this.peekType(value, module);

    return this.intConstant(value, given, module);
  }

  private byteMethodCheck(
    expr: CallExpr,
    member: MemberExpr,
    instance: InstanceType,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    if (this.types.isLibraryModule(module)) {
      return;
    }
    if (tree.argumentsOf(expr.argsList).some((arg) => arg.spread)) {
      return;
    }

    const name = member.name;
    const isTyped = this.types.typedName(instance) != undefined;
    const mapper = tree.argumentsOf(expr.argsList)[0];
    if (isTyped && name == kWithName) {
      return this.withIndexCheck(expr, member, module);
    }
    if (isTyped && name == kMapName && mapper != undefined) {
      return this.namedMapperCheck(
        tree.exprOf(mapper.exprId),
        instance,
        module,
      );
    }
    if (this.types.ownerOf(instance) != ByteOwner.Buffer) {
      return;
    }
    if (name == kFillName || kSearchNames.includes(name)) {
      return this.bufferValueCheck(expr, member, module);
    }

    this.bufferPositionsCheck(expr, member, module);
  }

  private withIndexCheck(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const index = tree.argumentsOf(expr.argsList)[0];
    if (index == undefined) {
      return;
    }

    const exprExpr = tree.exprOf(index.exprId);
    const given = this.peekType(exprExpr, module);
    if (given.kind == TypeKind.Error) {
      return;
    }
    if (
      this.isAtInBounds(
        tree.exprOf(member.objectId),
        tree.exprOf(index.exprId),
        module,
      )
    ) {
      return;
    }

    const object = tree.exprOf(member.objectId);
    const shown = this.types.valueText(object, module);
    const withIndexError = this.types.withIndexError(
      tree.exprOf(index.exprId).loc,
      shown,
    );

    this.errors.writeFound(module, withIndexError);
  }

  private isAtInBounds(object: Expr, index: Expr, module: int): boolean {
    const at = this.linearOf(index, module);
    const length = this.measuredLength(object, module);
    const isFromEnd =
      at != undefined &&
      length != undefined &&
      at.term == kZeroTerm &&
      at.offset < 0;
    if (isFromEnd && at != undefined && length != undefined) {
      const room = -(length.offset + at.offset);

      return this.canProve(kZeroTerm, length.term, room);
    }

    return this.isProvenIndex(object, index, module);
  }

  private bufferValueCheck(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const value = tree.argumentsOf(expr.argsList)[0];
    if (value == undefined) {
      return;
    }

    const exprExpr = tree.exprOf(value.exprId);
    const type = this.peekType(exprExpr, module);
    const base = this.types.definedType(type);
    if (base.kind == TypeKind.Error) {
      return;
    }
    if (!this.types.isFillValue(base)) {
      const valueArgumentError = this.types.valueArgumentError(
        tree.exprOf(value.exprId).loc,
        member.name,
        type,
      );

      return this.errors.writeFound(module, valueArgumentError);
    }
    if (member.name != kFillName) {
      return;
    }

    const valueExpr = tree.exprOf(value.exprId);

    this.byteValueFitCheck(valueExpr, base, module);
    this.fillPositionsCheck(
      tree.argumentsOf(expr.argsList),
      tree.exprOf(member.objectId),
      module,
    );
  }

  private fillPositionsCheck(
    args: Read<CallArgument[]>,
    buffer: Expr,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    for (let index = 1; index < args.length && index < 3; index++) {
      const position = tree.exprAt(args[index]?.exprId);
      if (position == undefined) {
        return;
      }

      const type = this.peekType(position, module);
      const base = this.types.definedType(type);
      if (base.kind == TypeKind.String) {
        return;
      }

      const what = this.fillWhat(index);

      this.requireUpTo(position, buffer, { what, less: 0 }, module);
    }
  }

  private readonly fillWhat(index: int): string {
    if (index == 1) {
      return kOffsetWhat;
    }

    return kEndWhat;
  }

  private bufferPositionsCheck(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const positions = this.types.positionsOf(member.name);
    const target = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (positions.length == 0 || target == undefined) {
      return;
    }

    for (
      let index = 1;
      index < tree.argumentsOf(expr.argsList).length;
      index++
    ) {
      const position = positions[index - 1];
      const value = tree.exprAt(tree.argumentsOf(expr.argsList)[index]?.exprId);
      if (position == undefined || value == undefined) {
        continue;
      }

      const what = `'${position.name}'`;
      if (!position.isEnd) {
        const given = this.peekType(value, module);

        this.requireBetween(value, given, { what, low: 0 }, module);

        continue;
      }

      const array = this.positionArray(position.isTarget, target, member);

      this.requireUpTo(value, array, { what, less: 0 }, module);
    }
  }

  private readonly positionArray(
    isTarget: boolean,
    target: Expr,
    member: MemberExpr,
  ): Expr {
    const tree = this.types.program.tree;

    if (isTarget) {
      return target;
    }

    return tree.exprOf(member.objectId);
  }
}
