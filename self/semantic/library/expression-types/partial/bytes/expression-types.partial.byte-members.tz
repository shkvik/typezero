import { kArrayBufferClass } from "../../../byte-source-rules/const/byte-source-rules.const.tz";
import {
  DeclaredMember,
  DeclaredMemberKind,
} from "../../../../../program/ast/types/ast.types.declarations.tz";
import {
  BinaryExpr,
  CallExpr,
  Expr,
  ExprKind,
  IndexExpr,
  MemberExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  InstanceType,
  Type,
  UnionType,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";

partial class ExpressionTypes {
  private byteMemberRead(
    expr: MemberExpr,
    instance: InstanceType,
    module: int,
  ): Type | undefined {
    if (!this.types.isBytesType(instance)) {
      return undefined;
    }

    const found = this.declaredNamed(instance, expr.name);
    const isTyped = this.types.typedName(instance) != undefined;
    if (found == undefined) {
      const missingError = this.types.missingMemberError(
        expr.loc,
        expr.name,
        instance,
        false,
      );

      this.errors.writeFound(module, missingError);

      return this.types.store.plain(TypeKind.Error);
    }

    const isMethod = found.form.kind != DeclaredMemberKind.Field;
    if (!isMethod || !isTyped) {
      return undefined;
    }

    const missingError = this.types.missingMemberError(
      expr.loc,
      expr.name,
      instance,
      true,
    );

    this.errors.writeFound(module, missingError);

    return this.types.store.plain(TypeKind.Error);
  }

  private missingByteMethod(
    expr: CallExpr,
    member: MemberExpr,
    instance: InstanceType,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    if (!this.types.isBytesType(instance)) {
      return false;
    }
    if (this.declaredNamed(instance, member.name) != undefined) {
      return false;
    }

    const isTyped = this.types.typedName(instance) != undefined;
    const methodError = this.types.missingMethodError(
      member.loc,
      member.name,
      instance,
      isTyped,
    );

    this.errors.writeFound(module, methodError);
    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args, module);

    return true;
  }

  private readonly declaredNamed(
    instance: InstanceType,
    name: string,
  ): DeclaredMember | undefined {
    const tree = this.types.program.tree;

    const opened = this.types.program.modules[instance.module];
    const declared = tree
      .declaredClassesOf(opened?.declaredList)
      .find((one) => one.loc == instance.loc);
    const found = tree.declaredMembersOf(declared?.membersList).find(
      (one) => one.name == name && !one.isStatic,
    );
    if (found != undefined) {
      return found;
    }

    const parent = this.types.baseClassOf(instance);
    if (parent == undefined || parent.kind != TypeKind.Instance) {
      return undefined;
    }

    return this.declaredNamed(parent, name);
  }

  private byteIndexCheck(expr: IndexExpr, object: Type, module: int): boolean {
    const tree = this.types.program.tree;

    const indexError = this.types.notIndexedError(expr.loc, object);
    if (indexError == undefined) {
      return false;
    }

    this.errors.writeFound(module, indexError);
    const index = tree.exprOf(expr.indexId);

    this.typed(index, undefined, module);

    return true;
  }

  private byteTextCheck(operand: Expr, base: Type, module: int): boolean {
    const textError = this.types.noTextError(operand.loc, base);
    if (textError == undefined) {
      return false;
    }

    this.errors.writeFound(module, textError);

    return true;
  }

  private byteUnionMember(
    expr: MemberExpr,
    union: UnionType,
    module: int,
  ): Type | undefined {
    if (!this.types.isBytesUnion(this.types.store.partsOf(union))) {
      return undefined;
    }

    const unionError = this.types.unionMemberError(
      expr.loc,
      expr.name,
      this.types.store.partsOf(union),
      union,
    );
    if (unionError != undefined) {
      this.errors.writeFound(module, unionError);

      return this.types.store.plain(TypeKind.Error);
    }
    if (this.types.isBufferName(expr.name)) {
      const buffer = this.types.libraryInstance(kArrayBufferClass, []);

      return buffer ?? this.types.store.plain(TypeKind.Error);
    }

    return this.types.store.integer(64, false);
  }

  private bytesInstanceof(expr: BinaryExpr, left: Type, module: int): boolean {
    const tree = this.types.program.tree;

    const rhs = tree.exprOf(expr.rhsId);
    if (rhs.kind != ExprKind.Name || !this.isGlobalUse(rhs, module)) {
      return false;
    }
    if (!this.types.isKindName(rhs.name)) {
      return false;
    }
    if (left.kind == TypeKind.Error) {
      return true;
    }

    const instanceofError = this.types.instanceofError(
      expr.loc,
      left,
      rhs.name,
    );

    this.errors.writeFound(module, instanceofError);

    return true;
  }
}
