import {
  AssignExpr,
  Expr,
  ExprKind,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import {
  LiteralKind,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";

partial class ExpressionTypes {
  private readonly isEncodingParam(type: Type): boolean {
    const label = this.store.labelOf(type);

    return this.byteSources.isEncodingLabel(label);
  }

  private encodingArgumentCheck(value: Expr, module: int): void {
    const given = this.typed(value, undefined, module);
    if (given.kind == TypeKind.Error || this.modules.isLibraryModule(module)) {
      return;
    }

    const texts = this.encodingTexts(value, given, module, 0);
    if (texts == undefined) {
      const unknownEncodingError = this.byteSources.unknownEncodingError(
        value.loc,
      );

      return this.reportFound(module, unknownEncodingError);
    }

    const encodingError = this.byteSources.encodingError(value.loc, texts);

    this.reportFound(module, encodingError);
  }

  private encodingTexts(
    value: Expr,
    given: Type,
    module: int,
    depth: int,
  ): string[] | undefined {
    const typed = this.encodingLiteralTexts(given);
    if (typed != undefined) {
      return typed;
    }
    if (depth > 8) {
      return undefined;
    }

    switch (value.kind) {
      case ExprKind.StringLit:
        return [value.value];
      case ExprKind.Conditional:
        return this.encodingBranchTexts(
          value.thenExpr,
          value.elseExpr,
          module,
          depth,
        );
      case ExprKind.Name:
        return this.encodingConstTexts(value, module, depth);
      default:
        return undefined;
    }
  }

  private readonly encodingLiteralTexts(given: Type): string[] | undefined {
    if (this.isEncodingParam(given)) {
      return [];
    }
    if (given.kind == TypeKind.Literal) {
      if (given.literal != LiteralKind.String) {
        return undefined;
      }

      return [given.text];
    }
    if (given.kind != TypeKind.Union) {
      return undefined;
    }

    const texts: string[] = [];

    for (const part of given.parts) {
      const found = this.encodingLiteralTexts(part);
      if (found == undefined) {
        return undefined;
      }

      texts.push(...found);
    }

    return texts;
  }

  private encodingBranchTexts(
    first: Expr,
    second: Expr,
    module: int,
    depth: int,
  ): string[] | undefined {
    const firstType = this.peekType(first, module);
    const secondType = this.peekType(second, module);
    const one = this.encodingTexts(first, firstType, module, depth + 1);
    const other = this.encodingTexts(second, secondType, module, depth + 1);
    if (one == undefined || other == undefined) {
      return undefined;
    }

    return [...one, ...other];
  }

  private encodingConstTexts(
    value: Expr,
    module: int,
    depth: int,
  ): string[] | undefined {
    if (value.kind != ExprKind.Name) {
      return undefined;
    }

    const target = this.targetOfName(value, module);
    if (target == undefined || target.kind != SymbolKind.Variable) {
      return undefined;
    }

    const variable = this.record(target.module)?.variables.get(target.loc);
    const init = variable?.decl.init;
    if (variable == undefined || !variable.isConst || init == undefined) {
      return undefined;
    }

    const type = this.peekType(init, target.module);

    return this.encodingTexts(init, type, target.module, depth + 1);
  }

  private readonly isTextType(type: Type): boolean {
    const base = this.types.definedType(type);
    if (base.kind == TypeKind.Literal) {
      return base.literal == LiteralKind.String;
    }

    return base.kind == TypeKind.String || this.isEncodingParam(type);
  }

  private bytesLengthCheck(expr: AssignExpr, module: int): void {
    const target = expr.target;
    if (target.kind != ExprKind.Member) {
      return;
    }
    if (!this.byteSources.isSizeName(target.name)) {
      return;
    }

    const object = this.peekType(target.object, module);
    const lengthFixedError = this.byteSources.lengthFixedError(
      target.loc,
      object,
    );

    this.reportFound(module, lengthFixedError);
  }
}
