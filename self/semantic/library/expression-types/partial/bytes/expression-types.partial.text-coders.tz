import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  NewExpr,
  PropertyKind,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  InstanceType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import { kNoPlace } from "../../../../code/expression-types/const/expression-types.const.tz";
import { kFatalDecoderClass } from "../../../text-coder-rules/const/text-coder-rules.const.tz";

partial class ExpressionTypes {
  private codedNew(expr: NewExpr, made: Type, module: int): Type {
    const tree = this.types.program.tree;

    if (this.types.isLibraryModule(module)) {
      return made;
    }
    if (this.types.isFatalNew(made)) {
      const fatalNewError = this.types.fatalNewError(expr.loc);

      this.errors.writeFound(module, fatalNewError);

      return this.types.store.plain(TypeKind.Error);
    }
    if (this.types.isArrayBuffer(made)) {
      return this.resizableCheck(expr, made, module);
    }
    if (!this.types.isDecoderNew(made)) {
      return made;
    }

    const label = tree.argumentsOf(expr.argsList)[0];
    if (
      label != undefined &&
      tree.exprOf(label.exprId).kind != ExprKind.Undefined
    ) {
      const exprExpr = tree.exprOf(label.exprId);

      this.decoderLabelCheck(exprExpr, module);
    }

    const options = tree.argumentsOf(expr.argsList)[1];
    if (
      options == undefined ||
      !this.canBeFatal(tree.exprOf(options.exprId), module, 0)
    ) {
      return made;
    }

    const fatal = this.types.libraryInstance(kFatalDecoderClass, []);

    return fatal ?? made;
  }

  private resizableCheck(expr: NewExpr, made: Type, module: int): Type {
    const tree = this.types.program.tree;

    const options = tree.argumentsOf(expr.argsList)[1];
    if (options == undefined) {
      return made;
    }

    const resizableError = this.types.resizableError(
      tree.exprOf(options.exprId).loc,
    );

    this.errors.writeFound(module, resizableError);

    return made;
  }

  private decoderLabelCheck(label: Expr, module: int): void {
    const written = this.types.literalLabel(label);
    if (written != undefined) {
      const labelError = this.types.labelError(label.loc, [written]);

      return this.errors.writeFound(module, labelError);
    }

    const given = this.peekType(label, module);
    if (given.kind == TypeKind.Error) {
      return;
    }

    const texts = this.encodingTexts(label, given, module, 0);
    if (texts == undefined) {
      const unknownLabelError = this.types.unknownLabelError(label.loc);

      return this.errors.writeFound(module, unknownLabelError);
    }

    const labelError = this.types.labelError(label.loc, texts);

    this.errors.writeFound(module, labelError);
  }

  private canBeFatal(options: Expr, module: int, depth: int): boolean {
    const tree = this.types.program.tree;

    if (options.kind != ExprKind.ObjectLit) {
      return this.isFatalShape(options, module);
    }
    if (depth > 8) {
      return false;
    }

    let isFatal = false;

    for (const property of tree.propertiesOf(options.propsList)) {
      const isSpread = property.form.kind == PropertyKind.Spread;
      if (isSpread) {
        isFatal =
          isFatal ||
          this.canBeFatal(tree.exprOf(property.valueId), module, depth + 1);
      }
      if (!isSpread && this.types.isFatalName(property.name)) {
        isFatal = this.types.isFatalFlag(tree.exprOf(property.valueId));
      }
    }

    return isFatal;
  }

  private isFatalShape(options: Expr, module: int): boolean {
    const type = this.peekType(options, module);
    const base = this.types.definedType(type);
    if (base.kind != TypeKind.Object) {
      return false;
    }

    const field = this.types.store.fieldsOf(base).find((one) =>
      this.types.isFatalName(one.name),
    );

    return field != undefined && field.type.kind != TypeKind.Undefined;
  }

  private decodeCall(
    expr: CallExpr,
    member: MemberExpr,
    instance: InstanceType,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const method = this.receiverMember(instance, member.name, true);
    const isPlain =
      tree.argumentsOf(expr.argsList).length <= 2 &&
      tree.argumentsOf(expr.argsList).every((arg) => !arg.spread);
    if (!this.types.isDecodeCall(instance, member.name) || !isPlain) {
      return undefined;
    }
    if (method == undefined || method.kind != TypeKind.Function) {
      return undefined;
    }

    const result = this.types.store.returnTypeOf(method);
    const input = tree.argumentsOf(expr.argsList)[0];
    if (input == undefined) {
      return result;
    }

    const exprExpr = tree.exprOf(input.exprId);
    const found = this.typed(exprExpr, undefined, module);
    const decodeInputError = this.types.decodeInputError(
      tree.exprOf(input.exprId).loc,
      found,
    );
    const options = tree.argumentsOf(expr.argsList)[1];
    if (decodeInputError != undefined) {
      this.errors.writeFound(module, decodeInputError);
      const args = tree.argumentsOf(expr.argsList);

      this.looseArguments(args.slice(1), module);

      return result;
    }

    const wanted = this.types.store.paramsOf(method)[1]?.type;
    if (options != undefined && wanted != undefined) {
      const optionsExpr = tree.exprOf(options.exprId);

      this.checked(optionsExpr, wanted, module, kNoPlace);
    }

    return result;
  }

  private decoderParseCheck(
    expr: CallExpr,
    instance: InstanceType,
    member: MemberExpr,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const label = tree.argumentsOf(expr.argsList)[0];
    const isParse = this.types.isParseName(member.name);
    if (
      !isParse ||
      !this.types.isDecoderNew(instance) ||
      label == undefined
    ) {
      return;
    }

    const exprExpr = tree.exprOf(label.exprId);
    const written = this.types.literalLabel(exprExpr);
    if (written == undefined || this.types.isLibraryModule(module)) {
      return;
    }

    const labelError = this.types.labelError(tree.exprOf(label.exprId).loc, [
      written,
    ]);

    this.errors.writeFound(module, labelError);
  }
}
