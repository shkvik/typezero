import { Code } from "../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import {
  ArrayLitExpr,
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  NewExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../program/ast/types/ast.types.functions.tz";
import {
  FunctionParameter,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import { PromiseValues } from "../../../code/expression-types/types/expression-types.types.tz";
import {
  TypeContext,
  TypePlace,
} from "../../../types/type-resolver/types/type-resolver.types.tz";
import {
  kAllName,
  kPromiseClass,
  kPromiseField,
  kRaceName,
  kResolveName,
  kTypedStatics,
  kWithResolversName,
} from "../../library-rules/const/library-rules.const.tz";

partial class ExpressionTypes {
  private promiseStaticCall(
    expr: CallExpr,
    member: MemberExpr,
    wanted: Type | undefined,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const owner = tree.exprOf(member.objectId);
    const isPromise =
      owner.kind == ExprKind.Name &&
      owner.name == kPromiseClass &&
      this.isGlobalUse(owner, module);
    const hasSpread = tree.argumentsOf(expr.argsList).some((arg) => arg.spread);
    if (!isPromise || hasSpread || this.types.isLibraryModule(module)) {
      return undefined;
    }

    const isTyped = kTypedStatics.includes(member.name);
    if (isTyped && tree.typeRefsOf(member.typeArgsList).length > 0) {
      this.errors.write(
        module,
        member.loc,
        Code.PromiseStaticTypeArgs,
        kNoDetails,
      );
    }

    switch (member.name) {
      case kResolveName:
        return this.promiseResolveCall(expr, member, wanted, module);
      case kWithResolversName:
        return this.withResolversCall(expr, member, wanted, module);
      case kAllName:
      case kRaceName:
        return this.promiseCombinatorCall(expr, member, wanted, module);
      default:
        return undefined;
    }
  }

  private promiseNew(
    expr: NewExpr,
    written: Read<Type[]>,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const known = this.types.promiseNew(written, wanted);
    const executor = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (
      known.kind != TypeKind.Error ||
      tree.typeRefsOf(expr.typeArgsList).length > 0
    ) {
      return known;
    }
    if (tree.argumentsOf(expr.argsList).length != 1 || executor == undefined) {
      return known;
    }
    if (executor.kind != ExprKind.Function) {
      this.errors.write(
        module,
        expr.loc,
        Code.PromiseValueNotInferred,
        kNoDetails,
      );

      return known;
    }

    const nothing = this.types.store.plain(TypeKind.Void);
    const resolve = tree.paramsOf(tree.functionOf(executor.fnId).paramsList)[0]
      ?.name;
    const fn = tree.functionOf(executor.fnId);
    const values = this.resolvedExprs(fn, resolve);
    if (values.length == 0) {
      return this.types.store.promiseOf(nothing);
    }

    const types = values.map((value) => this.peekType(value, module));
    if (types.some((type) => type.kind == TypeKind.Error)) {
      return known;
    }

    const value = this.joinedResolved(types);
    if (value == undefined) {
      this.errors.write(
        module,
        expr.loc,
        Code.PromiseValueNotInferred,
        kNoDetails,
      );

      return known;
    }

    return this.types.store.promiseOf(value);
  }

  private readonly resolvedExprs(
    fn: FunctionDecl,
    resolve: string | undefined,
  ): Expr[] {
    const values: Expr[] = [];

    for (const expr of this.types.functionExprs(fn, true)) {
      const value = this.resolvedExpr(expr, resolve);
      if (value != undefined) {
        values.push(value);
      }
    }

    return values;
  }

  private readonly resolvedExpr(
    expr: Expr,
    resolve: string | undefined,
  ): Expr | undefined {
    const tree = this.types.program.tree;

    if (expr.kind != ExprKind.Call) {
      return undefined;
    }

    const callee = tree.exprOf(expr.calleeId);
    if (callee.kind != ExprKind.Name || callee.name != resolve) {
      return undefined;
    }

    return tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
  }

  private joinedResolved(types: Read<Type[]>): Type | undefined {
    let found: Type | undefined = undefined;

    for (const type of types) {
      const isNothing =
        type.kind == TypeKind.Void || type.kind == TypeKind.Undefined;
      if (isNothing) {
        return undefined;
      }

      found = this.raceJoin(found, this.types.apparent(type));
      if (found == undefined) {
        return undefined;
      }
    }

    return found;
  }

  private promisedWanted(wanted: Type | undefined): Type | undefined {
    if (wanted == undefined) {
      return undefined;
    }

    const base = this.types.definedType(wanted);
    if (
      base.kind != TypeKind.Promise ||
      this.types.store.valueOf(base).kind == TypeKind.Never
    ) {
      return undefined;
    }

    return this.types.store.valueOf(base);
  }

  private staticCountCheck(
    expr: CallExpr,
    member: MemberExpr,
    least: int,
    most: int,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const count = tree.argumentsOf(expr.argsList).length;
    if (count >= least && count <= most) {
      return false;
    }

    const word = this.types.argumentCountText(least, most, false);

    this.errors.write(module, member.loc, Code.ArgumentCount, {
      word,
      other: `${count}`,
    });
    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args, module);

    return true;
  }

  private promiseResolveCall(
    expr: CallExpr,
    member: MemberExpr,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const error = this.types.store.plain(TypeKind.Error);
    const nothing = this.types.store.plain(TypeKind.Void);
    if (this.staticCountCheck(expr, member, 0, 1, module)) {
      return error;
    }

    const value = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (value == undefined) {
      return this.types.store.promiseOf(nothing);
    }

    const hint = this.resolveHint(value, wanted);
    const given = this.typed(value, hint, module);

    switch (given.kind) {
      case TypeKind.Error:
        return error;
      case TypeKind.Promise:
        return given;
      case TypeKind.Undefined:
        return this.types.store.promiseOf(nothing);
      case TypeKind.Void:
        this.errors.write(module, value.loc, Code.PromiseVoidGiven, {
          word: `${kPromiseClass}.${member.name}`,
        });

        return error;
      default:
        return this.types.store.promiseOf(this.resolvedValue(given, hint));
    }
  }

  private resolveHint(value: Expr, wanted: Type | undefined): Type | undefined {
    if (value.kind == ExprKind.Undefined) {
      return undefined;
    }

    return this.promisedWanted(wanted);
  }

  private resolvedValue(given: Type, hint: Type | undefined): Type {
    if (hint != undefined && this.types.converts(given, hint)) {
      return hint;
    }

    return this.types.apparent(given);
  }

  private withResolversCall(
    expr: CallExpr,
    member: MemberExpr,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const error = this.types.store.plain(TypeKind.Error);
    if (this.staticCountCheck(expr, member, 0, 0, module)) {
      return error;
    }
    const typeArgs = tree.typeRefsOf(member.typeArgsList);
    if (typeArgs.length > 1) {
      const code = Code.PromiseResolversTypeArgs;

      this.errors.write(module, member.loc, code, kNoDetails);

      return error;
    }

    const value = this.resolversValue(member, wanted, module);
    if (value == undefined) {
      this.errors.write(
        module,
        member.loc,
        Code.PromiseResolversUnknown,
        kNoDetails,
      );

      return error;
    }
    if (value.kind == TypeKind.Error) {
      return error;
    }

    const params: FunctionParameter[] = [];

    if (value.kind != TypeKind.Void) {
      params.push({ type: value, optional: false });
    }

    const nothing = this.types.store.plain(TypeKind.Void);
    const resolver = this.types.store.functionOf({
      params,
      rest: false,
      result: nothing,
    });
    const promise = this.types.store.promiseOf(value);

    return this.types.store.objectOf([
      { name: kPromiseField, type: promise, optional: false, readonly: false },
      { name: kResolveName, type: resolver, optional: false, readonly: false },
    ]);
  }

  private resolversValue(
    member: MemberExpr,
    wanted: Type | undefined,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const written = tree.typeRefsOf(member.typeArgsList)[0];
    if (written == undefined) {
      return this.expectedResolversValue(wanted);
    }

    const context: TypeContext = {
      module,
      bindings: new Map<int, Type>(),
      place: TypePlace.Plain,
    };
    const type = this.types.returnType(written, context);

    return this.awaitedValue(type);
  }

  private readonly expectedResolversValue(
    wanted: Type | undefined,
  ): Type | undefined {
    if (wanted == undefined || wanted.kind != TypeKind.Object) {
      return undefined;
    }

    const field = this.types.store
      .fieldsOf(wanted)
      .find((one) => one.name == kPromiseField);
    const promise = field?.type;
    if (promise == undefined || promise.kind != TypeKind.Promise) {
      return undefined;
    }

    return this.types.store.valueOf(promise);
  }

  private readonly awaitedValue(type: Type): Type {
    if (type.kind == TypeKind.Promise) {
      return this.types.store.valueOf(type);
    }

    return type;
  }

  private promiseCombinatorCall(
    expr: CallExpr,
    member: MemberExpr,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const error = this.types.store.plain(TypeKind.Error);
    const list = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (this.staticCountCheck(expr, member, 1, 1, module)) {
      return error;
    }
    if (list == undefined) {
      return error;
    }

    const isRace = member.name == kRaceName;
    const word = `${kPromiseClass}.${member.name}`;
    const element = this.combinatorWanted(wanted, isRace);
    const values = this.promiseValues(list, element, word, module);
    if (values == undefined) {
      return error;
    }
    if (isRace) {
      return this.raceResult(values, element, list, word, module);
    }

    return this.allResult(values, element, list, module);
  }

  private combinatorWanted(
    wanted: Type | undefined,
    isRace: boolean,
  ): Type | undefined {
    const value = this.promisedWanted(wanted);
    if (value == undefined || isRace) {
      return value;
    }
    if (value.kind != TypeKind.Array) {
      return undefined;
    }

    return this.types.store.itemOf(value);
  }

  private promiseValues(
    list: Expr,
    wanted: Type | undefined,
    word: string,
    module: int,
  ): PromiseValues | undefined {
    const tree = this.types.program.tree;

    const isPlain =
      list.kind == ExprKind.ArrayLit &&
      tree
        .elementsOf(list.elementsList)
        .every((element) => !element.spread && !element.hole);
    if (list.kind == ExprKind.ArrayLit && isPlain) {
      return this.literalPromiseValues(list, wanted, word, module);
    }

    const given = this.typed(list, undefined, module);
    const base = this.types.definedType(given);
    if (
      base.kind == TypeKind.Array &&
      this.isPlainPromised(this.types.store.itemOf(base))
    ) {
      return {
        element: this.awaitedValue(this.types.store.itemOf(base)),
        tuple: [],
      };
    }
    if (base.kind != TypeKind.Tuple) {
      return undefined;
    }
    if (
      !this.types.store
        .itemsOf(base)
        .every((item) => this.isPlainPromised(item))
    ) {
      return undefined;
    }

    return {
      tuple: this.types.store
        .itemsOf(base)
        .map((item) => this.awaitedValue(item)),
    };
  }

  private isPlainPromised(type: Type): boolean {
    return (
      type.kind == TypeKind.Promise || this.awaitedType(type)?.id == type.id
    );
  }

  private literalPromiseValues(
    list: ArrayLitExpr,
    wanted: Type | undefined,
    word: string,
    module: int,
  ): PromiseValues | undefined {
    const tree = this.types.program.tree;

    const elements = tree.elementsOf(list.elementsList);
    if (elements.length == 0) {
      if (wanted == undefined) {
        this.errors.write(module, list.loc, Code.PromiseListNoType, { word });

        return undefined;
      }

      return { element: wanted, tuple: [] };
    }

    const types: Type[] = [];

    for (const element of tree.elementsOf(list.elementsList)) {
      const expr = tree.exprOf(element.exprId);
      const type = this.typed(expr, undefined, module);
      if (type.kind == TypeKind.Error || !this.isPlainPromised(type)) {
        return undefined;
      }
      if (type.kind == TypeKind.Void) {
        this.errors.write(
          module,
          tree.exprOf(element.exprId).loc,
          Code.PromiseVoidGiven,
          {
            word,
          },
        );

        return undefined;
      }

      types.push(this.types.apparent(type));
    }

    const common = this.commonPromised(types);
    if (common != undefined) {
      return { element: this.awaitedValue(common), tuple: [] };
    }

    return { tuple: types.map((type) => this.awaitedValue(type)) };
  }

  private commonPromised(types: Read<Type[]>): Type | undefined {
    let common: Type | undefined = types[0];

    for (const type of types) {
      if (common != undefined && common.id != type.id) {
        common = this.types.unify(common, type);
      }
    }

    if (common == undefined || common.kind == TypeKind.Error) {
      return undefined;
    }

    return common;
  }

  private readonly settledElement(
    element: Type | undefined,
    wanted: Type | undefined,
  ): Type {
    const nothing = this.types.store.plain(TypeKind.Void);
    if (element == undefined) {
      return nothing;
    }
    if (element.kind != TypeKind.Never) {
      return element;
    }

    return wanted ?? nothing;
  }

  private allResult(
    values: Read<PromiseValues>,
    wanted: Type | undefined,
    list: Expr,
    module: int,
  ): Type {
    if (values.tuple.length > 0) {
      if (values.tuple.some((type) => type.kind == TypeKind.Void)) {
        this.errors.write(module, list.loc, Code.PromiseAllVoid, kNoDetails);

        return this.types.store.plain(TypeKind.Error);
      }

      return this.types.store.promiseOf(
        this.types.store.plainTuple(values.tuple.slice()),
      );
    }

    const element = this.settledElement(values.element, wanted);
    if (element.kind == TypeKind.Void) {
      return this.types.store.promiseOf(element);
    }

    return this.types.store.promiseOf(this.types.store.arrayOf(element));
  }

  private raceResult(
    values: Read<PromiseValues>,
    wanted: Type | undefined,
    list: Expr,
    word: string,
    module: int,
  ): Type {
    let joined = values.element ?? values.tuple[0];

    for (const part of values.tuple) {
      const next = this.raceJoin(joined, part);
      if (joined != undefined && next == undefined) {
        this.errors.write(module, list.loc, Code.PromiseRaceDiffer, {
          word,
          first: this.types.typeText(joined),
          second: this.types.typeText(part),
        });

        return this.types.store.plain(TypeKind.Error);
      }

      joined = next;
    }

    return this.types.store.promiseOf(this.settledElement(joined, wanted));
  }

  private raceJoin(joined: Type | undefined, part: Type): Type | undefined {
    if (joined == undefined || joined.id == part.id) {
      return part;
    }

    const isVoid = joined.kind == TypeKind.Void || part.kind == TypeKind.Void;
    if (isVoid) {
      return undefined;
    }

    const common = this.types.unionUnify(joined, part);
    if (common == undefined || common.kind == TypeKind.Error) {
      return undefined;
    }

    return common;
  }
}
