import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import { Details } from "../../../../../diagnostic/types/message.types.tz";
import {
  CallArgument,
  Expr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { Type } from "../../../../../program/type/types/type.types.tz";
import { DateReader } from "../../../date-reader/date-reader.tz";
import {
  kDateFieldLimit,
  kFirstTimeField,
  kTimeFieldMost,
  kTimeFieldNames,
} from "../../../../code/expression-types/const/expression-types.const.tz";
import { DateFieldValues } from "../../../../code/expression-types/types/expression-types.types.tz";
import { kShortYearBase } from "../../../date-rules/const/date-rules.const.tz";

partial class ExpressionTypes {
  private dateFieldsCheck(
    args: CallArgument[],
    first: int,
    setter: string,
    module: int,
  ): void {
    const values: (int | undefined)[] = [];

    for (const arg of args) {
      const type = this.timeArgument(arg.expr, module);
      const value = this.dateConstant(arg.expr, type, module);

      values.push(value);
    }

    const fields: DateFieldValues = { args, first, setter, values };

    this.yearFieldCheck(fields, module);

    const month = this.validMonth(fields, module);

    this.dayFieldCheck(fields, month, module);
    this.timeFieldsCheck(fields, module);
  }

  private dateConstant(arg: Expr, type: Type, module: int): int | undefined {
    const base = this.types.apparent(type);
    const value = this.intConstant(arg, base, module);
    if (value == undefined) {
      return undefined;
    }

    const double = Number(value);
    if (double < -kDateFieldLimit || double > kDateFieldLimit) {
      return undefined;
    }

    return Math.trunc(double).toInt();
  }

  private reportField(
    fields: DateFieldValues,
    field: int,
    code: Code,
    module: int,
    details: Details,
  ): void {
    const arg = fields.args[field - fields.first]?.expr;
    if (arg != undefined) {
      this.report(module, arg.loc, code, details);
    }
  }

  private yearFieldCheck(fields: DateFieldValues, module: int): void {
    const year = this.dates.fieldValue(fields, 0);
    if (year == undefined || !this.dates.isShortYear(fields, year)) {
      return;
    }

    this.reportField(fields, 0, Code.DateYearShort, module, {
      word: `${year}`,
      other: `${kShortYearBase + year}`,
    });
  }

  private validMonth(fields: DateFieldValues, module: int): int | undefined {
    const month = this.dates.fieldValue(fields, 1);
    if (month == undefined || (month >= 0 && month <= 11)) {
      return month;
    }
    if (month == 12) {
      this.reportField(fields, 1, Code.DateMonthNext, module, kNoDetails);

      return undefined;
    }

    this.reportField(fields, 1, Code.DateMonthOutside, module, {
      word: `${month}`,
    });

    return undefined;
  }

  private dayFieldCheck(
    fields: DateFieldValues,
    month: int | undefined,
    module: int,
  ): void {
    const day = this.dates.fieldValue(fields, 2);
    if (day == undefined) {
      return;
    }
    if (day < 0) {
      return this.reportField(fields, 2, Code.DateDayBelow, module, {
        word: `${day}`,
      });
    }
    if (month != undefined) {
      return this.dayInMonthCheck(fields, day, month, module);
    }
    if (day > 31) {
      this.reportField(fields, 2, Code.DateDayAbove, module, {
        word: `${day}`,
      });
    }
  }

  private dayInMonthCheck(
    fields: DateFieldValues,
    day: int,
    month: int,
    module: int,
  ): void {
    const year = this.dates.knownYear(fields);
    const last = this.dates.lastDayOf(year, month);
    if (day <= last) {
      return;
    }

    const missing = this.dates.missingDay(year, month, day);
    const other = this.dates.monthName(month);

    if (fields.setter == "") {
      return this.reportField(fields, 2, Code.DateDayLast, module, {
        word: missing,
        other,
        first: this.dates.nextYearText(year, month),
        second: `${(month + 1) % 12}`,
      });
    }
    if (month == 1) {
      return this.reportField(fields, 2, Code.DateDayFebruary, module, {
        word: missing,
        other: fields.setter,
        first: this.dates.yearPart(year),
      });
    }

    this.reportField(fields, 2, Code.DateDayCount, module, {
      word: missing,
      other,
      first: `${last}`,
    });
  }

  private timeFieldsCheck(fields: DateFieldValues, module: int): void {
    const end = fields.first + fields.args.length;
    const start = Math.max(fields.first, kFirstTimeField);

    for (let field = start; field < end; field++) {
      const value = this.dates.fieldValue(fields, field);
      const most = kTimeFieldMost[field - kFirstTimeField];
      const other = kTimeFieldNames[field - kFirstTimeField];
      if (value == undefined || most == undefined || other == undefined) {
        continue;
      }
      if (value >= 0 && value <= most) {
        continue;
      }

      this.reportField(fields, field, Code.DateTimeRange, module, {
        word: `${value}`,
        other,
        first: `${most}`,
      });
    }
  }

  private dateTextCheck(expr: Expr, module: int): void {
    const text = this.dates.dateTextOf(expr);
    if (text == undefined) {
      return;
    }

    const reader = new DateReader(text);
    const fields = reader.read();
    const loc = expr.loc;
    if (fields == undefined) {
      return this.report(module, loc, Code.DateTextUnreadable, { word: text });
    }
    if (fields.isDateOnly) {
      return this.report(module, loc, Code.DateTextNoTime, { word: text });
    }

    const day = fields.day;
    if (day.day > this.dates.daysInMonth(day.year, day.month)) {
      const other = this.dates.missingDay(day.year, day.month, day.day);

      return this.report(module, loc, Code.DateTextNoDay, {
        word: text,
        other,
      });
    }
    if (!this.dates.isDateInRange(fields)) {
      this.report(module, loc, Code.DateTextOutside, { word: text });
    }
  }
}
