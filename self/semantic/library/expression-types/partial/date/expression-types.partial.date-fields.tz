import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import {
  CallArgument,
  Expr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { Type } from "../../../../../program/type/types/type.types.tz";
import { kDateFieldLimit } from "../../../../code/expression-types/const/expression-types.const.tz";
import { DateFieldValues } from "../../../../code/expression-types/types/expression-types.types.tz";

partial class ExpressionTypes {
  private dateFieldsCheck(
    args: CallArgument[],
    first: int,
    setter: string,
    module: int,
  ): void {
    const values: (int | undefined)[] = [];

    for (const arg of args) {
      const type = this.timeArgument(arg.expr, module);
      const value = this.dateConstant(arg.expr, type, module);

      values.push(value);
    }

    const fields: DateFieldValues = { args, first, setter, values };

    const yearFieldErrors = this.dates.yearFieldCheck(fields);

    this.reportAll(module, yearFieldErrors);

    const month = this.validMonth(fields, module);

    const dayFieldErrors = this.dates.dayFieldCheck(fields, month);

    this.reportAll(module, dayFieldErrors);
    const timeFieldsErrors = this.dates.timeFieldsCheck(fields);

    this.reportAll(module, timeFieldsErrors);
  }

  private dateConstant(arg: Expr, type: Type, module: int): int | undefined {
    const base = this.types.apparent(type);
    const value = this.intConstant(arg, base, module);
    if (value == undefined) {
      return undefined;
    }

    const double = Number(value);
    if (double < -kDateFieldLimit || double > kDateFieldLimit) {
      return undefined;
    }

    return Math.trunc(double).toInt();
  }

  private validMonth(fields: DateFieldValues, module: int): int | undefined {
    const checked = this.dates.validMonth(fields);

    this.reportFound(module, checked.error);

    return checked.value;
  }
}
