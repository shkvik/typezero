import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import {
  CallExpr,
  ExprKind,
  MemberExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import {
  FunctionParameter,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import {
  kAllSettledName,
  kAnyName,
  kCatchName,
  kFinallyName,
  kRejectName,
  kThenName,
} from "../../../code/expression-types/const/expression-types.const.tz";
import { kPromiseClass } from "../../library-rules/const/library-rules.const.tz";
import { kResultMethods } from "../../result-rules/const/result-rules.const.tz";

partial class ExpressionTypes {
  private promiseMisuse(
    expr: CallExpr,
    member: MemberExpr,
    object: Type,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const name = member.name;
    const loc = member.loc;

    switch (name) {
      case kCatchName:
        this.errors.write(module, loc, Code.PromiseNoCatch, kNoDetails);
        const args = tree.argumentsOf(expr.argsList);

        this.looseArguments(args, module);

        return true;
      case kFinallyName:
        this.errors.write(module, loc, Code.PromiseNoFinally, kNoDetails);
        const argsItem = tree.argumentsOf(expr.argsList);

        this.looseArguments(argsItem, module);

        return true;
      case kThenName:
        return this.thenTwoCheck(expr, module);
      default:
        if (this.resultOnPromiseCheck(expr, member, object, module)) {
          return true;
        }

        return this.promiseMissing(member, object, module);
    }
  }

  private resultOnPromiseCheck(
    expr: CallExpr,
    member: MemberExpr,
    object: Type,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    if (object.kind != TypeKind.Promise) {
      return false;
    }

    const value = this.types.definedType(this.types.store.valueOf(object));
    const isMethod = kResultMethods.some((one) => one.name == member.name);
    if (value.kind != TypeKind.Result || !isMethod) {
      return false;
    }

    const holder = tree.exprOf(member.objectId);
    const other = this.types.promiseHolderText(holder);

    this.errors.write(module, member.loc, Code.ResultMethodOnPromise, {
      word: member.name,
      other,
    });
    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args, module);

    return true;
  }

  private thenTwoCheck(expr: CallExpr, module: int): boolean {
    const tree = this.types.program.tree;

    const second = tree.argumentsOf(expr.argsList)[1];
    if (second == undefined) {
      return false;
    }

    this.errors.write(
      module,
      tree.exprOf(second.exprId).loc,
      Code.PromiseThenTwo,
      kNoDetails,
    );
    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args, module);

    return true;
  }

  private thenCall(
    expr: CallExpr,
    member: MemberExpr,
    value: Type,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const error = this.types.store.plain(TypeKind.Error);
    const next = tree.argumentsOf(expr.argsList)[0];
    const count = tree.argumentsOf(expr.argsList).length;
    if (count != 1 || next == undefined) {
      const word = this.types.argumentCountText(1, 1, false);

      this.errors.write(module, member.loc, Code.ArgumentCount, {
        word,
        other: `${count}`,
      });
      const args = tree.argumentsOf(expr.argsList);

      this.looseArguments(args, module);

      return error;
    }
    const nextExpr = tree.exprOf(next.exprId);
    if (nextExpr.kind == ExprKind.Undefined) {
      return this.types.store.promiseOf(value);
    }

    const params: FunctionParameter[] = [];

    if (value.kind != TypeKind.Void) {
      params.push({ type: value, optional: false });
    }

    const signature = this.types.store.functionOf({
      params,
      rest: false,
      result: error,
    });
    const exprExpr = tree.exprOf(next.exprId);
    const given = this.typed(exprExpr, signature, module);
    if (given.kind == TypeKind.Error) {
      return error;
    }
    if (given.kind != TypeKind.Function) {
      this.errors.write(
        module,
        tree.exprOf(next.exprId).loc,
        Code.CallbackNotFunction,
        {
          word: member.name,
          first: this.types.typeText(given),
        },
      );

      return error;
    }

    const returned = this.thenResult(this.types.store.returnTypeOf(given));
    if (returned.kind == TypeKind.Error) {
      return error;
    }
    if (returned.kind == TypeKind.Never) {
      return this.types.store.promiseOf(value);
    }

    return this.types.store.promiseOf(returned);
  }

  private readonly thenResult(returned: Type): Type {
    if (returned.kind == TypeKind.Promise) {
      return this.types.store.valueOf(returned);
    }

    return returned;
  }

  private promiseMissing(
    member: MemberExpr,
    object: Type,
    module: int,
  ): boolean {
    const receiver = this.libraryReceiver(object);
    if (receiver == undefined) {
      return false;
    }

    const found = this.receiverMember(receiver, member.name, true);
    if (found != undefined) {
      return false;
    }

    const word = member.name;
    const first = this.types.typeText(object);

    this.errors.write(module, member.loc, Code.PromiseNoMethod, {
      word,
      first,
    });

    return true;
  }

  private promiseStatic(member: MemberExpr, module: int): boolean {
    const tree = this.types.program.tree;

    const object = tree.exprOf(member.objectId);
    if (object.kind != ExprKind.Name || object.name != kPromiseClass) {
      return false;
    }

    const target = this.targetOfName(object, module);
    if (target == undefined || !this.types.isLibraryModule(target.module)) {
      return false;
    }

    const loc = member.loc;

    switch (member.name) {
      case kRejectName:
        this.errors.write(module, loc, Code.PromiseRejected, kNoDetails);

        return true;
      case kAllSettledName:
        this.errors.write(module, loc, Code.PromiseAllSettled, kNoDetails);

        return true;
      case kAnyName:
        this.errors.write(module, loc, Code.PromiseAny, kNoDetails);

        return true;
      default:
        return this.promiseMissingCheck(member, module);
    }
  }

  private promiseMissingCheck(member: MemberExpr, module: int): boolean {
    const checked = this.types.promiseMissingCheck(member);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }
}
