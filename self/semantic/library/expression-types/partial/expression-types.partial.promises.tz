import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import {
  CallExpr,
  ExprKind,
  MemberExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import {
  FunctionParameter,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import {
  kAllSettledName,
  kAnyName,
  kCatchName,
  kFinallyName,
  kRejectName,
  kThenName,
} from "../../../code/expression-types/const/expression-types.const.tz";
import { kPromiseClass } from "../../library-rules/const/library-rules.const.tz";
import { kResultMethods } from "../../result-rules/const/result-rules.const.tz";

partial class ExpressionTypes {
  private readonly promiseMisuse(
    expr: CallExpr,
    member: MemberExpr,
    object: Type,
    module: int,
  ): boolean {
    const name = member.name;
    const loc = member.loc;

    switch (name) {
      case kCatchName:
        this.report(module, loc, Code.PromiseNoCatch, kNoDetails);
        this.looseArguments(expr.args, module);

        return true;
      case kFinallyName:
        this.report(module, loc, Code.PromiseNoFinally, kNoDetails);
        this.looseArguments(expr.args, module);

        return true;
      case kThenName:
        return this.thenTwoCheck(expr, module);
      default:
        if (this.resultOnPromiseCheck(expr, member, object, module)) {
          return true;
        }

        return this.promiseMissing(member, object, module);
    }
  }

  private readonly resultOnPromiseCheck(
    expr: CallExpr,
    member: MemberExpr,
    object: Type,
    module: int,
  ): boolean {
    if (object.kind != TypeKind.Promise) {
      return false;
    }

    const value = this.types.definedType(object.value);
    const isMethod = kResultMethods.some((one) => one.name == member.name);
    if (value.kind != TypeKind.Result || !isMethod) {
      return false;
    }

    const holder = member.object;
    const other = this.library.promiseHolderText(holder);

    this.report(module, member.loc, Code.ResultMethodOnPromise, {
      word: member.name,
      other,
    });
    this.looseArguments(expr.args, module);

    return true;
  }

  private readonly thenTwoCheck(expr: CallExpr, module: int): boolean {
    const second = expr.args[1];
    if (second == undefined) {
      return false;
    }

    this.report(module, second.expr.loc, Code.PromiseThenTwo, kNoDetails);
    this.looseArguments(expr.args, module);

    return true;
  }

  private readonly thenCall(
    expr: CallExpr,
    member: MemberExpr,
    value: Type,
    module: int,
  ): Type {
    const error = this.store.plain(TypeKind.Error);
    const next = expr.args[0];
    const count = expr.args.length;
    if (count != 1 || next == undefined) {
      const word = this.calls.argumentCountText(1, 1, false);

      this.report(module, member.loc, Code.ArgumentCount, {
        word,
        other: `${count}`,
      });
      this.looseArguments(expr.args, module);

      return error;
    }
    if (next.expr.kind == ExprKind.Undefined) {
      return this.store.promiseOf(value);
    }

    const params: FunctionParameter[] = [];

    if (value.kind != TypeKind.Void) {
      params.push({ type: value, optional: false });
    }

    const signature = this.store.functionOf({
      params,
      rest: false,
      result: error,
    });
    const given = this.typed(next.expr, signature, module);
    if (given.kind == TypeKind.Error) {
      return error;
    }
    if (given.kind != TypeKind.Function) {
      this.report(module, next.expr.loc, Code.CallbackNotFunction, {
        word: member.name,
        first: this.text.of(given),
      });

      return error;
    }

    const returned = this.thenResult(given.shape.result);
    if (returned.kind == TypeKind.Error) {
      return error;
    }
    if (returned.kind == TypeKind.Never) {
      return this.store.promiseOf(value);
    }

    return this.store.promiseOf(returned);
  }

  private readonly thenResult(returned: Type): Type {
    if (returned.kind == TypeKind.Promise) {
      return returned.value;
    }

    return returned;
  }

  private readonly promiseMissing(
    member: MemberExpr,
    object: Type,
    module: int,
  ): boolean {
    const receiver = this.libraryReceiver(object);
    if (receiver == undefined) {
      return false;
    }

    const found = this.receiverMember(receiver, member.name, true);
    if (found != undefined) {
      return false;
    }

    const word = member.name;
    const first = this.text.of(object);

    this.report(module, member.loc, Code.PromiseNoMethod, { word, first });

    return true;
  }

  private readonly promiseStatic(member: MemberExpr, module: int): boolean {
    const object = member.object;
    if (object.kind != ExprKind.Name || object.name != kPromiseClass) {
      return false;
    }

    const target = this.targetOfName(object, module);
    if (target == undefined || !this.modules.isLibraryModule(target.module)) {
      return false;
    }

    const loc = member.loc;

    switch (member.name) {
      case kRejectName:
        this.report(module, loc, Code.PromiseRejected, kNoDetails);

        return true;
      case kAllSettledName:
        this.report(module, loc, Code.PromiseAllSettled, kNoDetails);

        return true;
      case kAnyName:
        this.report(module, loc, Code.PromiseAny, kNoDetails);

        return true;
      default:
        return this.promiseMissingCheck(member, module);
    }
  }

  private readonly promiseMissingCheck(member: MemberExpr, module: int): boolean {
    const checked = this.library.promiseMissingCheck(member);

    this.reportFound(module, checked.error);

    return checked.value;
  }
}
