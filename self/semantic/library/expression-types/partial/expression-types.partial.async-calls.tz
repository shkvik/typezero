import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import { kIntervalName } from "../../event-rules/const/event-rules.const.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import {
  CallExpr,
  ExprKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";

partial class ExpressionTypes {
  private timerArgumentsCheck(expr: CallExpr, module: int): void {
    const tree = this.types.program.tree;

    const callee = tree.exprOf(expr.calleeId);
    const isTimer =
      callee.kind == ExprKind.Name &&
      (callee.name == "setTimeout" || callee.name == "setInterval") &&
      this.isGlobalUse(callee, module);
    const callback = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    const isInterval =
      isTimer && callee.kind == ExprKind.Name && callee.name == kIntervalName;
    if (isInterval && callback != undefined) {
      this.listenerLifeCheck(callback, undefined, true, module);
    }

    const extra = tree.exprAt(tree.argumentsOf(expr.argsList)[2]?.exprId);
    if (!isTimer || extra == undefined) {
      return;
    }

    this.errors.write(module, extra.loc, Code.TimerArguments, kNoDetails);
  }

  private uncaughtCheck(expr: CallExpr, module: int): void {
    const tree = this.types.program.tree;

    const callee = tree.exprOf(expr.calleeId);
    const event = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (callee.kind != ExprKind.Member || event == undefined) {
      return;
    }

    const holder = tree.exprOf(callee.objectId);
    const isProcess =
      holder.kind == ExprKind.Name &&
      holder.name == "process" &&
      this.isGlobalUse(holder, module);
    const isUncaught =
      event.kind == ExprKind.StringLit &&
      this.process.isThrownListener(callee.name, event.value);
    if (!isProcess || !isUncaught) {
      return;
    }

    this.errors.write(module, event.loc, Code.NothingToCatch, kNoDetails);
  }
}
