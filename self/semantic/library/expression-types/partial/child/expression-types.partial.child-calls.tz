import {
  ArrayElement,
  CallExpr,
  Expr,
  ExprKind,
  UnaryOp,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import { TypeKind } from "../../../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import { FsCall, FsShape } from "../../../fs-rules/types/fs-rules.types.tz";

partial class ExpressionTypes {
  private childCallCheck(expr: CallExpr, module: int): void {
    const tree = this.types.program.tree;

    const callee = tree.exprOf(expr.calleeId);
    if (callee.kind != ExprKind.Name || this.types.isLibraryModule(module)) {
      return;
    }
    if (
      tree.argumentsOf(expr.argsList).some((one) => one.spread) ||
      tree.argumentsOf(expr.argsList).length == 0
    ) {
      return;
    }

    const target = this.targetOfName(callee, module);
    const opened = this.types.program.modules[target?.module ?? -1];
    if (target == undefined || target.kind != SymbolKind.Function) {
      return;
    }
    if (opened == undefined || !this.types.isChildModule(opened.name)) {
      return;
    }
    if (!this.types.isRun(callee.name)) {
      return;
    }

    this.childRunCheck(expr, callee.name, module);
  }

  private childRunCheck(expr: CallExpr, name: string, module: int): void {
    const tree = this.types.program.tree;

    const isExec = this.types.isExec(name);
    const file = tree.argumentsOf(expr.argsList)[0];
    const list = tree.argumentsOf(expr.argsList)[1];
    if (file == undefined) {
      return;
    }

    const exprExpr = tree.exprOf(file.exprId);

    this.childFileCheck(exprExpr, isExec, module);
    const isList =
      !isExec &&
      list != undefined &&
      tree.exprOf(list.exprId).kind != ExprKind.ObjectLit;
    const later = tree.argumentsOf(expr.argsList)[2];
    if (!isExec && !isList && later != undefined) {
      const optionsAtError = this.types.optionsAtError(
        tree.exprOf(later.exprId).loc,
        name,
      );

      return this.errors.writeFound(module, optionsAtError);
    }
    const listExpr = tree.exprAt(list?.exprId);
    if (isList && listExpr != undefined && listExpr.kind == ExprKind.ArrayLit) {
      const elements = tree.elementsOf(listExpr.elementsList);

      this.childZeroCheck(elements, module);
    }

    const index = this.childOptionsAt(isList);
    const options = this.tables.childOptions().slice();
    const row: FsCall = {
      name,
      shape: FsShape.PathOnly,
      options,
      isUtf8Only: false,
    };
    if (!this.fsOptionsCheck(expr, index, row, module)) {
      return;
    }

    this.childOptionsCheck(expr, index, name, isExec, module);
  }

  private readonly childOptionsAt(isList: boolean): int {
    if (isList) {
      return 2;
    }

    return 1;
  }

  private childFileCheck(file: Expr, isExec: boolean, module: int): boolean {
    if (file.kind != ExprKind.StringLit) {
      return true;
    }
    if (file.value.includes("\u0000")) {
      this.errors.writeFound(
        module,
        this.types.zeroFileError(file.loc, isExec),
      );

      return false;
    }
    if (file.value == "" && !isExec) {
      this.errors.writeFound(module, this.types.emptyNameError(file.loc));

      return false;
    }

    return true;
  }

  private childZeroCheck(elements: Read<ArrayElement[]>, module: int): boolean {
    const tree = this.types.program.tree;

    let isFine = true;

    for (let index = 0; index < elements.length; index++) {
      const element = elements[index];
      if (element == undefined || element.spread) {
        continue;
      }

      const value = tree.exprOf(element.exprId);
      if (value.kind == ExprKind.StringLit && value.value.includes("\u0000")) {
        this.errors.writeFound(
          module,
          this.types.zeroArgError(value.loc, index),
        );

        isFine = false;
      }
    }

    return isFine;
  }

  private childOptionsCheck(
    expr: CallExpr,
    index: int,
    name: string,
    isExec: boolean,
    module: int,
  ): void {
    const encoding = this.fsOptionValue(expr, index, "encoding");
    const isBuffer = this.childEncodingCheck(encoding, name, module);

    this.childStdioCheck(expr, index, name, module);
    this.childLimitsCheck(expr, index, module);
    this.childInputCheck(expr, index, name, isBuffer, module);
    this.childSignalCheck(expr, index, module);
    this.childShellCheck(expr, index, name, isExec, module);
  }

  private childEncodingCheck(
    encoding: Expr | undefined,
    name: string,
    module: int,
  ): boolean {
    if (encoding == undefined || encoding.kind == ExprKind.Undefined) {
      return true;
    }
    if (encoding.kind != ExprKind.StringLit) {
      this.errors.writeFound(
        module,
        this.types.childEncodingError(encoding.loc, name),
      );

      return false;
    }
    if (this.types.isBufferMarker(encoding.value)) {
      return true;
    }

    const unknownError = this.types.encodingError(encoding.loc, [
      encoding.value,
    ]);

    this.errors.writeFound(module, unknownError);

    return false;
  }

  private childStdioCheck(
    expr: CallExpr,
    index: int,
    name: string,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const stdio = this.fsOptionValue(expr, index, "stdio");
    if (stdio == undefined || stdio.kind == ExprKind.Undefined) {
      return;
    }
    if (stdio.kind == ExprKind.StringLit) {
      const kindError = this.types.stdioKindError(stdio.loc, stdio);

      return this.errors.writeFound(module, kindError);
    }
    if (stdio.kind != ExprKind.ArrayLit) {
      return this.errors.writeFound(
        module,
        this.types.stdioError(stdio.loc, name),
      );
    }

    const fourth = tree.elementsOf(stdio.elementsList)[3];
    if (fourth != undefined) {
      this.errors.writeFound(
        module,
        this.types.threeError(tree.exprOf(fourth.exprId).loc),
      );
    }

    for (const element of tree.elementsOf(stdio.elementsList).slice(0, 3)) {
      const entryError = this.types.stdioEntryError(element);
      if (entryError != undefined) {
        this.errors.writeFound(module, entryError);
      }
    }
  }

  private childLimitsCheck(expr: CallExpr, index: int, module: int): void {
    const directory = this.fsOptionValue(expr, index, "cwd");
    const isZero =
      directory != undefined &&
      directory.kind == ExprKind.StringLit &&
      directory.value.includes("\u0000");
    if (isZero && directory != undefined) {
      this.errors.writeFound(module, this.types.zeroCwdError(directory.loc));
    }

    for (const limit of ["timeout", "maxBuffer"]) {
      const value = this.fsOptionValue(expr, index, limit);
      if (value != undefined && this.isNegativeNumber(value)) {
        this.errors.writeFound(
          module,
          this.types.negativeError(value.loc, limit),
        );
      }
    }

    const signal = this.fsOptionValue(expr, index, "killSignal");
    if (signal == undefined || signal.kind != ExprKind.StringLit) {
      return;
    }
    if (!this.types.isSignal(signal.value)) {
      this.errors.writeFound(
        module,
        this.types.noSignalError(signal.loc, signal.value),
      );
    }
  }

  private readonly isNegativeNumber(value: Expr): boolean {
    const tree = this.types.program.tree;

    if (value.kind != ExprKind.Unary || value.op != UnaryOp.Neg) {
      return false;
    }

    const operand = tree.exprOf(value.operandId);

    return operand.kind == ExprKind.IntLit || operand.kind == ExprKind.FloatLit;
  }

  private childInputCheck(
    expr: CallExpr,
    index: int,
    name: string,
    isBuffer: boolean,
    module: int,
  ): void {
    const input = this.fsOptionValue(expr, index, "input");
    if (input == undefined) {
      return;
    }

    const given = this.peekType(input, module);
    const base = this.types.definedType(given);
    if (base.kind == TypeKind.Error) {
      return;
    }

    const isText = this.types.isTextLike(base);
    if (!isText && !this.types.isByteView(base)) {
      const inputError = this.types.inputError(input.loc, name, given);

      return this.errors.writeFound(module, inputError);
    }

    const encoding = this.fsOptionValue(expr, index, "encoding");
    const isMarked =
      encoding != undefined &&
      encoding.kind == ExprKind.StringLit &&
      this.types.isBufferMarker(encoding.value);
    if (isText && isMarked && isBuffer) {
      this.errors.writeFound(module, this.types.bufferTextError(input.loc));
    }
  }

  private childSignalCheck(expr: CallExpr, index: int, module: int): void {
    const signal = this.fsOptionValue(expr, index, "killSignal");
    if (signal == undefined) {
      return;
    }

    const given = this.peekType(signal, module);
    const base = this.types.definedType(given);
    const isFitting =
      this.types.isTextLike(base) ||
      base.kind == TypeKind.Int ||
      base.kind == TypeKind.Error ||
      this.types.isIntlNumberLike(base);
    if (!isFitting) {
      this.errors.writeFound(
        module,
        this.types.killSignalError(signal.loc, given),
      );
    }
  }

  private childShellCheck(
    expr: CallExpr,
    index: int,
    name: string,
    isExec: boolean,
    module: int,
  ): void {
    const shell = this.fsOptionValue(expr, index, "shell");
    if (shell == undefined) {
      return;
    }

    const given = this.peekType(shell, module);
    const base = this.types.definedType(given);
    if (this.types.isTextLike(base) || base.kind == TypeKind.Error) {
      return;
    }

    const isFlag = this.types.isFlagType(base);
    const isLiteral = shell.kind == ExprKind.BoolLit;
    if (isFlag && isExec) {
      const isTrue = isLiteral && shell.kind == ExprKind.BoolLit && shell.value;
      if (!isTrue) {
        this.errors.writeFound(module, this.types.execShellError(shell.loc));
      }

      return;
    }
    if (isFlag && !isLiteral) {
      this.errors.writeFound(
        module,
        this.types.shellFlagError(shell.loc, name),
      );

      return;
    }
    if (!isFlag) {
      this.errors.writeFound(module, this.types.shellError(shell.loc, given));
    }
  }
}
