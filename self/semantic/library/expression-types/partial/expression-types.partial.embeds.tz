import { Code } from "../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import {
  CallExpr,
  ExprKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import {
  kEmbedNames,
  kEmbedTextName,
  kMissingFileReason,
} from "../../library-rules/const/library-rules.const.tz";

partial class ExpressionTypes {
  private embedCheck(expr: CallExpr, module: int): void {
    const tree = this.types.program.tree;

    const callee = tree.exprOf(expr.calleeId);
    if (callee.kind != ExprKind.Name || this.types.isLibraryModule(module)) {
      return;
    }

    const name = callee.name;
    const isEmbed =
      kEmbedNames.includes(name) && this.isGlobalUse(callee, module);
    const hasSpread = tree.argumentsOf(expr.argsList).some((one) => one.spread);
    if (!isEmbed || hasSpread) {
      return;
    }

    const count = tree.argumentsOf(expr.argsList).length;
    const path = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (count != 1 || path == undefined) {
      const word = this.types.argumentCountText(1, 1, false);

      return this.errors.write(module, callee.loc, Code.ArgumentCount, {
        word,
        other: `${count}`,
      });
    }

    const other = this.embedExample(name);
    const shown = this.constantText(path);
    if (shown == undefined) {
      return this.errors.write(module, path.loc, Code.EmbedLiteral, {
        word: name,
        other,
      });
    }
    if (shown.includes("\\")) {
      return this.errors.write(
        module,
        path.loc,
        Code.EmbedBackslash,
        kNoDetails,
      );
    }
    if (!this.isRelativePath(shown)) {
      return this.errors.write(module, path.loc, Code.EmbedRelative, {
        word: name,
        other,
      });
    }

    const home = this.types.program.modules[module]?.source.path ?? "";
    const size = this.embedded.sizeOf(home, shown);
    if (size == undefined) {
      this.errors.write(module, path.loc, Code.EmbedUnread, {
        word: shown,
        other: kMissingFileReason,
      });
    }
  }

  private readonly embedExample(name: string): string {
    if (name == kEmbedTextName) {
      return `${name}("./page.html")`;
    }

    return `${name}("./data.json")`;
  }

  private readonly isRelativePath(path: string): boolean {
    if (path == "" || path.startsWith("/")) {
      return false;
    }

    const drive = path.slice(1, 3);

    return drive != ":/";
  }
}
