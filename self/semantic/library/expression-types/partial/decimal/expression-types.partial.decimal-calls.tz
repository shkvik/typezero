import { ProofRange } from "../../../../flow/proof-rules/types/proof-rules.types.tz";
import {
  kBaseRange,
  kDigitsRange,
  kPlacesRange,
  kPositivePlacesMethods,
  kPositivePlacesRange,
  kPowerRange,
} from "../../../decimal-rules/const/decimal-rules.const.ranges.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  AssignExpr,
  BinaryOp,
  CallArgument,
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  NameExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  LiteralKind,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { DecimalText } from "../../../decimal-text/decimal-text.tz";
import {
  kDecimalError,
  kDecimalMethods,
  kDecimalName,
  kMathName,
  kNoPlace,
  kRoundingModes,
} from "../../../../code/expression-types/const/expression-types.const.tz";
import { DecimalArgument } from "../../../../code/expression-types/types/expression-types.types.tz";
import { kDecimalStatics } from "../../../decimal-rules/const/decimal-rules.const.tz";

partial class ExpressionTypes {
  private readonly isDecimalName(expr: Expr, module: int): boolean {
    if (expr.kind != ExprKind.Name || expr.name != kDecimalName) {
      return false;
    }

    return this.isGlobalUse(expr, module);
  }

  private decimalOfCall(expr: CallExpr, callee: NameExpr, module: int): Type {
    const tree = this.types.program.tree;

    const error = this.types.store.plain(TypeKind.Error);
    const arg = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (arg == undefined || tree.argumentsOf(expr.argsList).length != 1) {
      this.errors.write(module, callee.loc, Code.ArgumentCount, {
        word: this.types.argumentCountText(1, 1, false),
        other: `${tree.argumentsOf(expr.argsList).length}`,
      });

      return error;
    }

    const hint = this.types.decimalOfHint(arg);
    const type = this.typed(arg, hint, module);
    const base = this.types.apparent(this.types.definedType(type));
    if (type.kind == TypeKind.Error) {
      return error;
    }
    if (this.types.isDecimalTextType(type)) {
      return this.decimalOfText(arg, type, module);
    }

    const isNumber =
      base.kind == TypeKind.Int ||
      base.kind == TypeKind.Double ||
      base.kind == TypeKind.Decimal;
    if (isNumber && !this.types.isOptional(type)) {
      return this.types.decimalType();
    }

    this.errors.write(module, arg.loc, Code.DecimalOfType, {
      word: this.types.typeText(type),
      place: this.types.maybePlace(this.types.isOptional(type)),
    });

    return error;
  }

  private decimalOfText(arg: Expr, type: Type, module: int): Type {
    const texts = this.knownTextsOf(arg, type, module);
    if (texts == undefined) {
      const failure = this.types.libraryShape(kDecimalError, []);
      if (failure == undefined) {
        return this.types.store.plain(TypeKind.Error);
      }

      return this.types.store.resultOf(this.types.decimalType(), failure);
    }

    const reader = new DecimalText();
    const wrong = texts.find((text) => !reader.isNumber(text));
    if (wrong != undefined) {
      this.errors.write(module, arg.loc, Code.DecimalNotNumber, {
        word: wrong,
      });

      return this.types.store.plain(TypeKind.Error);
    }

    return this.types.decimalType();
  }

  private knownTextsOf(
    arg: Expr,
    type: Type,
    module: int,
  ): string[] | undefined {
    const tree = this.types.program.tree;

    if (arg.kind == ExprKind.StringLit) {
      return [arg.value];
    }
    if (
      arg.kind == ExprKind.Template &&
      tree.exprsOf(arg.exprsList).length == 0
    ) {
      return tree.textsOf(arg.quasisList).slice(0, 1);
    }
    if (type.kind == TypeKind.Literal && type.literal == LiteralKind.String) {
      return [type.text];
    }
    if (type.kind == TypeKind.Union && this.types.isDecimalTextType(type)) {
      return this.types.store
        .partsOf(type)
        .map((part) => this.types.literalPartText(part));
    }
    if (arg.kind == ExprKind.Name) {
      return this.doorTextsOfName(arg, module);
    }
    if (arg.kind == ExprKind.Conditional) {
      const first = this.branchTexts(
        tree.exprOf(arg.condId),
        tree.exprOf(arg.thenExprId),
        true,
        module,
      );
      const second = this.branchTexts(
        tree.exprOf(arg.condId),
        tree.exprOf(arg.elseExprId),
        false,
        module,
      );
      if (first == undefined || second == undefined) {
        return undefined;
      }

      return first.concat(second);
    }

    return undefined;
  }

  private branchTexts(
    cond: Expr,
    branch: Expr,
    isTrue: boolean,
    module: int,
  ): string[] | undefined {
    this.errors.beginTrial();

    const facts = this.factsOf(cond, isTrue, module);
    const before = this.underFacts(facts);
    const type = this.typed(branch, undefined, module);
    const texts = this.knownTextsOf(branch, type, module);

    this.facts = before;
    this.errors.endTrial();

    return texts;
  }

  private decimalStaticCall(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const object = tree.exprOf(member.objectId);
    if (!this.isDecimalName(object, module)) {
      return undefined;
    }

    const error = this.types.store.plain(TypeKind.Error);
    const name = member.name;
    if (!kDecimalStatics.includes(name)) {
      const decimalStaticMissingError =
        this.types.decimalStaticMissingError(member);

      this.errors.writeFound(module, decimalStaticMissingError);
      const args = tree.argumentsOf(expr.argsList);

      this.looseArguments(args, module);

      return error;
    }

    let isFitting = true;
    let hasValue = false;

    for (const arg of tree.argumentsOf(expr.argsList)) {
      if (!arg.spread) {
        this.checked(
          tree.exprOf(arg.exprId),
          this.types.decimalType(),
          module,
          kNoPlace,
        );

        hasValue = true;

        continue;
      }

      const isSpread = this.decimalSpreadCheck(arg, module);

      isFitting = isFitting && isSpread;
      hasValue =
        hasValue || this.isFilledSource(tree.exprOf(arg.exprId), module);
    }

    if (!isFitting) {
      return error;
    }

    const isSum = name == "sum";
    if (tree.argumentsOf(expr.argsList).length == 0 && !isSum) {
      this.errors.write(module, member.loc, Code.DecimalNoValue, {
        word: name,
      });

      return error;
    }
    if (hasValue || isSum) {
      return this.types.decimalType();
    }

    return this.types.optional(this.types.decimalType());
  }

  private decimalSpreadCheck(arg: CallArgument, module: int): boolean {
    const tree = this.types.program.tree;

    const list = this.types.store.arrayOf(this.types.decimalType());
    const expr = tree.exprOf(arg.exprId);
    const type = this.typed(expr, list, module);
    if (type.id == list.id || type.kind == TypeKind.Error) {
      return true;
    }

    this.errors.write(
      module,
      tree.exprOf(arg.exprId).loc,
      Code.DecimalSpreadNotDecimals,
      {
        word: this.types.typeText(type),
      },
    );

    return false;
  }

  private decimalStaticRead(expr: MemberExpr, module: int): Type {
    const checked = this.types.decimalStaticRead(expr);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private decimalMethodCall(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const error = this.types.store.plain(TypeKind.Error);
    const name = member.name;
    const method = kDecimalMethods.find((one) => one.name == name);
    if (method == undefined) {
      this.errors.write(module, member.loc, Code.DecimalMethodMissing, {
        word: name,
        place: this.types.decimalMissingHint(name),
      });
      const argsItem = tree.argumentsOf(expr.argsList);

      this.looseArguments(argsItem, module);

      return error;
    }

    const count = tree.argumentsOf(expr.argsList).length;
    if (name == "decimalPlaces" && count > 0) {
      this.errors.write(module, member.loc, Code.DecimalPlacesOnly, kNoDetails);
      const exprArgs = tree.argumentsOf(expr.argsList);

      this.looseArguments(exprArgs, module);

      return error;
    }
    if (count < method.least || count > method.most) {
      this.errors.write(module, member.loc, Code.ArgumentCount, {
        word: this.types.argumentCountText(method.least, method.most, false),
        other: `${count}`,
      });

      return error;
    }

    for (let index = 0; index < count; index++) {
      const arg = tree.exprAt(tree.argumentsOf(expr.argsList)[index]?.exprId);
      const kind = method.args[index];
      if (arg != undefined && kind != undefined) {
        this.decimalArgument(arg, kind, name, module);
      }
    }

    const divisor = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (name == "div" && divisor != undefined) {
      this.decimalZeroCheck(divisor, module);
    }

    return this.types.decimalMethodResult(method);
  }

  private decimalArgument(
    arg: Expr,
    kind: DecimalArgument,
    method: string,
    module: int,
  ): void {
    switch (kind) {
      case DecimalArgument.Decimal:
        this.checked(arg, this.types.decimalType(), module, kNoPlace);

        return;
      case DecimalArgument.Places:
        return this.decimalCount(arg, this.placesRange(method), module);
      case DecimalArgument.Digits:
        return this.decimalCount(arg, kDigitsRange, module);
      case DecimalArgument.Base:
        return this.decimalCount(arg, kBaseRange, module);
      case DecimalArgument.Power:
        return this.decimalCount(arg, kPowerRange, module);
      default:
        return this.roundingModeCheck(arg, module);
    }
  }

  private readonly placesRange(method: string): ProofRange {
    if (kPositivePlacesMethods.includes(method)) {
      return kPositivePlacesRange;
    }

    return kPlacesRange;
  }

  private decimalCount(arg: Expr, range: ProofRange, module: int): void {
    const int = this.types.store.integer(64, false);
    const type = this.typed(arg, int, module);
    const base = this.types.apparent(type);
    if (type.kind == TypeKind.Error) {
      return;
    }
    if (base.kind == TypeKind.Int && !this.types.isOptional(type)) {
      this.requireBetween(arg, type, range, module);

      return;
    }

    this.errors.write(module, arg.loc, Code.DecimalCountType, {
      word: range.what,
      first: this.types.typeText(type),
      place: this.types.maybePlace(this.types.isOptional(type)),
    });
  }

  private roundingModeCheck(arg: Expr, module: int): void {
    const string = this.types.store.plain(TypeKind.String);
    const type = this.checked(arg, string, module, kNoPlace);
    if (type.kind == TypeKind.Error) {
      return;
    }

    const modes = this.knownTextsOf(arg, type, module);
    if (modes == undefined) {
      this.errors.write(module, arg.loc, Code.RoundingModeRuntime, kNoDetails);

      return;
    }

    const unknown = modes.find((mode) => !kRoundingModes.includes(mode));
    if (unknown != undefined) {
      this.errors.write(module, arg.loc, Code.RoundingModeUnknown, {
        word: unknown,
      });
    }
  }

  private decimalRangeCheck(expr: Expr, module: int): void {
    if (expr.kind != ExprKind.FloatLit) {
      return;
    }

    const span = expr.text;
    const source = this.types.program.modules[module]?.source.text;
    if (span == undefined || source == undefined) {
      return;
    }

    const text = source.toString("utf8", span.start, span.end);
    const top = this.types.decimalTop(text);
    if (top != undefined && top > 10000000) {
      this.errors.write(module, expr.loc, Code.DecimalOutOfRange, kNoDetails);
    }
  }

  private mathDecimalCheck(expr: CallExpr, module: int): boolean {
    const tree = this.types.program.tree;

    const callee = tree.exprOf(expr.calleeId);
    if (callee.kind != ExprKind.Member) {
      return false;
    }

    const holder = tree.exprOf(callee.objectId);
    const isMath =
      holder.kind == ExprKind.Name &&
      holder.name == kMathName &&
      this.isGlobalUse(holder, module);
    if (!isMath) {
      return false;
    }

    for (const arg of tree.argumentsOf(expr.argsList)) {
      const exprExpr = tree.exprOf(arg.exprId);
      const type = this.peekType(exprExpr, module);

      if (!arg.spread && this.types.apparent(type).kind == TypeKind.Decimal) {
        this.errors.write(
          module,
          tree.exprOf(arg.exprId).loc,
          Code.MathArgumentDecimal,
          {
            word: this.types.typeText(type),
          },
        );
        const args = tree.argumentsOf(expr.argsList);

        this.looseArguments(args, module);

        return true;
      }
    }

    return false;
  }

  private decimalAssignCheck(
    expr: AssignExpr,
    tested: Type,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const isDividing = expr.op == BinaryOp.Div || expr.op == BinaryOp.Rem;
    if (isDividing && this.types.apparent(tested).kind == TypeKind.Decimal) {
      const value = tree.exprOf(expr.valueId);

      this.decimalZeroCheck(value, module);
    }
  }

  private decimalZeroCheck(divisor: Expr, module: int): void {
    const value = this.plainConstant(divisor, module);
    const isZero = value != undefined && value == 0;
    if (isZero || this.types.isZeroLiteral(divisor)) {
      this.errors.write(
        module,
        divisor.loc,
        Code.DecimalDivisionByZero,
        kNoDetails,
      );
    }
  }
}
