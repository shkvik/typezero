import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import {
  BinaryExpr,
  BinaryOp,
  Expr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { OperandPair } from "../../../../code/expression-types/types/expression-types.types.tz";

partial class ExpressionTypes {
  private decimalResult(
    expr: BinaryExpr,
    pair: OperandPair,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    if (expr.op == BinaryOp.Pow) {
      return this.decimalPower(expr, pair, module);
    }

    const isLeftFitting = this.isDecimalSide(
      tree.exprOf(expr.lhsId),
      pair.left,
      module,
    );
    const isRightFitting = this.isDecimalSide(
      tree.exprOf(expr.rhsId),
      pair.right,
      module,
    );
    if (!isLeftFitting || !isRightFitting) {
      const decimalMixError = this.types.decimalMixError(expr, pair, module);

      this.errors.writeFound(module, decimalMixError);

      return this.types.store.plain(TypeKind.Error);
    }

    this.decimalDivisor(expr, pair.right, module);

    return this.types.store.plain(TypeKind.Decimal);
  }

  private isDecimalSide(side: Expr, type: Type, module: int): boolean {
    if (type.kind == TypeKind.Decimal) {
      return true;
    }

    return type.kind == TypeKind.Int && this.isWholeTree(side, module);
  }

  private decimalPower(expr: BinaryExpr, pair: OperandPair, module: int): Type {
    const checked = this.types.decimalPower(expr, pair);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private decimalDivisor(expr: BinaryExpr, right: Type, module: int): void {
    const tree = this.types.program.tree;

    const isDividing = expr.op == BinaryOp.Div || expr.op == BinaryOp.Rem;
    if (!isDividing) {
      return;
    }

    const rhs = tree.exprOf(expr.rhsId);

    this.decimalZeroCheck(rhs, module);
  }
}
