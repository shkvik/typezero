import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";
import {
  kIntegerConversions,
  kMathName,
  kRoundingNames,
} from "../../../code/expression-types/const/expression-types.const.tz";

partial class ExpressionTypes {
  private doubleConversionCheck(
    member: MemberExpr,
    object: Type,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const base = this.types.apparent(object);
    if (base.kind != TypeKind.Double) {
      return false;
    }

    const objectExpr = tree.exprOf(member.objectId);
    const word = this.types.operandName(objectExpr);
    if (member.name == "toDecimal") {
      this.errors.write(module, member.loc, Code.DoubleToDecimal, { word });

      return true;
    }
    if (!kIntegerConversions.includes(member.name)) {
      return false;
    }
    const memberObject = tree.exprOf(member.objectId);
    if (this.isRoundingCall(memberObject, module)) {
      return false;
    }

    this.errors.write(module, member.loc, Code.DoubleUnrounded, {
      word,
      other: member.name,
    });

    return true;
  }

  private readonly isRoundingCall(expr: Expr, module: int): boolean {
    const tree = this.types.program.tree;

    if (expr.kind != ExprKind.Call) {
      return false;
    }

    const callee = tree.exprOf(expr.calleeId);
    if (callee.kind != ExprKind.Member) {
      return false;
    }

    const holder = tree.exprOf(callee.objectId);

    return (
      holder.kind == ExprKind.Name &&
      holder.name == kMathName &&
      kRoundingNames.includes(callee.name) &&
      this.isGlobalUse(holder, module)
    );
  }

  private mathOneTypeCheck(expr: CallExpr, module: int): void {
    const tree = this.types.program.tree;

    const callee = tree.exprOf(expr.calleeId);
    if (callee.kind != ExprKind.Member) {
      return;
    }

    const holder = tree.exprOf(callee.objectId);
    const isMath =
      holder.kind == ExprKind.Name &&
      holder.name == kMathName &&
      this.isGlobalUse(holder, module);
    const isRanged =
      callee.name == "min" || callee.name == "max" || callee.name == "clamp";
    if (!isMath || !isRanged || tree.argumentsOf(expr.argsList).length < 2) {
      return;
    }

    this.errors.beginTrial();

    const types = tree
      .argumentsOf(expr.argsList)
      .map((arg) =>
        this.types.apparent(
          this.typed(tree.exprOf(arg.exprId), undefined, module),
        ),
      );

    this.errors.endTrial();

    const first = tree.argumentsOf(expr.argsList).findIndex(
      (arg) => !this.types.isNumberLiteral(tree.exprOf(arg.exprId)),
    );
    const common = types[first];
    if (common == undefined || !this.types.isMathNumber(common)) {
      return;
    }

    for (
      let index = first + 1;
      index < tree.argumentsOf(expr.argsList).length;
      index++
    ) {
      const arg = tree.exprAt(tree.argumentsOf(expr.argsList)[index]?.exprId);
      const type = types[index];
      if (arg == undefined || type == undefined || type.id == common.id) {
        continue;
      }
      if (!this.types.isMathNumber(type) || this.types.isNumberLiteral(arg)) {
        continue;
      }

      const place = this.types.mathOneHint(arg, type, common);

      this.errors.write(module, arg.loc, Code.MathOneType, {
        first: this.types.typeText(common),
        second: this.types.typeText(type),
        place,
      });

      return;
    }
  }

  private mathSpreadCall(expr: CallExpr, module: int): Type | undefined {
    const tree = this.types.program.tree;

    const callee = tree.exprOf(expr.calleeId);
    if (callee.kind != ExprKind.Member) {
      return undefined;
    }

    const holder = tree.exprOf(callee.objectId);
    const isMath =
      holder.kind == ExprKind.Name &&
      holder.name == kMathName &&
      this.isGlobalUse(holder, module);
    const isRanged = callee.name == "min" || callee.name == "max";
    const isSpread = tree.argumentsOf(expr.argsList).some((arg) => arg.spread);
    if (!isMath || !isRanged || !isSpread) {
      return undefined;
    }

    let common: Type | undefined = undefined;
    let hasValue = false;
    let isNumeric = true;

    for (const arg of tree.argumentsOf(expr.argsList)) {
      if (!arg.spread) {
        const type = this.types.apparent(
          this.typed(tree.exprOf(arg.exprId), undefined, module),
        );

        hasValue = true;
        isNumeric = isNumeric && this.types.isMathNumber(type);

        continue;
      }

      const exprExpr = tree.exprOf(arg.exprId);
      const item = this.spreadNumbers(exprExpr, module);
      if (item == undefined) {
        isNumeric = false;

        continue;
      }
      const argExpr = tree.exprOf(arg.exprId);
      if (this.isFilledSource(argExpr, module)) {
        hasValue = true;
      }
      if (common != undefined && common.id != item.id) {
        this.errors.write(
          module,
          tree.exprOf(arg.exprId).loc,
          Code.MathSpreadType,
          {
            word: callee.name,
            first: this.types.typeText(common),
            second: this.types.typeText(item),
          },
        );

        return this.types.store.plain(TypeKind.Error);
      }

      common = item;
    }

    if (!isNumeric || common == undefined) {
      return this.types.store.plain(TypeKind.Error);
    }
    if (hasValue) {
      return common;
    }

    return this.types.optional(common);
  }

  private spreadNumbers(arg: Expr, module: int): Type | undefined {
    const type = this.typed(arg, undefined, module);
    const base = this.types.apparent(type);
    if (base.kind == TypeKind.Error) {
      return undefined;
    }

    const item = this.mathSpreadItem(base);
    if (item != undefined && item.kind == TypeKind.Error) {
      return undefined;
    }
    if (item != undefined && this.types.isMathNumber(item)) {
      return item;
    }

    this.errors.write(module, arg.loc, Code.MathSpreadNotNumbers, {
      word: this.types.typeText(type),
    });

    return undefined;
  }

  private mathSpreadItem(base: Type): Type | undefined {
    if (base.kind == TypeKind.String || base.kind == TypeKind.Template) {
      return undefined;
    }

    const item = this.iteratedItem(base);
    if (item == undefined) {
      return undefined;
    }

    return this.types.apparent(item);
  }

  private isFilledSource(arg: Expr, module: int): boolean {
    const tree = this.types.program.tree;

    if (arg.kind == ExprKind.ArrayLit) {
      return (
        tree.elementsOf(arg.elementsList).length > 0 &&
        tree.elementsOf(arg.elementsList).every((element) => !element.spread)
      );
    }

    return this.isProvenFilled(arg, module);
  }
}
