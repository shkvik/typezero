import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";
import {
  kIntegerConversions,
  kMathName,
  kRoundingNames,
} from "../../../code/expression-types/const/expression-types.const.tz";

partial class ExpressionTypes {
  private doubleConversionCheck(
    member: MemberExpr,
    object: Type,
    module: int,
  ): boolean {
    const base = this.types.apparent(object);
    if (base.kind != TypeKind.Double) {
      return false;
    }

    const word = this.sources.operandName(member.object);
    if (member.name == "toDecimal") {
      this.report(module, member.loc, Code.DoubleToDecimal, { word });

      return true;
    }
    if (!kIntegerConversions.includes(member.name)) {
      return false;
    }
    if (this.isRoundingCall(member.object, module)) {
      return false;
    }

    this.report(module, member.loc, Code.DoubleUnrounded, {
      word,
      other: member.name,
    });

    return true;
  }

  private isRoundingCall(expr: Expr, module: int): boolean {
    if (expr.kind != ExprKind.Call) {
      return false;
    }

    const callee = expr.callee;
    if (callee.kind != ExprKind.Member) {
      return false;
    }

    const holder = callee.object;

    return (
      holder.kind == ExprKind.Name &&
      holder.name == kMathName &&
      kRoundingNames.includes(callee.name) &&
      this.isGlobalUse(holder, module)
    );
  }

  private mathOneTypeCheck(expr: CallExpr, module: int): void {
    const callee = expr.callee;
    if (callee.kind != ExprKind.Member) {
      return;
    }

    const holder = callee.object;
    const isMath =
      holder.kind == ExprKind.Name &&
      holder.name == kMathName &&
      this.isGlobalUse(holder, module);
    const isRanged =
      callee.name == "min" || callee.name == "max" || callee.name == "clamp";
    if (!isMath || !isRanged || expr.args.length < 2) {
      return;
    }

    this.errors.beginTrial();

    const types = expr.args.map((arg) =>
      this.types.apparent(this.typed(arg.expr, undefined, module)),
    );

    this.errors.endTrial();

    const first = expr.args.findIndex(
      (arg) => !this.shapes.isNumberLiteral(arg.expr),
    );
    const common = types[first];
    if (common == undefined || !this.library.isMathNumber(common)) {
      return;
    }

    for (let index = first + 1; index < expr.args.length; index++) {
      const arg = expr.args[index]?.expr;
      const type = types[index];
      if (arg == undefined || type == undefined || type == common) {
        continue;
      }
      if (
        !this.library.isMathNumber(type) ||
        this.shapes.isNumberLiteral(arg)
      ) {
        continue;
      }

      const place = this.library.mathOneHint(arg, type, common);

      this.report(module, arg.loc, Code.MathOneType, {
        first: this.text.of(common),
        second: this.text.of(type),
        place,
      });

      return;
    }
  }

  private mathSpreadCall(expr: CallExpr, module: int): Type | undefined {
    const callee = expr.callee;
    if (callee.kind != ExprKind.Member) {
      return undefined;
    }

    const holder = callee.object;
    const isMath =
      holder.kind == ExprKind.Name &&
      holder.name == kMathName &&
      this.isGlobalUse(holder, module);
    const isRanged = callee.name == "min" || callee.name == "max";
    const isSpread = expr.args.some((arg) => arg.spread);
    if (!isMath || !isRanged || !isSpread) {
      return undefined;
    }

    let common: Type | undefined = undefined;
    let hasValue = false;
    let isNumeric = true;

    for (const arg of expr.args) {
      if (!arg.spread) {
        const type = this.types.apparent(
          this.typed(arg.expr, undefined, module),
        );

        hasValue = true;
        isNumeric = isNumeric && this.library.isMathNumber(type);

        continue;
      }

      const item = this.spreadNumbers(arg.expr, module);
      if (item == undefined) {
        isNumeric = false;

        continue;
      }
      if (this.isFilledSource(arg.expr, module)) {
        hasValue = true;
      }
      if (common != undefined && common != item) {
        this.report(module, arg.expr.loc, Code.MathSpreadType, {
          word: callee.name,
          first: this.text.of(common),
          second: this.text.of(item),
        });

        return this.store.plain(TypeKind.Error);
      }

      common = item;
    }

    if (!isNumeric || common == undefined) {
      return this.store.plain(TypeKind.Error);
    }
    if (hasValue) {
      return common;
    }

    return this.types.optional(common);
  }

  private spreadNumbers(arg: Expr, module: int): Type | undefined {
    const type = this.typed(arg, undefined, module);
    const base = this.types.apparent(type);
    if (base.kind == TypeKind.Error) {
      return undefined;
    }

    const item = this.mathSpreadItem(base);
    if (item != undefined && item.kind == TypeKind.Error) {
      return undefined;
    }
    if (item != undefined && this.library.isMathNumber(item)) {
      return item;
    }

    this.report(module, arg.loc, Code.MathSpreadNotNumbers, {
      word: this.text.of(type),
    });

    return undefined;
  }

  private mathSpreadItem(base: Type): Type | undefined {
    if (base.kind == TypeKind.String || base.kind == TypeKind.Template) {
      return undefined;
    }

    const item = this.iteratedItem(base);
    if (item == undefined) {
      return undefined;
    }

    return this.types.apparent(item);
  }

  private isFilledSource(arg: Expr, module: int): boolean {
    if (arg.kind == ExprKind.ArrayLit) {
      return (
        arg.elements.length > 0 &&
        arg.elements.every((element) => !element.spread)
      );
    }

    return this.isProvenFilled(arg, module);
  }
}
