import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";
import {
  kBitCounts,
  kBitHalves,
  kBitName,
  kBitWraps,
  kNoPlace,
} from "../../../code/expression-types/const/expression-types.const.tz";

partial class ExpressionTypes {
  private bitCall(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const object = tree.exprOf(member.objectId);
    if (object.kind == ExprKind.Member) {
      return this.wrapFromCall(expr, member, object, module);
    }
    if (!this.isBitName(object, module)) {
      return undefined;
    }

    const halves = kBitHalves.get(member.name);
    if (halves != undefined) {
      return this.bitHalvesCall(expr, halves, module);
    }

    const first = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (first == undefined) {
      return undefined;
    }

    const given = this.typed(first, undefined, module);

    for (const arg of tree.argumentsOf(expr.argsList).slice(1)) {
      const exprExpr = tree.exprOf(arg.exprId);

      this.typed(exprExpr, undefined, module);
    }

    if (kBitCounts.includes(member.name)) {
      return this.types.store.integer(64, false);
    }

    return given;
  }

  private readonly isBitName(expr: Expr, module: int): boolean {
    return (
      expr.kind == ExprKind.Name &&
      expr.name == kBitName &&
      this.isGlobalUse(expr, module)
    );
  }

  private wrapFromCall(
    expr: CallExpr,
    member: MemberExpr,
    object: MemberExpr,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const bits = kBitWraps.get(object.name);
    if (
      !this.isBitName(tree.exprOf(object.objectId), module) ||
      bits == undefined
    ) {
      return undefined;
    }
    if (member.name != "from") {
      return undefined;
    }

    for (const arg of tree.argumentsOf(expr.argsList)) {
      const exprExpr = tree.exprOf(arg.exprId);

      this.typed(exprExpr, undefined, module);
    }

    return this.types.store.wrapping(bits);
  }

  private bitHalvesCall(
    expr: CallExpr,
    halves: Read<string[]>,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const uint64 = this.types.store.integer(64, true);

    for (const arg of tree.argumentsOf(expr.argsList)) {
      const exprExpr = tree.exprOf(arg.exprId);
      const given = this.typed(exprExpr, uint64, module);
      const isWrapping = given.kind == TypeKind.Int && given.wraps;
      if (!isWrapping) {
        const argExpr = tree.exprOf(arg.exprId);

        this.coerce(argExpr, given, uint64, module, kNoPlace);
      }
    }

    const first = halves[0] ?? "";
    const second = halves[1] ?? "";

    return this.types.store.objectOf([
      { name: first, type: uint64, optional: false, readonly: false },
      { name: second, type: uint64, optional: false, readonly: false },
    ]);
  }
}
