import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";
import {
  kBitCounts,
  kBitHalves,
  kBitName,
  kBitWraps,
  kNoPlace,
} from "../../../code/expression-types/const/expression-types.const.tz";

partial class ExpressionTypes {
  private bitCall(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): Type | undefined {
    const object = member.object;
    if (object.kind == ExprKind.Member) {
      return this.wrapFromCall(expr, member, object, module);
    }
    if (!this.isBitName(object, module)) {
      return undefined;
    }

    const halves = kBitHalves.get(member.name);
    if (halves != undefined) {
      return this.bitHalvesCall(expr, halves, module);
    }

    const first = expr.args[0]?.expr;
    if (first == undefined) {
      return undefined;
    }

    const given = this.typed(first, undefined, module);

    for (const arg of expr.args.slice(1)) {
      this.typed(arg.expr, undefined, module);
    }

    if (kBitCounts.includes(member.name)) {
      return this.store.integer(64, false);
    }

    return given;
  }

  private readonly isBitName(expr: Expr, module: int): boolean {
    return (
      expr.kind == ExprKind.Name &&
      expr.name == kBitName &&
      this.isGlobalUse(expr, module)
    );
  }

  private wrapFromCall(
    expr: CallExpr,
    member: MemberExpr,
    object: MemberExpr,
    module: int,
  ): Type | undefined {
    const bits = kBitWraps.get(object.name);
    if (!this.isBitName(object.object, module) || bits == undefined) {
      return undefined;
    }
    if (member.name != "from") {
      return undefined;
    }

    for (const arg of expr.args) {
      this.typed(arg.expr, undefined, module);
    }

    return this.store.wrapping(bits);
  }

  private bitHalvesCall(
    expr: CallExpr,
    halves: Read<string[]>,
    module: int,
  ): Type {
    const uint64 = this.store.integer(64, true);

    for (const arg of expr.args) {
      const given = this.typed(arg.expr, uint64, module);
      const isWrapping = given.kind == TypeKind.Int && given.wraps;
      if (!isWrapping) {
        this.coerce(arg.expr, given, uint64, module, kNoPlace);
      }
    }

    const first = halves[0] ?? "";
    const second = halves[1] ?? "";

    return this.store.objectOf([
      { name: first, type: uint64, optional: false, readonly: false },
      { name: second, type: uint64, optional: false, readonly: false },
    ]);
  }
}
