import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  NewExpr,
  PropertyKind,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  InstanceType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import {
  kCipherClasses,
  kCostNames,
  kCurveOption,
  kDigestName,
  kHashClasses,
  kModulusOption,
  kPairOptions,
  kPairUnsupported,
  kScryptOptions,
  kTextOrBuffers,
  kTextOrViews,
  kUpdateName,
} from "../../../crypto-rules/const/crypto-rules.const.tz";
import {
  CryptoClass,
  CryptoData,
} from "../../../crypto-rules/types/crypto-rules.types.tz";

partial class ExpressionTypes {
  private cryptoAsyncCallback(
    expr: CallExpr,
    shown: string,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const last = tree.exprAt(
      tree.argumentsOf(expr.argsList)[
        tree.argumentsOf(expr.argsList).length - 1
      ]?.exprId,
    );
    const isCallback = last != undefined && last.kind == ExprKind.Function;
    if (!this.types.isAsyncName(shown) || !isCallback || last == undefined) {
      return false;
    }

    this.errors.writeFound(
      module,
      this.types.asyncCallbackError(last.loc, shown),
    );

    return true;
  }

  private cryptoSyncCallback(
    expr: CallExpr,
    index: int,
    name: string,
    hint: string,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const arg = tree.exprAt(tree.argumentsOf(expr.argsList)[index]?.exprId);
    if (arg == undefined) {
      return false;
    }

    const given = this.types.definedType(this.peekType(arg, module));
    if (given.kind != TypeKind.Function) {
      return false;
    }

    const callbackError = this.types.syncCallbackError(arg.loc, name, hint);

    this.errors.writeFound(module, callbackError);

    return true;
  }

  private cryptoOptionsFine(
    expr: CallExpr,
    index: int,
    shown: string,
    allowed: Read<string[]>,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const options = tree.exprAt(tree.argumentsOf(expr.argsList)[index]?.exprId);
    if (options == undefined || options.kind == ExprKind.Undefined) {
      return true;
    }
    if (options.kind != ExprKind.ObjectLit) {
      const literalError = this.types.optionsLiteralError(
        options.loc,
        shown,
        allowed,
      );

      this.errors.writeFound(module, literalError);

      return false;
    }

    for (const property of tree.propertiesOf(options.propsList)) {
      const kind = property.form.kind;
      const isNamed =
        kind != PropertyKind.Spread &&
        kind != PropertyKind.Computed &&
        kind != PropertyKind.Method &&
        property.name != "";
      if (!isNamed) {
        const byNameError = this.types.optionsByNameError(
          property.loc,
          shown,
          allowed,
        );

        this.errors.writeFound(module, byNameError);

        return false;
      }
      if (!allowed.includes(property.name)) {
        const unknownError = this.types.optionUnknownError(
          property.loc,
          shown,
          property.name,
          allowed,
        );

        this.errors.writeFound(module, unknownError);

        return false;
      }
    }

    return true;
  }

  private scryptOptionsCheck(expr: CallExpr, shown: string, module: int): void {
    const tree = this.types.program.tree;

    if (!this.cryptoOptionsFine(expr, 3, shown, kScryptOptions, module)) {
      return;
    }

    const options = tree.exprAt(tree.argumentsOf(expr.argsList)[3]?.exprId);
    if (options == undefined) {
      return;
    }

    const pairs = [
      ["N", "cost"],
      ["r", "blockSize"],
      ["p", "parallelization"],
    ];

    for (const pair of pairs) {
      const first = pair[0] ?? "";
      const second = pair[1] ?? "";
      const later = this.optionValue(options, second);
      const isBoth = this.optionValue(options, first) != undefined;
      if (isBoth && later != undefined) {
        const togetherError = this.types.togetherError(
          later.loc,
          first,
          second,
        );

        return this.errors.writeFound(module, togetherError);
      }
    }

    this.scryptCostCheck(options, module);
  }

  private scryptCostCheck(options: Expr, module: int): void {
    const costs = kCostNames
      .map((name) => this.optionValue(options, name))
      .filter((value) => value != undefined);
    const cost = costs[0];
    if (cost == undefined) {
      return;
    }

    const number = this.cryptoNumber(cost, module);
    if (number != undefined) {
      this.errors.writeFound(module, this.types.costError(cost.loc, number));
    }
  }

  private keyPairCheck(
    expr: CallExpr,
    shown: string,
    calleeLoc: int,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const count = tree.argumentsOf(expr.argsList).length;
    const first = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (count > 2 || first == undefined) {
      return;
    }

    const type = this.constantText(first) ?? "";
    const typeError = this.types.pairTypeError(first.loc, type);
    if (type != "" && typeError != undefined) {
      return this.errors.writeFound(module, typeError);
    }
    if (!this.cryptoOptionsFine(expr, 1, shown, kPairOptions, module)) {
      return;
    }

    for (const name of kPairUnsupported) {
      const value = this.cryptoOptionAt(expr, 1, name);
      if (value != undefined) {
        const optionError = this.types.pairOptionError(value.loc, name);

        return this.errors.writeFound(module, optionError);
      }
    }

    this.keyPairNeedsCheck(expr, type, calleeLoc, module);
  }

  private keyPairNeedsCheck(
    expr: CallExpr,
    type: string,
    calleeLoc: int,
    module: int,
  ): void {
    const modulus = this.cryptoOptionAt(expr, 1, kModulusOption);
    const curve = this.cryptoOptionAt(expr, 1, kCurveOption);
    const needsError = this.types.pairNeedsError(
      calleeLoc,
      type,
      modulus != undefined,
      curve != undefined,
    );
    if (needsError != undefined) {
      return this.errors.writeFound(module, needsError);
    }
    if (modulus == undefined) {
      return;
    }

    const bits = this.cryptoNumber(modulus, module);
    if (bits != undefined) {
      const smallError = this.types.smallModulusError(modulus.loc, type, bits);

      this.errors.writeFound(module, smallError);
    }
  }

  private cryptoNew(
    expr: NewExpr,
    name: string,
    home: int,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const opened = this.types.program.modules[home];
    const isCrypto =
      opened != undefined &&
      this.types.isCryptoModule(opened.name) &&
      this.types.isCryptoClass(name);
    if (!isCrypto || this.types.isLibraryModule(module)) {
      return undefined;
    }

    this.errors.writeFound(module, this.types.newError(expr.loc, name));
    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args, module);

    return this.types.store.plain(TypeKind.Error);
  }

  private cryptoMethodCall(
    expr: CallExpr,
    member: MemberExpr,
    instance: InstanceType,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const home = this.types.program.modules[instance.module]?.name ?? "";
    const className = this.types.cryptoClassName(instance, home);
    if (className == undefined) {
      return undefined;
    }

    const shape = this.tables.cryptoClass(className);
    const hasSpread = tree.argumentsOf(expr.argsList).some((arg) => arg.spread);
    if (shape == undefined || hasSpread) {
      return undefined;
    }

    const methodError = this.types.methodError(member.loc, shape, member.name);
    if (methodError == undefined) {
      this.cryptoMethodArguments(expr, member, shape, module);

      return undefined;
    }

    this.errors.writeFound(module, methodError);
    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args, module);

    return this.types.store.plain(TypeKind.Error);
  }

  private cryptoMemberRead(
    expr: MemberExpr,
    instance: InstanceType,
    module: int,
  ): Type | undefined {
    const home = this.types.program.modules[instance.module]?.name ?? "";
    const className = this.types.cryptoClassName(instance, home);
    if (className == undefined) {
      return undefined;
    }

    const shape = this.tables.cryptoClass(className);
    if (shape == undefined) {
      return undefined;
    }

    const memberError = this.types.memberError(expr.loc, shape, expr.name);
    if (memberError == undefined) {
      return undefined;
    }

    this.errors.writeFound(module, memberError);

    return this.types.store.plain(TypeKind.Error);
  }

  private cryptoMethodArguments(
    expr: CallExpr,
    member: MemberExpr,
    shape: Read<CryptoClass>,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const isHash = kHashClasses.includes(shape.name);
    const isCipher = kCipherClasses.includes(shape.name);
    const count = tree.argumentsOf(expr.argsList).length;
    if (member.name == kUpdateName && isHash && count <= 2) {
      const item: CryptoData = { index: 0, what: "data", kinds: kTextOrViews };

      return this.cryptoUpdateCheck(expr, item, module);
    }
    if (member.name == kUpdateName && isCipher && count <= 3) {
      const item: CryptoData = {
        index: 0,
        what: "data",
        kinds: kTextOrBuffers,
      };

      return this.cryptoUpdateCheck(expr, item, module);
    }
    if (member.name == kDigestName && isHash && count <= 1) {
      this.cryptoEncodingCheck(expr, 0, member.name, module);
    }
  }

  private cryptoUpdateCheck(
    expr: CallExpr,
    item: CryptoData,
    module: int,
  ): void {
    if (this.cryptoDataFine(expr, [item], module)) {
      this.cryptoEncodingCheck(expr, 1, "update", module);
    }
  }

  private cryptoEncodingCheck(
    expr: CallExpr,
    index: int,
    name: string,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const encoding = tree.exprAt(
      tree.argumentsOf(expr.argsList)[index]?.exprId,
    );
    if (encoding == undefined || encoding.kind == ExprKind.Undefined) {
      return;
    }

    const text = this.constantText(encoding);
    if (text == undefined) {
      const literalError = this.types.encodingLiteralError(encoding.loc, name);

      return this.errors.writeFound(module, literalError);
    }
    if (text == "buffer") {
      return;
    }

    const unknownError = this.types.encodingError(encoding.loc, [text]);

    this.errors.writeFound(module, unknownError);
  }
}
