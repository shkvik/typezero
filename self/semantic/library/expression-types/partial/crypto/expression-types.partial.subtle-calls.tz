import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  ObjectLitExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import { Type } from "../../../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import {
  kDecryptOperation,
  kDeriveBitsOperation,
  kEncryptOperation,
  kGenerateOperation,
  kImportOperation,
  kKeyLengthOperation,
  kPkcs8Format,
  kRawFormat,
  kSpkiFormat,
  kSubtleName,
  kUnwrapOperation,
  kWrapOperation,
} from "../../../subtle-rules/const/subtle-rules.const.tz";
import {
  SubtleAlgorithmRow,
  SubtleDraft,
} from "../../../subtle-rules/types/subtle-rules.types.tz";

partial class ExpressionTypes {
  private subtleCallCheck(expr: CallExpr, module: int): void {
    const callee = expr.callee;
    if (
      callee.kind != ExprKind.Member ||
      this.modules.isLibraryModule(module)
    ) {
      return;
    }

    const hasSpread = expr.args.some((one) => one.spread);
    const isSubtle = this.isSubtleObject(callee.object, module, 0);
    if (!isSubtle || hasSpread || !this.subtle.isMethod(callee.name)) {
      return;
    }

    const draft: SubtleDraft = { isBad: false };

    this.subtleWalk(expr, callee, draft, module);
  }

  private isSubtleObject(object: Expr, module: int, depth: int): boolean {
    if (object.kind == ExprKind.Member) {
      return (
        object.name == kSubtleName && this.isGlobalCrypto(object.object, module)
      );
    }
    if (object.kind != ExprKind.Name || depth > 4) {
      return false;
    }

    const init = this.constInit(object, module);

    return init != undefined && this.isSubtleObject(init, module, depth + 1);
  }

  private constInit(expr: Expr, module: int): Expr | undefined {
    if (expr.kind != ExprKind.Name) {
      return undefined;
    }

    const target = this.targetOfName(expr, module);
    if (target == undefined || target.kind != SymbolKind.Variable) {
      return undefined;
    }

    const variable = this.record(target.module)?.variables.get(target.loc);
    if (variable == undefined || !variable.isConst) {
      return undefined;
    }

    return variable.decl.init;
  }

  private subtleWalk(
    expr: CallExpr,
    member: MemberExpr,
    draft: SubtleDraft,
    module: int,
  ): void {
    switch (member.name) {
      case "generateKey":
        return this.subtleGenerate(expr, draft, module);
      case "importKey":
        return this.subtleImport(expr, draft, module);
      case "exportKey":
        return this.subtleFormatAt(expr, 0, draft, module);
      case "deriveKey":
        return this.subtleDeriveKey(expr, draft, module);
      case "wrapKey":
        return this.subtleWrap(expr, draft, module);
      case "unwrapKey":
        return this.subtleUnwrap(expr, draft, module);
      default:
        return this.subtleAlgorithmOnly(expr, member.name, draft, module);
    }
  }

  private subtleAlgorithmOnly(
    expr: CallExpr,
    operation: string,
    draft: SubtleDraft,
    module: int,
  ): void {
    this.subtleAlgorithmAt(expr, 0, operation, "", draft, module);
  }

  private subtleGenerate(
    expr: CallExpr,
    draft: SubtleDraft,
    module: int,
  ): void {
    const algorithm = this.subtleAlgorithmAt(
      expr,
      0,
      kGenerateOperation,
      "",
      draft,
      module,
    );
    const isPublic = this.secretPublicness(algorithm, -1);

    this.subtleUsages(expr, 2, algorithm, isPublic, true, draft, module);
  }

  private secretPublicness(
    algorithm: SubtleAlgorithmRow | undefined,
    otherwise: int,
  ): int {
    if (this.subtle.isSecret(algorithm)) {
      return 0;
    }

    return otherwise;
  }

  private subtleImport(expr: CallExpr, draft: SubtleDraft, module: int): void {
    const format = this.subtleFormatOf(expr, 0, draft, module);
    const algorithm = this.subtleAlgorithmAt(
      expr,
      2,
      kImportOperation,
      "",
      draft,
      module,
    );

    this.subtleImportFormat(expr, format, algorithm, false, draft, module);

    const isPublic = this.importedPublicness(format, algorithm);

    this.subtleUsages(
      expr,
      4,
      algorithm,
      isPublic,
      isPublic == 0,
      draft,
      module,
    );

    if (!draft.isBad && format != undefined) {
      this.subtleKeyData(expr, format, module);
    }
  }

  private subtleKeyData(expr: CallExpr, format: string, module: int): void {
    const data = expr.args[1]?.expr;
    if (data == undefined) {
      return;
    }

    const given = this.peekType(data, module);
    const shown = this.subtleDataShown(data, given);
    const dataError = this.subtle.keyDataError(data.loc, format, given, shown);

    this.reportFound(module, dataError);
  }

  private subtleDataShown(data: Expr, given: Type): string {
    if (data.kind == ExprKind.ObjectLit) {
      return "JsonWebKey";
    }

    return this.subtle.typeShown(given);
  }

  private importedPublicness(
    format: string | undefined,
    algorithm: SubtleAlgorithmRow | undefined,
  ): int {
    if (this.subtle.isSecret(algorithm)) {
      return 0;
    }
    if (format == kSpkiFormat || format == kRawFormat) {
      return 1;
    }
    if (format == kPkcs8Format) {
      return 0;
    }

    return -1;
  }

  private subtleImportFormat(
    expr: CallExpr,
    format: string | undefined,
    algorithm: SubtleAlgorithmRow | undefined,
    isUnwrap: boolean,
    draft: SubtleDraft,
    module: int,
  ): void {
    const first = expr.args[0]?.expr;
    if (format == undefined || algorithm == undefined || first == undefined) {
      return;
    }

    const formatError = this.subtle.importFormatError(
      first.loc,
      algorithm,
      format,
      isUnwrap,
    );
    if (formatError != undefined) {
      draft.isBad = true;
      this.reportFound(module, formatError);
    }
  }

  private subtleFormatAt(
    expr: CallExpr,
    index: int,
    draft: SubtleDraft,
    module: int,
  ): void {
    this.subtleFormatOf(expr, index, draft, module);
  }

  private subtleFormatOf(
    expr: CallExpr,
    index: int,
    draft: SubtleDraft,
    module: int,
  ): string | undefined {
    const given = expr.args[index]?.expr;
    if (given == undefined) {
      return undefined;
    }

    const written = this.constantText(given);
    if (written == undefined) {
      return undefined;
    }

    const formatError = this.subtle.formatError(given.loc, written);
    if (formatError != undefined) {
      draft.isBad = true;
      this.reportFound(module, formatError);

      return undefined;
    }

    return written;
  }

  private subtleDeriveKey(
    expr: CallExpr,
    draft: SubtleDraft,
    module: int,
  ): void {
    this.subtleAlgorithmAt(expr, 0, kDeriveBitsOperation, "", draft, module);

    const algorithm = this.subtleAlgorithmAt(
      expr,
      2,
      kImportOperation,
      "",
      draft,
      module,
    );
    const derived = expr.args[2]?.expr;
    if (algorithm == undefined || derived == undefined) {
      return;
    }

    const derivedError = this.subtle.derivedError(derived.loc, algorithm);
    if (derivedError != undefined) {
      draft.isBad = true;

      return this.reportFound(module, derivedError);
    }
    if (!this.subtle.isKdf(algorithm)) {
      this.subtleAlgorithmAt(expr, 2, kKeyLengthOperation, "", draft, module);
    }

    this.subtleUsages(expr, 4, algorithm, 0, true, draft, module);
  }

  private subtleWrap(expr: CallExpr, draft: SubtleDraft, module: int): void {
    this.subtleFormatOf(expr, 0, draft, module);
    this.subtleAlgorithmAt(
      expr,
      3,
      kWrapOperation,
      kEncryptOperation,
      draft,
      module,
    );
  }

  private subtleUnwrap(expr: CallExpr, draft: SubtleDraft, module: int): void {
    const format = this.subtleFormatOf(expr, 0, draft, module);

    this.subtleAlgorithmAt(
      expr,
      3,
      kUnwrapOperation,
      kDecryptOperation,
      draft,
      module,
    );

    const algorithm = this.subtleAlgorithmAt(
      expr,
      4,
      kImportOperation,
      "",
      draft,
      module,
    );

    this.subtleImportFormat(expr, format, algorithm, true, draft, module);

    const isPublic = this.importedPublicness(format, algorithm);

    this.subtleUsages(
      expr,
      6,
      algorithm,
      isPublic,
      isPublic == 0,
      draft,
      module,
    );
  }

  private subtleAlgorithmAt(
    expr: CallExpr,
    index: int,
    operation: string,
    fallback: string,
    draft: SubtleDraft,
    module: int,
  ): SubtleAlgorithmRow | undefined {
    const given = expr.args[index]?.expr;
    if (given == undefined) {
      return undefined;
    }

    const held = this.constInit(given, module);
    const isHeldLiteral =
      held != undefined &&
      (held.kind == ExprKind.ObjectLit || held.kind == ExprKind.StringLit);
    const arg = this.heldLiteral(given, held, isHeldLiteral);

    return this.subtleLiteralAlgorithm(arg, operation, fallback, draft, module);
  }

  private heldLiteral(
    given: Expr,
    held: Expr | undefined,
    isHeldLiteral: boolean,
  ): Expr {
    if (isHeldLiteral && held != undefined) {
      return held;
    }

    return given;
  }

  private subtleLiteralAlgorithm(
    arg: Expr,
    operation: string,
    fallback: string,
    draft: SubtleDraft,
    module: int,
  ): SubtleAlgorithmRow | undefined {
    const nameExpr = this.algorithmNameExpr(arg);
    if (nameExpr == undefined) {
      return undefined;
    }

    const written = this.constantText(nameExpr);
    if (written == undefined) {
      return undefined;
    }

    const found = this.subtle.algorithmFound(
      nameExpr.loc,
      written,
      operation,
      fallback,
    );
    const algorithm = found.algorithm;
    if (found.error != undefined || algorithm == undefined) {
      draft.isBad = true;
      this.reportFound(module, found.error);

      return undefined;
    }

    const dictionary = this.subtle.dictionaryOf(operation, algorithm);
    if (arg.kind != ExprKind.ObjectLit) {
      const objectError = this.subtle.objectError(
        nameExpr.loc,
        algorithm,
        operation,
        dictionary,
      );
      if (objectError != undefined) {
        draft.isBad = true;
        this.reportFound(module, objectError);

        return undefined;
      }

      return algorithm;
    }

    for (const member of dictionary?.required ?? []) {
      if (
        dictionary != undefined &&
        this.subtleProperty(arg, member) == undefined
      ) {
        draft.isBad = true;

        const needsError = this.subtle.needsError(
          arg.loc,
          algorithm,
          operation,
          dictionary,
          member,
        );

        this.reportFound(module, needsError);

        return undefined;
      }
    }

    const dictionaryName = dictionary?.name ?? "";
    if (
      this.subtleMembersBad(arg, algorithm, operation, dictionaryName, module)
    ) {
      draft.isBad = true;

      return undefined;
    }

    return algorithm;
  }

  private subtleMembersBad(
    literal: ObjectLitExpr,
    algorithm: SubtleAlgorithmRow,
    operation: string,
    dictionary: string,
    module: int,
  ): boolean {
    const length = this.subtleProperty(literal, "length");
    const tag = this.subtleProperty(literal, "tagLength");
    const errors = [
      this.subtleHashError(literal, dictionary),
      this.subtleCurveError(literal),
      this.subtleBitsError(length, algorithm, operation, true),
      this.subtleBitsError(tag, algorithm, operation, false),
    ];
    const first = errors.find((one) => one != undefined);
    if (first == undefined) {
      return false;
    }

    this.reportFound(module, first);

    return true;
  }
}
