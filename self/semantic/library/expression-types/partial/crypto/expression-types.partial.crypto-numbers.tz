import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { TypeKind } from "../../../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import { kZeroTerm } from "../../../../flow/bound-rules/const/bound-rules.const.tz";
import { Linear } from "../../../../code/expression-types/types/expression-types.types.tz";
import {
  kAesKeyType,
  kKeyBitsRange,
  kKeyLengthOption,
  kOffsetRange,
  kRandomSizeRange,
  kSecretKeyTypes,
  kSecretTypeLabel,
  kSizeRange,
} from "../../../crypto-rules/const/crypto-rules.const.tz";

partial class ExpressionTypes {
  private randomSizeCheck(expr: CallExpr, module: int): void {
    const tree = this.types.program.tree;

    const size = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (size == undefined) {
      return;
    }

    const given = this.peekType(size, module);
    if (given.kind != TypeKind.Error) {
      this.requireBetween(size, given, kRandomSizeRange, module);
    }
  }

  private randomIntCheck(expr: CallExpr, module: int): void {
    const tree = this.types.program.tree;

    const count = tree.argumentsOf(expr.argsList).length;
    const third = tree.exprAt(tree.argumentsOf(expr.argsList)[2]?.exprId);
    if (count == 3 && third != undefined) {
      return this.errors.write(
        module,
        third.loc,
        Code.CryptoRandomArgs,
        kNoDetails,
      );
    }

    const max = tree.exprAt(tree.argumentsOf(expr.argsList)[count - 1]?.exprId);
    const min = this.randomMinimum(expr);
    if (max == undefined) {
      return;
    }

    const bounds = [max];

    if (min != undefined) {
      bounds.unshift(min);
    }

    for (const bound of bounds) {
      const given = this.peekType(bound, module);
      if (given.kind == TypeKind.Error) {
        return;
      }
      if (this.types.definedType(given).kind != TypeKind.Int) {
        const shown = this.types.typeText(given);

        return this.errors.write(module, bound.loc, Code.CryptoRandomInt, {
          word: shown,
        });
      }
    }

    this.randomLessCheck(min, max, module);
  }

  private readonly randomMinimum(expr: CallExpr): Expr | undefined {
    const tree = this.types.program.tree;

    const args = tree.argumentsOf(expr.argsList);
    if (args.length != 2) {
      return undefined;
    }

    return tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
  }

  private randomLessCheck(min: Expr | undefined, max: Expr, module: int): void {
    const left = this.lessSide(min, module);
    const right = this.linearOf(max, module);
    if (left != undefined && right != undefined && this.isLess(left, right)) {
      return;
    }

    const leftText = this.lessText(min, module);
    const rightText = this.types.valueText(max, module);

    this.errors.write(
      module,
      max.loc,
      this.types.greaterCode(min != undefined),
      {
        word: leftText,
        other: rightText,
      },
    );
  }

  private lessSide(min: Expr | undefined, module: int): Linear | undefined {
    if (min == undefined) {
      return { term: kZeroTerm, offset: (0).toDecimal() };
    }

    return this.linearOf(min, module);
  }

  private readonly lessText(min: Expr | undefined, module: int): string {
    if (min == undefined) {
      return "0";
    }

    return this.types.valueText(min, module);
  }

  private readonly isLess(left: Linear, right: Linear): boolean {
    if (left.term == kZeroTerm && right.term == kZeroTerm) {
      return left.offset < right.offset;
    }

    const room = (1).toDecimal() - (right.offset - left.offset);

    return this.canProve(left.term, right.term, room);
  }

  private fillSizeCheck(expr: CallExpr, module: int): void {
    const tree = this.types.program.tree;

    const offset = tree.exprAt(tree.argumentsOf(expr.argsList)[1]?.exprId);
    if (offset == undefined || offset.kind == ExprKind.Undefined) {
      return;
    }

    const offsetType = this.peekType(offset, module);
    if (offsetType.kind == TypeKind.Error) {
      return;
    }
    if (!this.requireBetween(offset, offsetType, kOffsetRange, module)) {
      return;
    }

    const size = tree.exprAt(tree.argumentsOf(expr.argsList)[2]?.exprId);
    if (size == undefined || size.kind == ExprKind.Undefined) {
      return;
    }

    const given = this.peekType(size, module);
    if (given.kind == TypeKind.Error) {
      return;
    }
    if (!this.requireBetween(size, given, kSizeRange, module)) {
      return;
    }

    const target = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (
      target == undefined ||
      this.isFillFitting(target, offset, size, module)
    ) {
      return;
    }

    this.errors.write(module, size.loc, Code.CryptoFillFits, {
      word: this.types.valueText(size, module),
      other: this.types.valueText(offset, module),
    });
  }

  private isFillFitting(
    target: Expr,
    offset: Expr,
    size: Expr,
    module: int,
  ): boolean {
    const start = this.linearOf(offset, module);
    const count = this.linearOf(size, module);
    const length = this.measuredLength(target, module);
    if (start == undefined || count == undefined || length == undefined) {
      return false;
    }

    const sum = this.sumLinear(start, count);
    if (sum == undefined) {
      return false;
    }

    return this.isLinearUpTo(sum, length, 0);
  }

  private readonly sumLinear(
    first: Linear,
    second: Linear,
  ): Linear | undefined {
    const offset = first.offset + second.offset;
    if (first.term == kZeroTerm) {
      return { term: second.term, offset };
    }
    if (second.term == kZeroTerm) {
      return { term: first.term, offset };
    }

    return undefined;
  }

  private secretKeyCheck(expr: CallExpr, shown: string, module: int): void {
    const tree = this.types.program.tree;

    const first = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (tree.argumentsOf(expr.argsList).length != 2 || first == undefined) {
      return;
    }

    const type = this.constantText(first);
    if (type == undefined) {
      return;
    }

    const typeError = this.types.choiceError(
      first.loc,
      kSecretTypeLabel,
      type,
      kSecretKeyTypes,
    );
    if (typeError != undefined) {
      return this.errors.writeFound(module, typeError);
    }

    const options = [kKeyLengthOption];
    if (!this.cryptoOptionsFine(expr, 1, shown, options, module)) {
      return;
    }

    const length = this.cryptoOptionAt(expr, 1, kKeyLengthOption);
    const optionsArg = tree.exprAt(tree.argumentsOf(expr.argsList)[1]?.exprId);
    if (length == undefined && optionsArg != undefined) {
      return this.errors.write(
        module,
        optionsArg.loc,
        Code.CryptoKeyLengthNeeded,
        {
          word: shown,
        },
      );
    }
    if (length != undefined) {
      this.secretLengthCheck(length, type, module);
    }
  }

  private secretLengthCheck(length: Expr, type: string, module: int): void {
    const given = this.peekType(length, module);
    if (given.kind == TypeKind.Error) {
      return;
    }
    if (type != kAesKeyType) {
      this.requireBetween(length, given, kKeyBitsRange, module);

      return;
    }

    const known = this.intConstant(length, given, module);
    const isAesLength =
      known != undefined &&
      (known == (128).toDecimal() ||
        known == (192).toDecimal() ||
        known == (256).toDecimal());
    if (!isAesLength) {
      this.errors.write(
        module,
        length.loc,
        Code.CryptoAesKeyLength,
        kNoDetails,
      );
    }
  }
}
