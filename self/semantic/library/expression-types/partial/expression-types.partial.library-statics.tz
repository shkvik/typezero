import {
  CallExpr,
  ExprKind,
  MemberExpr,
  NewExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { SymbolKind } from "../../../../program/scopes/types/scopes.types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import {
  kCodePointRange,
  kFromCodePointName,
  kStringClassName,
} from "../../library-rules/const/library-rules.const.ranges.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";
import { CallKind } from "../../../code/expression-types/types/expression-types.types.tz";
import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";

partial class ExpressionTypes {
  private argumentRangeCheck(
    expr: CallExpr,
    member: MemberExpr,
    object: Type,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const range = this.types.argumentRange(object, member.name);
    const arg = tree.argumentsOf(expr.argsList)[0];
    if (range == undefined || arg == undefined || arg.spread) {
      return;
    }

    const exprExpr = tree.exprOf(arg.exprId);
    const given = this.peekType(exprExpr, module);
    const argExpr = tree.exprOf(arg.exprId);

    this.requireBetween(argExpr, given, range, module);
  }

  private codePointCall(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const owner = tree.exprOf(member.objectId);
    const isMaker =
      member.name == kFromCodePointName &&
      owner.kind == ExprKind.Name &&
      owner.name == kStringClassName &&
      this.isGlobalUse(owner, module);
    const hasSpread = tree.argumentsOf(expr.argsList).some((arg) => arg.spread);
    if (!isMaker || hasSpread) {
      return false;
    }

    const int = this.types.store.integer(64, false);

    for (const arg of tree.argumentsOf(expr.argsList)) {
      const exprExpr = tree.exprOf(arg.exprId);
      const given = this.typed(exprExpr, int, module);

      this.requireBetween(
        tree.exprOf(arg.exprId),
        given,
        kCodePointRange,
        module,
      );
    }

    return true;
  }

  private madeSizeCheck(expr: NewExpr, name: string, module: int): void {
    const tree = this.types.program.tree;

    const what = this.types.sizeWhat(name);
    const size = tree.argumentsOf(expr.argsList)[0];
    const isSized =
      tree.argumentsOf(expr.argsList).length == 1 && size != undefined;
    if (what == undefined || !isSized || size == undefined || size.spread) {
      return;
    }

    const exprExpr = tree.exprOf(size.exprId);
    const given = this.peekType(exprExpr, module);

    const base = this.types.definedType(given);
    if (base.kind == TypeKind.Double && this.types.isTypedName(name)) {
      const code = Code.BytesLengthFraction;

      return this.errors.write(
        module,
        tree.exprOf(size.exprId).loc,
        code,
        kNoDetails,
      );
    }
    if (base.kind != TypeKind.Int) {
      return;
    }

    this.requireBetween(
      tree.exprOf(size.exprId),
      given,
      { what, low: 0 },
      module,
    );
  }

  private libraryStaticCall(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const owner = tree.exprOf(member.objectId);
    if (owner.kind != ExprKind.Name) {
      return undefined;
    }

    const target = this.targetOfName(owner, module);
    const isLibraryClass =
      target != undefined &&
      target.kind == SymbolKind.Class &&
      this.types.isLibraryModule(target.module);
    if (!isLibraryClass || target == undefined) {
      return undefined;
    }

    const opened = this.types.program.modules[target.module];
    const declared = tree
      .declaredClassesOf(opened?.declaredList)
      .find((one) => one.loc == target.loc);
    if (declared == undefined) {
      return undefined;
    }

    const instance = this.types.declaredInstance(
      target.module,
      declared,
      [],
    );
    if (instance == undefined || instance.kind != TypeKind.Instance) {
      return undefined;
    }

    const regExpStatic = this.regExpStaticCall(expr, member, instance, module);
    if (regExpStatic != undefined) {
      return regExpStatic;
    }

    this.bytesStaticCheck(expr, instance, member, module);
    this.decoderParseCheck(expr, instance, member, module);

    const found = this.declaredStatic(instance, member.name);
    const variants = this.declaredVariants(instance, member.name, true);
    if (found == undefined && variants.types.length > 0) {
      return this.variantLibraryCall(expr, member, variants, module);
    }

    const isPlain =
      found != undefined &&
      found.kind == TypeKind.Function &&
      !this.types.mentionsParameter(found);
    if (!isPlain || found == undefined || found.kind != TypeKind.Function) {
      return undefined;
    }

    this.staticRangeCheck(expr, owner.name, member.name, module);

    return this.calledWith(expr, found, member.loc, CallKind.Library, module);
  }

  private staticRangeCheck(
    expr: CallExpr,
    owner: string,
    name: string,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const range = this.types.staticRange(owner, name);
    const arg = tree.argumentsOf(expr.argsList)[0];
    if (range == undefined || arg == undefined || arg.spread) {
      return;
    }

    const exprExpr = tree.exprOf(arg.exprId);
    const given = this.peekType(exprExpr, module);
    const argExpr = tree.exprOf(arg.exprId);

    this.requireBetween(argExpr, given, range, module);
  }
}
