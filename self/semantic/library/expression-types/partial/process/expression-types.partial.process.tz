import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  AssignExpr,
  CallArgument,
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import { kLibrary } from "../../../../../program/library/library-modules/const/library-modules.const.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import {
  kExitCodeName,
  kProcessName,
  kTtyName,
} from "../../../process-rules/const/process-rules.const.tz";

partial class ExpressionTypes {
  private readonly isProcessName(expr: Expr, module: int): boolean {
    return (
      expr.kind == ExprKind.Name &&
      expr.name == kProcessName &&
      this.isGlobalUse(expr, module)
    );
  }

  private processStreamTyped(expr: MemberExpr, module: int): Type | undefined {
    const tree = this.types.program.tree;

    const objectExpr = tree.exprOf(expr.objectId);
    if (!this.isProcessName(objectExpr, module)) {
      return undefined;
    }

    const row = kLibrary
      .members()
      .find((one) => one.owner == kProcessName && one.name == expr.name);
    if (row == undefined) {
      return undefined;
    }

    const home = this.types.program.modules.find(
      (one) => one.name == row.module,
    );
    if (home == undefined) {
      return undefined;
    }

    const target = this.exportedValue(home.id, expr.name);
    if (target == undefined || target.kind != SymbolKind.Variable) {
      return undefined;
    }

    const object = tree.exprOf(expr.objectId);

    this.memberObjects.add(object.id);

    return this.variableTyped(target, undefined);
  }

  private processMemberRead(expr: MemberExpr, module: int): boolean {
    const tree = this.types.program.tree;

    const object = tree.exprOf(expr.objectId);
    if (!this.isProcessName(object, module)) {
      return this.streamPartRead(expr, module);
    }
    if (this.types.isLibraryModule(module)) {
      return false;
    }

    const name = expr.name;
    if (this.process.isValueMember(name)) {
      return false;
    }

    const code = this.process.valueCode(name);

    this.errors.write(module, expr.loc, code, { word: name });

    return true;
  }

  private streamPartRead(expr: MemberExpr, module: int): boolean {
    const tree = this.types.program.tree;

    const object = tree.exprOf(expr.objectId);
    const stream = this.streamName(object, module);
    if (stream == undefined || !this.process.isStreamPart(expr.name)) {
      return false;
    }

    this.errors.write(module, expr.loc, Code.ProcessStreamPart, {
      word: stream,
      first: expr.name,
    });

    return true;
  }

  private readonly streamName(expr: Expr, module: int): string | undefined {
    const tree = this.types.program.tree;

    if (
      expr.kind != ExprKind.Member ||
      !this.isProcessName(tree.exprOf(expr.objectId), module)
    ) {
      return undefined;
    }
    if (!this.process.isStream(expr.name)) {
      return undefined;
    }

    return `${kProcessName}.${expr.name}`;
  }

  private processCall(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const object = tree.exprOf(member.objectId);
    const stream = this.streamName(object, module);
    if (stream != undefined && member.name == kTtyName) {
      this.errors.write(module, member.loc, Code.ProcessTtyValue, {
        word: stream,
      });
      const args = tree.argumentsOf(expr.argsList);

      this.looseArguments(args, module);

      return this.types.store.plain(TypeKind.Error);
    }
    const objectExpr = tree.exprOf(member.objectId);
    if (!this.isProcessName(objectExpr, module)) {
      return undefined;
    }
    if (this.types.isLibraryModule(module)) {
      return undefined;
    }

    const name = member.name;
    if (this.process.isSignalMember(name)) {
      return this.signalCall(expr, member, module);
    }
    if (this.process.isPlainCall(name)) {
      return undefined;
    }

    const code = this.process.callCode(name);

    this.errors.write(module, member.loc, code, { word: name });
    const argsItem = tree.argumentsOf(expr.argsList);

    this.looseArguments(argsItem, module);

    return this.types.store.plain(TypeKind.Error);
  }

  private signalCall(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const event = tree.argumentsOf(expr.argsList)[0];
    if (
      event == undefined ||
      tree.argumentsOf(expr.argsList).length != 2 ||
      event.spread
    ) {
      return undefined;
    }

    const exprExpr = tree.exprOf(event.exprId);
    const written = this.types.literalLabel(exprExpr);
    const isThrown =
      written != undefined &&
      this.process.isThrownListener(member.name, written);
    if (isThrown) {
      const args = tree.argumentsOf(expr.argsList);

      this.looseCallbacks(args, module);

      return this.types.store.plain(TypeKind.Error);
    }
    if (written != undefined && !this.process.isSignal(written)) {
      this.errors.write(
        module,
        tree.exprOf(event.exprId).loc,
        Code.ProcessSignal,
        {
          word: member.name,
          first: written,
        },
      );
      const argsItem = tree.argumentsOf(expr.argsList);

      this.looseCallbacks(argsItem, module);

      return this.types.store.plain(TypeKind.Error);
    }

    const objectExpr = tree.exprOf(member.objectId);

    this.memberObjects.add(objectExpr.id);

    const memberObject = tree.exprOf(member.objectId);
    const object = this.typed(memberObject, undefined, module);
    const found = this.processMethod(object, member.name);
    if (found == undefined || found.kind != TypeKind.Function) {
      const exprArgs = tree.argumentsOf(expr.argsList);

      this.looseCallbacks(exprArgs, module);

      return this.types.store.plain(TypeKind.Void);
    }

    const params = this.types.store.paramsOf(found);

    for (
      let index = 0;
      index < tree.argumentsOf(expr.argsList).length;
      index++
    ) {
      const arg = tree.argumentsOf(expr.argsList)[index];
      const param = params[index];
      if (arg != undefined && param != undefined) {
        const argExpr = tree.exprOf(arg.exprId);

        this.checked(argExpr, param.type, module, "");
      }
    }

    return this.types.store.returnTypeOf(found);
  }

  private processMethod(object: Type, name: string): Type | undefined {
    const base = this.types.definedType(object);
    if (base.kind != TypeKind.Object) {
      return undefined;
    }

    const field = this.types.store
      .fieldsOf(base)
      .find((one) => one.name == name);

    return field?.type;
  }

  private processAssignCheck(expr: AssignExpr, module: int): boolean {
    const tree = this.types.program.tree;

    const target = tree.exprOf(expr.targetId);
    if (target.kind != ExprKind.Member) {
      return false;
    }
    const object = tree.exprOf(target.objectId);
    if (!this.isProcessName(object, module)) {
      return this.streamAssignCheck(expr, target, module);
    }
    if (target.name != kExitCodeName) {
      this.errors.write(module, target.loc, Code.ProcessAssigned, {
        word: target.name,
      });
      const value = tree.exprOf(expr.valueId);

      this.typed(value, undefined, module);

      return true;
    }
    if (expr.op != undefined) {
      this.errors.write(module, expr.loc, Code.ProcessExitCodeOp, kNoDetails);
      const valueExpr = tree.exprOf(expr.valueId);

      this.typed(valueExpr, undefined, module);

      return true;
    }

    const int = this.types.store.integer(64, false);

    const exprValue = tree.exprOf(expr.valueId);

    this.checked(exprValue, int, module, "");

    return true;
  }

  private streamAssignCheck(
    expr: AssignExpr,
    target: MemberExpr,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const objectExpr = tree.exprOf(target.objectId);
    const stream = this.streamName(objectExpr, module);
    const object = tree.exprOf(target.objectId);
    if (stream == undefined || object.kind != ExprKind.Member) {
      return false;
    }

    this.errors.write(module, target.loc, Code.ProcessChanged, {
      word: object.name,
    });
    const value = tree.exprOf(expr.valueId);

    this.typed(value, undefined, module);

    return true;
  }

  private looseCallbacks(args: Read<CallArgument[]>, module: int): void {
    const tree = this.types.program.tree;

    for (const arg of args) {
      const expr = tree.exprOf(arg.exprId);

      this.listenerLoose(expr, module);
    }
  }
}
