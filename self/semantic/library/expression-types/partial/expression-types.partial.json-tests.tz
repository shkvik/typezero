import { Code } from "../../../../diagnostic/code.tz";
import { Details } from "../../../../diagnostic/types/message.types.tz";
import {
  BinaryExpr,
  BinaryOp,
  Expr,
  ExprKind,
  UnaryOp,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { TypeKind } from "../../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import { JsonTest } from "../../../code/expression-types/types/expression-types.types.tz";
import {
  kArrayTypeOf,
  kEqualText,
  kIsArrayName,
  kNotEqualText,
  kNullTypeOfs,
  kValuePlaceholder,
} from "../../library-rules/const/library-rules.const.tz";
import { kArrayClass } from "../../../code/expression-types/const/expression-types.const.tz";

partial class ExpressionTypes {
  private redundantTestsCheck(expr: BinaryExpr, module: int): void {
    const tree = this.types.program.tree;

    const isAnd = expr.op == BinaryOp.LogAnd;
    const rhs = tree.exprOf(expr.rhsId);
    const test = this.jsonTestOf(rhs, module);
    if (test == undefined) {
      return;
    }

    for (const term of this.sameOperatorTerms(
      tree.exprOf(expr.lhsId),
      expr.op,
    )) {
      const name = this.typeOfTextFor(term, test.tested, isAnd, module);
      if (name != undefined) {
        return this.typeOfAgreesCheck(rhs, test, name, isAnd, module);
      }
    }
  }

  private readonly sameOperatorTerms(expr: Expr, op: BinaryOp): Expr[] {
    const tree = this.types.program.tree;

    const terms: Expr[] = [];
    let current = expr;

    while (current.kind == ExprKind.Binary && current.op == op) {
      const rhs = tree.exprOf(current.rhsId);

      terms.push(rhs);
      current = tree.exprOf(current.lhsId);
    }

    terms.push(current);
    terms.reverse();

    return terms;
  }

  private jsonTestOf(rhs: Expr, module: int): JsonTest | undefined {
    const found = this.testedSide(rhs, module);
    if (found == undefined) {
      return undefined;
    }

    const type = this.peekType(found.tested, module);
    if (this.types.definedType(type).kind != TypeKind.Json) {
      return undefined;
    }

    return found;
  }

  private readonly testedSide(rhs: Expr, module: int): JsonTest | undefined {
    const tree = this.types.program.tree;

    if (rhs.kind == ExprKind.Binary) {
      const isEquality = rhs.op == BinaryOp.Eq || rhs.op == BinaryOp.Ne;
      const lhs = tree.exprOf(rhs.lhsId);
      const isLeftNull = this.isNullValue(lhs, module);
      const rhsExpr = tree.exprOf(rhs.rhsId);
      const isRightNull = this.isNullValue(rhsExpr, module);
      if (!isEquality || (!isLeftNull && !isRightNull)) {
        return undefined;
      }
      if (isLeftNull) {
        return { tested: tree.exprOf(rhs.rhsId), isNullTest: true };
      }

      return { tested: tree.exprOf(rhs.lhsId), isNullTest: true };
    }

    const inner = this.withoutNot(rhs);
    const tested = this.isArrayArgument(inner, module);
    if (tested == undefined) {
      return undefined;
    }

    return { tested, isNullTest: false };
  }

  private readonly isNullValue(expr: Expr, module: int): boolean {
    return expr.kind == ExprKind.Name && this.isNullName(expr, module);
  }

  private readonly withoutNot(expr: Expr): Expr {
    const tree = this.types.program.tree;

    if (expr.kind == ExprKind.Unary && expr.op == UnaryOp.Not) {
      return tree.exprOf(expr.operandId);
    }

    return expr;
  }

  private readonly isArrayArgument(expr: Expr, module: int): Expr | undefined {
    const tree = this.types.program.tree;

    if (expr.kind != ExprKind.Call) {
      return undefined;
    }

    const callee = tree.exprOf(expr.calleeId);
    if (callee.kind != ExprKind.Member) {
      return undefined;
    }

    const owner = tree.exprOf(callee.objectId);
    const isArray =
      owner.kind == ExprKind.Name &&
      owner.name == kArrayClass &&
      callee.name == kIsArrayName &&
      this.isGlobalUse(owner, module);
    if (!isArray) {
      return undefined;
    }

    return tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
  }

  private readonly typeOfTextFor(
    term: Expr,
    tested: Expr,
    isAnd: boolean,
    module: int,
  ): string | undefined {
    const tree = this.types.program.tree;

    if (term.kind != ExprKind.Binary) {
      return undefined;
    }

    const wanted = this.testOperator(isAnd);
    if (term.op != wanted) {
      return undefined;
    }

    const left = tree.exprOf(term.lhsId);
    const right = tree.exprOf(term.rhsId);
    if (left.kind == ExprKind.Unary && right.kind == ExprKind.StringLit) {
      const isTypeOf = left.op == UnaryOp.TypeOf;
      const isSame = this.isSameRef(
        tree.exprOf(left.operandId),
        tested,
        module,
      );

      return this.typeOfName(isTypeOf && isSame, right.value);
    }
    if (right.kind == ExprKind.Unary && left.kind == ExprKind.StringLit) {
      const isTypeOf = right.op == UnaryOp.TypeOf;
      const isSame = this.isSameRef(
        tree.exprOf(right.operandId),
        tested,
        module,
      );

      return this.typeOfName(isTypeOf && isSame, left.value);
    }

    return undefined;
  }

  private readonly typeOfName(
    isTest: boolean,
    name: string,
  ): string | undefined {
    if (isTest) {
      return name;
    }

    return undefined;
  }

  private readonly testOperator(isAnd: boolean): BinaryOp {
    if (isAnd) {
      return BinaryOp.Eq;
    }

    return BinaryOp.Ne;
  }

  private readonly isSameRef(first: Expr, second: Expr, module: int): boolean {
    const tree = this.types.program.tree;

    let left = first;
    let right = second;

    while (left.kind == ExprKind.Member && right.kind == ExprKind.Member) {
      if (left.name != right.name) {
        return false;
      }

      left = tree.exprOf(left.objectId);
      right = tree.exprOf(right.objectId);
    }

    if (left.kind != ExprKind.Name || right.kind != ExprKind.Name) {
      return false;
    }

    const leftTarget = this.targetOfName(left, module);
    const rightTarget = this.targetOfName(right, module);
    if (leftTarget == undefined || rightTarget == undefined) {
      return false;
    }

    return (
      leftTarget.module == rightTarget.module &&
      leftTarget.loc == rightTarget.loc
    );
  }

  private typeOfAgreesCheck(
    rhs: Expr,
    test: JsonTest,
    name: string,
    isAnd: boolean,
    module: int,
  ): void {
    const word = this.refText(test.tested);
    const first = this.testOperatorText(isAnd);
    const details: Details = { word, first, other: name };
    if (test.isNullTest && !kNullTypeOfs.includes(name)) {
      return this.errors.write(module, rhs.loc, Code.JsonNeverNull, details);
    }
    if (!test.isNullTest && name != kArrayTypeOf) {
      this.errors.write(module, rhs.loc, Code.JsonNeverArray, details);
    }
  }

  private readonly testOperatorText(isAnd: boolean): string {
    if (isAnd) {
      return kEqualText;
    }

    return kNotEqualText;
  }

  private readonly refText(expr: Expr): string {
    const tree = this.types.program.tree;

    const names: string[] = [];
    let link = expr;

    while (link.kind == ExprKind.Member) {
      names.push(link.name);
      link = tree.exprOf(link.objectId);
    }

    let text = kValuePlaceholder;
    if (link.kind == ExprKind.Name) {
      text = link.name;
    }

    for (const name of names.reverse()) {
      text = `${text}.${name}`;
    }

    return text;
  }
}
