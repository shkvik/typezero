import { SymbolKind } from "../../../../program/scopes/types/scopes.types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import {
  DictKind,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import { kNoPlace } from "../../../code/expression-types/const/expression-types.const.tz";
import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import {
  kFillAbstract,
  kFillError,
  kFillJavascript,
  kFillName,
  kFillOwnCtor,
  kFillOwnCtorEnd,
  kFillValueError,
  kMetadataNames,
  kMetadataReads,
  kReflectName,
  kReflectNames,
} from "../../library-rules/const/library-rules.const.tz";

partial class ExpressionTypes {
  private reflectCallCheck(expr: CallExpr, module: int): void {
    const callee = expr.callee;
    if (
      callee.kind != ExprKind.Member ||
      this.modules.isLibraryModule(module)
    ) {
      return;
    }

    const owner = callee.object;
    const isReflect =
      owner.kind == ExprKind.Name &&
      owner.name == "Reflect" &&
      this.isGlobalUse(owner, module);
    const hasSpread = expr.args.some((one) => one.spread);
    if (!isReflect || hasSpread) {
      return;
    }

    switch (callee.name) {
      case "get":
        return this.reflectGetCheck(expr, module);
      case "apply":
        return this.reflectApplyCheck(expr, module);
      case "construct":
        return this.reflectConstructCheck(expr, module);
      case "metadata":
        return this.metadataValueCheck(owner.loc, callee.loc, module);
      case "getMetadataKeys":
      case "getOwnMetadataKeys":
        return this.report(module, callee.loc, Code.ReflectMetadataKeys, {
          word: callee.name,
        });
      default:
        return this.reflectOtherCheck(expr, callee.name, callee.loc, module);
    }
  }

  private metadataValueCheck(start: int, loc: int, module: int): void {
    const text = this.program.modules[module]?.source.text;
    const before = text?.[start - 1];
    if (before == 64) {
      return;
    }

    this.report(module, loc, Code.ReflectMetadataValue, kNoDetails);
  }

  private reflectOtherCheck(
    expr: CallExpr,
    name: string,
    loc: int,
    module: int,
  ): void {
    if (!kReflectNames.includes(name)) {
      return this.report(module, loc, Code.ReflectUnknown, { word: name });
    }
    if (!kMetadataNames.includes(name)) {
      return;
    }

    const isDefine = name == "defineMetadata";
    const key = expr.args[0]?.expr;
    if (key != undefined && !this.metadataKeyFine(key, isDefine, module)) {
      return;
    }

    const value = expr.args[1]?.expr;
    if (isDefine && value != undefined) {
      const given = this.peekType(value, module);
      if (given.kind == TypeKind.Void) {
        return this.report(
          module,
          value.loc,
          Code.MetadataVoidValue,
          kNoDetails,
        );
      }
      if (key != undefined) {
        this.metadataWriteCheck(key, value, given, module);
      }
    }

    const target = expr.args[this.metadataTargetAt(isDefine)]?.expr;
    if (target == undefined) {
      return;
    }

    const targetType = this.peekType(target, module);
    const base = this.types.definedType(targetType);
    if (this.isPlainReflectValue(base.kind)) {
      this.report(module, target.loc, Code.MetadataTarget, {
        word: this.text.of(targetType),
      });
    }
  }

  private metadataIdentity(key: Expr, module: int): string | undefined {
    if (key.kind != ExprKind.Name) {
      return undefined;
    }

    const target = this.targetOfUse(key.loc, key.name, module);
    const isNamed =
      target?.kind == SymbolKind.Function || target?.kind == SymbolKind.Class;
    if (target == undefined || !isNamed) {
      return undefined;
    }

    return `${target.module} ${target.loc}`;
  }

  private metadataWriteCheck(
    key: Expr,
    value: Expr,
    given: Type,
    module: int,
  ): void {
    const identity = this.metadataIdentity(key, module);
    if (identity == undefined || key.kind != ExprKind.Name) {
      return;
    }

    const word = key.name;
    const known = this.metadataRecords.get(identity);
    if (known != undefined) {
      const fits =
        this.relation.extends(given, known) ||
        this.relation.converts(given, known);
      if (!fits && given.kind != TypeKind.Error) {
        this.report(module, value.loc, Code.MetadataRecordType, {
          word,
          first: this.text.of(given),
          second: this.text.of(known),
        });
      }

      return;
    }
    if (given.kind == TypeKind.Undefined) {
      return this.report(module, value.loc, Code.MetadataUndefinedRecord, {
        word,
      });
    }

    const record = this.types.apparent(given);
    if (record.kind == TypeKind.Error || this.parts.mentionsParameter(record)) {
      return;
    }

    this.metadataRecords.set(identity, record);
  }

  private reflectRecordRead(
    expr: CallExpr,
    member: MemberExpr,
    wanted: Type | undefined,
    module: int,
  ): Type | undefined {
    const owner = member.object;
    const isReflect =
      owner.kind == ExprKind.Name &&
      owner.name == kReflectName &&
      this.isGlobalUse(owner, module);
    const key = expr.args[0]?.expr;
    const isRead = kMetadataReads.includes(member.name);
    if (!isReflect || !isRead || key == undefined) {
      return undefined;
    }

    const identity = this.metadataIdentity(key, module);
    if (identity == undefined || key.kind != ExprKind.Name) {
      return undefined;
    }

    this.reflectCallCheck(expr, module);
    this.looseArguments(expr.args, module);

    const known = this.metadataRecords.get(identity);
    if (known != undefined) {
      return this.types.optional(known);
    }

    const written = this.writtenRecord(wanted);
    if (written == undefined) {
      this.report(module, key.loc, Code.MetadataNoRecord, { word: key.name });

      return this.store.plain(TypeKind.Error);
    }

    this.metadataRecords.set(identity, written);

    return this.types.optional(written);
  }

  private writtenRecord(wanted: Type | undefined): Type | undefined {
    if (wanted == undefined) {
      return undefined;
    }

    const plain = this.types.definedType(wanted);
    const isOpen =
      plain.kind == TypeKind.Unknown ||
      plain.kind == TypeKind.Error ||
      this.parts.mentionsParameter(plain);
    if (isOpen) {
      return undefined;
    }

    return plain;
  }

  private metadataTargetAt(isDefine: boolean): int {
    if (isDefine) {
      return 2;
    }

    return 1;
  }

  private metadataKeyFine(key: Expr, isDefine: boolean, module: int): boolean {
    const isDesign =
      key.kind == ExprKind.StringLit && key.value.startsWith("design:");
    if (isDefine && isDesign) {
      this.report(module, key.loc, Code.MetadataKeyDesign, kNoDetails);

      return false;
    }

    const given = this.peekType(key, module);
    const base = this.types.definedType(given);
    const isWrong =
      base.kind == TypeKind.Int ||
      base.kind == TypeKind.Double ||
      base.kind == TypeKind.Decimal ||
      base.kind == TypeKind.Boolean;
    if (isWrong) {
      this.report(module, key.loc, Code.MetadataKeyType, {
        word: this.text.of(given),
      });

      return false;
    }

    return true;
  }

  private reflectGetCheck(expr: CallExpr, module: int): void {
    const target = expr.args[0]?.expr;
    if (target == undefined) {
      return;
    }

    const given = this.peekType(target, module);
    const base = this.types.definedType(given);
    if (base.kind == TypeKind.Json) {
      return this.report(module, target.loc, Code.ReflectGetJson, kNoDetails);
    }
    if (this.isPlainReflectValue(base.kind)) {
      this.report(module, target.loc, Code.ReflectGetNotObject, {
        word: this.text.of(given),
      });
    }
  }

  private reflectApplyCheck(expr: CallExpr, module: int): void {
    const fn = expr.args[0]?.expr;
    if (fn == undefined) {
      return;
    }

    const given = this.peekType(fn, module);
    const base = this.types.definedType(given);
    const isFunction =
      base.kind == TypeKind.Function ||
      base.kind == TypeKind.Error ||
      base.kind == TypeKind.Unknown;
    if (!isFunction) {
      return this.report(module, fn.loc, Code.ReflectApplyNotFunction, {
        word: this.text.of(given),
      });
    }

    this.reflectArgumentsCheck(expr.args[2]?.expr, module);
  }

  private reflectConstructCheck(expr: CallExpr, module: int): void {
    const third = expr.args[2]?.expr;
    if (third != undefined) {
      return this.report(
        module,
        third.loc,
        Code.ReflectConstructThird,
        kNoDetails,
      );
    }

    const made = expr.args[0]?.expr;
    if (made == undefined) {
      return;
    }

    const given = this.peekType(made, module);
    const base = this.types.definedType(given);
    if (this.isPlainReflectValue(base.kind)) {
      return this.report(module, made.loc, Code.ReflectConstructNotClass, {
        word: this.text.of(given),
      });
    }

    this.reflectArgumentsCheck(expr.args[1]?.expr, module);
  }

  private reflectArgumentsCheck(list: Expr | undefined, module: int): void {
    if (list == undefined) {
      return;
    }

    const given = this.peekType(list, module);
    if (this.types.definedType(given).kind == TypeKind.Tuple) {
      this.report(module, list.loc, Code.ReflectArgumentsTuple, kNoDetails);
    }
  }

  private isPlainReflectValue(kind: TypeKind): boolean {
    return (
      kind == TypeKind.Int ||
      kind == TypeKind.Double ||
      kind == TypeKind.Decimal ||
      kind == TypeKind.Boolean ||
      kind == TypeKind.String ||
      kind == TypeKind.Literal
    );
  }

  private reflectStringRead(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): Type | undefined {
    const owner = member.object;
    const isReflect =
      owner.kind == ExprKind.Name &&
      owner.name == kReflectName &&
      this.isGlobalUse(owner, module);
    const hasSpread = expr.args.some((one) => one.spread);
    const key = expr.args[0]?.expr;
    if (!isReflect || hasSpread || key == undefined) {
      return undefined;
    }
    if (!kMetadataReads.includes(member.name)) {
      return undefined;
    }

    const given = this.peekType(key, module);
    const base = this.types.apparent(given);
    if (base.kind != TypeKind.String) {
      return undefined;
    }

    this.looseArguments(expr.args, module);

    return this.store.plain(TypeKind.Unknown);
  }

  private reflectFillCall(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): Type | undefined {
    const owner = member.object;
    const isReflect =
      owner.kind == ExprKind.Name &&
      owner.name == kReflectName &&
      this.isGlobalUse(owner, module);
    const hasSpread = expr.args.some((one) => one.spread);
    const isFill = isReflect && member.name == kFillName && !hasSpread;
    const cls = expr.args[0]?.expr;
    const values = expr.args[1]?.expr;
    if (!isFill || expr.args.length != 2) {
      return undefined;
    }
    if (cls == undefined || values == undefined) {
      return undefined;
    }
    if (this.modules.isLibraryModule(module)) {
      return undefined;
    }

    return this.filledType(cls, values, module);
  }

  private filledType(cls: Expr, values: Expr, module: int): Type {
    const error = this.store.plain(TypeKind.Error);
    if (this.libraryClassFill(cls, values, module)) {
      return error;
    }

    const given = this.typed(cls, undefined, module);
    const string = this.store.plain(TypeKind.String);
    const unknown = this.store.plain(TypeKind.Unknown);
    const map = this.store.dictOf(DictKind.Map, string, unknown);
    const mapped = this.checked(values, map, module, kNoPlace);
    if (given.kind == TypeKind.Error || mapped.kind == TypeKind.Error) {
      return error;
    }

    const base = this.types.definedType(given);
    if (base.kind != TypeKind.Class) {
      const word = this.text.of(given);

      this.report(module, cls.loc, Code.ReflectFillNotClass, { word });

      return error;
    }
    if (!base.exact) {
      return this.filledResult(base.instance, kFillError, module);
    }

    const instance = this.types.definedType(base.instance);
    if (instance.kind != TypeKind.Instance) {
      return error;
    }

    const decl = this.record(instance.module)?.classes.get(instance.loc);
    const word = instance.name;
    if (decl == undefined) {
      return error;
    }
    if (decl.isAbstract) {
      return this.fillRefused(cls, word, kFillAbstract, module);
    }
    if (decl.constructors.length > 0) {
      const other = `${kFillOwnCtor}${word}${kFillOwnCtorEnd}`;

      return this.fillRefused(cls, word, other, module);
    }

    return this.filledResult(base.instance, kFillValueError, module);
  }

  private libraryClassFill(cls: Expr, values: Expr, module: int): boolean {
    if (cls.kind != ExprKind.Name) {
      return false;
    }

    const target = this.targetOfName(cls, module);
    if (target == undefined || target.kind != SymbolKind.Class) {
      return false;
    }
    if (!this.modules.isLibraryModule(target.module)) {
      return false;
    }

    this.fillRefused(cls, cls.name, kFillJavascript, module);
    this.typed(values, undefined, module);

    return true;
  }

  private fillRefused(
    cls: Expr,
    word: string,
    other: string,
    module: int,
  ): Type {
    this.report(module, cls.loc, Code.ReflectFillCannot, { word, other });

    return this.store.plain(TypeKind.Error);
  }

  private filledResult(made: Type, failure: string, module: int): Type {
    const fails = this.namedLibraryType(failure, 0, module);
    if (fails.kind == TypeKind.Error) {
      return fails;
    }

    return this.store.resultOf(made, fails);
  }
}
