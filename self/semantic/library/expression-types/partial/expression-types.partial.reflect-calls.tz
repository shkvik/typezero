import { SymbolKind } from "../../../../program/scopes/types/scopes.types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import {
  DictKind,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import { kNoPlace } from "../../../code/expression-types/const/expression-types.const.tz";
import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import {
  kFillAbstract,
  kFillError,
  kFillJavascript,
  kFillName,
  kFillOwnCtor,
  kFillOwnCtorEnd,
  kFillValueError,
  kMetadataNames,
  kMetadataReads,
  kReflectName,
  kReflectNames,
} from "../../library-rules/const/library-rules.const.tz";

partial class ExpressionTypes {
  private reflectCallCheck(expr: CallExpr, module: int): void {
    const tree = this.types.program.tree;

    const callee = tree.exprOf(expr.calleeId);
    if (callee.kind != ExprKind.Member || this.types.isLibraryModule(module)) {
      return;
    }

    const owner = tree.exprOf(callee.objectId);
    const isReflect =
      owner.kind == ExprKind.Name &&
      owner.name == "Reflect" &&
      this.isGlobalUse(owner, module);
    const hasSpread = tree.argumentsOf(expr.argsList).some((one) => one.spread);
    if (!isReflect || hasSpread) {
      return;
    }

    switch (callee.name) {
      case "get":
        return this.reflectGetCheck(expr, module);
      case "apply":
        return this.reflectApplyCheck(expr, module);
      case "construct":
        return this.reflectConstructCheck(expr, module);
      case "metadata":
        return this.metadataValueCheck(owner.loc, callee.loc, module);
      case "getMetadataKeys":
      case "getOwnMetadataKeys":
        return this.errors.write(module, callee.loc, Code.ReflectMetadataKeys, {
          word: callee.name,
        });
      default:
        return this.reflectOtherCheck(expr, callee.name, callee.loc, module);
    }
  }

  private metadataValueCheck(start: int, loc: int, module: int): void {
    const text = this.types.program.modules[module]?.source.text;
    const before = text?.[start - 1];
    if (before == 64) {
      return;
    }

    this.errors.write(module, loc, Code.ReflectMetadataValue, kNoDetails);
  }

  private reflectOtherCheck(
    expr: CallExpr,
    name: string,
    loc: int,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    if (!kReflectNames.includes(name)) {
      return this.errors.write(module, loc, Code.ReflectUnknown, {
        word: name,
      });
    }
    if (!kMetadataNames.includes(name)) {
      return;
    }

    const isDefine = name == "defineMetadata";
    const key = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (key != undefined && !this.metadataKeyFine(key, isDefine, module)) {
      return;
    }

    const value = tree.exprAt(tree.argumentsOf(expr.argsList)[1]?.exprId);
    if (isDefine && value != undefined) {
      const given = this.peekType(value, module);
      if (given.kind == TypeKind.Void) {
        return this.errors.write(
          module,
          value.loc,
          Code.MetadataVoidValue,
          kNoDetails,
        );
      }
      if (key != undefined) {
        this.metadataWriteCheck(key, value, given, module);
      }
    }

    const target = tree.exprAt(
      tree.argumentsOf(expr.argsList)[this.metadataTargetAt(isDefine)]?.exprId,
    );
    if (target == undefined) {
      return;
    }

    const targetType = this.peekType(target, module);
    const base = this.types.definedType(targetType);
    if (this.isPlainReflectValue(base.kind)) {
      this.errors.write(module, target.loc, Code.MetadataTarget, {
        word: this.types.typeText(targetType),
      });
    }
  }

  private readonly metadataIdentity(
    key: Expr,
    module: int,
  ): string | undefined {
    if (key.kind != ExprKind.Name) {
      return undefined;
    }

    const target = this.targetOfUse(key.loc, key.name, module);
    const isNamed =
      target?.kind == SymbolKind.Function || target?.kind == SymbolKind.Class;
    if (target == undefined || !isNamed) {
      return undefined;
    }

    return `${target.module} ${target.loc}`;
  }

  private metadataWriteCheck(
    key: Expr,
    value: Expr,
    given: Type,
    module: int,
  ): void {
    const identity = this.metadataIdentity(key, module);
    if (identity == undefined || key.kind != ExprKind.Name) {
      return;
    }

    const word = key.name;
    const known = this.metadataRecords.get(identity);
    if (known != undefined) {
      const fits =
        this.types.extends(given, known) || this.types.converts(given, known);
      if (!fits && given.kind != TypeKind.Error) {
        this.errors.write(module, value.loc, Code.MetadataRecordType, {
          word,
          first: this.types.typeText(given),
          second: this.types.typeText(known),
        });
      }

      return;
    }
    if (given.kind == TypeKind.Undefined) {
      return this.errors.write(
        module,
        value.loc,
        Code.MetadataUndefinedRecord,
        {
          word,
        },
      );
    }

    const record = this.types.apparent(given);
    if (record.kind == TypeKind.Error || this.types.mentionsParameter(record)) {
      return;
    }

    this.metadataRecords.set(identity, record);
  }

  private reflectRecordRead(
    expr: CallExpr,
    member: MemberExpr,
    wanted: Type | undefined,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const owner = tree.exprOf(member.objectId);
    const isReflect =
      owner.kind == ExprKind.Name &&
      owner.name == kReflectName &&
      this.isGlobalUse(owner, module);
    const key = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    const isRead = kMetadataReads.includes(member.name);
    if (!isReflect || !isRead || key == undefined) {
      return undefined;
    }

    const identity = this.metadataIdentity(key, module);
    if (identity == undefined || key.kind != ExprKind.Name) {
      return undefined;
    }

    this.reflectCallCheck(expr, module);
    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args, module);

    const known = this.metadataRecords.get(identity);
    if (known != undefined) {
      return this.types.optional(known);
    }

    const written = this.writtenRecord(wanted);
    if (written == undefined) {
      this.errors.write(module, key.loc, Code.MetadataNoRecord, {
        word: key.name,
      });

      return this.types.store.plain(TypeKind.Error);
    }

    this.metadataRecords.set(identity, written);

    return this.types.optional(written);
  }

  private writtenRecord(wanted: Type | undefined): Type | undefined {
    if (wanted == undefined) {
      return undefined;
    }

    const plain = this.types.definedType(wanted);
    const isOpen =
      plain.kind == TypeKind.Unknown ||
      plain.kind == TypeKind.Error ||
      this.types.mentionsParameter(plain);
    if (isOpen) {
      return undefined;
    }

    return plain;
  }

  private readonly metadataTargetAt(isDefine: boolean): int {
    if (isDefine) {
      return 2;
    }

    return 1;
  }

  private metadataKeyFine(key: Expr, isDefine: boolean, module: int): boolean {
    const isDesign =
      key.kind == ExprKind.StringLit && key.value.startsWith("design:");
    if (isDefine && isDesign) {
      this.errors.write(module, key.loc, Code.MetadataKeyDesign, kNoDetails);

      return false;
    }

    const given = this.peekType(key, module);
    const base = this.types.definedType(given);
    const isWrong =
      base.kind == TypeKind.Int ||
      base.kind == TypeKind.Double ||
      base.kind == TypeKind.Decimal ||
      base.kind == TypeKind.Boolean;
    if (isWrong) {
      this.errors.write(module, key.loc, Code.MetadataKeyType, {
        word: this.types.typeText(given),
      });

      return false;
    }

    return true;
  }

  private reflectGetCheck(expr: CallExpr, module: int): void {
    const tree = this.types.program.tree;

    const target = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (target == undefined) {
      return;
    }

    const given = this.peekType(target, module);
    const base = this.types.definedType(given);
    if (base.kind == TypeKind.Json) {
      return this.errors.write(
        module,
        target.loc,
        Code.ReflectGetJson,
        kNoDetails,
      );
    }
    if (this.isPlainReflectValue(base.kind)) {
      this.errors.write(module, target.loc, Code.ReflectGetNotObject, {
        word: this.types.typeText(given),
      });
    }
  }

  private reflectApplyCheck(expr: CallExpr, module: int): void {
    const tree = this.types.program.tree;

    const fn = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (fn == undefined) {
      return;
    }

    const given = this.peekType(fn, module);
    const base = this.types.definedType(given);
    const isFunction =
      base.kind == TypeKind.Function ||
      base.kind == TypeKind.Error ||
      base.kind == TypeKind.Unknown;
    if (!isFunction) {
      return this.errors.write(module, fn.loc, Code.ReflectApplyNotFunction, {
        word: this.types.typeText(given),
      });
    }

    this.reflectArgumentsCheck(
      tree.exprAt(tree.argumentsOf(expr.argsList)[2]?.exprId),
      module,
    );
  }

  private reflectConstructCheck(expr: CallExpr, module: int): void {
    const tree = this.types.program.tree;

    const third = tree.exprAt(tree.argumentsOf(expr.argsList)[2]?.exprId);
    if (third != undefined) {
      return this.errors.write(
        module,
        third.loc,
        Code.ReflectConstructThird,
        kNoDetails,
      );
    }

    const made = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (made == undefined) {
      return;
    }

    const given = this.peekType(made, module);
    const base = this.types.definedType(given);
    if (this.isPlainReflectValue(base.kind)) {
      return this.errors.write(
        module,
        made.loc,
        Code.ReflectConstructNotClass,
        {
          word: this.types.typeText(given),
        },
      );
    }

    this.reflectArgumentsCheck(
      tree.exprAt(tree.argumentsOf(expr.argsList)[1]?.exprId),
      module,
    );
  }

  private reflectArgumentsCheck(list: Expr | undefined, module: int): void {
    if (list == undefined) {
      return;
    }

    const given = this.peekType(list, module);
    if (this.types.definedType(given).kind == TypeKind.Tuple) {
      this.errors.write(
        module,
        list.loc,
        Code.ReflectArgumentsTuple,
        kNoDetails,
      );
    }
  }

  private readonly isPlainReflectValue(kind: TypeKind): boolean {
    return (
      kind == TypeKind.Int ||
      kind == TypeKind.Double ||
      kind == TypeKind.Decimal ||
      kind == TypeKind.Boolean ||
      kind == TypeKind.String ||
      kind == TypeKind.Literal
    );
  }

  private reflectStringRead(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const owner = tree.exprOf(member.objectId);
    const isReflect =
      owner.kind == ExprKind.Name &&
      owner.name == kReflectName &&
      this.isGlobalUse(owner, module);
    const hasSpread = tree.argumentsOf(expr.argsList).some((one) => one.spread);
    const key = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (!isReflect || hasSpread || key == undefined) {
      return undefined;
    }
    if (!kMetadataReads.includes(member.name)) {
      return undefined;
    }

    const given = this.peekType(key, module);
    const base = this.types.apparent(given);
    if (base.kind != TypeKind.String) {
      return undefined;
    }

    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args, module);

    return this.types.store.plain(TypeKind.Unknown);
  }

  private reflectFillCall(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const owner = tree.exprOf(member.objectId);
    const isReflect =
      owner.kind == ExprKind.Name &&
      owner.name == kReflectName &&
      this.isGlobalUse(owner, module);
    const hasSpread = tree.argumentsOf(expr.argsList).some((one) => one.spread);
    const isFill = isReflect && member.name == kFillName && !hasSpread;
    const cls = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    const values = tree.exprAt(tree.argumentsOf(expr.argsList)[1]?.exprId);
    if (!isFill || tree.argumentsOf(expr.argsList).length != 2) {
      return undefined;
    }
    if (cls == undefined || values == undefined) {
      return undefined;
    }
    if (this.types.isLibraryModule(module)) {
      return undefined;
    }

    return this.filledType(cls, values, module);
  }

  private filledType(cls: Expr, values: Expr, module: int): Type {
    const tree = this.types.program.tree;

    const error = this.types.store.plain(TypeKind.Error);
    if (this.libraryClassFill(cls, values, module)) {
      return error;
    }

    const given = this.typed(cls, undefined, module);
    const string = this.types.store.plain(TypeKind.String);
    const unknown = this.types.store.plain(TypeKind.Unknown);
    const map = this.types.store.dictOf(DictKind.Map, string, unknown);
    const mapped = this.checked(values, map, module, kNoPlace);
    if (given.kind == TypeKind.Error || mapped.kind == TypeKind.Error) {
      return error;
    }

    const base = this.types.definedType(given);
    if (base.kind != TypeKind.Class) {
      const word = this.types.typeText(given);

      this.errors.write(module, cls.loc, Code.ReflectFillNotClass, { word });

      return error;
    }
    if (!base.exact) {
      return this.filledResult(
        this.types.store.classInstanceOf(base),
        kFillError,
        module,
      );
    }

    const instance = this.types.definedType(
      this.types.store.classInstanceOf(base),
    );
    if (instance.kind != TypeKind.Instance) {
      return error;
    }

    const decl = this.record(instance.module)?.classes.get(instance.loc);
    const word = instance.name;
    if (decl == undefined) {
      return error;
    }
    if (decl.isAbstract) {
      return this.fillRefused(cls, word, kFillAbstract, module);
    }
    const constructors = tree.countOf(decl.constructorsList);
    if (constructors > 0) {
      const other = `${kFillOwnCtor}${word}${kFillOwnCtorEnd}`;

      return this.fillRefused(cls, word, other, module);
    }

    return this.filledResult(
      this.types.store.classInstanceOf(base),
      kFillValueError,
      module,
    );
  }

  private libraryClassFill(cls: Expr, values: Expr, module: int): boolean {
    if (cls.kind != ExprKind.Name) {
      return false;
    }

    const target = this.targetOfName(cls, module);
    if (target == undefined || target.kind != SymbolKind.Class) {
      return false;
    }
    if (!this.types.isLibraryModule(target.module)) {
      return false;
    }

    this.fillRefused(cls, cls.name, kFillJavascript, module);
    this.typed(values, undefined, module);

    return true;
  }

  private fillRefused(
    cls: Expr,
    word: string,
    other: string,
    module: int,
  ): Type {
    this.errors.write(module, cls.loc, Code.ReflectFillCannot, { word, other });

    return this.types.store.plain(TypeKind.Error);
  }

  private filledResult(made: Type, failure: string, module: int): Type {
    const fails = this.namedLibraryType(failure, 0, module);
    if (fails.kind == TypeKind.Error) {
      return fails;
    }

    return this.types.store.resultOf(made, fails);
  }
}
