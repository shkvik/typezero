import { Code } from "../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import {
  kPerformanceName,
  kPrintNames,
} from "../../library-rules/const/library-rules.const.tz";

partial class ExpressionTypes {
  private printVoidCheck(expr: CallExpr, module: int): void {
    const tree = this.types.program.tree;

    const callee = tree.exprOf(expr.calleeId);
    if (callee.kind != ExprKind.Member || !kPrintNames.includes(callee.name)) {
      return;
    }
    const object = tree.exprOf(callee.objectId);
    if (!this.isGlobalNamed(object, "console", module)) {
      return;
    }

    for (const arg of tree.argumentsOf(expr.argsList)) {
      if (arg.spread) {
        const exprExpr = tree.exprOf(arg.exprId);

        this.printSpreadCheck(exprExpr, module);
        continue;
      }
      const argExpr = tree.exprOf(arg.exprId);
      if (argExpr.kind != ExprKind.Call) {
        continue;
      }

      const given = this.peekType(tree.exprOf(arg.exprId), module);
      if (given.kind == TypeKind.Void) {
        this.errors.write(
          module,
          tree.exprOf(arg.exprId).loc,
          Code.PrintVoid,
          kNoDetails,
        );
      }
    }
  }

  private printSpreadCheck(value: Expr, module: int): void {
    const given = this.peekType(value, module);
    const base = this.types.definedType(given);
    const isList =
      base.kind == TypeKind.Array ||
      base.kind == TypeKind.Tuple ||
      base.kind == TypeKind.Error ||
      base.kind == TypeKind.TypeParameter;
    if (!isList) {
      this.errors.write(module, value.loc, Code.PrintSpread, {
        word: this.types.typeText(given),
      });
    }
  }

  private performanceRead(expr: MemberExpr, module: int): Type | undefined {
    const tree = this.types.program.tree;

    const isPerformance = this.isGlobalNamed(
      tree.exprOf(expr.objectId),
      kPerformanceName,
      module,
    );
    if (!isPerformance || expr.name == "now") {
      return undefined;
    }

    this.errors.write(module, expr.loc, Code.PerformanceOther, {
      word: expr.name,
    });

    return this.types.store.plain(TypeKind.Error);
  }

  private performanceCallCheck(expr: CallExpr, module: int): boolean {
    const tree = this.types.program.tree;

    const callee = tree.exprOf(expr.calleeId);
    if (callee.kind != ExprKind.Member) {
      return false;
    }

    const read = this.performanceRead(callee, module);
    if (read == undefined) {
      return false;
    }

    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args, module);

    return true;
  }

  private readonly isGlobalNamed(
    object: Expr,
    name: string,
    module: int,
  ): boolean {
    return (
      object.kind == ExprKind.Name &&
      object.name == name &&
      this.isGlobalUse(object, module)
    );
  }

  private isJsonKnownCheck(expr: CallExpr, module: int): void {
    const tree = this.types.program.tree;

    const callee = tree.exprOf(expr.calleeId);
    const value = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (callee.kind != ExprKind.Member || callee.name != "isJson") {
      return;
    }
    if (
      !this.isGlobalNamed(tree.exprOf(callee.objectId), "Json", module) ||
      value == undefined
    ) {
      return;
    }

    const given = this.peekType(value, module);
    const base = this.types.definedType(given);
    const isOpen =
      base.kind == TypeKind.Unknown ||
      base.kind == TypeKind.Error ||
      base.kind == TypeKind.TypeParameter;
    if (isOpen) {
      return;
    }

    const other = this.jsonAlreadyHint(base.kind == TypeKind.Json);

    this.errors.write(module, value.loc, Code.JsonIsJsonKnown, {
      word: this.types.typeText(given),
      other,
    });
  }

  private readonly jsonAlreadyHint(isJson: boolean): string {
    if (isJson) {
      return ", and it is a Json already";
    }

    return "";
  }
}
