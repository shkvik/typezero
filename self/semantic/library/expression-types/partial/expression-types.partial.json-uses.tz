import { kByteOrderMark } from "../../json-text/const/json-text.const.tz";
import { kEmbedTextName } from "../../library-rules/const/library-rules.const.tz";
import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
  IndexExpr,
  MemberExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { SymbolKind } from "../../../../program/scopes/types/scopes.types.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";
import { kJsonGlobalName } from "../../../code/expression-types/const/expression-types.const.tz";

partial class ExpressionTypes {
  private jsonMethodCall(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const holder = tree.exprOf(member.objectId);
    const word = member.name;
    const isVariable =
      holder.kind == ExprKind.Name &&
      this.targetOfName(holder, module)?.kind == SymbolKind.Variable;
    if (isVariable && holder.kind == ExprKind.Name) {
      this.errors.write(module, member.loc, Code.JsonNoMethodNamed, {
        word,
        other: holder.name,
      });
    } else {
      this.errors.write(module, member.loc, Code.JsonNoMethod, { word });
    }

    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args, module);

    return this.types.store.plain(TypeKind.Error);
  }

  private jsonStaticCheck(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const object = tree.exprOf(member.objectId);
    const isJson =
      object.kind == ExprKind.Name &&
      object.name == kJsonGlobalName &&
      this.isGlobalUse(object, module);
    if (!isJson) {
      return false;
    }

    const second = tree.exprAt(tree.argumentsOf(expr.argsList)[1]?.exprId);
    if (member.name == "parse" && second == undefined) {
      this.jsonTextCheck(expr, module);
    }
    if (member.name == "parse" && second != undefined) {
      this.errors.write(module, second.loc, Code.JsonReviver, kNoDetails);
      this.nonNullArguments(expr, module);

      return true;
    }
    if (member.name != "stringify") {
      return false;
    }

    return this.stringifyCheck(expr, module);
  }

  private stringifyCheck(expr: CallExpr, module: int): boolean {
    const tree = this.types.program.tree;

    const value = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (value == undefined || tree.argumentsOf(expr.argsList).length > 3) {
      return false;
    }

    let isRefused = this.stringifiedValueCheck(value, module);
    const replacer = tree.exprAt(tree.argumentsOf(expr.argsList)[1]?.exprId);
    if (replacer != undefined && this.isGivenOption(replacer, module)) {
      const type = this.typed(replacer, undefined, module);
      if (type.kind != TypeKind.Error) {
        this.errors.write(module, replacer.loc, Code.JsonReplacer, kNoDetails);
      }

      isRefused = true;
    }

    const space = tree.exprAt(tree.argumentsOf(expr.argsList)[2]?.exprId);
    if (space != undefined && this.isGivenOption(space, module)) {
      const isSpace = this.spaceCheck(space, module);

      isRefused = isRefused || !isSpace;
    }
    if (isRefused) {
      this.nonNullArguments(expr, module);
    }

    return isRefused;
  }

  private nonNullArguments(expr: CallExpr, module: int): void {
    const tree = this.types.program.tree;

    for (const arg of tree.argumentsOf(expr.argsList)) {
      const value = tree.exprOf(arg.exprId);
      const isNull =
        value.kind == ExprKind.Name && this.isNullName(value, module);
      if (!isNull) {
        this.typed(value, undefined, module);
      }
    }
  }

  private stringifiedValueCheck(value: Expr, module: int): boolean {
    const type = this.peekType(value, module);

    if (type.kind == TypeKind.Void) {
      this.errors.write(module, value.loc, Code.JsonVoidValue, kNoDetails);

      return true;
    }

    const base = this.types.definedType(type);
    if (
      base.kind != TypeKind.Instance ||
      this.types.isLibraryModule(base.module)
    ) {
      return false;
    }

    const entryLookup = this.classMember(base, "toJSON");

    const entry = entryLookup.entry;
    if (entry == undefined || entry.methods.length == 0) {
      return false;
    }

    this.errors.write(module, value.loc, Code.JsonToJsonClass, {
      word: base.name,
    });

    return true;
  }

  private readonly isGivenOption(option: Expr, module: int): boolean {
    if (option.kind == ExprKind.Undefined) {
      return false;
    }

    return option.kind != ExprKind.Name || !this.isNullName(option, module);
  }

  private spaceCheck(space: Expr, module: int): boolean {
    const type = this.typed(space, undefined, module);
    const base = this.types.apparent(type);
    const isFitting =
      base.kind == TypeKind.Int ||
      base.kind == TypeKind.Double ||
      base.kind == TypeKind.String ||
      base.kind == TypeKind.Template ||
      base.kind == TypeKind.Error;
    if (isFitting) {
      return true;
    }

    this.errors.write(module, space.loc, Code.JsonSpaceType, {
      word: this.types.typeText(type),
    });

    return false;
  }

  private jsonIndexed(expr: IndexExpr, module: int): Type {
    const tree = this.types.program.tree;

    const index = tree.exprOf(expr.indexId);
    const key = this.typed(index, undefined, module);
    const base = this.types.apparent(key);
    const json = this.types.store.plain(TypeKind.Json);
    const isKey =
      base.kind == TypeKind.Error ||
      base.kind == TypeKind.String ||
      base.kind == TypeKind.Template ||
      base.kind == TypeKind.Int ||
      base.kind == TypeKind.Double;
    if (isKey) {
      return this.types.optional(json);
    }

    this.errors.write(module, tree.exprOf(expr.indexId).loc, Code.JsonKeyType, {
      word: this.types.typeText(key),
    });

    return this.types.store.plain(TypeKind.Error);
  }

  private jsonTextCheck(expr: CallExpr, module: int): void {
    const tree = this.types.program.tree;

    const arg = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (arg == undefined || tree.argumentsOf(expr.argsList).length != 1) {
      return;
    }

    const text = this.constantJsonText(arg, module);
    if (text == undefined) {
      return;
    }
    if (text.charCodeAt(0) == kByteOrderMark) {
      return this.errors.write(module, arg.loc, Code.JsonTextBom, kNoDetails);
    }

    const problem = this.jsonTexts.problemOf(text);
    if (problem == undefined) {
      return;
    }

    const place = this.jsonTexts.position(text, problem.offset);

    this.errors.write(module, arg.loc, Code.JsonTextInvalid, {
      word: problem.message,
      first: `${place[0] ?? 1}`,
      other: `${place[1] ?? 1}`,
    });
  }

  private readonly constantJsonText(
    arg: Expr,
    module: int,
  ): string | undefined {
    const tree = this.types.program.tree;

    if (arg.kind == ExprKind.StringLit) {
      return arg.value;
    }
    if (arg.kind != ExprKind.Call) {
      return undefined;
    }

    const callee = tree.exprOf(arg.calleeId);
    const path = tree.exprAt(tree.argumentsOf(arg.argsList)[0]?.exprId);
    if (callee.kind != ExprKind.Name || callee.name != kEmbedTextName) {
      return undefined;
    }
    if (path == undefined || !this.isGlobalUse(callee, module)) {
      return undefined;
    }

    const shown = this.constantText(path);
    if (shown == undefined) {
      return undefined;
    }

    const home = this.types.program.modules[module]?.source.path ?? "";

    return this.embedded.textOf(home, shown);
  }
}
