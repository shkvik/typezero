import { SourceError } from "../../../../../diagnostic/types/message.types.tz";
import {
  ArrayElement,
  CallArgument,
  Expr,
  ExprKind,
  NewExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { TypeRefKind } from "../../../../../program/ast/types/ast.types.types.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import {
  TypeContext,
  TypePlace,
} from "../../../../types/type-resolver/types/type-resolver.types.tz";
import {
  kDateTimeFormatClass,
  kDisplayNamesClass,
  kIntlPrefix,
  kLocaleClass,
} from "../../../intl-rules/const/intl-rules.const.tz";
import { IntlService } from "../../../intl-rules/types/intl-rules.types.tz";

partial class ExpressionTypes {
  private intlNew(expr: NewExpr, name: string, module: int): Type {
    if (name == kLocaleClass) {
      return this.localeNew(expr, module);
    }
    if (name == kDateTimeFormatClass) {
      this.dateFormatNew(expr, module);

      return this.namedLibraryType(`${kIntlPrefix}${name}`, expr.loc, module);
    }

    const service = this.intl.service(name);
    const what = `${kIntlPrefix}${name}`;
    if (service == undefined) {
      const unknownError = this.intl.unknownServiceError(expr.loc, name);

      this.reportFound(module, unknownError);
      this.looseArguments(expr.args, module);

      return this.store.plain(TypeKind.Error);
    }
    if (name == kDisplayNamesClass && expr.args.length < 2) {
      const noTypeError = this.intl.noTypeNewError(expr.loc);

      this.reportFound(module, noTypeError);
      this.looseArguments(expr.args, module);

      return this.store.plain(TypeKind.Error);
    }

    this.intlArguments(expr.args, 0, service, what, module);

    return this.namedLibraryType(what, expr.loc, module);
  }

  private localeNew(expr: NewExpr, module: int): Type {
    const what = `${kIntlPrefix}${kLocaleClass}`;
    const options = expr.args[1];
    if (options != undefined) {
      const optionsError = this.intl.localeOptionsError(options.expr.loc);

      this.reportFound(module, optionsError);
      this.looseArguments(expr.args, module);

      return this.namedLibraryType(what, expr.loc, module);
    }

    const tag = expr.args[0];
    if (tag != undefined && !tag.spread) {
      const given = this.typed(tag.expr, undefined, module);

      this.localeTagCheck(tag.expr, given, what, true, module);
    }

    return this.namedLibraryType(what, expr.loc, module);
  }

  private readonly namedLibraryType(name: string, loc: int, module: int): Type {
    const context: TypeContext = {
      module,
      bindings: new Map<int, Type>(),
      place: TypePlace.Plain,
    };

    this.errors.beginTrial();

    const type = this.resolver.resolve(
      { form: { kind: TypeRefKind.Name }, name, loc, args: [] },
      context,
    );

    this.errors.endTrial();

    return type;
  }

  private intlArguments(
    args: Read<CallArgument[]>,
    from: int,
    service: Read<IntlService>,
    what: string,
    module: int,
  ): boolean {
    const locale = args[from];
    const options = args[from + 1];
    let isLocaleOk = true;

    if (locale != undefined && !locale.spread) {
      const given = this.typed(locale.expr, undefined, module);

      isLocaleOk = this.localeArgumentCheck(locale.expr, given, what, module);
    }
    if (options == undefined || options.spread) {
      return isLocaleOk;
    }

    const isDisplay = service.name == kDisplayNamesClass;

    return this.intlOptionsCheck(
      options.expr,
      service,
      what,
      isLocaleOk,
      isDisplay,
      module,
    );
  }

  private localeArgumentCheck(
    arg: Expr,
    given: Type,
    what: string,
    module: int,
  ): boolean {
    const base = this.types.definedType(given);
    if (base.kind == TypeKind.Error) {
      return false;
    }
    if (base.kind == TypeKind.Undefined || this.isLocaleValue(given)) {
      return true;
    }
    if (!this.intl.isTextLike(base)) {
      const takesError = this.intl.takesError(arg.loc, what, given);

      this.reportFound(module, takesError);

      return false;
    }

    return this.localeTagCheck(arg, given, what, false, module);
  }

  private readonly isLocaleValue(given: Type): boolean {
    const base = this.types.definedType(given);

    return (
      base.kind == TypeKind.Instance &&
      base.name == kLocaleClass &&
      this.modules.isLibraryModule(base.module) &&
      !this.types.isOptional(given)
    );
  }

  private localeTagCheck(
    arg: Expr,
    given: Type,
    what: string,
    isConstructor: boolean,
    module: int,
  ): boolean {
    if (this.modules.isLibraryModule(module)) {
      return true;
    }

    const tags = this.encodingTexts(arg, given, module, 0);
    if (tags == undefined) {
      const unknownError = this.tagUnknownError(arg.loc, what, isConstructor);

      this.reportFound(module, unknownError);

      return false;
    }

    const wrong = tags.find((tag) => !this.intl.isLanguageTag(tag));
    if (wrong == undefined) {
      return true;
    }

    const notTagError = this.intl.notTagError(arg.loc, wrong);

    this.reportFound(module, notTagError);

    return false;
  }

  private readonly tagUnknownError(
    loc: int,
    what: string,
    isConstructor: boolean,
  ): SourceError {
    if (isConstructor) {
      return this.intl.tagUnknownLocaleError(loc);
    }

    return this.intl.tagUnknownError(loc, what);
  }

  private localeListCheck(list: Expr, what: string, module: int): boolean {
    if (list.kind == ExprKind.ArrayLit) {
      const text = this.store.plain(TypeKind.String);
      const wanted = this.store.arrayOf(text);

      this.typed(list, wanted, module);

      return this.localeElementsCheck(list.elements, what, module);
    }

    const given = this.typed(list, undefined, module);
    const base = this.types.definedType(given);
    if (base.kind == TypeKind.Error) {
      return false;
    }
    if (base.kind != TypeKind.Array) {
      return this.localeArgumentCheck(list, given, what, module);
    }
    if (this.types.definedType(base.item).kind != TypeKind.String) {
      const listError = this.intl.listError(list.loc, what, given);

      this.reportFound(module, listError);

      return false;
    }

    const listOpenError = this.intl.listOpenError(list.loc, what);

    this.reportFound(module, listOpenError);

    return false;
  }

  private localeElementsCheck(
    elements: Read<ArrayElement[]>,
    what: string,
    module: int,
  ): boolean {
    for (const element of elements) {
      if (element.spread) {
        const spreadError = this.intl.spreadError(element.expr.loc, what);

        this.reportFound(module, spreadError);

        return false;
      }

      const given = this.peekType(element.expr, module);
      if (!this.localeTagCheck(element.expr, given, what, false, module)) {
        return false;
      }
    }

    return true;
  }
}
