import { ProofRange } from "../../../../flow/proof-rules/types/proof-rules.types.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { SourceError } from "../../../../../diagnostic/types/message.types.tz";
import { DeclaredMemberKind } from "../../../../../program/ast/types/ast.types.declarations.tz";
import { Linear } from "../../../../code/expression-types/types/expression-types.types.tz";
import { kZeroTerm } from "../../../../flow/bound-rules/const/bound-rules.const.tz";
import {
  ArrayElement,
  CallArgument,
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  NewExpr,
  PropertyKind,
  UnaryOp,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { TypeRefKind } from "../../../../../program/ast/types/ast.types.types.tz";
import {
  InstanceType,
  ObjectField,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import {
  TypeContext,
  TypePlace,
} from "../../../../types/type-resolver/types/type-resolver.types.tz";
import {
  kCanonicalName,
  kCollatorClass,
  kCurrencyOption,
  kDateTimeFormatClass,
  kDigitPairs,
  kDigitRanges,
  kDisplayNamesClass,
  kIntlName,
  kIntlPrefix,
  kKeywordOptions,
  kLocaleClass,
  kLocaleCompareName,
  kNormalizeName,
  kNumberFormatClass,
  kRoundingIncrements,
  kRoundingOption,
  kStyleOption,
  kSupportedName,
  kToLocaleName,
  kTypeOption,
  kUnitOption,
  kValuesOfName,
} from "../../../intl-rules/const/intl-rules.const.tz";
import {
  IntlDigitRange,
  IntlMethodKind,
  IntlOption,
  IntlOptionKind,
  IntlService,
} from "../../../intl-rules/types/intl-rules.types.tz";

partial class ExpressionTypes {
  private intlNew(expr: NewExpr, name: string, module: int): Type {
    if (name == kLocaleClass) {
      return this.localeNew(expr, module);
    }
    if (name == kDateTimeFormatClass) {
      this.dateFormatNew(expr, module);

      return this.namedLibraryType(`${kIntlPrefix}${name}`, expr.loc, module);
    }

    const service = this.intl.service(name);
    const what = `${kIntlPrefix}${name}`;
    if (service == undefined) {
      const unknownError = this.intl.unknownServiceError(expr.loc, name);

      this.reportFound(module, unknownError);
      this.looseArguments(expr.args, module);

      return this.store.plain(TypeKind.Error);
    }
    if (name == kDisplayNamesClass && expr.args.length < 2) {
      const noTypeError = this.intl.noTypeNewError(expr.loc);

      this.reportFound(module, noTypeError);
      this.looseArguments(expr.args, module);

      return this.store.plain(TypeKind.Error);
    }

    this.intlArguments(expr.args, 0, service, what, module);

    return this.namedLibraryType(what, expr.loc, module);
  }

  private localeNew(expr: NewExpr, module: int): Type {
    const what = `${kIntlPrefix}${kLocaleClass}`;
    const options = expr.args[1];
    if (options != undefined) {
      const optionsError = this.intl.localeOptionsError(options.expr.loc);

      this.reportFound(module, optionsError);
      this.looseArguments(expr.args, module);

      return this.namedLibraryType(what, expr.loc, module);
    }

    const tag = expr.args[0];
    if (tag != undefined && !tag.spread) {
      const given = this.typed(tag.expr, undefined, module);

      this.localeTagCheck(tag.expr, given, what, true, module);
    }

    return this.namedLibraryType(what, expr.loc, module);
  }

  private namedLibraryType(name: string, loc: int, module: int): Type {
    const context: TypeContext = {
      module,
      bindings: new Map<int, Type>(),
      place: TypePlace.Plain,
    };

    this.errors.beginTrial();

    const type = this.resolver.resolve(
      { form: { kind: TypeRefKind.Name }, name, loc, args: [] },
      context,
    );

    this.errors.endTrial();

    return type;
  }

  private intlArguments(
    args: CallArgument[],
    from: int,
    service: IntlService,
    what: string,
    module: int,
  ): boolean {
    const locale = args[from];
    const options = args[from + 1];
    let isLocaleOk = true;

    if (locale != undefined && !locale.spread) {
      const given = this.typed(locale.expr, undefined, module);

      isLocaleOk = this.localeArgumentCheck(locale.expr, given, what, module);
    }
    if (options == undefined || options.spread) {
      return isLocaleOk;
    }

    const isDisplay = service.name == kDisplayNamesClass;

    return this.intlOptionsCheck(
      options.expr,
      service,
      what,
      isLocaleOk,
      isDisplay,
      module,
    );
  }

  private localeArgumentCheck(
    arg: Expr,
    given: Type,
    what: string,
    module: int,
  ): boolean {
    const base = this.types.definedType(given);
    if (base.kind == TypeKind.Error) {
      return false;
    }
    if (base.kind == TypeKind.Undefined || this.isLocaleValue(given)) {
      return true;
    }
    if (!this.intl.isTextLike(base)) {
      const takesError = this.intl.takesError(arg.loc, what, given);

      this.reportFound(module, takesError);

      return false;
    }

    return this.localeTagCheck(arg, given, what, false, module);
  }

  private isLocaleValue(given: Type): boolean {
    const base = this.types.definedType(given);

    return (
      base.kind == TypeKind.Instance &&
      base.name == kLocaleClass &&
      this.modules.isLibraryModule(base.module) &&
      !this.types.isOptional(given)
    );
  }

  private localeTagCheck(
    arg: Expr,
    given: Type,
    what: string,
    isConstructor: boolean,
    module: int,
  ): boolean {
    if (this.modules.isLibraryModule(module)) {
      return true;
    }

    const tags = this.encodingTexts(arg, given, module, 0);
    if (tags == undefined) {
      const unknownError = this.tagUnknownError(arg.loc, what, isConstructor);

      this.reportFound(module, unknownError);

      return false;
    }

    const wrong = tags.find((tag) => !this.intl.isLanguageTag(tag));
    if (wrong == undefined) {
      return true;
    }

    const notTagError = this.intl.notTagError(arg.loc, wrong);

    this.reportFound(module, notTagError);

    return false;
  }

  private tagUnknownError(
    loc: int,
    what: string,
    isConstructor: boolean,
  ): SourceError {
    if (isConstructor) {
      return this.intl.tagUnknownLocaleError(loc);
    }

    return this.intl.tagUnknownError(loc, what);
  }

  private localeListCheck(list: Expr, what: string, module: int): boolean {
    if (list.kind == ExprKind.ArrayLit) {
      const text = this.store.plain(TypeKind.String);
      const wanted = this.store.arrayOf(text);

      this.typed(list, wanted, module);

      return this.localeElementsCheck(list.elements, what, module);
    }

    const given = this.typed(list, undefined, module);
    const base = this.types.definedType(given);
    if (base.kind == TypeKind.Error) {
      return false;
    }
    if (base.kind != TypeKind.Array) {
      return this.localeArgumentCheck(list, given, what, module);
    }
    if (this.types.definedType(base.item).kind != TypeKind.String) {
      const listError = this.intl.listError(list.loc, what, given);

      this.reportFound(module, listError);

      return false;
    }

    const listOpenError = this.intl.listOpenError(list.loc, what);

    this.reportFound(module, listOpenError);

    return false;
  }

  private localeElementsCheck(
    elements: ArrayElement[],
    what: string,
    module: int,
  ): boolean {
    for (const element of elements) {
      if (element.spread) {
        const spreadError = this.intl.spreadError(element.expr.loc, what);

        this.reportFound(module, spreadError);

        return false;
      }

      const given = this.peekType(element.expr, module);
      if (!this.localeTagCheck(element.expr, given, what, false, module)) {
        return false;
      }
    }

    return true;
  }

  private intlOptionsCheck(
    options: Expr,
    service: IntlService,
    what: string,
    isLocaleOk: boolean,
    isDisplay: boolean,
    module: int,
  ): boolean {
    const given = this.typed(options, undefined, module);
    const base = this.types.definedType(given);
    if (given.kind == TypeKind.Error || this.modules.isLibraryModule(module)) {
      return false;
    }
    if (given.kind == TypeKind.Undefined && isDisplay) {
      const noTypeError = this.intl.optionsNoTypeError(options.loc);

      this.reportFound(module, noTypeError);

      return false;
    }
    if (!this.intl.isPlainOptions(given)) {
      const objectError = this.intl.optionsObjectError(
        options.loc,
        what,
        given,
      );

      this.reportFound(module, objectError);

      return false;
    }
    if (base.kind != TypeKind.Object) {
      return isLocaleOk;
    }

    let isFine = isLocaleOk;

    for (const field of base.fields) {
      const isFieldOk = this.intlFieldCheck(
        options,
        field,
        service,
        what,
        module,
      );

      isFine = isFine && isFieldOk;
    }

    if (!isFine) {
      return false;
    }

    const isTextOk = this.intlTextsCheck(options, base.fields, service, module);
    const isDeclared =
      options.kind != ExprKind.ObjectLit &&
      this.store.labelOf(base) != undefined;
    if (isDeclared) {
      return isTextOk;
    }

    const isRangeOk = this.intlRangesCheck(options, base.fields, module);
    const isPairOk = this.intlPairsCheck(options, base.fields, module);
    const isRoundOk = this.intlRoundingCheck(options, base.fields, module);

    return isTextOk && isRangeOk && isPairOk && isRoundOk;
  }

  private intlFieldCheck(
    options: Expr,
    field: ObjectField,
    service: IntlService,
    what: string,
    module: int,
  ): boolean {
    const option = this.intl.option(service, field.name);
    const loc = this.optionLoc(options, field.name);
    if (option == undefined) {
      const unknownError = this.intl.unknownOptionError(
        loc,
        field.name,
        what,
        service,
      );

      this.reportFound(module, unknownError);

      return false;
    }

    const value = this.types.definedType(field.type);
    if (value.kind == TypeKind.Undefined) {
      return true;
    }
    if (!this.intl.kindFits(option.kind, value)) {
      const kindError = this.intl.optionKindError(loc, option, field.type);

      this.reportFound(module, kindError);

      return false;
    }

    const text = this.optionText(options, field);
    const isListed = option.values.length > 0;
    if (
      text != undefined &&
      isListed &&
      !this.intl.isAllowedText(option, text)
    ) {
      const badValueError = this.intl.badValueError(loc, option, text);

      this.reportFound(module, badValueError);

      return false;
    }

    const isClosed =
      option.kind != IntlOptionKind.Number &&
      option.kind != IntlOptionKind.Flag;
    if (text != undefined || !isListed || !isClosed) {
      return true;
    }

    return this.intlValuesCheck(options, field, option, loc, module);
  }

  private intlValuesCheck(
    options: Expr,
    field: ObjectField,
    option: IntlOption,
    loc: int,
    module: int,
  ): boolean {
    const value = this.optionValue(options, field.name);
    let texts = this.intl.literalTexts(field.type);

    if (value != undefined) {
      const given = this.peekType(value, module);
      const known = this.encodingTexts(value, given, module, 0);

      texts = known ?? texts;
    }
    if (texts == undefined) {
      const openError = this.intl.openValueError(loc, option);

      this.reportFound(module, openError);

      return false;
    }

    const wrong = texts.find((one) => !this.intl.isAllowedText(option, one));
    if (wrong == undefined) {
      return true;
    }

    const badValueError = this.intl.badValueError(loc, option, wrong);

    this.reportFound(module, badValueError);

    return false;
  }

  private intlTextsCheck(
    options: Expr,
    fields: ObjectField[],
    service: IntlService,
    module: int,
  ): boolean {
    let isFine = true;
    const currency = this.optionTextNamed(options, fields, kCurrencyOption);
    const unit = this.optionTextNamed(options, fields, kUnitOption);

    if (currency != undefined && !this.intl.isCurrency(currency)) {
      const loc = this.optionLoc(options, kCurrencyOption);

      this.reportFound(module, this.intl.currencyError(loc, currency));

      isFine = false;
    }
    if (unit != undefined && !this.intl.isUnit(unit)) {
      const loc = this.optionLoc(options, kUnitOption);

      this.reportFound(module, this.intl.unitError(loc, unit));

      isFine = false;
    }

    for (const name of kKeywordOptions) {
      const value = this.optionTextNamed(options, fields, name);
      if (value != undefined && !this.intl.isKeywordType(value)) {
        const loc = this.optionLoc(options, name);

        this.reportFound(module, this.intl.keywordError(loc, value, name));

        isFine = false;
      }
    }

    const isStyleOk = this.intlStyleCheck(options, fields, service, module);
    const hasType = fields.some((one) => one.name == kTypeOption);
    if (service.name == kDisplayNamesClass && !hasType) {
      this.reportFound(module, this.intl.optionsNoTypeError(options.loc));

      return false;
    }

    return isFine && isStyleOk;
  }

  private intlStyleCheck(
    options: Expr,
    fields: ObjectField[],
    service: IntlService,
    module: int,
  ): boolean {
    const style = fields.find((one) => one.name == kStyleOption);
    if (style == undefined || service.name != kNumberFormatClass) {
      return true;
    }

    const written = this.optionText(options, style);
    const listed = this.intl.literalTexts(style.type) ?? [];
    const styles = this.writtenStyles(written, listed);
    const hasCurrency = fields.some((one) => one.name == kCurrencyOption);
    const hasUnit = fields.some((one) => one.name == kUnitOption);
    const loc = this.optionLoc(options, kStyleOption);
    let isFine = true;

    if (styles.includes(kCurrencyOption) && !hasCurrency) {
      this.reportFound(module, this.intl.styleCurrencyError(loc));

      isFine = false;
    }
    if (styles.includes(kUnitOption) && !hasUnit) {
      this.reportFound(module, this.intl.styleUnitError(loc));

      isFine = false;
    }

    return isFine;
  }

  private writtenStyles(
    written: string | undefined,
    listed: string[],
  ): string[] {
    if (written != undefined) {
      return [written];
    }

    return listed;
  }

  private intlRangesCheck(
    options: Expr,
    fields: ObjectField[],
    module: int,
  ): boolean {
    let isFine = true;

    for (const range of kDigitRanges) {
      const field = fields.find((one) => one.name == range.name);
      if (
        field != undefined &&
        !this.digitRangeCheck(options, field, range, module)
      ) {
        isFine = false;
      }
    }

    return isFine;
  }

  private digitRangeCheck(
    options: Expr,
    field: ObjectField,
    range: IntlDigitRange,
    module: int,
  ): boolean {
    const loc = this.optionLoc(options, field.name);
    const constant = this.optionNumber(options, field);
    if (constant != undefined) {
      const isInside = constant >= range.low && constant <= range.high;
      if (!isInside) {
        const rangeError = this.intl.digitRangeError(
          loc,
          range.name,
          range.low,
          range.high,
          true,
        );

        this.reportFound(module, rangeError);
      }

      return isInside;
    }

    const value = this.optionValue(options, field.name);
    if (value != undefined) {
      const given = this.peekType(value, module);
      const base = this.types.definedType(given);
      const proof: ProofRange = { what: "", low: range.low, high: range.high };
      const isInt = base.kind == TypeKind.Int;
      if (isInt && this.canProveBetween(value, proof, module)) {
        return true;
      }
    }

    const openError = this.intl.digitRangeError(
      loc,
      range.name,
      range.low,
      range.high,
      false,
    );

    this.reportFound(module, openError);

    return false;
  }

  private intlPairsCheck(
    options: Expr,
    fields: ObjectField[],
    module: int,
  ): boolean {
    if (options.kind != ExprKind.ObjectLit) {
      return true;
    }

    let isFine = true;

    for (const pair of kDigitPairs) {
      const low = fields.find((one) => one.name == pair.low);
      const high = fields.find((one) => one.name == pair.high);
      if (low == undefined || high == undefined) {
        continue;
      }
      if (this.isNotAbove(options, low, high, module)) {
        continue;
      }

      const isKnown =
        this.optionNumber(options, low) != undefined &&
        this.optionNumber(options, high) != undefined;
      const loc = this.optionLoc(options, pair.high);
      const aboveError = this.intl.aboveError(
        loc,
        pair.low,
        pair.high,
        isKnown,
      );

      this.reportFound(module, aboveError);

      isFine = false;
    }

    return isFine;
  }

  private isNotAbove(
    options: Expr,
    low: ObjectField,
    high: ObjectField,
    module: int,
  ): boolean {
    const lowNumber = this.optionNumber(options, low);
    const highNumber = this.optionNumber(options, high);
    if (lowNumber != undefined && highNumber != undefined) {
      return lowNumber.round(0, "floor") <= highNumber.round(0, "floor");
    }

    const lowLinear = this.optionLinear(options, low, lowNumber, module);
    const highLinear = this.optionLinear(options, high, highNumber, module);
    if (lowLinear == undefined || highLinear == undefined) {
      return false;
    }
    if (lowLinear.term == highLinear.term) {
      return lowLinear.offset <= highLinear.offset;
    }

    const room = lowLinear.offset - highLinear.offset;

    return this.canProve(lowLinear.term, highLinear.term, room);
  }

  private optionLinear(
    options: Expr,
    field: ObjectField,
    constant: decimal | undefined,
    module: int,
  ): Linear | undefined {
    const value = this.optionValue(options, field.name);
    if (value != undefined) {
      const linear = this.linearOf(value, module);
      if (linear != undefined) {
        return linear;
      }
    }
    if (constant == undefined || constant != constant.round(0, "floor")) {
      return undefined;
    }

    return { term: kZeroTerm, offset: constant };
  }

  private intlRoundingCheck(
    options: Expr,
    fields: ObjectField[],
    module: int,
  ): boolean {
    const field = fields.find((one) => one.name == kRoundingOption);
    if (field == undefined) {
      return true;
    }

    const constant = this.optionNumber(options, field);
    const isUnion = this.intl.isIncrementUnion(field.type, kRoundingIncrements);
    const isKnown = constant != undefined || isUnion;
    const isListed =
      constant == undefined || kRoundingIncrements.includes(constant);
    const isLiteral = options.kind == ExprKind.ObjectLit;
    const loc = this.optionLoc(options, kRoundingOption);
    if (isLiteral && isKnown && constant != 1 && isListed) {
      this.incrementDigitsCheck(options, fields, loc, module);
    }
    if (isKnown && isListed) {
      return true;
    }

    const incrementsError = this.intl.incrementsError(
      loc,
      constant != undefined,
    );

    this.reportFound(module, incrementsError);

    return false;
  }

  private incrementDigitsCheck(
    options: Expr,
    fields: ObjectField[],
    loc: int,
    module: int,
  ): void {
    const isSignificant = fields.some(
      (one) =>
        one.name == "minimumSignificantDigits" ||
        one.name == "maximumSignificantDigits",
    );
    if (isSignificant) {
      return this.reportFound(module, this.intl.incrementSignificantError(loc));
    }

    const low = fields.find((one) => one.name == "minimumFractionDigits");
    const high = fields.find((one) => one.name == "maximumFractionDigits");
    const isSame =
      low != undefined &&
      high != undefined &&
      this.isNotAbove(options, low, high, module) &&
      this.isNotAbove(options, high, low, module);
    if (!isSame) {
      this.reportFound(module, this.intl.incrementSameError(loc));
    }
  }

  private optionValue(options: Expr, name: string): Expr | undefined {
    if (options.kind != ExprKind.ObjectLit) {
      return undefined;
    }

    const found = options.props.find(
      (one) => one.form.kind != PropertyKind.Spread && one.name == name,
    );

    return found?.value;
  }

  private optionLoc(options: Expr, name: string): int {
    const value = this.optionValue(options, name);

    return value?.loc ?? options.loc;
  }

  private optionText(options: Expr, field: ObjectField): string | undefined {
    const value = this.optionValue(options, field.name);
    if (value != undefined) {
      const written = this.textCoders.literalLabel(value);
      if (written != undefined) {
        return written;
      }
    }

    const texts = this.intl.literalTexts(field.type);
    const base = this.types.definedType(field.type);
    if (
      texts == undefined ||
      texts.length != 1 ||
      base.kind != TypeKind.Literal
    ) {
      return undefined;
    }

    return texts[0];
  }

  private optionTextNamed(
    options: Expr,
    fields: ObjectField[],
    name: string,
  ): string | undefined {
    const field = fields.find((one) => one.name == name);
    if (field == undefined) {
      return undefined;
    }

    return this.optionText(options, field);
  }

  private optionNumber(options: Expr, field: ObjectField): decimal | undefined {
    const value = this.optionValue(options, field.name);
    if (value != undefined) {
      const written = this.writtenNumber(value);
      if (written != undefined) {
        return written;
      }
    }

    return this.intl.literalNumber(field.type);
  }

  private writtenNumber(value: Expr): decimal | undefined {
    if (value.kind == ExprKind.Unary && value.op == UnaryOp.Neg) {
      const inner = this.writtenNumber(value.operand);

      return this.oppositeOf(inner);
    }
    if (value.kind == ExprKind.IntLit) {
      return value.value.toDecimal();
    }
    if (value.kind != ExprKind.FloatLit) {
      return undefined;
    }

    const parsed = decimal(`${value.value}`);
    if (parsed.isErr()) {
      return undefined;
    }

    return parsed.value;
  }

  private intlNamespaceCall(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): Type | undefined {
    const object = member.object;
    if (object.kind == ExprKind.Member) {
      return this.intlStaticCall(expr, member, object, module);
    }
    if (object.kind != ExprKind.Name || object.name != kIntlName) {
      return undefined;
    }
    if (
      !this.isGlobalUse(object, module) ||
      expr.args.some((one) => one.spread)
    ) {
      return undefined;
    }

    const name = member.name;
    if (name == kDateTimeFormatClass) {
      return undefined;
    }
    if (name == kCanonicalName) {
      return this.canonicalCall(expr, module);
    }
    if (name == kValuesOfName || name == kLocaleClass) {
      return this.intlRefusedCall(expr, member, module);
    }

    const service = this.intl.service(name);
    if (service == undefined) {
      const unknownError = this.intl.unknownServiceError(member.loc, name);

      this.reportFound(module, unknownError);
      this.looseArguments(expr.args, module);

      return this.store.plain(TypeKind.Error);
    }
    if (!service.callable) {
      const withNewError = this.intl.withNewError(member.loc, name);

      this.reportFound(module, withNewError);
      this.looseArguments(expr.args, module);

      return this.store.plain(TypeKind.Error);
    }

    const what = `${kIntlPrefix}${name}`;

    this.intlArguments(expr.args, 0, service, what, module);

    return this.namedLibraryType(what, member.loc, module);
  }

  private intlRefusedCall(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): Type {
    const refusedError = this.intlRefusedError(member);

    this.reportFound(module, refusedError);
    this.looseArguments(expr.args, module);

    return this.store.plain(TypeKind.Error);
  }

  private intlRefusedError(member: MemberExpr): SourceError {
    if (member.name == kLocaleClass) {
      return this.intl.localeNewError(member.loc);
    }

    return this.intl.valuesOfError(member.loc);
  }

  private canonicalCall(expr: CallExpr, module: int): Type {
    const list = expr.args[0];
    const text = this.store.plain(TypeKind.String);
    if (list != undefined) {
      this.localeListCheck(list.expr, "Intl.getCanonicalLocales", module);
    }

    return this.store.arrayOf(text);
  }

  private intlStaticCall(
    expr: CallExpr,
    member: MemberExpr,
    owner: MemberExpr,
    module: int,
  ): Type | undefined {
    const root = owner.object;
    if (root.kind != ExprKind.Name || root.name != kIntlName) {
      return undefined;
    }
    if (!this.isGlobalUse(root, module) || owner.name == kLocaleClass) {
      return undefined;
    }

    const what = `${kIntlPrefix}${owner.name}.${member.name}`;
    const isService =
      owner.name == kDateTimeFormatClass ||
      this.intl.service(owner.name) != undefined;
    if (!isService || member.name != kSupportedName) {
      const staticError = this.intl.staticOnlyError(member.loc, what);

      this.reportFound(module, staticError);
      this.looseArguments(expr.args, module);

      return this.store.plain(TypeKind.Error);
    }

    const list = expr.args[0];
    const options = expr.args[1];
    const text = this.store.plain(TypeKind.String);
    if (list == undefined) {
      return this.store.arrayOf(text);
    }
    if (this.localeListCheck(list.expr, what, module) && options != undefined) {
      const service = this.intl.supportedService();

      this.intlOptionsCheck(options.expr, service, what, true, false, module);
    }

    return this.store.arrayOf(text);
  }

  private intlMethodCall(
    expr: CallExpr,
    member: MemberExpr,
    instance: InstanceType,
    module: int,
  ): Type | undefined {
    const service = this.intlServiceOf(instance);
    const row = this.intl.method(service ?? "", member.name);
    if (service == undefined || row == undefined) {
      return undefined;
    }
    if (expr.args.some((one) => one.spread)) {
      return undefined;
    }

    switch (row.kind) {
      case IntlMethodKind.Unsupported:
        return this.intlUnsupported(expr, member, false, module);
      case IntlMethodKind.SelectRange:
        return this.intlUnsupported(expr, member, true, module);
      case IntlMethodKind.Compare:
        return this.compareCall(expr, member, module);
      case IntlMethodKind.Number:
        return this.intlNumberCall(expr, member, instance, module);
      case IntlMethodKind.Relative:
        return this.relativeCall(expr, member, instance, module);
      case IntlMethodKind.Containing:
        return this.containingCall(expr, member, instance, module);
      case IntlMethodKind.DateRange:
        return this.dateFormatRange(expr, member, module);
      default:
        return undefined;
    }
  }

  private intlServiceOf(instance: InstanceType): string | undefined {
    const home = this.resolver.namespaceModule(kIntlName);
    if (home == undefined || instance.module != home) {
      return undefined;
    }

    return instance.name;
  }

  private intlUnsupported(
    expr: CallExpr,
    member: MemberExpr,
    isSelect: boolean,
    module: int,
  ): Type {
    const unsupportedError = this.intlUnsupportedError(member, isSelect);

    this.reportFound(module, unsupportedError);
    this.looseArguments(expr.args, module);

    return this.store.plain(TypeKind.Error);
  }

  private intlUnsupportedError(
    member: MemberExpr,
    isSelect: boolean,
  ): SourceError {
    if (isSelect) {
      return this.intl.selectRangeError(member.loc);
    }

    return this.intl.rangeUnsupportedError(member.loc, member.name);
  }

  private compareCall(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): Type | undefined {
    if (expr.args.length == 2) {
      return undefined;
    }

    const word = this.calls.argumentCountText(2, 2, false);
    const other = `${expr.args.length}`;

    this.report(module, member.loc, Code.ArgumentCount, { word, other });
    this.looseArguments(expr.args, module);

    return this.store.plain(TypeKind.Error);
  }

  private intlNumberCall(
    expr: CallExpr,
    member: MemberExpr,
    instance: InstanceType,
    module: int,
  ): Type | undefined {
    const value = expr.args[0];
    if (value == undefined || expr.args.length != 1) {
      return undefined;
    }

    const given = this.typed(value.expr, undefined, module);
    const notNumberError = this.intl.notNumberError(
      value.expr.loc,
      member.name,
      given,
    );

    this.reportFound(module, notNumberError);

    return this.intlResult(instance, member.name);
  }

  private intlResult(instance: InstanceType, name: string): Type {
    const method = this.receiverMember(instance, name, true);
    if (method == undefined || method.kind != TypeKind.Function) {
      return this.store.plain(TypeKind.Error);
    }

    return method.shape.result;
  }

  private relativeCall(
    expr: CallExpr,
    member: MemberExpr,
    instance: InstanceType,
    module: int,
  ): Type | undefined {
    const value = expr.args[0];
    const unit = expr.args[1];
    if (value == undefined || unit == undefined || expr.args.length != 2) {
      return undefined;
    }

    this.typed(value.expr, undefined, module);

    const text = this.store.plain(TypeKind.String);
    const given = this.checked(unit.expr, text, module, "");
    const units = this.intl.relativeUnits();
    const written = this.textCoders.literalLabel(unit.expr);

    if (written != undefined && !this.intl.isRelativeUnit(written)) {
      const unitError = this.intl.relativeUnitError(unit.expr.loc, written);

      this.reportFound(module, unitError);
    }
    if (written == undefined) {
      this.closedTextCheck(unit.expr, given, units, "unit of time", module);
    }

    return this.intlResult(instance, member.name);
  }

  private containingCall(
    expr: CallExpr,
    member: MemberExpr,
    instance: InstanceType,
    module: int,
  ): Type | undefined {
    const index = expr.args[0];
    if (expr.args.length > 1) {
      return undefined;
    }
    if (index != undefined) {
      this.typed(index.expr, undefined, module);
    }

    return this.intlResult(instance, member.name);
  }

  private closedTextCheck(
    arg: Expr,
    given: Type,
    allowed: string[],
    what: string,
    module: int,
  ): void {
    if (given.kind == TypeKind.Error || this.modules.isLibraryModule(module)) {
      return;
    }

    const texts = this.encodingTexts(arg, given, module, 0);
    if (texts == undefined) {
      const unknownError = this.intl.closedUnknownError(arg.loc, what, allowed);

      return this.reportFound(module, unknownError);
    }

    const closedError = this.intl.closedError(arg.loc, what, allowed, texts);

    this.reportFound(module, closedError);
  }

  private intlMemberRead(
    expr: MemberExpr,
    instance: InstanceType,
    module: int,
  ): Type | undefined {
    const service = this.intlServiceOf(instance);
    if (service == undefined) {
      return undefined;
    }

    const found = this.declaredNamed(instance, expr.name);
    const isMethod =
      found != undefined && found.form.kind != DeclaredMemberKind.Field;
    if (!isMethod || this.intl.isValueMethod(service, expr.name)) {
      return undefined;
    }

    const onlyCalledError = this.intl.onlyCalledError(
      expr.loc,
      expr.name,
      service,
    );

    this.reportFound(module, onlyCalledError);

    return this.store.plain(TypeKind.Error);
  }

  private localeMethodCall(
    expr: CallExpr,
    member: MemberExpr,
    object: Type,
    module: int,
  ): Type | undefined {
    if (expr.args.some((one) => one.spread)) {
      return undefined;
    }

    const base = this.types.apparent(object);
    const name = member.name;
    const isNumber = this.types.isNumber(base) || base.kind == TypeKind.Decimal;
    const isText = base.kind == TypeKind.String;
    if (isNumber && name == kToLocaleName && expr.args.length <= 2) {
      return this.numberLocaleCall(expr, module);
    }
    if (isText && name == kLocaleCompareName && expr.args.length >= 1) {
      return this.localeCompareCall(expr, module);
    }
    if (isText && name == kNormalizeName && expr.args.length <= 1) {
      return this.normalizeCall(expr, module);
    }

    return undefined;
  }

  private numberLocaleCall(expr: CallExpr, module: int): Type {
    const service = this.intl.service(kNumberFormatClass);
    if (service != undefined) {
      this.intlArguments(expr.args, 0, service, kToLocaleName, module);
    }

    return this.store.plain(TypeKind.String);
  }

  private localeCompareCall(expr: CallExpr, module: int): Type {
    const that = expr.args[0];
    const text = this.store.plain(TypeKind.String);
    const service = this.intl.service(kCollatorClass);
    if (that != undefined) {
      this.checked(that.expr, text, module, "");
    }
    if (service != undefined) {
      this.intlArguments(expr.args, 1, service, kLocaleCompareName, module);
    }

    return this.store.integer(64, false);
  }

  private normalizeCall(expr: CallExpr, module: int): Type {
    const form = expr.args[0];
    const text = this.store.plain(TypeKind.String);
    if (form == undefined) {
      return text;
    }

    const given = this.checked(form.expr, text, module, "");
    const written = this.textCoders.literalLabel(form.expr);
    const forms = this.intl.normalizationForms();
    if (written != undefined && !forms.includes(written)) {
      const badFormError = this.intl.badFormError(form.expr.loc, written);

      this.reportFound(module, badFormError);
    }
    if (written == undefined) {
      this.closedTextCheck(
        form.expr,
        given,
        forms,
        "normalization form",
        module,
      );
    }

    return text;
  }
}
