import { SourceError } from "../../../../../diagnostic/types/message.types.tz";
import {
  ArrayElement,
  CallArgument,
  Expr,
  ExprKind,
  NewExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { TypeRefKind } from "../../../../../program/ast/types/ast.types.types.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import {
  TypeContext,
  TypePlace,
} from "../../../../types/type-resolver/types/type-resolver.types.tz";
import {
  kDateTimeFormatClass,
  kDisplayNamesClass,
  kIntlPrefix,
  kLocaleClass,
} from "../../../intl-rules/const/intl-rules.const.tz";
import { IntlService } from "../../../intl-rules/types/intl-rules.types.tz";
import {
  kEmptyList,
} from "../../../../../program/ast/ast-tree/const/ast-tree.const.tz";
import { TypeRef } from "../../../../../program/ast/types/ast.types.types.tz";

partial class ExpressionTypes {
  private intlNew(expr: NewExpr, name: string, module: int): Type {
    const tree = this.types.program.tree;

    if (name == kLocaleClass) {
      return this.localeNew(expr, module);
    }
    if (name == kDateTimeFormatClass) {
      this.dateFormatNew(expr, module);

      return this.namedLibraryType(`${kIntlPrefix}${name}`, expr.loc, module);
    }

    const service = this.tables.intlService(name);
    const what = `${kIntlPrefix}${name}`;
    if (service == undefined) {
      const unknownError = this.types.unknownServiceError(expr.loc, name);

      this.errors.writeFound(module, unknownError);
      const args = tree.argumentsOf(expr.argsList);

      this.looseArguments(args, module);

      return this.types.store.plain(TypeKind.Error);
    }
    if (
      name == kDisplayNamesClass &&
      tree.argumentsOf(expr.argsList).length < 2
    ) {
      const noTypeError = this.types.noTypeNewError(expr.loc);

      this.errors.writeFound(module, noTypeError);
      const argsItem = tree.argumentsOf(expr.argsList);

      this.looseArguments(argsItem, module);

      return this.types.store.plain(TypeKind.Error);
    }

    this.intlArguments(
      tree.argumentsOf(expr.argsList),
      0,
      service,
      what,
      module,
    );

    return this.namedLibraryType(what, expr.loc, module);
  }

  private localeNew(expr: NewExpr, module: int): Type {
    const tree = this.types.program.tree;

    const what = `${kIntlPrefix}${kLocaleClass}`;
    const options = tree.argumentsOf(expr.argsList)[1];
    if (options != undefined) {
      const optionsError = this.types.localeOptionsError(
        tree.exprOf(options.exprId).loc,
      );

      this.errors.writeFound(module, optionsError);
      const args = tree.argumentsOf(expr.argsList);

      this.looseArguments(args, module);

      return this.namedLibraryType(what, expr.loc, module);
    }

    const tag = tree.argumentsOf(expr.argsList)[0];
    if (tag != undefined && !tag.spread) {
      const exprExpr = tree.exprOf(tag.exprId);
      const given = this.typed(exprExpr, undefined, module);

      const tagExpr = tree.exprOf(tag.exprId);

      this.localeTagCheck(tagExpr, given, what, true, module);
    }

    return this.namedLibraryType(what, expr.loc, module);
  }

  private namedLibraryType(name: string, loc: int, module: int): Type {
    const context: TypeContext = {
      module,
      bindings: new Map<int, Type>(),
      place: TypePlace.Plain,
    };

    this.errors.beginTrial();

    const written: TypeRef = {
      form: { kind: TypeRefKind.Name },
      id: -1,
      name,
      loc,
      argsList: kEmptyList,
    };
    const type = this.types.resolve(written, context);

    this.errors.endTrial();

    return type;
  }

  private intlArguments(
    args: Read<CallArgument[]>,
    from: int,
    service: Read<IntlService>,
    what: string,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const locale = args[from];
    const options = args[from + 1];
    let isLocaleOk = true;

    if (locale != undefined && !locale.spread) {
      const expr = tree.exprOf(locale.exprId);
      const given = this.typed(expr, undefined, module);

      isLocaleOk = this.localeArgumentCheck(
        tree.exprOf(locale.exprId),
        given,
        what,
        module,
      );
    }
    if (options == undefined || options.spread) {
      return isLocaleOk;
    }

    const isDisplay = service.name == kDisplayNamesClass;

    return this.intlOptionsCheck(
      tree.exprOf(options.exprId),
      service,
      what,
      isLocaleOk,
      isDisplay,
      module,
    );
  }

  private localeArgumentCheck(
    arg: Expr,
    given: Type,
    what: string,
    module: int,
  ): boolean {
    const base = this.types.definedType(given);
    if (base.kind == TypeKind.Error) {
      return false;
    }
    if (base.kind == TypeKind.Undefined || this.isLocaleValue(given)) {
      return true;
    }
    if (!this.types.isTextLike(base)) {
      const takesError = this.types.intlTakesError(arg.loc, what, given);

      this.errors.writeFound(module, takesError);

      return false;
    }

    return this.localeTagCheck(arg, given, what, false, module);
  }

  private isLocaleValue(given: Type): boolean {
    const base = this.types.definedType(given);

    return (
      base.kind == TypeKind.Instance &&
      base.name == kLocaleClass &&
      this.types.isLibraryModule(base.module) &&
      !this.types.isOptional(given)
    );
  }

  private localeTagCheck(
    arg: Expr,
    given: Type,
    what: string,
    isConstructor: boolean,
    module: int,
  ): boolean {
    if (this.types.isLibraryModule(module)) {
      return true;
    }

    const tags = this.encodingTexts(arg, given, module, 0);
    if (tags == undefined) {
      const unknownError = this.tagUnknownError(arg.loc, what, isConstructor);

      this.errors.writeFound(module, unknownError);

      return false;
    }

    const wrong = tags.find((tag) => !this.types.isLanguageTag(tag));
    if (wrong == undefined) {
      return true;
    }

    const notTagError = this.types.notTagError(arg.loc, wrong);

    this.errors.writeFound(module, notTagError);

    return false;
  }

  private readonly tagUnknownError(
    loc: int,
    what: string,
    isConstructor: boolean,
  ): SourceError {
    if (isConstructor) {
      return this.types.tagUnknownLocaleError(loc);
    }

    return this.types.tagUnknownError(loc, what);
  }

  private localeListCheck(list: Expr, what: string, module: int): boolean {
    const tree = this.types.program.tree;

    if (list.kind == ExprKind.ArrayLit) {
      const text = this.types.store.plain(TypeKind.String);
      const wanted = this.types.store.arrayOf(text);

      this.typed(list, wanted, module);

      return this.localeElementsCheck(
        tree.elementsOf(list.elementsList),
        what,
        module,
      );
    }

    const given = this.typed(list, undefined, module);
    const base = this.types.definedType(given);
    if (base.kind == TypeKind.Error) {
      return false;
    }
    if (base.kind != TypeKind.Array) {
      return this.localeArgumentCheck(list, given, what, module);
    }
    if (
      this.types.definedType(this.types.store.itemOf(base)).kind !=
      TypeKind.String
    ) {
      const listError = this.types.listError(list.loc, what, given);

      this.errors.writeFound(module, listError);

      return false;
    }

    const listOpenError = this.types.listOpenError(list.loc, what);

    this.errors.writeFound(module, listOpenError);

    return false;
  }

  private localeElementsCheck(
    elements: Read<ArrayElement[]>,
    what: string,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    for (const element of elements) {
      if (element.spread) {
        const spreadError = this.types.spreadError(
          tree.exprOf(element.exprId).loc,
          what,
        );

        this.errors.writeFound(module, spreadError);

        return false;
      }

      const expr = tree.exprOf(element.exprId);
      const given = this.peekType(expr, module);
      if (
        !this.localeTagCheck(
          tree.exprOf(element.exprId),
          given,
          what,
          false,
          module,
        )
      ) {
        return false;
      }
    }

    return true;
  }
}
