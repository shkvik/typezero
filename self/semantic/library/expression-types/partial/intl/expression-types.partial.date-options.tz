import {
  CallArgument,
  CallExpr,
  Expr,
  MemberExpr,
  NewExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { ProofRange } from "../../../../flow/proof-rules/types/proof-rules.types.tz";
import {
  ObjectField,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import {
  DateLocaleKind,
  DateOption,
  DateOptionRole,
} from "../../../intl-rules/types/intl-rules.types.tz";

partial class ExpressionTypes {
  private dateLocaleCall(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    if (
      tree.argumentsOf(expr.argsList).length > 2 ||
      tree.argumentsOf(expr.argsList).some((one) => one.spread)
    ) {
      return undefined;
    }

    const kind = this.dateLocaleKind(member.name);

    this.dateArguments(
      tree.argumentsOf(expr.argsList),
      member.name,
      kind,
      module,
    );

    return this.types.store.plain(TypeKind.String);
  }

  private readonly dateLocaleKind(name: string): DateLocaleKind {
    if (name == "toLocaleDateString") {
      return DateLocaleKind.Date;
    }
    if (name == "toLocaleTimeString") {
      return DateLocaleKind.Time;
    }

    return DateLocaleKind.Any;
  }

  private dateFormatNew(expr: NewExpr, module: int): void {
    const tree = this.types.program.tree;

    if (
      tree.argumentsOf(expr.argsList).length > 2 ||
      tree.argumentsOf(expr.argsList).some((one) => one.spread)
    ) {
      const args = tree.argumentsOf(expr.argsList);

      return this.looseArguments(args, module);
    }

    this.dateArguments(
      tree.argumentsOf(expr.argsList),
      "Intl.DateTimeFormat",
      DateLocaleKind.Any,
      module,
    );
  }

  private dateArguments(
    args: Read<CallArgument[]>,
    what: string,
    kind: DateLocaleKind,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const locale = args[0];
    const options = args[1];

    if (locale != undefined) {
      const expr = tree.exprOf(locale.exprId);
      const given = this.typed(expr, undefined, module);

      const exprExpr = tree.exprOf(locale.exprId);

      this.localeArgumentCheck(exprExpr, given, what, module);
    }
    if (options != undefined) {
      const optionsExpr = tree.exprOf(options.exprId);

      this.dateOptionsCheck(optionsExpr, what, kind, module);
    }
  }

  private dateOptionsCheck(
    options: Expr,
    what: string,
    kind: DateLocaleKind,
    module: int,
  ): void {
    const given = this.typed(options, undefined, module);
    const base = this.types.definedType(given);
    if (given.kind == TypeKind.Error || given.kind == TypeKind.Undefined) {
      return;
    }
    if (this.types.isLibraryModule(module)) {
      return;
    }
    if (base.kind != TypeKind.Object) {
      const objectError = this.types.dateObjectError(
        options.loc,
        what,
        given,
      );

      return this.errors.writeFound(module, objectError);
    }

    this.dateKindsCheck(
      options,
      this.types.store.fieldsOf(base),
      what,
      kind,
      module,
    );
    this.dateValuesCheck(options, this.types.store.fieldsOf(base), module);
  }

  private dateKindsCheck(
    options: Expr,
    fields: Read<ObjectField[]>,
    what: string,
    kind: DateLocaleKind,
    module: int,
  ): void {
    let hasStyle = false;
    let hasComponent = false;

    for (const field of fields) {
      const option = this.tables.dateOption(field.name);
      if (option == undefined) {
        const unknownError = this.types.dateUnknownError(
          options.loc,
          field.name,
          what,
        );

        this.errors.writeFound(module, unknownError);

        continue;
      }
      if (!this.dateKindFits(options, field, module)) {
        continue;
      }

      const isPresent = !field.optional && !this.types.isOptional(field.type);
      if (option.role == DateOptionRole.Component) {
        hasComponent = hasComponent || isPresent;
      }
      if (option.role == DateOptionRole.Style) {
        hasStyle = hasStyle || isPresent;
      }

      const isForeign = this.types.isForeignStyle(field.name, kind);
      if (option.role == DateOptionRole.Style && isPresent && isForeign) {
        const styleError = this.types.styleOnlyError(
          options.loc,
          field.name,
          what,
        );

        this.errors.writeFound(module, styleError);
      }
    }

    if (hasStyle && hasComponent) {
      this.errors.writeFound(module, this.types.stylePartsError(options.loc));
    }
  }

  private dateKindFits(
    options: Expr,
    field: ObjectField,
    module: int,
  ): boolean {
    const wanted = this.dateWanted(field);
    if (wanted == "") {
      return true;
    }

    const kindError = this.types.dateKindError(
      options.loc,
      field.name,
      wanted,
      field.type,
    );

    this.errors.writeFound(module, kindError);

    return false;
  }

  private dateWanted(field: ObjectField): string {
    const value = this.types.definedType(field.type);
    if (this.types.isHour12(field.name)) {
      return this.wantedIf(!this.types.isFlagType(value), "a boolean");
    }
    if (this.types.isDigitsName(field.name)) {
      const isNumber =
        this.types.isIntlNumberLike(value) ||
        this.types.numberLiterals(value) != undefined;

      return this.wantedIf(!isNumber, "a number");
    }

    return this.wantedIf(!this.types.isTextUnion(value), "a string");
  }

  private readonly wantedIf(isWrong: boolean, wanted: string): string {
    if (isWrong) {
      return wanted;
    }

    return "";
  }

  private dateValuesCheck(
    options: Expr,
    fields: Read<ObjectField[]>,
    module: int,
  ): void {
    for (const field of fields) {
      const option = this.tables.dateOption(field.name);
      const given = this.optionValue(options, field.name);
      const loc = this.optionLoc(options, field.name);
      if (option == undefined) {
        continue;
      }
      if (this.types.isDigitsName(field.name)) {
        this.dateDigitsCheck(field, given, loc, module);

        continue;
      }

      this.dateTextCheck(field, option, given, loc, module);
    }
  }

  private dateDigitsCheck(
    field: ObjectField,
    given: Expr | undefined,
    loc: int,
    module: int,
  ): void {
    if (given != undefined) {
      const type = this.peekType(given, module);
      const range: ProofRange = {
        what: "fractionalSecondDigits",
        low: 1,
        high: 3,
      };

      this.requireBetween(given, type, range, module);

      return;
    }

    const digits = this.types.numberLiterals(field.type);
    const isInside =
      digits != undefined && digits.every((one) => one >= 1 && one <= 3);
    if (!isInside) {
      this.errors.writeFound(module, this.types.digitsOpenError(loc));
    }
  }

  private dateTextCheck(
    field: ObjectField,
    option: Read<DateOption>,
    given: Expr | undefined,
    loc: int,
    module: int,
  ): void {
    if (option.values.length == 0) {
      return;
    }

    const texts = this.dateTexts(field, given, module);
    if (texts == undefined) {
      const written = this.writtenOption(given, module);
      const openError = this.types.dateValueOpenError(loc, option, written);

      return this.errors.writeFound(module, openError);
    }

    const wrong = texts.find((one) => !option.values.includes(one));
    if (wrong != undefined) {
      this.errors.writeFound(
        module,
        this.types.dateValueError(loc, option, wrong),
      );
    }
  }

  private dateTexts(
    field: ObjectField,
    given: Expr | undefined,
    module: int,
  ): string[] | undefined {
    if (given != undefined) {
      const type = this.peekType(given, module);
      const known = this.encodingTexts(given, type, module, 0);
      if (known != undefined) {
        return known;
      }
    }

    const base = this.types.definedType(field.type);
    const texts = this.types.literalTexts(base);
    const isText = this.types.isTextUnion(base) && base.kind != TypeKind.String;
    if (!isText) {
      return undefined;
    }

    return texts;
  }

  private readonly writtenOption(given: Expr | undefined, module: int): string {
    if (given == undefined) {
      return "value";
    }

    return this.types.valueText(given, module);
  }

  private dateFormatRange(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const rangeError = this.types.dateRangeError(member.loc, member.name);

    this.errors.writeFound(module, rangeError);
    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args, module);

    return this.types.store.plain(TypeKind.Error);
  }
}
