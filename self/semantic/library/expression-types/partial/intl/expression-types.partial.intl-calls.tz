import { Code } from "../../../../../diagnostic/code.tz";
import { SourceError } from "../../../../../diagnostic/types/message.types.tz";
import { DeclaredMemberKind } from "../../../../../program/ast/types/ast.types.declarations.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  InstanceType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  kCanonicalName,
  kCollatorClass,
  kDateTimeFormatClass,
  kIntlName,
  kIntlPrefix,
  kLocaleClass,
  kLocaleCompareName,
  kNormalizeName,
  kNumberFormatClass,
  kSupportedName,
  kToLocaleName,
  kValuesOfName,
} from "../../../intl-rules/const/intl-rules.const.tz";
import { IntlMethodKind } from "../../../intl-rules/types/intl-rules.types.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";

partial class ExpressionTypes {
  private intlNamespaceCall(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const object = tree.exprOf(member.objectId);
    if (object.kind == ExprKind.Member) {
      return this.intlStaticCall(expr, member, object, module);
    }
    if (object.kind != ExprKind.Name || object.name != kIntlName) {
      return undefined;
    }
    if (
      !this.isGlobalUse(object, module) ||
      tree.argumentsOf(expr.argsList).some((one) => one.spread)
    ) {
      return undefined;
    }

    const name = member.name;
    if (name == kDateTimeFormatClass) {
      return undefined;
    }
    if (name == kCanonicalName) {
      return this.canonicalCall(expr, module);
    }
    if (name == kValuesOfName || name == kLocaleClass) {
      return this.intlRefusedCall(expr, member, module);
    }

    const service = this.tables.intlService(name);
    if (service == undefined) {
      const unknownError = this.types.unknownServiceError(member.loc, name);

      this.errors.writeFound(module, unknownError);
      const args = tree.argumentsOf(expr.argsList);

      this.looseArguments(args, module);

      return this.types.store.plain(TypeKind.Error);
    }
    if (!service.callable) {
      const withNewError = this.types.withNewError(member.loc, name);

      this.errors.writeFound(module, withNewError);
      const argsItem = tree.argumentsOf(expr.argsList);

      this.looseArguments(argsItem, module);

      return this.types.store.plain(TypeKind.Error);
    }

    const what = `${kIntlPrefix}${name}`;

    this.intlArguments(
      tree.argumentsOf(expr.argsList),
      0,
      service,
      what,
      module,
    );

    return this.namedLibraryType(what, member.loc, module);
  }

  private intlRefusedCall(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const refusedError = this.intlRefusedError(member);

    this.errors.writeFound(module, refusedError);
    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args, module);

    return this.types.store.plain(TypeKind.Error);
  }

  private readonly intlRefusedError(member: MemberExpr): SourceError {
    if (member.name == kLocaleClass) {
      return this.types.localeNewError(member.loc);
    }

    return this.types.valuesOfError(member.loc);
  }

  private canonicalCall(expr: CallExpr, module: int): Type {
    const tree = this.types.program.tree;

    const list = tree.argumentsOf(expr.argsList)[0];
    const text = this.types.store.plain(TypeKind.String);
    if (list != undefined) {
      this.localeListCheck(
        tree.exprOf(list.exprId),
        "Intl.getCanonicalLocales",
        module,
      );
    }

    return this.types.store.arrayOf(text);
  }

  private intlStaticCall(
    expr: CallExpr,
    member: MemberExpr,
    owner: MemberExpr,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const root = tree.exprOf(owner.objectId);
    if (root.kind != ExprKind.Name || root.name != kIntlName) {
      return undefined;
    }
    if (!this.isGlobalUse(root, module) || owner.name == kLocaleClass) {
      return undefined;
    }

    const what = `${kIntlPrefix}${owner.name}.${member.name}`;
    const isService =
      owner.name == kDateTimeFormatClass ||
      this.tables.intlService(owner.name) != undefined;
    if (!isService || member.name != kSupportedName) {
      const staticError = this.types.staticOnlyError(member.loc, what);

      this.errors.writeFound(module, staticError);
      const args = tree.argumentsOf(expr.argsList);

      this.looseArguments(args, module);

      return this.types.store.plain(TypeKind.Error);
    }

    const list = tree.argumentsOf(expr.argsList)[0];
    const options = tree.argumentsOf(expr.argsList)[1];
    const text = this.types.store.plain(TypeKind.String);
    if (list == undefined) {
      return this.types.store.arrayOf(text);
    }
    if (
      this.localeListCheck(tree.exprOf(list.exprId), what, module) &&
      options != undefined
    ) {
      const service = this.tables.supportedService();

      this.intlOptionsCheck(
        tree.exprOf(options.exprId),
        service,
        what,
        true,
        false,
        module,
      );
    }

    return this.types.store.arrayOf(text);
  }

  private intlMethodCall(
    expr: CallExpr,
    member: MemberExpr,
    instance: InstanceType,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const service = this.intlServiceOf(instance);
    const row = this.types.method(service ?? "", member.name);
    if (service == undefined || row == undefined) {
      return undefined;
    }
    if (tree.argumentsOf(expr.argsList).some((one) => one.spread)) {
      return undefined;
    }

    switch (row.kind) {
      case IntlMethodKind.Unsupported:
        return this.intlUnsupported(expr, member, false, module);
      case IntlMethodKind.SelectRange:
        return this.intlUnsupported(expr, member, true, module);
      case IntlMethodKind.Compare:
        return this.compareCall(expr, member, module);
      case IntlMethodKind.Number:
        return this.intlNumberCall(expr, member, instance, module);
      case IntlMethodKind.Relative:
        return this.relativeCall(expr, member, instance, module);
      case IntlMethodKind.Containing:
        return this.containingCall(expr, member, instance, module);
      case IntlMethodKind.DateRange:
        return this.dateFormatRange(expr, member, module);
      default:
        return undefined;
    }
  }

  private readonly intlServiceOf(instance: InstanceType): string | undefined {
    const home = this.types.namespaceModule(kIntlName);
    if (home == undefined || instance.module != home) {
      return undefined;
    }

    return instance.name;
  }

  private intlUnsupported(
    expr: CallExpr,
    member: MemberExpr,
    isSelect: boolean,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const unsupportedError = this.intlUnsupportedError(member, isSelect);

    this.errors.writeFound(module, unsupportedError);
    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args, module);

    return this.types.store.plain(TypeKind.Error);
  }

  private readonly intlUnsupportedError(
    member: MemberExpr,
    isSelect: boolean,
  ): SourceError {
    if (isSelect) {
      return this.types.selectRangeError(member.loc);
    }

    return this.types.rangeUnsupportedError(member.loc, member.name);
  }

  private compareCall(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const argsItem = tree.argumentsOf(expr.argsList);
    if (argsItem.length == 2) {
      return undefined;
    }

    const word = this.types.argumentCountText(2, 2, false);
    const other = `${tree.argumentsOf(expr.argsList).length}`;

    this.errors.write(module, member.loc, Code.ArgumentCount, { word, other });
    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args, module);

    return this.types.store.plain(TypeKind.Error);
  }

  private intlNumberCall(
    expr: CallExpr,
    member: MemberExpr,
    instance: InstanceType,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const value = tree.argumentsOf(expr.argsList)[0];
    if (value == undefined || tree.argumentsOf(expr.argsList).length != 1) {
      return undefined;
    }

    const exprExpr = tree.exprOf(value.exprId);
    const given = this.typed(exprExpr, undefined, module);
    const notNumberError = this.types.notNumberError(
      tree.exprOf(value.exprId).loc,
      member.name,
      given,
    );

    this.errors.writeFound(module, notNumberError);

    return this.intlResult(instance, member.name);
  }

  private intlResult(instance: InstanceType, name: string): Type {
    const method = this.receiverMember(instance, name, true);
    if (method == undefined || method.kind != TypeKind.Function) {
      return this.types.store.plain(TypeKind.Error);
    }

    return this.types.store.returnTypeOf(method);
  }

  private relativeCall(
    expr: CallExpr,
    member: MemberExpr,
    instance: InstanceType,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const value = tree.argumentsOf(expr.argsList)[0];
    const unit = tree.argumentsOf(expr.argsList)[1];
    if (
      value == undefined ||
      unit == undefined ||
      tree.argumentsOf(expr.argsList).length != 2
    ) {
      return undefined;
    }

    const exprExpr = tree.exprOf(value.exprId);

    this.typed(exprExpr, undefined, module);

    const text = this.types.store.plain(TypeKind.String);
    const unitExpr = tree.exprOf(unit.exprId);
    const given = this.checked(unitExpr, text, module, "");
    const units = this.tables.relativeUnits();
    const written = this.types.literalLabel(tree.exprOf(unit.exprId));

    if (written != undefined && !this.types.isRelativeUnit(written)) {
      const unitError = this.types.relativeUnitError(
        tree.exprOf(unit.exprId).loc,
        written,
      );

      this.errors.writeFound(module, unitError);
    }
    if (written == undefined) {
      this.closedTextCheck(
        tree.exprOf(unit.exprId),
        given,
        units,
        "unit of time",
        module,
      );
    }

    return this.intlResult(instance, member.name);
  }

  private containingCall(
    expr: CallExpr,
    member: MemberExpr,
    instance: InstanceType,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const index = tree.argumentsOf(expr.argsList)[0];
    const args = tree.argumentsOf(expr.argsList);
    if (args.length > 1) {
      return undefined;
    }
    if (index != undefined) {
      const exprExpr = tree.exprOf(index.exprId);

      this.typed(exprExpr, undefined, module);
    }

    return this.intlResult(instance, member.name);
  }

  private closedTextCheck(
    arg: Expr,
    given: Type,
    allowed: Read<string[]>,
    what: string,
    module: int,
  ): void {
    if (given.kind == TypeKind.Error || this.types.isLibraryModule(module)) {
      return;
    }

    const texts = this.encodingTexts(arg, given, module, 0);
    if (texts == undefined) {
      const unknownError = this.types.closedUnknownError(
        arg.loc,
        what,
        allowed,
      );

      return this.errors.writeFound(module, unknownError);
    }

    const closedError = this.types.closedError(arg.loc, what, allowed, texts);

    this.errors.writeFound(module, closedError);
  }

  private intlMemberRead(
    expr: MemberExpr,
    instance: InstanceType,
    module: int,
  ): Type | undefined {
    const service = this.intlServiceOf(instance);
    if (service == undefined) {
      return undefined;
    }

    const found = this.declaredNamed(instance, expr.name);
    const isMethod =
      found != undefined && found.form.kind != DeclaredMemberKind.Field;
    if (!isMethod || this.types.isValueMethod(service, expr.name)) {
      return undefined;
    }

    const onlyCalledError = this.types.onlyCalledError(
      expr.loc,
      expr.name,
      service,
    );

    this.errors.writeFound(module, onlyCalledError);

    return this.types.store.plain(TypeKind.Error);
  }

  private localeMethodCall(
    expr: CallExpr,
    member: MemberExpr,
    object: Type,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    if (tree.argumentsOf(expr.argsList).some((one) => one.spread)) {
      return undefined;
    }

    const base = this.types.apparent(object);
    const name = member.name;
    const isNumber = this.types.isNumber(base) || base.kind == TypeKind.Decimal;
    const isText = base.kind == TypeKind.String;
    if (
      isNumber &&
      name == kToLocaleName &&
      tree.argumentsOf(expr.argsList).length <= 2
    ) {
      return this.numberLocaleCall(expr, module);
    }
    if (
      isText &&
      name == kLocaleCompareName &&
      tree.argumentsOf(expr.argsList).length >= 1
    ) {
      return this.localeCompareCall(expr, module);
    }
    if (
      isText &&
      name == kNormalizeName &&
      tree.argumentsOf(expr.argsList).length <= 1
    ) {
      return this.normalizeCall(expr, module);
    }

    return undefined;
  }

  private numberLocaleCall(expr: CallExpr, module: int): Type {
    const tree = this.types.program.tree;

    const service = this.tables.intlService(kNumberFormatClass);
    if (service != undefined) {
      this.intlArguments(
        tree.argumentsOf(expr.argsList),
        0,
        service,
        kToLocaleName,
        module,
      );
    }

    return this.types.store.plain(TypeKind.String);
  }

  private localeCompareCall(expr: CallExpr, module: int): Type {
    const tree = this.types.program.tree;

    const that = tree.argumentsOf(expr.argsList)[0];
    const text = this.types.store.plain(TypeKind.String);
    const service = this.tables.intlService(kCollatorClass);
    if (that != undefined) {
      const exprExpr = tree.exprOf(that.exprId);

      this.checked(exprExpr, text, module, "");
    }
    if (service != undefined) {
      this.intlArguments(
        tree.argumentsOf(expr.argsList),
        1,
        service,
        kLocaleCompareName,
        module,
      );
    }

    return this.types.store.integer(64, false);
  }

  private normalizeCall(expr: CallExpr, module: int): Type {
    const tree = this.types.program.tree;

    const form = tree.argumentsOf(expr.argsList)[0];
    const text = this.types.store.plain(TypeKind.String);
    if (form == undefined) {
      return text;
    }

    const exprExpr = tree.exprOf(form.exprId);
    const given = this.checked(exprExpr, text, module, "");
    const formExpr = tree.exprOf(form.exprId);
    const written = this.types.literalLabel(formExpr);
    const forms = this.tables.normalizationForms();
    if (written != undefined && !forms.includes(written)) {
      const badFormError = this.types.badFormError(
        tree.exprOf(form.exprId).loc,
        written,
      );

      this.errors.writeFound(module, badFormError);
    }
    if (written == undefined) {
      this.closedTextCheck(
        tree.exprOf(form.exprId),
        given,
        forms,
        "normalization form",
        module,
      );
    }

    return text;
  }
}
