import {
  BodySource,
  FunctionDecl,
  ParamKind,
} from "../../../../../program/ast/types/ast.types.functions.tz";
import {
  Expr,
  NewExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  kCStringName,
  kNulText,
} from "../../../foreign-rules/const/foreign-rules.const.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import {
  LiteralKind,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { TypeContext } from "../../../../types/type-resolver/types/type-resolver.types.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import {
  ParameterShape,
  ValueTarget,
} from "../../../../code/expression-types/types/expression-types.types.tz";

partial class ExpressionTypes {
  private foreignCheck(
    fn: FunctionDecl,
    shape: Read<ParameterShape>,
    context: Read<TypeContext>,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const isForeign = fn.bodySource == BodySource.Foreign;
    if (!isForeign || this.types.isLibraryModule(module)) {
      return;
    }
    if (tree.typeParamsOf(fn.typeParamsList).length > 0 || shape.rest) {
      return this.errors.writeFound(module, this.types.plainError(fn.loc));
    }

    for (let index = 0; index < tree.paramsOf(fn.paramsList).length; index++) {
      const param = tree.paramsOf(fn.paramsList)[index];
      const type = shape.params[index]?.type;
      if (param != undefined && type != undefined) {
        this.foreignParamCheck(param.loc, param.form.kind, type, module);
      }
    }

    const written = tree.typeRefAt(fn.returnTypeId);
    if (written == undefined) {
      return this.errors.writeFound(module, this.types.noReturnError(fn.loc));
    }

    const result = this.types.returnType(written, context);

    this.errors.writeFound(module, this.types.givesError(fn.loc, result));
  }

  private foreignParamCheck(
    loc: int,
    kind: ParamKind,
    type: Type,
    module: int,
  ): void {
    if (kind == ParamKind.Optional || kind == ParamKind.Defaulted) {
      return this.errors.writeFound(module, this.types.optionalError(loc));
    }

    this.errors.writeFound(module, this.types.takesError(loc, type));
  }

  private handleNew(
    expr: NewExpr,
    name: string,
    target: ValueTarget,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    if (target.kind != SymbolKind.Handle) {
      return undefined;
    }

    this.errors.writeFound(module, this.types.handleNewError(expr.loc, name));
    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args, module);

    return this.types.store.plain(TypeKind.Error);
  }

  private isCStringType(type: Type): boolean {
    const base = this.types.definedType(type);
    if (base.kind != TypeKind.Instance || base.name != kCStringName) {
      return false;
    }

    return this.types.isLibraryModule(base.module);
  }

  private cstringLiteral(expr: Expr, to: Type): Type | undefined {
    if (!this.isCStringType(to)) {
      return undefined;
    }

    const text = this.constantText(expr);
    if (text == undefined || text.includes(kNulText)) {
      return undefined;
    }

    return to;
  }

  private cstringMismatch(
    expr: Expr,
    given: Type,
    wanted: Type,
    module: int,
  ): boolean {
    const base = this.types.apparent(given);
    const isText =
      base.kind == TypeKind.String || base.kind == TypeKind.Template;
    if (!this.isCStringType(wanted) || !isText) {
      return false;
    }

    const first = this.types.typeText(given);
    const second = this.types.typeText(wanted);
    const text = this.constantText(expr);
    if (text != undefined && text.includes(kNulText)) {
      const literal = this.types.store.literal(LiteralKind.String, text);
      const shown = this.types.typeText(literal);

      this.errors.write(module, expr.loc, Code.CStringNul, {
        first: shown,
        second,
      });

      return true;
    }

    this.errors.write(module, expr.loc, Code.CStringText, { first, second });

    return true;
  }
}
