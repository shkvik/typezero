import {
  BodySource,
  FunctionDecl,
  ParamKind,
} from "../../../../../program/ast/types/ast.types.functions.tz";
import {
  Expr,
  NewExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  kCStringName,
  kNulText,
} from "../../../foreign-rules/const/foreign-rules.const.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import {
  LiteralKind,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { TypeContext } from "../../../../types/type-resolver/types/type-resolver.types.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import {
  ParameterShape,
  ValueTarget,
} from "../../../../code/expression-types/types/expression-types.types.tz";

partial class ExpressionTypes {
  private foreignCheck(
    fn: FunctionDecl,
    shape: ParameterShape,
    context: TypeContext,
    module: int,
  ): void {
    const isForeign = fn.bodySource == BodySource.Foreign;
    if (!isForeign || this.modules.isLibraryModule(module)) {
      return;
    }
    if (fn.typeParams.length > 0 || shape.rest) {
      return this.reportFound(module, this.foreign.plainError(fn.loc));
    }

    for (let index = 0; index < fn.params.length; index++) {
      const param = fn.params[index];
      const type = shape.params[index]?.type;
      if (param != undefined && type != undefined) {
        this.foreignParamCheck(param.loc, param.form.kind, type, module);
      }
    }

    const written = fn.returnType;
    if (written == undefined) {
      return this.reportFound(module, this.foreign.noReturnError(fn.loc));
    }

    const result = this.resolver.returnType(written, context);

    this.reportFound(module, this.foreign.givesError(fn.loc, result));
  }

  private foreignParamCheck(
    loc: int,
    kind: ParamKind,
    type: Type,
    module: int,
  ): void {
    if (kind == ParamKind.Optional || kind == ParamKind.Defaulted) {
      return this.reportFound(module, this.foreign.optionalError(loc));
    }

    this.reportFound(module, this.foreign.takesError(loc, type));
  }

  private handleNew(
    expr: NewExpr,
    name: string,
    target: ValueTarget,
    module: int,
  ): Type | undefined {
    if (target.kind != SymbolKind.Handle) {
      return undefined;
    }

    this.reportFound(module, this.foreign.handleNewError(expr.loc, name));
    this.looseArguments(expr.args, module);

    return this.store.plain(TypeKind.Error);
  }

  private isCStringType(type: Type): boolean {
    const base = this.types.definedType(type);
    if (base.kind != TypeKind.Instance || base.name != kCStringName) {
      return false;
    }

    return this.modules.isLibraryModule(base.module);
  }

  private cstringLiteral(expr: Expr, to: Type): Type | undefined {
    if (!this.isCStringType(to)) {
      return undefined;
    }

    const text = this.constantText(expr);
    if (text == undefined || text.includes(kNulText)) {
      return undefined;
    }

    return to;
  }

  private cstringMismatch(
    expr: Expr,
    given: Type,
    wanted: Type,
    module: int,
  ): boolean {
    const base = this.types.apparent(given);
    const isText =
      base.kind == TypeKind.String || base.kind == TypeKind.Template;
    if (!this.isCStringType(wanted) || !isText) {
      return false;
    }

    const first = this.text.of(given);
    const second = this.text.of(wanted);
    const text = this.constantText(expr);
    if (text != undefined && text.includes(kNulText)) {
      const literal = this.store.literal(LiteralKind.String, text);
      const shown = this.text.of(literal);

      this.report(module, expr.loc, Code.CStringNul, { first: shown, second });

      return true;
    }

    this.report(module, expr.loc, Code.CStringText, { first, second });

    return true;
  }
}
