import {
  BinaryOp,
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { StmtKind } from "../../../../program/ast/types/ast.types.statements.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import {
  DictKind,
  LiteralKind,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import {
  kArrayShape,
  kAsyncGeneratorShape,
  kBooleanShape,
  kCodeMethods,
  kDecimalShape,
  kDoubleShape,
  kFilterName,
  kGeneratorShape,
  kLentArrayMethods,
  kMathConstants,
  kMathName,
  kNumberLaterMethods,
  kResultShape,
  kSetClass,
  kSpecialMethods,
  kStringShape,
  kTakenMethods,
} from "../../../code/expression-types/const/expression-types.const.tz";
import {
  CallKind,
  GenericTarget,
  LibraryVariants,
} from "../../../code/expression-types/types/expression-types.types.tz";
import { kMapClass } from "../../../code/class-rules/const/class-rules.const.tz";
import { kPromiseClass } from "../../library-rules/const/library-rules.const.tz";

partial class ExpressionTypes {
  private libraryReceiver(type: Type): Type | undefined {
    switch (type.kind) {
      case TypeKind.String:
      case TypeKind.Template:
        return this.types.libraryShape(kStringShape, []);
      case TypeKind.Literal:
        return this.literalReceiver(type.literal);
      case TypeKind.Int:
        return this.integerReceiver(type);
      case TypeKind.Double:
        return this.types.libraryShape(kDoubleShape, []);
      case TypeKind.Boolean:
        return this.types.libraryShape(kBooleanShape, []);
      case TypeKind.Decimal:
        return this.types.libraryShape(kDecimalShape, []);
      case TypeKind.Array:
        return this.types.libraryShape(kArrayShape, [
          this.types.store.itemOf(type),
        ]);
      case TypeKind.Result: {
        const args = [
          this.types.store.valueOf(type),
          this.types.store.errorOf(type),
        ];

        return this.types.libraryShape(kResultShape, args);
      }
      case TypeKind.Iterator:
        return this.iteratorReceiver(type);
      case TypeKind.Dict:
        return this.dictReceiver(type);
      case TypeKind.Promise:
        return this.types.libraryInstance(kPromiseClass, [
          this.types.store.valueOf(type),
        ]);
      case TypeKind.Instance:
        return this.types.instanceReceiver(type);
      default:
        return undefined;
    }
  }

  private literalReceiver(literal: LiteralKind): Type | undefined {
    switch (literal) {
      case LiteralKind.String:
        return this.types.libraryShape(kStringShape, []);
      case LiteralKind.Int: {
        const int = this.types.store.integer(64, false);

        return this.libraryReceiver(int);
      }
      case LiteralKind.Double:
        return this.types.libraryShape(kDoubleShape, []);
      default:
        return this.types.libraryShape(kBooleanShape, []);
    }
  }

  private integerReceiver(type: Type): Type | undefined {
    if (type.kind != TypeKind.Int || type.wraps) {
      return undefined;
    }

    const name = this.types.typeText(type);

    return this.types.libraryShape(name, []);
  }

  private iteratorReceiver(type: Type): Type | undefined {
    if (type.kind != TypeKind.Iterator) {
      return undefined;
    }

    const shape = this.types.store.iteratorShapeOf(type);
    const args = [shape.yielded, shape.returned, shape.sent];

    if (shape.async) {
      return this.types.libraryShape(kAsyncGeneratorShape, args);
    }

    return this.types.libraryShape(kGeneratorShape, args);
  }

  private dictReceiver(type: Type): Type | undefined {
    if (type.kind != TypeKind.Dict) {
      return undefined;
    }

    switch (type.dict) {
      case DictKind.Map: {
        const args = [
          this.types.store.keyOf(type),
          this.types.store.valueOf(type),
        ];

        return this.types.libraryInstance(kMapClass, args);
      }
      case DictKind.Set:
        return this.types.libraryInstance(kSetClass, [
          this.types.store.keyOf(type),
        ]);
      default:
        return undefined;
    }
  }

  private libraryMemberTyped(
    expr: MemberExpr,
    object: Type,
    module: int,
  ): Type {
    const receiver = this.libraryReceiver(object);
    if (receiver == undefined) {
      return this.types.store.plain(TypeKind.Error);
    }

    const member = this.libraryMemberType(receiver, expr.name, false);
    if (member == undefined || member.kind == TypeKind.Function) {
      return this.types.store.plain(TypeKind.Error);
    }

    return member;
  }

  private libraryCall(
    expr: CallExpr,
    member: MemberExpr,
    object: Type,
    wanted: Type | undefined,
    module: int,
  ): Type | undefined {
    const receiver = this.libraryReceiver(object);
    if (receiver == undefined) {
      return undefined;
    }

    const asyncNext = this.asyncNextCall(expr, member, object, module);
    if (asyncNext != undefined) {
      return asyncNext;
    }

    const patternCall = this.stringPatternCall(expr, member, object, module);
    if (patternCall != undefined) {
      return patternCall;
    }

    const localeCall = this.localeMethodCall(expr, member, object, module);
    if (localeCall != undefined) {
      return localeCall;
    }

    this.argumentRangeCheck(expr, member, object, module);

    const isFilter =
      member.name == kFilterName && object.kind == TypeKind.Array;
    const isProved =
      (kSpecialMethods.includes(member.name) && !isFilter) ||
      this.types.isRegexSplit(expr, member);
    const generic = this.receiverMember(receiver, member.name, true);
    const isGeneric =
      generic != undefined &&
      generic.kind == TypeKind.Function &&
      this.mentionsLibraryParameter(generic);
    const isSpecial = isProved || object.kind == TypeKind.Result;
    if (isGeneric && isSpecial) {
      return this.types.store.plain(TypeKind.Error);
    }
    if (isGeneric && generic != undefined) {
      return this.libraryMethodCall(expr, member, generic, wanted, module);
    }

    const method = this.libraryMemberType(receiver, member.name, true);
    const variants = this.receiverVariants(receiver, member.name);
    if (generic == undefined && variants.types.length > 0) {
      return this.variantLibraryCall(expr, member, variants, module);
    }
    if (generic == undefined && method == undefined) {
      this.valueMissingCheck(expr, member, object, receiver, module);
    }

    const proved = this.provedResult(expr, member, object, module);
    if (proved != undefined) {
      return proved;
    }
    if (this.doubleConversionCheck(member, object, module)) {
      return this.types.store.plain(TypeKind.Error);
    }
    if (method == undefined || isProved) {
      return this.types.store.plain(TypeKind.Error);
    }

    const kind = this.types.receiverKind(object);

    const marked = this.positionShape(object, member.name) ?? method;

    this.positionMask = this.types.maskOf(object, marked);
    this.positionMethod = member.name;

    const called = this.fieldValueCall(expr, member, method, kind, module);
    if (isFilter) {
      const kept = this.filteredArray(expr, called);

      return this.lentResult(member, object, kept);
    }

    return this.lentResult(member, object, called);
  }

  private lentResult(member: MemberExpr, object: Type, result: Type): Type {
    const isLooked = kLentArrayMethods.includes(member.name);
    if (!isLooked || object.kind != TypeKind.Array) {
      return result;
    }
    if (result.kind != TypeKind.Array) {
      return result;
    }

    const item = this.types.store.itemOf(result);
    if (this.isCopy(item)) {
      return result;
    }

    return this.types.store.lentArrayOf(item);
  }

  private readonly mentionsLibraryParameter(method: Type): boolean {
    if (!this.types.mentionsParameter(method)) {
      return false;
    }

    const params = this.types.genericParameters(method);
    if (params == undefined) {
      return true;
    }

    return params.some((param) => this.isLibraryParameter(param));
  }

  private readonly isLibraryParameter(param: Type): boolean {
    if (param.kind != TypeKind.TypeParameter) {
      return true;
    }

    const isCode = this.types.isCheckedLibrary(param.module);

    return this.types.isLibraryModule(param.module) && !isCode;
  }

  private filteredArray(expr: CallExpr, kept: Type): Type {
    const tree = this.types.program.tree;

    if (
      kept.kind != TypeKind.Array ||
      !this.types.isOptional(this.types.store.itemOf(kept))
    ) {
      return kept;
    }

    const callback = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (callback == undefined || !this.keepsDefined(callback)) {
      return kept;
    }

    const defined = this.types.definedType(this.types.store.itemOf(kept));

    return this.types.store.arrayOf(defined);
  }

  private readonly keepsDefined(callback: Expr): boolean {
    const tree = this.types.program.tree;

    if (callback.kind != ExprKind.Function) {
      return false;
    }

    const fn = tree.functionOf(callback.fnId);
    const param = tree.paramsOf(fn.paramsList)[0];
    const only = tree.stmtsOf(tree.blockAt(fn.bodyId)?.bodyList)[0];
    if (param == undefined || only == undefined || !fn.concise) {
      return false;
    }
    if (only.kind != StmtKind.Return) {
      return false;
    }

    const test = tree.exprAt(only.valueId);
    if (test == undefined || test.kind != ExprKind.Binary) {
      return false;
    }
    if (test.op != BinaryOp.Ne) {
      return false;
    }

    const left = tree.exprOf(test.lhsId);
    const right = tree.exprOf(test.rhsId);
    const isLeft =
      left.kind == ExprKind.Name &&
      left.name == param.name &&
      right.kind == ExprKind.Undefined;
    const isRight =
      right.kind == ExprKind.Name &&
      right.name == param.name &&
      left.kind == ExprKind.Undefined;

    return isLeft || isRight;
  }

  private receiverVariants(receiver: Type, name: string): LibraryVariants {
    if (receiver.kind != TypeKind.Instance) {
      return { types: [], open: [] };
    }

    return this.declaredVariants(receiver, name, false);
  }

  private libraryMethodCall(
    expr: CallExpr,
    member: MemberExpr,
    type: Type,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const params = this.types.genericParameters(type);
    if (type.kind != TypeKind.Function || params == undefined) {
      return this.types.store.plain(TypeKind.Error);
    }
    if (params.length == 0) {
      const kind = this.namespaceKind(member, module);

      this.positionMethod = member.name;

      return this.fieldValueCall(expr, member, type, kind, module);
    }
    if (expr.optional || this.types.store.selfTypeOf(type) != undefined) {
      return this.types.store.plain(TypeKind.Error);
    }

    const generic: GenericTarget = {
      name: member.name,
      params,
      decls: [],
      home: module,
      shape: this.types.store.functionShapeOf(type),
      loc: member.loc,
      typeArgs: tree.typeRefsOf(member.typeArgsList),
      isLenient: true,
    };

    return this.genericResult(expr, generic, wanted, module);
  }

  private provedResult(
    expr: CallExpr,
    member: MemberExpr,
    object: Type,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const name = member.name;
    const base = this.types.apparent(object);
    if (base.kind == TypeKind.Array && kTakenMethods.includes(name)) {
      return this.takenItem(member, this.types.store.itemOf(base), module);
    }

    const isText =
      base.kind == TypeKind.String || base.kind == TypeKind.Template;
    const index = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (!isText || index == undefined || !kCodeMethods.includes(name)) {
      return undefined;
    }

    const int = this.types.store.integer(64, false);

    this.typed(index, int, module);

    const objectExpr = tree.exprOf(member.objectId);
    if (this.isProvenIndex(objectExpr, index, module)) {
      return int;
    }

    return this.types.optional(int);
  }

  private takenItem(member: MemberExpr, item: Type, module: int): Type {
    const tree = this.types.program.tree;

    const object = tree.exprOf(member.objectId);
    const isFilled = this.isProvenFilled(object, module);

    const objectExpr = tree.exprOf(member.objectId);

    this.takenFrom(objectExpr, module);

    if (isFilled) {
      return item;
    }

    return this.types.optional(item);
  }

  private valueMissingCheck(
    expr: CallExpr,
    member: MemberExpr,
    object: Type,
    receiver: Type,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const name = member.name;
    if (
      receiver.kind != TypeKind.Object ||
      !this.types.isPlainReceiver(object)
    ) {
      return;
    }
    if (kNumberLaterMethods.includes(name)) {
      return;
    }
    if (
      this.types.store.fieldsOf(receiver).some((field) => field.name == name)
    ) {
      return;
    }

    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args, module);
    this.errors.write(module, member.loc, Code.PropertyMissing, {
      word: name,
      first: this.types.typeText(object),
    });
  }

  private namespaceReadCheck(expr: MemberExpr, module: int): void {
    const tree = this.types.program.tree;

    const object = tree.exprOf(expr.objectId);
    if (object.kind != ExprKind.Name || !this.isGlobalUse(object, module)) {
      return;
    }

    const code = this.types.namespaceCode(object.name);
    if (code != Code.NamespaceMemberMissing) {
      return;
    }

    this.errors.write(module, expr.loc, code, {
      word: expr.name,
      first: object.name,
    });
  }

  private namespaceMissingCheck(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const object = tree.exprOf(member.objectId);
    if (object.kind != ExprKind.Name || !this.isGlobalUse(object, module)) {
      return;
    }

    const code = this.types.namespaceCode(object.name);
    if (code == undefined) {
      return;
    }

    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args, module);
    this.errors.write(module, member.loc, code, {
      word: member.name,
      first: object.name,
    });
  }

  private mathMemberCheck(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const object = tree.exprOf(member.objectId);
    const isMath =
      object.kind == ExprKind.Name &&
      object.name == kMathName &&
      this.isGlobalUse(object, module);
    if (!isMath) {
      return false;
    }

    const word = member.name;
    if (kMathConstants.includes(word)) {
      const args = tree.argumentsOf(expr.argsList);

      this.looseArguments(args, module);
      this.errors.write(module, member.loc, Code.MathConstantCalled, { word });

      return true;
    }

    const isRanged = word == "max" || word == "min";
    if (!isRanged || tree.argumentsOf(expr.argsList).length > 0) {
      return false;
    }

    const first = this.types.mathEndSign(word);

    this.errors.write(module, member.loc, Code.MathNoValues, { word, first });

    return true;
  }

  private positionShape(object: Type, name: string): Type | undefined {
    if (object.kind != TypeKind.Array) {
      return undefined;
    }

    const open = this.types.store.plain(TypeKind.Unknown);
    const receiver = this.types.libraryShape(kArrayShape, [open]);
    if (receiver == undefined) {
      return undefined;
    }

    return this.receiverMember(receiver, name, true);
  }

  private readonly namespaceKind(member: MemberExpr, module: int): CallKind {
    const tree = this.types.program.tree;

    const object = tree.exprOf(member.objectId);
    const isMath =
      object.kind == ExprKind.Name &&
      object.name == kMathName &&
      this.isGlobalUse(object, module);
    if (isMath) {
      return CallKind.Math;
    }

    return CallKind.Library;
  }
}
