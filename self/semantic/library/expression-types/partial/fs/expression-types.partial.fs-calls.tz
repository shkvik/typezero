import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  AssignExpr,
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  PropertyKind,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import { TypeKind } from "../../../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import {
  kBigintOption,
  kConstantsName,
  kEncodingOption,
  kFlagOption,
  kFlagOptions,
  kStatsClass,
  kStatsDates,
} from "../../../fs-rules/const/fs-rules.const.tz";
import { FsCall, FsShape } from "../../../fs-rules/types/fs-rules.types.tz";

partial class ExpressionTypes {
  private fsCallCheck(expr: CallExpr, module: int): void {
    const callee = expr.callee;
    if (callee.kind != ExprKind.Name || this.modules.isLibraryModule(module)) {
      return;
    }
    if (expr.args.some((one) => one.spread)) {
      return;
    }
    if (this.isFsPromisesName(callee, module)) {
      return this.fsPromisesCheck(expr, callee.name, callee.loc, module);
    }
    if (!this.isFsName(callee, SymbolKind.Function, module)) {
      return;
    }

    const row = this.fs.call(callee.name);
    if (row != undefined) {
      this.fsShapeCheck(expr, row, module);
    }
  }

  private readonly isFsPromisesName(expr: Expr, module: int): boolean {
    if (expr.kind != ExprKind.Name) {
      return false;
    }

    const target = this.targetOfName(expr, module);
    const isCallable =
      target != undefined &&
      (target.kind == SymbolKind.Function ||
        target.kind == SymbolKind.Variable);
    if (!isCallable || target == undefined) {
      return false;
    }

    const opened = this.program.modules[target.module];

    return opened != undefined && this.fs.isPromisesModule(opened.name);
  }

  private fsPromisesCheck(
    expr: CallExpr,
    name: string,
    loc: int,
    module: int,
  ): void {
    const row = this.fs.promiseCall(name);
    if (row != undefined) {
      this.fsShapeCheck(expr, row, module);
    }
  }

  private readonly isFsName(expr: Expr, kind: SymbolKind, module: int): boolean {
    if (expr.kind != ExprKind.Name) {
      return false;
    }

    const target = this.targetOfName(expr, module);
    if (target == undefined || target.kind != kind) {
      return false;
    }

    const opened = this.program.modules[target.module];

    return opened != undefined && this.fs.isFsModule(opened.name);
  }

  private fsShapeCheck(expr: CallExpr, row: Read<FsCall>, module: int): void {
    this.fsZeroPathCheck(expr, row, module);

    switch (row.shape) {
      case FsShape.ReadFile:
        return this.fsReadCheck(expr, row, 1, module);
      case FsShape.WriteFile:
        return this.fsWriteCheck(expr, row, module);
      case FsShape.PathEncoding:
      case FsShape.Readdir:
        return this.fsReadCheck(expr, row, 1, module);
      case FsShape.Stat:
        return this.fsStatCheck(expr, row, module);
      case FsShape.Mkdir:
        return this.fsMkdirCheck(expr, row, module);
      case FsShape.Rmdir:
        return this.fsRmdirCheck(expr, module);
      case FsShape.Rm:
        this.fsOptionsCheck(expr, 1, row, module);

        return;
      case FsShape.CopyFile:
        return this.fsCopyCheck(expr, row, module);
      default:
        return;
    }
  }

  private fsReadCheck(
    expr: CallExpr,
    row: Read<FsCall>,
    index: int,
    module: int,
  ): void {
    if (!this.fsEncodingOrOptions(expr, index, row, module)) {
      return;
    }

    const encoding = this.givenEncoding(expr, index);
    if (!this.fsEncodingCheck(encoding, row, module)) {
      return;
    }
    if (row.shape == FsShape.Readdir) {
      this.fsFlagOption(expr, index, "withFileTypes", row, module);

      return;
    }

    this.fsOpenFlagCheck(expr, index, row, module);
  }

  private fsWriteCheck(expr: CallExpr, row: Read<FsCall>, module: int): void {
    const data = expr.args[1];
    if (data == undefined) {
      return;
    }

    const given = this.peekType(data.expr, module);
    if (!this.fs.isWritable(given)) {
      const dataError = this.fs.dataError(data.expr.loc, row.name, given);

      return this.reportFound(module, dataError);
    }
    if (!this.fsEncodingOrOptions(expr, 2, row, module)) {
      return;
    }

    const encoding = this.givenEncoding(expr, 2);
    const isText = this.types.definedType(given).kind == TypeKind.String;
    if (encoding != undefined && !isText) {
      const forTextError = this.fs.forTextError(encoding.loc, row.name);

      return this.reportFound(module, forTextError);
    }
    if (this.fsEncodingCheck(encoding, row, module)) {
      this.fsOpenFlagCheck(expr, 2, row, module);
    }
  }

  private readonly fsStatCheck(expr: CallExpr, row: Read<FsCall>, module: int): void {
    if (!this.fsOptionsCheck(expr, 1, row, module)) {
      return;
    }

    const isThrowing = this.fsFlagOption(
      expr,
      1,
      "throwIfNoEntry",
      row,
      module,
    );
    if (!isThrowing) {
      return;
    }

    const bigint = this.fsOptionValue(expr, 1, kBigintOption);
    if (!this.fsFlagOption(expr, 1, kBigintOption, row, module)) {
      return;
    }
    if (
      bigint != undefined &&
      bigint.kind == ExprKind.BoolLit &&
      bigint.value
    ) {
      this.reportFound(module, this.fs.bigintError(bigint.loc));
    }
  }

  private readonly fsMkdirCheck(expr: CallExpr, row: Read<FsCall>, module: int): void {
    const options = expr.args[1]?.expr;
    const isMode =
      options != undefined &&
      options.kind != ExprKind.ObjectLit &&
      options.kind != ExprKind.Undefined;
    if (!isMode) {
      this.fsOptionsCheck(expr, 1, row, module);
    }
  }

  private readonly fsRmdirCheck(expr: CallExpr, module: int): void {
    const options = expr.args[1]?.expr;
    if (options == undefined || options.kind == ExprKind.Undefined) {
      return;
    }

    this.reportFound(module, this.fs.rmdirError(options.loc));
  }

  private readonly fsCopyCheck(expr: CallExpr, row: Read<FsCall>, module: int): void {
    const mode = expr.args[2];
    if (mode == undefined || expr.args.length != 3) {
      return;
    }

    this.reportFound(module, this.fs.copyModeError(mode.expr.loc, row.name));
  }

  private fsEncodingOrOptions(
    expr: CallExpr,
    index: int,
    row: Read<FsCall>,
    module: int,
  ): boolean {
    const arg = expr.args[index]?.expr;
    if (arg == undefined || arg.kind == ExprKind.StringLit) {
      return true;
    }
    if (arg.kind == ExprKind.ObjectLit || arg.kind == ExprKind.Undefined) {
      return this.fsOptionsCheck(expr, index, row, module);
    }

    const given = this.peekType(arg, module);
    const base = this.types.definedType(given);
    if (base.kind == TypeKind.Error) {
      return false;
    }
    if (this.intl.isTextLike(base)) {
      this.reportFound(module, this.fs.dependsError(arg.loc, row.name));

      return false;
    }

    const first = row.options[0] ?? "";
    const literalError = this.fs.optionsLiteralError(arg.loc, row.name, first);

    this.reportFound(module, literalError);

    return false;
  }

  private readonly fsOptionsCheck(
    expr: CallExpr,
    index: int,
    row: Read<FsCall>,
    module: int,
  ): boolean {
    const arg = expr.args[index]?.expr;
    if (arg == undefined || arg.kind == ExprKind.Undefined) {
      return true;
    }

    const first = row.options[0] ?? "";
    if (arg.kind != ExprKind.ObjectLit) {
      const literalError = this.fs.optionsLiteralError(
        arg.loc,
        row.name,
        first,
      );

      this.reportFound(module, literalError);

      return false;
    }

    for (const property of arg.props) {
      const kind = property.form.kind;
      const isByName =
        kind != PropertyKind.Spread &&
        kind != PropertyKind.Computed &&
        kind != PropertyKind.Method &&
        property.name != "";
      if (!isByName) {
        const byNameError = this.fs.byNameError(property.loc, row.name, first);

        this.reportFound(module, byNameError);

        return false;
      }
      if (!row.options.includes(property.name)) {
        const unknownError = this.fs.unknownOptionError(
          property.loc,
          row.name,
          property.name,
          row.options,
        );

        this.reportFound(module, unknownError);

        return false;
      }
    }

    return true;
  }

  private readonly fsOptionValue(
    expr: CallExpr,
    index: int,
    name: string,
  ): Expr | undefined {
    const arg = expr.args[index]?.expr;
    if (arg == undefined) {
      return undefined;
    }

    return this.optionValue(arg, name);
  }

  private readonly givenEncoding(expr: CallExpr, index: int): Expr | undefined {
    const arg = expr.args[index]?.expr;
    if (arg != undefined && arg.kind == ExprKind.StringLit) {
      return arg;
    }

    const encoding = this.fsOptionValue(expr, index, kEncodingOption);
    if (encoding == undefined || encoding.kind == ExprKind.Undefined) {
      return undefined;
    }

    return encoding;
  }

  private readonly fsEncodingCheck(
    encoding: Expr | undefined,
    row: Read<FsCall>,
    module: int,
  ): boolean {
    if (encoding == undefined) {
      return true;
    }
    if (encoding.kind != ExprKind.StringLit) {
      const literalError = this.fs.encodingLiteralError(encoding.loc, row.name);

      this.reportFound(module, literalError);

      return false;
    }

    const text = encoding.value;
    const unknownError = this.byteSources.encodingError(encoding.loc, [text]);
    if (unknownError != undefined) {
      this.reportFound(module, unknownError);

      return false;
    }
    if (row.isUtf8Only && !this.fs.isUtf8(text)) {
      const utf8Error = this.fs.utf8OnlyError(encoding.loc, row.name, text);

      this.reportFound(module, utf8Error);

      return false;
    }

    return true;
  }

  private readonly fsOpenFlagCheck(
    expr: CallExpr,
    index: int,
    row: Read<FsCall>,
    module: int,
  ): void {
    const flag = this.fsOptionValue(expr, index, kFlagOption);
    if (flag == undefined) {
      return;
    }
    if (flag.kind == ExprKind.StringLit && this.fs.isFlag(flag.value)) {
      return;
    }

    const written = this.writtenFlag(flag);

    this.reportFound(module, this.fs.flagError(flag.loc, row.name, written));
  }

  private readonly writtenFlag(flag: Expr): string | undefined {
    if (flag.kind != ExprKind.StringLit) {
      return undefined;
    }

    return flag.value;
  }

  private readonly fsFlagOption(
    expr: CallExpr,
    index: int,
    option: string,
    row: Read<FsCall>,
    module: int,
  ): boolean {
    const value = this.fsOptionValue(expr, index, option);
    if (value == undefined || value.kind == ExprKind.BoolLit) {
      return true;
    }
    if (!kFlagOptions.includes(option)) {
      return true;
    }

    const flagError = this.fs.flagOptionError(value.loc, row.name, option);

    this.reportFound(module, flagError);

    return false;
  }

  private readonly fsConstantCheck(expr: MemberExpr, module: int): boolean {
    const object = expr.object;
    if (object.kind != ExprKind.Name || object.name != kConstantsName) {
      return false;
    }
    if (!this.isFsName(object, SymbolKind.Variable, module)) {
      return false;
    }
    if (this.fs.isConstant(expr.name)) {
      return false;
    }

    this.reportFound(module, this.fs.constantError(expr.loc, expr.name));

    return true;
  }

  private readonly fsZeroPathCheck(expr: CallExpr, row: Read<FsCall>, module: int): void {
    const count = this.fsPathCount(row.shape);

    for (let index = 0; index < count; index++) {
      const path = expr.args[index]?.expr;
      if (path == undefined || path.kind != ExprKind.StringLit) {
        continue;
      }
      if (path.value.includes("\u0000")) {
        this.report(module, path.loc, Code.FsZeroPath, kNoDetails);
      }
    }
  }

  private readonly fsPathCount(shape: FsShape): int {
    if (shape == FsShape.TwoPaths) {
      return 2;
    }

    return 1;
  }

  private statsDateCheck(expr: AssignExpr, module: int): boolean {
    const target = expr.target;
    if (target.kind != ExprKind.Member || !kStatsDates.includes(target.name)) {
      return false;
    }

    const object = this.peekType(target.object, module);
    const base = this.types.definedType(object);
    if (base.kind != TypeKind.Instance || base.name != kStatsClass) {
      return false;
    }

    const opened = this.program.modules[base.module];
    if (opened == undefined || !this.fs.isFsModule(opened.name)) {
      return false;
    }

    this.report(module, target.loc, Code.StatsDateAssign, {
      word: target.name,
    });
    this.typed(expr.value, undefined, module);

    return true;
  }
}
