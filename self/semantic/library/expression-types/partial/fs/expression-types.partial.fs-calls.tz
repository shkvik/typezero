import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  AssignExpr,
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  PropertyKind,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import { TypeKind } from "../../../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import {
  kBigintOption,
  kConstantsName,
  kEncodingOption,
  kFlagOption,
  kFlagOptions,
  kStatsClass,
  kStatsDates,
} from "../../../fs-rules/const/fs-rules.const.tz";
import { FsCall, FsShape } from "../../../fs-rules/types/fs-rules.types.tz";

partial class ExpressionTypes {
  private fsCallCheck(expr: CallExpr, module: int): void {
    const tree = this.types.program.tree;

    const callee = tree.exprOf(expr.calleeId);
    if (callee.kind != ExprKind.Name || this.types.isLibraryModule(module)) {
      return;
    }
    if (tree.argumentsOf(expr.argsList).some((one) => one.spread)) {
      return;
    }
    if (this.isFsPromisesName(callee, module)) {
      return this.fsPromisesCheck(expr, callee.name, callee.loc, module);
    }
    if (!this.isFsName(callee, SymbolKind.Function, module)) {
      return;
    }

    const row = this.tables.fsCall(callee.name);
    if (row != undefined) {
      this.fsShapeCheck(expr, row, module);
    }
  }

  private readonly isFsPromisesName(expr: Expr, module: int): boolean {
    if (expr.kind != ExprKind.Name) {
      return false;
    }

    const target = this.targetOfName(expr, module);
    const isCallable =
      target != undefined &&
      (target.kind == SymbolKind.Function ||
        target.kind == SymbolKind.Variable);
    if (!isCallable || target == undefined) {
      return false;
    }

    const opened = this.types.program.modules[target.module];

    return opened != undefined && this.types.isPromisesModule(opened.name);
  }

  private fsPromisesCheck(
    expr: CallExpr,
    name: string,
    loc: int,
    module: int,
  ): void {
    const row = this.types.promiseCall(name);
    if (row != undefined) {
      this.fsShapeCheck(expr, row, module);
    }
  }

  private readonly isFsName(
    expr: Expr,
    kind: SymbolKind,
    module: int,
  ): boolean {
    if (expr.kind != ExprKind.Name) {
      return false;
    }

    const target = this.targetOfName(expr, module);
    if (target == undefined || target.kind != kind) {
      return false;
    }

    const opened = this.types.program.modules[target.module];

    return opened != undefined && this.types.isFsModule(opened.name);
  }

  private fsShapeCheck(expr: CallExpr, row: Read<FsCall>, module: int): void {
    this.fsZeroPathCheck(expr, row, module);

    switch (row.shape) {
      case FsShape.ReadFile:
        return this.fsReadCheck(expr, row, 1, module);
      case FsShape.WriteFile:
        return this.fsWriteCheck(expr, row, module);
      case FsShape.PathEncoding:
      case FsShape.Readdir:
        return this.fsReadCheck(expr, row, 1, module);
      case FsShape.Stat:
        return this.fsStatCheck(expr, row, module);
      case FsShape.Mkdir:
        return this.fsMkdirCheck(expr, row, module);
      case FsShape.Rmdir:
        return this.fsRmdirCheck(expr, module);
      case FsShape.Rm:
        this.fsOptionsCheck(expr, 1, row, module);

        return;
      case FsShape.CopyFile:
        return this.fsCopyCheck(expr, row, module);
      default:
        return;
    }
  }

  private fsReadCheck(
    expr: CallExpr,
    row: Read<FsCall>,
    index: int,
    module: int,
  ): void {
    if (!this.fsEncodingOrOptions(expr, index, row, module)) {
      return;
    }

    const encoding = this.givenEncoding(expr, index);
    if (!this.fsEncodingCheck(encoding, row, module)) {
      return;
    }
    if (row.shape == FsShape.Readdir) {
      this.fsFlagOption(expr, index, "withFileTypes", row, module);

      return;
    }

    this.fsOpenFlagCheck(expr, index, row, module);
  }

  private fsWriteCheck(expr: CallExpr, row: Read<FsCall>, module: int): void {
    const tree = this.types.program.tree;

    const data = tree.argumentsOf(expr.argsList)[1];
    if (data == undefined) {
      return;
    }

    const exprExpr = tree.exprOf(data.exprId);
    const given = this.peekType(exprExpr, module);
    if (!this.types.isWritable(given)) {
      const dataError = this.types.fsDataError(
        tree.exprOf(data.exprId).loc,
        row.name,
        given,
      );

      return this.errors.writeFound(module, dataError);
    }
    if (!this.fsEncodingOrOptions(expr, 2, row, module)) {
      return;
    }

    const encoding = this.givenEncoding(expr, 2);
    const isText = this.types.definedType(given).kind == TypeKind.String;
    if (encoding != undefined && !isText) {
      const forTextError = this.types.forTextError(encoding.loc, row.name);

      return this.errors.writeFound(module, forTextError);
    }
    if (this.fsEncodingCheck(encoding, row, module)) {
      this.fsOpenFlagCheck(expr, 2, row, module);
    }
  }

  private fsStatCheck(expr: CallExpr, row: Read<FsCall>, module: int): void {
    if (!this.fsOptionsCheck(expr, 1, row, module)) {
      return;
    }

    const isThrowing = this.fsFlagOption(
      expr,
      1,
      "throwIfNoEntry",
      row,
      module,
    );
    if (!isThrowing) {
      return;
    }

    const bigint = this.fsOptionValue(expr, 1, kBigintOption);
    if (!this.fsFlagOption(expr, 1, kBigintOption, row, module)) {
      return;
    }
    if (
      bigint != undefined &&
      bigint.kind == ExprKind.BoolLit &&
      bigint.value
    ) {
      this.errors.writeFound(module, this.types.bigintError(bigint.loc));
    }
  }

  private fsMkdirCheck(expr: CallExpr, row: Read<FsCall>, module: int): void {
    const tree = this.types.program.tree;

    const options = tree.exprAt(tree.argumentsOf(expr.argsList)[1]?.exprId);
    const isMode =
      options != undefined &&
      options.kind != ExprKind.ObjectLit &&
      options.kind != ExprKind.Undefined;
    if (!isMode) {
      this.fsOptionsCheck(expr, 1, row, module);
    }
  }

  private fsRmdirCheck(expr: CallExpr, module: int): void {
    const tree = this.types.program.tree;

    const options = tree.exprAt(tree.argumentsOf(expr.argsList)[1]?.exprId);
    if (options == undefined || options.kind == ExprKind.Undefined) {
      return;
    }

    this.errors.writeFound(module, this.types.rmdirError(options.loc));
  }

  private fsCopyCheck(expr: CallExpr, row: Read<FsCall>, module: int): void {
    const tree = this.types.program.tree;

    const mode = tree.argumentsOf(expr.argsList)[2];
    if (mode == undefined || tree.argumentsOf(expr.argsList).length != 3) {
      return;
    }

    this.errors.writeFound(
      module,
      this.types.copyModeError(tree.exprOf(mode.exprId).loc, row.name),
    );
  }

  private fsEncodingOrOptions(
    expr: CallExpr,
    index: int,
    row: Read<FsCall>,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const arg = tree.exprAt(tree.argumentsOf(expr.argsList)[index]?.exprId);
    if (arg == undefined || arg.kind == ExprKind.StringLit) {
      return true;
    }
    if (arg.kind == ExprKind.ObjectLit || arg.kind == ExprKind.Undefined) {
      return this.fsOptionsCheck(expr, index, row, module);
    }

    const given = this.peekType(arg, module);
    const base = this.types.definedType(given);
    if (base.kind == TypeKind.Error) {
      return false;
    }
    if (this.types.isTextLike(base)) {
      this.errors.writeFound(
        module,
        this.types.dependsError(arg.loc, row.name),
      );

      return false;
    }

    const first = row.options[0] ?? "";
    const literalError = this.types.fsOptionsLiteralError(
      arg.loc,
      row.name,
      first,
    );

    this.errors.writeFound(module, literalError);

    return false;
  }

  private fsOptionsCheck(
    expr: CallExpr,
    index: int,
    row: Read<FsCall>,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const arg = tree.exprAt(tree.argumentsOf(expr.argsList)[index]?.exprId);
    if (arg == undefined || arg.kind == ExprKind.Undefined) {
      return true;
    }

    const first = row.options[0] ?? "";
    if (arg.kind != ExprKind.ObjectLit) {
      const literalError = this.types.fsOptionsLiteralError(
        arg.loc,
        row.name,
        first,
      );

      this.errors.writeFound(module, literalError);

      return false;
    }

    for (const property of tree.propertiesOf(arg.propsList)) {
      const kind = property.form.kind;
      const isByName =
        kind != PropertyKind.Spread &&
        kind != PropertyKind.Computed &&
        kind != PropertyKind.Method &&
        property.name != "";
      if (!isByName) {
        const byNameError = this.types.byNameError(
          property.loc,
          row.name,
          first,
        );

        this.errors.writeFound(module, byNameError);

        return false;
      }
      if (!row.options.includes(property.name)) {
        const unknownError = this.types.unknownOptionError(
          property.loc,
          row.name,
          property.name,
          row.options,
        );

        this.errors.writeFound(module, unknownError);

        return false;
      }
    }

    return true;
  }

  private readonly fsOptionValue(
    expr: CallExpr,
    index: int,
    name: string,
  ): Expr | undefined {
    const tree = this.types.program.tree;

    const arg = tree.exprAt(tree.argumentsOf(expr.argsList)[index]?.exprId);
    if (arg == undefined) {
      return undefined;
    }

    return this.optionValue(arg, name);
  }

  private readonly givenEncoding(expr: CallExpr, index: int): Expr | undefined {
    const tree = this.types.program.tree;

    const arg = tree.exprAt(tree.argumentsOf(expr.argsList)[index]?.exprId);
    if (arg != undefined && arg.kind == ExprKind.StringLit) {
      return arg;
    }

    const encoding = this.fsOptionValue(expr, index, kEncodingOption);
    if (encoding == undefined || encoding.kind == ExprKind.Undefined) {
      return undefined;
    }

    return encoding;
  }

  private fsEncodingCheck(
    encoding: Expr | undefined,
    row: Read<FsCall>,
    module: int,
  ): boolean {
    if (encoding == undefined) {
      return true;
    }
    if (encoding.kind != ExprKind.StringLit) {
      const literalError = this.types.fsEncodingLiteralError(
        encoding.loc,
        row.name,
      );

      this.errors.writeFound(module, literalError);

      return false;
    }

    const text = encoding.value;
    const unknownError = this.types.encodingError(encoding.loc, [text]);
    if (unknownError != undefined) {
      this.errors.writeFound(module, unknownError);

      return false;
    }
    if (row.isUtf8Only && !this.types.isUtf8(text)) {
      const utf8Error = this.types.utf8OnlyError(encoding.loc, row.name, text);

      this.errors.writeFound(module, utf8Error);

      return false;
    }

    return true;
  }

  private fsOpenFlagCheck(
    expr: CallExpr,
    index: int,
    row: Read<FsCall>,
    module: int,
  ): void {
    const flag = this.fsOptionValue(expr, index, kFlagOption);
    if (flag == undefined) {
      return;
    }
    if (flag.kind == ExprKind.StringLit && this.types.isFlag(flag.value)) {
      return;
    }

    const written = this.writtenFlag(flag);

    this.errors.writeFound(
      module,
      this.types.flagError(flag.loc, row.name, written),
    );
  }

  private readonly writtenFlag(flag: Expr): string | undefined {
    if (flag.kind != ExprKind.StringLit) {
      return undefined;
    }

    return flag.value;
  }

  private fsFlagOption(
    expr: CallExpr,
    index: int,
    option: string,
    row: Read<FsCall>,
    module: int,
  ): boolean {
    const value = this.fsOptionValue(expr, index, option);
    if (value == undefined || value.kind == ExprKind.BoolLit) {
      return true;
    }
    if (!kFlagOptions.includes(option)) {
      return true;
    }

    const flagError = this.types.flagOptionError(value.loc, row.name, option);

    this.errors.writeFound(module, flagError);

    return false;
  }

  private fsConstantCheck(expr: MemberExpr, module: int): boolean {
    const tree = this.types.program.tree;

    const object = tree.exprOf(expr.objectId);
    if (object.kind != ExprKind.Name || object.name != kConstantsName) {
      return false;
    }
    if (!this.isFsName(object, SymbolKind.Variable, module)) {
      return false;
    }
    if (this.types.isConstant(expr.name)) {
      return false;
    }

    this.errors.writeFound(
      module,
      this.types.constantError(expr.loc, expr.name),
    );

    return true;
  }

  private fsZeroPathCheck(
    expr: CallExpr,
    row: Read<FsCall>,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const count = this.fsPathCount(row.shape);

    for (let index = 0; index < count; index++) {
      const path = tree.exprAt(tree.argumentsOf(expr.argsList)[index]?.exprId);
      if (path == undefined || path.kind != ExprKind.StringLit) {
        continue;
      }
      if (path.value.includes("\u0000")) {
        this.errors.write(module, path.loc, Code.FsZeroPath, kNoDetails);
      }
    }
  }

  private readonly fsPathCount(shape: FsShape): int {
    if (shape == FsShape.TwoPaths) {
      return 2;
    }

    return 1;
  }

  private statsDateCheck(expr: AssignExpr, module: int): boolean {
    const tree = this.types.program.tree;

    const target = tree.exprOf(expr.targetId);
    if (target.kind != ExprKind.Member || !kStatsDates.includes(target.name)) {
      return false;
    }

    const objectExpr = tree.exprOf(target.objectId);
    const object = this.peekType(objectExpr, module);
    const base = this.types.definedType(object);
    if (base.kind != TypeKind.Instance || base.name != kStatsClass) {
      return false;
    }

    const opened = this.types.program.modules[base.module];
    if (opened == undefined || !this.types.isFsModule(opened.name)) {
      return false;
    }

    this.errors.write(module, target.loc, Code.StatsDateAssign, {
      word: target.name,
    });
    const value = tree.exprOf(expr.valueId);

    this.typed(value, undefined, module);

    return true;
  }
}
