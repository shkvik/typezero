import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import {
  kCreateInterfaceName,
  kInterfaceName,
  kReadlineEvents,
  kReadlineMethods,
  kReadlineModules,
  kReadlineOptions,
  kReadlineUnsupported,
} from "../../../fs-rules/const/fs-rules.const.tz";
import { FsCall, FsShape } from "../../../fs-rules/types/fs-rules.types.tz";

partial class ExpressionTypes {
  private readlineCheck(expr: CallExpr, module: int): void {
    const tree = this.types.program.tree;

    const callee = tree.exprOf(expr.calleeId);
    if (callee.kind != ExprKind.Name || this.types.isLibraryModule(module)) {
      return;
    }

    const count = tree.argumentsOf(expr.argsList).length;
    const hasSpread = tree.argumentsOf(expr.argsList).some((one) => one.spread);
    const first = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (hasSpread || count > 2 || first == undefined) {
      return;
    }
    if (!this.isReadlineCreate(callee, module)) {
      return;
    }
    if (first.kind == ExprKind.ObjectLit) {
      return this.readlineOptionsCheck(expr, first, module);
    }

    this.readlineStreamsCheck(
      first,
      tree.exprAt(tree.argumentsOf(expr.argsList)[1]?.exprId),
      module,
    );
  }

  private readonly isReadlineCreate(callee: Expr, module: int): boolean {
    if (callee.kind != ExprKind.Name) {
      return false;
    }

    const target = this.targetOfName(callee, module);
    const isCallable =
      target != undefined &&
      (target.kind == SymbolKind.Function ||
        target.kind == SymbolKind.Variable);
    if (!isCallable || target == undefined) {
      return false;
    }

    const opened = this.types.program.modules[target.module];
    const name = this.importedName(callee, module);

    return (
      opened != undefined &&
      kReadlineModules.includes(opened.name) &&
      name == kCreateInterfaceName
    );
  }

  private readlineOptionsCheck(
    expr: CallExpr,
    options: Expr,
    module: int,
  ): void {
    const known = kReadlineOptions.slice();
    const row: FsCall = {
      name: kCreateInterfaceName,
      shape: FsShape.PathOnly,
      options: known,
      isUtf8Only: false,
    };
    if (!this.fsOptionsCheck(expr, 0, row, module)) {
      return;
    }

    for (const name of kReadlineUnsupported) {
      const value = this.optionValue(options, name);
      if (value != undefined) {
        return this.errors.write(module, value.loc, Code.ReadlineOption, {
          word: name,
        });
      }
    }

    const input = this.optionValue(options, "input");
    if (input == undefined) {
      return this.errors.write(
        module,
        options.loc,
        Code.ReadlineNoInput,
        kNoDetails,
      );
    }

    const output = this.optionValue(options, "output");

    this.readlineStreamsCheck(input, output, module);
  }

  private readlineStreamsCheck(
    input: Expr,
    output: Expr | undefined,
    module: int,
  ): void {
    if (!this.isProcessStream(input, "stdin", module)) {
      return this.errors.write(
        module,
        input.loc,
        Code.ReadlineNotStdin,
        kNoDetails,
      );
    }
    if (output == undefined || output.kind == ExprKind.Undefined) {
      return;
    }

    const isWritten =
      this.isProcessStream(output, "stdout", module) ||
      this.isProcessStream(output, "stderr", module);
    if (!isWritten) {
      this.errors.write(module, output.loc, Code.ReadlineOutput, kNoDetails);
    }
  }

  private readonly isProcessStream(
    value: Expr,
    name: string,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    return (
      value.kind == ExprKind.Member &&
      value.name == name &&
      this.isProcessName(tree.exprOf(value.objectId), module)
    );
  }

  private isReadlineInterface(object: Type, module: int): boolean {
    const base = this.types.definedType(object);
    if (base.kind != TypeKind.Instance || base.name != kInterfaceName) {
      return false;
    }
    if (this.types.isLibraryModule(module)) {
      return false;
    }

    const opened = this.types.program.modules[base.module];

    return opened != undefined && kReadlineModules.includes(opened.name);
  }

  private readlineMemberRead(
    expr: MemberExpr,
    object: Type,
    module: int,
  ): boolean {
    if (!this.isReadlineInterface(object, module)) {
      return false;
    }

    this.errors.write(module, expr.loc, Code.ReadlineNoMember, {
      word: expr.name,
      first: this.types.typeText(object),
    });

    return true;
  }

  private readlineMethodCall(
    expr: CallExpr,
    member: MemberExpr,
    object: Type,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const word = member.name;
    if (!this.isReadlineInterface(object, module)) {
      return undefined;
    }
    if (kReadlineMethods.includes(word)) {
      return undefined;
    }

    if (kReadlineEvents.includes(word)) {
      this.errors.write(module, member.loc, Code.ReadlineEvents, { word });
    } else {
      const first = this.types.typeText(object);

      this.errors.write(module, member.loc, Code.ReadlineNoMember, {
        word,
        first,
      });
    }

    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args, module);

    return this.types.store.plain(TypeKind.Error);
  }
}
