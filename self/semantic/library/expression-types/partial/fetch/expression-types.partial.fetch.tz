import { ClassDecl } from "../../../../../program/ast/types/ast.types.classes.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  NewExpr,
  ObjectLitExpr,
  Property,
  PropertyKind,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import {
  kBodyField,
  kEmptyStatuses,
  kGetMethod,
  kHeaderNameMethods,
  kHeaderValueMethods,
  kHeadersField,
  kHeadersName,
  kHrefName,
  kMethodField,
  kRequestName,
  kResponseName,
  kStatusField,
  kStatusTextField,
  kUrlField,
  kUrlName,
  kUrlSetters,
  kReadableStreamName,
  kFormDataName,
  kStreamBodyHint,
  kRequestInitName,
  kRequestOptionsName,
  kRequestInitHint,
} from "../../../fetch-rules/const/fetch-rules.const.tz";

partial class ExpressionTypes {
  private fetchNewCheck(
    expr: NewExpr,
    decl: ClassDecl,
    home: int,
    made: Type,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const isChecked =
      this.types.isTypedLibrary(home) &&
      !this.types.isLibraryModule(module) &&
      made.kind != TypeKind.Error;
    if (!isChecked) {
      return;
    }

    const isFailed = tree
      .argumentsOf(expr.argsList)
      .some((arg) => this.isFailedArgument(tree.exprOf(arg.exprId), module));

    switch (decl.name) {
      case kUrlName:
        if (isFailed) {
          return;
        }

        return this.urlNewCheck(expr, module);
      case kRequestName:
        if (isFailed) {
          return;
        }

        return this.requestNewCheck(expr, module);
      case kResponseName:
        return this.responseNewCheck(expr, module);
      case kHeadersName:
        return this.headersNewCheck(expr, module);
      default:
        return;
    }
  }

  private isFailedArgument(expr: Expr, module: int): boolean {
    return this.peekType(expr, module).kind == TypeKind.Error;
  }

  private urlNewCheck(expr: NewExpr, module: int): void {
    const tree = this.types.program.tree;

    const input = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    const base = tree.exprAt(tree.argumentsOf(expr.argsList)[1]?.exprId);
    if (input == undefined) {
      return;
    }

    const isBased = base != undefined;
    if (base != undefined && !this.isKnownAbsolute(base, module)) {
      return this.errors.writeFound(
        module,
        this.fetches.urlBaseError(base.loc),
      );
    }

    const text = this.fetchText(input);
    if (text != undefined) {
      const error = this.fetches.urlTextError(input.loc, text, isBased);

      return this.errors.writeFound(module, error);
    }
    if (!this.isKnownAbsolute(input, module)) {
      const error = this.fetches.urlUnknownError(input.loc, isBased);

      this.errors.writeFound(module, error);
    }
  }

  private requestNewCheck(expr: NewExpr, module: int): void {
    const tree = this.types.program.tree;

    const input = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (input == undefined) {
      return;
    }

    const given = this.peekType(input, module);
    const isRequestInput =
      this.isFetchClass(given, kRequestName) ||
      this.isFetchClass(given, kUrlName);
    if (!isRequestInput) {
      this.requestInputCheck(input, module);
    }

    const init = tree.exprAt(tree.argumentsOf(expr.argsList)[1]?.exprId);
    if (init == undefined || init.kind != ExprKind.ObjectLit) {
      return;
    }

    const isPlainInput = !this.isFetchClass(given, kRequestName);

    this.requestInitCheck(init, isPlainInput, module);
  }

  private requestInputCheck(input: Expr, module: int): void {
    const text = this.fetchText(input);
    if (text != undefined) {
      return this.errors.writeFound(
        module,
        this.fetches.requestUrlError(input.loc, text),
      );
    }
    if (!this.isKnownAbsolute(input, module)) {
      this.errors.writeFound(
        module,
        this.fetches.requestUnknownError(input.loc),
      );
    }
  }

  private requestInitCheck(
    init: ObjectLitExpr,
    isPlainInput: boolean,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const methodProperty = this.literalProperty(init, kMethodField);
    const body = this.literalProperty(init, kBodyField);
    const headers = this.literalProperty(init, kHeadersField);
    const method = this.requestMethod(methodProperty, module);
    const isKnown = this.isMethodKnown(methodProperty, method, isPlainInput);
    const isGet = this.fetches.isBodiless(this.methodOrGet(method));

    if (
      body != undefined &&
      isKnown &&
      isGet &&
      this.hasBody(tree.exprOf(body.valueId), module)
    ) {
      const isGiven = methodProperty != undefined;
      const shown = this.methodOrGet(method);
      const error = this.fetches.getBodyError(
        tree.exprOf(body.valueId).loc,
        shown,
        isGiven,
      );

      this.errors.writeFound(module, error);
    }
    if (headers != undefined) {
      const value = tree.exprOf(headers.valueId);

      this.headersInitCheck(value, module);
    }
  }

  private readonly isMethodKnown(
    property: Property | undefined,
    method: string,
    isPlainInput: boolean,
  ): boolean {
    if (property == undefined) {
      return isPlainInput;
    }

    return method != "";
  }

  private readonly methodOrGet(method: string): string {
    if (method == "") {
      return kGetMethod;
    }

    return method;
  }

  private requestMethod(property: Property | undefined, module: int): string {
    const tree = this.types.program.tree;

    if (property == undefined) {
      return "";
    }

    const value = tree.exprOf(property.valueId);
    const text = this.fetchText(value);
    if (text == undefined) {
      return "";
    }

    const error = this.fetches.methodError(
      tree.exprOf(property.valueId).loc,
      text,
    );

    this.errors.writeFound(module, error);

    return text.toUpperCase();
  }

  private responseNewCheck(expr: NewExpr, module: int): void {
    const tree = this.types.program.tree;

    const body = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    const init = tree.exprAt(tree.argumentsOf(expr.argsList)[1]?.exprId);
    if (body == undefined || init == undefined) {
      return;
    }
    if (init.kind != ExprKind.ObjectLit) {
      return;
    }

    for (const property of tree.propertiesOf(init.propsList)) {
      if (property.form.kind == PropertyKind.Value) {
        this.responseFieldCheck(body, property, module);
      }
    }
  }

  private responseFieldCheck(
    body: Expr,
    property: Property,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const value = tree.exprOf(property.valueId);

    switch (property.name) {
      case kStatusField:
        return this.responseStatusCheck(body, value, module);
      case kStatusTextField:
        return this.statusTextCheck(value, module);
      case kHeadersField:
        return this.headersInitCheck(value, module);
      default:
        return;
    }
  }

  private responseStatusCheck(body: Expr, value: Expr, module: int): void {
    const int = this.types.store.integer(64, false);
    const status = this.intConstant(value, int, module);
    if (status == undefined) {
      return;
    }

    const isEmpty = kEmptyStatuses.some((one) => one.toDecimal() == status);
    if (isEmpty && this.hasBody(body, module)) {
      this.errors.writeFound(
        module,
        this.fetches.noBodyError(body.loc, status),
      );
    }
  }

  private statusTextCheck(value: Expr, module: int): void {
    const text = this.fetchText(value);
    if (text != undefined) {
      this.errors.writeFound(
        module,
        this.fetches.statusTextError(value.loc, text),
      );
    }
  }

  private headersNewCheck(expr: NewExpr, module: int): void {
    const tree = this.types.program.tree;

    const init = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (init != undefined) {
      this.headersInitCheck(init, module);
    }
  }

  private headersInitCheck(init: Expr, module: int): void {
    const tree = this.types.program.tree;

    if (init.kind == ExprKind.ObjectLit) {
      for (const property of tree.propertiesOf(init.propsList)) {
        this.headerPropertyCheck(property, module);
      }

      return;
    }
    if (init.kind != ExprKind.ArrayLit) {
      return;
    }

    for (const element of tree.elementsOf(init.elementsList)) {
      if (!element.spread && !element.hole) {
        const expr = tree.exprOf(element.exprId);

        this.headerPairCheck(expr, module);
      }
    }
  }

  private headerPropertyCheck(property: Property, module: int): void {
    const tree = this.types.program.tree;

    if (property.form.kind != PropertyKind.Value) {
      return;
    }

    const nameError = this.fetches.headerNameError(property.loc, property.name);

    this.errors.writeFound(module, nameError);
    const value = tree.exprOf(property.valueId);

    this.headerValueCheck(value, module);
  }

  private headerPairCheck(pair: Expr, module: int): void {
    const tree = this.types.program.tree;

    if (
      pair.kind != ExprKind.ArrayLit ||
      tree.elementsOf(pair.elementsList).length != 2
    ) {
      return;
    }

    const name = tree.elementsOf(pair.elementsList)[0];
    const value = tree.elementsOf(pair.elementsList)[1];
    if (name == undefined || value == undefined) {
      return;
    }
    if (name.spread || value.spread) {
      return;
    }

    const expr = tree.exprOf(name.exprId);

    this.headerNameCheck(expr, module);
    const exprExpr = tree.exprOf(value.exprId);

    this.headerValueCheck(exprExpr, module);
  }

  private headerNameCheck(expr: Expr, module: int): void {
    const text = this.fetchText(expr);
    if (text != undefined) {
      this.errors.writeFound(
        module,
        this.fetches.headerNameError(expr.loc, text),
      );
    }
  }

  private headerValueCheck(expr: Expr, module: int): void {
    const text = this.fetchText(expr);
    if (text != undefined) {
      this.errors.writeFound(
        module,
        this.fetches.headerValueError(expr.loc, text),
      );
    }
  }

  private fetchCallChecked(
    expr: CallExpr,
    member: MemberExpr,
    instance: Type,
    called: Type,
    module: int,
  ): Type {
    if (this.types.isLibraryModule(module)) {
      return called;
    }
    if (this.isFetchClass(instance, kHeadersName)) {
      this.headersCallCheck(expr, member, module);

      return called;
    }
    if (!this.isFetchClass(instance, kUrlName)) {
      return called;
    }
    if (!this.isProvenSetter(expr, member, module)) {
      return called;
    }
    if (called.kind != TypeKind.Result) {
      return called;
    }

    return this.types.store.plain(TypeKind.Undefined);
  }

  private headersCallCheck(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const name = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    const value = tree.exprAt(tree.argumentsOf(expr.argsList)[1]?.exprId);
    if (name != undefined && kHeaderNameMethods.includes(member.name)) {
      this.headerNameCheck(name, module);
    }
    if (value != undefined && kHeaderValueMethods.includes(member.name)) {
      this.headerValueCheck(value, module);
    }
  }

  private isProvenSetter(
    expr: CallExpr,
    member: MemberExpr,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const input = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    const isSetter = kUrlSetters.includes(member.name);
    if (
      !isSetter ||
      input == undefined ||
      tree.argumentsOf(expr.argsList).length != 1
    ) {
      return false;
    }

    const text = this.fetchText(input);
    if (text == undefined) {
      return false;
    }

    const error = this.fetches.setterError(input.loc, member.name, text);

    this.errors.writeFound(module, error);

    return error == undefined;
  }

  private isKnownAbsolute(expr: Expr, module: int): boolean {
    const tree = this.types.program.tree;

    const text = this.fetchText(expr);
    if (text != undefined) {
      return this.fetches.isValidUrlText(text, false);
    }

    const type = this.peekType(expr, module);
    if (this.isFetchClass(type, kUrlName)) {
      return true;
    }
    if (expr.kind == ExprKind.Member) {
      return this.isRequestUrl(expr, module);
    }
    if (
      expr.kind == ExprKind.Call &&
      tree.argumentsOf(expr.argsList).length == 0
    ) {
      const callee = tree.exprOf(expr.calleeId);

      return this.isHrefCall(callee, module);
    }

    return false;
  }

  private isRequestUrl(expr: MemberExpr, module: int): boolean {
    const tree = this.types.program.tree;

    const objectExpr = tree.exprOf(expr.objectId);
    const object = this.peekType(objectExpr, module);

    return expr.name == kUrlField && this.isFetchClass(object, kRequestName);
  }

  private isHrefCall(callee: Expr, module: int): boolean {
    const tree = this.types.program.tree;

    if (callee.kind != ExprKind.Member || callee.name != kHrefName) {
      return false;
    }

    const objectExpr = tree.exprOf(callee.objectId);
    const object = this.peekType(objectExpr, module);

    return this.isFetchClass(object, kUrlName);
  }

  private isFetchClass(type: Type, name: string): boolean {
    const base = this.types.definedType(type);
    if (base.kind != TypeKind.Instance) {
      return false;
    }

    return this.types.isTypedLibrary(base.module) && base.name == name;
  }

  private hasBody(body: Expr, module: int): boolean {
    const type = this.peekType(body, module);

    return (
      type.kind != TypeKind.Error &&
      type.kind != TypeKind.Undefined &&
      !this.types.isOptional(type)
    );
  }

  private readonly fetchText(expr: Expr): string | undefined {
    const tree = this.types.program.tree;

    if (expr.kind == ExprKind.StringLit) {
      return expr.value;
    }
    if (
      expr.kind == ExprKind.Template &&
      tree.exprsOf(expr.exprsList).length == 0
    ) {
      return tree.textsOf(expr.quasisList)[0];
    }

    return undefined;
  }

  private readonly literalProperty(
    init: ObjectLitExpr,
    name: string,
  ): Property | undefined {
    const tree = this.types.program.tree;

    return tree.propertiesOf(init.propsList).find(
      (property) =>
        property.form.kind == PropertyKind.Value && property.name == name,
    );
  }

  private fetchMismatchHint(given: Type, wanted: Type): string {
    const from = this.types.definedType(given);
    const to = this.types.definedType(wanted);
    const parts = this.unionParts(to);
    const isStream = this.isFetchClass(from, kReadableStreamName);
    const hasForm = parts.some((part) =>
      this.isFetchClass(part, kFormDataName),
    );
    const hasStream = parts.some((part) =>
      this.isFetchClass(part, kReadableStreamName),
    );
    if (isStream && hasForm && !hasStream) {
      return kStreamBodyHint;
    }

    const fromName = this.types.typeText(from);
    const toName = this.types.typeText(to);
    if (
      fromName.startsWith(kRequestInitName) &&
      toName == kRequestOptionsName
    ) {
      return kRequestInitHint;
    }

    return "";
  }

  private readonly unionParts(type: Type): Type[] {
    if (type.kind == TypeKind.Union) {
      return this.types.store.partsOf(type);
    }

    return [type];
  }
}
