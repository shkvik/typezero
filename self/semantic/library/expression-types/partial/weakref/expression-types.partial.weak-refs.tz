import {
  CallExpr,
  MemberExpr,
  NewExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  InstanceType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import { ValueTarget } from "../../../../code/expression-types/types/expression-types.types.tz";

partial class ExpressionTypes {
  private weakRefNew(
    expr: NewExpr,
    name: string,
    target: ValueTarget,
    wanted: Type | undefined,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    if (
      !this.types.isWeakRefName(name) ||
      this.types.isLibraryModule(module)
    ) {
      return undefined;
    }

    const value = tree.argumentsOf(expr.argsList)[0];
    if (
      value == undefined ||
      tree.argumentsOf(expr.argsList).length != 1 ||
      value.spread
    ) {
      this.errors.writeFound(module, this.types.oneObjectError(expr.loc));
      const args = tree.argumentsOf(expr.argsList);

      this.looseArguments(args, module);

      return this.types.store.plain(TypeKind.Error);
    }
    const typeArgs = tree.typeRefsOf(expr.typeArgsList);
    if (typeArgs.length > 1) {
      this.errors.writeFound(module, this.types.typeArgumentsError(expr.loc));
      const argsItem = tree.argumentsOf(expr.argsList);

      this.looseArguments(argsItem, module);

      return this.types.store.plain(TypeKind.Error);
    }

    const written = this.writtenArguments(
      tree.typeRefsOf(expr.typeArgsList),
      module,
    );
    if (written == undefined) {
      const exprArgs = tree.argumentsOf(expr.argsList);

      this.looseArguments(exprArgs, module);

      return this.types.store.plain(TypeKind.Error);
    }

    const expected = written[0] ?? this.weakTargetOf(wanted);
    const exprExpr = tree.exprOf(value.exprId);
    const given = this.typed(exprExpr, expected, module);
    const object = expected ?? given;
    if (given.kind == TypeKind.Error) {
      return this.types.store.plain(TypeKind.Error);
    }

    const targetError = this.types.targetError(
      tree.exprOf(value.exprId).loc,
      object,
    );
    if (targetError != undefined) {
      this.errors.writeFound(module, targetError);

      return this.types.store.plain(TypeKind.Error);
    }

    const valueExpr = tree.exprOf(value.exprId);

    this.coerce(valueExpr, given, object, module, "");

    return this.weakRefOf(target, object);
  }

  private weakTargetOf(wanted: Type | undefined): Type | undefined {
    if (wanted == undefined) {
      return undefined;
    }

    const base = this.types.definedType(wanted);
    if (base.kind != TypeKind.Instance || !this.types.isWeakRef(base)) {
      return undefined;
    }

    return this.types.store.argsOf(base)[0];
  }

  private weakRefOf(target: ValueTarget, object: Type): Type {
    const tree = this.types.program.tree;

    const home = target.module;
    const opened = this.types.program.modules[home];
    const declared = tree
      .declaredClassesOf(opened?.declaredList)
      .find((one) => one.loc == target.loc);
    if (declared == undefined) {
      return this.types.store.plain(TypeKind.Error);
    }

    const made = this.types.declaredInstance(home, declared, [object]);

    return made ?? this.types.store.plain(TypeKind.Error);
  }

  private weakRefCall(
    expr: CallExpr,
    member: MemberExpr,
    instance: InstanceType,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    if (
      !this.types.isWeakRef(instance) ||
      this.types.isDeref(member.name)
    ) {
      return undefined;
    }

    const noMethodError = this.types.noMethodError(
      member.loc,
      member.name,
      instance,
    );

    this.errors.writeFound(module, noMethodError);
    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args, module);

    return this.types.store.plain(TypeKind.Error);
  }

  private weakRefRead(
    expr: MemberExpr,
    instance: InstanceType,
    module: int,
  ): Type | undefined {
    if (!this.types.isWeakRef(instance)) {
      return undefined;
    }

    const valueError = this.types.weakRefReadError(
      expr.loc,
      expr.name,
      instance,
    );

    this.errors.writeFound(module, valueError);

    return this.types.store.plain(TypeKind.Error);
  }
}
