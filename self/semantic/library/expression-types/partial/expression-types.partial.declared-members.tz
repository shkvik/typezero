import {
  DeclaredClass,
  DeclaredMember,
  DeclaredMemberKind,
} from "../../../../program/ast/types/ast.types.declarations.tz";
import {
  InstanceType,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import { ParameterSite } from "../../../types/type-resolver/types/type-resolver.types.tz";
import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";

partial class ExpressionTypes {
  private libraryMemberType(
    receiver: Type,
    name: string,
    isCalled: boolean,
  ): Type | undefined {
    const found = this.receiverMember(receiver, name, isCalled);
    if (found == undefined || this.mentionsLibraryParameter(found)) {
      return undefined;
    }

    return found;
  }

  private receiverMember(
    receiver: Type,
    name: string,
    isCalled: boolean,
  ): Type | undefined {
    if (receiver.kind == TypeKind.Object) {
      const fields = this.types.store
        .fieldsOf(receiver)
        .filter((field) => field.name == name);
      const field = fields[0];
      if (field == undefined || fields.length > 1) {
        return undefined;
      }

      return this.types.fieldWanted(field);
    }
    if (receiver.kind != TypeKind.Instance) {
      return undefined;
    }

    return this.declaredMember(receiver, name, isCalled);
  }

  private declaredMember(
    instance: InstanceType,
    name: string,
    isCalled: boolean,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const opened = this.types.program.modules[instance.module];
    const declared = tree
      .declaredClassesOf(opened?.declaredList)
      .find((one) => one.loc == instance.loc);
    if (declared == undefined) {
      return undefined;
    }

    const members = tree.declaredMembersOf(declared.membersList).filter(
      (one) => one.name == name && !one.isStatic,
    );
    if (members.length == 0) {
      return this.parentMember(instance, name, isCalled);
    }

    return this.declaredForm(instance, declared, members, isCalled);
  }

  private declaredStatic(
    instance: InstanceType,
    name: string,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const opened = this.types.program.modules[instance.module];
    const declared = tree
      .declaredClassesOf(opened?.declaredList)
      .find((one) => one.loc == instance.loc);
    if (declared == undefined) {
      return undefined;
    }

    const members = tree.declaredMembersOf(declared.membersList).filter(
      (one) => one.name == name && one.isStatic,
    );

    return this.declaredForm(instance, declared, members, true);
  }

  private declaredForm(
    instance: InstanceType,
    declared: DeclaredClass,
    members: Read<DeclaredMember[]>,
    isCalled: boolean,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const member = members[0];
    if (member == undefined) {
      return undefined;
    }

    const form = member.form;
    const context = this.types.classContext(
      instance,
      tree.typeParamsOf(declared.typeParamsList),
      instance.module,
    );

    if (form.kind == DeclaredMemberKind.Field) {
      const written = tree.typeRefAt(member.typeId);
      if (written == undefined || isCalled) {
        return undefined;
      }

      const type = this.types.resolve(written, context);

      if (form.optional) {
        return this.types.optional(type);
      }

      return type;
    }

    const isPlain = form.kind == DeclaredMemberKind.Method;
    if (!isPlain || members.length > 1) {
      return undefined;
    }
    if (tree.typeParamsOf(form.typeParamsList).length > 0 && !isCalled) {
      return undefined;
    }

    const sites: ParameterSite[] = [];

    for (const param of tree.paramsOf(form.paramsList)) {
      const type = tree.typeRefAt(param.typeId);
      if (type == undefined) {
        return undefined;
      }

      sites.push({
        name: param.name,
        loc: param.loc,
        kind: param.form.kind,
        type,
        isDeclared: false,
      });
    }

    const typeRef = tree.typeRefAt(member.typeId);

    return this.types.signature(sites, typeRef, context);
  }

  private parentMember(
    instance: InstanceType,
    name: string,
    isCalled: boolean,
  ): Type | undefined {
    const parent = this.types.baseClassOf(instance);
    if (parent == undefined || parent.kind != TypeKind.Instance) {
      return undefined;
    }

    return this.declaredMember(parent, name, isCalled);
  }
}
