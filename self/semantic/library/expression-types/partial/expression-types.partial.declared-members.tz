import {
  DeclaredClass,
  DeclaredMember,
  DeclaredMemberKind,
} from "../../../../program/ast/types/ast.types.declarations.tz";
import {
  InstanceType,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import { ParameterSite } from "../../../types/type-resolver/types/type-resolver.types.tz";
import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";

partial class ExpressionTypes {
  private readonly libraryMemberType(
    receiver: Type,
    name: string,
    isCalled: boolean,
  ): Type | undefined {
    const found = this.receiverMember(receiver, name, isCalled);
    if (found == undefined || this.parts.mentionsParameter(found)) {
      return undefined;
    }

    return found;
  }

  private readonly receiverMember(
    receiver: Type,
    name: string,
    isCalled: boolean,
  ): Type | undefined {
    if (receiver.kind == TypeKind.Object) {
      const fields = receiver.fields.filter((field) => field.name == name);
      const field = fields[0];
      if (field == undefined || fields.length > 1) {
        return undefined;
      }

      return this.objects.fieldWanted(field);
    }
    if (receiver.kind != TypeKind.Instance) {
      return undefined;
    }

    return this.declaredMember(receiver, name, isCalled);
  }

  private readonly declaredMember(
    instance: InstanceType,
    name: string,
    isCalled: boolean,
  ): Type | undefined {
    const opened = this.program.modules[instance.module];
    const declared = opened?.declared.find((one) => one.loc == instance.loc);
    if (declared == undefined) {
      return undefined;
    }

    const members = declared.members.filter(
      (one) => one.name == name && !one.isStatic,
    );
    if (members.length == 0) {
      return this.parentMember(instance, name, isCalled);
    }

    return this.declaredForm(instance, declared, members, isCalled);
  }

  private readonly declaredStatic(
    instance: InstanceType,
    name: string,
  ): Type | undefined {
    const opened = this.program.modules[instance.module];
    const declared = opened?.declared.find((one) => one.loc == instance.loc);
    if (declared == undefined) {
      return undefined;
    }

    const members = declared.members.filter(
      (one) => one.name == name && one.isStatic,
    );

    return this.declaredForm(instance, declared, members, true);
  }

  private readonly declaredForm(
    instance: InstanceType,
    declared: DeclaredClass,
    members: Read<DeclaredMember[]>,
    isCalled: boolean,
  ): Type | undefined {
    const member = members[0];
    if (member == undefined) {
      return undefined;
    }

    const form = member.form;
    const context = this.resolver.classContext(
      instance,
      declared.typeParams,
      instance.module,
    );

    if (form.kind == DeclaredMemberKind.Field) {
      const written = member.type;
      if (written == undefined || isCalled) {
        return undefined;
      }

      const type = this.resolver.resolve(written, context);

      if (form.optional) {
        return this.types.optional(type);
      }

      return type;
    }

    const isPlain = form.kind == DeclaredMemberKind.Method;
    if (!isPlain || members.length > 1) {
      return undefined;
    }
    if (form.typeParams.length > 0 && !isCalled) {
      return undefined;
    }

    const sites: ParameterSite[] = [];

    for (const param of form.params) {
      const type = param.type;
      if (type == undefined) {
        return undefined;
      }

      sites.push({
        name: param.name,
        loc: param.loc,
        kind: param.form.kind,
        type,
        isDeclared: false,
      });
    }

    return this.resolver.signature(sites, member.type, context);
  }

  private readonly parentMember(
    instance: InstanceType,
    name: string,
    isCalled: boolean,
  ): Type | undefined {
    const parent = this.types.baseClassOf(instance);
    if (parent == undefined || parent.kind != TypeKind.Instance) {
      return undefined;
    }

    return this.declaredMember(parent, name, isCalled);
  }
}
