import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { StaticOwner } from "../../../../code/expression-types/types/expression-types.types.tz";
import {
  kComposeName,
  kFinishedName,
  kFromName,
  kPipelineName,
  kReadableName,
} from "../../../event-rules/const/event-rules.const.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";

partial class ExpressionTypes {
  private streamFunctionCall(expr: CallExpr, name: string, module: int): Type {
    const tree = this.types.program.tree;

    if (name == kFinishedName) {
      for (const arg of tree.argumentsOf(expr.argsList)) {
        const exprExpr = tree.exprOf(arg.exprId);

        this.listenerLoose(exprExpr, module);
      }

      return this.types.store.plain(TypeKind.Error);
    }

    let chunk: Type | undefined = undefined;

    for (const arg of tree.argumentsOf(expr.argsList)) {
      const value = tree.exprOf(arg.exprId);
      if (value.kind == ExprKind.Function) {
        this.listenerLoose(value, module);
        chunk = undefined;

        continue;
      }

      const type = this.typed(value, undefined, module);

      chunk = this.stageChunk(name, value, type, chunk, module);
    }

    if (name == kComposeName && tree.argumentsOf(expr.argsList).length < 2) {
      this.errors.write(module, expr.loc, Code.StreamComposeFew, kNoDetails);
    }

    return this.types.store.plain(TypeKind.Error);
  }

  private stageChunk(
    name: string,
    value: Expr,
    type: Type,
    before: Type | undefined,
    module: int,
  ): Type | undefined {
    if (type.kind == TypeKind.Error) {
      return undefined;
    }
    if (!this.isStream(type)) {
      if (name == kComposeName) {
        const word = this.types.typeText(type);

        this.errors.write(module, value.loc, Code.StreamComposeOther, { word });
      }

      return undefined;
    }
    if (before != undefined) {
      this.stageTakesCheck(name, value, type, before, module);
    }

    return this.streamChunk(type, true);
  }

  private stageTakesCheck(
    name: string,
    value: Expr,
    type: Type,
    before: Type,
    module: int,
  ): void {
    const takes = this.streamChunk(type, false);
    if (takes == undefined) {
      if (name == kPipelineName) {
        const word = this.types.typeText(type);

        this.errors.write(module, value.loc, Code.StreamPipelineUnwritable, {
          word,
        });
      }

      return;
    }
    if (this.isStreamTaking(takes, before)) {
      return;
    }

    this.errors.write(module, value.loc, Code.StreamStageChunk, {
      word: name,
      first: this.types.typeText(before),
      second: this.stageText(type),
      other: this.types.typeText(takes),
    });
  }

  private readonly stageText(type: Type): string {
    if (
      type.kind != TypeKind.Instance ||
      this.types.store.argsOf(type).length == 0
    ) {
      return this.types.typeText(type);
    }

    const args = this.types.store
      .argsOf(type)
      .map((one) => this.types.typeText(one));

    return `${type.name}<${args.join(", ")}>`;
  }

  private isStreamTaking(takes: Type, chunk: Type): boolean {
    if (takes.id == chunk.id || chunk.kind == TypeKind.Error) {
      return true;
    }

    const isText =
      chunk.kind == TypeKind.String || chunk.kind == TypeKind.Template;
    if (this.isBufferChunk(takes) && isText) {
      return true;
    }

    return this.types.extends(chunk, takes);
  }

  private streamFromCall(
    expr: CallExpr,
    member: MemberExpr,
    owner: StaticOwner,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const isFrom =
      member.name == kFromName &&
      owner.decl.name == kReadableName &&
      this.isStreamModule(owner.module);
    if (!isFrom || this.types.isLibraryModule(module)) {
      return undefined;
    }

    const value = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);

    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args.slice(1), module);

    if (value == undefined) {
      return this.types.store.plain(TypeKind.Error);
    }

    const given = this.typed(value, undefined, module);
    if (given.kind == TypeKind.Error) {
      return given;
    }

    const chunk = this.fromChunk(given);
    if (chunk == undefined) {
      const word = this.types.typeText(given);

      this.errors.write(module, value.loc, Code.StreamFromSource, { word });

      return this.types.store.plain(TypeKind.Error);
    }

    return this.types.classInstance(owner.module, owner.decl, [chunk]);
  }

  private fromChunk(given: Type): Type | undefined {
    if (this.isBufferChunk(given)) {
      return this.types.definedType(given);
    }

    return this.iteratedItem(given);
  }
}
