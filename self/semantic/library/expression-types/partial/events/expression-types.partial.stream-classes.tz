import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import { ClassDecl } from "../../../../../program/ast/types/ast.types.classes.tz";
import { NewExpr } from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  FunctionDecl,
  Param,
} from "../../../../../program/ast/types/ast.types.functions.tz";
import {
  FunctionType,
  InstanceType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  kPassThroughName,
  kStreamAbstractExamples,
  kStreamAbstractHooks,
  kStreamChunkHooks,
  kStreamClassNames,
  kStreamHookNames,
  kReadableName,
} from "../../../event-rules/const/event-rules.const.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";

partial class ExpressionTypes {
  private streamNew(
    expr: NewExpr,
    decl: ClassDecl,
    home: int,
    wanted: Type | undefined,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const name = decl.name ?? "";
    const isStreamClass =
      this.isStreamModule(home) && kStreamClassNames.includes(name);
    if (!isStreamClass || this.types.isLibraryModule(module)) {
      return undefined;
    }
    if (name != kPassThroughName) {
      this.reportAbstractStream(expr, name, module);
      const args = tree.argumentsOf(expr.argsList);

      this.looseArguments(args, module);

      return this.types.store.plain(TypeKind.Error);
    }
    if (
      tree.typeRefsOf(expr.typeArgsList).length > 0 ||
      this.isWantedClass(wanted, name, home)
    ) {
      return undefined;
    }

    this.errors.write(module, expr.loc, Code.StreamUntypedNew, { word: name });
    const argsItem = tree.argumentsOf(expr.argsList);

    this.looseArguments(argsItem, module);

    return this.types.store.plain(TypeKind.Error);
  }

  private reportAbstractStream(expr: NewExpr, name: string, module: int): void {
    if (name == kReadableName) {
      this.errors.write(
        module,
        expr.loc,
        Code.StreamAbstractReadable,
        kNoDetails,
      );

      return;
    }

    const first = kStreamAbstractHooks.get(name) ?? "";
    const second = kStreamAbstractExamples.get(name) ?? "";

    this.errors.write(module, expr.loc, Code.StreamAbstract, {
      word: name,
      first,
      second,
    });
  }

  private readonly isWantedClass(
    wanted: Type | undefined,
    name: string,
    home: int,
  ): boolean {
    if (wanted == undefined) {
      return false;
    }

    return this.types
      .unionMembers(wanted)
      .some(
        (one) =>
          one.kind == TypeKind.Instance &&
          one.name == name &&
          one.module == home,
      );
  }

  private hookedParameter(fn: FunctionDecl, param: Param, type: Type): Type {
    const tree = this.types.program.tree;

    const isHook = kStreamHookNames.includes(fn.name);
    if (type.kind != TypeKind.Double || !isHook) {
      return type;
    }

    const hook = this.libraryHookType(fn);
    const index = tree
      .paramsOf(fn.paramsList)
      .findIndex((one) => one.loc == param.loc);
    const wanted = this.types.store.paramsOf(hook)[index]?.type;
    if (wanted == undefined || wanted.kind != TypeKind.Int) {
      return type;
    }

    return wanted;
  }

  private libraryHookType(fn: FunctionDecl): FunctionType | undefined {
    const tree = this.types.program.tree;

    const current = this.ownerClasses[this.ownerClasses.length - 1];
    if (
      current == undefined ||
      tree.typeParamsOf(current.decl.typeParamsList).length > 0
    ) {
      return undefined;
    }

    const decl = current.decl;
    const self = this.types.classInstance(current.module, decl, []);
    if (self.kind != TypeKind.Instance) {
      return undefined;
    }

    const parent = this.types.parentOf(self, decl);
    if (parent == undefined) {
      return undefined;
    }

    const entryLookup = this.classMember(parent, fn.name);

    const entry = entryLookup.entry;
    const theirs = entry?.methods[0];
    if (entry == undefined || theirs == undefined) {
      return undefined;
    }
    if (!this.isStreamModule(entry.instance.module)) {
      return undefined;
    }

    const type = this.methodTypeOf(entry, theirs);
    if (type.kind != TypeKind.Function) {
      return undefined;
    }

    return type;
  }

  private streamHookCheck(
    method: FunctionDecl,
    decl: ClassDecl,
    parent: InstanceType,
    module: int,
  ): void {
    const hook = this.streamHookVariant(method, decl, parent, module);
    if (hook == undefined) {
      return;
    }

    const code = this.hookCode(method.name);

    this.errors.write(module, method.loc, code, {
      word: method.name,
      first: hook,
    });
  }

  private readonly hookCode(name: string): Code {
    if (kStreamChunkHooks.includes(name)) {
      return Code.StreamHookOtherChunks;
    }

    return Code.StreamHookOther;
  }

  private streamHookVariant(
    method: FunctionDecl,
    decl: ClassDecl,
    parent: InstanceType | undefined,
    module: int,
  ): string | undefined {
    const tree = this.types.program.tree;

    const isHook = kStreamHookNames.includes(method.name);
    const isTyped = tree
      .paramsOf(method.paramsList)
      .every((param) => tree.typeRefAt(param.typeId) != undefined);
    if (!isHook || !isTyped || parent == undefined) {
      return undefined;
    }
    if (this.types.isLibraryModule(module)) {
      return undefined;
    }

    const entryLookup = this.classMember(parent, method.name);

    const entry = entryLookup.entry;
    const theirs = entry?.methods[0];
    if (entry == undefined || theirs == undefined) {
      return undefined;
    }
    if (!this.isStreamModule(entry.instance.module)) {
      return undefined;
    }

    const theirType = this.methodTypeOf(entry, theirs);
    const ownType = this.ownMethodType(decl, method, module);
    if (theirType.kind != TypeKind.Function || ownType == undefined) {
      return undefined;
    }

    const home = entry.instance.module;
    const isSame =
      this.types.isSameParameters(ownType, theirType) ||
      this.isLibraryHookPrefix(ownType, theirType, home);
    if (isSame) {
      return undefined;
    }

    return this.types.variantText(theirs, theirType);
  }
}
