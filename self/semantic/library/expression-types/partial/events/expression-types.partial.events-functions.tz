import { Code } from "../../../../../diagnostic/code.tz";
import {
  CallExpr,
  MemberExpr,
  NameExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  StaticOwner,
  ValueTarget,
} from "../../../../code/expression-types/types/expression-types.types.tz";
import {
  kEmitterName,
  kEventsModule,
  kEventsFunctions,
  kEventTargetName,
  kOnName,
  kOrEventTarget,
  kStreamFunctions,
  kStreamModules,
} from "../../../event-rules/const/event-rules.const.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";

partial class ExpressionTypes {
  private eventsFunctionCall(
    expr: CallExpr,
    callee: NameExpr,
    target: ValueTarget,
    module: int,
  ): Type | undefined {
    const home = this.types.program.modules[target.module]?.name ?? "";
    const declared = this.record(target.module)?.functions.get(target.loc);
    const isStreamFunction =
      target.kind == SymbolKind.Function &&
      kStreamModules.includes(home) &&
      kStreamFunctions.includes(declared?.name ?? callee.name);
    if (isStreamFunction && !this.types.isLibraryModule(module)) {
      const name = declared?.name ?? callee.name;

      return this.streamFunctionCall(expr, name, module);
    }

    const isFunction =
      target.kind == SymbolKind.Function &&
      home == kEventsModule &&
      kEventsFunctions.includes(callee.name);
    if (!isFunction) {
      return undefined;
    }

    this.endlessWaitCheck(expr, callee.name, module);

    return this.emitterArgumentCall(expr, callee.name, callee.loc, module);
  }

  private emitterStaticCall(
    expr: CallExpr,
    member: MemberExpr,
    owner: StaticOwner,
    module: int,
  ): Type | undefined {
    const home = this.types.program.modules[owner.module]?.name;
    const isStatic =
      owner.decl.name == kEmitterName &&
      home == kEventsModule &&
      kEventsFunctions.includes(member.name);
    if (!isStatic) {
      return undefined;
    }

    return this.emitterArgumentCall(expr, member.name, member.loc, module);
  }

  private emitterArgumentCall(
    expr: CallExpr,
    name: string,
    loc: int,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const first = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (first == undefined || this.types.isLibraryModule(module)) {
      return undefined;
    }

    const listened = this.emitterKey(first, module);
    if (listened != undefined) {
      this.eventMarks.errorListened.add(listened);
    }

    const given = this.peekType(first, module);
    const base = this.types.definedType(given);
    const isTarget = this.isWebClass(base, kEventTargetName);
    const isUnknownClass = base.kind == TypeKind.Instance && !isTarget;
    if (base.kind == TypeKind.Error || isUnknownClass) {
      return undefined;
    }
    if (isTarget && name != kOnName) {
      return undefined;
    }
    if (isTarget) {
      this.errors.write(module, loc, Code.EventsTargetOn, kNoDetails);
    } else {
      const other = this.targetHint(name);
      const shown = this.types.typeText(given);

      this.errors.write(module, first.loc, Code.EventsNotEmitter, {
        word: name,
        other,
        first: shown,
      });
    }

    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args, module);

    return this.types.store.plain(TypeKind.Error);
  }

  private readonly targetHint(name: string): string {
    if (name == kOnName) {
      return "";
    }

    return kOrEventTarget;
  }
}
