import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../../program/ast/types/ast.types.functions.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import {
  InstanceType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import { ValueTarget } from "../../../../code/expression-types/types/expression-types.types.tz";
import {
  Capture,
  ListenerForm,
  ListenerShape,
} from "../../../event-marks/types/event-marks.types.tz";
import {
  kEmitterBaseName,
  kEmitterName,
  kNotReceivers,
  kOffName,
  kRemoveListenerName,
  kConstructorWord,
  kThisEmitter,
  kThisWord,
  kTimeoutField,
} from "../../../event-rules/const/event-rules.const.tz";

partial class ExpressionTypes {
  private listenerLife(expr: CallExpr, member: MemberExpr, module: int): void {
    const tree = this.types.program.tree;

    const name = member.name;
    const listener = tree.exprAt(tree.argumentsOf(expr.argsList)[1]?.exprId);
    const isRemoving = name == kOffName || name == kRemoveListenerName;
    if (listener == undefined || isRemoving) {
      return;
    }

    this.listenerLifeCheck(
      listener,
      tree.exprOf(member.objectId),
      false,
      module,
    );
  }

  private listenerLifeCheck(
    listener: Expr,
    emitter: Expr | undefined,
    isTimer: boolean,
    module: int,
  ): void {
    if (this.types.isLibraryModule(module)) {
      return;
    }

    const shape = this.listenerShape(listener, module);
    if (shape.isSelf) {
      this.noteSelfListener();
    }

    const isTopLevel =
      this.openFunctions.length == 0 ||
      (emitter != undefined && this.isOwningEmitter(emitter, module));
    if (isTopLevel) {
      return;
    }

    switch (shape.form) {
      case ListenerForm.Captures:
        return this.capturesReport(listener, shape.captured, isTimer, module);
      case ListenerForm.Unknown: {
        const code = this.lifeCode(
          isTimer,
          Code.TimerUnknown,
          Code.ListenerUnknown,
        );

        return this.errors.write(module, listener.loc, code, kNoDetails);
      }
      default:
        return;
    }
  }

  private readonly lifeCode(
    isTimer: boolean,
    timer: Code,
    listener: Code,
  ): Code {
    if (isTimer) {
      return timer;
    }

    return listener;
  }

  private capturesReport(
    listener: Expr,
    captured: Read<Capture[]>,
    isTimer: boolean,
    module: int,
  ): void {
    for (const one of captured) {
      if (one.isChanged || !this.canReceive(one.type)) {
        const code = this.lifeCode(
          isTimer,
          Code.TimerKeeps,
          Code.ListenerKeeps,
        );

        this.errors.write(module, listener.loc, code, { word: one.name });

        return;
      }
    }

    const kept = captured.find((one) => one.isThis) ?? captured[0];
    if (kept == undefined) {
      return;
    }

    const others = captured.filter((one) => one.name != kept.name);
    const code = this.lifeCode(
      isTimer,
      Code.TimerCaptures,
      Code.ListenerCaptures,
    );

    this.errors.write(module, listener.loc, code, {
      first: this.namesText(captured),
      second: this.namesText(others),
      other: kept.name,
    });
  }

  private readonly namesText(captured: Read<Capture[]>): string {
    const quoted = captured.map((one) => `'${one.name}'`);
    const last = quoted[quoted.length - 1] ?? "";
    if (quoted.length < 2) {
      return last;
    }

    const head = quoted.slice(0, quoted.length - 1).join(", ");

    return `${head} and ${last}`;
  }

  private listenerShape(listener: Expr, module: int): ListenerShape {
    const tree = this.types.program.tree;

    if (listener.kind == ExprKind.Function) {
      const fnFn = tree.functionOf(listener.fnId);

      return this.listenerClosure(fnFn, module);
    }
    if (listener.kind == ExprKind.Member) {
      return this.memberShape(listener, module);
    }
    if (listener.kind == ExprKind.Name) {
      const target = this.targetOfName(listener, module);
      const fn = this.declaredFunction(target);
      if (fn != undefined) {
        return this.listenerClosure(fn, module);
      }
    }

    return { form: ListenerForm.Unknown, captured: [], isSelf: false };
  }

  private readonly declaredFunction(
    target: ValueTarget | undefined,
  ): FunctionDecl | undefined {
    if (target == undefined || target.kind != SymbolKind.Function) {
      return undefined;
    }

    return this.record(target.module)?.functions.get(target.loc);
  }

  private memberShape(listener: MemberExpr, module: int): ListenerShape {
    const tree = this.types.program.tree;

    const object = this.types.definedType(
      this.peekType(tree.exprOf(listener.objectId), module),
    );
    const isMethod =
      object.kind == TypeKind.Instance &&
      this.isOwnMethod(object, listener.name) &&
      this.canReceive(object);
    if (!isMethod) {
      return { form: ListenerForm.Unknown, captured: [], isSelf: false };
    }

    const objectExpr = tree.exprOf(listener.objectId);
    const isSelf = this.isThisName(objectExpr, module);

    return { form: ListenerForm.Receiver, captured: [], isSelf };
  }

  private readonly isOwnMethod(instance: InstanceType, name: string): boolean {
    const entryLookup = this.classMember(instance, name);
    const entry = entryLookup.entry;

    return entry != undefined && entry.field == undefined && !entry.isStatic;
  }

  private listenerClosure(fn: FunctionDecl, module: int): ListenerShape {
    const captured = this.capturesOf(fn, module);
    const only = captured[0];
    if (only == undefined) {
      return { form: ListenerForm.Free, captured, isSelf: false };
    }

    const isSingle =
      captured.length == 1 &&
      !fn.isGenerator &&
      !only.isChanged &&
      this.canReceive(only.type);
    if (isSingle) {
      return { form: ListenerForm.Receiver, captured, isSelf: only.isThis };
    }

    return { form: ListenerForm.Captures, captured, isSelf: false };
  }

  private capturesOf(fn: FunctionDecl, module: int): Capture[] {
    const exprs = this.types.functionExprs(fn, true);
    let last = fn.loc;

    for (const expr of exprs) {
      if (expr.loc > last) {
        last = expr.loc;
      }
    }

    const changed = this.changedNames(exprs, module);
    const captured: Capture[] = [];
    const seen = new Set<string>();

    for (const expr of exprs) {
      if (expr.kind != ExprKind.Name || seen.has(expr.name)) {
        continue;
      }
      if (this.isThisName(expr, module)) {
        seen.add(expr.name);
        captured.push(this.thisCapture());

        continue;
      }

      const target = this.targetOfName(expr, module);
      const isOutside =
        target != undefined &&
        (target.loc < fn.loc || target.loc > last) &&
        this.isLocalTarget(target, module);
      if (target == undefined || !isOutside) {
        continue;
      }

      seen.add(expr.name);
      captured.push({
        name: expr.name,
        type:
          this.valueOfName(expr, module) ??
          this.types.store.plain(TypeKind.Error),
        isChanged: changed.has(target.loc),
        isThis: false,
      });
    }

    return captured;
  }

  private readonly thisCapture(): Capture {
    const self = this.selves[this.selves.length - 1];

    return {
      name: kThisWord,
      type: self ?? this.types.store.plain(TypeKind.Error),
      isChanged: false,
      isThis: true,
    };
  }

  private readonly changedNames(exprs: Read<Expr[]>, module: int): Set<int> {
    const changed = new Set<int>();

    for (const expr of exprs) {
      const target = this.changedTarget(expr);
      if (target == undefined || target.kind != ExprKind.Name) {
        continue;
      }

      const found = this.targetOfName(target, module);
      if (found != undefined) {
        changed.add(found.loc);
      }
    }

    return changed;
  }

  private readonly changedTarget(expr: Expr): Expr | undefined {
    const tree = this.types.program.tree;

    if (expr.kind == ExprKind.Update || expr.kind == ExprKind.Assign) {
      return tree.exprOf(expr.targetId);
    }

    return undefined;
  }

  private readonly isLocalTarget(target: ValueTarget, module: int): boolean {
    const isValue =
      target.kind == SymbolKind.Variable || target.kind == SymbolKind.Parameter;
    if (!isValue || target.module != module) {
      return false;
    }

    return !this.isModuleVariable(target);
  }

  private readonly isModuleVariable(target: ValueTarget): boolean {
    const tree = this.types.program.tree;

    const opened = this.types.program.modules[target.module];
    if (opened == undefined) {
      return false;
    }

    return tree
      .stmtsOf(opened.file.itemsList)
      .some((item) => this.types.isItemDeclaring(item, target.loc));
  }

  private canReceive(type: Type): boolean {
    const base = this.types.definedType(type);
    if (base.kind == TypeKind.Object) {
      return true;
    }

    return base.kind == TypeKind.Instance && !kNotReceivers.includes(base.name);
  }

  private readonly isOwningEmitter(emitter: Expr, module: int): boolean {
    if (emitter.kind == ExprKind.New) {
      return true;
    }
    if (emitter.kind != ExprKind.Name || this.isThisName(emitter, module)) {
      return false;
    }

    const fn = this.openFunctions[this.openFunctions.length - 1];
    const target = this.targetOfName(emitter, module);
    if (fn == undefined || target == undefined) {
      return false;
    }
    if (target.kind != SymbolKind.Variable || target.loc < fn.loc) {
      return false;
    }

    return this.isLocalTarget(target, module);
  }

  private noteSelfListener(): void {
    const owner = this.ownerClasses[this.ownerClasses.length - 1];
    const fn = this.currentMethods[this.currentMethods.length - 1];
    if (owner == undefined || fn == undefined || fn.name != kConstructorWord) {
      return;
    }

    this.eventMarks.selfListeners.add(`${owner.module} ${owner.decl.loc}`);
  }

  private noteDroppedNew(expr: Expr, type: Type, module: int): void {
    if (expr.kind != ExprKind.New || type.kind != TypeKind.Instance) {
      return;
    }

    this.eventMarks.droppedNews.push({ instance: type, loc: expr.loc, module });
  }

  private droppedNewsCheck(module: int): void {
    for (const dropped of this.eventMarks.droppedNews) {
      if (dropped.module != module) {
        continue;
      }

      const isListening = this.types
        .ancestorsOf(dropped.instance)
        .some(
          (one) =>
            one.kind == TypeKind.Instance &&
            this.eventMarks.selfListeners.has(`${one.module} ${one.loc}`),
        );
      if (!isListening) {
        continue;
      }

      const word = dropped.instance.name;

      this.errors.write(module, dropped.loc, Code.EmitterDropped, {
        word,
        other: word.toLowerCase(),
      });
    }
  }

  private endlessWaitCheck(expr: CallExpr, name: string, module: int): void {
    const tree = this.types.program.tree;

    const first = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (first == undefined || this.isTimedWait(expr)) {
      return;
    }

    const given = this.types.definedType(this.peekType(first, module));
    if (given.kind != TypeKind.Instance || this.isEndingSource(given)) {
      return;
    }

    const isTopLevel =
      this.openFunctions.length == 0 || this.isOwningEmitter(first, module);
    if (isTopLevel) {
      return;
    }

    const word = this.emitterWord(first);

    this.errors.write(module, first.loc, Code.EventsWaitEndless, {
      word,
      first: name,
    });
  }

  private readonly isTimedWait(expr: CallExpr): boolean {
    const tree = this.types.program.tree;

    const options = tree.exprAt(tree.argumentsOf(expr.argsList)[2]?.exprId);
    if (options == undefined || options.kind != ExprKind.ObjectLit) {
      return false;
    }

    return tree
      .propertiesOf(options.propsList)
      .some((prop) => prop.name == kTimeoutField);
  }

  private readonly isEndingSource(given: InstanceType): boolean {
    const isPlain = this.types
      .ancestorsOf(given)
      .some(
        (one) =>
          this.isEventsClass(one, kEmitterName) ||
          this.isEventsClass(one, kEmitterBaseName),
      );
    const isLibrary = this.types.isLibraryModule(given.module);

    return isLibrary && !this.isEventsClass(given, kEmitterName) && !isPlain;
  }

  private readonly emitterWord(first: Expr): string {
    if (first.kind == ExprKind.Name) {
      return `'${first.name}'`;
    }

    return kThisEmitter;
  }
}
