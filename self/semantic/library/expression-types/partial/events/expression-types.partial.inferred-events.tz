import { Code } from "../../../../../diagnostic/code.tz";
import {
  CallArgument,
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import { SymbolKind } from "../../../../../program/scopes/types/scopes.types.tz";
import { SourceLines } from "../../../../../program/source-lines/source-lines.tz";
import {
  InstanceType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import { kNoPlace } from "../../../../code/expression-types/const/expression-types.const.tz";
import { FirstEmit } from "../../../event-marks/types/event-marks.types.tz";
import {
  kEmitName,
  kEmitterName,
  kListenerQueries,
} from "../../../event-rules/const/event-rules.const.tz";

partial class ExpressionTypes {
  private inferredCall(
    expr: CallExpr,
    member: MemberExpr,
    instance: InstanceType,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const isEmitting = member.name == kEmitName;
    const name = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    const rest = tree.argumentsOf(expr.argsList).slice(1);
    if (name == undefined) {
      return this.inferredResult(member, instance);
    }

    const text = this.types.store.plain(TypeKind.String);

    this.checked(name, text, module, kNoPlace);

    const event = this.constantKey(name, module);
    if (event == undefined) {
      if (isEmitting) {
        this.errors.write(module, name.loc, Code.EventNameUnknown, {
          word: member.name,
        });
      }

      this.inferredLoose(rest, module);

      return this.inferredResult(member, instance);
    }

    const key = this.inferredKey(
      tree.exprOf(member.objectId),
      instance,
      module,
    );
    if (isEmitting) {
      this.inferredEmit(rest, name, event, key, module);
    } else {
      this.inferredListen(name, event, key, module);
      this.inferredListener(expr, instance, event, key, module);
    }

    return this.inferredResult(member, instance);
  }

  private inferredListener(
    expr: CallExpr,
    instance: InstanceType,
    event: string,
    key: string | undefined,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const rest = tree.argumentsOf(expr.argsList).slice(1);
    const emitted = this.eventMarks.firstEmits.get(`${key} ${event}`);
    const firstArgs = emitted?.args.slice();
    if (key == undefined || firstArgs == undefined) {
      return this.inferredLoose(rest, module);
    }

    const required = firstArgs.length;
    const args = this.types.store.tupleOf({
      items: firstArgs,
      readonly: false,
      required,
      rest: -1,
    });

    this.listenerChecked(expr, instance, args, module);
  }

  private inferredLoose(args: Read<CallArgument[]>, module: int): void {
    const tree = this.types.program.tree;

    for (const arg of args) {
      const expr = tree.exprOf(arg.exprId);

      this.listenerLoose(expr, module);
    }
  }

  private inferredResult(member: MemberExpr, instance: InstanceType): Type {
    if (member.name == kEmitName) {
      return this.types.store.plain(TypeKind.Boolean);
    }
    if (kListenerQueries.includes(member.name)) {
      return this.listenersOf(undefined);
    }

    return instance;
  }

  private readonly inferredKey(
    object: Expr,
    instance: InstanceType,
    module: int,
  ): string | undefined {
    if (!this.isEventsClass(instance, kEmitterName)) {
      return `class ${instance.module} ${instance.loc}`;
    }
    if (object.kind != ExprKind.Name) {
      return undefined;
    }

    const target = this.targetOfName(object, module);
    if (target == undefined || target.kind != SymbolKind.Variable) {
      return undefined;
    }

    return `${target.module} ${target.loc}`;
  }

  private inferredListen(
    name: Expr,
    event: string,
    key: string | undefined,
    module: int,
  ): void {
    if (key == undefined) {
      return;
    }

    this.eventMarks.listens.push({ key, event, loc: name.loc, module });
  }

  private inferredEmit(
    rest: Read<CallArgument[]>,
    name: Expr,
    event: string,
    key: string | undefined,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const given = rest.map((arg) =>
      this.emittedType(tree.exprOf(arg.exprId), module),
    );
    if (key == undefined) {
      this.eventMarks.looseEmitModules.add(module);

      return;
    }

    const marks = this.eventMarks;
    const isNamed = marks.emittedNames.get(key)?.includes(event) ?? false;

    if (!marks.emittedNames.has(key)) {
      marks.emittedNames.set(key, []);
    }
    if (!isNamed) {
      marks.emittedNames.get(key)?.push(event);
    }

    const slot = `${key} ${event}`;
    const first = this.eventMarks.firstEmits.get(slot);
    if (first == undefined) {
      const place = this.placeText(module, name.loc);

      this.eventMarks.firstEmits.set(slot, { args: given, place });

      return;
    }

    const earlier: FirstEmit = { args: first.args.slice(), place: first.place };

    this.emittedAgainCheck(rest, name, event, given, earlier, module);
  }

  private emittedType(value: Expr, module: int): Type {
    const type = this.typed(value, undefined, module);

    return this.types.baseOf(type) ?? type;
  }

  private emittedAgainCheck(
    rest: Read<CallArgument[]>,
    name: Expr,
    event: string,
    given: Read<Type[]>,
    first: Read<FirstEmit>,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const shown = this.emittedText(first.args);
    if (given.length != first.args.length) {
      const count = given.length;
      const other = `${count} argument${this.countMark(count)}`;

      this.errors.write(module, name.loc, Code.EventEmittedCount, {
        word: event,
        first: shown,
        second: first.place,
        other,
      });

      return;
    }

    for (let index = 0; index < given.length; index++) {
      const now = given[index];
      const before = first.args[index];
      const arg = rest[index];
      if (now == undefined || before == undefined || arg == undefined) {
        continue;
      }
      if (now.kind == TypeKind.Error || this.types.converts(now, before)) {
        continue;
      }

      this.errors.write(
        module,
        tree.exprOf(arg.exprId).loc,
        Code.EventEmittedType,
        {
          word: event,
          first: shown,
          second: first.place,
          other: this.types.typeText(now),
        },
      );

      return;
    }
  }

  private readonly emittedText(args: Read<Type[]>): string {
    const parts = args.map((one) => this.types.typeText(one));

    return `[${parts.join(", ")}]`;
  }

  private readonly countMark(count: int): string {
    if (count == 1) {
      return "";
    }

    return "s";
  }

  private readonly placeText(module: int, loc: int): string {
    const opened = this.types.program.modules[module];
    if (opened == undefined) {
      return "";
    }

    const lines = new SourceLines(opened.source.text);
    const place = lines.placeOf(loc);
    const path = opened.source.path.replaceAll("\\", "/");
    const file = path.slice(path.lastIndexOf("/") + 1);

    return `${file}:${place.line}:${place.column}`;
  }

  private unemittedListensCheck(module: int): void {
    if (this.eventMarks.looseEmitModules.size > 0) {
      return;
    }

    for (const listen of this.eventMarks.listens) {
      if (listen.module != module) {
        continue;
      }

      const names = this.eventMarks.emittedNames.get(listen.key)?.slice() ?? [];
      if (names.includes(listen.event)) {
        continue;
      }

      const error = this.types.notEmittedError(
        listen.loc,
        names,
        listen.event,
      );

      this.errors.writeFound(module, error);
    }
  }
}
