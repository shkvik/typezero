import { Code } from "../../../../../diagnostic/code.tz";
import { ClassDecl } from "../../../../../program/ast/types/ast.types.classes.tz";
import {
  CallArgument,
  CallExpr,
  Expr,
  ExprKind,
  FunctionExpr,
  MemberExpr,
  NewExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  FunctionParameter,
  InstanceType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import { kNoPlace } from "../../../../code/expression-types/const/expression-types.const.tz";
import {
  kEmitName,
  kListenerQueries,
  kEmitterBaseName,
  kEmitterName,
  kEventsModule,
  kThisParam,
  kEventTargetName,
  kWebModule,
  kEventName,
  kTargetListenerMethods,
  kDataEvent,
  kStreamEmitterName,
  kStreamModule,
  kErrorEvent,
  kOffName,
  kRemoveListenerName,
} from "../../../event-rules/const/event-rules.const.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";

partial class ExpressionTypes {
  private emitterMapCheck(expr: NewExpr, made: Type, module: int): void {
    const events = this.eventMapOf(made);
    if (events == undefined || this.modules.isLibraryModule(module)) {
      return;
    }

    this.reportFound(module, this.events.mapError(expr.loc, events));
  }

  private emitterCall(
    expr: CallExpr,
    member: MemberExpr,
    instance: InstanceType,
    module: int,
  ): Type | undefined {
    const isListening = this.events.isListenerMethod(member.name);
    const isEmitting = member.name == kEmitName;
    const isQuery = kListenerQueries.includes(member.name);
    if (!isListening && !isEmitting && !isQuery) {
      return undefined;
    }
    if (!this.isEmitter(instance) || this.modules.isLibraryModule(module)) {
      return undefined;
    }
    if (!this.isPlainEmitter(instance)) {
      return undefined;
    }
    if (member.typeArgs.length > 0) {
      this.report(module, member.loc, Code.EmitTypeArgs, { word: member.name });
    }
    if (isListening) {
      this.listenerLife(expr, member, module);
      this.noteErrorPending(expr, member, instance, module);
    }

    const events = this.eventMapOf(instance);
    if (events == undefined) {
      this.noteErrorEvent(expr, member, isEmitting, module);

      return this.inferredCall(expr, member, instance, module);
    }

    const args = this.encodedArgs(
      expr,
      member,
      this.eventArgsOf(expr, member, events, module),
      module,
    );

    this.noteErrorEvent(expr, member, isEmitting, module);
    this.noteStreamListened(member, isListening, module);
    if (isEmitting) {
      return this.emitChecked(expr, args, module);
    }
    if (isQuery) {
      return this.listenersOf(args);
    }

    this.listenerChecked(expr, instance, args, module);

    return instance;
  }

  private eventArgsOf(
    expr: CallExpr,
    member: MemberExpr,
    events: Type | undefined,
    module: int,
  ): Type | undefined {
    const name = expr.args[0]?.expr;
    if (name == undefined) {
      return undefined;
    }

    const text = this.store.plain(TypeKind.String);

    this.checked(name, text, module, kNoPlace);

    if (events == undefined) {
      return undefined;
    }
    if (events.kind == TypeKind.Dict) {
      return events.value;
    }

    const key = this.constantKey(name, module);
    if (key == undefined) {
      this.report(module, name.loc, Code.EventNameUnknown, {
        word: member.name,
      });

      return undefined;
    }

    const args = this.events.eventArgs(events, key);
    if (args == undefined) {
      this.reportFound(module, this.events.noEventError(name.loc, events, key));
    }

    return args;
  }

  private listenersOf(args: Type | undefined): Type {
    const nothing = this.store.plain(TypeKind.Void);
    if (args == undefined) {
      const unknown = this.store.plain(TypeKind.Error);

      return this.store.arrayOf(unknown);
    }

    const listener = this.events.listenerType(args, nothing, undefined);

    return this.store.arrayOf(listener);
  }

  private emitChecked(
    expr: CallExpr,
    args: Type | undefined,
    module: int,
  ): Type {
    const given = expr.args.slice(1);
    const boolean = this.store.plain(TypeKind.Boolean);
    if (args == undefined || args.kind != TypeKind.Tuple) {
      this.looseArguments(given, module);

      return boolean;
    }

    const name = expr.args[0]?.expr;
    const event = this.constantKey(name ?? expr.callee, module) ?? "";
    const isFitting =
      given.length >= args.required &&
      (args.rest >= 0 || given.length <= args.items.length);
    if (!isFitting && args.items.length == 1 && given.length > 1) {
      this.report(module, expr.loc, Code.EmitOneValue, { word: event });
      this.looseArguments(given, module);

      return boolean;
    }
    if (!isFitting) {
      const most = args.items.length;
      const wanted = this.calls.argumentCountText(args.required, most, false);
      const error = this.events.arityError(
        expr.loc,
        event,
        args,
        wanted,
        given.length,
      );

      this.reportFound(module, error);
      this.looseArguments(given, module);

      return boolean;
    }

    this.emittedChecked(given, args, module);

    return boolean;
  }

  private emittedChecked(given: CallArgument[], args: Type, module: int): void {
    if (args.kind != TypeKind.Tuple) {
      return;
    }

    for (let index = 0; index < given.length; index++) {
      const arg = given[index];
      const item = args.items[index] ?? args.items[args.items.length - 1];
      if (arg == undefined || item == undefined) {
        continue;
      }

      this.checked(arg.expr, item, module, kNoPlace);
    }
  }

  private listenerChecked(
    expr: CallExpr,
    instance: InstanceType,
    args: Type | undefined,
    module: int,
  ): void {
    const listener = expr.args[1]?.expr;
    const rest = expr.args.slice(2);
    if (listener == undefined) {
      return this.looseArguments(rest, module);
    }
    if (args == undefined || args.kind != TypeKind.Tuple) {
      this.listenerLoose(listener, module);

      return this.looseArguments(rest, module);
    }

    const name = expr.args[0]?.expr;
    const event = this.constantKey(name ?? expr.callee, module) ?? "";

    if (listener.kind == ExprKind.Function) {
      this.listenerLiteral(listener, instance, args, module);
    } else {
      this.listenerValue(listener, event, args, module);
    }

    this.looseArguments(rest, module);
  }

  private listenerLoose(listener: Expr, module: int): void {
    if (listener.kind != ExprKind.Function) {
      this.typed(listener, undefined, module);

      return;
    }

    const params = listener.fn.params.map(() => ({
      type: this.store.plain(TypeKind.Error),
      optional: false,
    }));
    const result = this.store.plain(TypeKind.Void);
    const wanted = this.store.functionOf({ params, rest: false, result });

    this.typed(listener, wanted, module);
  }

  private listenerLiteral(
    listener: FunctionExpr,
    instance: InstanceType,
    args: Type,
    module: int,
  ): void {
    const fn = listener.fn;
    const first = fn.params[0];
    if (first != undefined && first.name == kThisParam) {
      if (fn.isAsync) {
        this.reportFound(module, this.events.asyncThisError(listener.loc));

        return;
      }

      const self = this.peekType(listener, module);
      const own = this.listenerSelf(self);
      if (own != undefined && !this.relation.converts(instance, own)) {
        const error = this.events.thisTypeError(listener.loc, own, instance);

        this.reportFound(module, error);

        return;
      }
    }

    const result = this.listenerResult(fn.isAsync);
    const self = this.listenerReceiver(fn.params[0]?.name, instance);
    const wanted = this.events.listenerType(args, result, self);

    this.checked(listener, wanted, module, kNoPlace);
  }

  private listenerReceiver(
    first: string | undefined,
    instance: InstanceType,
  ): Type | undefined {
    if (first == kThisParam) {
      return instance;
    }

    return undefined;
  }

  private listenerSelf(type: Type): Type | undefined {
    if (type.kind != TypeKind.Function) {
      return undefined;
    }

    return type.shape.self;
  }

  private listenerResult(isAsync: boolean): Type {
    const nothing = this.store.plain(TypeKind.Void);
    if (isAsync) {
      return this.store.promiseOf(nothing);
    }

    return nothing;
  }

  private listenerValue(
    listener: Expr,
    event: string,
    args: Type,
    module: int,
  ): void {
    const given = this.typed(listener, undefined, module);
    if (given.kind == TypeKind.Error) {
      return;
    }
    if (given.kind != TypeKind.Function) {
      return this.reportFound(
        module,
        this.events.notFunctionError(listener.loc, given),
      );
    }

    const result = given.shape.result;
    const isDropped =
      result.kind == TypeKind.Promise && result.value.kind != TypeKind.Void;
    if (isDropped) {
      return this.reportFound(
        module,
        this.events.asyncResultError(listener.loc, result),
      );
    }

    const nothing = this.store.plain(TypeKind.Void);
    const wanted = this.events.listenerType(args, nothing, undefined);
    const isFitting =
      this.relation.converts(given, wanted) ||
      this.functions.isFunctionAdapting(listener, given, wanted, module);
    if (!isFitting) {
      const error = this.events.getsError(listener.loc, event, args, given);

      this.reportFound(module, error);
    }
  }

  private emitterMethodValueCheck(
    expr: MemberExpr,
    object: Type,
    module: int,
  ): boolean {
    const isMethod =
      this.events.isListenerMethod(expr.name) || expr.name == kEmitName;
    if (!isMethod || object.kind != TypeKind.Instance) {
      return false;
    }
    if (!this.isEmitter(object) || this.modules.isLibraryModule(module)) {
      return false;
    }

    this.report(module, expr.loc, Code.EmitterMethodValue, { word: expr.name });

    return true;
  }

  private emitterNew(
    expr: NewExpr,
    decl: ClassDecl,
    home: int,
    module: int,
  ): Type | undefined {
    const isEmitter =
      decl.name == kEmitterName &&
      this.program.modules[home]?.name == kEventsModule;
    if (!isEmitter || expr.typeArgs.length > 0) {
      return undefined;
    }

    const unknown = this.store.plain(TypeKind.Error);
    const instance = this.resolver.classInstance(home, decl, [unknown]);
    if (instance.kind != TypeKind.Instance) {
      return undefined;
    }

    return this.constructed(expr, instance, decl, module);
  }

  private isPlainEmitter(type: Type): boolean {
    return this.types
      .ancestorsOf(type)
      .some(
        (one) =>
          this.isEventsClass(one, kEmitterName) || this.isStreamEmitter(one),
      );
  }

  private isStreamEmitter(type: Type): boolean {
    if (type.kind != TypeKind.Instance || type.name != kStreamEmitterName) {
      return false;
    }

    return this.program.modules[type.module]?.name == kStreamModule;
  }

  private isEmitter(type: Type): boolean {
    return this.types
      .ancestorsOf(type)
      .some((one) => this.isEventsClass(one, kEmitterBaseName));
  }

  private eventMapOf(type: Type): Type | undefined {
    for (const one of this.types.ancestorsOf(type)) {
      const isMap =
        one.kind == TypeKind.Instance &&
        (this.isEventsClass(one, kEmitterName) || this.isStreamEmitter(one));
      if (isMap && one.kind == TypeKind.Instance) {
        return this.knownMap(one.args[0]);
      }
    }

    return undefined;
  }

  private knownMap(events: Type | undefined): Type | undefined {
    if (events == undefined || events.kind == TypeKind.Error) {
      return undefined;
    }

    return events;
  }

  private isEventsClass(type: Type, name: string): boolean {
    if (type.kind != TypeKind.Instance || type.name != name) {
      return false;
    }

    return this.program.modules[type.module]?.name == kEventsModule;
  }

  private encodedArgs(
    expr: CallExpr,
    member: MemberExpr,
    args: Type | undefined,
    module: int,
  ): Type | undefined {
    const name = expr.args[0]?.expr;
    const key = this.emitterKey(member.object, module);
    const isData =
      name != undefined && this.constantKey(name, module) == kDataEvent;
    if (
      !isData ||
      key == undefined ||
      !this.eventMarks.encodedStreams.has(key)
    ) {
      return args;
    }

    const text = this.store.plain(TypeKind.String);

    return this.store.tupleOf({
      items: [text],
      readonly: false,
      required: 1,
      rest: -1,
    });
  }

  private isWebClass(type: Type, name: string): boolean {
    if (type.kind != TypeKind.Instance || type.name != name) {
      return false;
    }

    return this.program.modules[type.module]?.name == kWebModule;
  }

  private targetCall(
    expr: CallExpr,
    member: MemberExpr,
    instance: InstanceType,
    module: int,
  ): Type | undefined {
    const isListening = kTargetListenerMethods.includes(member.name);
    const isTarget = this.types
      .ancestorsOf(instance)
      .some((one) => this.isWebClass(one, kEventTargetName));
    if (!isListening || !isTarget) {
      return undefined;
    }

    const name = expr.args[0]?.expr;
    const listener = expr.args[1]?.expr;
    const text = this.store.plain(TypeKind.String);

    if (name != undefined) {
      this.checked(name, text, module, kNoPlace);
    }
    if (listener != undefined) {
      this.targetListenerCheck(listener, instance.module, module);
    }

    this.looseArguments(expr.args.slice(2), module);

    return this.store.plain(TypeKind.Undefined);
  }

  private targetListenerCheck(listener: Expr, home: int, module: int): void {
    const event = this.webEventType(home);
    if (event == undefined) {
      this.typed(listener, undefined, module);

      return;
    }

    const isWritten =
      listener.kind == ExprKind.Function &&
      listener.fn.params.some((param) => param.type != undefined);
    if (listener.kind == ExprKind.Function && !isWritten) {
      const result = this.listenerResult(listener.fn.isAsync);
      const params: FunctionParameter[] = listener.fn.params.map(() => ({
        type: event,
        optional: false,
      }));
      const wanted = this.store.functionOf({ params, rest: false, result });

      this.typed(listener, wanted, module);

      return;
    }

    const given = this.typed(listener, undefined, module);
    if (given.kind != TypeKind.Function) {
      return;
    }

    const first = given.shape.params[0]?.type;
    if (first == undefined || this.isEventKind(first, event)) {
      return;
    }

    this.report(module, listener.loc, Code.TargetListenerEvent, {
      first: this.text.of(first),
    });
  }

  private isEventKind(type: Type, event: Type): boolean {
    if (type.kind == TypeKind.Error) {
      return true;
    }

    return this.types.ancestorsOf(type).some((one) => one == event);
  }

  private webEventType(home: int): Type | undefined {
    const classes = this.record(home)?.classes;
    if (classes == undefined) {
      return undefined;
    }

    for (const decl of classes.values()) {
      if (decl.name == kEventName) {
        return this.resolver.classInstance(home, decl, []);
      }
    }

    return undefined;
  }

  private noteErrorEvent(
    expr: CallExpr,
    member: MemberExpr,
    isEmitting: boolean,
    module: int,
  ): void {
    const name = expr.args[0]?.expr;
    const isError =
      name != undefined && this.constantKey(name, module) == kErrorEvent;
    const key = this.emitterKey(member.object, module);
    if (!isError || key == undefined) {
      return;
    }
    if (isEmitting) {
      this.eventMarks.errorEmits.push({ key, loc: member.loc, module });

      return;
    }
    if (member.name != kOffName && member.name != kRemoveListenerName) {
      this.eventMarks.errorListened.add(key);
    }
  }

  private emitterKey(object: Expr, module: int): string | undefined {
    if (object.kind != ExprKind.Name) {
      return undefined;
    }

    const target = this.targetOfName(object, module);
    if (target == undefined) {
      return undefined;
    }

    return `${target.module} ${target.loc}`;
  }

  private unheardErrorsCheck(module: int): void {
    for (const emit of this.eventMarks.errorEmits) {
      const isHeard = this.eventMarks.errorListened.has(emit.key);
      if (emit.module == module && !isHeard) {
        this.report(module, emit.loc, Code.EventErrorUnheard, kNoDetails);
      }
    }
  }
}
