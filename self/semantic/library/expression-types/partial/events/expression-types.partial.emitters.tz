import { Code } from "../../../../../diagnostic/code.tz";
import { ClassDecl } from "../../../../../program/ast/types/ast.types.classes.tz";
import {
  CallArgument,
  CallExpr,
  Expr,
  ExprKind,
  FunctionExpr,
  MemberExpr,
  NewExpr,
} from "../../../../../program/ast/types/ast.types.expressions.tz";
import {
  FunctionParameter,
  InstanceType,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../../../code/expression-types/expression-types.tz";
import { kNoPlace } from "../../../../code/expression-types/const/expression-types.const.tz";
import {
  kEmitName,
  kListenerQueries,
  kEmitterBaseName,
  kEmitterName,
  kEventsModule,
  kThisParam,
  kEventTargetName,
  kWebModule,
  kEventName,
  kTargetListenerMethods,
  kDataEvent,
  kStreamEmitterName,
  kStreamModule,
  kErrorEvent,
  kOffName,
  kRemoveListenerName,
} from "../../../event-rules/const/event-rules.const.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";

partial class ExpressionTypes {
  private emitterMapCheck(expr: NewExpr, made: Type, module: int): void {
    const events = this.eventMapOf(made);
    if (events == undefined || this.types.isLibraryModule(module)) {
      return;
    }

    this.errors.writeFound(module, this.types.mapError(expr.loc, events));
  }

  private emitterCall(
    expr: CallExpr,
    member: MemberExpr,
    instance: InstanceType,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const isListening = this.types.isListenerMethod(member.name);
    const isEmitting = member.name == kEmitName;
    const isQuery = kListenerQueries.includes(member.name);
    if (!isListening && !isEmitting && !isQuery) {
      return undefined;
    }
    if (!this.isEmitter(instance) || this.types.isLibraryModule(module)) {
      return undefined;
    }
    if (!this.isPlainEmitter(instance)) {
      return undefined;
    }
    const typeArgs = tree.typeRefsOf(member.typeArgsList);
    if (typeArgs.length > 0) {
      this.errors.write(module, member.loc, Code.EmitTypeArgs, {
        word: member.name,
      });
    }
    if (isListening) {
      this.listenerLife(expr, member, module);
      this.noteErrorPending(expr, member, instance, module);
    }

    const events = this.eventMapOf(instance);
    if (events == undefined) {
      this.noteErrorEvent(expr, member, isEmitting, module);

      return this.inferredCall(expr, member, instance, module);
    }

    const args = this.encodedArgs(
      expr,
      member,
      this.eventArgsOf(expr, member, events, module),
      module,
    );

    this.noteErrorEvent(expr, member, isEmitting, module);
    this.noteStreamListened(member, isListening, module);
    if (isEmitting) {
      return this.emitChecked(expr, args, module);
    }
    if (isQuery) {
      return this.listenersOf(args);
    }

    this.listenerChecked(expr, instance, args, module);

    return instance;
  }

  private eventArgsOf(
    expr: CallExpr,
    member: MemberExpr,
    events: Type | undefined,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const name = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (name == undefined) {
      return undefined;
    }

    const text = this.types.store.plain(TypeKind.String);

    this.checked(name, text, module, kNoPlace);

    if (events == undefined) {
      return undefined;
    }
    if (events.kind == TypeKind.Dict) {
      return this.types.store.valueOf(events);
    }

    const key = this.constantKey(name, module);
    if (key == undefined) {
      this.errors.write(module, name.loc, Code.EventNameUnknown, {
        word: member.name,
      });

      return undefined;
    }

    const args = this.types.eventArgs(events, key);
    if (args == undefined) {
      this.errors.writeFound(
        module,
        this.types.noEventError(name.loc, events, key),
      );
    }

    return args;
  }

  private listenersOf(args: Type | undefined): Type {
    const nothing = this.types.store.plain(TypeKind.Void);
    if (args == undefined) {
      const unknown = this.types.store.plain(TypeKind.Error);

      return this.types.store.arrayOf(unknown);
    }

    const listener = this.types.listenerType(args, nothing, undefined);

    return this.types.store.arrayOf(listener);
  }

  private emitChecked(
    expr: CallExpr,
    args: Type | undefined,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const given = tree.argumentsOf(expr.argsList).slice(1);
    const boolean = this.types.store.plain(TypeKind.Boolean);
    if (args == undefined || args.kind != TypeKind.Tuple) {
      this.looseArguments(given, module);

      return boolean;
    }

    const name = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    const event =
      this.constantKey(name ?? tree.exprOf(expr.calleeId), module) ?? "";
    const isFitting =
      given.length >= args.required &&
      (args.rest >= 0 || given.length <= this.types.store.itemsOf(args).length);
    if (
      !isFitting &&
      this.types.store.itemsOf(args).length == 1 &&
      given.length > 1
    ) {
      this.errors.write(module, expr.loc, Code.EmitOneValue, { word: event });
      this.looseArguments(given, module);

      return boolean;
    }
    if (!isFitting) {
      const most = this.types.store.itemsOf(args).length;
      const wanted = this.types.argumentCountText(args.required, most, false);
      const error = this.types.arityError(
        expr.loc,
        event,
        args,
        wanted,
        given.length,
      );

      this.errors.writeFound(module, error);
      this.looseArguments(given, module);

      return boolean;
    }

    this.emittedChecked(given, args, module);

    return boolean;
  }

  private emittedChecked(
    given: Read<CallArgument[]>,
    args: Type,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    if (args.kind != TypeKind.Tuple) {
      return;
    }

    for (let index = 0; index < given.length; index++) {
      const arg = given[index];
      const item =
        this.types.store.itemsOf(args)[index] ??
        this.types.store.itemsOf(args)[
          this.types.store.itemsOf(args).length - 1
        ];
      if (arg == undefined || item == undefined) {
        continue;
      }

      const expr = tree.exprOf(arg.exprId);

      this.checked(expr, item, module, kNoPlace);
    }
  }

  private listenerChecked(
    expr: CallExpr,
    instance: InstanceType,
    args: Type | undefined,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const listener = tree.exprAt(tree.argumentsOf(expr.argsList)[1]?.exprId);
    const rest = tree.argumentsOf(expr.argsList).slice(2);
    if (listener == undefined) {
      return this.looseArguments(rest, module);
    }
    if (args == undefined || args.kind != TypeKind.Tuple) {
      this.listenerLoose(listener, module);

      return this.looseArguments(rest, module);
    }

    const name = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    const event =
      this.constantKey(name ?? tree.exprOf(expr.calleeId), module) ?? "";

    if (listener.kind == ExprKind.Function) {
      this.listenerLiteral(listener, instance, args, module);
    } else {
      this.listenerValue(listener, event, args, module);
    }

    this.looseArguments(rest, module);
  }

  private listenerLoose(listener: Expr, module: int): void {
    const tree = this.types.program.tree;

    if (listener.kind != ExprKind.Function) {
      this.typed(listener, undefined, module);

      return;
    }

    const params = tree
      .paramsOf(tree.functionOf(listener.fnId).paramsList)
      .map(() => ({
        type: this.types.store.plain(TypeKind.Error),
        optional: false,
      }));
    const result = this.types.store.plain(TypeKind.Void);
    const wanted = this.types.store.functionOf({ params, rest: false, result });

    this.typed(listener, wanted, module);
  }

  private listenerLiteral(
    listener: FunctionExpr,
    instance: InstanceType,
    args: Type,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const fn = tree.functionOf(listener.fnId);
    const first = tree.paramsOf(fn.paramsList)[0];
    if (first != undefined && first.name == kThisParam) {
      if (fn.isAsync) {
        this.errors.writeFound(module, this.types.asyncThisError(listener.loc));

        return;
      }

      const self = this.peekType(listener, module);
      const own = this.listenerSelf(self);
      if (own != undefined && !this.types.converts(instance, own)) {
        const error = this.types.thisTypeError(listener.loc, own, instance);

        this.errors.writeFound(module, error);

        return;
      }
    }

    const result = this.listenerResult(fn.isAsync);
    const self = this.listenerReceiver(
      tree.paramsOf(fn.paramsList)[0]?.name,
      instance,
    );
    const wanted = this.types.listenerType(args, result, self);

    this.checked(listener, wanted, module, kNoPlace);
  }

  private readonly listenerReceiver(
    first: string | undefined,
    instance: InstanceType,
  ): Type | undefined {
    if (first == kThisParam) {
      return instance;
    }

    return undefined;
  }

  private readonly listenerSelf(type: Type): Type | undefined {
    if (type.kind != TypeKind.Function) {
      return undefined;
    }

    return this.types.store.selfTypeOf(type);
  }

  private listenerResult(isAsync: boolean): Type {
    const nothing = this.types.store.plain(TypeKind.Void);
    if (isAsync) {
      return this.types.store.promiseOf(nothing);
    }

    return nothing;
  }

  private listenerValue(
    listener: Expr,
    event: string,
    args: Type,
    module: int,
  ): void {
    const given = this.typed(listener, undefined, module);
    if (given.kind == TypeKind.Error) {
      return;
    }
    if (given.kind != TypeKind.Function) {
      return this.errors.writeFound(
        module,
        this.types.notFunctionError(listener.loc, given),
      );
    }

    const result = this.types.store.returnTypeOf(given);
    const isDropped =
      result.kind == TypeKind.Promise &&
      this.types.store.valueOf(result).kind != TypeKind.Void;
    if (isDropped) {
      return this.errors.writeFound(
        module,
        this.types.asyncResultError(listener.loc, result),
      );
    }

    const nothing = this.types.store.plain(TypeKind.Void);
    const wanted = this.types.listenerType(args, nothing, undefined);
    const isFitting =
      this.types.converts(given, wanted) ||
      this.types.isFunctionAdapting(listener, given, wanted, module);
    if (!isFitting) {
      const error = this.types.getsError(listener.loc, event, args, given);

      this.errors.writeFound(module, error);
    }
  }

  private emitterMethodValueCheck(
    expr: MemberExpr,
    object: Type,
    module: int,
  ): boolean {
    const isMethod =
      this.types.isListenerMethod(expr.name) || expr.name == kEmitName;
    if (!isMethod || object.kind != TypeKind.Instance) {
      return false;
    }
    if (!this.isEmitter(object) || this.types.isLibraryModule(module)) {
      return false;
    }

    this.errors.write(module, expr.loc, Code.EmitterMethodValue, {
      word: expr.name,
    });

    return true;
  }

  private emitterNew(
    expr: NewExpr,
    decl: ClassDecl,
    home: int,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const isEmitter =
      decl.name == kEmitterName &&
      this.types.program.modules[home]?.name == kEventsModule;
    if (!isEmitter || tree.typeRefsOf(expr.typeArgsList).length > 0) {
      return undefined;
    }

    const unknown = this.types.store.plain(TypeKind.Error);
    const instance = this.types.classInstance(home, decl, [unknown]);
    if (instance.kind != TypeKind.Instance) {
      return undefined;
    }

    return this.constructed(expr, instance, decl, module);
  }

  private readonly isPlainEmitter(type: Type): boolean {
    return this.types
      .ancestorsOf(type)
      .some(
        (one) =>
          this.isEventsClass(one, kEmitterName) || this.isStreamEmitter(one),
      );
  }

  private readonly isStreamEmitter(type: Type): boolean {
    if (type.kind != TypeKind.Instance || type.name != kStreamEmitterName) {
      return false;
    }

    return this.types.program.modules[type.module]?.name == kStreamModule;
  }

  private readonly isEmitter(type: Type): boolean {
    return this.types
      .ancestorsOf(type)
      .some((one) => this.isEventsClass(one, kEmitterBaseName));
  }

  private readonly eventMapOf(type: Type): Type | undefined {
    for (const one of this.types.ancestorsOf(type)) {
      const isMap =
        one.kind == TypeKind.Instance &&
        (this.isEventsClass(one, kEmitterName) || this.isStreamEmitter(one));
      if (isMap && one.kind == TypeKind.Instance) {
        return this.knownMap(this.types.store.argsOf(one)[0]);
      }
    }

    return undefined;
  }

  private readonly knownMap(events: Type | undefined): Type | undefined {
    if (events == undefined || events.kind == TypeKind.Error) {
      return undefined;
    }

    return events;
  }

  private readonly isEventsClass(type: Type, name: string): boolean {
    if (type.kind != TypeKind.Instance || type.name != name) {
      return false;
    }

    return this.types.program.modules[type.module]?.name == kEventsModule;
  }

  private encodedArgs(
    expr: CallExpr,
    member: MemberExpr,
    args: Type | undefined,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const name = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    const object = tree.exprOf(member.objectId);
    const key = this.emitterKey(object, module);
    const isData =
      name != undefined && this.constantKey(name, module) == kDataEvent;
    if (
      !isData ||
      key == undefined ||
      !this.eventMarks.encodedStreams.has(key)
    ) {
      return args;
    }

    const text = this.types.store.plain(TypeKind.String);

    return this.types.store.tupleOf({
      items: [text],
      readonly: false,
      required: 1,
      rest: -1,
    });
  }

  private readonly isWebClass(type: Type, name: string): boolean {
    if (type.kind != TypeKind.Instance || type.name != name) {
      return false;
    }

    return this.types.program.modules[type.module]?.name == kWebModule;
  }

  private targetCall(
    expr: CallExpr,
    member: MemberExpr,
    instance: InstanceType,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const isListening = kTargetListenerMethods.includes(member.name);
    const isTarget = this.types
      .ancestorsOf(instance)
      .some((one) => this.isWebClass(one, kEventTargetName));
    if (!isListening || !isTarget) {
      return undefined;
    }

    const name = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    const listener = tree.exprAt(tree.argumentsOf(expr.argsList)[1]?.exprId);
    const text = this.types.store.plain(TypeKind.String);

    if (name != undefined) {
      this.checked(name, text, module, kNoPlace);
    }
    if (listener != undefined) {
      this.targetListenerCheck(listener, instance.module, module);
    }

    const args = tree.argumentsOf(expr.argsList);

    this.looseArguments(args.slice(2), module);

    return this.types.store.plain(TypeKind.Undefined);
  }

  private targetListenerCheck(listener: Expr, home: int, module: int): void {
    const tree = this.types.program.tree;

    const event = this.webEventType(home);
    if (event == undefined) {
      this.typed(listener, undefined, module);

      return;
    }

    const isWritten =
      listener.kind == ExprKind.Function &&
      tree
        .paramsOf(tree.functionOf(listener.fnId).paramsList)
        .some((param) => tree.typeRefAt(param.typeId) != undefined);
    if (listener.kind == ExprKind.Function && !isWritten) {
      const result = this.listenerResult(
        tree.functionOf(listener.fnId).isAsync,
      );
      const params: FunctionParameter[] = tree
        .paramsOf(tree.functionOf(listener.fnId).paramsList)
        .map(() => ({
          type: event,
          optional: false,
        }));
      const wanted = this.types.store.functionOf({
        params,
        rest: false,
        result,
      });

      this.typed(listener, wanted, module);

      return;
    }

    const given = this.typed(listener, undefined, module);
    if (given.kind != TypeKind.Function) {
      return;
    }

    const first = this.types.store.paramsOf(given)[0]?.type;
    if (first == undefined || this.isEventKind(first, event)) {
      return;
    }

    this.errors.write(module, listener.loc, Code.TargetListenerEvent, {
      first: this.types.typeText(first),
    });
  }

  private readonly isEventKind(type: Type, event: Type): boolean {
    if (type.kind == TypeKind.Error) {
      return true;
    }

    return this.types.ancestorsOf(type).some((one) => one.id == event.id);
  }

  private webEventType(home: int): Type | undefined {
    const classes = this.records.get(home)?.classes;
    if (classes == undefined) {
      return undefined;
    }

    for (const decl of classes.values()) {
      if (decl.name == kEventName) {
        return this.types.classInstance(home, decl, []);
      }
    }

    return undefined;
  }

  private noteErrorEvent(
    expr: CallExpr,
    member: MemberExpr,
    isEmitting: boolean,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const name = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    const isError =
      name != undefined && this.constantKey(name, module) == kErrorEvent;
    const object = tree.exprOf(member.objectId);
    const key = this.emitterKey(object, module);
    if (!isError || key == undefined) {
      return;
    }
    if (isEmitting) {
      this.eventMarks.errorEmits.push({ key, loc: member.loc, module });

      return;
    }
    if (member.name != kOffName && member.name != kRemoveListenerName) {
      this.eventMarks.errorListened.add(key);
    }
  }

  private readonly emitterKey(object: Expr, module: int): string | undefined {
    if (object.kind != ExprKind.Name) {
      return undefined;
    }

    const target = this.targetOfName(object, module);
    if (target == undefined) {
      return undefined;
    }

    return `${target.module} ${target.loc}`;
  }

  private unheardErrorsCheck(module: int): void {
    for (const emit of this.eventMarks.errorEmits) {
      const isHeard = this.eventMarks.errorListened.has(emit.key);
      if (emit.module == module && !isHeard) {
        this.errors.write(module, emit.loc, Code.EventErrorUnheard, kNoDetails);
      }
    }
  }
}
