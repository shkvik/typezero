import "./partial/regex-syntax.partial.escapes.tz";
import "./partial/regex-syntax.partial.classes.tz";
import "./partial/regex-syntax.partial.quantifiers.tz";
import { RegexCursor } from "../regex-cursor/regex-cursor.tz";
import {
  kBackslashEndText,
  kDecimalBase,
  kDuplicateNameText,
  kEscapeText,
  kInvalidFlagGroupText,
  kInvalidGroupText,
  kInvalidQuantifierText,
  kLoneBracketsText,
  kMaxCaptures,
  kMaxDepth,
  kModifierFlags,
  kMultipleDashesText,
  kNamedReferenceText,
  kNegatedProperty,
  kNoSuchGroupText,
  kNothingToRepeatText,
  kPropertyEscapes,
  kPropertyFlagText,
  kRepeatedFlagText,
  kTooLargeText,
  kTooManyCapturesText,
  kUnknownNameText,
  kUnmatchedCloseText,
  kUnterminatedGroupText,
} from "./const/regex-syntax.const.tz";
import {
  RegexGroupEnd,
  RegexNamedReference,
  RegexSyntaxError,
} from "./types/regex-syntax.types.tz";

export class RegexSyntax {
  private readonly cursor: RegexCursor;
  private readonly names: string[];
  private readonly paths: int[][];
  private readonly path: int[];
  private readonly open: int[];
  private readonly references: RegexNamedReference[];
  private captures: int;
  private totalCaptures: int;
  private disjunctions: int;

  public constructor(text: string, flags: string) {
    this.cursor = new RegexCursor(text, flags);
    this.names = [""];
    this.paths = [[]];
    this.path = [];
    this.open = [];
    this.references = [];
    this.captures = 0;
    this.totalCaptures = 0;
    this.disjunctions = 0;
  }

  public check(): RegexSyntaxError | undefined {
    this.scanCaptures();

    const isParsed = this.disjunction();
    if (isParsed && !this.cursor.isAtEnd()) {
      this.cursor.fail(this.leftoverText());
    }
    if (!this.cursor.isFailed()) {
      this.resolveNames();
    }
    if (!this.cursor.isFailed()) {
      return undefined;
    }

    return { message: this.cursor.error, at: this.cursor.errorAt };
  }

  private readonly leftoverText(): string {
    if (this.cursor.isAt(")")) {
      return kUnmatchedCloseText;
    }

    return kUnterminatedGroupText;
  }

  private scanCaptures(): void {
    const text = this.cursor.text;
    let depth = 0;
    let index = 0;

    while (index < text.length) {
      const char = this.cursor.charAt(index);
      if (char == "\\") {
        index += 2;

        continue;
      }
      if (char == "[" && (depth == 0 || this.cursor.isSets)) {
        depth += 1;
      }
      if (char == "]" && depth > 0) {
        depth -= 1;
      }
      if (char == "(" && depth == 0) {
        this.countGroupAt(index);
      }

      index += 1;
    }
  }

  private countGroupAt(index: int): void {
    if (this.cursor.charAt(index + 1) != "?") {
      this.totalCaptures += 1;

      return;
    }

    const third = this.cursor.charAt(index + 3);
    const isNamed =
      this.cursor.charAt(index + 2) == "<" && third != "=" && third != "!";
    if (isNamed) {
      this.totalCaptures += 1;
      this.cursor.hasNames = true;
    }
  }

  private disjunction(): boolean {
    const id = this.disjunctions;

    this.disjunctions += 1;
    this.path.push(id);
    this.path.push(0);

    if (!this.alternative()) {
      return false;
    }

    let branch = 1;

    while (this.cursor.accept("|")) {
      this.path.splice(this.path.length - 1, 1, branch);

      if (!this.alternative()) {
        return false;
      }

      branch += 1;
    }

    this.path.splice(this.path.length - 2, 2);

    return true;
  }

  private alternative(): boolean {
    let isMore = this.term();

    while (isMore) {
      isMore = this.term();
    }

    return !this.cursor.isFailed();
  }

  private term(): boolean {
    if (this.cursor.isAtEnd()) {
      return false;
    }

    const char = this.cursor.current();

    switch (char) {
      case "|":
      case ")":
        return false;
      case "^":
      case "$":
        this.cursor.index += 1;

        return this.unquantifiable(false);
      case "(":
        return this.groupTerm();
      case "[":
        return this.classTerm();
      case "\\":
        return this.escapeTerm();
      case "*":
      case "+":
      case "?":
        return this.cursor.fail(kNothingToRepeatText);
      case "{":
        return this.braceTerm();
      case "}":
      case "]":
        return this.bracketTerm();
      default:
        this.cursor.nextChar();

        return this.quantifier();
    }
  }

  private unquantifiable(isLook: boolean): boolean {
    if (!this.isQuantifierStart()) {
      return true;
    }
    if (isLook) {
      return this.cursor.fail(kInvalidQuantifierText);
    }

    return this.cursor.fail(kNothingToRepeatText);
  }

  private groupTerm(): boolean {
    this.cursor.index += 1;
    this.cursor.depth += 1;

    if (this.cursor.depth > kMaxDepth) {
      return this.cursor.fail(kTooLargeText);
    }

    const end = this.group();

    this.cursor.depth -= 1;

    switch (end) {
      case RegexGroupEnd.Failed:
        return false;
      case RegexGroupEnd.Fixed:
        return this.unquantifiable(true);
      default:
        return this.quantifier();
    }
  }

  private classTerm(): boolean {
    this.cursor.index += 1;

    const isFine = this.classFine();
    if (!isFine) {
      return false;
    }

    return this.quantifier();
  }

  private classFine(): boolean {
    if (this.cursor.isSets) {
      return this.setClass();
    }

    return this.legacyClass();
  }

  private braceTerm(): boolean {
    if (this.isQuantifierStart()) {
      return this.cursor.fail(kNothingToRepeatText);
    }
    if (this.cursor.isUnicode) {
      return this.cursor.fail(kLoneBracketsText);
    }

    this.cursor.index += 1;

    return this.quantifier();
  }

  private bracketTerm(): boolean {
    if (this.cursor.isUnicode) {
      return this.cursor.fail(kLoneBracketsText);
    }

    this.cursor.index += 1;

    return this.quantifier();
  }

  private group(): RegexGroupEnd {
    const at = this.cursor.index - 1;
    if (!this.cursor.accept("?")) {
      return this.captureGroup("", at);
    }

    const char = this.cursor.current();
    const isBehind =
      char == "<" && (this.cursor.isNextAt("=") || this.cursor.isNextAt("!"));
    if (char == "=" || char == "!") {
      this.cursor.index += 1;

      return this.lookGroup(false);
    }
    if (isBehind) {
      this.cursor.index += 2;

      return this.lookGroup(true);
    }
    if (char == "<") {
      this.cursor.index += 1;

      return this.namedGroup(at);
    }
    if (char != ":" && !this.modifiers()) {
      this.cursor.fail(kInvalidGroupText);

      return RegexGroupEnd.Failed;
    }

    this.cursor.accept(":");

    return this.closedGroup();
  }

  private captureGroup(name: string, at: int): RegexGroupEnd {
    this.captures += 1;

    if (this.captures > kMaxCaptures) {
      this.cursor.fail(kTooManyCapturesText);

      return RegexGroupEnd.Failed;
    }

    const path = this.path.slice();
    if (this.isDuplicateName(name, path)) {
      this.cursor.index = at;
      this.cursor.fail(kDuplicateNameText);

      return RegexGroupEnd.Failed;
    }

    this.names.push(name);
    this.paths.push(path);

    return this.openGroup(this.captures);
  }

  private namedGroup(at: int): RegexGroupEnd {
    if (this.captures + 1 > kMaxCaptures) {
      this.cursor.fail(kTooManyCapturesText);

      return RegexGroupEnd.Failed;
    }

    const name = this.groupName();
    if (name == undefined) {
      return RegexGroupEnd.Failed;
    }

    return this.captureGroup(name, at);
  }

  private openGroup(index: int): RegexGroupEnd {
    this.open.push(index);

    if (!this.disjunction()) {
      return RegexGroupEnd.Failed;
    }

    this.open.pop();

    return this.closedEnd(RegexGroupEnd.Quantifiable);
  }

  private lookGroup(isBehind: boolean): RegexGroupEnd {
    if (!this.disjunction()) {
      return RegexGroupEnd.Failed;
    }
    if (this.cursor.isUnicode || isBehind) {
      return this.closedEnd(RegexGroupEnd.Fixed);
    }

    return this.closedEnd(RegexGroupEnd.Quantifiable);
  }

  private closedGroup(): RegexGroupEnd {
    if (!this.disjunction()) {
      return RegexGroupEnd.Failed;
    }

    return this.closedEnd(RegexGroupEnd.Quantifiable);
  }

  private closedEnd(end: RegexGroupEnd): RegexGroupEnd {
    if (this.cursor.accept(")")) {
      return end;
    }

    this.cursor.fail(kUnterminatedGroupText);

    return RegexGroupEnd.Failed;
  }

  private modifiers(): boolean {
    let added = "";
    let removed = "";
    let hasDash = false;

    while (!this.cursor.accept(":")) {
      const char = this.cursor.current();
      if (char == "-") {
        if (hasDash) {
          return this.cursor.fail(kMultipleDashesText);
        }

        hasDash = true;
        this.cursor.index += 1;

        continue;
      }
      if (!kModifierFlags.includes(char)) {
        return this.cursor.fail(kInvalidGroupText);
      }
      if (added.includes(char) || removed.includes(char)) {
        return this.cursor.fail(kRepeatedFlagText);
      }

      if (hasDash) {
        removed += char;
      } else {
        added += char;
      }

      this.cursor.index += 1;
    }

    if (hasDash && removed == "" && added == "") {
      return this.cursor.fail(kInvalidFlagGroupText);
    }

    return true;
  }

  private readonly isDuplicateName(name: string, path: Read<int[]>): boolean {
    if (name == "") {
      return false;
    }

    for (let index = 1; index < this.names.length; index++) {
      const other = this.paths[index];
      const isSame = this.names[index] == name;
      if (other == undefined || !isSame) {
        continue;
      }
      if (this.mightBothParticipate(other, path)) {
        return true;
      }
    }

    return false;
  }

  private readonly mightBothParticipate(
    first: Read<int[]>,
    second: Read<int[]>,
  ): boolean {
    let index = 0;

    while (index + 1 < first.length && index + 1 < second.length) {
      if (this.stepAt(first, index) != this.stepAt(second, index)) {
        return true;
      }
      if (this.stepAt(first, index + 1) != this.stepAt(second, index + 1)) {
        return false;
      }

      index += 2;
    }

    return true;
  }

  private readonly stepAt(path: Read<int[]>, index: int): int {
    return path[index] ?? -1;
  }

  private escapeTerm(): boolean {
    const at = this.cursor.index;

    this.cursor.index += 1;

    if (this.cursor.isAtEnd()) {
      return this.cursor.fail(kBackslashEndText);
    }

    const char = this.cursor.current();
    const isNamed = this.cursor.isUnicode || this.cursor.hasNames;
    if (char == "b" || char == "B") {
      this.cursor.index += 1;

      return this.unquantifiable(false);
    }
    if (char >= "1" && char <= "9") {
      return this.numberedReference(at);
    }
    if (char == "k" && isNamed) {
      return this.namedReference(at);
    }
    if (this.isSetEscape(char)) {
      this.cursor.index += 1;

      return this.quantifier();
    }
    if (kPropertyEscapes.includes(char)) {
      return this.propertyTerm(char);
    }
    if (this.characterEscape(false) < 0) {
      return false;
    }

    return this.quantifier();
  }

  private propertyTerm(char: string): boolean {
    if (!this.cursor.isUnicode) {
      return this.cursor.fail(kPropertyFlagText);
    }

    this.cursor.index += 1;

    if (!this.propertyEscape(char == kNegatedProperty)) {
      return false;
    }

    return this.quantifier();
  }

  private numberedReference(at: int): boolean {
    const start = this.cursor.index;
    let number = 0;

    while (this.cursor.isDigitAt(this.cursor.index) && number <= kMaxCaptures) {
      const digit = this.cursor.digitAt(this.cursor.index);

      number = this.clamped(number * kDecimalBase + digit);
      this.cursor.index += 1;
    }

    if (number <= this.totalCaptures) {
      return this.quantifier();
    }

    this.cursor.index = start;

    if (this.cursor.isUnicode) {
      return this.cursor.fail(kEscapeText);
    }

    this.cursor.index = at;

    return this.cursor.fail(kNoSuchGroupText);
  }

  private namedReference(at: int): boolean {
    this.cursor.index += 1;

    if (!this.cursor.accept("<")) {
      return this.cursor.fail(kNamedReferenceText);
    }

    const name = this.groupName();
    if (name == undefined) {
      this.cursor.renameError(kNamedReferenceText);

      return false;
    }

    const isOpen = this.open.some((index) => this.names[index] == name);
    if (!isOpen) {
      this.references.push({ name, at });
    }

    return this.quantifier();
  }

  private resolveNames(): void {
    const known = this.names.slice(1);

    for (const reference of this.references) {
      if (!known.includes(reference.name)) {
        this.cursor.index = reference.at;
        this.cursor.fail(kUnknownNameText);

        return;
      }
    }
  }
}
