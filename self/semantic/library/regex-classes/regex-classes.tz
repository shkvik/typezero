import { RegexCursor } from "../regex-cursor/regex-cursor.tz";
import { RegexEscapes } from "../regex-escapes/regex-escapes.tz";
import {
  kBackslashEndText,
  kEscapeText,
  kIntersection,
  kInvalidClassText,
  kLetterKCode,
  kMaxDepth,
  kNegatedProperty,
  kNegatedStringsText,
  kNoUnit,
  kPropertyEscapes,
  kRangeOrderText,
  kReservedDoubles,
  kSetCharacterText,
  kSetOperationText,
  kSetSyntaxChars,
  kSubtraction,
  kTooLargeText,
  kTwoUnitsText,
  kUnterminatedClassText,
} from "../regex-syntax/const/regex-syntax.const.tz";
import { RegexClassAtom } from "../regex-syntax/types/regex-syntax.types.tz";

export class RegexClasses {
  private readonly cursor: RegexCursor;
  private readonly escapes: RegexEscapes;

  public constructor(cursor: RegexCursor, escapes: RegexEscapes) {
    this.cursor = cursor;
    this.escapes = escapes;
  }

  public legacyClass(): boolean {
    const cursor = this.cursor;
    let isAfterLead = false;

    cursor.accept("^");

    while (!cursor.accept("]")) {
      if (cursor.isAtEnd()) {
        return cursor.fail(kUnterminatedClassText);
      }

      const first = this.classAtom();
      if (first == undefined) {
        return false;
      }

      const isHalf =
        !cursor.isUnicode &&
        !first.isSet &&
        isAfterLead &&
        cursor.isTrail(first.char);
      if (isHalf) {
        return cursor.fail(kTwoUnitsText);
      }

      isAfterLead = !first.isSet && cursor.isLead(first.char);

      if (this.isRangeNext() && !this.isRangeFine(first)) {
        return false;
      }
    }

    return true;
  }

  public setClass(): boolean {
    return this.classContents() != undefined;
  }

  private isRangeNext(): boolean {
    const cursor = this.cursor;
    const next = cursor.index + 1;

    return (
      cursor.isAt("-") &&
      cursor.charAt(next) != "]" &&
      next < cursor.text.length
    );
  }

  private isRangeFine(first: RegexClassAtom): boolean {
    const cursor = this.cursor;

    cursor.index += 1;

    const last = this.classAtom();
    if (last == undefined) {
      return false;
    }
    if (first.isSet || last.isSet) {
      if (cursor.isUnicode) {
        return cursor.fail(kInvalidClassText);
      }

      return true;
    }
    if (first.char > last.char) {
      return cursor.fail(kRangeOrderText);
    }

    return true;
  }

  private classAtom(): RegexClassAtom | undefined {
    const cursor = this.cursor;
    if (cursor.isAtEnd()) {
      return this.failedAtom(kUnterminatedClassText);
    }
    if (!cursor.accept("\\")) {
      return { char: cursor.nextChar(), isSet: false };
    }
    if (cursor.isAtEnd()) {
      return this.failedAtom(kBackslashEndText);
    }

    const letter = cursor.current();
    if (this.escapes.isSetEscape(letter)) {
      cursor.index += 1;

      return { char: kNoUnit, isSet: true };
    }
    if (kPropertyEscapes.includes(letter) && cursor.isUnicode) {
      return this.propertyAtom(letter);
    }
    if (letter == "k" && !cursor.isUnicode && !cursor.hasNames) {
      cursor.index += 1;

      return { char: kLetterKCode, isSet: false };
    }

    const value = this.escapes.characterEscape(true);
    if (value == kNoUnit) {
      return undefined;
    }

    return { char: value, isSet: false };
  }

  private propertyAtom(letter: string): RegexClassAtom | undefined {
    this.cursor.index += 1;

    const isNegated = letter == kNegatedProperty;
    if (!this.escapes.propertyEscape(isNegated)) {
      return undefined;
    }

    return { char: kNoUnit, isSet: true };
  }

  private failedAtom(message: string): RegexClassAtom | undefined {
    this.cursor.fail(message);

    return undefined;
  }

  private classContents(): Set<string> | undefined {
    const cursor = this.cursor;
    const isNegated = cursor.accept("^");
    const strings = new Set<string>();

    if (!cursor.accept("]") && !this.isContentFine(strings)) {
      return undefined;
    }
    if (isNegated && strings.size > 0) {
      cursor.fail(kNegatedStringsText);

      return undefined;
    }

    return strings;
  }

  private isContentFine(strings: Set<string>): boolean {
    const first = this.classElement(strings, true);
    if (first == 0) {
      return false;
    }

    const operator = this.setOperator();
    if (operator == "") {
      return this.isUnionFine(strings);
    }
    if (first == 2) {
      return this.cursor.fail(kSetOperationText);
    }

    return this.isOperationFine(strings, operator);
  }

  private isUnionFine(strings: Set<string>): boolean {
    const cursor = this.cursor;

    while (!cursor.accept("]")) {
      if (cursor.isAtEnd()) {
        return cursor.fail(kUnterminatedClassText);
      }
      if (this.setOperator() != "") {
        return cursor.fail(kSetOperationText);
      }

      const operand = new Set<string>();
      if (this.classElement(operand, true) == 0) {
        return false;
      }

      for (const text of operand) {
        strings.add(text);
      }
    }

    return true;
  }

  private isOperationFine(strings: Set<string>, operator: string): boolean {
    const cursor = this.cursor;

    while (cursor.isDoubleAt(operator.slice(0, 1))) {
      cursor.index += 2;

      if (operator == kIntersection && cursor.isAt("&")) {
        return cursor.fail(kSetCharacterText);
      }

      const operand = new Set<string>();
      if (this.classElement(operand, false) == 0) {
        return false;
      }

      this.combine(strings, operand, operator);
    }

    if (cursor.accept("]")) {
      return true;
    }
    if (cursor.isAtEnd()) {
      return cursor.fail(kUnterminatedClassText);
    }

    return cursor.fail(kSetOperationText);
  }

  private combine(
    strings: Set<string>,
    operand: Set<string>,
    operator: string,
  ): void {
    for (const text of Array.from(strings)) {
      const isFound = operand.has(text);
      const isKept = isFound == (operator == kIntersection);
      if (!isKept) {
        strings.delete(text);
      }
    }
  }

  private setOperator(): string {
    const cursor = this.cursor;
    if (cursor.isDoubleAt("&")) {
      return kIntersection;
    }
    if (cursor.isDoubleAt("-")) {
      return kSubtraction;
    }

    return "";
  }

  private classElement(strings: Set<string>, isRangeAllowed: boolean): int {
    const cursor = this.cursor;
    const first = this.classOperand(strings);
    if (first == undefined) {
      return 0;
    }
    if (first.isSet || !cursor.isAt("-") || cursor.isNextAt("-")) {
      return 1;
    }
    if (!isRangeAllowed) {
      cursor.fail(kSetOperationText);

      return 0;
    }

    cursor.index += 1;

    const last = this.classOperand(new Set<string>());
    if (last == undefined) {
      return 0;
    }
    if (last.isSet) {
      cursor.fail(kInvalidClassText);

      return 0;
    }
    if (first.char > last.char) {
      cursor.fail(kRangeOrderText);

      return 0;
    }

    return 2;
  }

  private classOperand(strings: Set<string>): RegexClassAtom | undefined {
    const cursor = this.cursor;
    if (cursor.accept("[")) {
      return this.nestedOperand(strings);
    }
    if (cursor.accept("\\")) {
      return this.escapedOperand(strings);
    }
    if (cursor.isAtEnd()) {
      return this.failedAtom(kUnterminatedClassText);
    }

    const char = cursor.current();
    if (kReservedDoubles.includes(char) && cursor.isNextAt(char)) {
      return this.failedAtom(kSetOperationText);
    }
    if (kSetSyntaxChars.includes(char)) {
      return this.failedAtom(kSetCharacterText);
    }

    return { char: cursor.nextChar(), isSet: false };
  }

  private nestedOperand(strings: Set<string>): RegexClassAtom | undefined {
    const cursor = this.cursor;

    cursor.depth += 1;

    if (cursor.depth > kMaxDepth) {
      return this.failedAtom(kTooLargeText);
    }

    const inner = this.classContents();

    cursor.depth -= 1;

    if (inner == undefined) {
      return undefined;
    }

    for (const text of inner) {
      strings.add(text);
    }

    return { char: kNoUnit, isSet: true };
  }

  private escapedOperand(strings: Set<string>): RegexClassAtom | undefined {
    const cursor = this.cursor;
    if (cursor.isAtEnd()) {
      return this.failedAtom(kBackslashEndText);
    }

    const letter = cursor.current();
    if (letter == "q") {
      cursor.index += 1;

      return this.stringsOperand(strings);
    }
    if (this.escapes.isSetEscape(letter)) {
      cursor.index += 1;

      return { char: kNoUnit, isSet: true };
    }
    if (kPropertyEscapes.includes(letter)) {
      return this.propertyAtom(letter);
    }

    const value = this.escapes.characterEscape(true);
    if (value == kNoUnit) {
      return undefined;
    }

    return { char: value, isSet: false };
  }

  private stringsOperand(strings: Set<string>): RegexClassAtom | undefined {
    const cursor = this.cursor;
    if (!cursor.accept("{")) {
      return this.failedAtom(kEscapeText);
    }

    let text = "";
    let count = 0;

    while (!cursor.accept("}")) {
      if (cursor.isAtEnd()) {
        return this.failedAtom(kUnterminatedClassText);
      }
      if (cursor.accept("|")) {
        this.addString(strings, text, count);
        text = "";
        count = 0;

        continue;
      }

      const char = this.stringChar();
      if (char == kNoUnit) {
        return undefined;
      }

      text += `${char} `;
      count += 1;
    }

    this.addString(strings, text, count);

    return { char: kNoUnit, isSet: true };
  }

  private addString(strings: Set<string>, text: string, count: int): void {
    if (count != 1) {
      strings.add(text);
    }
  }

  private stringChar(): int {
    const cursor = this.cursor;
    if (cursor.accept("\\")) {
      return this.escapes.characterEscape(true);
    }

    return cursor.nextChar();
  }
}
