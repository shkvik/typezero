import { ModuleQuestions } from "../../declaration/module-questions/module-questions.tz";
import { Code } from "../../../diagnostic/code.tz";
import { kNoDetails } from "../../../diagnostic/const/message.const.tz";
import {
  Details,
  SourceError,
} from "../../../diagnostic/types/message.types.tz";
import { TypeText } from "../../../program/type/type-text/type-text.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import { ProofRange } from "../../flow/proof-rules/types/proof-rules.types.tz";
import { TypeQuestions } from "../../types/type-questions/type-questions.tz";
import { ByteNumberRules } from "../byte-number-rules/byte-number-rules.tz";
import { ByteKindInfo } from "../byte-number-rules/types/byte-number-rules.types.tz";
import { BytesRules } from "../bytes-rules/bytes-rules.tz";
import {
  kArrayBufferClass,
  kBufferClass,
  kBufferIndexHint,
  kUint8Class,
  kBufferName,
  kByteLengthName,
  kLengthName,
  kUnionNarrowNames,
  kViewOnlyNames,
  kBufferTextHint,
  kDataViewClass,
  kFlatMapName,
  kLocaleName,
  kNoElementsHint,
  kTextCoderNames,
  kViewIndexHint,
  kBufferEncodingLabel,
  kBufferEncodings,
  kSizeNames,
  kComparePositions,
  kCopyPositions,
  kElementSizes,
  kViewHint,
  kStringBytesHint,
  kValuePlaceholder,
} from "./const/byte-source-rules.const.tz";
import { BytePosition, SourceShape } from "./types/byte-source-rules.types.tz";

export class ByteSourceRules {
  private readonly text: TypeText;
  private readonly types: TypeQuestions;
  private readonly bytes: BytesRules;
  private readonly byteNumbers: ByteNumberRules;
  private readonly modules: ModuleQuestions;

  public constructor(
    text: TypeText,
    types: Own<TypeQuestions>,
    bytes: Own<BytesRules>,
    byteNumbers: Own<ByteNumberRules>,
    modules: Own<ModuleQuestions>,
  ) {
    this.text = text;
    this.types = types;
    this.bytes = bytes;
    this.byteNumbers = byteNumbers;
    this.modules = modules;
  }

  public readonly isArrayBuffer(type: Type): boolean {
    const base = this.types.definedType(type);

    return base.kind == TypeKind.Instance && base.name == kArrayBufferClass;
  }

  public readonly typedName(type: Type): string | undefined {
    const base = this.types.definedType(type);
    if (base.kind != TypeKind.Instance) {
      return undefined;
    }
    if (this.bytes.elementOf(base) == undefined) {
      return undefined;
    }

    return base.name;
  }

  public readonly infoOf(type: Type): ByteKindInfo | undefined {
    const element = this.bytes.elementOf(type);
    if (element == undefined || this.bytes.isClamped(type)) {
      return undefined;
    }

    return this.byteNumbers.infoOfElement(element);
  }

  public readonly sourceShape(from: Type): SourceShape {
    const base = this.types.definedType(from);
    const typed = this.bytes.elementOf(base);
    if (typed != undefined) {
      return { element: typed, isTyped: true };
    }
    if (base.kind == TypeKind.Array) {
      return { element: base.item, isTyped: false };
    }
    if (base.kind == TypeKind.Iterator) {
      return { element: base.shape.yielded, isTyped: false };
    }

    return { isTyped: false };
  }

  public readonly notSourceError(loc: int, target: string, from: Type): SourceError {
    const base = this.types.definedType(from);
    const first = this.text.of(from);
    const other = this.stringHint(base.kind == TypeKind.String);

    return {
      code: Code.BytesSourceKind,
      loc,
      details: { word: target, first, other },
    };
  }

  public readonly notIterableError(loc: int, target: string, from: Type): SourceError {
    const word = `'${target}.from'`;
    const first = this.text.of(from);

    return { code: Code.BytesFromSource, loc, details: { word, first } };
  }

  public readonly elementError(
    loc: int,
    target: Type,
    from: Type,
    shape: SourceShape,
    shown: string,
  ): SourceError | undefined {
    const element = shape.element;
    const word = this.text.of(target);
    const first = this.text.of(from);
    if (element == undefined) {
      return undefined;
    }

    const base = this.types.definedType(element);
    const isNumber = base.kind == TypeKind.Int || base.kind == TypeKind.Double;
    if (!isNumber) {
      return {
        code: Code.BytesSourceNotNumbers,
        loc,
        details: { word, first },
      };
    }

    const info = this.infoOf(target);
    const range = info?.range;
    if (info == undefined || range == undefined) {
      return undefined;
    }
    if (base.kind == TypeKind.Double) {
      const details: Details = { word, first, other: shown };

      return { code: Code.BytesSourceDoubles, loc, details };
    }

    return this.rangeError(loc, info, range, shape, word, first, shown);
  }

  public readonly setIteratorError(loc: int, from: Type): SourceError | undefined {
    const base = this.types.definedType(from);
    if (base.kind != TypeKind.Iterator) {
      return undefined;
    }

    return { code: Code.BytesSetIterator, loc, details: kNoDetails };
  }

  public readonly setFitError(
    loc: int,
    offset: string | undefined,
    source: string,
    target: string,
  ): SourceError {
    const start = this.startText(offset);
    const word = `${start}${source}.length <= ${target}.length`;

    return { code: Code.BytesSetUnproven, loc, details: { word } };
  }

  public readonly withIndexError(loc: int, array: string): SourceError {
    return { code: Code.BytesWithIndex, loc, details: { word: array } };
  }

  public readonly valueArgumentError(loc: int, name: string, found: Type): SourceError {
    const first = this.text.of(found);

    return {
      code: Code.BufferValueArgument,
      loc,
      details: { word: name, first },
    };
  }

  public readonly allocFillError(loc: int, found: Type): SourceError {
    const first = this.text.of(found);

    return { code: Code.BufferAllocFill, loc, details: { first } };
  }

  public readonly mapFitError(loc: int, target: Type): SourceError | undefined {
    const info = this.infoOf(target);
    const range = info?.range;
    if (info == undefined || range == undefined) {
      return undefined;
    }

    const word = `an element of '${this.text.of(target)}'`;
    const place = this.rangeText(range);
    const other = this.byteNumbers.wrapHint(info, "f(x)");

    return {
      code: Code.BytesMapUnproven,
      loc,
      details: { word, place, other },
    };
  }

  public readonly isFillValue(type: Type): boolean {
    const base = this.types.definedType(type);
    if (base.kind == TypeKind.Int || base.kind == TypeKind.String) {
      return true;
    }

    return this.isByteSource(base);
  }

  public readonly byteRange(): ProofRange {
    return { what: "a byte", low: 0, high: 255 };
  }

  public readonly byteInfo(): ByteKindInfo | undefined {
    return this.byteNumbers.byteInfo();
  }

  public readonly positionsOf(name: string): BytePosition[] {
    if (name == "compare") {
      return kComparePositions;
    }
    if (name == "copy") {
      return kCopyPositions;
    }

    return [];
  }

  public readonly elementSize(type: Type): decimal | undefined {
    const base = this.types.definedType(type);
    if (base.kind != TypeKind.Instance) {
      return undefined;
    }

    const row = kElementSizes.find((one) => one.name == base.name);

    return row?.size;
  }

  public readonly sizeOfName(name: string): decimal | undefined {
    const row = kElementSizes.find((one) => one.name == name);

    return row?.size;
  }

  public readonly isByteView(type: Type): boolean {
    const base = this.types.definedType(type);
    if (base.kind != TypeKind.Instance) {
      return false;
    }

    return (
      base.name != kArrayBufferClass && this.elementSize(base) != undefined
    );
  }

  public readonly offsetAlignedError(
    loc: int,
    what: string,
    size: decimal,
  ): SourceError {
    const details: Details = { word: what, other: `${size}` };

    return { code: Code.ViewOffsetAligned, loc, details };
  }

  public readonly sizeAlignedError(loc: int, what: string, size: decimal): SourceError {
    const details: Details = { word: what, other: `${size}` };

    return { code: Code.ViewSizeAligned, loc, details };
  }

  public readonly notFitsError(
    loc: int,
    what: string,
    offset: string | undefined,
    length: string,
    size: decimal,
    buffer: string,
  ): SourceError {
    const start = this.startText(offset);
    const times = this.timesText(size);
    const other = `${start}${length}${times}`;
    const details: Details = { word: what, other, first: buffer };

    return { code: Code.ViewNotFits, loc, details };
  }

  public readonly viewOverError(loc: int, found: Type): SourceError {
    const first = this.text.of(found);
    const isTyped = this.bytes.elementOf(found) != undefined;
    const other = this.viewHint(isTyped);

    return { code: Code.ViewOverBuffer, loc, details: { first, other } };
  }

  public readonly offsetOnlyError(loc: int, target: string, found: Type): SourceError {
    const first = this.text.of(found);

    return {
      code: Code.ViewOffsetOnly,
      loc,
      details: { word: target, first },
    };
  }

  public readonly isEncodingLabel(label: string | undefined): boolean {
    return label == kBufferEncodingLabel;
  }

  public readonly encodingError(loc: int, texts: Read<string[]>): SourceError | undefined {
    for (const text of texts) {
      const lower = text.toLowerCase();
      if (!kBufferEncodings.includes(lower)) {
        return {
          code: Code.BufferEncodingUnknown,
          loc,
          details: { word: text },
        };
      }
    }

    return undefined;
  }

  public readonly unknownEncodingError(loc: int): SourceError {
    return { code: Code.BufferEncodingNotKnown, loc, details: kNoDetails };
  }

  public readonly isSizeName(name: string): boolean {
    return kSizeNames.includes(name);
  }

  public readonly lengthFixedError(loc: int, type: Type): SourceError | undefined {
    const isBytes = this.isByteView(type) || this.isArrayBuffer(type);
    if (!isBytes) {
      return undefined;
    }

    const word = this.text.of(this.types.definedType(type));

    return { code: Code.BytesLengthFixed, loc, details: { word } };
  }

  public readonly isBytesType(type: Type): boolean {
    const base = this.types.definedType(type);
    if (base.kind != TypeKind.Instance) {
      return false;
    }
    if (!this.modules.isLibraryModule(base.module)) {
      return false;
    }

    const isView = this.isByteView(base) || this.isArrayBuffer(base);

    return isView || kTextCoderNames.includes(base.name);
  }

  public readonly missingMemberError(
    loc: int,
    name: string,
    type: Type,
    isNotCalled: boolean,
  ): SourceError {
    const first = this.text.of(type);
    const details: Details = { word: name, first };
    if (isNotCalled) {
      return { code: Code.MethodNotCalled, loc, details };
    }

    return { code: Code.PropertyMissing, loc, details };
  }

  public readonly missingMethodError(
    loc: int,
    name: string,
    type: Type,
    isTyped: boolean,
  ): SourceError {
    if (isTyped && name == kFlatMapName) {
      return { code: Code.BytesFlatMap, loc, details: kNoDetails };
    }
    if (isTyped && name == kLocaleName) {
      return { code: Code.BytesLocale, loc, details: kNoDetails };
    }

    return this.missingMemberError(loc, name, type, false);
  }

  public readonly notIndexedError(loc: int, type: Type): SourceError | undefined {
    const base = this.types.definedType(type);
    if (!this.isBytesType(base) || this.typedName(base) != undefined) {
      return undefined;
    }

    const first = this.text.of(base);
    const other = this.indexHint(base);

    return { code: Code.BytesNotIndexed, loc, details: { first, other } };
  }

  public readonly noTextError(loc: int, type: Type): SourceError | undefined {
    const base = this.types.definedType(type);
    if (!this.isBytesType(base) || this.typedName(base) != undefined) {
      return undefined;
    }

    const first = this.text.of(base);
    const other = this.textHint(base);

    return { code: Code.BytesNoText, loc, details: { first, other } };
  }

  public readonly isBytesUnion(parts: Read<Type[]>): boolean {
    return parts.length > 1 && parts.every((part) => this.isBytesType(part));
  }

  public readonly unionMemberError(
    loc: int,
    name: string,
    parts: Read<Type[]>,
    union: Type,
  ): SourceError | undefined {
    const first = this.text.of(union);
    if (kUnionNarrowNames.includes(name)) {
      return {
        code: Code.BytesUnionNarrow,
        loc,
        details: { word: name, first },
      };
    }

    const lacking = parts.find((part) => !this.hasUnionMember(name, part));
    if (lacking == undefined) {
      return undefined;
    }

    const holder = parts.find((part) => this.hasUnionMember(name, part));
    const second = this.text.of(lacking);
    const other = this.narrowHint(holder);
    const details: Details = { word: name, first, second, other };

    return { code: Code.BytesUnionLacking, loc, details };
  }

  public readonly isBufferName(name: string): boolean {
    return name == kBufferName;
  }

  public readonly kindOf(type: Type): string | undefined {
    if (this.types.isOptional(type)) {
      return undefined;
    }

    const base = this.types.definedType(type);
    if (base.kind != TypeKind.Instance || !this.isBytesType(base)) {
      return undefined;
    }

    return base.name;
  }

  public readonly isKindName(name: string): boolean {
    const isView = kElementSizes.some((one) => one.name == name);

    return (
      isView || name == kArrayBufferClass || kTextCoderNames.includes(name)
    );
  }

  public readonly instanceofError(
    loc: int,
    left: Type,
    kind: string,
  ): SourceError | undefined {
    const base = this.types.definedType(left);
    const word = kind;
    if (base.kind == TypeKind.Unknown || base.kind == TypeKind.AnyObject) {
      return undefined;
    }
    if (base.kind == TypeKind.Union) {
      return this.unionInstanceofError(loc, left, base.parts, kind);
    }

    const first = this.text.of(left);
    if (this.isKind(kind, left)) {
      return { code: Code.InstanceOfAlwaysTrue, loc, details: { word, first } };
    }

    const isOptional = this.types.isOptional(left);
    if (isOptional && this.isKind(kind, base)) {
      const shown = this.text.of(base);

      return {
        code: Code.InstanceOfOrUndefined,
        loc,
        details: { first: shown },
      };
    }
    if (this.canBeBuffer(kind, base)) {
      return undefined;
    }

    return { code: Code.InstanceOfNeverBuiltin, loc, details: { word, first } };
  }

  private readonly isByteSource(base: Type): boolean {
    const element = this.bytes.elementOf(base);
    const isClamped = this.bytes.isClamped(base);

    return (
      element != undefined &&
      element.kind == TypeKind.Int &&
      element.bits == 8 &&
      element.unsigned &&
      !isClamped
    );
  }

  private readonly rangeError(
    loc: int,
    info: ByteKindInfo,
    range: ProofRange,
    shape: SourceShape,
    word: string,
    first: string,
    shown: string,
  ): SourceError | undefined {
    const place = this.rangeText(range);
    const wrap = this.byteNumbers.wrapHint(info, kValuePlaceholder);
    const other = `${word}.from(${shown}, ${kValuePlaceholder} => ${wrap})`;
    const element = shape.element;
    if (!shape.isTyped || element == undefined) {
      const details: Details = { word, first, place, other };

      return { code: Code.BytesSourceUnproven, loc, details };
    }

    const held = this.byteNumbers.infoOfElement(element)?.range;
    if (held == undefined) {
      return undefined;
    }

    const high = range.high ?? 0;
    const heldHigh = held.high ?? 0;
    if (held.low >= range.low && heldHigh <= high) {
      return undefined;
    }

    const second = this.rangeText(held);
    const details: Details = { word, first, second, place, other };

    return { code: Code.BytesSourceMayNotFit, loc, details };
  }

  private readonly rangeText(range: ProofRange): string {
    const high = range.high ?? 0;

    return `${range.low} to ${high}`;
  }

  private readonly stringHint(isString: boolean): string {
    if (isString) {
      return kStringBytesHint;
    }

    return "";
  }

  private readonly startText(offset: string | undefined): string {
    if (offset == undefined) {
      return "";
    }

    return `${offset} + `;
  }

  private readonly timesText(size: decimal): string {
    if (size > 1) {
      return ` * ${size}`;
    }

    return "";
  }

  private readonly viewHint(isTyped: boolean): string {
    if (isTyped) {
      return kViewHint;
    }

    return "";
  }

  private readonly indexHint(base: Type): string {
    if (this.isArrayBuffer(base)) {
      return kBufferIndexHint;
    }
    if (base.kind == TypeKind.Instance && base.name == kDataViewClass) {
      return kViewIndexHint;
    }

    return kNoElementsHint;
  }

  private readonly textHint(base: Type): string {
    if (this.isArrayBuffer(base)) {
      return kBufferTextHint;
    }

    return "";
  }

  private readonly hasUnionMember(name: string, part: Type): boolean {
    if (name == kByteLengthName) {
      return this.isByteView(part) || this.isArrayBuffer(part);
    }
    if (kViewOnlyNames.includes(name)) {
      return this.isByteView(part);
    }

    return name == kLengthName && this.typedName(part) != undefined;
  }

  private readonly narrowHint(holder: Type | undefined): string {
    if (holder == undefined) {
      return "";
    }

    return `, e.g. 'if (x instanceof ${this.text.of(holder)})'`;
  }

  private readonly unionInstanceofError(
    loc: int,
    left: Type,
    parts: Read<Type[]>,
    kind: string,
  ): SourceError | undefined {
    const base = this.types.definedType(left);
    const first = this.text.of(base);
    const word = kind;
    const matching = parts.filter((part) => this.isKind(kind, part));
    const isMaybe = parts.some((part) => this.canBeBuffer(kind, part));
    if (matching.length == 0 && !isMaybe) {
      return {
        code: Code.InstanceOfNoneBuiltin,
        loc,
        details: { word, first },
      };
    }

    const isAll = matching.length == parts.length;
    if (isAll && !this.types.isOptional(left)) {
      return { code: Code.InstanceOfAllBuiltin, loc, details: { word, first } };
    }

    return undefined;
  }

  private readonly isKind(kind: string, type: Type): boolean {
    const found = this.kindOf(type);
    if (found == undefined) {
      return false;
    }

    return found == kind || (kind == kUint8Class && found == kBufferClass);
  }

  private readonly canBeBuffer(kind: string, type: Type): boolean {
    return kind == kBufferClass && this.kindOf(type) == kUint8Class;
  }
}
