import { Code } from "../../../diagnostic/code.tz";
import { kNoDetails } from "../../../diagnostic/const/message.const.tz";
import { SourceError } from "../../../diagnostic/types/message.types.tz";
import { TypeText } from "../../../program/type/type-text/type-text.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import { TypeQuestions } from "../../types/type-questions/type-questions.tz";
import { ByteSourceRules } from "../byte-source-rules/byte-source-rules.tz";
import { kWebCryptoCurves } from "../crypto-rules/const/crypto-rules.const.names.tz";
import {
  kAesFamily,
  kAesGcmName,
  kAesLengths,
  kCryptoKeyClass,
  kDeriveKeysVerb,
  kDigestOperation,
  kGcmTagLengths,
  kGenerateOperation,
  kKdfFamily,
  kKeyLengthOperation,
  kShaPrefix,
  kSubtleCryptoClass,
  kSubtleMethods,
  kSubtleVerbs,
  kVowelStarts,
} from "./const/subtle-rules.const.tz";
import {
  kExperimentalAlgorithms,
  kKeyFormats,
  kKeyUsages,
  kSubtleAlgorithms,
  kSubtleDictionaries,
  kSubtleExamples,
  kSubtleFamilies,
} from "./const/subtle-rules.const.tables.tz";
import {
  SubtleAlgorithmFound,
  SubtleAlgorithmRow,
  SubtleDictionaryRow,
} from "./types/subtle-rules.types.tz";

export class SubtleRules {
  private readonly text: TypeText;
  private readonly types: TypeQuestions;
  private readonly byteSources: ByteSourceRules;

  public constructor(
    text: TypeText,
    types: TypeQuestions,
    byteSources: ByteSourceRules,
  ) {
    this.text = text;
    this.types = types;
    this.byteSources = byteSources;
  }

  public isMethod(name: string): boolean {
    return kSubtleMethods.includes(name);
  }

  public algorithmFound(
    loc: int,
    written: string,
    operation: string,
    fallback: string,
  ): SubtleAlgorithmFound {
    const upper = written.toUpperCase();
    const known =
      this.algorithmIn(operation, upper) ?? this.algorithmIn(fallback, upper);
    if (known != undefined) {
      return { algorithm: known };
    }

    const list = this.quotedList(this.namesOf(operation), "or");
    const verb = this.verbOf(operation);
    if (kExperimentalAlgorithms.includes(upper)) {
      const details = { word: written, first: verb, other: list };

      return { error: { code: Code.SubtleExperiment, loc, details } };
    }

    const isElsewhere = kSubtleAlgorithms.some(
      (one) => one.name.toUpperCase() == upper,
    );
    const details = {
      word: written,
      path: operation,
      first: verb,
      other: list,
    };
    if (isElsewhere) {
      return { error: { code: Code.SubtleOtherOperation, loc, details } };
    }

    return { error: { code: Code.SubtleUnknownAlgorithm, loc, details } };
  }

  public dictionaryOf(
    operation: string,
    algorithm: SubtleAlgorithmRow,
  ): SubtleDictionaryRow | undefined {
    return kSubtleDictionaries.find((one) => {
      if (one.operation != operation) {
        return false;
      }
      if (one.isPrefix) {
        return algorithm.name.startsWith(one.algorithm);
      }

      return algorithm.name == one.algorithm;
    });
  }

  public objectError(
    loc: int,
    algorithm: SubtleAlgorithmRow,
    operation: string,
    dictionary: SubtleDictionaryRow | undefined,
  ): SourceError | undefined {
    const member = dictionary?.required[0];
    if (dictionary == undefined || member == undefined) {
      return undefined;
    }

    const details = {
      word: algorithm.name,
      path: operation,
      first: dictionary.name,
      second: member,
      other: this.exampleOf(member),
    };

    return { code: Code.SubtleParamsObject, loc, details };
  }

  public needsError(
    loc: int,
    algorithm: SubtleAlgorithmRow,
    operation: string,
    dictionary: SubtleDictionaryRow,
    member: string,
  ): SourceError {
    const details = {
      word: algorithm.name,
      path: operation,
      first: member,
      second: dictionary.name,
      other: this.exampleOf(member),
    };

    return { code: Code.SubtleNeedsMember, loc, details };
  }

  public shaError(
    loc: int,
    hash: string,
    dictionary: string,
  ): SourceError | undefined {
    const isSha = hash.toLowerCase().startsWith(kShaPrefix);
    const isKnown = this.algorithmIn(kDigestOperation, hash.toUpperCase());
    if (isSha && isKnown != undefined) {
      return undefined;
    }

    const isExperiment = kExperimentalAlgorithms.includes(hash.toUpperCase());
    if (isSha || isExperiment) {
      const other = this.quotedList(this.namesOf(kDigestOperation), "or");
      const details = { word: hash, first: dictionary, other };

      return { code: Code.SubtleUnknownHash, loc, details };
    }

    const details = { word: hash, first: dictionary };

    return { code: Code.SubtleNotSha, loc, details };
  }

  public curveError(loc: int, curve: string): SourceError | undefined {
    if (kWebCryptoCurves.includes(curve)) {
      return undefined;
    }

    return { code: Code.SubtleCurve, loc, details: { word: curve } };
  }

  public aesLengthError(
    loc: int,
    algorithm: SubtleAlgorithmRow,
    operation: string,
    bits: double,
  ): SourceError | undefined {
    const isSizing =
      operation == kGenerateOperation || operation == kKeyLengthOperation;
    const isFine = kAesLengths.some((length) => length.toDouble() == bits);
    if (algorithm.family != kAesFamily || !isSizing || isFine) {
      return undefined;
    }

    return { code: Code.SubtleAesLength, loc, details: kNoDetails };
  }

  public gcmTagError(
    loc: int,
    algorithm: SubtleAlgorithmRow,
    bits: double,
  ): SourceError | undefined {
    const isFine = kGcmTagLengths.some((length) => length.toDouble() == bits);
    if (algorithm.name != kAesGcmName || isFine) {
      return undefined;
    }

    return { code: Code.SubtleGcmTag, loc, details: kNoDetails };
  }

  public formatError(loc: int, written: string): SourceError | undefined {
    if (kKeyFormats.includes(written)) {
      return undefined;
    }

    return { code: Code.SubtleFormat, loc, details: { word: written } };
  }

  public importFormatError(
    loc: int,
    algorithm: SubtleAlgorithmRow,
    format: string,
    isUnwrap: boolean,
  ): SourceError | undefined {
    const formats = this.formatsOf(algorithm);
    if (formats.includes(format)) {
      return undefined;
    }

    const details = {
      word: algorithm.name,
      first: format,
      other: this.quotedList(formats, "or"),
    };
    if (isUnwrap) {
      return { code: Code.SubtleUnwrapFormat, loc, details };
    }

    return { code: Code.SubtleImportFormat, loc, details };
  }

  public derivedError(
    loc: int,
    algorithm: SubtleAlgorithmRow,
  ): SourceError | undefined {
    if (this.isSecret(algorithm)) {
      return undefined;
    }

    const details = { word: algorithm.name };

    return { code: Code.SubtleDerived, loc, details };
  }

  public isSecret(algorithm: SubtleAlgorithmRow | undefined): boolean {
    if (algorithm == undefined) {
      return false;
    }

    const name = algorithm.family;
    const family = kSubtleFamilies.find((one) => one.family == name);

    return family?.isSecret == true;
  }

  public isKdf(algorithm: SubtleAlgorithmRow): boolean {
    return algorithm.family == kKdfFamily;
  }

  public isUsage(name: string): boolean {
    return kKeyUsages.includes(name);
  }

  public unknownUsageError(loc: int, usage: string): SourceError {
    const other = this.quotedList(kKeyUsages, "and");

    return {
      code: Code.SubtleUnknownUsage,
      loc,
      details: { word: usage, other },
    };
  }

  public allowedUsages(
    algorithm: SubtleAlgorithmRow | undefined,
    isPublic: int,
  ): string[] {
    const allowed: string[] = [];
    if (algorithm == undefined) {
      return allowed;
    }
    if (isPublic != 0) {
      allowed.push(...algorithm.publicUsages);
    }
    if (isPublic != 1) {
      for (const usage of algorithm.privateUsages) {
        if (!allowed.includes(usage)) {
          allowed.push(usage);
        }
      }
    }

    return allowed;
  }

  public notOfUsageError(
    loc: int,
    usage: string,
    algorithm: SubtleAlgorithmRow,
    isPublic: int,
    allowed: string[],
  ): SourceError {
    const what = this.keyWhat(algorithm, isPublic);
    const other = this.takesText(allowed);
    const details = { word: usage, first: what, other };

    return { code: Code.SubtleNotUsage, loc, details };
  }

  public emptyUsagesError(
    loc: int,
    algorithm: SubtleAlgorithmRow,
    isSingle: boolean,
  ): SourceError {
    const own = algorithm.privateUsages;
    if (isSingle) {
      const other = this.quotedList(own, "and");

      return { code: Code.SubtleEmptyUsages, loc, details: { other } };
    }

    const other = this.quotedList(own, "or");

    return { code: Code.SubtlePairEmpty, loc, details: { other } };
  }

  public keyDataError(
    loc: int,
    format: string,
    type: Type,
    shown: string,
  ): SourceError | undefined {
    const base = this.types.definedType(type);
    if (base.kind == TypeKind.Error) {
      return undefined;
    }

    const isJwk = format == "jwk";
    if (isJwk && this.isHoldingBytes(type)) {
      return { code: Code.SubtleJwkData, loc, details: { word: shown } };
    }
    if (!isJwk && base.kind == TypeKind.Object) {
      const details = { word: format, first: shown };

      return { code: Code.SubtleBytesData, loc, details };
    }

    return undefined;
  }

  public typeShown(type: Type): string {
    return this.text.of(type);
  }

  public newError(loc: int, name: string): SourceError | undefined {
    if (name == kCryptoKeyClass) {
      return { code: Code.SubtleNewKey, loc, details: kNoDetails };
    }
    if (name == kSubtleCryptoClass) {
      return { code: Code.SubtleNewSubtle, loc, details: kNoDetails };
    }

    return undefined;
  }

  public globalThisError(loc: int, name: string): SourceError {
    return { code: Code.GlobalThisMember, loc, details: { word: name } };
  }

  private isHoldingBytes(type: Type): boolean {
    const parts = this.types.unionMembers(type);

    return parts.every(
      (part) =>
        this.byteSources.isByteView(part) ||
        this.byteSources.isArrayBuffer(part),
    );
  }

  private keyWhat(algorithm: SubtleAlgorithmRow, isPublic: int): string {
    const name = algorithm.name;
    if (isPublic == 1) {
      return `a public ${name} key`;
    }
    if (isPublic == 0 && !this.isSecret(algorithm)) {
      return `a private ${name} key`;
    }
    if (kVowelStarts.includes(name.slice(0, 1))) {
      return `an ${name} key`;
    }

    return `a ${name} key`;
  }

  private takesText(allowed: string[]): string {
    if (allowed.length == 0) {
      return "it takes none: pass []";
    }

    return `it takes ${this.quotedList(allowed, "and")}`;
  }

  private algorithmIn(
    operation: string,
    upper: string,
  ): SubtleAlgorithmRow | undefined {
    return kSubtleAlgorithms.find(
      (one) =>
        one.operations.includes(operation) && one.name.toUpperCase() == upper,
    );
  }

  private namesOf(operation: string): string[] {
    return kSubtleAlgorithms
      .filter((one) => one.operations.includes(operation))
      .map((one) => one.name);
  }

  private verbOf(operation: string): string {
    const found = kSubtleVerbs.find((one) => one.operation == operation);

    return found?.verb ?? kDeriveKeysVerb;
  }

  private exampleOf(member: string): string {
    const found = kSubtleExamples.find((one) => one.name == member);

    return found?.example ?? "";
  }

  private formatsOf(algorithm: SubtleAlgorithmRow): string[] {
    const family = kSubtleFamilies.find(
      (one) => one.family == algorithm.family,
    );

    return family?.formats ?? [];
  }

  private quotedList(names: string[], last: string): string {
    let out = "";

    for (let index = 0; index < names.length; index++) {
      out += this.listJoint(index, names.length, last) + (names[index] ?? "");
    }

    return `${out}'`;
  }

  private listJoint(index: int, count: int, last: string): string {
    if (index == 0) {
      return "'";
    }
    if (index + 1 == count) {
      return `' ${last} '`;
    }

    return "', '";
  }
}
