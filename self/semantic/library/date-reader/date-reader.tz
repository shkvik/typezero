import {
  kColon,
  kDot,
  kEndToken,
  kInvalidToken,
  kLargestSigned,
  kMinus,
  kNone,
  kRightParen,
  kUnsignedRange,
} from "./const/date-reader.const.tz";
import {
  DateFields,
  DateToken,
  DateTokenKind,
  DayValue,
  TimeValue,
  ZoneValue,
} from "./types/date-reader.types.tz";
import { DateScanner } from "../date-scanner/date-scanner.tz";
import { DateValues } from "../date-values/date-values.tz";

export class DateReader {
  private readonly scanner: DateScanner;
  private readonly values: DateValues;
  private dayParts: int[];
  private namedMonth: int;
  private isIso: boolean;
  private hasNumber: boolean;
  private timeParts: int[];
  private hourOffset: int;
  private zoneSign: int;
  private zoneHour: int;
  private zoneMinute: int;

  public constructor(text: string) {
    this.scanner = new DateScanner(text);
    this.values = new DateValues();
    this.dayParts = [];
    this.namedMonth = kNone;
    this.isIso = false;
    this.hasNumber = false;
    this.timeParts = [];
    this.hourOffset = kNone;
    this.zoneSign = kNone;
    this.zoneHour = kNone;
    this.zoneMinute = kNone;
  }

  public read(): DateFields | undefined {
    this.scanner.start();

    const first = this.parseIso();
    if (first.kind == DateTokenKind.Invalid) {
      return undefined;
    }

    const isDateOnly =
      first.kind == DateTokenKind.End &&
      this.isIso &&
      this.timeParts.length == 0;

    this.hasNumber = this.dayParts.length > 0;

    let token = first;

    while (token.kind != DateTokenKind.End) {
      if (!this.legacyStep(token)) {
        return undefined;
      }

      token = this.scanner.nextToken();
    }

    const day = this.writtenDay();
    const time = this.writtenTime();
    const zone = this.writtenZone();
    if (day == undefined || time == undefined || zone == undefined) {
      return undefined;
    }

    return { day, time, zone, isDateOnly };
  }

  private addDay(value: int): boolean {
    if (this.dayParts.length == 3) {
      return false;
    }

    this.dayParts.push(value);

    return true;
  }

  private addTime(value: int): boolean {
    if (this.timeParts.length >= 4) {
      return false;
    }

    this.timeParts.push(value);

    return true;
  }

  private addLastTime(value: int): boolean {
    if (!this.addTime(value)) {
      return false;
    }

    while (this.timeParts.length < 4) {
      this.timeParts.push(0);
    }

    return true;
  }

  private readonly isTimeExpecting(value: int): boolean {
    const count = this.timeParts.length;
    const isMinute = count == 1 && this.values.isMinute(value);
    const isSecond = count == 2 && this.values.isMinute(value);
    const isMillisecond = count == 3 && this.values.isMillisecond(value);

    return isMinute || isSecond || isMillisecond;
  }

  private setZone(hours: int): void {
    const isNegative = hours < 0;

    this.zoneSign = this.values.signFor(isNegative);
    this.zoneHour = this.values.signed(hours, isNegative);
    this.zoneMinute = 0;
  }

  private readonly isZoneExpecting(value: int): boolean {
    return (
      this.zoneHour != kNone &&
      this.zoneMinute == kNone &&
      this.values.isMinute(value)
    );
  }

  private readonly isUtcZone(): boolean {
    return this.zoneHour == 0 && this.zoneMinute == 0;
  }

  private parseIso(): DateToken {
    const dateStop = this.isoDate();
    if (dateStop != undefined) {
      return dateStop;
    }

    const timeStop = this.isoTime();
    if (timeStop != undefined) {
      return timeStop;
    }
    if (this.zoneHour == kNone && this.timeParts.length == 0) {
      this.setZone(0);
    }

    this.isIso = true;

    return kEndToken;
  }

  private isoDate(): DateToken | undefined {
    const yearStop = this.isoYear();
    if (yearStop != undefined) {
      return yearStop;
    }
    if (!this.scanner.skipSymbol(kMinus)) {
      return undefined;
    }

    const month = this.scanner.peek();
    const isMonth =
      this.scanner.isFixedNumber(month, 2) && this.values.isMonth(month.value);

    this.scanner.nextToken();

    if (!isMonth) {
      return month;
    }

    this.addDay(month.value);

    if (!this.scanner.skipSymbol(kMinus)) {
      return undefined;
    }

    const day = this.scanner.peek();
    const isDay =
      this.scanner.isFixedNumber(day, 2) && this.values.isDay(day.value);

    this.scanner.nextToken();

    if (!isDay) {
      return day;
    }

    this.addDay(day.value);

    return undefined;
  }

  private isoYear(): DateToken | undefined {
    if (this.scanner.isNextSign()) {
      const sign = this.scanner.nextToken();
      if (!this.scanner.isNextFixed(6)) {
        return sign;
      }

      const year = this.scanner.nextToken();
      const direction = this.scanner.signOf(sign);
      if (direction < 0 && year.value == 0) {
        return sign;
      }

      this.addDay(direction * year.value);

      return undefined;
    }
    if (this.scanner.isNextFixed(4)) {
      const year = this.scanner.nextToken();

      this.addDay(year.value);

      return undefined;
    }

    return this.scanner.nextToken();
  }

  private isoTime(): DateToken | undefined {
    const mark = this.scanner.peek();
    if (mark.kind != DateTokenKind.LetterT) {
      return this.isoEnd(mark);
    }

    this.scanner.nextToken();

    const hour = this.scanner.peek();
    const isHour =
      this.scanner.isFixedNumber(hour, 2) &&
      this.values.between(hour.value, 0, 24);
    if (!isHour) {
      return kInvalidToken;
    }

    const isMidnight = hour.value == 24;

    this.scanner.nextToken();

    this.addTime(hour.value);

    if (!this.scanner.skipSymbol(kColon) || !this.isClockPart(isMidnight)) {
      return kInvalidToken;
    }

    const minute = this.scanner.nextToken();

    this.addTime(minute.value);

    const secondsStop = this.isoSeconds(isMidnight);
    if (secondsStop != undefined) {
      return secondsStop;
    }

    const zoneStop = this.isoZone();
    if (zoneStop != undefined) {
      return zoneStop;
    }
    const last = this.scanner.peek();
    if (last.kind != DateTokenKind.End) {
      return kInvalidToken;
    }

    return undefined;
  }

  private isoEnd(mark: DateToken): DateToken | undefined {
    if (mark.kind == DateTokenKind.End) {
      return undefined;
    }

    return this.scanner.nextToken();
  }

  private readonly isClockPart(isMidnight: boolean): boolean {
    const part = this.scanner.peek();
    const isLate = isMidnight && part.value > 0;

    return (
      this.scanner.isFixedNumber(part, 2) &&
      this.values.isMinute(part.value) &&
      !isLate
    );
  }

  private isoSeconds(isMidnight: boolean): DateToken | undefined {
    if (!this.scanner.skipSymbol(kColon)) {
      return undefined;
    }
    if (!this.isClockPart(isMidnight)) {
      return kInvalidToken;
    }

    const second = this.scanner.nextToken();

    this.addTime(second.value);

    if (!this.scanner.skipSymbol(kDot)) {
      return undefined;
    }

    const part = this.scanner.peek();
    const isLate = isMidnight && part.value > 0;
    if (part.kind != DateTokenKind.Number || isLate) {
      return kInvalidToken;
    }

    const fraction = this.scanner.nextToken();
    const milliseconds = this.values.readMilliseconds(fraction);

    this.addTime(milliseconds);

    return undefined;
  }

  private isoZone(): DateToken | undefined {
    if (this.scanner.isNextZ()) {
      this.scanner.nextToken();
      this.setZone(0);

      return undefined;
    }
    if (!this.scanner.isNextSign()) {
      return undefined;
    }

    const sign = this.scanner.nextToken();

    this.zoneSign = this.scanner.signOf(sign);

    if (this.scanner.isNextFixed(4)) {
      return this.joinedZone();
    }

    const hour = this.scanner.peek();
    const isHour =
      this.scanner.isFixedNumber(hour, 2) && this.values.isHour(hour.value);
    if (!isHour) {
      return kInvalidToken;
    }

    this.scanner.nextToken();

    this.zoneHour = hour.value;

    if (!this.scanner.skipSymbol(kColon)) {
      return kInvalidToken;
    }

    const minute = this.scanner.peek();
    const isMinute =
      this.scanner.isFixedNumber(minute, 2) &&
      this.values.isMinute(minute.value);
    if (!isMinute) {
      return kInvalidToken;
    }

    this.scanner.nextToken();

    this.zoneMinute = minute.value;

    return undefined;
  }

  private joinedZone(): DateToken | undefined {
    const joined = this.scanner.nextToken();
    const hour = joined.value / 100;
    const minute = joined.value % 100;
    if (!this.values.isHour(hour) || !this.values.isMinute(minute)) {
      return kInvalidToken;
    }

    this.zoneHour = hour;
    this.zoneMinute = minute;

    return undefined;
  }

  private legacyStep(token: DateToken): boolean {
    if (token.kind == DateTokenKind.Number) {
      return this.numberStep(token.value);
    }
    if (this.scanner.isWord(token)) {
      return this.wordStep(token);
    }

    const isSign = this.scanner.isSign(token);
    const isZoned = this.isUtcZone() || this.timeParts.length != 0;
    if (isSign && isZoned) {
      return this.zoneSignStep(token);
    }

    const isClosing = this.scanner.isSymbol(token, kRightParen);

    return !((isSign || isClosing) && this.hasNumber);
  }

  private numberStep(value: int): boolean {
    this.hasNumber = true;

    if (this.scanner.skipSymbol(kColon)) {
      return this.clockStep(value);
    }

    const isDot = this.scanner.skipSymbol(kDot);
    if (isDot && this.isTimeExpecting(value)) {
      return this.fractionStep(value);
    }
    if (this.isZoneExpecting(value)) {
      this.zoneMinute = value;

      return true;
    }
    if (this.isTimeExpecting(value)) {
      return this.lastClockStep(value);
    }
    if (!this.addDay(value)) {
      return false;
    }

    this.scanner.skipSymbol(kMinus);

    return true;
  }

  private clockStep(value: int): boolean {
    if (this.scanner.skipSymbol(kColon)) {
      if (this.timeParts.length != 0) {
        return false;
      }

      this.addTime(value);
      this.addTime(0);

      return true;
    }
    if (!this.addTime(value)) {
      return false;
    }
    if (this.scanner.isNextSymbol(kDot)) {
      this.scanner.nextToken();
    }

    return true;
  }

  private fractionStep(value: int): boolean {
    this.addTime(value);

    if (!this.scanner.isNextNumber()) {
      return false;
    }

    const fraction = this.scanner.nextToken();
    const milliseconds = this.values.readMilliseconds(fraction);
    if (milliseconds < 0) {
      return false;
    }

    this.addLastTime(milliseconds);

    return true;
  }

  private lastClockStep(value: int): boolean {
    this.addLastTime(value);

    const peek = this.scanner.peek();
    const isOpen =
      peek.kind == DateTokenKind.End || peek.kind == DateTokenKind.Space;

    return isOpen || this.scanner.isZ(peek) || this.scanner.isSign(peek);
  }

  private wordStep(token: DateToken): boolean {
    const hasTime = this.timeParts.length != 0;
    if (token.kind == DateTokenKind.Meridiem && hasTime) {
      this.hourOffset = token.value;

      return true;
    }
    if (token.kind == DateTokenKind.Month) {
      this.namedMonth = token.value;
      this.scanner.skipSymbol(kMinus);

      return true;
    }
    if (token.kind == DateTokenKind.Zone && this.hasNumber) {
      this.setZone(token.value);

      return true;
    }
    if (this.hasNumber) {
      return false;
    }

    return !this.scanner.isNextNumber();
  }

  private zoneSignStep(token: DateToken): boolean {
    this.zoneSign = this.scanner.signOf(token);

    const number = this.zoneNumber();
    const digits = number.length;
    const value = number.value;

    this.hasNumber = true;

    if (this.scanner.isNextSymbol(kColon)) {
      this.zoneHour = value;
      this.zoneMinute = kNone;

      return true;
    }
    if (digits == 1 || digits == 2) {
      this.zoneHour = value;
      this.zoneMinute = 0;

      return true;
    }
    if (digits == 3 || digits == 4) {
      this.zoneHour = value / 100;
      this.zoneMinute = value % 100;

      return true;
    }

    return false;
  }

  private zoneNumber(): DateToken {
    if (this.scanner.isNextNumber()) {
      return this.scanner.nextToken();
    }

    return { kind: DateTokenKind.Number, length: 0, value: 0 };
  }

  private writtenDay(): DayValue | undefined {
    if (this.dayParts.length < 1) {
      return undefined;
    }

    while (this.dayParts.length < 3) {
      this.dayParts.push(1);
    }

    const parts = this.dayParts;
    const first = parts[0] ?? 0;
    const second = parts[1] ?? 0;
    const third = parts[2] ?? 0;
    const read = this.orderedDay(first, second, third);
    const year = this.fullYear(read.year);
    const isFitting =
      this.values.isMonth(read.month) && this.values.isDay(read.day);
    if (!isFitting) {
      return undefined;
    }

    return { year, month: read.month - 1, day: read.day };
  }

  private readonly orderedDay(first: int, second: int, third: int): DayValue {
    if (this.namedMonth != kNone) {
      return this.namedDay(first, second);
    }
    if (this.isIso || !this.values.isDay(first)) {
      return { year: first, month: second, day: third };
    }

    return { year: third, month: first, day: second };
  }

  private readonly namedDay(first: int, second: int): DayValue {
    const month = this.namedMonth;
    if (!this.values.isDay(first)) {
      return { year: first, month, day: second };
    }

    return { year: second, month, day: first };
  }

  private readonly fullYear(year: int): int {
    if (this.isIso) {
      return year;
    }
    if (this.values.between(year, 0, 49)) {
      return year + 2000;
    }
    if (this.values.between(year, 50, 99)) {
      return year + 1900;
    }

    return year;
  }

  private writtenTime(): TimeValue | undefined {
    while (this.timeParts.length < 4) {
      this.timeParts.push(0);
    }

    const parts = this.timeParts;
    const written = parts[0] ?? 0;
    const minute = parts[1] ?? 0;
    const second = parts[2] ?? 0;
    const millisecond = parts[3] ?? 0;
    const isHalf = this.hourOffset != kNone;
    if (isHalf && !this.values.between(written, 0, 12)) {
      return undefined;
    }

    const hour = this.dayHour(written);
    const isFitting =
      this.values.isHour(hour) &&
      this.values.isMinute(minute) &&
      this.values.isMinute(second) &&
      this.values.isMillisecond(millisecond);
    const isMidnight =
      hour == 24 && minute == 0 && second == 0 && millisecond == 0;
    if (!isFitting && !isMidnight) {
      return undefined;
    }

    return { hour, minute, second, millisecond };
  }

  private readonly dayHour(written: int): int {
    if (this.hourOffset == kNone) {
      return written;
    }

    return (written % 12) + this.hourOffset;
  }

  private readonly writtenZone(): ZoneValue | undefined {
    if (this.zoneSign == kNone) {
      return { isLocal: true, offset: 0 };
    }

    const hour = this.knownPart(this.zoneHour);
    const minute = this.knownPart(this.zoneMinute);
    const total = (hour * 3600 + minute * 60) % kUnsignedRange;
    if (total > kLargestSigned) {
      return undefined;
    }

    const offset = this.values.signed(total, this.zoneSign < 0);

    return { isLocal: false, offset };
  }

  private readonly knownPart(value: int): int {
    if (value == kNone) {
      return 0;
    }

    return value;
  }
}
