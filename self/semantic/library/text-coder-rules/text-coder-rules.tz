import { Code } from "../../../diagnostic/code.tz";
import { kNoDetails } from "../../../diagnostic/const/message.const.tz";
import { SourceError } from "../../../diagnostic/types/message.types.tz";
import {
  Expr,
  ExprKind,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { kDecoderLabels } from "../../../program/library/decoder-labels/const/decoder-labels.const.tz";
import { TypeText } from "../../../program/type/type-text/type-text.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import { TypeQuestions } from "../../types/type-questions/type-questions.tz";
import { ByteSourceRules } from "../byte-source-rules/byte-source-rules.tz";
import {
  kDecodeName,
  kDecoderClasses,
  kFatalDecoderClass,
  kFatalName,
  kLabelSpaces,
  kParseName,
  kTextDecoderClass,
} from "./const/text-coder-rules.const.tz";

export class TextCoderRules {
  private readonly text: TypeText;
  private readonly types: TypeQuestions;
  private readonly byteSources: ByteSourceRules;

  public constructor(
    text: TypeText,
    types: TypeQuestions,
    byteSources: ByteSourceRules,
  ) {
    this.text = text;
    this.types = types;
    this.byteSources = byteSources;
  }

  public isDecoderNew(type: Type): boolean {
    return this.isNamed(type, kTextDecoderClass);
  }

  public isFatalNew(type: Type): boolean {
    return this.isNamed(type, kFatalDecoderClass);
  }

  public isDecodeCall(type: Type, name: string): boolean {
    const base = this.types.definedType(type);
    const isDecoder =
      base.kind == TypeKind.Instance && kDecoderClasses.includes(base.name);

    return (
      isDecoder && name == kDecodeName && this.byteSources.isBytesType(base)
    );
  }

  public isParseName(name: string): boolean {
    return name == kParseName;
  }

  public isFatalName(name: string): boolean {
    return name == kFatalName;
  }

  public literalLabel(label: Expr): string | undefined {
    if (label.kind == ExprKind.StringLit) {
      return label.value;
    }
    if (label.kind == ExprKind.Template && label.exprs.length == 0) {
      return label.quasis[0];
    }

    return undefined;
  }

  public labelError(loc: int, labels: string[]): SourceError | undefined {
    for (const label of labels) {
      const plain = this.trimmed(label).toLowerCase();
      if (!kDecoderLabels.includes(plain)) {
        return {
          code: Code.DecoderLabelUnknown,
          loc,
          details: { word: label },
        };
      }
    }

    return undefined;
  }

  public unknownLabelError(loc: int): SourceError {
    return { code: Code.DecoderLabelNotKnown, loc, details: kNoDetails };
  }

  public isFatalFlag(value: Expr): boolean {
    if (value.kind == ExprKind.Undefined) {
      return false;
    }

    return value.kind != ExprKind.BoolLit || value.value;
  }

  public decodeInputError(loc: int, found: Type): SourceError | undefined {
    const base = this.types.definedType(found);
    const isFitting =
      base.kind == TypeKind.Error ||
      base.kind == TypeKind.Undefined ||
      this.byteSources.isByteView(base) ||
      this.byteSources.isArrayBuffer(base);
    if (isFitting) {
      return undefined;
    }

    const first = this.text.of(found);

    return { code: Code.DecodeInput, loc, details: { first } };
  }

  public fatalNewError(loc: int): SourceError {
    return { code: Code.FatalDecoderNew, loc, details: kNoDetails };
  }

  public resizableError(loc: int): SourceError {
    return { code: Code.ResizableBuffer, loc, details: kNoDetails };
  }

  private isNamed(type: Type, name: string): boolean {
    const base = this.types.definedType(type);

    return (
      base.kind == TypeKind.Instance &&
      base.name == name &&
      this.byteSources.isBytesType(base)
    );
  }

  private trimmed(label: string): string {
    let start = 0;
    let end = label.length;

    while (start < end && kLabelSpaces.includes(label.charAt(start))) {
      start += 1;
    }

    while (end > start && kLabelSpaces.includes(label.charAt(end - 1))) {
      end -= 1;
    }

    return label.slice(start, end);
  }
}
