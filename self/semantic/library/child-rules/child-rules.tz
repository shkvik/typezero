import { Code } from "../../../diagnostic/code.tz";
import { kNoDetails } from "../../../diagnostic/const/message.const.tz";
import { SourceError } from "../../../diagnostic/types/message.types.tz";
import {
  ArrayElement,
  Expr,
  ExprKind,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { TypeText } from "../../../program/type/type-text/type-text.tz";
import { Type } from "../../../program/type/types/type.types.tz";
import {
  kBufferMarker,
  kChildModule,
  kChildOptions,
  kExecName,
  kIpcKind,
  kMostDescriptor,
  kRunNames,
  kSignals,
  kStdioKinds,
} from "./const/child-rules.const.tz";

export class ChildRules {
  private readonly text: TypeText;

  public constructor(text: TypeText) {
    this.text = text;
  }

  public isChildModule(name: string): boolean {
    return name == kChildModule;
  }

  public isRun(name: string): boolean {
    return kRunNames.includes(name);
  }

  public isExec(name: string): boolean {
    return name == kExecName;
  }

  public options(): string[] {
    return kChildOptions;
  }

  public isBufferMarker(text: string): boolean {
    return text == kBufferMarker;
  }

  public isSignal(name: string): boolean {
    return kSignals.includes(name);
  }

  public optionsAtError(loc: int, name: string): SourceError {
    return { code: Code.ChildOptionsAt, loc, details: { word: name } };
  }

  public zeroFileError(loc: int, isExec: boolean): SourceError {
    const word = this.fileWord(isExec);

    return { code: Code.ChildZeroFile, loc, details: { word } };
  }

  public emptyNameError(loc: int): SourceError {
    return { code: Code.ChildEmptyName, loc, details: kNoDetails };
  }

  public zeroArgError(loc: int, index: int): SourceError {
    return { code: Code.ChildZeroArg, loc, details: { word: `${index}` } };
  }

  public encodingError(loc: int, name: string): SourceError {
    return { code: Code.ChildEncoding, loc, details: { word: name } };
  }

  public stdioError(loc: int, name: string): SourceError {
    return { code: Code.ChildStdio, loc, details: { word: name } };
  }

  public threeError(loc: int): SourceError {
    return { code: Code.ChildStdioThree, loc, details: kNoDetails };
  }

  public stdioKindError(loc: int, value: Expr): SourceError | undefined {
    if (value.kind != ExprKind.StringLit) {
      return { code: Code.ChildStdioLiteral, loc, details: kNoDetails };
    }

    const text = value.value;
    if (kStdioKinds.includes(text)) {
      return undefined;
    }
    if (text == kIpcKind) {
      return { code: Code.ChildStdioIpc, loc, details: kNoDetails };
    }

    return { code: Code.ChildStdioUnknown, loc, details: { word: text } };
  }

  public stdioEntryError(element: ArrayElement): SourceError | undefined {
    const value = element.expr;
    const loc = value.loc;
    if (element.spread) {
      return { code: Code.ChildStdioSpread, loc, details: kNoDetails };
    }
    if (value.kind == ExprKind.Undefined) {
      return undefined;
    }
    if (value.kind == ExprKind.IntLit && value.value > kMostDescriptor) {
      const word = `${value.value}`;

      return { code: Code.ChildStdioNoFd, loc, details: { word } };
    }
    if (value.kind == ExprKind.IntLit) {
      return undefined;
    }

    return this.stdioKindError(loc, value);
  }

  public zeroCwdError(loc: int): SourceError {
    return { code: Code.ChildZeroCwd, loc, details: kNoDetails };
  }

  public negativeError(loc: int, limit: string): SourceError {
    return { code: Code.ChildNegative, loc, details: { word: limit } };
  }

  public noSignalError(loc: int, signal: string): SourceError {
    return { code: Code.ChildNoSignal, loc, details: { word: signal } };
  }

  public inputError(loc: int, name: string, found: Type): SourceError {
    const first = this.text.of(found);

    return { code: Code.ChildInput, loc, details: { word: name, first } };
  }

  public bufferTextError(loc: int): SourceError {
    return { code: Code.ChildBufferText, loc, details: kNoDetails };
  }

  public killSignalError(loc: int, found: Type): SourceError {
    const first = this.text.of(found);

    return { code: Code.ChildKillSignal, loc, details: { first } };
  }

  public execShellError(loc: int): SourceError {
    return { code: Code.ChildExecShell, loc, details: kNoDetails };
  }

  public shellFlagError(loc: int, name: string): SourceError {
    return { code: Code.ChildShellFlag, loc, details: { word: name } };
  }

  public shellError(loc: int, found: Type): SourceError {
    const first = this.text.of(found);

    return { code: Code.ChildShell, loc, details: { first } };
  }

  private fileWord(isExec: boolean): string {
    if (isExec) {
      return "command";
    }

    return "program name";
  }
}
