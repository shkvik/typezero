import {
  Checked,
  Details,
  SourceError,
} from "../../../diagnostic/types/message.types.tz";
import { Code } from "../../../diagnostic/code.tz";
import { kNoDetails } from "../../../diagnostic/const/message.const.tz";
import {
  BinaryExpr,
  BinaryOp,
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import {
  FunctionType,
  InstanceType,
  Type,
  TypeKind,
} from "../../../program/type/types/type.types.tz";
import {
  DateFieldValues,
  OperandPair,
} from "../../code/expression-types/types/expression-types.types.tz";
import { kDateName } from "../../types/type-questions/const/type-questions.const.tz";
import {
  kDateLocalLimit,
  kDateSetters,
  kDateStatics,
  kDateTimeLimit,
  kDateYearLimit,
  kDateYearShift,
  kDayMilliseconds,
  kDaysInCycle,
  kEpochYear,
  kFirstTimeField,
  kGetYearName,
  kGmtStringName,
  kHourMilliseconds,
  kLastShortYear,
  kMinuteMilliseconds,
  kMonthDays,
  kMonthNames,
  kMonthStarts,
  kSecondMilliseconds,
  kSetYearName,
  kSetterPrefix,
  kShortYearBase,
  kTimeFieldMost,
  kTimeFieldNames,
  kUnknownYear,
  kUtcSetterPrefix,
  kYearsInCycle,
} from "./const/date-rules.const.tz";
import { TypeStore } from "../../../program/type/type-store/type-store.tz";
import { OperatorRules } from "../../code/operator-rules/operator-rules.tz";
import { SourceTexts } from "../../code/source-texts/source-texts.tz";
import { CallRules } from "../../code/call-rules/call-rules.tz";
import { DateReader } from "../date-reader/date-reader.tz";
import { TypeText } from "../../../program/type/type-text/type-text.tz";
import {
  DateFields,
  DayValue,
} from "../date-reader/types/date-reader.types.tz";
import { TypeQuestions } from "../../types/type-questions/type-questions.tz";
import { CarriedDay } from "./types/date-rules.types.tz";

export class DateRules {
  private readonly types: TypeQuestions;
  private readonly text: TypeText;
  private readonly calls: CallRules;
  private readonly sources: SourceTexts;
  private readonly operators: OperatorRules;
  private readonly store: TypeStore;

  public constructor(
    types: Own<TypeQuestions>,
    text: TypeText,
    calls: Own<CallRules>,
    sources: Own<SourceTexts>,
    operators: Own<OperatorRules>,
    store: TypeStore,
  ) {
    this.types = types;
    this.text = text;
    this.calls = calls;
    this.sources = sources;
    this.operators = operators;
    this.store = store;
  }

  public readonly fieldValue(fields: Read<DateFieldValues>, field: int): int | undefined {
    return fields.values[field - fields.first];
  }

  public readonly isShortYear(fields: Read<DateFieldValues>, year: int): boolean {
    return fields.setter == "" && year >= 0 && year <= kLastShortYear;
  }

  public readonly knownYear(fields: Read<DateFieldValues>): int | undefined {
    const year = this.fieldValue(fields, 0);
    if (year == undefined) {
      return undefined;
    }
    if (this.isShortYear(fields, year)) {
      return kShortYearBase + year;
    }

    return year;
  }

  public readonly nextYearText(year: int | undefined, month: int): string {
    if (year == undefined) {
      return kUnknownYear;
    }
    if (month == 11) {
      return `${year + 1}`;
    }

    return `${year}`;
  }

  public readonly yearPart(year: int | undefined): string {
    if (year == undefined) {
      return "";
    }

    return `${year}, `;
  }

  public readonly monthName(month: int): string {
    return kMonthNames[month] ?? "";
  }

  public readonly daysInMonth(year: int, month: int): int {
    if (month == 1 && this.isLeapYear(year)) {
      return 29;
    }

    return kMonthDays[month] ?? 31;
  }

  public readonly lastDayOf(year: int | undefined, month: int): int {
    if (year != undefined) {
      return this.daysInMonth(year, month);
    }
    if (month == 1) {
      return 29;
    }

    return this.daysInMonth(2001, month);
  }

  public readonly missingDay(year: int | undefined, month: int, day: int): string {
    const name = this.monthName(month);
    if (year == undefined) {
      const after = this.monthName((month + 1) % 12);
      const lack = `${name} has no day ${day}`;

      return `${lack}, and JavaScript would move on to ${after}`;
    }

    const carried = this.carriedDay(year, month, day);
    const lack = `${name} ${year} has no day ${day}`;
    const moved = `${this.monthName(carried.month)} ${carried.day}`;

    return `${lack}, and JavaScript would make it ${moved}`;
  }

  public readonly dateTextOf(expr: Expr): string | undefined {
    if (expr.kind == ExprKind.StringLit) {
      return expr.value;
    }
    if (expr.kind == ExprKind.Template && expr.exprs.length == 0) {
      return expr.quasis[0];
    }

    return undefined;
  }

  public readonly isDateInRange(fields: DateFields): boolean {
    const day = fields.day;
    if (day.year < -kDateYearLimit || day.year > kDateYearLimit) {
      return false;
    }

    const time = fields.time;
    const clock =
      time.hour * kHourMilliseconds +
      time.minute * kMinuteMilliseconds +
      time.second * kSecondMilliseconds +
      time.millisecond;
    const local = this.daysFromEpoch(day) * kDayMilliseconds + clock;
    const zone = fields.zone;
    if (zone.isLocal) {
      return local >= -kDateLocalLimit && local <= kDateLocalLimit;
    }

    const value = local - zone.offset * kSecondMilliseconds;

    return value >= -kDateTimeLimit && value <= kDateTimeLimit;
  }

  public readonly dateValuePlace(type: Type, base: Type): string {
    if (this.types.isOptional(type)) {
      return "; the value may be undefined: check it first";
    }
    if (base.kind == TypeKind.Decimal) {
      return "; convert it with 'Number(x)'";
    }

    return "";
  }

  public readonly jsonExtra(isJson: boolean): int {
    if (isJson) {
      return 1;
    }

    return 0;
  }

  public readonly setterFirst(name: string): int | undefined {
    if (!name.startsWith(kSetterPrefix)) {
      return undefined;
    }

    const field = this.setterField(name);
    const setter = kDateSetters.find((one) => one.name == field);

    return setter?.first;
  }

  public readonly dateMissingError(
    member: MemberExpr,
    instance: InstanceType,
  ): SourceError | undefined {
    const word = member.name;
    const loc = member.loc;

    switch (word) {
      case kGetYearName:
        return { code: Code.DateGetYear, loc, details: kNoDetails };
      case kSetYearName:
        return { code: Code.DateSetYear, loc, details: kNoDetails };
      case kGmtStringName:
        return { code: Code.DateGmtString, loc, details: kNoDetails };
      default:
        return {
          code: Code.PropertyMissing,
          loc,
          details: {
            word,
            first: this.text.of(instance),
          },
        };
    }

    return undefined;
  }

  public readonly dateStaticError(member: MemberExpr): SourceError | undefined {
    const word = member.name;
    const known = kDateStatics.find((one) => one.name == word);
    if (known == undefined) {
      return {
        code: Code.NamespaceMemberMissing,
        loc: member.loc,
        details: {
          word,
          first: kDateName,
        },
      };
    }

    return {
      code: Code.DateStaticRead,
      loc: member.loc,
      details: {
        word,
        other: known.example,
      },
    };
  }

  public readonly dateTextCheck(expr: Expr): SourceError[] {
    const errors: SourceError[] = [];

    const text = this.dateTextOf(expr);
    if (text == undefined) {
      return errors;
    }

    const reader = new DateReader(text);
    const fields = reader.read();
    const loc = expr.loc;
    if (fields == undefined) {
      errors.push({
        code: Code.DateTextUnreadable,
        loc,
        details: { word: text },
      });

      return errors;
    }
    if (fields.isDateOnly) {
      errors.push({
        code: Code.DateTextNoTime,
        loc,
        details: { word: text },
      });

      return errors;
    }

    const day = fields.day;
    if (day.day > this.daysInMonth(day.year, day.month)) {
      const other = this.missingDay(day.year, day.month, day.day);

      errors.push({
        code: Code.DateTextNoDay,
        loc,
        details: {
          word: text,
          other,
        },
      });

      return errors;
    }
    if (!this.isDateInRange(fields)) {
      errors.push({
        code: Code.DateTextOutside,
        loc,
        details: { word: text },
      });
    }

    return errors;
  }

  public readonly fieldErrors(
    fields: Read<DateFieldValues>,
    field: int,
    code: Code,
    details: Details,
  ): SourceError[] {
    const errors: SourceError[] = [];

    const arg = fields.args[field - fields.first]?.expr;
    if (arg != undefined) {
      errors.push({ code, loc: arg.loc, details });
    }

    return errors;
  }

  public readonly dateCountCheck(
    expr: CallExpr,
    member: MemberExpr,
    method: FunctionType,
    extra: int,
  ): Checked<boolean> {
    const params = method.shape.params;
    const least = params.filter((param) => !param.optional).length;
    const most = params.length + extra;
    const count = expr.args.length;
    if (count >= least && count <= most) {
      return { value: true };
    }

    const word = this.calls.argumentCountText(least, most, false);

    return {
      value: false,
      error: {
        code: Code.ArgumentCount,
        loc: member.loc,
        details: {
          word,
          other: `${count}`,
        },
      },
    };
  }

  public readonly dateOperatorError(
    expr: BinaryExpr,
    pair: OperandPair,
  ): SourceError | undefined {
    switch (expr.op) {
      case BinaryOp.Add:
        return { code: Code.DatePlus, loc: expr.loc, details: kNoDetails };
      case BinaryOp.Sub:
        return { code: Code.DateMinus, loc: expr.loc, details: kNoDetails };
      case BinaryOp.Lt:
      case BinaryOp.Le:
      case BinaryOp.Gt:
      case BinaryOp.Ge:
        return {
          code: Code.DateCompare,
          loc: expr.loc,
          details: {
            word: this.sources.operatorText(expr.op),
          },
        };
      default:
        const operandsError = this.operators.operandsError(expr, pair);

        return operandsError;
    }
  }

  public readonly dayInMonthCheck(
    fields: Read<DateFieldValues>,
    day: int,
    month: int,
  ): SourceError[] {
    const errors: SourceError[] = [];

    const year = this.knownYear(fields);
    const last = this.lastDayOf(year, month);
    if (day <= last) {
      return errors;
    }

    const missing = this.missingDay(year, month, day);
    const other = this.monthName(month);

    if (fields.setter == "") {
      const fieldErrors = this.fieldErrors(fields, 2, Code.DateDayLast, {
        word: missing,
        other,
        first: this.nextYearText(year, month),
        second: `${(month + 1) % 12}`,
      });

      for (const found of fieldErrors) {
        errors.push(found);
      }

      return errors;
    }
    if (month == 1) {
      const fieldErrors2 = this.fieldErrors(fields, 2, Code.DateDayFebruary, {
        word: missing,
        other: fields.setter,
        first: this.yearPart(year),
      });

      for (const found of fieldErrors2) {
        errors.push(found);
      }

      return errors;
    }

    const fieldErrors3 = this.fieldErrors(fields, 2, Code.DateDayCount, {
      word: missing,
      other,
      first: `${last}`,
    });

    for (const found of fieldErrors3) {
      errors.push(found);
    }

    return errors;
  }

  public readonly timeFieldsCheck(fields: Read<DateFieldValues>): SourceError[] {
    const errors: SourceError[] = [];

    const end = fields.first + fields.args.length;
    const start = Math.max(fields.first, kFirstTimeField);

    for (let field = start; field < end; field++) {
      const value = this.fieldValue(fields, field);
      const most = kTimeFieldMost[field - kFirstTimeField];
      const other = kTimeFieldNames[field - kFirstTimeField];
      if (value == undefined || most == undefined || other == undefined) {
        continue;
      }
      if (value >= 0 && value <= most) {
        continue;
      }

      const fieldErrors = this.fieldErrors(fields, field, Code.DateTimeRange, {
        word: `${value}`,
        other,
        first: `${most}`,
      });

      for (const found of fieldErrors) {
        errors.push(found);
      }
    }

    return errors;
  }

  public readonly yearFieldCheck(fields: Read<DateFieldValues>): SourceError[] {
    const errors: SourceError[] = [];

    const year = this.fieldValue(fields, 0);
    if (year == undefined || !this.isShortYear(fields, year)) {
      return errors;
    }

    const fieldErrors = this.fieldErrors(fields, 0, Code.DateYearShort, {
      word: `${year}`,
      other: `${kShortYearBase + year}`,
    });

    for (const found of fieldErrors) {
      errors.push(found);
    }

    return errors;
  }

  public readonly dateComparisonErrors(
    expr: BinaryExpr,
    pair: OperandPair,
  ): SourceError[] {
    const errors: SourceError[] = [];

    const isBoth =
      this.types.isDate(pair.left) && this.types.isDate(pair.right);
    if (!isBoth) {
      const dateOperatorError = this.dateOperatorError(expr, pair);

      if (dateOperatorError != undefined) {
        errors.push(dateOperatorError);
      }
    }

    return errors;
  }

  public readonly dayFieldCheck(
    fields: Read<DateFieldValues>,
    month: int | undefined,
  ): SourceError[] {
    const errors: SourceError[] = [];

    const day = this.fieldValue(fields, 2);
    if (day == undefined) {
      return errors;
    }
    if (day < 0) {
      const fieldErrors = this.fieldErrors(fields, 2, Code.DateDayBelow, {
        word: `${day}`,
      });

      for (const found of fieldErrors) {
        errors.push(found);
      }

      return errors;
    }
    if (month != undefined) {
      const dayInMonthErrors = this.dayInMonthCheck(fields, day, month);

      for (const found of dayInMonthErrors) {
        errors.push(found);
      }

      return errors;
    }
    if (day > 31) {
      const fieldErrors2 = this.fieldErrors(fields, 2, Code.DateDayAbove, {
        word: `${day}`,
      });

      for (const found of fieldErrors2) {
        errors.push(found);
      }
    }

    return errors;
  }

  public readonly dateArithmetic(expr: BinaryExpr, pair: OperandPair): Checked<Type> {
    const isBoth =
      this.types.isDate(pair.left) && this.types.isDate(pair.right);
    if (isBoth && expr.op == BinaryOp.Sub) {
      return { value: this.store.integer(64, false) };
    }

    const dateOperatorError = this.dateOperatorError(expr, pair);

    return {
      value: this.store.plain(TypeKind.Error),
      error: dateOperatorError,
    };
  }

  public readonly dateStaticRead(expr: MemberExpr): Checked<Type> {
    const dateStaticError = this.dateStaticError(expr);

    return { value: this.store.plain(TypeKind.Error), error: dateStaticError };
  }

  public readonly validMonth(fields: Read<DateFieldValues>): Checked<int | undefined> {
    const month = this.fieldValue(fields, 1);
    if (month == undefined || (month >= 0 && month <= 11)) {
      return { value: month };
    }
    if (month == 12) {
      const next = this.fieldErrors(fields, 1, Code.DateMonthNext, kNoDetails);

      return { value: undefined, error: next[0] };
    }

    const outside = this.fieldErrors(fields, 1, Code.DateMonthOutside, {
      word: `${month}`,
    });

    return { value: undefined, error: outside[0] };
  }

  private readonly isLeapYear(year: int): boolean {
    const isCentury = year % 100 == 0;

    return year % 4 == 0 && (!isCentury || year % 400 == 0);
  }

  private readonly carriedDay(year: int, month: int, day: int): CarriedDay {
    const cycles = (day - 1) / kDaysInCycle;
    let currentYear = year + cycles * kYearsInCycle;
    let currentMonth = month;
    let currentDay = day - cycles * kDaysInCycle;

    while (currentDay > this.daysInMonth(currentYear, currentMonth)) {
      currentDay -= this.daysInMonth(currentYear, currentMonth);
      currentMonth += 1;

      if (currentMonth == 12) {
        currentMonth = 0;
        currentYear += 1;
      }
    }

    return { month: currentMonth, day: currentDay };
  }

  private readonly daysFromEpoch(day: DayValue): int {
    const shifted = day.year + kDateYearShift;
    const epoch = kEpochYear + kDateYearShift;
    const before = this.shiftedDays(shifted) - this.shiftedDays(epoch);
    const start = kMonthStarts[day.month] ?? 0;
    const isLeapShift = this.isLeapYear(day.year) && day.month >= 2;
    const leap = this.leapDay(isLeapShift);

    return before + start + leap - 1 + day.day;
  }

  private readonly shiftedDays(shifted: int): int {
    return 365 * shifted + shifted / 4 - shifted / 100 + shifted / 400;
  }

  private readonly leapDay(isLeap: boolean): int {
    if (isLeap) {
      return 1;
    }

    return 0;
  }

  private readonly setterField(name: string): string {
    if (name.startsWith(kUtcSetterPrefix)) {
      return name.slice(kUtcSetterPrefix.length);
    }

    return name.slice(kSetterPrefix.length);
  }
}
