import { Code } from "../../../diagnostic/code.tz";
import { kNoDetails } from "../../../diagnostic/const/message.const.tz";
import { SourceError } from "../../../diagnostic/types/message.types.tz";
import { TypeText } from "../../../program/type/type-text/type-text.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import { ModuleQuestions } from "../../declaration/module-questions/module-questions.tz";
import { TypeQuestions } from "../../types/type-questions/type-questions.tz";
import {
  kDerefName,
  kUnsupportedTargets,
  kWeakRefName,
} from "./const/weak-ref-rules.const.tz";

export class WeakRefRules {
  private readonly text: TypeText;
  private readonly types: TypeQuestions;
  private readonly modules: ModuleQuestions;

  public constructor(
    text: TypeText,
    types: Own<TypeQuestions>,
    modules: Own<ModuleQuestions>,
  ) {
    this.text = text;
    this.types = types;
    this.modules = modules;
  }

  public readonly isWeakRef(type: Type): boolean {
    const base = this.types.definedType(type);

    return (
      base.kind == TypeKind.Instance &&
      base.name == kWeakRefName &&
      this.modules.isLibraryModule(base.module)
    );
  }

  public readonly isWeakRefName(name: string): boolean {
    return name == kWeakRefName;
  }

  public readonly isDeref(name: string): boolean {
    return name == kDerefName;
  }

  public readonly targetError(loc: int, target: Type): SourceError | undefined {
    const base = this.types.definedType(target);
    if (this.isUnknownYet(base)) {
      return undefined;
    }

    const isUnsupported =
      base.kind == TypeKind.Instance &&
      this.modules.isLibraryModule(base.module) &&
      kUnsupportedTargets.includes(base.name);
    if (isUnsupported) {
      const word = this.text.of(base);

      return { code: Code.WeakRefNotYet, loc, details: { word } };
    }

    const isObject =
      (base.kind == TypeKind.Object ||
        base.kind == TypeKind.Instance ||
        base.kind == TypeKind.Tuple ||
        base.kind == TypeKind.Dict) &&
      !this.isWeakRef(base);
    if (isObject && !this.types.isOptional(target)) {
      return undefined;
    }

    const word = this.text.of(target);
    const other = this.objectHint(this.types.isOptional(target));

    return { code: Code.WeakRefNotObject, loc, details: { word, other } };
  }

  public readonly oneObjectError(loc: int): SourceError {
    return { code: Code.WeakRefOneObject, loc, details: kNoDetails };
  }

  public readonly typeArgumentsError(loc: int): SourceError {
    return { code: Code.WeakRefTypeArguments, loc, details: kNoDetails };
  }

  public readonly noMethodError(loc: int, name: string, type: Type): SourceError {
    const first = this.text.of(type);

    return { code: Code.WeakRefNoMethod, loc, details: { word: name, first } };
  }

  public readonly derefValueError(loc: int, name: string): SourceError {
    return { code: Code.WeakRefDerefValue, loc, details: { word: name } };
  }

  public readonly readError(loc: int, name: string, type: Type): SourceError {
    if (this.isDeref(name)) {
      return this.derefValueError(loc, name);
    }

    return this.noMethodError(loc, name, type);
  }

  private readonly objectHint(isOptional: boolean): string {
    if (isOptional) {
      return "; make it of the object and check for undefined before";
    }

    return "; hold the value itself";
  }

  private readonly isUnknownYet(type: Type): boolean {
    return (
      type.kind == TypeKind.Error ||
      type.kind == TypeKind.TypeParameter ||
      type.kind == TypeKind.Operation
    );
  }
}
