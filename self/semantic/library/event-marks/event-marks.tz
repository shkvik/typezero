import {
  DroppedNew,
  ErrorEmit,
  ErrorPending,
  EventListen,
  FirstEmit,
} from "./types/event-marks.types.tz";

export class EventMarks {
  public errorEmits: ErrorEmit[];
  public errorListened: Set<string>;
  public encodedStreams: Set<string>;
  public listenedStreams: Map<string, string>;
  public emittedNames: Map<string, string[]>;
  public firstEmits: Map<string, FirstEmit>;
  public listens: EventListen[];
  public looseEmitModules: Set<int>;
  public selfListeners: Set<string>;
  public droppedNews: DroppedNew[];
  public errorPending: ErrorPending[];

  public constructor() {
    this.errorEmits = [];
    this.errorListened = new Set<string>();
    this.encodedStreams = new Set<string>();
    this.listenedStreams = new Map<string, string>();
    this.emittedNames = new Map<string, string[]>();
    this.firstEmits = new Map<string, FirstEmit>();
    this.listens = [];
    this.looseEmitModules = new Set<int>();
    this.selfListeners = new Set<string>();
    this.droppedNews = [];
    this.errorPending = [];
  }
}
