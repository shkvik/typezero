import {
  DroppedNew,
  ErrorEmit,
  ErrorPending,
  EventListen,
  FirstEmit,
} from "./types/event-marks.types.tz";

export class EventMarks {
  public errorEmits: Cell<ErrorEmit[]>;
  public errorListened: Cell<Set<string>>;
  public encodedStreams: Cell<Set<string>>;
  public listenedStreams: Cell<Map<string, string>>;
  public emittedNames: Cell<Map<string, string[]>>;
  public firstEmits: Cell<Map<string, FirstEmit>>;
  public listens: Cell<EventListen[]>;
  public looseEmitModules: Cell<Set<int>>;
  public selfListeners: Cell<Set<string>>;
  public droppedNews: Cell<DroppedNew[]>;
  public errorPending: Cell<ErrorPending[]>;

  public constructor() {
    this.errorEmits = [];
    this.errorListened = new Set<string>();
    this.encodedStreams = new Set<string>();
    this.listenedStreams = new Map<string, string>();
    this.emittedNames = new Map<string, string[]>();
    this.firstEmits = new Map<string, FirstEmit>();
    this.listens = [];
    this.looseEmitModules = new Set<int>();
    this.selfListeners = new Set<string>();
    this.droppedNews = [];
    this.errorPending = [];
  }
}

export type InternedEventMarks = Interned<EventMarks>;
