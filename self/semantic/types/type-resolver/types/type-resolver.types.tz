import { Code } from "../../../../diagnostic/code.tz";
import {
  Details,
  SourceError,
} from "../../../../diagnostic/types/message.types.tz";
import {
  ClassDecl,
  EnumDecl,
  HandleDecl,
  TypeAliasDecl,
} from "../../../../program/ast/types/ast.types.classes.tz";
import { DeclaredClass } from "../../../../program/ast/types/ast.types.declarations.tz";
import { ParamKind } from "../../../../program/ast/types/ast.types.functions.tz";
import {
  MappedTypeForm,
  TypeRef,
} from "../../../../program/ast/types/ast.types.types.tz";
import { NameUse } from "../../../../program/scopes/types/scopes.types.tz";
import {
  ObjectField,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";

export enum PlainBuiltin {
  Int,
  Int8,
  Int16,
  Int32,
  Uint8,
  Uint16,
  Uint32,
  Uint64,
  Wrap32,
  Wrap64,
  Double,
  String,
  Boolean,
  Decimal,
  Json,
  Unknown,
  Never,
  Void,
  Undefined,
  AnyObject,
}

export enum GenericBuiltin {
  Array,
  Result,
  Promise,
  Map,
  Set,
  Record,
  Generator,
  AsyncGenerator,
}

export enum TextChange {
  Capitalize,
  Uncapitalize,
  Uppercase,
  Lowercase,
}

export type TextChangeName = {
  readonly name: string;
  readonly change: TextChange;
};

export type PlainTypeName = {
  readonly name: string;
  readonly type: PlainBuiltin;
};

export type GenericTypeName = {
  readonly name: string;
  readonly type: GenericBuiltin;
  readonly least: int;
  readonly most: int;
  readonly example: string;
  readonly values: int;
};

export type JsonKind = {
  readonly kind: TypeKind;
  readonly name: string;
};

export type TypeDeclaration = TypeAliasDecl | ClassDecl | EnumDecl | HandleDecl;

export enum TypePlace {
  Plain,
  Pattern,
  RestParameter,
  Base,
}

export type TypeContext = {
  readonly module: int;
  readonly bindings: Map<int, Type>;
  readonly place: TypePlace;
};

export type ModuleOrigin = {
  readonly library: boolean;
  readonly native: boolean;
};

export type ModuleRecord = {
  readonly library: boolean;
  readonly native: boolean;
  readonly uses: Map<int, NameUse>;
  readonly declarations: Map<string, TypeDeclaration>;
  readonly classes: Map<string, DeclaredClass>;
  readonly errors: SourceError[];
  readonly reported: Set<string>;
};

export type ClassHome = {
  readonly module: int;
  readonly name: string;
  readonly loc: int;
};

export type ParameterSite = {
  readonly name: string;
  readonly loc: int;
  readonly kind: ParamKind;
  readonly type: TypeRef;
  readonly isDeclared: boolean;
};

export enum UnionSlot {
  None,
  Number,
  Array,
  Function,
  Iterator,
  AsyncIterator,
  Promise,
  Untagged,
}

export type SlotUse = {
  readonly slot: UnionSlot;
  readonly home: int;
  readonly type: Type;
};

export type UnionProblem = {
  readonly code: Code;
  readonly details: Details;
};

export enum DoorState {
  InWork,
  Done,
}

export type AliasDoor = {
  state: DoorState;
  entered: boolean;
  result: Type;
  readonly reserved?: Type;
};

export type MappedPlan = {
  readonly form: MappedTypeForm;
  readonly value: TypeRef;
  readonly rename?: TypeRef;
  readonly source: ObjectField[];
  readonly identity: boolean;
};

export type Distribution = {
  readonly loc: int;
  readonly parts: Type[];
};

export type EnumStep = {
  readonly type: Type;
  readonly number?: int;
};
