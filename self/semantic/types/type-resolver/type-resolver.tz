import "./partial/type-resolver.partial.builtins.tz";
import "./partial/type-resolver.partial.forms.tz";
import "./partial/type-resolver.partial.declared.tz";
import "./partial/type-resolver.partial.aliases.tz";
import "./partial/type-resolver.partial.alias-growth.tz";
import "./partial/type-resolver.partial.enums.tz";
import "./partial/type-resolver.partial.enum-values.tz";
import "./partial/type-resolver.partial.modules.tz";
import "./partial/type-resolver.partial.globals.tz";
import "./partial/type-resolver.partial.operations.tz";
import "./partial/type-resolver.partial.intersections.tz";
import "./partial/type-resolver.partial.members.tz";
import "./partial/type-resolver.partial.mapped.tz";
import "./partial/type-resolver.partial.templates.tz";
import "./partial/type-resolver.partial.conditionals.tz";
import "./partial/type-resolver.partial.rules.tz";
import "./partial/type-resolver.partial.unions.tz";
import "./partial/type-resolver.partial.signatures.tz";
import "./partial/type-resolver.partial.constraints.tz";
import "./partial/type-resolver.partial.methods.tz";
import "./partial/type-resolver.partial.library.tz";
import "./partial/type-resolver.partial.substitution.tz";
import "./partial/type-resolver.partial.class-values.tz";
import { Code } from "../../../diagnostic/code.tz";
import {
  Details,
  SourceError,
} from "../../../diagnostic/types/message.types.tz";
import {
  EnumDecl,
  TypeAliasDecl,
} from "../../../program/ast/types/ast.types.classes.tz";
import {
  TypeRef,
  TypeRefKind,
} from "../../../program/ast/types/ast.types.types.tz";
import { Program } from "../../../program/module/types/module.types.tz";
import { ModuleScopes } from "../../../program/scopes/types/scopes.types.tz";
import { TypeStore } from "../../../program/type/type-store/type-store.tz";
import { TypeText } from "../../../program/type/type-text/type-text.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import { TypeRelation } from "../type-relation/type-relation.tz";
import {
  AliasDoor,
  AliasOrigin,
  EnumStep,
  ModuleRecord,
  TypeContext,
} from "./types/type-resolver.types.tz";
import { ErrorLog } from "../../../diagnostic/error-log/error-log.tz";
import { ModuleQuestions } from "../../declaration/module-questions/module-questions.tz";
import { WeakRefRules } from "../../library/weak-ref-rules/weak-ref-rules.tz";
import { TypeQuestions } from "../type-questions/type-questions.tz";

export class TypeResolver {
  private readonly store: TypeStore;
  private readonly text: TypeText;
  private readonly relation: TypeRelation;
  private readonly program: Program;
  private scopes: Cell<Map<int, ModuleScopes>>;
  private records: Cell<Map<int, ModuleRecord>>;
  private doors: Cell<Map<string, AliasDoor>>;
  private working: Cell<Map<string, int>>;
  private nesting: Cell<Map<string, int>>;
  private tailUses: Cell<Set<TypeRef>>;
  private endless: Cell<Set<string>>;
  private bounded: Cell<Set<int>>;
  private holes: Cell<Set<int>>;
  private globals: Cell<Map<string, int>>;
  private namespaces: Cell<Map<string, int>>;
  private prefixes: Cell<Map<int, string>>;
  private libraryShapes: Cell<Set<int>>;
  private aliasOrigins: Cell<Map<int, AliasOrigin>>;
  private extending: Cell<TypeAliasDecl[]>;
  private enumCache: Cell<Map<string, EnumStep[]>>;
  private enumOpen: Cell<Set<string>>;
  private readonly errors: ErrorLog;
  private readonly weakRefs: WeakRefRules;

  public constructor(
    store: TypeStore,
    program: Own<Program>,
    resolved: Read<ModuleScopes[]>,
  ) {
    this.store = store;
    this.text = new TypeText(store);
    this.relation = new TypeRelation(store);
    this.program = program;
    this.scopes = new Map<int, ModuleScopes>();
    this.records = new Map<int, ModuleRecord>();
    this.doors = new Map<string, AliasDoor>();
    this.working = new Map<string, int>();
    this.nesting = new Map<string, int>();
    this.tailUses = new Set<TypeRef>();
    this.endless = new Set<string>();
    this.bounded = new Set<int>();
    this.holes = new Set<int>();
    this.globals = new Map<string, int>();
    this.namespaces = new Map<string, int>();
    this.prefixes = new Map<int, string>();
    this.libraryShapes = new Set<int>();
    this.aliasOrigins = new Map<int, AliasOrigin>();
    this.extending = [];
    this.enumCache = new Map<string, EnumStep[]>();
    this.enumOpen = new Set<string>();
    this.errors = new ErrorLog();
    this.weakRefs = new WeakRefRules(
      this.text,
      new TypeQuestions(store, this.relation),
      new ModuleQuestions(this.program),
    );

    for (const scopes of resolved) {
      this.scopes.set(scopes.module.id, scopes);
    }

    this.indexGlobals();
  }

  public readonly problems(module: int): SourceError[] {
    return this.errors.of(module);
  }

  public readonly resolve(ref: TypeRef, context: TypeContext): Type {
    const form = ref.form;

    switch (form.kind) {
      case TypeRefKind.Name:
      case TypeRefKind.Generic:
        return this.named(ref, context);
      case TypeRefKind.Array: {
        const items = this.resolveAll(ref.args, context);
        const error = this.store.plain(TypeKind.Error);
        const item = items[0] ?? error;

        return this.listOf(ref, item, form.readonly, context);
      }
      case TypeRefKind.Union:
        return this.union(ref, context);
      case TypeRefKind.Tuple:
        return this.tuple(ref, form, context);
      case TypeRefKind.Object:
        return this.object(form, context, false);
      case TypeRefKind.Function:
        return this.functionType(form, context);
      case TypeRefKind.Literal:
        return this.literal(ref.name, form);
      case TypeRefKind.Predicate:
        return this.store.plain(TypeKind.Boolean);
      case TypeRefKind.KeyOf:
        return this.keyOf(ref, context);
      case TypeRefKind.Indexed:
        return this.indexed(ref, context);
      case TypeRefKind.Mapped:
        return this.mapped(ref, form, context);
      case TypeRefKind.Conditional:
        return this.conditional(ref, context);
      case TypeRefKind.Template:
        return this.template(ref, form, context);
      case TypeRefKind.Intersection:
        return this.intersection(ref, context);
      case TypeRefKind.Infer:
        return this.inferred(ref, context);
      case TypeRefKind.TypeOf:
        return this.typeOfClass(ref, context);
      default:
        return this.store.plain(TypeKind.Error);
    }
  }

  public readonly declaredAlias(module: int, decl: TypeAliasDecl): Type {
    const written: Type[] = [];

    this.builtinAliasCheck(module, decl);
    this.aliasGrowthCheck(module, decl);

    for (const param of decl.typeParams) {
      const name = param.name;
      const type = this.opened(module, param.loc, name, param.constraint);

      written.push(type);
    }

    return this.alias(module, decl, written, false);
  }

  public readonly declaredEnum(module: int, decl: EnumDecl): Type {
    const values = this.enumValues(module, decl);

    return this.enumWhole(decl, values);
  }

  private readonly resolveAll(refs: Read<TypeRef[]>, context: TypeContext): Type[] {
    const types: Type[] = [];

    for (const ref of refs) {
      const type = this.resolve(ref, context);

      types.push(type);
    }

    return types;
  }

  private readonly named(ref: TypeRef, context: TypeContext): Type {
    const record = this.record(context.module);
    const use = record?.uses.get(ref.loc);
    const symbol = use?.symbol;
    if (symbol == undefined || this.isBuiltinShadow(symbol)) {
      return this.global(ref, context);
    }

    return this.declared(ref, symbol, context);
  }

  private readonly report(module: int, loc: int, code: Code, details: Details): void {
    const record = this.record(module);
    if (record == undefined) {
      return;
    }

    this.errors.write(module, loc, code, details);
  }
}

export type InternedTypeResolver = Interned<TypeResolver>;
