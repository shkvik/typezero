import "./partial/type-resolver.partial.builtins.tz";
import "./partial/type-resolver.partial.forms.tz";
import "./partial/type-resolver.partial.declared.tz";
import "./partial/type-resolver.partial.aliases.tz";
import "./partial/type-resolver.partial.enums.tz";
import { Code } from "../../../diagnostic/code.tz";
import {
  Details,
  SourceError,
} from "../../../diagnostic/types/message.types.tz";
import {
  EnumDecl,
  TypeAliasDecl,
} from "../../../program/ast/types/ast.types.classes.tz";
import { StmtKind } from "../../../program/ast/types/ast.types.statements.tz";
import {
  TypeRef,
  TypeRefKind,
} from "../../../program/ast/types/ast.types.types.tz";
import {
  ModuleScopes,
  NameUse,
} from "../../../program/scopes/types/scopes.types.tz";
import { TypeStore } from "../../../program/type/type-store/type-store.tz";
import { TypeText } from "../../../program/type/type-text/type-text.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import {
  AliasDoor,
  ModuleRecord,
  TypeContext,
  TypeDeclaration,
} from "./types/type-resolver.types.tz";

export class TypeResolver {
  private readonly store: TypeStore;
  private readonly text: TypeText;
  private readonly scopes: Map<int, ModuleScopes>;
  private readonly records: Map<int, ModuleRecord>;
  private readonly doors: Map<string, AliasDoor>;

  public constructor(store: TypeStore, resolved: ModuleScopes[]) {
    this.store = store;
    this.text = new TypeText(store);
    this.scopes = new Map<int, ModuleScopes>();
    this.records = new Map<int, ModuleRecord>();
    this.doors = new Map<string, AliasDoor>();

    for (const scopes of resolved) {
      this.scopes.set(scopes.module.id, scopes);
    }
  }

  public problems(module: int): SourceError[] {
    const record = this.records.get(module);
    if (record == undefined) {
      return [];
    }

    return record.errors;
  }

  public resolve(ref: TypeRef, context: TypeContext): Type {
    const form = ref.form;

    switch (form.kind) {
      case TypeRefKind.Name:
      case TypeRefKind.Generic:
        return this.named(ref, context);
      case TypeRefKind.Array: {
        const items = this.resolveAll(ref.args, context);
        const error = this.store.plain(TypeKind.Error);
        const item = items[0] ?? error;

        return this.store.arrayOf(item);
      }
      case TypeRefKind.Union: {
        const parts = this.resolveAll(ref.args, context);

        return this.store.unionOf(parts);
      }
      case TypeRefKind.Tuple:
        return this.tuple(form, context);
      case TypeRefKind.Object:
        return this.object(form, context);
      case TypeRefKind.Function:
        return this.functionType(form, context);
      case TypeRefKind.Literal:
        return this.literal(ref.name, form);
      case TypeRefKind.Predicate:
        return this.store.plain(TypeKind.Boolean);
      default:
        return this.store.plain(TypeKind.Error);
    }
  }

  public declaredAlias(module: int, decl: TypeAliasDecl): Type {
    const written: Type[] = [];

    for (const param of decl.typeParams) {
      const type = this.store.typeParameter(module, param.loc, param.name);

      written.push(type);
    }

    return this.alias(module, decl, written);
  }

  public declaredEnum(decl: EnumDecl): Type {
    const values = this.enumValues(decl);

    return this.enumWhole(decl, values);
  }

  private resolveAll(refs: TypeRef[], context: TypeContext): Type[] {
    const types: Type[] = [];

    for (const ref of refs) {
      const type = this.resolve(ref, context);

      types.push(type);
    }

    return types;
  }

  private named(ref: TypeRef, context: TypeContext): Type {
    const record = this.record(context.module);
    const use = record?.uses.get(ref.loc);
    if (use == undefined) {
      return this.store.plain(TypeKind.Error);
    }

    const symbol = use.symbol;
    if (symbol == undefined) {
      return this.builtin(ref, context);
    }

    return this.declared(ref, symbol, context);
  }

  private record(module: int): ModuleRecord | undefined {
    const known = this.records.get(module);
    if (known != undefined) {
      return known;
    }

    const scopes = this.scopes.get(module);
    if (scopes == undefined) {
      return undefined;
    }

    const uses = new Map<int, NameUse>();
    const declarations = new Map<string, TypeDeclaration>();

    for (const use of scopes.uses) {
      if (use.isType) {
        uses.set(use.loc, use);
      }
    }

    for (const item of scopes.module.file.items) {
      switch (item.kind) {
        case StmtKind.TypeAlias:
        case StmtKind.Enum:
        case StmtKind.Handle:
          declarations.set(item.name, item);
          break;
        case StmtKind.Class:
          declarations.set(item.name ?? "", item);
          break;
        default:
          break;
      }
    }

    const record: ModuleRecord = { uses, declarations, errors: [] };

    this.records.set(module, record);

    return record;
  }

  private report(module: int, loc: int, code: Code, details: Details): void {
    const record = this.record(module);
    if (record != undefined) {
      record.errors.push({ code, loc, details });
    }
  }
}
