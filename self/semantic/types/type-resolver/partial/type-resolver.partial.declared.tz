import { TypeResolver } from "../type-resolver.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { ClassDecl } from "../../../../program/ast/types/ast.types.classes.tz";
import { StmtKind } from "../../../../program/ast/types/ast.types.statements.tz";
import {
  TypeParamDecl,
  TypeRef,
} from "../../../../program/ast/types/ast.types.types.tz";
import {
  NameSymbol,
  SymbolKind,
} from "../../../../program/scopes/types/scopes.types.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";
import {
  ClassHome,
  TypeContext,
  TypeDeclaration,
  TypePlace,
} from "../types/type-resolver.types.tz";

partial class TypeResolver {
  private declared(
    ref: TypeRef,
    symbol: NameSymbol,
    context: TypeContext,
  ): Type {
    switch (symbol.kind) {
      case SymbolKind.TypeParameter:
        return this.parameter(ref, symbol, context);
      case SymbolKind.Import:
        return this.imported(ref, symbol, context);
      default: {
        const record = this.record(context.module);
        const found = record?.declarations.get(symbol.name);
        if (found == undefined) {
          return this.fromModule(ref, context.module, symbol.name, context);
        }
        if (found.loc != symbol.loc) {
          return this.store.plain(TypeKind.Error);
        }
        if (this.prefixes.has(context.module)) {
          const builtin = this.builtin(symbol.name, ref, context);
          if (builtin != undefined) {
            return builtin;
          }
        }

        return this.ofDeclaration(ref, context.module, found, context);
      }
    }
  }

  private parameter(
    ref: TypeRef,
    symbol: NameSymbol,
    context: TypeContext,
  ): Type {
    if (ref.args.length > 0) {
      this.report(context.module, ref.loc, Code.TypeNotGeneric, {
        word: symbol.name,
      });

      return this.store.plain(TypeKind.Error);
    }

    const bound = context.bindings.get(symbol.loc);
    if (bound != undefined) {
      return bound;
    }

    return this.opened(
      context.module,
      symbol.loc,
      symbol.name,
      symbol.constraint,
    );
  }

  private imported(
    ref: TypeRef,
    symbol: NameSymbol,
    context: TypeContext,
  ): Type {
    const target = symbol.target;
    if (target == undefined) {
      return this.store.plain(TypeKind.Error);
    }
    if (!this.declaresType(target.module, target.name)) {
      return this.global(ref, context);
    }

    return this.fromModule(ref, target.module, target.name, context);
  }

  private declaresType(module: int, name: string): boolean {
    const record = this.record(module);
    if (record == undefined || this.prefixes.has(module)) {
      return true;
    }

    return record.declarations.has(name) || record.classes.has(name);
  }

  private ofDeclaration(
    ref: TypeRef,
    module: int,
    found: TypeDeclaration,
    context: TypeContext,
  ): Type {
    switch (found.kind) {
      case StmtKind.TypeAlias: {
        const name = found.name;
        const params = found.typeParams;
        const written = this.written(ref, name, params, context);
        const fits =
          written != undefined &&
          this.argumentsFit(ref, module, name, params, written, context);
        if (written == undefined || !fits) {
          return this.store.plain(TypeKind.Error);
        }

        return this.alias(module, found, written);
      }
      case StmtKind.Class: {
        const name = found.name ?? "";
        const params = found.typeParams;
        const written = this.written(ref, name, params, context);
        const fits =
          written != undefined &&
          this.argumentsFit(ref, module, name, params, written, context);
        if (written == undefined || !fits) {
          return this.store.plain(TypeKind.Error);
        }

        const parents = this.parentRefs(found.base, found.interfaces);
        const home: ClassHome = { module, name, loc: found.loc };

        return this.instance(home, params, written, parents);
      }
      case StmtKind.Enum: {
        const written = this.written(ref, found.name, [], context);
        if (written == undefined) {
          return this.store.plain(TypeKind.Error);
        }

        return this.enumType(ref, found);
      }
      default: {
        const written = this.written(ref, found.name, [], context);
        if (written == undefined) {
          return this.store.plain(TypeKind.Error);
        }

        return this.store.instanceOf(module, found.loc, found.name, []);
      }
    }
  }

  private written(
    ref: TypeRef,
    name: string,
    params: TypeParamDecl[],
    context: TypeContext,
  ): Type[] | undefined {
    const count = ref.args.length;
    if (context.place == TypePlace.Base && count == 0 && params.length > 0) {
      return undefined;
    }
    if (params.length == 0 && count > 0) {
      this.report(context.module, ref.loc, Code.TypeNotGeneric, {
        word: name,
      });

      return undefined;
    }

    const needed = this.neededCount(params);
    if (count < needed || count > params.length) {
      const names = params.map((param) => param.name);

      this.report(context.module, ref.loc, Code.TypeArgumentsCount, {
        word: name,
        other: `${name}<${names.join(", ")}>`,
      });

      return undefined;
    }

    return this.resolveAll(ref.args, context);
  }

  private neededCount(params: TypeParamDecl[]): int {
    let needed = 0;

    for (const param of params) {
      if (param.defaultType == undefined) {
        needed += 1;
      }
    }

    return needed;
  }

  public classInstance(module: int, decl: ClassDecl, written: Type[]): Type {
    const name = decl.name ?? "";
    const parents = this.parentRefs(decl.base, decl.interfaces);
    const home: ClassHome = { module, name, loc: decl.loc };

    return this.instance(home, decl.typeParams, written, parents);
  }

  private parentRefs(base: TypeRef | undefined, others: TypeRef[]): TypeRef[] {
    if (base == undefined) {
      return others;
    }

    return [base].concat(others);
  }

  private instance(
    home: ClassHome,
    params: TypeParamDecl[],
    written: Type[],
    parents: TypeRef[],
  ): Type {
    const module = home.module;
    const bindings = this.bind(module, params, written);
    const args = Array.from(bindings.values());
    const type = this.store.instanceOf(module, home.loc, home.name, args);
    const label = this.labelText(module, home.name, written);

    this.store.label(type, label);

    if (this.store.hasParents(type)) {
      return type;
    }

    this.store.inherit(type, []);

    const inside: TypeContext = { module, bindings, place: TypePlace.Base };
    const resolved: Type[] = [];

    for (const parent of parents) {
      const found = this.resolve(parent, inside);
      if (found.kind != TypeKind.Error) {
        resolved.push(found);
      }
    }

    this.store.inherit(type, resolved);

    return type;
  }

  private bind(
    module: int,
    params: TypeParamDecl[],
    written: Type[],
  ): Map<int, Type> {
    const bindings = new Map<int, Type>();

    for (let index = 0; index < params.length; index++) {
      const param = params[index];
      const given = written[index];
      if (given != undefined) {
        bindings.set(param.loc, given);

        continue;
      }

      const filled = this.defaultArgument(param, {
        module,
        bindings,
        place: TypePlace.Plain,
      });

      bindings.set(param.loc, filled);
    }

    return bindings;
  }

  private defaultArgument(param: TypeParamDecl, context: TypeContext): Type {
    const written = param.defaultType;
    if (written == undefined) {
      return this.store.plain(TypeKind.Error);
    }

    return this.resolve(written, context);
  }

  private labelText(module: int, name: string, written: Type[]): string {
    const prefix = this.prefixes.get(module) ?? "";

    if (written.length == 0) {
      return `${prefix}${name}`;
    }

    const texts = written.map((type) => this.text.of(type));

    return `${prefix}${name}<${texts.join(", ")}>`;
  }
}
