import { TypeResolver } from "../type-resolver.tz";
import {
  BinaryExpr,
  BinaryOp,
  Expr,
  ExprKind,
  MemberExpr,
  UnaryExpr,
  UnaryOp,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import {
  LiteralKind,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import {
  kBitSpan,
  kExponentLimit,
  kEndlessText,
  kExponentDigits,
  kFloorRounding,
  kNotNumberText,
  kPowerLimit,
  kShiftLimit,
  kShiftSpan,
  kShownPrecision,
  kSignBit,
} from "../const/type-resolver.const.tables.tz";
import {
  EnumConstant,
  EnumFrame,
  EnumStep,
} from "../types/type-resolver.types.tz";

partial class TypeResolver {
  private readonly enumConstant(
    expr: Expr,
    frame: EnumFrame,
  ): EnumConstant | undefined {
    switch (expr.kind) {
      case ExprKind.IntLit: {
        const value = decimal(expr.value);

        return this.numberConstant(value);
      }
      case ExprKind.FloatLit: {
        const value = decimal(expr.value);

        return this.numberConstant(value);
      }
      case ExprKind.StringLit:
        return this.textConstant(expr.value);
      case ExprKind.Template:
        return this.templateConstant(expr.quasis, expr.exprs);
      case ExprKind.Name:
        return this.ownMemberConstant(frame, expr.name);
      case ExprKind.Member:
        return this.otherMemberConstant(expr, frame);
      case ExprKind.Unary:
        return this.unaryConstant(expr, frame);
      case ExprKind.Binary:
        return this.binaryConstant(expr, frame);
      default:
        return undefined;
    }
  }

  private readonly numberConstant(number: decimal): EnumConstant {
    return { isText: false, number, text: "" };
  }

  private readonly endlessConstant(shown: string): EnumConstant {
    return { isText: false, number: 0, text: "", shown };
  }

  private readonly textConstant(text: string): EnumConstant {
    return { isText: true, number: 0, text };
  }

  private readonly templateConstant(
    quasis: Read<string[]>,
    exprs: Read<Expr[]>,
  ): EnumConstant | undefined {
    const text = quasis[0];
    if (exprs.length > 0 || text == undefined) {
      return undefined;
    }

    return this.textConstant(text);
  }

  private readonly ownMemberConstant(
    frame: Read<EnumFrame>,
    name: string,
  ): EnumConstant | undefined {
    const members = frame.decl.members;
    const index = members.findIndex((each) => each.name == name);
    const step = frame.steps[index];
    if (index < 0 || step == undefined) {
      return undefined;
    }

    return this.stepConstant(step);
  }

  private readonly stepConstant(step: EnumStep): EnumConstant {
    const type = step.type;
    if (type.kind == TypeKind.Literal && type.literal == LiteralKind.String) {
      return this.textConstant(type.text);
    }

    const number = step.number ?? 0;
    const value = decimal(number);

    return this.numberConstant(value);
  }

  private readonly otherMemberConstant(
    expr: MemberExpr,
    frame: Read<EnumFrame>,
  ): EnumConstant | undefined {
    const object = expr.object;
    if (object.kind != ExprKind.Name) {
      return undefined;
    }

    const home = this.enumNamed(object, frame.module);
    if (home == undefined) {
      return undefined;
    }
    if (home.decl == frame.decl) {
      return this.ownMemberConstant(frame, expr.name);
    }

    const steps = this.otherEnumSteps(home);
    if (steps == undefined) {
      return this.numberConstant(0);
    }

    const members = home.decl.members;
    const index = members.findIndex((each) => each.name == expr.name);
    const step = steps[index];
    if (index < 0 || step == undefined) {
      return undefined;
    }

    return this.stepConstant(step);
  }

  private readonly unaryConstant(
    expr: UnaryExpr,
    frame: EnumFrame,
  ): EnumConstant | undefined {
    const operand = this.enumConstant(expr.operand, frame);
    if (operand == undefined || operand.isText) {
      return undefined;
    }
    if (operand.shown != undefined) {
      return operand;
    }

    const number = operand.number;

    switch (expr.op) {
      case UnaryOp.Neg:
        return this.numberConstant(-number);
      case UnaryOp.Plus:
        return operand;
      case UnaryOp.BitNot: {
        const bits = this.int32Of(number);

        return this.numberConstant(-bits - 1);
      }
      default:
        return undefined;
    }
  }

  private readonly binaryConstant(
    expr: BinaryExpr,
    frame: EnumFrame,
  ): EnumConstant | undefined {
    const left = this.enumConstant(expr.lhs, frame);
    const right = this.enumConstant(expr.rhs, frame);
    if (left == undefined || right == undefined) {
      return undefined;
    }
    if (left.isText || right.isText) {
      return this.joinedConstant(expr.op, left, right);
    }
    if (left.shown != undefined) {
      return left;
    }
    if (right.shown != undefined) {
      return right;
    }

    return this.numberResult(expr.op, left.number, right.number);
  }

  private readonly joinedConstant(
    op: BinaryOp,
    left: EnumConstant,
    right: EnumConstant,
  ): EnumConstant | undefined {
    if (op != BinaryOp.Add || !left.isText || !right.isText) {
      return undefined;
    }

    return this.textConstant(left.text + right.text);
  }

  private readonly numberResult(
    op: BinaryOp,
    left: decimal,
    right: decimal,
  ): EnumConstant | undefined {
    switch (op) {
      case BinaryOp.Add:
        return this.numberConstant(left + right);
      case BinaryOp.Sub:
        return this.numberConstant(left - right);
      case BinaryOp.Mul:
        return this.numberConstant(left * right);
      case BinaryOp.Div:
        return this.quotientConstant(left, right);
      case BinaryOp.Rem:
        return this.remainderConstant(left, right);
      case BinaryOp.Pow:
        return this.powerConstant(left, right);
      case BinaryOp.BitAnd:
      case BinaryOp.BitOr:
      case BinaryOp.BitXor:
        return this.bitsConstant(op, left, right);
      case BinaryOp.Shl:
      case BinaryOp.Shr:
      case BinaryOp.UShr:
        return this.shiftConstant(op, left, right);
      default:
        return undefined;
    }
  }

  private readonly quotientConstant(left: decimal, right: decimal): EnumConstant {
    if (right != 0) {
      return this.numberConstant(left / right);
    }
    if (left == 0) {
      return this.endlessConstant(kNotNumberText);
    }

    const sign = this.signText(left);

    return this.endlessConstant(sign + kEndlessText);
  }

  private readonly remainderConstant(left: decimal, right: decimal): EnumConstant {
    if (right == 0) {
      return this.endlessConstant(kNotNumberText);
    }

    return this.numberConstant(left % right);
  }

  private readonly powerConstant(
    base: decimal,
    exponent: decimal,
  ): EnumConstant | undefined {
    if (!exponent.isInteger()) {
      return undefined;
    }
    if (exponent < 0) {
      return this.inversePower(base, -exponent);
    }

    return this.wholePower(base, exponent);
  }

  private readonly wholePower(base: decimal, exponent: decimal): EnumConstant {
    let product: decimal = 1;
    let rest = exponent;

    while (rest > 0) {
      product *= base;
      rest -= 1;

      if (product.abs() > kPowerLimit) {
        const isNegative = base < 0 && exponent % 2 == 1;
        const sign = this.signOf(isNegative);

        return this.endlessConstant(sign + kEndlessText);
      }
    }

    return this.numberConstant(product);
  }

  private readonly inversePower(base: decimal, exponent: decimal): EnumConstant {
    const power = this.wholePower(base, exponent);
    if (power.shown != undefined) {
      return this.numberConstant(0);
    }

    return this.quotientConstant(1, power.number);
  }

  private readonly signText(value: decimal): string {
    return this.signOf(value < 0);
  }

  private readonly signOf(isNegative: boolean): string {
    if (isNegative) {
      return "-";
    }

    return "";
  }

  private readonly int32Of(value: decimal): decimal {
    const whole = value.round(0, "down");
    let pattern = whole % kBitSpan;

    if (pattern < 0) {
      pattern += kBitSpan;
    }
    if (pattern >= kSignBit) {
      pattern -= kBitSpan;
    }

    return pattern;
  }

  private readonly uint32Of(value: decimal): decimal {
    const signed = this.int32Of(value);
    if (signed < 0) {
      return signed + kBitSpan;
    }

    return signed;
  }

  private readonly bitsConstant(
    op: BinaryOp,
    left: decimal,
    right: decimal,
  ): EnumConstant {
    let first = this.uint32Of(left);
    let second = this.uint32Of(right);
    let result: decimal = 0;
    let place: decimal = 1;

    for (let index = 0; index < 32; index += 1) {
      const one = first % 2;
      const other = second % 2;
      const bit = this.joinedBit(op, one, other);

      result += bit * place;
      first = (first - one) / 2;
      second = (second - other) / 2;
      place *= 2;
    }

    const signed = this.int32Of(result);

    return this.numberConstant(signed);
  }

  private readonly joinedBit(op: BinaryOp, one: decimal, other: decimal): decimal {
    switch (op) {
      case BinaryOp.BitAnd:
        return one * other;
      case BinaryOp.BitOr:
        return one + other - one * other;
      default:
        return (one + other) % 2;
    }
  }

  private readonly shiftConstant(
    op: BinaryOp,
    left: decimal,
    right: decimal,
  ): EnumConstant {
    const count = this.shiftCount(right);
    const factor = decimal(2) ** count;
    if (factor == 0) {
      return this.numberConstant(0);
    }

    switch (op) {
      case BinaryOp.Shl: {
        const moved = this.int32Of(left) * factor;
        const signed = this.int32Of(moved);

        return this.numberConstant(signed);
      }
      case BinaryOp.Shr: {
        const signed = this.int32Of(left);
        const moved = signed.div(factor, 0, kFloorRounding);

        return this.numberConstant(moved);
      }
      default: {
        const unsigned = this.uint32Of(left);
        const moved = unsigned.div(factor, 0, kFloorRounding);

        return this.numberConstant(moved);
      }
    }
  }

  private readonly shiftCount(right: decimal): int {
    const count = this.uint32Of(right) % kShiftSpan;
    const double = Number(count);
    if (double < 0 || double > kShiftLimit) {
      return 0;
    }

    return Math.trunc(double).toInt();
  }

  private readonly shownNumber(value: decimal): string {
    if (value == 0) {
      return "0";
    }
    if (value < 0) {
      const size = this.shownNumber(-value);

      return `-${size}`;
    }

    const written = value.toExponential(kShownPrecision - 1);
    const mark = written.indexOf("e");
    const mantissa = written.slice(0, mark);
    const power = written.slice(mark + 1);
    const exponent = this.exponentOf(power);
    const digits = mantissa.replaceAll(".", "");

    if (exponent < -4 || exponent >= kShownPrecision) {
      return this.scientificText(digits, exponent);
    }

    return this.fixedText(digits, exponent);
  }

  private readonly exponentOf(power: string): int {
    const size = power.slice(1);
    const parsed = parseInt(size);
    if (parsed.isErr()) {
      return 0;
    }

    const exponent = parsed.value;
    if (exponent < 0 || exponent > kExponentLimit) {
      return 0;
    }
    if (power.startsWith("-")) {
      return -exponent;
    }

    return exponent;
  }

  private readonly scientificText(digits: string, exponent: int): string {
    const trimmed = this.withoutZeros(digits);
    const head = trimmed.slice(0, 1);
    const tail = trimmed.slice(1);
    const sign = this.exponentSign(exponent);
    const size = Math.abs(exponent);
    const power = `${size}`.padStart(kExponentDigits, "0");
    const mantissa = this.joinedFraction(head, tail);

    return `${mantissa}e${sign}${power}`;
  }

  private readonly exponentSign(exponent: int): string {
    if (exponent < 0) {
      return "-";
    }

    return "+";
  }

  private readonly fixedText(digits: string, exponent: int): string {
    if (exponent < 0) {
      const zeros = this.zerosOf(-exponent - 1);
      const trimmed = this.withoutZeros(digits);

      return `0.${zeros}${trimmed}`;
    }

    const whole = digits.slice(0, exponent + 1);
    const fraction = digits.slice(exponent + 1);
    const trimmed = this.withoutZeros(fraction);

    return this.joinedFraction(whole, trimmed);
  }

  private readonly zerosOf(count: int): string {
    if (count <= 0) {
      return "";
    }

    return "0".repeat(count);
  }

  private readonly joinedFraction(whole: string, fraction: string): string {
    if (fraction.length == 0) {
      return whole;
    }

    return `${whole}.${fraction}`;
  }

  private readonly withoutZeros(digits: string): string {
    let end = digits.length;

    while (end > 0 && digits.charAt(end - 1) == "0") {
      end -= 1;
    }

    return digits.slice(0, end);
  }
}
