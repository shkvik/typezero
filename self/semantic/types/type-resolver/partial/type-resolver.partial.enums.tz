import { TypeResolver } from "../type-resolver.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import {
  EnumDecl,
  EnumMember,
} from "../../../../program/ast/types/ast.types.classes.tz";
import { NameExpr } from "../../../../program/ast/types/ast.types.expressions.tz";
import { StmtKind } from "../../../../program/ast/types/ast.types.statements.tz";
import { TypeRef } from "../../../../program/ast/types/ast.types.types.tz";
import { SymbolKind } from "../../../../program/scopes/types/scopes.types.tz";
import {
  LiteralKind,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import {
  kNamePoint,
  kSafeWholeLimit,
  kSafeWholeSize,
} from "../const/type-resolver.const.tables.tz";
import {
  EnumConstant,
  EnumCount,
  EnumFrame,
  EnumHome,
  EnumStep,
  TypeContext,
} from "../types/type-resolver.types.tz";

partial class TypeResolver {
  private readonly enumType(
    ref: TypeRef,
    decl: EnumDecl,
    module: int,
    context: Read<TypeContext>,
  ): Type {
    const point = ref.name.indexOf(kNamePoint);
    if (point < 0) {
      return this.enumWholeOf(module, decl);
    }

    const values = this.enumValues(module, decl);
    const member = ref.name.slice(point + 1);
    const index = decl.members.findIndex((each) => each.name == member);
    const error = this.store.plain(TypeKind.Error);

    if (index < 0) {
      this.report(context.module, ref.loc, Code.EnumTypeMemberMissing, {
        word: decl.name,
        other: member,
      });

      return error;
    }

    return values[index] ?? error;
  }

  private readonly enumWholeOf(module: int, decl: EnumDecl): Type {
    const key = `${module} ${decl.loc}`;
    const known = this.enumWholes.get(key);
    if (known != undefined) {
      return known;
    }

    const values = this.enumValues(module, decl);
    const whole = this.enumWhole(decl, values);
    if (!this.enumOpen.has(key)) {
      this.enumWholes.set(key, whole);
    }

    return whole;
  }

  private readonly enumWhole(decl: EnumDecl, values: Read<Type[]>): Type {
    const texts = values.filter(
      (value) =>
        value.kind == TypeKind.Literal && value.literal == LiteralKind.String,
    );
    if (texts.length == 0 || texts.length < values.length) {
      return this.store.integer(64, false);
    }

    const whole = this.store.unionOf(values);

    this.store.label(whole, decl.name);

    return whole;
  }

  public readonly enumMember(
    module: int,
    decl: EnumDecl,
    name: string,
  ): EnumStep | undefined {
    const index = decl.members.findIndex((each) => each.name == name);
    if (index < 0) {
      return undefined;
    }

    const steps = this.enumSteps(module, decl);

    return steps[index];
  }

  private readonly enumValues(module: int, decl: EnumDecl): Type[] {
    const steps = this.enumSteps(module, decl);

    return steps.map((step) => step.type);
  }

  private readonly enumSteps(module: int, decl: EnumDecl): EnumStep[] {
    const key = `${module} ${decl.loc}`;
    const known = this.enumCache.get(key)?.slice();
    if (known != undefined) {
      return known;
    }

    const owned = this.errors.mark();

    this.enumOpen.add(key);

    const steps = this.countedSteps(module, decl);

    this.enumOpen.delete(key);
    this.enumCache.set(key, steps.slice());
    this.errors.keepSince(owned);

    return steps;
  }

  private readonly countedSteps(module: int, decl: EnumDecl): EnumStep[] {
    const frame: EnumFrame = { module, decl, steps: [] };
    const count: EnumCount = {
      next: 0,
      isCounting: true,
      hasNumbers: false,
      hasStrings: false,
    };

    for (const member of decl.members) {
      this.uniqueMemberCheck(frame, member);

      const step = this.countedStep(frame, member, count);

      frame.steps.push(step);
    }

    if (count.hasNumbers && count.hasStrings) {
      this.report(module, decl.loc, Code.EnumMixed, { word: decl.name });
    }

    return frame.steps;
  }

  private readonly uniqueMemberCheck(frame: Read<EnumFrame>, member: EnumMember): void {
    const earlier = frame.decl.members.slice(0, frame.steps.length);
    if (!earlier.some((other) => other.name == member.name)) {
      return;
    }

    this.report(frame.module, member.loc, Code.EnumMemberDuplicate, {
      word: member.name,
    });
  }

  private readonly countedStep(
    frame: EnumFrame,
    member: EnumMember,
    count: EnumCount,
  ): EnumStep {
    const init = member.init;
    if (init == undefined) {
      return this.numberStep(frame, member, count.next, count);
    }

    const constant = this.enumConstant(init, frame);
    if (constant == undefined) {
      this.report(frame.module, init.loc, Code.EnumNotConstant, kNoDetails);
      count.isCounting = false;

      return this.errorStep();
    }
    if (constant.isText) {
      count.hasStrings = true;
      count.isCounting = false;

      const type = this.store.literal(LiteralKind.String, constant.text);

      return { type };
    }

    return this.constantStep(frame, member, constant, count);
  }

  private readonly constantStep(
    frame: Read<EnumFrame>,
    member: EnumMember,
    constant: EnumConstant,
    count: EnumCount,
  ): EnumStep {
    const shown = constant.shown;
    if (shown == undefined) {
      return this.numberStep(frame, member, constant.number, count);
    }

    this.notWholeReport(frame, member, shown);
    count.isCounting = false;

    return this.errorStep();
  }

  private readonly numberStep(
    frame: Read<EnumFrame>,
    member: EnumMember,
    value: decimal,
    count: EnumCount,
  ): EnumStep {
    if (member.init == undefined && !count.isCounting) {
      this.report(frame.module, member.loc, Code.EnumMemberNoValue, {
        word: member.name,
      });

      return this.errorStep();
    }

    const size = value.abs();

    if (!value.isInteger() || size > kSafeWholeLimit) {
      const shown = this.shownNumber(value);

      this.notWholeReport(frame, member, shown);
      count.isCounting = false;

      return this.errorStep();
    }

    const text = `${value}`;
    const number = this.wholeOf(value);
    const type = this.store.literal(LiteralKind.Int, text);

    count.hasNumbers = true;
    count.next = value + 1;
    count.isCounting = true;

    return { type, number };
  }

  private readonly wholeOf(value: decimal): int {
    const double = Number(value);
    if (double < -kSafeWholeSize || double > kSafeWholeSize) {
      return 0;
    }

    return Math.trunc(double).toInt();
  }

  private readonly notWholeReport(
    frame: Read<EnumFrame>,
    member: EnumMember,
    shown: string,
  ): void {
    const loc = member.init?.loc ?? member.loc;

    this.report(frame.module, loc, Code.EnumMemberNotWhole, {
      word: member.name,
      other: shown,
    });
  }

  private readonly errorStep(): EnumStep {
    const type = this.store.plain(TypeKind.Error);

    return { type };
  }

  private readonly enumNamed(name: NameExpr, module: int): EnumHome | undefined {
    const uses = this.scopes.get(module)?.uses ?? [];
    const use = uses.find((one) => one.loc == name.loc && !one.isType);
    const symbol = use?.symbol;
    if (symbol == undefined) {
      return undefined;
    }
    if (symbol.kind == SymbolKind.Enum) {
      return this.enumDeclared(module, name.name, symbol.loc);
    }

    const target = symbol.target;
    if (symbol.kind != SymbolKind.Import || target == undefined) {
      return undefined;
    }

    return this.enumDeclared(target.module, target.name, undefined);
  }

  private readonly enumDeclared(
    module: int,
    name: string,
    loc: int | undefined,
  ): EnumHome | undefined {
    const found = this.record(module)?.declarations.get(name);
    if (found == undefined || found.kind != StmtKind.Enum) {
      return undefined;
    }
    if (loc != undefined && found.loc != loc) {
      return undefined;
    }

    return { module, decl: found };
  }

  private readonly otherEnumSteps(home: EnumHome): EnumStep[] | undefined {
    const key = `${home.module} ${home.decl.loc}`;
    if (!this.enumOpen.has(key)) {
      return this.enumSteps(home.module, home.decl);
    }

    this.report(home.module, home.decl.loc, Code.EnumCycle, {
      word: home.decl.name,
    });

    return undefined;
  }
}
