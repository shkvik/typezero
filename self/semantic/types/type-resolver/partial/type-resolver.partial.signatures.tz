import { TypeResolver } from "../type-resolver.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import { ParamKind } from "../../../../program/ast/types/ast.types.functions.tz";
import { TypeRef } from "../../../../program/ast/types/ast.types.types.tz";
import {
  FunctionParameter,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import { kThisParameter } from "../const/type-resolver.const.tables.tz";
import {
  ParameterSite,
  TypeContext,
  TypePlace,
} from "../types/type-resolver.types.tz";

partial class TypeResolver {
  public signature(
    sites: ParameterSite[],
    result: TypeRef | undefined,
    context: TypeContext,
  ): Type {
    const params: FunctionParameter[] = [];
    let self: Type | undefined = undefined;
    let rest = false;
    let optionalBefore = false;

    for (const site of sites) {
      const type = this.siteType(site, context);

      if (site.name == kThisParameter) {
        self = type;

        continue;
      }
      if (site.kind == ParamKind.Required && optionalBefore) {
        this.report(
          context.module,
          site.loc,
          Code.RequiredAfterOptional,
          kNoDetails,
        );
      }

      const optional =
        site.kind == ParamKind.Optional || site.kind == ParamKind.Defaulted;

      optionalBefore = optionalBefore || site.kind == ParamKind.Optional;
      rest = rest || site.kind == ParamKind.Rest;
      params.push({ type, optional });
    }

    const returned = this.returned(result, context);

    return this.store.functionOf({ params, rest, self, result: returned });
  }

  private siteType(site: ParameterSite, context: TypeContext): Type {
    if (site.kind != ParamKind.Rest) {
      return this.value(site.type, context);
    }

    const inner = this.placed(context, TypePlace.RestParameter);
    const type = this.resolve(site.type, inner);
    const isHole = inner.place == TypePlace.Pattern && this.isOpen(type);
    if (isHole || this.isList(type)) {
      return type;
    }

    this.report(context.module, site.type.loc, Code.RestParameterNotArray, {
      word: site.name,
    });

    return this.store.plain(TypeKind.Error);
  }

  private isList(type: Type): boolean {
    switch (type.kind) {
      case TypeKind.Array:
      case TypeKind.Tuple:
      case TypeKind.Operation:
      case TypeKind.Error:
        return true;
      case TypeKind.TypeParameter: {
        const constraint = this.store.constraintOf(type);

        return constraint != undefined && this.isList(constraint);
      }
      default:
        return false;
    }
  }

  private returned(ref: TypeRef | undefined, context: TypeContext): Type {
    if (ref == undefined) {
      return this.store.plain(TypeKind.Void);
    }

    const type = this.resolve(ref, context);

    return this.present(ref, type, context);
  }
}
