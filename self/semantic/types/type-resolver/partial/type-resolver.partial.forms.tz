import { TypeResolver } from "../type-resolver.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import {
  kBooleanTypeName,
  kStringTypeName,
} from "../../../../program/ast/const/ast.const.tz";
import { ParamKind } from "../../../../program/ast/types/ast.types.functions.tz";
import {
  FunctionTypeForm,
  LiteralTypeForm,
  ObjectTypeField,
  ObjectTypeForm,
  TupleTypeForm,
  TypeRef,
  TypeRefKind,
} from "../../../../program/ast/types/ast.types.types.tz";
import {
  LiteralKind,
  ObjectField,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import {
  ParameterSite,
  TypeContext,
  TypePlace,
} from "../types/type-resolver.types.tz";

partial class TypeResolver {
  private tuple(ref: TypeRef, form: TupleTypeForm, context: TypeContext): Type {
    const items: Type[] = [];
    const spreads: int[] = [];

    for (const element of form.elements) {
      if (!element.spread) {
        const item = this.value(element.type, context);

        items.push(item);

        continue;
      }

      const item = this.resolve(element.type, context);
      if (item.kind == TypeKind.Tuple && item.rest < 0) {
        for (const inner of item.items) {
          items.push(inner);
        }

        continue;
      }

      spreads.push(items.length);
      items.push(item);
    }

    const problem = this.spreadProblem(items, spreads, context.place);
    if (problem != undefined) {
      this.report(context.module, ref.loc, problem, kNoDetails);

      return this.store.plain(TypeKind.Error);
    }

    return this.store.tupleOf({
      items,
      readonly: form.readonly,
      required: items.length,
      rest: spreads[spreads.length - 1] ?? -1,
    });
  }

  private spreadProblem(
    items: Type[],
    spreads: int[],
    place: TypePlace,
  ): Code | undefined {
    const last = items.length - 1;

    for (const at of spreads) {
      const item = items[at];
      if (item == undefined || item.kind != TypeKind.Array) {
        continue;
      }
      if (at < last) {
        return Code.TupleSpreadNotLast;
      }
      if (place == TypePlace.Plain) {
        return Code.TupleRest;
      }
    }

    return undefined;
  }

  private object(
    form: ObjectTypeForm,
    context: TypeContext,
    declared: boolean,
  ): Type {
    const fields: ObjectField[] = [];

    for (const field of form.fields) {
      if (field.call) {
        continue;
      }

      const type = this.value(field.type, context);
      const overloaded = this.isOverloaded(form, field.name);
      const problem = this.memberProblem(fields, field, type, overloaded);

      if (overloaded && !declared) {
        this.report(context.module, field.loc, Code.SignaturesOnlyInInterface, {
          word: field.name,
        });

        continue;
      }
      if (problem != undefined) {
        const other = this.text.of(type);

        this.report(context.module, field.loc, problem, {
          word: field.name,
          other,
        });

        continue;
      }

      fields.push({
        name: field.name,
        type,
        optional: field.optional,
        readonly: field.readonly,
      });
    }

    return this.store.objectOf(fields);
  }

  private isOverloaded(form: ObjectTypeForm, name: string): boolean {
    let count = 0;

    for (const field of form.fields) {
      if (field.call || field.name != name) {
        continue;
      }
      if (!field.method) {
        return false;
      }

      count += 1;
    }

    return count > 1;
  }

  private memberProblem(
    kept: ObjectField[],
    field: ObjectTypeField,
    type: Type,
    overloaded: boolean,
  ): Code | undefined {
    const earlier = kept.filter((one) => one.name == field.name);

    if (earlier.length > 0 && !overloaded) {
      return Code.DuplicateField;
    }
    if (earlier.some((one) => one.type == type)) {
      return Code.DuplicateSignature;
    }

    return undefined;
  }

  private functionType(form: FunctionTypeForm, context: TypeContext): Type {
    const last = form.params.length - 1;
    const sites: ParameterSite[] = [];

    for (const param of form.params) {
      const spread = form.rest && sites.length == last;
      const kind = this.siteKind(param.optional, spread);

      sites.push({
        name: param.name,
        loc: param.loc,
        kind,
        type: param.type,
        isDeclared: false,
      });
    }

    this.assertsTypeCheck(form.result, context);

    return this.signature(sites, form.result, context);
  }

  private assertsTypeCheck(
    result: TypeRef | undefined,
    context: TypeContext,
  ): void {
    const form = result?.form;
    if (result == undefined || form == undefined) {
      return;
    }
    if (form.kind != TypeRefKind.Predicate || !form.asserts) {
      return;
    }

    const shown = this.assertedText(result, context);

    this.report(context.module, result.loc, Code.AssertsRefused, {
      word: shown,
      other: this.assertedAdvice(result, shown),
    });
  }

  private assertedText(result: TypeRef, context: TypeContext): string {
    const ref = result.args[0];
    if (ref == undefined) {
      return result.name;
    }

    const type = this.resolve(ref, context);
    const shown = this.text.of(type);

    return `${result.name} is ${shown}`;
  }

  private assertedAdvice(result: TypeRef, shown: string): string {
    if (result.args.length == 0) {
      return "boolean";
    }

    return shown;
  }

  private siteKind(optional: boolean, spread: boolean): ParamKind {
    if (spread) {
      return ParamKind.Rest;
    }
    if (optional) {
      return ParamKind.Optional;
    }

    return ParamKind.Required;
  }

  private literal(name: string, form: LiteralTypeForm): Type {
    if (name == kStringTypeName) {
      return this.store.literal(LiteralKind.String, form.text);
    }
    if (name == kBooleanTypeName) {
      const truth = this.truthText(form.number);

      return this.store.literal(LiteralKind.Boolean, truth);
    }

    const text = `${form.number}`;

    if (form.integer) {
      return this.store.literal(LiteralKind.Int, text);
    }

    return this.store.literal(LiteralKind.Double, text);
  }

  private truthText(number: double): string {
    if (number == 0.0) {
      return "false";
    }

    return "true";
  }
}
