import { TypeResolver } from "../type-resolver.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { TypeAliasDecl } from "../../../../program/ast/types/ast.types.classes.tz";
import {
  TypeRef,
  TypeRefKind,
} from "../../../../program/ast/types/ast.types.types.tz";
import {
  ObjectField,
  OperationKind,
  Type,
  TypeKind,
  UnionType,
} from "../../../../program/type/types/type.types.tz";
import { kAliasDepthLimit } from "../const/type-resolver.const.tables.tz";
import {
  AliasDoor,
  DoorState,
  TypeContext,
  TypePlace,
} from "../types/type-resolver.types.tz";

partial class TypeResolver {
  private alias(module: int, decl: TypeAliasDecl, written: Type[]): Type {
    const bindings = this.bind(module, decl.typeParams, written);
    const args = Array.from(bindings.values());
    const ids = args.map((arg) => `${arg.id}`);
    const home = `${module} ${decl.loc}`;
    const key = `${home} ${ids.join(" ")}`;
    const label = this.labelText(module, decl.name, written);
    const open = this.doors.get(key);
    if (open != undefined) {
      return this.reenter(module, decl, open, args, label);
    }

    const depth = this.working.get(home) ?? 0;
    const seen = new Set<int>();
    if (depth > 0 && this.anyDepends(args, seen)) {
      return this.operation(OperationKind.Alias, args, label);
    }

    const error = this.store.plain(TypeKind.Error);

    if (depth >= kAliasDepthLimit) {
      this.reportDepth(module, decl, home);

      return error;
    }

    const reserved = this.reserve(decl.type, label);
    const door: AliasDoor = {
      state: DoorState.InWork,
      entered: false,
      result: error,
      reserved,
    };

    this.doors.set(key, door);
    this.working.set(home, depth + 1);

    const body = this.aliasBody(decl, {
      module,
      bindings,
      place: TypePlace.Plain,
    });
    const result = this.settle(module, decl, door, body);

    this.working.set(home, depth);
    door.result = result;
    door.state = DoorState.Done;
    this.labelAlias(decl, result, label);
    this.keepOrigin(module, decl, written, result);

    if (this.record(module)?.library == true) {
      this.libraryShapes.add(result.id);
    }

    return result;
  }

  private keepOrigin(
    module: int,
    decl: TypeAliasDecl,
    args: Type[],
    result: Type,
  ): void {
    if (decl.typeParams.length == 0 || this.aliasOrigins.has(result.id)) {
      return;
    }

    this.aliasOrigins.set(result.id, { module, decl, args });
  }

  private reportDepth(module: int, decl: TypeAliasDecl, home: string): void {
    if (this.endless.has(home)) {
      return;
    }

    this.endless.add(home);
    this.report(module, decl.loc, Code.AliasTooDeep, { word: decl.name });
  }

  private reenter(
    module: int,
    decl: TypeAliasDecl,
    door: AliasDoor,
    args: Type[],
    label: string,
  ): Type {
    if (door.state == DoorState.Done) {
      return door.result;
    }

    const reserved = door.reserved;
    if (reserved != undefined) {
      door.entered = true;

      return reserved;
    }

    const seen = new Set<int>();
    if (this.anyDepends(args, seen)) {
      return this.operation(OperationKind.Alias, args, label);
    }
    if (!door.entered) {
      this.report(module, decl.loc, Code.AliasRefersToItself, {
        word: decl.name,
      });
    }

    door.entered = true;

    return this.store.plain(TypeKind.Error);
  }

  private reserve(ref: TypeRef, label: string): Type | undefined {
    switch (ref.form.kind) {
      case TypeRefKind.Object: {
        const reserved = this.store.reserveObject();

        this.store.label(reserved, label);

        return reserved;
      }
      case TypeRefKind.Union: {
        const reserved = this.store.reserveUnion();

        this.store.label(reserved, label);

        return reserved;
      }
      default:
        return undefined;
    }
  }

  private aliasBody(decl: TypeAliasDecl, context: TypeContext): Type {
    if (decl.bases.length == 0) {
      return this.ownBody(decl.type, context);
    }

    const fields = new Map<string, ObjectField>();
    const owners = new Map<string, string>();
    const parents: Type[] = [];

    this.extending.push(decl);

    for (const base of decl.bases) {
      this.baseFields(decl, base, owners, fields, context, parents);
    }

    this.extending.pop();

    const own = this.ownBody(decl.type, context);

    this.narrowedChecks(decl, own, owners, fields, context.module);
    this.inherit(fields, own);

    const merged = Array.from(fields.values());
    const made = this.store.objectOf(merged);

    this.addParents(made, parents);

    return made;
  }

  private addParents(type: Type, parents: Type[]): void {
    const known = this.store.parentsOf(type);
    const added = parents.filter((parent) => !known.includes(parent));
    if (added.length > 0) {
      this.store.inherit(type, known.concat(added));
    }
  }

  private baseFields(
    decl: TypeAliasDecl,
    base: TypeRef,
    owners: Map<string, string>,
    fields: Map<string, ObjectField>,
    context: TypeContext,
    parents: Type[],
  ): void {
    const module = context.module;
    const first = decl.name;
    const word = base.name;
    if (word == first) {
      return this.report(module, base.loc, Code.InterfaceItself, { first });
    }

    const isLooping = this.extending.some((one) => one.name == word);
    if (isLooping) {
      return this.report(module, base.loc, Code.InterfaceItselfThrough, {
        first,
        word,
      });
    }

    const parent = this.resolve(base, context);
    if (parent.kind == TypeKind.Instance) {
      return this.report(module, base.loc, Code.InterfaceClassBase, { word });
    }
    if (parent.kind != TypeKind.Object) {
      return this.notObjectBase(parent, base, module);
    }

    for (const field of parent.fields) {
      fields.set(field.name, field);
      owners.set(field.name, word);
    }

    parents.push(parent);
  }

  private notObjectBase(parent: Type, base: TypeRef, module: int): void {
    if (parent.kind == TypeKind.Error || this.isLibrary(module)) {
      return;
    }

    this.report(module, base.loc, Code.InterfaceNotObject, {
      word: this.text.of(parent),
    });
  }

  private narrowedChecks(
    decl: TypeAliasDecl,
    own: Type,
    owners: Map<string, string>,
    fields: Map<string, ObjectField>,
    module: int,
  ): void {
    const form = decl.type.form;
    if (own.kind != TypeKind.Object || form.kind != TypeRefKind.Object) {
      return;
    }

    for (const written of form.fields) {
      const field = own.fields.find((one) => one.name == written.name);
      const inherited = fields.get(written.name);
      if (field == undefined || inherited == undefined || written.method) {
        continue;
      }
      if (this.isSameLayout(field.type, inherited.type)) {
        continue;
      }

      this.report(module, written.loc, Code.InterfaceFieldLayout, {
        word: written.name,
        first: decl.name,
        second: this.text.of(field.type),
        other: owners.get(written.name) ?? "",
        place: this.text.of(inherited.type),
      });
    }
  }

  private isSameLayout(own: Type, theirs: Type): boolean {
    const isOpen = own.kind == TypeKind.Error || theirs.kind == TypeKind.Error;
    if (own == theirs || isOpen) {
      return true;
    }
    if (own.kind != TypeKind.Instance || theirs.kind != TypeKind.Instance) {
      return false;
    }

    const chain: Type[] = [own];

    for (let index = 0; index < chain.length; index++) {
      const current = chain[index];
      if (current == theirs) {
        return true;
      }
      if (current == undefined) {
        break;
      }

      for (const parent of this.store.parentsOf(current)) {
        if (!chain.includes(parent)) {
          chain.push(parent);
        }
      }
    }

    return false;
  }

  private ownBody(ref: TypeRef, context: TypeContext): Type {
    const form = ref.form;
    if (form.kind == TypeRefKind.Object) {
      return this.object(form, context, true);
    }

    return this.resolve(ref, context);
  }

  private inherit(fields: Map<string, ObjectField>, from: Type): void {
    if (from.kind != TypeKind.Object) {
      return;
    }

    for (const field of from.fields) {
      fields.set(field.name, field);
    }
  }

  private settle(
    module: int,
    decl: TypeAliasDecl,
    door: AliasDoor,
    body: Type,
  ): Type {
    const reserved = door.reserved;

    if (!door.entered || body.kind == TypeKind.Error) {
      return body;
    }
    if (reserved == undefined) {
      return this.store.plain(TypeKind.Error);
    }
    if (body.kind == TypeKind.Object) {
      this.store.fillObject(reserved, body.fields);
      this.addParents(reserved, this.store.parentsOf(body));

      return reserved;
    }
    if (body.kind == TypeKind.Union && this.isClosed(body, reserved)) {
      this.store.fillUnion(reserved, body.parts);

      return reserved;
    }

    this.report(module, decl.loc, Code.RecursiveUnion, { word: decl.name });

    return this.store.plain(TypeKind.Error);
  }

  private isClosed(body: UnionType, reserved: Type): boolean {
    if (body == reserved || body.parts.includes(reserved)) {
      return false;
    }

    return !body.parts.some((part) => part.kind == TypeKind.Undefined);
  }

  private labelAlias(decl: TypeAliasDecl, result: Type, label: string): void {
    const written = decl.type.form.kind == TypeRefKind.Object;
    if (written && result.kind == TypeKind.Object) {
      this.store.label(result, label);
    }
  }
}
