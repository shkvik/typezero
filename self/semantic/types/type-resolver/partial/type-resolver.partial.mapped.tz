import { TypeResolver } from "../type-resolver.tz";
import { Code } from "../../../../diagnostic/code.tz";
import {
  MappedTypeForm,
  ModifierChange,
  TypeRef,
  TypeRefKind,
} from "../../../../program/ast/types/ast.types.types.tz";
import {
  Change,
  LiteralKind,
  ObjectField,
  OperationKind,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import { MappedPlan, TypeContext } from "../types/type-resolver.types.tz";

partial class TypeResolver {
  private readonly mapped(
    ref: TypeRef,
    form: MappedTypeForm,
    context: TypeContext,
  ): Type {
    const keysRef = ref.args[0];
    const value = ref.args[1];
    if (keysRef == undefined || value == undefined) {
      return this.store.plain(TypeKind.Error);
    }

    const keys = this.resolve(keysRef, context);
    if (this.isOpen(keys)) {
      return this.mappedLater(ref, form, keys, context);
    }

    const names = this.partsOf(keys);
    const named = names.every((name) => name.kind == TypeKind.Literal);
    if (keys.kind != TypeKind.Never && !named) {
      const word = this.text.of(keys);

      this.report(context.module, keysRef.loc, Code.MappedKeys, { word });

      return this.store.plain(TypeKind.Error);
    }

    const plan: MappedPlan = {
      form,
      value,
      rename: ref.args[2],
      source: this.mappedSource(keysRef, context),
      identity: this.isIdentity(keysRef, value, ref.name),
    };
    const fields: ObjectField[] = [];

    for (const name of names) {
      const inner = this.bound(context, ref.loc, name);
      const field = this.mappedField(plan, name, inner);
      if (field != undefined) {
        fields.push(field);
      }
    }

    return this.store.objectOf(fields);
  }

  private readonly mappedLater(
    ref: TypeRef,
    form: MappedTypeForm,
    keys: Type,
    context: TypeContext,
  ): Type {
    const operands = this.resolveAll(ref.args.slice(1), context);

    return this.store.operationOf({
      op: OperationKind.Mapped,
      operands: [keys].concat(operands),
      word: ref.name,
      optional: this.changeOf(form.optionalChange),
      readonly: this.changeOf(form.readonlyChange),
    });
  }

  private readonly changeOf(change: ModifierChange): Change {
    switch (change) {
      case ModifierChange.Add:
        return Change.Add;
      case ModifierChange.Remove:
        return Change.Remove;
      default:
        return Change.None;
    }
  }

  private readonly mappedSource(keys: TypeRef, context: TypeContext): ObjectField[] {
    const of = keys.args[0];
    if (keys.form.kind != TypeRefKind.KeyOf || of == undefined) {
      return [];
    }

    const source = this.resolve(of, context);
    if (source.kind == TypeKind.Object) {
      return source.fields.slice();
    }
    if (source.kind == TypeKind.Instance) {
      return this.memberFields(source);
    }

    return [];
  }

  private readonly isIdentity(keys: TypeRef, value: TypeRef, variable: string): boolean {
    const of = keys.args[0];
    const object = value.args[0];
    const index = value.args[1];
    const direct =
      keys.form.kind == TypeRefKind.KeyOf &&
      value.form.kind == TypeRefKind.Indexed;
    if (!direct || of == undefined || object == undefined) {
      return false;
    }

    return (
      index != undefined && index.name == variable && of.name == object.name
    );
  }

  private readonly mappedField(
    plan: Read<MappedPlan>,
    key: Type,
    inner: TypeContext,
  ): ObjectField | undefined {
    if (key.kind != TypeKind.Literal) {
      return undefined;
    }

    const written = key.text;
    const name = this.mappedName(plan.rename, written, inner);
    if (name == undefined) {
      return undefined;
    }

    const origin = plan.source.find((field) => field.name == written);
    const type = this.mappedValue(plan, origin, inner);
    const wasReadonly = origin?.readonly ?? false;
    const wasOptional = plan.identity && (origin?.optional ?? false);
    const readonly = this.changed(plan.form.readonlyChange, wasReadonly);
    const optional = this.changed(plan.form.optionalChange, wasOptional);

    return { name, type, optional, readonly };
  }

  private readonly mappedName(
    rename: TypeRef | undefined,
    key: string,
    inner: TypeContext,
  ): string | undefined {
    if (rename == undefined) {
      return key;
    }

    const renamed = this.resolve(rename, inner);
    if (renamed.kind != TypeKind.Literal) {
      return undefined;
    }
    if (renamed.literal != LiteralKind.String) {
      this.report(inner.module, rename.loc, Code.MappedRename, {
        word: renamed.text,
      });

      return undefined;
    }

    return renamed.text;
  }

  private readonly mappedValue(
    plan: Read<MappedPlan>,
    origin: ObjectField | undefined,
    inner: TypeContext,
  ): Type {
    if (plan.identity && origin != undefined) {
      return origin.type;
    }

    const value = this.value(plan.value, inner);

    if (plan.form.optionalChange == ModifierChange.Remove) {
      return this.withoutUndefined(value);
    }

    return value;
  }

  private readonly changed(change: ModifierChange, before: boolean): boolean {
    switch (change) {
      case ModifierChange.Add:
        return true;
      case ModifierChange.Remove:
        return false;
      default:
        return before;
    }
  }
}
