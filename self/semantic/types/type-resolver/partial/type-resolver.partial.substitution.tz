import { TypeResolver } from "../type-resolver.tz";
import { ClassDecl } from "../../../../program/ast/types/ast.types.classes.tz";
import { StmtKind } from "../../../../program/ast/types/ast.types.statements.tz";
import {
  TypeParamDecl,
  TypeRef,
  TypeRefKind,
} from "../../../../program/ast/types/ast.types.types.tz";
import {
  FunctionParameter,
  FunctionShape,
  InstanceType,
  ObjectField,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import { kUnionSeparator } from "../const/type-resolver.const.tables.tz";
import {
  SubstitutionWalk,
  TypeContext,
  TypePlace,
} from "../types/type-resolver.types.tz";

partial class TypeResolver {
  public parameterTypes(module: int, params: TypeParamDecl[]): Type[] {
    const types: Type[] = [];

    for (const param of params) {
      const name = param.name;
      const type = this.opened(module, param.loc, name, param.constraint);

      types.push(type);
    }

    return types;
  }

  public constraintMiss(
    home: int,
    param: TypeParamDecl,
    given: Type,
    bindings: Map<int, Type>,
  ): string | undefined {
    const constraint = param.constraint;
    if (constraint == undefined) {
      return undefined;
    }

    const inside: TypeContext = {
      module: home,
      bindings,
      place: TypePlace.Plain,
    };
    const ways = this.constraintWays(constraint, inside);
    if (this.satisfies(given, ways)) {
      return undefined;
    }

    return this.writtenConstraint(home, param, constraint);
  }

  private writtenConstraint(
    home: int,
    param: TypeParamDecl,
    written: TypeRef,
  ): string {
    const isNames =
      written.form.kind == TypeRefKind.Union &&
      written.args.every((arg) => arg.form.kind == TypeRefKind.Name);
    if (!isNames) {
      return this.constraintText(home, param, written);
    }

    const names = written.args.map((arg) => arg.name);

    return names.join(kUnionSeparator);
  }

  public defaultOf(
    home: int,
    param: TypeParamDecl,
    bindings: Map<int, Type>,
  ): Type | undefined {
    const written = param.defaultType;
    if (written == undefined) {
      return undefined;
    }

    const inside: TypeContext = {
      module: home,
      bindings,
      place: TypePlace.Plain,
    };

    return this.resolve(written, inside);
  }

  public mentions(type: Type, ids: Set<int>): boolean {
    const seen = new Set<int>();

    return this.mentionsSeen(type, ids, seen);
  }

  private mentionsSeen(type: Type, ids: Set<int>, seen: Set<int>): boolean {
    if (seen.has(type.id)) {
      return false;
    }

    seen.add(type.id);

    if (type.kind == TypeKind.TypeParameter) {
      return ids.has(type.id);
    }

    const parts = this.innerTypes(type);

    return parts.some((part) => this.mentionsSeen(part, ids, seen));
  }

  private innerTypes(type: Type): Type[] {
    switch (type.kind) {
      case TypeKind.Array:
        return [type.item];
      case TypeKind.Tuple:
        return type.items;
      case TypeKind.Object:
        return type.fields.map((field) => field.type);
      case TypeKind.Function:
        return this.shapeTypes(type.shape);
      case TypeKind.Union:
        return type.parts;
      case TypeKind.Result:
        return [type.value, type.error];
      case TypeKind.Promise:
        return [type.value];
      case TypeKind.Iterator: {
        const shape = type.shape;

        return [shape.yielded, shape.returned, shape.sent];
      }
      case TypeKind.Dict:
        return [type.key, type.value];
      case TypeKind.Instance:
        return type.args;
      case TypeKind.Template:
        return type.parts;
      case TypeKind.Operation:
        return type.shape.operands;
      default:
        return [];
    }
  }

  private shapeTypes(shape: FunctionShape): Type[] {
    const types = shape.params.map((param) => param.type);
    const self = shape.self;

    types.push(shape.result);

    if (self != undefined) {
      types.push(self);
    }

    return types;
  }

  public substitute(type: Type, bound: Map<int, Type>): Type {
    return this.substituteAt(type, bound, false);
  }

  public substituteValue(type: Type, bound: Map<int, Type>): Type {
    return this.substituteAt(type, bound, true);
  }

  private substituteAt(
    type: Type,
    bound: Map<int, Type>,
    isValue: boolean,
  ): Type {
    const ids = new Set<int>();
    const visiting = new Set<int>();

    for (const id of bound.keys()) {
      ids.add(id);
    }

    const walk: SubstitutionWalk = { bound, ids, visiting };

    return this.substituted(type, walk, isValue);
  }

  private substituted(
    type: Type,
    walk: SubstitutionWalk,
    isValue: boolean,
  ): Type {
    if (!this.mentions(type, walk.ids)) {
      return type;
    }
    if (type.kind == TypeKind.TypeParameter) {
      return this.boundParameter(type, walk, isValue);
    }
    if (walk.visiting.has(type.id)) {
      return this.store.plain(TypeKind.Error);
    }

    walk.visiting.add(type.id);

    const made = this.substitutedParts(type, walk);

    walk.visiting.delete(type.id);

    return made;
  }

  private boundParameter(
    type: Type,
    walk: SubstitutionWalk,
    isValue: boolean,
  ): Type {
    const found = walk.bound.get(type.id);
    if (found == undefined) {
      return type;
    }
    if (isValue && found.kind == TypeKind.Void) {
      return this.store.plain(TypeKind.Undefined);
    }

    return found;
  }

  private substitutedParts(type: Type, walk: SubstitutionWalk): Type {
    switch (type.kind) {
      case TypeKind.Array: {
        const item = this.substituted(type.item, walk, true);

        return this.store.arrayOf(item);
      }
      case TypeKind.Tuple: {
        const items = this.substitutedAll(type.items, walk, true);
        const required = type.required;
        const rest = type.rest;
        const readonly = type.readonly;

        return this.store.tupleOf({ items, readonly, required, rest });
      }
      case TypeKind.Object: {
        const fields = type.fields.map((field) =>
          this.substitutedField(field, walk),
        );

        return this.store.objectOf(fields);
      }
      case TypeKind.Function:
        return this.substitutedFunction(type.shape, walk);
      case TypeKind.Union: {
        const parts = this.substitutedAll(type.parts, walk, true);

        return this.store.unionOf(parts);
      }
      case TypeKind.Result: {
        const value = this.substituted(type.value, walk, false);
        const error = this.substituted(type.error, walk, false);

        return this.store.resultOf(value, error);
      }
      case TypeKind.Promise: {
        const value = this.substituted(type.value, walk, false);

        return this.store.promiseOf(value);
      }
      default:
        return this.substitutedHolder(type, walk);
    }
  }

  private substitutedHolder(type: Type, walk: SubstitutionWalk): Type {
    switch (type.kind) {
      case TypeKind.Iterator: {
        const shape = type.shape;
        const yielded = this.substituted(shape.yielded, walk, true);
        const returned = this.substituted(shape.returned, walk, false);
        const sent = this.substituted(shape.sent, walk, false);
        const async = shape.async;

        return this.store.iteratorOf({ yielded, returned, sent, async });
      }
      case TypeKind.Dict: {
        const key = this.substituted(type.key, walk, true);
        const value = this.substituted(type.value, walk, true);

        return this.store.dictOf(type.dict, key, value);
      }
      case TypeKind.Instance: {
        const args = this.substitutedAll(type.args, walk, false);

        return this.instanceWith(type, args);
      }
      default:
        return this.store.plain(TypeKind.Error);
    }
  }

  private substitutedAll(
    parts: Type[],
    walk: SubstitutionWalk,
    isValue: boolean,
  ): Type[] {
    return parts.map((part) => this.substituted(part, walk, isValue));
  }

  private substitutedField(
    field: ObjectField,
    walk: SubstitutionWalk,
  ): ObjectField {
    const type = this.substituted(field.type, walk, true);

    return {
      name: field.name,
      type,
      optional: field.optional,
      readonly: field.readonly,
    };
  }

  private substitutedFunction(
    shape: FunctionShape,
    walk: SubstitutionWalk,
  ): Type {
    const params: FunctionParameter[] = shape.params.map((param) => ({
      type: this.substituted(param.type, walk, true),
      optional: param.optional,
    }));
    const rest = shape.rest;
    const result = this.substituted(shape.result, walk, false);
    const written = shape.self;

    if (written == undefined) {
      return this.store.functionOf({ params, rest, result });
    }

    const self = this.substituted(written, walk, true);

    return this.store.functionOf({ params, rest, self, result });
  }

  public instanceWith(instance: InstanceType, args: Type[]): Type {
    const record = this.record(instance.module);
    const found = record?.declarations.get(instance.name);
    if (found != undefined && found.kind == StmtKind.Class) {
      return this.ownInstanceWith(instance, found, args);
    }

    const declared = record?.classes.get(instance.name);
    if (declared == undefined || declared.loc != instance.loc) {
      return this.store.plain(TypeKind.Error);
    }

    const made = this.declaredInstance(instance.module, declared, args);

    return made ?? this.store.plain(TypeKind.Error);
  }

  private ownInstanceWith(
    instance: InstanceType,
    decl: ClassDecl,
    args: Type[],
  ): Type {
    if (decl.loc != instance.loc) {
      return this.store.plain(TypeKind.Error);
    }

    return this.classInstance(instance.module, decl, args);
  }
}
