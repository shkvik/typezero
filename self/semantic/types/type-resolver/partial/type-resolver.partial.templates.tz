import { TypeResolver } from "../type-resolver.tz";
import { Code } from "../../../../diagnostic/code.tz";
import {
  TemplateTypeForm,
  TypeRef,
} from "../../../../program/ast/types/ast.types.types.tz";
import {
  LiteralKind,
  OperationKind,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import { kFalseText, kTrueText } from "../const/type-resolver.const.tables.tz";
import {
  TextChange,
  TextChangeName,
  TypeContext,
} from "../types/type-resolver.types.tz";

partial class TypeResolver {
  private template(
    ref: TypeRef,
    form: TemplateTypeForm,
    context: TypeContext,
  ): Type {
    const parts = this.resolveAll(ref.args, context);
    let texts: string[] = [form.texts[0] ?? ""];

    for (let index = 0; index < parts.length; index++) {
      const choices = this.textChoices(parts[index]);
      if (choices == undefined) {
        return this.store.templateOf(form.texts, parts);
      }

      const after = form.texts[index + 1] ?? "";

      texts = this.combined(texts, choices, after);
    }

    const literals: Type[] = [];

    for (const text of texts) {
      const literal = this.store.literal(LiteralKind.String, text);

      literals.push(literal);
    }

    return this.store.unionOf(literals);
  }

  private combined(
    starts: string[],
    choices: string[],
    after: string,
  ): string[] {
    const texts: string[] = [];

    for (const start of starts) {
      for (const choice of choices) {
        texts.push(`${start}${choice}${after}`);
      }
    }

    return texts;
  }

  private textChoices(type: Type | undefined): string[] | undefined {
    if (type == undefined) {
      return undefined;
    }

    switch (type.kind) {
      case TypeKind.Literal:
        return [type.text];
      case TypeKind.Boolean:
        return [kFalseText, kTrueText];
      case TypeKind.Union: {
        const texts: string[] = [];

        for (const part of type.parts) {
          const choices = this.textChoices(part);
          if (choices == undefined) {
            return undefined;
          }

          for (const choice of choices) {
            texts.push(choice);
          }
        }

        return texts;
      }
      default:
        return undefined;
    }
  }

  private textChange(
    ref: TypeRef,
    row: TextChangeName,
    context: TypeContext,
  ): Type {
    if (ref.args.length != 1) {
      this.report(context.module, ref.loc, Code.TypeArgumentsCount, {
        word: row.name,
        other: `${row.name}<"text">`,
      });

      return this.store.plain(TypeKind.Error);
    }

    const args = this.resolveAll(ref.args, context);
    const error = this.store.plain(TypeKind.Error);
    const text = args[0] ?? error;

    return this.changedText(text, row);
  }

  private changedText(type: Type, row: TextChangeName): Type {
    switch (type.kind) {
      case TypeKind.Literal: {
        const changed = this.changedWord(type.text, row.change);

        return this.store.literal(LiteralKind.String, changed);
      }
      case TypeKind.Union: {
        const parts: Type[] = [];

        for (const part of type.parts) {
          const changed = this.changedText(part, row);

          parts.push(changed);
        }

        return this.store.unionOf(parts);
      }
      case TypeKind.TypeParameter:
      case TypeKind.Operation:
        return this.operation(OperationKind.TextChange, [type], row.name);
      default:
        return type;
    }
  }

  private changedWord(text: string, change: TextChange): string {
    const head = text.slice(0, 1);
    const tail = text.slice(1);

    switch (change) {
      case TextChange.Capitalize:
        return `${head.toUpperCase()}${tail}`;
      case TextChange.Uncapitalize:
        return `${head.toLowerCase()}${tail}`;
      case TextChange.Uppercase:
        return text.toUpperCase();
      default:
        return text.toLowerCase();
    }
  }
}
