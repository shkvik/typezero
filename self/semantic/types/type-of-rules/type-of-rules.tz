import { Code } from "../../../diagnostic/code.tz";
import { kNoDetails } from "../../../diagnostic/const/message.const.tz";
import { Details, Finding } from "../../../diagnostic/types/message.types.tz";
import { TypeStore } from "../../../program/type/type-store/type-store.tz";
import { TypeText } from "../../../program/type/type-text/type-text.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import { TypeQuestions } from "../type-questions/type-questions.tz";
import { TypeRelation } from "../type-relation/type-relation.tz";
import {
  kAnyObjectTypeOfNames,
  kBigintTypeOf,
  kIntegerTypeOfPrefixes,
  kJsonTypeOfNames,
  kLastNameSeparator,
  kMostShownNumberNames,
  kNameSeparator,
  kNullTypeOf,
  kNumberTypeOf,
  kNumberTypeOfNames,
  kSymbolTypeOf,
  kTypeOfNames,
  kUndefinedTypeOf,
} from "./const/type-of-rules.const.tz";

export class TypeOfRules {
  private readonly store: TypeStore;
  private readonly text: TypeText;
  private readonly relation: TypeRelation;
  private readonly types: TypeQuestions;

  public constructor(
    store: TypeStore,
    text: TypeText,
    relation: Own<TypeRelation>,
    types: Own<TypeQuestions>,
  ) {
    this.store = store;
    this.text = text;
    this.relation = relation;
    this.types = types;
  }

  public readonly answerOf(tested: Type, name: string): Finding | undefined {
    if (name == kBigintTypeOf) {
      return { code: Code.TypeOfBigint, details: kNoDetails };
    }
    if (!kTypeOfNames.includes(name)) {
      return this.nameAnswer(tested, name);
    }

    const plain = this.types.definedType(tested);
    const parts = this.types.unionMembers(plain);
    const isOpen =
      parts.some((part) => part.kind == TypeKind.Error) ||
      plain.kind == TypeKind.TypeParameter;
    if (isOpen) {
      return undefined;
    }

    const names = this.typeOfNames(tested);
    if (names.length == 0 || names.includes(name)) {
      return undefined;
    }

    const first = this.text.of(tested);
    const other = this.quotedNames(names);
    const details: Details = { first, other, word: name };

    return { code: Code.TypeOfNever, details };
  }

  public readonly typeOfNames(type: Type): string[] {
    const names: string[] = [];

    this.addTypeOfNames(type, names);

    return names;
  }

  public readonly typeOfName(type: Type): string {
    switch (type.kind) {
      case TypeKind.Int: {
        const plain = this.store.integer(type.bits, type.unsigned);

        return this.text.of(plain);
      }
      case TypeKind.Double:
        return "double";
      case TypeKind.Decimal:
        return "decimal";
      case TypeKind.String:
      case TypeKind.Template:
        return "string";
      case TypeKind.Boolean:
        return "boolean";
      case TypeKind.Array:
      case TypeKind.Tuple:
        return "array";
      case TypeKind.Object:
      case TypeKind.Instance:
      case TypeKind.Result:
      case TypeKind.Iterator:
      case TypeKind.Dict:
      case TypeKind.Promise:
        return "object";
      case TypeKind.Function:
        return "function";
      case TypeKind.Class:
        return "class";
      case TypeKind.Literal:
        return this.literalTypeOfName(type);
      case TypeKind.Union:
        return this.unionTypeOfName(type.parts);
      case TypeKind.TypeParameter:
      case TypeKind.Json:
      case TypeKind.Unknown:
      case TypeKind.AnyObject:
      case TypeKind.Operation:
      case TypeKind.Error:
        return "";
      default:
        return kUndefinedTypeOf;
    }
  }

  private readonly nameAnswer(tested: Type, name: string): Finding {
    const all = this.quotedNames(kTypeOfNames);

    if (name == kSymbolTypeOf) {
      const details: Details = { other: all };

      return { code: Code.TypeOfNoSymbol, details };
    }
    if (name != kNumberTypeOf) {
      const details: Details = { word: name, other: all };

      return { code: Code.TypeOfNotName, details };
    }

    const numbers = this.numberTypeOfNames(tested);
    const isShown =
      numbers.length > 0 && numbers.length <= kMostShownNumberNames;
    if (!isShown) {
      return { code: Code.TypeOfNoNumber, details: kNoDetails };
    }

    const first = this.text.of(tested);
    const other = this.quotedNames(numbers);
    const details: Details = { first, other };

    return { code: Code.TypeOfNoNumberHere, details };
  }

  private readonly numberTypeOfNames(type: Type): string[] {
    if (type.kind == TypeKind.Error) {
      return [];
    }

    const names = this.typeOfNames(type);

    return names.filter((name) => this.isNumberTypeOfName(name));
  }

  private readonly isNumberTypeOfName(name: string): boolean {
    const isInteger = kIntegerTypeOfPrefixes.some((prefix) =>
      name.startsWith(prefix),
    );

    return isInteger || kNumberTypeOfNames.includes(name);
  }

  private readonly quotedNames(names: Read<string[]>): string {
    let list = "";
    let index = 0;

    for (const name of names) {
      list = list + this.nameSeparator(index, names.length) + `"${name}"`;
      index += 1;
    }

    return list;
  }

  private readonly nameSeparator(index: int, count: int): string {
    if (index == 0) {
      return "";
    }
    if (index + 1 == count) {
      return kLastNameSeparator;
    }

    return kNameSeparator;
  }

  private readonly addTypeOfNames(type: Type, names: string[]): void {
    if (this.types.isOptional(type)) {
      const plain = this.types.definedType(type);

      this.addTypeOfNames(plain, names);
      this.addName(kUndefinedTypeOf, names);

      return;
    }

    switch (type.kind) {
      case TypeKind.Json:
        return this.addNames(kJsonTypeOfNames, names);
      case TypeKind.Unknown: {
        const known = kTypeOfNames.filter((name) => name != kNullTypeOf);

        return this.addNames(known, names);
      }
      case TypeKind.TypeParameter:
        return this.addNames(kTypeOfNames, names);
      case TypeKind.AnyObject:
        return this.addNames(kAnyObjectTypeOfNames, names);
      case TypeKind.Union:
        for (const part of type.parts) {
          this.addTypeOfNames(part, names);
        }

        return;
      default:
        return this.addName(this.typeOfName(type), names);
    }
  }

  private readonly addNames(added: Read<string[]>, names: string[]): void {
    for (const name of added) {
      this.addName(name, names);
    }
  }

  private readonly addName(name: string, names: string[]): void {
    if (name != "" && !names.includes(name)) {
      names.push(name);
    }
  }

  private readonly literalTypeOfName(type: Type): string {
    const base = this.relation.baseOf(type);
    if (base == undefined) {
      return "";
    }

    return this.typeOfName(base);
  }

  private readonly unionTypeOfName(parts: Read<Type[]>): string {
    const first = parts[0];
    if (first == undefined) {
      return "";
    }

    const name = this.typeOfName(first);
    const isSame = parts.every((part) => this.typeOfName(part) == name);
    if (!isSame) {
      return "";
    }

    return name;
  }
}
