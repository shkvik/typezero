import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import { TypeStore } from "../../../program/type/type-store/type-store.tz";

export class TypeParts {
  private readonly store: TypeStore;

  public constructor(store: TypeStore) {
    this.store = store;
  }

  public genericParameters(type: Type): Type[] | undefined {
    const found: Type[] = [];
    const seen = new Set<int>();

    if (!this.collectParameters(type, found, seen)) {
      return undefined;
    }

    return found;
  }

  public hasUnknownInside(type: Type): boolean {
    const seen = new Set<int>();

    return this.isUnknownInside(type, seen);
  }

  public isOpaqueResult(type: Type): boolean {
    const seen = new Set<int>();

    return type.kind == TypeKind.Unknown || this.isVoidChoice(type, seen);
  }

  public isListParameter(param: Type): boolean {
    const constraint = this.store.constraintOf(param);
    if (constraint == undefined) {
      return false;
    }

    return (
      constraint.kind == TypeKind.Array || constraint.kind == TypeKind.Tuple
    );
  }

  public typeParts(type: Type): Type[] {
    switch (type.kind) {
      case TypeKind.Array:
        return [type.item];
      case TypeKind.Tuple:
        return type.items;
      case TypeKind.Object:
        return type.fields.map((field) => field.type);
      case TypeKind.Function: {
        const shape = type.shape;
        const params = shape.params.map((param) => param.type);

        return params.concat([shape.result]);
      }
      case TypeKind.Union:
        return type.parts;
      case TypeKind.Result:
        return [type.value, type.error];
      case TypeKind.Promise:
        return [type.value];
      case TypeKind.Class:
        return [type.instance];
      case TypeKind.Iterator: {
        const shape = type.shape;

        return [shape.yielded, shape.returned, shape.sent];
      }
      case TypeKind.Dict:
        return [type.key, type.value];
      case TypeKind.Instance:
        return type.args;
      default:
        return [];
    }
  }

  public mentionsParameter(type: Type): boolean {
    switch (type.kind) {
      case TypeKind.TypeParameter:
      case TypeKind.Operation:
      case TypeKind.Error:
        return true;
      case TypeKind.Array:
        return this.mentionsParameter(type.item);
      case TypeKind.Tuple:
        return type.items.some((item) => this.mentionsParameter(item));
      case TypeKind.Union:
        return type.parts.some((part) => this.mentionsParameter(part));
      case TypeKind.Function: {
        const shape = type.shape;
        const params = shape.params.map((param) => param.type);

        return (
          this.mentionsParameter(shape.result) ||
          params.some((param) => this.mentionsParameter(param))
        );
      }
      case TypeKind.Result:
        return (
          this.mentionsParameter(type.value) ||
          this.mentionsParameter(type.error)
        );
      case TypeKind.Promise:
        return this.mentionsParameter(type.value);
      case TypeKind.Dict:
        return (
          this.mentionsParameter(type.key) || this.mentionsParameter(type.value)
        );
      case TypeKind.Instance:
        return type.args.some((arg) => this.mentionsParameter(arg));
      default:
        return false;
    }
  }

  private collectParameters(
    type: Type,
    found: Type[],
    seen: Set<int>,
  ): boolean {
    if (seen.has(type.id)) {
      return true;
    }

    seen.add(type.id);

    switch (type.kind) {
      case TypeKind.TypeParameter:
        found.push(type);

        return true;
      case TypeKind.Operation:
      case TypeKind.Error:
      case TypeKind.Template:
        return false;
      default: {
        const parts = this.typeParts(type);

        return parts.every((part) => this.collectParameters(part, found, seen));
      }
    }
  }

  private isUnknownInside(type: Type, seen: Set<int>): boolean {
    if (seen.has(type.id)) {
      return false;
    }

    seen.add(type.id);

    if (type.kind == TypeKind.Error) {
      return true;
    }

    const parts = this.typeParts(type);

    return parts.some((part) => this.isUnknownInside(part, seen));
  }

  private isVoidChoice(type: Type, seen: Set<int>): boolean {
    if (seen.has(type.id) || type.kind == TypeKind.Function) {
      return false;
    }

    seen.add(type.id);

    if (type.kind == TypeKind.Union) {
      const hasVoid = type.parts.some((part) => part.kind == TypeKind.Void);
      if (hasVoid) {
        return true;
      }
    }
    if (type.kind == TypeKind.Object) {
      const hasVoid = type.fields.some(
        (field) => field.type.kind == TypeKind.Void,
      );
      if (hasVoid) {
        return true;
      }
    }
    if (type.kind == TypeKind.Promise || type.kind == TypeKind.Result) {
      return false;
    }

    const parts = this.typeParts(type);

    return parts.some((part) => this.isVoidChoice(part, seen));
  }
}
