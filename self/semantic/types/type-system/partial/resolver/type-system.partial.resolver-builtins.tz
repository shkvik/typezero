import { TypeSystem } from "../../type-system.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  TypeAliasDecl,
} from "../../../../../program/ast/types/ast.types.classes.tz";
import {
  TypeRef,
  TypeRefKind,
} from "../../../../../program/ast/types/ast.types.types.tz";
import {
  NameSymbol,
  SymbolKind,
} from "../../../../../program/scopes/types/scopes.types.tz";
import {
  DictKind,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  kArrayName,
  kBuiltinNames,
  kGenericTypes,
  kJsonName,
  kNumber,
  kNumericNames,
  kPlainTypes,
  kTextChanges,
} from "../../../type-resolver/const/type-resolver.const.tables.tz";
import {
  GenericBuiltin,
  GenericTypeName,
  PlainBuiltin,
  TypeContext,
} from "../../../type-resolver/types/type-resolver.types.tz";

partial class TypeSystem {
  private builtin(
    name: string,
    ref: TypeRef,
    context: Read<TypeContext>,
  ): Type | undefined {
    const tree = this.program.tree;

    const generic = kGenericTypes.find((row) => row.name == name);
    if (generic != undefined) {
      return this.generic(ref, generic, context);
    }

    const change = kTextChanges.find((row) => row.name == name);
    if (change != undefined) {
      return this.textChange(ref, change, context);
    }

    const plain = kPlainTypes.find((row) => row.name == name);
    if (plain == undefined) {
      return undefined;
    }
    const args = tree.typeRefsOf(ref.argsList);
    if (args.length > 0) {
      this.report(context.module, ref.loc, Code.PlainTypeNotGeneric, {
        word: name,
      });

      return this.store.plain(TypeKind.Error);
    }

    return this.plain(plain.type);
  }

  private generic(
    ref: TypeRef,
    row: GenericTypeName,
    context: Read<TypeContext>,
  ): Type {
    const tree = this.program.tree;

    const count = tree.typeRefsOf(ref.argsList).length;
    if (count < row.least || count > row.most) {
      const code = this.countCode(row, count);

      this.report(context.module, ref.loc, code, {
        word: row.name,
        other: row.example,
      });

      return this.store.plain(TypeKind.Error);
    }

    const args = this.genericArguments(
      tree.typeRefsOf(ref.argsList),
      row.values,
      context,
    );
    const error = this.store.plain(TypeKind.Error);
    const first = args[0] ?? error;
    const second = args[1] ?? error;

    switch (row.type) {
      case GenericBuiltin.Array:
        return this.listOf(ref, first, false, context);
      case GenericBuiltin.Result:
        return this.store.resultOf(first, second);
      case GenericBuiltin.Promise:
        return this.promised(ref, first, context);
      case GenericBuiltin.Map:
        return this.keyedDict(ref, DictKind.Map, first, second, context);
      case GenericBuiltin.Set:
        return this.keyedDict(ref, DictKind.Set, first, first, context);
      case GenericBuiltin.Record:
        return this.keyed(ref, first, second, context);
      case GenericBuiltin.Generator:
        return this.iterator(args, false);
      case GenericBuiltin.Constructor:
        return this.constructorType(ref, args, context);
      case GenericBuiltin.Mode:
        return first;
      default:
        return this.iterator(args, true);
    }
  }

  private iterator(args: Read<Type[]>, async: boolean): Type {
    const nothing = this.store.plain(TypeKind.Void);
    const yielded = args[0] ?? nothing;
    const returned = args[1] ?? nothing;
    const sent = args[2] ?? nothing;

    return this.store.iteratorOf({ yielded, returned, sent, async });
  }

  private plain(type: PlainBuiltin): Type {
    switch (type) {
      case PlainBuiltin.Int:
        return this.store.integer(64, false);
      case PlainBuiltin.Int8:
        return this.store.integer(8, false);
      case PlainBuiltin.Int16:
        return this.store.integer(16, false);
      case PlainBuiltin.Int32:
        return this.store.integer(32, false);
      case PlainBuiltin.Uint8:
        return this.store.integer(8, true);
      case PlainBuiltin.Uint16:
        return this.store.integer(16, true);
      case PlainBuiltin.Uint32:
        return this.store.integer(32, true);
      case PlainBuiltin.Uint64:
        return this.store.integer(64, true);
      case PlainBuiltin.Wrap32:
        return this.store.wrapping(32);
      case PlainBuiltin.Wrap64:
        return this.store.wrapping(64);
      case PlainBuiltin.Double:
        return this.store.plain(TypeKind.Double);
      case PlainBuiltin.String:
        return this.store.plain(TypeKind.String);
      case PlainBuiltin.Boolean:
        return this.store.plain(TypeKind.Boolean);
      case PlainBuiltin.Decimal:
        return this.store.plain(TypeKind.Decimal);
      case PlainBuiltin.Json:
        return this.store.plain(TypeKind.Json);
      case PlainBuiltin.Unknown:
        return this.store.plain(TypeKind.Unknown);
      case PlainBuiltin.Never:
        return this.store.plain(TypeKind.Never);
      case PlainBuiltin.Void:
        return this.store.plain(TypeKind.Void);
      case PlainBuiltin.Undefined:
        return this.store.plain(TypeKind.Undefined);
      default:
        return this.store.plain(TypeKind.AnyObject);
    }
  }

  private readonly countCode(row: GenericTypeName, count: int): Code {
    if (count == 0) {
      return row.few;
    }

    return row.many;
  }

  private builtinAliasCheck(module: int, decl: TypeAliasDecl): void {
    const tree = this.program.tree;

    const name = decl.name;
    const isNumeric = kNumericNames.includes(name);
    const isBuiltin = isNumeric || kBuiltinNames.includes(name);
    if (!isBuiltin || this.record(module)?.library != false) {
      return;
    }

    const body = tree.typeRefOf(decl.typeId);
    const isNumberAlias =
      isNumeric && body.form.kind == TypeRefKind.Name && body.name == kNumber;
    const isJsonUnion =
      name == kJsonName && body.form.kind == TypeRefKind.Union;
    if (isNumberAlias || isJsonUnion) {
      return;
    }
    if (isNumeric) {
      this.report(module, decl.loc, Code.BuiltinNumberRedefined, {
        word: name,
      });

      return;
    }

    this.report(module, decl.loc, Code.BuiltinTypeRedefined, { word: name });
  }

  private readonly isBuiltinShadow(symbol: NameSymbol): boolean {
    if (symbol.kind != SymbolKind.TypeAlias) {
      return false;
    }

    const name = symbol.name;
    const isPlain = kPlainTypes.some((row) => row.name == name);

    return isPlain || name == kArrayName;
  }

  private keyedDict(
    ref: TypeRef,
    dict: DictKind,
    key: Type,
    value: Type,
    context: Read<TypeContext>,
  ): Type {
    const tree = this.program.tree;

    const written = tree.typeRefsOf(ref.argsList)[0];
    if (this.keyCheck(written, key, context.module)) {
      return this.store.plain(TypeKind.Error);
    }

    return this.store.dictOf(dict, key, value);
  }

  public keyCheck(
    written: TypeRef | undefined,
    key: Type | undefined,
    module: int,
  ): boolean {
    if (written == undefined || key == undefined) {
      return false;
    }

    const code = this.keyProblem(key);
    if (code == undefined) {
      return false;
    }

    this.report(module, written.loc, code, kNoDetails);

    return true;
  }

  private readonly keyProblem(key: Type): Code | undefined {
    if (key.kind == TypeKind.Unknown) {
      return Code.KeyUnknown;
    }
    if (key.kind == TypeKind.Result) {
      return Code.KeyResult;
    }
    if (key.kind != TypeKind.Union) {
      return undefined;
    }

    const isResult = this.store
      .partsOf(key)
      .some((part) => part.kind == TypeKind.Result);
    if (isResult) {
      return Code.KeyResult;
    }

    return undefined;
  }
}
