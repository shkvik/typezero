import { TypeSystem } from "../../type-system.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  TypeParamDecl,
  TypeRef,
  TypeRefKind,
} from "../../../../../program/ast/types/ast.types.types.tz";
import {
  LiteralKind,
  ObjectField,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  kPlainTypes,
} from "../../../type-resolver/const/type-resolver.const.tables.tz";
import {
  TypeContext,
  TypePlace,
} from "../../../type-resolver/types/type-resolver.types.tz";

partial class TypeSystem {
  public typeParameters(module: int, params: Read<TypeParamDecl[]>): void {
    const tree = this.program.tree;

    const context = this.plainContext(module);
    let defaulted = false;

    for (const param of params) {
      const name = param.name;
      const constraint = tree.typeRefAt(param.constraintId);
      const fallback = tree.typeRefAt(param.defaultTypeId);

      if (kPlainTypes.some((row) => row.name == name)) {
        this.report(module, param.loc, Code.BuiltinTypeParameterName, {
          word: name,
        });
      }
      if (constraint != undefined) {
        this.value(constraint, context);
      }
      if (fallback == undefined && defaulted) {
        this.report(module, param.loc, Code.DefaultMissing, { word: name });
      }
      if (fallback != undefined) {
        defaulted = true;
        this.checkDefault(param, fallback, context);
      }
    }
  }

  private checkDefault(
    param: TypeParamDecl,
    fallback: TypeRef,
    context: Read<TypeContext>,
  ): void {
    const tree = this.program.tree;

    const constraint = tree.typeRefAt(param.constraintId);
    if (constraint == undefined) {
      return;
    }

    const given = this.resolve(fallback, context);
    const ways = this.constraintWays(constraint, context);
    if (this.satisfies(given, ways)) {
      return;
    }

    const first = this.typeText(given);
    const other = this.constraintText(context.module, param, constraint);

    this.report(context.module, fallback.loc, Code.DefaultNotSatisfying, {
      word: param.name,
      first,
      other,
    });
  }

  private readonly plainContext(module: int): TypeContext {
    return { module, bindings: new Map<int, Type>(), place: TypePlace.Plain };
  }

  private opened(
    module: int,
    loc: int,
    name: string,
    written: TypeRef | undefined,
  ): Type {
    const type = this.store.typeParameter(module, loc, name);
    if (written == undefined || this.bounded.has(type.id)) {
      return type;
    }

    this.bounded.add(type.id);

    const context = this.plainContext(module);
    const constraint = this.resolve(written, context);
    const isFree =
      constraint.kind == TypeKind.Unknown || constraint.kind == TypeKind.Error;
    if (!isFree) {
      this.store.constrain(type, constraint);
    }

    return type;
  }

  private constraintText(
    module: int,
    param: TypeParamDecl,
    written: TypeRef,
  ): string {
    const open = this.opened(module, param.loc, param.name, written);
    const declared = this.store.constraintOf(open);
    const isName = written.form.kind == TypeRefKind.Name;
    if (declared == undefined || isName) {
      return written.name;
    }

    return this.typeText(declared);
  }

  private resolverArgumentsFit(
    ref: TypeRef,
    home: int,
    name: string,
    params: Read<TypeParamDecl[]>,
    written: Read<Type[]>,
    context: Read<TypeContext>,
  ): boolean {
    const tree = this.program.tree;

    const bindings = this.bind(home, params, written);
    const inside: TypeContext = {
      module: home,
      bindings: new Map<int, Type>(bindings),
      place: TypePlace.Plain,
    };

    for (const param of params.slice(0, written.length)) {
      const constraint = tree.typeRefAt(param.constraintId);
      const given = bindings.get(param.loc);
      if (constraint == undefined || given == undefined) {
        continue;
      }

      const ways = this.constraintWays(constraint, inside);
      if (this.satisfies(given, ways)) {
        continue;
      }

      const first = this.typeText(given);
      const other = this.constraintText(home, param, constraint);

      this.report(context.module, ref.loc, Code.ConstraintNotSatisfied, {
        word: param.name,
        first,
        other,
        second: name,
      });

      return false;
    }

    return true;
  }

  private constraintWays(written: TypeRef, context: Read<TypeContext>): Type[] {
    const tree = this.program.tree;

    if (written.form.kind != TypeRefKind.Union) {
      return [this.resolve(written, context)];
    }

    const args = tree.typeRefsOf(written.argsList);
    const ways = this.resolveAll(args, context);
    if (ways.some((way) => way.kind == TypeKind.Undefined)) {
      return [this.store.unionOf(ways)];
    }

    return ways;
  }

  private satisfies(given: Type, ways: Type[]): boolean {
    if (given.kind == TypeKind.Error || given.kind == TypeKind.Operation) {
      return true;
    }
    if (this.holes.has(given.id)) {
      return true;
    }
    if (ways.some((way) => this.fitsWay(given, way))) {
      return true;
    }

    const own = this.store.constraintOf(given);
    if (given.kind != TypeKind.TypeParameter || own == undefined) {
      return false;
    }

    return this.resolverPartsOf(own).every((part) =>
      this.satisfies(part, ways),
    );
  }

  private fitsWay(given: Type, way: Type): boolean {
    const seen = new Set<int>();
    if (way.kind == TypeKind.Unknown || this.depends(way, seen)) {
      return true;
    }
    if (this.converts(given, way)) {
      return true;
    }
    if (
      way.kind == TypeKind.Array &&
      this.store.itemOf(way).kind == TypeKind.Unknown
    ) {
      return given.kind == TypeKind.Array || given.kind == TypeKind.Tuple;
    }

    if (way.kind == TypeKind.Tuple) {
      return this.startsWith(given, this.store.itemsOf(way));
    }

    return (
      way.kind == TypeKind.Object &&
      this.hasMembers(given, this.store.fieldsOf(way))
    );
  }

  private readonly startsWith(given: Type, wanted: Read<Type[]>): boolean {
    if (
      given.kind != TypeKind.Tuple ||
      this.store.itemsOf(given).length < wanted.length
    ) {
      return false;
    }

    for (let index = 0; index < wanted.length; index++) {
      const have = this.store.itemsOf(given)[index];
      const item = wanted[index];
      if (have == undefined || item == undefined) {
        return false;
      }

      const isNarrower = item.kind == TypeKind.String && this.isTextual(have);
      if (have.id != item.id && !isNarrower) {
        return false;
      }
    }

    return true;
  }

  private hasMembers(given: Type, wanted: Read<ObjectField[]>): boolean {
    for (const part of this.resolverPartsOf(given)) {
      if (!this.partHasMembers(part, wanted)) {
        return false;
      }
    }

    return true;
  }

  private partHasMembers(part: Type, wanted: Read<ObjectField[]>): boolean {
    if (part.kind != TypeKind.Object && part.kind != TypeKind.Instance) {
      return false;
    }

    const fields = this.fieldsOf(part);

    for (const field of wanted) {
      const have = fields.find((one) => one.name == field.name);
      if (have != undefined && !this.isSameMember(have, field)) {
        return false;
      }
      if (have == undefined && !this.isSpared(part, field)) {
        return false;
      }
    }

    return true;
  }

  private fieldsOf(part: Type): ObjectField[] {
    if (part.kind == TypeKind.Object) {
      return this.store.fieldsOf(part).slice();
    }
    if (part.kind == TypeKind.Instance) {
      return this.inheritedFields(part);
    }

    return [];
  }

  private readonly isSameMember(
    have: ObjectField,
    wanted: ObjectField,
  ): boolean {
    const isExact =
      have.type.id == wanted.type.id && have.optional == wanted.optional;
    const isNarrower =
      wanted.type.kind == TypeKind.String && this.isTextual(have.type);
    const mayWrite = !have.readonly || wanted.readonly;

    return (isExact || isNarrower) && mayWrite;
  }

  private readonly isTextual(type: Type): boolean {
    return this.resolverPartsOf(type).every(
      (part) =>
        part.kind == TypeKind.Literal && part.literal == LiteralKind.String,
    );
  }

  private isSpared(part: Type, wanted: ObjectField): boolean {
    const isMethod = wanted.readonly && wanted.type.kind == TypeKind.Function;
    if (part.kind != TypeKind.Instance || !isMethod) {
      return wanted.optional;
    }

    const methods = this.methodTypes(part, wanted.name);
    const found = methods.some(
      (method) => method.id == wanted.type.id || method.kind == TypeKind.Error,
    );

    return found || wanted.optional;
  }
}
