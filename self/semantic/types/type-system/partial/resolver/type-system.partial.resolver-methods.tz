import { TypeSystem } from "../../type-system.tz";
import {
  Access,
  ClassDecl,
  MethodKind,
} from "../../../../../program/ast/types/ast.types.classes.tz";
import {
  DeclaredClass,
  DeclaredMemberKind,
} from "../../../../../program/ast/types/ast.types.declarations.tz";
import { Param } from "../../../../../program/ast/types/ast.types.functions.tz";
import {
  StmtKind,
} from "../../../../../program/ast/types/ast.types.statements.tz";
import { TypeRef } from "../../../../../program/ast/types/ast.types.types.tz";
import {
  InstanceType,
  ObjectField,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  ParameterSite,
  TypeContext,
} from "../../../type-resolver/types/type-resolver.types.tz";

partial class TypeSystem {
  private inheritedFields(instance: InstanceType): ObjectField[] {
    const fields = this.memberFields(instance).slice();

    for (const parent of this.store.parentsOf(instance)) {
      if (parent.kind != TypeKind.Instance) {
        continue;
      }

      for (const field of this.inheritedFields(parent)) {
        if (!fields.some((own) => own.name == field.name)) {
          fields.push(field);
        }
      }
    }

    return fields;
  }

  private methodTypes(instance: InstanceType, name: string): Type[] {
    const types = this.ownMethods(instance, name);

    for (const parent of this.store.parentsOf(instance)) {
      if (parent.kind != TypeKind.Instance) {
        continue;
      }

      for (const type of this.methodTypes(parent, name)) {
        types.push(type);
      }
    }

    return types;
  }

  private ownMethods(instance: InstanceType, name: string): Type[] {
    const record = this.record(instance.module);
    if (record == undefined) {
      return [];
    }

    const decl = this.ownClassAt(record, instance.loc);
    const declared = this.declaredClassAt(record, instance.loc);
    if (decl != undefined) {
      return this.classMethods(instance, decl, name);
    }
    if (declared != undefined) {
      return this.declaredMethods(instance, declared, name);
    }

    return [];
  }

  private classMethods(
    instance: InstanceType,
    decl: ClassDecl,
    name: string,
  ): Type[] {
    const tree = this.program.tree;

    const context = this.inside(
      instance,
      tree.typeParamsOf(decl.typeParamsList),
    );
    const types: Type[] = [];

    for (const method of tree.functionsOf(decl.methodsList)) {
      const role = method.role;
      const open =
        role != undefined &&
        role.access == Access.Public &&
        role.method != MethodKind.Static;
      if (
        method.name != name ||
        !open ||
        tree.typeParamsOf(method.typeParamsList).length > 0
      ) {
        continue;
      }

      const type = this.methodType(
        tree.paramsOf(method.paramsList),
        tree.typeRefAt(method.returnTypeId),
        context,
      );

      types.push(type);
    }

    return types;
  }

  private declaredMethods(
    instance: InstanceType,
    declared: DeclaredClass,
    name: string,
  ): Type[] {
    const tree = this.program.tree;

    const context = this.inside(
      instance,
      tree.typeParamsOf(declared.typeParamsList),
    );
    const types: Type[] = [];

    for (const member of tree.declaredMembersOf(declared.membersList)) {
      const form = member.form;
      const hidden = member.access != Access.Public || member.isStatic;

      if (form.kind != DeclaredMemberKind.Method || member.name != name) {
        continue;
      }
      if (hidden || tree.typeParamsOf(form.typeParamsList).length > 0) {
        continue;
      }

      const type = this.methodType(
        tree.paramsOf(form.paramsList),
        tree.typeRefAt(member.typeId),
        context,
      );

      types.push(type);
    }

    return types;
  }

  private methodType(
    params: Read<Param[]>,
    result: TypeRef | undefined,
    context: Read<TypeContext>,
  ): Type {
    const tree = this.program.tree;

    const sites: ParameterSite[] = [];

    for (const param of params) {
      const type = tree.typeRefAt(param.typeId);
      if (type != undefined) {
        sites.push({
          name: param.name,
          loc: param.loc,
          kind: param.form.kind,
          type,
          isDeclared: false,
        });
      }
    }

    if (result == undefined || sites.length < params.length) {
      return this.store.plain(TypeKind.Error);
    }

    return this.signature(sites, result, context);
  }
}
