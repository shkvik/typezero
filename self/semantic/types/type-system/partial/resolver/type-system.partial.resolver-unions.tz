import { TypeSystem } from "../../type-system.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import {
  TypeRef,
  TypeRefKind,
} from "../../../../../program/ast/types/ast.types.types.tz";
import { kLibrary } from "../../../../../program/library/library-modules/const/library-modules.const.tz";
import {
  LiteralKind,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  kJsonKinds,
  kNullTypeName,
} from "../../../type-resolver/const/type-resolver.const.tables.tz";
import {
  SlotUse,
  TypeContext,
  UnionProblem,
  UnionSlot,
} from "../../../type-resolver/types/type-resolver.types.tz";

partial class TypeSystem {
  private union(ref: TypeRef, context: Read<TypeContext>): Type {
    const tree = this.program.tree;

    const written: TypeRef[] = [];

    for (const arg of tree.typeRefsOf(ref.argsList)) {
      if (!this.isNull(arg)) {
        written.push(arg);
      }
    }

    const parts: Type[] = [];

    for (const one of written) {
      const part = this.resolve(one, context);
      if (part.kind == TypeKind.Error) {
        return part;
      }

      parts.push(part);
    }

    const joined = this.store.unionOf(parts);
    const hasNull = written.length < tree.typeRefsOf(ref.argsList).length;
    const refused =
      this.refusesVoid(ref, parts, context) ||
      this.refusesNull(ref, joined, hasNull, context) ||
      this.refusesClash(ref, joined, context);
    if (refused) {
      return this.store.plain(TypeKind.Error);
    }

    return joined;
  }

  private readonly isNull(ref: TypeRef): boolean {
    return ref.form.kind == TypeRefKind.Name && ref.name == kNullTypeName;
  }

  private refusesVoid(
    ref: TypeRef,
    parts: Read<Type[]>,
    context: Read<TypeContext>,
  ): boolean {
    if (!parts.some((part) => part.kind == TypeKind.Void)) {
      return false;
    }

    this.report(context.module, ref.loc, Code.VoidInUnion, kNoDetails);

    return true;
  }

  private refusesNull(
    ref: TypeRef,
    joined: Type,
    hasNull: boolean,
    context: Read<TypeContext>,
  ): boolean {
    const rest = this.withoutUndefined(joined);
    if (!hasNull || rest.kind == TypeKind.Json) {
      return false;
    }

    this.report(context.module, ref.loc, Code.NullInUnion, kNoDetails);

    return true;
  }

  public readonly unionProblem(joined: Type): UnionProblem | undefined {
    if (joined.kind != TypeKind.Union) {
      return undefined;
    }

    const present: Type[] = [];

    for (const part of this.store.partsOf(joined)) {
      if (part.kind != TypeKind.Undefined) {
        present.push(part);
      }
    }

    if (present.length < 2) {
      return undefined;
    }

    const word = this.structureText(joined);
    const hasJson = present.some((part) => part.kind == TypeKind.Json);
    const seen: SlotUse[] = [];

    for (const part of present) {
      const shared = this.sharedWithJson(part);
      if (hasJson && shared != "") {
        const first = this.typeText(part);
        const details = { word, first, other: shared };

        return { code: Code.UnionWithJson, details };
      }
      if (part.kind == TypeKind.Result) {
        return { code: Code.UnionWithResult, details: { word } };
      }

      const use = this.slotUse(part);
      const before = seen.find(
        (one) => one.slot == use.slot && one.home == use.home,
      );
      const clashes = before != undefined && before.type.id != use.type.id;
      if (use.slot != UnionSlot.None && before != undefined && clashes) {
        const code = this.clashCode(use.slot);
        const first = this.typeText(before.type);
        const second = this.typeText(use.type);
        const other = this.clashHint(before.type, use.type);

        return { code, details: { word, first, second, other } };
      }

      seen.push(use);
    }

    return undefined;
  }

  private refusesClash(
    ref: TypeRef,
    joined: Type,
    context: Read<TypeContext>,
  ): boolean {
    const module = context.module;
    const record = this.record(module);
    const native = record != undefined && record.native;
    if (native) {
      return false;
    }

    const problem = this.unionProblem(joined);
    if (problem == undefined) {
      return false;
    }

    this.report(module, ref.loc, problem.code, problem.details);

    return true;
  }

  private readonly sharedWithJson(part: Type): string {
    const kind = this.baseKind(part);
    const row = kJsonKinds.find((one) => one.kind == kind);

    return row?.name ?? "";
  }

  private readonly baseKind(part: Type): TypeKind {
    if (part.kind != TypeKind.Literal) {
      return part.kind;
    }

    switch (part.literal) {
      case LiteralKind.String:
        return TypeKind.String;
      case LiteralKind.Boolean:
        return TypeKind.Boolean;
      case LiteralKind.Double:
        return TypeKind.Double;
      default:
        return TypeKind.Int;
    }
  }

  private readonly slotUse(part: Type): SlotUse {
    if (part.kind == TypeKind.Instance) {
      const slot = this.instanceSlot(part.module);

      return { slot, home: part.module, type: part };
    }

    const number = this.baseOf(part) ?? part;
    if (number.kind == TypeKind.Int) {
      const plain = this.store.integer(number.bits, number.unsigned);

      return { slot: UnionSlot.Number, home: plain.id, type: number };
    }

    const slot = this.resolverSlotOf(part);

    return { slot, home: 0, type: part };
  }

  private readonly resolverSlotOf(part: Type): UnionSlot {
    switch (part.kind) {
      case TypeKind.Array:
        return UnionSlot.Array;
      case TypeKind.Function:
        return UnionSlot.Function;
      case TypeKind.Promise:
        return UnionSlot.Promise;
      case TypeKind.Iterator:
        return this.iteratorSlot(this.store.iteratorShapeOf(part).async);
      default:
        return UnionSlot.None;
    }
  }

  private readonly iteratorSlot(async: boolean): UnionSlot {
    if (async) {
      return UnionSlot.AsyncIterator;
    }

    return UnionSlot.Iterator;
  }

  private readonly instanceSlot(module: int): UnionSlot {
    if (this.untaggedGroup(module) == undefined) {
      return UnionSlot.None;
    }

    return UnionSlot.Untagged;
  }

  private readonly untaggedGroup(module: int): string | undefined {
    if (module < 0) {
      return undefined;
    }

    const name = this.program.modules[module]?.name ?? "";
    const row = kLibrary.named(name);
    const untagged = row?.untagged ?? false;
    if (row == undefined || !untagged) {
      return undefined;
    }

    return row.namespace ?? row.name;
  }

  private readonly clashCode(slot: UnionSlot): Code {
    switch (slot) {
      case UnionSlot.Array:
        return Code.UnionOfArrays;
      case UnionSlot.Function:
        return Code.UnionOfFunctions;
      case UnionSlot.Promise:
        return Code.UnionOfPromises;
      case UnionSlot.Untagged:
        return Code.UnionOfUntagged;
      case UnionSlot.Number:
        return Code.UnionOfNumbers;
      default:
        return Code.UnionOfIterators;
    }
  }

  private readonly clashHint(before: Type, now: Type): string {
    if (before.kind == TypeKind.Array && now.kind == TypeKind.Array) {
      const first = this.typeText(this.store.itemOf(before));
      const second = this.typeText(this.store.itemOf(now));

      return `(${first} | ${second})[]`;
    }
    if (before.kind == TypeKind.Promise && now.kind == TypeKind.Promise) {
      const first = this.typeText(this.store.valueOf(before));
      const second = this.typeText(this.store.valueOf(now));

      return `Promise<${first} | ${second}>`;
    }
    if (now.kind == TypeKind.Instance) {
      return this.untaggedGroup(now.module) ?? "";
    }
    if (now.kind == TypeKind.Int) {
      const plain = this.store.integer(now.bits, now.unsigned);

      return this.typeText(plain);
    }

    return "";
  }
}
