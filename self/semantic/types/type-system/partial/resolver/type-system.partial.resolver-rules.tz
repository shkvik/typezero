import { TypeSystem } from "../../type-system.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../../diagnostic/const/message.const.tz";
import { TypeRef } from "../../../../../program/ast/types/ast.types.types.tz";
import {
  SymbolKind,
} from "../../../../../program/scopes/types/scopes.types.tz";
import {
  DictKind,
  ObjectField,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  TypeContext,
  TypePlace,
} from "../../../type-resolver/types/type-resolver.types.tz";

partial class TypeSystem {
  public value(ref: TypeRef, context: Read<TypeContext>): Type {
    const type = this.resolve(ref, context);
    if (type.kind == TypeKind.Void && !this.isArgument(ref, context)) {
      this.report(context.module, ref.loc, Code.VoidPlace, kNoDetails);

      return this.store.plain(TypeKind.Error);
    }

    return this.present(ref, type, context);
  }

  private isArgument(ref: TypeRef, context: Read<TypeContext>): boolean {
    const record = this.record(context.module);
    const symbol = record?.uses.get(ref.loc)?.symbol;

    return symbol != undefined && symbol.kind == SymbolKind.TypeParameter;
  }

  private present(ref: TypeRef, type: Type, context: Read<TypeContext>): Type {
    if (type.kind != TypeKind.Undefined || this.isLibrary(context.module)) {
      return type;
    }

    this.report(context.module, ref.loc, Code.UndefinedAlone, kNoDetails);

    return this.store.plain(TypeKind.Error);
  }

  private isLibrary(module: int): boolean {
    const record = this.record(module);

    return record != undefined && record.library;
  }

  private genericArguments(
    refs: Read<TypeRef[]>,
    values: int,
    context: Read<TypeContext>,
  ): Type[] {
    const types: Type[] = [];

    for (const ref of refs) {
      const type = this.argument(ref, types.length < values, context);

      types.push(type);
    }

    return types;
  }

  private argument(
    ref: TypeRef,
    isValue: boolean,
    context: Read<TypeContext>,
  ): Type {
    if (isValue) {
      return this.value(ref, context);
    }

    return this.resolve(ref, context);
  }

  private promised(
    ref: TypeRef,
    value: Type,
    context: Read<TypeContext>,
  ): Type {
    const tree = this.program.tree;

    const written = tree.typeRefsOf(ref.argsList)[0] ?? ref;
    const present = this.present(written, value, context);

    return this.store.promiseOf(present);
  }

  private listOf(
    ref: TypeRef,
    item: Type,
    readonly: boolean,
    context: Read<TypeContext>,
  ): Type {
    if (item.kind == TypeKind.Void || item.kind == TypeKind.Undefined) {
      return this.nothingList(ref, item, context);
    }
    if (readonly) {
      return this.store.readonlyArrayOf(item);
    }

    return this.store.arrayOf(item);
  }

  private nothingList(
    ref: TypeRef,
    item: Type,
    context: Read<TypeContext>,
  ): Type {
    const word = this.typeText(item);

    this.report(context.module, ref.loc, Code.ArrayOfNothing, { word });

    return this.store.plain(TypeKind.Error);
  }

  private keyed(
    ref: TypeRef,
    key: Type,
    value: Type,
    context: Read<TypeContext>,
  ): Type {
    const tree = this.program.tree;

    const parts = this.resolverPartsOf(key);
    const texts = parts.every((part) => this.isText(part));
    if (parts.every((part) => part.kind == TypeKind.Literal) && texts) {
      return this.fieldPerKey(parts, value);
    }
    if (texts || key.kind == TypeKind.Error) {
      return this.store.dictOf(DictKind.Record, key, value);
    }

    const written = tree.typeRefsOf(ref.argsList)[0] ?? ref;
    const code = this.keyCode(key);
    const word = this.typeText(key);
    const other = this.typeText(value);

    this.report(context.module, written.loc, code, { word, other });

    return this.store.plain(TypeKind.Error);
  }

  private fieldPerKey(keys: Read<Type[]>, value: Type): Type {
    const type = this.withoutUndefined(value);
    const optional = type.id != value.id;
    const fields: ObjectField[] = [];

    for (const key of keys) {
      if (key.kind == TypeKind.Literal) {
        fields.push({ name: key.text, type, optional, readonly: false });
      }
    }

    return this.store.objectOf(fields);
  }

  private readonly keyCode(key: Type): Code {
    if (key.kind == TypeKind.Int || key.kind == TypeKind.Double) {
      return Code.RecordNumberKeys;
    }

    return Code.RecordKeys;
  }

  private inferred(ref: TypeRef, context: Read<TypeContext>): Type {
    if (context.place == TypePlace.Pattern) {
      return this.store.typeParameter(context.module, ref.loc, ref.name);
    }

    this.report(context.module, ref.loc, Code.InferPlace, kNoDetails);

    return this.store.plain(TypeKind.Error);
  }

  private refusedNull(ref: TypeRef, context: Read<TypeContext>): Type {
    if (!this.isLibrary(context.module)) {
      this.report(context.module, ref.loc, Code.NullType, kNoDetails);
    }

    return this.store.plain(TypeKind.Error);
  }

  private readonly placed(
    context: Read<TypeContext>,
    place: TypePlace,
  ): TypeContext {
    const bindings = new Map<int, Type>(context.bindings);
    if (context.place == TypePlace.Pattern) {
      return { module: context.module, bindings, place: context.place };
    }

    return { module: context.module, bindings, place };
  }
}
