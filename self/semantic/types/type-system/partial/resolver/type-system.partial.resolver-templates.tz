import { TypeSystem } from "../../type-system.tz";
import { Code } from "../../../../../diagnostic/code.tz";
import {
  TemplateTypeForm,
  TypeRef,
} from "../../../../../program/ast/types/ast.types.types.tz";
import {
  LiteralKind,
  OperationKind,
  Type,
  TypeKind,
} from "../../../../../program/type/types/type.types.tz";
import {
  kFalseText,
  kTrueText,
} from "../../../type-resolver/const/type-resolver.const.tables.tz";
import {
  TextChange,
  TextChangeName,
  TypeContext,
} from "../../../type-resolver/types/type-resolver.types.tz";

partial class TypeSystem {
  private template(
    ref: TypeRef,
    form: TemplateTypeForm,
    context: Read<TypeContext>,
  ): Type {
    const tree = this.program.tree;

    const args = tree.typeRefsOf(ref.argsList);
    const parts = this.resolveAll(args, context);

    for (let index = 0; index < parts.length; index++) {
      const part = parts[index];
      const place = tree.typeRefsOf(ref.argsList)[index];
      if (part != undefined && place != undefined && !this.isHoleType(part)) {
        this.report(context.module, place.loc, Code.TemplateHole, {
          word: this.typeText(part),
        });

        return this.store.plain(TypeKind.Error);
      }
    }

    let texts: string[] = [tree.textsOf(form.textsList)[0] ?? ""];

    for (let index = 0; index < parts.length; index++) {
      const choices = this.textChoices(parts[index]);
      if (choices == undefined) {
        const textsItem = tree.textsOf(form.textsList);

        return this.store.templateOf(textsItem, parts);
      }

      const after = tree.textsOf(form.textsList)[index + 1] ?? "";

      texts = this.combined(texts, choices, after);
    }

    const literals: Type[] = [];

    for (const text of texts) {
      const literal = this.store.literal(LiteralKind.String, text);

      literals.push(literal);
    }

    return this.store.unionOf(literals);
  }

  private readonly combined(
    starts: Read<string[]>,
    choices: Read<string[]>,
    after: string,
  ): string[] {
    const texts: string[] = [];

    for (const start of starts) {
      for (const choice of choices) {
        texts.push(`${start}${choice}${after}`);
      }
    }

    return texts;
  }

  private readonly textChoices(type: Type | undefined): string[] | undefined {
    if (type == undefined) {
      return undefined;
    }

    switch (type.kind) {
      case TypeKind.Literal:
        return [type.text];
      case TypeKind.Boolean:
        return [kFalseText, kTrueText];
      case TypeKind.Union: {
        const texts: string[] = [];

        for (const part of this.store.partsOf(type)) {
          const choices = this.textChoices(part);
          if (choices == undefined) {
            return undefined;
          }

          for (const choice of choices) {
            texts.push(choice);
          }
        }

        return texts;
      }
      default:
        return undefined;
    }
  }

  private textChange(
    ref: TypeRef,
    row: TextChangeName,
    context: Read<TypeContext>,
  ): Type {
    const tree = this.program.tree;

    const refArgs = tree.typeRefsOf(ref.argsList);
    if (refArgs.length != 1) {
      this.report(context.module, ref.loc, Code.TypeArgumentsCount, {
        word: row.name,
        other: `${row.name}<"text">`,
      });

      return this.store.plain(TypeKind.Error);
    }

    const argsItem = tree.typeRefsOf(ref.argsList);
    const args = this.resolveAll(argsItem, context);
    const error = this.store.plain(TypeKind.Error);
    const text = args[0] ?? error;
    if (!this.isTextType(text)) {
      this.report(context.module, ref.loc, Code.TextChangeNotString, {
        word: row.name,
        other: this.typeText(text),
      });

      return error;
    }

    return this.changedText(text, row);
  }

  private readonly isHoleType(type: Type): boolean {
    switch (type.kind) {
      case TypeKind.String:
      case TypeKind.Int:
      case TypeKind.Double:
      case TypeKind.Boolean:
      case TypeKind.Undefined:
      case TypeKind.Literal:
      case TypeKind.Template:
      case TypeKind.TypeParameter:
      case TypeKind.Operation:
      case TypeKind.Error:
        return true;
      case TypeKind.Union:
        return this.store.partsOf(type).every((part) => this.isHoleType(part));
      default:
        return false;
    }
  }

  private readonly isTextType(type: Type): boolean {
    switch (type.kind) {
      case TypeKind.String:
      case TypeKind.Template:
      case TypeKind.TypeParameter:
      case TypeKind.Operation:
      case TypeKind.Error:
        return true;
      case TypeKind.Literal:
        return type.literal == LiteralKind.String;
      case TypeKind.Union:
        return this.store.partsOf(type).every((part) => this.isTextType(part));
      default:
        return false;
    }
  }

  private changedText(type: Type, row: TextChangeName): Type {
    switch (type.kind) {
      case TypeKind.Literal: {
        const changed = this.changedWord(type.text, row.change);

        return this.store.literal(LiteralKind.String, changed);
      }
      case TypeKind.Union: {
        const parts: Type[] = [];

        for (const part of this.store.partsOf(type)) {
          const changed = this.changedText(part, row);

          parts.push(changed);
        }

        return this.store.unionOf(parts);
      }
      case TypeKind.TypeParameter:
      case TypeKind.Operation:
        return this.operation(OperationKind.TextChange, [type], row.name);
      default:
        return type;
    }
  }

  private readonly changedWord(text: string, change: TextChange): string {
    const head = text.slice(0, 1);
    const tail = text.slice(1);

    switch (change) {
      case TextChange.Capitalize:
        return `${head.toUpperCase()}${tail}`;
      case TextChange.Uncapitalize:
        return `${head.toLowerCase()}${tail}`;
      case TextChange.Uppercase:
        return text.toUpperCase();
      default:
        return text.toLowerCase();
    }
  }
}
