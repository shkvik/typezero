import { ModuleScopes } from "../../../program/scopes/types/scopes.types.tz";
import { TypeStore } from "../../../program/type/type-store/type-store.tz";
import { Type } from "../../../program/type/types/type.types.tz";
import { IntegerMath } from "../../code/integer-math/integer-math.tz";
import { LibraryTables } from "../../library/library-tables/library-tables.tz";
import { LiteralRanges } from "../literal-ranges/literal-ranges.tz";
import { InferHole } from "../type-relation/types/type-relation.types.tz";
import {
  AliasDoor,
  AliasHome,
  AliasOrigin,
  EnumStep,
  ModuleRecord,
} from "../type-resolver/types/type-resolver.types.tz";

export class TypeSystem {
  public readonly store: TypeStore;
  public readonly program: Program;
  private readonly errors: ErrorLog;
  private readonly ranges: LiteralRanges;
  private readonly integers: IntegerMath;
  private readonly tables: LibraryTables;
  private assumed: Set<string>;
  private inferHoles: Map<int, InferHole>;
  private captured: Map<int, Type>;
  private scopes: Map<int, ModuleScopes>;
  private records: Map<int, ModuleRecord>;
  private doors: Map<string, AliasDoor>;
  private working: Map<string, int>;
  private nesting: Map<string, int>;
  private tailUses: Set<int>;
  private readonly methodIndex: Map<string, int[]>;
  private endless: Set<string>;
  private bounded: Set<int>;
  private holes: Set<int>;
  private globals: Map<string, int>;
  private namespaces: Map<string, int>;
  private prefixes: Map<int, string>;
  private libraryShapes: Set<int>;
  private aliasOrigins: Map<int, AliasOrigin>;
  private readonly aliasHomes: Map<int, AliasHome>;
  private extending: TypeAliasDecl[];
  private enumCache: Map<string, readonly EnumStep[]>;
  private enumWholes: Map<string, Type>;
  private enumOpen: Set<string>;

  public constructor(
    store: Own<TypeStore>,
    program: Own<Program>,
    resolved: Own<ModuleScopes[]>,
  ) {
    this.store = store;
    this.program = program;
    this.errors = new ErrorLog();
    this.ranges = new LiteralRanges();
    this.integers = new IntegerMath();
    this.tables = new LibraryTables();
    this.assumed = new Set<string>();
    this.inferHoles = new Map<int, InferHole>();
    this.captured = new Map<int, Type>();
    this.scopes = new Map<int, ModuleScopes>();
    this.records = new Map<int, ModuleRecord>();
    this.doors = new Map<string, AliasDoor>();
    this.working = new Map<string, int>();
    this.nesting = new Map<string, int>();
    this.tailUses = new Set<int>();
    this.methodIndex = new Map<string, int[]>();
    this.endless = new Set<string>();
    this.bounded = new Set<int>();
    this.holes = new Set<int>();
    this.globals = new Map<string, int>();
    this.namespaces = new Map<string, int>();
    this.prefixes = new Map<int, string>();
    this.libraryShapes = new Set<int>();
    this.aliasOrigins = new Map<int, AliasOrigin>();
    this.aliasHomes = new Map<int, AliasHome>();
    this.extending = [];
    this.enumCache = new Map<string, readonly EnumStep[]>();
    this.enumWholes = new Map<string, Type>();
    this.enumOpen = new Set<string>();

    for (const scopes of resolved.drain()) {
      this.scopes.set(scopes.module, scopes);
    }

    this.indexGlobals();
    this.indexMethods();
  }
}

