import { TypeStore } from "../../../program/type/type-store/type-store.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import { TypeRelation } from "../type-relation/type-relation.tz";
import { kIteratorKey } from "./const/type-questions.const.tz";
import { kDateName, kRegExpName } from "./const/type-questions.const.tz";

export class TypeQuestions {
  private readonly store: TypeStore;
  private readonly relation: TypeRelation;

  public constructor(store: TypeStore, relation: TypeRelation) {
    this.store = store;
    this.relation = relation;
  }

  public isOptional(type: Type): boolean {
    if (type.kind != TypeKind.Union) {
      return false;
    }

    return type.parts.some((part) => part.kind == TypeKind.Undefined);
  }

  public optional(type: Type): Type {
    const nothing = this.store.plain(TypeKind.Undefined);

    return this.store.unionOf([type, nothing]);
  }

  public definedType(type: Type): Type {
    const parts = this.definedParts(type);
    if (parts.length == 0) {
      return type;
    }

    return this.store.unionOf(parts);
  }

  public definedParts(type: Type): Type[] {
    if (type.kind != TypeKind.Union) {
      return [type];
    }

    const parts: Type[] = [];

    for (const part of type.parts) {
      if (part.kind != TypeKind.Undefined) {
        parts.push(part);
      }
    }

    return parts;
  }

  public wantedPart(wanted: Type | undefined): Type | undefined {
    if (wanted == undefined) {
      return undefined;
    }

    return this.definedType(wanted);
  }

  public apparent(type: Type): Type {
    const base = this.relation.baseOf(type);
    if (base != undefined) {
      return base;
    }
    if (type.kind != TypeKind.Union) {
      return type;
    }

    const first = type.parts[0];
    const firstBase = this.optionalBase(first);
    const isOneBase = type.parts.every(
      (part) => this.optionalBase(part) == firstBase,
    );
    if (firstBase == undefined || !isOneBase) {
      return type;
    }

    return firstBase;
  }

  public unionMembers(base: Type): Type[] {
    if (base.kind != TypeKind.Union) {
      return [base];
    }

    return base.parts;
  }

  public isNumberLike(type: Type): boolean {
    switch (type.kind) {
      case TypeKind.Int:
      case TypeKind.Double:
      case TypeKind.Decimal:
        return true;
      default:
        return false;
    }
  }

  public isObjectKind(type: Type): boolean {
    switch (type.kind) {
      case TypeKind.Object:
      case TypeKind.Instance:
      case TypeKind.Tuple:
      case TypeKind.AnyObject:
        return true;
      default:
        return false;
    }
  }

  public isObjectReference(type: Type): boolean {
    switch (type.kind) {
      case TypeKind.Iterator:
      case TypeKind.Dict:
      case TypeKind.Promise:
      case TypeKind.Class:
        return true;
      case TypeKind.Union:
        return this.isObjectUnion(type.parts);
      default:
        return this.isObjectKind(type);
    }
  }

  public isOpenParameter(type: Type): boolean {
    const isParameter = type.kind == TypeKind.TypeParameter;

    return isParameter && this.store.constraintOf(type) == undefined;
  }

  public baseClassOf(type: Type): Type | undefined {
    const parents = this.store.parentsOf(type);

    return parents.find((parent) => parent.kind == TypeKind.Instance);
  }

  public isNumber(type: Type): boolean {
    switch (type.kind) {
      case TypeKind.Int:
      case TypeKind.Double:
      case TypeKind.Decimal:
        return true;
      default:
        return false;
    }
  }

  public isSameClass(first: Type, second: Type): boolean {
    if (first.kind != TypeKind.Instance || second.kind != TypeKind.Instance) {
      return false;
    }

    return first.module == second.module && first.loc == second.loc;
  }

  public ancestorsOf(type: Type): Type[] {
    const chain: Type[] = [type];

    for (let index = 0; index < chain.length; index++) {
      const current = chain[index];
      if (current == undefined) {
        break;
      }

      for (const parent of this.store.parentsOf(current)) {
        if (!chain.includes(parent)) {
          chain.push(parent);
        }
      }
    }

    return chain;
  }

  public onlyPart(wanted: Type): Type {
    const parts = this.definedParts(wanted);
    const only = parts[0];
    if (parts.length != 1 || only == undefined) {
      return wanted;
    }

    return only;
  }

  public hasMethodFields(type: Type): boolean {
    const base = this.definedType(type);
    if (base.kind != TypeKind.Object) {
      return false;
    }

    return base.fields.some((field) => field.method ?? false);
  }

  public isIterableTarget(wanted: Type): boolean {
    const defined = this.definedType(wanted);
    const parts = this.unionMembers(defined);

    return parts.some(
      (part) =>
        part.kind == TypeKind.Object &&
        part.fields.some((field) => field.name == kIteratorKey),
    );
  }

  public isDate(type: Type): boolean {
    return type.kind == TypeKind.Instance && type.name == kDateName;
  }

  public isRegExp(type: Type): boolean {
    return type.kind == TypeKind.Instance && type.name == kRegExpName;
  }

  public isNumeric(type: Type): boolean {
    return type.kind == TypeKind.Int || type.kind == TypeKind.Double;
  }

  public holdsKind(type: Type, kind: TypeKind): boolean {
    const held = this.definedType(type);
    if (held.kind == TypeKind.Array) {
      return this.holdsKind(held.item, kind);
    }

    return held.kind == kind;
  }

  public holdsObjects(type: Type): boolean {
    const held = this.definedType(type);
    if (held.kind == TypeKind.Array) {
      return this.holdsObjects(held.item);
    }

    return this.isObjectKind(held) || held.kind == TypeKind.Dict;
  }

  private optionalBase(type: Type | undefined): Type | undefined {
    if (type == undefined) {
      return undefined;
    }

    return this.relation.baseOf(type);
  }

  private isObjectUnion(parts: Type[]): boolean {
    const first = parts[0];
    if (first == undefined || this.relation.isTagged(parts)) {
      return false;
    }

    const isHolder =
      first.kind == TypeKind.Dict || first.kind == TypeKind.Promise;

    return isHolder || this.isObjectKind(first);
  }
}
