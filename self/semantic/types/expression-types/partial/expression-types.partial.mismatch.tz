import { Code } from "../../../../diagnostic/code.tz";
import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import { Expr } from "../../../../program/ast/types/ast.types.expressions.tz";
import { Type } from "../../../../program/type/types/type.types.tz";
import { MismatchTexts } from "../../mismatch-rules/types/mismatch-rules.types.tz";

partial class ExpressionTypes {
  private mismatch(
    expr: Expr,
    given: Type,
    wanted: Type,
    module: int,
    place: string,
  ): void {
    const texts: MismatchTexts = {
      name: this.types.operandName(expr),
      unknownCheck: this.unknownCheckText(expr, given, wanted),
      isFresh: this.types.isFresh(expr),
      isPlaced: this.isPlacedLiteral(expr, wanted, module),
      place: place + this.fetchMismatchHint(given, wanted),
      both: this.bothText(expr, wanted, module),
    };
    const isBytes =
      this.types.isBytesType(given) &&
      this.types.isBytesType(wanted);
    if (isBytes) {
      const first = this.types.typeText(given);
      const second = this.types.typeText(wanted);

      this.errors.write(module, expr.loc, Code.NotAssignable, {
        first,
        second,
        place,
      });

      return;
    }

    const answer = this.types.answerOf(given, wanted, texts);
    if (answer != undefined) {
      this.errors.write(module, expr.loc, answer.code, answer.details);
    }
  }

  private isRangeProven(
    expr: Expr,
    given: Type,
    wanted: Type,
    module: int,
  ): boolean {
    if (!this.ranges.isWordInt(given)) {
      return false;
    }

    const goal = this.types.definedType(wanted);
    const intervals = this.ranges.wholeIntervals(this.types.store, goal);
    if (intervals.length == 0) {
      return false;
    }

    const value = this.intConstant(expr, given, module);
    if (value == undefined) {
      return intervals.some((interval) =>
        this.canProveBetween(
          expr,
          { what: "", low: interval.low.value, high: interval.high.value },
          module,
        ),
      );
    }

    return intervals.some(
      (interval) => interval.low.value <= value && value <= interval.high.value,
    );
  }
}
