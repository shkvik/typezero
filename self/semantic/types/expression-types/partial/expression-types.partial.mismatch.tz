import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import { Expr } from "../../../../program/ast/types/ast.types.expressions.tz";
import { Type } from "../../../../program/type/types/type.types.tz";
import { MismatchTexts } from "../../mismatch-rules/types/mismatch-rules.types.tz";

partial class ExpressionTypes {
  private mismatch(
    expr: Expr,
    given: Type,
    wanted: Type,
    module: int,
    place: string,
  ): void {
    const texts: MismatchTexts = {
      name: this.sources.operandName(expr),
      unknownCheck: this.unknownCheckText(expr, given, wanted),
      isFresh: this.shapes.isFresh(expr),
      isPlaced: this.isPlacedLiteral(expr, wanted, module),
      place,
    };
    const answer = this.mismatches.answerOf(given, wanted, texts);
    if (answer != undefined) {
      this.report(module, expr.loc, answer.code, answer.details);
    }
  }

  private isRangeProven(
    expr: Expr,
    given: Type,
    wanted: Type,
    module: int,
  ): boolean {
    if (!this.ranges.isWordInt(given)) {
      return false;
    }

    const goal = this.types.definedType(wanted);
    const intervals = this.ranges.wholeIntervals(goal);
    if (intervals.length == 0) {
      return false;
    }

    const value = this.intConstant(expr, given, module);
    if (value == undefined) {
      return true;
    }

    return intervals.some(
      (interval) => interval.low.value <= value && value <= interval.high.value,
    );
  }
}
