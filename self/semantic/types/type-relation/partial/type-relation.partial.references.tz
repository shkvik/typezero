import { TypeRelation } from "../type-relation.tz";
import {
  LiteralKind,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import { ValueSlot } from "../types/type-relation.types.tz";

partial class TypeRelation {
  public isTagged(parts: Type[]): boolean {
    const first = parts[0];
    if (first == undefined) {
      return false;
    }

    return parts.some((part) => !this.sameSlot(first, part));
  }

  private sameSlot(first: Type, second: Type): boolean {
    const slot = this.slotOf(first);
    if (slot != this.slotOf(second)) {
      return false;
    }
    if (slot != ValueSlot.Int) {
      return true;
    }

    return this.numberOf(first) == this.numberOf(second);
  }

  private numberOf(type: Type): Type {
    return this.baseOf(type) ?? type;
  }

  private slotOf(type: Type): ValueSlot {
    switch (type.kind) {
      case TypeKind.String:
      case TypeKind.Template:
        return ValueSlot.String;
      case TypeKind.Int:
        return ValueSlot.Int;
      case TypeKind.Json:
        return ValueSlot.Json;
      case TypeKind.Double:
        return ValueSlot.Double;
      case TypeKind.Boolean:
        return ValueSlot.Boolean;
      case TypeKind.Decimal:
        return ValueSlot.Decimal;
      case TypeKind.Object:
      case TypeKind.AnyObject:
      case TypeKind.Instance:
      case TypeKind.Tuple:
      case TypeKind.Dict:
      case TypeKind.Promise:
        return ValueSlot.Object;
      case TypeKind.Array:
        return ValueSlot.Array;
      case TypeKind.Function:
        return ValueSlot.Function;
      case TypeKind.Iterator:
        return ValueSlot.Iterator;
      case TypeKind.TypeParameter:
        return ValueSlot.Parameter;
      case TypeKind.Literal:
        return this.literalSlot(type.literal);
      default:
        return ValueSlot.Other;
    }
  }

  private literalSlot(literal: LiteralKind): ValueSlot {
    switch (literal) {
      case LiteralKind.String:
        return ValueSlot.Atom;
      case LiteralKind.Boolean:
        return ValueSlot.Boolean;
      case LiteralKind.Double:
        return ValueSlot.Double;
      default:
        return ValueSlot.Int;
    }
  }

  private isSameUnion(own: Type, wide: Type): boolean {
    if (own.kind != TypeKind.Union || wide.kind != TypeKind.Union) {
      return false;
    }

    const theirs = wide.parts;
    if (own.parts.length != theirs.length) {
      return false;
    }

    return own.parts.every((part) => theirs.includes(part));
  }

  private sameReference(from: Type, to: Type): boolean {
    let own = from;
    let wide = to;

    while (own != wide && this.goesDeeper(own, wide)) {
      if (own.kind == TypeKind.Array && wide.kind == TypeKind.Array) {
        own = own.item;
        wide = wide.item;

        continue;
      }

      const inner = this.defined(wide);
      if (!this.isReference(inner)) {
        return false;
      }

      own = this.defined(own);
      wide = inner;
    }

    if (own == wide || this.isSameUnion(own, wide)) {
      return true;
    }
    if (own.kind != TypeKind.Union) {
      return this.objectsShare(own, wide);
    }
    if (this.isOptional(own) || this.isTagged(own.parts)) {
      return false;
    }

    return own.parts.every(
      (part) => part == wide || this.objectsShare(part, wide),
    );
  }

  private goesDeeper(own: Type, wide: Type): boolean {
    const arrays = own.kind == TypeKind.Array && wide.kind == TypeKind.Array;

    return arrays || this.isOptional(wide);
  }

  private isOptional(type: Type): boolean {
    if (type.kind != TypeKind.Union) {
      return false;
    }

    return type.parts.some((part) => part.kind == TypeKind.Undefined);
  }

  private isReference(type: Type): boolean {
    return type.kind == TypeKind.Array || this.isObjectLike(type);
  }

  private isObjectLike(type: Type): boolean {
    switch (type.kind) {
      case TypeKind.Object:
      case TypeKind.Instance:
      case TypeKind.Tuple:
      case TypeKind.AnyObject:
        return true;
      default:
        return false;
    }
  }

  private objectsShare(from: Type, to: Type): boolean {
    if (!this.isObjectLike(from) || !this.isObjectLike(to)) {
      return false;
    }

    return this.descends(from, to) || this.plainConverts(from, to);
  }
}
