import "./partial/type-relation.partial.patterns.tz";
import "./partial/type-relation.partial.conversion.tz";
import "./partial/type-relation.partial.references.tz";
import { TypeStore } from "../../../program/type/type-store/type-store.tz";
import {
  FunctionShape,
  InstanceType,
  ParamWriter,
  LiteralKind,
  LiteralType,
  ObjectField,
  TupleType,
  Type,
  TypeKind,
} from "../../../program/type/types/type.types.tz";
import { InferHole } from "./types/type-relation.types.tz";

export class TypeRelation {
  private readonly store: TypeStore;
  private readonly assumed: Set<string>;
  private holes: Map<int, InferHole>;
  private captured: Map<int, Type>;

  public constructor(store: TypeStore) {
    this.store = store;
    this.assumed = new Set<string>();
    this.holes = new Map<int, InferHole>();
    this.captured = new Map<int, Type>();
  }

  public writersOf(module: int, loc: int): ParamWriter[] | undefined {
    return this.store.writersOf(module, loc);
  }

  public extends(source: Type, target: Type): boolean {
    if (source == target) {
      return true;
    }

    const hole = this.holes.get(target.id);
    if (hole != undefined) {
      return this.capture(hole, source);
    }
    if (target.kind == TypeKind.Unknown || source.kind == TypeKind.Never) {
      return true;
    }
    if (source.kind == TypeKind.Union) {
      return source.parts.every((part) => this.extends(part, target));
    }
    if (target.kind == TypeKind.Union) {
      return target.parts.some((part) => this.extends(source, part));
    }

    const pair = `${source.id} ${target.id}`;
    if (this.assumed.has(pair)) {
      return true;
    }

    this.assumed.add(pair);

    const fits = this.fits(source, target);

    this.assumed.delete(pair);

    return fits;
  }

  public matches(
    source: Type,
    target: Type,
    holes: Map<int, InferHole>,
  ): Map<int, Type> | undefined {
    this.holes = holes;
    this.captured = new Map<int, Type>();

    const fits = this.extends(source, target);
    const captured = this.captured;

    this.holes = new Map<int, InferHole>();
    if (!fits) {
      return undefined;
    }

    return captured;
  }

  private fits(source: Type, target: Type): boolean {
    if (source.kind == TypeKind.Literal) {
      return this.literalFits(source, target);
    }

    switch (target.kind) {
      case TypeKind.Array:
        return this.arrayFits(source, target.item);
      case TypeKind.Tuple:
        return source.kind == TypeKind.Tuple && this.tupleFits(source, target);
      case TypeKind.Object:
        return this.objectFits(source, target.fields);
      case TypeKind.Function:
        return (
          source.kind == TypeKind.Function &&
          this.functionFits(source.shape, target.shape)
        );
      case TypeKind.Promise:
        return (
          source.kind == TypeKind.Promise &&
          this.extends(source.value, target.value)
        );
      case TypeKind.Result:
        return (
          source.kind == TypeKind.Result &&
          this.extends(source.value, target.value) &&
          this.extends(source.error, target.error)
        );
      case TypeKind.Dict:
        return (
          source.kind == TypeKind.Dict &&
          source.dict == target.dict &&
          this.extends(source.key, target.key) &&
          this.extends(source.value, target.value)
        );
      case TypeKind.Iterator:
        return (
          source.kind == TypeKind.Iterator &&
          source.shape.async == target.shape.async &&
          this.extends(source.shape.yielded, target.shape.yielded)
        );
      case TypeKind.Instance:
        return this.instanceFits(source, target);
      default:
        return false;
    }
  }

  private instanceFits(source: Type, target: InstanceType): boolean {
    if (source.kind != TypeKind.Instance) {
      return false;
    }

    const isSame = source.module == target.module && source.loc == target.loc;
    if (isSame) {
      return this.argumentsFit(source, target);
    }

    const parents = this.store.parentsOf(source);

    return parents.some((parent) => this.instanceFits(parent, target));
  }

  private argumentsFit(source: InstanceType, target: InstanceType): boolean {
    const writers = this.store.writersOf(target.module, target.loc) ?? [];

    for (let index = 0; index < target.args.length; index++) {
      const own = source.args[index];
      const wide = target.args[index];
      if (own == undefined || wide == undefined) {
        return false;
      }

      const writer = writers[index]?.writer ?? "";
      const isOpen =
        this.holes.has(wide.id) ||
        wide.kind == TypeKind.TypeParameter ||
        own.kind == TypeKind.TypeParameter;
      if (writer != "" && own != wide && !isOpen) {
        return false;
      }
      if (!this.extends(own, wide)) {
        return false;
      }
    }

    return true;
  }

  private literalFits(source: LiteralType, target: Type): boolean {
    switch (source.literal) {
      case LiteralKind.String:
        return this.textFits(source.text, target);
      case LiteralKind.Int:
        return target.kind == TypeKind.Int || target.kind == TypeKind.Double;
      case LiteralKind.Double:
        return target.kind == TypeKind.Double;
      default:
        return target.kind == TypeKind.Boolean;
    }
  }

  private arrayFits(source: Type, item: Type): boolean {
    if (source.kind == TypeKind.Array) {
      return this.extends(source.item, item);
    }
    if (source.kind == TypeKind.Tuple) {
      return source.items.every((each) => this.extends(each, item));
    }

    return false;
  }

  private tupleFits(source: TupleType, target: TupleType): boolean {
    const before = target.rest;
    if (before < 0) {
      return this.allFit(source.items, target.items);
    }

    const after = target.items.length - before - 1;
    const middle = source.items.length - after;
    if (middle < before) {
      return false;
    }

    const heads = source.items.slice(0, before);
    const tails = source.items.slice(middle);
    const wantedHeads = target.items.slice(0, before);
    const wantedTails = target.items.slice(before + 1);
    if (!this.allFit(heads, wantedHeads) || !this.allFit(tails, wantedTails)) {
      return false;
    }

    const between = source.items.slice(before, middle);
    const rest = this.store.plainTuple(between);
    const wanted = target.items[before];

    return wanted != undefined && this.extends(rest, wanted);
  }

  private allFit(sources: Type[], targets: Type[]): boolean {
    if (sources.length != targets.length) {
      return false;
    }

    for (let index = 0; index < sources.length; index++) {
      const source = sources[index];
      const target = targets[index];
      if (source == undefined || target == undefined) {
        return false;
      }
      if (!this.extends(source, target)) {
        return false;
      }
    }

    return true;
  }

  private objectFits(source: Type, wanted: ObjectField[]): boolean {
    if (source.kind != TypeKind.Object) {
      return false;
    }

    for (const field of wanted) {
      const own = source.fields.find((each) => each.name == field.name);
      if (own == undefined) {
        if (!field.optional) {
          return false;
        }

        continue;
      }
      if (!this.extends(own.type, field.type)) {
        return false;
      }
    }

    return true;
  }

  private functionFits(source: FunctionShape, target: FunctionShape): boolean {
    if (!this.extends(source.result, target.result)) {
      return false;
    }

    const open = this.openRest(target);
    const count = this.fixedCount(source, open);

    for (let index = 0; index < count; index++) {
      const given = this.parameterAt(target, index);
      const taken = source.params[index]?.type;
      if (given == undefined || taken == undefined) {
        continue;
      }
      if (!this.extends(given, taken)) {
        return false;
      }
    }

    if (open < 0) {
      return true;
    }

    return this.captureArguments(source, target, open);
  }

  private fixedCount(source: FunctionShape, open: int): int {
    if (open < 0) {
      return source.params.length;
    }

    return open;
  }

  private parameterAt(shape: FunctionShape, index: int): Type | undefined {
    const last = shape.params.length - 1;
    if (!shape.rest || index < last) {
      return shape.params[index]?.type;
    }

    const rest = shape.params[last]?.type;
    if (rest != undefined && rest.kind == TypeKind.Array) {
      return rest.item;
    }

    return rest;
  }
}
