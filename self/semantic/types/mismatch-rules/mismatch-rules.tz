import { Code } from "../../../diagnostic/code.tz";
import { Details, Finding } from "../../../diagnostic/types/message.types.tz";
import { TypeText } from "../../../program/type/type-text/type-text.tz";
import {
  ObjectField,
  Type,
  TypeKind,
} from "../../../program/type/types/type.types.tz";
import { ModuleQuestions } from "../../declaration/module-questions/module-questions.tz";
import { LiteralRanges } from "../literal-ranges/literal-ranges.tz";
import { Interval } from "../literal-ranges/types/literal-ranges.types.tz";
import { TypeQuestions } from "../type-questions/type-questions.tz";
import { kWideBits } from "../type-relation/const/type-relation.const.tz";
import { TypeRelation } from "../type-relation/type-relation.tz";
import {
  kConversionPrefix,
  kUnsaidExample,
  kUnsaidMiddle,
  kUnsaidSample,
  kWiderEnd,
  kWiderMiddle,
  kWiderStart,
} from "./const/mismatch-rules.const.tz";
import { MismatchTexts } from "./types/mismatch-rules.types.tz";

export class MismatchRules {
  private readonly text: TypeText;
  private readonly relation: TypeRelation;
  private readonly types: TypeQuestions;
  private readonly modules: ModuleQuestions;
  private readonly ranges: LiteralRanges;

  public constructor(
    text: TypeText,
    relation: Own<TypeRelation>,
    types: Own<TypeQuestions>,
    modules: Own<ModuleQuestions>,
    ranges: LiteralRanges,
  ) {
    this.text = text;
    this.relation = relation;
    this.types = types;
    this.modules = modules;
    this.ranges = ranges;
  }

  public readonly answerOf(
    given: Type,
    wanted: Type,
    texts: MismatchTexts,
  ): Finding | undefined {
    const source = this.innerObject(given, wanted);
    const target = this.innerObject(wanted, given);
    const first = this.text.of(given);
    const second = this.text.of(wanted);
    const widened = this.widenedDetail(source, target);
    if (widened != "") {
      const place = texts.place + widened;

      return { code: Code.NotAssignable, details: { first, second, place } };
    }

    const unsaid = this.unsaidDetail(source, target);
    if (unsaid != "") {
      const place = texts.place + unsaid;

      return { code: Code.NotAssignable, details: { first, second, place } };
    }

    const hasOther = texts.both != "";
    const detail = this.objectDetail(source, target, hasOther);
    const isWider = this.isOptionalWidening(source, target);
    if (detail != "" && !texts.isFresh && !texts.isPlaced && !isWider) {
      const place = texts.place + detail + texts.both;
      const details: Details = { first, second, place };

      return { code: Code.NotAssignable, details };
    }

    const only = this.types.onlyPart(wanted);
    const goal = this.types.definedType(wanted);
    const intervals = this.ranges.rangeIntervals(given, goal);
    const holds = this.ranges.rangeText(intervals);
    const code = this.mismatchCode(given, wanted, source, target, holds);
    if (!this.isReported(texts.isFresh, given, wanted, code)) {
      return undefined;
    }

    const word = this.mismatchWord(texts, code, given, wanted, intervals);
    const other = this.mismatchOther(code, holds, only, target);
    const place = texts.place;
    const details: Details = { first, second, word, other, place };

    return { code, details };
  }

  public readonly isUndecided(wanted: Type): boolean {
    const goal = this.types.definedType(wanted);

    return goal.kind == TypeKind.Operation;
  }

  public readonly isIteratorFromClass(given: Type, wanted: Type): boolean {
    const target = this.types.definedType(wanted);

    return given.kind == TypeKind.Instance && target.kind == TypeKind.Iterator;
  }

  public readonly numberCode(given: Type, target: Type): Code {
    if (given.kind == TypeKind.Int && this.types.isNumber(target)) {
      return Code.ConvertExplicitly;
    }
    if (given.kind == TypeKind.Double && target.kind == TypeKind.Int) {
      return Code.RoundThenConvert;
    }
    if (given.kind == TypeKind.Double && target.kind == TypeKind.Decimal) {
      return Code.DoubleIntoDecimal;
    }
    if (given.kind == TypeKind.Decimal && this.types.isNumber(target)) {
      return Code.DecimalIntoNumber;
    }

    return Code.NotAssignable;
  }

  public readonly sharedTag(target: Type): string | undefined {
    if (target.kind != TypeKind.Union) {
      return undefined;
    }

    const parts = target.parts;
    const front = parts[0];
    if (front == undefined || front.kind != TypeKind.Object) {
      return undefined;
    }

    const tag = front.fields.find((field) =>
      parts.every((part) => this.hasLiteralField(part, field.name)),
    );

    return tag?.name;
  }

  public readonly conversionName(target: Type): string {
    const name = this.text.of(target);
    const head = name.slice(0, 1).toUpperCase();
    const tail = name.slice(1);

    return `${kConversionPrefix}${head}${tail}`;
  }

  private readonly mismatchCode(
    given: Type,
    wanted: Type,
    source: Type,
    target: Type,
    holds: string,
  ): Code {
    if (holds != "" && given.kind == TypeKind.Literal) {
      return Code.LiteralOutsideRange;
    }
    if (holds != "") {
      return Code.ValueOutsideRange;
    }

    const plain = this.types.definedType(given);
    const aim = this.types.definedType(wanted);
    if (aim.kind == TypeKind.Never) {
      return Code.NeverNotAssignable;
    }
    if (plain.kind == TypeKind.Unknown) {
      return Code.UnknownNotAssignable;
    }
    if (plain.kind == TypeKind.AnyObject) {
      return Code.ObjectNotAssignable;
    }

    const isShape =
      source.kind == TypeKind.Object || source.kind == TypeKind.Tuple;
    const isPlainObject = isShape && !this.types.hasMethodFields(source);
    if (isPlainObject && target.kind == TypeKind.Instance) {
      return Code.LiteralNotInstance;
    }
    if (isPlainObject && this.hasObjectMember(target)) {
      return this.unionCode(target);
    }
    if (source.kind == TypeKind.Tuple && target.kind == TypeKind.Array) {
      return Code.TupleNotArray;
    }
    if (this.isOtherClass(source, target)) {
      return this.classCode(target);
    }
    if (this.isMaybeFitting(given, wanted)) {
      return Code.OptionalNotAssignable;
    }
    if (this.isFunctionPair(given, wanted)) {
      return Code.FunctionsMismatch;
    }

    const value = this.types.definedType(given);
    const goal = this.types.definedType(wanted);

    if (value.kind == TypeKind.Json) {
      return Code.JsonUnchecked;
    }
    if (goal.kind == TypeKind.AnyObject) {
      return Code.NotAnObject;
    }
    if (goal.kind == TypeKind.Json) {
      return this.jsonCode(source, value);
    }

    const only = this.types.onlyPart(wanted);

    return this.numberCode(given, only);
  }

  private readonly hasObjectMember(target: Type): boolean {
    if (target.kind != TypeKind.Union) {
      return false;
    }

    return target.parts.some((part) => this.types.isObjectKind(part));
  }

  private readonly unionCode(target: Type): Code {
    if (this.sharedTag(target) == undefined) {
      return Code.ObjectIntoUnion;
    }

    return Code.ObjectIntoTaggedUnion;
  }

  private readonly hasLiteralField(part: Type, name: string): boolean {
    if (part.kind != TypeKind.Object) {
      return false;
    }

    const field = part.fields.find((one) => one.name == name);

    return (
      field != undefined &&
      !field.optional &&
      field.type.kind == TypeKind.Literal
    );
  }

  private readonly jsonCode(source: Type, value: Type): Code {
    if (this.types.isObjectKind(source) || value.kind == TypeKind.Array) {
      return Code.ObjectIntoJson;
    }
    if (value.kind == TypeKind.Dict) {
      return this.dictionaryCode(value.value);
    }
    if (value.kind == TypeKind.Decimal) {
      return Code.DecimalIntoJson;
    }

    return Code.NotAssignable;
  }

  private readonly dictionaryCode(value: Type): Code {
    const parts = this.types.definedParts(value);
    const isWide = parts.some(
      (part) => part.kind == TypeKind.Int && part.bits >= kWideBits,
    );
    if (isWide) {
      return Code.WideIntegersIntoJson;
    }

    return Code.NotAssignable;
  }

  private readonly isReported(
    isFresh: boolean,
    given: Type,
    wanted: Type,
    code: Code,
  ): boolean {
    if (this.types.isIterableTarget(wanted)) {
      return false;
    }
    if (isFresh || this.isCertain(code)) {
      return true;
    }

    const source = this.innerObject(given, wanted);
    const target = this.innerObject(wanted, given);
    const from = this.types.onlyPart(given);
    const to = this.types.onlyPart(wanted);
    const isPlain =
      this.isPlainValue(from) ||
      this.isPlainValue(to) ||
      this.isPlainValue(source) ||
      this.isPlainValue(target);

    return isPlain || !this.isWidening(source, target);
  }

  private readonly isWidening(source: Type, target: Type): boolean {
    if (!this.types.isObjectKind(target)) {
      return false;
    }

    return this.types.isObjectKind(source) || source.kind == TypeKind.Union;
  }

  private readonly isOtherClass(source: Type, target: Type): boolean {
    if (
      source.kind != TypeKind.Instance ||
      this.modules.isLibraryModule(source.module)
    ) {
      return false;
    }

    const chain = this.types.ancestorsOf(source);

    if (target.kind == TypeKind.Object) {
      return chain.every((one) => one.kind == TypeKind.Instance);
    }
    if (target.kind != TypeKind.Instance) {
      return false;
    }

    return !chain.some((one) => this.types.isSameClass(one, target));
  }

  private readonly isFunctionPair(given: Type, wanted: Type): boolean {
    const goal = this.types.definedType(wanted);

    return given.kind == TypeKind.Function && goal.kind == TypeKind.Function;
  }

  private readonly isMaybeFitting(given: Type, wanted: Type): boolean {
    if (!this.types.isOptional(given) || this.types.isOptional(wanted)) {
      return false;
    }

    const defined = this.types.definedType(given);

    return this.relation.converts(defined, wanted);
  }

  private readonly classCode(target: Type): Code {
    if (target.kind == TypeKind.Instance) {
      return Code.ClassNotExtended;
    }

    return Code.ClassNotImplemented;
  }

  private readonly isCertain(code: Code): boolean {
    switch (code) {
      case Code.LiteralNotInstance:
      case Code.TupleNotArray:
      case Code.JsonUnchecked:
      case Code.NotAnObject:
      case Code.ObjectIntoJson:
      case Code.ClassNotExtended:
      case Code.ClassNotImplemented:
      case Code.OptionalNotAssignable:
      case Code.FunctionsMismatch:
      case Code.UnknownNotAssignable:
      case Code.ObjectNotAssignable:
      case Code.NeverNotAssignable:
        return true;
      default:
        return false;
    }
  }

  private readonly innerObject(type: Type, other: Type): Type {
    const inner = this.types.definedType(type);
    const otherInner = this.types.definedType(other);
    if (inner.kind == TypeKind.Array && otherInner.kind == TypeKind.Array) {
      return this.innerObject(inner.item, otherInner.item);
    }

    return inner;
  }

  private readonly mismatchWord(
    texts: MismatchTexts,
    code: Code,
    given: Type,
    wanted: Type,
    intervals: Read<Interval[]>,
  ): string {
    const source = this.innerObject(given, wanted);
    const target = this.innerObject(wanted, given);

    switch (code) {
      case Code.UnknownNotAssignable:
      case Code.ObjectNotAssignable:
        return texts.unknownCheck;
      case Code.LiteralNotInstance:
      case Code.ClassNotImplemented:
        return this.text.of(target);
      case Code.ClassNotExtended:
        return this.text.of(source);
      case Code.ObjectIntoTaggedUnion:
        return this.sharedTag(target) ?? "";
      case Code.ValueOutsideRange:
        return this.ranges.rangeCheck(
          texts.name,
          intervals,
          this.text.of(this.types.definedType(target)),
        );
      default:
        return texts.name;
    }
  }

  private readonly mismatchOther(
    code: Code,
    holds: string,
    only: Type,
    target: Type,
  ): string {
    if (code == Code.LiteralOutsideRange || code == Code.ValueOutsideRange) {
      return holds;
    }
    if (code == Code.ClassNotExtended) {
      return this.text.of(target);
    }

    return this.conversionName(only);
  }

  private readonly isPlainValue(type: Type): boolean {
    switch (type.kind) {
      case TypeKind.Int:
      case TypeKind.Double:
      case TypeKind.Decimal:
      case TypeKind.String:
      case TypeKind.Boolean:
      case TypeKind.Literal:
      case TypeKind.Template:
      case TypeKind.Undefined:
      case TypeKind.Json:
        return true;
      case TypeKind.Union:
        return type.parts.every((part) => this.isPlainValue(part));
      default:
        return false;
    }
  }

  private readonly isOptionalWidening(source: Type, target: Type): boolean {
    if (source.kind != TypeKind.Object || target.kind != TypeKind.Object) {
      return false;
    }

    const own = source.fields.slice();
    const wide = target.fields.slice();
    const isEachKnown = own.every((field) => this.isWiderField(field, wide));
    const isRestOptional = wide.every(
      (field) => field.optional || this.hasField(own, field.name),
    );

    return isEachKnown && isRestOptional;
  }

  private readonly isWiderField(field: ObjectField, wide: Read<ObjectField[]>): boolean {
    const other = wide.find((one) => one.name == field.name);

    return other != undefined && this.relation.converts(field.type, other.type);
  }

  private readonly hasField(fields: Read<ObjectField[]>, name: string): boolean {
    return fields.some((one) => one.name == name);
  }

  private readonly objectDetail(source: Type, target: Type, hasOther: boolean): string {
    if (source.kind != TypeKind.Object || target.kind != TypeKind.Object) {
      return "";
    }

    for (const field of source.fields) {
      const other = target.fields.find((one) => one.name == field.name);
      if (other == undefined) {
        return `; an object must have exactly the fields of its type, and this one has the extra field '${field.name}'`;
      }
    }

    for (const field of target.fields) {
      const other = source.fields.find((one) => one.name == field.name);
      if (other == undefined) {
        return `; it has no field '${field.name}'`;
      }
    }

    for (const field of source.fields) {
      const other = target.fields.find((one) => one.name == field.name);
      if (other != undefined) {
        const detail = this.fieldDetail(field, other, target, hasOther);
        if (detail != "") {
          return detail;
        }
      }
    }

    return "";
  }

  private readonly fieldDetail(
    field: ObjectField,
    other: ObjectField,
    target: Type,
    hasOther: boolean,
  ): string {
    const own = this.objectFieldType(field);
    const theirs = this.objectFieldType(other);
    const name = field.name;
    const to = this.text.of(target);

    if (own != theirs) {
      const here = this.text.of(own);
      const there = this.text.of(theirs);
      const text = `; field '${name}' is '${here}' here and '${there}' in '${to}'`;

      if (hasOther) {
        return text;
      }

      return text + this.objectTypeHint(own, theirs, to);
    }
    if (field.readonly && !other.readonly) {
      return `; field '${name}' is read-only here, and '${to}' would let it be changed`;
    }

    return "";
  }

  private readonly objectFieldType(field: ObjectField): Type {
    if (field.optional) {
      return this.types.optional(field.type);
    }

    return field.type;
  }

  private readonly objectTypeHint(own: Type, theirs: Type, to: string): string {
    const isNumberPair =
      this.isNumberKind(this.types.definedType(own)) &&
      this.isNumberKind(this.types.definedType(theirs));
    if (!isNumberPair) {
      return "";
    }

    return `: give the object its type where it is created, e.g. 'const p: ${to} = { ... }'`;
  }

  private readonly isNumberKind(type: Type): boolean {
    return type.kind == TypeKind.Int || type.kind == TypeKind.Double;
  }

  private readonly unsaidDetail(source: Type, target: Type): string {
    if (source.kind != TypeKind.Instance || target.kind != TypeKind.Instance) {
      return "";
    }
    if (source.module != target.module || source.loc != target.loc) {
      return "";
    }

    for (let index = 0; index < target.args.length; index++) {
      const own = source.args[index];
      const wide = target.args[index];
      if (own != undefined && wide != undefined) {
        if (this.relation.isUnsaid(own, wide)) {
          return this.unsaidText(own, wide);
        }
      }
    }

    return "";
  }

  private readonly unsaidText(own: Type, wide: Type): string {
    const ownName = this.text.of(own);
    const wideName = this.text.of(wide);
    const isNamed = !ownName.startsWith("{") && own.kind != TypeKind.Union;
    const example = this.unsaidExample(isNamed, ownName);

    const head = `; '${ownName}'${kUnsaidMiddle}'${wideName}'`;
    const tail = `${kUnsaidExample}${example} extends ${wideName} { ... }'`;

    return head + tail;
  }

  private readonly unsaidExample(isNamed: boolean, name: string): string {
    if (isNamed) {
      return name;
    }

    return kUnsaidSample;
  }

  private readonly widenedDetail(source: Type, target: Type): string {
    if (source.kind != TypeKind.Instance || target.kind != TypeKind.Instance) {
      return "";
    }
    if (source.module != target.module || source.loc != target.loc) {
      return "";
    }

    const writers = this.relation.writersOf(target.module, target.loc) ?? [];

    for (let index = 0; index < writers.length; index++) {
      const writer = writers[index];
      const own = source.args[index];
      const wide = target.args[index];
      if (writer == undefined || own == undefined || wide == undefined) {
        continue;
      }

      const isWider =
        writer.writer != "" && own != wide && this.relation.extends(own, wide);
      if (isWider) {
        return `${kWiderStart}${target.name}${kWiderMiddle}${writer.name}${kWiderEnd}${writer.writer}`;
      }
    }

    return "";
  }
}
