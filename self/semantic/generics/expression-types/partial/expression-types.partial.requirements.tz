import {
  kInstanceChainLimit,
  kNewPrefix,
} from "../../generic-rules/const/generic-rules.const.tz";
import {
  BinaryExpr,
  BinaryOp,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../program/ast/types/ast.types.functions.tz";
import {
  CapturePlace,
  NameUse,
} from "../../../../program/scopes/types/scopes.types.tz";
import {
  CallTarget,
  GenericDraft,
  OperandPair,
  PendingCall,
  Requirement,
  RequirementKind,
} from "../../../code/expression-types/types/expression-types.types.tz";
import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import { messageText } from "../../../../diagnostic/message.tz";
import { Finding } from "../../../../diagnostic/types/message.types.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";
import { kToStringName } from "../../../code/expression-types/const/expression-types.const.tz";

partial class ExpressionTypes {
  private requireOf(type: Type, kind: RequirementKind, word: string): void {
    if (type.kind != TypeKind.TypeParameter) {
      return;
    }

    this.addRequirement(type.id, { kind, word, other: 0 });
  }

  private requireConstruct(type: Type, count: int): void {
    if (type.kind != TypeKind.TypeParameter) {
      return;
    }

    const kind = RequirementKind.Construct;

    this.addRequirement(type.id, { kind, word: "", other: count });
  }

  private captureRequirements(fn: FunctionDecl, module: int): void {
    const tree = this.types.program.tree;

    const uses = this.records.get(module)?.uses;
    if (tree.typeParamsOf(fn.typeParamsList).length == 0 || uses == undefined) {
      return;
    }

    const params = this.types.parameterTypes(
      module,
      tree.typeParamsOf(fn.typeParamsList),
    );
    const first = params[0];
    if (first == undefined) {
      return;
    }

    const captured: NameUse[] = [];

    for (const use of uses.values()) {
      const capture = use.capture ?? CapturePlace.None;
      const isInside = this.types.isInsideFunction(fn, use.loc);
      if (capture != CapturePlace.None && isInside) {
        captured.push(use);
      }
    }

    for (const use of captured) {
      const capture = use.capture ?? CapturePlace.None;

      this.requireOf(first, this.captureKind(capture), use.name);
    }
  }

  private readonly captureKind(capture: CapturePlace): RequirementKind {
    if (capture == CapturePlace.StaticInit) {
      return RequirementKind.StaticCapture;
    }

    return RequirementKind.LaterCapture;
  }

  private addRequirement(id: int, requirement: Requirement): void {
    if (!this.requirements.has(id)) {
      this.requirements.set(id, []);
    }

    this.requirements.get(id)?.push(requirement);
  }

  private requireFollowing(draft: Read<GenericDraft>, module: int): void {
    const target = draft.target;
    const bound = this.types.boundById(draft);

    if (target.isLenient) {
      return;
    }

    for (const [id, type] of bound) {
      if (type.kind == TypeKind.TypeParameter) {
        const kind = RequirementKind.Follows;

        this.addRequirement(type.id, { kind, word: "", other: id });
      }
    }

    const owner = this.ownerKey(module);
    const call: PendingCall = {
      name: target.name,
      params: target.params.slice(),
      bound,
      loc: target.loc,
      module,
      owner,
    };

    const index = this.pendingCalls.length;

    this.pendingCalls.push(call);
    this.waitingCalls.push(index);

    if (owner == "") {
      return;
    }
    if (!this.ownedCalls.has(owner)) {
      this.ownedCalls.set(owner, []);
    }

    this.ownedCalls.get(owner)?.push(index);
  }

  private ownerKey(module: int): string {
    const tree = this.types.program.tree;

    for (let index = this.openFunctions.length - 1; index >= 0; index--) {
      const fn = this.openFunctions[index];
      if (fn != undefined && tree.typeParamsOf(fn.typeParamsList).length > 0) {
        const params = this.types.parameterTypes(
          module,
          tree.typeParamsOf(fn.typeParamsList),
        );

        return this.paramsKey(params);
      }
    }

    return "";
  }

  private readonly paramsKey(params: Read<Type[]>): string {
    return params.map((param) => `${param.id}`).join(" ");
  }

  private pendingCallsCheck(module: int): void {
    const mine = this.waitingCalls.filter((at) => this.isCallOf(at, module));
    const rest = this.waitingCalls.filter((at) => !this.isCallOf(at, module));

    this.waitingCalls = rest;

    for (const index of mine) {
      this.pendingCallCheck(index);
    }
  }

  private readonly isCallOf(index: int, module: int): boolean {
    const call = this.pendingCalls[index];

    return call != undefined && call.module == module;
  }

  private pendingCallCheck(index: int): void {
    const call = this.pendingCalls[index];
    if (call == undefined) {
      return;
    }

    const params = call.params;

    for (const param of params) {
      if (param.kind != TypeKind.TypeParameter) {
        continue;
      }

      const type = this.pendingCalls[index]?.bound.get(param.id);
      if (type == undefined || type.kind == TypeKind.TypeParameter) {
        continue;
      }

      const seen = new Set<int>();
      const found = this.parameterFinding(param.id, type, seen);
      if (found != undefined) {
        return this.refusedCallReport(index, found);
      }
    }

    this.chainCheck(index);
  }

  private refusedCallReport(index: int, found: Finding): void {
    const call = this.pendingCalls[index];
    if (call == undefined) {
      return;
    }

    const other = messageText(found.code, found.details);
    const isClass = call.name.startsWith(kNewPrefix);
    const code = this.types.refusedCode(isClass);
    const word = this.types.refusedName(call.name, isClass);

    this.errors.write(call.module, call.loc, code, {
      word,
      first: this.callBindings(call),
      other,
    });
  }

  private chainCheck(index: int): void {
    const call = this.pendingCalls[index];
    if (call == undefined || call.owner != "") {
      return;
    }

    const key = this.paramsKey(call.params);
    const bound = new Map<int, Type>(call.bound);
    const seen = new Set<string>();
    const found = this.chainFinding(key, index, bound, [], seen);
    if (found == undefined) {
      return;
    }

    this.chainReport(index, found);
  }

  private chainReport(index: int, found: Finding): void {
    const call = this.pendingCalls[index];
    if (call == undefined) {
      return;
    }

    this.errors.write(call.module, call.loc, Code.GenericCallRefused, {
      word: call.name,
      first: this.callBindings(call),
      other: messageText(found.code, found.details),
    });
  }

  private chainFinding(
    key: string,
    index: int,
    bound: Read<Map<int, Type>>,
    path: string[],
    seen: Set<string>,
  ): Finding | undefined {
    const call = this.pendingCalls[index];
    if (call == undefined) {
      return undefined;
    }

    const count = path.filter((one) => one == key).length;
    const types = this.boundTypes(call.params, bound);
    if (count >= kInstanceChainLimit) {
      const first = types.map((type) => this.types.typeText(type)).join(", ");

      return {
        code: Code.GenericChainEndless,
        details: { word: call.name, first },
      };
    }

    const visit = `${key} ${this.paramsKey(types)}`;
    if (seen.has(visit)) {
      return undefined;
    }

    seen.add(visit);
    path.push(key);

    const found = this.ownedFinding(key, bound, path, seen);

    path.pop();

    return found;
  }

  private readonly boundTypes(
    params: Read<Type[]>,
    bound: Read<Map<int, Type>>,
  ): Type[] {
    const types: Type[] = [];

    for (const param of params) {
      const type = bound.get(param.id);
      if (type != undefined) {
        types.push(type);
      }
    }

    return types;
  }

  private ownedFinding(
    key: string,
    bound: Read<Map<int, Type>>,
    path: string[],
    seen: Set<string>,
  ): Finding | undefined {
    const count = this.ownedCalls.get(key)?.length ?? 0;

    for (let at = 0; at < count; at++) {
      const index = this.ownedCallAt(key, at);
      const inner = this.pendingCalls[index];
      if (inner == undefined) {
        continue;
      }

      const innerKey = this.paramsKey(inner.params);
      if (innerKey == key) {
        continue;
      }

      const next = new Map<int, Type>();

      for (const [id, type] of inner.bound) {
        next.set(id, this.types.substitute(type, bound));
      }

      const found = this.chainFinding(innerKey, index, next, path, seen);
      if (found != undefined) {
        return found;
      }
    }

    return undefined;
  }

  private readonly callBindings(call: Read<PendingCall>): string {
    const names: string[] = [];
    const types: Type[] = [];

    for (const param of call.params) {
      if (param.kind != TypeKind.TypeParameter) {
        continue;
      }

      const type = call.bound.get(param.id);
      if (type != undefined) {
        names.push(param.name);
        types.push(type);
      }
    }

    return this.bindingsText(names, types);
  }

  private readonly bindingsText(
    names: Read<string[]>,
    types: Read<Type[]>,
  ): string {
    const parts: string[] = [];

    for (let index = 0; index < names.length; index++) {
      const name = names[index];
      const type = types[index];
      if (name != undefined && type != undefined) {
        parts.push(`${name} = ${this.types.typeText(type)}`);
      }
    }

    return parts.join(", ");
  }

  private parameterFinding(
    id: int,
    type: Type,
    seen: Set<int>,
  ): Finding | undefined {
    if (seen.has(id)) {
      return undefined;
    }

    seen.add(id);

    const count = this.requirements.get(id)?.length ?? 0;

    for (let at = 0; at < count; at++) {
      const one = this.requirementAt(id, at);
      if (one == undefined) {
        continue;
      }

      const found = this.requirementFinding(one, type, seen);
      if (found != undefined) {
        return found;
      }
    }

    return undefined;
  }

  private readonly ownedCallAt(key: string, at: int): int {
    const indices = this.ownedCalls.get(key) ?? [];

    return indices[at] ?? -1;
  }

  private readonly requirementAt(id: int, at: int): Requirement | undefined {
    const list = this.requirements.get(id) ?? [];

    return list[at];
  }

  private requirementFinding(
    one: Requirement,
    type: Type,
    seen: Set<int>,
  ): Finding | undefined {
    switch (one.kind) {
      case RequirementKind.Text:
        return this.textFinding(type);
      case RequirementKind.Compare:
        return this.comparisonFinding(type, one.word);
      case RequirementKind.Sort:
        return this.sortFinding(type);
      case RequirementKind.Unused:
        return this.unusedFinding(type);
      case RequirementKind.Construct:
        return this.constructFinding(type, one.other);
      case RequirementKind.LaterCapture:
        return {
          code: Code.ClassExprLaterCapture,
          details: { word: one.word },
        };
      case RequirementKind.StaticCapture:
        return {
          code: Code.ClassExprStaticCapture,
          details: { word: one.word },
        };
      default:
        return this.parameterFinding(one.other, type, seen);
    }
  }

  private textFinding(type: Type): Finding | undefined {
    const base = this.types.definedType(type);
    const isText = type.kind == TypeKind.String || type.kind == TypeKind.Error;
    if (base.kind == TypeKind.Instance) {
      return this.instanceTextFinding(base);
    }
    if (isText || base.kind == TypeKind.TypeParameter) {
      return undefined;
    }

    return this.types.textAnswer(type, base);
  }

  private readonly instanceTextFinding(base: Type): Finding | undefined {
    const tree = this.types.program.tree;

    if (
      base.kind != TypeKind.Instance ||
      this.types.isLibraryModule(base.module)
    ) {
      return undefined;
    }

    const decl = this.classOf(base);
    if (
      decl == undefined ||
      tree.typeParamsOf(decl.typeParamsList).length > 0
    ) {
      return undefined;
    }

    const hasOwn = this.types.hasClassMethod(decl, kToStringName);
    if (hasOwn) {
      return undefined;
    }

    return { code: Code.ObjectToText, details: kNoDetails };
  }

  private requireJoin(expr: BinaryExpr, pair: OperandPair): void {
    const left = this.types.definedType(pair.left);
    const right = this.types.definedType(pair.right);
    const hasText =
      left.kind == TypeKind.String || right.kind == TypeKind.String;
    if (expr.op != BinaryOp.Add || !hasText) {
      return;
    }

    this.requireOf(left, RequirementKind.Text, "");
    this.requireOf(right, RequirementKind.Text, "");
  }

  private comparisonFinding(type: Type, other: string): Finding | undefined {
    const base = this.types.definedType(type);
    if (base.kind == TypeKind.Result) {
      return { code: Code.ResultsCompared, details: { other } };
    }
    if (!this.types.isOrdering(other)) {
      return undefined;
    }

    const isOrdered =
      base.kind == TypeKind.String ||
      this.types.isNumber(base) ||
      this.types.isDate(base);
    if (isOrdered) {
      return undefined;
    }

    const first = this.types.typeText(type);

    return {
      code: Code.OperandTypes,
      details: { first, second: first, other },
    };
  }

  private sortFinding(type: Type): Finding | undefined {
    const code = this.sortProblem(type);
    if (code == undefined) {
      return undefined;
    }

    const word = this.types.typeText(this.types.definedType(type));
    const other = this.types.sortExample(type);

    return { code, details: { word, other } };
  }

  private constructFinding(type: Type, count: int): Finding | undefined {
    const tree = this.types.program.tree;

    const base = this.types.definedType(type);
    if (base.kind != TypeKind.Instance) {
      return undefined;
    }

    const decl = this.classOf(base);
    if (decl == undefined) {
      return undefined;
    }

    const maker = this.makerOf(base, decl);
    if (maker == undefined) {
      return undefined;
    }

    const constructors = tree.functionsOf(maker.owner.constructorsList);
    const chosen = constructors[0];
    if (chosen == undefined && count > 0) {
      return { code: Code.NoConstructor, details: { word: decl.name ?? "" } };
    }
    if (chosen == undefined || constructors.length > 1) {
      return undefined;
    }

    const target = this.constructorTarget(maker, chosen, decl.loc);
    if (target == undefined) {
      return undefined;
    }

    return this.countFinding(target, count);
  }

  private readonly countFinding(
    target: Read<CallTarget>,
    count: int,
  ): Finding | undefined {
    const params = target.params;
    const least = this.types.leastArguments(target);
    const isTooMany = !target.rest && count > params.length;
    if (count >= least && !isTooMany) {
      return undefined;
    }

    const word = this.types.argumentCountText(
      least,
      params.length,
      target.rest,
    );

    return { code: Code.ArgumentCount, details: { word, other: `${count}` } };
  }

  private unusedFinding(type: Type): Finding | undefined {
    const base = this.types.definedType(type);
    if (base.kind != TypeKind.Result) {
      return undefined;
    }

    return { code: Code.ResultUnused, details: kNoDetails };
  }
}
