import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { ClassDecl } from "../../../../program/ast/types/ast.types.classes.tz";
import {
  CallExpr,
  MemberExpr,
  NewExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../program/ast/types/ast.types.functions.tz";
import {
  FunctionShape,
  FunctionType,
  InstanceType,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import { messageText } from "../../../../diagnostic/message.tz";
import { Finding } from "../../../../diagnostic/types/message.types.tz";
import { kNewWord } from "../../../code/expression-types/const/expression-types.const.tz";
import {
  CallTarget,
  ClassMemberEntry,
  GenericTarget,
} from "../../../code/expression-types/types/expression-types.types.tz";
import { kConstructorName } from "../../../code/object-rules/const/object-rules.const.tz";

partial class ExpressionTypes {
  private genericMethodCall(
    expr: CallExpr,
    member: MemberExpr,
    entry: Read<ClassMemberEntry>,
    method: FunctionDecl,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const most = method.typeParams.length;
    if (member.typeArgs.length > most) {
      this.report(module, member.loc, Code.TypeArgumentsTooMany, {
        word: member.name,
        other: this.genericCalls.typeArgumentText(most),
        first: `${member.typeArgs.length}`,
      });
      this.looseArguments(expr.args, module);

      return this.store.plain(TypeKind.Error);
    }

    const shape = this.genericMethodShape(entry, method);
    if (shape == undefined) {
      return this.store.plain(TypeKind.Error);
    }

    const part = this.partOf(entry.owner, method);
    const home = this.partModule(part, entry.instance.module);
    const generic: GenericTarget = {
      name: member.name,
      params: this.resolver.parameterTypes(home, method.typeParams),
      decls: method.typeParams,
      home,
      shape,
      loc: member.loc,
      typeArgs: member.typeArgs,
      isLenient: false,
    };

    return this.genericCall(generic, expr.args, wanted, module);
  }

  private genericMethodShape(
    entry: Read<ClassMemberEntry>,
    method: FunctionDecl,
  ): FunctionShape | undefined {
    const owner = entry.owner;
    const instance = entry.instance;

    if (owner.typeParams.length == 0) {
      const type = this.methodFunction(owner, method, instance.module);
      if (type.kind != TypeKind.Function) {
        return undefined;
      }

      return type.shape;
    }

    const written = method.returnType;
    const sites = this.classes.parameterSites(method);
    if (written == undefined || sites == undefined) {
      return undefined;
    }

    const part = this.partOf(owner, method);
    const home = this.partModule(part, instance.module);
    const context = this.resolver.classContext(instance, part.typeParams, home);
    const type = this.resolver.signature(sites, written, context);
    if (type.kind != TypeKind.Function) {
      return undefined;
    }

    return type.shape;
  }

  private genericNew(
    expr: NewExpr,
    decl: ClassDecl,
    home: int,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const params = this.resolver.parameterTypes(home, decl.typeParams);
    const instance = this.resolver.classInstance(home, decl, params);
    const word = decl.name ?? "";

    if (instance.kind != TypeKind.Instance) {
      return this.store.plain(TypeKind.Error);
    }
    if (decl.isAbstract) {
      this.report(module, expr.loc, Code.AbstractNew, { word });

      return this.store.plain(TypeKind.Error);
    }

    const maker = this.makerOf(instance, decl);
    if (maker == undefined) {
      return this.store.plain(TypeKind.Error);
    }

    const constructors = maker.owner.constructors;
    const chosen = constructors[0];

    if (constructors.length > 1) {
      return this.store.plain(TypeKind.Error);
    }
    if (chosen == undefined && expr.args.length > 0) {
      this.report(module, expr.loc, Code.NoConstructor, { word });
      this.looseArguments(expr.args, module);

      return this.store.plain(TypeKind.Error);
    }

    const loc = expr.loc;

    if (chosen != undefined) {
      const access = this.classes.accessOf(chosen);

      this.reportAccess(maker.owner, access, kConstructorName, loc, module);
    }

    const made = this.makerTarget(maker, chosen, loc);
    if (made == undefined) {
      return this.store.plain(TypeKind.Error);
    }

    const shape: FunctionShape = {
      params: made.params,
      rest: made.rest,
      result: instance,
    };
    const generic: GenericTarget = {
      name: `${kNewWord}${word}`,
      params,
      decls: decl.typeParams,
      home,
      shape,
      loc,
      typeArgs: [],
      isLenient: false,
    };

    return this.genericCall(generic, expr.args, wanted, module);
  }

  private copyVariantsCheck(
    expr: NewExpr,
    made: Type,
    decl: ClassDecl,
    module: int,
  ): void {
    if (made.kind != TypeKind.Instance || decl.typeParams.length == 0) {
      return;
    }

    const isOpen = made.args.some((arg) => arg.kind == TypeKind.TypeParameter);
    if (isOpen) {
      return;
    }

    const found = this.copyVariantsFinding(made, decl);
    if (found == undefined) {
      return;
    }

    const names = decl.typeParams.map((param) => param.name);

    this.report(module, expr.loc, Code.GenericClassRefused, {
      word: decl.name ?? "",
      first: this.bindingsText(names, made.args),
      other: messageText(found.code, found.details),
    });
  }

  private copyVariantsFinding(
    made: InstanceType,
    decl: ClassDecl,
  ): Finding | undefined {
    for (const variants of this.variantGroups(decl)) {
      const found = this.copyPairsFinding(made, decl, variants);
      if (found != undefined) {
        return found;
      }
    }

    return undefined;
  }

  private copyPairsFinding(
    made: InstanceType,
    decl: ClassDecl,
    variants: Read<FunctionDecl[]>,
  ): Finding | undefined {
    if (variants.length < 2) {
      return undefined;
    }

    const home = made.module;
    const own = variants.map((fn) => this.ownMethodType(decl, fn, home));
    const copied = variants.map((fn) => this.copiedMethodType(made, decl, fn));
    const what = this.variantsWhat(variants);

    for (let later = 1; later < variants.length; later++) {
      for (let earlier = 0; earlier < later; earlier++) {
        const first = variants[earlier];
        const second = variants[later];
        const ownFirst = own[earlier];
        const ownSecond = own[later];
        const one = copied[earlier];
        const other = copied[later];
        if (first == undefined || second == undefined) {
          continue;
        }
        if (ownFirst == undefined || ownSecond == undefined) {
          continue;
        }
        if (one == undefined || other == undefined) {
          continue;
        }

        const declared = this.overloads.variantPairCheck(
          first,
          second,
          ownFirst,
          ownSecond,
          what,
        );
        if (declared.value) {
          continue;
        }

        const checked = this.overloads.variantPairCheck(
          first,
          second,
          one,
          other,
          what,
        );
        const error = checked.error;
        if (error != undefined) {
          return { code: error.code, details: error.details };
        }
      }
    }

    return undefined;
  }

  private readonly copiedMethodType(
    made: InstanceType,
    decl: ClassDecl,
    method: FunctionDecl,
  ): FunctionType | undefined {
    const sites = this.classes.parameterSites(method);
    if (sites == undefined) {
      return undefined;
    }

    const part = this.partOf(decl, method);
    const home = this.partModule(part, made.module);
    const context = this.resolver.classContext(made, part.typeParams, home);

    this.errors.beginTrial();

    const type = this.resolver.signature(sites, method.returnType, context);

    this.errors.endTrial();

    if (type.kind != TypeKind.Function) {
      return undefined;
    }

    return type;
  }

  private readonly makerTarget(
    maker: Read<ClassMemberEntry>,
    chosen: FunctionDecl | undefined,
    loc: int,
  ): CallTarget | undefined {
    if (chosen == undefined) {
      return { params: [], rest: false, loc, isLenient: false };
    }

    return this.constructorTarget(maker, chosen, loc);
  }
}
