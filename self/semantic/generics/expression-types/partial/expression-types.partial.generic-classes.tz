import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { ClassDecl } from "../../../../program/ast/types/ast.types.classes.tz";
import {
  CallExpr,
  MemberExpr,
  NewExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../program/ast/types/ast.types.functions.tz";
import {
  FunctionShape,
  FunctionType,
  InstanceType,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import { messageText } from "../../../../diagnostic/message.tz";
import { Finding } from "../../../../diagnostic/types/message.types.tz";
import { kNewWord } from "../../../code/expression-types/const/expression-types.const.tz";
import {
  CallTarget,
  ClassMemberEntry,
  GenericTarget,
} from "../../../code/expression-types/types/expression-types.types.tz";
import { kConstructorName } from "../../../code/object-rules/const/object-rules.const.tz";

partial class ExpressionTypes {
  private genericMethodCall(
    expr: CallExpr,
    member: MemberExpr,
    entry: Read<ClassMemberEntry>,
    method: FunctionDecl,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const most = tree.typeParamsOf(method.typeParamsList).length;
    const typeArgsItem = tree.typeRefsOf(member.typeArgsList);
    if (typeArgsItem.length > most) {
      this.errors.write(module, member.loc, Code.TypeArgumentsTooMany, {
        word: member.name,
        other: this.types.typeArgumentText(most),
        first: `${tree.typeRefsOf(member.typeArgsList).length}`,
      });
      const args = tree.argumentsOf(expr.argsList);

      this.looseArguments(args, module);

      return this.types.store.plain(TypeKind.Error);
    }

    const shape = this.genericMethodShape(entry, method);
    if (shape == undefined) {
      return this.types.store.plain(TypeKind.Error);
    }

    const part = this.partOf(entry.owner, method);
    const home = this.partModule(part, entry.instance.module);
    const generic: GenericTarget = {
      name: member.name,
      params: this.types.parameterTypes(
        home,
        tree.typeParamsOf(method.typeParamsList),
      ),
      decls: tree.typeParamsOf(method.typeParamsList),
      home,
      shape,
      loc: member.loc,
      typeArgs: tree.typeRefsOf(member.typeArgsList),
      isLenient: false,
    };

    return this.genericCall(
      generic,
      expr.argsList,
      tree.argumentsOf(expr.argsList),
      wanted,
      module,
    );
  }

  private genericMethodShape(
    entry: Read<ClassMemberEntry>,
    method: FunctionDecl,
  ): FunctionShape | undefined {
    const tree = this.types.program.tree;

    const owner = entry.owner;
    const instance = entry.instance;

    const typeParams = tree.typeParamsOf(owner.typeParamsList);
    if (typeParams.length == 0) {
      const type = this.methodFunction(owner, method, instance.module);
      if (type.kind != TypeKind.Function) {
        return undefined;
      }

      return this.types.store.functionShapeOf(type);
    }

    const written = tree.typeRefAt(method.returnTypeId);
    const sites = this.types.parameterSites(method);
    if (written == undefined || sites == undefined) {
      return undefined;
    }

    const part = this.partOf(owner, method);
    const home = this.partModule(part, instance.module);
    const context = this.types.classContext(
      instance,
      tree.typeParamsOf(part.typeParamsList),
      home,
    );
    const type = this.types.signature(sites, written, context);
    if (type.kind != TypeKind.Function) {
      return undefined;
    }

    return this.types.store.functionShapeOf(type);
  }

  private genericNew(
    expr: NewExpr,
    decl: ClassDecl,
    home: int,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const tree = this.types.program.tree;

    const params = this.types.parameterTypes(
      home,
      tree.typeParamsOf(decl.typeParamsList),
    );
    const instance = this.types.classInstance(home, decl, params);
    const word = decl.name ?? "";

    if (instance.kind != TypeKind.Instance) {
      return this.types.store.plain(TypeKind.Error);
    }
    if (decl.isAbstract) {
      this.errors.write(module, expr.loc, Code.AbstractNew, { word });

      return this.types.store.plain(TypeKind.Error);
    }

    const maker = this.makerOf(instance, decl);
    if (maker == undefined) {
      return this.types.store.plain(TypeKind.Error);
    }

    const constructors = tree.functionsOf(maker.owner.constructorsList);
    const chosen = constructors[0];

    if (constructors.length > 1) {
      return this.types.store.plain(TypeKind.Error);
    }
    if (chosen == undefined && tree.argumentsOf(expr.argsList).length > 0) {
      this.errors.write(module, expr.loc, Code.NoConstructor, { word });
      const args = tree.argumentsOf(expr.argsList);

      this.looseArguments(args, module);

      return this.types.store.plain(TypeKind.Error);
    }

    const loc = expr.loc;

    if (chosen != undefined) {
      const access = this.types.classAccessOf(chosen);

      this.reportAccess(maker.owner, access, kConstructorName, loc, module);
    }

    const made = this.makerTarget(maker, chosen, loc);
    if (made == undefined) {
      return this.types.store.plain(TypeKind.Error);
    }

    const shape: FunctionShape = {
      params: made.params,
      rest: made.rest,
      result: instance,
    };
    const generic: GenericTarget = {
      name: `${kNewWord}${word}`,
      params,
      decls: tree.typeParamsOf(decl.typeParamsList),
      home,
      shape,
      loc,
      typeArgs: [],
      isLenient: false,
    };

    return this.genericCall(
      generic,
      expr.argsList,
      tree.argumentsOf(expr.argsList),
      wanted,
      module,
    );
  }

  private copyVariantsCheck(
    expr: NewExpr,
    made: Type,
    decl: ClassDecl,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    if (
      made.kind != TypeKind.Instance ||
      tree.typeParamsOf(decl.typeParamsList).length == 0
    ) {
      return;
    }

    const isOpen = this.types.store
      .argsOf(made)
      .some((arg) => arg.kind == TypeKind.TypeParameter);
    if (isOpen) {
      return;
    }

    const found = this.copyVariantsFinding(made, decl);
    if (found == undefined) {
      return;
    }

    const names = tree
      .typeParamsOf(decl.typeParamsList)
      .map((param) => param.name);

    this.errors.write(module, expr.loc, Code.GenericClassRefused, {
      word: decl.name ?? "",
      first: this.bindingsText(names, this.types.store.argsOf(made)),
      other: messageText(found.code, found.details),
    });
  }

  private copyVariantsFinding(
    made: InstanceType,
    decl: ClassDecl,
  ): Finding | undefined {
    const groups = this.variantGroups(decl);

    for (const variants of groups) {
      const found = this.copyPairsFinding(made, decl, variants);
      if (found != undefined) {
        return found;
      }
    }

    return undefined;
  }

  private copyPairsFinding(
    made: InstanceType,
    decl: ClassDecl,
    variants: Read<FunctionDecl[]>,
  ): Finding | undefined {
    if (variants.length < 2) {
      return undefined;
    }

    const home = made.module;
    const own = variants.map((fn) => this.ownMethodType(decl, fn, home));
    const copied = variants.map((fn) => this.copiedMethodType(made, decl, fn));
    const what = this.variantsWhat(variants);

    for (let later = 1; later < variants.length; later++) {
      for (let earlier = 0; earlier < later; earlier++) {
        const first = variants[earlier];
        const second = variants[later];
        const ownFirst = own[earlier];
        const ownSecond = own[later];
        const one = copied[earlier];
        const other = copied[later];
        if (first == undefined || second == undefined) {
          continue;
        }
        if (ownFirst == undefined || ownSecond == undefined) {
          continue;
        }
        if (one == undefined || other == undefined) {
          continue;
        }

        const declared = this.types.variantPairCheck(
          first,
          second,
          ownFirst,
          ownSecond,
          what,
        );
        if (declared.value) {
          continue;
        }

        const checked = this.types.variantPairCheck(
          first,
          second,
          one,
          other,
          what,
        );
        const error = checked.error;
        if (error != undefined) {
          return { code: error.code, details: error.details };
        }
      }
    }

    return undefined;
  }

  private copiedMethodType(
    made: InstanceType,
    decl: ClassDecl,
    method: FunctionDecl,
  ): FunctionType | undefined {
    const tree = this.types.program.tree;

    const sites = this.types.parameterSites(method);
    if (sites == undefined) {
      return undefined;
    }

    const part = this.partOf(decl, method);
    const home = this.partModule(part, made.module);
    const context = this.types.classContext(
      made,
      tree.typeParamsOf(part.typeParamsList),
      home,
    );

    this.errors.beginTrial();

    const type = this.types.signature(
      sites,
      tree.typeRefAt(method.returnTypeId),
      context,
    );

    this.errors.endTrial();

    if (type.kind != TypeKind.Function) {
      return undefined;
    }

    return type;
  }

  private makerTarget(
    maker: Read<ClassMemberEntry>,
    chosen: FunctionDecl | undefined,
    loc: int,
  ): CallTarget | undefined {
    if (chosen == undefined) {
      return { params: [], rest: false, loc, isLenient: false };
    }

    return this.constructorTarget(maker, chosen, loc);
  }
}
