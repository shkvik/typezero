import {
  ExpressionTypes,
} from "../../../code/expression-types/expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import {
  CallArgument,
  Expr,
  ExprKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import {
  FunctionParameter,
  FunctionShape,
  LiteralKind,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import {
  TypeContext,
  TypePlace,
} from "../../../types/type-resolver/types/type-resolver.types.tz";
import {
  kNoPlace,
} from "../../../code/expression-types/const/expression-types.const.tz";
import {
  ArgumentForm,
  CallTarget,
  CandidateStrength,
  GenericDraft,
  GenericTarget,
} from "../../../code/expression-types/types/expression-types.types.tz";
import { AstList } from "../../../../program/ast/types/ast.types.span.tz";

partial class ExpressionTypes {
  private genericCall(
    target: Own<GenericTarget>,
    list: AstList | undefined,
    args: Own<CallArgument[]>,
    wanted: Type | undefined,
    module: int,
  ): Type {
    const hasLists = target.params.some((param) =>
      this.types.isListParameter(param),
    );
    const shape = target.shape;
    const isOpaque = this.hasOperationParameter(shape);
    if (hasLists) {
      this.splitListsCheck(target, module);
    }
    if (hasLists || isOpaque || this.types.isListRest(shape)) {
      return this.types.store.plain(TypeKind.Error);
    }
    if (!this.isGenericArity(target, args, module)) {
      return this.types.store.plain(TypeKind.Error);
    }

    const isExplicit = target.typeArgs.length > 0;
    const draft = this.types.genericDraft(target, list, args, wanted);

    if (isExplicit) {
      return this.explicitCall(draft, module);
    }

    this.inferArguments(draft, module);
    this.settleStrong(draft, module);
    this.inferFromWanted(draft);
    this.settleAll(draft, module);
    this.contextualArguments(draft, module);

    return this.boundCall(draft, module);
  }

  private splitListsCheck(target: Read<GenericTarget>, module: int): void {
    if (target.typeArgs.length > 0 || target.isLenient) {
      return;
    }

    const lists = this.types.splitLists(target.shape);

    for (const param of target.params) {
      if (lists.some((one) => one.id == param.id)) {
        const error = this.types.uninferredError(target, param);

        this.errors.writeFound(module, error);
      }
    }
  }

  private isGenericArity(
    target: Read<GenericTarget>,
    args: Read<CallArgument[]>,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const call = this.types.genericCallTarget(target);
    const fixed = this.types.callFixedCount(call);
    const limit = this.types.spreadLimit(call, fixed, args.length);
    const spread = args.find((arg, index) => arg.spread && index < limit);
    if (spread != undefined && !this.isArraySpread(spread, module)) {
      return false;
    }
    if (spread != undefined && target.isLenient) {
      return false;
    }
    if (spread != undefined) {
      this.errors.write(
        module,
        tree.exprOf(spread.exprId).loc,
        Code.SpreadNotRest,
        kNoDetails,
      );
      this.looseArguments(args, module);

      return false;
    }

    const least = this.types.leastArguments(call);
    const most = call.params.length;
    const count = args.length;
    const isTooMany = !call.rest && count > most;
    if (count >= least && !isTooMany) {
      return true;
    }
    if (target.isLenient) {
      return false;
    }

    const word = this.types.argumentCountText(least, most, call.rest);
    const other = `${count}`;

    this.errors.write(module, target.loc, Code.ArgumentCount, { word, other });

    return false;
  }

  private isArraySpread(spread: CallArgument, module: int): boolean {
    const tree = this.types.program.tree;

    const expr = tree.exprOf(spread.exprId);
    const type = this.typed(expr, undefined, module);

    return type.kind == TypeKind.Array;
  }

  private explicitCall(draft: GenericDraft, module: int): Type {
    const target = draft.target;
    const written = target.typeArgs;
    const total = target.params.length;
    if (written.length > total) {
      const typeArgumentCountErrors =
        this.types.typeArgumentCountErrors(target);

      this.errors.writeAll(module, typeArgumentCountErrors);

      draft.isInferred = false;
    }

    const context: TypeContext = {
      module,
      bindings: new Map<int, Type>(),
      place: TypePlace.Plain,
    };
    const count = Math.min(written.length, total);

    for (let index = 0; index < count; index++) {
      const ref = written[index];
      if (ref != undefined) {
        const type = this.types.resolve(ref, context);

        draft.bound.set(index, type);
      }
    }

    this.finishTypeArguments(draft, module);

    if (!draft.isInferred) {
      this.uncheckedArguments(draft, module);

      return this.types.store.plain(TypeKind.Error);
    }

    this.rememberTypeArguments(draft, module);

    const shape = this.boundShape(draft);
    const call: CallTarget = {
      params: shape.params,
      rest: shape.rest,
      loc: target.loc,
      isLenient: target.isLenient,
    };

    this.argumentsCheck(draft.argsList, draft.args, call, module);

    return shape.result;
  }

  private inferArguments(draft: GenericDraft, module: int): void {
    for (let index = 0; index < draft.args.length; index++) {
      const arg = draft.args[index];
      if (arg != undefined) {
        this.inferFromArgument(draft, index, arg, module);
      }
    }
  }

  private inferFromArgument(
    draft: GenericDraft,
    index: int,
    arg: CallArgument,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const expr = tree.exprOf(arg.exprId);
    const pattern = this.types.patternAt(draft.target.shape, index, arg.spread);
    const form = this.argumentForm(draft, expr, pattern, module);
    switch (form) {
      case ArgumentForm.Plain: {
        const shape = draft.target.shape;
        const slot = this.types.slotAt(shape, index, arg.spread);

        return this.plainArgument(draft, index, expr, slot, module);
      }
      case ArgumentForm.LiteralText:
        return this.literalText(draft, index, expr, pattern, module);
      case ArgumentForm.Contextual:
        draft.contextual.push(index);
        this.inferObjectFields(draft.inference, pattern, expr, module);

        return;
      case ArgumentForm.Shape: {
        const error = this.types.store.plain(TypeKind.Error);
        const shape = this.literalShapeOf(expr) ?? error;
        const isWhole = this.isWholeArgument(expr, shape, module);
        const strength = CandidateStrength.Weak;

        draft.literals.push(index);

        return this.inferArgument(
          draft.inference,
          pattern,
          shape,
          strength,
          isWhole,
        );
      }
      default: {
        if (draft.target.isLenient && this.isSkippedNull(expr, module)) {
          return;
        }
        if (this.enumOfObject(expr, module) != undefined) {
          draft.inference.isUnmatched = true;

          return;
        }

        const given = this.typed(expr, undefined, module);
        const isWhole = this.isWholeArgument(expr, given, module);
        const strength = CandidateStrength.Strong;
        const inferred = this.optionalGiven(draft, index, pattern, given);

        draft.given.set(index, given);

        return this.inferArgument(
          draft.inference,
          pattern,
          inferred,
          strength,
          isWhole,
        );
      }
    }
  }

  private optionalGiven(
    draft: Read<GenericDraft>,
    index: int,
    pattern: Type,
    given: Type,
  ): Type {
    const param = draft.target.shape.params[index];
    const isOptional = param != undefined && param.optional;
    if (!isOptional || this.types.isOptional(pattern)) {
      return given;
    }

    return this.types.definedType(given);
  }

  private readonly isSkippedNull(expr: Expr, module: int): boolean {
    return expr.kind == ExprKind.Name && this.isNullName(expr, module);
  }

  private isWholeArgument(expr: Expr, type: Type, module: int): boolean {
    return type.kind == TypeKind.Int && this.isWholeTree(expr, module);
  }

  private plainArgument(
    draft: GenericDraft,
    index: int,
    expr: Expr,
    pattern: Type,
    module: int,
  ): void {
    if (draft.target.isLenient) {
      return this.lenientClosure(expr, pattern, module);
    }

    const given = this.checked(expr, pattern, module, kNoPlace);

    draft.given.set(index, given);
    draft.settled.add(index);
  }

  private literalText(
    draft: GenericDraft,
    index: int,
    expr: Expr,
    pattern: Type,
    module: int,
  ): void {
    if (expr.kind != ExprKind.StringLit) {
      return;
    }

    const literal = this.types.store.literal(LiteralKind.String, expr.value);
    const given = this.checked(expr, literal, module, kNoPlace);
    const set = draft.inference;
    const strength = CandidateStrength.Strong;

    draft.given.set(index, given);
    draft.settled.add(index);

    this.inferArgument(set, pattern, literal, strength, false);
  }

  private argumentForm(
    draft: Read<GenericDraft>,
    expr: Expr,
    pattern: Type,
    module: int,
  ): ArgumentForm {
    const params = draft.target.params;
    if (!this.isMentioning(pattern, params)) {
      return ArgumentForm.Plain;
    }
    if (this.types.isLiteralText(expr, pattern, params)) {
      return ArgumentForm.LiteralText;
    }
    if (this.isContextual(expr, module)) {
      return ArgumentForm.Contextual;
    }
    if (draft.target.isLenient && expr.kind == ExprKind.Function) {
      return ArgumentForm.Contextual;
    }
    if (this.literalShapeOf(expr) != undefined) {
      return ArgumentForm.Shape;
    }

    const isLiteral =
      expr.kind == ExprKind.ArrayLit || expr.kind == ExprKind.ObjectLit;
    if (isLiteral) {
      return ArgumentForm.Contextual;
    }

    return ArgumentForm.Inferred;
  }

  private boundCall(draft: GenericDraft, module: int): Type {
    if (draft.inference.isUnmatched) {
      this.uncheckedArguments(draft, module);

      return this.types.store.plain(TypeKind.Error);
    }

    this.finishTypeArguments(draft, module);

    if (!draft.isInferred) {
      this.uncheckedArguments(draft, module);

      return this.types.store.plain(TypeKind.Error);
    }
    if (this.growingCheck(draft, module)) {
      return this.types.store.plain(TypeKind.Error);
    }

    this.literalArguments(draft, module);
    this.rememberTypeArguments(draft, module);

    const shape = this.boundShape(draft);

    if (!draft.target.isLenient) {
      this.boundArguments(draft, shape, module);
    }

    this.requireFollowing(draft, module);

    return shape.result;
  }

  private literalArguments(draft: GenericDraft, module: int): void {
    const tree = this.types.program.tree;

    const bound = this.types.boundById(draft);
    const shape = draft.target.shape;

    for (const index of draft.literals) {
      const arg = draft.args[index];
      if (arg == undefined) {
        continue;
      }

      const slot = this.types.slotAt(shape, index, arg.spread);
      const hint = this.types.substituteValue(slot, bound);
      const given = this.literalChecked(
        draft,
        tree.exprOf(arg.exprId),
        hint,
        module,
      );

      draft.given.set(index, given);
      draft.settled.add(index);
    }
  }

  private literalChecked(
    draft: Read<GenericDraft>,
    expr: Expr,
    hint: Type,
    module: int,
  ): Type {
    if (draft.target.isLenient) {
      return this.typed(expr, hint, module);
    }

    return this.checked(expr, hint, module, kNoPlace);
  }

  private boundArguments(
    draft: Read<GenericDraft>,
    shape: Read<FunctionShape>,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    for (let index = 0; index < draft.args.length; index++) {
      const arg = draft.args[index];
      const given = draft.given.get(index);
      const isOpen = arg != undefined && !draft.settled.has(index);
      if (isOpen && arg != undefined && given != undefined) {
        const to = this.types.slotAt(shape, index, arg.spread);

        const expr = tree.exprOf(arg.exprId);

        this.coerce(expr, given, to, module, kNoPlace);
      }
    }
  }

  private uncheckedArguments(draft: Read<GenericDraft>, module: int): void {
    const tree = this.types.program.tree;

    if (draft.target.isLenient) {
      return;
    }

    for (let index = 0; index < draft.args.length; index++) {
      const arg = draft.args[index];
      if (arg != undefined && !draft.given.has(index)) {
        const expr = tree.exprOf(arg.exprId);

        this.typed(expr, undefined, module);
      }
    }
  }

  private rememberTypeArguments(draft: Read<GenericDraft>, module: int): void {
    const target = draft.target;
    const types: Type[] = [];

    for (let index = 0; index < target.params.length; index++) {
      const param = target.params[index];
      const bound = draft.bound.get(index);
      if (bound != undefined) {
        types.push(bound);
      } else if (param != undefined) {
        types.push(param);
      }
    }

    this.typeArguments.set(`${module} ${target.loc}`, types);
  }

  private boundShape(draft: Read<GenericDraft>): FunctionShape {
    const shape = draft.target.shape;
    const bound = this.types.boundById(draft);
    const params: FunctionParameter[] = shape.params.map((param) => ({
      type: this.types.substituteValue(param.type, bound),
      optional: param.optional,
    }));
    const rest = shape.rest;
    const result = this.types.substitute(shape.result, bound);

    return { params, rest, result };
  }

  private growingCheck(draft: Read<GenericDraft>, module: int): boolean {
    const params = draft.target.params;

    for (const [index, type] of draft.bound) {
      const param = params[index];
      if (param == undefined || type.id == param.id) {
        continue;
      }
      if (param.kind != TypeKind.TypeParameter) {
        continue;
      }

      const probe = new Map<int, Type>();

      probe.set(param.id, this.types.store.plain(TypeKind.Never));

      if (this.types.substitute(type, probe).id == type.id) {
        continue;
      }

      this.errors.write(module, draft.target.loc, Code.GenericGrowingSelf, {
        word: draft.target.name,
        first: this.types.typeText(type),
        other: this.types.typeText(param),
      });

      return true;
    }

    return false;
  }
}
