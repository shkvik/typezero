import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import {
  FunctionExpr,
  NameExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { StmtKind } from "../../../../program/ast/types/ast.types.statements.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";
import { ValueTarget } from "../../../code/expression-types/types/expression-types.types.tz";

partial class ExpressionTypes {
  private genericValue(
    expr: NameExpr,
    target: ValueTarget,
    wanted: Type | undefined,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const fn = this.record(target.module)?.functions.get(target.loc);
    const used = this.functionAt(target.module, target.loc);
    const isGeneric =
      fn != undefined && tree.typeParamsOf(fn.typeParamsList).length > 0;
    if (!isGeneric || used.kind != TypeKind.Function) {
      return undefined;
    }
    const typeArgs = tree.typeRefsOf(expr.typeArgsList);
    if (typeArgs.length > 0) {
      return undefined;
    }

    const goal = this.types.wantedFunction(wanted);
    if (goal == undefined) {
      return this.genericValueReport(expr, module);
    }
    if (goal.kind != TypeKind.Function) {
      return undefined;
    }

    const bound = new Map<int, Type>();
    const params = this.types.store.paramsOf(used);

    for (let index = 0; index < params.length; index++) {
      const param = params[index]?.type;
      const given = this.types.store.paramsOf(goal)[index]?.type;
      if (param == undefined || given == undefined) {
        continue;
      }
      if (
        param.kind == TypeKind.TypeParameter &&
        !this.types.mentionsParameter(given)
      ) {
        bound.set(param.id, given);
      }
    }

    if (bound.size == 0) {
      return undefined;
    }

    return this.types.substituteValue(used, bound);
  }

  private genericValueReport(expr: NameExpr, module: int): Type | undefined {
    if (this.argumentExprs.has(expr.id) || this.isConstInit(expr, module)) {
      return undefined;
    }

    this.errors.write(module, expr.loc, Code.GenericValueNeedsArgs, {
      word: expr.name,
    });

    return this.types.store.plain(TypeKind.Error);
  }

  private readonly isConstInit(expr: NameExpr, module: int): boolean {
    const tree = this.types.program.tree;

    const variables = this.record(module)?.variables;
    if (variables == undefined) {
      return false;
    }

    for (const variable of variables.values()) {
      if (variable.isConst && variable.decl.initId == expr.id) {
        return true;
      }
    }

    return false;
  }

  private genericClosureCheck(expr: FunctionExpr, module: int): void {
    const tree = this.types.program.tree;

    if (
      tree.typeParamsOf(tree.functionOf(expr.fnId).typeParamsList).length ==
        0 ||
      this.isTopConstant(expr, module)
    ) {
      return;
    }

    this.errors.write(
      module,
      expr.loc,
      Code.GenericClosureNotTopLevel,
      kNoDetails,
    );
  }

  private readonly isTopConstant(expr: FunctionExpr, module: int): boolean {
    const tree = this.types.program.tree;

    const items =
      tree.stmtsOf(this.types.program.modules[module]?.file.itemsList) ?? [];

    for (const item of items) {
      if (item.kind != StmtKind.VarDecl || !item.isConst) {
        continue;
      }
      if (
        tree
          .declaratorsOf(item.declsList)
          .some((decl) => decl.initId == expr.id)
      ) {
        return true;
      }
    }

    return false;
  }
}
