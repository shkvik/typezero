import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import {
  FunctionExpr,
  NameExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { StmtKind } from "../../../../program/ast/types/ast.types.statements.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";
import { ValueTarget } from "../../../code/expression-types/types/expression-types.types.tz";

partial class ExpressionTypes {
  private genericValue(
    expr: NameExpr,
    target: ValueTarget,
    wanted: Type | undefined,
    module: int,
  ): Type | undefined {
    const fn = this.record(target.module)?.functions.get(target.loc);
    const used = this.functionAt(target.module, target.loc);
    const isGeneric = fn != undefined && fn.typeParams.length > 0;
    if (!isGeneric || used.kind != TypeKind.Function) {
      return undefined;
    }
    if (expr.typeArgs.length > 0) {
      return undefined;
    }

    const goal = this.generics.wantedFunction(wanted);
    if (goal == undefined) {
      return this.genericValueReport(expr, module);
    }
    if (goal.kind != TypeKind.Function) {
      return undefined;
    }

    const bound = new Map<int, Type>();
    const params = used.shape.params;

    for (let index = 0; index < params.length; index++) {
      const param = params[index]?.type;
      const given = goal.shape.params[index]?.type;
      if (param == undefined || given == undefined) {
        continue;
      }
      if (
        param.kind == TypeKind.TypeParameter &&
        !this.parts.mentionsParameter(given)
      ) {
        bound.set(param.id, given);
      }
    }

    if (bound.size == 0) {
      return undefined;
    }

    return this.resolver.substituteValue(used, bound);
  }

  private genericValueReport(expr: NameExpr, module: int): Type | undefined {
    if (this.argumentExprs.has(expr) || this.isConstInit(expr, module)) {
      return undefined;
    }

    this.report(module, expr.loc, Code.GenericValueNeedsArgs, {
      word: expr.name,
    });

    return this.store.plain(TypeKind.Error);
  }

  private isConstInit(expr: NameExpr, module: int): boolean {
    const variables = this.record(module)?.variables;
    if (variables == undefined) {
      return false;
    }

    for (const variable of variables.values()) {
      if (variable.isConst && variable.decl.init == expr) {
        return true;
      }
    }

    return false;
  }

  private genericClosureCheck(expr: FunctionExpr, module: int): void {
    if (expr.fn.typeParams.length == 0 || this.isTopConstant(expr, module)) {
      return;
    }

    this.report(module, expr.loc, Code.GenericClosureNotTopLevel, kNoDetails);
  }

  private isTopConstant(expr: FunctionExpr, module: int): boolean {
    const items = this.program.modules[module]?.file.items ?? [];

    for (const item of items) {
      if (item.kind != StmtKind.VarDecl || !item.isConst) {
        continue;
      }
      if (item.decls.some((decl) => decl.init == expr)) {
        return true;
      }
    }

    return false;
  }
}
