import { kStringArgument } from "../const/expression-types.const.tz";
import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { ClassDecl } from "../../../../program/ast/types/ast.types.classes.tz";
import {
  BinaryExpr,
  MemberExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../program/ast/types/ast.types.functions.tz";
import { TypeRef } from "../../../../program/ast/types/ast.types.types.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";

partial class ExpressionTypes {
  private genericClassRules(decl: ClassDecl, module: int): void {
    const tree = this.types.program.tree;

    this.classGrowthCheck(decl, module);

    for (const fn of tree.functionsOf(decl.methodsList)) {
      const genericMethodErrors = this.types.genericMethodErrors(
        decl,
        fn,
      );

      this.errors.writeAll(module, genericMethodErrors);
    }
  }

  private classGrowthCheck(decl: ClassDecl, module: int): void {
    const tree = this.types.program.tree;

    const name = decl.name ?? "";
    if (tree.typeParamsOf(decl.typeParamsList).length == 0 || name == "") {
      return;
    }

    const names = tree
      .typeParamsOf(decl.typeParamsList)
      .map((param) => param.name);
    const refs: TypeRef[] = [];

    for (const field of tree.fieldsOf(decl.fieldsList)) {
      const type = tree.typeRefAt(field.typeId);
      if (type != undefined) {
        refs.push(type);
      }
    }

    const growing = refs.some((root) =>
      this.types.isGrowingUse(root, name, names),
    );
    if (growing) {
      this.errors.write(module, decl.loc, Code.GenericClassGrowing, {
        word: name,
      });
    }
  }

  private genericMethodValue(
    expr: MemberExpr,
    method: FunctionDecl,
    module: int,
  ): boolean {
    const checked = this.types.genericMethodValue(expr, method);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private genericInstanceofCheck(
    expr: BinaryExpr,
    left: Type,
    decl: ClassDecl,
    home: int,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const base = this.types.definedType(left);
    const word = decl.name ?? "";
    const typeParams = tree.typeParamsOf(decl.typeParamsList);
    if (typeParams.length == 0) {
      return;
    }

    const isOpaque =
      base.kind == TypeKind.Unknown || base.kind == TypeKind.AnyObject;
    if (isOpaque) {
      const code = this.types.genericTellCode(home);
      const first = this.types.typeText(base);
      const other = `${word}${kStringArgument}`;

      return this.errors.write(module, expr.loc, code, { word, first, other });
    }
    if (this.types.isOpenTested(base)) {
      return;
    }

    const parts = this.types.unionMembers(base);
    const isMatching = parts.some((part) =>
      this.types.isInstanceOfClass(part, word),
    );
    if (isMatching) {
      return;
    }

    const first = this.types.typeText(base);
    const open = tree.typeParamsOf(decl.typeParamsList).map(() =>
      this.types.store.plain(TypeKind.Error),
    );
    const instance = this.types.classInstance(home, decl, open);
    const ancestors = this.types.ancestorsOf(instance);
    const isRelated = parts.some((part) =>
      ancestors.some((one) => one.id == part.id),
    );
    if (!isRelated) {
      this.errors.write(module, expr.loc, Code.InstanceOfGenericNever, {
        word,
        first,
      });

      return;
    }

    const code = this.types.genericTellCode(home);

    this.errors.write(module, expr.loc, code, { word, first, other: first });
  }
}
