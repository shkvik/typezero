import { kStringArgument } from "../const/expression-types.const.tz";
import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { ClassDecl } from "../../../../program/ast/types/ast.types.classes.tz";
import {
  BinaryExpr,
  MemberExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../program/ast/types/ast.types.functions.tz";
import { TypeRef } from "../../../../program/ast/types/ast.types.types.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";

partial class ExpressionTypes {
  private readonly genericClassRules(decl: ClassDecl, module: int): void {
    this.classGrowthCheck(decl, module);

    for (const fn of decl.methods) {
      const genericMethodErrors = this.genericCalls.genericMethodErrors(
        decl,
        fn,
      );

      this.reportAll(module, genericMethodErrors);
    }
  }

  private readonly classGrowthCheck(decl: ClassDecl, module: int): void {
    const name = decl.name ?? "";
    if (decl.typeParams.length == 0 || name == "") {
      return;
    }

    const names = decl.typeParams.map((param) => param.name);
    const refs: TypeRef[] = [];

    for (const field of decl.fields) {
      const type = field.type;
      if (type != undefined) {
        refs.push(type);
      }
    }

    const growing = refs.some((root) =>
      this.resolver.isGrowingUse(root, name, names),
    );
    if (growing) {
      this.report(module, decl.loc, Code.GenericClassGrowing, { word: name });
    }
  }

  private readonly genericMethodValue(
    expr: MemberExpr,
    method: FunctionDecl,
    module: int,
  ): boolean {
    const checked = this.genericCalls.genericMethodValue(expr, method);

    this.reportFound(module, checked.error);

    return checked.value;
  }

  private readonly genericInstanceofCheck(
    expr: BinaryExpr,
    left: Type,
    decl: ClassDecl,
    home: int,
    module: int,
  ): void {
    const base = this.types.definedType(left);
    const word = decl.name ?? "";
    if (decl.typeParams.length == 0) {
      return;
    }

    const isOpaque =
      base.kind == TypeKind.Unknown || base.kind == TypeKind.AnyObject;
    if (isOpaque) {
      const code = this.genericCalls.genericTellCode(home);
      const first = this.text.of(base);
      const other = `${word}${kStringArgument}`;

      return this.report(module, expr.loc, code, { word, first, other });
    }
    if (this.classValues.isOpenTested(base)) {
      return;
    }

    const parts = this.types.unionMembers(base);
    const isMatching = parts.some((part) =>
      this.generics.isInstanceOfClass(part, word),
    );
    if (isMatching) {
      return;
    }

    const first = this.text.of(base);
    const open = decl.typeParams.map(() => this.store.plain(TypeKind.Error));
    const instance = this.resolver.classInstance(home, decl, open);
    const ancestors = this.types.ancestorsOf(instance);
    const isRelated = parts.some((part) => ancestors.includes(part));
    if (!isRelated) {
      this.report(module, expr.loc, Code.InstanceOfGenericNever, {
        word,
        first,
      });

      return;
    }

    const code = this.genericCalls.genericTellCode(home);

    this.report(module, expr.loc, code, { word, first, other: first });
  }
}
