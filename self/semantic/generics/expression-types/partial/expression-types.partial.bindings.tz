import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { TypeParamDecl } from "../../../../program/ast/types/ast.types.types.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";
import {
  CandidateStrength,
  GenericDraft,
  InferenceSet,
} from "../../../code/expression-types/types/expression-types.types.tz";
import {
  Expr,
  ExprKind,
  PropertyKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";

partial class ExpressionTypes {
  private settleStrong(draft: GenericDraft, module: int): void {
    for (let index = 0; index < draft.target.params.length; index++) {
      const strong = this.types.candidatesOf(
        draft.inference,
        index,
        CandidateStrength.Strong,
      );
      if (strong.length > 0) {
        this.settleParameter(draft, index, module);
      }
    }
  }

  private settleAll(draft: GenericDraft, module: int): void {
    for (let index = 0; index < draft.target.params.length; index++) {
      this.settleParameter(draft, index, module);
    }
  }

  private settleParameter(draft: GenericDraft, index: int, module: int): void {
    if (draft.bound.has(index)) {
      return;
    }

    const joined = this.joinCandidates(draft, index, module);

    if (draft.bound.has(index)) {
      return;
    }

    const widened = this.types.widenedToConstraint(draft, index, joined);
    const type = this.types.withUndefined(draft, index, widened);

    if (type != undefined) {
      draft.bound.set(index, type);
    }
  }

  private joinCandidates(
    draft: GenericDraft,
    index: int,
    module: int,
  ): Type | undefined {
    const set = draft.inference;
    const strong = this.types.candidatesOf(
      set,
      index,
      CandidateStrength.Strong,
    );
    const weak = this.types.candidatesOf(set, index, CandidateStrength.Weak);
    const literal = this.types.candidatesOf(
      set,
      index,
      CandidateStrength.Literal,
    );
    let type: Type | undefined = undefined;

    for (const candidate of strong) {
      const next = this.types.joinedWith(type, candidate);
      if (next == undefined) {
        return this.clash(draft, index, type, candidate, module);
      }

      type = next;
    }

    for (const candidate of weak) {
      const next = this.types.joinedWith(type, candidate);
      if (next == undefined && strong.length == 0) {
        return this.clash(draft, index, type, candidate, module);
      }
      if (next != undefined) {
        type = next;
      }
    }

    for (const candidate of literal) {
      if (this.types.isOtherNumber(type, candidate)) {
        continue;
      }

      const next = this.types.joinedWith(type, candidate);
      if (next == undefined) {
        return this.clash(draft, index, type, candidate, module);
      }

      type = next;
    }

    return type;
  }

  private clash(
    draft: GenericDraft,
    index: int,
    type: Type | undefined,
    candidate: Type,
    module: int,
  ): Type | undefined {
    const checked = this.types.clash(draft, index, type, candidate);

    this.errors.writeFound(module, checked.error);

    return checked.value;
  }

  private inferFromWanted(draft: GenericDraft): void {
    const wanted = draft.wanted;
    const params = draft.target.params;
    const result = draft.target.shape.result;
    const isOpen = draft.bound.size < params.length;
    if (wanted == undefined || !isOpen) {
      return;
    }
    if (!this.isMentioning(result, params)) {
      return;
    }

    const set = this.types.inferenceSet(params.slice());

    this.inferPair(set, result, wanted);

    for (let index = 0; index < params.length; index++) {
      const strong = this.types.candidatesOf(
        set,
        index,
        CandidateStrength.Strong,
      );
      const type = this.types.wantedCandidate(strong);
      if (!draft.bound.has(index) && type != undefined) {
        draft.bound.set(index, type);
      }
    }
  }

  private finishTypeArguments(draft: GenericDraft, module: int): void {
    const isSilent = this.types.hasArgumentErrors(draft);

    for (let index = 0; index < draft.target.params.length; index++) {
      this.finishTypeArgument(draft, index, isSilent, module);
    }
  }

  private finishTypeArgument(
    draft: GenericDraft,
    index: int,
    isSilent: boolean,
    module: int,
  ): void {
    const target = draft.target;
    const param = target.params[index];
    const decl = target.decls[index];

    if (param == undefined) {
      return;
    }
    if (!draft.bound.has(index) && decl != undefined) {
      this.defaultArgument(draft, index, decl);
    }

    const found = draft.bound.get(index);
    if (found == undefined) {
      if (!isSilent) {
        const target = draft.target;
        const error = this.types.uninferredError(target, param);

        this.errors.writeFound(module, error);
      }

      this.types.failParameter(draft, index);

      return;
    }
    if (found.kind == TypeKind.Error) {
      draft.isInferred = false;

      return;
    }
    if (decl == undefined || target.isLenient) {
      return;
    }

    this.constraintCheck(draft, index, decl, found, module);
  }

  private defaultArgument(
    draft: GenericDraft,
    index: int,
    decl: TypeParamDecl,
  ): void {
    const target = draft.target;
    const bindings = this.types.boundByLoc(draft);
    const fallback = this.types.defaultOf(target.home, decl, bindings);
    if (fallback == undefined) {
      return;
    }

    const open = this.types.openParameters(draft);
    if (this.isMentioning(fallback, open)) {
      return;
    }

    draft.bound.set(index, fallback);
  }

  private constraintCheck(
    draft: GenericDraft,
    index: int,
    decl: TypeParamDecl,
    found: Type,
    module: int,
  ): void {
    const target = draft.target;
    const bindings = this.types.boundByLoc(draft);
    const home = target.home;
    const miss = this.types.constraintMiss(home, decl, found, bindings);
    if (miss == undefined) {
      return;
    }

    const word = decl.name;
    const first = this.types.typeText(found);
    const second = target.name;

    this.errors.write(module, target.loc, Code.ConstraintNotSatisfied, {
      word,
      first,
      other: miss,
      second,
    });

    this.types.failParameter(draft, index);
  }

  private fillDefaults(draft: GenericDraft): boolean {
    const decls = draft.target.decls;
    let isDefaulted = false;

    for (let index = 0; index < decls.length; index++) {
      const decl = decls[index];
      if (decl == undefined || draft.bound.has(index)) {
        continue;
      }

      const fallback = this.closedDefault(draft, decl);
      if (fallback != undefined) {
        draft.bound.set(index, fallback);
        isDefaulted = true;
      }
    }

    return isDefaulted;
  }

  private closedDefault(
    draft: Read<GenericDraft>,
    decl: TypeParamDecl,
  ): Type | undefined {
    const target = draft.target;
    const bindings = new Map<int, Type>();
    const fallback = this.types.defaultOf(target.home, decl, bindings);
    if (fallback == undefined) {
      return undefined;
    }
    if (this.isMentioning(fallback, target.params)) {
      return undefined;
    }

    return fallback;
  }

  private inferObjectFields(
    set: InferenceSet,
    pattern: Type,
    expr: Expr,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const wanted = this.types.definedType(pattern);
    if (expr.kind != ExprKind.ObjectLit || wanted.kind != TypeKind.Object) {
      return;
    }

    for (const prop of tree.propertiesOf(expr.propsList)) {
      const field = this.types.store
        .fieldsOf(wanted)
        .find((one) => one.name == prop.name);
      const value = tree.exprOf(prop.valueId);
      const isPlain =
        prop.form.kind == PropertyKind.Value &&
        value.kind != ExprKind.Function &&
        this.literalShapeOf(value) == undefined &&
        !this.isContextual(value, module);
      if (field == undefined || !isPlain) {
        continue;
      }

      const given = this.peekType(value, module);
      const strength = CandidateStrength.Strong;

      this.inferArgument(set, field.type, given, strength, false);
    }
  }
}
