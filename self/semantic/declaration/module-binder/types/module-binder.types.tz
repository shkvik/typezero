import {
  ImportDecl,
  ModuleName,
} from "../../../../program/ast/types/ast.types.modules.tz";
import { ModuleNames } from "../../../../program/module-names/types/module-names.types.tz";

export enum BindState {
  New,
  Exporting,
  Exported,
}

export type BoundModule = {
  readonly names: ModuleNames;
  state: Cell<BindState>;
};

export type InternedBound = Interned<BoundModule>;

export type ImportedName = {
  readonly decl: ImportDecl;
  readonly name: ModuleName;
};

export type Submodule = {
  readonly parent: string;
  readonly name: string;
  readonly module: string;
};
