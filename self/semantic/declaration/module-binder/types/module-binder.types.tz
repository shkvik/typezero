import { SourceError } from "../../../../diagnostic/types/message.types.tz";
import {
  ImportDecl,
  ModuleName,
} from "../../../../program/ast/types/ast.types.modules.tz";
import {
  ModuleExport,
  ModuleImport,
} from "../../../../program/module-names/types/module-names.types.tz";
import { Module } from "../../../../program/module/types/module.types.tz";

export enum BindState {
  New,
  Exporting,
  Exported,
}

export type BoundModule = {
  readonly module: int;
  declared: Map<string, int>;
  exports: Map<string, ModuleExport>;
  imports: Map<string, ModuleImport>;
  errors: SourceError[];
  state: BindState;
};

export type ImportedName = {
  readonly decl: ImportDecl;
  readonly name: ModuleName;
};

export type Submodule = {
  readonly parent: string;
  readonly name: string;
  readonly module: string;
};
