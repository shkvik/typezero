import { ModuleBinder } from "../module-binder.tz";
import {
  NameOrigin,
  VarDeclarator,
} from "../../../../program/ast/types/ast.types.patterns.tz";
import {
  Stmt,
  StmtKind,
} from "../../../../program/ast/types/ast.types.statements.tz";
import { BoundModule } from "../types/module-binder.types.tz";

partial class ModuleBinder {
  private readonly declareNames(bound: Read<BoundModule>): void {
    const module = bound.names.module;

    for (const item of module.file.items) {
      this.declareItem(bound, item);
    }

    for (const one of module.declared) {
      this.declare(bound, one.name, one.loc);
    }
  }

  private readonly declareItem(bound: Read<BoundModule>, item: Stmt): void {
    switch (item.kind) {
      case StmtKind.VarDecl:
        this.declareVariables(bound, item.decls);
        break;
      case StmtKind.Function:
      case StmtKind.TypeAlias:
      case StmtKind.Enum:
      case StmtKind.Handle:
        this.declare(bound, item.name, item.loc);
        break;
      case StmtKind.Class:
        this.declare(bound, item.name ?? "", item.loc);
        break;
      default:
        break;
    }
  }

  private readonly declareVariables(bound: Read<BoundModule>, decls: Read<VarDeclarator[]>): void {
    for (const decl of decls) {
      if (decl.origin == NameOrigin.Written) {
        this.declare(bound, decl.name, decl.loc);
      }
    }
  }

  private readonly declare(bound: Read<BoundModule>, name: string, loc: int): void {
    if (name != "" && !bound.names.declared.has(name)) {
      bound.names.declared.set(name, loc);
    }
  }
}
