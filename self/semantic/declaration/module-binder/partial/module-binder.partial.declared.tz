import { ModuleBinder } from "../module-binder.tz";
import {
  NameOrigin,
  VarDeclarator,
} from "../../../../program/ast/types/ast.types.patterns.tz";
import {
  Stmt,
  StmtKind,
} from "../../../../program/ast/types/ast.types.statements.tz";
import { Program } from "../../../../program/module/types/module.types.tz";

partial class ModuleBinder {
  private declareNames(program: Read<Program>, at: int): void {
    const tree = program.tree;

    const module = this.moduleAt(program, at);
    if (module == undefined) {
      return;
    }

    for (const item of tree.stmtsOf(module.file.itemsList)) {
      this.declareItem(program, at, item);
    }

    for (const one of tree.declaredClassesOf(module.declaredList)) {
      this.declare(at, one.name, one.loc);
    }
  }

  private declareItem(program: Read<Program>, at: int, item: Stmt): void {
    const tree = program.tree;

    switch (item.kind) {
      case StmtKind.VarDecl:
        const decls = tree.declaratorsOf(item.declsList);

        this.declareVariables(at, decls);
        break;
      case StmtKind.Function:
      case StmtKind.TypeAlias:
      case StmtKind.Enum:
      case StmtKind.Handle:
        this.declare(at, item.name, item.loc);
        break;
      case StmtKind.Class:
        this.declare(at, item.name ?? "", item.loc);
        break;
      default:
        break;
    }
  }

  private declareVariables(at: int, decls: Read<VarDeclarator[]>): void {
    for (const decl of decls) {
      if (decl.origin == NameOrigin.Written) {
        this.declare(at, decl.name, decl.loc);
      }
    }
  }

  private declare(at: int, name: string, loc: int): void {
    const bound = this.ordered[at];
    if (name != "" && bound != undefined && !bound.declared.has(name)) {
      bound.declared.set(name, loc);
    }
  }
}
