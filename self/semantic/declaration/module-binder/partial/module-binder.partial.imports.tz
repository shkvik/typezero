import { ModuleBinder } from "../module-binder.tz";
import { Code } from "../../../../diagnostic/code.tz";
import {
  ImportDecl,
  ModuleName,
} from "../../../../program/ast/types/ast.types.modules.tz";
import { Program } from "../../../../program/module/types/module.types.tz";

partial class ModuleBinder {
  private bindImports(program: Read<Program>, at: int): void {
    const tree = program.tree;

    const module = this.moduleAt(program, at);
    if (module == undefined) {
      return;
    }

    for (const decl of tree.importsOf(module.file.importsList)) {
      this.bindImport(program, at, decl);
    }

    for (const decl of tree.importsOf(module.implicitList)) {
      this.bindImport(program, at, decl);
    }
  }

  private bindImport(program: Read<Program>, at: int, decl: ImportDecl): void {
    const tree = program.tree;

    const from = decl.from;
    const source = this.linkedIndex(program, at, from);
    if (source == undefined) {
      return;
    }

    this.exportsOf(program, source);

    for (const name of tree.namesOf(decl.namesList)) {
      this.importName(program, at, source, from.path, name);
    }
  }

  private importName(
    program: Read<Program>,
    at: int,
    source: int,
    path: string,
    name: ModuleName,
  ): void {
    const target = this.exportedBy(program, at, source, path, name);
    if (target == undefined) {
      return;
    }

    const word = name.as;
    if (this.isDeclaredAt(at, word)) {
      this.report(at, name.asLoc, Code.ImportConflictsWithDeclaration, {
        word,
        other: name.name,
        path,
      });

      return;
    }

    const previous = this.importAt(at, word);
    if (previous != undefined) {
      const other = this.lineOf(program, at, previous.loc);

      this.report(at, name.asLoc, Code.DuplicateImport, { word, other });

      return;
    }

    const bound = this.ordered[at];
    if (bound != undefined) {
      bound.imports.set(word, { target, loc: name.asLoc });
    }
  }
}
