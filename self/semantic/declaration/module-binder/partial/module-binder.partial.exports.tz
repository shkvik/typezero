import { replace } from "tz:mem";
import { ModuleBinder } from "../module-binder.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { SourceError } from "../../../../diagnostic/types/message.types.tz";
import {
  ExportDecl,
  ExportForm,
  ModuleName,
  ModulePath,
} from "../../../../program/ast/types/ast.types.modules.tz";
import { kBuiltinModules } from "../../../../program/library/builtin-modules/const/builtin-modules.const.tz";
import {
  ModuleExport,
  NameTarget,
} from "../../../../program/module-names/types/module-names.types.tz";
import {
  Module,
  Program,
} from "../../../../program/module/types/module.types.tz";
import { BindState, ImportedName } from "../types/module-binder.types.tz";
import { kSubmodules } from "../const/module-binder.const.tz";

partial class ModuleBinder {
  private exportsOf(program: Read<Program>, at: int): void {
    const tree = program.tree;

    const bound = this.ordered[at];
    if (bound == undefined || bound.state != BindState.New) {
      return;
    }

    bound.state = BindState.Exporting;

    const exports = tree.exportsOf(
      this.moduleAt(program, at)?.file.exportsList,
    );

    this.exportDeclared(program, at);

    for (const decl of exports) {
      this.exportNames(program, at, decl);
    }

    for (const decl of exports) {
      this.exportAll(program, at, decl);
    }

    this.markExported(at);
  }

  private markExported(at: int): void {
    const bound = this.ordered[at];
    if (bound != undefined) {
      bound.state = BindState.Exported;
    }
  }

  private exportDeclared(program: Read<Program>, at: int): void {
    const isDeclarationOnly = this.moduleAt(program, at)?.isDeclarationOnly;
    const bound = this.ordered[at];
    if (bound == undefined || isDeclarationOnly != true) {
      return;
    }

    const id = bound.module;

    for (const [name, loc] of bound.declared) {
      bound.exports.set(name, { target: { module: id, name }, loc });
    }
  }

  private exportNames(program: Read<Program>, at: int, decl: ExportDecl): void {
    const tree = program.tree;

    const from = decl.from;
    const module = this.moduleAt(program, at);
    const isLibrary = module != undefined && module.source.isLibrary;
    if (from != undefined && !isLibrary && kBuiltinModules.has(from.path)) {
      this.report(at, from.loc, Code.ExportFromBuiltin, {
        path: from.path,
      });

      return;
    }

    for (const name of tree.namesOf(decl.namesList)) {
      this.exportName(program, at, decl, name);
    }
  }

  private exportName(
    program: Read<Program>,
    at: int,
    decl: ExportDecl,
    name: ModuleName,
  ): void {
    const target = this.exportTarget(program, at, decl, name);
    if (target == undefined) {
      return;
    }

    const previous = this.exportAt(at, name.as);
    if (previous != undefined) {
      const other = this.lineOf(program, at, previous.loc);

      this.report(at, name.asLoc, Code.DuplicateExport, {
        word: name.as,
        other,
      });

      return;
    }

    const bound = this.ordered[at];
    if (bound != undefined) {
      bound.exports.set(name.as, { target, loc: name.asLoc });
    }
  }

  private exportTarget(
    program: Read<Program>,
    at: int,
    decl: ExportDecl,
    name: ModuleName,
  ): NameTarget | undefined {
    const from = decl.from;
    if (from == undefined) {
      return this.localTarget(program, at, name);
    }

    const source = this.linkedIndex(program, at, from);
    if (source == undefined) {
      return undefined;
    }

    this.exportsOf(program, source);

    return this.exportedBy(program, at, source, from.path, name);
  }

  private exportedBy(
    program: Read<Program>,
    at: int,
    source: int,
    path: string,
    name: ModuleName,
  ): NameTarget | undefined {
    const word = name.name;
    const found = this.exportAt(source, word);
    if (found != undefined) {
      return found.target;
    }

    const theirModule = this.moduleAt(program, source);
    if (theirModule == undefined) {
      return undefined;
    }
    if (this.isSubmodule(theirModule.name, word)) {
      return { module: theirModule.id, name: word };
    }
    if (this.exports.isPendingCall(theirModule.name, word)) {
      return { module: theirModule.id, name: word };
    }

    const unmarked =
      this.isDeclaredAt(source, word) && !theirModule.source.isLibrary;
    if (unmarked) {
      const other = theirModule.name;

      this.report(at, name.loc, Code.NoExportNamedUnmarked, {
        path,
        word,
        other,
      });

      return undefined;
    }

    if (theirModule.source.isLibrary) {
      const missing = this.exports.missing(theirModule.name, path, word);

      this.report(at, name.loc, missing.code, missing.details);

      return undefined;
    }

    this.report(at, name.loc, Code.NoExportNamed, { path, word });

    return undefined;
  }

  private readonly isSubmodule(module: string, word: string): boolean {
    return kSubmodules.some((one) => one.parent == module && one.name == word);
  }

  private localTarget(
    program: Read<Program>,
    at: int,
    name: ModuleName,
  ): NameTarget | undefined {
    const module = this.moduleAt(program, at);
    const word = name.name;
    if (module == undefined) {
      return undefined;
    }
    if (this.isDeclaredAt(at, word)) {
      return { module: module.id, name: word };
    }

    const imported = this.importedAs(program, module, word);
    if (imported == undefined) {
      const code = this.unknownExportCode(program, module, word);

      this.report(at, name.loc, code, { word });

      return undefined;
    }

    const from = imported.decl.from;
    if (!module.source.isLibrary && kBuiltinModules.has(from.path)) {
      this.report(at, name.loc, Code.ExportOfBuiltinName, { word });

      return undefined;
    }

    const source = this.linkedIndex(program, at, from);
    if (source == undefined) {
      return undefined;
    }

    this.exportsOf(program, source);

    const found = this.exportAt(source, imported.name.name);
    if (found == undefined) {
      return undefined;
    }

    return found.target;
  }

  private readonly importedAs(
    program: Read<Program>,
    module: Read<Module>,
    word: string,
  ): ImportedName | undefined {
    const tree = program.tree;

    for (const decl of tree.importsOf(module.file.importsList)) {
      const name = tree.namesOf(decl.namesList).find((one) => one.as == word);
      if (name != undefined) {
        return { decl, name };
      }
    }

    return undefined;
  }

  private readonly unknownExportCode(
    program: Read<Program>,
    module: Read<Module>,
    word: string,
  ): Code {
    const tree = program.tree;

    const imports = tree.importsOf(module.file.importsList);
    const whole = imports.some((decl) => decl.whole?.name == word);
    if (whole) {
      return Code.ExportOfBuiltinName;
    }

    return Code.ExportNotFound;
  }

  private exportAll(program: Read<Program>, at: int, decl: ExportDecl): void {
    const from = decl.from;
    if (decl.form != ExportForm.All || from == undefined) {
      return;
    }

    const source = this.linkedIndex(program, at, from);
    if (source == undefined || source == at) {
      return;
    }

    this.exportsOf(program, source);

    const ours = this.takeExports(at);
    const problems: SourceError[] = [];
    const theirs = this.exportsAt(source);

    if (theirs != undefined) {
      for (const [name, exported] of theirs) {
        this.exportThroughStar(ours, problems, decl, from, name, exported);
      }
    }

    this.putExports(at, ours);
    this.addErrors(at, problems);
  }

  private takeExports(at: int): Map<string, ModuleExport> {
    const bound = this.ordered[at];
    if (bound == undefined) {
      return new Map<string, ModuleExport>();
    }

    return replace(bound.exports, new Map<string, ModuleExport>());
  }

  private putExports(at: int, exports: Own<Map<string, ModuleExport>>): void {
    const bound = this.ordered[at];
    if (bound != undefined) {
      bound.exports = exports;
    }
  }

  private readonly exportThroughStar(
    ours: Map<string, ModuleExport>,
    problems: SourceError[],
    decl: ExportDecl,
    from: ModulePath,
    name: string,
    exported: ModuleExport,
  ): void {
    const known = ours.get(name);
    if (known == undefined) {
      ours.set(name, { target: exported.target, loc: decl.loc, star: from });

      return;
    }

    const first = known.star;
    if (first == undefined || this.sameTarget(known.target, exported.target)) {
      return;
    }

    problems.push({
      code: Code.StarExportTwice,
      loc: decl.loc,
      details: {
        word: name,
        path: first.path,
        other: from.path,
      },
    });
  }

  private readonly sameTarget(first: NameTarget, second: NameTarget): boolean {
    return first.module == second.module && first.name == second.name;
  }
}
