import { FunctionDecl } from "../../../program/ast/types/ast.types.functions.tz";
import {
  Stmt,
  StmtKind,
} from "../../../program/ast/types/ast.types.statements.tz";
import { kLibrary } from "../../../program/library/library-modules/const/library-modules.const.tz";
import { ModuleNames } from "../../../program/module-names/types/module-names.types.tz";
import { Module, Program } from "../../../program/module/types/module.types.tz";
import { ModuleScopes } from "../../../program/scopes/types/scopes.types.tz";
import { ScopeTraversal } from "../scope-traversal/scope-traversal.tz";
import { GlobalDraft, GlobalScope } from "./types/name-resolver.types.tz";

export class NameResolver {
  private readonly names: ModuleNames[];

  public constructor(names: Own<ModuleNames[]>) {
    this.names = names;
  }

  public run(program: Read<Program>): ModuleScopes[] {
    let globals: GlobalScope = this.globalScope(program);
    const partMethods = this.partMethods(program);
    const resolved: ModuleScopes[] = [];

    for (const names of this.names.drain()) {
      const traversal = new ScopeTraversal(names, globals, partMethods.slice());
      const scopes = traversal.run(program);

      globals = traversal.takeGlobals();
      resolved.push(scopes);
    }

    return resolved;
  }

  private readonly globalScope(program: Read<Program>): GlobalScope {
    const tree = program.tree;

    const globals: GlobalDraft = {
      values: new Set<string>(),
      types: new Set<string>(),
      namespaces: new Map<string, Set<string>>(),
    };

    for (const builtin of program.builtins) {
      for (const item of tree.stmtsOf(builtin.parsed.file.itemsList)) {
        this.addGlobal(program, globals, item);
      }
    }

    for (const id of program.globals) {
      const module = program.modules[id];
      if (module == undefined) {
        continue;
      }

      const word = kLibrary.named(module.name)?.namespace;
      if (word == undefined) {
        this.addDeclared(program, globals, module);
      } else {
        this.addNamespace(program, globals, module, word);
      }
    }

    return {
      values: globals.values,
      types: globals.types,
      namespaces: globals.namespaces,
    };
  }

  private readonly addDeclared(
    program: Read<Program>,
    names: GlobalDraft,
    module: Read<Module>,
  ): void {
    const tree = program.tree;

    for (const item of tree.stmtsOf(module.file.itemsList)) {
      this.addGlobal(program, names, item);
    }

    for (const one of tree.declaredClassesOf(module.declaredList)) {
      names.values.add(one.name);
      names.types.add(one.name);
    }
  }

  private readonly addNamespace(
    program: Read<Program>,
    globals: GlobalDraft,
    module: Read<Module>,
    word: string,
  ): void {
    const inside: GlobalDraft = {
      values: new Set<string>(),
      types: new Set<string>(),
      namespaces: new Map<string, Set<string>>(),
    };

    this.addDeclared(program, inside, module);
    globals.namespaces.set(word, inside.types);

    if (inside.values.size > 0) {
      globals.values.add(word);
    }
  }

  private readonly addGlobal(
    program: Read<Program>,
    globals: GlobalDraft,
    item: Stmt,
  ): void {
    const tree = program.tree;

    switch (item.kind) {
      case StmtKind.VarDecl:
        for (const decl of tree.declaratorsOf(item.declsList)) {
          globals.values.add(decl.name);
        }
        break;
      case StmtKind.Function:
        globals.values.add(item.name);
        break;
      case StmtKind.TypeAlias:
      case StmtKind.Handle:
        globals.types.add(item.name);
        break;
      case StmtKind.Enum:
        globals.values.add(item.name);
        globals.types.add(item.name);
        break;
      case StmtKind.Class:
        globals.values.add(item.name ?? "");
        globals.types.add(item.name ?? "");
        break;
      default:
        break;
    }
  }

  private readonly partMethods(program: Read<Program>): FunctionDecl[] {
    const tree = program.tree;

    const methods: FunctionDecl[] = [];

    for (const module of program.modules) {
      for (const part of tree.classesOf(module.partsList)) {
        for (const method of tree.functionsOf(part.methodsList)) {
          methods.push(method);
        }
      }
    }

    return methods;
  }
}
