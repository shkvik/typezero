import { NameSymbol } from "../../../program/scopes/types/scopes.types.tz";
import { Scope, ScopeEntry } from "./types/scope-stack.types.tz";

export class ScopeStack {
  private readonly scopes: Scope[];
  private depth: int;

  public constructor() {
    this.scopes = [];
    this.depth = 0;
  }

  public open(): void {
    this.scopes.push({
      values: new Map<string, ScopeEntry>(),
      types: new Map<string, ScopeEntry>(),
    });
  }

  public close(): void {
    this.scopes.pop();
  }

  public enterFunction(): void {
    this.depth += 1;
  }

  public leaveFunction(): void {
    this.depth -= 1;
  }

  public declaredValue(name: string): Read<ScopeEntry> | undefined {
    this.ensureScope();

    return this.scopes[this.scopes.length - 1]?.values.get(name);
  }

  public declaredType(name: string): Read<ScopeEntry> | undefined {
    this.ensureScope();

    return this.scopes[this.scopes.length - 1]?.types.get(name);
  }

  public declareValue(symbol: NameSymbol, live: boolean): void {
    const entry: ScopeEntry = { symbol, depth: this.depth, live };

    this.ensureScope();
    this.scopes[this.scopes.length - 1]?.values.set(symbol.name, entry);
  }

  public declareType(symbol: NameSymbol): void {
    const entry: ScopeEntry = { symbol, depth: this.depth, live: true };

    this.ensureScope();
    this.scopes[this.scopes.length - 1]?.types.set(symbol.name, entry);
  }

  public readonly findValue(name: string): Read<ScopeEntry> | undefined {
    for (let index = this.scopes.length - 1; index >= 0; index--) {
      const entry = this.scopes[index]?.values.get(name);
      if (entry != undefined) {
        return entry;
      }
    }

    return undefined;
  }

  public readonly findType(name: string): Read<ScopeEntry> | undefined {
    for (let index = this.scopes.length - 1; index >= 0; index--) {
      const entry = this.scopes[index]?.types.get(name);
      if (entry != undefined) {
        return entry;
      }
    }

    return undefined;
  }

  public markLive(name: string): void {
    for (let index = this.scopes.length - 1; index >= 0; index--) {
      const entry = this.scopes[index]?.values.get(name);
      if (entry != undefined) {
        entry.live = true;

        return;
      }
    }
  }

  public readonly currentDepth(): int {
    return this.depth;
  }

  public readonly isReadable(entry: Read<ScopeEntry>): boolean {
    return entry.live || entry.depth != this.depth;
  }

  private ensureScope(): void {
    if (this.scopes.length == 0) {
      this.open();
    }
  }
}
