import { NameSymbol } from "../../../../program/scopes/types/scopes.types.tz";

export type ScopeEntry = {
  readonly symbol: NameSymbol;
  readonly depth: int;
  live: Cell<boolean>;
};

export type InternedScopeEntry = Interned<ScopeEntry>;

export type Scope = {
  readonly values: Map<string, ScopeEntry>;
  readonly types: Map<string, ScopeEntry>;
};
