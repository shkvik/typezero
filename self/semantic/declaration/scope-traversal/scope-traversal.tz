import "./partial/scope-traversal.partial.imports.tz";
import "./partial/scope-traversal.partial.declarations.tz";
import "./partial/scope-traversal.partial.statements.tz";
import "./partial/scope-traversal.partial.expressions.tz";
import "./partial/scope-traversal.partial.types.tz";
import "./partial/scope-traversal.partial.classes.tz";
import "./partial/scope-traversal.partial.missing.tz";
import "./partial/scope-traversal.partial.jumps.tz";
import { Code } from "../../../diagnostic/code.tz";
import {
  Details,
  SourceError,
} from "../../../diagnostic/types/message.types.tz";
import { FunctionDecl } from "../../../program/ast/types/ast.types.functions.tz";
import { kGlobalNames } from "../../../program/library/global-names/const/global-names.const.tz";
import { kLibrary } from "../../../program/library/library-modules/const/library-modules.const.tz";
import { ModuleNames } from "../../../program/module-names/types/module-names.types.tz";
import { Module } from "../../../program/module/types/module.types.tz";
import {
  ModuleScopes,
  NameSymbol,
  NameUse,
  SymbolKind,
} from "../../../program/scopes/types/scopes.types.tz";
import { SourceLines } from "../../../program/source-lines/source-lines.tz";
import { GlobalScope } from "../name-resolver/types/name-resolver.types.tz";
import { ScopeStack } from "../scope-stack/scope-stack.tz";
import { kHiddenPrefix, kNamePoint } from "./const/scope-traversal.const.tz";
import {
  CapturePlace,
  ClassFrame,
  JumpTarget,
} from "./types/scope-traversal.types.tz";

export class ScopeTraversal {
  private readonly module: Module;
  private readonly names: ModuleNames;
  private readonly globals: GlobalScope;
  private readonly partMethods: FunctionDecl[];
  private readonly scopes: ScopeStack;
  private readonly uses: NameUse[];
  private readonly errors: SourceError[];
  private readonly otherCaseVariables: Set<int>;
  private readonly classFrames: ClassFrame[];
  private jumpTargets: JumpTarget[];
  private pendingLabels: string[];
  private defaultOf: string;
  private genericFunctions: int;
  private readonly memberUses: Map<string, string[]>;

  public constructor(
    names: ModuleNames,
    globals: GlobalScope,
    partMethods: FunctionDecl[],
  ) {
    this.module = names.module;
    this.names = names;
    this.globals = globals;
    this.partMethods = partMethods;
    this.scopes = new ScopeStack();
    this.uses = [];
    this.errors = [];
    this.otherCaseVariables = new Set<int>();
    this.classFrames = [];
    this.jumpTargets = [];
    this.pendingLabels = [];
    this.defaultOf = "";
    this.genericFunctions = 0;
    this.memberUses = new Map<string, string[]>();
  }

  public run(): ModuleScopes {
    const items = this.module.file.items;

    this.scopes.open();
    this.declareImports();
    this.declareStatements(items);
    this.declareClasses(this.module.declared);
    this.traverseStatements(items);

    for (const one of this.module.declared) {
      this.traverseDeclaredClass(one);
    }

    for (const part of this.module.parts) {
      this.traverseClass(part, false);
    }

    this.scopes.close();
    this.wholeImportsCheck();
    this.errors.sort((first, second) => first.loc - second.loc);

    return { module: this.module, uses: this.uses, errors: this.errors };
  }

  private useValue(
    name: string,
    loc: int,
    missing: Code = Code.NameNotFound,
  ): void {
    if (kGlobalNames.isUnbound(name)) {
      return;
    }

    const entry = this.scopes.findValue(name);
    if (entry != undefined) {
      if (!this.scopes.isReadable(entry)) {
        this.reportEarlyUse(entry.symbol, loc);
      }
      if (this.otherCaseVariables.has(entry.symbol.loc)) {
        this.report(loc, Code.OtherCaseVariable, { word: name });
      }

      this.noteUse({ loc, name, isType: false, symbol: entry.symbol });
      this.captureCheck(entry.symbol, entry.depth, loc);

      return;
    }
    if (this.globals.values.has(name) || kGlobalNames.hasValue(name)) {
      this.noteUse({ loc, name, isType: false });

      return;
    }

    this.reportMissingValue(name, loc, missing);
  }

  private captureCheck(symbol: NameSymbol, depth: int, loc: int): void {
    const frame = this.classFrames[this.classFrames.length - 1];
    if (frame == undefined || frame.place == CapturePlace.None) {
      return;
    }

    const isLocal =
      symbol.kind == SymbolKind.Variable || symbol.kind == SymbolKind.Parameter;
    const isOuter = depth > 0 && depth <= frame.outer;
    if (!isLocal || !isOuter) {
      return;
    }

    const word = symbol.name;
    if (frame.place == CapturePlace.StaticInit) {
      return this.report(loc, Code.ClassExprStaticCapture, { word });
    }

    this.report(loc, Code.ClassExprLaterCapture, { word });
  }

  private reportEarlyUse(symbol: NameSymbol, loc: int): void {
    const parameter = this.defaultOf;
    const name = symbol.name;

    if (parameter != "" && symbol.kind == SymbolKind.Parameter) {
      this.report(loc, Code.DefaultUsesLaterParameter, {
        word: parameter,
        other: name,
      });

      return;
    }

    this.report(loc, Code.UsedBeforeDeclaration, { word: name });
  }

  private useType(
    name: string,
    loc: int,
    missing: Code = Code.TypeNotFound,
  ): void {
    const point = name.indexOf(kNamePoint);
    const first = this.firstPart(name, point);
    if (kGlobalNames.isUnbound(first)) {
      return;
    }

    const entry = this.scopes.findType(first);
    if (entry != undefined) {
      this.noteUse({ loc, name, isType: true, symbol: entry.symbol });

      return;
    }
    if (this.globals.types.has(first) || kGlobalNames.hasType(first)) {
      this.noteUse({ loc, name, isType: true });

      return;
    }
    if (point >= 0 && this.ownsType(first, name.slice(point + 1))) {
      this.noteUse({ loc, name, isType: true });

      return;
    }

    this.reportMissingType(name, loc, missing);
  }

  private ownsType(owner: string, member: string): boolean {
    const declared = this.globals.namespaces.get(owner);
    if (declared != undefined) {
      return declared.has(member) || kLibrary.hasMember(owner, member);
    }

    return this.ownsNames(owner);
  }

  private isValueName(name: string): boolean {
    const typed = this.scopes.findType(name) != undefined;
    const valued = this.scopes.findValue(name) != undefined;

    return valued && !typed;
  }

  private firstPart(name: string, point: int): string {
    if (point < 0) {
      return name;
    }

    return name.slice(0, point);
  }

  private ownsNames(owner: string): boolean {
    return (
      this.scopes.findValue(owner) != undefined ||
      this.globals.values.has(owner) ||
      kGlobalNames.hasValue(owner)
    );
  }

  private noteUse(use: NameUse): void {
    if (!use.name.startsWith(kHiddenPrefix)) {
      this.uses.push(use);
    }
  }

  private report(loc: int, code: Code, details: Details): void {
    this.errors.push({ code, loc, details });
  }

  private lineOf(loc: int): string {
    const lines = new SourceLines(this.module.source.text);
    const place = lines.placeOf(loc);

    return `${place.line}`;
  }
}
