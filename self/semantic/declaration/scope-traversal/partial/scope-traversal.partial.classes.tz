import { replace } from "tz:mem";
import { ScopeTraversal } from "../scope-traversal.tz";
import { Code } from "../../../../diagnostic/code.tz";
import {
  ClassDecl,
  Decorator,
  FieldKind,
  MethodKind,
} from "../../../../program/ast/types/ast.types.classes.tz";
import {
  DeclaredClass,
  DeclaredMember,
  DeclaredMemberKind,
} from "../../../../program/ast/types/ast.types.declarations.tz";
import {
  FunctionDecl,
  Param,
  ParamKind,
} from "../../../../program/ast/types/ast.types.functions.tz";
import { TypeRef } from "../../../../program/ast/types/ast.types.types.tz";
import {
  CapturePlace,
  NameSymbol,
  SymbolKind,
} from "../../../../program/scopes/types/scopes.types.tz";
import { ClassFrame } from "../types/scope-traversal.types.tz";
import { Program } from "../../../../program/module/types/module.types.tz";

partial class ScopeTraversal {
  private traverseFunction(program: Read<Program>, fn: FunctionDecl): void {
    const tree = program.tree;

    this.traverseDecorators(
      program,
      tree.decoratorsOf(fn.role?.decoratorsList) ?? [],
    );

    this.scopes.open();
    this.scopes.enterFunction();
    this.genericFunctions += this.genericMark(
      tree.typeParamsOf(fn.typeParamsList).length,
    );

    this.declareOwnName(fn);
    const typeParams = tree.typeParamsOf(fn.typeParamsList);

    this.declareTypeParams(program, typeParams);

    for (const param of tree.paramsOf(fn.paramsList)) {
      this.declareValue(
        program,
        { name: param.name, kind: SymbolKind.Parameter, loc: param.loc },
        false,
      );
    }

    for (const param of tree.paramsOf(fn.paramsList)) {
      this.traverseParam(program, param);
    }

    const returnType = tree.typeRefAt(fn.returnTypeId);

    this.traverseOptionalType(program, returnType);

    const body = tree.blockAt(fn.bodyId);
    const targets = replace(this.jumpTargets, []);

    if (body != undefined) {
      const bodyItem = tree.stmtsOf(body.bodyList);

      this.declareStatements(program, bodyItem);
      const bodyBody = tree.stmtsOf(body.bodyList);

      this.traverseStatements(program, bodyBody);
    }

    this.jumpTargets = targets;
    this.genericFunctions -= this.genericMark(
      tree.typeParamsOf(fn.typeParamsList).length,
    );
    this.scopes.leaveFunction();
    this.scopes.close();
  }

  private readonly genericMark(count: int): int {
    if (count > 0) {
      return 1;
    }

    return 0;
  }

  private declareOwnName(fn: FunctionDecl): void {
    const name = fn.ownName;
    if (name != "") {
      this.scopes.declareValue(
        { name, kind: SymbolKind.Function, loc: fn.loc },
        true,
      );
    }
  }

  private traverseParam(program: Read<Program>, param: Param): void {
    const tree = program.tree;

    const form = param.form;

    const decorators = tree.decoratorsOf(param.decoratorsList);

    this.traverseDecorators(program, decorators);
    const typeRef = tree.typeRefAt(param.typeId);

    this.traverseOptionalType(program, typeRef);

    if (form.kind == ParamKind.Defaulted) {
      this.defaultOf = param.name;
      const defaultValue = tree.exprOf(form.defaultValueId);

      this.traverseExpr(program, defaultValue);
      this.defaultOf = "";
    }

    this.scopes.markLive(param.name);
  }

  private traverseDecorators(
    program: Read<Program>,
    decorators: Read<Decorator[]>,
  ): void {
    const tree = program.tree;

    for (const decorator of decorators) {
      const expr = tree.exprOf(decorator.exprId);

      this.traverseExpr(program, expr);
    }
  }

  private traverseClass(
    program: Read<Program>,
    decl: ClassDecl,
    isExpression: boolean,
  ): void {
    const tree = program.tree;

    const decorators = tree.decoratorsOf(decl.decoratorsList);

    this.traverseDecorators(program, decorators);

    const frame = this.classFrameOf(isExpression);

    this.scopes.open();
    this.scopes.enterFunction();

    this.declareExpressionName(decl);

    const methods = this.ownMethods(program, decl);

    this.scopes.open();
    const typeParams = tree.typeParamsOf(decl.typeParamsList);

    this.declareTypeParams(program, typeParams);
    this.traverseBase(program, tree.typeRefAt(decl.baseId), decl.name ?? "");
    const baseExpr = tree.exprAt(decl.baseExprId);

    this.traverseOptionalExpr(program, baseExpr);
    const baseArgs = tree.typeRefsOf(decl.baseArgsList);

    this.traverseTypes(program, baseArgs);
    const interfaces = tree.typeRefsOf(decl.interfacesList);

    this.traverseTypes(program, interfaces);

    const outer = frame.outer;

    this.classFrames.push(frame);

    for (const field of tree.fieldsOf(decl.fieldsList)) {
      const place = this.fieldPlace(outer, field.form);

      const decoratorsItem = tree.decoratorsOf(field.decoratorsList);

      this.traverseDecorators(program, decoratorsItem);
      const typeRef = tree.typeRefAt(field.typeId);

      this.traverseOptionalType(program, typeRef);
      this.setClassPlace(place);
      const init = tree.exprAt(field.initId);

      this.traverseOptionalExpr(program, init);
    }

    const body = this.bodyPlace(outer);

    this.setClassPlace(body);

    for (const made of tree.functionsOf(decl.constructorsList)) {
      this.traverseFunction(program, made);
    }

    for (const method of methods) {
      if (!this.isStatic(method)) {
        this.traverseFunction(program, method);
      }
    }

    this.scopes.close();

    for (const method of methods) {
      if (this.isStatic(method)) {
        this.traverseFunction(program, method);
      }
    }

    this.classFrames.pop();
    this.scopes.leaveFunction();
    this.scopes.close();
  }

  private readonly classFrameOf(isExpression: boolean): ClassFrame {
    const outer = this.scopes.currentDepth();
    const isGeneric = this.genericFunctions > 0;
    if (!isExpression || outer == 0) {
      return { outer: 0, place: CapturePlace.None, isGeneric };
    }

    return { outer, place: CapturePlace.None, isGeneric };
  }

  private setClassPlace(place: CapturePlace): void {
    const frame = this.classFrames[this.classFrames.length - 1];
    if (frame != undefined) {
      frame.place = place;
    }
  }

  private readonly fieldPlace(outer: int, form: FieldKind): CapturePlace {
    if (outer == 0) {
      return CapturePlace.None;
    }
    if (form == FieldKind.Static) {
      return CapturePlace.StaticInit;
    }

    return CapturePlace.Later;
  }

  private readonly bodyPlace(outer: int): CapturePlace {
    if (outer == 0) {
      return CapturePlace.None;
    }

    return CapturePlace.Later;
  }

  private readonly ownMethods(
    program: Read<Program>,
    decl: ClassDecl,
  ): FunctionDecl[] {
    const tree = program.tree;

    if (decl.isPartial) {
      return tree.functionsOf(decl.methodsList).slice();
    }

    return tree
      .functionsOf(decl.methodsList)
      .filter((method) => !this.partMethods.some((one) => one.id == method.id));
  }

  private readonly isStatic(method: FunctionDecl): boolean {
    return method.role?.method == MethodKind.Static;
  }

  private traverseDeclaredClass(
    program: Read<Program>,
    decl: DeclaredClass,
  ): void {
    const tree = program.tree;

    this.scopes.open();
    this.scopes.enterFunction();

    const typeParams = tree.typeParamsOf(decl.typeParamsList);

    this.declareTypeParams(program, typeParams);
    const base = tree.typeRefAt(decl.baseId);

    this.traverseBase(program, base, decl.name);
    const implemented = tree.typeRefsOf(decl.implementedList);

    this.traverseTypes(program, implemented);

    for (const member of tree.declaredMembersOf(decl.membersList)) {
      this.traverseDeclaredMember(program, member);
    }

    this.scopes.leaveFunction();
    this.scopes.close();
  }

  private traverseDeclaredMember(
    program: Read<Program>,
    member: DeclaredMember,
  ): void {
    const tree = program.tree;

    const form = member.form;

    this.scopes.open();
    if (form.kind != DeclaredMemberKind.Field) {
      const typeParams = tree.typeParamsOf(form.typeParamsList);

      this.declareTypeParams(program, typeParams);

      for (const param of tree.paramsOf(form.paramsList)) {
        const typeRef = tree.typeRefAt(param.typeId);

        this.traverseOptionalType(program, typeRef);
      }
    }

    const memberType = tree.typeRefAt(member.typeId);

    this.traverseOptionalType(program, memberType);
    this.scopes.close();
  }

  private traverseBase(
    program: Read<Program>,
    base: TypeRef | undefined,
    owner: string,
  ): void {
    const tree = program.tree;

    if (base == undefined) {
      return;
    }
    if (this.isErrorClassBase(base.name)) {
      return this.report(base.loc, Code.ErrorClassBase, {
        word: base.name,
        first: owner,
      });
    }
    if (this.isValueName(base.name)) {
      this.useValue(base.name, base.loc);

      const args = tree.typeRefsOf(base.argsList);

      return this.traverseTypes(program, args);
    }

    this.useType(base.name, base.loc, Code.ClassNotFound);
    const argsItem = tree.typeRefsOf(base.argsList);

    this.traverseTypes(program, argsItem);
  }

  private declareExpressionName(decl: ClassDecl): void {
    const name = decl.name ?? "";
    if (!decl.expression || name == "") {
      return;
    }

    const symbol: NameSymbol = {
      name,
      kind: SymbolKind.Class,
      loc: decl.loc,
    };

    this.scopes.declareValue(symbol, true);
    this.scopes.declareType(symbol);
  }
}
