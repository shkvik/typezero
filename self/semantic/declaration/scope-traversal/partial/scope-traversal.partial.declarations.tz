import { ScopeTraversal } from "../scope-traversal.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { DeclaredClass } from "../../../../program/ast/types/ast.types.declarations.tz";
import { FunctionDecl } from "../../../../program/ast/types/ast.types.functions.tz";
import { ImportDecl } from "../../../../program/ast/types/ast.types.modules.tz";
import {
  Stmt,
  StmtKind,
} from "../../../../program/ast/types/ast.types.statements.tz";
import { TypeParamDecl } from "../../../../program/ast/types/ast.types.types.tz";
import {
  NameSymbol,
  SymbolKind,
} from "../../../../program/scopes/types/scopes.types.tz";
import { Program } from "../../../../program/module/types/module.types.tz";

partial class ScopeTraversal {
  private declareImports(program: Read<Program>): void {
    const tree = program.tree;

    for (const decl of tree.importsOf(
      program.modules[this.module]?.file.importsList,
    )) {
      this.declareImport(program, decl);
    }

    for (const decl of tree.importsOf(
      program.modules[this.module]?.implicitList,
    )) {
      this.declareImport(program, decl);
    }
  }

  private declareImport(program: Read<Program>, decl: ImportDecl): void {
    const tree = program.tree;

    for (const name of tree.namesOf(decl.namesList)) {
      const bound = this.names.imports.get(name.as);

      this.declareImported({
        name: name.as,
        kind: SymbolKind.Import,
        loc: name.asLoc,
        target: bound?.target,
      });
    }

    const whole = decl.whole;
    if (whole != undefined) {
      this.declareImported({
        name: whole.name,
        kind: SymbolKind.Import,
        loc: whole.loc,
      });
    }
  }

  private declareImported(symbol: NameSymbol): void {
    this.scopes.declareValue(symbol, true);
    this.scopes.declareType(symbol);
  }

  private declareStatements(
    program: Read<Program>,
    statements: Read<Stmt[]>,
  ): void {
    for (const statement of statements) {
      this.declareStatement(program, statement);
    }
  }

  private declareStatement(program: Read<Program>, statement: Stmt): void {
    const tree = program.tree;

    const loc = statement.loc;

    switch (statement.kind) {
      case StmtKind.VarDecl:
        for (const decl of tree.declaratorsOf(statement.declsList)) {
          this.declareValue(
            program,
            { name: decl.name, kind: SymbolKind.Variable, loc: decl.loc },
            false,
          );
        }
        break;
      case StmtKind.Function:
        this.declareFunction(program, statement);
        break;
      case StmtKind.Class:
        this.declareBoth(program, {
          name: statement.name ?? "",
          kind: SymbolKind.Class,
          loc,
        });
        break;
      case StmtKind.Enum:
        this.declareBoth(program, {
          name: statement.name,
          kind: SymbolKind.Enum,
          loc,
        });
        break;
      case StmtKind.TypeAlias:
        this.declareType(program, {
          name: statement.name,
          kind: SymbolKind.TypeAlias,
          loc,
        });
        break;
      case StmtKind.Handle:
        this.declareBoth(program, {
          name: statement.name,
          kind: SymbolKind.Handle,
          loc,
        });
        break;
      default:
        break;
    }
  }

  private declareFunction(program: Read<Program>, fn: FunctionDecl): void {
    const tree = program.tree;

    const name = fn.name;
    const previous = this.scopes.declaredValue(name)?.symbol;
    const anotherSignature =
      tree.blockAt(fn.bodyId) == undefined &&
      previous?.kind == SymbolKind.Function;
    if (!anotherSignature) {
      this.declareValue(
        program,
        { name, kind: SymbolKind.Function, loc: fn.loc },
        true,
      );
    }
  }

  private declareClasses(
    program: Read<Program>,
    classes: Read<DeclaredClass[]>,
  ): void {
    for (const one of classes) {
      this.declareBoth(program, {
        name: one.name,
        kind: SymbolKind.Class,
        loc: one.loc,
      });
    }
  }

  private declareBoth(program: Read<Program>, symbol: NameSymbol): void {
    if (this.declareValue(program, symbol, true)) {
      this.declareType(program, symbol);
    }
  }

  private declareValue(
    program: Read<Program>,
    symbol: NameSymbol,
    live: boolean,
  ): boolean {
    const name = symbol.name;
    if (name == "") {
      return false;
    }

    const previous = this.scopes.declaredValue(name)?.symbol;
    if (previous == undefined || previous.kind == SymbolKind.Import) {
      this.scopes.declareValue(symbol, live);

      return true;
    }

    const code = this.duplicateCode(symbol, previous);
    const other = this.lineOf(program, previous.loc);

    this.report(symbol.loc, code, { word: name, other });

    return false;
  }

  private readonly duplicateCode(
    symbol: NameSymbol,
    previous: NameSymbol,
  ): Code {
    const functions =
      symbol.kind == SymbolKind.Function &&
      previous.kind == SymbolKind.Function;
    if (functions) {
      return Code.DuplicateFunction;
    }

    return Code.DuplicateDeclaration;
  }

  private declareType(program: Read<Program>, symbol: NameSymbol): void {
    const name = symbol.name;
    const previous = this.scopes.declaredType(name)?.symbol;
    if (previous == undefined || previous.kind == SymbolKind.Import) {
      this.scopes.declareType(symbol);

      return;
    }

    const other = this.lineOf(program, previous.loc);

    this.report(symbol.loc, Code.DuplicateType, { word: name, other });
  }

  private declareTypeParams(
    program: Read<Program>,
    params: Read<TypeParamDecl[]>,
  ): void {
    const tree = program.tree;

    for (const param of params) {
      const name = param.name;
      const loc = param.loc;

      if (this.scopes.declaredType(name) != undefined) {
        this.report(loc, Code.DuplicateTypeParameter, { word: name });
      } else {
        this.scopes.declareType({
          name,
          kind: SymbolKind.TypeParameter,
          loc,
          constraint: tree.typeRefAt(param.constraintId),
        });
      }
    }

    for (const param of params) {
      const constraintRef = tree.typeRefAt(param.constraintId);

      this.traverseOptionalType(program, constraintRef);
      const defaultType = tree.typeRefAt(param.defaultTypeId);

      this.traverseOptionalType(program, defaultType);
    }
  }
}
