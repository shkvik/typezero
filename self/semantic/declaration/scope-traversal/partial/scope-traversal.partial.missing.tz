import { ScopeTraversal } from "../scope-traversal.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { kGlobalNames } from "../../../../program/library/global-names/const/global-names.const.tz";
import {
  AbsentName,
  AbsentReason,
} from "../../../../program/library/global-names/types/global-names.types.tz";

partial class ScopeTraversal {
  private reportMissingValue(name: string, loc: int, missing: Code): void {
    const absent = kGlobalNames.absent(name);
    const isMade = missing == Code.ClassNotFound;
    if (absent != undefined && absent.asValue && this.isHinted(absent)) {
      return this.reportAbsent(absent, loc, isMade);
    }
    if (this.isTypeName(name) && this.isResultHalfName(name)) {
      return this.resultHalfReport(name, loc);
    }
    if (this.isTypeName(name)) {
      return this.report(loc, Code.TypeAsValue, { word: name });
    }

    this.report(loc, missing, { word: name });
  }

  private isResultHalfName(name: string): boolean {
    const isHalf = name == "Ok" || name == "Err";

    return isHalf && this.scopes.findType(name) == undefined;
  }

  private resultHalfReport(name: string, loc: int): void {
    if (name == "Ok") {
      return this.report(loc, Code.ResultHalfAsValue, {
        word: name,
        other: "ok(value)",
        first: "isOk()",
      });
    }

    this.report(loc, Code.ResultHalfAsValue, {
      word: name,
      other: "err(error)",
      first: "isErr()",
    });
  }

  private reportMissingType(name: string, loc: int, missing: Code): void {
    const absent = kGlobalNames.absent(name);
    if (absent != undefined && absent.asType && this.isHinted(absent)) {
      return this.reportAbsent(absent, loc, false);
    }

    this.report(loc, missing, { word: name });
  }

  private reportAbsent(absent: AbsentName, loc: int, isMade: boolean): void {
    const code = this.absentCode(absent.reason);
    const word = this.absentWord(absent, isMade);

    this.report(loc, code, { word, other: absent.instead ?? "" });
  }

  private isHinted(absent: AbsentName): boolean {
    return absent.reason != AbsentReason.ErrorClass;
  }

  private absentWord(absent: AbsentName, isMade: boolean): string {
    const isCode =
      absent.reason == AbsentReason.CodeFromString ||
      absent.reason == AbsentReason.Proxy;
    if (isMade && isCode) {
      return `new ${absent.name}`;
    }

    return absent.name;
  }

  private isErrorClassBase(name: string): boolean {
    const absent = kGlobalNames.absent(name);
    if (absent == undefined || absent.reason != AbsentReason.ErrorClass) {
      return false;
    }

    return !this.isTypeName(name);
  }

  private isTypeName(name: string): boolean {
    const entry = this.scopes.findType(name);

    return (
      entry != undefined ||
      this.globals.types.has(name) ||
      kGlobalNames.hasType(name)
    );
  }

  private absentCode(reason: AbsentReason): Code {
    switch (reason) {
      case AbsentReason.CodeFromString:
        return Code.NoCodeFromString;
      case AbsentReason.Proxy:
        return Code.NoProxy;
      case AbsentReason.Require:
        return Code.NoRequire;
      case AbsentReason.Long:
        return Code.NoLong;
      case AbsentReason.BigintType:
        return Code.NoBigintType;
      case AbsentReason.Bigint:
        return Code.NoBigint;
      case AbsentReason.SharedBuffer:
        return Code.NoSharedBuffer;
      default:
        return Code.NoWeakCollection;
    }
  }
}
