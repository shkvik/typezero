import { ScopeTraversal } from "../scope-traversal.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { kGlobalNames } from "../../../../program/library/global-names/const/global-names.const.tz";
import {
  AbsentName,
  AbsentReason,
} from "../../../../program/library/global-names/types/global-names.types.tz";

partial class ScopeTraversal {
  private reportMissingValue(name: string, loc: int, missing: Code): void {
    const absent = kGlobalNames.absent(name);
    if (absent != undefined && absent.asValue) {
      return this.reportAbsent(absent, loc);
    }
    if (this.isTypeName(name)) {
      return this.report(loc, Code.TypeAsValue, { word: name });
    }

    this.report(loc, missing, { word: name });
  }

  private reportMissingType(name: string, loc: int, missing: Code): void {
    const absent = kGlobalNames.absent(name);
    if (absent != undefined && absent.asType) {
      return this.reportAbsent(absent, loc);
    }

    this.report(loc, missing, { word: name });
  }

  private reportAbsent(absent: AbsentName, loc: int): void {
    const code = this.absentCode(absent.reason);

    this.report(loc, code, { word: absent.name, other: absent.instead });
  }

  private isErrorClassBase(name: string): boolean {
    const absent = kGlobalNames.absent(name);
    if (absent == undefined || absent.reason != AbsentReason.ErrorClass) {
      return false;
    }

    return !this.isTypeName(name);
  }

  private isTypeName(name: string): boolean {
    const entry = this.scopes.findType(name);

    return (
      entry != undefined ||
      this.globals.types.has(name) ||
      kGlobalNames.hasType(name)
    );
  }

  private absentCode(reason: AbsentReason): Code {
    switch (reason) {
      case AbsentReason.ErrorClass:
        return Code.NoErrorClass;
      case AbsentReason.CodeFromString:
        return Code.NoCodeFromString;
      case AbsentReason.Proxy:
        return Code.NoProxy;
      case AbsentReason.Require:
        return Code.NoRequire;
      case AbsentReason.Long:
        return Code.NoLong;
      case AbsentReason.BigintType:
        return Code.NoBigintType;
      case AbsentReason.Bigint:
        return Code.NoBigint;
      case AbsentReason.SharedBuffer:
        return Code.NoSharedBuffer;
      default:
        return Code.NoWeakCollection;
    }
  }
}
