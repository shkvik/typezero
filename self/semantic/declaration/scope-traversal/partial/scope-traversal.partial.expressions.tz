import { ScopeTraversal } from "../scope-traversal.tz";
import { Code } from "../../../../diagnostic/code.tz";
import {
  CallArgument,
  Expr,
  ExprKind,
  NewExpr,
  NewKind,
  ObjectLitExpr,
  PropertyKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { Program } from "../../../../program/module/types/module.types.tz";

partial class ScopeTraversal {
  private traverseOptionalExpr(
    program: Read<Program>,
    expr: Expr | undefined,
  ): void {
    if (expr != undefined) {
      this.traverseExpr(program, expr);
    }
  }

  private traverseExprs(program: Read<Program>, exprs: Read<Expr[]>): void {
    for (const expr of exprs) {
      this.traverseExpr(program, expr);
    }
  }

  private traverseExpr(program: Read<Program>, expr: Expr): void {
    const tree = program.tree;

    switch (expr.kind) {
      case ExprKind.Name:
        this.useValue(expr.name, expr.loc);

        const typeArgs = tree.typeRefsOf(expr.typeArgsList);

        return this.traverseTypes(program, typeArgs);
      case ExprKind.Member:
        const object = tree.exprOf(expr.objectId);

        this.noteMemberUse(object, expr.name);
        const objectExpr = tree.exprOf(expr.objectId);

        this.traverseExpr(program, objectExpr);

        const typeArgsItem = tree.typeRefsOf(expr.typeArgsList);

        return this.traverseTypes(program, typeArgsItem);
      case ExprKind.Index:
        const exprObject = tree.exprOf(expr.objectId);

        this.traverseExpr(program, exprObject);

        const index = tree.exprOf(expr.indexId);

        return this.traverseExpr(program, index);
      case ExprKind.Unary:
        const operand = tree.exprOf(expr.operandId);

        return this.traverseExpr(program, operand);
      case ExprKind.Binary:
        const lhs = tree.exprOf(expr.lhsId);

        this.traverseExpr(program, lhs);

        const rhs = tree.exprOf(expr.rhsId);

        return this.traverseExpr(program, rhs);
      case ExprKind.Assign:
        const target = tree.exprOf(expr.targetId);

        this.traverseExpr(program, target);

        const value = tree.exprOf(expr.valueId);

        return this.traverseExpr(program, value);
      case ExprKind.Update:
        const targetExpr = tree.exprOf(expr.targetId);

        return this.traverseExpr(program, targetExpr);
      case ExprKind.Call:
        const callee = tree.exprOf(expr.calleeId);

        this.traverseExpr(program, callee);

        const args = tree.argumentsOf(expr.argsList);

        return this.traverseArguments(program, args);
      case ExprKind.New:
        return this.traverseNew(program, expr);
      case ExprKind.Conditional:
        const cond = tree.exprOf(expr.condId);

        this.traverseExpr(program, cond);
        const thenExpr = tree.exprOf(expr.thenExprId);

        this.traverseExpr(program, thenExpr);

        const elseExpr = tree.exprOf(expr.elseExprId);

        return this.traverseExpr(program, elseExpr);
      case ExprKind.Cast:
        const operandExpr = tree.exprOf(expr.operandId);

        this.traverseExpr(program, operandExpr);

        const targetRef = tree.typeRefOf(expr.targetId);

        return this.traverseType(program, targetRef);
      case ExprKind.Sequence:
        const exprs = tree.exprsOf(expr.exprsList);

        return this.traverseExprs(program, exprs);
      case ExprKind.OptionalChain:
        const chain = tree.exprOf(expr.chainId);

        return this.traverseExpr(program, chain);
      case ExprKind.Function:
        const fn = tree.functionOf(expr.fnId);

        return this.traverseFunction(program, fn);
      case ExprKind.Yield:
        const valueExpr = tree.exprAt(expr.valueId);

        return this.traverseOptionalExpr(program, valueExpr);
      case ExprKind.Await:
        const exprValue = tree.exprOf(expr.valueId);

        return this.traverseExpr(program, exprValue);
      case ExprKind.Class:
        const decl = tree.classOf(expr.declId);

        return this.traverseClass(program, decl, true);
      case ExprKind.Template:
        const exprsItem = tree.exprsOf(expr.exprsList);

        return this.traverseExprs(program, exprsItem);
      case ExprKind.ArrayLit:
        for (const element of tree.elementsOf(expr.elementsList)) {
          const exprExpr = tree.exprOf(element.exprId);

          this.traverseExpr(program, exprExpr);
        }

        return;
      case ExprKind.ObjectLit:
        return this.traverseObject(program, expr);
      default:
        return;
    }
  }

  private traverseArguments(
    program: Read<Program>,
    args: Read<CallArgument[]>,
  ): void {
    const tree = program.tree;

    for (const argument of args) {
      const expr = tree.exprOf(argument.exprId);

      this.traverseExpr(program, expr);
    }
  }

  private traverseNew(program: Read<Program>, expr: NewExpr): void {
    const tree = program.tree;

    const form = expr.form;
    if (form.kind == NewKind.Named) {
      this.useValue(form.name, expr.loc, Code.ClassNotFound);
    } else {
      const callee = tree.exprOf(form.calleeId);

      this.traverseExpr(program, callee);
    }

    const typeArgs = tree.typeRefsOf(expr.typeArgsList);

    this.traverseTypes(program, typeArgs);
    const args = tree.argumentsOf(expr.argsList);

    this.traverseArguments(program, args);
  }

  private traverseObject(program: Read<Program>, expr: ObjectLitExpr): void {
    const tree = program.tree;

    for (const property of tree.propertiesOf(expr.propsList)) {
      const form = property.form;
      const value = tree.exprOf(property.valueId);

      if (form.kind == PropertyKind.Computed) {
        const key = tree.exprOf(form.keyId);

        this.traverseExpr(program, key);
      }
      if (
        form.kind == PropertyKind.Defaulted &&
        value.kind == ExprKind.Assign
      ) {
        const valueExpr = tree.exprOf(value.valueId);

        this.traverseExpr(program, valueExpr);

        continue;
      }

      this.traverseExpr(program, value);
    }
  }
}
