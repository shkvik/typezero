import { ScopeTraversal } from "../scope-traversal.tz";
import {
  ObjectTypeField,
  TypeRefKind,
  TypeRef,
} from "../../../../program/ast/types/ast.types.types.tz";
import { SymbolKind } from "../../../../program/scopes/types/scopes.types.tz";
import { Program } from "../../../../program/module/types/module.types.tz";

partial class ScopeTraversal {
  private traverseOptionalType(
    program: Read<Program>,
    ref: TypeRef | undefined,
  ): void {
    if (ref != undefined) {
      this.traverseType(program, ref);
    }
  }

  private traverseTypes(program: Read<Program>, refs: Read<TypeRef[]>): void {
    for (const ref of refs) {
      this.traverseType(program, ref);
    }
  }

  private traverseType(program: Read<Program>, ref: TypeRef): void {
    const tree = program.tree;

    const form = ref.form;

    switch (form.kind) {
      case TypeRefKind.Name:
      case TypeRefKind.Generic:
        this.useType(ref.name, ref.loc);

        const args = tree.typeRefsOf(ref.argsList);

        return this.traverseTypes(program, args);
      case TypeRefKind.TypeOf:
        return this.useValue(tree.textsOf(form.namesList)[0] ?? "", ref.loc);
      case TypeRefKind.Mapped:
        return this.traverseMapped(program, ref);
      case TypeRefKind.Conditional:
        return this.traverseConditional(program, ref);
      case TypeRefKind.Object:
        return this.traverseObjectType(
          program,
          tree.objectFieldsOf(form.fieldsList),
        );
      default:
        return this.traverseTypes(program, this.childTypes(program, ref));
    }
  }

  private traverseObjectType(
    program: Read<Program>,
    fields: Read<ObjectTypeField[]>,
  ): void {
    const tree = program.tree;

    for (const field of fields) {
      this.scopes.open();
      const typeParams = tree.typeParamsOf(field.typeParamsList);

      this.declareTypeParams(program, typeParams);
      const typeRef = tree.typeRefOf(field.typeId);

      this.traverseType(program, typeRef);
      this.scopes.close();
    }
  }

  private traverseMapped(program: Read<Program>, ref: TypeRef): void {
    const tree = program.tree;

    this.scopes.open();
    this.scopes.declareType({
      name: ref.name,
      kind: SymbolKind.TypeParameter,
      loc: ref.loc,
    });
    const args = tree.typeRefsOf(ref.argsList);

    this.traverseTypes(program, args);
    this.scopes.close();
  }

  private traverseConditional(program: Read<Program>, ref: TypeRef): void {
    const tree = program.tree;

    this.scopes.open();

    const extended = tree.typeRefsOf(ref.argsList)[1];
    if (extended != undefined) {
      this.declareInferred(program, extended);
    }

    const args = tree.typeRefsOf(ref.argsList);

    this.traverseTypes(program, args);
    this.scopes.close();
  }

  private declareInferred(program: Read<Program>, ref: TypeRef): void {
    if (ref.form.kind == TypeRefKind.Infer) {
      this.scopes.declareType({
        name: ref.name,
        kind: SymbolKind.TypeParameter,
        loc: ref.loc,
      });
    }

    for (const child of this.childTypes(program, ref)) {
      this.declareInferred(program, child);
    }
  }

  private readonly childTypes(program: Read<Program>, ref: TypeRef): TypeRef[] {
    const tree = program.tree;

    const form = ref.form;
    const children = tree.typeRefsOf(ref.argsList).slice();

    switch (form.kind) {
      case TypeRefKind.Function: {
        for (const param of tree.functionTypeParamsOf(form.paramsList)) {
          const typeRef = tree.typeRefOf(param.typeId);

          children.push(typeRef);
        }

        const result = tree.typeRefAt(form.resultId);
        if (result != undefined) {
          children.push(result);
        }

        return children;
      }
      case TypeRefKind.Object:
        for (const field of tree.objectFieldsOf(form.fieldsList)) {
          const fieldType = tree.typeRefOf(field.typeId);

          children.push(fieldType);
        }

        return children;
      case TypeRefKind.Tuple:
        for (const element of tree.tupleElementsOf(form.elementsList)) {
          const elementType = tree.typeRefOf(element.typeId);

          children.push(elementType);
        }

        return children;
      default:
        return children;
    }
  }
}
