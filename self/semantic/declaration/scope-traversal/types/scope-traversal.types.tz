import { CapturePlace } from "../../../../program/scopes/types/scopes.types.tz";

export enum JumpKind {
  Loop,
  Switch,
  Block,
}

export type ClassFrame = {
  readonly outer: int;
  place: CapturePlace;
  readonly isGeneric: boolean;
};

export type JumpTarget = {
  readonly kind: JumpKind;
  readonly labels: readonly string[];
};

export type KnownModuleRow = {
  readonly path: string;
  readonly isNode: boolean;
  readonly typicalName: string;
};
