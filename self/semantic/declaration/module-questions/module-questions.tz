import { Program } from "../../../program/module/types/module.types.tz";
import { kTypedLibraries } from "./const/module-questions.const.tz";

export class ModuleQuestions {
  private readonly program: Program;

  public constructor(program: Own<Program>) {
    this.program = program;
  }

  public readonly isLibraryModule(module: int): boolean {
    const opened = this.program.modules[module];
    if (module < 0 || opened == undefined) {
      return true;
    }

    return opened.source.isLibrary;
  }

  public readonly isTypedLibrary(module: int): boolean {
    const opened = this.program.modules[module];
    if (opened == undefined || !opened.source.isLibrary) {
      return false;
    }

    return kTypedLibraries.includes(opened.name);
  }
}
