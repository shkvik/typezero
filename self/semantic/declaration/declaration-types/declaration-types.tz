import { replace } from "tz:mem";
import {
  EnumDecl,
  TypeAliasDecl,
} from "../../../program/ast/types/ast.types.classes.tz";
import { FunctionDecl } from "../../../program/ast/types/ast.types.functions.tz";
import { VarDeclarator } from "../../../program/ast/types/ast.types.patterns.tz";
import {
  Stmt,
  StmtKind,
} from "../../../program/ast/types/ast.types.statements.tz";
import {
  DeclarationForm,
  ModuleTypes,
  TypedDeclaration,
} from "../../../program/module-types/types/module-types.types.tz";
import { SourceFile } from "../../../program/ast/types/ast.types.modules.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../code/expression-types/expression-types.tz";
import { TypeSystem } from "../../types/type-system/type-system.tz";
import {
  TypeContext,
  TypePlace,
} from "../../types/type-resolver/types/type-resolver.types.tz";

export class DeclarationTypes {
  private readonly module: int;
  private readonly file: SourceFile;
  private readonly isLibrary: boolean;
  private readonly context: TypeContext;
  private declarations: TypedDeclaration[];

  public constructor(module: int, file: SourceFile, isLibrary: boolean) {
    this.module = module;
    this.file = file;
    this.isLibrary = isLibrary;
    this.context = {
      module: this.module,
      bindings: new Map<int, Type>(),
      place: TypePlace.Plain,
    };
    this.declarations = [];
  }

  public readonly resolveAliases(types: TypeSystem): void {
    const tree = types.program.tree;

    for (const item of tree.stmtsOf(this.file.itemsList)) {
      if (
        item.kind == StmtKind.TypeAlias &&
        tree.typeParamsOf(item.typeParamsList).length == 0
      ) {
        types.declaredAlias(this.module, item);
      }
    }
  }

  public run(expressions: ExpressionTypes): ModuleTypes {
    const tree = expressions.types.program.tree;

    expressions.checkModule(this.module);

    for (const item of tree.stmtsOf(this.file.itemsList)) {
      this.typeItem(item, expressions);
    }

    return {
      module: this.module,
      declarations: replace(this.declarations, []),
    };
  }

  private typeItem(item: Stmt, expressions: ExpressionTypes): void {
    const tree = expressions.types.program.tree;

    switch (item.kind) {
      case StmtKind.VarDecl:
        for (const decl of tree.declaratorsOf(item.declsList)) {
          this.typeVariable(decl, expressions);
        }
        break;
      case StmtKind.Function:
        this.typeFunction(item, expressions);
        break;
      case StmtKind.Class:
        expressions.types.typeParameters(
          this.module,
          tree.typeParamsOf(item.typeParamsList),
        );
        break;
      case StmtKind.TypeAlias:
        expressions.types.typeParameters(
          this.module,
          tree.typeParamsOf(item.typeParamsList),
        );
        this.typeAlias(item, expressions);
        break;
      case StmtKind.Enum:
        this.typeEnum(item, expressions);
        break;
      default:
        break;
    }
  }

  private typeVariable(
    decl: VarDeclarator,
    expressions: ExpressionTypes,
  ): void {
    const tree = expressions.types.program.tree;

    const type = expressions.variable(this.module, decl.loc);
    if (
      tree.typeRefAt(decl.typeAnnId) == undefined &&
      type.kind == TypeKind.Error
    ) {
      return;
    }

    this.declare(DeclarationForm.Value, decl.name, decl.loc, type);
  }

  private typeFunction(fn: FunctionDecl, expressions: ExpressionTypes): void {
    const tree = expressions.types.program.tree;

    const type = expressions.functionTyped(this.module, fn.loc);
    if (type.kind == TypeKind.Error) {
      return;
    }
    if (
      tree.typeRefAt(fn.returnTypeId) == undefined &&
      this.isBroken(type, expressions)
    ) {
      return;
    }

    this.declare(DeclarationForm.Value, fn.name, fn.loc, type);

    if (!this.isLibrary) {
      this.typeLocals(
        tree.stmtsOf(tree.blockAt(fn.bodyId)?.bodyList) ?? [],
        expressions,
      );
    }
  }

  private typeLocals(
    statements: Read<Stmt[]>,
    expressions: ExpressionTypes,
  ): void {
    for (const statement of statements) {
      this.typeLocal(statement, expressions);
    }
  }

  private typeLocal(statement: Stmt, expressions: ExpressionTypes): void {
    const tree = expressions.types.program.tree;

    switch (statement.kind) {
      case StmtKind.VarDecl:
        for (const decl of tree.declaratorsOf(statement.declsList)) {
          this.typeVariable(decl, expressions);
        }
        break;
      case StmtKind.Function:
        this.typeFunction(statement, expressions);
        break;
      case StmtKind.Block:
        const body = tree.stmtsOf(statement.bodyList);

        this.typeLocals(body, expressions);
        break;
      case StmtKind.If:
        const thenStmt = tree.stmtOf(statement.thenStmtId);

        this.typeLocal(thenStmt, expressions);
        const elseStmt = tree.stmtAt(statement.elseStmtId);

        this.typeOptionalLocal(elseStmt, expressions);
        break;
      case StmtKind.While:
      case StmtKind.DoWhile:
      case StmtKind.Labeled:
        const bodyStmt = tree.stmtOf(statement.bodyId);

        this.typeLocal(bodyStmt, expressions);
        break;
      case StmtKind.For:
        const init = tree.stmtAt(statement.initId);

        this.typeOptionalLocal(init, expressions);
        const statementBody = tree.stmtAt(statement.bodyId);

        this.typeOptionalLocal(statementBody, expressions);
        break;
      case StmtKind.ForOf:
        this.typeVariable(statement.binding, expressions);
        this.typeLocal(tree.stmtOf(statement.bodyId), expressions);
        break;
      case StmtKind.Switch:
        for (const option of tree.casesOf(statement.casesList)) {
          const bodyItem = tree.stmtsOf(option.bodyList);

          this.typeLocals(bodyItem, expressions);
        }
        break;
      default:
        break;
    }
  }

  private typeOptionalLocal(
    statement: Stmt | undefined,
    expressions: ExpressionTypes,
  ): void {
    if (statement != undefined) {
      this.typeLocal(statement, expressions);
    }
  }

  private readonly isBroken(
    type: Type,
    expressions: Read<ExpressionTypes>,
  ): boolean {
    if (type.kind != TypeKind.Function) {
      return false;
    }

    const shape = expressions.types.store.functionShapeOf(type);

    return shape.result.kind == TypeKind.Error;
  }

  private typeAlias(decl: TypeAliasDecl, expressions: ExpressionTypes): void {
    const tree = expressions.types.program.tree;

    const type = expressions.types.declaredAlias(this.module, decl);
    const params = tree
      .typeParamsOf(decl.typeParamsList)
      .map((param) => param.name);
    const name = this.genericName(decl.name, params);

    this.declare(DeclarationForm.TypeAlias, name, decl.loc, type);
  }

  private typeEnum(decl: EnumDecl, expressions: ExpressionTypes): void {
    const type = expressions.types.declaredEnum(this.module, decl);

    this.declare(DeclarationForm.Enum, decl.name, decl.loc, type);
  }

  private readonly genericName(name: string, params: Read<string[]>): string {
    if (params.length == 0) {
      return name;
    }

    return `${name}<${params.join(", ")}>`;
  }

  private declare(
    form: DeclarationForm,
    name: string,
    loc: int,
    type: Type,
  ): void {
    this.declarations.push({ form, name, loc, type });
  }
}
