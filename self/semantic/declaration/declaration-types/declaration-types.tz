import {
  EnumDecl,
  TypeAliasDecl,
} from "../../../program/ast/types/ast.types.classes.tz";
import { FunctionDecl } from "../../../program/ast/types/ast.types.functions.tz";
import { VarDeclarator } from "../../../program/ast/types/ast.types.patterns.tz";
import {
  Stmt,
  StmtKind,
} from "../../../program/ast/types/ast.types.statements.tz";
import {
  DeclarationForm,
  ModuleTypes,
  TypedDeclaration,
} from "../../../program/module-types/types/module-types.types.tz";
import { Module } from "../../../program/module/types/module.types.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../code/expression-types/expression-types.tz";
import { TypeResolver } from "../../types/type-resolver/type-resolver.tz";
import {
  TypeContext,
  TypePlace,
} from "../../types/type-resolver/types/type-resolver.types.tz";

export class DeclarationTypes {
  private readonly module: Module;
  private readonly resolver: TypeResolver;
  private readonly expressions: ExpressionTypes;
  private readonly context: TypeContext;
  private readonly declarations: TypedDeclaration[];

  public constructor(
    resolver: TypeResolver,
    expressions: ExpressionTypes,
    module: Module,
  ) {
    this.module = module;
    this.expressions = expressions;
    this.resolver = resolver;
    this.context = {
      module: module.id,
      bindings: new Map<int, Type>(),
      place: TypePlace.Plain,
    };
    this.declarations = [];
  }

  public resolveAliases(): void {
    for (const item of this.module.file.items) {
      if (item.kind == StmtKind.TypeAlias && item.typeParams.length == 0) {
        this.resolver.declaredAlias(this.module.id, item);
      }
    }
  }

  public run(): ModuleTypes {
    this.expressions.checkModule(this.module.id);

    for (const item of this.module.file.items) {
      this.typeItem(item);
    }

    return { module: this.module, declarations: this.declarations };
  }

  private typeItem(item: Stmt): void {
    switch (item.kind) {
      case StmtKind.VarDecl:
        for (const decl of item.decls) {
          this.typeVariable(decl);
        }
        break;
      case StmtKind.Function:
        this.typeFunction(item);
        break;
      case StmtKind.Class:
        this.resolver.typeParameters(this.module.id, item.typeParams);
        break;
      case StmtKind.TypeAlias:
        this.resolver.typeParameters(this.module.id, item.typeParams);
        this.typeAlias(item);
        break;
      case StmtKind.Enum:
        this.typeEnum(item);
        break;
      default:
        break;
    }
  }

  private typeVariable(decl: VarDeclarator): void {
    const type = this.expressions.variable(this.module.id, decl.loc);
    if (decl.typeAnn == undefined && type.kind == TypeKind.Error) {
      return;
    }

    this.declare(DeclarationForm.Value, decl.name, decl.loc, type);
  }

  private typeFunction(fn: FunctionDecl): void {
    const type = this.expressions.functionOf(this.module.id, fn.loc);
    if (type.kind == TypeKind.Error) {
      return;
    }
    if (fn.returnType == undefined && this.isBroken(type)) {
      return;
    }

    this.declare(DeclarationForm.Value, fn.name, fn.loc, type);

    if (!this.module.source.isLibrary) {
      this.typeLocals(fn.body?.body ?? []);
    }
  }

  private typeLocals(statements: Stmt[]): void {
    for (const statement of statements) {
      this.typeLocal(statement);
    }
  }

  private typeLocal(statement: Stmt): void {
    switch (statement.kind) {
      case StmtKind.VarDecl:
        for (const decl of statement.decls) {
          this.typeVariable(decl);
        }
        break;
      case StmtKind.Function:
        this.typeFunction(statement);
        break;
      case StmtKind.Block:
        this.typeLocals(statement.body);
        break;
      case StmtKind.If:
        this.typeLocal(statement.thenStmt);
        this.typeOptionalLocal(statement.elseStmt);
        break;
      case StmtKind.While:
      case StmtKind.DoWhile:
      case StmtKind.Labeled:
        this.typeLocal(statement.body);
        break;
      case StmtKind.For:
        this.typeOptionalLocal(statement.init);
        this.typeOptionalLocal(statement.body);
        break;
      case StmtKind.ForOf:
        this.typeVariable(statement.binding);
        this.typeLocal(statement.body);
        break;
      case StmtKind.Switch:
        for (const option of statement.cases) {
          this.typeLocals(option.body);
        }
        break;
      default:
        break;
    }
  }

  private typeOptionalLocal(statement: Stmt | undefined): void {
    if (statement != undefined) {
      this.typeLocal(statement);
    }
  }

  private isBroken(type: Type): boolean {
    if (type.kind != TypeKind.Function) {
      return false;
    }

    return type.shape.result.kind == TypeKind.Error;
  }

  private typeAlias(decl: TypeAliasDecl): void {
    const type = this.resolver.declaredAlias(this.module.id, decl);
    const params = decl.typeParams.map((param) => param.name);
    const name = this.genericName(decl.name, params);

    this.declare(DeclarationForm.TypeAlias, name, decl.loc, type);
  }

  private typeEnum(decl: EnumDecl): void {
    const type = this.resolver.declaredEnum(this.module.id, decl);

    this.declare(DeclarationForm.Enum, decl.name, decl.loc, type);
  }

  private genericName(name: string, params: string[]): string {
    if (params.length == 0) {
      return name;
    }

    return `${name}<${params.join(", ")}>`;
  }

  private declare(
    form: DeclarationForm,
    name: string,
    loc: int,
    type: Type,
  ): void {
    this.declarations.push({ form, name, loc, type });
  }
}
