import { OwnershipCheck } from "../ownership-check.tz";
import { ClassDecl } from "../../../../program/ast/types/ast.types.classes.tz";
import { Code } from "../../../../diagnostic/code.tz";
import {
  CallArgument,
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  NameExpr,
  NewExpr,
  NewKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import {
  FunctionDecl,
  ParamKind,
} from "../../../../program/ast/types/ast.types.functions.tz";
import {
  DeclaredMember,
  DeclaredMemberKind,
} from "../../../../program/ast/types/ast.types.declarations.tz";
import { TypeRefKind } from "../../../../program/ast/types/ast.types.types.tz";
import { SymbolKind } from "../../../../program/scopes/types/scopes.types.tz";
import {
  DictKind,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import {
  ArgumentUse,
  BuiltinMethod,
  Callee,
  CalleeParam,
  CallbackMode,
  Loan,
  LoanKind,
  Operand,
  OperandKind,
  ParamMode,
  Place,
  ResultMode,
  Variable,
} from "../types/ownership-check.types.tz";
import {
  kArrayMethods,
  kChangingArrayMethods,
  kMapMethods,
  kMemModuleName,
  kMutName,
  kReplaceName,
  kSwapName,
  kSymbolEqualsKey,
  kSymbolHashKey,
  kWeakRefName,
  kTakeName,
  kViewName,
} from "../const/ownership-check.const.tz";
import { StmtKind } from "../../../../program/ast/types/ast.types.statements.tz";

partial class OwnershipCheck {
  private evaluateCall(expr: CallExpr): Operand {
    const callee = expr.callee;
    if (callee.kind == ExprKind.Member) {
      return this.methodCall(expr, callee);
    }

    let info: Callee = this.libraryCallee(expr);

    if (callee.kind == ExprKind.Name) {
      info = this.nameCallee(callee, expr);
      this.checkTake(callee, expr);
      this.checkMemPlaces(callee, expr);
      this.checkRequires(info, callee.loc, callee.name);
      this.checkClone(callee, expr);
    } else {
      this.evaluate(callee);
    }

    this.checkCellReach(expr, info, undefined, expr.args);

    const uses = this.argumentsOf(expr.args, info);

    this.applyArguments(uses);
    this.checkTwice(undefined, undefined, LoanKind.Shared, uses);
    this.checkVariance(expr, uses);

    return this.resultOf(info, expr, undefined, uses);
  }

  private readonly borrowKeeper(receiver: Read<Operand>, callee: MemberExpr): Variable | undefined {
    const place = receiver.place;
    const isAdding = callee.name == "push" || callee.name == "unshift";
    if (!isAdding || receiver.kind != OperandKind.Place || place == undefined) {
      return undefined;
    }
    if (place.path.length > 0) {
      return undefined;
    }

    const variable = this.variableOf(place.root);
    if (variable == undefined || variable.isBorrowArray != true) {
      return undefined;
    }

    return variable;
  }

  private readonly keepBorrows(keeper: Variable, uses: Read<ArgumentUse[]>): void {
    for (const use of uses) {
      const loans = this.heldLoans(use.operand);

      keeper.loans = keeper.loans.concat(loans);
    }
  }

  private readonly checkMemPlaces(callee: NameExpr, expr: CallExpr): void {
    const count = callee.name == kSwapName ? 2 : 1;
    const isMem =
      callee.name == kTakeName || callee.name == kReplaceName || callee.name == kSwapName;
    if (!isMem || !this.isMemFunction(callee)) {
      return;
    }

    for (const argument of expr.args.slice(0, count)) {
      if (!this.isPlaceExpr(argument.expr)) {
        this.report(argument.expr.loc, Code.OwnMemPlace, { word: callee.name });
      }
    }
  }

  private readonly isPlaceExpr(expr: Expr): boolean {
    switch (expr.kind) {
      case ExprKind.Name:
      case ExprKind.Member:
      case ExprKind.Index:
        return true;
      case ExprKind.Cast:
        return this.isPlaceExpr(expr.operand);
      default:
        return false;
    }
  }

  private readonly isMemFunction(callee: NameExpr): boolean {
    const target = this.values.valueTargetOf(callee, this.module);
    const home = target == undefined ? undefined : this.program.modules[target.module];

    return home != undefined && home.name == kMemModuleName;
  }

  private readonly checkTake(callee: NameExpr, expr: CallExpr): void {
    const place = expr.args[0]?.expr;
    if (callee.name != kTakeName || place == undefined) {
      return;
    }

    const target = this.values.valueTargetOf(callee, this.module);
    const home = target == undefined ? undefined : this.program.modules[target.module];
    if (home == undefined || home.name != kMemModuleName) {
      return;
    }

    const type = this.values.answers.typeOf(place);
    if (type == undefined || this.hasEmptyValue(type)) {
      return;
    }

    const word = this.exprText(place);

    this.report(place.loc, Code.OwnTakeEmpty, { word });
  }

  private readonly hasEmptyValue(type: Type): boolean {
    switch (type.kind) {
      case TypeKind.Array:
      case TypeKind.String:
      case TypeKind.Int:
      case TypeKind.Double:
      case TypeKind.Decimal:
      case TypeKind.Boolean:
      case TypeKind.Undefined:
        return true;
      case TypeKind.Union:
        return type.parts.some((part) => part.kind == TypeKind.Undefined);
      case TypeKind.Dict:
        return type.dict != DictKind.Record;
      default:
        return false;
    }
  }

  private methodCall(expr: CallExpr, callee: MemberExpr): Operand {
    const receiver = this.evaluate(callee.object);
    const info = this.memberCallee(callee, expr);

    this.checkRequires(info, callee.loc, callee.name);
    this.checkCellReach(expr, info, callee.object, expr.args);

    const isGuarded = this.cellGuardFor(callee.object, expr.loc);
    const uses = this.argumentsOf(expr.args, info);

    this.cellGuardDone(isGuarded);
    const keeper = this.borrowKeeper(receiver, callee);

    this.checkVariance(expr, uses);

    if (keeper == undefined) {
      this.applyArguments(uses);
    } else {
      this.keepBorrows(keeper, uses);
    }
    this.applyReceiver(receiver, info.receiver, callee);
    this.checkTwice(receiver, callee.object, info.receiver, uses);

    return this.resultOf(info, expr, receiver, uses);
  }

  private evaluateNew(expr: NewExpr): Operand {
    const form = expr.form;
    if (form.kind == NewKind.Callee) {
      this.evaluate(form.callee);
    }

    const info = this.constructorCallee(expr);

    this.checkCellReach(expr, info, undefined, expr.args);

    const uses = this.argumentsOf(expr.args, info);

    this.applyArguments(uses);
    this.checkTwice(undefined, undefined, LoanKind.Shared, uses);
    this.checkMadeKeys(expr);

    return this.freshOperand(expr.loc);
  }

  private checkMadeKeys(expr: NewExpr): void {
    const made = this.values.answers.typeOf(expr);
    if (made != undefined && made.kind == TypeKind.Dict && made.dict != DictKind.Record) {
      const name = this.copiedName(made.key);
      const decl = this.values.classDeclOf(made.key);
      const isKeyed =
        decl != undefined &&
        this.hasMethod(decl, kSymbolEqualsKey) &&
        this.hasMethod(decl, kSymbolHashKey);
      if (name != undefined && !isKeyed) {
        this.report(expr.loc, Code.OwnKeyHash, { word: name });
      }
    }
    if (made == undefined || made.kind != TypeKind.Instance || made.name != kWeakRefName) {
      return;
    }

    const target = made.args[0];
    const name = target == undefined ? undefined : this.copiedName(target);
    if (name != undefined) {
      this.report(expr.loc, Code.OwnWeakCopy, { word: name });
    }
  }

  public copiedName(type: Type): string | undefined {
    if (this.store.isInterned(type) || !this.traits.isCopy(type, this.values)) {
      return undefined;
    }
    if (type.kind == TypeKind.Object) {
      return "this object";
    }
    if (type.kind != TypeKind.Instance || this.values.classDeclOf(type) == undefined) {
      return undefined;
    }

    return type.name;
  }

  public readonly hasMethod(decl: ClassDecl, name: string): boolean {
    return decl.methods.some((method) => method.name == name);
  }

  private argumentsOf(args: Read<CallArgument[]>, info: Read<Callee>): ArgumentUse[] {
    const uses: ArgumentUse[] = [];

    for (let index: int = 0; index < args.length; index++) {
      const arg = args[index];
      if (arg == undefined) {
        continue;
      }

      const param = this.paramAt(info, index);
      const callback = this.callbackModeOf(param.mode);
      const operand = this.evaluateFor(arg.expr, callback);
      if (arg.spread && this.isSpreadOfCopies(arg.expr)) {
        const copy = this.copyOperand(arg.expr.loc);

        uses.push({ operand: copy, mode: ParamMode.Read, expr: arg.expr });

        continue;
      }

      uses.push({ operand, mode: param.mode, expr: arg.expr });
    }

    return uses;
  }

  private readonly calleeTypeOf(call: CallExpr): Type | undefined {
    const callee = call.callee;
    if (callee.kind != ExprKind.Name) {
      return this.values.answers.typeOf(callee);
    }

    const target = this.values.valueTargetOf(callee, this.module);
    if (target == undefined || target.kind != SymbolKind.Function) {
      return this.values.answers.typeOf(callee);
    }

    return this.values.functionOf(target.module, target.loc);
  }

  private readonly checkVariance(call: CallExpr, uses: Read<ArgumentUse[]>): void {
    const callee = this.calleeTypeOf(call);
    if (callee == undefined || callee.kind != TypeKind.Function) {
      return;
    }

    for (let index: int = 0; index < uses.length; index++) {
      const use = uses[index];
      const param = callee.shape.params[index];
      if (use == undefined || param == undefined || use.mode != ParamMode.Mut) {
        continue;
      }

      const given = this.ownTypeOf(use.expr);
      if (given != undefined && this.isWiderPlace(given, param.type)) {
        const word = this.exprText(use.expr);

        this.report(use.expr.loc, Code.OwnMutVariance, { word });
      }
    }
  }

  private readonly ownTypeOf(expr: Expr): Type | undefined {
    if (expr.kind != ExprKind.Name) {
      return this.values.answers.typeOf(expr);
    }

    const target = this.values.valueTargetOf(expr, this.module);
    if (target == undefined || target.kind != SymbolKind.Variable) {
      return this.values.answers.typeOf(expr);
    }

    return this.values.variableOf(target.module, target.loc) ?? this.values.answers.typeOf(expr);
  }

  private readonly isWiderPlace(given: Type, wanted: Type): boolean {
    if (given == wanted) {
      return false;
    }
    if (given.kind == TypeKind.Array && wanted.kind == TypeKind.Array) {
      return (
        wanted.readonly != true &&
        given.item != wanted.item &&
        wanted.item.kind != TypeKind.TypeParameter
      );
    }
    if (given.kind != TypeKind.Object || wanted.kind != TypeKind.Object) {
      return false;
    }

    const givenFields = given.fields.slice();

    return wanted.fields.some((field) => {
      const own = givenFields.find((one) => one.name == field.name);

      return (
        !field.readonly &&
        own != undefined &&
        own.type != field.type &&
        field.type.kind != TypeKind.TypeParameter
      );
    });
  }

  private readonly paramAt(info: Read<Callee>, index: int): CalleeParam {
    const exact = info.params[index];
    if (exact != undefined) {
      return exact;
    }

    const last = info.params[info.params.length - 1];
    if (last != undefined && last.isRest) {
      return last;
    }

    return { mode: ParamMode.Read, isRest: false, isCallback: false };
  }

  private readonly callbackModeOf(mode: ParamMode): CallbackMode {
    switch (mode) {
      case ParamMode.Own:
        return CallbackMode.Kept;
      case ParamMode.Once:
        return CallbackMode.Once;
      default:
        return CallbackMode.During;
    }
  }

  private applyArguments(uses: Read<ArgumentUse[]>): void {
    for (const use of uses) {
      switch (use.mode) {
        case ParamMode.Own:
        case ParamMode.Once:
          this.take(use.operand, use.expr);
          break;
        case ParamMode.Mut:
          this.access(use.operand, LoanKind.Exclusive, use.expr);
          break;
        default:
          break;
      }
    }
  }

  private applyReceiver(
    receiver: Read<Operand>,
    kind: LoanKind,
    callee: MemberExpr,
  ): void {
    if (kind != LoanKind.Exclusive) {
      return;
    }

    const type = this.values.answers.typeOf(callee.object);
    const isShared =
      (type != undefined && this.store.isInterned(type)) ||
      this.isSharedPart(callee.object);
    if (isShared) {
      const word = this.exprText(callee.object);

      this.report(callee.loc, Code.OwnInternedChanged, {
        word,
        other: callee.name,
      });

      return;
    }
    if (this.isReadonlyArrayExpr(callee.object)) {
      const word = this.exprText(callee.object);

      this.report(callee.loc, Code.OwnReadonlyArray, { word });

      return;
    }

    this.access(receiver, kind, callee.object);
  }

  private readonly checkTwice(
    receiver: Read<Operand | undefined>,
    receiverExpr: Expr | undefined,
    kind: LoanKind,
    uses: Read<ArgumentUse[]>,
  ): void {
    const places: Place[] = [];
    const exclusive: boolean[] = [];
    const exprs: Expr[] = [];

    if (receiver != undefined && receiverExpr != undefined) {
      const isExclusive = kind == LoanKind.Exclusive;

      this.notePlaces(receiver, isExclusive, receiverExpr, places, exclusive, exprs);
    }

    for (const use of uses) {
      const isExclusive =
        use.mode != ParamMode.Read && use.mode != ParamMode.Lent;

      this.notePlaces(use.operand, isExclusive, use.expr, places, exclusive, exprs);
    }

    this.reportTwice(places, exclusive, exprs);
  }

  private readonly notePlaces(
    operand: Read<Operand>,
    isExclusive: boolean,
    expr: Expr,
    places: Place[],
    exclusive: boolean[],
    exprs: Expr[],
  ): void {
    for (const loan of this.loansOf(operand)) {
      places.push(loan.place);
      exclusive.push(isExclusive);
      exprs.push(expr);
    }
  }

  private readonly reportTwice(places: Read<Place[]>, exclusive: Read<boolean[]>, exprs: Read<Expr[]>): void {
    for (let second: int = 1; second < places.length; second++) {
      for (let first: int = 0; first < second; first++) {
        const isConflict = this.isTwiceConflict(places, exclusive, first, second);
        const expr = exprs[second];
        const earlier = exprs[first];
        if (!isConflict || expr == undefined || earlier == expr) {
          continue;
        }

        const word = this.exprText(expr);

        this.report(expr.loc, Code.OwnArgumentTwice, { word });

        return;
      }
    }
  }

  private readonly isTwiceConflict(
    places: Read<Place[]>,
    exclusive: Read<boolean[]>,
    first: int,
    second: int,
  ): boolean {
    const one = places[first];
    const two = places[second];
    const isOneExclusive = exclusive[first] == true;
    const isTwoExclusive = exclusive[second] == true;
    if (one == undefined || two == undefined) {
      return false;
    }
    if (!isOneExclusive && !isTwoExclusive) {
      return false;
    }

    return this.overlaps(one, two);
  }

  private resultOf(
    info: Callee,
    expr: Expr,
    receiver: Read<Operand | undefined>,
    uses: Read<ArgumentUse[]>,
  ): Operand {
    const type = this.values.answers.typeOf(expr);
    if (info.result == ResultMode.Copy || this.isCopyExpr(expr)) {
      return this.copyOperand(expr.loc);
    }
    const isView = this.isViewCall(expr);
    const isLent = info.decl != undefined && info.result != ResultMode.Element;
    const isCopied = this.isArrayOfCopies(type) && !isView && !isLent;
    if (info.result == ResultMode.Own || isCopied) {
      return this.freshOperand(expr.loc);
    }

    const kind = this.resultLoanKind(info.result);
    const loans = this.resultLoans(info, receiver, uses);
    if (loans.length == 0) {
      return this.emptyResult(info, receiver, uses, expr.loc);
    }

    const kinded = loans.map((loan) => this.loanOn(loan.place, kind, loan.frozen));
    const isCell = receiver != undefined && receiver.isCell == true;
    const isInferred = info.result == ResultMode.Element;
    if (isCell || isInferred) {
      return { kind: OperandKind.Borrowed, loans: kinded, loc: expr.loc, isCell, isInferred };
    }

    return this.borrowedOperand(kinded, expr.loc);
  }

  private readonly isViewCall(expr: Expr): boolean {
    return (
      expr.kind == ExprKind.Call &&
      expr.callee.kind == ExprKind.Member &&
      expr.callee.name == kViewName
    );
  }

  private isArrayOfCopies(type: Type | undefined): boolean {
    if (type == undefined || type.kind != TypeKind.Array) {
      return false;
    }

    return this.traits.isCopy(type.item, this.values);
  }

  private readonly resultLoanKind(result: ResultMode): LoanKind {
    if (result == ResultMode.Mut) {
      return LoanKind.Exclusive;
    }

    return LoanKind.Shared;
  }

  private readonly resultLoans(
    info: Read<Callee>,
    receiver: Read<Operand | undefined>,
    uses: Read<ArgumentUse[]>,
  ): Loan[] {
    const lent = uses.filter((use) => use.mode == ParamMode.Lent);
    if (lent.length > 0) {
      const loans: Loan[] = [];

      for (const use of lent) {
        loans.push(...this.loansOf(use.operand));
      }

      return loans;
    }
    if (receiver != undefined) {
      return this.loansOf(receiver);
    }

    return [];
  }

  private memberCallee(callee: MemberExpr, call: Expr): Callee {
    const type = this.values.answers.typeOf(callee.object);
    if (type == undefined) {
      return this.libraryCallee(call);
    }

    switch (type.kind) {
      case TypeKind.Array:
        return this.builtinCallee(kArrayMethods, callee.name, call);
      case TypeKind.Dict:
        return this.builtinCallee(kMapMethods, callee.name, call);
      case TypeKind.Instance:
        return this.instanceCallee(type, callee.name, call);
      case TypeKind.Object:
        return this.interfaceCallee(type, callee.name) ?? this.libraryCallee(call);
      default:
        return this.libraryCallee(call);
    }
  }

  private instanceCallee(type: Type, name: string, call: Expr): Callee {
    const method = this.methodNamed(type, name, 0);
    if (method != undefined) {
      return this.declCallee(method, false);
    }

    const member = this.declaredMethod(type, name);
    if (member == undefined || member.form.kind != DeclaredMemberKind.Method) {
      return this.libraryCallee(call);
    }

    const params: CalleeParam[] = [];

    for (const param of member.form.params) {
      const written = this.paramMode(param);
      const isMarked = param.type?.name == kMutName;
      const mode = this.calleeMode(written, !isMarked);
      const isRest = param.form.kind == ParamKind.Rest;
      const isCallback = param.type?.form.kind == TypeRefKind.Function;

      params.push({ mode, isRest, isCallback });
    }

    const ref = member.type;
    let result: ResultMode = ResultMode.Own;

    if (ref != undefined) {
      result = this.resultModeOfRef(ref);
    }
    if (result == ResultMode.Own && this.isCopyExpr(call)) {
      result = ResultMode.Copy;
    }

    return { params, receiver: LoanKind.Shared, result };
  }

  private readonly declaredMethod(type: Type, name: string): DeclaredMember | undefined {
    if (type.kind != TypeKind.Instance) {
      return undefined;
    }

    const loc = type.loc;
    const home = this.program.modules[type.module];
    const declared = home?.declared.find((one) => one.loc == loc);

    return declared?.members.find((one) => one.name == name && !one.isStatic);
  }

  private readonly methodNamed(type: Type, name: string, depth: int): FunctionDecl | undefined {
    if (depth > 20) {
      return undefined;
    }

    const decl = this.values.classDeclOf(type);
    if (decl == undefined) {
      return undefined;
    }

    const own = decl.methods.find((method) => method.name == name);
    if (own != undefined) {
      return own;
    }

    for (const parent of this.store.parentsOf(type)) {
      const found = this.methodNamed(parent, name, depth + 1);
      if (found != undefined) {
        return found;
      }
    }

    return undefined;
  }

  private nameCallee(callee: NameExpr, call: Expr): Callee {
    const target = this.values.valueTargetOf(callee, this.module);
    if (target == undefined || target.kind != SymbolKind.Function) {
      return this.valueCallee();
    }

    const key = this.keyOf(target.module, target.loc);
    const decl = this.functions.get(key);
    if (decl != undefined) {
      return this.declCallee(decl, false);
    }

    const declared = this.libraryFunction(target.module, target.loc);
    if (declared == undefined) {
      return this.libraryCallee(call);
    }

    return this.declCallee(declared, true);
  }

  private readonly libraryFunction(module: int, loc: int): FunctionDecl | undefined {
    const opened = this.program.modules[module];
    if (opened == undefined) {
      return undefined;
    }

    for (const item of opened.file.items) {
      if (item.kind == StmtKind.Function && item.loc == loc) {
        return item;
      }
    }

    return undefined;
  }

  private constructorCallee(expr: NewExpr): Callee {
    const type = this.values.answers.typeOf(expr);
    if (type == undefined) {
      return this.libraryCallee(expr);
    }
    if (type.kind == TypeKind.Dict && type.dict != DictKind.Record) {
      return this.collectionCallee(type);
    }

    const decl = this.values.classDeclOf(type);
    const made = decl?.constructors[0];
    if (made == undefined) {
      return this.libraryCallee(expr);
    }

    return this.declCallee(made, false);
  }

  private readonly declCallee(fn: FunctionDecl, isLibrary: boolean): Callee {
    const params: CalleeParam[] = [];

    for (const param of fn.params) {
      const written = this.paramMode(param);
      const isMarked = param.type?.name == kMutName;
      const mode = this.calleeMode(written, isLibrary && !isMarked);
      const isRest = param.form.kind == ParamKind.Rest;
      const isCallback = param.type?.form.kind == TypeRefKind.Function;

      params.push({ mode, isRest, isCallback });
    }

    const receiver = this.receiverOf(fn);
    const result = this.resultModeOf(fn);

    return { params, receiver, result, decl: fn };
  }

  private readonly calleeMode(mode: ParamMode, isLibrary: boolean): ParamMode {
    if (isLibrary && mode == ParamMode.Mut) {
      return ParamMode.Read;
    }

    return mode;
  }

  private readonly receiverOf(fn: FunctionDecl): LoanKind {
    if (fn.role?.isReadonly == true) {
      return LoanKind.Shared;
    }

    return LoanKind.Exclusive;
  }

  private builtinCallee(table: Read<BuiltinMethod[]>, name: string, call: Expr): Callee {
    const row = table.find((one) => one.name == name);
    if (row == undefined) {
      return this.libraryCallee(call);
    }

    const params: CalleeParam[] = row.params.map((mode) => ({
      mode,
      isRest: false,
      isCallback: false,
    }));

    if (row.isRestOwn) {
      params.push({ mode: ParamMode.Own, isRest: true, isCallback: false });
    }

    return { params, receiver: row.receiver, result: row.result };
  }

  private libraryCallee(call: Expr): Callee {
    const isCopy = this.isCopyExpr(call);
    let result: ResultMode = ResultMode.Own;

    if (isCopy) {
      result = ResultMode.Copy;
    }

    return { params: [], receiver: LoanKind.Shared, result };
  }

  private readonly valueCallee(): Callee {
    const params: CalleeParam[] = [
      { mode: ParamMode.Mut, isRest: true, isCallback: false },
    ];

    return { params, receiver: LoanKind.Shared, result: ResultMode.Own };
  }

  private readonly isChangingMethod(object: Expr, method: string): boolean {
    const type = this.values.answers.typeOf(object);
    if (type == undefined) {
      return false;
    }

    switch (type.kind) {
      case TypeKind.Array:
        return kChangingArrayMethods.includes(method);
      case TypeKind.Dict:
        return this.isChangingDictMethod(method);
      case TypeKind.Instance: {
        const found = this.methodNamed(type, method, 0);

        return found != undefined && found.role?.isReadonly != true;
      }
      default:
        return false;
    }
  }

  private readonly isChangingDictMethod(method: string): boolean {
    const row = kMapMethods.find((one) => one.name == method);

    return row != undefined && row.receiver == LoanKind.Exclusive;
  }

  private readonly isOperandPlace(operand: Read<Operand>): boolean {
    return operand.kind == OperandKind.Place;
  }
}
