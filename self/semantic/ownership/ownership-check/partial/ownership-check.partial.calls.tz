import { OwnershipCheck } from "../ownership-check.tz";
import { ClassDecl } from "../../../../program/ast/types/ast.types.classes.tz";
import { Code } from "../../../../diagnostic/code.tz";
import {
  CallArgument,
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  NameExpr,
  NewExpr,
  NewKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import {
  DictKind,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import {
  ArgumentTypes,
  ArgumentUse,
  Callee,
  CalleeParam,
  CallbackMode,
  LoanKind,
  Operand,
  OperandKind,
  ParamMode,
  Place,
} from "../types/ownership-check.types.tz";
import {
  kMemModuleName,
  kReplaceName,
  kSwapName,
  kSymbolEqualsKey,
  kSymbolHashKey,
  kWeakRefName,
  kTakeName,
} from "../const/ownership-check.const.tz";

partial class OwnershipCheck {
  private evaluateCall(expr: CallExpr): Operand {
    const tree = this.values.types.program.tree;

    const callee = tree.exprOf(expr.calleeId);
    if (callee.kind == ExprKind.Member) {
      return this.methodCall(expr, callee);
    }

    let info: Callee = this.libraryCallee(expr);

    if (callee.kind == ExprKind.Name) {
      info = this.nameCallee(callee, expr);
      this.checkTake(callee, expr);
      this.checkMemPlaces(callee, expr);
      this.checkRequires(info, callee.loc, callee.name);
      this.checkClone(callee, expr);
    } else {
      this.evaluate(callee);
    }

    const args = tree.argumentsOf(expr.argsList);
    const types = this.argumentTypes(expr);
    const uses = this.argumentsOf(args, info, true, types);

    this.applyArguments(uses);
    this.checkTwice(undefined, undefined, LoanKind.Shared, uses);
    this.checkVariance(expr, uses);
    this.checkCopyShares(expr, uses);

    const isOpen = this.isOpenCallee(callee);

    this.noteCall(expr, callee, info, isOpen);

    return this.resultOf(info, expr, undefined, uses);
  }

  private readonly borrowKeeper(
    receiver: Read<Operand>,
    callee: MemberExpr,
  ): int | undefined {
    const place = receiver.place;
    const isAdding = callee.name == "push" || callee.name == "unshift";
    if (!isAdding || receiver.kind != OperandKind.Place || place == undefined) {
      return undefined;
    }
    if (place.depth > 0) {
      return undefined;
    }

    const variable = this.variableOf(place.root);
    if (variable == undefined || variable.isBorrowArray != true) {
      return undefined;
    }

    return place.root;
  }

  private keepBorrows(keeper: int, uses: Read<ArgumentUse[]>): void {
    for (const use of uses) {
      const loans = this.heldLoans(use.operand);

      this.addLoans(keeper, loans);
    }
  }

  private checkMemPlaces(callee: NameExpr, expr: CallExpr): void {
    const tree = this.values.types.program.tree;

    const count = callee.name == kSwapName ? 2 : 1;
    const isMem =
      callee.name == kTakeName ||
      callee.name == kReplaceName ||
      callee.name == kSwapName;
    if (!isMem || !this.isMemFunction(callee)) {
      return;
    }

    for (const argument of tree.argumentsOf(expr.argsList).slice(0, count)) {
      const exprExpr = tree.exprOf(argument.exprId);
      if (!this.isPlaceExpr(exprExpr)) {
        this.errors.write(
          this.home,
          tree.exprOf(argument.exprId).loc,
          Code.OwnMemPlace,
          {
            word: callee.name,
          },
        );
      }
    }
  }

  private readonly isPlaceExpr(expr: Expr): boolean {
    const tree = this.values.types.program.tree;

    switch (expr.kind) {
      case ExprKind.Name:
      case ExprKind.Member:
      case ExprKind.Index:
        return true;
      case ExprKind.Cast:
        const operand = tree.exprOf(expr.operandId);

        return this.isPlaceExpr(operand);
      default:
        return false;
    }
  }

  private readonly isMemFunction(callee: NameExpr): boolean {
    const target = this.values.valueTargetOf(callee, this.module);

    return this.moduleNameAt(target?.module) == kMemModuleName;
  }

  private readonly moduleNameAt(module: int | undefined): string {
    if (module == undefined) {
      return "";
    }

    return this.values.types.program.modules[module]?.name ?? "";
  }

  private checkTake(callee: NameExpr, expr: CallExpr): void {
    const tree = this.values.types.program.tree;

    const place = tree.exprAt(tree.argumentsOf(expr.argsList)[0]?.exprId);
    if (callee.name != kTakeName || place == undefined) {
      return;
    }

    const target = this.values.valueTargetOf(callee, this.module);
    if (this.moduleNameAt(target?.module) != kMemModuleName) {
      return;
    }

    const type = this.values.answers.typeOf(place);
    if (type == undefined || this.hasEmptyValue(type)) {
      return;
    }

    const word = this.exprText(place);

    this.errors.write(this.home, place.loc, Code.OwnTakeEmpty, { word });
  }

  private readonly hasEmptyValue(type: Type): boolean {
    switch (type.kind) {
      case TypeKind.Array:
      case TypeKind.String:
      case TypeKind.Int:
      case TypeKind.Double:
      case TypeKind.Decimal:
      case TypeKind.Boolean:
      case TypeKind.Undefined:
        return true;
      case TypeKind.Union:
        return this.values.types.store
          .partsOf(type)
          .some((part) => part.kind == TypeKind.Undefined);
      case TypeKind.Dict:
        return type.dict != DictKind.Record;
      default:
        return false;
    }
  }

  private methodCall(expr: CallExpr, callee: MemberExpr): Operand {
    const tree = this.values.types.program.tree;

    const object = tree.exprOf(callee.objectId);
    const receiver = this.evaluate(object);
    const info = this.memberCallee(callee, expr);

    this.checkSearchEquality(expr, callee);

    this.checkRequires(info, callee.loc, callee.name);

    const keeper = this.borrowKeeper(receiver, callee);
    const args = tree.argumentsOf(expr.argsList);
    const types = this.argumentTypes(expr);
    const isMoving = keeper == undefined;
    const uses = this.argumentsOf(args, info, isMoving, types);

    this.checkVariance(expr, uses);
    this.checkCopyShares(expr, uses);

    if (keeper == undefined) {
      this.applyArguments(uses);
    } else {
      this.keepBorrows(keeper, uses);
    }
    this.applyReceiver(receiver, info.receiver, callee);
    this.checkTwice(
      receiver,
      tree.exprOf(callee.objectId),
      info.receiver,
      uses,
    );
    this.takeJoinedReceiver(receiver, callee);

    const isOpen = this.isOpenMethod(callee);

    this.noteCall(expr, callee, info, isOpen);

    return this.resultOf(info, expr, receiver, uses);
  }

  private evaluateNew(expr: NewExpr): Operand {
    const tree = this.values.types.program.tree;

    const form = expr.form;
    if (form.kind == NewKind.Callee) {
      const callee = tree.exprOf(form.calleeId);

      this.evaluate(callee);
    }

    const info = this.constructorCallee(expr);

    const args = tree.argumentsOf(expr.argsList);
    const types = this.argumentTypes(expr);
    const uses = this.argumentsOf(args, info, true, types);

    this.applyArguments(uses);
    this.checkTwice(undefined, undefined, LoanKind.Shared, uses);
    this.checkMadeKeys(expr);
    this.noteCall(expr, expr, info, false);

    return this.freshOperand(expr.loc);
  }

  private checkMadeKeys(expr: NewExpr): void {
    const made = this.values.answers.typeOf(expr);
    if (
      made != undefined &&
      made.kind == TypeKind.Dict &&
      made.dict != DictKind.Record
    ) {
      const name = this.copiedName(this.values.types.store.keyOf(made));
      const decl = this.values.classDeclOf(this.values.types.store.keyOf(made));
      const isKeyed =
        decl != undefined &&
        this.hasMethod(decl, kSymbolEqualsKey) &&
        this.hasMethod(decl, kSymbolHashKey);
      if (name != undefined && !isKeyed) {
        this.errors.write(this.home, expr.loc, Code.OwnKeyHash, { word: name });
      }
    }
    if (
      made == undefined ||
      made.kind != TypeKind.Instance ||
      made.name != kWeakRefName
    ) {
      return;
    }

    const target = this.values.types.store.argsOf(made)[0];
    const name = target == undefined ? undefined : this.copiedName(target);
    if (name != undefined) {
      this.errors.write(this.home, expr.loc, Code.OwnWeakCopy, { word: name });
    }
  }

  public copiedName(type: Type): string | undefined {
    if (!this.values.isCopy(type)) {
      return undefined;
    }
    if (type.kind == TypeKind.Object || this.isRecordUnion(type)) {
      return "this object";
    }
    if (
      type.kind != TypeKind.Instance ||
      this.values.classDeclOf(type) == undefined
    ) {
      return undefined;
    }

    return type.name;
  }

  private readonly isRecordUnion(type: Type): boolean {
    if (type.kind != TypeKind.Union) {
      return false;
    }

    const parts = this.values.types.store.partsOf(type);
    const records = parts.filter((part) => part.kind == TypeKind.Object);
    const others = parts.filter(
      (part) => part.kind != TypeKind.Object && part.kind != TypeKind.Undefined,
    );

    return records.length > 0 && others.length == 0;
  }

  private checkSearchEquality(call: CallExpr, callee: MemberExpr): void {
    const isSearch =
      callee.name == "includes" ||
      callee.name == "indexOf" ||
      callee.name == "lastIndexOf";
    if (!isSearch) {
      return;
    }

    const tree = this.values.types.program.tree;
    const object = tree.exprOf(callee.objectId);
    const array = this.values.answers.typeOf(object);
    if (array == undefined || array.kind != TypeKind.Array) {
      return;
    }

    const item = this.values.types.store.itemOf(array);
    const name = this.copiedName(item);
    if (name == undefined) {
      return;
    }

    const decl = this.values.classDeclOf(item);
    if (decl != undefined && this.hasMethod(decl, kSymbolEqualsKey)) {
      return;
    }

    this.errors.write(this.home, call.loc, Code.OwnEqualsMissing, {
      word: name,
    });
  }

  public readonly hasMethod(decl: ClassDecl, name: string): boolean {
    const tree = this.values.types.program.tree;

    return this.values.types.hasClassMethod(decl, name);
  }

  private argumentsOf(
    args: Read<CallArgument[]>,
    info: Read<Callee>,
    isMoving: boolean,
    types: Read<ArgumentTypes>,
  ): ArgumentUse[] {
    const tree = this.values.types.program.tree;

    const uses: ArgumentUse[] = [];

    for (let index: int = 0; index < args.length; index++) {
      const arg = args[index];
      if (arg == undefined) {
        continue;
      }

      const param = this.paramAt(info, index);
      const callback = this.callbackModeOf(param.mode);
      const exprExpr = tree.exprOf(arg.exprId);
      const isTaken =
        param.mode == ParamMode.Own || param.mode == ParamMode.Once;
      const wanted = this.wantedAt(types, index);
      const isWidening = isMoving && isTaken;
      if (isWidening && arg.spread) {
        this.widenSpread(exprExpr, wanted);
      }
      if (isWidening && !arg.spread) {
        this.widenFor(exprExpr, wanted);
      }
      if (!isWidening && !arg.spread) {
        this.promiseFor(exprExpr, wanted);
      }

      const operand = this.evaluateFor(exprExpr, callback);
      if (arg.spread && this.isSpreadOfCopies(tree.exprOf(arg.exprId))) {
        const argExpr = tree.exprOf(arg.exprId);
        const copy = this.copyOperand(argExpr.loc);

        uses.push({
          operand: copy,
          mode: ParamMode.Read,
          expr: tree.exprOf(arg.exprId),
        });

        continue;
      }

      const expr = tree.exprOf(arg.exprId);
      if (isMoving && isTaken) {
        this.take(operand, expr);
      }

      uses.push({ operand, mode: param.mode, expr });
    }

    return uses;
  }

  private readonly paramAt(info: Read<Callee>, index: int): CalleeParam {
    const exact = info.params[index];
    if (exact != undefined) {
      return exact;
    }

    const last = info.params[info.params.length - 1];
    if (last != undefined && last.isRest) {
      return last;
    }

    return { mode: ParamMode.Read, isRest: false, isCallback: false };
  }

  private readonly callbackModeOf(mode: ParamMode): CallbackMode {
    switch (mode) {
      case ParamMode.Own:
        return CallbackMode.Kept;
      case ParamMode.Once:
        return CallbackMode.Once;
      default:
        return CallbackMode.During;
    }
  }

  private applyArguments(uses: Read<ArgumentUse[]>): void {
    for (const use of uses) {
      switch (use.mode) {
        case ParamMode.Mut:
          this.access(use.operand, LoanKind.Exclusive, use.expr);
          break;
        default:
          break;
      }
    }
  }

  private applyReceiver(
    receiver: Read<Operand>,
    kind: LoanKind,
    callee: MemberExpr,
  ): void {
    const tree = this.values.types.program.tree;

    if (kind != LoanKind.Exclusive) {
      return;
    }

    const calleeObject = tree.exprOf(callee.objectId);
    if (this.isReadonlyArrayExpr(calleeObject)) {
      const object = tree.exprOf(callee.objectId);
      const word = this.exprText(object);

      this.errors.write(this.home, callee.loc, Code.OwnReadonlyArray, { word });

      return;
    }

    const objectExpr = tree.exprOf(callee.objectId);

    this.access(receiver, kind, objectExpr);
  }
}
