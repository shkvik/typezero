import { OwnershipCheck } from "../ownership-check.tz";
import { Code } from "../../../../diagnostic/code.tz";
import {
  Expr,
  ExprKind,
  NameExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../program/ast/types/ast.types.functions.tz";
import {
  CallbackMode,
  FunctionFrame,
  Holding,
  Place,
} from "../types/ownership-check.types.tz";
import { kThisKey } from "../const/ownership-check.const.tz";

partial class OwnershipCheck {
  private closure(fn: FunctionDecl, mode: CallbackMode, loc: int): void {
    const frame = this.frame();
    if (frame == undefined) {
      return;
    }

    const owner = frame.owner;
    const exprs = this.closureExprs(fn);
    const captured = this.capturedKeys(frame, exprs);
    const isKept = mode == CallbackMode.Kept || mode == CallbackMode.Once;
    if (!isKept) {
      this.lentClosures.add(fn.id);
    }

    for (const key of captured) {
      if (isKept && !this.isCopiedCapture(key, exprs)) {
        const used = this.firstUseOf(key, exprs, loc);

        this.captureKept(key, loc, used);
      } else if (!isKept) {
        this.captureDuring(key, exprs, loc);
      }
    }

    this.checkFunction(fn, owner, mode, true);
  }

  private readonly closureExprs(fn: FunctionDecl): Expr[] {
    return this.values.types.functionExprs(fn, true);
  }

  private readonly capturedKeys(
    frame: Read<FunctionFrame>,
    exprs: Read<Expr[]>,
  ): int[] {
    const keys: int[] = [];

    for (const expr of exprs) {
      if (expr.kind != ExprKind.Name) {
        continue;
      }

      const key = this.keyOfName(expr);
      if (key == undefined || keys.includes(key)) {
        continue;
      }
      if (frame.variables.has(key)) {
        keys.push(key);
      }
    }

    return keys;
  }

  private readonly firstUseOf(
    key: int,
    exprs: Read<Expr[]>,
    fallback: int,
  ): int {
    for (const expr of exprs) {
      if (expr.kind == ExprKind.Name && this.keyOfName(expr) == key) {
        return expr.loc;
      }
    }

    return fallback;
  }

  private captureKept(key: int, loc: int, used: int): void {
    const variable = this.variableOf(key);
    if (variable == undefined || variable.holding == Holding.Global) {
      return;
    }

    const word = variable.name;
    const holding = variable.holding;
    const isConst = variable.isConst;

    if (key == kThisKey) {
      this.errors.write(this.home, used, Code.OwnKeptThis, {});

      return;
    }
    if (!isConst) {
      this.errors.write(this.home, used, Code.OwnKeptLet, { word });

      return;
    }

    switch (holding) {
      case Holding.Own: {
        const place = this.wholePlace(key);

        this.moveOwned(place, loc);
        return;
      }
      case Holding.Borrow:
      case Holding.Lent:
        this.errors.write(this.home, loc, Code.OwnKeptBorrow, { word });
        return;
      default:
        return;
    }
  }

  private isCopiedCapture(key: int, exprs: Read<Expr[]>): boolean {
    const variable = this.variableOf(key);
    if (variable == undefined || !variable.isConst) {
      return false;
    }

    for (const expr of exprs) {
      if (expr.kind != ExprKind.Name || this.keyOfName(expr) != key) {
        continue;
      }

      return this.isCopyExpr(expr);
    }

    return false;
  }

  private captureDuring(key: int, exprs: Read<Expr[]>, loc: int): void {
    if (!this.isChangedIn(key, exprs)) {
      return;
    }

    const place = this.wholePlace(key);

    this.changePlace(place, loc);
  }

  private readonly isChangedIn(key: int, exprs: Read<Expr[]>): boolean {
    for (const expr of exprs) {
      const changed = this.changedRoot(expr);
      if (changed == undefined) {
        continue;
      }

      const found = this.keyOfName(changed);
      if (found == key) {
        return true;
      }
    }

    return false;
  }

  private readonly changedRoot(expr: Expr): NameExpr | undefined {
    const tree = this.values.types.program.tree;

    if (expr.kind == ExprKind.Assign || expr.kind == ExprKind.Update) {
      const target = tree.exprOf(expr.targetId);

      return this.rootNameOf(target);
    }
    const member = this.calleeMember(expr);
    if (member == undefined) {
      return undefined;
    }
    const objectExpr = tree.exprOf(member.objectId);
    if (!this.isChangingMethod(objectExpr, member.name)) {
      return undefined;
    }

    const object = tree.exprOf(member.objectId);

    return this.rootNameOf(object);
  }
}
