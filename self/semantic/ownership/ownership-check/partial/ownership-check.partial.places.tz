import { OwnershipCheck } from "../ownership-check.tz";
import { Code } from "../../../../diagnostic/code.tz";
import {
  Expr,
  ExprKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import {
  FlowState,
  Holding,
  Loan,
  LoanKind,
  Moved,
  Place,
  Variable,
} from "../types/ownership-check.types.tz";
import {
  kElementStep,
  kStepJoin,
  kThisKey,
} from "../const/ownership-check.const.tz";

partial class OwnershipCheck {
  private readonly wholePlace(root: int): Place {
    return { root, path: "", depth: 0 };
  }

  private readonly extended(place: Place, step: string): Place {
    const depth = place.depth + 1;
    if (place.depth == 0) {
      return { root: place.root, path: step, depth };
    }

    const path = `${place.path}${kStepJoin}${step}`;

    return { root: place.root, path, depth };
  }

  private readonly joined(outer: Place, inner: Place): Place {
    const depth = outer.depth + inner.depth;
    if (inner.depth == 0) {
      return { root: outer.root, path: outer.path, depth };
    }
    if (outer.depth == 0) {
      return { root: outer.root, path: inner.path, depth };
    }

    const path = `${outer.path}${kStepJoin}${inner.path}`;

    return { root: outer.root, path, depth };
  }

  private readonly stepsOf(place: Place): string[] {
    if (place.depth == 0) {
      return [];
    }

    return place.path.split(kStepJoin);
  }

  private readonly isPrefix(shorter: Place, longer: Place): boolean {
    if (shorter.root != longer.root || shorter.depth > longer.depth) {
      return false;
    }
    if (shorter.depth == 0 || shorter.path == longer.path) {
      return true;
    }

    return longer.path.startsWith(`${shorter.path}${kStepJoin}`);
  }

  private readonly overlaps(first: Place, second: Place): boolean {
    return this.isPrefix(first, second) || this.isPrefix(second, first);
  }

  private readonly placeText(place: Place): string {
    const root = this.rootName(place.root);
    const steps = this.stepsOf(place);
    let text: string = root;

    for (const step of steps) {
      text = this.stepText(text, step);
    }

    return text;
  }

  private readonly stepText(text: string, step: string): string {
    if (step == kElementStep) {
      return `${text}[...]`;
    }

    return `${text}.${step}`;
  }

  private readonly rootName(root: int): string {
    if (root == kThisKey) {
      return "this";
    }

    const variable = this.variableOf(root);
    if (variable == undefined) {
      return "the value";
    }

    return variable.name;
  }

  private readonly exprText(expr: Expr): string {
    const tree = this.values.types.program.tree;

    switch (expr.kind) {
      case ExprKind.Name:
        return expr.name;
      case ExprKind.Member: {
        const objectExpr = tree.exprOf(expr.objectId);
        const object = this.exprText(objectExpr);

        return `${object}.${expr.name}`;
      }
      case ExprKind.Index: {
        const exprObject = tree.exprOf(expr.objectId);
        const object = this.exprText(exprObject);

        return `${object}[...]`;
      }
      case ExprKind.Cast:
        const operand = tree.exprOf(expr.operandId);

        return this.exprText(operand);
      case ExprKind.OptionalChain:
        const chain = tree.exprOf(expr.chainId);

        return this.exprText(chain);
      case ExprKind.Call: {
        const calleeExpr = tree.exprOf(expr.calleeId);
        const callee = this.exprText(calleeExpr);

        return `${callee}(...)`;
      }
      default:
        return "the value";
    }
  }

  private readonly isLive(variable: Read<Variable>, loc: int): boolean {
    const at = this.liveFrom > loc ? this.liveFrom : loc;

    return variable.declared < loc && at < variable.lastUse;
  }

  private checkWrite(place: Place, loc: int, isMove: boolean): void {
    this.checkWriteExcept(place, loc, isMove, place.root);
  }

  private checkWriteExcept(
    place: Read<Place>,
    loc: int,
    isMove: boolean,
    except: int,
  ): void {
    for (const target of this.underlying(place)) {
      const isReported = this.checkWriteOn(
        target,
        loc,
        [except, place.root],
        isMove,
      );
      if (isReported) {
        return;
      }
    }
  }

  private checkWriteOn(
    place: Place,
    loc: int,
    except: Read<int[]>,
    isMove: boolean,
  ): boolean {
    const found = this.conflictOn(place, loc, except, isMove);
    if (found == undefined) {
      return false;
    }

    this.reportInUse(place, found, loc);

    return true;
  }

  private readonly conflictOn(
    place: Read<Place>,
    loc: int,
    except: Read<int[]>,
    isMove: boolean,
  ): int | undefined {
    const frame = this.frame();
    if (frame == undefined) {
      return undefined;
    }

    for (const variable of frame.variables.values()) {
      if (except.includes(variable.key) || !this.isLive(variable, loc)) {
        continue;
      }

      const loan = this.conflictingLoan(variable, place, isMove);
      if (loan != undefined) {
        return variable.key;
      }
    }

    return undefined;
  }

  private readonly conflictingLoan(
    variable: Read<Variable>,
    place: Read<Place>,
    isMove: boolean,
  ): Loan | undefined {
    for (const loan of variable.loans) {
      if (!this.overlaps(loan.place, place)) {
        continue;
      }

      const isAbove = place.depth < loan.place.depth;
      if (loan.frozen && isAbove && !isMove) {
        continue;
      }

      return loan;
    }

    return undefined;
  }

  private reportInUse(place: Place, key: int, loc: int): void {
    const variable = this.variableOf(key);
    if (variable == undefined) {
      return;
    }

    const lastUse = variable.lastUse;
    const declared = variable.declared;
    const name = variable.name;
    const isBinding = this.isLoopBinding(key);
    const word = this.placeText(place);
    const first = this.lineOf(lastUse);

    if (isBinding) {
      const other = this.lineOf(declared);

      this.errors.write(this.home, loc, Code.OwnLoopChanged, { word, other });

      return;
    }

    this.errors.write(this.home, loc, Code.OwnInUse, {
      word,
      other: name,
      first,
    });
  }

  private readonly underlying(place: Own<Place>): Place[] {
    const variable = this.variableOf(place.root);
    if (variable == undefined || variable.holding != Holding.Borrow) {
      return [place];
    }

    const found: Place[] = [];

    for (const loan of variable.loans) {
      found.push(this.joined(loan.place, place));
    }

    return found;
  }

  private checkUsable(place: Place, loc: int): boolean {
    const moved = this.movedOver(place);
    if (moved == undefined) {
      return true;
    }

    const word = this.placeText(moved.place);
    const other = this.lineOf(moved.loc);

    if (moved.loc >= loc) {
      this.errors.write(this.home, loc, Code.OwnMovedInLoop, { word });
    } else {
      this.errors.write(this.home, loc, Code.OwnMovedUsed, { word, other });
    }

    return false;
  }

  private readonly movedOver(place: Read<Place>): Moved | undefined {
    for (const moved of this.state.moved) {
      if (this.overlaps(moved.place, place)) {
        return moved;
      }
    }

    return undefined;
  }

  private markMoved(place: Own<Place>, loc: int): void {
    this.state.moved.push({ place, loc });
  }

  private revive(root: int): void {
    this.state.moved = this.state.moved.filter(
      (moved) => moved.place.root != root,
    );
  }

  private readonly copyState(state: Read<FlowState>): FlowState {
    const moved: Moved[] = state.moved.slice();

    return { moved, isDead: state.isDead };
  }

  private readonly merged(
    first: Read<FlowState>,
    second: Read<FlowState>,
  ): FlowState {
    if (first.isDead) {
      return this.copyState(second);
    }
    if (second.isDead) {
      return this.copyState(first);
    }

    const moved: Moved[] = first.moved.slice();

    for (const entry of second.moved) {
      const isKnown = moved.some((known) => this.isSamePlace(known, entry));
      if (!isKnown) {
        moved.push(entry);
      }
    }

    return { moved, isDead: false };
  }

  private readonly isSamePlace(first: Moved, second: Moved): boolean {
    const isPrefix = this.isPrefix(first.place, second.place);

    return isPrefix && first.place.depth == second.place.depth;
  }

  private readonly loanOn(
    place: Own<Place>,
    kind: LoanKind,
    frozen: boolean,
  ): Loan {
    return { place, kind, frozen };
  }
}
