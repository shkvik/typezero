import { replace } from "tz:mem";
import { OwnershipCheck } from "../ownership-check.tz";
import { Code } from "../../../../diagnostic/code.tz";
import {
  ArrayLitExpr,
  BinaryOp,
  Expr,
  ExprKind,
  NameExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import {
  ForOfStmt,
  IfStmt,
  Stmt,
  StmtKind,
  SwitchStmt,
  VarDeclStmt,
} from "../../../../program/ast/types/ast.types.statements.tz";
import { VarDeclarator } from "../../../../program/ast/types/ast.types.patterns.tz";
import {
  DictKind,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import {
  CallbackMode,
  FlowState,
  Holding,
  Loan,
  LoanKind,
  Operand,
  OperandKind,
  Variable,
} from "../types/ownership-check.types.tz";
import { kElementStep } from "../const/ownership-check.const.tz";

partial class OwnershipCheck {
  private walkStatements(items: Read<Stmt[]>): void {
    for (const item of items) {
      this.walkStatement(item);
    }
  }

  private walkStatement(stmt: Stmt): void {
    const tree = this.values.types.program.tree;

    switch (stmt.kind) {
      case StmtKind.Block:
        const body = tree.stmtsOf(stmt.bodyList);

        return this.walkStatements(body);
      case StmtKind.VarDecl:
        return this.walkDeclaration(stmt);
      case StmtKind.Function:
        return this.walkNestedFunction(stmt);
      case StmtKind.Class:
        return this.walkNestedClass(stmt);
      case StmtKind.Expr:
        const expr = tree.exprOf(stmt.exprId);

        this.evaluate(expr);
        return;
      case StmtKind.If:
        return this.walkIf(stmt);
      case StmtKind.While:
        return this.walkLoop(
          tree.exprOf(stmt.condId),
          tree.stmtOf(stmt.bodyId),
          undefined,
        );
      case StmtKind.DoWhile:
        return this.walkLoop(
          tree.exprOf(stmt.condId),
          tree.stmtOf(stmt.bodyId),
          undefined,
        );
      case StmtKind.For:
        return this.walkFor(
          tree.stmtAt(stmt.initId),
          tree.exprAt(stmt.condId),
          tree.exprAt(stmt.stepId),
          tree.stmtAt(stmt.bodyId),
        );
      case StmtKind.ForOf:
        return this.walkForOf(stmt);
      case StmtKind.Switch:
        return this.walkSwitch(stmt);
      case StmtKind.Labeled:
        const bodyStmt = tree.stmtOf(stmt.bodyId);

        return this.walkStatement(bodyStmt);
      case StmtKind.Return:
        const value = tree.exprAt(stmt.valueId);

        return this.walkReturn(value, stmt.loc);
      case StmtKind.Break:
      case StmtKind.Continue:
        this.state.isDead = true;
        return;
      default:
        return;
    }
  }

  private walkNestedFunction(stmt: Stmt): void {
    const frame = this.frame();
    if (
      stmt.kind != StmtKind.Function ||
      frame == undefined ||
      this.isModuleItem(stmt)
    ) {
      return;
    }

    const owner = frame.owner;

    this.checkFunction(stmt, owner, CallbackMode.Local, true);
  }

  private walkNestedClass(stmt: Stmt): void {
    const isInside = this.frame() != undefined;
    if (stmt.kind != StmtKind.Class || !isInside || this.isModuleItem(stmt)) {
      return;
    }

    this.checkClass(stmt, true);
  }

  private readonly isModuleItem(stmt: Stmt): boolean {
    const tree = this.values.types.program.tree;

    const home = this.values.types.program.modules[this.module];

    return (
      home != undefined &&
      tree.stmtsOf(home.file.itemsList).some((one) => one.id == stmt.id)
    );
  }

  private walkDeclaration(stmt: VarDeclStmt): void {
    const tree = this.values.types.program.tree;

    for (const declarator of tree.declaratorsOf(stmt.declsList)) {
      this.walkDeclarator(declarator);
    }
  }

  private walkDeclarator(declarator: VarDeclarator): void {
    const tree = this.values.types.program.tree;

    const key = declarator.loc;
    const variable = this.variableOf(key);
    const init = tree.exprAt(declarator.initId);
    if (variable == undefined) {
      return;
    }

    const isBorrowArray = variable.isBorrowArray == true;

    this.revive(key);
    if (init == undefined) {
      const holding = this.declaredHolding(key);

      this.setHolding(key, holding);

      return;
    }
    if (isBorrowArray && init.kind == ExprKind.ArrayLit) {
      return this.borrowsListed(key, init);
    }
    if (this.isRecordCopy(key, init)) {
      this.evaluate(init);
      this.setHeld(key, Holding.Own, []);

      return;
    }
    if (this.isFieldCopy(key, init)) {
      return this.fieldsLooked(key, init);
    }

    const wanted = this.values.variableOf(this.module, key);

    this.widenFor(init, wanted);

    const operand = this.evaluateFor(init, CallbackMode.Local);

    this.bind(key, operand, init);
    this.noteBorrowDecl(key, key);
  }

  private readonly isRecordCopy(loc: int, init: Expr): boolean {
    const target = this.values.variableOf(this.module, loc);
    const given = this.values.answers.typeOf(init);
    const isRecord =
      target != undefined &&
      target.kind == TypeKind.Dict &&
      target.dict == DictKind.Record;

    return isRecord && given != undefined && given.kind == TypeKind.Object;
  }

  private isFieldCopy(loc: int, init: Expr): boolean {
    const target = this.values.variableOf(this.module, loc);
    const given = this.values.answers.typeOf(init);
    const isObjects =
      target != undefined &&
      given != undefined &&
      target.kind == TypeKind.Object &&
      given.kind == TypeKind.Object &&
      target.id != given.id;

    return (
      isObjects &&
      target != undefined &&
      this.values.isCopy(target)
    );
  }

  private fieldsLooked(key: int, init: Expr): void {
    const operand = this.evaluate(init);
    const place = operand.place;
    if (
      operand.kind != OperandKind.Place ||
      place == undefined ||
      this.isCopyExpr(init)
    ) {
      this.setHeld(key, Holding.Own, []);

      return;
    }

    const loans = this.loansOfPlace(place);

    this.setHeld(key, Holding.Borrow, loans);
  }

  private borrowsListed(key: int, init: ArrayLitExpr): void {
    const tree = this.values.types.program.tree;

    let loans: Loan[] = [];

    for (const element of tree.elementsOf(init.elementsList)) {
      if (element.hole) {
        continue;
      }

      const expr = tree.exprOf(element.exprId);
      const operand = this.evaluate(expr);

      loans = loans.concat(this.loansOf(operand));
    }

    this.setHeld(key, Holding.Own, loans);
  }

  private noteBorrowDecl(key: int, loc: int): void {
    if (this.holdingOf(key) == Holding.Borrow) {
      this.borrowDecls.add(`${this.module} ${loc}`);
    }
  }

  private declaredHolding(loc: int): Holding {
    const type = this.values.variableOf(this.module, loc);
    if (type != undefined && this.values.isCopy(type)) {
      return Holding.Copy;
    }

    return Holding.Own;
  }

  private walkIf(stmt: IfStmt): void {
    const tree = this.values.types.program.tree;

    const cond = tree.exprOf(stmt.condId);

    this.evaluate(cond);

    const before = this.copyState(this.state);
    const condExpr = tree.exprOf(stmt.condId);
    const thenEmpty = this.emptiedBorrow(condExpr, BinaryOp.Eq);

    const thenStmt = tree.stmtOf(stmt.thenStmtId);

    this.walkBranch(thenStmt, thenEmpty);

    const afterThen = replace(this.state, before);

    const elseStmt = tree.stmtAt(stmt.elseStmtId);
    if (elseStmt != undefined) {
      const elseEmpty = this.emptiedBorrow(
        tree.exprOf(stmt.condId),
        BinaryOp.Ne,
      );

      this.walkBranch(elseStmt, elseEmpty);
    }

    this.state = this.merged(afterThen, this.state);
  }

  private walkBranch(stmt: Stmt, emptied: int | undefined): void {
    if (emptied == undefined) {
      return this.walkStatement(stmt);
    }

    const loans = this.takeLoans(emptied);

    this.walkStatement(stmt);
    this.setLoans(emptied, loans);
  }

  private readonly emptiedBorrow(cond: Expr, op: BinaryOp): int | undefined {
    const tree = this.values.types.program.tree;

    if (cond.kind != ExprKind.Binary || cond.op != op) {
      return undefined;
    }

    const name = this.comparedName(
      tree.exprOf(cond.lhsId),
      tree.exprOf(cond.rhsId),
    );
    if (name == undefined) {
      return undefined;
    }

    const key = this.keyOfName(name);
    if (key == undefined) {
      return undefined;
    }

    const variable = this.variableOf(key);
    if (
      variable == undefined ||
      !variable.isConst ||
      variable.holding != Holding.Borrow
    ) {
      return undefined;
    }

    return key;
  }

  private readonly comparedName(lhs: Expr, rhs: Expr): NameExpr | undefined {
    if (lhs.kind == ExprKind.Name && rhs.kind == ExprKind.Undefined) {
      return lhs;
    }
    if (rhs.kind == ExprKind.Name && lhs.kind == ExprKind.Undefined) {
      return rhs;
    }

    return undefined;
  }

  private walkLoop(cond: Expr, body: Stmt, step: Expr | undefined): void {
    const before = this.copyState(this.state);

    this.loopPass(cond, body, step);

    const first = this.state;

    this.state = this.merged(before, first);
    this.loopPass(cond, body, step);
    this.state = this.merged(before, this.state);
  }

  private loopPass(cond: Expr, body: Stmt, step: Expr | undefined): void {
    this.evaluate(cond);
    this.walkStatement(body);
    this.state.isDead = false;

    if (step != undefined) {
      this.evaluate(step);
    }
  }

  private walkFor(
    init: Stmt | undefined,
    cond: Expr | undefined,
    step: Expr | undefined,
    body: Stmt | undefined,
  ): void {
    if (init != undefined) {
      this.walkStatement(init);
    }

    const before = this.copyState(this.state);

    this.forPass(cond, step, body);

    const first = this.state;

    this.state = this.merged(before, first);
    this.forPass(cond, step, body);
    this.state = this.merged(before, this.state);
  }

  private forPass(
    cond: Expr | undefined,
    step: Expr | undefined,
    body: Stmt | undefined,
  ): void {
    if (cond != undefined) {
      this.evaluate(cond);
    }
    if (body != undefined) {
      this.walkStatement(body);
    }

    this.state.isDead = false;

    if (step != undefined) {
      this.evaluate(step);
    }
  }

  private walkForOf(stmt: ForOfStmt): void {
    const tree = this.values.types.program.tree;

    const key = stmt.binding.loc;
    const isBound = this.hasVariable(key);
    const iterable = tree.exprOf(stmt.iterableId);
    const operand = this.evaluate(iterable);

    if (isBound) {
      const end = this.lastLocOf(stmt);

      this.revive(key);
      this.noteBinding(key);
      this.setLastUse(key, end);
      this.bindElement(key, operand, stmt);
      this.noteBorrowDecl(key, key);
      this.checkUsingElement(key, stmt);
    }

    const before = this.copyState(this.state);

    const body = tree.stmtOf(stmt.bodyId);

    this.walkStatement(body);
    this.state.isDead = false;

    const first = this.state;

    this.state = this.merged(before, first);

    if (isBound) {
      this.revive(key);
    }

    const bodyStmt = tree.stmtOf(stmt.bodyId);

    this.walkStatement(bodyStmt);
    this.state = this.merged(before, this.state);
  }

  private checkUsingElement(key: int, stmt: ForOfStmt): void {
    const tree = this.values.types.program.tree;

    const binding = this.variableOf(key);
    const isBorrow = binding != undefined && binding.holding == Holding.Borrow;
    if (!stmt.isUsing || binding == undefined || !isBorrow) {
      return;
    }

    const word = binding.name;
    const iterable = tree.exprOf(stmt.iterableId);
    const other = this.exprText(iterable);

    this.errors.write(this.home, stmt.binding.loc, Code.OwnUsingBorrow, {
      word,
      other,
    });
  }

  private loopSourceLoans(operand: Read<Operand>, iterable: Expr): Loan[] {
    const place = operand.place;
    if (operand.kind == OperandKind.Place && place != undefined) {
      const element = this.extended(place, kElementStep);
      const isFrozen = this.isFrozenExpr(iterable);

      return this.loansOfPlaceAs(element, LoanKind.Shared, isFrozen);
    }
    if (operand.kind == OperandKind.Borrowed) {
      return operand.loans.slice();
    }

    return [];
  }

  private bindElement(key: int, operand: Read<Operand>, stmt: ForOfStmt): void {
    const tree = this.values.types.program.tree;

    if (!this.hasVariable(key)) {
      return;
    }

    const isChanged = this.isChangedVariable(key);
    const type = this.values.variableOf(this.module, stmt.binding.loc);
    if (type != undefined && this.values.isCopy(type)) {
      const iterableExpr = tree.exprOf(stmt.iterableId);
      const loans = this.loopSourceLoans(operand, iterableExpr);

      this.setHeld(key, Holding.Copy, loans);

      return;
    }

    const place = operand.place;
    if (operand.kind == OperandKind.Place && place != undefined) {
      const element = this.extended(place, kElementStep);
      const kind = this.loanKindOf(isChanged);

      if (kind == LoanKind.Exclusive) {
        this.changePlaceExcept(element, stmt.loc, key);
      }

      const iterable = tree.exprOf(stmt.iterableId);
      const isShared = kind == LoanKind.Shared;
      const isFrozen = isShared && this.isFrozenExpr(iterable);
      const loans = this.loansOfPlaceAs(element, kind, isFrozen);

      this.setHeld(key, Holding.Borrow, loans);

      return;
    }
    if (operand.kind == OperandKind.Borrowed) {
      this.setHolding(key, Holding.Borrow);

      const loans = this.inferredLoans(key, operand, stmt.loc);

      this.setLoans(key, loans);

      return;
    }

    this.setHolding(key, Holding.Own);
  }

  private readonly loanKindOf(isChanged: boolean): LoanKind {
    if (isChanged) {
      return LoanKind.Exclusive;
    }

    return LoanKind.Shared;
  }

  private walkSwitch(stmt: SwitchStmt): void {
    const tree = this.values.types.program.tree;

    const discriminant = tree.exprOf(stmt.discriminantId);

    this.evaluate(discriminant);

    const before = this.copyState(this.state);
    let after: FlowState = { moved: [], isDead: true };

    for (const option of tree.casesOf(stmt.casesList)) {
      this.state = this.copyState(before);

      const test = tree.exprAt(option.testId);
      if (test != undefined) {
        this.evaluate(test);
      }

      const body = tree.stmtsOf(option.bodyList);

      this.walkStatements(body);
      after = this.merged(after, this.state);
    }

    this.state = this.merged(after, before);
  }
}
