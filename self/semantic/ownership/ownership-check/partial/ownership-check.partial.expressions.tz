import { replace } from "tz:mem";
import { OwnershipCheck } from "../ownership-check.tz";
import { Code } from "../../../../diagnostic/code.tz";
import {
  ArrayLitExpr,
  BinaryExpr,
  BinaryOp,
  ConditionalExpr,
  Expr,
  ExprKind,
  IndexExpr,
  MemberExpr,
  NameExpr,
  ObjectLitExpr,
  Property,
  PropertyKind,
  UnaryOp,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { SymbolKind } from "../../../../program/scopes/types/scopes.types.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";
import {
  CallbackMode,
  Holding,
  Loan,
  Operand,
  OperandKind,
  Place,
  Variable,
} from "../types/ownership-check.types.tz";
import {
  kElementStep,
  kSymbolEqualsKey,
  kThisName,
} from "../const/ownership-check.const.tz";
import { MethodKind } from "../../../../program/ast/types/ast.types.classes.tz";

partial class OwnershipCheck {
  private evaluate(expr: Expr): Operand {
    return this.evaluateFor(expr, CallbackMode.Local);
  }

  private evaluateFor(expr: Expr, callback: CallbackMode): Operand {
    const tree = this.values.types.program.tree;

    switch (expr.kind) {
      case ExprKind.Name:
        return this.evaluateName(expr, true);
      case ExprKind.Member:
        return this.evaluateMember(expr, true);
      case ExprKind.Index:
        return this.evaluateIndex(expr, true);
      case ExprKind.Unary:
        return this.evaluateUnary(
          expr.op,
          tree.exprOf(expr.operandId),
          expr.loc,
        );
      case ExprKind.Binary:
        return this.evaluateBinary(expr);
      case ExprKind.Assign:
        return this.evaluateAssign(expr);
      case ExprKind.Update:
        const target = tree.exprOf(expr.targetId);

        this.changePlaceOf(target, expr.loc);
        return this.copyOperand(expr.loc);
      case ExprKind.Call:
        return this.evaluateCall(expr);
      case ExprKind.New:
        return this.evaluateNew(expr);
      case ExprKind.Conditional:
        return this.evaluateConditional(expr);
      case ExprKind.Cast:
        const operand = tree.exprOf(expr.operandId);

        return this.evaluateFor(operand, callback);
      case ExprKind.OptionalChain:
        const chain = tree.exprOf(expr.chainId);

        return this.evaluateFor(chain, callback);
      case ExprKind.Sequence:
        const exprs = tree.exprsOf(expr.exprsList);

        return this.evaluateSequence(exprs, expr.loc);
      case ExprKind.Template:
        const exprsItem = tree.exprsOf(expr.exprsList);

        return this.evaluateUsed(exprsItem, expr.loc);
      case ExprKind.ArrayLit:
        return this.evaluateArray(expr);
      case ExprKind.ObjectLit:
        return this.evaluateObject(expr);
      case ExprKind.Function:
        const fn = tree.functionOf(expr.fnId);

        this.closure(fn, callback, expr.loc);
        return this.freshOperand(expr.loc);
      case ExprKind.Await:
        const value = tree.exprOf(expr.valueId);

        return this.evaluateAwait(value, expr.loc);
      case ExprKind.Yield:
        const valueExpr = tree.exprAt(expr.valueId);

        return this.evaluateYield(valueExpr, expr.loc);
      case ExprKind.RegexLit:
      case ExprKind.Class:
        return this.freshOperand(expr.loc);
      default:
        return this.copyOperand(expr.loc);
    }
  }

  private evaluateBase(expr: Expr): Operand {
    const tree = this.values.types.program.tree;

    switch (expr.kind) {
      case ExprKind.Name:
        return this.evaluateName(expr, false);
      case ExprKind.Member:
        return this.evaluateMember(expr, false);
      case ExprKind.Index:
        return this.evaluateIndex(expr, false);
      case ExprKind.Cast:
        const operand = tree.exprOf(expr.operandId);

        return this.evaluateBase(operand);
      case ExprKind.OptionalChain:
        const chain = tree.exprOf(expr.chainId);

        return this.evaluateBase(chain);
      case ExprKind.Unary:
        if (expr.op == UnaryOp.NonNull) {
          const operandExpr = tree.exprOf(expr.operandId);

          return this.evaluateBase(operandExpr);
        }
        return this.evaluate(expr);
      default:
        return this.evaluate(expr);
    }
  }

  private evaluateName(expr: NameExpr, isChecked: boolean): Operand {
    const key = this.keyOfName(expr);
    if (key == undefined) {
      return this.copyOperand(expr.loc);
    }

    if (!this.isKnownVariable(expr, key)) {
      return this.copyOperand(expr.loc);
    }

    const holding = this.holdingOf(key);
    const place = this.wholePlace(key);

    if (isChecked || holding == Holding.Copy) {
      this.checkUsable(place, expr.loc);
    }
    if (holding == Holding.Copy && !this.isWidened(expr)) {
      return this.copyOperand(expr.loc);
    }
    if (isChecked && this.isCopyExpr(expr)) {
      return this.copyOperand(expr.loc);
    }

    return this.placeOperand(place, expr.loc);
  }

  private isKnownVariable(expr: NameExpr, key: int): boolean {
    if (this.hasVariable(key)) {
      return true;
    }

    const target = this.values.valueTargetOf(expr, this.module);
    if (target == undefined || target.kind != SymbolKind.Variable) {
      return false;
    }

    this.noteConstantPlace(key, target.module, target.loc);

    return this.addGlobal(key, expr.name);
  }

  private evaluateMember(expr: MemberExpr, isChecked: boolean): Operand {
    const tree = this.values.types.program.tree;

    const fromStatic = this.staticOperand(expr, isChecked);
    if (fromStatic != undefined) {
      return fromStatic;
    }

    const objectExpr = tree.exprOf(expr.objectId);
    const object = this.evaluateBase(objectExpr);
    const inner = this.stepInto(object, expr.name, expr.loc, isChecked);
    if (isChecked && this.isCopyExpr(expr)) {
      return this.copyOperand(expr.loc);
    }

    return inner;
  }

  private readonly indexStep(expr: IndexExpr): string {
    const tree = this.values.types.program.tree;

    const index = tree.exprOf(expr.indexId);
    if (index.kind != ExprKind.IntLit || !this.isTupleItem(expr)) {
      return kElementStep;
    }

    const position = index.value.toInt();

    return `${position}`;
  }

  private evaluateIndex(expr: IndexExpr, isChecked: boolean): Operand {
    const tree = this.values.types.program.tree;

    const objectExpr = tree.exprOf(expr.objectId);
    const object = this.evaluateBase(objectExpr);

    const index = tree.exprOf(expr.indexId);

    this.evaluate(index);

    const step = this.indexStep(expr);
    const inner = this.stepInto(object, step, expr.loc, isChecked);
    if (isChecked && this.isCopyExpr(expr)) {
      return this.copyOperand(expr.loc);
    }

    return inner;
  }

  private stepInto(
    object: Read<Operand>,
    step: string,
    loc: int,
    isChecked: boolean,
  ): Operand {
    const place = object.place;

    return this.stepped(object, step, loc, isChecked, place);
  }

  private stepped(
    object: Read<Operand>,
    step: string,
    loc: int,
    isChecked: boolean,
    place: Read<Place | undefined>,
  ): Operand {
    switch (object.kind) {
      case OperandKind.Place: {
        if (place == undefined) {
          return this.freshOperand(loc);
        }

        const inner = this.extended(place, step);

        if (isChecked) {
          this.checkUsable(inner, loc);
        }

        return this.placeOperand(inner, loc);
      }
      case OperandKind.Borrowed:
        return this.borrowedOperand(object.loans.slice(), loc);
      case OperandKind.Copy:
        return this.copyOperand(loc);
      default:
        return this.freshOperand(loc);
    }
  }

  private evaluateUnary(op: UnaryOp, operand: Expr, loc: int): Operand {
    if (op == UnaryOp.NonNull) {
      return this.evaluate(operand);
    }
    if (op == UnaryOp.Delete) {
      this.changePlaceOf(operand, loc);

      return this.copyOperand(loc);
    }

    this.evaluate(operand);

    return this.copyOperand(loc);
  }

  private evaluateBinary(expr: BinaryExpr): Operand {
    const tree = this.values.types.program.tree;

    const isLogical =
      expr.op == BinaryOp.LogAnd ||
      expr.op == BinaryOp.LogOr ||
      expr.op == BinaryOp.Nullish;
    if (!isLogical) {
      const lhsExpr = tree.exprOf(expr.lhsId);

      this.evaluate(lhsExpr);
      const rhsExpr = tree.exprOf(expr.rhsId);

      this.evaluate(rhsExpr);
      this.checkEquality(expr);

      return this.copyOperand(expr.loc);
    }

    const exprLhs = tree.exprOf(expr.lhsId);
    const lhs = this.evaluate(exprLhs);
    const before = this.copyState(this.state);
    const exprRhs = tree.exprOf(expr.rhsId);
    const rhs = this.evaluate(exprRhs);

    this.state = this.merged(before, this.state);

    if (this.isCopyExpr(expr)) {
      return this.copyOperand(expr.loc);
    }

    return this.either(lhs, rhs, expr.loc);
  }

  private checkEquality(expr: BinaryExpr): void {
    const tree = this.values.types.program.tree;

    if (expr.op != BinaryOp.Eq && expr.op != BinaryOp.Ne) {
      return;
    }
    if (
      this.isUndefinedSide(tree.exprOf(expr.lhsId)) ||
      this.isUndefinedSide(tree.exprOf(expr.rhsId))
    ) {
      return;
    }

    const name =
      this.equalityWithout(tree.exprOf(expr.lhsId)) ??
      this.equalityWithout(tree.exprOf(expr.rhsId));
    if (name != undefined) {
      this.errors.write(this.home, expr.loc, Code.OwnEqualsMissing, {
        word: name,
      });
    }
  }

  private readonly isUndefinedSide(side: Expr): boolean {
    const type = this.values.answers.typeOf(side);

    return type == undefined || type.kind == TypeKind.Undefined;
  }

  private equalityWithout(side: Expr): string | undefined {
    const type = this.values.answers.typeOf(side);
    const name = type == undefined ? undefined : this.copiedName(type);
    if (type == undefined || name == undefined) {
      return undefined;
    }

    const decl = this.values.classDeclOf(type);
    if (decl != undefined && this.hasMethod(decl, kSymbolEqualsKey)) {
      return undefined;
    }

    return name;
  }

  private evaluateConditional(expr: ConditionalExpr): Operand {
    const tree = this.values.types.program.tree;

    const cond = tree.exprOf(expr.condId);

    this.evaluate(cond);

    const before = this.copyState(this.state);
    const thenExpr = tree.exprOf(expr.thenExprId);
    const first = this.evaluate(thenExpr);
    const afterThen = replace(this.state, before);

    const elseExpr = tree.exprOf(expr.elseExprId);
    const second = this.evaluate(elseExpr);

    this.state = this.merged(afterThen, this.state);

    if (this.isCopyExpr(expr)) {
      return this.copyOperand(expr.loc);
    }

    return this.either(first, second, expr.loc);
  }

  private readonly either(
    first: Own<Operand>,
    second: Own<Operand>,
    loc: int,
  ): Operand {
    const bothFresh =
      this.isFreshLike(first.kind) && this.isFreshLike(second.kind);
    if (bothFresh) {
      return this.freshOperand(loc);
    }
    if (this.isFreshLike(first.kind)) {
      return second;
    }
    if (this.isFreshLike(second.kind)) {
      return first;
    }

    const loans: Loan[] = this.loansOf(first).concat(this.loansOf(second));

    return this.borrowedOperand(loans, loc);
  }

  private readonly isFreshLike(kind: OperandKind): boolean {
    return (
      kind == OperandKind.Fresh ||
      kind == OperandKind.Copy ||
      kind == OperandKind.Nothing
    );
  }

  private evaluateSequence(exprs: Read<Expr[]>, loc: int): Operand {
    let last: Operand = this.copyOperand(loc);

    for (const expr of exprs) {
      last = this.evaluate(expr);
    }

    return last;
  }

  private evaluateUsed(exprs: Read<Expr[]>, loc: int): Operand {
    for (const expr of exprs) {
      this.evaluate(expr);
    }

    return this.copyOperand(loc);
  }

  private evaluateArray(expr: ArrayLitExpr): Operand {
    const tree = this.values.types.program.tree;

    const elements = tree.elementsOf(expr.elementsList);

    for (let index: int = 0; index < elements.length; index++) {
      const element = elements[index];
      if (element == undefined || element.hole) {
        continue;
      }

      const item = tree.exprOf(element.exprId);
      const wanted = this.elementWanted(expr, index, element.spread);

      this.widenFor(item, wanted);

      const operand = this.evaluateFor(item, CallbackMode.Kept);
      if (
        element.spread &&
        this.isSpreadOfCopies(tree.exprOf(element.exprId))
      ) {
        continue;
      }

      const exprExpr = tree.exprOf(element.exprId);

      this.take(operand, exprExpr);
    }

    return this.freshOperand(expr.loc);
  }

  private isSpreadOfCopies(expr: Expr): boolean {
    const type = this.values.answers.typeOf(expr);
    const item = type == undefined ? undefined : this.values.iteratedItem(type);

    return item != undefined && this.values.isCopy(item);
  }

  private evaluateObject(expr: ObjectLitExpr): Operand {
    const tree = this.values.types.program.tree;

    for (const property of tree.propertiesOf(expr.propsList)) {
      const form = property.form;
      if (form.kind == PropertyKind.Computed) {
        const key = tree.exprOf(form.keyId);

        this.evaluate(key);
      }
      if (form.kind == PropertyKind.Method) {
        continue;
      }
      if (form.kind != PropertyKind.Spread) {
        const valueExpr = tree.exprOf(property.valueId);
        const wanted = this.propertyWanted(expr, property.name);

        this.widenFor(valueExpr, wanted);
      }

      const operand = this.evaluateFor(
        tree.exprOf(property.valueId),
        CallbackMode.Kept,
      );
      const place = operand.place;
      const isFields =
        form.kind == PropertyKind.Spread &&
        operand.kind == OperandKind.Place &&
        place != undefined;
      if (isFields && place != undefined) {
        this.takeFields(expr, property, place);

        continue;
      }

      const value = tree.exprOf(property.valueId);

      this.take(operand, value);
    }

    return this.freshOperand(expr.loc);
  }

  private takeFields(
    expr: ObjectLitExpr,
    spread: Property,
    place: Place,
  ): void {
    const tree = this.values.types.program.tree;

    const later = tree
      .propertiesOf(expr.propsList)
      .slice(
        tree
          .propertiesOf(expr.propsList)
          .findIndex((one) => one.loc == spread.loc) + 1,
      );

    for (const name of this.spreadFieldNames(tree.exprOf(spread.valueId))) {
      const isWritten = later.some(
        (one) => one.form.kind != PropertyKind.Spread && one.name == name,
      );
      if (isWritten) {
        continue;
      }

      const field = this.extended(place, name);
      const value = tree.exprOf(spread.valueId);
      const type = this.spreadFieldType(value, name);
      if (type != undefined && this.values.isCopy(type)) {
        continue;
      }

      this.take(
        this.placeOperand(field, tree.exprOf(spread.valueId).loc),
        tree.exprOf(spread.valueId),
      );
    }
  }

  private readonly spreadFieldNames(value: Expr): string[] {
    const tree = this.values.types.program.tree;

    const type = this.values.answers.typeOf(value);
    if (type == undefined) {
      return [];
    }
    if (type.kind == TypeKind.Object) {
      return this.values.types.store.fieldsOf(type).map((field) => field.name);
    }

    const decl = this.values.classDeclOf(type);

    return tree.fieldsOf(decl?.fieldsList).map((field) => field.name) ?? [];
  }

  private readonly spreadFieldType(
    value: Expr,
    name: string,
  ): Type | undefined {
    const type = this.values.answers.typeOf(value);
    if (type == undefined || type.kind != TypeKind.Object) {
      return undefined;
    }

    return this.values.types.store
      .fieldsOf(type)
      .find((field) => field.name == name)?.type;
  }

  private evaluateAwait(value: Expr, loc: int): Operand {
    this.evaluate(value);

    return this.freshOperand(loc);
  }

  private evaluateYield(value: Expr | undefined, loc: int): Operand {
    if (value != undefined) {
      const operand = this.evaluate(value);

      this.take(operand, value);
    }

    return this.freshOperand(loc);
  }

  private isCopyExpr(expr: Expr): boolean {
    const type = this.values.answers.typeOf(expr);
    if (type == undefined) {
      return true;
    }
    if (this.isWidened(expr)) {
      return false;
    }
    if (!this.values.isCopy(type)) {
      return false;
    }
    if (this.isValueCopy(type)) {
      return true;
    }

    return !this.isOwnDeclaredName(expr);
  }

  private readonly isValueCopy(type: Type): boolean {
    switch (type.kind) {
      case TypeKind.Boolean:
      case TypeKind.Double:
      case TypeKind.Decimal:
      case TypeKind.String:
      case TypeKind.Int:
      case TypeKind.Literal:
      case TypeKind.Template:
        return true;
      default:
        return false;
    }
  }

  private isOwnDeclaredName(expr: Expr): boolean {
    if (expr.kind != ExprKind.Name) {
      return false;
    }

    const target = this.values.valueTargetOf(expr, this.module);
    if (target == undefined || target.kind != SymbolKind.Variable) {
      return false;
    }

    const declared = this.values.variableOf(target.module, target.loc);

    return declared != undefined && !this.values.isCopy(declared);
  }

  private readonly loansOf(operand: Read<Operand>): Loan[] {
    const place = operand.place;
    if (operand.kind == OperandKind.Borrowed) {
      return operand.loans.slice();
    }
    if (operand.kind == OperandKind.Place && place != undefined) {
      return this.loansOfPlace(place);
    }

    return [];
  }

  private readonly copyOperand(loc: int): Operand {
    return { kind: OperandKind.Copy, loans: [], loc };
  }

  private readonly freshOperand(loc: int): Operand {
    return { kind: OperandKind.Fresh, loans: [], loc };
  }

  private readonly placeOperand(place: Own<Place>, loc: int): Operand {
    return { kind: OperandKind.Place, place, loans: [], loc };
  }

  private readonly borrowedOperand(loans: Own<Loan[]>, loc: int): Operand {
    return { kind: OperandKind.Borrowed, loans, loc };
  }
}
