import { replace } from "tz:mem";
import { OwnershipCheck } from "../ownership-check.tz";
import { Code } from "../../../../diagnostic/code.tz";
import {
  ClassDecl,
  MethodKind,
} from "../../../../program/ast/types/ast.types.classes.tz";
import {
  FunctionDecl,
  FunctionPlace,
  Param,
  ParamKind,
} from "../../../../program/ast/types/ast.types.functions.tz";
import {
  Stmt,
  StmtKind,
} from "../../../../program/ast/types/ast.types.statements.tz";
import {
  TypeRef,
  TypeRefKind,
} from "../../../../program/ast/types/ast.types.types.tz";
import { Module } from "../../../../program/module/types/module.types.tz";
import {
  FunctionShape,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import {
  CallbackMode,
  FunctionFrame,
  Holding,
  ParamMode,
  ResultMode,
  Variable,
} from "../types/ownership-check.types.tz";
import {
  kLentName,
  kMutName,
  kOnceName,
  kOwnName,
  kReadName,
  kThisKey,
} from "../const/ownership-check.const.tz";

partial class OwnershipCheck {
  private checkModule(module: Read<Module>): void {
    const tree = this.values.types.program.tree;

    this.module = module.id;
    this.home = module.id;

    const frame = this.emptyFrame(undefined, undefined, CallbackMode.During);

    const items = tree.stmtsOf(module.file.itemsList);

    this.reportGlobalLets(items);
    const itemsItem = tree.stmtsOf(module.file.itemsList);

    this.runFrame(frame, itemsItem);

    for (const item of tree.stmtsOf(module.file.itemsList)) {
      this.checkDeclared(item, false);
    }
    for (const part of tree.classesOf(module.partsList)) {
      this.checkClass(part, false);
    }
  }

  private reportGlobalLets(items: Read<Stmt[]>): void {
    const tree = this.values.types.program.tree;

    for (const item of items) {
      if (item.kind != StmtKind.VarDecl || item.isConst) {
        continue;
      }

      for (const declarator of tree.declaratorsOf(item.declsList)) {
        this.errors.write(this.home, declarator.loc, Code.OwnGlobalLet, {
          word: declarator.name,
        });
      }
    }
  }

  private checkDeclared(stmt: Stmt, isNested: boolean): void {
    switch (stmt.kind) {
      case StmtKind.Function:
        this.checkFunction(stmt, undefined, CallbackMode.During, isNested);
        break;
      case StmtKind.Class:
        this.checkClass(stmt, isNested);
        break;
      default:
        break;
    }
  }

  private checkClass(decl: ClassDecl, isNested: boolean): void {
    const tree = this.values.types.program.tree;

    for (const field of tree.fieldsOf(decl.fieldsList)) {
      const ref = tree.typeRefAt(field.typeId);
      if (ref != undefined && this.holdsBorrowRef(ref)) {
        this.errors.write(this.home, field.loc, Code.OwnBorrowField, {
          word: field.name,
        });
      }
    }

    for (const method of tree.functionsOf(decl.methodsList)) {
      const isPart = !decl.isPartial && this.partHomes.has(method.id);
      if (!isPart) {
        this.checkFunction(method, decl, CallbackMode.During, isNested);
      }
    }

    for (const made of tree.functionsOf(decl.constructorsList)) {
      this.checkFunction(made, decl, CallbackMode.During, isNested);
    }
  }

  private checkFunction(
    fn: FunctionDecl,
    owner: ClassDecl | undefined,
    callback: CallbackMode,
    isNested: boolean,
  ): void {
    const tree = this.values.types.program.tree;

    const body = tree.blockAt(fn.bodyId);
    if (body == undefined) {
      return;
    }

    const frame = this.emptyFrame(fn, owner, callback);
    const shape = this.shapeOf(fn);

    this.addThis(frame, fn, owner);

    for (
      let index: int = 0;
      index < tree.paramsOf(fn.paramsList).length;
      index++
    ) {
      const param = tree.paramsOf(fn.paramsList)[index];
      if (param != undefined) {
        const type = this.paramTypeOf(shape, index);

        this.addParam(frame, param, type);
      }
    }

    if (isNested) {
      this.copyOuter(frame);
    }

    const saved = replace(this.state, { moved: [], isDead: false });
    const bodyItem = tree.stmtsOf(body.bodyList);

    this.runFrame(frame, bodyItem);
    this.state = saved;
  }

  private runFrame(frame: Own<FunctionFrame>, items: Read<Stmt[]>): void {
    this.collectUses(frame, items);
    this.frames.push(frame);
    this.walkStatements(items);

    const done = this.frames.pop();
    if (done != undefined) {
      this.noteHints(done);
    }
  }

  private noteHints(frame: Read<FunctionFrame>): void {
    const tree = this.values.types.program.tree;

    const fn = frame.fn;
    if (fn == undefined || fn.isArrow) {
      return;
    }

    const role = fn.role;
    const isPlainMethod =
      role != undefined &&
      role.method == MethodKind.Instance &&
      !role.isOverride &&
      !role.isReadonly &&
      frame.result != ResultMode.Mut;
    const self = frame.variables.get(kThisKey);
    if (isPlainMethod && self != undefined && !self.isChanged) {
      this.hint(fn.loc, "readonly-method", fn.name);
    }

    for (const param of tree.paramsOf(fn.paramsList)) {
      const variable = frame.variables.get(param.loc);
      if (variable == undefined || variable.holding != Holding.Lent) {
        continue;
      }
      if (!variable.isReadOnly && !variable.isChanged) {
        this.hint(param.loc, "read-param", param.name);
      }
    }
  }

  private readonly emptyFrame(
    fn: FunctionDecl | undefined,
    owner: ClassDecl | undefined,
    callback: CallbackMode,
  ): FunctionFrame {
    const result = this.resultModeOf(fn);

    return {
      fn,
      module: this.module,
      owner,
      variables: new Map<int, Variable>(),
      lentParams: new Set<int>(),
      result,
      thisHolding: Holding.Copy,
      callback,
      loops: [],
      outer: new Set<int>(),
      bindings: new Set<int>(),
      globals: new Set<int>(),
    };
  }

  private readonly copyOuter(frame: FunctionFrame): void {
    const outer = this.frame();
    if (outer == undefined) {
      return;
    }

    for (const variable of outer.variables.values()) {
      if (frame.variables.has(variable.key)) {
        continue;
      }

      const holding = this.capturedHolding(frame, variable);
      const isGlobal =
        holding == Holding.Global || holding == Holding.Static;

      if (isGlobal) {
        frame.globals.add(variable.key);
      }

      frame.variables.set(variable.key, {
        key: variable.key,
        name: variable.name,
        holding,
        loans: [],
        isReadOnly: variable.isReadOnly,
        isConst: variable.isConst,
        isUsing: variable.isUsing,
        declared: -1,
        lastUse: -1,
        isChanged: false,
      });
      frame.outer.add(variable.key);
    }
  }

  private readonly capturedHolding(
    frame: Read<FunctionFrame>,
    variable: Read<Variable>,
  ): Holding {
    if (variable.holding == Holding.Copy) {
      return Holding.Copy;
    }
    if (variable.holding == Holding.Static) {
      return Holding.Static;
    }
    if (variable.holding == Holding.Global) {
      return Holding.Global;
    }
    if (
      variable.holding == Holding.Own &&
      frame.callback == CallbackMode.Once
    ) {
      return Holding.Own;
    }

    return Holding.Lent;
  }

  private readonly addThis(
    frame: FunctionFrame,
    fn: FunctionDecl,
    owner: ClassDecl | undefined,
  ): void {
    const role = fn.role;
    if (owner == undefined || role == undefined) {
      return;
    }
    if (role.method == MethodKind.Static) {
      return;
    }

    const isConstructor = role.method == MethodKind.Constructor;
    let holding: Holding = Holding.Lent;

    if (isConstructor) {
      holding = Holding.Own;
    }

    frame.variables.set(kThisKey, {
      key: kThisKey,
      name: "this",
      holding,
      loans: [],
      isReadOnly: role.isReadonly,
      isConst: true,
      isUsing: false,
      declared: fn.loc,
      lastUse: -1,
      isChanged: false,
    });
  }

  private addParam(
    frame: FunctionFrame,
    param: Param,
    type: Type | undefined,
  ): void {
    const tree = this.values.types.program.tree;

    const mode = this.paramMode(param);
    const holding = this.paramHolding(mode, type);

    if (mode == ParamMode.Lent) {
      frame.lentParams.add(param.loc);
    }
    if (
      mode == ParamMode.Lent &&
      type != undefined &&
      this.values.isCopy(type)
    ) {
      this.errors.write(this.home, param.loc, Code.OwnLentCopy, {
        word: param.name,
      });
    }

    const isMarkedMut =
      tree.typeRefAt(param.typeId)?.name == kMutName &&
      tree.typeRefsOf(tree.typeRefAt(param.typeId)?.argsList).length == 1;
    if (isMarkedMut && type != undefined && this.values.isCopy(type)) {
      this.errors.write(this.home, param.loc, Code.OwnMutCopy, {
        word: param.name,
      });
    }

    frame.variables.set(param.loc, {
      key: param.loc,
      name: param.name,
      holding,
      loans: [],
      isReadOnly: mode == ParamMode.Read || mode == ParamMode.Lent,
      isConst: true,
      isUsing: false,
      declared: param.loc,
      lastUse: -1,
      isChanged: false,
    });
  }

  private paramHolding(mode: ParamMode, type: Type | undefined): Holding {
    if (type != undefined && this.values.isCopy(type)) {
      return Holding.Copy;
    }
    if (mode == ParamMode.Own || mode == ParamMode.Once) {
      return Holding.Own;
    }

    return Holding.Lent;
  }

  private readonly holdsBorrowRef(ref: TypeRef): boolean {
    const tree = this.values.types.program.tree;

    if (this.isBorrowRef(ref)) {
      return true;
    }

    return tree
      .typeRefsOf(ref.argsList)
      .some((arg) => this.holdsBorrowRef(arg));
  }

  private readonly isBorrowRef(ref: TypeRef): boolean {
    const tree = this.values.types.program.tree;

    if (ref.form.kind == TypeRefKind.Array) {
      const item = tree.typeRefsOf(ref.argsList)[0];

      return item != undefined && this.isBorrowRef(item);
    }
    if (ref.form.kind == TypeRefKind.Tuple) {
      const parts = tree.tupleElementsOf(ref.form.elementsList);

      return (
        parts.length > 0 &&
        parts.every((part) => this.isBorrowRef(tree.typeRefOf(part.typeId)))
      );
    }
    const args = tree.typeRefsOf(ref.argsList);
    if (args.length != 1) {
      return false;
    }

    return (
      ref.name == kReadName || ref.name == kMutName || ref.name == kLentName
    );
  }

  private readonly paramMode(param: Param): ParamMode {
    const tree = this.values.types.program.tree;

    const ref = tree.typeRefAt(param.typeId);
    if (ref == undefined) {
      return ParamMode.Mut;
    }
    if (
      param.form.kind == ParamKind.Rest &&
      ref.form.kind == TypeRefKind.Array
    ) {
      const item = tree.typeRefsOf(ref.argsList)[0];
      if (item != undefined) {
        return this.modeOfRef(item);
      }
    }

    return this.modeOfRef(ref);
  }

  private readonly modeOfRef(ref: TypeRef): ParamMode {
    const tree = this.values.types.program.tree;

    const args = tree.typeRefsOf(ref.argsList);
    if (args.length != 1) {
      return ParamMode.Mut;
    }

    switch (ref.name) {
      case kReadName:
        return ParamMode.Read;
      case kOwnName:
        return ParamMode.Own;
      case kLentName:
        return ParamMode.Lent;
      case kOnceName:
        return ParamMode.Once;
      default:
        return ParamMode.Mut;
    }
  }

  private readonly resultModeOf(fn: FunctionDecl | undefined): ResultMode {
    const tree = this.values.types.program.tree;

    const ref = tree.typeRefAt(fn?.returnTypeId);
    if (ref == undefined) {
      return ResultMode.Own;
    }

    return this.resultModeOfRef(ref);
  }

  private readonly resultModeOfRef(ref: TypeRef): ResultMode {
    const tree = this.values.types.program.tree;

    const item = tree.typeRefsOf(ref.argsList)[0];
    if (ref.form.kind == TypeRefKind.Array && item != undefined) {
      return this.resultModeOfRef(item);
    }
    if (ref.form.kind == TypeRefKind.Union) {
      for (const part of tree.typeRefsOf(ref.argsList)) {
        const mode = this.resultModeOfRef(part);
        if (mode != ResultMode.Own) {
          return mode;
        }
      }

      return ResultMode.Own;
    }
    const args = tree.typeRefsOf(ref.argsList);
    if (args.length != 1) {
      return ResultMode.Own;
    }
    if (ref.name == kReadName) {
      return ResultMode.Read;
    }
    if (ref.name == kMutName) {
      return ResultMode.Mut;
    }

    return ResultMode.Own;
  }

  private readonly shapeOf(fn: FunctionDecl): FunctionShape | undefined {
    const type = this.functionTypeOf(fn);
    if (type == undefined || type.kind != TypeKind.Function) {
      return undefined;
    }

    return this.values.types.store.functionShapeOf(type);
  }

  private readonly functionTypeOf(fn: FunctionDecl): Type | undefined {
    if (fn.place != FunctionPlace.Expression) {
      return this.values.functionOf(this.module, fn.loc);
    }

    return this.values.typedFunctionOf(this.module, fn.loc);
  }

  private readonly paramTypeOf(
    shape: Read<FunctionShape | undefined>,
    index: int,
  ): Type | undefined {
    if (shape == undefined) {
      return undefined;
    }

    const param = shape.params[index];
    if (param == undefined) {
      return undefined;
    }

    return param.type;
  }

  private noteOwnCode(module: Read<Module>): void {
    const tree = this.values.types.program.tree;

    for (const item of tree.stmtsOf(module.file.itemsList)) {
      if (item.kind == StmtKind.Function) {
        this.ownCode.add(item.id);
      }
      if (item.kind != StmtKind.Class) {
        continue;
      }
      for (const method of tree.functionsOf(item.methodsList)) {
        this.ownCode.add(method.id);
      }
      for (const made of tree.functionsOf(item.constructorsList)) {
        this.ownCode.add(made.id);
      }
    }
    for (const part of tree.classesOf(module.partsList)) {
      for (const method of tree.functionsOf(part.methodsList)) {
        this.ownCode.add(method.id);
      }
    }
  }
}
