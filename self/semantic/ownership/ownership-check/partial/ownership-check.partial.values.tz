import { OwnershipCheck } from "../ownership-check.tz";
import { Code } from "../../../../diagnostic/code.tz";
import {
  Expr,
  ExprKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { TypeKind } from "../../../../program/type/types/type.types.tz";
import {
  Holding,
  Loan,
  LoanKind,
  Operand,
  OperandKind,
  Place,
  Variable,
} from "../types/ownership-check.types.tz";
import {
  kElementStep,
  kLengthName,
  kThisKey,
} from "../const/ownership-check.const.tz";

partial class OwnershipCheck {
  private take(operand: Read<Operand>, expr: Expr): void {
    const place = operand.place;

    this.checkWidenedPart(operand, expr);

    switch (operand.kind) {
      case OperandKind.Borrowed: {
        const word = this.exprText(expr);

        this.errors.write(this.home, expr.loc, Code.OwnStoreBorrow, { word });
        return;
      }
      case OperandKind.Place:
        if (place != undefined) {
          this.takePlace(place, expr);
        }
        return;
      default:
        return;
    }
  }

  private takePlace(place: Place, expr: Expr): void {
    const holding = this.holdingOf(place.root);
    const word = this.placeText(place);
    if (holding == undefined) {
      return;
    }

    const isOwnField = place.root == kThisKey && place.depth > 0;
    if (holding == Holding.Own && isOwnField) {
      this.errors.write(this.home, expr.loc, Code.OwnTakeBorrowed, { word });

      return;
    }

    switch (holding) {
      case Holding.Own:
        return this.ownedTaken(place, expr);
      case Holding.Copy:
        return this.copyTaken(place, expr);
      case Holding.Borrow:
        this.errors.write(this.home, expr.loc, Code.OwnStoreBorrow, { word });
        return;
      case Holding.Lent:
        return this.reportLentTaken(place.root, place, expr.loc);
      case Holding.Global:
        this.errors.write(this.home, expr.loc, Code.OwnGiveGlobal, { word });
        return;
      case Holding.Static:
        this.errors.write(this.home, expr.loc, Code.OwnStaticGiven, { word });
        return;
      default:
        return;
    }
  }

  private readonly isTupleItem(expr: Expr): boolean {
    const tree = this.values.types.program.tree;

    if (
      expr.kind != ExprKind.Index ||
      tree.exprOf(expr.indexId).kind != ExprKind.IntLit
    ) {
      return false;
    }

    const objectExpr = tree.exprOf(expr.objectId);
    const object = this.values.answers.typeOf(objectExpr);

    return object != undefined && object.kind == TypeKind.Tuple;
  }

  private ownedTaken(place: Place, expr: Expr): void {
    const isWhole = place.depth == 0;
    const isField = expr.kind == ExprKind.Member || this.isTupleItem(expr);
    const isMoved = this.moveOwned(place, expr.loc);

    if (isMoved && (isWhole || isField)) {
      this.moveUses.add(expr.id);
    }
  }

  private moveOwned(place: Place, loc: int): boolean {
    if (this.stepsOf(place).includes(kElementStep)) {
      const word = this.placeText(place);

      this.errors.write(this.home, loc, Code.OwnTakeElement, { word });

      return false;
    }
    if (!this.checkUsable(place, loc)) {
      return false;
    }

    this.checkWrite(place, loc, true);
    this.markMoved(place, loc);

    return true;
  }

  private reportLentTaken(key: int, place: Place, loc: int): void {
    const frame = this.frame();
    const word = this.placeText(place);
    const isParam =
      frame != undefined &&
      place.depth == 0 &&
      key != kThisKey &&
      !frame.outer.has(key);

    if (isParam) {
      this.errors.write(this.home, loc, Code.OwnNeedsOwnParam, { word });

      return;
    }

    this.errors.write(this.home, loc, Code.OwnTakeBorrowed, { word });
  }

  private access(operand: Read<Operand>, kind: LoanKind, expr: Expr): void {
    if (kind == LoanKind.Exclusive) {
      this.changeOperand(operand, expr);
    }
  }

  private readonly isTracked(operand: Read<Operand>): boolean {
    return (
      operand.kind == OperandKind.Place || operand.kind == OperandKind.Borrowed
    );
  }

  private changeOperand(operand: Read<Operand>, expr: Expr): void {
    const place = operand.place;
    if (operand.kind == OperandKind.Place && place != undefined) {
      this.changePlace(place, expr.loc);

      return;
    }
    if (operand.kind != OperandKind.Borrowed) {
      return;
    }

    const isShared = operand.loans.some((loan) => loan.kind == LoanKind.Shared);
    if (isShared && operand.loans.length > 0) {
      const word = this.exprText(expr);

      this.errors.write(this.home, expr.loc, Code.OwnReadChanged, { word });
    }
  }

  private changePlace(place: Place, loc: int): void {
    this.changePlaceExcept(place, loc, place.root);
  }

  private changePlaceExcept(place: Place, loc: int, except: int): void {
    const variable = this.variableOf(place.root);
    const frame = this.frame();
    const word = this.placeText(place);
    if (variable == undefined || frame == undefined) {
      return;
    }

    const holding = variable.holding;
    const isReadOnly = variable.isReadOnly;
    const isShared = this.isSharedOnly(variable);
    const hasFunction = frame.fn != undefined;
    if (holding == Holding.Lent && isReadOnly) {
      this.errors.write(this.home, loc, Code.OwnReadChanged, { word });

      return;
    }
    if (holding == Holding.Global) {
      this.reportGlobalChange(hasFunction, word, loc);

      return;
    }
    if (holding == Holding.Static) {
      this.noteStaticWrite(place.root);
    }
    if (holding == Holding.Borrow && isShared) {
      this.errors.write(this.home, loc, Code.OwnReadChanged, { word });

      return;
    }
    if (holding == Holding.Lent) {
      this.markChanged(place.root);
    }

    this.checkWriteExcept(place, loc, false, except);
  }

  private reportGlobalChange(
    hasFunction: boolean,
    word: string,
    loc: int,
  ): void {
    if (!hasFunction) {
      return;
    }

    this.errors.write(this.home, loc, Code.OwnGlobalChanged, { word });
  }

  private readonly isSharedOnly(variable: Read<Variable>): boolean {
    return variable.loans.every((loan) => loan.kind == LoanKind.Shared);
  }

  private changePlaceOf(target: Expr, loc: int): void {
    const tree = this.values.types.program.tree;

    if (this.isArrayLength(target) && target.kind == ExprKind.Member) {
      const object = tree.exprOf(target.objectId);

      return this.changePlaceOf(object, loc);
    }
    const operand = this.evaluateBase(target);

    this.reportReadonlyArray(target, loc);
    this.changeOperand(operand, target);
  }

  private readonly isArrayLength(target: Expr): boolean {
    const tree = this.values.types.program.tree;

    if (target.kind != ExprKind.Member || target.name != kLengthName) {
      return false;
    }

    const object = tree.exprOf(target.objectId);
    const type = this.values.answers.typeOf(object);

    return type != undefined && type.kind == TypeKind.Array;
  }

  private reportReadonlyArray(target: Expr, loc: int): void {
    const tree = this.values.types.program.tree;

    if (target.kind != ExprKind.Index) {
      return;
    }

    const object = tree.exprOf(target.objectId);
    const type = this.values.answers.typeOf(object);
    if (type == undefined || type.kind != TypeKind.Array) {
      return;
    }
    if (type.readonly == true) {
      const objectExpr = tree.exprOf(target.objectId);
      const word = this.exprText(objectExpr);

      this.errors.write(this.home, loc, Code.OwnReadonlyArray, { word });
    }
  }

  private copiedHolding(key: int): Holding {
    const declared = this.declaredOf(key);
    const type = this.values.variableOf(this.module, declared);
    if (type != undefined && !this.values.isCopy(type)) {
      return Holding.Own;
    }

    return Holding.Copy;
  }

  private bind(key: int, operand: Read<Operand>, init: Expr): void {
    if (this.isUndefinedSide(init)) {
      const declared = this.declaredOf(key);
      const holding = this.declaredHolding(declared);

      this.setHeld(key, holding, []);

      return;
    }
    if (operand.kind == OperandKind.Copy || this.isCopyExpr(init)) {
      const holding = this.copiedHolding(key);

      this.checkWidenedPart(operand, init);

      this.setHeld(key, holding, []);

      return;
    }
    const place = operand.place;

    switch (operand.kind) {
      case OperandKind.Borrowed:
        return this.bindBorrowed(key, operand, init.loc);
      case OperandKind.Place:
        if (place != undefined) {
          this.bindPlace(key, place, init);
        }
        return;
      default:
        this.setHeld(key, Holding.Own, []);
        return;
    }
  }

  private bindBorrowed(key: int, operand: Read<Operand>, loc: int): void {
    this.setHolding(key, Holding.Borrow);

    const loans = this.inferredLoans(key, operand, loc);

    this.setLoans(key, loans);
  }

  private inferredLoans(key: int, operand: Read<Operand>, loc: int): Loan[] {
    if (operand.isInferred != true || !this.isChangedVariable(key)) {
      return operand.loans.slice();
    }

    const loans: Loan[] = [];

    for (const loan of operand.loans) {
      this.changePlaceExcept(loan.place, loc, key);
      loans.push(this.loanOn(loan.place, LoanKind.Exclusive, loan.frozen));
    }

    return loans;
  }

  private bindPlace(key: int, place: Place, init: Expr): void {
    const variable = this.variableOf(key);
    const root = this.variableOf(place.root);
    if (variable == undefined) {
      return;
    }

    const isChanged = variable.isChanged;
    const isPattern = variable.isPattern == true;
    if (root == undefined) {
      this.setHolding(key, Holding.Own);

      return;
    }

    const isWhole = place.depth == 0 && !isPattern;
    const isOwnedCopy =
      root.holding == Holding.Copy && this.isOwnedCopyRoot(place.root);
    const isOwned = root.holding == Holding.Own || isOwnedCopy;
    const isMove = isOwned && isWhole;
    if (isMove) {
      const isMoved = this.moveOwned(place, init.loc);

      this.setHeld(key, Holding.Own, []);

      if (isMoved && init.kind == ExprKind.Name) {
        this.moveUses.add(init.id);
      }

      return;
    }

    const kind = this.loanKindOf(isChanged);
    const frozen = this.isFrozenExpr(init);
    const loans = this.loansOfPlaceAs(place, kind, frozen);

    this.setHeld(key, Holding.Borrow, loans);

    if (kind == LoanKind.Exclusive) {
      this.changePlaceExcept(place, init.loc, key);
    }
  }

  private readonly loansOfPlace(place: Place): Loan[] {
    return this.loansOfPlaceAs(place, LoanKind.Shared, false);
  }

  private readonly loansOfPlaceAs(
    place: Place,
    kind: LoanKind,
    frozen: boolean,
  ): Loan[] {
    const root = this.variableOf(place.root);
    if (root == undefined || root.holding != Holding.Borrow) {
      return [this.loanOn(place, kind, frozen)];
    }

    const loans: Loan[] = [];

    for (const loan of root.loans) {
      const inner = this.joined(loan.place, place);
      const isFrozen = loan.frozen || frozen;

      loans.push(this.loanOn(inner, kind, isFrozen));
    }

    return loans;
  }
}
