import { OwnershipCheck } from "../ownership-check.tz";
import { Code } from "../../../../diagnostic/code.tz";
import {
  BinaryOp,
  CallArgument,
  CallExpr,
  Expr,
  ExprKind,
  UnaryOp,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { StmtKind } from "../../../../program/ast/types/ast.types.statements.tz";
import { Module } from "../../../../program/module/types/module.types.tz";
import { SymbolKind } from "../../../../program/scopes/types/scopes.types.tz";
import { TypeKind } from "../../../../program/type/types/type.types.tz";
import {
  Callee,
  CellGuard,
  CellSource,
  Holding,
  LoanKind,
  Operand,
  OperandKind,
  ParamMode,
  ResultMode,
  Variable,
} from "../types/ownership-check.types.tz";

partial class OwnershipCheck {
  private noteOwnCode(module: Read<Module>): void {
    for (const item of module.file.items) {
      if (item.kind == StmtKind.Function) {
        this.ownCode.add(item);
      }
      if (item.kind != StmtKind.Class) {
        continue;
      }
      for (const method of item.methods) {
        this.ownCode.add(method);
      }
      for (const made of item.constructors) {
        this.ownCode.add(made);
      }
    }
    for (const part of module.parts) {
      for (const method of part.methods) {
        this.ownCode.add(method);
      }
    }
  }

  private cellSourceOf(expr: Expr): CellSource | undefined {
    if (this.isInternedValue(expr)) {
      return undefined;
    }

    switch (expr.kind) {
      case ExprKind.Member:
        if (this.isCellField(expr)) {
          return { holder: expr.object, field: expr.name };
        }
        if (this.isInternedValue(expr.object)) {
          return undefined;
        }

        return this.cellSourceOf(expr.object);
      case ExprKind.Index:
        return this.cellSourceOf(expr.object);
      case ExprKind.Call:
        return this.calledCellSource(expr);
      case ExprKind.OptionalChain:
        return this.cellSourceOf(expr.chain);
      case ExprKind.Cast:
        return this.cellSourceOf(expr.operand);
      case ExprKind.Unary:
        if (expr.op != UnaryOp.NonNull) {
          return undefined;
        }

        return this.cellSourceOf(expr.operand);
      case ExprKind.Binary:
        if (expr.op != BinaryOp.Nullish) {
          return undefined;
        }

        return this.cellSourceOf(expr.lhs);
      default:
        return undefined;
    }
  }

  private calledCellSource(call: CallExpr): CellSource | undefined {
    const callee = call.callee;
    if (callee.kind != ExprKind.Member) {
      return undefined;
    }

    const info = this.memberCallee(callee, call);
    const isLooking =
      info.result == ResultMode.Read ||
      info.result == ResultMode.Mut ||
      info.result == ResultMode.Element;
    const type = this.values.answers.typeOf(call);
    const isCopied = info.decl == undefined && this.isArrayOfCopies(type);
    if (!isLooking || isCopied) {
      return undefined;
    }

    return this.cellSourceOf(callee.object);
  }

  private cellGuardOf(source: Read<CellSource>, loc: int): CellGuard {
    const type = this.values.answers.typeOf(source.holder);
    const root = this.rootNameOf(source.holder);
    const isShared = type == undefined || root == undefined || this.isInternedType(type);
    let key: int | undefined = undefined;

    if (!isShared && root != undefined) {
      key = this.keyOfName(root);
    }

    return { holder: source.holder, field: source.field, root: key, type, loc };
  }

  private checkCellKept(variable: Variable, operand: Read<Operand>, init: Expr): void {
    if (variable.holding == Holding.Copy || this.isCopyExpr(init)) {
      return;
    }
    if (operand.isCell == true && this.isTracked(operand)) {
      return;
    }

    const source = this.cellSourceOf(init);
    if (source == undefined) {
      return;
    }

    const word = this.exprText(init);

    this.report(init.loc, Code.OwnCellBorrow, { word });
    variable.holding = Holding.Own;
    variable.loans = [];
  }

  private cellGuardFor(expr: Expr, loc: int): boolean {
    const source = this.cellSourceOf(expr);
    if (source == undefined) {
      return false;
    }

    this.cellGuards.push(this.cellGuardOf(source, loc));

    return true;
  }

  private cellGuardDone(isGuarded: boolean): void {
    if (isGuarded) {
      this.cellGuards.pop();
    }
  }

  private checkCellReach(
    call: Expr,
    info: Read<Callee>,
    receiver: Expr | undefined,
    args: Read<CallArgument[]>,
  ): void {
    if (this.cellGuards.length == 0) {
      return;
    }

    const guard = this.cellGuards.find((one) =>
      this.isCellReached(one, call, info, receiver, args),
    );
    if (guard == undefined) {
      return;
    }

    const word = this.exprText(call);
    const holder = this.exprText(guard.holder);
    const other = `${holder}.${guard.field}`;

    this.report(call.loc, Code.OwnCellReach, { word, other });
  }

  private isCellReached(
    guard: Read<CellGuard>,
    call: Expr,
    info: Read<Callee>,
    receiver: Expr | undefined,
    args: Read<CallArgument[]>,
  ): boolean {
    const isOwn = this.isOwnCallee(call, info, receiver);
    if (guard.root == undefined) {
      return isOwn;
    }
    if (isOwn && receiver == undefined && info.decl == undefined) {
      return true;
    }

    const isChanging = info.receiver == LoanKind.Exclusive;
    if (receiver != undefined && this.reachesHolder(guard, receiver, isChanging)) {
      return true;
    }

    for (let index: int = 0; index < args.length; index++) {
      const arg = args[index];
      const mode = this.paramAt(info, index).mode;
      const isMut = mode != ParamMode.Read && mode != ParamMode.Lent;
      if (arg != undefined && this.reachesHolder(guard, arg.expr, isMut)) {
        return true;
      }
    }

    return false;
  }

  private reachesHolder(guard: Read<CellGuard>, expr: Expr, isChanging: boolean): boolean {
    const root = this.rootNameOf(expr);
    if (root != undefined && this.keyOfName(root) == guard.root) {
      if (expr.kind == ExprKind.Name) {
        return true;
      }

      return isChanging && expr.kind == ExprKind.Member && expr.name == guard.field;
    }

    const type = this.values.answers.typeOf(expr);

    return type != undefined && guard.type != undefined && type == guard.type;
  }

  private isOwnCallee(call: Expr, info: Read<Callee>, receiver: Expr | undefined): boolean {
    const decl = info.decl;
    if (decl != undefined) {
      return this.ownCode.has(decl);
    }
    if (call.kind == ExprKind.New) {
      return false;
    }
    if (receiver != undefined) {
      const type = this.values.answers.typeOf(receiver);

      return type != undefined && type.kind == TypeKind.Object;
    }
    if (call.kind != ExprKind.Call) {
      return false;
    }

    const callee = call.callee;
    if (callee.kind != ExprKind.Name) {
      return true;
    }

    const target = this.values.valueTargetOf(callee, this.module);

    return target == undefined || target.kind != SymbolKind.Function;
  }
}
