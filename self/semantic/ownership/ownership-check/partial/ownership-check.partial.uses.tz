import { OwnershipCheck } from "../ownership-check.tz";
import {
  CallArgument,
  Expr,
  ExprKind,
  NameExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import {
  BindingKind,
  NameOrigin,
  VarDeclarator,
} from "../../../../program/ast/types/ast.types.patterns.tz";
import {
  Stmt,
  StmtKind,
} from "../../../../program/ast/types/ast.types.statements.tz";
import {
  TypeRef,
  TypeRefKind,
} from "../../../../program/ast/types/ast.types.types.tz";
import {
  Callee,
  Derived,
  FunctionFrame,
  Holding,
  LoopSpan,
  ParamMode,
  ResultMode,
  Variable,
} from "../types/ownership-check.types.tz";
import { SymbolKind } from "../../../../program/scopes/types/scopes.types.tz";
import {
  kForeignKeyBase,
  kForeignModuleSpan,
  kThisKey,
  kThisName,
} from "../const/ownership-check.const.tz";

partial class OwnershipCheck {
  private collectUses(frame: FunctionFrame, items: Read<Stmt[]>): void {
    const derived: Derived[] = [];

    for (const item of items) {
      this.declareIn(frame, item, derived);
    }

    const exprs: Expr[] = [];
    const values: Expr[] = [];

    for (const item of items) {
      this.values.types.statementExprs(item, exprs, values, true);
    }

    for (const expr of exprs) {
      this.noteUse(frame, expr);
    }

    this.spreadChanges(frame, derived);
    this.extendInLoops(frame);
  }

  private readonly declareIn(
    frame: FunctionFrame,
    stmt: Stmt,
    derived: Derived[],
  ): void {
    const tree = this.values.types.program.tree;

    switch (stmt.kind) {
      case StmtKind.VarDecl:
        for (const declarator of tree.declaratorsOf(stmt.declsList)) {
          this.declareVariable(frame, declarator, stmt.isConst, stmt.isUsing);
          this.noteDerived(
            declarator.loc,
            tree.exprAt(declarator.initId),
            derived,
          );
        }
        return;
      case StmtKind.Block:
        const body = tree.stmtsOf(stmt.bodyList);

        return this.declareAll(frame, body, derived);
      case StmtKind.If:
        const thenStmt = tree.stmtOf(stmt.thenStmtId);

        this.declareIn(frame, thenStmt, derived);
        return this.declareOptional(
          frame,
          tree.stmtAt(stmt.elseStmtId),
          derived,
        );
      case StmtKind.While:
      case StmtKind.DoWhile:
        this.noteLoop(frame, stmt.loc, stmt);
        const bodyStmt = tree.stmtOf(stmt.bodyId);

        return this.declareIn(frame, bodyStmt, derived);
      case StmtKind.For:
        this.noteLoop(frame, stmt.loc, stmt);
        const init = tree.stmtAt(stmt.initId);

        this.declareOptional(frame, init, derived);
        const stmtBody = tree.stmtAt(stmt.bodyId);

        return this.declareOptional(frame, stmtBody, derived);
      case StmtKind.ForOf:
        this.noteLoop(frame, stmt.loc, stmt);
        this.declareVariable(frame, stmt.binding, stmt.isConst, stmt.isUsing);
        this.noteDerived(
          stmt.binding.loc,
          tree.exprOf(stmt.iterableId),
          derived,
        );
        return this.declareIn(frame, tree.stmtOf(stmt.bodyId), derived);
      case StmtKind.Switch:
        for (const option of tree.casesOf(stmt.casesList)) {
          const bodyItem = tree.stmtsOf(option.bodyList);

          this.declareAll(frame, bodyItem, derived);
        }
        return;
      case StmtKind.Labeled:
        return this.declareIn(frame, tree.stmtOf(stmt.bodyId), derived);
      default:
        return;
    }
  }

  private readonly declareAll(
    frame: FunctionFrame,
    items: Read<Stmt[]>,
    derived: Derived[],
  ): void {
    for (const item of items) {
      this.declareIn(frame, item, derived);
    }
  }

  private readonly declareOptional(
    frame: FunctionFrame,
    stmt: Stmt | undefined,
    derived: Derived[],
  ): void {
    if (stmt != undefined) {
      this.declareIn(frame, stmt, derived);
    }
  }

  private readonly noteDerived(
    key: int,
    init: Expr | undefined,
    derived: Derived[],
  ): void {
    if (init != undefined) {
      derived.push({ key, source: init });
    }
  }

  private spreadChanges(frame: FunctionFrame, derived: Read<Derived[]>): void {
    let isSpread = true;

    while (isSpread) {
      isSpread = false;

      for (const one of derived) {
        const variable = frame.variables.get(one.key);
        if (variable == undefined || !variable.isChanged) {
          continue;
        }

        const type = this.values.variableOf(this.module, one.key);
        if (type != undefined && this.values.isCopy(type)) {
          continue;
        }

        const key = this.spreadKey(one.source);
        if (key == undefined) {
          continue;
        }

        const source = frame.variables.get(key);
        if (source != undefined && !source.isChanged) {
          source.isChanged = true;
          isSpread = true;
        }
      }
    }
  }

  private spreadKey(source: Expr): int | undefined {
    const root = this.borrowRootOf(source);
    if (root == undefined) {
      return undefined;
    }

    return this.keyOfName(root);
  }

  private borrowRootOf(expr: Expr): NameExpr | undefined {
    const tree = this.values.types.program.tree;

    switch (expr.kind) {
      case ExprKind.Name:
        return expr;
      case ExprKind.Member:
      case ExprKind.Index:
        const object = tree.exprOf(expr.objectId);

        return this.borrowRootOf(object);
      case ExprKind.Cast:
        const operand = tree.exprOf(expr.operandId);

        return this.borrowRootOf(operand);
      case ExprKind.OptionalChain:
        const chain = tree.exprOf(expr.chainId);

        return this.borrowRootOf(chain);
      case ExprKind.Unary:
        const operandExpr = tree.exprOf(expr.operandId);

        return this.borrowRootOf(operandExpr);
      case ExprKind.Call:
        const callee = tree.exprOf(expr.calleeId);

        return this.callBorrowRoot(callee, expr);
      case ExprKind.Conditional:
        return (
          this.borrowRootOf(tree.exprOf(expr.thenExprId)) ??
          this.borrowRootOf(tree.exprOf(expr.elseExprId))
        );
      case ExprKind.Binary:
        return (
          this.borrowRootOf(tree.exprOf(expr.lhsId)) ??
          this.borrowRootOf(tree.exprOf(expr.rhsId))
        );
      default:
        return undefined;
    }
  }

  private callBorrowRoot(callee: Expr, call: Expr): NameExpr | undefined {
    const tree = this.values.types.program.tree;

    if (callee.kind != ExprKind.Member) {
      return undefined;
    }

    const info = this.calleeForUses(callee, call);
    if (info.result != ResultMode.Element && info.result != ResultMode.Mut) {
      return undefined;
    }

    const object = tree.exprOf(callee.objectId);

    return this.borrowRootOf(object);
  }

  private readonly declareVariable(
    frame: FunctionFrame,
    declarator: VarDeclarator,
    isConst: boolean,
    isUsing: boolean,
  ): void {
    const tree = this.values.types.program.tree;

    const isBorrowArray = this.isBorrowArrayRef(
      tree.typeRefAt(declarator.typeAnnId),
    );

    frame.variables.set(declarator.loc, {
      key: declarator.loc,
      name: declarator.name,
      holding: Holding.Own,
      loans: [],
      isReadOnly: false,
      isConst,
      isUsing,
      declared: declarator.loc,
      lastUse: declarator.loc,
      isChanged: false,
      isBorrowArray,
      isPattern:
        declarator.form.kind != BindingKind.Plain &&
        declarator.origin == NameOrigin.Generated,
    });
  }

  private readonly isBorrowArrayRef(ref: TypeRef | undefined): boolean {
    return (
      ref != undefined &&
      (ref.form.kind == TypeRefKind.Array ||
        ref.form.kind == TypeRefKind.Tuple) &&
      this.isBorrowRef(ref)
    );
  }

  private readonly noteLoop(
    frame: FunctionFrame,
    start: int,
    stmt: Stmt,
  ): void {
    const end = this.lastLocOf(stmt);
    const span: LoopSpan = { start, end };

    frame.loops.push(span);
  }

  private readonly lastLocOf(stmt: Stmt): int {
    const exprs: Expr[] = [];
    const values: Expr[] = [];
    let last: int = stmt.loc;

    this.values.types.statementExprs(stmt, exprs, values, true);

    for (const expr of exprs) {
      if (expr.loc > last) {
        last = expr.loc;
      }
    }

    return last;
  }

  private noteUse(frame: FunctionFrame, expr: Expr): void {
    const tree = this.values.types.program.tree;

    if (expr.kind == ExprKind.Name) {
      this.noteName(frame, expr);

      return;
    }
    if (expr.kind == ExprKind.Assign || expr.kind == ExprKind.Update) {
      const targetExpr = tree.exprOf(expr.targetId);
      if (targetExpr.kind != ExprKind.Name) {
        const target = tree.exprOf(expr.targetId);

        this.noteChange(frame, target);
      }

      return;
    }
    const callee = this.calleeMember(expr);
    if (callee != undefined) {
      const object = tree.exprOf(callee.objectId);

      this.noteChangingCall(frame, object, callee.name);
    }
    if (expr.kind == ExprKind.Call) {
      const calleeExpr = tree.exprOf(expr.calleeId);
      const info = this.calleeForUses(calleeExpr, expr);

      const args = tree.argumentsOf(expr.argsList);

      this.noteChangedArguments(frame, args, info);
    }
  }

  private calleeForUses(callee: Expr, call: Expr): Callee {
    if (callee.kind == ExprKind.Member) {
      return this.memberCallee(callee, call);
    }
    if (callee.kind == ExprKind.Name) {
      return this.nameCallee(callee, call);
    }

    return this.libraryCallee(call);
  }

  private noteChangedArguments(
    frame: FunctionFrame,
    args: Read<CallArgument[]>,
    info: Read<Callee>,
  ): void {
    const tree = this.values.types.program.tree;

    for (let index: int = 0; index < args.length; index++) {
      const arg = args[index];
      const param = this.paramAt(info, index);
      if (arg == undefined || param.mode != ParamMode.Mut) {
        continue;
      }
      const exprExpr = tree.exprOf(arg.exprId);
      if (!this.isCopyExpr(exprExpr)) {
        const expr = tree.exprOf(arg.exprId);

        this.noteChange(frame, expr);
      }
    }
  }

  private readonly noteName(frame: FunctionFrame, expr: NameExpr): void {
    const key = this.keyOfName(expr);
    if (key == undefined) {
      return;
    }

    const variable = frame.variables.get(key);
    if (variable == undefined) {
      return;
    }
    if (expr.loc > variable.lastUse) {
      variable.lastUse = expr.loc;
    }
  }

  private readonly noteChange(frame: FunctionFrame, target: Expr): void {
    const root = this.rootNameOf(target);
    if (root == undefined) {
      return;
    }

    const key = this.keyOfName(root);
    if (key == undefined) {
      return;
    }

    const variable = frame.variables.get(key);
    if (variable != undefined) {
      variable.isChanged = true;
    }
  }

  private readonly noteChangingCall(
    frame: FunctionFrame,
    object: Expr,
    method: string,
  ): void {
    const root = this.rootNameOf(object);
    if (root == undefined) {
      return;
    }

    const key = this.keyOfName(root);
    if (key == undefined) {
      return;
    }

    const variable = frame.variables.get(key);
    if (variable == undefined) {
      return;
    }
    if (this.isChangingMethod(object, method)) {
      variable.isChanged = true;
    }
  }

  private readonly extendInLoops(frame: FunctionFrame): void {
    const extended = new Map<int, int>();

    for (const variable of frame.variables.values()) {
      const lastUse = this.loopLastUse(frame, variable);
      if (lastUse != variable.lastUse) {
        extended.set(variable.key, lastUse);
      }
    }

    for (const key of extended.keys()) {
      const variable = frame.variables.get(key);
      const lastUse = extended.get(key);
      if (variable != undefined && lastUse != undefined) {
        variable.lastUse = lastUse;
      }
    }
  }

  private readonly loopLastUse(
    frame: Read<FunctionFrame>,
    variable: Read<Variable>,
  ): int {
    let lastUse: int = variable.lastUse;

    for (const loop of frame.loops) {
      const isInside = lastUse >= loop.start;
      const isBefore = variable.declared < loop.start;
      if (isInside && isBefore && lastUse <= loop.end) {
        lastUse = loop.end;
      }
    }

    return lastUse;
  }

  private readonly rootNameOf(expr: Expr): NameExpr | undefined {
    const tree = this.values.types.program.tree;

    switch (expr.kind) {
      case ExprKind.Name:
        return expr;
      case ExprKind.Member:
      case ExprKind.Index:
        const object = tree.exprOf(expr.objectId);

        return this.rootNameOf(object);
      case ExprKind.Cast:
        const operand = tree.exprOf(expr.operandId);

        return this.rootNameOf(operand);
      case ExprKind.OptionalChain:
        const chain = tree.exprOf(expr.chainId);

        return this.rootNameOf(chain);
      default:
        return undefined;
    }
  }

  private readonly keyOfName(expr: NameExpr): int | undefined {
    if (expr.name == kThisName) {
      return kThisKey;
    }

    const target = this.values.valueTargetOf(expr, this.module);
    if (target == undefined) {
      return undefined;
    }
    if (target.module == this.module) {
      return target.loc;
    }
    const home = this.values.types.program.modules[target.module];
    if (
      target.kind != SymbolKind.Variable ||
      home == undefined ||
      home.source.isLibrary
    ) {
      return undefined;
    }

    const shift = target.module * kForeignModuleSpan;

    return kForeignKeyBase - shift - target.loc;
  }
}
