import "./partial/ownership-check.partial.functions.tz";
import "./partial/ownership-check.partial.uses.tz";
import "./partial/ownership-check.partial.statements.tz";
import "./partial/ownership-check.partial.expressions.tz";
import "./partial/ownership-check.partial.places.tz";
import "./partial/ownership-check.partial.values.tz";
import "./partial/ownership-check.partial.frozen.tz";
import "./partial/ownership-check.partial.returns.tz";
import "./partial/ownership-check.partial.calls.tz";
import "./partial/ownership-check.partial.call-results.tz";
import "./partial/ownership-check.partial.callees.tz";
import "./partial/ownership-check.partial.variance.tz";
import "./partial/ownership-check.partial.widening.tz";
import "./partial/ownership-check.partial.closures.tz";
import "./partial/ownership-check.partial.rules.tz";
import "./partial/ownership-check.partial.variables.tz";
import { Code } from "../../../diagnostic/code.tz";
import { ErrorLog } from "../../../diagnostic/error-log/error-log.tz";
import {
  Details,
  SourceError,
} from "../../../diagnostic/types/message.types.tz";
import { ClassDecl } from "../../../program/ast/types/ast.types.classes.tz";
import { FunctionDecl } from "../../../program/ast/types/ast.types.functions.tz";
import { replace } from "tz:mem";
import { Expr } from "../../../program/ast/types/ast.types.expressions.tz";
import {
  Stmt,
  StmtKind,
} from "../../../program/ast/types/ast.types.statements.tz";
import { Module, Program } from "../../../program/module/types/module.types.tz";
import { SourceLines } from "../../../program/source-lines/source-lines.tz";
import { TypeStore } from "../../../program/type/type-store/type-store.tz";
import { Type } from "../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../code/expression-types/expression-types.tz";
import { kCheckedLibraries } from "../../declaration/module-questions/const/module-questions.const.tz";
import { FlowState, FunctionFrame } from "./types/ownership-check.types.tz";

export class OwnershipCheck {
  public readonly values: ExpressionTypes;
  private readonly errors: ErrorLog;
  private readonly functions: Map<string, FunctionDecl>;
  private readonly classes: Map<string, ClassDecl>;
  private readonly partHomes: Map<int, int>;
  private readonly lines: Map<int, SourceLines>;
  private readonly frames: FunctionFrame[];
  private readonly hintTexts: string[];
  private state: FlowState;
  private module: int;
  private home: int;
  private liveFrom: int;
  private moveUses: Set<int>;
  private borrowDecls: Set<string>;
  private lentClosures: Set<int>;
  private readonly widened: Set<int>;
  private readonly literalWanted: Map<int, Type>;
  private readonly ownCode: Set<int>;

  public constructor(values: Own<ExpressionTypes>) {
    this.values = values;
    this.errors = new ErrorLog();
    this.functions = new Map<string, FunctionDecl>();
    this.classes = new Map<string, ClassDecl>();
    this.partHomes = new Map<int, int>();
    this.lines = new Map<int, SourceLines>();
    this.frames = [];
    this.hintTexts = [];
    this.state = { moved: [], isDead: false };
    this.module = -1;
    this.home = -1;
    this.liveFrom = -1;
    this.moveUses = new Set<int>();
    this.borrowDecls = new Set<string>();
    this.lentClosures = new Set<int>();
    this.widened = new Set<int>();
    this.literalWanted = new Map<int, Type>();
    this.ownCode = new Set<int>();
  }

  public takeMoves(): Set<int> {
    return replace(this.moveUses, new Set<int>());
  }

  public takeBorrows(): Set<string> {
    return replace(this.borrowDecls, new Set<string>());
  }

  public takeLentClosures(): Set<int> {
    return replace(this.lentClosures, new Set<int>());
  }

  public run(): void {
    for (const module of this.values.types.program.modules) {
      if (this.isChecked(module)) {
        this.indexModule(module);
      }
    }

    for (const module of this.values.types.program.modules) {
      if (this.isChecked(module)) {
        this.checkModule(module);
      }
    }
  }

  public readonly problems(module: int): SourceError[] {
    return this.errors.of(module);
  }

  public readonly hints(): string[] {
    return this.hintTexts.slice();
  }

  private hint(loc: int, kind: string, name: string): void {
    const module = this.values.types.program.modules[this.home];
    const lines = this.sourceLines();
    if (module == undefined || lines == undefined) {
      return;
    }

    const place = lines.placeOf(loc);
    const path = module.source.path;

    this.hintTexts.push(
      `${path}:${place.line}:${place.column}: hint ${kind} ${name}`,
    );
  }

  private readonly isChecked(module: Read<Module>): boolean {
    if (module.isDeclarationOnly) {
      return false;
    }

    return !module.source.isLibrary || kCheckedLibraries.includes(module.name);
  }

  private indexModule(module: Read<Module>): void {
    const tree = this.values.types.program.tree;

    for (const item of tree.stmtsOf(module.file.itemsList)) {
      this.indexStatement(module.id, item);
    }
    for (const part of tree.classesOf(module.partsList)) {
      for (const method of tree.functionsOf(part.methodsList)) {
        this.partHomes.set(method.id, module.id);
      }
    }
    if (!module.source.isLibrary) {
      this.noteOwnCode(module);
    }
  }

  private indexStatement(module: int, stmt: Stmt): void {
    switch (stmt.kind) {
      case StmtKind.Function:
        this.functions.set(this.keyOf(module, stmt.loc), stmt);
        break;
      case StmtKind.Class:
        this.indexClass(module, stmt);
        break;
      default:
        break;
    }
  }

  private indexClass(module: int, decl: ClassDecl): void {
    const tree = this.values.types.program.tree;

    this.classes.set(this.keyOf(module, decl.loc), decl);

    for (const method of tree.functionsOf(decl.methodsList)) {
      this.functions.set(this.keyOf(module, method.loc), method);
    }
    for (const made of tree.functionsOf(decl.constructorsList)) {
      this.functions.set(this.keyOf(module, made.loc), made);
    }
  }

  private readonly keyOf(module: int, loc: int): string {
    return `${module}:${loc}`;
  }

  private lineOf(loc: int): string {
    const lines = this.sourceLines();
    if (lines == undefined) {
      return "?";
    }

    const place = lines.placeOf(loc);

    return `${place.line}`;
  }

  private sourceLines(): Read<SourceLines> | undefined {
    const module = this.values.types.program.modules[this.home];
    if (!this.lines.has(this.home) && module != undefined) {
      const made = new SourceLines(module.source.text);

      this.lines.set(this.home, made);
    }

    return this.lines.get(this.home);
  }
}
