import {
  ClassDecl,
  ClassField,
  FieldKind,
} from "../../../../program/ast/types/ast.types.classes.tz";
import { StmtKind } from "../../../../program/ast/types/ast.types.statements.tz";
import {
  ObjectField,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import { kDisposeKey } from "../../../code/dispose-rules/const/dispose-rules.const.tz";

partial class ExpressionTypes {
  public isCopy(type: Type): boolean {
    const known = this.copies.get(type.id);
    if (known != undefined) {
      return known;
    }

    const key = `copy ${type.id}`;
    if (this.copyOpen.has(key)) {
      return false;
    }

    this.copyOpen.add(key);
    const answer = this.copyOf(type);

    this.copyOpen.delete(key);
    this.copies.set(type.id, answer);

    return answer;
  }

  public isDeepImmutable(type: Type): boolean {
    const known = this.frozen.get(type.id);
    if (known != undefined) {
      return known;
    }

    const key = `frozen ${type.id}`;
    if (this.copyOpen.has(key)) {
      return true;
    }

    this.copyOpen.add(key);
    const answer = this.frozenOf(type);

    this.copyOpen.delete(key);
    this.frozen.set(type.id, answer);

    return answer;
  }

  public readonly hasDispose(decl: ClassDecl): boolean {
    const tree = this.types.program.tree;

    return this.types.hasClassMethod(decl, kDisposeKey);
  }

  private copyOf(type: Type): boolean {
    switch (type.kind) {
      case TypeKind.Error:
      case TypeKind.Void:
      case TypeKind.Undefined:
      case TypeKind.Never:
      case TypeKind.Unknown:
      case TypeKind.Boolean:
      case TypeKind.Double:
      case TypeKind.Decimal:
      case TypeKind.String:
      case TypeKind.Int:
      case TypeKind.Literal:
      case TypeKind.Template:
        return true;
      case TypeKind.Union:
        return this.types.store
          .partsOf(type)
          .every((part) => this.isCopy(part));
      case TypeKind.Result:
        return (
          this.isCopy(this.types.store.valueOf(type)) &&
          this.isCopy(this.types.store.errorOf(type))
        );
      case TypeKind.Tuple:
        return (
          type.readonly &&
          this.types.store.itemsOf(type).every((item) => this.isCopy(item))
        );
      case TypeKind.Object:
        return this.isCopyObject(this.types.store.fieldsOf(type));
      case TypeKind.Instance:
        return this.isCopyInstance(type);
      default:
        return false;
    }
  }

  private isCopyObject(fields: Read<ObjectField[]>): boolean {
    for (const field of fields) {
      if (!field.readonly || field.method == true) {
        return false;
      }
      if (field.type.kind == TypeKind.Function) {
        return false;
      }
      if (!this.isCopy(field.type)) {
        return false;
      }
    }

    return true;
  }

  private isCopyInstance(type: Type): boolean {
    if (
      type.kind == TypeKind.Instance &&
      this.isHandle(type.module, type.loc)
    ) {
      return true;
    }

    if (this.types.store.isBase(type)) {
      return false;
    }

    return this.hasCopyFields(type, 0);
  }

  private hasCopyFields(type: Type, depth: int): boolean {
    const decl = this.classDeclOf(type);
    const fields = this.instanceFields(type);
    if (decl == undefined || fields == undefined || depth > 20) {
      return false;
    }
    if (this.hasDispose(decl)) {
      return false;
    }

    for (const field of fields) {
      const declared = this.fieldNamed(decl, field.name);
      if (declared == undefined || !this.isReadonlyField(declared)) {
        return false;
      }
      if (!this.isCopy(field.type)) {
        return false;
      }
    }

    return this.hasCopyParents(type, depth);
  }

  private hasCopyParents(type: Type, depth: int): boolean {
    const parents = this.types.store.parentsOf(type).slice();

    for (const parent of parents) {
      const isClass = this.classDeclOf(parent) != undefined;
      if (isClass && !this.hasCopyFields(parent, depth + 1)) {
        return false;
      }
    }

    return true;
  }

  private frozenOf(type: Type): boolean {
    if (this.isCopy(type)) {
      return true;
    }

    switch (type.kind) {
      case TypeKind.Array:
        return (
          type.readonly == true &&
          this.isDeepImmutable(this.types.store.itemOf(type))
        );
      case TypeKind.Tuple:
        return (
          type.readonly && this.areDeepImmutable(this.types.store.itemsOf(type))
        );
      case TypeKind.Union:
        return this.types.store
          .partsOf(type)
          .every((part) => this.isDeepImmutable(part));
      case TypeKind.Object:
        return this.isFrozenObject(this.types.store.fieldsOf(type));
      case TypeKind.Instance:
        return this.isFrozenInstance(type);
      default:
        return false;
    }
  }

  private areDeepImmutable(types: Read<Type[]>): boolean {
    return types.every((type) => this.isDeepImmutable(type));
  }

  private isFrozenObject(fields: Read<ObjectField[]>): boolean {
    for (const field of fields) {
      if (!field.readonly) {
        return false;
      }
      if (field.method == true || field.type.kind == TypeKind.Function) {
        continue;
      }
      if (!this.isDeepImmutable(field.type)) {
        return false;
      }
    }

    return true;
  }

  private isFrozenInstance(type: Type): boolean {
    const decl = this.classDeclOf(type);
    const fields = this.instanceFields(type);
    if (decl == undefined || fields == undefined) {
      return false;
    }
    if (this.types.store.isBase(type)) {
      return false;
    }

    for (const field of fields) {
      const declared = this.fieldNamed(decl, field.name);
      if (declared == undefined || !this.isReadonlyField(declared)) {
        return false;
      }
      if (!this.isDeepImmutable(field.type)) {
        return false;
      }
    }

    return true;
  }

  private readonly isHandle(module: int, loc: int): boolean {
    const tree = this.types.program.tree;

    const found = this.types.program.modules[module];
    if (found == undefined) {
      return false;
    }

    return tree.stmtsOf(found.file.itemsList).some(
      (item) => item.kind == StmtKind.Handle && item.loc == loc,
    );
  }

  private readonly fieldNamed(
    decl: ClassDecl,
    name: string,
  ): ClassField | undefined {
    const tree = this.types.program.tree;

    return tree.fieldsOf(decl.fieldsList).find((field) => field.name == name);
  }

  private readonly isReadonlyField(field: ClassField): boolean {
    return field.readonly || field.form == FieldKind.ArrowMethod;
  }
}
