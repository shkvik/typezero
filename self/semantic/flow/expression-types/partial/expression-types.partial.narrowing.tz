import { replace } from "tz:mem";
import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import {
  BinaryExpr,
  BinaryOp,
  Expr,
  ExprKind,
  MemberExpr,
  UnaryOp,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { SymbolKind } from "../../../../program/scopes/types/scopes.types.tz";
import {
  LiteralKind,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import { kTrueText } from "../../../types/type-resolver/const/type-resolver.const.tables.tz";
import {
  NarrowSlot,
  ValueTarget,
} from "../../../code/expression-types/types/expression-types.types.tz";

partial class ExpressionTypes {
  private readonly factOf(target: ValueTarget): Type | undefined {
    const key = `${target.module} ${target.loc}`;

    return this.knownFact(key);
  }

  private readonly knownFact(key: string): Type | undefined {
    const fact = this.facts.get(key);
    if (fact == undefined || fact.kind == TypeKind.Undefined) {
      return undefined;
    }

    return fact;
  }

  private readonly underFacts(facts: Read<Map<string, Type>>): Map<string, Type> {
    const merged = this.narrowings.mergedFacts(this.facts, facts);

    return replace(this.facts, merged);
  }

  private readonly factsCopy(): Map<string, Type> {
    return new Map<string, Type>(this.facts);
  }

  private readonly factsOf(cond: Expr, isTrue: boolean, module: int): Map<string, Type> {
    switch (cond.kind) {
      case ExprKind.Unary:
        if (cond.op != UnaryOp.Not) {
          return new Map<string, Type>();
        }

        return this.factsOf(cond.operand, !isTrue, module);
      case ExprKind.Name:
      case ExprKind.Member:
      case ExprKind.OptionalChain:
      case ExprKind.Assign:
        return this.truthFacts(cond, isTrue, module);
      case ExprKind.Binary:
        return this.binaryFacts(cond, isTrue, module);
      case ExprKind.Call:
        return this.callFacts(cond, isTrue, module);
      default:
        return new Map<string, Type>();
    }
  }

  private readonly truthFacts(
    cond: Expr,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> {
    const facts = new Map<string, Type>();
    const path = this.narrowings.comparedPath(cond);
    if (path.kind == ExprKind.Member) {
      const literal = this.store.literal(LiteralKind.Boolean, kTrueText);

      this.literalTagFacts(path, literal, isTrue, facts, module);
    }

    const slot = this.narrowable(path, module);
    if (slot == undefined || !isTrue || !this.types.isOptional(slot.type)) {
      return facts;
    }

    const defined = this.types.definedType(slot.type);

    facts.set(slot.key, defined);
    this.linkFacts(path, facts, module);

    return facts;
  }

  private readonly linkFacts(expr: Expr, facts: Map<string, Type>, module: int): void {
    if (expr.kind == ExprKind.OptionalChain) {
      return this.linkFacts(expr.chain, facts, module);
    }
    if (expr.kind != ExprKind.Member) {
      return;
    }

    const object = expr.object;
    const slot = this.narrowable(object, module);
    if (
      expr.optional &&
      slot != undefined &&
      this.types.isOptional(slot.type)
    ) {
      const defined = this.types.definedType(slot.type);

      facts.set(slot.key, defined);
    }

    this.linkFacts(object, facts, module);
  }

  private readonly binaryFacts(
    cond: BinaryExpr,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> {
    switch (cond.op) {
      case BinaryOp.LogAnd:
        if (isTrue) {
          return this.bothFacts(cond, true, module);
        }

        return this.eitherFacts(cond, true, false, module);
      case BinaryOp.LogOr:
        if (isTrue) {
          return this.eitherFacts(cond, false, true, module);
        }

        return this.bothFacts(cond, false, module);
      case BinaryOp.Eq: {
        const facts = this.equalityFacts(cond.lhs, cond.rhs, isTrue, module);
        const bounds = this.comparisonBounds(cond, isTrue, module);

        return this.narrowings.mergedFacts(facts, bounds);
      }
      case BinaryOp.Ne: {
        const facts = this.equalityFacts(cond.lhs, cond.rhs, !isTrue, module);
        const bounds = this.comparisonBounds(cond, isTrue, module);

        return this.narrowings.mergedFacts(facts, bounds);
      }
      case BinaryOp.Lt:
      case BinaryOp.Le:
      case BinaryOp.Gt:
      case BinaryOp.Ge:
        return this.comparisonBounds(cond, isTrue, module);
      case BinaryOp.InstanceOf:
        return this.instanceFacts(cond.lhs, cond.rhs, isTrue, module);
      case BinaryOp.In:
        return this.keyFacts(cond.lhs, cond.rhs, isTrue, module);
      default:
        return new Map<string, Type>();
    }
  }

  private readonly keyFacts(
    lhs: Expr,
    rhs: Expr,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> {
    const facts = new Map<string, Type>();
    const slot = this.narrowable(rhs, module);
    if (slot == undefined || lhs.kind != ExprKind.StringLit) {
      return facts;
    }

    const name = lhs.value;
    const parts = this.types.unionMembers(slot.type);
    const kept = parts.filter((part) => this.isKeyKept(part, name, isTrue));
    if (parts.length < 2 || kept.length == 0) {
      return facts;
    }

    facts.set(slot.key, this.store.unionOf(kept));

    return facts;
  }

  private readonly isKeyKept(part: Type, name: string, isTrue: boolean): boolean {
    if (part.kind == TypeKind.Object) {
      const field = part.fields.find((one) => one.name == name);
      if (field == undefined) {
        return !isTrue;
      }

      return isTrue || field.optional;
    }
    if (part.kind != TypeKind.Instance) {
      return true;
    }

    const lookup = this.classMember(part, name);
    if (!lookup.isKnown) {
      return true;
    }

    return (lookup.entry != undefined) == isTrue;
  }

  private readonly bothFacts(
    cond: BinaryExpr,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> {
    const left = this.factsOf(cond.lhs, isTrue, module);
    const before = this.underFacts(left);
    const right = this.factsOf(cond.rhs, isTrue, module);

    this.facts = before;

    return this.narrowings.mergedFacts(left, right);
  }

  private readonly eitherFacts(
    cond: BinaryExpr,
    isLeftTrue: boolean,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> {
    const left = this.factsOf(cond.lhs, isTrue, module);
    const passed = this.factsOf(cond.lhs, isLeftTrue, module);
    const before = this.underFacts(passed);
    const right = this.factsOf(cond.rhs, isTrue, module);

    this.facts = before;

    return this.narrowings.joinedFacts(left, right);
  }

  private readonly equalityFacts(
    lhs: Expr,
    rhs: Expr,
    isEqual: boolean,
    module: int,
  ): Map<string, Type> {
    const facts = new Map<string, Type>();
    const typeofFacts = this.typeofFacts(lhs, rhs, isEqual, module);
    if (typeofFacts != undefined) {
      return typeofFacts;
    }

    const left = this.narrowings.comparedPath(lhs);
    const right = this.narrowings.comparedPath(rhs);
    const isPathLeft = this.pathKey(left, module) != undefined;
    const name = this.narrowings.sideOf(isPathLeft, left, right);
    const other = this.narrowings.sideOf(isPathLeft, right, left);
    const slot = this.narrowable(name, module);
    if (slot == undefined) {
      return facts;
    }

    const narrowed = this.comparedType(slot.type, other, isEqual, module);
    if (narrowed != undefined) {
      facts.set(slot.key, narrowed);
    }

    const isDefined =
      narrowed != undefined &&
      narrowed.kind != TypeKind.Undefined &&
      !this.types.isOptional(narrowed);
    if (isDefined) {
      this.linkFacts(name, facts, module);
    }

    const tag = this.narrowings.tagOf(name);
    if (tag != undefined) {
      this.tagFacts(tag, other, isEqual, facts, module);
    }

    return facts;
  }

  private readonly tagFacts(
    tag: MemberExpr,
    other: Expr,
    isEqual: boolean,
    facts: Map<string, Type>,
    module: int,
  ): void {
    const literal = this.comparedLiteral(other, module);
    if (literal == undefined) {
      return;
    }

    this.literalTagFacts(tag, literal, isEqual, facts, module);
  }

  private readonly literalTagFacts(
    tag: MemberExpr,
    literal: Type,
    isEqual: boolean,
    facts: Map<string, Type>,
    module: int,
  ): void {
    const owner = this.narrowable(tag.object, module);
    if (owner == undefined) {
      return;
    }

    const parts = this.narrowings.flatMembers(owner.type);
    const kept = parts.filter((part) =>
      this.isTagKept(part, tag.name, literal, isEqual),
    );
    if (kept.length == 0 && !isEqual) {
      facts.set(owner.key, this.store.plain(TypeKind.Never));

      return;
    }
    if (kept.length == 0 || kept.length == parts.length) {
      return;
    }

    const union = this.store.unionOf(kept);

    facts.set(owner.key, union);
  }

  private readonly isTagKept(
    part: Type,
    name: string,
    literal: Type,
    isEqual: boolean,
  ): boolean {
    const tag = this.partField(part, name);
    if (tag == undefined) {
      return !isEqual;
    }
    if (!isEqual) {
      return tag != literal;
    }

    const base = this.relation.baseOf(literal);
    const isOpen = tag == base || tag.kind == TypeKind.Error;

    return isOpen || this.objects.holdsLiteral(tag, literal);
  }

  private readonly comparedType(
    type: Type,
    other: Expr,
    isEqual: boolean,
    module: int,
  ): Type | undefined {
    if (other.kind == ExprKind.Undefined) {
      return this.narrowings.undefinedCompared(type, isEqual);
    }

    const literal = this.comparedLiteral(other, module);
    if (literal == undefined) {
      return undefined;
    }
    if (isEqual) {
      return this.narrowings.literalPart(type, literal);
    }

    return this.narrowings.withoutPart(type, literal);
  }

  private readonly comparedLiteral(other: Expr, module: int): Type | undefined {
    const isWritten =
      other.kind == ExprKind.StringLit ||
      other.kind == ExprKind.IntLit ||
      other.kind == ExprKind.BoolLit ||
      other.kind == ExprKind.Unary ||
      other.kind == ExprKind.Member;
    const literal = this.literalOf(other, module);
    if (!isWritten || literal == undefined) {
      return undefined;
    }

    return this.store.literal(literal.kind, literal.text);
  }

  private readonly typeofFacts(
    lhs: Expr,
    rhs: Expr,
    isEqual: boolean,
    module: int,
  ): Map<string, Type> | undefined {
    const isTypeofLeft = lhs.kind == ExprKind.Unary && lhs.op == UnaryOp.TypeOf;
    const tested = this.narrowings.sideOf(isTypeofLeft, lhs, rhs);
    const other = this.narrowings.sideOf(isTypeofLeft, rhs, lhs);
    const isTypeof =
      tested.kind == ExprKind.Unary && tested.op == UnaryOp.TypeOf;
    if (!isTypeof || tested.kind != ExprKind.Unary) {
      return undefined;
    }

    const facts = new Map<string, Type>();
    const slot = this.narrowable(tested.operand, module);
    if (slot == undefined || other.kind != ExprKind.StringLit) {
      return facts;
    }

    const narrowed = this.narrowings.typeofType(
      slot.type,
      other.value,
      isEqual,
    );
    if (narrowed != undefined) {
      facts.set(slot.key, narrowed);
    }

    return facts;
  }

  private readonly instanceFacts(
    lhs: Expr,
    rhs: Expr,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> {
    const facts = new Map<string, Type>();
    const slot = this.narrowable(lhs, module);
    if (slot == undefined || rhs.kind != ExprKind.Name) {
      return facts;
    }

    const valueClass = this.valueClassOf(rhs, module);
    if (valueClass != undefined && isTrue) {
      facts.set(slot.key, valueClass.instance);
    }
    if (valueClass != undefined) {
      return facts;
    }

    const name = rhs.name;
    const parts = this.types.unionMembers(slot.type);
    const kept = parts.filter(
      (part) => this.narrowings.isInstanceOf(part, name) == isTrue,
    );
    if (kept.length == 0 && isTrue) {
      const derived =
        this.derivedInstance(rhs, parts, module) ??
        this.libraryNarrowed(rhs, parts, module);
      if (derived != undefined) {
        facts.set(slot.key, derived);
      }

      return facts;
    }
    if (kept.length == 0) {
      return facts;
    }

    const union = this.store.unionOf(kept);

    facts.set(slot.key, union);

    return facts;
  }

  private readonly libraryNarrowed(
    rhs: Expr,
    parts: Read<Type[]>,
    module: int,
  ): Type | undefined {
    const isOpen = parts.some((part) =>
      this.objectMembers.isUnknownValue(part),
    );
    if (rhs.kind != ExprKind.Name || !isOpen) {
      return undefined;
    }
    if (!this.isLibraryName(rhs, module)) {
      return undefined;
    }

    const instance = this.resolver.libraryInstance(rhs.name, []);

    return instance ?? this.store.plain(TypeKind.Error);
  }

  private readonly derivedInstance(
    rhs: Expr,
    parts: Read<Type[]>,
    module: int,
  ): Type | undefined {
    if (rhs.kind != ExprKind.Name) {
      return undefined;
    }

    const target = this.targetOfName(rhs, module);
    if (target == undefined || target.kind != SymbolKind.Class) {
      return undefined;
    }
    if (this.isDeclaredLibrary(target.module, target.loc)) {
      return this.libraryDerived(rhs.name, parts);
    }

    const decl = this.record(target.module)?.classes.get(target.loc);
    if (decl == undefined || decl.typeParams.length > 0) {
      return undefined;
    }

    const instance = this.resolver.classInstance(target.module, decl, []);
    const isDerived = parts.some((part) =>
      this.relation.converts(instance, part),
    );
    if (!isDerived) {
      return undefined;
    }

    return instance;
  }

  private readonly libraryDerived(name: string, parts: Read<Type[]>): Type | undefined {
    const instance = this.resolver.libraryInstance(name, []);
    if (instance == undefined || instance.kind != TypeKind.Instance) {
      return undefined;
    }

    const isDerived = parts.some((part) =>
      this.relation.converts(instance, part),
    );
    if (!isDerived) {
      return undefined;
    }

    return instance;
  }

  private readonly narrowable(expr: Expr, module: int): NarrowSlot | undefined {
    const key = this.pathKey(expr, module);
    if (key == undefined) {
      return undefined;
    }

    const type = this.knownFact(key) ?? this.pathDeclared(expr, module);
    if (type == undefined || type.kind == TypeKind.Error) {
      return undefined;
    }

    return { key, type };
  }

  private readonly pathDeclared(expr: Expr, module: int): Type | undefined {
    if (expr.kind != ExprKind.Name) {
      return this.typed(expr, undefined, module);
    }

    const target = this.targetOfName(expr, module);
    if (target == undefined) {
      return undefined;
    }

    return this.declaredOf(target);
  }

  private readonly declaredOf(target: ValueTarget): Type | undefined {
    if (target.kind == SymbolKind.Parameter) {
      return this.parameterTyped(target);
    }

    return this.door(target.module, target.loc)?.type;
  }
}
