import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import {
  BinaryExpr,
  BinaryOp,
  Expr,
  ExprKind,
  MemberExpr,
  UnaryOp,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { SymbolKind } from "../../../../program/scopes/types/scopes.types.tz";
import {
  LiteralKind,
  Type,
  TypeKind,
} from "../../../../program/type/types/type.types.tz";
import { kTrueText } from "../../../types/type-resolver/const/type-resolver.const.tables.tz";
import {
  kArrayTypeOf,
  kDictTexts,
  kTypeOfTypes,
} from "../../../code/expression-types/const/expression-types.const.tz";
import {
  NarrowSlot,
  ValueTarget,
} from "../../../code/expression-types/types/expression-types.types.tz";

partial class ExpressionTypes {
  private factOf(target: ValueTarget): Type | undefined {
    const key = `${target.module} ${target.loc}`;

    return this.knownFact(key);
  }

  private knownFact(key: string): Type | undefined {
    const fact = this.facts.get(key);
    if (fact == undefined || fact.kind == TypeKind.Undefined) {
      return undefined;
    }

    return fact;
  }

  private underFacts(facts: Map<string, Type>): Map<string, Type> {
    const before = this.facts;

    this.facts = this.mergedFacts(before, facts);

    return before;
  }

  private mergedFacts(
    first: Map<string, Type>,
    second: Map<string, Type>,
  ): Map<string, Type> {
    const merged = new Map<string, Type>();

    for (const [key, type] of first) {
      merged.set(key, type);
    }

    for (const [key, type] of second) {
      merged.set(key, type);
    }

    return merged;
  }

  private joinedFacts(
    first: Map<string, Type>,
    second: Map<string, Type>,
  ): Map<string, Type> {
    const joined = new Map<string, Type>();

    for (const [key, type] of first) {
      const other = second.get(key);
      if (other != undefined) {
        const union = this.store.unionOf([type, other]);

        joined.set(key, union);
      }
    }

    return joined;
  }

  private factsOf(cond: Expr, isTrue: boolean, module: int): Map<string, Type> {
    switch (cond.kind) {
      case ExprKind.Unary:
        if (cond.op != UnaryOp.Not) {
          return new Map<string, Type>();
        }

        return this.factsOf(cond.operand, !isTrue, module);
      case ExprKind.Name:
      case ExprKind.Member:
      case ExprKind.OptionalChain:
      case ExprKind.Assign:
        return this.truthFacts(cond, isTrue, module);
      case ExprKind.Binary:
        return this.binaryFacts(cond, isTrue, module);
      case ExprKind.Call:
        return this.callFacts(cond, isTrue, module);
      default:
        return new Map<string, Type>();
    }
  }

  private truthFacts(
    cond: Expr,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> {
    const facts = new Map<string, Type>();
    const path = this.comparedPath(cond);
    if (path.kind == ExprKind.Member) {
      const literal = this.store.literal(LiteralKind.Boolean, kTrueText);

      this.literalTagFacts(path, literal, isTrue, facts, module);
    }

    const slot = this.narrowable(path, module);
    if (slot == undefined || !isTrue || !this.types.isOptional(slot.type)) {
      return facts;
    }

    const defined = this.types.definedType(slot.type);

    facts.set(slot.key, defined);
    this.linkFacts(path, facts, module);

    return facts;
  }

  private linkFacts(expr: Expr, facts: Map<string, Type>, module: int): void {
    if (expr.kind == ExprKind.OptionalChain) {
      return this.linkFacts(expr.chain, facts, module);
    }
    if (expr.kind != ExprKind.Member) {
      return;
    }

    const object = expr.object;
    const slot = this.narrowable(object, module);
    if (
      expr.optional &&
      slot != undefined &&
      this.types.isOptional(slot.type)
    ) {
      const defined = this.types.definedType(slot.type);

      facts.set(slot.key, defined);
    }

    this.linkFacts(object, facts, module);
  }

  private binaryFacts(
    cond: BinaryExpr,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> {
    switch (cond.op) {
      case BinaryOp.LogAnd:
        if (isTrue) {
          return this.bothFacts(cond, true, module);
        }

        return this.eitherFacts(cond, true, false, module);
      case BinaryOp.LogOr:
        if (isTrue) {
          return this.eitherFacts(cond, false, true, module);
        }

        return this.bothFacts(cond, false, module);
      case BinaryOp.Eq: {
        const facts = this.equalityFacts(cond.lhs, cond.rhs, isTrue, module);
        const bounds = this.comparisonBounds(cond, isTrue, module);

        return this.mergedFacts(facts, bounds);
      }
      case BinaryOp.Ne: {
        const facts = this.equalityFacts(cond.lhs, cond.rhs, !isTrue, module);
        const bounds = this.comparisonBounds(cond, isTrue, module);

        return this.mergedFacts(facts, bounds);
      }
      case BinaryOp.Lt:
      case BinaryOp.Le:
      case BinaryOp.Gt:
      case BinaryOp.Ge:
        return this.comparisonBounds(cond, isTrue, module);
      case BinaryOp.InstanceOf:
        return this.instanceFacts(cond.lhs, cond.rhs, isTrue, module);
      case BinaryOp.In:
        return this.keyFacts(cond.lhs, cond.rhs, isTrue, module);
      default:
        return new Map<string, Type>();
    }
  }

  private keyFacts(
    lhs: Expr,
    rhs: Expr,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> {
    const facts = new Map<string, Type>();
    const slot = this.narrowable(rhs, module);
    if (slot == undefined || lhs.kind != ExprKind.StringLit) {
      return facts;
    }

    const name = lhs.value;
    const parts = this.types.unionMembers(slot.type);
    const kept = parts.filter((part) => this.isKeyKept(part, name, isTrue));
    if (parts.length < 2 || kept.length == 0) {
      return facts;
    }

    facts.set(slot.key, this.store.unionOf(kept));

    return facts;
  }

  private isKeyKept(part: Type, name: string, isTrue: boolean): boolean {
    if (part.kind == TypeKind.Object) {
      const field = part.fields.find((one) => one.name == name);
      if (field == undefined) {
        return !isTrue;
      }

      return isTrue || field.optional;
    }
    if (part.kind != TypeKind.Instance) {
      return true;
    }

    const lookup = this.classMember(part, name);
    if (!lookup.isKnown) {
      return true;
    }

    return (lookup.entry != undefined) == isTrue;
  }

  private bothFacts(
    cond: BinaryExpr,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> {
    const left = this.factsOf(cond.lhs, isTrue, module);
    const before = this.underFacts(left);
    const right = this.factsOf(cond.rhs, isTrue, module);

    this.facts = before;

    return this.mergedFacts(left, right);
  }

  private eitherFacts(
    cond: BinaryExpr,
    isLeftTrue: boolean,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> {
    const left = this.factsOf(cond.lhs, isTrue, module);
    const passed = this.factsOf(cond.lhs, isLeftTrue, module);
    const before = this.underFacts(passed);
    const right = this.factsOf(cond.rhs, isTrue, module);

    this.facts = before;

    return this.joinedFacts(left, right);
  }

  private equalityFacts(
    lhs: Expr,
    rhs: Expr,
    isEqual: boolean,
    module: int,
  ): Map<string, Type> {
    const facts = new Map<string, Type>();
    const typeofFacts = this.typeofFacts(lhs, rhs, isEqual, module);
    if (typeofFacts != undefined) {
      return typeofFacts;
    }

    const left = this.comparedPath(lhs);
    const right = this.comparedPath(rhs);
    const isPathLeft = this.pathKey(left, module) != undefined;
    const name = this.sideOf(isPathLeft, left, right);
    const other = this.sideOf(isPathLeft, right, left);
    const slot = this.narrowable(name, module);
    if (slot == undefined) {
      return facts;
    }

    const narrowed = this.comparedType(slot.type, other, isEqual, module);
    if (narrowed != undefined) {
      facts.set(slot.key, narrowed);
    }

    const isDefined =
      narrowed != undefined &&
      narrowed.kind != TypeKind.Undefined &&
      !this.types.isOptional(narrowed);
    if (isDefined) {
      this.linkFacts(name, facts, module);
    }

    const tag = this.tagOf(name);
    if (tag != undefined) {
      this.tagFacts(tag, other, isEqual, facts, module);
    }

    return facts;
  }

  private comparedPath(expr: Expr): Expr {
    if (expr.kind == ExprKind.Assign && expr.op == undefined) {
      return expr.target;
    }

    return expr;
  }

  private tagOf(expr: Expr): MemberExpr | undefined {
    if (expr.kind == ExprKind.OptionalChain) {
      return this.tagOf(expr.chain);
    }
    if (expr.kind != ExprKind.Member) {
      return undefined;
    }

    return expr;
  }

  private tagFacts(
    tag: MemberExpr,
    other: Expr,
    isEqual: boolean,
    facts: Map<string, Type>,
    module: int,
  ): void {
    const literal = this.comparedLiteral(other, module);
    if (literal == undefined) {
      return;
    }

    this.literalTagFacts(tag, literal, isEqual, facts, module);
  }

  private literalTagFacts(
    tag: MemberExpr,
    literal: Type,
    isEqual: boolean,
    facts: Map<string, Type>,
    module: int,
  ): void {
    const owner = this.narrowable(tag.object, module);
    if (owner == undefined) {
      return;
    }

    const parts = this.flatMembers(owner.type);
    const kept = parts.filter((part) =>
      this.isTagKept(part, tag.name, literal, isEqual),
    );
    if (kept.length == 0 && !isEqual) {
      facts.set(owner.key, this.store.plain(TypeKind.Never));

      return;
    }
    if (kept.length == 0 || kept.length == parts.length) {
      return;
    }

    const union = this.store.unionOf(kept);

    facts.set(owner.key, union);
  }

  private flatMembers(type: Type): Type[] {
    if (type.kind != TypeKind.Union) {
      return [type];
    }

    const flat: Type[] = [];

    for (const part of type.parts) {
      for (const member of this.flatMembers(part)) {
        flat.push(member);
      }
    }

    return flat;
  }

  private isTagKept(
    part: Type,
    name: string,
    literal: Type,
    isEqual: boolean,
  ): boolean {
    const tag = this.partField(part, name);
    if (tag == undefined) {
      return !isEqual;
    }
    if (!isEqual) {
      return tag != literal;
    }

    const base = this.relation.baseOf(literal);
    const isOpen = tag == base || tag.kind == TypeKind.Error;

    return isOpen || this.holdsLiteral(tag, literal);
  }

  private sideOf(isFirst: boolean, first: Expr, second: Expr): Expr {
    if (isFirst) {
      return first;
    }

    return second;
  }

  private comparedType(
    type: Type,
    other: Expr,
    isEqual: boolean,
    module: int,
  ): Type | undefined {
    if (other.kind == ExprKind.Undefined) {
      return this.undefinedCompared(type, isEqual);
    }

    const literal = this.comparedLiteral(other, module);
    if (literal == undefined) {
      return undefined;
    }
    if (isEqual) {
      return this.literalPart(type, literal);
    }

    return this.withoutPart(type, literal);
  }

  private undefinedCompared(type: Type, isEqual: boolean): Type | undefined {
    if (!this.types.isOptional(type)) {
      return undefined;
    }
    if (isEqual) {
      return this.store.plain(TypeKind.Undefined);
    }

    return this.types.definedType(type);
  }

  private comparedLiteral(other: Expr, module: int): Type | undefined {
    const isWritten =
      other.kind == ExprKind.StringLit ||
      other.kind == ExprKind.IntLit ||
      other.kind == ExprKind.BoolLit ||
      other.kind == ExprKind.Unary ||
      other.kind == ExprKind.Member;
    const literal = this.literalOf(other, module);
    if (!isWritten || literal == undefined) {
      return undefined;
    }

    return this.store.literal(literal.kind, literal.text);
  }

  private literalPart(type: Type, literal: Type): Type | undefined {
    const parts = this.types.unionMembers(type);
    if (parts.includes(literal)) {
      return literal;
    }

    const base = this.relation.baseOf(literal);
    if (base != undefined && parts.includes(base)) {
      return literal;
    }

    return undefined;
  }

  private withoutPart(type: Type, literal: Type): Type | undefined {
    const parts = this.types.unionMembers(type);
    if (!parts.includes(literal)) {
      return undefined;
    }

    const kept = parts.filter((part) => part != literal);
    if (kept.length == 0) {
      return this.store.plain(TypeKind.Never);
    }

    return this.store.unionOf(kept);
  }

  private typeofFacts(
    lhs: Expr,
    rhs: Expr,
    isEqual: boolean,
    module: int,
  ): Map<string, Type> | undefined {
    const isTypeofLeft = lhs.kind == ExprKind.Unary && lhs.op == UnaryOp.TypeOf;
    const tested = this.sideOf(isTypeofLeft, lhs, rhs);
    const other = this.sideOf(isTypeofLeft, rhs, lhs);
    const isTypeof =
      tested.kind == ExprKind.Unary && tested.op == UnaryOp.TypeOf;
    if (!isTypeof || tested.kind != ExprKind.Unary) {
      return undefined;
    }

    const facts = new Map<string, Type>();
    const slot = this.narrowable(tested.operand, module);
    if (slot == undefined || other.kind != ExprKind.StringLit) {
      return facts;
    }

    const narrowed = this.typeofType(slot.type, other.value, isEqual);
    if (narrowed != undefined) {
      facts.set(slot.key, narrowed);
    }

    return facts;
  }

  private typeofType(
    type: Type,
    name: string,
    isEqual: boolean,
  ): Type | undefined {
    const kept: Type[] = [];

    for (const part of this.types.unionMembers(type)) {
      const isOpen =
        part.kind == TypeKind.Unknown ||
        part.kind == TypeKind.Json ||
        part.kind == TypeKind.TypeParameter;
      if (isOpen) {
        const open = this.openPart(part, name, isEqual);

        kept.push(open);

        continue;
      }

      const isNamed = this.typeOfNames(part).includes(name);
      if (isNamed == isEqual) {
        kept.push(part);
      }
    }

    if (kept.length == 0) {
      return undefined;
    }

    return this.store.unionOf(kept);
  }

  private openPart(part: Type, name: string, isEqual: boolean): Type {
    const row = kTypeOfTypes.find((one) => one.name == name);
    if (isEqual && name == kArrayTypeOf && part.kind == TypeKind.Unknown) {
      return this.store.arrayOf(part);
    }
    if (!isEqual || row == undefined) {
      return part;
    }

    const kind = row.kind;
    if (kind != TypeKind.Int) {
      return this.store.plain(kind);
    }

    return this.store.integer(row.bits, row.unsigned);
  }

  private instanceFacts(
    lhs: Expr,
    rhs: Expr,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> {
    const facts = new Map<string, Type>();
    const slot = this.narrowable(lhs, module);
    if (slot == undefined || rhs.kind != ExprKind.Name) {
      return facts;
    }

    const valueClass = this.valueClassOf(rhs, module);
    if (valueClass != undefined && isTrue) {
      facts.set(slot.key, valueClass.instance);
    }
    if (valueClass != undefined) {
      return facts;
    }

    const name = rhs.name;
    const parts = this.types.unionMembers(slot.type);
    const kept = parts.filter(
      (part) => this.isInstanceOf(part, name) == isTrue,
    );
    if (kept.length == 0 && isTrue) {
      const derived =
        this.derivedInstance(rhs, parts, module) ??
        this.libraryNarrowed(rhs, parts, module);
      if (derived != undefined) {
        facts.set(slot.key, derived);
      }

      return facts;
    }
    if (kept.length == 0) {
      return facts;
    }

    const union = this.store.unionOf(kept);

    facts.set(slot.key, union);

    return facts;
  }

  private libraryNarrowed(
    rhs: Expr,
    parts: Type[],
    module: int,
  ): Type | undefined {
    const isOpen = parts.some((part) => this.isUnknownValue(part));
    if (rhs.kind != ExprKind.Name || !isOpen) {
      return undefined;
    }
    if (!this.isLibraryName(rhs, module)) {
      return undefined;
    }

    const instance = this.resolver.libraryInstance(rhs.name, []);

    return instance ?? this.store.plain(TypeKind.Error);
  }

  private derivedInstance(
    rhs: Expr,
    parts: Type[],
    module: int,
  ): Type | undefined {
    if (rhs.kind != ExprKind.Name) {
      return undefined;
    }

    const target = this.targetOfName(rhs, module);
    if (target == undefined || target.kind != SymbolKind.Class) {
      return undefined;
    }

    const decl = this.record(target.module)?.classes.get(target.loc);
    if (decl == undefined || decl.typeParams.length > 0) {
      return undefined;
    }

    const instance = this.resolver.classInstance(target.module, decl, []);
    const isDerived = parts.some((part) =>
      this.relation.converts(instance, part),
    );
    if (!isDerived) {
      return undefined;
    }

    return instance;
  }

  private isInstanceOf(part: Type, name: string): boolean {
    switch (part.kind) {
      case TypeKind.Instance:
        return part.name == name;
      case TypeKind.Dict: {
        const dict = part.dict;
        const row = kDictTexts.find((one) => one.dict == dict);

        return row != undefined && row.kind == name;
      }
      default:
        return false;
    }
  }

  private narrowable(expr: Expr, module: int): NarrowSlot | undefined {
    const key = this.pathKey(expr, module);
    if (key == undefined) {
      return undefined;
    }

    const type = this.knownFact(key) ?? this.pathDeclared(expr, module);
    if (type == undefined || type.kind == TypeKind.Error) {
      return undefined;
    }

    return { key, type };
  }

  private pathDeclared(expr: Expr, module: int): Type | undefined {
    if (expr.kind != ExprKind.Name) {
      return this.typed(expr, undefined, module);
    }

    const target = this.targetOfName(expr, module);
    if (target == undefined) {
      return undefined;
    }

    return this.declaredOf(target);
  }

  private declaredOf(target: ValueTarget): Type | undefined {
    if (target.kind == SymbolKind.Parameter) {
      return this.parameterTyped(target);
    }

    return this.door(target.module, target.loc)?.type;
  }
}
