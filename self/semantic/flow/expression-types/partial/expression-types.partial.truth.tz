import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";
import {
  kBooleanName,
  kDateName,
  kLengthName,
  kNarrowedCodes,
  kNumberName,
  kOtherPlaceholder,
  kUnnamedOperand,
} from "../../../code/expression-types/const/expression-types.const.tz";
import { CallbackPlan } from "../../../code/expression-types/types/expression-types.types.tz";
import {
  TruthProblem,
  TruthTexts,
  TruthUse,
} from "../../truth-rules/types/truth-rules.types.tz";

partial class ExpressionTypes {
  private checkTruthy(
    expr: Expr,
    type: Type,
    use: TruthUse,
    other: Expr | undefined,
    module: int,
    shown: string = "",
  ): boolean {
    if (this.truth.problemOf(type) == TruthProblem.None) {
      return true;
    }

    const texts: TruthTexts = {
      word: this.shownWord(expr, shown),
      other: this.otherHint(other),
      isLength: this.isLength(expr),
    };
    const answer = this.truth.answerOf(type, use, texts);
    const narrowed = this.narrowedCode(expr, answer.code, module);
    if (narrowed != undefined) {
      const word = texts.word;
      const first = this.truth.holderNoun(answer.base);

      this.report(module, expr.loc, narrowed, { word, first });

      return false;
    }

    const base = answer.base;
    const code = this.classNameCode(expr, answer.code, base, module);

    this.report(module, expr.loc, code, answer.details);

    return false;
  }

  private shownWord(expr: Expr, shown: string): string {
    if (shown != "") {
      return shown;
    }

    return this.hintText(expr, kUnnamedOperand);
  }

  private booleanCallCheck(expr: CallExpr, module: int): void {
    const callee = expr.callee;
    const arg = expr.args[0];
    const isBoolean =
      callee.kind == ExprKind.Name &&
      callee.name == kBooleanName &&
      this.isGlobalUse(callee, module);
    if (!isBoolean || arg == undefined || expr.args.length != 1) {
      return;
    }

    this.quiet += 1;

    const type = this.typed(arg.expr, undefined, module);

    this.quiet -= 1;
    this.checkTruthy(arg.expr, type, TruthUse.Condition, undefined, module);
  }

  private numberCallCheck(expr: CallExpr, module: int): void {
    const callee = expr.callee;
    const arg = expr.args[0];
    const isNumber =
      callee.kind == ExprKind.Name &&
      callee.name == kNumberName &&
      this.isGlobalUse(callee, module);
    if (!isNumber || arg == undefined || expr.args.length != 1) {
      return;
    }

    this.quiet += 1;

    const type = this.typed(arg.expr, undefined, module);

    this.quiet -= 1;

    const code = this.numberSourceCode(type);
    if (code != undefined) {
      this.report(module, arg.expr.loc, code, { word: this.text.of(type) });
    }
  }

  private numberSourceCode(type: Type): Code | undefined {
    if (type.kind == TypeKind.Error) {
      return undefined;
    }
    if (this.types.isOptional(type) || type.kind == TypeKind.Undefined) {
      return Code.NumberOfUndefined;
    }

    const base = this.types.apparent(type);

    switch (base.kind) {
      case TypeKind.Int:
      case TypeKind.Double:
      case TypeKind.Decimal:
      case TypeKind.Boolean:
      case TypeKind.String:
      case TypeKind.Template:
      case TypeKind.Error:
      case TypeKind.TypeParameter:
        return undefined;
      case TypeKind.Instance:
        return this.dateSourceCode(base.name);
      default:
        return Code.NumberOfWrongType;
    }
  }

  private dateSourceCode(name: string): Code | undefined {
    if (name == kDateName) {
      return undefined;
    }

    return Code.NumberOfWrongType;
  }

  private booleanCallbackCheck(
    arg: Expr,
    plan: CallbackPlan,
    module: int,
  ): void {
    const isBoolean =
      arg.kind == ExprKind.Name &&
      arg.name == kBooleanName &&
      this.isGlobalUse(arg, module);
    const item = plan.params[0];
    if (!isBoolean || item == undefined) {
      return;
    }

    const use = TruthUse.Condition;

    this.checkTruthy(arg, item, use, undefined, module, kUnnamedOperand);
  }

  private narrowedCode(expr: Expr, code: Code, module: int): Code | undefined {
    const row = kNarrowedCodes.find((one) => one.code == code);
    if (row == undefined || expr.kind != ExprKind.Name) {
      return undefined;
    }

    const target = this.targetOfName(expr, module);
    if (target == undefined || this.factOf(target) == undefined) {
      return undefined;
    }

    const declared = this.declaredOf(target);
    if (declared == undefined || !this.types.isOptional(declared)) {
      return undefined;
    }

    return row.narrowed;
  }

  private otherHint(other: Expr | undefined): string {
    if (other == undefined) {
      return kOtherPlaceholder;
    }

    return this.hintText(other, kOtherPlaceholder);
  }

  private isLength(expr: Expr): boolean {
    if (expr.kind == ExprKind.OptionalChain) {
      return this.isLength(expr.chain);
    }

    return expr.kind == ExprKind.Member && expr.name == kLengthName;
  }
}
