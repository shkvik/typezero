import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  NameExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../program/ast/types/ast.types.functions.tz";
import { TypeRefKind } from "../../../../program/ast/types/ast.types.types.tz";
import { SymbolKind } from "../../../../program/scopes/types/scopes.types.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";
import {
  TypeContext,
  TypePlace,
} from "../../../types/type-resolver/types/type-resolver.types.tz";
import {
  kArrayName,
  kIsArrayName,
  kIsJsonName,
  kJsonName,
} from "../../../code/expression-types/const/expression-types.const.tz";

partial class ExpressionTypes {
  private callFacts(
    call: CallExpr,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> {
    const tree = this.types.program.tree;

    const callee = tree.exprOf(call.calleeId);
    if (this.isArrayCheck(callee, module)) {
      return this.arrayFacts(call, isTrue, module);
    }

    switch (callee.kind) {
      case ExprKind.Name:
        return this.functionGuardFacts(call, callee, isTrue, module);
      case ExprKind.Member:
        if (this.isJsonCheck(callee, module)) {
          return this.jsonFacts(call, isTrue, module);
        }
        if (callee.name == "isOk" || callee.name == "isErr") {
          return this.resultFacts(call, callee, isTrue, module);
        }

        return this.methodGuardFacts(call, callee, isTrue, module);
      default:
        return new Map<string, Type>();
    }
  }

  private readonly isArrayCheck(callee: Expr, module: int): boolean {
    const tree = this.types.program.tree;

    if (callee.kind != ExprKind.Member || callee.name != kIsArrayName) {
      return false;
    }

    const object = tree.exprOf(callee.objectId);

    return (
      object.kind == ExprKind.Name &&
      object.name == kArrayName &&
      this.isLibraryName(object, module)
    );
  }

  private arrayFacts(
    call: CallExpr,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> {
    const tree = this.types.program.tree;

    const facts = new Map<string, Type>();
    const arg = tree.argumentsOf(call.argsList)[0];
    if (arg == undefined) {
      return facts;
    }

    const expr = tree.exprOf(arg.exprId);
    const slot = this.narrowable(expr, module);
    if (slot == undefined) {
      return facts;
    }

    const kept = this.types
      .unionMembers(slot.type)
      .filter((part) => this.types.isListType(part) == isTrue);
    const isUnknown = slot.type.kind == TypeKind.Unknown;
    if (isUnknown && isTrue) {
      facts.set(slot.key, this.types.store.arrayOf(slot.type));

      return facts;
    }

    const isJson = this.types.definedType(slot.type).kind == TypeKind.Json;
    if (isJson && isTrue) {
      const json = this.types.store.plain(TypeKind.Json);

      facts.set(slot.key, this.types.store.arrayOf(json));

      return facts;
    }
    if (kept.length > 0) {
      const union = this.types.store.unionOf(kept);

      facts.set(slot.key, union);
    }

    return facts;
  }

  private readonly isJsonCheck(callee: MemberExpr, module: int): boolean {
    const tree = this.types.program.tree;

    const object = tree.exprOf(callee.objectId);

    return (
      callee.name == kIsJsonName &&
      object.kind == ExprKind.Name &&
      object.name == kJsonName &&
      this.isLibraryName(object, module)
    );
  }

  private jsonFacts(
    call: CallExpr,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> {
    const tree = this.types.program.tree;

    const facts = new Map<string, Type>();
    const arg = tree.argumentsOf(call.argsList)[0];
    if (arg == undefined || !isTrue) {
      return facts;
    }

    const expr = tree.exprOf(arg.exprId);
    const slot = this.narrowable(expr, module);
    if (slot != undefined && this.types.isUnknownValue(slot.type)) {
      facts.set(slot.key, this.types.store.plain(TypeKind.Json));
    }

    return facts;
  }

  private functionGuardFacts(
    call: CallExpr,
    callee: NameExpr,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> {
    const tree = this.types.program.tree;

    const target = this.targetOfName(callee, module);
    if (target == undefined || target.kind != SymbolKind.Function) {
      return new Map<string, Type>();
    }
    const isTyped = this.types.isTypedLibrary(target.module);
    if (this.types.isLibraryModule(target.module) && !isTyped) {
      return new Map<string, Type>();
    }

    const fn = this.record(target.module)?.functions.get(target.loc);
    if (fn == undefined) {
      return new Map<string, Type>();
    }

    const isPredicate =
      tree.typeRefAt(fn.returnTypeId)?.form.kind == TypeRefKind.Predicate;
    const summary = this.summaryFacts(call, fn, target.module, isTrue, module);
    if (!isPredicate && summary != undefined) {
      return summary;
    }

    const predicate = this.predicateFacts(call, fn, target.module, isTrue);
    if (predicate != undefined) {
      return predicate;
    }

    return this.unknownFacts(
      tree.argumentsOf(call.argsList).map((arg) => tree.exprOf(arg.exprId)),
      module,
    );
  }

  private predicateFacts(
    call: CallExpr,
    fn: FunctionDecl,
    home: int,
    isTrue: boolean,
  ): Map<string, Type> | undefined {
    const tree = this.types.program.tree;

    const written = tree.typeRefAt(fn.returnTypeId);
    const form = written?.form;
    if (written == undefined || form == undefined) {
      return undefined;
    }
    if (form.kind != TypeRefKind.Predicate || form.asserts) {
      return new Map<string, Type>();
    }

    const index = tree
      .paramsOf(fn.paramsList)
      .findIndex((param) => param.name == written.name);
    const arg = tree.argumentsOf(call.argsList)[index];
    const ref = tree.typeRefsOf(written.argsList)[0];
    if (
      arg == undefined ||
      ref == undefined ||
      tree.typeParamsOf(fn.typeParamsList).length > 0
    ) {
      return undefined;
    }

    const context: TypeContext = {
      module: home,
      bindings: new Map<int, Type>(),
      place: TypePlace.Plain,
    };
    const guarded = this.types.resolve(ref, context);

    const expr = tree.exprOf(arg.exprId);

    return this.guardedFacts(expr, guarded, isTrue, home);
  }

  private guardedFacts(
    expr: Expr,
    guarded: Type,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> {
    const facts = new Map<string, Type>();
    const slot = this.narrowable(expr, module);
    if (slot == undefined || guarded.kind == TypeKind.Error) {
      return facts;
    }

    const parts = this.types.unionMembers(slot.type);
    const kept = parts.filter(
      (part) => this.types.converts(part, guarded) == isTrue,
    );
    if (kept.length > 0) {
      const union = this.types.store.unionOf(kept);

      facts.set(slot.key, union);
    }
    if (kept.length == 0 && isTrue) {
      facts.set(slot.key, guarded);
    }

    return facts;
  }

  private methodGuardFacts(
    call: CallExpr,
    callee: MemberExpr,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> {
    const tree = this.types.program.tree;

    const summary = this.methodSummaryFacts(call, callee, isTrue, module);
    if (summary != undefined) {
      return summary;
    }

    const object = tree.exprOf(callee.objectId);
    const receiver = this.narrowable(object, module);
    const values = tree
      .argumentsOf(call.argsList)
      .map((arg) => tree.exprOf(arg.exprId));

    if (
      receiver == undefined ||
      !this.types.isOwnReceiver(receiver.type)
    ) {
      return this.unknownFacts(values, module);
    }

    const objectExpr = tree.exprOf(callee.objectId);

    values.push(objectExpr);

    return this.unknownFacts(values, module);
  }

  private methodSummaryFacts(
    call: CallExpr,
    callee: MemberExpr,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> | undefined {
    const tree = this.types.program.tree;

    const object = tree.exprOf(callee.objectId);
    const receiver = this.peekType(object, module);
    if (receiver.kind != TypeKind.Instance) {
      return undefined;
    }

    const entryLookup = this.classMember(receiver, callee.name);

    const entry = entryLookup.entry;
    const method = entry?.methods[0];
    if (entry == undefined || method == undefined || entry.isStatic) {
      return undefined;
    }

    const owner = entry.owner;
    const isGeneric =
      tree.typeParamsOf(method.typeParamsList).length > 0 ||
      tree.typeParamsOf(owner.typeParamsList).length > 0;
    if (entry.methods.length != 1 || isGeneric) {
      return undefined;
    }

    const instance = entry.instance;
    const type = this.methodFunction(owner, method, instance.module);
    const part = this.partOf(owner, method);
    const home = this.partModule(part, instance.module);
    const summary = this.summaryAt(`${home} ${method.loc}`);
    if (summary == undefined || !this.types.isBooleanFunction(type)) {
      return undefined;
    }

    return this.summaryApplied(call, summary, isTrue, module);
  }

  private unknownFacts(values: Read<Expr[]>, module: int): Map<string, Type> {
    const facts = new Map<string, Type>();
    const unknown = this.types.store.plain(TypeKind.Error);

    for (const value of values) {
      const slot = this.narrowable(value, module);
      if (slot == undefined) {
        continue;
      }
      if (slot.type.kind == TypeKind.Object) {
        this.types.unknownFields(
          slot.key,
          this.types.store.fieldsOf(slot.type),
          facts,
        );

        continue;
      }
      if (this.types.isGuardable(slot.type)) {
        facts.set(slot.key, unknown);
      }
    }

    return facts;
  }
}
