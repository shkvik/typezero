import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import {
  CallExpr,
  Expr,
  ExprKind,
  MemberExpr,
  NameExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../program/ast/types/ast.types.functions.tz";
import { TypeRefKind } from "../../../../program/ast/types/ast.types.types.tz";
import { SymbolKind } from "../../../../program/scopes/types/scopes.types.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";
import {
  TypeContext,
  TypePlace,
} from "../../../types/type-resolver/types/type-resolver.types.tz";
import {
  kArrayName,
  kIsArrayName,
  kIsJsonName,
  kJsonName,
} from "../../../code/expression-types/const/expression-types.const.tz";

partial class ExpressionTypes {
  private readonly callFacts(
    call: CallExpr,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> {
    const callee = call.callee;
    if (this.isArrayCheck(callee, module)) {
      return this.arrayFacts(call, isTrue, module);
    }

    switch (callee.kind) {
      case ExprKind.Name:
        return this.functionGuardFacts(call, callee, isTrue, module);
      case ExprKind.Member:
        if (this.isJsonCheck(callee, module)) {
          return this.jsonFacts(call, isTrue, module);
        }
        if (callee.name == "isOk" || callee.name == "isErr") {
          return this.resultFacts(call, callee, isTrue, module);
        }

        return this.methodGuardFacts(call, callee, isTrue, module);
      default:
        return new Map<string, Type>();
    }
  }

  private readonly isArrayCheck(callee: Expr, module: int): boolean {
    if (callee.kind != ExprKind.Member || callee.name != kIsArrayName) {
      return false;
    }

    const object = callee.object;

    return (
      object.kind == ExprKind.Name &&
      object.name == kArrayName &&
      this.isLibraryName(object, module)
    );
  }

  private readonly arrayFacts(
    call: CallExpr,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> {
    const facts = new Map<string, Type>();
    const arg = call.args[0];
    if (arg == undefined) {
      return facts;
    }

    const slot = this.narrowable(arg.expr, module);
    if (slot == undefined) {
      return facts;
    }

    const kept = this.types
      .unionMembers(slot.type)
      .filter((part) => this.narrowings.isListType(part) == isTrue);
    const isUnknown = slot.type.kind == TypeKind.Unknown;
    if (isUnknown && isTrue) {
      facts.set(slot.key, this.store.arrayOf(slot.type));

      return facts;
    }

    const isJson = this.types.definedType(slot.type).kind == TypeKind.Json;
    if (isJson && isTrue) {
      const json = this.store.plain(TypeKind.Json);

      facts.set(slot.key, this.store.arrayOf(json));

      return facts;
    }
    if (kept.length > 0) {
      const union = this.store.unionOf(kept);

      facts.set(slot.key, union);
    }

    return facts;
  }

  private readonly isJsonCheck(callee: MemberExpr, module: int): boolean {
    const object = callee.object;

    return (
      callee.name == kIsJsonName &&
      object.kind == ExprKind.Name &&
      object.name == kJsonName &&
      this.isLibraryName(object, module)
    );
  }

  private readonly jsonFacts(
    call: CallExpr,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> {
    const facts = new Map<string, Type>();
    const arg = call.args[0];
    if (arg == undefined || !isTrue) {
      return facts;
    }

    const slot = this.narrowable(arg.expr, module);
    if (slot != undefined && this.objectMembers.isUnknownValue(slot.type)) {
      facts.set(slot.key, this.store.plain(TypeKind.Json));
    }

    return facts;
  }

  private readonly functionGuardFacts(
    call: CallExpr,
    callee: NameExpr,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> {
    const target = this.targetOfName(callee, module);
    if (target == undefined || target.kind != SymbolKind.Function) {
      return new Map<string, Type>();
    }
    const isTyped = this.modules.isTypedLibrary(target.module);
    if (this.modules.isLibraryModule(target.module) && !isTyped) {
      return new Map<string, Type>();
    }

    const fn = this.record(target.module)?.functions.get(target.loc);
    if (fn == undefined) {
      return new Map<string, Type>();
    }

    const isPredicate = fn.returnType?.form.kind == TypeRefKind.Predicate;
    const summary = this.summaryFacts(call, fn, target.module, isTrue, module);
    if (!isPredicate && summary != undefined) {
      return summary;
    }

    const predicate = this.predicateFacts(call, fn, target.module, isTrue);
    if (predicate != undefined) {
      return predicate;
    }

    return this.unknownFacts(
      call.args.map((arg) => arg.expr),
      module,
    );
  }

  private readonly predicateFacts(
    call: CallExpr,
    fn: FunctionDecl,
    home: int,
    isTrue: boolean,
  ): Map<string, Type> | undefined {
    const written = fn.returnType;
    const form = written?.form;
    if (written == undefined || form == undefined) {
      return undefined;
    }
    if (form.kind != TypeRefKind.Predicate || form.asserts) {
      return new Map<string, Type>();
    }

    const index = fn.params.findIndex((param) => param.name == written.name);
    const arg = call.args[index];
    const ref = written.args[0];
    if (arg == undefined || ref == undefined || fn.typeParams.length > 0) {
      return undefined;
    }

    const context: TypeContext = {
      module: home,
      bindings: new Map<int, Type>(),
      place: TypePlace.Plain,
    };
    const guarded = this.resolver.resolve(ref, context);

    return this.guardedFacts(arg.expr, guarded, isTrue, home);
  }

  private readonly guardedFacts(
    expr: Expr,
    guarded: Type,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> {
    const facts = new Map<string, Type>();
    const slot = this.narrowable(expr, module);
    if (slot == undefined || guarded.kind == TypeKind.Error) {
      return facts;
    }

    const parts = this.types.unionMembers(slot.type);
    const kept = parts.filter(
      (part) => this.relation.converts(part, guarded) == isTrue,
    );
    if (kept.length > 0) {
      const union = this.store.unionOf(kept);

      facts.set(slot.key, union);
    }
    if (kept.length == 0 && isTrue) {
      facts.set(slot.key, guarded);
    }

    return facts;
  }

  private readonly methodGuardFacts(
    call: CallExpr,
    callee: MemberExpr,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> {
    const summary = this.methodSummaryFacts(call, callee, isTrue, module);
    if (summary != undefined) {
      return summary;
    }

    const receiver = this.narrowable(callee.object, module);
    const values = call.args.map((arg) => arg.expr);

    if (
      receiver == undefined ||
      !this.narrowings.isOwnReceiver(receiver.type)
    ) {
      return this.unknownFacts(values, module);
    }

    values.push(callee.object);

    return this.unknownFacts(values, module);
  }

  private readonly methodSummaryFacts(
    call: CallExpr,
    callee: MemberExpr,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> | undefined {
    const receiver = this.peekType(callee.object, module);
    if (receiver.kind != TypeKind.Instance) {
      return undefined;
    }

    const entry = this.classMember(receiver, callee.name).entry;
    const method = entry?.methods[0];
    if (entry == undefined || method == undefined || entry.isStatic) {
      return undefined;
    }

    const owner = entry.owner;
    const isGeneric =
      method.typeParams.length > 0 || owner.typeParams.length > 0;
    if (entry.methods.length != 1 || isGeneric) {
      return undefined;
    }

    const instance = entry.instance;
    const type = this.methodFunction(owner, method, instance.module);
    const part = this.partOf(owner, method);
    const home = this.partModule(part, instance.module);
    const summary = this.guardSummaries.get(`${home} ${method.loc}`);
    if (summary == undefined || !this.narrowings.isBooleanFunction(type)) {
      return undefined;
    }

    return this.summaryApplied(call, summary, isTrue, module);
  }

  private readonly unknownFacts(values: Read<Expr[]>, module: int): Map<string, Type> {
    const facts = new Map<string, Type>();
    const unknown = this.store.plain(TypeKind.Error);

    for (const value of values) {
      const slot = this.narrowable(value, module);
      if (slot == undefined) {
        continue;
      }
      if (slot.type.kind == TypeKind.Object) {
        this.narrowings.unknownFields(slot.key, slot.type.fields, facts);

        continue;
      }
      if (this.narrowings.isGuardable(slot.type)) {
        facts.set(slot.key, unknown);
      }
    }

    return facts;
  }
}
