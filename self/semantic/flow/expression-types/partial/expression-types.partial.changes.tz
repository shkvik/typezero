import {
  Expr,
  ExprKind,
  PropertyKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import {
  BoundSide,
  DeclaredVariable,
  Destination,
  HiddenName,
  ParamSlot,
  ValueRecord,
} from "../../../code/expression-types/types/expression-types.types.tz";
import { FunctionDecl } from "../../../../program/ast/types/ast.types.functions.tz";
import { Stmt } from "../../../../program/ast/types/ast.types.statements.tz";
import {
  NameSymbol,
  NameUse,
  SymbolKind,
} from "../../../../program/scopes/types/scopes.types.tz";
import {
  ClassDecl,
  EnumDecl,
} from "../../../../program/ast/types/ast.types.classes.tz";
import { Type } from "../../../../program/type/types/type.types.tz";
import { kDot } from "../../../code/source-texts/const/source-texts.const.tz";
import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";

partial class ExpressionTypes {
  private readonly forgetPatterned(target: Expr, module: int): void {
    switch (target.kind) {
      case ExprKind.Name:
      case ExprKind.Member: {
        const key = this.pathKey(target, module);
        if (key != undefined) {
          this.forgetPath(key);
        }

        return;
      }
      case ExprKind.ArrayLit:
        for (const element of target.elements) {
          this.forgetPatterned(element.expr, module);
        }

        return;
      case ExprKind.ObjectLit:
        for (const property of target.props) {
          if (property.form.kind != PropertyKind.Computed) {
            this.forgetPatterned(property.value, module);
          }
        }

        return;
      case ExprKind.Assign:
        return this.forgetPatterned(target.target, module);
      default:
        return;
    }
  }

  private readonly forgetCallChanged(module: int): void {
    for (const key of this.callChangedKeys(module)) {
      if (this.hasFactOf(key)) {
        this.forgetPath(key);
      }
    }
  }

  private readonly hasFactOf(key: string): boolean {
    for (const known of this.facts.keys()) {
      if (known.includes(key)) {
        return true;
      }
    }

    return false;
  }

  private readonly callChangedKeys(module: int): string[] {
    const known = this.callChanged.get(module)?.slice();
    if (known != undefined) {
      return known;
    }

    const keys: string[] = [];
    const record = this.record(module);

    this.callChanged.set(module, []);

    if (record == undefined) {
      return keys;
    }

    const functions = Array.from(record.functions.values());
    const seen = new Set<int>();

    for (const use of record.uses.values()) {
      const symbol = use.symbol;
      if (symbol == undefined || seen.has(symbol.loc)) {
        continue;
      }
      if (!this.isChangeable(symbol, module)) {
        continue;
      }

      const home = this.innermostFunction(functions, symbol.loc);
      const user = this.innermostFunction(functions, use.loc);
      if (user != undefined && user != home) {
        const key = `${module} ${symbol.loc}`;

        seen.add(symbol.loc);
        keys.push(key);
        this.callChanged.get(module)?.push(key);
      }
    }

    return keys;
  }

  private readonly isChangeable(symbol: NameSymbol, module: int): boolean {
    if (symbol.kind == SymbolKind.Parameter) {
      return true;
    }
    if (symbol.kind != SymbolKind.Variable) {
      return false;
    }

    const variable = this.record(module)?.variables.get(symbol.loc);

    return variable != undefined && !variable.isConst;
  }

  private readonly innermostFunction(
    functions: Read<FunctionDecl[]>,
    loc: int,
  ): FunctionDecl | undefined {
    let found: FunctionDecl | undefined = undefined;
    let start = -1;

    for (const fn of functions) {
      const span = fn.source;
      if (span == undefined || loc < span.start || loc >= span.end) {
        continue;
      }
      if (span.start > start) {
        found = fn;
        start = span.start;
      }
    }

    return found;
  }

  private readonly forgetPath(key: string): void {
    this.forgetFacts(key);
    this.forgetBounds(key, BoundSide.None);
  }

  private readonly forgetFacts(key: string): void {
    const prefix = key + kDot;
    const kept = new Map<string, Type>();

    for (const [known, type] of this.facts) {
      if (known != key && !known.startsWith(prefix)) {
        kept.set(known, type);
      }
    }

    this.facts = kept;
  }

  private readonly forgetLooped(statement: Stmt, module: int): void {
    const record = this.record(module);
    if (record == undefined) {
      return;
    }

    const scratch: ValueRecord = {
      uses: new Map<int, NameUse>(record.uses),
      hidden: new Map<string, HiddenName>(record.hidden),
      variables: new Map<int, DeclaredVariable>(),
      functions: new Map<int, FunctionDecl>(),
      params: new Map<int, ParamSlot>(),
      assigned: new Set<int>(),
      changes: [],
      enums: new Map<int, EnumDecl>(record.enums),
      classes: new Map<int, ClassDecl>(record.classes),
      destinations: new Map<int, Destination[]>(),
      owners: [],
    };

    this.indexStatement(statement, scratch);

    for (const loc of scratch.assigned) {
      const side = this.loopDirection(scratch.changes, loc, module);
      const key = `${module} ${loc}`;

      this.forgetFacts(key);
      this.forgetBounds(key, side);
    }

    for (const change of scratch.changes) {
      this.forgetChangedPart(change, module);
    }
  }

  private readonly forgetChangedPart(change: Expr, module: int): void {
    const target = this.bounds.changedTarget(change);
    if (target == undefined) {
      return;
    }
    if (target.kind == ExprKind.Member) {
      const key = this.pathKey(target, module);
      if (key != undefined) {
        this.forgetFacts(key);
      }

      return;
    }
    if (target.kind != ExprKind.Index) {
      return;
    }

    const key = this.pathKey(target.object, module);
    if (key != undefined) {
      this.forgetFacts(key);
    }
  }
}
