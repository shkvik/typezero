import { kBufferName } from "../../../library/byte-source-rules/const/byte-source-rules.const.tz";
import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import {
  Expr,
  ExprKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";
import { Linear } from "../../../code/expression-types/types/expression-types.types.tz";
import {
  kLengthTerm,
  kZeroTerm,
} from "../../bound-rules/const/bound-rules.const.tz";
import {
  OffsetLimit,
  ProofRange,
} from "../../proof-rules/types/proof-rules.types.tz";

partial class ExpressionTypes {
  private requireBetween(
    expr: Expr,
    given: Type,
    range: ProofRange,
    module: int,
  ): boolean {
    const isExempt =
      given.kind == TypeKind.Error || this.types.isLibraryModule(module);
    if (isExempt) {
      return false;
    }
    if (this.canProveBetween(expr, range, module)) {
      return true;
    }

    const constant = this.intConstant(expr, given, module);
    if (constant != undefined && this.types.isInside(constant, range)) {
      return true;
    }

    const shown = this.types.valueText(expr, module);
    const betweenError = this.types.betweenError(
      expr.loc,
      range,
      constant,
      given,
      shown,
    );

    this.errors.writeFound(module, betweenError);

    return false;
  }

  private canProveBetween(expr: Expr, range: ProofRange, module: int): boolean {
    const tree = this.types.program.tree;

    if (expr.kind == ExprKind.Conditional) {
      return (
        this.canProveBetween(tree.exprOf(expr.thenExprId), range, module) &&
        this.canProveBetween(tree.exprOf(expr.elseExprId), range, module)
      );
    }

    const value = this.linearOf(expr, module);
    const known = this.valueRange(expr, module);
    const high = range.high;
    const isLower =
      this.isAtLeast(value, range.low) || this.types.isFrom(known, range.low);
    if (high == undefined || !isLower) {
      return isLower;
    }

    return this.isAtMost(value, high) || this.types.isUpTo(known, high);
  }

  private readonly isAtLeast(value: Linear | undefined, low: decimal): boolean {
    if (value == undefined) {
      return false;
    }
    if (value.term == kZeroTerm) {
      return value.offset >= low;
    }

    return this.canProve(kZeroTerm, value.term, low - value.offset);
  }

  private readonly isAtMost(value: Linear | undefined, high: decimal): boolean {
    if (value == undefined) {
      return false;
    }
    if (value.term == kZeroTerm) {
      return value.offset <= high;
    }

    return this.canProve(value.term, kZeroTerm, value.offset - high);
  }

  private requireUpTo(
    value: Expr | undefined,
    object: Expr,
    limit: OffsetLimit,
    module: int,
  ): boolean {
    if (this.types.isLibraryModule(module)) {
      return false;
    }
    if (value != undefined) {
      const given = this.peekType(value, module);
      if (given.kind == TypeKind.Error) {
        return true;
      }
    }
    if (this.canProveUpTo(value, object, limit.less, module)) {
      return true;
    }

    const holder = this.peekType(object, module);
    const hasBytes = this.types.isRaw(holder);
    const shown = this.shownOffset(value, module);
    const objectText = this.types.valueText(object, module);
    const place = this.types.limitText(objectText, hasBytes, limit.less);
    const loc = value?.loc ?? object.loc;
    const upToError = this.types.upToError(loc, limit.what, shown, place);

    this.errors.writeFound(module, upToError);

    return false;
  }

  private readonly shownOffset(
    value: Expr | undefined,
    module: int,
  ): string | undefined {
    if (value == undefined) {
      return undefined;
    }

    return this.types.valueText(value, module);
  }

  private canProveUpTo(
    value: Expr | undefined,
    object: Expr,
    less: decimal,
    module: int,
  ): boolean {
    const length = this.measuredLength(object, module);
    if (length == undefined) {
      return false;
    }
    if (value == undefined) {
      const zero: Linear = { term: kZeroTerm, offset: 0 };

      return this.isLinearUpTo(zero, length, less);
    }

    const natural: ProofRange = { what: "", low: 0 };
    if (!this.canProveBetween(value, natural, module)) {
      return false;
    }

    const at = this.linearOf(value, module);
    if (at != undefined && this.isLinearUpTo(at, length, less)) {
      return true;
    }

    const highest = this.valueRange(value, module).hi;
    if (highest == undefined) {
      return false;
    }

    const top: Linear = { term: kZeroTerm, offset: highest };

    return this.isLinearUpTo(top, length, less);
  }

  private readonly isLinearUpTo(
    value: Linear,
    length: Linear,
    less: decimal,
  ): boolean {
    const room = value.offset + less - length.offset;

    return this.canProve(value.term, length.term, room);
  }

  private measuredLength(object: Expr, module: int): Linear | undefined {
    const tree = this.types.program.tree;

    if (object.kind == ExprKind.Member && object.name == kBufferName) {
      const objectExpr = tree.exprOf(object.objectId);

      return this.bufferLength(objectExpr, module);
    }
    if (object.kind != ExprKind.Name) {
      return this.madeLinear(object, module);
    }

    const key = this.pathKey(object, module);
    if (key == undefined) {
      return undefined;
    }

    const term = kLengthTerm + key;

    this.rememberFixedCount(object, term, module);

    if (this.isFixedLength(object, module)) {
      this.fixedLengths.add(term);
    }

    return { term, offset: 0 };
  }

  private bufferLength(view: Expr, module: int): Linear | undefined {
    const type = this.peekType(view, module);
    const size = this.types.elementSize(type);
    const length = this.measuredLength(view, module);
    if (size == undefined || length == undefined) {
      return undefined;
    }
    if (size == 1) {
      return length;
    }

    const exact = this.settledLinear(length);
    if (exact.term != kZeroTerm) {
      return undefined;
    }

    return { term: kZeroTerm, offset: exact.offset * size };
  }

  private readonly settledLinear(value: Linear): Linear {
    if (value.term == kZeroTerm) {
      return value;
    }

    const above = this.bestRoom(kZeroTerm, value.term);
    const below = this.bestRoom(value.term, kZeroTerm);
    if (above == undefined || below == undefined || above != -below) {
      return value;
    }

    return { term: kZeroTerm, offset: above + value.offset };
  }
}
