import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import {
  Expr,
  ExprKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import {
  IfStmt,
  Stmt,
  StmtKind,
  SwitchStmt,
} from "../../../../program/ast/types/ast.types.statements.tz";
import {
  kExitName,
  kPanicName,
  kProcessName,
} from "../../../code/expression-types/const/expression-types.const.tz";

partial class ExpressionTypes {
  private readonly isAlwaysReturning(
    statement: Stmt | undefined,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    if (statement == undefined) {
      return false;
    }

    switch (statement.kind) {
      case StmtKind.Return:
        return true;
      case StmtKind.Expr:
        const expr = tree.exprOf(statement.exprId);

        return this.isExit(expr, module);
      case StmtKind.Block:
        return tree
          .stmtsOf(statement.bodyList)
          .some((one) => this.isAlwaysReturning(one, module));
      case StmtKind.If:
        return this.isIfReturning(statement, module);
      case StmtKind.While:
      case StmtKind.DoWhile:
        return (
          this.types.isTrueLiteral(tree.exprOf(statement.condId)) &&
          !this.types.hasBreak(tree.stmtOf(statement.bodyId))
        );
      case StmtKind.For:
        return (
          this.types.isForever(tree.exprAt(statement.condId)) &&
          !this.types.hasBreak(tree.stmtAt(statement.bodyId))
        );
      case StmtKind.Switch:
        return this.isSwitchReturning(statement, module);
      case StmtKind.Labeled:
        return (
          this.isAlwaysReturning(tree.stmtOf(statement.bodyId), module) &&
          !this.types.hasBreak(tree.stmtOf(statement.bodyId))
        );
      default:
        return false;
    }
  }

  private readonly isExit(expr: Expr, module: int): boolean {
    const tree = this.types.program.tree;

    if (expr.kind != ExprKind.Call) {
      return false;
    }

    const callee = tree.exprOf(expr.calleeId);
    if (callee.kind == ExprKind.Name) {
      return callee.name == kPanicName && this.isLibraryName(callee, module);
    }
    if (callee.kind != ExprKind.Member || callee.name != kExitName) {
      return false;
    }

    const owner = tree.exprOf(callee.objectId);
    if (owner.kind != ExprKind.Name || owner.name != kProcessName) {
      return false;
    }

    return this.record(module)?.uses.get(owner.loc)?.symbol == undefined;
  }

  private readonly isIfReturning(statement: IfStmt, module: int): boolean {
    const tree = this.types.program.tree;

    const cond = tree.exprOf(statement.condId);
    const literal = this.types.literalCondition(cond);
    const elseStmt = tree.stmtAt(statement.elseStmtId);
    if (literal == true && elseStmt == undefined) {
      const thenStmt = tree.stmtOf(statement.thenStmtId);

      return this.isAlwaysReturning(thenStmt, module);
    }

    const isEmptyThen =
      tree.stmtOf(statement.thenStmtId).kind == StmtKind.Empty;
    if (literal == false && isEmptyThen) {
      return this.isAlwaysReturning(elseStmt, module);
    }
    if (elseStmt == undefined) {
      return false;
    }

    return (
      this.isAlwaysReturning(tree.stmtOf(statement.thenStmtId), module) &&
      this.isAlwaysReturning(elseStmt, module)
    );
  }

  private readonly isSwitchReturning(
    statement: SwitchStmt,
    module: int,
  ): boolean {
    const tree = this.types.program.tree;

    const cases = tree.casesOf(statement.casesList);
    const last = cases[cases.length - 1];
    const hasDefault = cases.some(
      (option) => tree.exprAt(option.testId) == undefined,
    );
    const isCovered = this.coveredSwitches.has(`${module} ${statement.loc}`);
    if ((!hasDefault && !isCovered) || last == undefined) {
      return false;
    }

    const isLeaving = cases.some((option) =>
      tree.stmtsOf(option.bodyList).some((one) => this.types.hasBreak(one)),
    );
    if (isLeaving) {
      return false;
    }

    return tree
      .stmtsOf(last.bodyList)
      .some((one) => this.isAlwaysReturning(one, module));
  }
}
