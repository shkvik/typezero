import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import { kNoDetails } from "../../../../diagnostic/const/message.const.tz";
import { MethodKind } from "../../../../program/ast/types/ast.types.classes.tz";
import {
  Expr,
  ExprKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import {
  FunctionDecl,
  Param,
} from "../../../../program/ast/types/ast.types.functions.tz";
import {
  TypeRef,
  TypeRefKind,
} from "../../../../program/ast/types/ast.types.types.tz";
import { SymbolKind } from "../../../../program/scopes/types/scopes.types.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";
import {
  TypeContext,
  TypePlace,
} from "../../../types/type-resolver/types/type-resolver.types.tz";
import { kThisName } from "../../../code/expression-types/const/expression-types.const.tz";
import { ValueTarget } from "../../../code/expression-types/types/expression-types.types.tz";

partial class ExpressionTypes {
  private predicateDeclCheck(
    fn: FunctionDecl,
    written: TypeRef,
    module: int,
  ): void {
    const form = written.form;
    if (form.kind != TypeRefKind.Predicate) {
      return;
    }
    if (form.asserts) {
      return this.assertsReport(fn, written, module);
    }
    if (written.name == kThisName) {
      return this.thisPredicateCheck(fn, written, module);
    }
    if (this.predicateParam(fn, written.name) != undefined) {
      return;
    }

    this.report(module, written.loc, Code.PredicateNotParameter, {
      word: written.name,
    });
  }

  private thisPredicateCheck(
    fn: FunctionDecl,
    written: TypeRef,
    module: int,
  ): void {
    if (this.isInstanceMethod(fn)) {
      return;
    }

    this.report(module, written.loc, Code.PredicateThisOutside, kNoDetails);
  }

  private isInstanceMethod(fn: FunctionDecl): boolean {
    const method = fn.role?.method;

    return method == MethodKind.Instance || method == MethodKind.Abstract;
  }

  private predicateParam(fn: FunctionDecl, name: string): Param | undefined {
    let found: Param | undefined = undefined;

    for (const param of fn.params) {
      if (param.name == name) {
        found = param;
      }
    }

    return found;
  }

  private assertsReport(fn: FunctionDecl, written: TypeRef, module: int): void {
    const guarded = this.predicateGuard(written, module);
    const shown = this.shownPredicate(written, guarded);
    const other = this.assertsAdvice(shown, guarded);
    const place = this.assertsCall(fn);

    this.report(module, written.loc, Code.AssertsRefusedCall, {
      word: shown,
      other,
      place,
    });
  }

  private predicateGuard(written: TypeRef, module: int): Type | undefined {
    const ref = written.args[0];
    if (ref == undefined) {
      return undefined;
    }

    const context: TypeContext = {
      module,
      bindings: new Map<int, Type>(),
      place: TypePlace.Plain,
    };

    return this.resolver.resolve(ref, context);
  }

  private shownPredicate(written: TypeRef, guarded: Type | undefined): string {
    if (guarded == undefined) {
      return written.name;
    }

    const type = this.text.of(guarded);

    return `${written.name} is ${type}`;
  }

  private assertsAdvice(shown: string, guarded: Type | undefined): string {
    if (guarded == undefined) {
      return "boolean";
    }

    return shown;
  }

  private assertsCall(fn: FunctionDecl): string {
    const names = fn.params.map((param) => param.name);
    const args = names.join(", ");
    const call = `${fn.name}(${args})`;
    const self = this.selves[this.selves.length - 1];
    if (!this.isInstanceMethod(fn) || self == undefined) {
      return call;
    }

    const owner = this.text.of(self);
    const first = owner.slice(0, 1);
    const rest = owner.slice(1);
    const lower = first.toLowerCase();

    return `${lower}${rest}.${call}`;
  }

  private predicateReturnCheck(
    fn: FunctionDecl,
    value: Expr,
    module: int,
  ): void {
    const written = fn.returnType;
    const form = written?.form;
    if (written == undefined || form == undefined) {
      return;
    }

    const isGuard = form.kind == TypeRefKind.Predicate && !form.asserts;
    const isFalse = value.kind == ExprKind.BoolLit && !value.value;
    if (!isGuard || isFalse) {
      return;
    }

    const param = this.predicateParam(fn, written.name);
    const guarded = this.predicateGuard(written, module);
    if (param == undefined || guarded == undefined) {
      return;
    }
    if (guarded.kind == TypeKind.Error) {
      return;
    }

    const target: ValueTarget = {
      module,
      kind: SymbolKind.Parameter,
      loc: param.loc,
    };
    const known = this.knownWhenTrue(value, target, module);
    if (this.relation.converts(known, guarded)) {
      return;
    }

    this.report(module, value.loc, Code.PredicateUnproven, {
      word: this.functionLabel(fn),
      first: this.shownPredicate(written, guarded),
      second: this.text.of(known),
      other: written.name,
    });
  }

  private knownWhenTrue(value: Expr, target: ValueTarget, module: int): Type {
    const before = this.facts;

    this.quiet += 1;

    const truthy = this.factsOf(value, true, module);

    this.quiet -= 1;
    this.facts = this.mergedFacts(before, truthy);

    const known = this.factOf(target) ?? this.parameterTyped(target);

    this.facts = before;

    return known;
  }
}
