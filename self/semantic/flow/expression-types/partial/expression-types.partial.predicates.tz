import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import { Code } from "../../../../diagnostic/code.tz";
import {
  Expr,
  ExprKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../program/ast/types/ast.types.functions.tz";
import {
  TypeRef,
  TypeRefKind,
} from "../../../../program/ast/types/ast.types.types.tz";
import { SymbolKind } from "../../../../program/scopes/types/scopes.types.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";
import {
  TypeContext,
  TypePlace,
} from "../../../types/type-resolver/types/type-resolver.types.tz";
import { kThisName } from "../../../code/expression-types/const/expression-types.const.tz";
import { ValueTarget } from "../../../code/expression-types/types/expression-types.types.tz";

partial class ExpressionTypes {
  private predicateDeclCheck(
    fn: FunctionDecl,
    written: TypeRef,
    module: int,
  ): void {
    const form = written.form;
    if (form.kind != TypeRefKind.Predicate) {
      return;
    }
    if (form.asserts) {
      return this.assertsReport(fn, written, module);
    }
    if (written.name == kThisName) {
      const thisPredicateError = this.types.thisPredicateCheck(
        fn,
        written,
      );

      return this.errors.writeFound(module, thisPredicateError);
    }
    if (this.types.predicateParam(fn, written.name) != undefined) {
      return;
    }

    this.errors.write(module, written.loc, Code.PredicateNotParameter, {
      word: written.name,
    });
  }

  private assertsReport(fn: FunctionDecl, written: TypeRef, module: int): void {
    const guarded = this.predicateGuard(written, module);
    const shown = this.types.shownPredicate(written, guarded);
    const other = this.types.assertsAdvice(shown, guarded);
    const place = this.assertsCall(fn);

    this.errors.write(module, written.loc, Code.AssertsRefusedCall, {
      word: shown,
      other,
      place,
    });
  }

  private predicateGuard(written: TypeRef, module: int): Type | undefined {
    const tree = this.types.program.tree;

    const ref = tree.typeRefsOf(written.argsList)[0];
    if (ref == undefined) {
      return undefined;
    }

    const context: TypeContext = {
      module,
      bindings: new Map<int, Type>(),
      place: TypePlace.Plain,
    };

    return this.types.resolve(ref, context);
  }

  private readonly assertsCall(fn: FunctionDecl): string {
    const tree = this.types.program.tree;

    const names = tree.paramsOf(fn.paramsList).map((param) => param.name);
    const args = names.join(", ");
    const call = `${fn.name}(${args})`;
    const self = this.selves[this.selves.length - 1];
    if (!this.types.isInstanceMethod(fn) || self == undefined) {
      return call;
    }

    const owner = this.types.typeText(self);
    const first = owner.slice(0, 1);
    const rest = owner.slice(1);
    const lower = first.toLowerCase();

    return `${lower}${rest}.${call}`;
  }

  private predicateReturnCheck(
    fn: FunctionDecl,
    value: Expr,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const written = tree.typeRefAt(fn.returnTypeId);
    const form = written?.form;
    if (written == undefined || form == undefined) {
      return;
    }

    const isGuard = form.kind == TypeRefKind.Predicate && !form.asserts;
    const isFalse = value.kind == ExprKind.BoolLit && !value.value;
    if (!isGuard || isFalse) {
      return;
    }

    const param = this.types.predicateParam(fn, written.name);
    const guarded = this.predicateGuard(written, module);
    if (param == undefined || guarded == undefined) {
      return;
    }
    if (guarded.kind == TypeKind.Error) {
      return;
    }

    const target: ValueTarget = {
      module,
      kind: SymbolKind.Parameter,
      loc: param.loc,
    };
    const known = this.knownWhenTrue(value, target, module);
    if (this.types.converts(known, guarded)) {
      return;
    }

    this.errors.write(module, value.loc, Code.PredicateUnproven, {
      word: this.types.functionLabel(fn),
      first: this.types.shownPredicate(written, guarded),
      second: this.types.typeText(known),
      other: written.name,
    });
  }

  private knownWhenTrue(value: Expr, target: ValueTarget, module: int): Type {
    const before = this.factsCopy();

    this.errors.beginTrial();

    const truthy = this.factsOf(value, true, module);

    this.errors.endTrial();
    this.facts = this.types.mergedFacts(before, truthy);

    const known = this.factOf(target) ?? this.parameterTyped(target);

    this.facts = before;

    return known;
  }
}
