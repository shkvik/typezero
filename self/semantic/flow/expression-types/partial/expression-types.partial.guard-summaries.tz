import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import {
  CallExpr,
  Expr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../program/ast/types/ast.types.functions.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";
import { kValueTerm } from "../../../code/expression-types/const/expression-types.const.tz";
import {
  FunctionFrame,
  GuardBuild,
  GuardSummary,
} from "../../../code/expression-types/types/expression-types.types.tz";
import {
  kLengthTerm,
  kZeroTerm,
} from "../../bound-rules/const/bound-rules.const.tz";

partial class ExpressionTypes {
  private noteGuardExit(
    value: Expr | undefined,
    frame: FunctionFrame,
    module: int,
  ): void {
    if (value == undefined || frame.fn == undefined) {
      return;
    }

    const guard = frame.guard;
    const isTrue = this.types.isLiteralTruth(value, true);
    const isFalse = this.types.isLiteralTruth(value, false);

    if (!isFalse) {
      const whenTrue = this.exitFacts(value, true, module);

      guard.whenTrue = this.types.joinedSide(guard.whenTrue, whenTrue);
    }
    if (!isTrue) {
      const whenFalse = this.exitFacts(value, false, module);

      guard.whenFalse = this.types.joinedSide(guard.whenFalse, whenFalse);
    }
  }

  private exitFacts(
    value: Expr,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> {
    this.errors.beginTrial();

    const facts = this.factsOf(value, isTrue, module);

    this.errors.endTrial();

    return this.types.mergedFacts(this.facts, facts);
  }

  private rememberGuard(
    fn: FunctionDecl,
    frame: Read<FunctionFrame>,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    if (fn.isGenerator) {
      return;
    }

    const params = tree
      .paramsOf(fn.paramsList)
      .map((param) => `${module} ${param.loc}`);
    const guard = frame.guard;
    const whenTrue = this.projectedSide(guard, true, params);
    const whenFalse = this.projectedSide(guard, false, params);
    const summary: GuardSummary = { params, whenTrue, whenFalse };

    this.guardSummaries.set(`${module} ${fn.loc}`, summary);
  }

  private readonly projectedSide(
    guard: Read<GuardBuild>,
    isTrue: boolean,
    params: Read<string[]>,
  ): Map<string, Type> | undefined {
    if (isTrue) {
      return this.projected(guard.whenTrue, params);
    }

    return this.projected(guard.whenFalse, params);
  }

  private readonly projected(
    side: Read<Map<string, Type> | undefined>,
    params: Read<string[]>,
  ): Map<string, Type> | undefined {
    if (side == undefined) {
      return undefined;
    }

    const projected = new Map<string, Type>();

    for (const [key, type] of side) {
      const isParam = params.some((param) =>
        this.types.isParamPath(key, param),
      );
      if (isParam || this.isParamBound(key, params)) {
        projected.set(key, type);
      }
    }

    return projected;
  }

  private readonly isParamBound(key: string, params: Read<string[]>): boolean {
    const terms = this.types.boundTerms(key);
    if (terms.length == 0) {
      return false;
    }

    return terms.every(
      (term) =>
        term == kZeroTerm ||
        params.some(
          (param) => term == kValueTerm + param || term == kLengthTerm + param,
        ),
    );
  }

  private summaryFacts(
    call: CallExpr,
    fn: FunctionDecl,
    home: int,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> | undefined {
    const type = this.functionAt(home, fn.loc);
    const summary = this.summaryAt(`${home} ${fn.loc}`);
    if (summary == undefined || !this.types.isBooleanFunction(type)) {
      return undefined;
    }

    return this.summaryApplied(call, summary, isTrue, module);
  }

  private readonly summaryAt(key: string): GuardSummary | undefined {
    const summary = this.guardSummaries.get(key);
    if (summary == undefined) {
      return undefined;
    }

    const params = summary.params.slice();
    const whenTrue = this.sideCopy(summary.whenTrue);
    const whenFalse = this.sideCopy(summary.whenFalse);

    return { params, whenTrue, whenFalse };
  }

  private readonly sideCopy(
    facts: Read<Map<string, Type> | undefined>,
  ): Map<string, Type> | undefined {
    if (facts == undefined) {
      return undefined;
    }

    return new Map<string, Type>(facts);
  }

  private summaryApplied(
    call: CallExpr,
    summary: Read<GuardSummary>,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> {
    const facts = new Map<string, Type>();

    if (isTrue) {
      this.sideApplied(call, summary, summary.whenTrue, facts, module);
    } else {
      this.sideApplied(call, summary, summary.whenFalse, facts, module);
    }

    return facts;
  }

  private sideApplied(
    call: CallExpr,
    summary: Read<GuardSummary>,
    side: Read<Map<string, Type> | undefined>,
    facts: Map<string, Type>,
    module: int,
  ): void {
    if (side == undefined) {
      return;
    }

    const moves = this.boundMoves(call, summary, module);

    for (const [key, narrowed] of side) {
      const moved = this.types.movedBound(key, moves);
      if (moved != "") {
        facts.set(moved, narrowed);

        continue;
      }

      this.appliedFact(call, summary, key, narrowed, facts, module);
    }
  }

  private boundMoves(
    call: CallExpr,
    summary: Read<GuardSummary>,
    module: int,
  ): Map<string, string> {
    const tree = this.types.program.tree;

    const moves = new Map<string, string>();

    for (let index = 0; index < summary.params.length; index++) {
      const param = summary.params[index];
      const arg = tree.argumentsOf(call.argsList)[index];
      if (param == undefined || arg == undefined || arg.spread) {
        continue;
      }

      const expr = tree.exprOf(arg.exprId);
      const key = this.pathKey(expr, module);
      if (key == undefined) {
        continue;
      }

      moves.set(kValueTerm + param, kValueTerm + key);
      moves.set(kLengthTerm + param, kLengthTerm + key);
    }

    return moves;
  }

  private appliedFact(
    call: CallExpr,
    summary: Read<GuardSummary>,
    key: string,
    narrowed: Type,
    facts: Map<string, Type>,
    module: int,
  ): void {
    const tree = this.types.program.tree;

    const index = summary.params.findIndex((param) =>
      this.types.isParamPath(key, param),
    );
    const param = summary.params[index];
    const arg = tree.argumentsOf(call.argsList)[index];
    if (param == undefined || arg == undefined || arg.spread) {
      return;
    }

    const expr = tree.exprOf(arg.exprId);
    const slot = this.narrowable(expr, module);
    if (slot == undefined || narrowed.kind == TypeKind.Error) {
      return;
    }

    const path = key.slice(param.length);
    const place = slot.key + path;
    const now = this.currentOf(place, path, slot.type);
    if (now == undefined) {
      facts.set(place, narrowed);

      return;
    }

    const kept = this.keptByGuard(now, narrowed);
    if (kept != undefined) {
      facts.set(place, kept);
    }
  }

  private readonly currentOf(
    place: string,
    path: string,
    type: Type,
  ): Type | undefined {
    if (path == "") {
      return type;
    }

    return this.knownFact(place);
  }

  private keptByGuard(now: Type, narrowed: Type): Type | undefined {
    if (now.kind == TypeKind.Error || this.types.converts(now, narrowed)) {
      return undefined;
    }
    if (this.types.converts(narrowed, now)) {
      return narrowed;
    }

    const kept = this.types
      .unionMembers(now)
      .filter((part) => this.types.converts(part, narrowed));
    if (kept.length == 0) {
      return undefined;
    }

    return this.types.store.unionOf(kept);
  }
}
