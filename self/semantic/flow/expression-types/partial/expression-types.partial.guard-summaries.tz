import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import {
  CallExpr,
  Expr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { FunctionDecl } from "../../../../program/ast/types/ast.types.functions.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";
import { kValueTerm } from "../../../code/expression-types/const/expression-types.const.tz";
import {
  FunctionFrame,
  GuardBuild,
  GuardSummary,
} from "../../../code/expression-types/types/expression-types.types.tz";
import {
  kLengthTerm,
  kZeroTerm,
} from "../../bound-rules/const/bound-rules.const.tz";

partial class ExpressionTypes {
  private noteGuardExit(
    value: Expr | undefined,
    frame: FunctionFrame,
    module: int,
  ): void {
    if (value == undefined || frame.fn == undefined) {
      return;
    }

    const guard = frame.guard;
    const isTrue = this.shapes.isLiteralTruth(value, true);
    const isFalse = this.shapes.isLiteralTruth(value, false);

    if (!isFalse) {
      const whenTrue = this.exitFacts(value, true, module);

      guard.whenTrue = this.narrowings.joinedSide(guard.whenTrue, whenTrue);
    }
    if (!isTrue) {
      const whenFalse = this.exitFacts(value, false, module);

      guard.whenFalse = this.narrowings.joinedSide(guard.whenFalse, whenFalse);
    }
  }

  private exitFacts(
    value: Expr,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> {
    this.errors.beginTrial();

    const facts = this.factsOf(value, isTrue, module);

    this.errors.endTrial();

    return this.narrowings.mergedFacts(this.facts, facts);
  }

  private rememberGuard(
    fn: FunctionDecl,
    frame: Read<FunctionFrame>,
    module: int,
  ): void {
    if (fn.isGenerator) {
      return;
    }

    const params = fn.params.map((param) => `${module} ${param.loc}`);
    const guard = frame.guard;
    const whenTrue = this.projectedSide(guard, true, params);
    const whenFalse = this.projectedSide(guard, false, params);
    const summary: GuardSummary = { params, whenTrue, whenFalse };

    this.guardSummaries.set(`${module} ${fn.loc}`, summary);
  }

  private readonly projectedSide(
    guard: Read<GuardBuild>,
    isTrue: boolean,
    params: Read<string[]>,
  ): Map<string, Type> | undefined {
    const side = this.narrowings.guardSide(guard, isTrue);
    if (side == undefined) {
      return undefined;
    }

    const projected = new Map<string, Type>();

    for (const [key, type] of side) {
      const isParam = params.some((param) =>
        this.narrowings.isParamPath(key, param),
      );
      if (isParam || this.isParamBound(key, params)) {
        projected.set(key, type);
      }
    }

    return projected;
  }

  private readonly isParamBound(key: string, params: Read<string[]>): boolean {
    const terms = this.bounds.boundTerms(key);
    if (terms.length == 0) {
      return false;
    }

    return terms.every(
      (term) =>
        term == kZeroTerm ||
        params.some(
          (param) => term == kValueTerm + param || term == kLengthTerm + param,
        ),
    );
  }

  private summaryFacts(
    call: CallExpr,
    fn: FunctionDecl,
    home: int,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> | undefined {
    const type = this.functionAt(home, fn.loc);
    const summary = this.guardSummaries.get(`${home} ${fn.loc}`);
    if (summary == undefined || !this.narrowings.isBooleanFunction(type)) {
      return undefined;
    }

    return this.summaryApplied(call, summary, isTrue, module);
  }

  private summaryApplied(
    call: CallExpr,
    summary: Read<GuardSummary>,
    isTrue: boolean,
    module: int,
  ): Map<string, Type> {
    const facts = new Map<string, Type>();
    const side = this.narrowings.summarySide(summary, isTrue);
    if (side == undefined) {
      return facts;
    }

    const moves = this.boundMoves(call, summary, module);

    for (const [key, narrowed] of side) {
      const moved = this.bounds.movedBound(key, moves);
      if (moved != "") {
        facts.set(moved, narrowed);

        continue;
      }

      this.appliedFact(call, summary, key, narrowed, facts, module);
    }

    return facts;
  }

  private boundMoves(
    call: CallExpr,
    summary: Read<GuardSummary>,
    module: int,
  ): Map<string, string> {
    const moves = new Map<string, string>();

    for (let index = 0; index < summary.params.length; index++) {
      const param = summary.params[index];
      const arg = call.args[index];
      if (param == undefined || arg == undefined || arg.spread) {
        continue;
      }

      const key = this.pathKey(arg.expr, module);
      if (key == undefined) {
        continue;
      }

      moves.set(kValueTerm + param, kValueTerm + key);
      moves.set(kLengthTerm + param, kLengthTerm + key);
    }

    return moves;
  }

  private appliedFact(
    call: CallExpr,
    summary: Read<GuardSummary>,
    key: string,
    narrowed: Type,
    facts: Map<string, Type>,
    module: int,
  ): void {
    const index = summary.params.findIndex((param) =>
      this.narrowings.isParamPath(key, param),
    );
    const param = summary.params[index];
    const arg = call.args[index];
    if (param == undefined || arg == undefined || arg.spread) {
      return;
    }

    const slot = this.narrowable(arg.expr, module);
    if (slot == undefined || narrowed.kind == TypeKind.Error) {
      return;
    }

    const path = key.slice(param.length);
    const place = slot.key + path;
    const now = this.currentOf(place, path, slot.type);
    if (now == undefined) {
      facts.set(place, narrowed);

      return;
    }

    const kept = this.keptByGuard(now, narrowed);
    if (kept != undefined) {
      facts.set(place, kept);
    }
  }

  private readonly currentOf(place: string, path: string, type: Type): Type | undefined {
    if (path == "") {
      return type;
    }

    return this.knownFact(place);
  }

  private readonly keptByGuard(now: Type, narrowed: Type): Type | undefined {
    if (now.kind == TypeKind.Error || this.relation.converts(now, narrowed)) {
      return undefined;
    }
    if (this.relation.converts(narrowed, now)) {
      return narrowed;
    }

    const kept = this.types
      .unionMembers(now)
      .filter((part) => this.relation.converts(part, narrowed));
    if (kept.length == 0) {
      return undefined;
    }

    return this.store.unionOf(kept);
  }
}
