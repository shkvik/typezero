import { kBufferName } from "../../../library/byte-source-rules/const/byte-source-rules.const.tz";
import {
  kLengthTerm,
  kZeroTerm,
} from "../../bound-rules/const/bound-rules.const.tz";
import {
  Expr,
  ExprKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { Type } from "../../../../program/type/types/type.types.tz";
import { Linear } from "../../../code/expression-types/types/expression-types.types.tz";
import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";

partial class ExpressionTypes {
  private literalLength(key: string, value: Expr): void {
    if (value.kind != ExprKind.ArrayLit) {
      return;
    }

    const isPlain = value.elements.every((one) => !one.spread && !one.hole);
    if (!isPlain) {
      return;
    }

    const length: Linear = { term: kLengthTerm + key, offset: 0 };
    const count = value.elements.length.toDecimal();
    const zero: Linear = { term: kZeroTerm, offset: 0 };
    const facts = new Map<string, Type>(this.facts);

    this.bounds.addBound(facts, length, zero, count);
    this.facts = facts;
  }

  private madeLength(key: string, value: Expr, module: int): void {
    const count = this.madeLinear(value, module);
    if (count == undefined) {
      return;
    }

    const length: Linear = { term: kLengthTerm + key, offset: 0 };
    const facts = new Map<string, Type>(this.facts);

    this.fixedLengths.add(length.term);
    this.bounds.addBound(facts, length, count, 0);
    this.facts = facts;
  }

  private declaredLength(key: string, value: Expr, module: int): void {
    const count = this.madeLinear(value, module);
    if (count == undefined) {
      return;
    }

    const length: Linear = { term: kLengthTerm + key, offset: 0 };
    const facts = new Map<string, Type>(this.facts);

    this.fixedLengths.add(length.term);
    this.bounds.addEquality(facts, length, count);
    this.facts = facts;
  }

  private madeLinear(value: Expr, module: int): Linear | undefined {
    const sized = this.sizedLinear(value, module);
    if (sized != undefined) {
      return sized;
    }

    return this.viewLinear(value, module);
  }

  private sizedLinear(value: Expr, module: int): Linear | undefined {
    const size =
      this.shapes.madeSize(value) ?? this.shapes.allocatedSize(value);
    const source = this.shapes.copiedSource(value);

    if (size != undefined) {
      const sized = this.listedLinear(size) ?? this.linearOf(size, module);
      if (sized != undefined) {
        return sized;
      }
    }
    if (source != undefined) {
      return this.listedLinear(source) ?? this.textLinear(source);
    }

    return undefined;
  }

  private listedLinear(value: Expr): Linear | undefined {
    if (value.kind != ExprKind.ArrayLit) {
      return undefined;
    }

    const isPlain = value.elements.every((one) => !one.spread && !one.hole);
    if (!isPlain) {
      return undefined;
    }

    return { term: kZeroTerm, offset: value.elements.length.toDecimal() };
  }

  private textLinear(value: Expr): Linear | undefined {
    if (value.kind != ExprKind.StringLit) {
      return undefined;
    }

    const size = Buffer.byteLength(value.value);

    return { term: kZeroTerm, offset: size.toDecimal() };
  }

  private viewLinear(value: Expr, module: int): Linear | undefined {
    const view = this.shapes.viewOf(value);
    if (view == undefined) {
      return undefined;
    }

    const length = view.length;
    if (length != undefined) {
      return this.linearOf(length, module);
    }

    const whole = this.wholeLinear(view.buffer, module);
    const start = this.offsetLinear(view.offset, module);
    const size = this.byteSources.sizeOfName(view.name);
    if (whole == undefined || start == undefined || size == undefined) {
      return undefined;
    }
    if (start.term != kZeroTerm) {
      return undefined;
    }
    if (size == 1) {
      return { term: whole.term, offset: whole.offset - start.offset };
    }

    const exact = this.settledLinear(whole);
    const bytes = exact.offset - start.offset;
    if (exact.term != kZeroTerm || bytes % size != 0) {
      return undefined;
    }

    return { term: kZeroTerm, offset: bytes / size };
  }

  private wholeLinear(buffer: Expr, module: int): Linear | undefined {
    const size = this.shapes.madeBuffer(buffer);
    if (size != undefined) {
      return this.linearOf(size, module);
    }

    const holder = this.peekType(buffer, module);
    if (!this.bytes.isRaw(holder)) {
      return undefined;
    }

    return this.freshLength(buffer, module);
  }

  private freshLength(buffer: Expr, module: int): Linear | undefined {
    if (buffer.kind != ExprKind.Member || buffer.name != kBufferName) {
      return this.measuredLength(buffer, module);
    }

    const view = buffer.object;
    const count = this.madeLinear(view, module);
    const type = this.peekType(view, module);
    const size = this.byteSources.elementSize(type);
    if (count == undefined || size == undefined || count.term != kZeroTerm) {
      return undefined;
    }

    return { term: kZeroTerm, offset: count.offset * size };
  }

  private embeddedLength(key: string, value: Expr, module: int): void {
    const relative = this.shapes.embeddedPath(value);
    const home = this.program.modules[module]?.source.path;
    if (relative == undefined || home == undefined) {
      return;
    }

    const size = this.embedded.sizeOf(home, relative);
    if (size == undefined) {
      return;
    }

    const length: Linear = { term: kLengthTerm + key, offset: 0 };
    const zero: Linear = { term: kZeroTerm, offset: 0 };
    const facts = new Map<string, Type>(this.facts);

    this.fixedLengths.add(length.term);
    this.bounds.addBound(facts, length, zero, size.toDecimal());
    this.facts = facts;
  }
}
