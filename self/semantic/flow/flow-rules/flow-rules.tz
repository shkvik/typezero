import {
  Checked,
  SourceError,
} from "../../../diagnostic/types/message.types.tz";
import { Code } from "../../../diagnostic/code.tz";
import {
  AssignExpr,
  BinaryOp,
  ExprKind,
  IndexExpr,
} from "../../../program/ast/types/ast.types.expressions.tz";
import { Type, TypeKind } from "../../../program/type/types/type.types.tz";
import { ExpressionShapes } from "../../code/expression-shapes/expression-shapes.tz";
import { TypeText } from "../../../program/type/type-text/type-text.tz";
import { TruthUse } from "../truth-rules/types/truth-rules.types.tz";
import { TypeStore } from "../../../program/type/type-store/type-store.tz";
import { TypeRelation } from "../../types/type-relation/type-relation.tz";
import { TypeQuestions } from "../../types/type-questions/type-questions.tz";

export class FlowRules {
  private readonly store: TypeStore;
  private readonly relation: TypeRelation;
  private readonly types: TypeQuestions;
  private readonly text: TypeText;
  private readonly shapes: ExpressionShapes;

  public constructor(
    store: TypeStore,
    relation: Own<TypeRelation>,
    types: Own<TypeQuestions>,
    text: TypeText,
    shapes: ExpressionShapes,
  ) {
    this.store = store;
    this.relation = relation;
    this.types = types;
    this.text = text;
    this.shapes = shapes;
  }

  public readonly logicalAssignWord(isAnd: boolean): string {
    if (isAnd) {
      return "&&=";
    }

    return "||=";
  }

  public readonly assignUse(op: BinaryOp | undefined): TruthUse {
    if (op == BinaryOp.LogOr) {
      return TruthUse.OrAssign;
    }

    return TruthUse.AndAssign;
  }

  public readonly assignedWanted(
    op: BinaryOp | undefined,
    declared: Type | undefined,
  ): Type | undefined {
    const isPlain =
      op == undefined || op == BinaryOp.LogOr || op == BinaryOp.Nullish;
    if (!isPlain || declared == undefined) {
      return undefined;
    }
    if (declared.kind == TypeKind.Error) {
      return undefined;
    }

    return declared;
  }

  public readonly assignedFact(
    op: BinaryOp | undefined,
    declared: Type,
    current: Type | undefined,
    given: Type,
  ): Type | undefined {
    const isDefaulting = op == BinaryOp.LogOr || op == BinaryOp.Nullish;

    if (declared.kind != TypeKind.Union) {
      return undefined;
    }
    if (isDefaulting && current != undefined) {
      return this.defaultedFact(declared, current, given);
    }
    if (op != undefined || given.kind == TypeKind.Error) {
      return undefined;
    }
    if (!this.relation.converts(given, declared)) {
      return undefined;
    }

    return given;
  }

  public readonly withFact(
    facts: Read<Map<string, Type>>,
    key: string,
    type: Type,
  ): Map<string, Type> {
    const copy = new Map<string, Type>(facts);

    copy.set(key, type);

    return copy;
  }

  public readonly branchesJoined(
    before: Read<Map<string, Type>>,
    thenStart: Read<Map<string, Type>>,
    thenEnd: Read<Map<string, Type>>,
    elseStart: Read<Map<string, Type>>,
    elseEnd: Read<Map<string, Type>>,
  ): Map<string, Type> {
    const joined = new Map<string, Type>(before);
    const keys = new Set<string>(thenEnd.keys());

    for (const key of elseEnd.keys()) {
      keys.add(key);
    }

    for (const key of before.keys()) {
      keys.add(key);
    }

    for (const key of keys) {
      const isThenChanged = thenEnd.get(key) != thenStart.get(key);
      const isElseChanged = elseEnd.get(key) != elseStart.get(key);
      if (!isThenChanged && !isElseChanged) {
        continue;
      }

      const thenType = thenEnd.get(key);
      const elseType = elseEnd.get(key);

      joined.delete(key);

      if (thenType != undefined && elseType != undefined) {
        const union = this.store.unionOf([thenType, elseType]);

        joined.set(key, union);
      }
    }

    return joined;
  }

  public readonly tupleWriteCheck(
    target: IndexExpr,
    tuple: Type,
  ): SourceError | undefined {
    const index = target.index;
    if (tuple.kind != TypeKind.Tuple || !tuple.readonly) {
      return undefined;
    }
    if (index.kind != ExprKind.IntLit) {
      return undefined;
    }

    return {
      code: Code.ObjectReadOnlyField,
      loc: target.loc,
      details: {
        word: `${index.value}`,
        first: this.text.of(tuple),
      },
    };
  }

  public readonly logicalTargetCheck(expr: AssignExpr): Checked<boolean> {
    const op = expr.op;
    const isLogical = op == BinaryOp.LogAnd || op == BinaryOp.LogOr;
    if (!isLogical || this.shapes.isSimpleTarget(expr.target)) {
      return { value: false };
    }

    const word = this.logicalAssignWord(op == BinaryOp.LogAnd);

    return {
      value: true,
      error: {
        code: Code.LogicalAssignSimple,
        loc: expr.target.loc,
        details: { word },
      },
    };
  }

  private readonly defaultedFact(declared: Type, current: Type, given: Type): Type {
    const defined = this.types.definedType(current);
    const isKnown =
      given.kind != TypeKind.Error && this.relation.converts(given, declared);
    if (!isKnown) {
      return defined;
    }

    return this.store.unionOf([defined, given]);
  }
}
