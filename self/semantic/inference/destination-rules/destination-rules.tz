import {
  DictKind,
  DictType,
  Type,
  TypeKind,
} from "../../../program/type/types/type.types.tz";
import { TypeStore } from "../../../program/type/type-store/type-store.tz";
import {
  kElementMethods,
  kFillMethod,
  kKeyMethods,
  kSetMethod,
} from "./const/destination-rules.const.tz";

export class DestinationRules {
  public readonly memberParameter(
    store: Read<TypeStore>,
    object: Type,
    name: string,
    index: int,
  ): Type | undefined {
    if (object.kind == TypeKind.Array) {
      const item = store.itemOf(object);

      return this.arrayParameter(item, name, index);
    }
    if (object.kind == TypeKind.Dict) {
      return this.dictParameter(store, object, name, index);
    }

    return undefined;
  }

  private readonly arrayParameter(
    item: Type,
    name: string,
    index: int,
  ): Type | undefined {
    if (kElementMethods.includes(name)) {
      return item;
    }
    if (name == kFillMethod && index == 0) {
      return item;
    }

    return undefined;
  }

  private readonly dictParameter(
    store: Read<TypeStore>,
    dict: DictType,
    name: string,
    index: int,
  ): Type | undefined {
    const isMap = dict.dict == DictKind.Map;
    if (isMap && name == kSetMethod) {
      return this.pairPart(store, dict, index);
    }

    const isKeyed = dict.dict != DictKind.Record && kKeyMethods.includes(name);
    if (isKeyed && index == 0) {
      return store.keyOf(dict);
    }

    return undefined;
  }

  private readonly pairPart(
    store: Read<TypeStore>,
    dict: DictType,
    index: int,
  ): Type | undefined {
    switch (index) {
      case 0:
        return store.keyOf(dict);
      case 1:
        return store.valueOf(dict);
      default:
        return undefined;
    }
  }
}
