import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import { ClassDecl } from "../../../../program/ast/types/ast.types.classes.tz";
import {
  BinaryOp,
  CallExpr,
  Expr,
  ExprKind,
  NewKind,
  PropertyKind,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { TypeRef } from "../../../../program/ast/types/ast.types.types.tz";
import { SymbolKind } from "../../../../program/scopes/types/scopes.types.tz";
import {
  FunctionDecl,
  ParamKind,
} from "../../../../program/ast/types/ast.types.functions.tz";
import {
  Stmt,
  StmtKind,
  VarDeclStmt,
} from "../../../../program/ast/types/ast.types.statements.tz";
import {
  Destination,
  DestinationKind,
  ValueDraft,
} from "../../../code/expression-types/types/expression-types.types.tz";
import { kHiddenMark } from "../../../code/source-texts/const/source-texts.const.tz";

partial class ExpressionTypes {
  private readonly indexStatements(
    statements: Read<Stmt[]>,
    record: ValueDraft,
  ): void {
    for (const statement of statements) {
      this.indexStatement(statement, record);
    }
  }

  private readonly indexOptionalStatement(
    statement: Stmt | undefined,
    record: ValueDraft,
  ): void {
    if (statement != undefined) {
      this.indexStatement(statement, record);
    }
  }

  private readonly indexStatement(statement: Stmt, record: ValueDraft): void {
    const tree = this.types.program.tree;

    switch (statement.kind) {
      case StmtKind.Block:
        const body = tree.stmtsOf(statement.bodyList);

        return this.indexStatements(body, record);
      case StmtKind.VarDecl:
        return this.indexVariables(statement, record);
      case StmtKind.Function:
        return this.indexFunction(statement, record);
      case StmtKind.Expr:
        const expr = tree.exprOf(statement.exprId);

        return this.indexExpression(expr, record);
      case StmtKind.If:
        const cond = tree.exprOf(statement.condId);

        this.indexExpression(cond, record);
        const thenStmt = tree.stmtOf(statement.thenStmtId);

        this.indexStatement(thenStmt, record);

        return this.indexOptionalStatement(
          tree.stmtAt(statement.elseStmtId),
          record,
        );
      case StmtKind.While:
      case StmtKind.DoWhile:
        const condExpr = tree.exprOf(statement.condId);

        this.indexExpression(condExpr, record);

        const bodyStmt = tree.stmtOf(statement.bodyId);

        return this.indexStatement(bodyStmt, record);
      case StmtKind.For:
        const init = tree.stmtAt(statement.initId);

        this.indexOptionalStatement(init, record);
        const statementCond = tree.exprAt(statement.condId);

        this.indexOptionalExpression(statementCond, record);
        const step = tree.exprAt(statement.stepId);

        this.indexOptionalExpression(step, record);

        return this.indexOptionalStatement(
          tree.stmtAt(statement.bodyId),
          record,
        );
      case StmtKind.ForOf: {
        const decl = statement.binding;
        const isConst = statement.isConst;

        record.variables.set(decl.loc, { decl, isConst, loop: statement });
        this.keepHidden(decl.name, SymbolKind.Variable, decl.loc, record);
        const iterable = tree.exprOf(statement.iterableId);

        this.indexExpression(iterable, record);

        const statementBody = tree.stmtOf(statement.bodyId);

        return this.indexStatement(statementBody, record);
      }
      case StmtKind.Switch:
        const discriminant = tree.exprOf(statement.discriminantId);

        this.indexExpression(discriminant, record);

        for (const option of tree.casesOf(statement.casesList)) {
          const test = tree.exprAt(option.testId);

          this.indexOptionalExpression(test, record);
          const bodyItem = tree.stmtsOf(option.bodyList);

          this.indexStatements(bodyItem, record);
        }

        return;
      case StmtKind.Labeled:
        return this.indexStatement(tree.stmtOf(statement.bodyId), record);
      case StmtKind.Return:
        const value = tree.exprAt(statement.valueId);

        this.keepReturned(value, record);

        return this.indexOptionalExpression(
          tree.exprAt(statement.valueId),
          record,
        );
      case StmtKind.Class:
        return this.indexClass(statement, record);
      case StmtKind.Enum:
        record.enums.set(statement.loc, statement);

        return;
      default:
        return;
    }
  }

  private readonly keepHidden(
    name: string,
    kind: SymbolKind,
    loc: int,
    record: ValueDraft,
  ): void {
    if (name.startsWith(kHiddenMark)) {
      record.hidden.set(name, { kind, loc });
    }
  }

  private readonly indexVariables(
    statement: VarDeclStmt,
    record: ValueDraft,
  ): void {
    const tree = this.types.program.tree;

    const isConst = statement.isConst;

    for (const decl of tree.declaratorsOf(statement.declsList)) {
      record.variables.set(decl.loc, { decl, isConst });
      this.keepHidden(decl.name, SymbolKind.Variable, decl.loc, record);
      this.keepDeclared(
        tree.exprAt(decl.initId),
        tree.typeRefAt(decl.typeAnnId),
        record,
      );
      const init = tree.exprAt(decl.initId);

      this.indexOptionalExpression(init, record);
    }
  }

  private readonly keepDestination(
    value: Expr | undefined,
    destination: Destination,
    record: ValueDraft,
  ): void {
    if (value == undefined || value.kind != ExprKind.Name) {
      return;
    }

    const symbol = record.uses.get(value.loc)?.symbol;
    if (symbol == undefined || symbol.kind != SymbolKind.Variable) {
      return;
    }

    if (!record.destinations.has(symbol.loc)) {
      record.destinations.set(symbol.loc, []);
    }

    record.destinations.get(symbol.loc)?.push(destination);
  }

  private readonly keepAssigned(
    target: Expr,
    value: Expr,
    op: BinaryOp | undefined,
    record: ValueDraft,
  ): void {
    if (op == undefined) {
      const kind = DestinationKind.Assigned;

      this.keepDestination(target, { kind, index: 0, value }, record);
    }
  }

  private readonly keepDeclared(
    value: Expr | undefined,
    written: TypeRef | undefined,
    record: ValueDraft,
  ): void {
    if (written != undefined) {
      const kind = DestinationKind.Declared;

      this.keepDestination(value, { kind, index: 0, written }, record);
    }
  }

  private readonly keepReturned(
    value: Expr | undefined,
    record: ValueDraft,
  ): void {
    const tree = this.types.program.tree;

    const fn = record.owners[record.owners.length - 1];
    if (fn != undefined && tree.typeRefAt(fn.returnTypeId) != undefined) {
      const kind = DestinationKind.Returned;

      this.keepDestination(value, { kind, index: 0, fn }, record);
    }
  }

  private readonly keepArguments(call: CallExpr, record: ValueDraft): void {
    const tree = this.types.program.tree;

    const kind = DestinationKind.Argument;

    for (
      let index = 0;
      index < tree.argumentsOf(call.argsList).length;
      index++
    ) {
      const arg = tree.argumentsOf(call.argsList)[index];
      if (arg != undefined && !arg.spread) {
        this.keepDestination(
          tree.exprOf(arg.exprId),
          { kind, index, call },
          record,
        );
      }
    }
  }

  private readonly indexFunction(fn: FunctionDecl, record: ValueDraft): void {
    const tree = this.types.program.tree;

    record.functions.set(fn.loc, fn);

    for (const param of tree.paramsOf(fn.paramsList)) {
      const form = param.form;

      record.params.set(param.loc, { fn, param });
      this.keepHidden(param.name, SymbolKind.Parameter, param.loc, record);

      if (form.kind == ParamKind.Defaulted) {
        const defaultValue = tree.exprOf(form.defaultValueId);

        this.indexExpression(defaultValue, record);
      }
    }

    const body = tree.blockAt(fn.bodyId);
    if (body != undefined) {
      record.owners.push(fn);
      const bodyItem = tree.stmtsOf(body.bodyList);

      this.indexStatements(bodyItem, record);
      record.owners.pop();
    }
  }

  private readonly indexClass(decl: ClassDecl, record: ValueDraft): void {
    const tree = this.types.program.tree;

    record.classes.set(decl.loc, decl);

    for (const field of tree.fieldsOf(decl.fieldsList)) {
      const init = tree.exprAt(field.initId);

      this.indexOptionalExpression(init, record);
    }

    for (const fn of tree.functionsOf(decl.constructorsList)) {
      this.indexFunction(fn, record);
    }

    for (const fn of tree.functionsOf(decl.methodsList)) {
      if (decl.isPartial || this.partOf(decl, fn).id == decl.id) {
        this.indexFunction(fn, record);
      }
    }
  }

  private readonly indexAssigned(target: Expr, record: ValueDraft): void {
    if (target.kind != ExprKind.Name) {
      return;
    }

    const symbol = record.uses.get(target.loc)?.symbol;
    if (symbol != undefined) {
      record.assigned.add(symbol.loc);
    }
  }

  private readonly indexOptionalExpression(
    expr: Expr | undefined,
    record: ValueDraft,
  ): void {
    if (expr != undefined) {
      this.indexExpression(expr, record);
    }
  }

  private readonly indexExpressions(
    exprs: Read<Expr[]>,
    record: ValueDraft,
  ): void {
    for (const expr of exprs) {
      this.indexExpression(expr, record);
    }
  }

  private readonly indexExpression(expr: Expr, record: ValueDraft): void {
    const tree = this.types.program.tree;

    switch (expr.kind) {
      case ExprKind.Member:
        const object = tree.exprOf(expr.objectId);

        return this.indexExpression(object, record);
      case ExprKind.Index:
        const objectExpr = tree.exprOf(expr.objectId);

        this.indexExpression(objectExpr, record);

        const index = tree.exprOf(expr.indexId);

        return this.indexExpression(index, record);
      case ExprKind.Unary:
        const operand = tree.exprOf(expr.operandId);

        return this.indexExpression(operand, record);
      case ExprKind.Binary:
        const lhs = tree.exprOf(expr.lhsId);

        this.indexExpression(lhs, record);

        const rhs = tree.exprOf(expr.rhsId);

        return this.indexExpression(rhs, record);
      case ExprKind.Assign:
        record.changes.push(expr);
        this.keepAssigned(
          tree.exprOf(expr.targetId),
          tree.exprOf(expr.valueId),
          expr.op,
          record,
        );
        const target = tree.exprOf(expr.targetId);

        this.indexAssigned(target, record);
        const targetExpr = tree.exprOf(expr.targetId);

        this.indexExpression(targetExpr, record);

        const value = tree.exprOf(expr.valueId);

        return this.indexExpression(value, record);
      case ExprKind.Update:
        record.changes.push(expr);
        const exprTarget = tree.exprOf(expr.targetId);

        this.indexAssigned(exprTarget, record);

        return this.indexExpression(tree.exprOf(expr.targetId), record);
      case ExprKind.Call: {
        const values = tree
          .argumentsOf(expr.argsList)
          .map((argument) => tree.exprOf(argument.exprId));

        this.keepArguments(expr, record);
        const callee = tree.exprOf(expr.calleeId);

        this.indexExpression(callee, record);

        return this.indexExpressions(values, record);
      }
      case ExprKind.New: {
        const form = expr.form;
        const values = tree
          .argumentsOf(expr.argsList)
          .map((argument) => tree.exprOf(argument.exprId));

        if (form.kind != NewKind.Named) {
          const calleeExpr = tree.exprOf(form.calleeId);

          this.indexExpression(calleeExpr, record);
        }

        return this.indexExpressions(values, record);
      }
      case ExprKind.Conditional:
        const cond = tree.exprOf(expr.condId);

        this.indexExpression(cond, record);
        const thenExpr = tree.exprOf(expr.thenExprId);

        this.indexExpression(thenExpr, record);

        const elseExpr = tree.exprOf(expr.elseExprId);

        return this.indexExpression(elseExpr, record);
      case ExprKind.Cast:
        const operandExpr = tree.exprOf(expr.operandId);

        return this.indexExpression(operandExpr, record);
      case ExprKind.Sequence:
        const exprs = tree.exprsOf(expr.exprsList);

        return this.indexExpressions(exprs, record);
      case ExprKind.OptionalChain:
        const chain = tree.exprOf(expr.chainId);

        return this.indexExpression(chain, record);
      case ExprKind.Function:
        const fn = tree.functionOf(expr.fnId);

        return this.indexFunction(fn, record);
      case ExprKind.Yield:
        const valueExpr = tree.exprAt(expr.valueId);

        return this.indexOptionalExpression(valueExpr, record);
      case ExprKind.Await:
        const exprValue = tree.exprOf(expr.valueId);

        return this.indexExpression(exprValue, record);
      case ExprKind.Class:
        const decl = tree.classOf(expr.declId);

        return this.indexClass(decl, record);
      case ExprKind.Template:
        const exprsItem = tree.exprsOf(expr.exprsList);

        return this.indexExpressions(exprsItem, record);
      case ExprKind.ArrayLit: {
        const values = tree
          .elementsOf(expr.elementsList)
          .map((element) => tree.exprOf(element.exprId));

        return this.indexExpressions(values, record);
      }
      case ExprKind.ObjectLit:
        for (const property of tree.propertiesOf(expr.propsList)) {
          const form = property.form;

          if (form.kind == PropertyKind.Computed) {
            const key = tree.exprOf(form.keyId);

            this.indexExpression(key, record);
          }

          const propertyValue = tree.exprOf(property.valueId);

          this.indexExpression(propertyValue, record);
        }

        return;
      default:
        return;
    }
  }
}
