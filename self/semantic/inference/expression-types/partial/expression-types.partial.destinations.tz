import { ExpressionTypes } from "../../../code/expression-types/expression-types.tz";
import {
  Expr,
  ExprKind,
  MemberExpr,
} from "../../../../program/ast/types/ast.types.expressions.tz";
import { SymbolKind } from "../../../../program/scopes/types/scopes.types.tz";
import { Type, TypeKind } from "../../../../program/type/types/type.types.tz";
import {
  TypeContext,
  TypePlace,
} from "../../../types/type-resolver/types/type-resolver.types.tz";
import {
  DeclaredVariable,
  Destination,
  DestinationKind,
} from "../../../code/expression-types/types/expression-types.types.tz";

partial class ExpressionTypes {
  private destinationOf(
    variable: DeclaredVariable,
    init: Expr,
    module: int,
  ): Type | undefined {
    const isResult = this.isResultLiteral(init, module);
    const isLiteral =
      init.kind == ExprKind.ObjectLit || init.kind == ExprKind.ArrayLit;
    if (!isLiteral && !isResult) {
      return undefined;
    }

    const list = this.destinationsOf(module, variable.decl.loc);
    let chosen: Type | undefined = undefined;

    for (const one of list) {
      const type = this.destinationType(one, module);
      if (type == undefined || !this.isLiteralPlace(init, type, module)) {
        continue;
      }
      if (this.types.mentionsParameter(type)) {
        return undefined;
      }
      if (chosen != undefined && chosen.id != type.id && !isResult) {
        return undefined;
      }

      chosen = this.chosenPlace(chosen, type);
      if (chosen == undefined) {
        return undefined;
      }
    }

    if (chosen == undefined) {
      return undefined;
    }
    if (isResult) {
      return chosen;
    }
    if (!this.isFitting(init, chosen, module)) {
      return undefined;
    }

    return chosen;
  }

  private conflictPlaces(
    variable: DeclaredVariable,
    init: Expr,
    module: int,
  ): Type[] {
    const tree = this.types.program.tree;

    const isLiteral =
      init.kind == ExprKind.ObjectLit || init.kind == ExprKind.ArrayLit;
    if (!isLiteral || tree.typeRefAt(variable.decl.typeAnnId) != undefined) {
      return [];
    }

    const list = this.destinationsOf(module, variable.decl.loc);
    const places: Type[] = [];

    for (const one of list) {
      const type = this.destinationType(one, module);
      if (type == undefined || !this.isLiteralPlace(init, type, module)) {
        continue;
      }
      if (this.types.mentionsParameter(type)) {
        return [];
      }
      if (!places.some((one) => one.id == type.id)) {
        places.push(type);
      }
    }

    const common = places.find((candidate) =>
      places.every((other) => this.types.converts(candidate, other)),
    );
    if (places.length < 2 || common != undefined) {
      return [];
    }

    return places;
  }

  private chosenPlace(chosen: Type | undefined, type: Type): Type | undefined {
    if (chosen == undefined || chosen.id == type.id) {
      return type;
    }
    if (chosen.kind != TypeKind.Result || type.kind != TypeKind.Result) {
      return undefined;
    }

    const value = this.resultHalfJoin(
      this.types.store.valueOf(chosen),
      this.types.store.valueOf(type),
    );
    const error = this.resultHalfJoin(
      this.types.store.errorOf(chosen),
      this.types.store.errorOf(type),
    );
    if (value == undefined || error == undefined) {
      return undefined;
    }

    return this.types.store.resultOf(value, error);
  }

  private readonly isResultLiteral(expr: Expr, module: int): boolean {
    const tree = this.types.program.tree;

    if (expr.kind != ExprKind.Call) {
      return false;
    }

    const callee = tree.exprOf(expr.calleeId);
    if (callee.kind != ExprKind.Name) {
      return false;
    }

    const args = tree.argumentsOf(expr.argsList);
    const isPlain = args.length <= 1 && args.every((arg) => !arg.spread);

    return isPlain && this.isResultMakerCall(callee, module);
  }

  private isFitting(init: Expr, wanted: Type, module: int): boolean {
    this.errors.beginTrial();

    const trial = this.typed(init, wanted, module);
    const isClean = this.errors.endTrial();

    return isClean && this.types.converts(trial, wanted);
  }

  private placedType(given: Type, destination: Type | undefined): Type {
    if (destination == undefined || destination.kind == TypeKind.Union) {
      return given;
    }
    if (!this.types.converts(given, destination)) {
      return given;
    }

    return destination;
  }

  private destinationType(one: Destination, module: int): Type | undefined {
    const context: TypeContext = {
      module,
      bindings: new Map<int, Type>(),
      place: TypePlace.Plain,
    };

    return this.writtenDestination(one, context, module);
  }

  private readonly isLiteralPlace(
    init: Expr,
    type: Type,
    module: int,
  ): boolean {
    if (this.isResultLiteral(init, module)) {
      return type.kind == TypeKind.Result;
    }
    if (init.kind == ExprKind.ArrayLit) {
      return type.kind == TypeKind.Array;
    }
    if (type.kind == TypeKind.Union) {
      return this.types.store
        .partsOf(type)
        .some((part) => part.kind == TypeKind.Object);
    }

    return type.kind == TypeKind.Object;
  }

  private writtenDestination(
    one: Destination,
    context: Read<TypeContext>,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const written = one.written;
    const fn = one.fn;

    switch (one.kind) {
      case DestinationKind.Declared:
        if (written == undefined) {
          return undefined;
        }

        return this.types.value(written, context);
      case DestinationKind.Returned: {
        const result = tree.typeRefAt(fn?.returnTypeId);
        if (fn == undefined || result == undefined) {
          return undefined;
        }

        const type = this.types.returnType(result, context);

        return this.types.innerResult(type, fn);
      }
      case DestinationKind.Assigned:
        return this.assignedDestination(one, module);
      default:
        return this.argumentDestination(one, module);
    }
  }

  private assignedDestination(one: Destination, module: int): Type | undefined {
    const value = one.value;
    if (value == undefined || !this.isResultLiteral(value, module)) {
      return undefined;
    }

    const type = this.peekType(value, module);

    return type;
  }

  private argumentDestination(one: Destination, module: int): Type | undefined {
    const tree = this.types.program.tree;

    const callee = tree.exprAt(one.call?.calleeId);
    if (callee == undefined) {
      return undefined;
    }
    if (callee.kind == ExprKind.Member) {
      return this.memberDestination(one, callee, module);
    }
    if (callee.kind != ExprKind.Name) {
      return undefined;
    }

    const target = this.targetOfName(callee, module);
    if (target == undefined || target.kind != SymbolKind.Function) {
      return undefined;
    }

    const fn = this.record(target.module)?.functions.get(target.loc);
    if (fn == undefined || !this.isCallable(fn, target.module)) {
      return undefined;
    }

    const type = this.functionAt(target.module, target.loc);
    if (type.kind != TypeKind.Function) {
      return undefined;
    }

    const shape = this.types.store.functionShapeOf(type);
    const params = this.types.directParams(shape.params, shape.self);

    return params[one.index]?.type;
  }

  private memberDestination(
    one: Destination,
    member: MemberExpr,
    module: int,
  ): Type | undefined {
    const tree = this.types.program.tree;

    const memberObject = tree.exprOf(member.objectId);
    if (memberObject.kind != ExprKind.Name) {
      return undefined;
    }

    const objectExpr = tree.exprOf(member.objectId);
    const peeked = this.peekType(objectExpr, module);

    const object = this.types.definedType(peeked);

    return this.destinations.memberParameter(
      this.types.store,
      object,
      member.name,
      one.index,
    );
  }
}
