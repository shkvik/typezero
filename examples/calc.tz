// Калькулятор в обратной польской записи: "3 4 + 2 *" — это (3 + 4) * 2.
enum Op {
  Add,
  Sub,
  Mul,
  Div,
  Pow,
  Sqrt,
  Unknown,
}

function parseOp(token: string): Op {
  switch (token) {
    case "+":
      return Op.Add
    case "-":
      return Op.Sub
    case "*":
    case "×":
      return Op.Mul
    case "/":
      return Op.Div
    case "^":
      return Op.Pow
    case "sqrt":
      return Op.Sqrt
    default:
      return Op.Unknown
  }
}

// Числа калькулятора — до 10^100 по модулю. Тогда ни одно действие не уйдёт за
// пределы double, где получилась бы Infinity, и компилятор это видит: без
// проверок ниже он не соберёт программу.
const limit = 1e100

// Значение выражения, или undefined с объяснением, если оно неверное.
function evaluate(expression: string): double | undefined {
  const stack: double[] = []
  for (const token of expression.split(" ")) {
    if (token == "") continue
    const value = Number(token)
    if (value.isOk()) {
      const x = value.value
      if (Math.abs(x) > limit) {
        console.log(`  число ${token} слишком большое`)
        return undefined
      }
      stack.push(x)
      continue
    }
    const op = parseOp(token)
    if (op == Op.Unknown) {
      console.log(`  непонятно, что такое "${token}"`)
      return undefined
    }
    const b = stack.pop()
    if (b == undefined) {
      console.log(`  для "${token}" не хватает чисел`)
      return undefined
    }
    if (op == Op.Sqrt) {
      if (b < 0) {
        console.log(`  корня из ${b} нет`)
        return undefined
      }
      stack.push(Math.sqrt(b))
      continue
    }
    const a = stack.pop()
    if (a == undefined) {
      console.log(`  для "${token}" не хватает чисел`)
      return undefined
    }
    let result: double
    switch (op) {
      case Op.Add:
        result = a + b
        break
      case Op.Sub:
        result = a - b
        break
      case Op.Mul:
        result = a * b
        break
      case Op.Div:
        if (Math.abs(b) < 1 / limit) {
          console.log(`  делить на ${b} нельзя`)
          return undefined
        }
        result = a / b
        break
      default: // Op.Pow: показатель — целый, от 0 до 10, основание — до 10^10.
        if (b < 0 || b > 10 || Math.abs(a) > 1e10) {
          console.log(`  ${a} в степени ${b} не считаю`)
          return undefined
        }
        result = a ** Math.trunc(b).toInt()
    }
    if (Math.abs(result) > limit) {
      console.log(`  результат больше 10^100`)
      return undefined
    }
    stack.push(result)
  }
  if (stack.length != 1) {
    console.log(`  в конце осталось чисел: ${stack.length}, а нужно одно`)
    return undefined
  }
  return stack[0]
}

const expressions = ["3 4 + 2 *", "2 10 ^", "2 sqrt", "1 3 /", "0.1 0.2 +", "5 0 /", "1 +", "2 3", "7 x"]
for (const expression of expressions) {
  const result = evaluate(expression)
  console.log(expression.padEnd(12), "=", result == undefined ? "ошибка" : String(result))
}
