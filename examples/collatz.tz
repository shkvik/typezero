// Самая длинная последовательность Коллатца среди стартовых чисел меньше
// миллиона. Промежуточные значения не помещаются в 32 бита, а int — 64.
function collatzLength(start: int): int {
  let n = start;
  let steps = 1;
  while (n != 1) {
    if (n % 2 == 0) n = n / 2;
    // Компилятор не знает, как далеко уходит последовательность, и требует
    // проверки перед умножением: без неё это ошибка.
    else if (n < 1000000000000000000) n = 3 * n + 1;
    else return -1;
    steps++;
  }
  return steps;
}

let best: int = 1;
let bestLength = 1;
for (let start: int = 1; start < 1000000; start++) {
  let length = collatzLength(start);
  if (length > bestLength) {
    best = start;
    bestLength = length;
  }
}
console.log("число:", best, "длина:", bestLength);
