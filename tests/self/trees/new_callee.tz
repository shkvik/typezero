// What 'new' creates: members and indexes after the parentheses still name
// the class, a keyword may be the name of a member, '<' after a class
// without arguments is a comparison unless type arguments close, and the
// class may be kept in a field of 'this'.
const a = new (pick(x)).Shape(1);
const b = new (pick(x))[0](1);
const c = new (pick(x))(1).size;
const d = new shapes.default(1);
const e = new Box < limit;
const f = new Box<int>(1);
const g = new Box<int>;
const h = new this.kind(1);
const i = new this.kinds[0]<int>(1);
