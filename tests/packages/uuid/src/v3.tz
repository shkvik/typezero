import { md5 } from './md5.tz';
import { UUIDTypes, UuidError } from './types.tz';
import { v35 } from './v35.tz';

export { DNS, URL } from './v35.tz';

function v3<TBuf extends Uint8Array = never>(
  value: string | Uint8Array,
  namespace: UUIDTypes,
  buf?: TBuf,
  offset?: number,
): Result<UUIDTypes<TBuf>, UuidError> {
  return v35(0x30, md5, value, namespace, buf, offset);
}

export { v3 };
