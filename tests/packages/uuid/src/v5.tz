import { sha1 } from './sha1.tz';
import { UUIDTypes, UuidError } from './types.tz';
import { v35 } from './v35.tz';

export { DNS, URL } from './v35.tz';

function v5<TBuf extends Uint8Array = never>(
  value: string | Uint8Array,
  namespace: UUIDTypes,
  buf?: TBuf,
  offset?: int,
): Result<UUIDTypes<TBuf>, UuidError> {
  return v35(0x50, sha1, value, namespace, buf, offset);
}

export { v5 };
