import { rng } from './rng.tz';
import { unsafeStringify } from './stringify.tz';
import { UUIDTypes, UuidError, Version4Options } from './types.tz';

function v4<TBuf extends Uint8Array = never>(
  options?: Version4Options,
  buf?: TBuf,
  offset?: int,
): Result<UUIDTypes<TBuf>, UuidError> {
  if (!buf && !options) {
    return ok(crypto.randomUUID());
  }

  // Putting tail-code that could just go inline here in a separate function to
  // enable compiler optimizations that dramatically improve performance.
  //
  // REF: https://github.com/uuidjs/uuid/issues/892
  return _v4(options, buf, offset);
}

function _v4<TBuf extends Uint8Array = never>(
  options?: Version4Options,
  buf?: TBuf,
  offset?: int,
): Result<UUIDTypes<TBuf>, UuidError> {
  options = options || {};

  const rnds = options.random ?? options.rng?.() ?? rng();
  if (rnds.length < 16) {
    return err({ name: 'Error', message: 'Random bytes length must be >= 16' });
  }

  // Per 4.4, set bits for version and `clock_seq_hi_and_reserved`
  rnds[6] = (rnds[6] & 0x0f) | 0x40;
  rnds[8] = (rnds[8] & 0x3f) | 0x80;

  // Copy bytes to buffer, if provided
  if (buf) {
    // tz: the check is on the int offset, in a form the compiler reads.
    const at = offset ?? 0;
    if (at < 0 || at > buf.length - 16) {
      return err({
        name: 'RangeError',
        message: `UUID byte range ${at}:${at + 15} is out of buffer bounds`,
      });
    }

    buf.set(rnds.subarray(0, 16), at);

    return ok(buf);
  }

  return ok(unsafeStringify(rnds));
}
export { v4 };
