export type UUIDTypes<TBuf extends Uint8Array = Uint8Array> = string | TBuf;

export type Version1Options = {
  node?: Uint8Array;
  clockseq?: int;
  random?: Uint8Array;
  rng?: () => Uint8Array;
  msecs?: int;
  nsecs?: int;
  _v6?: boolean; // Internal use only!
};

export type Version4Options = {
  random?: Uint8Array;
  rng?: () => Uint8Array;
};

export type Version6Options = Version1Options;

export type Version7Options = {
  random?: Uint8Array;
  msecs?: int;
  seq?: int;
  rng?: () => Uint8Array;
};

// Workaround for different versions of TypeScript definitions
export type NonSharedArrayBuffer = Uint8Array;

// tz: what uuid throws is an Err of this, named as the error uuid throws.
export type UuidError = { name: 'TypeError' | 'RangeError' | 'Error'; message: string };
