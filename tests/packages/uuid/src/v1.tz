import { rng } from './rng.tz';
import { unsafeStringify } from './stringify.tz';
import { UUIDTypes, UuidError, Version1Options } from './types.tz';

// **`v1()` - Generate time-based UUID**
//
// Inspired by https://github.com/LiosK/UUID.js
// and http://docs.python.org/library/uuid.html

type V1State = {
  node?: Uint8Array; // node id (47-bit random)
  clockseq?: int; // sequence number (14-bit)

  // v1 & v6 timestamps are a pain to deal with.  They specify time from the
  // Gregorian epoch in 100ns intervals, which requires values with 57+ bits of
  // precision.  But that's outside the precision of IEEE754 floats (i.e. JS
  // numbers).  To work around this, we represent them internally using 'msecs'
  // (milliseconds since unix epoch) and 'nsecs' (100-nanoseconds offset from
  // `msecs`).

  msecs?: int; // timestamp (milliseconds, unix epoch)
  nsecs?: int; // timestamp (100-nanoseconds offset from 'msecs')
};

const _state: V1State = {};

function v1<TBuf extends Uint8Array = never>(
  options?: Version1Options,
  buf?: TBuf,
  offset?: int,
): Result<UUIDTypes<TBuf>, UuidError> {
  let bytes: Uint8Array;

  // Extract _v6 flag from options, clearing options if appropriate
  const isV6 = options?._v6 ?? false;
  if (options) {
    const optionsKeys = Object.keys(options);
    if (optionsKeys.length == 1 && optionsKeys[0] == '_v6') {
      options = undefined;
    }
  }

  if (options) {
    // With options: Make UUID independent of internal state
    const made = v1Bytes(
      options.random ?? options.rng?.() ?? rng(),
      options.msecs,
      options.nsecs,
      options.clockseq,
      options.node,
      buf,
      offset,
    );
    if (made.isErr()) return err(made.error);
    bytes = made.value;
  } else {
    // Without options: Make UUID from internal state
    const now = Date.now();
    const rnds = rng();

    updateV1State(_state, now, rnds);

    // Geenerate UUID.  Note that v6 uses random values for `clockseq` and
    // `node`.
    //
    // https://www.rfc-editor.org/rfc/rfc9562.html#section-5.6-4
    const made = v1Bytes(
      rnds,
      _state.msecs,
      _state.nsecs,
      // v6 UUIDs get random `clockseq` and `node` for every UUID
      // https://www.rfc-editor.org/rfc/rfc9562.html#section-5.6-4
      isV6 ? undefined : _state.clockseq,
      isV6 ? undefined : _state.node,
      buf,
      offset,
    );
    if (made.isErr()) return err(made.error);
    bytes = made.value;
  }

  return ok(buf ?? unsafeStringify(bytes));
}

// (Private!)  Do not use.  This method is only exported for testing purposes
// and may change without notice.
export function updateV1State(state: V1State, now: int, rnds: Uint8Array) {
  // tz: no time yet is undefined, where JavaScript starts from -Infinity.
  const last = state.msecs;
  let nsecs = state.nsecs ?? 0;

  // Update timestamp
  if (last != undefined && now == last) {
    // Same msec-interval = simulate higher clock resolution by bumping `nsecs`
    // https://www.rfc-editor.org/rfc/rfc9562.html#section-6.1-2.6
    nsecs++;

    // Check for `nsecs` overflow (nsecs is capped at 10K intervals / msec)
    if (nsecs >= 10000) {
      // Prior to uuid@11 this would throw an error, however the RFCs allow for
      // changing the node in this case.  This slightly breaks monotonicity at
      // msec granularity, but that's not a significant concern.
      // https://www.rfc-editor.org/rfc/rfc9562.html#section-6.1-2.16
      state.node = undefined;
      nsecs = 0;
    }
  } else if (last == undefined || now > last) {
    // Reset nsec counter when clock advances to a new msec interval
    nsecs = 0;
  } else if (now < last) {
    // Handle clock regression
    // https://www.rfc-editor.org/rfc/rfc9562.html#section-6.1-2.7
    //
    // Note: Unsetting node here causes both it and clockseq to be randomized,
    // below.
    state.node = undefined;
  }
  state.nsecs = nsecs;

  // Init node and clock sequence (do this after timestamp update which may
  // reset the node) https://www.rfc-editor.org/rfc/rfc9562.html#section-5.1-7
  //
  // Note:
  if (!state.node) {
    const node = rnds.slice(10, 16);

    // Set multicast bit
    // https://www.rfc-editor.org/rfc/rfc9562.html#section-6.10-3
    if (node.length > 0) node[0] |= 0x01; // Set multicast bit
    state.node = node;

    // Clock sequence must be randomized
    // https://www.rfc-editor.org/rfc/rfc9562.html#section-5.1-8
    state.clockseq = (((rnds[8] ?? 0).toInt() << 8) | (rnds[9] ?? 0).toInt()) & 0x3fff;
  }

  state.msecs = now;

  return state;
}

function v1Bytes(
  rnds: Uint8Array,
  msecs?: int,
  nsecs?: int,
  clockseq?: int,
  node?: Uint8Array,
  buf?: Uint8Array,
  offset: int = 0,
): Result<Uint8Array, UuidError> {
  if (rnds.length < 16) {
    return err({ name: 'Error', message: 'Random bytes length must be >= 16' });
  }

  // Defaults
  if (buf) {
    if (offset < 0 || offset + 16 > buf.length) {
      return err({
        name: 'RangeError',
        message: `UUID byte range ${offset}:${offset + 15} is out of buffer bounds`,
      });
    }
  }

  // tz: the defaults go into variables of their own, which are not undefined.
  let ms = msecs ?? Date.now();
  const ns = nsecs ?? 0;
  const seq = clockseq ?? ((rnds[8].toInt() << 8) | rnds[9].toInt()) & 0x3fff;
  let id = node;
  if (id == undefined) {
    id = rnds.slice(10, 16);

    // Set multicast bit
    // https://www.rfc-editor.org/rfc/rfc9562.html#section-6.10-3
    if (id.length > 0) id[0] |= 0x01;
  }

  // Offset to Gregorian epoch
  // https://www.rfc-editor.org/rfc/rfc9562.html#section-5.1-1
  ms += 12219292800000;

  // The timestamp is `msecs * 10000 + nsecs`, which needs more precision than a
  // JS number has.
  // tz: an int holds it: 60 bits of 64.
  const t = ms * 10000 + ns;

  // tz: the 16 bytes go into an array of their own, whose indices need no checks, and then
  // into `buf` at `offset`, which was checked above.
  const b = new Uint8Array(16);

  // `time_low`
  b[0] = ((t >> 24) & 0xff).toUint8();
  b[1] = ((t >> 16) & 0xff).toUint8();
  b[2] = ((t >> 8) & 0xff).toUint8();
  b[3] = (t & 0xff).toUint8();

  // `time_mid`
  b[4] = ((t >> 40) & 0xff).toUint8();
  b[5] = ((t >> 32) & 0xff).toUint8();

  // `time_high_and_version`
  b[6] = (((t >> 56) & 0xf) | 0x10).toUint8(); // include version
  b[7] = ((t >> 48) & 0xff).toUint8();

  // `clock_seq_hi_and_reserved` | variant
  b[8] = (((seq >> 8) | 0x80) & 0xff).toUint8();

  // `clock_seq_low`
  b[9] = (seq & 0xff).toUint8();

  // `node`
  for (let n = 0; n < 6; ++n) {
    b[10 + n] = id[n] ?? 0;
  }

  if (!buf) return ok(b);
  // tz: the offset is checked again where the bytes go in, as an int, so that
  // the compiler sees them fit; the check above has returned already otherwise.
  const at = offset;
  if (at >= 0 && at <= buf.length - 16) buf.set(b, at);
  return ok(buf);
}

export { v1 };
