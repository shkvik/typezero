// An int that may overflow is an error (docs/numbers.md, section 2), next to
// the other errors.
const seconds: int = parseInt("90").unwrapOr(0)
// expect-error: 'seconds * 1000' may overflow int: 'seconds' comes from parseInt on line 3
const ms = seconds * 1000
// expect-error: a number cannot be a condition
if (ms) console.log(ms)

// A constant that does not fit is an error, not a warning.
const day = 86400
// expect-error: this constant is 86400000000000000000, which does not fit in 'int'
const micro = day * 1000000000000000
console.log(micro)
