// Integer constants that would wrap around, where JavaScript keeps the value.
// expect-error: this constant is 18446744073709551616, which does not fit in 'int' and would wrap around to 0
const a = 2 ** 64
const MS_PER_DAY = 24 * 60 * 60 * 1000
// expect-error: this constant is 31536000000000000000, which does not fit in 'int' and would wrap around to -5357488147419103232; compute it as a 'double'
const ns = MS_PER_DAY * 365 * 1000000000
// expect-error: this constant is 9223372036854775808, which does not fit in 'int'
const b = 9223372036854775807 + 1
const min = -9223372036854775808
// expect-error: this constant is 9223372036854775808
const c = -min
// expect-error: this constant is 9223372036854775808
const d = min / -1
// expect-error: this constant is -9223372036854775809
const e = min - 1
// A narrower type wraps sooner.
const small: int16 = 30000
// expect-error: this constant is 60000, which does not fit in 'int16' and would wrap around to -5536; compute it as an 'int'
const f = small * 2
enum Size {
  Large = 10000000000,
}
// expect-error: this constant is 100000000000000000000
console.log(Size.Large * Size.Large)

// `| 0` wraps nothing in tz: counting modulo 2^32 is Bit.Wrap32.
// expect-error: '(2147483647 * 2147483647) | 0' changes nothing in tz: integers are exact, and nothing wraps around here
const g = (2147483647 * 2147483647) | 0

// One error for the first operation that overflows, not for each around it.
// expect-error: this constant is 18446744073709551616
const h = (4294967296 * 4294967296 + 1) * 2

// Division by a constant zero is an error, of doubles too: tz has no Infinity.
let x = 5
// expect-error: division by zero
console.log(x / 0)
// expect-error: division by zero
console.log(x % (1 - 1))
// expect-error: division by zero
x /= 0
let y = 5.5
// expect-error: division by zero
console.log(y / 0)

// A negative constant exponent, not only a literal one.
const NEG = -1
// expect-error: 'int' raised to a negative power is a fraction
console.log(2 ** NEG)
