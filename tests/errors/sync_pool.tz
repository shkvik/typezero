// The object from a Pool lives only inside 'use' (docs/async.md, section 11): after the
// function ends the pool gives it to another request, so it can't be kept anywhere, given to
// a timer, left to a call nobody waits for, or returned from the function.
import { Pool } from "tz:sync"

class Connection {
  public used: int
  public constructor() {
    this.used = 0
  }
  public async ping(): Promise<Result<int, never>> {
    this.used += 1
    return ok(this.used)
  }
  public async touch(): Promise<void> {
    await Promise.resolve()
    this.used += 1
  }
  public remember(): void {
    // expect-error: the object from a Pool lives only inside 'use' (after it the pool gives it to another request), so it can't be kept by 'push', which may store it (docs/async.md, section 11)
    registry.push(this)
  }
}

const registry: Connection[] = []
let last: Connection | undefined = undefined
const all: Connection[] = []
const byName = new Map<string, Connection>()

function audit(connection: Connection): int {
  return connection.used
}

function keepIt(connection: Connection): void {
  // expect-error: the object from a Pool lives only inside 'use' (after it the pool gives it to another request), so it can't be kept in a module variable (docs/async.md, section 11)
  last = connection
}

const pool = new Pool<Connection>({
  max: 2,
  create: async () => ok(new Connection()),
  alive: (connection) => {
    // expect-error: the object from a Pool lives only inside 'use' (after it the pool gives it to another request), so it can't be kept by 'push', which may store it (docs/async.md, section 11)
    all.push(connection)
    return true
  },
})

const used = await pool.use(async (connection) => {
  // expect-error: the object from a Pool lives only inside 'use' (after it the pool gives it to another request), so it can't be kept in a module variable (docs/async.md, section 11)
  last = connection
  // expect-error: the object from a Pool lives only inside 'use' (after it the pool gives it to another request), so it can't be kept by 'set', which may store it (docs/async.md, section 11)
  byName.set("main", connection)
  // expect-error: the object from a Pool lives only inside 'use' (after it the pool gives it to another request), so it can't be kept in a new object (docs/async.md, section 11)
  const box = { connection }
  // expect-error: a function that uses the object from a Pool can't be kept by 'setImmediate', which may store it: it could run after 'use', when the pool has given the object to another request; take what you need from the object first (docs/async.md, section 11)
  setImmediate(() => console.log(connection.used))
  keepIt(connection)
  connection.remember()
  const seen = audit(connection)
  const pinged = await connection.ping()
  console.log(seen, pinged.value, box.connection.used)
  return ok(connection.used)
})
console.log(used.value)

// expect-error: this function returns the object from the pool, but after 'use' the pool gives it to another request; return what you need from it instead (docs/async.md, section 11)
const leaked = await pool.use(async (connection) => ok(connection))
console.log(leaked.value.used)

async function dropped(): Promise<void> {
  const counted = await pool.use(async (connection) => {
    // expect-error: 'void' does not wait for this call, but it uses the object from a Pool, which 'use' gives to another request as soon as its function ends; await the call instead (docs/async.md, section 11)
    void connection.touch()
    return ok(connection.used)
  })
  console.log(counted.value)
}
await dropped()
