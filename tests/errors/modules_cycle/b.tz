import { aName, getA } from "./a"
// expect-error: b.tz reads 'aName' of a.tz while it loads, but a.tz is not loaded yet: main.tz -> a.tz -> b.tz -> (a.tz already started); compute the value inside a function, or move 'aName' to a file outside the cycle
export const bSeesA = "b sees " + aName
// expect-error: b.tz calls 'getA' while it loads, and it reads 'aName' of a.tz, which is not loaded yet: main.tz -> a.tz -> b.tz -> (a.tz already started); make the call inside a function, or move 'aName' to a file outside the cycle
export const bCallsA = getA()
// Fine: by the time it is called, a.tz has loaded.
export function bLater() {
  return aName
}
