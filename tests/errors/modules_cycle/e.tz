import { fz } from "./f"
// f.tz loads first, and its arrow needs the type of e1, so e.tz is checked
// up to e1 ahead of its turn; this arrow needs fz, which f.tz declares later.
// expect-error: 'fz' of f.tz has no type yet where e.tz creates this function: the files import each other; declare the function with 'function' at the top level of the file
const twice = () => fz * 2
export const e1 = 1
