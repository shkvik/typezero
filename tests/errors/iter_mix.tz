// Generator methods, and `yield*` of a Result, which is not iterable.
class Box {
  // A field before `*name()` needs a ';', as in JavaScript: `[] * values()`
  // would go on.
  items: int[] = [];
  *values() {
    yield* this.items
    // expect-error: 'yield*' needs an array, a string or an iterator, found 'Result<
    yield* ok(1)
  }
  // expect-error: a generator returns an iterator: declare its type as 'Generator<int[]>'
  *wrong(): int[] {
    yield 1
  }
}
const box = new Box()
// expect-error: an iterator cannot be converted to a string
console.log(`${box.values()}`)
