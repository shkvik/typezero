// An operation of integers that may not fit its type is an error
// (docs/numbers.md, section 2): a value from outside (input, parseInt, JSON)
// or a counter that grows in a loop without a bound may make it too large.
// The message says where the value comes from and how to fix it.
import { readLine } from "tz:io"

const text = readLine() ?? "[1, 2, 3]"
const parsed = JSON.parse<int[]>(text)
if (parsed.isErr()) process.exit(1)
const prices = parsed.value
let sum = 0
// expect-error: 'sum += p' may overflow int: 'p' comes from JSON on line 8; check the values before, or count in a decimal: 'let sum: decimal = 0' and add 'x.toDecimal()'
for (const p of prices) sum += p
let wide: int = 0
// expect-error: 'wide += p' may overflow int: 'p' comes from JSON on line 8; check the values before, or count 'wide' in a 'decimal'
for (const p of prices) wide += p

const seconds: int = parseInt(readLine() ?? "90").unwrapOr(0)
// expect-error: 'seconds * 1000' may overflow int: 'seconds' comes from parseInt on line 18
const ms = seconds * 1000
// expect-error: 'Math.min(seconds, 1000) * 1000' may overflow int: the result of 'Math.min(...)' comes from parseInt on line 18
console.log(ms, Math.min(seconds, 1000) * 1000)

// All the calls of a function count; the one that passes a value from
// outside is named.
function scale(n: int): int {
  // expect-error: 'n * 1000' may overflow int: 'n' comes from parseInt on line 18, passed by the call on line 30
  return n * 1000
}
console.log(scale(5), scale(60), scale(seconds))

// Without `| 0`, a hash outgrows int after a few characters.
let unsafe = 7
// expect-error: 'unsafe * 31' may overflow int: 'unsafe' grows with every pass of the loop on line 35
for (const c of text) unsafe = unsafe * 31 + c.length

// Callbacks run where they are passed: reduce adds up the elements.
// expect-error: 'total + p' may overflow int: 'p' comes from JSON on line 8
console.log(prices.reduce((total, p) => total + p, 0))

// Fields filled from JSON come from outside too.
type Order = { id: int; count: int }
const order = JSON.parse<Order>('{"id": 7, "count": 3}').unwrapOr({ id: 0, count: 0 })
// expect-error: 'order.count * 1000' may overflow int: 'order.count' comes from JSON on line 43
console.log(order.count * 1000, order.id)

// In an async function too: an await is a point where other code runs,
// and a value from outside stays one across it.
async function scaled(text: string): Promise<int> {
  const n: int = parseInt(text).unwrapOr(0)
  await undefined
  // expect-error: 'n * 1000' may overflow int: 'n' comes from parseInt on line 50
  return n * 1000
}
console.log(await scaled("12"))

// Each integer type has its limits: a uint8 counter overflows at 255.
let x: uint8 = 250
// expect-error: 'x++' may overflow uint8: 'x' grows with every pass of the loop on line 60
for (let i = 0; i < 10; i++) x++
let y: int8 = 120
// expect-error: 'y += 10' may overflow int8: it may reach 130
y += 10

// What is known at compile time but does not fit is an error too.
let big: int = 9223372036854775807
// expect-error: 'big + 1' may overflow int: it may reach 9223372036854775808
console.log(big + 1)
let min: int = -9223372036854775808
let minusOne: int = -1
// expect-error: 'min / minusOne' may overflow int
console.log(min / minusOne)
let two: int = 2
let sixtyThree: int = 63
// expect-error: 'two ** sixtyThree' may overflow int: it may reach 9223372036854775808
console.log(two ** sixtyThree)
