// There is no `as`; numbers convert the way JavaScript converts them.
const d: double = 2.5
const l: int = 5
const i: int = 3
function find(flag: boolean): int | undefined {
  if (flag) return 1
}
const maybe = find(true)
// expect-error: 'as' is not supported; round it first, then convert: 'Math.trunc(d).toInt()'
const a = d as int
// expect-error: 'as' is not supported; round it first, then convert: 'Math.trunc(d).toUint8()'
const b = d as uint8
// expect-error: 'as' is not supported; convert it explicitly: 'i.toDouble()'
const c = i as double
// expect-error: 'as' is not supported; convert it explicitly: 'l.toInt16()'
const e = l as int16
// expect-error: 'as' is not supported; the value may be undefined
const f = maybe as int
// expect-error: 'as' is not supported; declare the type of the variable instead
const g = [] as int[]
// expect-error: 'as' is not supported, and type 'string' cannot become 'int'
const h = "7" as int
// expect-error: type 'double' is not assignable to type 'int'; round it first, then convert: 'Math.trunc(d).toInt()'
const j: int = d
// expect-error: type 'int' is not assignable to type 'int16'; convert it explicitly: 'l.toInt16()'
const k: int16 = l
// expect-error: expected 1 argument, but got 2
const n = Math.floor(d, 2)
// expect-error: property 'sqrtt' does not exist on 'Math'
const p = Math.sqrtt(d)
// expect-error: 'Math.floor' can be used as a value only where a function type is expected
const q = Math.floor
// expect-error: argument of type 'string' is not assignable to parameter of type 'double'
const r = Math.round("1.5")
