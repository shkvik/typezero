// The numbers of a date must keep its time within an int of milliseconds
// (docs/date.md, section 4): about 292 million years around 1970. A number
// from the input is checked first; the fields of a date that exists are
// trusted, and so is any time in milliseconds.
const n = Number.parseInt(process.argv[2] ?? "1")
const d = new Date(0)
if (n.isOk()) {
  const v = n.value
  // expect-error: cannot prove that the time of the date fits in 'int' (about 292 million years around 1970): 'v' comes from parseInt on line 5; check it first, e.g. 'if (v >= 1 && v <= 31)'
  d.setUTCDate(v)
  // expect-error: 'v' comes from parseInt on line 5; check it first, e.g. 'if (v >= 0 && v <= 59)'
  d.setMinutes(30, v)
  // expect-error: 'v' comes from parseInt on line 5; check it first, e.g. 'if (v >= 0 && v <= 11)'
  const month = new Date(2026, v, 1)
  // expect-error: 'v' comes from parseInt on line 5; check it first, e.g. 'if (v >= -292275054 && v <= 292278993)'
  const year = Date.UTC(v, 0)
  if (v >= 0 && v <= 100000) {
    // expect-error: 'v' may be 100000; check it first, e.g. 'if (v >= 0 && v <= 11)'
    const edge = new Date(292278000, v, 1)
    const far = new Date(275759, v, 1)
    d.setUTCHours(v)
  }
  if (v >= -292275054 && v <= 292278993) {
    const checked = Date.UTC(v, 11, 31, 23, 59, 59, 999)
  }
  // The fields of a date are trusted: they move a date that exists.
  const next = new Date(d.getFullYear(), d.getMonth() + 1, 1)
  d.setUTCDate(d.getUTCDate() + 1)
  d.setUTCFullYear(d.getUTCFullYear() + 1)
  // Any int is a time.
  const at = new Date(v)
  d.setTime(v)
}
const f = Number.parseFloat(process.argv[3] ?? "0")
if (f.isOk()) {
  console.log(new Intl.DateTimeFormat("en").format(f.value))
}
