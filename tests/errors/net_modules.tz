// The modules of tz's own library behind the globals of fetch and URL are
// not for programs: they name the globals, or import Server from tz:http.
// expect-error: there is no built-in module 'tz:fetch'; tz has 'tz:io', 'tz:fs', 'tz:http' and 'tz:http2'
import { Wire } from "tz:fetch"
// expect-error: there is no built-in module 'tz:url'; tz has 'tz:io', 'tz:fs', 'tz:http' and 'tz:http2'
import { URL } from "tz:url"
