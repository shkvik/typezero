// expect-error: type 'double' is not assignable to type 'int'
let x: int = 1.5
let big: int = 5
// A number changes its type only explicitly.
// expect-error: operator '+' cannot be applied to types 'int' and 'double': a number changes its type only explicitly, e.g. 'big.toDouble() + 0.5'
let y: int = big + 0.5
// expect-error: integer literal does not fit in type 'int'
let z: int = 9223372036854775808
// expect-error: integer literal does not fit in type 'uint8'
let w: uint8 = 256
// expect-error: integer literal does not fit in type 'uint32'
let u: uint32 = -1
