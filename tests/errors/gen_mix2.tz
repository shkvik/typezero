// Writes through a wider type that pass through the built-in modules and
// through errors (tests/run/gen_mix2.tz has the reads that are allowed): a
// listener of an emitter that puts another Animal into the array it gets,
// and an error whose narrowed field is changed after it went out in a Result.
import { EventEmitter } from "node:events"

class Animal {
  constructor(public name: string) {}
}
class Dog extends Animal {}
class Cat extends Animal {}

class Zoo extends EventEmitter<{ show: [all: Animal[]] }> {
  show(all: Animal[]) {
    this.emit("show", all)
  }
}
const dogs: Dog[] = [new Dog("Rex")]
const zoo = new Zoo()
zoo.on("show", (all) => all.push(new Cat("Tom")))
// expect-error: 'Dog[]' cannot go where 'Animal[]' is expected here: line 20 puts a 'Cat' into it
zoo.show(dogs)

class PetError {
  constructor(public pet: Animal) {}
}
class DogError extends PetError {
  constructor(public pet: Dog) {
    super(pet)
  }
}
function fail(e: PetError): Result<void, PetError> {
  return err(e)
}
// expect-error: writes a 'Cat' to its field 'pet', which is a 'Dog' in 'DogError'
const failed = fail(new DogError(new Dog("Ace")))
if (failed.isErr()) failed.error.pet = new Cat("Tim")

