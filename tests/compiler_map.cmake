# docs/compiler-map.md names every folder of compiler/, and only them: a new
# folder gets its line in the map when it is made.
cmake_minimum_required(VERSION 3.20)
file(READ ${ROOT}/docs/compiler-map.md text)
string(REPLACE ";" "," text "${text}")
string(REPLACE "\n" ";" lines "${text}")
set(inside FALSE)
set(stack "")
set(mapped "")
foreach(line IN LISTS lines)
  if(line MATCHES "^```")
    if(inside)
      set(inside FALSE)
    else()
      set(inside TRUE)
      set(stack "")
    endif()
    continue()
  endif()
  if(NOT inside OR NOT line MATCHES "^( *)([a-z0-9_]+)/")
    continue()
  endif()
  string(LENGTH "${CMAKE_MATCH_1}" spaces)
  math(EXPR depth "${spaces} / 2")
  set(name ${CMAKE_MATCH_2})
  list(LENGTH stack size)
  if(depth GREATER size)
    message(FATAL_ERROR "docs/compiler-map.md: '${name}/' is indented deeper than its folder")
  endif()
  if(depth LESS size)
    list(SUBLIST stack 0 ${depth} stack)
  endif()
  list(APPEND stack ${name})
  list(JOIN stack "/" folder)
  list(APPEND mapped ${folder})
endforeach()

file(GLOB_RECURSE found LIST_DIRECTORIES true ${ROOT}/compiler/*)
set(folders "")
foreach(path IN LISTS found)
  if(IS_DIRECTORY ${path})
    file(RELATIVE_PATH folder ${ROOT}/compiler ${path})
    list(APPEND folders ${folder})
  endif()
endforeach()

set(problems "")
foreach(folder IN LISTS folders)
  if(NOT folder IN_LIST mapped)
    string(APPEND problems "\n  compiler/${folder}/ is not in the map: add its line")
  endif()
endforeach()
foreach(folder IN LISTS mapped)
  if(NOT folder IN_LIST folders)
    string(APPEND problems "\n  the map names compiler/${folder}/, which is not there")
  endif()
endforeach()
if(problems)
  message(FATAL_ERROR "docs/compiler-map.md:${problems}")
endif()
list(LENGTH folders count)
message(STATUS "docs/compiler-map.md: ${count} folders, all in the map")
