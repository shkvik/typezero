// same-as-node
// process.stdin as a Readable, with setEncoding(), and process.stdout as a
// Writable: what goes through pipeline() and is written comes in order with
// console.log.
import { Transform } from "node:stream"
import { pipeline } from "node:stream/promises"
class Upper extends Transform {
  onTransform(chunk, enc, cb) {
    cb(undefined, chunk.toString().toUpperCase())
  }
}
process.stdin.setEncoding("utf8")
let text = ""
process.stdin.on("error", (e) => console.log(`stdin error ${e.message}`))
process.stdin.on("data", (s) => {
  text += s
})
process.stdin.on("end", () => {
  console.log(`got ${text.length} chars: ${JSON.stringify(text)}`)
  const upper = new Upper()
  void pipeline(upper, process.stdout, { end: false }).then((r) => {
    if (r.isErr()) console.log(`pipeline error ${r.error.message}`)
  })
  upper.write("piped ")
  void upper.end("to stdout\n").then((r) => {
    if (r.isErr()) console.log(`end error ${r.error.message}`)
  })
  upper.on("end", () => {
    process.stdout.write(Buffer.from("bytes\n"))
    console.log("after bytes")
    process.stderr.write("to stderr\n")
  })
})
