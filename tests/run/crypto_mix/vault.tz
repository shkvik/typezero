// What main.tz keeps its secrets with: a generic sealed box over any value
// that JSON writes, AES-256-GCM with a key from scrypt, and a store of the
// sealed bytes in files read and written through node:fs/promises, which
// emits an event for each.
import { EventEmitter } from "node:events"
import { createCipheriv, createDecipheriv, createHash, randomBytes, scryptSync } from "node:crypto"
import { readFile, writeFile } from "node:fs/promises"
import { join } from "node:path"

export function keyFrom(password: string, salt: Uint8Array) {
  return scryptSync(password, salt, 32)
}

// iv (12 bytes), tag (16 bytes), then the ciphertext.
export function seal<T>(key: Buffer, value: T) {
  const iv = randomBytes(12)
  const cipher = createCipheriv("aes-256-gcm", key, iv)
  if (cipher.isErr())
    return cipher
  const head = cipher.value.update(JSON.stringify(value), "utf8")
  const tail = cipher.value.final()
  if (tail.isErr())
    return tail
  const tag = cipher.value.getAuthTag()
  if (tag.isErr())
    return tag
  return ok(Buffer.concat([iv, tag.value, head, tail.value]))
}

// A tag that does not match is an Err, and so is text that is not JSON.
export function open(key: Buffer, sealed: Uint8Array) {
  const bytes = Buffer.from(sealed)
  const decipher = createDecipheriv("aes-256-gcm", key, bytes.subarray(0, 12))
  if (decipher.isErr())
    return decipher
  decipher.value.setAuthTag(bytes.subarray(12, 28))
  const head = decipher.value.update(bytes.subarray(28), undefined, "utf8")
  const tail = decipher.value.final("utf8")
  if (tail.isErr())
    return tail
  return JSON.parse(head + tail.value)
}

export class Vault extends EventEmitter {
  constructor(readonly dir: string, readonly key: Buffer) {
    super()
  }

  async put<T>(name: string, value: T) {
    const sealed = must(seal(this.key, value))
    must(await writeFile(join(this.dir, name), sealed))
    this.emit("stored", name, createHash("sha256").update(sealed).digest("hex").length)
  }

  async get(name: string) {
    return open(this.key, must(await readFile(join(this.dir, name))))
  }
}

function must<T, E>(r: Result<T, E>): T {
  if (r.isErr()) {
    console.log(r.error)
    process.exit(1)
  }
  return r.value
}
