// same-as-node
// readFileSync(0, "utf8") reads all of stdin (io_stdin.in) at once, as it
// is: "\r\n" stays.
import { readFileSync } from "node:fs"

const all = must(readFileSync(0, "utf8"))
console.log(JSON.stringify(all), all.length)
const lines = all.split("\n").map(l => l.trimEnd())
console.log(lines, lines.length)
console.log(JSON.stringify(must(readFileSync(0, "utf8"))))

function must<T, E>(r: Result<T, E>): T {
  if (r.isErr()) {
    console.log(r.error)
    process.exit(1)
  }
  return r.value
}
