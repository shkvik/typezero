// same-as-node
// expect-exit: 1
// expect-stderr: Error: from the module
// An ES module without top-level `await` that throws: Node reports the error
// four turns of the microtask queue later, and the microtasks queued before
// run meanwhile, but not the nextTick callbacks.
import { chain } from "./chain.tz"
queueMicrotask(chain)
process.nextTick(() => console.log("never: nextTick"))
console.log("main")
throw new Error("from the module")
