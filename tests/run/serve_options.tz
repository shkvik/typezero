// same-as-node
// The options of listen: onListen, a signal that stops the server, and what
// the server tells: its port, hostname and url; stop() lets the requests
// being handled finish.
import { Server } from "tz:http"

const controller = new AbortController()
const started = Promise.withResolvers<void>()
let listened = ""
const server = new Server(async req => {
  if (new URL(req.url).pathname == "/slow") {
    started.resolve()
    await new Promise<void>(r => setTimeout(r, 100))
  }
  return new Response("done")
})
const listening = server.listen({
  port: 0,
  hostname: "127.0.0.1",
  signal: controller.signal,
  onListen: address => {
    listened = `${address.hostname} ${address.port > 0}`
  },
})
if (listening.isErr()) {
  console.log("cannot listen:", listening.error.message)
  process.exit(1)
}
console.log(listened, server.hostname, server.port > 0)
console.log((server.url?.href ?? "").replaceAll(String(server.port), "PORT"))
const slow = fetch(`http://127.0.0.1:${server.port}/slow`)
await started.promise
controller.abort()
const r = must(await slow)
console.log(r.status, must(await r.text()))
await server.finished
console.log("finished")
const after = await fetch(`http://127.0.0.1:${server.port}/`)
if (after.isErr()) console.log(after.error.message)

function must<T, E>(r: Result<T, E>): T {
  if (r.isErr()) {
    console.log(r.error)
    process.exit(1)
  }
  return r.value
}
