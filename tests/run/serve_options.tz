// same-as-node
// The options of a server: where it listens, a signal that stops it, and
// what listen gives: its port, hostname and url; stop() lets the requests
// being handled finish, and waits for them.
import { Server } from "tz:http"

const controller = new AbortController()
const started = Promise.withResolvers<void>()
const server = new Server(
  {
    port: 0,
    hostname: "127.0.0.1",
    signal: controller.signal,
  },
  async (req) => {
    if (new URL(req.url).pathname() == "/slow") {
      started.resolve()
      await new Promise<void>((r) => setTimeout(r, 100))
    }
    return new Response("done")
  },
)
const listened = server.listen()
if (listened.isErr()) {
  console.log("cannot listen:", listened.error.message)
  process.exit(1)
}
const listening = listened.value
console.log(listening.hostname, listening.port > 0)
console.log(listening.url.href().replaceAll(String(listening.port), "PORT"))
const slow = fetch(`http://127.0.0.1:${listening.port}/slow`)
await started.promise
controller.abort()
const r = must(await slow)
console.log(r.status, must(await r.text()))
await listening.stop()
console.log("finished")
const after = await fetch(`http://127.0.0.1:${listening.port}/`)
if (after.isErr()) console.log(after.error.message)

function must<T, E>(r: Result<T, E>): T {
  if (r.isErr()) {
    console.log(r.error)
    process.exit(1)
  }
  return r.value
}
