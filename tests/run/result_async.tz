// An async operation that can fail gives Promise<Result<T, E>>
// (docs/errors.md, section 4): await it, then use the methods of Result.
async function fetchAge(name: string) {
  await undefined
  if (name == "") return err("no name")
  return ok(name.length * 10)
}
console.log(await fetchAge("Ann"), await fetchAge(""))
console.log((await fetchAge("Bo")).map((a) => a * 2))
console.log((await fetchAge("")).mapErr((e) => e.length))
console.log((await fetchAge("Eve")).match((a) => `age ${a}`, (e) => `error ${e}`))
console.log((await fetchAge("")).unwrapOr(-1), (await fetchAge("Fay")).unwrapOr(-1))

// The early return of an Err from an async function, whose value has another
// type.
async function describe(name: string) {
  const age = await fetchAge(name)
  if (age.isErr()) return age
  await undefined
  return ok(`${age.value} years`)
}
console.log(await describe("Bo"), await describe(""))

// Returning the Promise of another async function, without await.
async function viaPromise(name: string) {
  if (name == "?") return ok(0)
  return fetchAge(name)
}
const later = async (name: string) => fetchAge(name)
console.log(await viaPromise("?"), await viaPromise("Cid"), await later(""))

// Several at once: Promise.all gives each Result, Result.combine all values
// or the first error.
const names = ["Al", "Bea", "Cy"]
console.log(Result.combine(await Promise.all(names.map(fetchAge))))
console.log(Result.combine(await Promise.all(["Al", "", "Cy"].map(fetchAge))))
console.log(Result.combineWithAllErrors(await Promise.all(["", "Bea", ""].map(fetchAge))))
