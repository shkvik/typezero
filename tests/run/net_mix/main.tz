// A server and fetch with the rest of the language, across files: handlers of
// a decorated class found by path and called through reflection; a body an
// async generator streams, read with `for await`; a response signed with
// HMAC that the client checks; a fetch whose body comes later than its
// timeout; and a server that stop() stops.
import { Server } from "tz:http"
import { Handlers, routes, verified } from "./routes.tz"

const handlers = new Handlers()

const server = new Server({ port: 0, hostname: "127.0.0.1" }, async req => {
  const name = routes.get(new URL(req.url).pathname())
  if (name == undefined) return new Response("not found", { status: 404 })
  await undefined
  const method = Reflect.get(handlers, name)
  const result = Reflect.apply(method, handlers, [req]).unwrapOr(undefined)
  return result instanceof Response ? result : new Response("bad handler", { status: 500 })
})
const started = server.listen()
if (started.isErr()) {
  console.log("cannot listen:", started.error.message)
  process.exit(1)
}
const listening = started.value
const base = `http://127.0.0.1:${listening.port}`

// 1. A signed response, checked by the client.
const hello = must(await fetch(`${base}/hello?name=tz`))
const text = must(await hello.text())
const signature = hello.headers.get("x-signature") ?? ""
console.log(hello.status, text, verified(text, signature), verified(text + "!", signature))

// 2. A body streamed by an async generator, read in pieces.
const counted = must(await fetch(`${base}/count`))
const decoder = new TextDecoder()
let received = ""
const body = counted.body()
if (body != undefined) for await (const chunk of body) if (chunk.isOk()) received += decoder.decode(chunk.value)
console.log(received)

// 3. A fetch whose body comes later than its timeout.
const slow = must(await fetch(`${base}/slow`, { timeout: 50 }))
const slowText = await slow.text()
if (slowText.isOk()) console.log("in time", slowText.value)
else console.log(slow.status, "timed out:", slowText.error.code)

// 4. Not found, and the server stopped.
console.log((must(await fetch(`${base}/nope`))).status, handlers.served)
await listening.stop()
const after = await fetch(`${base}/hello`)
if (after.isErr()) console.log("after stop:", after.error.message)

function must<T, E>(r: Result<T, E>): T {
  if (r.isErr()) {
    console.log(r.error)
    process.exit(1)
  }
  return r.value
}
