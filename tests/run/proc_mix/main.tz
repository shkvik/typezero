// Child processes with the rest of the language, across files: a decorated
// method that runs this program again, an async generator of what a child
// prints, the fields of an ExecFileTextError narrowed by kind, unknown values, a
// child that reads its input with readLine of tz:io, and the overflow
// warnings for numbers a child printed.
import { execSync, spawnSync } from "node:child_process"
import { readLine } from "tz:io"
import { Runner, ran } from "./tools.tz"

const at = process.argv.indexOf("--child")
if (at >= 0) {
  const what = process.argv[at + 1] ?? ""
  const arg = process.argv[at + 2] ?? ""
  if (what == "count") {
    const count = parseInt(arg).unwrapOr(0)
    for (let i = 1; i <= count && i < 1000; i++)
      console.log(i * 10)
  } else if (what == "fail") {
    console.log("about to fail")
    process.stderr.write(`failing with ${arg}\n`)
    process.exitCode = parseInt(arg).unwrapOr(1)
  } else if (what == "read") {
    let n = 0
    for (let line = readLine(); line != undefined; line = readLine())
      console.log(`${++n}${arg}${line}`)
  }
} else {
  const runner = new Runner([process.argv[1] ?? "", "--child"])

  // 1. A decorated method and an async generator over what a child prints.
  console.log(runner.text("count", "2").map(t => t.trim().split("\n")).unwrapOr([]))
  let total = 0
  for await (const line of runner.lines("count", "4")) {
    const n: int = parseInt(line).unwrapOr(0)
    if (n >= 0 && n < 1000000) total += n
  }
  console.log(total, ran)

  // 2. A child that fails: an Err of an ExecFileTextError, whose fields a
  // check of kind narrows.
  const failed = runner.text("fail", "3")
  console.log(failed.match(out => `ok ${out}`, e => e.kind == "EXEC_FILE_TEXT_ERROR_EXIT" ? `status ${e.status}` : e.message))
  console.log(runner.text("count", "1").map(out => out.trim()).unwrapOr("-"))
  const four = runner.text("fail", "4")
  if (four.isErr() && four.error.kind == "EXEC_FILE_TEXT_ERROR_EXIT") {
    const out = four.error.stdout
    const problem = four.error.stderr
    if (out != undefined && problem != undefined)
      console.log(four.error.status, out.trim(), problem.trim())
  }
  const five = execSync(`"${process.execPath}" "${process.argv[1] ?? ""}" --child fail 5`, { stdio: "pipe" })
  if (five.isErr() && five.error.kind == "EXEC_BYTES_ERROR_EXIT") {
    const out = five.error.stdout
    const problem = five.error.stderr
    if (out != undefined && problem != undefined)
      console.log(five.error.status, out.length, problem.length)
  }

  // 3. Results as unknown values.
  const outputs: unknown[] = [
    spawnSync(process.execPath, [...runner.self, "count", "1"]).map(r => r.stdout ?? Buffer.alloc(0)).unwrapOr(Buffer.alloc(0)),
    spawnSync(process.execPath, [...runner.self, "count", "1"], { encoding: "utf8" }).map(r => r.stdout ?? "").unwrapOr(""),
  ]
  for (const out of outputs)
    console.log(typeof out, out instanceof Buffer ? out.toString("hex") : out)

  // 4. A child that reads the input it is given with readLine.
  const read = spawnSync(process.execPath, [...runner.self, "read", ": "], { input: "один\nдва\r\nтри", encoding: "utf8" })
  if (read.isOk())
    console.log(read.value.stdout, read.value.status)
}
