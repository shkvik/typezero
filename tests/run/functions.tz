// same-as-node
function fib(n: int): int {
  if (n < 2) return n
  return fib(n - 1) + fib(n - 2)
}

function factorial(n: int): double {
  let result: double = 1
  for (let i: int = 2; i <= n; i++) result *= i.toDouble()
  return result
}

function square(x: double): double {
  return x * x
}

function gcd(a: int, b: int): int {
  while (b != 0) {
    let t = b
    b = a % b
    a = t
  }
  return a
}

function sign(x: double): int {
  if (x > 0) {
    return 1
  } else if (x < 0) {
    return -1
  } else {
    return 0
  }
}
function untilThree(): int {
  let i: int = 0
  while (true) {
    i++
    if (i == 3) return i
  }
}
function greet(): void {
  console.log("hi from a void function")
  return
}
// A function changes the state its caller gives it: a module has no `let`.
type Counter = { value: int }
function bump(counter: Counter): void {
  counter.value += 1
}

function main(): void {
  // Functions can be called before their declaration.
  console.log(square(7))
  console.log(fib(20))
  console.log(factorial(20))
  console.log(gcd(1071, 462))

  console.log(sign(-2.5), sign(0), sign(3))

  console.log(untilThree())

  greet()

  const counter: Counter = { value: 0 }
  bump(counter)
  bump(counter)
  bump(counter)
  console.log(counter.value)
}

main()
