// same-as-node
// node:fs: files and directories, in a directory of the test's own under
// the temporary one, which it removes at the end.
import { readFileSync, writeFileSync, appendFileSync, existsSync, mkdirSync, mkdtempSync,
         readdirSync, statSync, lstatSync, rmSync, renameSync, copyFileSync, unlinkSync,
         rmdirSync, realpathSync, accessSync, chmodSync, truncateSync, constants, Stats,
         Dirent } from "node:fs"
import { join, basename, relative } from "node:path"
import { tmpdir } from "node:os"

const dir = must(mkdtempSync(join(tmpdir(), "tz-files-")))
console.log(basename(dir).length, existsSync(dir), must(statSync(dir)).isDirectory())

// Text in and out, with the encoding and the flags.
const notes = join(dir, "notes.txt")
must(writeFileSync(notes, "first\n"))
must(appendFileSync(notes, "second\n"))
must(writeFileSync(notes, "third\n", { flag: "a" }))
console.log(JSON.stringify(must(readFileSync(notes, "utf8"))), must(readFileSync(notes, { encoding: "utf-8" })).length)
must(writeFileSync(notes, "replaced", "utf8"))
must(writeFileSync(notes, "", { flag: "a", encoding: "utf8" }))
console.log(must(readFileSync(notes, { encoding: "utf8", flag: "r" })), existsSync(join(dir, "nope")))

// Directories, and what is in them.
console.log(must(mkdirSync(join(dir, "a"))), must(mkdirSync(join(dir, "a"), { recursive: true })))
const first = must(mkdirSync(join(dir, "b", "c", "d"), { recursive: true }))
console.log(basename(first ?? "none"))
must(writeFileSync(join(dir, "b", "c", "x.txt"), "x"))
must(writeFileSync(join(dir, "b", "y.txt"), "yy"))
console.log(must(readdirSync(dir)))
console.log(must(readdirSync(dir, { recursive: true })))
console.log(must(readdirSync(join(dir, "b"), "utf8")), must(readdirSync(join(dir, "b", "c", "d"))))
for (const entry of must(readdirSync(dir, { withFileTypes: true, recursive: true })))
  console.log(entry.name, relative(dir, entry.parentPath), entry.isFile(), entry.isDirectory(),
              entry.isSymbolicLink())
const entries: Dirent[] = must(readdirSync(join(dir, "b"), { withFileTypes: true }))
for (const entry of entries.slice(0, 1))
  console.log(Object.keys(entry))

// What statSync tells.
const stats: Stats = must(statSync(join(dir, "b", "y.txt")))
console.log(stats.isFile(), stats.isDirectory(), stats.isSymbolicLink(), stats.isFIFO(), stats.size,
            stats.mtimeMs > 0, stats.mtimeMs <= (Date.now() + 1000).toDouble(), stats.nlink)
console.log(Object.keys(stats))
console.log(must(lstatSync(dir)).isDirectory(), must(statSync(join(dir, "nope"), { throwIfNoEntry: false })))
console.log((must(statSync(dir)).mode & 0o170000) == 0o040000, (stats.mode & 0o170000) == 0o100000)

// Moving, copying and deleting.
must(renameSync(join(dir, "b", "y.txt"), join(dir, "z.txt")))
must(copyFileSync(join(dir, "z.txt"), join(dir, "copy.txt")))
must(unlinkSync(join(dir, "copy.txt")))
must(copyFileSync(join(dir, "notes.txt"), join(dir, "copy.txt")))
console.log(must(readFileSync(join(dir, "copy.txt"), "utf8")), existsSync(join(dir, "b", "y.txt")))
must(unlinkSync(join(dir, "copy.txt")))
must(truncateSync(join(dir, "z.txt"), 1))
console.log(JSON.stringify(must(readFileSync(join(dir, "z.txt"), "utf8"))))
must(truncateSync(join(dir, "z.txt")))
console.log(must(statSync(join(dir, "z.txt"))).size)
must(accessSync(join(dir, "z.txt")))
must(accessSync(join(dir, "z.txt"), constants.R_OK | constants.W_OK))
must(chmodSync(join(dir, "z.txt"), 0o444))
console.log((must(statSync(join(dir, "z.txt"))).mode & 0o200) == 0)
must(chmodSync(join(dir, "z.txt"), "644"))
console.log((must(statSync(join(dir, "z.txt"))).mode & 0o200) != 0)
must(rmdirSync(join(dir, "a")))
console.log(must(realpathSync(dir)) == dir, must(realpathSync(join(dir, "b", "..", "z.txt"))) == join(dir, "z.txt"))
must(rmSync(join(dir, "z.txt")))
must(rmSync(join(dir, "missing"), { force: true }))
must(rmSync(join(dir, "missing"), { recursive: true, force: true }))
console.log(must(readdirSync(dir)))
must(rmSync(dir, { recursive: true }))
console.log(existsSync(dir))

function must<T, E>(r: Result<T, E>): T {
  if (r.isErr()) {
    console.log(r.error)
    process.exit(1)
  }
  return r.value
}
