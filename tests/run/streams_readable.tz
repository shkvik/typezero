// Readable of node:stream (docs/streams.md): flowing mode with 'data',
// paused mode with 'readable' and read(), unshift(), pause() and resume(),
// in node's order of events and calls of onRead() (_read() in node).
// pushEnd() ends a stream, as push(null) does in node: the expected output is
// node's. Who listens to a stream listens for 'error' too.
import { Readable } from "node:stream"
const log = (s: string) => console.log(s)

// Flowing: the chunks of read(), then 'end' and 'close'.
let n = 0
class Chunks extends Readable {
  onRead(size) {
    log(`read ${size}`)
    n++
    if (n <= 3) this.push(`chunk${n}`)
    else this.pushEnd()
  }
}
class Later extends Readable {
  private chunks: string[]
  constructor(chunks: string[]) {
    super({ highWaterMark: 4 })
    this.chunks = chunks
  }
  onRead(size) {
    const next = this.chunks.shift()
    log(`_read ${size} -> ${next ?? "EOF"}`)
    if (next == undefined) {
      this.pushEnd()
      return
    }
    const chunk: string = next
    setTimeout(() => this.push(chunk), 1)
  }
}
class Manual extends Readable {
  onRead() {}
}
const r = new Chunks()
r.on("error", (e) => log(`error ${e.message}`))
r.on("data", (chunk) => log(`data ${chunk.toString()}`))
r.on("end", () => log("end"))
r.on("pause", () => log("pause"))
r.on("resume", () => log("resume"))
process.nextTick(() => log("tick"))
setImmediate(() => log("immediate"))
log("sync done")

// Paused: 'readable', and read() until it gives undefined.
r.on("close", () => {
  log("close")
  const p = new Later(["ab", "cd", "ef"])
  p.on("error", (e) => log(`p error ${e.message}`))
  p.on("readable", () => {
    log(`readable len=${p.readableLength()}`)
    let chunk: Buffer | undefined
    while ((chunk = p.read()) != undefined) log(`read ${chunk.toString()}`)
    log(`after loop ended=${p.readableEnded()}`)
  })
  p.on("end", () => log("p end"))
  p.on("close", () => {
    log(`p close destroyed=${p.destroyed()}`)
    p.removeAllListeners()
    more()
  })
})

// read(n), unshift(), pause() and resume().
function more() {
  const s = new Manual()
  s.push("hello ")
  s.push("world")
  log(`len ${s.readableLength()}`)
  const first = s.read(3)
  log(`read3 ${first?.toString()}`)
  s.unshift(Buffer.from("XY"))
  log(`len ${s.readableLength()}`)
  const all = s.read()
  log(`all ${all?.toString()}`)
  s.pushEnd()
  s.on("error", (e) => log(`s error ${e.message}`))
  s.on("end", () => log("s end"))
  s.resume()
  log(`paused ${s.isPaused()}`)
  s.pause()
  log(`paused ${s.isPaused()}`)
  s.resume()
}
