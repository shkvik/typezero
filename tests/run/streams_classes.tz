// Classes of the program that extend those of node:stream and replace the
// methods the stream calls (onRead, onWrite, onTransform... — _read, _write,
// _transform in node): they take the parameters node passes, whose types may
// be left out, as may the last of them (`onRead()`), as in node. undefined ends a stream, as null does in
// node: the output is node's with push(null).
import { Duplex, Readable, Transform, Writable } from "node:stream"
import { finished, pipeline } from "node:stream/promises"

class Counter extends Readable {
  private n = 0
  limit: int
  constructor(limit: int) {
    super()
    this.limit = limit
  }
  onRead() {
    this.n++
    if (this.n > this.limit) this.push(undefined)
    else this.push(`${this.n}\n`)
  }
}

class Upper extends Transform {
  onTransform(chunk, encoding, callback) {
    callback(undefined, chunk.toString().toUpperCase())
  }
  onFlush(callback) {
    this.push("done\n")
    callback()
  }
}

class Collect extends Writable {
  parts: string[] = []
  onWrite(chunk: Buffer, encoding: string, callback: (error?: StreamError) => void) {
    this.parts.push(chunk.toString())
    callback()
  }
  onFinal(callback) {
    console.log("final", this.parts.length)
    callback()
  }
  onDestroy(error, callback) {
    console.log("destroy", error == undefined)
    callback(error)
  }
}

const sink = new Collect()
const piped = await pipeline(new Counter(3), new Upper(), sink)
console.log(piped.isOk(), JSON.stringify(sink.parts.join("")), sink.destroyed())

// A class of strings: onWrite() gets them as they were written.
class Lines extends Writable<string> {
  constructor() {
    super({ decodeStrings: false })
  }
  onWrite(line, encoding, callback) {
    console.log("line", JSON.stringify(line), encoding)
    callback()
  }
}
const lines = new Lines()
lines.write("one")
const linesEnded = await lines.end("two")
console.log("lines", linesEnded.isOk(), (await finished(lines)).isOk())

// onRead(size: number), as the types of node have it: the highWaterMark.
class Sized extends Readable {
  sent = 0
  onRead(size: number) {
    if (this.sent > 0) {
      this.push(undefined)
      return
    }
    this.sent = size
    console.log("size", size)
    this.push(Buffer.alloc(3, 120))
  }
}
const sized = new Sized({ highWaterMark: 100 })
sized.on("data", (b) => console.log("data", b.toString()))
console.log("sized", (await finished(sized)).isOk())

// A Duplex that gives back what is written to it.
class Echo extends Duplex {
  onRead(size) {}
  onWrite(chunk, encoding, callback) {
    this.push(chunk)
    callback()
  }
  onFinal(callback) {
    this.push(undefined)
    callback()
  }
}
const echo = new Echo()
echo.on("data", (b) => console.log("echo", b.toString()))
echo.write("ping")
const echoEnded = echo.end("pong")
const echoDone = await finished(echo)
console.log("end", echoDone.isOk(), (await echoEnded).isOk())
