// What reflection checks when the program runs (docs/decorators.md, section
// 6), where JavaScript goes on with what it got: each argument against the
// parameter it goes to, how many there are, the `this` of a method. A value
// that does not fit is an Err of a ReflectError that says which and why;
// `new` of a class value is checked when compiling (errors/reflect_new.tz).

class Point {
  constructor(public x: int, public y: int) {}
  move(dx: int, dy?: int) {
    this.x += dx
    this.y += dy ?? 0
    return this
  }
  scale(...factors: double[]) {
    let k = 1.0
    for (const f of factors) k *= f
    return `${this.x * k}, ${this.y * k}`
  }
}
class Label {
  constructor(public text: string, public at: Point) {}
}
abstract class Shape {
  abstract area(): double
}
class Square extends Shape {
  constructor(public side: double) {
    super()
  }
  area() {
    return this.side * this.side
  }
}

function show<T>(what: string, r: Result<T, ReflectError>) {
  if (r.isOk()) console.log(what, r.value)
  else console.log(what, `${r.error.code}: ${r.error.message}`)
}

const kind: Constructor = Point
const labelKind: Constructor<Label> = Label
const p = new Point(1, 2)
console.log("new", new kind(3, 4))
show("construct", Reflect.construct(kind, [1, 2.5]))
show("construct", Reflect.construct(kind, [1]))
show("construct", Reflect.construct(kind, [1, 2, 3]))
show("construct", Reflect.construct(kind, ["1", 2]))
console.log("new", new labelKind("here", p))
show("construct", Reflect.construct(labelKind, ["here", new Label("x", new Point(0, 0))]))
const move = Reflect.get(p, "move")
show("apply", Reflect.apply(move, p, [3]))
show("apply", Reflect.apply(move, p, [3, 4]))
show("apply", Reflect.apply(move, p, []))
show("apply", Reflect.apply(move, p, [true]))
show("apply", Reflect.apply(move, new Label("l", p), [1]))
show("apply", Reflect.apply(Reflect.get(p, "scale"), p, [2, 0.5, 3]))
show("apply", Reflect.apply(Reflect.get(p, "scale"), p, [2, "x"]))
const five: unknown = 5
show("apply", Reflect.apply(five, p, []))
show("apply", Reflect.apply(Reflect.get(p, "x"), p, []))
const shapes: Constructor<Shape>[] = [Square, Shape]
for (const shape of shapes) show("construct", Reflect.construct(shape, [3]).map(s => s.area()))
console.log("get", Reflect.get(p, "x"))
const nothing: unknown = undefined
console.log("get", Reflect.get(nothing, "x"), Reflect.get(five, "x"))
console.log("get", Reflect.get(Point, "name"))
