// same-as-node
// Files that import each other. main.tz loads a.tz, which loads b.tz, which
// imports a.tz back: b.tz runs first, before a.tz has run, so it uses what
// a.tz declares only inside functions, which run later.
import { greet, isEven } from "./a.tz"
console.log(greet("main"))
console.log(isEven(10), isEven(7))
