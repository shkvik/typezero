// same-as-node
// `x >>> n` of a double: ToUint32 of x, as in JavaScript, with counts that are
// constants and counts known only when the program runs.
const xs: double[] = [0, -0, 1.5, -1.5, 0.99, -0.99, 2147483647.5, 2147483648, -2147483649,
  4294967295.9, 4294967296.5, -4294967297, 1e20, -1e20, 2.0 ** 53 + 2, NaN, Infinity, -Infinity]
for (const x of xs)
  console.log(x, x >>> 0, x >>> 1, x >>> 16, x >>> 31, x >>> 32, x >>> 33, (x >>> 0) | 0)

function shift(x: double, n: int) {
  return x >>> n
}
for (const n of [0, 1, 5, 31, 32, 63, -1]) {
  console.log(n, shift(-1, n), shift(3000000000.7, n), shift(-123456.789, n), shift(NaN, n))
}

// Where an int is expected, a count of 1 to 31 fits; otherwise the result is
// a long, as for an int.
const half: int = 3000000000.5 >>> 1
const whole = -0.5 >>> 0
const big: int = -1.5 >>> 0
console.log(half, whole, big)

// `>>>=` on a double keeps the unsigned result.
let d = -5.5
d >>>= 0
let e = 1e10
e >>>= 3
let f = -1
f >>>= 28
console.log(d, e, f)

// The hash of the uuid package, without `| 0` before the shift.
function md5ish(text: string) {
  let h = 0x811c9dc5
  for (let i = 0; i < text.length; i++) h = Math.imul(h ^ text.charCodeAt(i), 16777619)
  const ratio = (h >>> 0) / 2.0 ** 32
  return Math.floor(ratio * 2.0 ** 32 + 0.5) >>> 0
}
console.log(md5ish("hello"), md5ish(""), (2.0 ** 32 - 1) * 1.0 >>> 8)
