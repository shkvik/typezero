// Errors across files (docs/errors.md): types of objects with a tag, unions
// of them told apart by the tag, errors of regexes, Json and decimal given
// on, overriding methods and generic code with a Result, a generator of
// Results that a loop leaves at the first Err, and where each Err was made.
import { AppError, AtMost, Pattern, Positive, Rule, Validator, describe } from "./errors.tz"
import { loadConfig, ownerName, parseLine } from "./parse.tz"

// 1. Regexes, decimal and Json, from another file.
const inputs = [{ line: "rent: 12.50 #home #monthly", separator: ":" }, { line: "???", separator: ":" },
                { line: "food: 1.2.3", separator: ":" }, { line: "a: 1", separator: "(" }]
for (const { line, separator } of inputs) {
  const entry = parseLine(line, 1, separator)
  if (entry.isOk()) {
    console.log("entry", JSON.stringify(entry.value))
  } else {
    const e = entry.error
    if (e.code == "ERR_INVALID_REGEX") console.log("regex:", e.message)
    else console.log("parse:", describe(e))
  }
}
for (const text of ['{"limit": 100, "rules": ["positive"]}', '{"limit": "lots", "rules": []}', '{"limit": 1,']) {
  const config = loadConfig(text)
  if (config.isOk()) console.log("config", config.value.limit, config.value.rules)
  else console.log("config:", config.error.message, config.error.cause)
}
console.log(ownerName('{"owner": {"name": "Ann"}}'), ownerName('{"owner": null}'))

// 2. Overriding methods, called through the base class; the first Err ends
// the loop.
const rules: Rule[] = [new Positive(), new AtMost(100)]
function checkAll(amount: decimal): Result<decimal, AppError> {
  let value = amount
  for (const rule of rules) {
    const checked = rule.check(value)
    if (checked.isErr()) return checked
    value = checked.value
  }
  return ok(value)
}
for (const amount of [decimal("5"), decimal("-1"), decimal("250")]) {
  const checked = checkAll(amount)
  console.log(`check ${amount}:`, checked.isOk() ? `${checked.value}` : describe(checked.error))
}
console.log(rules.map((r) => r.label()).join())
const validators: Validator[] = [new Pattern("^\\w+$", "i"), new Pattern("[a-", "")]
for (const v of validators)
  for (const text of ["abc", "a b"]) {
    const valid = v.validate(text)
    console.log(`validate ${text}:`, valid.isOk() ? valid.value : describe(valid.error))
  }

// 3. Generic code: the Result of the callback goes through it.
function firstThat<T>(items: T[], wanted: (x: T) => boolean): Result<T, string> {
  for (const x of items) if (wanted(x)) return ok(x)
  return err(`none of ${items.length}`)
}
function retry<T, E>(times: int, f: (n: int) => Result<T, E>): Result<T, E[]> {
  const failures: E[] = []
  for (let n = 1; n <= times; n++) {
    const r = f(n)
    if (r.isOk()) return ok(r.value)
    failures.push(r.error)
  }
  return err(failures)
}
console.log(firstThat(["a", "bb", "ccc"], (s) => s.length > 1))
console.log(firstThat([1, 2, 3], (n) => n > 5))
const retried = retry(3, (n) => checkAll(decimal(n < 3 ? -n : n)))
console.log(retried.isOk() ? `retry ${retried.value}` : "retry failed")
const failed = retry(2, (n) => checkAll(decimal(n * 1000)))
if (failed.isErr()) console.log(failed.error.map((e) => describe(e)))

// 4. A generator of Results: the loop stops at the first Err.
function* entries(lines: string[]) {
  let n = 0
  for (const line of lines) yield parseLine(line, ++n, ":")
}
function total(lines: string[]): Result<decimal, string> {
  let sum: decimal = 0
  for (const entry of entries(lines)) {
    if (entry.isErr()) {
      const e = entry.error
      return err(e.code == "ERR_INVALID_REGEX" ? e.message : describe(e))
    }
    const checked = checkAll(entry.value.amount)
    if (checked.isErr()) return err(describe(checked.error))
    sum += checked.value
  }
  return ok(sum)
}
console.log(total(["a: 1", "b: 2.5"]).unwrapOr(-1))
console.log(total(["a: 1", "b: x", "c: 3"]))
console.log(total(["a: 1", "b: 500"]))

// 5. Where an Err was made: the function and the line, in any file.
console.log(checkAll(decimal("-3")))
console.log(parseLine("bad", 10, ":"))
console.log(JSON.stringify(checkAll(decimal("700")).match((v) => `${v}`, (e) => e)))
