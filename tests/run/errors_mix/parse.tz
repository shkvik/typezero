// Reading the input: regexes made when the program runs, decimal(s) and
// JSON.parse with a check of its own, whose errors become errors of the
// program in a Result.
import { ConfigError, ParseError } from "./errors.tz"

export type Entry = { name: string; amount: decimal; tags: string[] }

export function tagsOf(text: string): string[] {
  const tags: string[] = []
  for (const m of text.matchAll(/#(\w+)/g)) tags.push(m[1] ?? "")
  return tags
}

export function parseLine(line: string, n: int, separator: string): Result<Entry, ParseError | RegexError> {
  const re = RegExp.parse(`^(\\w+)${separator}\\s*(\\S+)(.*)$`)
  if (re.isErr()) return err(re.error)
  const m = re.value.exec(line)
  if (m == undefined) return err({ code: "unreadable", message: `cannot read '${line}'`, line: n })
  const text = m[2] ?? ""
  const amount = decimal(text)
  if (amount.isErr()) return err({ code: "bad_amount", message: amount.error.message, line: n, text })
  return ok({ name: m[1] ?? "", amount: amount.value, tags: tagsOf(m[3] ?? "") })
}

export type Config = { limit: decimal; rules: string[]; owner?: { name: string } }

function isConfigJson(data: Json): boolean {
  return typeof data == "object" && typeof data.limit == "number" && Array.isArray(data.rules)
}

export function loadConfig(text: string): Result<Config, ConfigError> {
  const parsedResult = JSON.parse(text)
  if (parsedResult.isErr())
    return err({ code: "bad_config", message: "bad config", cause: parsedResult.error.message })
  const data = parsedResult.value
  if (!isConfigJson(data)) return err({ code: "bad_config", message: "bad config", cause: "not a config" })
  const rules: string[] = []
  for (const rule of data.rules) if (typeof rule == "string") rules.push(rule)
  const limit = decimal(String(data.limit))
  if (limit.isErr()) return err({ code: "bad_config", message: "bad config", cause: limit.error.message })
  const config: Config = { limit: limit.value, rules: rules }
  return ok(config)
}

// Reading a Json by hand: a key of null is undefined.
export function ownerName(text: string): string {
  const j = JSON.parse(text).unwrapOr(null)
  const name = j.owner.name
  return typeof name == "string" ? name : "?"
}
