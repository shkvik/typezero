// same-as-node
// Web Crypto with asymmetric keys, fixed so that what is deterministic (Ed25519, RSASSA-PKCS1-v1_5,
// ECDH, X25519, the JWKs) gives node's bytes: ECDSA, RSA-PSS, RSA-OAEP, Ed25519, ECDH and X25519,
// and the keys in spki, pkcs8, jwk and raw, out and in again.
const subtle = crypto.subtle
const enc = new TextEncoder()
const hex = (b: ArrayBuffer) => Buffer.from(b).toString("hex")
const b64 = (s: string) => new Uint8Array(Buffer.from(s, "base64"))
const ecSpki = b64("MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEuWIM2JbLJ21D4deDZ4pLWk7ZvpnBMyYhxIGbcRcen1WxBGViitNtIqy3BCqzLw8pNP9x8KIQMpPqKZArtfVTUQ==")
const ecPkcs8 = b64("MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgoN9C2OR5/7yJBJoC5shMWHOcuJoLwE2eSVf61squ5A2hRANCAAS5YgzYlssnbUPh14NniktaTtm+mcEzJiHEgZtxFx6fVbEEZWKK020irLcEKrMvDyk0/3HwohAyk+opkCu19VNR")
const ec2Spki = b64("MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEB6oRpP92Ks8PFq7n22hkHDXTqn5ZCNwC/5/5v7w3RzK4QrE/h2INTFbifPVmCfgCHuF+jU0pcp/FhCMUR0SUYg==")
const ec2Pkcs8 = b64("MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQggphHYp+9AfcZA8i9ogCd/M6cAlgVQNGf3gqti153kaqhRANCAAQHqhGk/3Yqzw8WrufbaGQcNdOqflkI3AL/n/m/vDdHMrhCsT+HYg1MVuJ89WYJ+AIe4X6NTSlyn8WEIxRHRJRi")
const edSpki = b64("MCowBQYDK2VwAyEAQtnFfC6wvYbVATYWrpuFGQCymTTuLxerB+YwpIwITDU=")
const edPkcs8 = b64("MC4CAQAwBQYDK2VwBCIEIMuKA0dNXtgdwnjFqC3w1MeBn7hMqG+2UBOZTqaDMdx/")
const xSpki = b64("MCowBQYDK2VuAyEA6WGOatiILTysUgHF0lz50MHkvllTtEsKCVE72UF/N10=")
const xPkcs8 = b64("MC4CAQAwBQYDK2VuBCIEIJBMlKHXaGN70OwGZ0mJWo/s11GvTcU2BD2iZTpg3XJO")
const x2Spki = b64("MCowBQYDK2VuAyEAZ0GXO3a0+XVZOzvI1WR7eLpDrChf77y6LuMUJaaWtzI=")
const x2Pkcs8 = b64("MC4CAQAwBQYDK2VuBCIEIDCL57rTrgebgs/6tfQ+M8/rVPCIZmCfjbc3kpsryad6")
const rsaSpki = b64("MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQDubZ//owIUboSkxXbYBzYmBCYOqVRlp3fE6RBoXaTqg1xci+cJfNaH5ycerjAWZVWFM42cPinzEYhZt8ihWE0dP64/P31b/rYMq/WZaBqoQmezkutr7hqzieWAocp8eM1tst1PiropEF2emwUv2Za9IJwUYhx6Vudyo4B72lWuIQIDAQAB")
const rsaPkcs8 = b64("")
const data = enc.encode("the data")

// ECDSA
const ecPriv = await subtle.importKey("pkcs8", ecPkcs8, { name: "ECDSA", namedCurve: "P-256" }, true, ["sign"])
const ecPub = await subtle.importKey("spki", ecSpki, { name: "ECDSA", namedCurve: "P-256" }, true, ["verify"])
console.log(ecPriv, ecPub.algorithm)
const ecSig = await subtle.sign({ name: "ECDSA", hash: "SHA-256" }, ecPriv, data)
console.log("ecdsa", ecSig.byteLength, await subtle.verify({ name: "ECDSA", hash: "SHA-256" }, ecPub, ecSig, data))
console.log("ecdsa other hash", await subtle.verify({ name: "ECDSA", hash: "SHA-384" }, ecPub, ecSig, data))
console.log(await subtle.exportKey("jwk", ecPriv))
console.log(hex(await subtle.exportKey("raw", ecPub)))
const ecRaw = await subtle.importKey("raw", await subtle.exportKey("raw", ecPub), { name: "ECDSA", namedCurve: "P-256" }, true, ["verify"])
console.log(Buffer.from(await subtle.exportKey("spki", ecRaw)).toString("base64") == Buffer.from(ecSpki).toString("base64"))
console.log(Buffer.from(await subtle.exportKey("pkcs8", ecPriv)).toString("base64") == Buffer.from(ecPkcs8).toString("base64"))

// Ed25519
const edPriv = await subtle.importKey("pkcs8", edPkcs8, "Ed25519", true, ["sign"])
const edPub = await subtle.importKey("spki", edSpki, { name: "Ed25519" }, true, ["verify"])
const edSig = await subtle.sign("Ed25519", edPriv, data)
console.log("ed25519", hex(edSig))
console.log(await subtle.verify("Ed25519", edPub, edSig, data), await subtle.verify("Ed25519", edPub, edSig, enc.encode("x")))
console.log(await subtle.exportKey("jwk", edPriv), await subtle.exportKey("jwk", edPub))
console.log(hex(await subtle.exportKey("raw", edPub)))

// RSA
const rsaPriv = await subtle.importKey("pkcs8", rsaPkcs8, { name: "RSASSA-PKCS1-v1_5", hash: "SHA-256" }, true, ["sign"])
const rsaPub = await subtle.importKey("spki", rsaSpki, { name: "RSASSA-PKCS1-v1_5", hash: "SHA-256" }, true, ["verify"])
console.log(rsaPub)
const rsaSig = await subtle.sign("RSASSA-PKCS1-v1_5", rsaPriv, data)
console.log("pkcs1", hex(rsaSig))
console.log(await subtle.verify("RSASSA-PKCS1-v1_5", rsaPub, rsaSig, data))
const pssPriv = await subtle.importKey("pkcs8", rsaPkcs8, { name: "RSA-PSS", hash: "SHA-384" }, false, ["sign"])
const pssPub = await subtle.importKey("spki", rsaSpki, { name: "RSA-PSS", hash: "SHA-384" }, false, ["verify"])
const pssSig = await subtle.sign({ name: "RSA-PSS", saltLength: 32 }, pssPriv, data)
console.log("pss", pssSig.byteLength, await subtle.verify({ name: "RSA-PSS", saltLength: 32 }, pssPub, pssSig, data), await subtle.verify({ name: "RSA-PSS", saltLength: 20 }, pssPub, pssSig, data))
const oaepPub = await subtle.importKey("spki", rsaSpki, { name: "RSA-OAEP", hash: "SHA-256" }, false, ["encrypt"])
const oaepPriv = await subtle.importKey("pkcs8", rsaPkcs8, { name: "RSA-OAEP", hash: "SHA-256" }, false, ["decrypt"])
const sealed = await subtle.encrypt({ name: "RSA-OAEP", label: enc.encode("L") }, oaepPub, data)
console.log("oaep", sealed.byteLength, new TextDecoder().decode(await subtle.decrypt({ name: "RSA-OAEP", label: enc.encode("L") }, oaepPriv, sealed)))
try { await subtle.decrypt({ name: "RSA-OAEP" }, oaepPriv, sealed) } catch (e) { console.log(e.name, e.message) }
const rsaJwk = await subtle.exportKey("jwk", rsaPub)
console.log(rsaJwk)

// ECDH and X25519
const a = await subtle.importKey("pkcs8", ecPkcs8, { name: "ECDH", namedCurve: "P-256" }, false, ["deriveBits", "deriveKey"])
const bPub = await subtle.importKey("spki", ec2Spki, { name: "ECDH", namedCurve: "P-256" }, false, [])
const b = await subtle.importKey("pkcs8", ec2Pkcs8, { name: "ECDH", namedCurve: "P-256" }, false, ["deriveBits"])
const aPub = await subtle.importKey("spki", ecSpki, { name: "ECDH", namedCurve: "P-256" }, false, [])
console.log("ecdh", hex(await subtle.deriveBits({ name: "ECDH", public: bPub }, a, 256)))
console.log("ecdh", hex(await subtle.deriveBits({ name: "ECDH", public: aPub }, b)))
console.log("ecdh 100", hex(await subtle.deriveBits({ name: "ECDH", public: aPub }, b, 100)))
const xa = await subtle.importKey("pkcs8", xPkcs8, "X25519", false, ["deriveBits"])
const xbPub = await subtle.importKey("spki", x2Spki, "X25519", true, [])
console.log("x25519", hex(await subtle.deriveBits({ name: "X25519", public: xbPub }, xa, 256)))
const xb = await subtle.importKey("pkcs8", x2Pkcs8, "X25519", false, ["deriveBits"])
const xaPub = await subtle.importKey("spki", xSpki, "X25519", false, [])
console.log("x25519", hex(await subtle.deriveBits({ name: "X25519", public: xaPub }, xb, 256)))
console.log(await subtle.exportKey("jwk", xbPub))
const derived = await subtle.deriveKey({ name: "ECDH", public: bPub }, a, { name: "AES-GCM", length: 128 }, true, ["encrypt"])
console.log(derived, hex(await subtle.exportKey("raw", derived)))

// Generated keys of each family, through JWK and back.
const spki = (k: CryptoKey) => subtle.exportKey("spki", k)
const ec = await subtle.generateKey({ name: "ECDSA", namedCurve: "P-521" }, true, ["sign", "verify"])
const ecJwk = await subtle.exportKey("jwk", ec.privateKey)
const ecBack = await subtle.importKey("jwk", ecJwk, { name: "ECDSA", namedCurve: "P-521" }, true, ["sign"])
const ecPubJwk = await subtle.exportKey("jwk", ec.publicKey)
const ecPubBack = await subtle.importKey("jwk", ecPubJwk, { name: "ECDSA", namedCurve: "P-521" }, true, ["verify"])
console.log(hex(await spki(ecPubBack)) == hex(await spki(ec.publicKey)), ecBack.type, ecJwk.crv, Object.keys(ecPubJwk))
const sig = await subtle.sign({ name: "ECDSA", hash: "SHA-384" }, ecBack, new Uint8Array(3))
console.log(sig.byteLength, await subtle.verify({ name: "ECDSA", hash: "SHA-384" }, ec.publicKey, sig, new Uint8Array(3)))
const ed = await subtle.generateKey({ name: "Ed25519" }, true, ["sign", "verify"])
const edJwk = await subtle.exportKey("jwk", ed.privateKey)
const edBack = await subtle.importKey("jwk", edJwk, "Ed25519", false, ["sign"])
const edSig2 = await subtle.sign("Ed25519", edBack, new Uint8Array(1))
console.log(hex(edSig2) == hex(await subtle.sign("Ed25519", ed.privateKey, new Uint8Array(1))), edJwk.kty, Object.keys(edJwk))
const x = await subtle.generateKey("X25519", true, ["deriveBits"])
const xJwk = await subtle.exportKey("jwk", x.publicKey)
const xBack = await subtle.importKey("jwk", xJwk, "X25519", true, [])
console.log(hex(await subtle.deriveBits({ name: "X25519", public: xBack }, x.privateKey, 256)) == hex(await subtle.deriveBits({ name: "X25519", public: x.publicKey }, x.privateKey, 256)))
const rsa = await subtle.generateKey({ name: "RSA-PSS", modulusLength: 1024, publicExponent: new Uint8Array([1, 0, 1]), hash: "SHA-256" }, true, ["sign", "verify"])
const rsaJwk2 = await subtle.exportKey("jwk", rsa.privateKey)
const rsaBack = await subtle.importKey("jwk", rsaJwk2, { name: "RSA-PSS", hash: "SHA-256" }, true, ["sign"])
console.log(rsaBack.algorithm, rsaJwk2.alg, Object.keys(rsaJwk2).length)
const pss = await subtle.sign({ name: "RSA-PSS", saltLength: 0 }, rsaBack, new Uint8Array(2))
console.log(await subtle.verify({ name: "RSA-PSS", saltLength: 0 }, rsa.publicKey, pss, new Uint8Array(2)))
try { await subtle.sign({ name: "RSA-PSS", saltLength: 100 }, rsaBack, new Uint8Array(2)) } catch (e) { console.log(e.name, e.message) }
// pkcs8 of each, and spki of the public keys.
for (const k of [ec.privateKey, ed.privateKey, x.privateKey]) console.log(k.algorithm.name, (await subtle.exportKey("pkcs8", k)).byteLength)
console.log((await subtle.exportKey("pkcs8", rsa.privateKey)).byteLength > 600)
// JSON text as a JWK.
const text = JSON.stringify(await subtle.exportKey("jwk", ed.publicKey))
const parsed = JSON.parse(text).unwrapOr(null)
const fromText = await subtle.importKey("jwk", parsed, "Ed25519", true, ["verify"])
console.log(await subtle.verify("Ed25519", fromText, edSig2, new Uint8Array(1)))
