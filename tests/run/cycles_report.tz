// expect-stderr: tz: group of Guest: 4092 of 4096 objects cannot be reached, held by Guest.friend at cycles_report.tz:23
// A program compiled with TZ_CHECK_LEAKS set walks a group that has grown
// large (docs/objects.md, section 11). Two guests who came together point at
// each other, and the room points at the last guest who came, so all of them
// are in the group of the room. A guest the room no longer points at is freed
// at once, unless the guest is in a cycle: a pair that has left stays in the
// group while the room lives, and the report names the reference that holds it.
class Room {
  last?: Guest
  visits: int

  constructor() {
    this.visits = 0
  }
}

class Guest {
  friend?: Guest
  room?: Room
  constructor(public name: string) {}
}

function serve(days: int): int {
  const room = new Room()
  for (let day = 0; day < days; day++) {
    const a = new Guest(`a${day}`), b = new Guest(`b${day}`)
    a.friend = b
    b.friend = a
    a.room = room
    room.last = a
    room.visits++
    const alone = new Guest(`c${day}`)
    alone.room = room
    room.last = alone
  }
  return room.visits
}

console.log(serve(20000))
