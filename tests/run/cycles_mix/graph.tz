// What main.tz builds its cycles from: an emitter whose events are those its
// code emits; a server whose connections refer back to it, with
// an EventTarget that shuts it down, the promises of their ends and a hash
// of what each reads; and handlers that a class decorator registers by path,
// which reflection makes for each server.
import { EventEmitter } from "node:events"
import { createHash, Hash } from "node:crypto"

export class Room extends EventEmitter {
  lines: string[]
  constructor(readonly name: string) {
    super()
    this.lines = []
  }
  say(who: string, text: string) {
    this.emit("say", { who: who, text: text })
  }
  close() {
    this.emit("close")
  }
}

// `@Route("/path")`: the class handles that path.
export const routes = new Map<string, Constructor<Handler>>()
export function Route(path: string) {
  return (cls: Constructor<Handler>) => {
    routes.set(path, cls)
  }
}

export class Handler {
  handled: int
  constructor(readonly server: Server) {
    this.handled = 0
  }
  handle(conn: Conn, text: string): string {
    this.handled++
    return `${conn.id}:${text}`
  }
}

export class Conn {
  peer?: Conn
  onData?: (text: string) => void
  readonly finish: (why: string) => void
  readonly done: Promise<string>
  readonly hash: Hash
  constructor(readonly server: Server, readonly id: int) {
    this.hash = sha256()
    // The resolve of the promise, whose environment is the promise.
    const { promise, resolve } = Promise.withResolvers<string>()
    this.done = promise
    this.finish = resolve
  }
  receive(text: string) {
    this.hash.update(text)
    this.onData?.(text)
  }
  close(why: string) {
    this.server.conns.delete(this)
    this.finish(`${this.id} ${why}`)
  }
}

export class Server {
  readonly conns: Set<Conn>
  readonly byId: Map<int, Conn>
  readonly handlers: Map<string, Handler>
  readonly log: string[]
  readonly shutdown: EventTarget
  down: boolean
  constructor(readonly name: string) {
    this.conns = new Set<Conn>()
    this.byId = new Map<int, Conn>()
    this.handlers = new Map<string, Handler>()
    this.log = []
    this.shutdown = new EventTarget()
    this.down = false
    // The target's listener holds the server, which holds the target.
    this.shutdown.addEventListener("shutdown", () => {
      this.down = true
      for (const c of [...this.conns]) c.close("shutdown")
    })
    for (const [path, cls] of routes) this.handlers.set(path, new cls(this))
  }
  accept(id: int): Conn {
    const c = new Conn(this, id)
    this.conns.add(c)
    this.byId.set(id, c)
    return c
  }
  route(path: string, conn: Conn, text: string): string {
    return this.handlers.get(path)?.handle(conn, text) ?? `no route ${path}`
  }
}

// createHash gives a Result (OpenSSL may refuse); a connection without its hash cannot work.
function sha256(): Hash {
  const made = createHash("sha256")
  if (made.isErr()) {
    console.log(made.error.message)
    process.exit(1)
  }
  return made.value
}
