// take() and drop() take a count shown not to be negative (JavaScript throws
// a RangeError at a negative one); a count of 0 is fine.
function* naturals() {
  let n = 0
  while (true) yield n++
}
console.log(naturals().take(0).toArray(), naturals().drop(0).take(1).toArray())
let count = -2
if (count >= 0) console.log(naturals().take(count).toArray())
else console.log("negative count", count)
