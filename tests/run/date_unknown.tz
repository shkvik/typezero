// env: TZ=UTC
// What dates do where JavaScript throws (docs/errors.md, step 5): a text that
// is no date is an Err of Date.parse, a language that is none an Err of
// Intl.Locale.parse; a time zone or a calendar that only the running program
// shows to be unknown is left out (the zone of the computer, the gregorian
// calendar); a value of an option with a list is checked when the program is
// built (tests/errors/date.tz). An invalid date still prints as one until
// numbers are proven (docs/numbers.md); toISOString() of it is fatal
// (tests/run/date_invalid.tz).
const texts = ["2026-10-23T10:00Z", "not a date"]
for (const text of texts) {
  const ms = Date.parse(text)
  console.log(ms.isOk() ? new Date(ms.value).toISOString() : ms.error)
}
const zones = ["Asia/Bishkek", "Mars/Base"]
for (const timeZone of zones) {
  console.log(timeZone, new Intl.DateTimeFormat("en-US", { timeZone, hour: "numeric" }).format(0))
  console.log(timeZone, new Date(0).toLocaleString("en-US", { timeZone }))
}
const months = ["long", "huge"]
for (const month of months) {
  if (month == "long" || month == "short") console.log(new Date(0).toLocaleDateString("en-US", { month, timeZone: "UTC" }))
  else console.log(month, "is no width of a month")
}
const calendars = ["gregory", "not a calendar!"]
for (const calendar of calendars)
  console.log(calendar, new Intl.DateTimeFormat("en-US", { calendar, timeZone: "UTC" }).format(0))
const options: Intl.DateTimeFormatOptions[] = [{ dateStyle: "short" }, { dateStyle: "short", hour: "numeric" }]
for (const o of options) console.log(new Date(0).toLocaleString("en-US", { ...o, timeZone: "UTC" }))
const timed: Intl.DateTimeFormatOptions = { timeStyle: "short", timeZone: "UTC" }
console.log(new Date(0).toLocaleDateString("en-US", timed))
for (const tag of ["de-DE", "en_US"]) {
  const locale = Intl.Locale.parse(tag)
  console.log(tag, locale.isOk() ? new Date(0).toLocaleDateString(locale.value, { timeZone: "UTC" }) : locale.error.message)
}
