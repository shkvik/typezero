// Object-mode streams: their chunk types, given or found from what the
// program pushes and writes (docs/streams.md, section 2), pipeline() of
// node:stream/promises with async generators, and node:stream/consumers.
// undefined ends a stream, as null does in node: the output is node's with
// push(null).
import { Readable, Transform, Writable } from "node:stream"
import { pipeline } from "node:stream/promises"
import { text, json, buffer } from "node:stream/consumers"
interface User {
  name: string
  age: int
}
const log = (s: string) => console.log(s)
class Users extends Readable<User> {
  constructor() {
    super({ objectMode: true })
  }
  onRead() {}
}
const users = new Users()
users.push({ name: "ann", age: 31 })
users.push({ name: "bob", age: 25 })
users.pushEnd()
class ToLine extends Transform<User, string> {
  constructor() {
    super({ writableObjectMode: true, encoding: "utf8" })
  }
  onTransform(user, encoding, callback) {
    callback(undefined, `${user.name}:${user.age}\n`)
  }
}
const toLine = new ToLine()
const lines: string[] = []
class Sink extends Writable<string> {
  constructor() {
    super({ decodeStrings: false })
  }
  onWrite(chunk, encoding, callback) {
    lines.push(chunk)
    callback()
  }
}
const sink = new Sink()
const piped = await pipeline(users, toLine, sink)
log(`lines ${piped.isOk()} ${JSON.stringify(lines)}`)

const r2 = Readable.from(["a", "b", "c"])
log(`text ${(await text(r2)).unwrapOr("?")}`)
const r3 = Readable.from([Buffer.from('{"x": [1, 2'), Buffer.from("]}")])
const j = (await json(r3)).unwrapOr(null)
log(`json ${JSON.stringify(j).unwrapOr("")}`)
const r4 = Readable.from(["héllo", " wörld"])
const b = (await buffer(r4)).unwrapOr(Buffer.alloc(0))
log(`buffer ${b.length} ${b.toString("hex")}`)
const sunk = await pipeline(
  Readable.from(["x", "y"]),
  async function* (source) {
    for await (const chunk of source) yield chunk.toUpperCase()
  },
  async function (source) {
    for await (const chunk of source) log(`sink ${chunk}`)
  },
)
log(`done ${sunk.isOk()}`)

// The chunk types found from the program: what read() pushes, what
// transform() gives its callback, what write() is declared to take.
class Point {
  x: int
  y: int
  constructor(x: int, y: int) {
    this.x = x
    this.y = y
  }
}
let n = 0
type Total = { label: string; total: int }
class Points extends Readable<Point> {
  constructor() {
    super({ objectMode: true })
  }
  onRead() {
    n++
    if (n <= 3) this.push(new Point(n, n * n))
    else this.pushEnd()
  }
}
class Sum extends Transform<Point, Total> {
  constructor() {
    super({ objectMode: true })
  }
  onTransform(p, encoding, callback) {
    callback(undefined, { label: `p${p.x}`, total: p.x + p.y })
  }
}
class Totals extends Writable<Total> {
  constructor() {
    super({ objectMode: true })
  }
  onWrite(item, encoding, callback) {
    log(`${item.label} = ${item.total}`)
    callback()
  }
}
const points = new Points()
const sum = new Sum()
const totals = new Totals()
points.on("data", (p) => log(`point ${p.x},${p.y}`))
totals.on("finish", () => log("finish"))
const summed = await pipeline(points, sum, totals)
log(`summed ${summed.isOk()}`)
