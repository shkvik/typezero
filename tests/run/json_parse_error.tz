// same-as-node
// JSON.parse of a text that is not JSON gives an Err with the text of the
// SyntaxError node throws (docs/modules.md, section 5).
console.log(JSON.parse('{"ok": [1, 2]}'))
const text = '{\n  "a": 1\n  "b": 2\n}'
const r = JSON.parse(text)
if (r.isErr()) console.log(r.error)
console.log(JSON.parse("").match((j) => "parsed", (e) => `${e.code}: ${e.message}`))
