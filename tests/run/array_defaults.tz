// Where typezero differs from JavaScript: an array has no holes. new Array(n)
// and a longer length fill with the default of the element type (0, false,
// "", undefined); JavaScript would leave empty slots.
console.log(new Array<int>(3), new Array<boolean>(2), new Array<string>(2), new Array<int | undefined>(2))
const a = [1, 2, 3]
a.length = 5
console.log(a, a.length)
a.length = 1
console.log(a)
let n = 4
const sized: double[] = new Array(n)
console.log(sized, sized.length)
