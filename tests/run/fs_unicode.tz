// same-as-node
// Names of files in any language, and text in them: the system gets them in
// UTF-16 on Windows, so nothing depends on the code page.
import { readFileSync, writeFileSync, existsSync, mkdirSync, mkdtempSync, readdirSync, statSync,
         renameSync, rmSync } from "node:fs"
import { join } from "node:path"
import { tmpdir } from "node:os"

const dir = must(mkdtempSync(join(tmpdir(), "tz-юникод-")))
const folder = join(dir, "папка ✓")
must(mkdirSync(folder))
const names = ["файл.txt", "😀 smile.txt", "日本語.md", "Ελληνικά", "ß.txt"]
for (const name of names)
  must(writeFileSync(join(folder, name), `${name}: текст 😀\n`))
console.log(must(readdirSync(folder)).sort())
for (const name of names)
  console.log(existsSync(join(folder, name)), must(statSync(join(folder, name))).size,
              JSON.stringify(must(readFileSync(join(folder, name), "utf8"))))
must(renameSync(join(folder, "файл.txt"), join(folder, "переименован.txt")))
console.log(existsSync(join(folder, "файл.txt")), must(readFileSync(join(folder, "переименован.txt"), "utf8")))
const missing = readFileSync(join(folder, "нет такого.txt"), "utf8")
if (missing.isErr())
  console.log(missing.error.code, missing.error.path.replaceAll(dir, "D"))
must(rmSync(dir, { recursive: true }))
console.log(existsSync(dir))

function must<T, E>(r: Result<T, E>): T {
  if (r.isErr()) {
    console.log(r.error)
    process.exit(1)
  }
  return r.value
}
