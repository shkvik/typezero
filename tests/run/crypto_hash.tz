// same-as-node
import { createHash, createHmac, hash, getHashes } from "node:crypto"

// Every hash of the direct layer, by its name and by the aliases node takes.
const text = "The quick brown fox jumps over the lazy dog"
console.log(must(createHash("md5")).update(text).digest("hex"))
console.log(must(createHash("sha1")).update(text).digest("hex"))
console.log(must(createHash("sha224")).update(text).digest("hex"))
console.log(must(createHash("sha256")).update(text).digest("hex"))
console.log(must(createHash("sha384")).update(text).digest("hex"))
console.log(must(createHash("sha512")).update(text).digest("hex"))
console.log(must(createHash("sha512-224")).update(text).digest("hex"))
console.log(must(createHash("sha512-256")).update(text).digest("hex"))
console.log(must(createHash("sha3-224")).update(text).digest("hex"))
console.log(must(createHash("sha3-256")).update(text).digest("hex"))
console.log(must(createHash("sha3-384")).update(text).digest("hex"))
console.log(must(createHash("sha3-512")).update(text).digest("hex"))
console.log(must(createHash("shake128")).update(text).digest("hex"))
console.log(must(createHash("shake256")).update(text).digest("hex"))
console.log(must(createHash("shake128", { outputLength: 100 })).update(text).digest("hex"))
console.log(must(createHash("shake256", { outputLength: 3 })).update(text).digest("hex"))
console.log(must(createHash("ripemd160")).update(text).digest("hex"))
console.log(must(createHash("sm3")).update(text).digest("hex"))
console.log(must(createHash("md5-sha1")).update(text).digest("hex"))
console.log(must(createHash("blake2b512")).update(text).digest("hex"))
console.log(must(createHash("blake2s256")).update(text).digest("hex"))
console.log(must(createHash("SHA-256")).update(text).digest("hex"))
console.log(must(createHash("RSA-SHA256")).update(text).digest("hex"))
console.log(must(createHash("rmd160")).update(text).digest("hex"))
console.log(must(createHash("2.16.840.1.101.3.4.2.1")).update(text).digest("hex"))
console.log(must(createHash("SHA512-256")).update(text).digest("hex"))

// Encodings in and out, pieces, copies.
const h = must(createHash("sha256"))
h.update("68656c6c6f", "hex").update(" ").update(Buffer.from("world"))
const copy = h.copy()
console.log(h.digest("base64"), copy.update("!").digest("base64url"))
console.log(must(createHash("sha1")).update("").digest())
console.log(must(createHash("sha1")).update(new Uint8Array([1, 2, 3])).digest("latin1").length)
console.log(must(createHash("md5")).update("привет", "utf8").digest("hex"))
console.log(must(createHash("md5")).update("привет", "latin1").digest("hex"))
const big = "x".repeat(1000000)
console.log(must(createHash("sha256")).update(big).digest("hex"))
console.log(must(createHash("sha3-256")).update(big).digest("hex"))

// HMAC, with keys longer than the block.
console.log(must(createHmac("sha256", "key")).update(text).digest("hex"))
console.log(must(createHmac("sha512", "k".repeat(200))).update(text).digest("hex"))
console.log(must(createHmac("md5", Buffer.from("key"))).update(text).digest("base64"))
console.log(must(createHmac("sha3-256", "key")).update(text).digest("hex"))
console.log(must(createHmac("blake2b512", "key")).update(text).digest("hex"))
const mac = must(createHmac("sha1", "key"))
mac.update(text)
console.log(mac.digest("hex"))

// crypto.hash
console.log(must(hash("sha1", text)))
console.log(must(hash("md5", text, "base64")))
console.log(must(hash("sha256", Buffer.from(text), "buffer")).length)

// digest() leaves the hash open, as in Python and Go: more can be added and
// digested again (in node the second digest throws).
const again = must(createHash("sha256")).update("ab")
console.log(again.digest("hex") == again.digest("hex"),
            again.update("c").digest("hex") == must(createHash("sha256")).update("abc").digest("hex"))
console.log(h.update("x").digest("hex").length)
const names = getHashes()
console.log(names.length, names.includes("sha256"), names.includes("md4"))
console.log(names.join(","))

function must<T, E>(r: Result<T, E>): T {
  if (r.isErr()) {
    console.log(r.error)
    process.exit(1)
  }
  return r.value
}
