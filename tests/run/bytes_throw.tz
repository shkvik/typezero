// same-as-node
// The errors JavaScript throws when the program runs, with node's messages,
// which are still exceptions here: unknown encodings and a string that is
// not hex; and the Err of a fatal TextDecoder at bytes it cannot decode.
// Lengths and offsets are proven when the program is built instead
// (tests/errors/proofs.tz).
function attempt(what: string, f: () => void) {
  try {
    f()
    console.log(what, "ok")
  } catch (e) {
    console.log(what, e.name, e.message)
  }
}
const four = Buffer.alloc(4)
const encodings = ["hex", "nope", "x-mac-cyrillic", "utf-17"]
attempt("encoding", () => console.log(four.toString(encodings[1] ?? "")))
attempt("fill", () => console.log(four.fill("zz", "hex")))
attempt("label", () => console.log(new TextDecoder(encodings[3] ?? "")))
attempt("label old", () => console.log(new TextDecoder(encodings[2] ?? "").decode(new Uint8Array([0xc0, 0x80]))))
const decoded = [
  new TextDecoder("utf-8", { fatal: true }).decode(new Uint8Array([0x41, 0xff])),
  new TextDecoder("utf-16le", { fatal: true }).decode(new Uint8Array([0, 0xd8])),
  new TextDecoder("windows-1253", { fatal: true }).decode(new Uint8Array([0xaa])),
  new TextDecoder("utf-8", { fatal: true }).decode(new Uint8Array([0x41, 0x42])),
]
for (const text of decoded) console.log("fatal", text.isOk() ? text.value : `${text.error.code} ${text.error.message}`)
