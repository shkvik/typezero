// The other file of result_mix: functions that return Results, a generic
// alias of Result and an interface, all imported by main.tz.

export interface Order {
  name: string
  price: decimal
  qty: int
}

export type Parsed<T> = Result<T, string>

export function parseName(s: string): Parsed<string> {
  const name = s.trim()
  return name.length == 0 ? err("empty name") : ok(name)
}

// Digits with at most one point (decimal() takes "1e3" and "0x1f" too).
export function parsePrice(s: string): Parsed<decimal> {
  let points = 0
  for (const c of s) {
    if (c == ".") points++
    else if (c < "0" || c > "9") return err(`bad price '${s}'`)
  }
  if (s.length == 0 || points > 1) return err(`bad price '${s}'`)
  return decimal(s).mapErr(() => `bad price '${s}'`)
}

export function parseQty(s: string): Parsed<int> {
  const n = parseInt(s)
  return isNaN(n) || n <= 0 ? err(`bad quantity '${s}'`) : ok(n | 0)
}
