// same-as-node
// Semicolons are optional, as in TypeScript.
function seven(): int {
  return 7
}

function main(): void {
  let a = 1
  let b = 2;
  let c = a
    + b
  console.log(c)

  // A line break before `++` makes it apply to the next line.
  let d: int = 5
  d
  ++d
  console.log(d)

  console.log(seven());
}

main()
