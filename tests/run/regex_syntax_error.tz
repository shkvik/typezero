// same-as-node
// RegExp.parse(s) of a pattern that is not a regex gives an Err with the text
// of the SyntaxError node throws (docs/regex.md, section 1).
const patterns: string[] = ["a+", "[0-9]{2}", "a(b"]
for (const p of patterns) {
  const re = RegExp.parse(p, "i")
  console.log(re.isOk() ? re.value.test("A12") : re.error)
}
const flags = RegExp.parse("a", "gg")
if (flags.isErr()) console.log(flags.error.code, flags.error.message)
