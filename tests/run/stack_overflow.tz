// Recursion that runs out of stack ends the program (docs/errors.md, section 9):
// each thread has 1 GB of stack, and running out of it is fatal, with code 2.
// expect-exit: 2
// expect-stderr: panic: stack overflow
function grow(n: int): int {
  return n < 0 ? 0 : grow(n + 1) + grow(n + 2)
}
console.log("before")
console.log(grow(0))
