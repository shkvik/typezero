// same-as-node
// node:fs/promises: the functions of node:fs that wait on the thread pool
// and give a Promise, in a directory of the test's own under the temporary
// one, which it removes at the end.
import { readFile, writeFile, appendFile, mkdtemp, mkdir, readdir, stat, lstat, rm, rmdir,
         rename, copyFile, unlink, access, chmod, truncate, realpath, constants } from "node:fs/promises"
import { promises } from "node:fs"
import { join, basename, relative } from "node:path"
import { tmpdir } from "node:os"

const dir = must(await mkdtemp(join(tmpdir(), "tz-fsp-")))
console.log(basename(dir).length, (must(await stat(dir))).isDirectory())

// Text in and out, with the encoding and the flags.
const notes = join(dir, "notes.txt")
must(await writeFile(notes, "first\n"))
must(await appendFile(notes, "second\n"))
must(await writeFile(notes, "third\n", { flag: "a" }))
console.log(JSON.stringify(must(await readFile(notes, "utf8"))), (must(await readFile(notes, { encoding: "utf-8" }))).length)
must(await writeFile(notes, "заменён", "utf8"))
console.log(must(await readFile(notes, { encoding: "utf8", flag: "r" })))
must(await truncate(notes, 4))
console.log(JSON.stringify(must(await promises.readFile(notes, "utf8"))))

// Directories, and what is in them: recursive readdir goes as Node's async
// one does, deeper directories after the entries of their parent.
console.log(must(await mkdir(join(dir, "a"))), basename((must(await mkdir(join(dir, "a", "b", "c"), { recursive: true }))) ?? "none"))
console.log(must(await mkdir(join(dir, "a"), { recursive: true })))
must(await writeFile(join(dir, "a", "f1.txt"), "1"))
must(await writeFile(join(dir, "a", "b", "f2.txt"), "22"))
must(await mkdir(join(dir, "x")))
must(await writeFile(join(dir, "x", "f3.txt"), "333"))
console.log(must(await readdir(dir)))
console.log(must(await readdir(dir, { recursive: true })))
for (const e of must(await readdir(dir, { withFileTypes: true, recursive: true })))
  console.log(e.name, relative(dir, e.parentPath), e.isFile(), e.isDirectory())

// What stat tells.
const st = must(await stat(join(dir, "x", "f3.txt")))
console.log(st.isFile(), st.size, st.mtimeMs > 0, (must(await lstat(dir))).isDirectory())

// Moving, copying, permissions and deleting.
must(await rename(join(dir, "x", "f3.txt"), join(dir, "moved.txt")))
must(await copyFile(join(dir, "moved.txt"), join(dir, "copy.txt")))
must(await copyFile(join(dir, "moved.txt"), join(dir, "copy.txt"), constants.COPYFILE_FICLONE))
must(await access(join(dir, "copy.txt")))
console.log(must(await readFile(join(dir, "copy.txt"), "utf8")))
must(await chmod(join(dir, "copy.txt"), 0o444))
must(await chmod(join(dir, "copy.txt"), "644"))
must(await unlink(join(dir, "copy.txt")))
must(await rmdir(join(dir, "x")))
console.log(must(await readdir(dir)))
console.log((must(await realpath(dir))).toLowerCase() == dir.toLowerCase())

// Many at once: each waits on the pool, and Promise.all keeps their order.
const names: string[] = []
for (let i = 0; i < 20; i++) names.push(join(dir, `n${i}.txt`))
await Promise.all(names.map((name, i) => writeFile(name, "x".repeat(i))))
const sizes = await Promise.all(names.map(async (name) => (must(await readFile(name, "utf8"))).length))
console.log(sizes.join(","))

must(await rm(dir, { recursive: true }))
must(await rm(dir, { recursive: true, force: true }))
console.log("removed")

function must<T, E>(r: Result<T, E>): T {
  if (r.isErr()) {
    console.log(r.error)
    process.exit(1)
  }
  return r.value
}
