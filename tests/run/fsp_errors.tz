// same-as-node
// What fails in node:fs/promises gives a Promise of the Err node:fs gives for
// the same. The directory of the test shows as D.
import { readFile, writeFile, appendFile, mkdir, mkdtemp, readdir, stat, lstat, rm, rmdir,
         rename, copyFile, unlink, access, chmod, truncate, realpath } from "node:fs/promises"
import { join } from "node:path"
import { tmpdir } from "node:os"

const dir = must(await mkdtemp(join(tmpdir(), "tz-fsp-errors-")))
const file = join(dir, "file.txt")
const sub = join(dir, "sub")
const missing = join(dir, "missing")
must(await writeFile(file, "text"))
must(await mkdir(sub))
must(await writeFile(join(sub, "inside.txt"), "inside"))

async function show<T>(what: string, p: Promise<Result<T, SystemError>>) {
  const r = await p
  if (r.isOk()) {
    console.log(what, "-> no error")
    return
  }
  const e = r.error
  if (e.code == "ERR_INVALID_ARG_VALUE")
    console.log(what, "->", e.code, "|", e.message)
  else
    console.log(what, "->", e.code, e.errno, e.syscall, (e.path ?? "-").replaceAll(dir, "D"),
                (e.dest ?? "-").replaceAll(dir, "D"), "|", e.message.replaceAll(dir, "D"))
}

await show("read missing", readFile(missing, "utf8"))
await show("read directory", readFile(sub, "utf8"))
await show("read zero char", readFile("a\u0000b", "utf8"))
await show("write missing dir", writeFile(join(missing, "x.txt"), "x"))
await show("write exclusive", writeFile(file, "x", { flag: "wx" }))
await show("append missing dir", appendFile(join(missing, "x.txt"), "x"))
await show("mkdir existing", mkdir(sub))
await show("mkdir missing parent", mkdir(join(missing, "a")))
await show("mkdir under file", mkdir(join(file, "a", "b"), { recursive: true }))
await show("mkdtemp missing", mkdtemp(join(missing, "t-")))
await show("rmdir not empty", rmdir(sub))
await show("rmdir missing", rmdir(missing))
await show("unlink directory", unlink(sub))
await show("unlink missing", unlink(missing))
await show("rm directory", rm(sub))
await show("rm missing", rm(missing))
await show("rename missing", rename(missing, join(dir, "other")))
await show("copy missing", copyFile(missing, join(dir, "other")))
await show("readdir file", readdir(file))
await show("readdir missing", readdir(missing))
await show("stat missing", stat(missing))
await show("lstat missing", lstat(missing))
await show("realpath missing", realpath(join(missing, "deeper")))
await show("access missing", access(missing))
await show("chmod missing", chmod(missing, 0o644))
await show("truncate missing", truncate(missing))

// Not awaited at once: the Err waits in the Promise until it is.
const later = readFile(missing, "utf8")
await show("awaited later", later)

must(await rm(dir, { recursive: true }))
console.log("done")

function must<T, E>(r: Result<T, E>): T {
  if (r.isErr()) {
    console.log(r.error)
    process.exit(1)
  }
  return r.value
}
