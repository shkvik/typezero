// same-as-node
// Each file imports what it uses of the built-in modules, under its own
// names.
import { existsSync as exists, mkdtempSync, rmSync } from "node:fs"
import { join } from "node:path"
import { tmpdir } from "node:os"
import { saveNote, readNote } from "./notes.tz"

const dir = must(mkdtempSync(join(tmpdir(), "tz-notes-")))
const file = saveNote(dir, "today", "купить хлеб")
console.log(exists(file), readNote(file))
must(rmSync(dir, { recursive: true }))
console.log(exists(dir))

function must<T, E>(r: Result<T, E>): T {
  if (r.isErr()) {
    console.log(r.error)
    process.exit(1)
  }
  return r.value
}
