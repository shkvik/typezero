// same-as-node --experimental-transform-types
// A string enum as a type is the union of its values: Record over it is an object with a
// field per member, a key of the enum type reads and writes those fields, Object.values
// lists the members, and a switch over all members is complete.
enum Resource {
  Wood = "wood",
  Brick = "brick",
  Ore = "ore",
}
enum Size {
  Base = "base",
  Large = "large",
}
type Counts = Partial<Record<Resource, int>>

const seats: Record<Size, int> = { base: 4, large: 6 }
const most: int = seats[Size.Large]

function price(r: Resource): int {
  switch (r) {
    case Resource.Wood:
      return 1
    case Resource.Brick:
      return 2
    case Resource.Ore:
      return 3
  }
}

function add(hand: Counts, r: Resource, n: int): void {
  hand[r] = (hand[r] ?? 0) + n
}

function total(hand: Counts): int {
  let sum = 0
  for (const r of Object.values(Resource)) {
    sum += (hand[r] ?? 0) * price(r)
  }
  return sum
}

function loot(card: Resource): Counts {
  const one = { [card]: 1 }
  return one
}

const hand: Counts = { wood: 2 }
add(hand, Resource.Ore, 3)
add(hand, Resource.Wood, 1)
let current = Resource.Brick
current = Resource.Ore
const text: string = current
console.log(most, hand, total(hand), loot(Resource.Brick), text, `${current}!`)
console.log(Object.keys(Resource), Object.entries(Resource))
console.log(Object.values(Resource).includes(current), JSON.stringify({ hand, current }))
const cost: Counts = { [Resource.Wood]: 1, [Resource.Brick]: 1 }
console.log(cost, current == "ore", price(current))
