// The other file of json_mix: a class that keeps a Json in a field, settings
// checked by a function and made with a literal, and a parser that returns
// Results.
export interface Settings {
  name: string
  limit: int
  price: decimal
  tags: string[]
  note?: string
}

export class Store {
  data: Json
  constructor(text: string) {
    this.data = JSON.parse(text).unwrapOr(null)
  }
  // The names of the users that have one, from whatever the file holds.
  names(): string[] {
    const users = this.data.users
    const names: string[] = []
    if (users != undefined && Array.isArray(users))
      for (const user of users.values().filter(u => u != null)) {
        const name = user.name
        if (typeof name == "string") names.push(name)
      }
    return names
  }
}

export function readSettings(text: string): Result<Settings, string> {
  const parsed = JSON.parse(text)
  if (parsed.isErr()) return err(parsed.error.message)
  const json = parsed.value
  if (json == null || typeof json != "object" || Array.isArray(json))
    return err("settings must be an object")
  if (!isSettingsJson(json)) return err("settings need a name, a limit, a price and tags")
  const tags: string[] = []
  for (const tag of json.tags) if (typeof tag == "string") tags.push(tag)
  const price = decimal(String(json.price))
  if (price.isErr()) return err(price.error.message)
  const limit = json.limit
  if (!(limit >= 0 && limit <= 1000000)) return err("limit: from 0 to 1000000")
  const note = json.note
  const settings: Settings = {
    name: json.name,
    limit: Math.trunc(limit).toInt(),
    price: price.value,
    tags: tags,
    note: typeof note == "string" ? note : undefined,
  }
  return ok(settings)
}

function isSettingsJson(json: Json): boolean {
  return typeof json.name == "string" && typeof json.limit == "number" &&
    Number.isInteger(json.limit) &&
    typeof json.price == "number" && Array.isArray(json.tags)
}
