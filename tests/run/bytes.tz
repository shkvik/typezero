// same-as-node
// Typed arrays, ArrayBuffer and DataView: making them, reading and writing
// elements, the methods of arrays, printing as node prints them.
const u = new Uint8Array([5, 1, 4, 2, 3])
console.log(u.subarray(-2), u.subarray(1, -1), u.slice(-3, -1), u.subarray(4, 2), u.at(-1), u.at(9))
const f = new Float64Array([3, NaN, -0, 0, -1, Infinity])
console.log(f.slice().sort(), f.indexOf(NaN), f.includes(NaN), f.indexOf(0), f.lastIndexOf(-0), f.join("|"), String(new Float32Array([0.1, 1e21])))
console.log(new Uint8Array([1, 2, 3, 4, 5]).copyWithin(0, 3), new Uint8Array([1, 2, 3, 4, 5]).copyWithin(1, 0, 3), new Uint8Array([1, 2, 3, 4, 5]).copyWithin(-2, 0))
const s = new Uint8Array([1, 2, 3, 4, 5])
s.set(s.subarray(0, 3), 2)
console.log(s)
const t = new Uint8Array([1, 2, 3, 4, 5])
t.set([9, 8])
t.set(new Uint8Array([7]), 4)
console.log(t)
console.log(u.with(-1, 9), u.toReversed(), u.toSorted(), u.toSorted((a, b) => b - a), u)
console.log(new Float16Array([1.0009765625, 65520, 0.1, 70000]), new Float32Array([16777217]), new Int8Array([127]).fill(-128))
console.log(new Uint8ClampedArray([1, 2, -3, 300]))
console.log(new Uint8Array(new Uint8ClampedArray([1, 255])), new Int16Array(new Int8Array([-1])))
const b16 = new Uint16Array(new Uint8Array([1, 2, 3, 4]).buffer)
console.log(b16, new Uint8Array(b16.buffer, 1, 2), b16.byteLength, b16.byteOffset, Uint16Array.BYTES_PER_ELEMENT, b16.BYTES_PER_ELEMENT)
console.log(new ArrayBuffer(8).slice(2, -2).byteLength, ArrayBuffer.isView(u), ArrayBuffer.isView(new ArrayBuffer(1)), new DataView(new ArrayBuffer(2)).byteLength)
const dv = new DataView(new ArrayBuffer(8))
dv.setUint16(0, 0x1234)
dv.setUint16(2, 0x1234, true)
dv.setFloat32(4, 1.5)
console.log(dv.getUint8(0), dv.getUint16(0, true), dv.getInt32(0), dv.getFloat32(4), dv.getFloat16(4), new Uint8Array(dv.buffer))
console.log([...u], Array.from(u), Array.from(u, x => x * 2), u.map(x => x & 0x7f), u.filter(x => x > 2), u.reduce((a, b) => a + b), u.find(x => x > 3), u.findIndex(x => x > 3), u.some(x => x > 4), u.every(x => x > 0))
console.log(Uint8Array.from([1, 2, 3]), Uint8Array.of(1, 2, 255))
for (const x of new Int16Array([-1, 2])) console.log(x)
console.log(u.toString(), u.join(), u.join(""), `${new Float32Array([1.5])}`)
const big = new Uint8Array(8)
console.log(big[10], big[-1], big.length)
console.log(new Uint8Array(3).fill(7, 1), new Uint8Array([3, 1, 2]).sort((a, b) => a - b), new Uint8Array([10, 9, 1]).sort())
console.log(new Float64Array([0.1 + 0.2]), new Float32Array(2).fill(0.1))
console.log(JSON.stringify(new Uint8Array([1, 2])), JSON.stringify({ b: new ArrayBuffer(2), u: new Int8Array([-1]) }))
console.log(new ArrayBuffer(4), new DataView(new ArrayBuffer(4), 1))
console.log(new Uint32Array([4294967295]), new Int8Array([-56]), new Uint32Array([1])[0] + 1)
