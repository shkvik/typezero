// same-as-node
// env: NODE_EXTRA_CA_CERTS=@TESTS@/tls/ca.pem
// env: TLS_DIR=@TESTS@/tls
// https whose server does not check out (docs/net.md, step 4), as node
// tells: expired, not yet valid, for another name, signed by itself, by a CA
// nobody trusts (alone, with an intermediate, with that CA sent along), and
// then the one that is fine. fetch fails with the reason as its cause.
import { Server } from "tz:http"
import { readFileSync } from "node:fs"
import { join } from "node:path"

const dir = process.env.TLS_DIR ?? "."
const key = must(readFileSync(join(dir, "key.pem"), "utf8"))
for (const name of ["expired", "future", "wrongname", "self", "other", "chain", "rooted", "localhost"]) {
  const cert = must(readFileSync(join(dir, `${name}.pem`), "utf8"))
  const server = new Server({ port: 0, hostname: "127.0.0.1", transport: { secure: true, cert, key } }, () => new Response("ok"))
  const started = server.listen()
  if (started.isErr()) {
    console.log("cannot listen:", started.error.message)
    process.exit(1)
  }
  const listening = started.value
  const res = await fetch(`https://localhost:${listening.port}/`)
  if (res.isOk()) console.log(name, res.value.status, must(await res.value.text()))
  else console.log(name, res.error.kind, res.error.code, res.error.message)
  await listening.stop()
}

function must<T, E>(r: Result<T, E>): T {
  if (r.isErr()) {
    console.log(r.error)
    process.exit(1)
  }
  return r.value
}
