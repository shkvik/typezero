// What a ReadableStream does where the WHATWG standard throws a TypeError
// (docs/errors.md, step 5): a second reader of a locked stream gives an Err
// at each read, a released reader too; cancel() of a locked stream does
// nothing. The Err of a wrong read is a ReaderError of kind USED (docs/net.md,
// section 3). enqueue() or close() after close() breaks the stream: its
// reader gets ControllerClosedError instead of what was left; after the end
// there is no one to tell.
const s = new ReadableStream<int, never>({
  start: c => {
    c.enqueue(1)
    c.enqueue(2)
  },
})
const first = s.getReader()
const second = s.getReader()
const late = await second.read()
console.log(late.isErr() ? `${late.error.kind} ${late.error.code}: ${late.error.message}` : "read")
await s.cancel("ignored")
const r = await first.read()
console.log(r.isOk() && !r.value.done ? r.value.value : "none")
first.releaseLock()
const released = await first.read()
console.log(released.isErr() ? `${released.error.code}: ${released.error.message}` : "read")

async function readAll(stream: ReadableStream<int, never>) {
  const got: string[] = []
  for await (const n of stream) {
    if (n.isErr()) {
      got.push(`${n.error.kind} ${n.error.code}: ${n.error.message}`)
      break
    }
    got.push(`${n.value}`)
  }

  return got.length == 0 ? "nothing" : got.join(", ")
}
console.log(await readAll(new ReadableStream<int, never>({
  start: c => {
    c.enqueue(1)
    c.close()
    c.enqueue(2)
  },
})))
console.log(await readAll(new ReadableStream<int, never>({
  start: c => {
    c.enqueue(1)
    c.close()
    c.close()
  },
})))
console.log(await readAll(new ReadableStream<int, never>({
  start: c => {
    c.close()
    c.enqueue(3)
  },
})))
