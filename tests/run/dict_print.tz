// same-as-node
// Printing dictionaries and their iterators, as node does.
const m = new Map([["a", 1], ["b", 2]])
const it = m.keys()
console.log(it)
it.next()
console.log(it)
it.next()
console.log(it)
it.next()
console.log(it)
console.log(m.entries(), m.values())
const s = new Set([1, 2])
console.log(s.values(), s.entries(), s.keys())
const e = s.entries()
e.next()
e.next()
console.log(e)
console.log([m.keys()])
console.log({ a: { b: { c: m.keys() } } })
console.log(new Map<string, int>(), new Set<int>(), {})
console.log({ a: { b: { c: new Map([[1, 2]]), d: new Set([1]), e: { x: 1 } } } })
const big = new Map<int, int>()
for (let i = 0; i < 120; i++) big.set(i, i)
console.log(big)
const thirty = new Set<int>()
for (let i = 0; i < 30; i++) thirty.add(i)
console.log(thirty)
interface Deep { x: Map<int, int>[] }
const deep = new Map<string, Deep>([["a", { x: [new Map([[1, 2]])] }]])
console.log(deep)
const r: Record<string, int> = { "a-b": 1, b: 2, __proto__x: 3 }
console.log(r)
console.log(new Map([["aaaaaaaaaaaaaaaaaaaaa", 1], ["bbbbbbbbbbbbbbbbbbbbbbbbb", 2], ["ccccccccccccccccccccccc", 3]]))
const bigSet = new Set<int>()
for (let i = 0; i < 105; i++) bigSet.add(i * 2)
console.log(bigSet.values())
console.log(new Map([["x", new Set(["y"])]]), [new Set<string>()])
const strings = new Map([["it's", "a \"quote\""]])
console.log(strings, new Set(["line\nbreak"]))
