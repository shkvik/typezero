// JSON.parse<T> of a JSON that does not fit T gives an Err that names the
// path of the value (docs/narrowing.md, section 3).
type Order = { items: { price: decimal; count: int }[] }
const good = JSON.parse<Order>('{"items": [{"price": 1.5, "count": 2}]}')
console.log(good)
const bad = JSON.parse<Order>('{"items": [{"price": 1.5, "count": 2}, {"price": "2", "count": 1}]}')
console.log(bad)
if (bad.isErr()) console.log(`${bad.error.path}: ${bad.error.message}`)
const short = JSON.parse<Order>('{"items": [{"price": 1.5}]}')
console.log(short.isErr() ? short.error : "parsed")
