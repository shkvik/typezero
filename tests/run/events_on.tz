// same-as-node
// on() of node:events in 'for await': the events that come before the loop waits
// wait in a queue, each in a Result; an event named in 'close' ends it, an
// 'error' event and an abort end it after an Err, and 'break' too; each removes
// the listeners. once() with a timeout.
import { EventEmitter, on, once } from "node:events"
const log = (s: string) => console.log(s)
const bus = new EventEmitter<{ data: [n: int, label: string]; end: []; error: [err: Error] }>()
const it = on(bus, "data", { close: ["end"] })
bus.emit("data", 1, "one")
bus.emit("data", 2, "two")
setTimeout(() => {
  bus.emit("data", 3, "three")
  bus.emit("end")
}, 5)
for await (const event of it) {
  if (event.isErr()) break
  const [n, label] = event.value
  log(`${n} ${label}`)
}
log(`listeners after: ${bus.listenerCount("data")} ${bus.listenerCount("end")}`)

// an error ends it, after the events before it
const errs = on(bus, "data")
setTimeout(() => {
  bus.emit("data", 4, "four")
  bus.emit("error", new Error("boom"))
}, 5)
for await (const event of errs) {
  if (event.isErr()) log(`error ${event.error.message}`)
  else log(`got ${event.value[0]}`)
}
log(`listeners after error: ${bus.listenerCount("data")} ${bus.listenerCount("error")}`)

// break removes the listeners
setTimeout(() => bus.emit("data", 5, "five"), 5)
for await (const event of on(bus, "data")) {
  if (event.isOk()) log(`first ${event.value[0]}`)
  break
}
log(`listeners after break: ${bus.listenerCount("data")}`)

// a signal ends it with an AbortError
const ac = new AbortController()
setTimeout(() => ac.abort(), 5)
for await (const event of on(bus, "data", { signal: ac.signal })) {
  if (event.isErr()) log(`aborted: ${event.error.name}`)
  else log(`never ${event.value[0]}`)
}
// once with a timeout signal
const alive = setTimeout(() => log("kept alive"), 50)
const ended = await once(bus, "end", { signal: AbortSignal.timeout(5) })
if (ended.isErr()) {
  const cause = ended.error.cause
  log(`once: ${ended.error.name} ${cause instanceof Error ? cause.name : "-"}`)
}
clearTimeout(alive)
