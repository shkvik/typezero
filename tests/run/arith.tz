// Integer arithmetic wraps around on overflow at run time (in constants it is
// an error, see errors/constants.tz).
let big: int = 9223372036854775807
// expect-warning: 'big + 1' may overflow int: it may reach 9223372036854775808
console.log(big + 1)
let small: int = -9223372036854775808
console.log(small - 1)

// Integer division truncates; the remainder takes the sign of the dividend.
console.log(7 / 2, -7 / 2, 7 % 3, -7 % 3)
let min: int = -9223372036854775808
let minusOne: int = -1
// expect-warning: 'min / minusOne' may overflow int
console.log(min / minusOne, min % minusOne)

// Literals take the type the context expects.
let half: double = 1 / 2
console.log(half)
let wide: int = 2147483647 + 1
console.log(wide)

// int is 64 bits; it widens to double on its own.
let n: int = 10
let l: int = 3000000000
console.log(n + l)
let x: double = n * 1.5
console.log(x)

// Bitwise operators; shift counts are masked like in JavaScript.
console.log(6 & 3, 6 | 3, 6 ^ 3, ~5)
console.log(1 << 4, -16 >> 2, -16 >>> 28, 1 << 33)

// Compound assignment, increment and decrement.
let c: int = 5
c += 3
c -= 1
c *= 2
c /= 3
c %= 3
console.log(c)
let d: double = 1
d /= 4
console.log(d)
let i: int = 0
console.log(i++, i, ++i, i--, --i)
