// same-as-node
// Writable of node:stream (docs/streams.md): write() gives false at the
// highWaterMark and 'drain' comes when the writes are done, end() with a
// chunk, whose Promise of a Result comes when the stream finished, onFinal(),
// onWritev() of what cork() held (_final() and _writev() in node), a stream
// of strings (decodeStrings: false), and a write that fails.
import { Writable } from "node:stream"
const log = (s: string) => console.log(s)
class Slow extends Writable {
  constructor() {
    super({ highWaterMark: 5 })
  }
  onWrite(chunk, encoding, callback) {
    log(`_write ${chunk.toString()} ${encoding} len=${this.writableLength()}`)
    setTimeout(() => callback(), 1)
  }
  onFinal(callback) {
    log("_final")
    callback()
  }
}
class Batched extends Writable {
  onWrite(chunk, encoding, callback) {
    this.onWritev([{ chunk, encoding }], callback)
  }
  onWritev(chunks, callback) {
    log(`_writev ${chunks.map((c) => c.chunk.toString()).join("|")}`)
    process.nextTick(() => callback())
  }
}
class Strings extends Writable<string> {
  constructor() {
    super({ decodeStrings: false })
  }
  onWrite(chunk, enc, cb) {
    log(`string chunk ${typeof chunk} ${chunk} ${enc}`)
    cb()
  }
}
class Failing extends Writable {
  onWrite(chunk, enc, cb) {
    void chunk
    void enc
    cb({ message: "boom" })
  }
}
const w = new Slow()
w.on("error", (err) => log(`w error ${err.message}`))
w.on("drain", () => log("drain"))
w.on("prefinish", () => log("prefinish"))
w.on("finish", () => log(`finish finished=${w.writableFinished()}`))
w.on("close", () => {
  log("close")
  w.removeAllListeners()
  more()
})
log(`write1 ${w.write("abc")}`)
log(`write2 ${w.write("de", () => log("cb de"))}`)
log(`write3 ${w.write(Buffer.from("fgh"))}`)
log(`needDrain ${w.writableNeedDrain()} len ${w.writableLength()}`)
void w.end("end").then((r) => log(`end ${r.isOk()}`))
log(`ended ${w.writableEnded()}`)

function more() {
  const v = new Batched()
  v.cork()
  v.write("a")
  v.write("b")
  v.write("c", "latin1")
  process.nextTick(() => {
    log(`corked ${v.writableCorked()}`)
    v.uncork()
    v.write("d")
    void v.end().then((r) => log(`v end ${r.isOk()}`))
  })
  v.on("error", (err) => log(`v error ${err.message}`))
  v.on("finish", () => log("v finish"))
  const s = new Strings()
  s.write("hi")
  void s.end("there", "utf8").then((r) => log(`s end ${r.isOk()}`))
  const e = new Failing()
  e.on("error", (err) => log(`error ${err.message}`))
  e.on("close", () => {
    log("close e")
    e.removeAllListeners()
  })
  log(`write e ${e.write("x", (err) => log(`cb err ${err?.message}`))}`)
}
