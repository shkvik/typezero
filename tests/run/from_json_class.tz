// fromJson(cls, j): an object of a class from a Json, through its
// constructor (docs/narrowing.md, section 3; docs/decorators.md, section 6).
// The keys named as the parameters of the constructor are its arguments,
// each checked as fromJson<T> checks a field; then the public fields that
// code may write take the keys the Json has. Classes inside are made the
// same way; a class known only when the program runs, through its
// description.

class Address {
  constructor(public city: string, public zip?: string) {}
}
class Item {
  constructor(public name: string, public price: int) {}
}
class Order {
  notes: string[] = []
  status = "new"
  readonly kind = "order"
  private secret = 1
  constructor(public id: int, public to: Address, public items: Item[]) {}
  total() {
    let sum = 0
    for (const item of this.items) sum += item.price
    return sum
  }
  peek() {
    return this.secret
  }
}

const text =
  '{"id": 7, "to": {"city": "Oslo"}, "items": [{"name": "pen", "price": 110}, ' +
  '{"name": "ink", "price": 225}], "status": "paid", "kind": "x", "secret": 9, "extra": true}'
const order = must(fromJson(Order, must(JSON.parse(text))))
console.log(order, order.total(), order.peek())

// Back and forth: what JSON.stringify writes, fromJson makes again.
const again = must(fromJson(Order, must(JSON.parse(JSON.stringify(order)))))
console.log(again.items[1], again.status, again instanceof Order)

// What does not fit says where.
for (const bad of ['{"id": 1.5, "to": {"city": "x"}, "items": []}',
                   '{"id": 1, "to": {"zip": "1"}, "items": []}',
                   '{"id": 1, "to": {"city": "x"}, "items": [{"name": "a", "price": "1"}]}',
                   '{"id": 1, "to": {"city": "x"}, "items": [], "notes": [1]}',
                   '[]']) {
  const made = fromJson(Order, must(JSON.parse(bad)))
  if (made.isErr()) console.log(made.error.path, made.error.message)
}

// A class known only when the program runs.
const kinds: Constructor[] = [Address, Item]
for (const kind of kinds)
  console.log(must(fromJson(kind, must(JSON.parse('{"city": "Rome", "name": "cup", "price": 3}')))))

function must<T>(r: Result<T, JsonError>): T {
  if (r.isErr()) {
    console.log(r.error)
    process.exit(1)
  }
  return r.value
}
