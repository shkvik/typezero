// What main.tz runs: an emitter whose events come from the emits here and
// in main.tz, which reads files through node:fs/promises, and a generic
// function over any AsyncIterable.
import { EventEmitter } from "node:events"
import { readFile } from "node:fs/promises"

export class Jobs extends EventEmitter {
  started = 0

  async read(name: string, path: string) {
    this.started++
    this.emit("start", name)
    const text = await readFile(path, { encoding: "utf8" })
    if (text.isOk()) this.emit("done", name, text.value.trim().length)
    else this.emit("failed", name, text.error.code)
  }
}

export async function collect<T>(source: AsyncIterable<T>): Promise<T[]> {
  const out: T[] = []
  for await (const x of source) out.push(x)
  return out
}

function must<T, E>(r: Result<T, E>): T {
  if (r.isErr()) {
    console.log(r.error)
    process.exit(1)
  }
  return r.value
}
