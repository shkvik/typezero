// same-as-node
// AES-GCM, CBC and CTR and ChaCha20-Poly1305 of the direct layer. crypto_cipher_aesni and
// crypto_cipher_soft run the same with the CPU features OpenSSL may use turned off.
// createCipheriv, final() and getAuthTag() give a Result: a key or an IV of a
// wrong length, a tag that does not match and calls out of order are an Err.
import { createCipheriv, createDecipheriv } from "node:crypto"

const key = Buffer.alloc(32, 7)
const iv = Buffer.alloc(12, 9)
const text = "Сообщение, которое шифруют: " + "abc".repeat(30)

// AES-GCM, each length of key, in pieces and with AAD.
const gcm = must(createCipheriv("aes-256-gcm", key, iv))
gcm.setAAD(Buffer.from("header"))
const part1 = gcm.update(text.slice(0, 10), "utf8")
const part2 = gcm.update(text.slice(10), "utf8")
const last = must(gcm.final())
const sealed = Buffer.concat([part1, part2, last])
const tag = must(gcm.getAuthTag())
console.log(sealed.toString("hex"))
console.log(tag.toString("hex"), part1.length, part2.length, last.length)
const open = must(createDecipheriv("aes-256-gcm", key, iv))
open.setAAD(Buffer.from("header"))
open.setAuthTag(tag)
console.log(open.update(sealed, undefined, "utf8") + must(open.final("utf8")))

const g128 = must(createCipheriv("aes-128-gcm", key.subarray(0, 16), Buffer.alloc(16, 1), { authTagLength: 8 }))
console.log(g128.update("short", "utf8", "hex") + must(g128.final("hex")), must(g128.getAuthTag()).toString("hex"))
const g192 = must(createCipheriv("aes-192-gcm", key.subarray(0, 24), Buffer.alloc(7, 2)))
console.log(g192.update("x".repeat(1000), "utf8", "base64").length + must(g192.final("base64")).length,
            must(g192.getAuthTag()).toString("hex"))

const bad = must(createDecipheriv("aes-256-gcm", key, iv))
bad.setAuthTag(Buffer.alloc(16))
bad.update(sealed)
show(bad.final())

// CBC with padding, without it, and the pieces a decipher holds back.
const cbc = must(createCipheriv("aes-256-cbc", key, Buffer.alloc(16, 3)))
const c1 = cbc.update(text, "utf8", "hex") + must(cbc.final("hex"))
console.log(c1)
const dc = must(createDecipheriv("aes-256-cbc", key, Buffer.alloc(16, 3)))
const bytes = Buffer.from(c1, "hex")
const pieces = [dc.update(bytes.subarray(0, 16)), dc.update(bytes.subarray(16, 40)), dc.update(bytes.subarray(40))]
console.log(pieces.map(p => p.length).join(","), must(dc.final()).length)
const raw = must(createCipheriv("aes-128-cbc", key.subarray(0, 16), Buffer.alloc(16)))
raw.setAutoPadding(false)
console.log(raw.update(Buffer.alloc(32, 1)).toString("hex"), must(raw.final()).length)
const raw2 = must(createCipheriv("aes128", key.subarray(0, 16), Buffer.alloc(16)))
raw2.setAutoPadding(false)
raw2.update(Buffer.alloc(5))
show(raw2.final())
const wrong = must(createDecipheriv("aes-256-cbc", key, Buffer.alloc(16, 4)))
wrong.update(bytes)
show(wrong.final())

// CTR across pieces of any length.
const ctr = must(createCipheriv("aes-192-ctr", key.subarray(0, 24), Buffer.alloc(16, 0xff)))
const s1 = ctr.update("abc", "utf8", "hex")
const s2 = ctr.update("x".repeat(70), "utf8", "hex")
console.log(s1 + s2 + must(ctr.final("hex")))
const ctr2 = must(createDecipheriv("aes-192-ctr", key.subarray(0, 24), Buffer.alloc(16, 0xff)))
console.log(ctr2.update(s1 + s2, "hex", "utf8"))

// ChaCha20-Poly1305.
const cc = must(createCipheriv("chacha20-poly1305", key, iv, { authTagLength: 16 }))
cc.setAAD(Buffer.from("aad"))
const ccOut = Buffer.concat([cc.update(text, "utf8"), must(cc.final())])
console.log(ccOut.toString("base64"), must(cc.getAuthTag()).toString("hex"))
const cd = must(createDecipheriv("chacha20-poly1305", key, iv, { authTagLength: 16 }))
cd.setAAD(Buffer.from("aad"))
cd.setAuthTag(must(cc.getAuthTag()))
console.log(cd.update(ccOut).toString("utf8") == text)
show(cd.final())

// Errors of the arguments: createCipheriv gives an Err.
show(createCipheriv("aes-256-gcm", Buffer.alloc(31), iv))
show(createCipheriv("aes-256-cbc", key, iv))
show(createCipheriv("chacha20-poly1305", key, Buffer.alloc(8)))
// Errors of the order of calls: getAuthTag() before final() is an Err, and
// what goes wrong in setAAD, setAuthTag and update is the Err of the next
// final().
show(must(createCipheriv("aes-256-gcm", key, iv)).getAuthTag())
const aad = must(createCipheriv("aes-256-cbc", key, Buffer.alloc(16)))
aad.setAAD(Buffer.alloc(1))
show(aad.final())
const short = must(createDecipheriv("aes-256-gcm", key, iv))
short.setAuthTag(Buffer.alloc(3))
show(short.final())
const long = must(createDecipheriv("aes-256-gcm", key, iv, { authTagLength: 8 }))
long.setAuthTag(Buffer.alloc(16))
show(long.final())
const done = must(createCipheriv("aes-256-ctr", key, Buffer.alloc(16)))
show(done.final())
show(done.final())
console.log(done.update("x").length)

export const ciphered = true

function show<T>(r: Result<T, CryptoError>) {
  console.log(r.isErr() ? `${r.error.code} | ${r.error.message}` : "no error")
}

function must<T, E>(r: Result<T, E>): T {
  if (r.isErr()) {
    console.log(r.error)
    process.exit(1)
  }
  return r.value
}
