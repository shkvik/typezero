// A decimal divided by zero is fatal for now (JavaScript throws a RangeError
// for `1n / 0n`, BigNumber.js gives Infinity: a decimal has none); proofs of
// the divisor come with the numbers (docs/numbers.md).
// expect-exit: 2
// expect-stderr: panic: Division by zero
const prices: decimal[] = [10, 0]
let total: decimal = 0
for (const p of prices) {
  total += 1 / p
  console.log(total)
}
