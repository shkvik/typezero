// expect-exit: 2
// expect-stderr: panic: TypeError: Other.m was called with a 'this' that is not an instance of Other
// A decorated method that gives a Result: the Result goes up through its
// stub as from any method. The descriptor's first value checks the `this`
// it is called with, and another `this` is fatal (docs/errors.md, section 9).

function Check<A extends unknown[], R>(_cls: object, name: string, method: MethodDescriptor<A, R>) {
  const original = method.value
  method.value = function (this: unknown, ...args: A): R {
    console.log(`${name} with ${args.length} argument(s)`)
    return original.apply(this, args)
  }
}

class Box {
  constructor(public v: int) {}
  @Check
  times(n: int): Result<int, string> {
    if (n < 0) return err("negative")
    return ok(n * this.v)
  }
}

console.log(new Box(1).times(-1))
console.log(new Box(3).times(7))

// Calls the method's own code with another `this`.
function Steal<A extends unknown[], R>(_cls: object, _name: string, method: MethodDescriptor<A, R>) {
  const original = method.value
  method.value = function (this: unknown, ...args: A): R {
    return original.apply("not a box", args)
  }
}
class Other {
  @Steal
  m() {
    return 1
  }
}
console.log("before")
new Other().m()
console.log("not reached")
