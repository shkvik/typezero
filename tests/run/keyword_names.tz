type Range = { from: int; to: int }
function get(module: int, namespace: int): int {
  return module + namespace
}
async function load(declare: int): Promise<int> {
  return declare * 2
}
class Store {
  private readonly items: int[]
  public constructor() {
    this.items = []
  }
  public get(index: int): int {
    return this.items[index] ?? -1
  }
  public set(value: int): void {
    this.items.push(value)
  }
}

async function main(): Promise<void> {
  const from = 1
  let type = "a"
  type = "b"
  const of = [1, 2, 3]
  let sum = 0
  for (const item of of) {
    sum += item
  }
  for (const set of [4]) {
    sum += set
  }
  const async = (readonly: int) => readonly + 1
  const box: Range = { from, to: 5 }
  const { to } = box
  const start = ({ from }: Range) => from
  const store = new Store()
  store.set(get(from, 2))
  abstract: for (const x of of) {
    if (x > 1) {
      break abstract
    }
    sum += 10
  }
  const loaded = await load(3)
  console.log(from, type, sum, async(1), loaded, box.to, to, start(box), store.get(0))
}

await main()
