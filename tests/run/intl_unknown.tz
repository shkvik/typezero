// What Intl does with a currency, a unit, a numbering system or a collation
// that only the running program shows not to be one (docs/errors.md, step 5):
// JavaScript throws a RangeError, tz leaves the option out (a currency or a
// unit without one formats a plain number). A language and the options with a
// list of values are checked when the program is built: tests/errors/intl.tz,
// tests/errors/intl_values.tz; a language from the program comes from
// Intl.Locale.parse.
function v(s: string): string {
  return s
}
function n(x: number): number {
  return x
}
function t(f: () => string) {
  console.log(f())
}
t(() => new Intl.NumberFormat("en", { style: "currency", currency: v("US") }).format(1.5))
t(() => new Intl.NumberFormat("en", { style: "currency", currency: v("eur") }).format(1.5))
t(() => new Intl.NumberFormat("en", { style: "unit", unit: v("parsec") }).format(2))
t(() => new Intl.RelativeTimeFormat("en").format(n(3), "day"))
t(() => new Intl.NumberFormat("en", { style: "unit", unit: v("") }).resolvedOptions().style)
t(() => new Intl.NumberFormat("en", { numberingSystem: v("a") }).format(12))
t(() => new Intl.NumberFormat("en", { numberingSystem: v("bogus") }).resolvedOptions().numberingSystem)
t(() => new Intl.NumberFormat("en-u-nu-bogus").resolvedOptions().locale)
t(() => new Intl.NumberFormat("en-u-nu-arab").resolvedOptions().locale)
t(() => new Intl.NumberFormat("en-u-nu-arab", { numberingSystem: "arab" }).resolvedOptions().locale)
t(() => new Intl.NumberFormat("en-u-nu-arab", { numberingSystem: "thai" }).resolvedOptions().locale)
t(() => new Intl.NumberFormat("en-u-nu-arab", { numberingSystem: "thai" }).format(12))
t(() => `${new Intl.NumberFormat("en", { useGrouping: "true" }).resolvedOptions().useGrouping}`)
t(() => `${new Intl.NumberFormat("en", { useGrouping: true }).resolvedOptions().useGrouping}`)
t(() => `${new Intl.NumberFormat("en", { notation: "compact", useGrouping: "true" }).resolvedOptions().useGrouping}`)
t(() => new Intl.NumberFormat("en", { minimumIntegerDigits: 2.7 }).format(5))
t(() => new Intl.Collator("en", { collation: v("x") }).resolvedOptions().collation)
t(() => new Intl.Collator("en", { collation: v("phonebk") }).resolvedOptions().collation)
t(() => Intl.NumberFormat("en").format(1))
t(() => new Intl.NumberFormat("en", { style: "currency", currency: "usd", currencyDisplay: "name" }).format(1))
t(() => `${new Intl.NumberFormat("en", { style: "currency", currency: "JPY" }).resolvedOptions().maximumFractionDigits}`)
t(() => new Intl.NumberFormat("en", { style: "currency", currency: "XYZ" }).format(1))
t(() => new Intl.NumberFormat("en", { style: "unit", unit: "liter-per-kilometer", unitDisplay: "long" }).format(1))
t(() => new Intl.NumberFormat("en", { style: "currency", currency: "USD", currencySign: "accounting" }).format(-1))

function percent(x: number, locale: Intl.Locale): string {
  return x.toLocaleString(locale, { style: "percent" })
}
for (const tag of ["ru", "en_GB", "de"]) {
  const locale = Intl.Locale.parse(tag)
  if (locale.isErr()) console.log(`${locale.error.code}: ${locale.error.message} (${locale.error.tag})`)
  else console.log(percent(0.5, locale.value), locale.value.toString())
}
