// How fetch fails (docs/net.md, section 2): an Err of a FetchError whose
// kind says what to do (REQUEST — fix the code, NETWORK — try again,
// RESPONSE, TLS, REDIRECT, TIMEOUT), a closed code and a message that says
// what, where and why. A body that cannot be read is an Err with the errors
// of its method: TextError, JsonBodyError (with the start of a body that is
// not JSON), FormDataError.
// A request larger than maxBodySize gets 413; data: URLs need no network.
// A name that is not found may be EAI_AGAIN on a machine without a network.
// https is in tls_serve.tz and tls_errors.tz.
import { Server } from "tz:http"

async function attempt(what: string, url: string, init?: RequestInit) {
  const r = await fetch(url, init)
  if (r.isErr()) {
    const e = r.error
    const code = e.code == "EAI_AGAIN" ? "ENOTFOUND" : e.code
    console.log(what, e.kind, `${code}: ${e.message.replaceAll("DNS did not answer; check the network", "no such name in DNS")}`)
    return
  }
  const text = await r.value.text()
  if (text.isOk()) console.log(what, r.value.status, text.value)
  else console.log(what, text.error.kind, `${text.error.code}: ${text.error.message}`)
}

function advice(e: TextError): string {
  switch (e.kind) {
    case "BODY_ERROR_USED":
      return "fix the code"
    case "BODY_ERROR_NETWORK":
    case "BODY_ERROR_TIMEOUT":
      return "try again"
    case "BODY_ERROR_TOO_LARGE":
    case "BODY_ERROR_MALFORMED":
    case "BODY_ERROR_STREAM":
      return "bad body"
  }
}

await attempt("bad port", "http://localhost:6000/")
await attempt("ftp", "ftp://example.com/")
await attempt("no url", "not a url")
await attempt("credentials", "http://user:pw@localhost/")
await attempt("no host", "http://no-such-host.invalid/")
await attempt("data", "data:text/plain,hello%20world")
await attempt("base64", "data:;base64,aGk=")
await attempt("get with body", "http://localhost:8000/", { method: "GET", body: "x" })
await attempt("bad method", "http://localhost:8000/", { method: "TRACE" })
await attempt("no duplex", "http://localhost:8000/", {
  method: "POST",
  body: new ReadableStream({ start: c => { c.close() } }),
})

const corrupt = Buffer.from("not gzip at all")
const server = new Server({ port: 0, hostname: "127.0.0.1", maxBodySize: 10 }, async req => {
  const path = new URL(req.url).pathname()
  if (path == "/gzip") return new Response(corrupt, { headers: { "content-encoding": "gzip" } })
  if (path == "/html")
    return new Response("<html><title>502 Bad Gateway</title></html>", { headers: { "content-type": "text/html" } })
  if (path == "/bare") return new Response(Buffer.from("name=x"))
  const text = await req.text()
  return new Response(text.isOk() ? `${text.value.length} bytes` : text.error.message)
})
const started = server.listen()
if (started.isErr()) {
  console.log("cannot listen:", started.error.message)
  process.exit(1)
}
const listening = started.value
const base = `http://127.0.0.1:${listening.port}`
await attempt("small body", base, { method: "POST", body: "0123456789" })
await attempt("large body", base, { method: "POST", body: "0123456789!" })
const big = new ReadableStream({
  start: c => {
    c.enqueue(new TextEncoder().encode("0123456789"))
    c.enqueue(new TextEncoder().encode("!"))
    c.close()
  },
})
await attempt("large stream", base, { method: "POST", body: big, duplex: "half" })
await attempt("corrupt gzip", `${base}/gzip`)
const once = await fetch(base, { method: "POST", body: "once" })
if (once.isOk()) {
  const r = once.value
  console.log((await r.text()).unwrapOr("-"), r.bodyUsed())
  const again = await r.text()
  if (again.isErr()) console.log(again.error.kind, again.error.code, again.error.message, advice(again.error))
}
const html = await fetch(`${base}/html`)
if (html.isOk()) {
  const parsed = await html.value.json()
  if (parsed.isErr() && parsed.error.kind == "JSON_BODY_ERROR_CONTENT") {
    const e = parsed.error
    console.log("html", e.code, e.contentType, e.start)
  }
}
const bare = await fetch(`${base}/bare`)
if (bare.isOk()) {
  const form = await bare.value.formData()
  if (form.isErr() && form.error.kind == "FORM_DATA_ERROR_CONTENT") {
    const e = form.error
    console.log("bare", e.code, e.contentType ?? "no content-type", e.message)
  }
}
await listening.stop()
const gone = new Server({ port: 0, hostname: "127.0.0.1" }, () => new Response("")).listen()
if (gone.isOk()) {
  const port = gone.value.port
  await gone.value.stop()
  const refused = await fetch(`http://127.0.0.1:${port}/`)
  if (refused.isErr() && refused.error.kind == "FETCH_ERROR_NETWORK") {
    const e = refused.error
    console.log("refused", e.kind, e.code, e.message.replaceAll(String(port), "PORT"),
                e.syscall, e.host, e.port == port)
  }
}
