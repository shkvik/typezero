// env: NODE_EXTRA_CA_CERTS=@TESTS@/tls/ca.pem
// env: TLS_DIR=@TESTS@/tls
// https under load (docs/net.md, section 6): a server with TLS serves its
// connections on all the threads, as a plain one does. Many requests at once
// over HTTP/1.1 (a connection each) and over HTTP/2 (one connection), bodies
// bigger than a TLS record both ways, four rounds; every answer must come back
// whole, then the server stops.
import { readFileSync } from "node:fs"
import { join } from "node:path"
import { Handler, Listening, ListenError, Server } from "tz:http"

const dir = process.env.TLS_DIR ?? "."
const cert = readFileSync(join(dir, "localhost.pem"), "utf8")
const key = readFileSync(join(dir, "key.pem"), "utf8")
if (cert.isErr() || key.isErr()) process.exit(1)
const transport = { secure: true, cert: cert.value, key: key.value }

const handler: Handler = async (req) => {
  const url = new URL(req.url)
  if (url.pathname() == "/echo") {
    const text = await req.text()
    return new Response(text.isOk() ? String(text.value.length) : text.error.code)
  }
  const size = parseInt(url.pathname().slice(1)).unwrapOr(0)
  if (size < 0) return new Response("negative", { status: 400 })
  return new Response("x".repeat(size))
}

const sizes = [5, 20000, 100000]
const requests = 48
const rounds = 4

async function ask(base: string, i: int): Promise<string> {
  const size = sizes[i % sizes.length] ?? 0
  if (size < 0) return "negative"
  if (i % 2 == 1) {
    const sent = await fetch(`${base}/echo`, { method: "POST", body: "y".repeat(size) })
    if (sent.isErr()) return sent.error.code
    const text = await sent.value.text()
    if (text.isErr()) return text.error.code
    return text.value == String(size) ? sent.value.protocol : `echo ${text.value} for ${size}`
  }
  const sent = await fetch(`${base}/${size}`)
  if (sent.isErr()) return sent.error.code
  const text = await sent.value.text()
  if (text.isErr()) return text.error.code
  return text.value.length == size ? sent.value.protocol : `got ${text.value.length} for ${size}`
}

async function load(name: string, started: Result<Listening, ListenError>) {
  if (started.isErr()) {
    console.log("cannot listen:", started.error.message)
    process.exit(1)
  }
  const listening = started.value
  const base = `https://localhost:${listening.port}`
  const seen = new Map<string, int>()
  for (let round: int = 0; round < rounds; round++) {
    const asked: Promise<string>[] = []
    for (let i: int = 0; i < requests; i++) asked.push(ask(base, i))
    const answers = await Promise.all(asked)
    for (const answer of answers) seen.set(answer, (seen.get(answer) ?? 0) + 1)
  }
  for (const [answer, count] of seen) console.log(name, answer, count)
  await listening.stop()
}

await load("http/1.1 server:", new Server({ port: 0, hostname: "127.0.0.1", transport, http2: { enabled: false } }, handler).listen())
await load("h2 server:", new Server({ port: 0, hostname: "127.0.0.1", transport, http2: { enabled: true } }, handler).listen())
