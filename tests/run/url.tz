// same-as-node
// URL of the WHATWG URL Standard, a global as in node: parsing (special
// and other schemes, hosts as names, IPv4 in any of its forms and IPv6,
// paths with . and .., percent-encoding), relative URLs against a base,
// canParse and parse, the set methods (how a URL prints is in library_print.tz).
const inputs = [
  "https://user:pw@example.com:8080/a/b?x=1&y=2#frag",
  "http://EXAMPLE.com:80/./a/../b/%2e%2E/c",
  "http://[::1]:3000/x",
  "http://[2001:db8:0:0:1:0:0:1]/",
  "http://[::ffff:192.168.0.1]/",
  "http://0x7f.1/",
  "http://0300.0250.0.1/",
  "file:///C:/Users/x/../y.txt",
  "file://localhost/etc/hosts",
  "file:c:\a\b",
  "mailto:someone@example.com",
  "data:text/plain,hello world",
  "http://example.com/a b?c d#e f",
  "http://example.com/путь?запрос=значение#фрагмент",
  "http://пример.рф/",
  "http://ex%41mple.com/",
  "HTTP://example.COM",
  "http://a/b\c\d",
  "http://example.com:/x",
  "ws://h:80/",
  "wss://h:443/",
  "http://h/?a='b'&c=\"d\"",
  "non-spec://h/a b",
  "blob:https://a.com/uuid",
  "about:blank",
  "http://h/#a#b",
  "foo://",
]
for (const s of inputs) {
  const parsed = URL.parse(s)
  if (parsed.isErr()) continue
  const u = parsed.value
  console.log(u.href(), "|", u.origin(), "|", u.protocol(), u.username(), u.password(), u.host(), u.hostname(),
              u.port(), u.pathname(), u.search(), u.hash())
}
for (const s of ["http://h:65536/", "http://[::1/", "http://a b/", "http:///", "https://h:x/",
                 "http://192.168.0.257/", "nope"])
  console.log(s, URL.canParse(s), URL.parse(s).isErr())
const base = "http://base.com/dir/file?q#f"
for (const r of ["", "?x", "#y", "/abs", "../up", "//other.com/p", "./a/b", "http:foo"])
  console.log(JSON.stringify(r), URL.parse(r, base).map((u) => u.href()).unwrapOr("?"))
const baseUrl = URL.parse(base)
if (baseUrl.isOk())
  console.log(new URL("c", baseUrl.value).href(), URL.canParse("/x", "http://h"))
const bad = URL.parse("not a url")
if (bad.isErr()) console.log(bad.error.code, bad.error.message, bad.error.input)

// Plain addresses take a short way through the parser; whatever it does not
// know (a dot segment, a host that may be a number, a character to encode,
// upper case, a user) goes the long way, with the same result.
const near = [
  "https://example.com", "http://h:0080/x", "http://h:/", "ws://h:80/a", "wss://h:444/",
  "ftp://h:21/f", "https://a..b/", "https://.a/", "https://a.b./c", "http://a.1/", "http://a.1b/",
  "http://a.0x1/", "http://xn--p1ai/", "http://-a-.com/", "https://h/a/./b", "https://h/a/%2E%2e/b",
  "https://h/a/.%2e", "https://h/...", "https://h/.a", "https://h/a^b", "https://h/{x}`", "https://h/a\\b",
  "https://h/?'x'<", "https://h/#`x`", "https://h?x", "https://h#f", "https://h/?#", "https://h//a//b/",
  "https://EXAMPLE.com/", "Https://h/", "https://h/	a", "https://u@h/", "https://h:1x/",
  "https://h/%zz?%zz#%zz", "https:h/x", "https:///h/x",
]
for (const s of near) {
  const parsed = URL.parse(s)
  console.log(JSON.stringify(s), parsed.isOk() ? `${parsed.value.href()} ${parsed.value.host()} ${parsed.value.pathname()}` : "error")
}

// The parts change through methods; a literal is checked when the program is
// built, a text from a variable gives a Result.
const u = new URL("http://h/p?a=1#top")
u.setPathname("/new path")
u.setHash("end")
u.setPort("8080")
u.setHostname("other.org")
u.setUsername("me")
u.setPassword("s3cret")
console.log(u.href())
u.setProtocol("https")
u.setPort("443")
console.log(u.href(), u.port() == "", u.portNumber())
u.setHost("example.com:9000")
u.setSearch("q=1 2")
console.log(u.href())
u.setHref("http://reset.com/")
console.log(u.href(), u.toString(), u.toJSON(), JSON.stringify({ u: u.toJSON() }))
for (const port of ["81", "x81", ""]) {
  const set = u.setPort(port)
  console.log(set.isOk() ? "port " + u.port() : set.error.code + " " + set.error.input, u.host())
}
for (const text of ["http://a:8080/", "http://a/", "https://a:443/", "ftp://a:21/x", "http://a:0/"]) {
  const parsed = URL.parse(text)
  if (parsed.isOk()) {
    const port = parsed.value.portNumber()
    console.log(text, port, port == undefined ? "no port" : port + 1)
  }
}
u.setPort("9090")
console.log(u.portNumber())
const mail = new URL("mailto:a@b.c")
for (const host of ["example.com"]) {
  const refused = mail.setHost(host)
  console.log(refused.isErr() ? refused.error.code : "set", mail.href())
}
