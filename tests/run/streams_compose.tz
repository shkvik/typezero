// same-as-node
// A PassThrough where a Writable is expected (a Duplex is one), compose()
// of two Transforms, finished() of node:stream/promises and with a callback,
// and construct(), which the writes wait for.
import { PassThrough, Transform, Writable, compose, finished as finishedCb } from "node:stream"
import { finished } from "node:stream/promises"
const log = (s: string) => console.log(s)
function sinkInto(w: Writable, text: string) {
  w.write(text)
  return w.end()
}
const pt = new PassThrough()
pt.on("data", (c) => log(`pt ${c.toString()}`))
const sank = sinkInto(pt, "into a duplex")
const ptDone = await finished(pt)
log(`pt finished ${ptDone.isOk()} ${pt.writableFinished()} ${pt.readableEnded()} ${(await sank).isOk()}`)

class Upper extends Transform {
  onTransform(chunk, enc, cb) {
    cb(undefined, chunk.toString().toUpperCase())
  }
}
class Exclaim extends Transform {
  onTransform(chunk, enc, cb) {
    cb(undefined, `${chunk.toString()}!`)
  }
}
const upper = new Upper()
const exclaim = new Exclaim()
const both = compose(upper, exclaim)
both.on("data", (c) => log(`composed ${c.toString()}`))
both.write("hey")
const bothEnded = both.end()
const bothDone = await finished(both)
log(`composed done ${bothDone.isOk()} ${(await bothEnded).isOk()}`)

let constructed = false
class Constructed extends Writable {
  onConstruct(cb) {
    log("construct")
    setTimeout(() => {
      constructed = true
      cb()
    }, 1)
  }
  onWrite(chunk, enc, cb) {
    log(`write after construct ${constructed} ${chunk.toString()}`)
    cb()
  }
}
const c = new Constructed()
c.write("x")
const cEnded = c.end()
finishedCb(c, (err) => log(`c finished ${err == undefined}`))
log(`c ended ${(await cEnded).isOk()}`)
