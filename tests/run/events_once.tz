// same-as-node
// once(emitter, name) of node:events (docs/events.md, section 4): a Promise
// of a Result with the arguments of the next event, an Err when an 'error'
// event comes first; also of an EventTarget, where it is the arguments
// alone. getEventListeners() and
// listenerCount() of the module, and the same functions on EventEmitter.
import { EventEmitter, once, getEventListeners, listenerCount } from "node:events"

type Failure = { code: string; message: string }
const server = new EventEmitter<{ listening: [port: double, host: string]; error: [err: Failure]; done: [] }>()
setTimeout(() => server.emit("listening", 8080, "localhost"), 1)
const listening = await once(server, "listening")
if (listening.isOk()) {
  const [port, host] = listening.value
  console.log("listening", port, host, server.listenerCount("listening"), server.listenerCount("error"))
}

const failing = once(server, "done")
server.emit("error", { code: "E_BROKEN", message: "broken" })
const failed = await failing
if (failed.isErr()) console.log("error first:", failed.error.message)
setTimeout(() => server.emit("done"), 1)
const done = await once(server, "done")
console.log(done.isOk() ? done.value : "?")

const fired = once(server, "done")
server.emit("done")
const firedNow = await fired
console.log(firedNow.isOk() ? firedNow.value : "?", server.listenerCount("done"))

server.on("error", (e) => console.log("error", e.message))
server.on("done", () => {})
console.log(getEventListeners(server, "done").length, listenerCount(server, "done"))
console.log(EventEmitter.listenerCount(server, "done"))

// An EventTarget: the event, in an array.
const target = new EventTarget()
setTimeout(() => target.dispatchEvent(new Event("ping")), 1)
const [event] = await once(target, "ping")
console.log(event.type, getEventListeners(target, "ping").length)
