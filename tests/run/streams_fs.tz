// same-as-node
// fs.createReadStream() and fs.createWriteStream() (docs/streams.md, step
// 3): their events, chunks of highWaterMark, start and end, an encoding
// that gives strings, backpressure, the "a" flag, pipeline() from one file
// through a Transform to another, and a file that is not there; what waits
// for a stream gives a Result.
import { createReadStream, createWriteStream, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs"
import { join } from "node:path"
import { tmpdir } from "node:os"
import { Transform } from "node:stream"
import { finished, pipeline } from "node:stream/promises"
const dir = must(mkdtempSync(join(tmpdir(), "tz-streams-")))
const src = join(dir, "in.txt")
must(writeFileSync(src, "hello world\n".repeat(3)))

const events: string[] = []
const r = createReadStream(src, { highWaterMark: 16 })
r.on("open", (fd) => events.push(`open ${typeof fd}`))
r.on("ready", () => events.push("ready"))
r.on("data", (c) => events.push(`data ${c.length}`))
r.on("end", () => events.push("end"))
r.on("close", () => events.push("close"))
// tz: without an end, end is undefined, where node has Infinity, so it is not printed.
console.log(`pending ${r.pending()} hwm ${r.readableHighWaterMark()} flags ${r.flags}`)
const read = await finished(r)
console.log(read.isOk(), events.join(", "))
console.log(`bytesRead ${r.bytesRead()} destroyed ${r.destroyed()}`)

const slice = createReadStream(src, { encoding: "utf8", start: 6, end: 10 })
for await (const item of slice) {
  if (item.isErr()) break
  console.log(`slice ${JSON.stringify(item.value)} ${typeof item.value}`)
}
const latin = createReadStream(src, "latin1")
let text = ""
latin.on("data", (s) => (text += s))
const latinRead = await finished(latin)
console.log(`latin1 ${latinRead.isOk()} ${text.length}`)

const out = join(dir, "out.txt")
const w = createWriteStream(out, { highWaterMark: 8 })
console.log(`write ${w.write("12345")} ${w.write("67890")} needDrain ${w.writableNeedDrain()}`)
w.on("error", (e) => console.log(`w error ${e.message}`))
w.on("drain", () => console.log("drain"))
const written = await w.end("!")
console.log(`end ${written.isOk()} ${w.bytesWritten()}`)
console.log(`out ${JSON.stringify(must(readFileSync(out, "utf8")))}`)
const more = createWriteStream(out, { flags: "a" })
const appended = await more.end("appended")
console.log(`appended ${appended.isOk()} ${JSON.stringify(must(readFileSync(out, "utf8")))}`)

class Upper extends Transform {
  onTransform(chunk, enc, cb) {
    cb(undefined, chunk.toString().toUpperCase())
  }
}
const upper = new Upper()
const copy = join(dir, "copy.txt")
const copied = await pipeline(createReadStream(src), upper, createWriteStream(copy))
console.log(`copy ${copied.isOk()} ${JSON.stringify(must(readFileSync(copy, "utf8")))}`)

const missing = createReadStream(join(dir, "no-such-file.txt"))
const missed = await finished(missing)
console.log(`missing ${missed.isErr()}`)
must(rmSync(dir, { recursive: true }))

function must<T, E>(r: Result<T, E>): T {
  if (r.isErr()) {
    console.log(r.error)
    process.exit(1)
  }
  return r.value
}
