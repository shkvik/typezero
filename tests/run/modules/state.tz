console.log("state loads")
// A module has no `let`: what changes lives in an object the program makes.
export class State {
  public counter: int
  public readonly history: int[]

  constructor() {
    this.counter = 0
    this.history = []
  }

  public increment(): void {
    this.counter++
    this.history.push(this.counter)
  }
}
