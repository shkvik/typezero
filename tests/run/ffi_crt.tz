declare class Memory {}

declare function abs(value: int32): int32
declare function llabs(value: int): int
declare function sqrt(value: double): double
declare function malloc(size: uint64): Memory | undefined
declare function free(memory: Memory): void
declare function memset(buffer: Buffer, value: int32, size: uint64): void
declare function memcpy(to: Buffer, from: int32[], size: uint64): void
declare function GetCurrentProcessId(): uint32

console.log(abs(-5), llabs(-1234567890123), sqrt(2.25))
const memory = malloc(16)
if (memory != undefined) {
  console.log("allocated", memory)
  free(memory)
}
const filled = Buffer.alloc(4)
memset(filled, 7, 4)
console.log(filled)
const numbers: int32[] = [1, 2, 3]
const bytes = Buffer.alloc(12)
memcpy(bytes, numbers, 12)
console.log(bytes)
console.log(GetCurrentProcessId() > 0)
const first = malloc(8)
const second = malloc(8)
if (first != undefined && second != undefined) {
  const sizes = new Map<Memory, int>()
  sizes.set(first, 8)
  sizes.set(second, 16)
  const list: Memory[] = [first, second]
  console.log(sizes.get(second), list.indexOf(second))
  free(first)
  free(second)
}
