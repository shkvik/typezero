// expect-exit: 2
// expect-stderr: panic: Division by zero
// Division by zero is checked at run time and fatal for now, also where the
// divisor is only known to be zero after inlining and unrolling; proofs of
// the divisor come with the numbers (docs/numbers.md).
function divide(a: int, b: int): int {
  return a / b
}
for (let i = 3; i >= 0; i--) console.log("10 /", i, "=", divide(10, i))
console.log("after")
