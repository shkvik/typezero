// same-as-node
// Web Crypto: what node rejects when the program runs is an Err here (SubtleSignError and others), with a
// code of tz for node's DOMException (or TypeError of Web IDL), and node's message. The algorithms come from variables:
// written in the call, these would be errors of the compiler (tests/errors/webcrypto.tz).
const subtle = crypto.subtle
const enc = new TextEncoder()
async function attempt<T, E extends { code: string; message: string }>(what: string, made: Promise<Result<T, E>>) {
  const r = await made
  if (r.isOk()) console.log(what, "ok")
  else console.log(what, r.error.code, r.error.message)
}
const names = ["HMAC", "AES-XYZ", "aes-gcm"]
const hmac = must(await subtle.importKey("raw", enc.encode("k"), { name: "HMAC", hash: "SHA-256" }, false, ["verify"]))
const aes = must(await subtle.importKey("raw", new Uint8Array(16), "AES-GCM", true, ["encrypt"]))
const cbc = must(await subtle.importKey("raw", new Uint8Array(16), "AES-CBC", false, ["encrypt", "decrypt"]))
const pb = must(await subtle.importKey("raw", enc.encode("pw"), "PBKDF2", false, ["deriveKey"]))
await attempt("unknown name", subtle.digest(names[1] ?? "", new Uint8Array(1)))
await attempt("name case", subtle.importKey("raw", new Uint8Array(16), names[2] ?? "", false, ["encrypt"]))
await attempt("no usage", subtle.sign("HMAC", hmac, new Uint8Array(1)))
await attempt("wrong key", subtle.encrypt({ name: "AES-CBC", iv: new Uint8Array(16) }, aes, new Uint8Array(1)))
await attempt("cbc iv", subtle.encrypt({ name: "AES-CBC", iv: new Uint8Array(8) }, cbc, new Uint8Array(1)))
await attempt("gcm short", subtle.decrypt({ name: "AES-GCM", iv: new Uint8Array(12) }, cbc, new Uint8Array(4)))
await attempt("not extractable", subtle.exportKey("raw", hmac))
await attempt("bad der", subtle.importKey("spki", new Uint8Array(10), { name: "ECDSA", namedCurve: "P-256" }, true, ["verify"]))
await attempt("aes length", subtle.importKey("raw", new Uint8Array(10), "AES-GCM", true, ["encrypt"]))
await attempt("jwk alg", subtle.importKey("jwk", { kty: "oct", k: "AAAAAAAAAAAAAAAAAAAAAA", alg: "A256GCM" }, "AES-GCM", true, ["encrypt"]))
await attempt("jwk ext", subtle.importKey("jwk", { kty: "oct", k: "AAAAAAAAAAAAAAAAAAAAAA", ext: false }, "AES-GCM", true, ["encrypt"]))
await attempt("jwk ops", subtle.importKey("jwk", { kty: "oct", k: "AAAAAAAAAAAAAAAAAAAAAA", key_ops: ["decrypt"] }, "AES-GCM", false, ["encrypt"]))
await attempt("jwk kty", subtle.importKey("jwk", { kty: "EC", k: "AAAAAAAAAAAAAAAAAAAAAA" }, "AES-GCM", false, ["encrypt"]))
await attempt("jwk use", subtle.importKey("jwk", { kty: "oct", k: "AAAAAAAAAAAAAAAAAAAAAA", use: "sig" }, "AES-GCM", false, ["encrypt"]))
let alg = { name: "HMAC" }
await attempt("missing hash", subtle.importKey("raw", new Uint8Array(4), alg, false, ["sign"]))
await attempt("derive usage", subtle.deriveBits({ name: "PBKDF2", salt: new Uint8Array(1), iterations: 1, hash: "SHA-1" }, pb, 8))
await attempt("iterations", subtle.deriveKey({ name: "PBKDF2", salt: new Uint8Array(1), iterations: 0, hash: "SHA-1" }, pb, { name: "AES-GCM", length: 128 }, false, ["encrypt"]))
const pair = must(await subtle.generateKey({ name: "ECDH", namedCurve: "P-256" }, false, ["deriveBits"]))
await attempt("public of ecdh", subtle.deriveBits({ name: "ECDH", public: pair.privateKey }, pair.privateKey, 8))
await attempt("export pbkdf2", subtle.exportKey("raw", pb))
await attempt("spki of secret", subtle.exportKey("spki", aes))
await attempt("ecdh too long", subtle.deriveBits({ name: "ECDH", public: pair.publicKey }, pair.privateKey, 1024))
const ed = must(await subtle.generateKey("Ed25519", true, ["sign", "verify"]))
await attempt("raw private", subtle.exportKey("raw", ed.privateKey))
await attempt("ed raw len", subtle.importKey("raw", new Uint8Array(31), "Ed25519", true, ["verify"]))
await attempt("ok", subtle.importKey("raw", must(await subtle.exportKey("raw", ed.publicKey)), "Ed25519", true, ["verify"]))
const ctr = must(await subtle.importKey("raw", new Uint8Array(16), "AES-CTR", false, ["encrypt"]))
await attempt("ctr wraps", subtle.encrypt({ name: "AES-CTR", counter: new Uint8Array(16), length: 1 }, ctr, new Uint8Array(40)))
await attempt("ctr fits", subtle.encrypt({ name: "AES-CTR", counter: new Uint8Array(16), length: 1 }, ctr, new Uint8Array(32)))
const usages: KeyUsage[] = []
await attempt("no usages", subtle.importKey("raw", new Uint8Array(16), names[2] ?? "", false, usages))
await attempt("ecdh usage", subtle.generateKey({ name: "ECDH", namedCurve: "P-256" }, false, usages))
let rsa = { name: "RSASSA-PKCS1-v1_5", modulusLength: 1024, publicExponent: new Uint8Array([1, 0, 0, 0, 0, 1]), hash: "SHA-256" }
await attempt("exponent", subtle.generateKey(rsa, false, ["sign"]))

function must<T, E>(r: Result<T, E>): T {
  if (r.isErr()) {
    console.log(r.error)
    process.exit(1)
  }
  return r.value
}
