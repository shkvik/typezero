// same-as-node
// Numbers from strings give a Result (docs/numbers.md, section 9): parseInt an
// int of at most 64 bits, parseFloat and Number(s) a double; text that is no
// number, or a number beyond the type, is an Err. What JavaScript reads as a
// number, they read the same way.
function show<T>(r: Result<T, NumberError>): string {
  return r.isOk() ? `${r.value}` : "Err"
}
console.log(show(parseInt("42")), show(parseInt("  -17px")), show(parseInt("0x1F")), show(parseInt("ff", 16)), show(parseInt("0b11")), show(parseInt("11", 2)))
console.log(show(parseInt("z", 36)), show(parseInt("12", 1)), show(parseInt("12", 37)), show(parseInt("")), show(parseInt("-")), show(parseInt("3.9")))
console.log(show(parseInt("123456789012345678901234567890")), show(parseInt("9223372036854775808")), show(parseInt("-99999999999999999999")))
console.log(show(parseInt("0x")), show(parseInt("+8")), show(parseInt("  9")), show(parseInt("٣")))
console.log(show(parseFloat("3.14abc")), show(parseFloat(".5")), show(parseFloat("-.5e-3x")), show(parseFloat("1e")), show(parseFloat("1e+")), show(parseFloat("e5")))
console.log(show(parseFloat("Infinityx")), show(parseFloat("1e400")), show(parseFloat("0x10")), show(parseFloat("  2.5  ")), show(parseFloat(".")), show(parseFloat("-0")))
console.log(show(Number("42")), show(Number(" 4.5e1 ")), show(Number("")), show(Number("  ")), show(Number("0x1f")), show(Number("0b101")), show(Number("0o17")))
console.log(show(Number("12px")), show(Number("1_000")), show(Number("-0x10")), show(Number("Infinity")), show(Number("infinity")))
console.log(show(Number("+")), show(Number("-")), show(Number("+.")), show(Number("e1")), show(Number("1e")), show(parseFloat("+")), show(parseInt("-")))
console.log(show(Number(".5")), show(Number("5.")), show(Number(".")), show(Number("+1e3")), Number(true), Number(false), Number(7), Number())
const parsed = parseInt("x")
console.log(parsed.isErr() ? parsed.error.code : "", parseInt("17").unwrapOr(0))

const zero: double = 0
console.log(Number.isInteger(5), Number.isInteger(5.5), Number.isInteger(-zero))
console.log(Number.isSafeInteger(2.0 ** 53), Number.isSafeInteger(2.0 ** 53 - 1), Number.isSafeInteger(3.5), show(Number.parseFloat("1.5")), show(Number.parseInt("08")))
console.log(Number.MAX_SAFE_INTEGER, Number.MIN_SAFE_INTEGER, Number.EPSILON, Number.MAX_VALUE, Number.MIN_VALUE)

// toFixed rounds the exact value of the double, halves away from zero.
const values = [0, 1.5, 2.5, -2.5, 1.005, 1.45, 0.000001, 123.456, -0.0001, 1e20, 1e21, 0.5, 8.345]
for (const v of values) console.log(v, v.toFixed(), v.toFixed(2), v.toFixed(5))
const third = 1.0 / 3
console.log(third.toFixed(20), (2.0 ** 60).toFixed(3), (5e-324).toFixed(100).length)
const n: int = 7
console.log(n.toFixed(2), n.toString(), (-zero).toFixed(1))
