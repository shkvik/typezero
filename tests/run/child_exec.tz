// expect-stderr: to stderr
// execFileSync and execSync give a Result of what the program printed. When
// the program fails, it is an Err of the function's own type
// (docs/process.md, section 3): ExecFileTextError, ExecBytesError... — kind
// tells the reason (EXIT, PROGRAM_NOT_FOUND_IN_PATH, TIMEOUT...), and only
// that reason's fields are there: status after EXIT, timeout after TIMEOUT.
// What the program wrote to stderr goes on to this program's stderr.
import { execFileSync, execSync } from "node:child_process"
import { writeFileSync, mkdtempSync, rmSync } from "node:fs"
import { join } from "node:path"
import { tmpdir } from "node:os"

const at = process.argv.indexOf("--child")
const script = process.argv[1] ?? ""
if (at >= 0) {
  const args = process.argv.slice(at + 1)
  const what = args[0] ?? ""
  if (what == "print") {
    process.stdout.write(args[1] ?? "")
    process.stderr.write(args[2] ?? "")
    process.exitCode = parseInt(args[3] ?? "0").unwrapOr(0)
  } else if (what == "args") {
    console.log(JSON.stringify(args.slice(1)))
  } else if (what == "sleep") {
    setTimeout(() => console.log("woke up"), 2000)
  }
} else {
  const self = [script, "--child"]
  console.log(must(execFileSync(process.execPath, [...self, "print", "out"])))
  console.log(must(execFileSync(process.execPath, [...self, "print", "out"], { encoding: "utf8" })))
  console.log(must(execFileSync(process.execPath, [...self, "print", "", "to stderr\n"], { encoding: "utf8" })) == "")
  console.log(must(execFileSync(process.execPath, [...self, "print", "x"], { stdio: "inherit" })) == undefined)

  failure(execFileSync(process.execPath, [...self, "print", "o", "e", "2"], { stdio: "pipe" }))
  failure(execFileSync(process.execPath, [...self, "print", "o", "", "1"], { encoding: "utf8" }))
  failure(execFileSync(process.execPath, [...self, "print", "o", "bad\n", "7"], { encoding: "utf8", stdio: "pipe" }))
  failure(execFileSync(process.execPath, [...self, "print", "o", "e", "1"], { encoding: "utf8", stdio: "pipe", argv0: "named" }))
  failure(execFileSync("tz-no-such-program", ["a"]))
  failure(execSync("exit 4"))
  failure(execSync("echo failed 1>&2 && exit 3", { encoding: "utf8", stdio: "pipe" }))
  failure(execFileSync(process.execPath, [...self, "sleep"], { timeout: 300, stdio: "pipe" }))
  const slept = execSync(`"${process.execPath}" "${script}" --child sleep`, { timeout: 300 })
  if (slept.isErr() && slept.error.kind == "EXEC_BYTES_ERROR_TIMEOUT") {
    const e = slept.error
    console.log(e.code, e.timeout, e.signal, e.stdout?.length)
  }
  const exited = execFileSync(process.execPath, [...self, "print", "o", "bad\nmore\n", "7"], { encoding: "utf8", stdio: "pipe" })
  if (exited.isErr() && exited.error.kind == "EXEC_FILE_TEXT_ERROR_EXIT") {
    const e = exited.error
    console.log(e.code, e.status, JSON.stringify(e.stdout), JSON.stringify(e.stderr), e.args.length)
  }
  const missing = execFileSync("tz-no-such-program", ["a"], { encoding: "utf8" })
  if (missing.isErr() && missing.error.kind == "EXEC_FILE_TEXT_ERROR_PROGRAM_NOT_FOUND_IN_PATH") {
    console.log(missing.error.file, missing.error.args, missing.error.syscall)
  }

  // Through the shell, as in Node: cmd.exe on Windows.
  console.log(must(execSync("echo hello && echo world", { encoding: "utf8" })).replaceAll("\r", ""))
  console.log(must(execFileSync("echo", ["a", "b"], { shell: true, encoding: "utf8" })).replaceAll("\r", ""))
  console.log(must(execSync("echo shell", { shell: process.env.ComSpec ?? "cmd.exe", encoding: "utf8" })).trim())
  const userInput = "hi & echo injected"
  console.log(must(execSync("echo " + userInput, { encoding: "utf8" })).replaceAll("\r", ""))
  console.log(must(execFileSync(process.execPath, [...self, "args", userInput], { encoding: "utf8" })).trim())

  // A batch file runs only through the shell (CVE-2024-27980).
  const dir = must(mkdtempSync(join(tmpdir(), "tz-child-")))
  const bat = join(dir, "hello.bat")
  must(writeFileSync(bat, "@echo from batch %1\r\n"))
  const batch = execFileSync(bat, ["x"])
  if (batch.isErr())
    console.log(batch.error.kind, batch.error.code, batch.error.message.replaceAll(dir, "D"))
  console.log(must(execFileSync(`"${bat}"`, ["x"], { shell: true, encoding: "utf8" })).trim())
  console.log(must(execSync(`"${bat}" y`, { encoding: "utf8", cwd: dir })).trim())
  must(rmSync(dir, { recursive: true }))

  // windowsVerbatimArguments: the command line as it is, unquoted.
  console.log(must(execFileSync(process.execPath, [...self, "args", "\"a b\"", "c"], { encoding: "utf8", windowsVerbatimArguments: true })).trim())
  console.log(must(execFileSync(process.execPath, [...self, "args", "\"a b\"", "c"], { encoding: "utf8", windowsHide: true })).trim())
}

function must<T, E>(r: Result<T, E>): T {
  if (r.isErr()) {
    console.log(r.error)
    process.exit(1)
  }
  return r.value
}

// The command line of the child in messages: tz runs itself where Node runs
// the script.
function clean(text: string) {
  return text.replaceAll(`${process.execPath} ${script}`, "CHILD").replaceAll(script, "SCRIPT")
             .replaceAll(process.execPath, "EXE").replaceAll("\r", "")
}

function failure<T, E extends { kind: string; code: string; message: string }>(r: Result<T, E>) {
  if (r.isOk()) {
    console.log("no error")
    return
  }
  const e = r.error
  console.log(e.kind, e.code, "|", clean(e.message))
}
