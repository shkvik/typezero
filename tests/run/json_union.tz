// JSON.parse<T> and fromJson<T> into unions and literal types
// (docs/narrowing.md, section 3): the kind of value JSON holds tells the
// members apart (typeof), a literal takes only its value, and objects go by
// a tag field, `kind: "circle"`. A value that fits no member is an Err with
// the path to it.
type Circle = { kind: "circle"; r: double }
type Square = { kind: "square"; side: double }
type Shape = Circle | Square
function area(s: Shape): double {
  return s.kind == "circle" ? 3 * s.r * s.r : s.side * s.side
}
const shapes = must(JSON.parse<Shape[]>('[{"kind": "circle", "r": 1}, {"side": 2, "kind": "square"}]'))
console.log(shapes, shapes.map(area))

type Dir = "up" | "down"
const dirs = must(JSON.parse<Dir[]>('["up", "down", "up"]'))
console.log(dirs, dirs[0] == "up")
type Level = 0 | 1 | 2
console.log(must(JSON.parse<Level>("2")), must(JSON.parse<true>("true")), must(fromJson<"on">(must(JSON.parse('"on"')))))

// Members of different kinds.
type Value = string | int | boolean | int[]
console.log(must(JSON.parse<Value[]>('["a", 1, true, [1, 2]]')))
type Size = "auto" | int
console.log(must(JSON.parse<Size[]>('["auto", 12]')))
// Optional: a missing key and null give undefined.
type Options = { name: string; mode?: "fast" | "slow" }
console.log(must(JSON.parse<Options[]>('[{"name": "a"}, {"name": "b", "mode": "slow"}, {"name": "c", "mode": null}]')))

// Dictionaries: a Record with literal keys is an object with those fields;
// Record<string, T> inside a type is a dictionary.
type Grid = Record<"w" | "h", int>
console.log(must(JSON.parse<Grid>('{"w": 3, "h": 4}')))
type Inventory = { owner: string; counts: Record<string, int>; tags: Record<string, Dir[]> }
console.log(must(JSON.parse<Inventory>('{"owner": "x", "counts": {"a": 1, "b": 2}, "tags": {"t": ["up"]}}')))

function show<T>(r: Result<T, JsonError>) {
  if (r.isErr()) console.log(r.error.path == "" ? r.error.message : `${r.error.path}: ${r.error.message}`)
  else console.log(r.value)
}
show(JSON.parse<Shape>('{"kind": "triangle", "a": 1}'))
show(JSON.parse<Shape>('{"r": 1}'))
show(JSON.parse<Shape>('{"kind": "circle", "r": "big"}'))
show(JSON.parse<Shape>("5"))
show(JSON.parse<Dir>('"left"'))
show(JSON.parse<Level[]>("[0, 3]"))
show(JSON.parse<Value>("null"))
show(JSON.parse<Inventory>('{"owner": "x", "counts": {}, "tags": {"t": ["up", "left"]}}'))

function must<T>(r: Result<T, JsonError>): T {
  if (r.isErr()) {
    console.log(r.error)
    process.exit(1)
  }
  return r.value
}
