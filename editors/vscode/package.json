{
  "name": "tz",
  "displayName": "TypeZero",
  "description": "Errors as you type, highlighting, formatting and a file icon for TypeZero programs (.tz files)",
  "version": "0.5.0",
  "publisher": "typezero",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:tz",
    "onDebugResolve:tz"
  ],
  "contributes": {
    "configuration": {
      "title": "TypeZero",
      "properties": {
        "tz.path": {
          "type": "string",
          "default": "",
          "description": "The tz executable whose language server (tz lsp) shows the errors. Empty: tz on PATH, else build/dev/bin/tz.exe of an open folder."
        }
      }
    },
    "commands": [
      {
        "command": "tz.restartServer",
        "title": "TypeZero: Restart the Language Server"
      }
    ],
    "languages": [
      {
        "id": "tz",
        "aliases": [
          "TypeZero",
          "tz"
        ],
        "extensions": [
          ".tz"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/tz-light.svg",
          "dark": "./icons/tz-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "tz",
        "scopeName": "source.tz",
        "path": "./syntaxes/tz.tmLanguage.json",
        "unbalancedBracketScopes": [
          "keyword.operator.relational",
          "storage.type.function.arrow",
          "keyword.operator.bitwise.shift",
          "meta.brace.angle",
          "punctuation.definition.tag",
          "keyword.operator.assignment.compound.bitwise.ts"
        ],
        "tokenTypes": {
          "punctuation.definition.template-expression": "other",
          "entity.name.type.instance.jsdoc": "other",
          "entity.name.function.tagged-template": "other",
          "meta.import string.quoted": "other",
          "variable.other.jsdoc": "other"
        }
      }
    ],
    "configurationDefaults": {
      "[tz]": {
        "editor.defaultFormatter": "typezero.tz",
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
      }
    },
    "breakpoints": [
      {
        "language": "tz"
      }
    ],
    "debuggers": [
      {
        "type": "tz",
        "label": "TypeZero",
        "languages": [
          "tz"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "description": "The .tz file to build with tz build --debug and run.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Command-line arguments of the program.",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "The working directory; by default the directory of the program."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Environment variables of the program.",
                "default": {}
              },
              "stopAtEntry": {
                "type": "boolean",
                "description": "Stop at the start of the program.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "tz",
            "request": "launch",
            "name": "Debug the .tz file",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "TypeZero: Launch",
            "description": "Build a .tz file with tz build --debug and debug it",
            "body": {
              "type": "tz",
              "request": "launch",
              "name": "Debug the .tz file",
              "program": "^\"\\${file}\""
            }
          }
        ]
      }
    ]
  }
}
